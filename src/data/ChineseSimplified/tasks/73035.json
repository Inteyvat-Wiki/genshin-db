			},
			"dialogs": [
				{
					"id": 730350901,
					"content": "总算解决了…这么说来，之前在莎兰树的梦境里，也能看见这棵很神奇的树呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350902,
					"content": "#对不起，那菈{NICKNAME}。对不起，派蒙。我完全没发现，觉王树的梦境已经被无留陀侵蚀了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350903
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350903,
					"content": "无数黑色的虫子在侵蚀梦之树在沙恒中的根。就算在梦中，也能感受到无留陀的手，在摇晃着这个梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350904
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350904,
					"content": "对不起喔…之前在觉树之堂见到无留陀的时候，我就应该知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350905
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350905,
					"content": "#没关系啦！你看，有{NICKNAME}在，不是轻轻松松地解决了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350906,
						730350907,
						730350909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350906,
					"content": "那惟耶之实…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350912
					]
				},
				{
					"id": 730350912,
					"content": "#有了恒素果，多少应该能为他恢复一些力量。那菈{NICKNAME}，拜托你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350913
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350913,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350914
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350914,
					"content": "嗯，我明白了。虽然没想到会这么快，但是我知道，在正确的时候，就会明白应该做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350915
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350915,
					"content": "就像云朵会明白要降下雨滴，雨水会明白要落入土地。种子会明白要茁壮成长，变成大树，然后结出饱满的果实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350916
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350916,
					"content": "兰罗摩看起来怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350917,
					"content": "嗯，我在和梦之树说话。原来你们听不到喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350918
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350918,
					"content": "虽然之前也看见兰纳真和蘑菇说话…但是，正常来说，人是不能和植物说话的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350919,
					"content": "原来是这样！又学到了新的知识。谢谢派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350920
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350920,
					"content": "#惟耶之实的事情，那菈{NICKNAME}、派蒙，不用担心。我们先从梦里出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350907,
					"content": "小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350908
					]
				},
				{
					"id": 730350908,
					"content": "唔…不过，这对惟耶之实有影响吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350909,
					"content": "也没你说的那么轻松…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350910
					]
				},
				{
					"id": 730350910,
					"content": "多亏了你，不管怎么说，还是解决了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350911
					],
