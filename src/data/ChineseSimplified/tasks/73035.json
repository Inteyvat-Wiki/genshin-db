			"dialogs": [
				{
					"id": 730350401,
					"content": "觉王树中间好像在发光…那就是惟耶之实吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350402,
					"content": "哎呀，真是不容易，这些终于能让拉娜恢复了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350404,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350405,
					"content": "兰罗摩，你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350408,
					"content": "觉王树已经被无留陀侵蚀了，无法结出惟耶之实。所以，我要种出新的觉王树，这样才能帮助你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350409,
					"content": "但是…种树不是要花好长好长时间吗？从种子到长成大树…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350410,
					"content": "毋须担心。莎兰树成长的速度与种子有关。觉王树将所有的力量交给了我，加上恒素果与我们一同的记忆，没问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350411,
					"content": "谢谢你，最初的觉王树。谢谢你们，兰拉吉、兰雅玛、兰玛哈，我会好好利用你们留下的记忆，让新的觉王树重新连接梦的通路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350412,
					"content": "感觉，兰罗摩好像变了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730350413,
					"content": "是吗？我知道了很多事情、学到了很多词语、获得了许多记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350414,
					"content": "但是，不用担心。我还是我，你们是我的朋友。我一定会帮助你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350415,
					"content": "那惟耶之实…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "觉王之殿的深处封印着往昔的桓那兰那，无留陀的化身就在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350420,
					"content": "它会不停向大地、向沙恒灌注蛇毒，直到一切青翠的都枯黄，所有花朵都凋零，溪水散发出腐臭的气味。直到万物死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350421,
					"content": "我们要将它摧毁。只有这样，才能种出强壮的树，结出惟耶之实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350416,
					"content": "我相信你。接下来要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#那菈{NICKNAME}明白了就好。那就没什么问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730350406,
					"content": "怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				}
			]
		},
