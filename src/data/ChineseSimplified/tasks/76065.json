					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650102,
					"content": "哥伦比娅居然在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "嗯，现在你也来了，所以，是我们一起在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650104,
					"content": "说得好像你知道我会来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "我不知道是什么时候，但你总会来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650106,
					"content": "就像月亮与提瓦特之间总有一股相互联系的引力。你总能找到我。不是么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650107,
					"content": "来，一起坐坐吧，给你留了位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650108,
					"content": "上次我们在你的飞船上，看提瓦特。这次就看看星空吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650109,
					"content": "宁宁和她的前辈们，就是被这片星空吸引了。那里一定也有着别样的引力。我感受得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650110,
					"content": "宁宁和她发出的消息…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "别担心，她没有遇到危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650112,
					"content": "她安全地走了很远很远的路，远到已经感应不到我用来护送她的力量了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650113,
					"content": "但是，我很好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650114,
					"content": "好奇什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "嗯，有很多。比如，望月者的消息会被其他人接收到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650116,
					"content": "接收到的人，或者其他存在…他们会是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650117,
					"content": "他们会怎么想？会和我们一样，心里也有爱和恨吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650118,
					"content": "会和我们一样，即使深渊环伺，依然被头顶这片美丽又神秘的星空吸引吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650119,
					"content": "会和我们一样，也想找到其他人，然后招招手说「好朋友，很高兴认识你」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650120,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650121,
					"content": "这片星空深处，还有没被黑暗吞噬的文明吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650122,
					"content": "我想会有的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650124,
					"content": "我们的飞船，曾接收过一段讯息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "什么讯息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650126,
					"content": "有效内容几乎缺失了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "但一定属于一个智慧文明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "缺失…是因为走了太远的路吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650129,
					"content": "不过，光是这样，就已经足够让人高兴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650130,
					"content": "#对了，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650131,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "你原本的家乡，也在那深处吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650133,
					"content": "如果有一天，你想要回到你启程的地方，打扫打扫那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650134,
					"content": "我很乐意搭把手，像你帮我打扫月亮一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650135,
					"content": "那我不会忘记来邀请你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "再开一个派对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650137,
					"content": "再开一个派对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650139,
					"content": "名字就叫「归旅之夜」，你觉得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650140,
					"content": "也许是白天呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "那就从白天玩到夜晚。把好朋友们都喊上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "哥伦比娅"
				},
				{
					"id": 760650142,
					"content": "听起来很愉快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "愿那个夜晚在一个好天气里到来。在朋友们的团聚下到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥伦比娅"
				}
			]
		}
	]
}