					}
				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "你好，崔斯梅姬斯图斯女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950102,
					"content": "哦？能准确说出这个名字，看来我们有共同的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950103,
					"content": "有位哥伦比娅小姐向我推荐了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950104,
					"content": "那可是位难以预测的小姐呢，你们的相遇一定充满惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950105,
					"content": "所言极是，我非常认同「难以预测」这个评价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950106,
					"content": "初次见面，我是莱欧斯利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950107,
					"content": "是了，驻守水下的公爵，很高兴认识你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950108,
					"content": "没想到伟大的魔女之一竟然听说过我，真是荣幸之至。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950109,
					"content": "还是说，作为占星术士的崔斯梅姬斯图斯女士已经预见了我的到来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950110,
					"content": "呵呵…既然我们都知晓彼此的身份，那就省去这些繁文缛节吧，称呼我为芭比洛斯即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950111,
					"content": "那也请直接叫我莱欧斯利吧，现在并非公务时间，我也只是一个闲散的枫丹市民罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950112,
					"content": "刚刚路上正好碰到新鲜出炉的晶螺糕，听说魔女们都喜欢围着茶桌闲聊，如不嫌弃的话，请收下一份吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950113,
					"content": "哎呀，这的确是茶会上非常受欢迎的甜点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950114,
					"content": "在这里停留许久，我给不少人送出了属于他们的预言，倒是第一次先收到了礼物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950115,
					"content": "谢谢你，莱欧斯利先生，我会和艾莉丝她们分享的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950116,
					"content": "…我听到了哦，芭比，必须给我留！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950117,
					"content": "不能像之前那样因为我来晚了就让尼可一声不吭地把所有——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950118,
					"content": "咳咳！知道了知道了，这次一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950119,
					"content": "真是的，你怎么来得这么巧，我还想在新朋友面前维持住魔女会的体面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950120,
					"content": "没关系，有什么不好，没有规定说能力强大的人不能拥有活泼的性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950121,
					"content": "正是如此！乐观开朗可是我们魔女会的入会门槛之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950122,
					"content": "第一次听说有这种门槛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950123,
					"content": "我刚刚想的！魔女会可是给世界带来快乐的组织，我们自己当然要先乐观开朗起来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950124,
					"content": "仅代表个人，我支持诸位随心所欲地享受生活——当然，要在不违法乱纪的前提下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950125,
					"content": "你这个前提在艾莉丝面前不堪一击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950126,
					"content": "哎呀，那可真是令人担忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950127,
					"content": "嘿，我还在这呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950128,
					"content": "放心放心，我还不至于非要在梅洛彼得堡的管理人面前胡闹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950129,
					"content": "而且…就算退一步讲，你那里应该比西风骑士团的禁闭室要更宽敞一些吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950130,
					"content": "哈哈，难道一间禁闭室就能关住传说中的魔女吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950131,
					"content": "艾莉丝女士甘愿受罚，肯定是因为她为人谦和且守信啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950132,
					"content": "这话说得——真是太对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950133,
					"content": "停，停，莱欧斯利先生，请不要再助长她的气焰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950134,
					"content": "一个心情愉悦的艾莉丝，可不一定会做出什么事来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950135,
					"content": "深有体会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#对哦，说起来{NICKNAME}可是骑士团的荣誉骑士，那么肯定是要维护禁闭室的尊严才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950138,
					"content": "由荣誉骑士来阻拦逃跑的魔女吗？听起来像是很不错的话剧，请务必叫我围观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950139,
					"content": "你也真是看热闹不嫌事大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950140,
					"content": "不过没想到公爵已经提前过来了，省去了我们往水下跑一趟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950141,
					"content": "这就是占卜的力量吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "啊，说到这个，也该做些正事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950143,
					"content": "莱欧斯利先生，无论是看在哥伦比娅小姐的面上，还是作为茶会糕点的回礼，都请你抽取一张「月谕圣牌」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950144,
					"content": "或许命运的馈赠就暗藏其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950145,
					"content": "这算是一种预言吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950146,
					"content": "可以这么说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950147,
					"content": "那没有枫丹人会不认真对待的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950148,
					"content": "说是要「认真对待」，莱欧斯利直接拿起了最上面的一张牌…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "我对这种牌不甚了解，这似乎是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950150,
					"content": "是正位的「皇帝」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950151,
					"content": "您这样欲言又止，难道是坏消息？请不必介意，直言相告就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950152,
					"content": "不，恰恰相反，这张牌意味着永恒的统辖与难以撼动的权威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950153,
					"content": "如果这代表未来的路，那其实你早已抵达了目的地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950154,
					"content": "不过…呵呵呵，你的「命运」显然还会滚滚向前，变化不止，那么就意味着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950155,
					"content": "或许变化的不是人，而是环境？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950156,
					"content": "嗯…就目前而言，是有这种倾向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950157,
					"content": "那看来我可以对自己的直觉更加自信一些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950158,
					"content": "之前我曾因公务拜访挪德卡莱，长了不少见识，此后也不免关注了一些当地的新闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950159,
					"content": "而有那么一个晚上，我看着格外明亮的月亮，不由得想，这个世界正在产生变化，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950160,
					"content": "正确的回答是，世间万物每时每刻都在变化，而在巨大变量的介入后，我们都要做好迎接未知的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950161,
					"content": "不过从这张牌的结果来看，你似乎不用太过担心。无论环境如何改变，你都将拥有适应它或与之对抗的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950162,
					"content": "那可真是皆大欢喜。看来那一拳没有白挨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950163,
					"content": "是带着美好祝愿的一拳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "不过出于好奇，我有个相当冒昧的问题想要请教，不知能否直说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950166,
					"content": "真是狡猾，莱欧斯利先生这样说就是在故意引起我们的好奇心嘛！这下就算你不说，我也偏要问了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950167,
					"content": "那就恕我直言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950168,
					"content": "我一直很想知道，一个真正的预言究竟要如何保证它的实现？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950169,
					"content": "就以我为例，当下的占卜称我会长期处于一个稳定的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950170,
					"content": "但如果我在得知了这个预言后叛逆心肆起，立即去做一些出格的事情，结果又会如何呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950171,
					"content": "就比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950172,
					"content": "比如把梅洛彼得堡炸上天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "行，就这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950174,
					"content": "还惦记着这回事呢？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950175,
					"content": "欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950176,
					"content": "不，你等会儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950177,
					"content": "哈哈！真是巧了！我这边正好有一位实力强劲的爆破专家可以介绍给你——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950178,
					"content": "而荣誉骑士会作为那位爆破专家的随行监护人，在关键时刻阻拦一切坏事的发生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950179,
					"content": "…你看，预言就是这样达成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950180,
					"content": "看来是位破坏力很强的专家啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950181,
					"content": "而且非常可爱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "啊，是小可莉吧！公爵可能不知道，可莉是艾莉丝的女儿哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746950183,
					"content": "不，准确地说，应当是「诸世界的大冒险家」「很坏很坏的大魔王」「旧蒙德的守护者」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950184,
					"content": "太长了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950185,
					"content": "…总之就是大魔王艾莉丝最可爱的孩子，名副其实的「火花骑士」——可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950186,
					"content": "唉，就应该按照原定的计划，大家一起好好办一场聚会，还能介绍你们认识呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950187,
					"content": "那样等可莉去枫丹玩的时候，还能有新朋友一起开茶会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746950188,
					"content": "听上去是个不错的计划，我已经开始期待了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950189,
					"content": "毕竟我是不会对一壶好茶说不的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 746950164,
					"content": "大难不死，必有后福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "还请对禁闭室保持敬畏之心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
