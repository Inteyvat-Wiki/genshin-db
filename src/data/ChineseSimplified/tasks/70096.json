			"dialogs": [
				{
					"id": 700960401,
					"content": "很流畅的身法，完全看不出是机械。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960402,
					"content": "洛恩先生的攻击也很精准，就像机械一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960403,
					"content": "好耶！是新零件！可以拿回去做新的模块了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 700960404,
					"content": "哦？那现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960405,
					"content": "伊涅芙！再去多找几个！样本越多越好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 700960406,
					"content": "是…抱歉，我们回头再谈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960407,
					"content": "一番探索之后…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 700960409,
					"content": "居然睡着了…是因为之前在荆夫港玩得太累了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960410,
					"content": "爱诺经常这样，精力来得快去得也快。抱歉，洛恩先生，我现在无法移动，需要等爱诺再睡熟一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960411,
					"content": "…算了，你的力量，我已经看过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960412,
					"content": "…希望我的战斗数据，对您有所帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960413,
					"content": "对了，告诉我们特殊机关信息的人，还提到过「雪山」，也许各位可以再去那边看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				}
			]
		},
