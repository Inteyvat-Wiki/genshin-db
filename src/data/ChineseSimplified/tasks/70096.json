				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "伊涅芙伊涅芙！你看那个风车！快把它的结构记录下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 700960302,
					"content": "收到——正在准备为风车拍照。这次想要合影吗，爱诺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960303,
					"content": "#欸？{NICKNAME}？派蒙——还有洛恩！嗨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 700960304,
					"content": "来自挪德卡莱的「强大古龙」…我早该想到是谁的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960305,
					"content": "情况总结中…所以，洛恩先生是想要找我进行战斗训练？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960306,
					"content": "跳过所有前因后果，确实是这么回事。在挪德卡莱远征的时候还真没想到，你居然有这么曲折的来历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960307,
					"content": "不过这都无关紧要，从前我就想领教一下你的身手了，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960308,
					"content": "哼哼！伊涅芙！给他点颜色看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 700960309,
					"content": "抱歉——根据今日日程安排，我们还要去收集蒙德的特殊零件。根据评估，与您交战，可能会影响后续的行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 700960310,
					"content": "对哦…差点忘了还有这回事。明明是听说了蒙德有特别的大机器人才过来的…一不小心就全在玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 700960311,
					"content": "好吧…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960312,
					"content": "洛恩…居然这就放弃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960313,
					"content": "——只要帮你们干掉那些遗迹守卫，你就能腾出日程了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				}
			]
		},
