			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "…追寻力量之人，依循命运的指引，终于来到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960502,
					"content": "果然是杜林…我怎么一点都不意外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960503,
					"content": "但语气有点不一样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "至高领主、魔女造物、天使孑遗…行使着各不相同的力量，却都被冠以「龙」的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960505,
					"content": "…只因「龙」，即是强大的象征。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960506,
					"content": "所以「与巨龙战斗」也就成了力量的证明？——我有点理解当初的大团长了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960507,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960508,
					"content": "虽然你看起来还想说什么，不过接下来就用兵刃交流吧？这样更好懂一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960509,
					"content": "等等！年…年轻的人类啊，你想找的试炼不在这里，前往风龙废墟吧去直面最后一次预言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960510,
					"content": "语速好快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "你没事吧？杜林？总感觉你今天说话怪怪的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960513,
					"content": "（哈…该念的应该都念了吧…虽然跳过了很多！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960514,
					"content": "那个，阿贝多喊我去帮他做实验，我就先回去了。抱歉了，各位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 700960515,
					"content": "这就飞走了？…真遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960516,
					"content": "嗯？这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960517,
					"content": "呃…所以杜林究竟是来做什么的？除了最后那句「前往风龙废墟」好像没什么有效信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960518,
					"content": "我有种预感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "有意思，我现在倒是想去见证一下，这「预言」会怎么实现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				},
				{
					"id": 700960519,
					"content": "是为了凑「三」这个数。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "像赶着下场的演员！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
