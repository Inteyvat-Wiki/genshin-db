					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700960704,
					"content": "第一次上手什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "嗯…是「魔女的课业」，回头再向你解释吧。",
