			"dialogs": [
				{
					"id": 201010301,
					"content": "哇啊…不要吃我！——呃，你们…是人类？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010302
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010302,
					"content": "一整层的防御…都被突破了…我还以为是「深渊教团」的怪物攻来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010303,
						201010305
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010303,
					"content": "我们是来取天空之琴的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010304
					]
				},
				{
					"id": 201010304,
					"content": "你，你们怎么知道「天空之琴」在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010309,
					"content": "存放圣物的地方是上锁的，你们要找钥匙的话…往前走吧，不要找我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010310
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010310,
					"content": "钥匙不知道是在哪位先遣队员手里…但总之你可以去房间里找他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010311
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010311,
					"content": "是个被吓破胆了的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 201010312,
					"content": "哼…你，你们好自为之吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010313
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010313,
					"content": "我们「愚人众」在蒙德…可是有「执行官」坐镇的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010314
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010314,
					"content": "「女士」大人会找到你们，把你们吊起来折磨——到那时可不要连累我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010305,
					"content": "我们是来取你性命的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010306
					]
				},
				{
					"id": 201010306,
					"content": "咿——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010307
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010307,
					"content": "不要这样…！我有珍贵的情报要坦白！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010308
					],
					"speakerTitle": "「愚人众」守卫"
				},
				{
					"id": 201010308,
					"content": "其实我们把蒙德的至宝，「天空之琴」，藏在这座遗迹深处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「愚人众」守卫"
				}
			]
