			"dialogs": [
				{
					"id": 761190101,
					"content": "…这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190102,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761190103,
					"content": "…哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190104,
					"content": "她们好像玩得很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190105,
					"content": "你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190106,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761190107,
					"content": "你也好，努昂诺塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190108,
					"content": "是在玩新游戏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "嗯，我在「旗舰」见到有人用杯子和朋友这样玩，就学来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190110,
					"content": "他们把宝石扣进杯子里，在桌面上快速转动杯子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190111,
					"content": "等停下后，让对方猜测宝石究竟停留在哪个杯子里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190112,
					"content": "月灵们喜欢钻在布里转来转去的感觉，所以我以魔女小姐的帽子为原型，做了些改良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190113,
					"content": "很可爱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761190115,
					"content": "但话说回来你都去过「旗舰」了呀，有被人认出来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190116,
					"content": "有人问起。我就说「我在扮演月神大人，很像吧？」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190117,
					"content": "祈月之夜时的那招还真给你学会了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190118,
					"content": "那些人会信吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "唔…好像半信半疑。但也没再多和我搭话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190120,
					"content": "是我表演得不自然吗？下次再去其他地方多试几次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190121,
					"content": "怎么听着是学坏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761190122,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761190123,
					"content": "努昂诺塔想邀请你来猜它躲在哪里，要和它玩一局吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190124,
					"content": "好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "请按「旗舰」的规矩，付十万摩拉作为押金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190126,
					"content": "这部分就不用学了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
