			"dialogs": [
				{
					"id": 120410401,
					"content": "终于到了，入口就在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410402
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410402,
					"content": "居然出现了一个鸟居？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410403,
					"content": "你还好吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410404
					]
				},
				{
					"id": 120410404,
					"content": "感觉又恶化了…但没关系，我会尽快结束一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410405
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410405,
					"content": "这里是曾被我亲手封存起来的…雷电真的意识空间入口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410406
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410406,
					"content": "看来，「她」已经不允许我胡乱使用这个身体了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410407
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410407,
					"content": "嗯？什么意思，她到底是谁啊？是在说真吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410408,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410409
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410409,
					"content": "跟到哪里去…唔，唔哇啊啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1204105,
			"completionStepIds": [
				1204111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204111",
							"2"
						],
						"stepId": 1204111,
						"stateName": "QUEST_STATE_UNFINISHED"
