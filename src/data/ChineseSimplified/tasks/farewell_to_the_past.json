			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120410201,
					"content": "影，要不然还是交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410202,
						120410203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410202,
					"content": "你的状态确实不对劲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				},
				{
					"id": 120410204,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410205
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410205,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410206
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410206,
					"content": "没关系，你先在后面休息，恢复一下体力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410207,
					"content": "我们来对付魔物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410208,
					"content": "欸…又是那样的光？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410209,
						120410210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410209,
					"content": "马上又要来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410211,
					"content": "这、这里是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410212
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410212,
					"content": "你们是…啊，将军大人也在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410213
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410213,
					"content": "将军大人您受伤了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410214
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410214,
					"content": "唔…没事，只是身体有点僵硬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410215
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410215,
					"content": "我等幕府武士，定会护将军大人周全直至最后一刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410216
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410216,
					"content": "兄弟们，上，魔物又冲过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410217
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410217,
					"content": "不行，太危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410218
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410218,
					"content": "我们的职责正在于此！如果害怕危险，从一开始就不会拿起武器了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410219
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410219,
					"content": "不用担心，将军大人，正是在这种困境中，神明赐予我们的力量才更有意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410220
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410220,
					"content": "那个是，神之眼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410221,
					"content": "没错。我知道神明无所不能，愿意将力量赐给人类，说明神对我们有深厚的期望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410222
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410222,
					"content": "如今将军大人遭遇困境，更是我们兑现诺言的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410223
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410223,
					"content": "那时的武人，是这么看待神之眼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410224,
						120410225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410224,
					"content": "充满了希望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410226,
					"content": "大家都不知道将军大人去了哪里，都很绝望。但我们现在找到了您，您就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410227
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410227,
					"content": "只要您能重新出现在大家面前，我们心中就会重燃希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410228
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410228,
					"content": "这份希望，会成为指引我们穿越黑暗的光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410229
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410229,
					"content": "大家，跟我一起战斗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410230
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410230,
					"content": "我们也可以战斗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410231,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410232
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410232,
					"content": "我知道了，请一定保护好自己的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410225,
					"content": "抗争之心从未动摇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410210,
					"content": "这次是什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410203,
					"content": "别再硬撑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				}
			]
		},
