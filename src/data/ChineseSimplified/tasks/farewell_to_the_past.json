			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120410501,
					"content": "呃啊…头好晕，被拉到什么地方来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410502,
					"content": "呜哇！这个地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410503,
					"content": "很像「一心净土」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410504
					]
				},
				{
					"id": 120410504,
					"content": "你看，你看，那边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410505,
					"content": "有另一个影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410506,
					"content": "又见面了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410507
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410507,
					"content": "此身为内在的协助者，亦是法则的守护者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410508
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410508,
					"content": "如果内在想要背离法则，那此身…便化作修罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410509
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410509,
					"content": "这种感觉…难道是人偶将军？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410510,
					"content": "你以我的身躯游历世间，看似掌握了永恒的真谛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410511
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410511,
					"content": "你认为如今的自己比过去更坚定，所以现在这个你才是正确的。是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410512
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410512,
					"content": "如今的你究竟是有了新的想法，还是受到了无可抵御的「磨损」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410513
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410513,
					"content": "我正是为回答你而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410514
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410514,
					"content": "我们同为武人，此时此刻的对话方式，只有「战斗」这一种吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410515
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410515,
					"content": "呜哇，等等，气氛一下就变了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410516,
					"content": "你你你…你已经没事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410517,
					"content": "先前种种不适，是将军在抗拒我继续使用她的身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410518
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410518,
					"content": "如她所说，一旦我有了「改变」的念头，她就会视我为敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410519
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410519,
					"content": "只要进入意识空间，我便可独立于她存在，不再受到干扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410520
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410520,
					"content": "将军虽是人偶，也有其自我意识。必要时，她会出现在这里与我对质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410521,
						120410522
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410521,
					"content": "这就是你曾对我说的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410523
					]
				},
				{
					"id": 120410523,
					"content": "呃…虽然影说过再困难也会去做之类的话，但谁想得到是这种自己打自己的情况啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410524,
					"content": "影和将军竟然要战斗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410525,
					"content": "我为将军定下的法则…不，将军便是过去的我的理想，是「永恒」的基石，难以撼动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410526
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410526,
					"content": "若非必要，我不会尝试改变她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410527
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410527,
					"content": "就没有其他办法了吗？不动手也能把话说开…之类的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410528,
					"content": "影不是给自己留退路的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410529
					]
				},
				{
					"id": 120410529,
					"content": "可是，她们明明都是为了稻妻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410530,
					"content": "此身，象征无上威严，被授予统领一国之权，凝聚了「雷电将军」的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410531
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410531,
					"content": "自然也继承了影前行时不断失去的痛苦，以及，想要抵达永恒的决心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410532
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410532,
					"content": "一切都是为了对抗「磨损」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410533
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410533,
					"content": "决心、勇气、爱慕、仇恨…都会在时间长河中变质扭曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410534
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410534,
					"content": "唯有「法则」永恒不变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410535
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410535,
					"content": "这的确是我制造你之时的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410536
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410536,
					"content": "也变成了我不得不跨越的高墙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410537
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410537,
					"content": "你，要与我为敌吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410538
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410538,
					"content": "我是你的过去，我是万世不变的法则，我是「永恒」的守护者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410539
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410539,
					"content": "而我是，许以臣民一梦的——「雷电影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410522,
					"content": "永恒的防御机制？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410523
					]
				}
			]
		},
		{
			"id": 1204106,
			"completionStepIds": [
				1204113
			],
