			"dialogs": [
				{
					"id": 120410301,
					"content": "它们的进攻，好像终于停止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410302
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410302,
					"content": "我还是第一次打这么激烈的仗呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410303
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410303,
					"content": "谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410304
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410304,
					"content": "欸？你没事了吗？要不要再休息一会儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410305,
					"content": "没关系，已经好些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410306
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410306,
					"content": "你们身手了得，实在令人刮目相看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410307
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410307,
					"content": "那些魔物一定还会回来。到时候，恐怕就不只是兽境猎犬这么简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410308
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410308,
					"content": "你们尽快护送将军大人返回稻妻城，与大将率领的军队汇合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410309
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410309,
					"content": "见到将军大人顺利归来，所有人一定会士气大振。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410310
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410310,
					"content": "那你们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410311,
					"content": "我们留在这里阻挡怪物，不能让它们再前进了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410312
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410312,
					"content": "只要兄弟们齐心协力，无论有多少魔物都不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410313
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410314,
						120410315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410314,
					"content": "（不必打扰他们心中的「现实」。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				},
				{
					"id": 120410316,
					"content": "交给我们吧！战斗本就是我们最熟悉的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410317
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410317,
					"content": "但将军大人是特别的，只有将军大人才能逆转这绝望的现状，带我们走向未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410318
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410318,
					"content": "无论稻妻面对什么样的威胁，我们都有理由永远相信将军大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410319
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410320
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410320,
					"content": "非常感谢你们，我向你们保证，我会给稻妻一个光明的未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410321
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410321,
					"content": "这份承诺来得有些迟了，但至少，是从此刻开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410322
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410322,
					"content": "将军大人请放心，有您这句话，我们决不言败！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410323
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410323,
					"content": "我们一定能与您一起，把稻妻失去的东西全都夺回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410324
					],
					"speakerTitle": "深见"
				},
				{
					"id": 120410324,
					"content": "常道恢弘，鸣神永恒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410325
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410325,
					"content": "常道恢弘，鸣神永恒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410326
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410326,
					"content": "他们…消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410327,
						120410328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410327,
					"content": "刚刚的承诺，你是对他们说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410329,
					"content": "两者皆有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410330
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410330,
					"content": "人们的牺牲曾令我无比痛苦，可我忽视了他们燃尽一切，闪出强光的模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410331
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410331,
					"content": "——结果便是在这几百年里，我辜负了他们的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410332
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410332,
					"content": "「无论对他们说什么都没有意义，他们不过是地脉中一段游离的记忆。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410333
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410333,
					"content": "就算如此，我也要给他们…和直到现在仍深信我的人民一个交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410334
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410334,
					"content": "我觉得，这样的心意，在几百年之后能够被回应，也算收获回报了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410335,
					"content": "谢谢你的安慰。但这本就是身为稻妻之神应尽的事，我已经做得太迟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410336
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410336,
					"content": "就像那位武士说的，我曾以为，我只需承担一名战士所应承受的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410337
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410337,
					"content": "可稻妻更需要的，是像真那样的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410338
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410338,
					"content": "哪怕我与真完全不同，也永远无法成为她——我需要做的事也应该和她相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410339
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410339,
					"content": "人类值得你的信任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410340
					]
				},
				{
					"id": 120410340,
					"content": "是啊，多么强大，坚韧，值得为之骄傲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410341
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410341,
					"content": "被人们崇敬的雷电将军，万不可拖了他们的后腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410342
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410342,
					"content": "哦？这样看来，你已经想通了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410343,
					"content": "稻妻会有新的变化与可能，但还需要时间。「过去」留给我们的伤痕，会被「未来」的时间抚平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410344
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410344,
					"content": "无论花费多少时间，我都会坚持下去。这就是我许下的承诺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410345
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410345,
					"content": "消灭了兽境猎犬，这件事算初步解决了。现下看来，它们并不会构成更大的威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410346
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410346,
					"content": "后续事务，比如调查事件原因，养护根系等，就交给天领奉行或社奉行的人去处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410347
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410347,
					"content": "嗯，那我们走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410348,
					"content": "影虽然看起来还算冷静，心里应该很乱吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410349,
					"content": "我总觉得，这段时间她变了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410350,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410351,
					"content": "怎么了，影？快跟上来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410352,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410353
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410353,
					"content": "影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410354
					]
				},
				{
					"id": 120410354,
					"content": "你怎么了，是不是又难受起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410355
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410355,
					"content": "身体…动不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410356
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410356,
					"content": "看来情况比我想的更严重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410357,
						120410358
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410357,
					"content": "要不要休息一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410359,
					"content": "不用，是「她」在呼唤我。现在就是最好的时机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410360
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410360,
					"content": "#{NICKNAME}，可以扶我一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410361
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410361,
					"content": "我要去鸣神大社下方的洞窟里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410362
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410362,
					"content": "洞窟？里面有什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410363,
					"content": "那里…是可以斩断过去，走向未来的战场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410358,
					"content": "总之先回稻妻城吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410328,
					"content": "还是对你自己说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410315,
					"content": "那就拜托你们了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				}
			]
		},
		{
			"id": 1204104,
