			"dialogs": [
				{
					"id": 120410101,
					"content": "还是像刚刚一样，交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410102
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410102,
					"content": "喂喂，你、你确定自己没问题吗？别吓唬我们呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
