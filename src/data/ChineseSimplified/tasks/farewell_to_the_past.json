					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120410601,
					"content": "终于打败她了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410602,
					"content": "看来你的武艺并没有退步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410603
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410603,
					"content": "但你的意志又能坚持到什么时候呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410604
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410604,
					"content": "怎、怎么会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410605,
					"content": "人偶将军不会是无敌的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410606
					]
				},
				{
					"id": 120410606,
					"content": "这里是意识空间，她的存在确实很难撼动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410607
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410607,
					"content": "她是为了对抗磨损而生的产物。论意志，她能凌驾于一切生灵之上，包括你我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410608
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410608,
					"content": "那、那这场战斗不就是没有尽头的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410609,
					"content": "或许吧。但我必须向她证明，此刻我的意志绝非磨损的产物。我将铸就的未来，会是经得起磨损的伟业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410610
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410610,
					"content": "不这样做，将军的法则就无从改变，稻妻亦无「前进」可言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410611
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410611,
					"content": "这是我的责任。无论这场战斗要持续多久，数月、数年、十几上百年…无论多少次，我都会击败她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410612
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410612,
					"content": "那这段时间稻妻怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410613
					]
				},
				{
					"id": 120410613,
					"content": "五百年前，人类凭借奋战证明了自身的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410614
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410614,
					"content": "现在，他们又靠着「愿望」革除旧弊，就像古老的樱树也会长出新枝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410615
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410615,
					"content": "——我该学会信任他们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410616,
						120410617
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410616,
					"content": "但你忍心让人类独自前行吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410618
					]
				},
				{
					"id": 120410618,
					"content": "我明白。但假如真所说的「梦想」才是真正的永恒，那么将军所不存在的「须臾」，也不足为惧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410619
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410619,
					"content": "若是为了稻妻无穷的未来，我的战斗无论多漫长，在「永恒」中也只如一瞬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410620
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410620,
					"content": "我向稻妻的臣民们许诺，定会归来。这份诺言，由你见证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410621
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410621,
					"content": "我不在的这段时间，一切就交给神子她们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410622
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410622,
					"content": "可是、可是这样一来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410623,
					"content": "转告我的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410624
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120410624,
					"content": "影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410625
					]
				},
				{
					"id": 120410625,
					"content": "呜哇——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120410617,
					"content": "大家都认为将军大人是希望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410618
					]
				}
			]
		},
