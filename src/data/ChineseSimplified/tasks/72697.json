			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#嘿嘿，{NICKNAME}，派蒙，你们来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970102,
					"content": "我的玩具城就要开业了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970103,
					"content": "玩具城？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970104,
					"content": "咳咳，当然了，说是玩具城，实际上也只有我和我的「大工机」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970105,
					"content": "我改良了一下工序，现在没必要那么等待那么长时间才能完成制造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970106,
					"content": "虽然称不上是「瞬间完成」，但也好歹也可以说是「立等可取」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970107,
					"content": "哇，听上去很了不起的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970108,
					"content": "还有这个，我改良了「素材收集器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970109,
					"content": "之前不是必须完成一个工序以后回来一趟嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970110,
					"content": "那之后我就觉得效率有点低，就做了调整，现在它会根据收集的状况更新当前的工序内容了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970111,
					"content": "根据收集状况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970112,
					"content": "调节工序内容？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970113,
					"content": "听不明白…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "哎，该怎么跟你们解释呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970115,
					"content": "比如我在第一道工序需要十个日落果，第二道工序需要水元素，第三道工序需要击败两只水史莱姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970116,
					"content": "现在你带着「素材收集器」，收集了十个日落果，那么它就会判定第一道工序所需材料已全部收集完毕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970117,
					"content": "然后它就会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970118,
					"content": "我懂了，然后它就会自动进入第二个工序的收集模式！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970119,
					"content": "对，它就会进入「元素充能」的模式，补充水元素。等到水元素补充完了以后，又会进行一次变更。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970120,
					"content": "就会进入第三个工序…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "是的，到时候你就只用击败两只水史莱姆就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970123,
					"content": "听上去真的方便了好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970124,
					"content": "是吧，改良这个素材收集器啊，花了我一晚上时间，我愿称它为终极居家三合一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970125,
					"content": "「素材收集器」真是好了不起啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970126,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970128,
					"content": "不过，为什么要把这个「素材收集器」给我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970129,
					"content": "嘿嘿，我暂时被禁足，只能在离岛上…根本没法收集材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970130,
					"content": "帮人帮到底嘛，到时候制造玩具卖出的收入也会给你们一些的，而且这些造出的玩具，你可以免费拿走一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970141,
					"content": "还记得之前给你们的那张券吗，嘿嘿，用那个券就可以免费兑换…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970142,
					"content": "只要是你试出来的玩具造型，随便兑换哪个都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970131,
					"content": "好啊，我们跑前跑后，制造的材料是我们出的，造出来的玩具卖的摩拉大部分归你，玩具也只能留一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970132,
					"content": "#哪有这样的事，我们走，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970133,
					"content": "那…给你们的分成多一些，玩具可以拿走两个…要么…三个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970134,
					"content": "我们走，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "四个！四个！这可是底线了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970136,
					"content": "唉，要是我没欠钱，这些玩具全给你们都行，但是我、我这不还欠着万国商会的钱要还…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970137,
					"content": "哼，看你可怜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "…唉，是呀，我们可是看着你可怜才愿意帮你的，可不是为了分成的摩拉和那四个玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970139,
					"content": "嘿嘿，多谢两位帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970140,
					"content": "这下，总算能够稍微松一口气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726970121,
					"content": "就会进入「核心激活」工序…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}