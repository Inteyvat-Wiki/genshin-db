			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "天衡山…移霄导天真君…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220102,
					"content": "你在想什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "啊，我正在研究璃月海灯节的历史和传说呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220104,
					"content": "我听说这次的「明霄灯」的造型，会是一位名叫「移霄导天真君」的仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220105,
					"content": "根据我搜集到的传说，那位仙人似乎也在某段时间里跟随「岩王帝君」征战…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220106,
					"content": "虽然具体时间和面对的敌人在各种文献中有各种不同的说法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220107,
					"content": "但在各类记载和在坊间流传的说法中，都一致指出这位仙人已经牺牲了。而且这位仙人还以自己的角支撑起了天衡山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220108,
					"content": "所以，我来天衡山，想要实地考察一下，想着如果运气够好，说不定能够找到些什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220109,
					"content": "但天衡山里的魔物众多，我确定了考察地点之后，却发现通往那里的路上都是魔物，压根过不去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220110,
					"content": "旅行者，如果你愿意的话，能不能请你帮我去那边搜索一下，帮我带些「土质样本」回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220111,
					"content": "土质…样本？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "嗯…这是教令院里的说法，其实就是那片区域里的土壤啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220113,
					"content": "既然在璃月的传说中，那位「移霄导天真君」用自己的角支撑起了天衡山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220114,
					"content": "那么从学术角度来说，我认为地质成分中也许会存在一些不同寻常的成分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220115,
					"content": "所以，请你帮我去那里，取一份土壤回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
		{
			"id": 7182202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
