			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220201,
					"content": "鹿角…天衡山…唔，如果是真的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
		{
			"id": 7182203,
			"completionStepIds": [
				7182203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182203",
							"2"
						],
						"stepId": 7182203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "你把样本带回来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220302,
					"content": "已经带回来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "辛苦你了，请给我看一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220304,
					"content": "…唔，这份土壤好像也没什么特别的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220305,
					"content": "你想发现什么吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "根据传说，「移霄导天真君」是为了保护璃月港，用自己强壮的头角支起了即将倾颓的天衡山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220307,
					"content": "我还以为，会至少发现一些「角」的碎片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220308,
					"content": "果然传说也只是传说而已吗…或者说，那场大战距离现在的时间太远，痕迹也基本上消失了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220309,
					"content": "但能够搜集到天衡山的土壤样本倒也不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220310,
					"content": "旅行者，你能再陪我一段路程吗？我想要再往上走走，倒也不会太远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220311,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "这次…我想要去高处俯视一下天衡山，观察一下这里的地形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220314,
					"content": "在传说中，「岩王帝君」和许多仙人们都参与了那次大战，还险些导致天衡山倒塌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220315,
					"content": "如果战况激烈到那种程度…那我也许能从地形里观察出一些东西来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220312,
					"content": "你又想去找什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "总算到这里了…这路可真难走，还有这么多魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220602,
					"content": "这周围的地形…好像也没什么特别的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220603,
					"content": "咦？这棵树上是什么，一盏霄灯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220604,
					"content": "这里怎么会有霄灯？难道有人来这里拜祭那位仙人了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220605,
					"content": "我看看这盏霄灯里写了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220606,
					"content": "「万世安泰，天下太平。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220607,
					"content": "是个很宏伟的愿望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "确实。但这个愿望…怎么说呢，有点太过宏伟了？不像是拜祭，也不像是「愿望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220610,
					"content": "反而像是那种…在璃月传说里的仙人们才会许的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220611,
					"content": "到底是谁会在霄灯上许这种愿望呢？真奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220612,
					"content": "唔，不管怎么说，至少有人还记得来这里放霄灯，那位仙人应该也会很高兴吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220613,
					"content": "谢谢你陪我走了这么远的路，我还想在这里再研究一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220614,
					"content": "对了，这些东西请你收下，就当做是报酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220615,
					"content": "唉，璃月有这么多传说，但我的研究怎么就一点进展都没有呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 718220608,
					"content": "看起来不像是来拜祭的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}