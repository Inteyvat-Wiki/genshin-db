				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "又来了哦！又是我们哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140102,
					"content": "旅行者，派蒙。你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140103,
					"content": "已经习惯像这样和阿贝多见面了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140104,
					"content": "我完成你的委托了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "非常感谢，找你果然是正确的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140107,
					"content": "帮上你的忙了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "当然，你对我的研究工作给予了极大帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140109,
					"content": "嘿嘿，你知道就好~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140110,
					"content": "这份恩情我会牢记在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140111,
					"content": "这把剑还给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "应该足够强了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140113,
					"content": "差不多了。你身体感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140114,
					"content": "和平时一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "那就行，没有副作用，也没有污染和毒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140116,
					"content": "看来…我的认知是正确的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140117,
					"content": "摆出了一副料事如神的表情呢，这家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140118,
					"content": "剑好用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140119,
					"content": "好用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "是吗。不管怎么说，它也达到了我想要的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140122,
					"content": "把剑拿起来了…阿贝多，你要用它吗？你、你不要做傻事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140123,
					"content": "我要把被你净化过的纯粹生命之力提取出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140124,
					"content": "力量也能单独存在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140125,
					"content": "或许别人做不到，但我可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140126,
					"content": "…好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140127,
					"content": "哇，这种力量，好像一个光球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140128,
					"content": "啊！放到神秘的瓶子里了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140129,
					"content": "虽然这把剑算不上神兵利器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140130,
					"content": "做个纪念吧。希望以后它也能在旅途中帮助你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140131,
					"content": "真的可以吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "我要的是与它有关的实验结果，现在我得到了我要的东西，剑应该留给擅长使用它的你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140134,
					"content": "旅行者，谢谢你帮我完成这次研究。那么，再见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140135,
					"content": "能与我发生共鸣的，龙的生命之力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140136,
					"content": "并非因为它是龙，而是因为我的缘故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140137,
					"content": "莱茵多特…师父…这就是你曾经创造的巨龙「杜林」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140138,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140139,
					"content": "我与它的相会，真的是一件好事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412140132,
					"content": "你不需要它了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "不好用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "答应你的事，我都做完了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}