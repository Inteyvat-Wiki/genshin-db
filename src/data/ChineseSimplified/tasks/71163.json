					}
				]
			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "怎么回事？我们怎么来了这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630302,
					"content": "怎么样？喜欢我给你们准备的小玩意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630303,
					"content": "兹白，你在这里啊！这把伞是什么？「嗖」地一下就把我们搬到这里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630304,
					"content": "看来你们的记性也欠佳呢，这就忘了先前与我一同乘过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630305,
					"content": "现在想起来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630306,
					"content": "哦！是…是月宫的高车！难怪刚才就觉得眼熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630307,
					"content": "呵呵，只是我依照记忆仿制的而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630308,
					"content": "#这还要多亏{NICKNAME}拿来的那枚玉节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630309,
					"content": "#噢~原来你之前说要做一个小玩意送给{NICKNAME}，就是这个呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630310,
					"content": "不错，这玉节所制的高车可载着你们快速抵达目的地，应当能为旅途提供些许便利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630311,
					"content": "两位向导，请收好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630312,
					"content": "好厉害…我还以为你只是说说而已呢，没想到这么快就做好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630313,
					"content": "我原以为是要花上一些工夫，毕竟这玉节受损严重，灵气早已散尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630314,
					"content": "但幸运的是，这里是沉玉谷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630315,
					"content": "哦？沉玉谷怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630316,
					"content": "你可知，我们现在所在沉玉谷何处？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630317,
					"content": "呃…遗珑埠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630318,
					"content": "呵呵，你还不够了解这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630319,
					"content": "你我脚踏之地，其实是璃月地脉交汇的关键节点之一，如此节点，共有八处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630320,
					"content": "生死休杜，开景惊伤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "你倒是比我想象中要更加熟悉此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630322,
					"content": "哦！我也想起来了，是地脉中的八门！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630323,
					"content": "不错，这里就是其中的大吉门——生门的中央地带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630324,
					"content": "生门主生长繁荣，万物复苏，因此，我才能在短时间内补足玉节灵气，制出这架高车。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630325,
					"content": "哇，原来这么管用啊？看来沉玉谷真是个风水宝地啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630326,
					"content": "嗯…这才该是你们安居乐业的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630327,
					"content": "你们…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711630328,
					"content": "没什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630329,
					"content": "好啦，我也没有别的事了，去忙你们的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630330,
					"content": "我打算在这山上再走一走，就在这里别过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630331,
					"content": "谢谢兹白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "不必客气。你唤醒了我，是我欠你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630333,
					"content": "主要是钟离的功劳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "同样的话，我也对他说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630335,
					"content": "从他那我还得知，你正行进在一条漫长的旅途中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630336,
					"content": "你的下一站，是那遥远的雪国吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630337,
					"content": "是的，那里是至冬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "至冬…虽然我不清楚那是个什么样的国度，但冰天雪地的路途，想必不能畅通无阻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630339,
					"content": "#{NICKNAME}，往后若是需要助力，你知道在哪里可以找到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630340,
					"content": "我会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "嗯，保重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兹白"
				}
			]
		}
	]
}