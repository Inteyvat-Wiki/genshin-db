					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101603,
					"content": "金灿灿的…还会灼眼睛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101604,
					"content": "风车菊这么亮，「风车」一定也很亮，人们把它装在房子上，大概是用来做灯光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101605
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101605,
					"content": "…风车不是用来干这个的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
