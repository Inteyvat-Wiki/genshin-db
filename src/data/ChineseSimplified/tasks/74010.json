							"7401001",
							"2"
						],
						"stepId": 7401001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100101,
					"content": "为什么呢，为什么不发芽呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100102
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100102,
					"content": "这是在忙什么吗？让我看看…啊，我懂了，这一定就是所谓的「家庭菜园」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100103,
					"content": "菜、菜园？可这明明是花圃…居然会被当成菜园…柯莎果然不是称职的花匠，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100104
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100104,
					"content": "欸，是我认错了吗？对不起啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100105,
					"content": "对哦，之前柯莎说过没有花可以送给我们，就是在说这件事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100106,
					"content": "是呀，柯莎在花圃把花种埋下，全没动静。这些花种，该不会全都坏掉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100107
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100107,
					"content": "好可惜，如果是这样的话，那只能从头做起了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100108,
					"content": "是啊，只能从头做起了呀。柯莎想要美丽的花圃，不想被当成菜园…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100109
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100109,
					"content": "#唔…既然这样，就让什么忙都能帮的小帮手派蒙和大帮手{NICKNAME}来帮帮柯莎吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100110,
					"content": "#派蒙和{NICKNAME}…会种花，会帮助柯莎吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100111,
						740100113
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100111,
					"content": "我之前种过一些花卉和作物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100112
					]
				},
				{
					"id": 740100112,
					"content": "真令人羡慕！…柯莎的愿望是成为厉害的花匠，可种下的花朵总是枯萎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100115
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100115,
					"content": "开始想要移栽，可是移栽的花儿总是不能成活。之后想到要从花种开始培育，花种却迟迟不肯发芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100116
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100116,
					"content": "花儿这么美丽，照顾花儿却这么辛苦…不过人类已经习惯了做辛苦的工作，所以照顾起花儿也很轻松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100117
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100117,
					"content": "可能只是人类种花的地方环境更好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100118
					]
				},
				{
					"id": 740100118,
					"content": "环境…卖花的人类也说，「外面的环境对花儿比较好」。但是种在外面，柯莎就很难去照看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100119
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100119,
					"content": "据说，遥远的地方有各种各样的花。也许，也许其中有些，能适应村里的环境…可惜柯莎出不了远门，不能自己去找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100120
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100120,
					"content": "#嘿嘿，那你碰到对的人了。派蒙和{NICKNAME}游历过许多地方，见到过各种各样的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100113,
					"content": "我见过别人种花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100114
					]
				},
				{
					"id": 740100114,
					"content": "见过别人种花的人类，很容易就能学会。柯莎也见过人类种花，自己做却总失败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100115
					],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100201,
					"content": "比如说风车菊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100202
					]
				},
				{
					"id": 740100202,
					"content": "对呀，风车菊生长在野外，是一种顽强的花朵呢，或许也能在这里成活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100203,
					"content": "「蜂车菊」，陌生的名字呢…是吸引很多蜜蜂的花？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100204
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100204,
					"content": "和蜜蜂没关系啦…「风车」是种装在房子上的东西，有许多花瓣一样的叶片，被风一吹就会骨碌骨碌转圈圈~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100205,
					"content": "风车菊就像风车，也能迎风旋转哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100206,
					"content": "骨碌骨碌转圈圈？…好奇妙！真想现在就能看到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100301,
					"content": "比如说霓裳花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100302
					]
				},
				{
					"id": 740100302,
					"content": "「泥长花」，陌生的名字，也许是种在泥里，花瓣长长的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100303
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100303,
					"content": "不是这样啦…「霓裳」是漂亮衣服的意思，这种花不但美丽，还可以被做成漂亮的衣服穿在身上哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100304,
					"content": "异国的花朵又美丽，又可以穿在身上！…越想越羡慕。好想马上就能看到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201310",
							"3"
						],
						"stepId": 201310,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740100401,
					"content": "比如说鸣草。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100402
					]
				},
				{
					"id": 740100402,
					"content": "对呀，鸣草在天天下雷雨的地方都能生长，海沫村至少没有整天都噼里啪啦嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100403,
					"content": "「名草」，陌生的名字，人类有「园艺会」评选「名花」，异国也评选「名草」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100404
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100404,
					"content": "不不不，「鸣草」不是草，是一种花啦！即便没有风，它也会随雷声隐隐震动，所以，当地的居民还会用它来预报雷雨呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100405,
					"content": "能自己振动的花朵…是什么样子呢？真想早点知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7401005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
