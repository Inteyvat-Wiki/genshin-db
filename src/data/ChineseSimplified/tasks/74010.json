			"dialogs": [
				{
					"id": 740100601,
					"content": "（就先介绍这么多吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100602
					]
				},
				{
					"id": 740100602,
					"content": "哼哼，既然柯莎这么好奇，不如我们来帮你找一些异国的花吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100603,
					"content": "真的吗？那可不可以把这几种全都…唔，不对不对，柯莎要做认真负责的花匠，先照顾好一种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100604
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100604,
					"content": "#{NICKNAME}……愿意帮柯莎，带来哪种花朵呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
