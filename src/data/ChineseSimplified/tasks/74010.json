				"points": []
			},
			"dialogs": [
				{
					"id": 740101801,
					"content": "这就是，能振动的花儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101802
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101802,
					"content": "果然，在不打雷的洞窟里面，鸣草的振动很微弱，几乎看不出来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101803,
					"content": "…真的很难看出来，不过，振动发出的声音很好听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101804
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101804,
					"content": "鸣草的振动…发出的声音好听？我怎么听不见啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101805,
					"content": "…清脆悦耳，怎么也听不够。这么美丽的花朵，振动的响声也这么惹人喜爱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101806
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101806,
					"content": "奇怪，看她那么陶醉，好像真的能听到鸣草振动的声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101807,
					"content": "…对了，如果打「雷」，鸣草就会振动得更厉害，悦耳的声音就会更响吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101808
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101808,
					"content": "一定是这样…花儿都要打肥料，鸣草也一样。那么「雷」这种肥料哪里买得到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101809
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101809,
					"content": "从雷电将军那里？…不对，「雷」可不是肥料啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
