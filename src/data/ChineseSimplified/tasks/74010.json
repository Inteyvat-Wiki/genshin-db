			},
			"dialogs": [
				{
					"id": 740100801,
					"content": "啊，是外面的人。欢、欢迎你们，可是…可是我现在没有花可以送给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100802
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100802,
					"content": "送花？也不用这么隆重吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100803,
					"content": "好吧，那柯莎只能很热情很热情地欢迎你们来到海沫村了，欢迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100804
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100804,
					"content": "谢谢你，柯莎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100805
					]
				},
				{
					"id": 740100805,
					"content": "嗯，柯莎很热情，所以你们有什么想知道的，柯莎都愿意告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100806
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100806,
					"content": "那太好啦，柯莎可以简单介绍一下海沫村吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100807,
					"content": "当然可以。海沫村是很多美露莘的家，嗯…在这里还看不到，再往前走一点就能看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100808
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100808,
					"content": "大家都是很好的美露莘，如果你们也是很好的人的话，大家也会欢迎你们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100809,
						740100812
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100809,
					"content": "我是好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100810
					]
				},
				{
					"id": 740100810,
					"content": "那我也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100811,
					"content": "嗯！那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100818
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100818,
					"content": "接下来应该说什么呢？柯莎想不起来了…但是记得结尾应该是：「祝你们在海沫村度过愉快的时光！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100819
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100819,
					"content": "#好喔！{NICKNAME}，不如我们去看看？就暂时先跟柯莎道别吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100820,
					"content": "再见！希望你们下次来的时候，柯莎已经准备好了花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100812,
					"content": "很难说完全没做过坏事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740100813
					]
				},
				{
					"id": 740100813,
					"content": "啊！怎么会这样…得去告诉在逐影庭工作的伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100814
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100814,
					"content": "#呜哇！{NICKNAME}只是在开玩笑的！我们没做过要被逐影庭盯上的坏事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100815,
					"content": "…真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100816
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740100816,
					"content": "真的！当然是真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740100817,
					"content": "好吧，柯莎相信你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740100818
					],
					"speakerTitle": "柯莎"
				}
			]
