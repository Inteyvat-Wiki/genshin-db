				"points": []
			},
			"dialogs": [
				{
					"id": 740102001,
					"content": "没想到，柯莎对花朵的印象会和我们差别这么大…解释起来又那么困难…有点伤脑筋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102002,
					"content": "为什么要伤脑筋呢？派蒙认为很美丽的花朵，在柯莎眼中也是一样的美丽呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102003
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102003,
					"content": "美丽是美丽，但并不「一样」啦…不过喜爱花朵的心情确实是共通的。那就先不纠结这些，好好地照料花朵吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740102004,
					"content": "嗯！接下来柯莎要去打些<color=#00E1FFFF>水</color>来，浇灌珍贵的花朵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740102005
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740102005,
					"content": "没必要跑一趟，让我来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740102006
					]
				},
				{
					"id": 740102006,
					"content": "#对呀，放心交给{NICKNAME}吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
