			"dialogs": [
				{
					"id": 740101701,
					"content": "原来霓裳花是像水珠一样的花朵，晶莹剔透。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101702
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101702,
					"content": "欸，霓裳花晶莹剔透？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101703,
					"content": "把晶莹剔透的霓裳花穿在身上，就像披着瀑布，柯莎没见过这样的衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101704
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101704,
					"content": "我其实也没见过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740101705,
					"content": "…对了，这就是人类的「时尚」！「时尚」就是越奇怪越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740101706
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740101706,
					"content": "霓裳花不是这样用的，时尚也不是这种东西啦…大概不是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
