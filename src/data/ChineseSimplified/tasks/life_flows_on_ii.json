				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "我已经和洛蒂娅说明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220102,
					"content": "她是我们纯水精灵密探中最为有名，也是最为强大的一位。不过她却怀揣着对上一任水之神的思念，叛逃了枫丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220103,
					"content": "我也已经回不去枫丹了，所以我就全部告诉你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220104,
					"content": "我们纯水精灵曾经分布在全大陆的山川河流、小池溪水之中，绝大部分都是枫丹的间谍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220105,
					"content": "呜啊！水之神究竟在计划着什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220106,
					"content": "曾经的那位没有什么计划，只是想要像是水系一样，贯通大陆，把大家联系在一起。可随着她的消逝，许多精灵切断了和枫丹的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220107,
					"content": "就像是最强大的洛蒂娅，并不认可新的水之神，只想怀抱着曾经的梦活下去而已。洛蒂娅她，只想要一方静水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220108,
					"content": "但是她察觉到了我，误以为我是枫丹的刺客。所以她散出恶意，变苦河流，想要消灭我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220109,
					"content": "可是你当初明明这么弱小，她至于这么大费周章嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220110,
					"content": "纯水精灵的主导意识，很容易因为融合了一个有恶念的小意识就崩溃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220111,
					"content": "我很向往洛蒂娅，所以靠着寄宿水史莱姆，在水系间跳跃，远离枫丹来到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220112,
					"content": "除了背负任务的刺客，应该没有别的纯水精灵能有我这样的执着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220113,
					"content": "某种程度上，是听起来挺厉害的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220114,
					"content": "#不过我也一样，是被{NICKNAME}载着迟早要横跨七国的人哦。和我的伟绩相比，你还差了点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220115,
					"content": "喂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "我已经和她解释清楚了，水的苦味应该不久就会消失了。最后她还询问我，是否还想要融入轻策之水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220117,
					"content": "所以你是来告别的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220118,
					"content": "我还有一条信息需要传达呢。请你们陪我再去一次清泉镇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嫣朵拉"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
							"2"
						],
						"stepId": 4142202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老芬奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "芬奇，芬奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220202,
					"content": "哎哟，吓我一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220203,
					"content": "嫣朵拉她学习东西进步神速。会被吓到也是当然的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220204,
					"content": "只是觉得，会喊我芬奇，真像是她啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220205,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220206,
					"content": "「每天都有一个孩子蹒跚向前，世间一切由他自己去发现。他的所见变成了他的一部分——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220207,
					"content": "「这个孩子蹒跚向前，如此一生的时间。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220208,
					"content": "我知道这首诗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220209,
					"content": "我们的生命和你们的生命有很大不同。所以可能我们在活着的时候，无法互相理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220210,
					"content": "但是我们的生命，也都是一样的。一直都在迎接新事物和新转机的过程里，奔流到海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220211,
					"content": "所以她说：「在夜空里所有星星熄灭的时候，所有溪流、所有的梦想，都能汇入同一片大海之中。那时我们终会再见的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220212,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220213,
					"content": "生命之流还在前行，请你也迈开脚步，不要驻足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220214,
					"content": "哈哈哈，果然是她。还是一副把我当小孩子的语气啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220215,
					"content": "好了，请让我一个人静静吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414220216,
					"content": "#那{NICKNAME}，我们也应该找康纳回复了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142203",
							"2"
						],
						"stepId": 4142203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"康纳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "哦哦，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414220302,
					"content": "我猜想如果是你们出马的话，事情应该完美解决了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414220303,
					"content": "那是当然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "大概过几天水的苦味就会消散了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220306,
					"content": "哦，我明白我明白。就算消除了源头，还得给水一点时间让它自我清洁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414220307,
					"content": "那我就联系冒险家协会结案了。实在是太感谢两位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "康纳"
				},
				{
					"id": 414220304,
					"content": "虽然过程有点复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "我们族群表达喜爱的方式，是把双方的水体融汇在一起。这样多个意识就可以无隔阂的相处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220402,
					"content": "但理解世界上其他生命却没有这么简单。因此我们观察、研究、模仿，幻化出动物的样子。也可以说，它们的模样变成了我们的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220403,
					"content": "望着流逝的河水，嫣朵拉开始了高深话题的思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220404,
					"content": "我以前也从来没有思考过以后的生命如何度过。我以前一直觉得和洛蒂娅融为一体就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220405,
					"content": "但是洛蒂娅看起来并不开心。她自己也明白，她只是在等待着净水腐败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220406,
					"content": "所以你的选择是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "不论是洛蒂娅还是清泉镇的她，似乎都不想让我走上她们的路。但是她们肯定更加讨厌枫丹的生活吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220409,
					"content": "你们这种生命真的很奇妙，所以我也没办法提出什么有用的建议。不过我觉得，生命还是过得开心一点比较好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414220410,
					"content": "所以，我决定选一条从没有前人选过的路。因为和你们相处的旅行很开心，我想要以后每天都这么开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414220411,
