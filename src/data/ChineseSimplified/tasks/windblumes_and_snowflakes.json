						700090811
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090811,
					"content": "好吧…你都送我礼物了，那我就再讲几个故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090812
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090812,
					"content": "好耶！那窝要听…驴人众的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090813
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090813,
					"content": "咳！这个…这个没什么…没什么趣，我想个更有意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
