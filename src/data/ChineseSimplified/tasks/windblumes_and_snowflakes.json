			},
			"dialogs": [
				{
					"id": 700090401,
					"content": "狗狗来这边…有很好词的喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090402
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090402,
					"content": "哇！狗狗真过来了，嘻嘻，窝要去摸摸它啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090403
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090403,
					"content": "嘻嘻，狗狗摸起来好软…那个驴人众蜀黍说，他们家辣边，也有狠多狗狗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090404
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090404,
					"content": "但他说，他家那边的狗狗，都狠大狠大，毛也狠多狠多…肯定也狠好摸吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				}
			]
		},
