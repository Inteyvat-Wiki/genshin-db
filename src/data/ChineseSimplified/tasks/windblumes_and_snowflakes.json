					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090804
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090804,
					"content": "蒲公英…还有这个烤松饼是怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090805
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090805,
					"content": "是礼物吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090806
					]
				},
				{
					"id": 700090806,
					"content": "礼、礼物？蒲公英就只剩下了个杆子，还有这烤松饼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090807
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090807,
					"content": "这烤松饼可是莉莉亲手做的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090808
					]
				},
				{
					"id": 700090808,
					"content": "…看着真是…不错。没想到这孩子还有这手艺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090809
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090809,
					"content": "嘻嘻，这都是窝学的我麻麻，蜀黍，吃完了之后，窝还要听你讲故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090810
					],
					"speakerTitle": "莉莉"
				},
				{
