			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "蜀黍，你们驴人众，过不过风化节呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090102,
					"content": "唔，我应该过不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090103,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "咦？怎么是你，喂，你为什么又是一副怀疑的表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090105,
					"content": "我就是在这里陪着这孩子说说话，又没做什么坏事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090106,
					"content": "看来愚人众真的不过风花节。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，呢也不过…过风画节呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090108,
					"content": "欸，那是啊，这蒙德城的「荣誉骑士」，怎么能过风花节呢，这肯定要去执勤啊，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090109,
					"content": "你怎么一脸得意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "咳…咳，算了，不和你说这么多了，我看你闲着也是闲着，不如来帮我个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090111,
					"content": "这孩子的父母，因为城里这个吵吵嚷嚷的节日，也要出去采购，所以就把这孩子放在这里，拜托修女照顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090112,
					"content": "但是你也知道，风花节嘛，城里城外都忙成了一团，修女们各忙各的，也没空来陪这孩子玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090113,
					"content": "所以，她就缠上我了，一个劲地要我陪她玩，但你也知道，我是不可能出教堂的。所以我也只能在这陪她说说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090114,
					"content": "可惜啊，我是个「愚人众」，就算是和这孩子说话，旁边的那位修女也在不停地瞪我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090115,
					"content": "我看，她准是觉得我这个「愚人众」图谋不轨，又想打什么坏主意吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090116,
					"content": "哼，为了不让那位修女过来烦我，也为了这孩子的「身心健康」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090117,
					"content": "我想拜托你这位光荣又正派的「荣誉骑士」，陪着这孩子出去玩玩，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090118,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "哦唷，这么干脆。不愧是「荣誉骑士」嘛，我还以为你还要和我讨价还价，要点什么报酬呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090120,
					"content": "赶紧带着这孩子出去玩吧，我接着在这呆着，吃那些修女的白眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090121,
					"content": "唉，这日子到底啥时候能到头啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090122,
					"content": "你其实就是想让莉莉能出去玩吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "你…你算了吧，我是「愚人众」，是坏人，知道了吗？怎么可能有这么好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090124,
					"content": "哎呀，行了行了，你快点带着这孩子出去玩吧，我看她在教堂里都要憋坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090125,
					"content": "我嘛…我就接着呆在这，吃那些修女的白眼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 700090126,
					"content": "唉，这日子到底啥时候能到头啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
		{
			"id": 7000902,
			"completionStepIds": [
				7000904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000904",
							"2"
						],
						"stepId": 7000904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，为什么那个驴人众的蜀黍，不过风画节呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090202,
					"content": "他有重要的工作要做。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "纵要的工作？唔…比过风画节还纵要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090207,
					"content": "可是，那个蜀黍就算干了这么坏这么坏的事，只要改掉，他也能变成很好很好的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090208,
					"content": "嗯！窝要去和那个蜀黍说，只要变得很好很好，他就能过风画节了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090209,
					"content": "那个叔叔现在很忙，我们出去玩玩，好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "#欸…好吧。那，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，你可以带窝出去玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090211,
					"content": "没问题，别走太远就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "好欸！那窝们快出去玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090204,
					"content": "「愚人众」应该参加不了风花节。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "为森么呀？是不是因为…驴人众很坏很坏？把拔缩，碎觉卜刷牙、赤饭时用手抓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090206,
					"content": "唔唔，辣样是很坏呢，蜀黍的把拔看了肯定会生气的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "莉莉"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布兰琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "旅行者？你有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090303,
					"content": "还有…莉莉？你怎么来了，你爸爸和妈妈呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090304,
					"content": "#把拔和麻麻有很纵要的事要做！所以这个{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}在带我玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090305,
					"content": "很重要的事？鲁道夫先生和吉丽安娜小姐还真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090306,
					"content": "大捷洁，刚才那个小狗狗在哪里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090307,
					"content": "刚才的小狗？唔…我也不知道，平时它们基本上都躲在自己的窝里，只在我往食盆里放食物的时候，它们才过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090308,
					"content": "可能是因为现在城里太热闹了，它们都被吵得跑出来了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090309,
					"content": "怎么，莉莉，你是想和它们玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090310,
					"content": "嗯！窝想和它们玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090311,
					"content": "这样啊…我想想，光是找肯定是找不到的…那你们不如去那边的食盆里放点吃的，把它们引出吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090312,
					"content": "唔，我想想…小狗的食盆里最好放些禽肉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090313,
					"content": "欸…可是这些，都要去辣里找呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090314
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090314,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090315
					]
				},
				{
					"id": 700090315,
					"content": "#哇！谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，那窝们快点去喂它们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				}
			]
		},
