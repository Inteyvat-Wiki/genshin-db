					"芙萝拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090602,
					"content": "呼呼，你们好呀？你们是来买花的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090603
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700090603,
					"content": "真的有好多花花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090604
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090604,
					"content": "咦，莉莉？你怎么和这位旅行者在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090605
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700090605,
					"content": "#把拔和麻麻有很纵要的事要做！所以这个{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}在带我玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090606
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090606,
					"content": "重要的事啊…我差不多也猜到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090607
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700090607,
					"content": "先不说这些了，你们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090608
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700090608,
					"content": "是来看花的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090609
					]
				},
				{
					"id": 700090609,
					"content": "看花…唔，这样吧，我这里刚好有一株蒲公英，送给你吧莉莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090610
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700090610,
					"content": "真的嘛？谢谢——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090611
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090611,
					"content": "为什么突然就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090612
					]
				},
				{
					"id": 700090612,
					"content": "其实…是因为鲁道夫先生之前刚在我这里订了一大捧花，要送给吉丽安娜小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090613
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700090613,
					"content": "现在只是送一株蒲公英而已，没什么大问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090614
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700090614,
					"content": "蒲公英真好看…不过，窝应该要回去了，不然把拔麻麻回来看不见我会着急的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090615
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090615,
					"content": "#对了，回去之前…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}，尼知道城里哪里有那种…大大的锅吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090616
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090616,
					"content": "#窝之前看过我麻麻做「烤松饼」…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}陪我玩了这么久，窝来做点好次的给尼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				}
			]
		},
