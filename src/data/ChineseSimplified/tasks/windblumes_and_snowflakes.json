				"points": []
			},
			"dialogs": [
				{
					"id": 700090502,
					"content": "莉莉，旅行者，你们回来了？怎么样，找到小狗了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090503
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090503,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090504
					]
				},
				{
					"id": 700090504,
					"content": "嗯！谢谢大捷洁，窝和它们玩得狠好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090505
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090505,
					"content": "这样就好了。对了，你们要是有空的话，也可以去芙萝拉小姐那边看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090506
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090506,
					"content": "毕竟是风花节，能够带一束花回去的话，感觉也不错，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090507
					],
					"speakerTitle": "布兰琪"
				},
				{
					"id": 700090507,
					"content": "#哇…窝想去看看，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090508
					],
					"speakerTitle": "莉莉"
				},
				{
					"id": 700090508,
					"content": "我们过去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090509
					]
				},
				{
					"id": 700090509,
					"content": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉"
				}
			]
		},
		{
