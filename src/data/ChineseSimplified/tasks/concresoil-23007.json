			"dialogs": [
				{
					"id": 230070201,
					"content": "目前我有几个想法，今天的话…我想找一些浸有史莱姆凝液的泥土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070202,
					"content": "我找人打听到了一处史莱姆的聚集地，旅行者，你能帮我去取些泥土回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070203,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "那就拜托你了，打不打倒那些史莱姆都行，只要取一些它们聚集地附近的泥土回来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070205,
					"content": "我把那片史莱姆聚集地的方位给你标在地图上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070206,
					"content": "你自己不去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "我也想自己去，但我还要去解决一些坛坛罐罐的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070208,
					"content": "放心吧，我会为你准备好合适的报酬的，这件事就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070209,
					"content": "请你去这里找一找吧，我帮你标在地图上…",
					"roleType": "TALK_ROLE_NPC",
