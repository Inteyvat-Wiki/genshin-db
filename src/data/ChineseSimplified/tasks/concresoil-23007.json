			"dialogs": [
				{
					"id": 230070101,
					"content": "有没有更好用的材料呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070102,
					"content": "什么材料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "抱歉，我又在自言自语了。最近天气变化莫测，房屋出问题的情况很多，我有点忙不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070104,
					"content": "你不是做陶器的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "是这样没错，但我也是泥瓦匠，都是和泥土打交道的事，也没差啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070106,
					"content": "你听过那句话吗？「做学问就像盖房子，要想起高楼，就要打好地基。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070107,
					"content": "「想要扩展学术理论，就要夯实根基，正所谓基础不牢，地动山摇…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070108,
					"content": "上面的聪明人总把这话挂在嘴边，虽然我不是很懂，但你看，他们把建房子看得和做学问一样重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070109,
					"content": "那只是比喻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "不管怎么说，提到房屋的基础，就会想到建材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070112,
					"content": "泥土作为粘合与支撑材料，如果能强化它的强度与适应性，房子就会更坚固，我也不用这么忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230070110,
					"content": "应该不是这么解读的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
