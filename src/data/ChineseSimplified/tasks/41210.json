			"dialogs": [
				{
					"id": 412109901,
					"content": "阿贝多先生的秘密一定很厉害吧，否则，为什么要保密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "砂糖"
				}
			]
		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"砂糖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "呀，是砂糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100202,
					"content": "你也来雪山探险吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100203,
					"content": "呜哇！吓我一跳…请不要在我思考研究报告的时候突然吓唬我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100204,
					"content": "可你看上去只是呆呆地站着而已呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100205,
					"content": "没、没有这种事，我明明是在为新研发的四倍大种子甜甜花取名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100206,
					"content": "四倍大种子甜甜花一定好吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "哦哦？你感兴趣吗！太好了，下次请务必给我向你展示新成果的机会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100209,
					"content": "好可惜，要不是来雪山，我一般都会把成品带在身边的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100210,
					"content": "对哦，你不是在城里做研究吗？怎么跑到这里来啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100211,
					"content": "我和蒂玛乌斯在帮阿贝多先生整理实验数据哦。蒂玛乌斯刚走，你们没遇到他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100212,
					"content": "没有哎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100213,
					"content": "他说自己对数据不够敏锐，比阿贝多先生差了太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100214,
					"content": "有些东西先生一眼就能看出来，我们却要想很久。恐怕这就是学识与经验的差距吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100215,
					"content": "因为沮丧，他就说要去别处散散步，我一个人先做剩余的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100216,
					"content": "（总觉得蒂玛乌斯是不是故意的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "本想做完手上的事四处转转，没想到从报告里找到了一些有趣数据！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100218,
					"content": "唉…我的探秘之旅，又要延后了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100219,
					"content": "探秘？什么秘？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100220,
					"content": "啊…这么说来，你们现在有空吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100221,
					"content": "有呀！我们正在到处闲逛呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100222,
					"content": "能请你们帮我一个忙吗？事实上，我总觉得…阿贝多先生有事瞒着我和蒂玛乌斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100223,
					"content": "阿贝多不是你们的老师吗？老师能有什么事瞒着学生呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100224,
					"content": "是啊，可他似乎一直在掩藏某件东西…我猜，一定是与炼金术有关的厉害东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100225,
					"content": "明明不知道实情，为什么还能这么肯定啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100226,
					"content": "因为我和蒂玛乌斯都是炼金术的狂热研究者，如果是别的东西，阿贝多先生没必要瞒着我们才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100227,
					"content": "啊…这么一说确实很有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100228,
					"content": "能帮我调查一下阿贝多先生到底藏着什么吗？我实在是太好奇了！拜托拜托！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100229,
					"content": "唔…你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100230,
					"content": "如果砂糖想知道，我可以一探究竟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "哇啊——！太好了，谢谢你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412100233,
					"content": "好吧好吧，那就让我们走一趟吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100231,
					"content": "我也想知道阿贝多的秘密收藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "这是可以吃的东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
			"completionStepIds": [
				4121004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121004",
							"2"
						],
						"stepId": 4121004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "阿贝多——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100302,
					"content": "嗨，又是我们哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "嗯？你们怎么回来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100304,
					"content": "迷路了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100305,
					"content": "不是啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100306,
					"content": "在路上接了砂糖的委托，来调查你的秘密。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "哦？秘密？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100309,
					"content": "啊啊啊，你在干什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100310,
					"content": "这种时候不是应该悄悄调查吗？怎么就说出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100311,
					"content": "反正也瞒不过阿贝多吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "呜…就算你这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100313,
					"content": "来得正好，我也有事要找你，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100314,
					"content": "接着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100315,
					"content": "咦，这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100316,
					"content": "如你所见，一把单手剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100317,
					"content": "原来你会锻造？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "剑不是我打的，不过，我刚才在上面施了炼金术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100320,
					"content": "想试试吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100321,
					"content": "哎？要把它给我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "根据我的研究，这把剑情况特殊，只有你能使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100323,
					"content": "但我现在迫切需要它的数据，麻烦你拿着它多多战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100324,
					"content": "喂喂，等一下，怎么会有只给一个人使用的剑呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100325,
					"content": "该不会有什么副作用吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "很敏锐嘛。这把剑确实不同寻常，它受到了某种诅咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100327,
					"content": "寻常人完全无法使用这把单手剑，但你不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100328,
					"content": "哎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100329,
					"content": "可以说，这把被诅咒的剑唯独对你没有害处。既然如此，除了你我还能找谁帮忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100330,
					"content": "多说无益，到附近找几只怪物吧。有些事，一试便知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100318,
					"content": "炼金术士也要兼职铁匠吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "砂糖说你有些不可告人的小秘密。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
		{
			"id": 4121004,
			"completionStepIds": [
				4121006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121006",
							"2"
						],
						"stepId": 4121006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凶恶的男人"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "找到了！就是那个小兔崽子拿着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "凶恶的男人"
				},
				{
					"id": 412100402,
					"content": "把东西交出来，小偷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "凶恶的男人"
				},
				{
					"id": 412100403,
					"content": "盗宝团？这么冷的地方也会有盗宝团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100404,
					"content": "少废话！给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "凶恶的男人"
				},
				{
					"id": 412100405,
					"content": "小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
						],
						"stepId": 4121008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "盗宝团居然叫我们小偷，明明他们自己才是小偷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100502,
					"content": "这些人来得可真快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100503,
					"content": "阿贝多，你是小偷吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "怎么可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100506,
					"content": "他们说的东西，好像就是这把剑，到底是怎么回事呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100507,
					"content": "你那是什么表情？我当然不可能去偷剑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100508,
					"content": "不久前，骑士团在蒙德城外抓捕了一批盗宝团，他们非法搬运的赃物也被全数收缴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100509,
					"content": "这把剑就是其中之一。说是赃物，却没人认领，也不知从哪儿来的，一直丢在仓库里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100510,
					"content": "我去仓库拿东西的时候意外注意到了它。说真的，旧成这样的剑除了拿来做炼金材料恐怕别无他用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100511,
					"content": "噫，怎么能把赃物说成是自己的东西呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100512,
					"content": "然后呢？你就把它拿走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100513,
					"content": "嗯，我拿这把剑是想做实验用，却没想到，在调查过程中发现了它的真实来历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100514,
					"content": "这把看似老旧的武器出自某位已故铁匠之手，是传说中的魔剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100515,
					"content": "魔剑？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100516,
					"content": "据说，铁匠在铸剑后不久便失踪，剑也下落不明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100517,
					"content": "根据赃物来源反推，它多半是被盗宝团偷走，由此失传至今。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100518,
					"content": "啊！造剑的人失踪了？！好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100519,
					"content": "怪不得是被诅咒的魔剑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100520,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100521,
					"content": "人类竟然能造出这样的魔剑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "你知道关于<color=#00E1FFFF>「杜林」</color>和这座雪山的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>「杜林」</color>，就是数百年前<color=#00E1FFFF>「风神巴巴托斯」</color>与<color=#00E1FFFF>「特瓦林」</color>联手击败的、威胁蒙德的黑龙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100524,
					"content": "激战最后，被打败的杜林从空中坠落，跌入了茫茫白雪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100525,
					"content": "雪山上的积雪终年不化，是一件非常奇妙的事。杜林落在这里，究竟是偶然还是必然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100526,
					"content": "还能是必然吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100527,
					"content": "选择雪山作为坟场，说不定是想利用这种冰封一切的力量来抑制杜林身上的腐殖之毒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100528,
					"content": "巴巴托斯那样的神明，应该能想到这一办法才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100529,
					"content": "哇…巴巴托斯那么厉害的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100530,
					"content": "这些只是我的猜测，并没有依据。但可以确定，这座雪山与杜林有着千丝万缕的瓜葛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100531,
					"content": "而你手中这把剑的材料里，应该就有杜林的残骸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100532,
					"content": "龙的残骸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100533,
					"content": "嗯。将死去的龙的眼睛、指甲、鳞片……磨成粉末涂抹到剑身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100534,
					"content": "这样一来，杜林的污秽与毒便能融入剑中，成为剑的威力来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100535,
					"content": "这是非常高超的工艺，铁匠在铸剑成功后，一定会因为喜悦而亲自试剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100536,
					"content": "只要他使用这把剑来战斗，剑上的污秽之力就会顺着剑柄传入他体内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100537,
					"content": "常人无法抵抗这种力量，因诅咒而精神错乱的铁匠四处疯逃，说不定，就在某处遭遇了不测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100538,
					"content": "呜哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100539,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "你净化过特瓦林的泪滴，有着极为罕见的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100541,
					"content": "这份力量确保了你不仅不会被污秽和毒性腐蚀，还能彻底消除它们的危险性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100542,
					"content": "所以，只有你能好好地使用这把剑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100543,
					"content": "话虽如此，这把剑果然还是太…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100544,
					"content": "它、它好像在发光？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412100545,
					"content": "对我来说，这正是实验开始的信号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100546,
					"content": "这把剑现在还很弱，可它能吸收力量，通过这种方法，它会不断增强自身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100547,
					"content": "从某种意义上说，也算是「活物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 412100548,
					"content": "旅行者，拿着它尽情冒险吧，我需要你来让它不断成长。",
