			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120050101,
					"content": "嗯？这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050102
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050102,
					"content": "是祭典的广告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050103,
					"content": "这么说来，我们来稻妻至今还没去过这种热闹好玩的场合呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050104,
					"content": "绫华是想去祭典吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050105
					]
				},
				{
					"id": 120050105,
					"content": "不、不是这样的！咳咳…我是说，祭典什么的，在稻妻很是常见，我们社奉行早就习惯了这样的风俗哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050106
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050106,
					"content": "每逢时节，稻妻的居民都会参加祭典，相对的，治安难度也会增加…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050107
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050107,
					"content": "所以，祭典固然开心热闹，对我们来说却是一件值得操心的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050108
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050108,
					"content": "啊！都怪我考虑工作，害大家跑题了…抱歉，我要去的是旁边这家店铺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050109
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050109,
					"content": "原来不是要看这个招牌啊，那我们去店里看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050110,
					"content": "最新款式的衣服，来看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050111
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050111,
					"content": "呀，是神里小姐跟异乡的客人们！欢迎光临小仓屋，几位想买布料还是定制成衣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050112
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050112,
					"content": "您好，我这边有份服装设计图纸，想劳烦您看一看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050113
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050113,
					"content": "哦哦！掏出了早就准备好的图纸呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050114,
					"content": "我看看…嗯？这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050115
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050115,
					"content": "依您之见，这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050116
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050116,
					"content": "这是一份非常不错的设计稿哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050117
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050117,
					"content": "神里小姐是想定做这样的着物对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050118
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050118,
					"content": "嗯，麻烦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050119
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050119,
					"content": "您愿意来本店定制服装，我们小仓屋非常荣幸，不过…有件事比较棘手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050120
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050120,
					"content": "定做您想要的这件着物，需要用到霓裳花制成的丝绸。稻妻的丝绸大多是从璃月港进口的，但眼下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050121
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050121,
					"content": "唉，您也知道，稻妻正处于锁闭状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050122
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050122,
					"content": "说实话，服装业受到了不小的影响，我们很难进到高档布料，成衣定制的业务也因此搁置了好一阵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050123
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050123,
					"content": "不过，要是客人能自备布料，我们就能帮忙做出衣服哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050124
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050124,
					"content": "意思是需要我们自己去买布？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050125,
					"content": "连小仓屋都弄不到的高档布料…还有哪里能买到呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050126
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050126,
					"content": "您可以到万国商会看看。他们的渠道比我们多些，毕竟都是来自全大陆各地的商贩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050127
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050127,
					"content": "就是价格可能有些贵，但在这样的非常时期，我想…能买到想要的东西就算不错了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050128
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050128,
					"content": "原来在稻妻，定做衣服也变得这么麻烦了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050129,
					"content": "说起来，万国商会就是久利须那边对吧？我们确实是好一阵子没去离岛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050130,
					"content": "嗯…看来得到万国商会走一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050131
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050131,
					"content": "非常感谢，等我们买到布料再回来找您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050132
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050132,
					"content": "在此之前，我还有一个小小的请求，能不能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050133
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050133,
					"content": "绫华神神秘秘的，在说什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050134,
					"content": "嗯、嗯…没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050135
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050135,
					"content": "那就拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050136
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050136,
					"content": "神里小姐客气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050137
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050137,
					"content": "说真的，我们小仓屋也好久没做丝绸面料的着物了呢，图纸又很漂亮…我跟你们一样非常期待哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050138
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120050138,
					"content": "谢谢您。那我们就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050139
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050139,
					"content": "旅行者，派蒙，我们去万国商会碰碰运气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				}
			]
		},
		{
			"id": 1200502,
			"completionStepIds": [
				1200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200506",
							"2"
						],
						"stepId": 1200506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久利须"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120050201,
					"content": "喂你们看！久利须会长在那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050202,
					"content": "应该就是那位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050203
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050203,
					"content": "呜呜，这下可怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050204
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050204,
					"content": "久利须先生，您没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050205
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050205,
					"content": "噢、噢噢！您是神里家的…绫华小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050206
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050206,
					"content": "您好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050207
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050207,
					"content": "旅行者也在啊。好久不见，我猜你最近是离开离岛了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050208
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050208,
					"content": "是啊，好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050209
					]
				},
				{
					"id": 120050209,
					"content": "上次的事真是多谢你啦，多亏了你，我们商会的生意才又能周转起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050210
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050210,
					"content": "欸，话说…你怎么站在这里发呆呀，是遇到麻烦事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050211,
					"content": "我…我…唉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050212
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050212,
					"content": "说来丢人，我们万国商会的货物被浪人抢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050213
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050213,
					"content": "货物的具体内容是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050214
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050214,
					"content": "是一批高档丝绸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050215
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050215,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050216
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050216,
					"content": "前些年我们从璃月进了一大批丝绸，一直堆在仓库里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050217
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050217,
					"content": "最近听说，稻妻城内各个服装店积压的丝绸都卖得差不多了，我们正想着把这批货提出来卖个好价钱，谁知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050218
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050218,
					"content": "唉！那些浪人一截下我们的货，就立刻带着东西逃到树林里去了。我想报案，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050219
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050219,
					"content": "您也知道，我们这种外国商贩本就不受待见。「勘定奉行」的人一点儿都不想搭理我们，甚至巴不得我们倒霉呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050220
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050220,
					"content": "虽然我个人也不怎么认可「勘定奉行」的行事作风，但久利须先生，这里毕竟是稻妻，请注意您的发言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050221
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050221,
					"content": "噢，抱歉，忍不住就抱怨了起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050222
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050222,
					"content": "现在也没有更好的办法，单凭我们商会，怕是没法追回货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050223
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050223,
					"content": "唉，或许这就是注定的破财之灾吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050224
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050224,
					"content": "虽然不能走公务流程，但我可以帮您找回丢失的货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050225
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050225,
					"content": "当然当然，您…哎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050226
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050226,
					"content": "哎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050227,
					"content": "这样真的没关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050228
					]
				},
				{
					"id": 120050228,
					"content": "嗯。不过，虽然是以个人身份出面处理这次的事，但我的一言一行，多少都会关系到社奉行与神里家的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050229
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050229,
					"content": "我有一些顾虑，所以…希望您能为我保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050230
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050230,
					"content": "另外，人生在世，谁都不能保证遇到困难时会有人对自己出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050231
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050231,
					"content": "以您和万国商会的立场，我建议…平日还是多加小心，以免蒙受不必要的损失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050232
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050232,
					"content": "一定、一定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050233
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050233,
					"content": "可是，这样会不会给您个人带去麻烦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050234
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050234,
					"content": "万一勘定奉行的大人们对您有什么意见…您在民间声望很高，犯不着为了我们这种小人物蒙受损失啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050235
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050235,
					"content": "您说笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050236
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050236,
					"content": "怎么说我也是神里家的大小姐。单凭勘定奉行的各位，应该还没有资格追究我的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050237
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050237,
					"content": "呜哇，好有气势的发言！这就是贵族大小姐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050238,
					"content": "久利须先生，请您将货物被劫的时间、地点以及抢劫者的特征告诉我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050239
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050239,
					"content": "太感谢了，太感谢了！时间是两个小时之前，事发地点是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050240
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050240,
					"content": "各位，请随我到事发地点进行调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050241
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050241,
					"content": "好，出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
