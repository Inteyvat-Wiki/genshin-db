					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051001,
					"content": "太好了！唔，除了丝绸，其他辅料本店应该都有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051002
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120051002,
					"content": "我去清点材料，很快就好，各位，请先在这里稍等片刻哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051003
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120051003,
					"content": "一定要有哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051004,
					"content": "希望这次不缺什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051005
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051005,
					"content": "说起来，旅行者，其实我一直想给你也添置一套新衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051006
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051007,
					"content": "谢谢你，我这样就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051008
					]
				},
				{
					"id": 120051006,
					"content": "只是…不知道你习不习惯稻妻的特色服饰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051007
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051009,
					"content": "这身衣服对我来说具备特殊意义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051011
					]
				},
				{
					"id": 120051010,
					"content": "专注外表的话，会让我的剑变钝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051011
					]
				},
				{
					"id": 120051008,
					"content": "哎？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051009,
						120051010
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051011,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051012
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051012,
					"content": "果然，优秀的旅行者都有一套自己的行事准则与着装风格呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051013
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051013,
					"content": "出门在外，很多事也是不得已呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051015,
					"content": "没有这么小的尺寸吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051016
					]
				},
				{
					"id": 120051014,
					"content": "不过，我倒是很想试试看稻妻的特色服装哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051016,
					"content": "什么嘛，想做的话还是可以做的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051018,
					"content": "绫华，你太客气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051020
					]
				},
				{
					"id": 120051019,
					"content": "派蒙跟我都这样就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051020
					]
				},
				{
					"id": 120051017,
					"content": "哈哈哈，你们的交流真可爱…咳！不、不是，我是说，如果派蒙想要，我可以找人帮你定做衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051018,
						120051019
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051020,
					"content": "这样啊…好的，那就按旅行者说的来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051021
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051022,
					"content": "会穿得非常奇怪哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051023
					]
				},
				{
					"id": 120051030,
					"content": "会穿得非常讲究哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051031
					]
				},
				{
					"id": 120051021,
					"content": "说起来，其他国家的人一般都会穿什么风格的衣服呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051022,
						120051030
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051023,
					"content": "对对，什么样子都有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051024,
					"content": "戴着兜帽的、脸上挂着半片面具的、穿得像只孔雀的、露出一截肚子的、衣服特别紧身的…没有不可能，只有你想不到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051025,
					"content": "真的吗？完全没有标准，全凭喜好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051026
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051026,
					"content": "哇，真不错…不知为什么，有点向往…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051027
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051027,
					"content": "莫非你也想穿奇怪的衣服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051028,
					"content": "不不，怎么会！我只是…只是很佩服那些随心所欲的人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051029
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051029,
					"content": "真想走遍七国，看看别人过着怎样的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051038
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051031,
					"content": "对对！每个国家各有特色，典雅、高贵、随性…虽然各不相同，却又都符合各自特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051032
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051032,
					"content": "着装是门非常高深的学问，我也还在努力学习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051033
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051033,
					"content": "能让衣服衬托自身气质，成为自己身体的延伸…是一件非常棒的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051034
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051034,
					"content": "所以，我并不讨厌打扮哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051035
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051035,
					"content": "我懂我懂，确实是这样呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051036
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051036,
					"content": "派蒙这么可爱，穿什么衣服都会很可爱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051037
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051037,
					"content": "呜哇——！我被夸了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051038
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051038,
					"content": "久等啦，我这边清点完毕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051039
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120051039,
					"content": "有劳您了，还缺什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051040
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051040,
					"content": "好消息，用料全齐！尺寸是…就按图上的来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051041
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120051041,
					"content": "对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051042
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051042,
					"content": "明白了，这就为您安排。价格一共是…这个数！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051043
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120051043,
					"content": "请您收下。可以的话，希望能加急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051044
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051044,
					"content": "刚好最近也没有其他急单，我们这就着手开始制作。不过，制作衣物需要一定时间，几位可以稍后过来取货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051045
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120051045,
					"content": "在此之前，请找个地方休息休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051046
					],
					"speakerTitle": "小仓澪"
				},
				{
					"id": 120051046,
					"content": "我也这么想，我们去别处转转吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051047
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051047,
					"content": "当然，关于这点，我已经提前考虑到了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051048
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051048,
					"content": "接下来，我想带旅行者和派蒙去餐馆用餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051049
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051050,
					"content": "刚好我也饿了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051051
					]
				},
				{
					"id": 120051049,
					"content": "哦哦哦！要开饭啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051050
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120051051,
					"content": "哼哼，地点是我精心挑选的一家临街餐馆——「木南料亭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051052
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051052,
					"content": "比起过于高档令人拘谨的高级餐厅，我认为那种自在的氛围更适合我们今天的行程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051053
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051053,
					"content": "那么我们现在过去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051054
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120051054,
					"content": "嗯嗯，我都等不及啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
