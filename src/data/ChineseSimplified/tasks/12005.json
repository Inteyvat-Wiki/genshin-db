			"dialogs": [
				{
					"id": 120050301,
					"content": "小偷，站住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050302,
					"content": "哈？就带这么几个人来，还想把东西拿回去吗？别做梦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050303
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050303,
					"content": "竟然理直气壮地说出这种话…你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050304
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050304,
					"content": "有什么不敢？喂你，我问你，你是别国来的商人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050305
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050305,
					"content": "万国商会，不就是在稻妻地盘上腆着脸皮苟且偷生的蛀虫而已嘛！有人保护你吗？谁来为你出头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050306
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050307
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050307,
					"content": "哈哈哈哈！连自己的立场都不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050308
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050308,
					"content": "在这个稻妻，你们这些无依无靠的商贩任人宰割才是常态吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050309
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050309,
					"content": "…可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050310
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050310,
					"content": "喂！外国佬，你想做笔交易吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050311
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050311,
					"content": "交易？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050312
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050312,
					"content": "用钱把这些布料买回去，怎么样？总比头破血流地离开这里好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050313
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050313,
					"content": "欺人太甚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120050314,
					"content": "我…唉！算我倒霉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050315
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050315,
					"content": "稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050316
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050316,
					"content": "久利须先生，请不要付钱给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050317
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050317,
					"content": "可、可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050318
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050318,
					"content": "还记得我们的协议吗？您守口如瓶，我也会完成答应您的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050319
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120050319,
					"content": "啊对，对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050320
					],
					"speakerTitle": "久利须"
				},
				{
					"id": 120050320,
					"content": "那么请您退到安全的地方，并保护好自身安全。接下来…是我实现承诺的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				}
			]
		},
