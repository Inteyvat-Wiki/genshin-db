			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010301,
					"content": "啊，是秘境的入口！深渊法师一定是逃进去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010302,
					"content": "那它也就没有退路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "呼…呼……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010305,
					"content": "小可莉，还跑得动吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010306,
					"content": "要不要留在这里，我们讨来宝物之后还给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010307,
					"content": "…不，不行，我要跟你们一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010308,
					"content": "毛茸茸偷的是我的东西，我自己也要负责把它夺回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010309,
					"content": "很有勇气呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "嘿嘿，可莉是很厉害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010312,
					"content": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，我们走我们走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010310,
					"content": "但是秘境很危险哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "我们追上去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
		{
			"id": 1020104,
			"completionStepIds": [
				1020111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1020111",
							"2"
						],
						"stepId": 1020111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "哼，追上来了吗。看来你们还算有两下子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010402,
					"content": "不过，你们也就到此为止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010403,
					"content": "你想要做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010404,
					"content": "哈哈哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010405,
					"content": "我们可是在人类的传言里，收集到了详细的战力情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010406,
					"content": "这个红衣服的小女孩，拥有蒙德城最厉害的宝物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010407,
					"content": "现在宝物在我手上，你们再着急也没用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010408,
					"content": "好——就用这个宝物来对付你们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010409,
					"content": "不行！千…千万别动它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010410,
					"content": "哼哼，看你慌张的样子，终于知道害怕了吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010411,
					"content": "让我看看，哦…火焰的标记吗，哼哼哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010412,
					"content": "嘣——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010501,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010502,
					"content": "生存守则之——「炸弹伤人琴找上门」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010503,
					"content": "完了完了…这下全完了呜呜呜……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010504,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010505,
					"content": "可莉的「宝物」，原来是炸弹吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010506,
					"content": "好厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "唔，难怪会有可莉是蒙德最强战力的传言呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010509,
					"content": "至少我是肯定不敢跟她打架的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010510,
					"content": "但是，她为什么要逃走呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010511,
					"content": "她好像提到了生存守则。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "唔，也对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010514,
					"content": "那我们还是先回<color=#00E1FFFF>骑士团</color>找琴团长汇报一下情况吧。",
