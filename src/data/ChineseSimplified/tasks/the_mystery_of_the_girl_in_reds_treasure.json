			"dialogs": [
				{
					"id": 102010101,
					"content": "到了到了！就在这附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010102,
					"content": "你们看，我那~~么大一个宝物，之前就是埋在这儿的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010103,
					"content": "被挖出了一个坑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010104,
					"content": "等等，那边有谁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "是深渊法师？！难道它就是琴团长之前警告的，偷偷接近蒙德城的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010106,
					"content": "咦？它手里拿着的是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010107,
					"content": "是我的宝物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102010108,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010109,
					"content": "嘁，那女孩居然带了帮手。计划有变…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "深渊法师"
				},
				{
					"id": 102010110,
					"content": "喂！你有本事别逃呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102010111,
					"content": "我们追。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1020113",
