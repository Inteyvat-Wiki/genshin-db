	"talks": [
		{
			"id": 1102102,
			"completionStepIds": [
				1102102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102102",
							"2"
						],
						"stepId": 1102102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210201,
					"content": "唔，这地方，怎么看起来这么普通…真的能找到有价值的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210202
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210202,
					"content": "嗯？我觉得挺壮观的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210203,
					"content": "我不是说风景，而是…既然发生了一场大战，总该有些不同寻常的地方吧，但现在，唉，甚至不知道该从哪儿找起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210204
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210204,
					"content": "此处名为孤云阁，如果想要研究魔神，或是魔神战争时期的历史，这里都是绝佳的场所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210205
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210205,
					"content": "相传，岩王帝君以岩为枪，投入此片海域，将魔神刺穿并镇压。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210206
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210206,
					"content": "那些岩枪经历了长年的风化，最终形成了此番别致的景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210207
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210207,
					"content": "这、这么大的山，居然是岩王爷的武器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210208,
					"content": "如今残存于我们眼前的，不过冰山一角。当年帝君投下的岩枪，无论数量还是体积，都远超于此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210209
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210209,
					"content": "只不过因为角度各异，柱体又过于巨大，受到海水侵蚀，或是重力影响，很多都整体沉入了海底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210210
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210210,
					"content": "所以，除了后来的风化，起初的崩落也是孤云阁的重要成因之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210211
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210211,
					"content": "那…能和这么夸张的力量对抗的魔神，应该也很强吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210212
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210212,
					"content": "是的，这就是孤云阁的研究价值所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210213
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210213,
					"content": "与那段历史有关的物件大多沉于深海，但「漩涡之魔神」掀起了滔天巨浪，也给了这些东西重见天日的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210214
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210214,
					"content": "也就是说，只要仔细找找，肯定就能赚得盆满钵满…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210215
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210215,
					"content": "啊，我是说，肯定会收获颇丰，是吧？这我就安心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210216
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210216,
					"content": "反正带了这么多人，我觉得分头寻找效率会更高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210217
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210217,
					"content": "嗯，那么，我和我的这位朋友同行吧，虽然我略懂一些杂学，但在专业的考古学家面前，还是不班门弄斧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210218
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210218,
					"content": "欸？我、我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210219
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210219,
					"content": "怎么啦？这不是你的本职工作，有必要这么惊讶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210220
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210220,
					"content": "我知道了…那、那我就为他带路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210221
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210221,
					"content": "嗯，如果收集到了什么珍贵或者稀奇的东西，我想想…就到对岸汇合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		},
		{
			"id": 1102106,
			"completionStepIds": [
				1102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102106",
							"2"
						],
						"stepId": 1102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克列门特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210601,
					"content": "…你这也叫考古学家？！这也看不出来，那也不认识，你到底行不行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210602
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210602,
					"content": "术、术业有专攻不是很正常的事吗！我已经很努力地讲解了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210603
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210603,
					"content": "别吵架别吵架，到底发生什么了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210604,
					"content": "这家伙，口口声声说自己是考古学家，却对这周围的遗迹一窍不通！还没有我懂得多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210605
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210605,
					"content": "我只能靠直觉…我是说，经验，带了点好像有价值的东西回来。唉，真是耽误时间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210606
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210606,
					"content": "我…我一直都在研究「盐之魔神」，对海里的东西不懂，也很正常吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210607,
						110210608
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210607,
					"content": "（作为学者，确实有点奇怪…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210609
					]
				},
				{
					"id": 110210609,
					"content": "倒是你，一直在问我这个值多少摩拉、那个值多少摩拉！文物的价值难道就是摩拉吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210610
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210610,
					"content": "这、这…文物的价值，用摩拉来衡量，不是最直白吗！也很符合璃月的传统吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210611
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210611,
					"content": "没关系，两位稍安勿躁，我们倒是带回来了一些不错的东西，可以一起看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210612
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210612,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210613
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210613,
					"content": "很遗憾，你们带回来的这些东西，虽然确实是被「漩涡之魔神」带上岸的，可惜都与魔神无关，只是出自附近海域而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210614
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210614,
					"content": "相比之下，还是我们找到的这块石板，表面有神秘的纹饰，且微存魔神之力，或许会对研究有所帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210615
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210615,
					"content": "快、快把它给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210616
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210616,
					"content": "嘿嘿，有了这个，就不算毫无收获了。魔神的力量，哼哼，这个才是好东西啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210617
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210617,
					"content": "咳咳，但是，这其他的东西应该也还值几个钱，能收回雇佣顾问的成本——都归我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210618
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210618,
					"content": "一定要有魔神的力量残留在上面，才有研究的价值吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110210619,
					"content": "不是的，我追寻「盐之魔神」的历史，是因为历史能讲述文化，还有信仰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210620
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210620,
					"content": "至于你，就只是想借考古的名义发财吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210621
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210621,
					"content": "胡说！我是至冬国的专业考古研究员，如假包换！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210622,
						110210623
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210622,
					"content": "（不，就是想借考古的名义发财吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210624
					]
				},
				{
					"id": 110210624,
					"content": "哦，对了，那个茶杯，最好别卖掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210625
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210625,
					"content": "啊？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210626
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210626,
					"content": "那不是古代的东西，是凝光的收藏，跟着群玉阁一起掉下来的。如果你不想惹恼七星的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210627
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110210627,
					"content": "呃，我知道了…明明我看成色还不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210628
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210628,
					"content": "你看，你就是想拿去卖钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210629
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210629,
					"content": "那、那又怎么样！研究和卖钱，二者兼顾不好吗？脑筋这么死板干什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210630
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210630,
