			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700101,
					"content": "咳，咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700103
					]
				},
				{
					"id": 726700103,
					"content": "你好你好，终于等到一个看起来合适的人了，咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700104,
					"content": "而且还是熟人，这下我不用担心样本不够了嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700105,
					"content": "等了这半天，不是老年人就是小孩子，完全不够用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700106,
						726700109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700106,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700107
					]
				},
				{
					"id": 726700107,
					"content": "啊，这么快就把我忘了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700108,
					"content": "我又不是什么图谋不轨的恶人，不用这样假装不认识我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700111,
					"content": "你仔细看看，是我啊，我们在稻妻的离岛还见过面的，咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700112,
					"content": "真的很可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700113
					]
				},
				{
					"id": 726700113,
					"content": "看起来你真是忘记我了，唉，那就来自我介绍一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700114
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700114,
					"content": "我是须弥「教令院」的学者胡塞尼，为了在稻妻开展调研项目，一路跋涉好不容易抵达稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700115,
					"content": "可惜…咳…要在稻妻开展调研实在限制太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700116,
					"content": "虽然我最终也不是一无所获，但是跟这一路的颠簸坎坷比起来，总有点得不偿失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700117,
					"content": "研究经费已经所剩无几了，我只能取道璃月回「教令院」，不过我还是希望利用回程的时间做点补救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700118,
					"content": "我想，不如继续在曾经获得「教令院」肯定的「导能原盘」项目上下功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700119,
					"content": "至于「导能原盘」，不知道你记不记得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700120
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700120,
					"content": "那是一件珍贵的古代遗物，能够借助无所不在的地脉，增强使用者的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700121,
					"content": "咳咳，这个研究项目仍在初期阶段，我之前上交的调查报告也只相当于完整研究的绪论部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700122
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700122,
					"content": "要弄明白整个「导能原盘」的运作原理与应用可能性，还有许多工作要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700123,
					"content": "所以我正在这里征召志愿者，邀请他们使用「导能原盘」，以获得更多的新数据，支撑我的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700124
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700124,
					"content": "我…咳…可不是什么可疑分子，你别误会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700125,
					"content": "原来如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700126
					]
				},
				{
					"id": 726700126,
					"content": "没错…咳…那么我现在可以问了，旅行者，你愿不愿意成为志愿者，帮忙试用「导能原盘」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700127
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700127,
					"content": "可以试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700128
					]
				},
				{
					"id": 726700128,
					"content": "请先允许我表达感谢，你一直乐于为追求智慧这项事业做出奉献。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700129
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700129,
					"content": "不过在我将「导能原盘」正式交你保管之前，还是让我们先来做一个小小的热身活动吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700130
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700130,
					"content": "这也是为了确认志愿者是否有能力自保…咳…毕竟，负责任的学术项目是不会拿志愿者的生命安全冒险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700131
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700131,
					"content": "如果你已经准备好了的话，就到指定的地点去，试着清理那里的营地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700132
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700132,
					"content": "我会在这里等你回来，一定要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700109,
					"content": "…你打算做什么！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700110
					]
				},
				{
					"id": 726700110,
					"content": "我看起来像是那种绑架路人做实验的疯狂学者吗？别用这种防贼一样的口气嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "胡塞尼"
				}
			]
		},
		{
			"id": 7267002,
			"completionStepIds": [
				7267003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267003",
							"2"
						],
						"stepId": 7267003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700201,
					"content": "你们回来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700202
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700202,
					"content": "毫发无伤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700203
					]
				},
				{
					"id": 726700203,
					"content": "哈哈…咳，是我多虑了，你的实力很强，我可以放心地把「导能原盘」交你保管了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700204
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700204,
					"content": "「导能原盘」的使用方法简单易懂，你看到就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700205
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700205,
					"content": "不过使用时务必小心，这可是真正的古代遗物，如果弄丢了或者弄坏了，我就得倒大霉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700206
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700206,
					"content": "你可以先熟悉一下「导能原盘」，之后再尝试测试工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700301
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700301,
					"content": "怎么样，能理解「导能原盘」的使用方法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700302,
						726700304
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700302,
					"content": "不算太复杂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700303
					]
				},
				{
					"id": 726700303,
					"content": "的确，和「教令院」里的某些器械比起来，「导能原盘」算是比较易用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700306,
					"content": "以你的水平，如果扩大测试规模，应该也没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700307
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700307,
					"content": "我听路过的冒险家说，他们新发现了一处奇特的秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700308
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700308,
					"content": "因为之前似乎没有人发现过这个地方，所以其中汇聚的魔物数量不少，能力也比野外游荡的魔物强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700309
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700309,
					"content": "如果把那里当作测试场地的话，一定能获得更全面的数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700310
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700310,
					"content": "毕竟你之前的表现…咳…实话说很出色，「导能原盘」中留下的记录反而有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700311
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700311,
					"content": "是你的话，出入这种秘境大概不是难事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700312
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700312,
					"content": "那还用说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700313
					]
				},
				{
					"id": 726700313,
					"content": "要是别人这么说，我八成不信，但是你的话，我觉得肯定没问题哈哈…咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700314
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700314,
					"content": "那我来帮你把秘境地点标注在地图上吧，测试任务就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 726700304,
					"content": "有点不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700305
					]
				},
				{
					"id": 726700305,
					"content": "这很正常。放心，作为非专业人士，你只需掌握基础操作就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
}