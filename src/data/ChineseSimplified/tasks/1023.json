							"102305",
							"2"
						],
						"stepId": 102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230501,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230502
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230502,
					"content": "啊，他变回了原来的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230546
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230546,
					"content": "也该…冷静下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230503,
					"content": "刚才那身「魔王武装」，对身体的负担果然很大，让我没机会停下来思考…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230504
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230504,
					"content": "但仔细一想，你们确实没有比我抢先一步得到「神之心」的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230505
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230505,
					"content": "无论「神之心」去了哪里…都应该与你们无关吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230506
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230506,
					"content": "是啊，都说了不是我们拿的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230507,
					"content": "旅者，你今天展现出的实力，比「女士」在蒙德对你的评价更强，这是为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230508,
						10230509
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230508,
					"content": "（是因为正在收集七种元素…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				},
				{
					"id": 10230510,
					"content": "看你的样子，心里好像是有答案的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230511
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230511,
					"content": "唉，但如果是不能对我说的秘密，那我也只能勉强压抑一下自己的好奇心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230512
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230512,
					"content": "有这场战斗，我已经很满足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230513
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230513,
					"content": "同样追求变强的人，都是朋友，尽管这种友谊的形式，只能是互相争斗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230514
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230514,
					"content": "真是奇怪的朋友观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230515,
					"content": "但现在，也不得不暂时搁置知己间的交流，回到我的任务中去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230516
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230516,
					"content": "——既然「神之心」不是被人拿走，那会不会是…从一开始，就不在「仙祖法蜕」里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230517
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230517,
					"content": "更进一步地想，「仙祖法蜕」本身，会不会也只是一种障眼法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230518
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230518,
					"content": "啊，你是想说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230519,
						10230520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230519,
					"content": "岩王帝君没死？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230521,
					"content": "恐怕正是如此。那可…真有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230522
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230522,
					"content": "不愧是商业之都的守护神，对「契约之外的小手段」也非常精通呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230523
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230523,
					"content": "这样一来，就只能发动「备用方案」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230524
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230524,
					"content": "备用方案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230525,
					"content": "本来不想用这个方案的，因为会波及弱者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230526
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230526,
					"content": "说到底，世界属于我们这些追求变强的人。对于无聊无趣的弱者，我平常都不怎么愿意去理会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230527
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230527,
					"content": "可惜身为愚人众执行官，是不能对「手段」挑三拣四的。这就像小孩子有时也得学着去吃自己不喜欢的胡萝卜一样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230528
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230528,
					"content": "所以…你究竟想做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230529,
					"content": "我要唤醒「孤云阁」下沉睡的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230530
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230530,
					"content": "魔神？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230531,
					"content": "<color=#00E1FFFF>「漩涡之魔神」，奥赛尔</color>。在魔神战争时败于「岩之魔神」摩拉克斯，被岩枪镇压在海中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230532
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230532,
					"content": "如果让一位昔日的魔神，去进攻失去了神灵镇守的璃月港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230533
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230533,
					"content": "你们觉得，那位把我们都耍了一通的岩王帝君大人，还能安稳地躲在一边看戏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230534
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230534,
					"content": "可…可是，魔神战争都结束了两千年！在世上只有七神的今天，你要怎么把远古的魔神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230535,
					"content": "当然是，已经准备好了「唤醒」的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230536,
					"content": "啊！那是「百无禁忌箓」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230537,
					"content": "我…我想起来了！我们确实有发现「愚人众」在研究它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230538,
						10230539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230538,
					"content": "我亲眼见过研究的现场。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230540,
					"content": "没错，给你们的那张，只是这场研究的副产物而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230541
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230541,
					"content": "这么多「百无禁忌箓」的力量聚集在一起，再加上女皇赐予「执行官」的力量…暂时解封岩枪镇压之力，也不是什么办不到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230544
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230544,
					"content": "原本对我来说，走到这一步，动用远古魔神的力量，已经很无趣了，也不符合我的信条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230545
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230545,
					"content": "不过，一想到不仅是那位岩神，连你们也必须为此作出应对…倒也还挺有意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230539,
					"content": "而且你们还在尝试「复制」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230520,
					"content": "死去的仙体是假的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230509,
					"content": "（是因为正在逐渐恢复曾经的力量…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				}
			]
		}
	]
}