			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230301,
					"content": "哇啊——这里就是<color=#00E1FFFF>「黄金屋」</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230302,
					"content": "外面看起来就已经很气派了，没想到里面更加豪华！而且…而且满地都是摩拉！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230303,
					"content": "既然整个提瓦特的摩拉，都是在这里造出来的，那…是不是多一点少一点，都很不容易被发现？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230304,
					"content": "莫伸手，伸手必被抓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "原来是诱饵式陷阱，好险好险！幸亏有你提醒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230307,
					"content": "但就算不能拿，近距离看看应该没问题吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230308,
					"content": "可以的话，我还想躺在里面睡一觉！用摩拉当被子，做梦也会更香，嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230309,
					"content": "还是先去确认「仙祖法蜕」的情况吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "哦，对了对了，正事要紧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230312,
					"content": "这里…是不是太安静了？「仙祖法蜕」这么重要的东西，肯定不会没人看管吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230313,
					"content": "#——欸？！{NICKNAME}，你看，那是什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230314,
					"content": "是千岩军。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "好像都晕倒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "…唔，感觉情况很不妙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230317,
					"content": "我们赶紧去确认一下「仙祖法蜕」有没有异常吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230310,
					"content": "这里的气氛好像…有点奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230305,
					"content": "如果真这么简单，那早就乱套了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				}
			]
		},
		{
			"id": 102305,
			"completionStepIds": [
				102305
			],
			"beginWay": "TALK_BEGIN_AUTO",
