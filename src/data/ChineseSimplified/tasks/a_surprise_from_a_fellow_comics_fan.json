			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}！没想到在蒙德碰上了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706970102,
					"content": "这还是我第一次来这么冷的地方呢，所有的体验都很新奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706970103,
					"content": "打雪仗啊，堆雪人啊，哦对了，还有漫画！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706970104,
					"content": "没想到，在稻妻流行的作品《炽魂斗士战记》，在这里也有读者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706970105,
					"content": "我和几个纳塔来的朋友聊漫画聊得可开心了，一时手痒，还做了一块漫画角色立牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706970106,
					"content": "对了，你听说过《炽魂斗士战记》吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706970107,
					"content": "和宵宫聊了聊「炽魂斗士特攻队」的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "竟然这么巧，你的朋友也喜欢这部漫画，好奇妙的缘分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706970109,
					"content": "那这块立牌就送给你们吧，炽魂斗士菲耶蒂娜，正好配「炽魂斗士特战队」。",
