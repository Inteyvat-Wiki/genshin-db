			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"杰洛尼"
				],
				"points": [
					{
						"sceneId": 10,
						"position": [
							-86.963,
							390.917,
							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "咦，你们怎么到这里来了？这里没有轨道，也很高，又在整个琉形蜃境边缘的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540102,
					"content": "平时很少有人会到这边来，就连伊迪娅…哼哼，我怀疑她自己都压根不知道有这么个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540103,
					"content": "这里什么都没有嘛，杰洛尼在这里做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540104,
					"content": "我只是稍微出来散散心啦…咦，别用那种「不会又和费迪南德吵架，所以离家出走了吧！」的眼神看我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540105,
					"content": "没有，真的没有吵架，我之所以会到处跑是出于，呃，该怎么说，是出于个人兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540106,
					"content": "之前不是也说过吗，「呼呼飞车」一开始的想法是我提出的，那时我的想法就是，有什么东西能够轻松爬到高处就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540107,
					"content": "所以我…所以杰洛尼才想出了飞车和轨道，那是因为喜欢天空和高处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540108,
					"content": "很像个傻瓜吧，我记得稻妻也有那种谚语，什么只有脑子不好使的人和烟喜欢往上跑之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540109,
					"content": "能想到飞车就很了不起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "但是在琉形蜃境中，才能建起这样的飞车。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540112,
					"content": "…算了，不提这个。我到这里来的原因还有一个，那就是为了观赏这里的星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540113,
					"content": "虽然琉形蜃境的星空应该也只是瓶外星空的折影，但是对我来说也足够美丽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540114,
					"content": "每天晚上…只要看着这片星空，心中就会感受到无比的安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540115,
					"content": "喜欢星空的，是杰洛尼吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "只要看到那样的星空，不管谁都会喜欢上的。真是可惜啊，如果白天也能看到星空就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540117,
					"content": "当然了，如果不用每天爬到这里也能看到那就更好了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540118,
					"content": "啊，这样的办法！我想到了一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540119,
					"content": "咦，真的有这样的办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540120,
					"content": "只要拍摄画片就好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "…画、画片？原来现在还有那么先进的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540122,
					"content": "嗯，不如我们拍一张星空的画片给杰洛尼看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540123,
					"content": "真的可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540124,
					"content": "当然可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "不过，不知道哪里能拍出好看的星空呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540126,
					"content": "啊，这里！夜晚，在这边的平台上，能看到最漂亮的星空，这也是为什么我爬到这里来的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "杰洛尼"
				},
				{
					"id": 790540127,
					"content": "这样啊，好！杰洛尼你就等我们的画片吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540110,
					"content": "飞车很有趣哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
