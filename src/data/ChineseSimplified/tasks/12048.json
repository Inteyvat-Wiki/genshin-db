			"dialogs": [
				{
					"id": 120480101,
					"content": "那位客人，到这里登记！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "百日白白音"
				},
				{
					"id": 120480102,
					"content": "什么日子啊，能来这么多人？早知道就限号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "柴葉紫"
				},
				{
					"id": 120480103,
					"content": "哇，那个江村一玄斋的问题被解决后生意好了很多嘛，阿紫和白音恢复得也很不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480104,
					"content": "#早啊，{NICKNAME}，派蒙，来预约？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480105,
					"content": "对啊，就约今天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480106,
					"content": "那我需要再给两位准备一份贵宾邀请函，毕竟两位都是本店的贵客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480107,
					"content": "好耶！这次我想先体验美食服务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480108,
					"content": "哎呀，前天刚给过撤股的建议，差点让你丢掉这么好的生意，你不会埋怨我吧，老朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480109,
					"content": "我根本没有考虑你的建议，何来埋怨呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480110,
					"content": "就是这个语气，很亲切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480111,
					"content": "你又搞突然出现这一套…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480112,
					"content": "早啊，两个小家伙，昨晚的夜色还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480113,
					"content": "你偷看了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "偷看？那棵树就在鸣神大社下面，难道要我把鸣神大社搬走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480115,
					"content": "宫司大人来这里，所为何事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480116,
					"content": "嗯…就当是随便逛逛吧，顺便带来一个天领奉行的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480117,
					"content": "你的族人昨晚从水里捞上来的那个家伙已经脱离了生命危险，但心智似乎降低到了小孩子的水平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480118,
					"content": "这样也好…另外，我先向宫司大人道谢了，昨天的事情能顺利解决，多亏了宫司大人的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480119,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480120,
					"content": "不是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "神子，我们两个之间藏不住心思的向来不是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480122,
					"content": "要说面对你时的自卑和要强这两种情绪，我当然会有，或者说就是依靠这两种情绪我才有动力经营这份产业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480123,
					"content": "自卑让我时刻保持清醒，要强让我能坚持下去。这是已经被妥善处理的心理问题，不需要让你如此顾忌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480124,
					"content": "唉…还不如早点讲明呢，也不用让这小家伙两头跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480125,
					"content": "#{NICKNAME}的行动还是很有意义的，毕竟要为宫司大人考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480126,
					"content": "那个「江村一玄斋」聚集了大批信徒，在他的底细被曝光之前，鸣神大社的宫司贸然介入进行打压的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480127,
					"content": "一帮吵吵闹闹的信徒会对鸣神大社的名誉带来多少影响，很难估量，所以宫司大人明面上最好没有过问此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480128,
					"content": "这一点我当然知道，但还是老朋友的心情更让我顾忌一些，否则也没必要搞那么多弯弯绕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480129,
					"content": "神子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480130,
					"content": "你还是那个有趣但不怎么可爱的家伙…看来担心你会有烦恼果然没什么必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480131,
					"content": "…我还是会有烦恼的。不过，每种烦恼都有各自对应的解药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120480132,
					"content": "这是新的邀请函，请收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梦见月瑞希"
				}
			]
		},
