			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉诺尔",
					"恩肖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000701,
					"content": "这任务…比想象中麻烦欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000702,
					"content": "因为花园里的巨人真的很爱那些紫色的小花，而且总是有很多规矩嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000703
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000703,
					"content": "不听话的孩子就该早点学会守规矩，免得长大了更难管教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000704,
						740000706
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000704,
					"content": "派蒙，听到了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000705
					]
				},
				{
					"id": 740000705,
					"content": "欸？关我什么事呀，我可不是不听话的小孩，哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000708,
					"content": "你们都玩累了吧？正好今天也做了塔塞斯杂烩，一起坐下吃点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000709
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000709,
					"content": "#是呀是呀！{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我们一起吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000710
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000710,
					"content": "#好欸！既然莉诺尔都这么说了，{NICKNAME}，我们就不要推辞了吧，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000711,
					"content": "那就感谢招待了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000712
					]
				},
				{
					"id": 740000712,
					"content": "你们是莉诺尔的朋友， 客气什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000713
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000713,
					"content": "被邀请到室内，享用了并不精致但十分美味的塔塞斯杂烩。\\n席间，分享了一些旅途的见闻，引得老人啧啧称奇，少女咯咯发笑。\\n在谈笑声中度过了一段欢乐的时光…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740000714
					]
				},
				{
					"id": 740000714,
					"content": "怎么样？外公的手艺是不是胜过韦尔赛叔叔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000715,
						740000716
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000715,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000718
					]
				},
				{
					"id": 740000718,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，你们知道吗？我也有帮忙喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000719
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000719,
					"content": "虽然现在还只是帮一点点小忙，但是外公说了，只要多练，总有一天我也可以做出那么美味的塔塞斯杂烩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000720
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000720,
					"content": "#哼哼，到时一定让{M#哥哥姐姐}{F#姐姐们}也尝尝我的手艺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000721
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000721,
					"content": "那我们约好了！真让人期待呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000722,
					"content": "话说回来，我们叨扰了这么久，也该告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000723,
					"content": "欸——这就走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000724
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000724,
					"content": "#莉诺尔，听话，{M#他们}{F#她们}也有自己的事要做，不可能一直陪你玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000725
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000725,
					"content": "唔…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000726
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000726,
					"content": "别这么难过嘛，以后有机会的话，一定还会再见面的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000727,
					"content": "真的吗？那下次见面的时候，卡特哥哥也会一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000728
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000728,
					"content": "这个嘛…应该也不是完全没可能吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000729,
					"content": "好喔，那在下次见面之前，我会准备很多很多精彩的故事，到时讲给你们听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000730
					],
					"speakerTitle": "莉诺尔"
				},
				{
					"id": 740000730,
					"content": "嗯嗯，他肯定也很期待莉诺尔的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000731,
					"content": "好孩子，谢谢你们来看莉诺尔，还陪她玩闹。这里还有些塔塞斯杂烩，你们带在路上吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000732
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000732,
					"content": "冒险家经常要在野外露宿吧？记得吃饱穿暖，别饿着冻着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000733
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000733,
					"content": "知道啦！恩肖爷爷和莉诺尔也要照顾好自己哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000716,
					"content": "感觉都差不多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000717
					]
				},
				{
					"id": 740000717,
					"content": "我觉得还是恩肖爷爷做的塔塞斯杂烩比较美味欸，该怎么说呢，很有家庭的味道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000706,
					"content": "把不听话的小孩都关进花园。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000707
					]
				},
				{
					"id": 740000707,
					"content": "嘿嘿，可是我根本不会踩到花，而且不需要女巫帮忙就可以飞过高墙哦！",
