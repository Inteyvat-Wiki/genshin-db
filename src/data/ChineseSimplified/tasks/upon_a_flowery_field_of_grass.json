			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"恩肖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000601,
					"content": "本以为是更轻松的任务，没想到它们这么任性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000602,
					"content": "好孩子，现在你应该知道了，越是任性就越得让它们知道规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000603,
						740000605
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000603,
					"content": "不能踩花的规矩倒是记住了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000604
					]
				},
				{
					"id": 740000604,
					"content": "#{NICKNAME}要是也能飞就好了，脚踏实地可真辛苦呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000607,
					"content": "既然累了，就休息一会儿再走。正好做了塔塞斯杂烩，你们也来尝尝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000608
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000608,
					"content": "有好吃的吗！啊…可、可是这样不好吧…要不还是算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000609,
					"content": "怎么，难道是信不过我的手艺？不说别的，塔塞斯杂烩可是我的拿手菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000610
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000610,
					"content": "我的意思是，这样会不会也算是不守规矩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000611,
					"content": "你们付出了劳动，这是你们应得的。吃饱了才有力气继续劳动。对了，你们是冒险家…那更应该多吃点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000612
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000612,
					"content": "还有正式委托的报酬，之后会支付给你们。这是合乎委托的规矩的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000613
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000613,
					"content": "嘿嘿，既然是这样，那我们就不客气啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000614,
					"content": "被老人邀请至屋内，享用了并不精致的塔塞斯杂烩。炖菜的暖意沁入心脾，感觉疲惫也被一扫而空…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740000615
					]
				},
				{
					"id": 740000615,
					"content": "劳动之后的料理总是格外美味呢！而且塔塞斯杂烩该怎么说呢，很有家庭的味道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000616,
					"content": "因为食材和料理方法都很普通吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000617
					]
				},
				{
					"id": 740000617,
					"content": "普通但是好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000618,
					"content": "那当然了，我们家的倔丫头也对这道菜赞不绝口。就算是闹别扭，只要闻到炖菜的香气，一定乖乖到餐厅坐下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000619
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000619,
					"content": "现在嘛，她走得太远了，闻不到了。多半是连回家的路该怎么走也忘得一干二净了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000620
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000620,
					"content": "这…对了，我们也可以帮忙找人的，恩肖爷爷要是愿意给我们讲讲她的特征，说不定我们能帮你找到她呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000621,
					"content": "如果在旅途中遇到的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000622
					]
				},
				{
					"id": 740000622,
					"content": "好心的孩子，谢谢你们。我要找她倒不是难事，毕竟之前她也托人送了几封信回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000623
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000623,
					"content": "不过我看她是完全不觉得自己有错，不然怎么会只寄信，而不是自己回家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000624
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000624,
					"content": "所以她的信我是一个字也没看，拆也没拆。动物不懂事便罢了，她可是个大姑娘了，她也不懂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000625
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000625,
					"content": "说起来，最近也没再收到她的信…大概是知道自讨没趣了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000626
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000626,
					"content": "总之，我可不会专门雇人找到她再带她回家。要么她自己回家认错，要么就再也别回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000627
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000627,
					"content": "好、好吧…既然你这样说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000628,
					"content": "不管怎么说，谢谢你们帮忙把勇士它们几个带回来。虽然报酬不多…这里还有些塔塞斯杂烩，给你们带上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000629
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000629,
					"content": "冒险家经常要在野外露宿吧？记得吃饱穿暖，别饿着冻着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000630
					],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000630,
					"content": "嗯嗯！恩肖爷爷也要快些把腿伤养好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740000631,
					"content": "注意安全，照顾好自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩肖"
				},
				{
					"id": 740000605,
					"content": "看来应该给派蒙也立一些规矩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000606
					]
				},
				{
					"id": 740000606,
					"content": "我哪有很任性…不对！我可不是什么不听话的宠物狗啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000607
					],
					"speakerTitle": "派蒙"
				}
			]
		},
