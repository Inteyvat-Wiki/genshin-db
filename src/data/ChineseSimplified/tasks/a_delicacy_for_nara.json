			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰帕卡提"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "…和那菈说话，好困难。而且，好高喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130202,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#噫！是那菈{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130204,
					"content": "兰帕卡提不害怕。而且，哥哥们胆子大，一定也不害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130205,
					"content": "只要跟着<color=#00E1FFFF>烟柱</color>，应该就能找到他们。如果变得奇怪，就用<color=#00E1FFFF>草元素的力量</color>「啪叽」他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰帕卡提"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰帕卡提",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "兰帕卡提现在可是非常生气，哎呀呀，比非常生气还要生气一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130302,
					"content": "森林里面多危险呀，「无留陀」在森林里肆虐。出发的时候，兰帕卡提还特意叮嘱几位哥哥要团结一心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130303,
					"content": "结果刚出门就大吵了一架，兰茶荼，你自己还吃了奇怪的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130304,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730130305,
					"content": "兰帕卡提决定，在十次日落果成熟的时间里，兰茶荼都不准采蘑菇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130306,
					"content": "怎么这样…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730130307,
					"content": "就是，要是把坏孢子带进来了，让蘑菇怪物长出来，那怎么行嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730130308,
					"content": "兰非拉哥哥也是，跑到离桓那兰那那么远的地方去采果子。那边有好坏好坏的东西！兰拉迦也特地说过的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130309,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730130310,
					"content": "就是就是。果实也要喝水，兰那罗也要喝水。所以，水是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730130311,
					"content": "兰阿帕斯哥哥，你非得去「法留纳神机」找水。难道不知道，就连那菈法留纳也说过，桓那兰那的水是最好喝的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130312,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730130313,
					"content": "现、现在你们看见了吧，只有「开心的味道」，才能给妹妹带来幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730130314,
					"content": "#兰萨卡哥哥，我听说，你为了你的「开心的味道」，给那菈{NICKNAME}增添了许多麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130315,
					"content": "那、那都是为了「至上珍馐」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730130316,
					"content": "完成「至上珍馐」是为了得到「烹饪修行」的结果，哎呀呀，依靠他人的力量完成的修行，又有什么意义可言？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130317,
					"content": "兰帕卡提觉得，兰萨卡哥哥最需要好好进行反省。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130318,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730130319,
					"content": "兰帕卡提！我们来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130320,
					"content": "哎呀呀，是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130321,
					"content": "#那菈{NICKNAME}和派蒙分享了兰帕卡提的烦恼，解决了烦恼的根源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130322,
					"content": "兰帕卡提终于不再为哥哥们错过无忧节，是否在外涉险而感到烦恼了。多亏你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130323,
					"content": "兰帕卡提和哥哥们，都很感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130324,
					"content": "那就最好不过了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130325,
					"content": "不过，有件事情，我一直很好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130326,
					"content": "「那菈法留纳」到底是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是我们的朋友。是桓那兰那的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130328,
					"content": "#在好久好久好久以前，兰那罗的朋友。和那菈{NICKNAME}很像，是个金灿灿的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130329,
					"content": "原来如此。不过，我还有别的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130330,
					"content": "关于「兄妹」的事情吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "嗯。兰帕卡提的哥哥们，究竟谁最大、谁最小呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130332,
					"content": "嗯？大小？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130333,
					"content": "指年龄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "「年龄」…啊。兰帕卡提知道了，就像树的年轮。嗯，森林的孩子们，是不分「年龄」大小的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130337,
					"content": "欸？那「哥哥」和「妹妹」又是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130338,
					"content": "#这个啊。以前，我们有一个那菈朋友。那菈法留纳。{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}有一个「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130339,
					"content": "#兰帕卡提和哥哥们听{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说到那个「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」的时候，看起来都很幸福，又很难过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130340,
					"content": "所以，我们知道了。对「哥哥」来说，「妹妹」是很重要的那菈。对「妹妹」来说，「哥哥」是很重要的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130341,
					"content": "我们觉得很好。所以，兰帕卡提和哥哥们也决定，要变成「哥哥」和「妹妹」。那菈法留纳说，这样很好。要珍惜亲人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130342,
					"content": "没错，一定要珍惜自己的亲人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130344,
					"content": "我还有一件事情很在意…兰那罗需要吃饭吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130345,
					"content": "人类会把食材做成菜肴，森林的孩子也可以把食材做成菜肴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130346,
					"content": "因为那菈法留纳以前，教过我们，那菈吃东西的方法。兰帕卡提和哥哥们，才会开始「烹饪修行」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130347,
					"content": "唔，还真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130348,
					"content": "就像是在玩什么游戏一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "兰帕卡提和哥哥们可是很认真的。因为，那菈法留纳说过，能够一起分享食物，是很幸福的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130351,
					"content": "#对了，听兰阿帕斯哥哥说，那菈{NICKNAME}也会烹饪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130352,
					"content": "#嗯，{NICKNAME}的技术也是久经考验的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130353,
					"content": "#这样呀…无忧节的时候，那菈{NICKNAME}一定要来。陪不才的哥哥们烹饪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130354,
					"content": "让他们再一次见到，只有那菈才明白、兰那罗永远不能明白的，真正的烹饪与菜肴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130355,
					"content": "到时候可别惊讶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "兰帕卡提会满心期待的。这次无忧节，一定会很好、很厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130356,
					"content": "等我给你露一手吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "就像是在过家家一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "指尺寸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
					"content": "喂！才不是啦，是问年龄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130336
					],
					"speakerTitle": "派蒙"
				}
			]
