	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"兰帕卡提",
					"兰罗摩",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "呀！是金色的那菈。噫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130102,
					"content": "#兰帕卡提不害怕。那菈{NICKNAME}是好那菈，和故事里的那个那菈一样。那菈{NICKNAME}和派蒙，帮助了大家许多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130103,
					"content": "#嗯，不害怕了。兰罗摩，兰帕卡提相信你，也相信草、叶子和种子说的话，明白是好那菈。你们好，那菈{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130104,
					"content": "兰帕卡提，你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130105,
					"content": "其实我是坏人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "喂！别开这种玩笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130107,
					"content": "不是的。兰帕卡提知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130108,
					"content": "#很多风的地方，有小小的种子。它们和那菈一起来到桓那兰那。它们说，那菈{NICKNAME}很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130109,
					"content": "之前兰罗摩也说过类似的话呢！这么说来，很多风的地方来的种子…是指蒲公英吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130110,
					"content": "也可能是风车菊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#那菈{NICKNAME}要帮助兰拉娜，结出惟耶之实。所以，我们要一起为无忧节做准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130116,
					"content": "哎呀呀…无忧节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130117,
					"content": "兰帕卡提的样子好奇怪。有什么烦恼的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130118,
					"content": "兰帕卡提的「哥哥」们，一直没有回到桓那兰那。如果他们不回来，我们「兄妹」就不能一起过无忧节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130119,
					"content": "我也很久没在桓那兰那遇到兰茶荼、兰萨卡、兰阿帕斯和兰非拉了。自从上次那次事情以后，就一直没见到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130120,
					"content": "很久…是有多久呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130121,
					"content": "那是很多很多个月亮以前。幼苗才刚刚钻出土。到现在，幼苗已经长成了能为兰那罗遮雨的大树，有七个兰帕卡提那么高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130122,
					"content": "从种子长成大树…哇！那岂不是已经过去好久好久了！兰帕卡提的哥哥们失踪了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130123,
					"content": "「失踪」？是一种种子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130124,
					"content": "哦哦！原来那菈的种子，叫失踪。好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130125,
					"content": "#那菈好厉害！那菈{NICKNAME}一定有好多好多的失踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130126,
					"content": "不是这个意思啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130127,
					"content": "「不知道到哪去了」的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "噢。不是这样的。兰帕卡提知道兰茶荼、兰萨卡、兰阿帕斯和兰非拉在哪里。所以，哥哥没有失踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130129,
					"content": "他们到桓那兰那外修行了好久好久。「烹饪修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130136,
					"content": "原来如此，是「烹饪修行」吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130137,
					"content": "听着像是派蒙会感兴趣的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#哼哼！派蒙对「{NICKNAME}的烹饪修行」更感兴趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130139,
					"content": "所以，「烹饪修行」究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130140,
					"content": "那是上次无忧节的故事。那时候，那菈做了很多很多「菜肴」，给兰那罗们品尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130141,
					"content": "所以，兰茶荼他们为了这次无忧节，能够给那菈做「菜肴」，就一直在「烹饪修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130142,
					"content": "…突然期待起无忧节了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130143,
					"content": "但那是兰那罗的饭菜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "美食是所有生物共同的语言！没问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130146,
					"content": "不过，既然兰帕卡提知道他们在哪，为什么不自己去找呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130147,
					"content": "盛大的无忧节即将举办，兰帕卡提也要做很多、很多的准备。没有时间去找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130148,
					"content": "为了无忧节离开桓那兰那烹饪修行。但是不知道无忧节快要到来。兰茶荼、兰萨卡、兰阿帕斯、兰非拉，笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130149,
					"content": "#那就交给我们吧！反正我们和兰罗摩也要为无忧节做准备，找回森林里的兰那罗。对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130150,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "可是我们要怎么找到兰茶荼、兰…兰什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130153,
					"content": "兰茶荼、兰萨卡、兰阿帕斯、兰非拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130154,
					"content": "呜哇，一想到还有兰拉娜、兰罗摩、兰拉迦、兰帕卡提…兰那罗的名字怎么这么难记！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130155,
					"content": "派蒙，不要说兰那罗的名字不好。不然，兰那罗会伤心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130156,
					"content": "好啦，我知道了。所以说，我们要怎么找到他们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130157,
					"content": "他们以前在桓那兰那烹饪修行。结果，弄出好多好多烟。所以，兰帕卡提把他们赶出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130158,
					"content": "当时，大家都好害怕，还有的兰那罗吓得休眠了。幸好兰罗摩勇敢，惩罚了烟。兰帕卡提很生气，所以让他们出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130159,
					"content": "在林子里，看到<color=#00E1FFFF>袅袅升起的烟柱</color>，就能找到他们。应该吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130160,
					"content": "原来是你把他们撵走的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130161,
					"content": "嗯。不对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130162,
					"content": "#倒也没有啦…总之，{NICKNAME}，我们出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130163,
					"content": "啊。对了。还有一件事。如果哥哥们变得奇怪，就用<color=#00E1FFFF>草元素的力量</color>「啪叽」他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130164,
					"content": "以前，他们弄出好多好多烟。整个桓那兰那都是烟。他们也害怕，到处乱跑。有时候，如果碰到奇怪的蘑菇，也会变成那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130165,
					"content": "但是，兰那罗是草木的精灵。所以，只要吸收<color=#00E1FFFF>草元素的力量</color>，就能恢复、清醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130166,
					"content": "#我明白了。{NICKNAME}只要吃甜甜花酿鸡，就能恢复。所以是甜甜花酿鸡的精灵。嗯！很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130167,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130169,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130170,
					"content": "…总之，我们出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130172,
					"content": "#那菈{NICKNAME}和派蒙加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730130171,
					"content": "总之，出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "好期待！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "我明白你的心情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#那菈{NICKNAME}也明白我的心情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130132,
					"content": "#嗯，{NICKNAME}也有失散的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130133,
					"content": "#噢。那菈{NICKNAME}的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}也去「烹饪修行」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130134,
					"content": "欸？感觉有些地方搞错了…失踪就是，「不知道到哪去了」的意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130135,
					"content": "噢。不是这样的。兰帕卡提知道哥哥们没有失踪。他们到桓那兰那外修行了好久好久。「烹饪修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730130111,
					"content": "也可能是松果。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "难道是风带来了故事的种子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130114,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
