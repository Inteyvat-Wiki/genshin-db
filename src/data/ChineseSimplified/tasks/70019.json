			"dialogs": [
				{
					"id": 700190308,
					"content": "现在总能告诉我们那个奇怪的丘丘人在哪里了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190301
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700190301,
					"content": "Yeye dada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190302
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700190302,
					"content": "Wei? Du odomu tomo zido mi si, du zido <color=#00E1FFFF>unta nunu</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190303
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700190304,
					"content": "Mosi mita dada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700190306
					]
				},
				{
					"id": 700190305,
					"content": "Tomo, valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700190306
					]
				},
				{
					"id": 700190303,
					"content": "<color=#00E1FFFF>Unta nunu</color>…它在提示我们时间吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190304,
						700190305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700190306,
					"content": "Valo, mi tomo!",
