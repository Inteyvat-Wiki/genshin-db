			"dialogs": [
				{
					"id": 700190101,
					"content": "Yoyo dala si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190102
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700190102,
					"content": "Mimi tomo. Mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190103
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700190103,
					"content": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190104
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700190104,
					"content": "他说他希望天上的太阳不见，想要一睡不醒，想要死。是什么让它这么痛苦啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700190105,
					"content": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190106
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700190106,
					"content": "唔，不如我们就把它想要的东西交给它，权作安慰吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
		},
