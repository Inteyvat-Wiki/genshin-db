			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860101,
					"content": "#{NICKNAME}，派蒙，还有「咚咚小圆帽」，我们在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860102
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400860102,
					"content": "莱依拉！这几天和「转转悠悠兽」玩得还开心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860103,
					"content": "当然了！有「转转悠悠兽」帮我拖行李，我们去了很远的地方露营，见识到了不一样的星空美景，还推进了论文！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860104
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400860104,
					"content": "不过，清单上提到的东西都快做完了，面粉这样的食材经常呛得我不停咳嗽…我还是没能找到「转转悠悠兽」的最爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860105
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400860105,
					"content": "如果改进后的「意智宝珠」能让我们和蕈兽直接对话就好了…嗯！我把这件事也写进信里，托人问问生论派的资深学者吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860106
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400860106,
					"content": "莱依拉好像拿出了前所未有的干劲！说了这么多话还很精神…为了伙伴居然能做到这种程度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860107,
					"content": "呃啊，力气消耗过度了，我们赶快去见八重小姐吧…不然我又撑不住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱依拉"
				}
			]
		},
		{
			"id": 4008602,
			"completionStepIds": [
				4008602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008602",
							"2"
						],
						"stepId": 4008602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860201,
					"content": "嗯？来得还挺早啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860202,
					"content": "神子，你这就要走了吗？总感觉你都没好好在须弥玩玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860203,
					"content": "我早就尽兴了哦。托你们的福，这次的取材很顺利，不止得到了宝贵的参赛体验，还有破坏阴谋的精彩戏码…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860204,
					"content": "嗯，不如直接让左右加放弃自己原创的人物，以你们为主角创作下一部小说好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860205,
						400860206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860205,
					"content": "其实你也在暗中行动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				},
				{
					"id": 400860207,
					"content": "对哦！现在我终于明白了，原来你之前给过我们好多次暗示！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860208,
					"content": "明明早点揭穿埃尔欣根就可以了，为什么要绕这么大的弯子啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860209,
					"content": "一开始就点破真相，岂不是太无聊了？我很想见识一下，你们会如何应对这种局面呢。结果你们给了我一个莫大的惊喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860210,
					"content": "我原以为，你们和蕈兽之间的故事，会是「主人」与「仆从」的展开，但你们有了在这之上的答案…平等默契的「伙伴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860211,
					"content": "从另一个角度考虑，总是念及「主人」的埃尔欣根，会栽在你们手里，也是情理之中。当然，以他的手腕，也许还会闹腾一会儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860212,
					"content": "我又开始听不懂了…下次还是把神子的话写下来，拿回去好好研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860213,
					"content": "闲聊到此为止，「百雷遮罗」就交给你们了。记得照顾好它哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860214,
					"content": "你们和海妮耶都要加把劲啊，这样有趣的大赛能否继续举办下去，全都取决于你们今后的作为了，我还有点期待呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860206,
					"content": "你知道埃尔欣根有蹊跷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				}
			]
		},
		{
			"id": 4008603,
			"completionStepIds": [
				4008603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008603",
							"2"
						],
						"stepId": 4008603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"莱依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860301,
					"content": "你们来了，时间正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860302
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860302,
					"content": "我收集了其他参赛选手的「意智宝珠」，选好了适合蕈兽伙伴生活的地点，绝不会对周围的生态环境造成恶劣影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860303
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860303,
					"content": "向大家问好吧，「欢腾之火」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860304
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860304,
					"content": "「欢腾之火」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860305
					]
				},
				{
					"id": 400860305,
					"content": "这是「火一」的新名字。最初和它相遇时，我发现它如此乖巧，其实也有过欢腾的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860306
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860306,
					"content": "要是早点破除那种固有的偏见，不再压制自己的真情实感，不去憎恨蕈兽…或许这种心情会一直持续下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860307
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860307,
					"content": "海妮耶总算彻底解开心结了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860308
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400860308,
					"content": "这样才对嘛！虽然我也有点习惯「火一」这个名字了，可这个新名字的意义无比重大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860309,
						400860310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860309,
					"content": "恭喜你，海妮耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				},
				{
					"id": 400860311,
					"content": "我决定以最严格的标准要求自己，务必照顾好这些性情温和的蕈兽。请放心将伙伴们交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860312
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860312,
					"content": "这样一来，就到了分别的时候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860313
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400860313,
					"content": "去吧，「转转悠悠兽」，要好好听海妮耶的话哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860314
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400860314,
					"content": "「百雷遮罗」，等到下次举办「驯兽师大赛」，神子还会来看你的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860315,
					"content": "「咚咚小圆帽」…我们再来击掌吧！这段时间我很开心，你也要高高兴兴地生活，期待着和我们重逢的那天啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860316,
					"content": "一定会再见的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860317
					]
				},
				{
					"id": 400860317,
					"content": "希望人和蕈兽和谐共处的那天能尽早到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860318
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860318,
					"content": "我相信你们！等着你们的好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860310,
					"content": "也恭喜「欢腾之火」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				}
			]
		}
	]
}