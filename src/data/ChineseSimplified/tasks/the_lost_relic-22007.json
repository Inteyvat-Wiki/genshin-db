				},
				{
					"id": 220070204,
					"content": "我可是专业的学者，怎么可能犯低级错误。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220070205,
					"content": "好了，文物就拜托你了，我可拿那些怪物没办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
