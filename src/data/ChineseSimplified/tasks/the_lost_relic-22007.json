			"dialogs": [
				{
					"id": 220070101,
					"content": "到底掉哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220070102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "哎呀，是这样…我在一处遗迹考察的时候，突然被怪物袭击…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220070104,
					"content": "我慌里慌张地逃跑，结果，把刚刚挖出来的文物忘在了原地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220070105,
					"content": "那群怪物离开之后，我又折返回去，但是文物已经不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220070106,
					"content": "我在周围找了半天也没找到，不知道是不是被怪物拿走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220070107,
					"content": "你能帮我去找找吗？如果找到文物的话，就用这个盒子装好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				}
			]
		},
