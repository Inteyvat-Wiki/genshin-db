					"小白"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "刚才多谢了，旅行者，要是我一个人去，说不定就要忙得手忙脚乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180502,
					"content": "大过节的，我也不太想让江城爷爷总是一个人呆着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180503,
					"content": "那你自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "嗯…我等一下也会回去打理打理磨坊里的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180505,
					"content": "那个磨坊是我父亲留下来的，他过世后，我辞去了璃月的工作，回来继承了他的磨坊和手艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180506,
					"content": "怎么说呢，在一样的环境里，做和他一样的事情，我总能回忆起很多事来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180507,
					"content": "特别是在海灯节的时候，我总会想起父亲从前和我说过的许多话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180508,
					"content": "啊对了，光顾着给江城爷爷做霄灯了，我还得给自己做一盏才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180509,
					"content": "不过材料都用光了，没有留自己的份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180510,
					"content": "现在再去搜集材料，怕是来不及了…旅行者，能请你帮我搜集一些来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180511,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180512
					]
				},
				{
					"id": 718180512,
					"content": "那就拜托你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				}
			]
