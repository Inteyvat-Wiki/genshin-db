			"trigger": {
				"objectNames": [
					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "唉…老婆子，你也来和小白唠两句…她爹爹的手艺这么好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180302,
					"content": "这豆腐啊，就是卖去璃月港，也是一顶一的好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180303,
					"content": "唔，小白啊，你是来做什么的来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180304,
					"content": "是来送霄灯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "霄灯…啊…是霄灯…哎呀，年年都麻烦你啦，小白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180306,
					"content": "老婆子，你还记得吧，之前我编霄灯的手艺可好啦，那周围的人，都找我编。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180307,
					"content": "每年过海灯节的时候，那些霄灯啊，可真好看…你等着，我这就去给你挂霄灯去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180308,
					"content": "我来挂霄灯吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "嗯，也好，那你可小心点啊，可别碰着摔着了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江城"
				}
			]
		},
