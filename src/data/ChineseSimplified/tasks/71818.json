			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "老婆子，你回来啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180202,
					"content": "抱歉，你认错人了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "嗨，我可还没老糊涂呢…怎么会认不出你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180204,
					"content": "我刚刚还念叨着你呢，你看这大过年的，是不是该给咱女儿添件新衣裳了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180205,
					"content": "哟…这回你还多带了个人回来…啊，是你找来的裁缝吗？我俩又想到一块儿去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180206,
					"content": "江城爷爷，是我，小白啊。前两天我还给你送过豆腐，这么快就不记得我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180207,
					"content": "啊…小白…是小白啊！记得记得！就前一阵子，你爹爹还在跟我夸你呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180208,
					"content": "欸…那是什么时候的事儿来着…老婆子，你还记得不…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180209,
					"content": "…还记得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "嗬！我就说，我的记性怎么可能差了…还有，还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180212,
					"content": "江城爷爷，您歇一会，别太累了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180213,
					"content": "旅行者，要不你先去帮江城爷爷打扫一下屋子吧，我来陪他聊会儿天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180214,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				},
				{
					"id": 718180210,
					"content": "当然记得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
		{
