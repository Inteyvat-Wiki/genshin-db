			"trigger": {
				"objectNames": [
					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "霄灯挂好了？好看，真好看，来年一定又是个好年呐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180402,
					"content": "一定会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "那江城爷爷，我们还有点事，就先走了，回头再来看您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180405,
					"content": "行、行，年轻人，总有自己要忙的事…忙不完的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180406,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "欸，老婆子…别忘了看看咱家的地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江城"
				},
				{
					"id": 718180403,
					"content": "肯定会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
			"id": 7181805,
