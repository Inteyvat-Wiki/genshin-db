				"objectNames": [
					"小白"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "你好啊，旅行者。上次真是太谢谢你了，轻策庄好久没有这么热闹过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180102,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "往年只有我和阿芷在，最多给孩子们做点霄灯，陪老人唠点家常，再稍微做一些好吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180104,
					"content": "这次多亏了你，才能过上一个热热闹闹的海灯节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180105,
					"content": "不过热闹归热闹…我还是想去探望一下庄里的老人。今天我准备去看看江城爷爷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180106,
					"content": "如果你愿意的话，就一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180107,
					"content": "那我们一起吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "嗯，好的，那我们先去江城爷爷那里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
