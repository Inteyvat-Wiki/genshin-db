			"dialogs": [
				{
					"id": 760710301,
					"content": "太好了，谢谢你。有了这些新鲜的麦子，就能做出温暖的面包了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710302
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710302,
					"content": "那么作为回报，我就把烤制「蘑幻之菇」的方法教给你吧，要记住哦…",
					"roleType": "TALK_ROLE_NPC",
