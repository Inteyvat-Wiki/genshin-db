			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"别蕾娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "要是能做出美味的面包，就能让大家打起精神来吧。但是现在这状况，有点难办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710102,
					"content": "遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "是这样的，我正打算做一种新的面包，那是小时候妈妈给我做过的像是蘑菇一样的面包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710106,
					"content": "在我的记忆里，这种面包要先用蘑菇和浆果做成酱馅，然后把酱馅填进揉好的面团，放进烤炉里一起烤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710107,
					"content": "而其中最重要的，就是一定要用新鲜麦子磨成的面粉，这样做出来的面包才会散发着温暖的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710108,
					"content": "本来我只是想来采一些麦子，但不知道是不是最近同僚们没空照看这里的麦田，附近多了许多奇奇怪怪的小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710109,
					"content": "要是瓦蒂什先生在的话应该就能处理了吧，但我实在不擅长这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710110,
					"content": "所以如果可以的话，能帮我采一点麦子来吗？只要一点点就好。作为回报，我可以教你做温暖的蘑菇面包，拜托啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				},
				{
					"id": 760710103,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "哎呀，你别走嘛，能帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "别蕾娜",
					"speakerSubtitle": "执灯士"
				}
			]
		},
