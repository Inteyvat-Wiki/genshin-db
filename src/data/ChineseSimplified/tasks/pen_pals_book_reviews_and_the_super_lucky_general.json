			"dialogs": [
				{
					"id": 722811601,
					"content": "#{NICKNAME}，派蒙，谢谢你们过来送我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811602
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722811602,
					"content": "这次离岛之旅感觉如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811603
					]
				},
				{
					"id": 722811603,
					"content": "很有价值。「小说鉴赏会」很成功，也让我对未来的正式会谈充满了希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811604
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722811604,
					"content": "而且，五郎也立了大功，一下子就为海祇岛争取到了这么多有用的书籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811605
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722811605,
					"content": "虽说是我抽到了大奖，但这些书归根结底是八重神子送的。我觉得将来有机会的话，还是应该好好谢谢她才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811606
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811606,
					"content": "对了，昨天八重神子好像给了你一封信？她说了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811607
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722811607,
					"content": "啊，我差点忘了这件事！让我拿出来看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811608
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811608,
					"content": "五郎，我猜你刚刚听说有颁奖和合影的时候，心里一定非常不安吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811609,
					"content": "没想到你不仅接受了那些条件，并且还对我提出了要求，你的这份勇气赢得了我的尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811610
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811610,
					"content": "那些书籍是我送给海祇岛的一点心意，也是给你的礼物，希望你能喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811611,
					"content": "对了，读到这里的你，一定非常感谢我的善解人意，想要找个机会报答我对吧，你的机会来了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811612
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811612,
					"content": "下个月八重堂会举办一场活动，我们会找人装扮成轻小说中的角色，与书迷们亲切互动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811613
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811613,
					"content": "五郎你不仅有耐心，长得也很清秀，不如就过来帮忙吧，我会专门为你量身打造一套造型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811614
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811614,
					"content": "顺便说一句，是女装哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811615
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722811615,
					"content": "啊啊啊啊啊——那个可恶的女人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				}
			]
		}
	]
