	"talks": [
		{
			"id": 7228102,
			"completionStepIds": [
				7228102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228102",
							"2"
						],
						"stepId": 7228102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海",
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810201,
					"content": "#{NICKNAME}，派蒙，好久不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810202
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810202,
					"content": "哇，是心海和五郎，没想到海祇岛的现人神巫女和大将，也来参加容彩祭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810203,
					"content": "对，不过我们并不是以海祇岛管理者的身份，而是以个人身份受到了邀请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810204
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810204,
					"content": "最近难得海祇岛事务不多，我又想买些书，于是就决定来一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810205
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810205,
					"content": "五郎其实对容彩祭兴趣不大，但听说我要来离岛，就也跟着一起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810206
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810206,
					"content": "毕竟珊瑚宫大人要离开海祇岛，而且今天还要去见「笔友」，我身为大将，当然要确保大人的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810207
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810207,
					"content": "「笔友」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810208,
					"content": "对，我们是最近才认识，然后开始联络的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810209
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810209,
					"content": "我和笔友对轻小说的口味很接近，经常能聊到不少有趣的想法。当然了，我们也有针锋相对、互不相让的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810210
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810210,
					"content": "因为我们这次都会来容彩祭，所以决定趁机开一场「小说鉴赏会」，聊聊彼此对小说的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810211
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810211,
					"content": "听起来好专业的样子！对了，你们两个既然都喜欢小说，要不要试着一起创作？说不定还能改变当今稻妻的文坛局势呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810212,
					"content": "呵呵，这倒是个很有趣的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810213
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810213,
					"content": "#快到见面的时间了，{NICKNAME}，我和五郎要准备去约定地点和对方会合了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810214
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810214,
					"content": "心海，其实我有点好奇你的笔友，我能不能也跟过去看看？你放心，我就远远看一下，不会打扰你们聚会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810215,
					"content": "让我想想…你们二位应该没有问题，那就一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
		{
			"id": 7228104,
			"completionStepIds": [
				7228104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228104",
							"2"
						],
						"stepId": 7228104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海",
					"五郎",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810401,
					"content": "约定的地点就在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810402
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810402,
					"content": "周围没有其他人，看样子是我们来得比较早…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810403
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810403,
					"content": "哎呀呀，让我看看是谁来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810404
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810404,
					"content": "神、神子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810405,
					"content": "（糟糕了，没想到竟然碰到了神子！神子和心海不仅分属两个阵营，信仰的神明也不同。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810406,
					"content": "（她们两个之间…不会发生什么冲突吧？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810407,
					"content": "不愧是鸣神大社的宫司大人，果然是一副高高在上的态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810408
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810408,
					"content": "呵呵，不愧是海祇岛的领袖，虽说看起来就像水母一样柔弱，但就连说出的话都是有毒的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810409,
					"content": "啊…这、这可怎么办才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810410,
					"content": "你好，初次见面，「玲珑油豆腐」小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810411
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810411,
					"content": "请多关照咯，「深海舌鲆鱼」小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810412,
					"content": "呵呵呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810413,
					"content": "欸…这到底是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810414,
					"content": "原来心海的笔友，竟然是神子吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810415,
					"content": "不对不对，看她们两个的样子，根本就是早知道彼此的身份！这么说的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810416,
						722810417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810416,
					"content": "所谓的笔友见面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				},
				{
					"id": 722810418,
					"content": "嗯？你在说什么呀，我怎么听不懂？我明明只是来和「深海舌鲆鱼」小姐开「小说鉴赏会」的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810419,
					"content": "我们走吧，鉴赏会的地点就在上面的勘定奉行府里，那儿风景很好，特别适合喝喝茶，聊聊创作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810420
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810420,
					"content": "什么样的「小说鉴赏会」能开到勘定奉行府里去啊，会相信才怪呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810421,
					"content": "我看你们这次聊起来，就不是改变稻妻的文坛，而是要连整个稻妻的局势都改变了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810422,
					"content": "呵呵，海祇岛不久后会与幕府针对稻妻未来的发展进行正式会谈，在会谈前，这样的非正式会晤也是必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810423
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810423,
					"content": "对，尤其是我这种幕府之外的人出面，会更方便帮大家摸清彼此的底线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810424
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810424,
					"content": "只不过这才是我们第一次会面，对一般民众来说，公布消息还是略早了一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810425
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810425,
					"content": "原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810426,
					"content": "说起来，怎么没看见你们的大将？你不是说他也会一起来的吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810427,
					"content": "咦，对哦，五郎他怎么突然不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810428,
					"content": "五郎他帮我去采购书籍了，所以这次鉴赏会就不来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810429
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810429,
					"content": "哎呀，真可惜，我还以为又能看到他那双毛茸茸的耳朵了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810430
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810430,
					"content": "#{NICKNAME}，借一步说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810431
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810431,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810432
					]
				},
				{
					"id": 722810432,
					"content": "我之前就隐约感觉到五郎不擅应对八重宫司，所以这次一开始，我才不想让他跟我来离岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810433
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810433,
					"content": "刚才他一看见八重宫司就躲了起来，恐怕是本能反应，但五郎责任心又很强，今后见到我，肯定会羞愧得无地自容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810434
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810434,
					"content": "所以我想把采购书籍的任务交给他，也能让他心里好受些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810435
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810435,
					"content": "但五郎之前很少买东西，所以我想拜托你们跟他一起去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810436
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810436,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810437
					]
				},
				{
					"id": 722810437,
					"content": "心海，你就放心和神子开会，买书的事就交给我们和五郎吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810438,
					"content": "那就拜托你们了。这张纸上我列出了要买书籍的清单，你把它交给五郎吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 722810417,
					"content": "只是掩人耳目的托词吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				}
			]
		},
