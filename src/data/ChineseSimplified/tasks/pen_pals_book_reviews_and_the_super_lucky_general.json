			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五郎",
					"村田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722811301,
					"content": "五郎，你刚才好勇敢啊，明明不擅长对付神子，却不仅答应了参加颁奖，还提出了自己的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722811302,
					"content": "真的吗？当时我只是一想到珊瑚宫大人的嘱托，还有海祇岛的居民，就一下子有了勇气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811303
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811303,
					"content": "我可是海祇岛的大将，怎么能输在这种地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811304
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811304,
					"content": "现在，我已经找到领兵作战时候的感觉了，接下来，就算是八重神子亲自来谈判，我也不会被她的压迫力影响了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811305
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811306
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811306,
					"content": "五郎，你看起来好像还是有点紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722811307,
					"content": "哈哈，大概是因为想到，那个女人说不定会提出什么捉弄我的要求吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811308
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811308,
					"content": "几位，抱歉让你们久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811309
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811309,
					"content": "情况怎么样，八重宫司她说了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811310
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811310,
					"content": "八重大人说，可以答应客人您的要求，把奖品的轻小说都换成农业科学类书籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811311
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811311,
					"content": "太好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722811312,
					"content": "而且八重大人说，考虑到客人您使用书籍的目的，还可以额外多赠送您一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811313
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811313,
					"content": "您现在就可以跟我去八重堂的仓库选书。客人乘坐的船是明天晚上，选好的书籍会由我们打包直接送上船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811314
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811314,
					"content": "直接打包？那颁奖仪式该怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811315
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811315,
					"content": "八重大人说，选书会耗费不少时间精力，为了让您能在容彩祭上有一段美好的回忆，颁奖仪式就取消了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811316
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811316,
					"content": "不过，她给您留下了一封信，您可以在有时间的时候再读。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811317
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811317,
					"content": "没想到八重神子竟然会取消颁奖仪式…唉，我之前一直认定了会被她狠狠作弄，现在看来，是我太狭隘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811318
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811318,
					"content": "那先跟这位编辑小姐去选书了，就不麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811319,
						722811320
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811319,
					"content": "五郎，明天晚上再见吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				},
				{
					"id": 722811321,
					"content": "好，那就明天晚上再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811320,
					"content": "我们两个去码头送你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				}
			]
		},
