			"dialogs": [
				{
					"id": 722810501,
					"content": "五郎，你还好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810502,
					"content": "啊！是你们俩…唉，没想到那个女人竟然会突然出现，我实在是不知道该跟她说什么。等我回过神来，就已经躲在这附近了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810503
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810503,
					"content": "我明明是为了保护珊瑚宫大人的安全才跟来的，结果却什么都做不到，反而成了她的负担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810504
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810504,
					"content": "五郎，你不要太自责了，其实心海她托我们来告诉你，有个重要的任务交给你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810505,
					"content": "把心海的书单交给五郎。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722810506
					]
				},
				{
					"id": 722810506,
					"content": "这是珊瑚宫大人的采购列表，我明白了，大人是希望我能将功补过！好，接下来就交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810507
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810507,
					"content": "五郎，我们也陪你一起去吧，我们刚好可以作为向导，陪你在容彩祭上转转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810508,
					"content": "太感谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				}
			]
		},
