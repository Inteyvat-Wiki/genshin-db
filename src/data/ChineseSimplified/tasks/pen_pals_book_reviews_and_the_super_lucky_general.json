					"nextDialogs": [
						722810711
					],
					"speakerTitle": "福本"
				},
				{
					"id": 722810711,
					"content": "不，我没事，谢谢您的赠品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810712
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810712,
					"content": "#{NICKNAME}，这个狐…呃，玩偶，如果可以的话，还是请你收下吧。",
