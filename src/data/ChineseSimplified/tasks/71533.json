			"dialogs": [
				{
					"id": 715330101,
					"content": "…唔，感觉也不太对，这种「祝柬」，真难做啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330102,
					"content": "米卡，你在做「祝柬」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#欸？{NICKNAME}，居然能遇见你，真巧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330104,
					"content": "你是来璃月过海灯节的么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "欸？不是不是，我来璃月港本来是为了执行递送信件的任务，刚巧遇上了海灯节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330106,
					"content": "我来之前听可莉前辈说，她很想要一封海灯节的「祝柬」，就想着顺便买一封回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330107,
					"content": "结果，没想到要自己做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330108,
					"content": "我做了半天，却总觉得做出来的「祝柬」不太对…但也不知道具体哪里不对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}，你见多识广…能给我点制作「祝柬」的建议吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330110,
					"content": "让我思考一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
