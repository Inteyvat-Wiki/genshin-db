	"talks": [
		{
			"id": 301301,
			"completionStepIds": [
				301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301301",
							"2"
						],
						"stepId": 301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30130101,
					"content": "先说说迪娜泽黛的事吧，她没事可真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130102,
					"content": "嗯，在「最后一天的花神诞祭」上我们分别之后，我到了城外去，见到了旅行者所描述的光景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130103,
					"content": "在无数的梦境中，我找到了一个逐渐变得稀薄的梦…这正好验证了我的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130104,
					"content": "当迪娜泽黛彻底无法承受虚空对梦境的收割之后，意识便会逸散，反而脱离了虚空的掌控。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130105,
					"content": "不过残留的那一点意识也无力支撑很久了，它会回到本该属于自己的梦境里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130106,
					"content": "与梦境一起逐渐变得稀薄，直至消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130107,
					"content": "我竭尽了全部的努力维持住了那个迪娜泽黛的梦境，但也不会很长久，好在你们及时打破了「轮回」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130108,
					"content": "这么说来，算是我们一起拯救了迪娜泽黛呀，最后还是赶上了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130109,
						30130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130109,
					"content": "令人欣慰的结果。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130111
					]
				},
				{
					"id": 30130111,
					"content": "嗯？你们怎么都在欣慰地笑呢？我以为此刻你们应该感动得痛哭流涕才对…嗯…还需要继续多多观察才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130112
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130112,
					"content": "两者其实都可以啦！这要分人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130113,
					"content": "好了，除此之外，你们还有很多问题想问我吧？你们拯救了我虔诚的信徒，我会将所有答案作为回报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130114,
					"content": "关于我在道成林昏迷时所看到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130115
					]
				},
				{
					"id": 30130115,
					"content": "#旅行者在道成林的时候被熏香影响而昏迷了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说昏迷时看到了一棵巨大的树，红色的天空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130116,
					"content": "还听到了一个人的声音，对吗？关键词是「世界」和「遗忘」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130117,
					"content": "对的！你果然知道，我们一直想问你那是什么，红色的天空和坎瑞亚有没有关联…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130118,
					"content": "旅行者看来连接上了世界树啊，那是世界树中，大慈树王残余的意识所留下的一段讯息，也或许是她临死前最后的回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130119
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130119,
					"content": "你们应该也知道，大慈树王是在坎瑞亚灾变后失踪的，所以时间点的确对得上，你们的怀疑不无道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130120
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130120,
					"content": "是大慈树王残留的信息？我们之前还以为会是那个赤王呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130121,
					"content": "赤王…那位更早便逝去的魔神？至今还有一些仍在信仰那位赤王的沙漠子民，你们可能听到了些谣传吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130122
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130122,
					"content": "这样吗，那么…那条讯息的内容到底是什么意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130123,
					"content": "…我还无法解读它，哪怕以虚空目前的能力也做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130124
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130124,
					"content": "大慈树王在世界树中残留的意识，像是被「污染」了一样，隐含了非常危险的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130125
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130125,
					"content": "甚至许多修行的学者一旦意识与之连通，便会彻底陷入疯狂…尽管我多次对教令院进行过警示，却依旧一直有受害者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130126
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130126,
					"content": "不过我相信，拯救世界树的关键就在其中，所以我一直没有放弃对它的解读。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130127
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130127,
					"content": "幻觉里的那棵树就是世界树吗…提纳里也说过，世界树「生病」了，难道就是因为有被「污染」的意识在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130128,
					"content": "可是连你也不知道那个幻觉的含义，我们岂不是白来找你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130129,
					"content": "旅行者接触了那个「意识」却丝毫不受影响，我第一次见到这样的人。或许有你在的话，我们会有机会解读它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130130
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130130,
					"content": "不，我们是必须要解读出其中的秘密。我已经排除了所有可能影响世界树的因素，只剩下这一种了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130131
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130131,
					"content": "这是一个以世界树…以提瓦特的存亡为赌注来挑战的「谜题」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130132,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130132,
					"content": "你为何是凯瑟琳的模样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130133
					]
				},
				{
					"id": 30130133,
					"content": "应该说，我正在以虚空为媒介，「侵占」着凯瑟琳的意识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130134
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130134,
					"content": "那、那是怎么做到的！凯瑟琳小姐好可怜，你也能侵占别人的意识吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130135,
					"content": "如果是佩戴着虚空终端的人的话，理论上我都是可以「进入」他们的脑子里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130136
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130136,
					"content": "虚空是大慈树王的遗产，而我既是小吉祥草王，又是「最初的虚空终端」，我的意识一直连接在虚空当中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130137
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130137,
					"content": "不过我一向尊重须弥子民的自我意志，从未真的去侵占他们的意识，只会在必要时借用一下这个至冬的仿生人偶而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130138
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130138,
					"content": "啊…唔，等等，好像冷不丁知道了什么不得了的事，原来凯瑟琳是…怪不得有那么多奇怪的地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130139,
					"content": "可是你自己的身体呢？为什么一直用这种方式，我记得你是住在「净善宫」来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130140,
					"content": "…这要从很久以前说起。大慈树王消失后，贤者们找到了刚刚诞生的我，并接回须弥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130141
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130141,
					"content": "当时的我的确幼小无力，贤者们便以「保护」的名义，将我关在净善宫中，几乎不再过问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130142
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130142,
					"content": "可我很清楚，贤者多么希望他们找到的是大慈树王，而非是几乎象征着大慈树王已逝去这一事实的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130143
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130143,
					"content": "所以…贤者们其实是在「软禁」自己新的神明吗？他们怎么敢…为什么不给他们一点教训呀，纳西妲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130144,
					"content": "从某个角度上讲，他们也没有错。大慈树王是全知全能的，哪怕逝去后，虚空依旧在赋予这个国家力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130145
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130145,
					"content": "而我…还远远担不起「智慧之神」的名号，对国家的治理也是教令院更加驾轻就熟，我的存在并没有那么大的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130146
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130146,
					"content": "在我眼里，你已经是位优秀的神明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130147
					]
				},
				{
					"id": 30130147,
					"content": "是呀是呀，纳西妲也已经有很多信徒了，看看花神诞祭那天，来参加的大家都是真心喜欢你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130148,
					"content": "呵呵，谢谢你们能这么说。不过其实，能够将意识连接虚空的我，也并不需要身体上的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130149
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130149,
					"content": "对我来说，设法拯救世界树才是使命与最优先事项。我会一边继续寻找方法，一边努力成长为更合格的神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130150
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130150,
					"content": "…偶尔，负起「智慧之神」的责任，开导一下迷途中的子民，这些…也就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130151,
					"content": "关于教令院贤者们的计划…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130152
					]
				},
				{
					"id": 30130152,
					"content": "教令院对须弥的治理一直没出过什么大问题，这是我见到他们第一次脱离正轨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130153
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130153,
					"content": "究竟发生了什么事，有什么目的值得他们这么做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130154
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130154,
					"content": "尽管现在城里的人们几乎没有察觉异样，但若非旅行者破坏了「花神诞祭的轮回」，或许事态真的会很严重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130155
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130155,
					"content": "我试图在虚空中调查过，可虚空中没有任何可疑资料，关键人员也似乎刻意没有佩戴虚空终端…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130156
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130156,
					"content": "我想他们应该故意在掩盖些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130157
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130157,
					"content": "这让我想起，在化城郭的时候，有位贤者来邀请提纳里参加某项「工程」…难道说就是那个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130158,
					"content": "总之，必须优先查明贤者们的意图，进行纠正与惩罚…但也当心不要打草惊蛇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130159,
						30130169
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130159,
					"content": "人们没有发现虚空的问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130160
					]
				},
				{
					"id": 30130160,
					"content": "你是说使用虚空导致不再做梦的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130161
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130161,
					"content": "对呀，这么长时间以来，没有人觉得不对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130162,
					"content": "不是察觉不到，而是没有人在意。其实根源还是在于贤者们的「误导」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130163
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130163,
					"content": "「误导」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130164,
					"content": "贤者让人们以为不会做梦是理性与智慧的体现，须弥人不会做梦是须弥人的荣耀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130165
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130165,
					"content": "…但实际上，梦境只是被虚空「收割」走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130166
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130166,
					"content": "贤者们也因此可以最大化地利用虚空，使过往的那些研究能够更加顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130175
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130175,
					"content": "况且大慈树王当年创造虚空，也一定希望它可以物尽其用吧，所以我并未对这件事有很大意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130167
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130167,
					"content": "如此一来，贤者们宣扬的主流观点便淹没了质疑的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130168
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130168,
					"content": "甚至那些从来不用虚空终端，并且会做梦的须弥人，也只会认为这是一种不好意思说出口的耻辱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130151,
						30130169
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130169,
					"content": "没什么问题了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130170
					]
				},
				{
					"id": 30130170,
					"content": "这样吗。但愿我的回答，可以让作为「求知者」的你们满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130171
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130171,
					"content": "其实之前维持迪娜泽黛即将消失的梦境的时候，对我精神力的耗损非常大…我恐怕需要小憩一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130172
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130172,
					"content": "这段时间里倒不怎么需要担心贤者们的行动，像「花神诞祭的轮回」这种大工程，短时间内虚空不可能进行两次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130173
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130173,
					"content": "嗯，你去睡觉吧，有我们看着呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130174
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130174,
					"content": "呵呵，真令人安心。哈欠——这可真是我出生以来最累人的一次生日了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130301
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130301,
					"content": "唔…旅行者？派蒙？我为什么会在这里，你们有什么头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130302
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130302,
					"content": "呃…可能是梦游？你知道，不能叫醒梦游的人的，所以我们只是…只是路过在这里等你醒来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30130303,
					"content": "是这样啊，嗯…有空该找找维护人员了。啊，我没事，一会儿我就回去了，谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 30130110,
					"content": "可真是奇迹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130111
					]
				}
			]
		},
