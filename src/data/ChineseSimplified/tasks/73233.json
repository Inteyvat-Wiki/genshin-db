			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"内尔敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "屋内的某人似乎听到了动静…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "你好，请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 732330503,
					"content": "关于这盆花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "这是…里夫送给我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 732330505,
					"content": "这盆里种着花吗？真的？谢谢你帮他送来，我很喜欢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 732330506,
					"content": "不过…我真的能养好它吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 732330507,
					"content": "你之前没养过花吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "我…我不擅长照顾植物，之前好多盆绿植都被我养得枯萎了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 732330509,
					"content": "这盆花一定更娇贵，要是我又把它给养枯的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 732330510,
					"content": "唔，不行，既然花已经到我手上了，我就要好好照顾它才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 732330511,
					"content": "库尔苏姆奶奶一定知道怎么解决这个问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内尔敏"
				}
			]
		},
		{
			"id": 7323306,
			"completionStepIds": [
				7323306
			],
