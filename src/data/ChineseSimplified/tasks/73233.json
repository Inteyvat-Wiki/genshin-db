					"阿扎莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "唉，还有一批货物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 732330202,
					"content": "关于里夫的货物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "你是说里夫找我订的货物吗？我刚接了一批货，里面正好有他要的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 732330204,
					"content": "不过，他买的东西可不少啊…你是帮他来拿货的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 732330205,
					"content": "很，很重吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "除了那个花盆之外，还有各类种子，肥料和园艺用品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 732330208,
					"content": "这些东西加起来可不轻啊，你…你一个人搬得过去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 732330209,
					"content": "我自有办法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "这样啊…那行，我给你把东西都包好。真是辛苦你走这一趟了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 732330210,
					"content": "我都答应人家了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "有，有多少…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
			"id": 7323303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
