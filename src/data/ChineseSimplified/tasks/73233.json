			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "旅行者，你回来了，真是辛苦你了…内尔敏怎么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330602,
					"content": "她担心自己不会种花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "这个…我会陪着她研究这事的啦，实在不行就去找人问问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330604,
					"content": "要是真不行，我…我就…我就去找点容易种，又容易成活的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330608,
					"content": "咳，总之…谢谢你帮我的忙，旅行者，这些报酬请你收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330609,
					"content": "等会我就把其他的东西给内尔敏拿过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330610,
					"content": "等等，这些园艺工具没附带使用说明书吗？我完全不知道怎么用它们啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330605,
					"content": "你之前没送过她花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "也不能说没送过吧…只不过前几次我托人买的都是已经长成的花。等送到村里来的时候，那些花已经快被晒干了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330607,
					"content": "所以这次，我决定直接送内尔敏一盆刚种下的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "里夫"
				}
			]
		},
