				"points": []
			},
			"dialogs": [
				{
					"id": 732330301,
					"content": "旅行者！你把东西拿回来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				}
			]
		},
		{
			"id": 7323304,
			"completionStepIds": [
				7323307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323307",
							"2"
						],
						"stepId": 7323307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "就是这些，太谢谢你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330402,
					"content": "你是要开花店吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "哎呀，这不是…一次性买多点，免得总是出去嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330405,
					"content": "你先在旁边休息一下吧！我得先把种子种下去，再施点肥料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330406,
					"content": "里夫开始摆弄起了花盆…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "好了！这样就可以了，内尔敏只需要给这盆花浇浇水就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330408,
					"content": "旅行者，能不能…再请你帮我把这盆花送去给内尔敏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330409,
					"content": "你自己怎么不去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "我得盯着这个路口啊，要是有粮食或者物资运过来，我还得去叫村里的人过来接收物资。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330411,
					"content": "周围这温度…你应该已经感觉到了。要是接收速度太慢，物资说不定都会被晒坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330412,
					"content": "拜托你啦旅行者，内尔敏住得离这里不远，你就把这一盆花送去给她就好，其余的东西我会想办法运回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				},
				{
					"id": 732330403,
					"content": "你买这么多东西干啥！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
