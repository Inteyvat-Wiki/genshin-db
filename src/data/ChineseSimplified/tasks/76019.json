			},
			"dialogs": [
				{
					"id": 760190101,
					"content": "「识者之证」？难道是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190102,
					"content": "你、你们凑过来干什么，我们在谈很秘密的话题，关于雷德·米勒「伟大财宝」的线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190103,
						760190104
					],
					"speakerTitle": "维里"
				},
				{
					"id": 760190103,
					"content": "太好了，也算我一份吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				},
				{
					"id": 760190105,
					"content": "唔…对了，既然这样，那我们组队好了，我正愁凑不齐启动资金呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190106
					],
					"speakerTitle": "维里"
				},
				{
					"id": 760190106,
					"content": "我一个，你一个，还有会飞的一个，一共三份，我们三个正好，一人五十万摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190107
					],
					"speakerTitle": "维里"
				},
				{
					"id": 760190107,
					"content": "五十万摩拉？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190108,
					"content": "唉，维里小弟，不是说好了这是我们两个之间的秘密吗？我是信任你，才会告诉你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190109
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190109,
					"content": "可是一百五十万摩拉，对我来说实在不是启动资金级别的数目呀，五十万还勉强能够凑齐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190110
					],
					"speakerTitle": "维里"
				},
				{
					"id": 760190110,
					"content": "他们两个看起来也像是有经验的冒险者，我们组队的话，成功概率不是更高吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190111
					],
					"speakerTitle": "维里"
				},
				{
					"id": 760190111,
					"content": "#唉，我是很看好维里小弟的，既然{M#他们}{F#她们}是你看好的人选，那我也愿意交往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190112
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190112,
					"content": "不过呢，这位会飞的朋友，体型和咱们不一样，自然要特别关照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190113
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190113,
					"content": "哇，是有什么礼物要送给我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190114,
					"content": "嗯，因为是特别定制的，相比纳塔原版的「强水」，能够适应的人群也更广，会飞的朋友当然也能放心使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190115
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190115,
					"content": "至于价格嘛，要是别人，按理是得收两百万摩拉的，但看在你们是维里小弟的朋友的份上，就只要一百万摩拉好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190116
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190116,
					"content": "一百万摩拉？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190117,
						760190119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190117,
					"content": "是惊喜大礼啊，派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190118
					]
				},
				{
					"id": 760190118,
					"content": "根本就是惊吓才对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190121,
					"content": "就是啊，希丁芭小姐，会飞的这个原本我就没指望她能派上用场，「强水」就不必分给她了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190122
					],
					"speakerTitle": "维里"
				},
				{
					"id": 760190122,
					"content": "等一下，你这根本就不是在帮我说话吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190123,
					"content": "哼，原本只是想听听看有没有宝物的线索，结果你们两个家伙，根本就是一个坏一个笨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190124,
					"content": "#想要骗我和{NICKNAME}可没那么容易！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190125,
					"content": "谁是坏人？谁在欺骗？线索是真的，货品也半分不假，至于价钱嘛…那也是你情我愿的买卖。而像你这样聒噪的小东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190126
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190126,
					"content": "…我呢，最看不惯的就是你这样自以为是的家伙了，明明自己没多大本事，却腆着脸狐假虎威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190127
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190127,
					"content": "希、希丁芭小姐…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190128
					],
					"speakerTitle": "维里"
				},
				{
					"id": 760190128,
					"content": "维里小弟也是，既然是秘密的话题，当然要贴近了，小声地说，可你呢，却大着嗓门把这两个不速之客招来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190129
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190129,
					"content": "我现在烦得很，不让你们吃点教训，实在是心火难消呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190130
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190130,
					"content": "看招！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190119,
					"content": "五十万摩拉，不卖我就走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190120
					]
				},
				{
					"id": 760190120,
					"content": "你怎么开始砍价了？我们根本不需要这种东西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190104,
					"content": "已经被人听到就算不上秘密了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				}
			]
		},
