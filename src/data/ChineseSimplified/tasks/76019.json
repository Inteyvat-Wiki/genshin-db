			"dialogs": [
				{
					"id": 760190301,
					"content": "…要杀要剐，悉听尊便了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190302,
					"content": "#呜啊，我跟{NICKNAME}才不会做这么可怕的事！只要你之后不要再骗人就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190303,
					"content": "就算是维里这样的笨蛋…欸？那家伙什么时候溜了？总、总之就算是他那样的笨蛋也不能骗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190304,
					"content": "你们真善良，唉，如果我在须弥的时候也遇到像你们这样善良的人，也许就不会落到今天的下场了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190306,
					"content": "你们不问我遭遇了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190307,
					"content": "我的直觉让我别继续追问了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "真是敏锐的小鬼…唉，最近一段时间都没开过张，也许是时候改行了，我也不想被伏尼契商会盯上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190310,
					"content": "如果你能早点这么想，刚才就不用白白挨打啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190311,
					"content": "做出人生抉择时总归需要一个契机嘛，不管是好是坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190312,
					"content": "#{M#小弟}{F#小妹}，还有会飞的小东西，如果你们需要这个契机，可以随时来找我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "希丁芭"
				},
				{
					"id": 760190313,
					"content": "还、还是算了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760190314,
					"content": "希丁芭留下红绸，摆摆手离开了…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
