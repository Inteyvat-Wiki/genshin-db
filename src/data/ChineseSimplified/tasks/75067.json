				]
			},
			"dialogs": [
				{
					"id": 750670201,
					"content": "啊，这里果然是被诅咒了的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670202
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750670202,
					"content": "你们也不要过多停留了，快点离去吧…对，在漆黑的潮水到来之前，你们一定要离去才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670203
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750670203,
					"content": "对，漆黑的潮水，那巨大的影子就要来了，得…得让大家安全离开，要让大家…安全离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因"
				}
			]
		},
