			"dialogs": [
				{
					"id": 716710101,
					"content": "呃啊，不愧是夜兰都评价棘手的秘境，真的不一般呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710102,
					"content": "也不知道这个地脉紊乱点记录的都是什么战局…一般士兵真的能应付过来吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710103,
						716710104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710103,
					"content": "魔神战争的局部交战？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				},
				{
					"id": 716710105,
					"content": "唔…我猜，大概也没到…那么吓人的程度吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710106,
					"content": "你们回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710107
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710107,
					"content": "嗯，神色从容，应该取得了不错的战果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710108
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716710108,
					"content": "也确实遇见了非常惊险的情况！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710109,
					"content": "向刻晴和夜兰描述了其中的战况…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716710110
					]
				},
				{
					"id": 716710110,
					"content": "原来如此…实在有劳你们了，干得漂亮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710111
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710111,
					"content": "你们通过紊乱点造访秘境后，外溢的魔物显著减少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710112
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716710112,
					"content": "虽然没能直接清除紊乱点，但的确有效削弱了它的活性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710113
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716710113,
					"content": "得益于此，魔物们的棘手程度大大降低，普通的千岩军战士也能将它们击退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710115,
						716710116
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710115,
					"content": "进去一次，就明白了凶险。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710117,
					"content": "#怎么感觉，{NICKNAME}的斗志燃烧起来了…你还摩拳擦掌呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710118,
					"content": "#刚才，送往玉京台的加急信件得到了回复，天权星和开阳星一致同意，与{NICKNAME}达成长期合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710119
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710119,
					"content": "#得益于{NICKNAME}的努力，这个地脉紊乱点甚至可被我们妥善利用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710120
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710120,
					"content": "#此后，{NICKNAME}将获得驻军的全力支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710121
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710121,
					"content": "#紊乱点活跃期间，若是{NICKNAME}有意愿，便可攻入秘境。少量外溢的魔物则由千岩军处理，给战士们轮番练手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710122
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710122,
					"content": "算是转危为安，转祸为福了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710123,
						716710124
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 716710123,
					"content": "那从今以后，我定然全力以赴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710125,
					"content": "哎呀呀，可算松了口气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710126,
					"content": "话又说回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710127,
					"content": "地脉真是个奇妙的东西，总有一天，我们得想个办法，查出它更多的秘密才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710128,
					"content": "不知道能不能遇见什么聪明人，给我们翻出一本…《地脉百科全书》来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716710124,
					"content": "既然危险解除，我就酌情出勤！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710116,
					"content": "难对付的家伙，要慢慢搞定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710104,
					"content": "灾变之时的极端战况？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				}
			]
		}
	]
}