			"dialogs": [
				{
					"id": 220410101,
					"content": "汝等来了啊，来得正好，奴家正在发愁呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410102,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "汝等还记得「昆布丸」这个孩子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410104,
					"content": "这孩子去附近玩了之后，到现在也没有回来，奴家很担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410105,
					"content": "拜托汝等，去附近找找「昆布丸」，再把它带回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410106,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "那就拜托汝了，快点找到「昆布丸」，把它带回神社来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410108,
					"content": "只有它跑出去了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "只有这孩子…也许是上次奴家训斥了它，让它不高兴了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410110,
					"content": "这孩子，为什么总是这么不听话呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410111,
					"content": "拜托汝了，快点找到「昆布丸」，把它带回神社来吧。",
