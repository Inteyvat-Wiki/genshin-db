			"dialogs": [
				{
					"id": 220410301,
					"content": "怎么样，汝等找到昆布丸了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410302,
					"content": "已经找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "欸！它又跑不见了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220410304,
					"content": "我这就接着抓它回来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "汝等，不用去找它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410307,
					"content": "这孩子果然还在和奴家赌气…等会奴家自己再去教训一下那孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410308,
					"content": "明明都快成为一只大猫了，怎么还是这么任性，到时候要是惊到了来神社的人类可怎么办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410309,
					"content": "喔，这些东西给汝等，谢谢汝等帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410310,
					"content": "唉，为什么这孩子不能和「阿饭」一样听话呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220410305,
					"content": "我今天还不信了…",
