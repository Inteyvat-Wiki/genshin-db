			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马扎里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "生物火雨…难道，真如传说中那样，火山喷发会像活物一样肆意地进化和繁衍，把周边都同化成火山？完了完了，那可就危险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310102,
					"content": "火山可不是那样形成的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "是了是了，没有熔岩哪里来的火山。火山是不可能随便出现的，要不然这里早就成了危险区域了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310105,
					"content": "但、但要是万一传说是真的呢？嗯，要是那个能自动留影的留影机管用就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310106,
					"content": "等等，万一留影机出了什么问题没拍到画片，岂不是糟糕了？不行不行，我得找个时间去看一眼才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310103,
					"content": "不好意思，打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "再见…还是说，这其中另有隐情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马扎里"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马扎里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "原来生物火雨就是从天而降的浮燃鸟啊，怪不得范围比一般喷发要大呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310202,
					"content": "糟了，假如它们哪天砸到了我家里怎么办？不行，必须得要想个办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310203,
					"content": "只是特殊情况。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "对啊，浮燃鸟只有靠着火山喷发才有可能飞到天上去，我家又不在火山喷发的范围里，应该不需要担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310205,
					"content": "但、但要是有一天，来一场史无前例的大喷发呢？那是不是就没有地方是安全的了？不行不行，还是要想个办法才是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马扎里"
				},
				{
					"id": 751310206,
					"content": "不好意思，打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "没事，不打扰…总而言之，先加固一下房顶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马扎里"
				}
			]
		},
		{
			"id": 7513103,
			"completionStepIds": [
				7513106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
