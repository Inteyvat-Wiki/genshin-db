			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "——唔，像是活物一样的火、诡异的残影、能自动留影的留影机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310402,
					"content": "我的直觉告诉我，这其中一定蕴含着某个复杂且难以解释的谜团的！说不定还跟宝藏相关！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310403,
					"content": "派蒙看出什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "说实话…完全没有头绪！不过…留影机的主人把它放在这里，一定是为了拍到地面发生震动时的画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310405,
					"content": "所以我们只需要把留影机复原，然后等待地面发生震动就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310406,
					"content": "嘿嘿，我相信到那个时候，宝藏的线索就会像是那道残影一样，轰隆轰隆地钻出来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
