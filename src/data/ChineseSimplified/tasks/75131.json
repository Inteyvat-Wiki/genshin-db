			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "生、生物火雨！难道说火会像活物那样朝人的头顶飞过来吗？呜哇，纳塔的火山也太可怕了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}，我有一点点好奇。嘿嘿，要不我们现在就去前面的区域探索一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513102",
							"2"
