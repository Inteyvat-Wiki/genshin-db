			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "真的不能把这套卡的卡背复制一份给我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930102,
					"content": "抱歉，不可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930103,
					"content": "真的很帅，可以再商量一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930104,
					"content": "不可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930105,
					"content": "好吧，拿到好看的牌背和使用强力的卡牌都需要付出代价，我明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930106,
					"content": "你根本没明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "喂！你根本什么也没问，直接就说出原因了吗？说不定赛诺是来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930110,
					"content": "没错。不愧是我的挚友，我们已经心意相通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930111,
					"content": "还真是啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930112,
					"content": "最近枫丹这边正在举办一场小型的牌友聚会，据说，聚会上会发放免费的限定款式卡套。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930113,
					"content": "教令院没有什么要紧事，所以我就过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930114,
					"content": "就算是有要紧事，赛诺肯定也会把它变得不太要紧的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930115,
					"content": "是的，我只加了两个星期的班，就把所有事务都处理得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930116,
					"content": "赛索斯也帮忙了，他很适合做文本工作，我答应给他也带一副卡套作为补偿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930117,
					"content": "这位大风纪官，你到底抽不抽牌了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930118,
					"content": "当然要抽。你刚才说，这张牌可以用来预测我的未来，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930119,
					"content": "准确地说其实不是这样。不过你这么理解也没有什么太大的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930120,
					"content": "原来是这样…这就是《决斗王》里写的「赌上命运的下一轮抽牌」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930121,
					"content": "那么，到我的回合了，抽牌…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930122,
					"content": "赛诺深吸一口气，用帅气的姿势抽出了卡牌…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "是逆位的「节制」啊，被你这位须弥教令院的「大风纪官」抽到，倒是不出所料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930124,
					"content": "你之前听说过赛诺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "艾莉丝和我提起过几次，说古板的教令院，居然有这么一位富有幽默感的「大风纪官」，真是有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930126,
					"content": "谢谢夸奖。我已经抽了牌，接下来该做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930127,
					"content": "既然是逆位的「节制」，或者说逆位的「技艺」，那我会建议，你最好先保持「什么都不做」的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930128,
					"content": "你行事过于急躁匆忙，几乎要在命运的独木桥上失去平衡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930129,
					"content": "是我打牌太没有节制了吗？赛索斯和提纳里也这么说过我，我已经调整好时间表了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930130,
					"content": "…我不是说打牌。我是说工作时间。能够让你这位「大风纪官」全力应对的事，应该不止是「七圣召唤」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930131,
					"content": "除打牌之外，我的时间安排，基本上没有一丝一毫「调整」的余地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930132,
					"content": "如此安排所带来的压力，你习惯了独自承担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930133,
					"content": "还有诸位风纪官同僚，我们会一起承担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930134,
					"content": "但他们都指望着你。不止是风纪官，教令院的学者，须弥的民众…许多人，都指望着你这位「大风纪官」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930135,
					"content": "没人会提起这件事，或者，他们都没有意识到自己内心的这份想法…毕竟他们都被你的幽默感吸引住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930136,
					"content": "但你却每时每刻都能感受到那些目光…喔，还有那位与你同行的「影子」，他也是重担之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930138,
					"content": "你习惯了走在最前方，接过一个又一个重担…我想，或许这才是你「失衡」的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930139,
					"content": "我有许多朋友，还有「七圣召唤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930140,
					"content": "看来，你并不打算休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930141,
					"content": "还没到能够休息的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930142,
					"content": "确实，对你这样的人来说，如果内心的鏖战无休无止，那么哪怕是死亡之日，亦不是职责的终结之时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930143,
					"content": "收下这张「月谕圣牌」吧。或许它能指引你，找到那个足以让你重拾平衡的「理由」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930144,
					"content": "在那个时候，你内心的鏖战，应该也会走向最终的决战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930145,
					"content": "赛诺不会输的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#谢谢你，{NICKNAME}，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930148,
					"content": "也谢谢您，这张牌我收下了。我保证，不会把它带进梅洛彼得堡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930149,
					"content": "…哈？怎么莫名其妙的，等一下，难道说——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930150,
					"content": "怎么又来了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "…这和梅洛彼得堡有什么关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930154,
					"content": "因为这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930155,
					"content": "「越狱」圣牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛诺"
				},
				{
					"id": 746930151,
					"content": "转换得好快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "芭比洛斯女士，您不要——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "赛诺是最强的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "我根本不明白！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "你怎么来这里打牌了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
