					}
				]
			},
			"dialogs": [
				{
					"id": 402000101,
					"content": "夜景不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000102
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000102,
					"content": "清新的海露花香、街角香水店的芬芳、还有醇厚的咖啡豆味，在夜风中相融，氛围相当闲适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000103
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000103,
					"content": "如果能找到一间楼顶露台的小酒馆，小酌两杯起泡葡萄酒，就能收获一场绝妙的微醺体验了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000104,
						402000105
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000104,
					"content": "现在是清净的假期，那就喝吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				},
				{
					"id": 402000106,
					"content": "好呀…那就陪我找找看吧，隐伏在城中的宝藏酒馆，会不会藏着惊喜的酒单？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000107
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000107,
					"content": "不过，在那之前，趁着卡布里埃商会还没打烊，和我一起去挑选几种香水，搭配这身装束？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000108
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000108,
					"content": "还有精密的钟表，暗藏趣意的发条摆设，和工艺独特的首饰，值得一看的纪念品还不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000109,
						402000110
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000109,
					"content": "工作越久越想消费吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000111,
					"content": "有提瓦特见识最广博，审美最独到的旅者陪着我，我当然要抓住这个机会，请你好好当一回参谋啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000112
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000112,
					"content": "嗯…心满意足了，的确是一次不错的异国旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000113
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000113,
					"content": "如果能将时长放宽，慢慢游玩个三五天，还能消除仓促带来的遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000114,
						402000115
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000114,
					"content": "不是说要好好享受假期吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000116,
					"content": "没办法，下一桩差事已经来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000117
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000117,
					"content": "除了为这次的案件写一份正式报告，协助建设更完善的货物通关体系，我还要准备动身，前往下一个任务地点——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000118
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000118,
					"content": "挪德卡莱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000119,
						402000120
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000119,
					"content": "我和派蒙的下一站也是那里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000121,
					"content": "别紧张，只是和一位情报伙伴见个面，确定以后互利共赢的方案，还有互不干扰的边界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000122
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000122,
					"content": "详情以后再谈吧。为了纪念这次尽兴的枫丹之旅，一起合张影，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000123,
						402000124
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000123,
					"content": "也是为了纪念你领我上道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000125,
					"content": "#没错，我可以将我的后背毫无保留地交给你了，新晋王牌探员{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000126
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000126,
					"content": "就用最关键的「综像勘录仪」，来完成这张意义重大的留影吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000127
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000127,
					"content": "希望在挪德卡莱再见时，我们还能像这次一样，完美合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402000124,
					"content": "也是为了纪念我们成功合作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000120,
					"content": "有什么紧急情况惊动了你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000115,
					"content": "怎么好像又要回去工作一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000110,
					"content": "购物意愿爆发的时机正好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000105,
					"content": "刚刚完成一桩大案，尽情喝吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				}
			]
		},
