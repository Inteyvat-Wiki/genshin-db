			},
			"dialogs": [
				{
					"id": 402000201,
					"content": "也就是说，再等一会儿，丰克警官就会带我们去审讯坏家伙的地方，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000202,
					"content": "没错，你有机会看到我们的秘密基地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000203
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「执律庭」探员"
				},
				{
					"id": 402000203,
					"content": "哈哈，开玩笑的。为了避免闹出的动静干扰正常的工作，我们特意选了一座偏僻的民房。出发后，要跟紧我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000204
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「执律庭」探员"
				},
				{
					"id": 402000204,
					"content": "#没事没事！我可是最最称职的向导，以前和{NICKNAME}去过好多好多头都会绕晕的地方，不会在枫丹廷里迷路的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000205,
					"content": "#啊，{NICKNAME}来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000206,
					"content": "动作这么快？难道夜兰是那种…闭眼一会儿就休息好了的超级工作达人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000207,
						402000208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000207,
					"content": "还没去休假呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				},
				{
					"id": 402000209,
					"content": "嘿嘿，没事没事，别担心我。派蒙也是会成长的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000210,
					"content": "这次，所有的麻烦事都搞定了，你就放心和夜兰去玩一阵子吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000211,
					"content": "要抛掉一切烦恼，好好享受放松时光哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000212,
					"content": "我也一定保证，把派蒙小侦探照顾得好好的，派蒙小侦探想学什么本领，想吃什么零食，我们都全力满足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000213,
						402000214
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「执律庭」探员"
				},
				{
					"id": 402000213,
					"content": "那我去玩咯！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000215,
					"content": "嗯！我一定好好学习！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402000214,
					"content": "派蒙加油哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000208,
					"content": "不放心你，过来看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				}
			]
		}
	]
