					"speakerTitle": "遗迹宝藏"
				},
				{
					"id": 710131403,
					"content": "<color=#00E1FFFF>若有兴趣，可去池边一探，我在那埋下了些许财帛，你可自取。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "遗迹宝藏"
				},
				{
					"id": 710131404,
					"content": "但那三问，请你谨记于心，希望有一天，你能寻得解答…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "遗迹宝藏"
				}
			]
		},
