			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>『神之眼』</color>…实是超凡之物，世人皆说此物是上天所赐。却无人能说出，究竟何人可得此神物，又是为何得此神物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "遗迹宝藏"
				},
				{
					"id": 710131502,
					"content": "我看典籍中，有人说天道悯人，<color=#00E1FFFF>『神之眼』</color>乃是上天赐予凡人中出类拔萃者，助其降妖除魔，卫道世间。但我…却已经对魔物生不出荡涤之意，只想与他们沟通交流，探其本质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "遗迹宝藏"
				},
				{
					"id": 710131503,
					"content": "这<color=#00E1FFFF>『神之眼』</color>…不要也罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "遗迹宝藏"
				}
			]
		},
