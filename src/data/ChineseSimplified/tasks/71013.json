					"nextDialogs": [
						710130102
					],
					"speakerTitle": "遗迹宝藏"
				},
				{
					"id": 710130102,
					"content": "我和师弟潜修于此，欲求<color=#00E1FFFF>『神之眼』</color>，立此碑为证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
