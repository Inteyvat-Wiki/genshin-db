				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "我虽幸获<color=#00E1FFFF>『神之眼』</color>，但心中亦有疑惑。世间魔物不绝，以凡人之力，何日能荡清世间？而且那些魔物既有言语，也擅工造，亦有喜怒哀乐，除样貌形状外，实与人无异…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "遗迹宝藏"
				},
				{
					"id": 710130202,
					"content": "我将心中疑问刻于碑上，不知道后世观此碑者，能否为我解惑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "遗迹宝藏"
				}
			]
