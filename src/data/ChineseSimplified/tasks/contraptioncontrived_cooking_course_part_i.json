			"dialogs": [
				{
					"id": 715000201,
					"content": "你们拿到竹笋了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留云借风真君"
				}
			]
		},
		{
			"id": 7150003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150005",
							"2"
						],
						"stepId": 7150005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留云借风真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "其余的事就交给这机关，但是旅行者，还得请你帮忙照看一下火候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 715000304,
					"content": "这机关不能自动控制火候吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "这个嘛…本仙之前也尝试过将灶火内置，想要以机关控制火候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 715000306,
					"content": "但「机关烹饪神机」所需的灶火不同寻常…必须得是本仙亲自操控仙力化出的火焰才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 715000307,
					"content": "若是把这种等级的仙火内置，一些细小的机关部件可能会被烤得变形，导致机关失灵。因小失大，实不可取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 715000308,
					"content": "目前最好的解决方法，还是将仙火置于机关外部。只是如此一来，我需要一个人帮着控制火候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 715000309,
					"content": "兹事体大，旅行者，火候的掌控就交给你了。你准备好了之后，就来告诉本仙一声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留云借风真君"
				}
			]
		},
		{
			"id": 7150004,
			"completionStepIds": [
