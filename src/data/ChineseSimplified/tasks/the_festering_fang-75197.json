				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970505,
					"content": "乌尔班开始制作武器…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970501
					]
				},
				{
					"id": 751970501,
					"content": "做好了！哈哈哈，来，拿好了，是不是很有份量感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970502
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970502,
					"content": "我要付多少钱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970503
					]
				},
				{
					"id": 751970503,
					"content": "钱？不需要，你能拿来这些材料让我制作武器，我就已经很满足了，你不需要再付钱给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970504
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970504,
					"content": "好了，拿着这把武器去冒险吧，你可要好好珍惜它啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌尔班"
				}
			]
		},
		{
