			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乌尔班"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970602,
					"content": "你回来了，那些「牙齿」…哦，你已经找齐了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970603
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970603,
					"content": "你们去冒险的时候，我这边遇到了点问题，无论我用什么方法，都没办法从这枚「牙齿」上敲下来一点碎屑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970604
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970604,
					"content": "我还从没遇到过这样的奇事，于是就托人去问了阿贝多先生，该怎么处理这样的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970605
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970605,
					"content": "于是——喏，你看，阿贝多先生托砂糖小姐送来了一块符石，就摆在那边的炼金合成台上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970606
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970606,
					"content": "欸，符石？这和我们找到的「龙牙」有什么关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751970607,
					"content": "这个嘛，按照砂糖小姐转述阿贝多先生的说法，要想用这种材料来锻造武器，必须先进行一些特殊处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970608
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970608,
					"content": "其中一种处理方法，就是让一枚龙牙汲取到某种和龙有关的「生命力」，再用它来处理其他龙牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970609
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970609,
					"content": "这枚符石——我想想砂糖小姐是怎么说的——哦对，据说是「一千年前帮助蒙德反抗旧贵族的某支流浪乐团留给骑士团的遗物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970610
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970610,
					"content": "那支乐团的笛手，曾在烬寂海与当地人称作「巴窟纳瓦」的可怖魔兽交战，从它身上斩下了这块符石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970611
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970611,
					"content": "总之，阿贝多先生说，这块符石中就蕴藏着与龙的力量相近的「无限的生命力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970612
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970612,
					"content": "只要借助炼金合成台，用龙牙汲取符石中的生命力，就能用它来锻造武器了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970613
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970613,
					"content": "听、听起来好像很厉害…该说不愧是阿贝多吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970614,
						751970616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751970614,
					"content": "之后要谢谢阿贝多才行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970615
					]
				},
				{
					"id": 751970615,
					"content": "#是呀是呀！否则真不知道要怎么办才好…总之，{NICKNAME}，我们接下来就试试汲取符石的力量吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751970617,
					"content": "哈哈，那就太好了。来，这枚「牙齿」给你，这件事就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970618
					],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970618,
					"content": "不过，炼金术的力量还真神奇啊，居然能从千年前的石头里提取出「生命力」…究竟是怎么做到的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌尔班"
				},
				{
					"id": 751970616,
					"content": "好，就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970617
					]
				}
			]
		},
