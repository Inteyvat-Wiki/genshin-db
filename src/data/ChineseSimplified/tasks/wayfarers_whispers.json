					}
				]
			},
			"dialogs": [
				{
					"id": 756690101,
					"content": "#{NICKNAME}，你来你来，有些好东西要给你看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690102,
					"content": "你看，这些都是我在旅行路上拍的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690103,
					"content": "我们又走过了好多地方，在你四处探路的时候，我也没有闲着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690104,
					"content": "喏，这些都是我拿自己的留影机拍下的画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690105,
					"content": "对了，你还记得我们在达莫维百货买过两本留影册吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690106,
						756690108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690106,
					"content": "记得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690107
					]
				},
				{
					"id": 756690107,
					"content": "我就知道你还记得，当时我可是提前好久、拿出攒了好久的零钱才预订到那两本留影册。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690111,
					"content": "那两本留影册咱们两个人一人一本，款式一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690112,
					"content": "我的那本里已经攒了好厚好厚的一摞画片，不知道你的那本有没有拍满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690113,
					"content": "我刚买了一本新的留影册，本来打算留作备用的，但如果你的留影册已经拍满了，就拿去用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690114,
						756690117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690114,
					"content": "派蒙喜欢留影吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690115
					]
				},
				{
					"id": 756690115,
					"content": "对哦，你想，我们一起走过了那么多地方，看过了那么多普通人想都不敢想的风景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690116,
					"content": "如果不留一些纪念下来，就太可惜了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690121,
					"content": "而且，更重要的是，这是我们两个人的重要回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690122,
					"content": "过去的回忆和未来的经历都要好好珍惜，这句话是嵴锋龙部落的帕加尔大叔跟我说的，很有道理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690123,
					"content": "这次，我就再把自己的留影机借给你，再多留下一些画片好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690124,
					"content": "马上就要踏上至冬的领土了，我总有种预感，下一段旅程可能不会很轻松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690125,
					"content": "在那之前，好好地整理一下我们一路旅行感受到的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690126,
					"content": "这样不管碰到什么困难，只要想起我们共同经历的点点滴滴，一定会充满勇气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690117,
					"content": "派蒙真大度！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690118
					]
				},
				{
					"id": 756690118,
					"content": "哼哼，那还用说，全提瓦特最好的向导派蒙身上可不只有大度这一种优秀品质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690119,
					"content": "特意多买一本留影册其实也是因为我喜欢留影嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690120,
					"content": "我们一起旅行的路上见过了那么多特别的风景，不留下点纪念实在太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690108,
					"content": "不记得了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690109
					]
				},
				{
					"id": 756690109,
					"content": "欸，居然不记得了吗？当时我可是提前好久、拿出攒了好久的零钱才预订到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756690110,
					"content": "算啦，你每天要操心的事也挺多的，宽容大度的向导派蒙我不会介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}