			"dialogs": [
				{
					"id": 761530101,
					"content": "出版业也不挣钱哪，要不干脆只做投资算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530102,
					"content": "想看看投资券…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "好嘞，投资券2000摩拉一张，每周结算一次，嘿嘿，这小袋子里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530104,
					"content": "…呃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530105,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "雅珂达，你怎么来了，是奈芙尔老板有什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530107,
					"content": "没有，我就是陪着我的朋友来这里随便逛逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761530108,
					"content": "嘿嘿，看来萨维特老板的投资生意确实做得很好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761530109,
					"content": "一般！一般，哈哈哈…小本生意，糊口罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530110,
					"content": "（这丫头…话里有话！肯定是奈芙尔派她过来的…嘁。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530111,
					"content": "这真的能赚钱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "当然啦，老板说了，萨维特老板可是最最有声望，最最有能力的商人。跟着他投资，准没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761530113,
					"content": "是…是…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530114,
					"content": "（果然是奈芙尔…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530115,
					"content": "那什么时候能结算投资…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "今天！就在今天，您刚才买的是我们刚刚推出的…短线投资券！盈亏立即结算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530117,
					"content": "怎么感觉这些话都是你刚刚才编出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761530118,
					"content": "呃…总、总之，感谢您购买短线投资券！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530119,
					"content": "这是您的投资回报，祝您拥有美好的一天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530120,
					"content": "总之赚钱是好事啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "真的？嘿嘿嘿，那你给我买一个小鸟形状的，我就喜欢那样的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761530123,
					"content": "欸，我和你们一起去，给老板也带一个回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761530124,
					"content": "雅…雅珂达小姐，稍等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530125,
					"content": "…那个，奈芙尔老板是否交代您了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530126,
					"content": "啊。老板说：「东西已经找到了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761530127,
					"content": "「萨维特先生，不要心急。事情，要一步一步地做才稳当。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761530128,
					"content": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望二位了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨维特"
				},
				{
					"id": 761530121,
					"content": "走，派蒙，我们去买糖雕吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				}
			]
