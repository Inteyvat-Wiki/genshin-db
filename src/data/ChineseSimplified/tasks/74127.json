			"dialogs": [
				{
					"id": 741270401,
					"content": "天哪…真是太高了，太高了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270402,
					"content": "你是在描述科学院的学术水平吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "不，我就是在说这里的高度，虽然之前科学院的学术水平确实也不低啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270404,
					"content": "至于现在…唉，谁又想得到科学院会遭那么多罪呢？也不知道重建工作能不能顺利进行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270405,
					"content": "最后一站是…「枫丹科学院驻外资质审核办公室」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270406,
					"content": "亏你能一口气念下来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "多谢您的夸奖。但是这地方在哪？我在科学院里并没有发现这个办公室啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270408,
					"content": "办公室的负责人是德斯诺斯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "对！没错，这地方您也知道？果然不愧是科学院的荣誉高级研究员，简直是科学院万事通啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270410,
					"content": "喔…我也记起来了！是那个在废墟里的办公室？如果…那也算办公室的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270411,
					"content": "也许是德斯诺斯先生为了方便您理解，将前面的前缀都暂时省略了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270412,
					"content": "请您带路吧，我得去那边找德斯诺斯先生拿一些文件，拿完文件后，我就可以回复律庭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270413,
					"content": "今天可真是顺利，我马上就可以回去歇着了。枫丹科学院的作风果然不同于…咳，我、我什么都没说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
