						],
						"pointId": 6038
					}
				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "…就像我之前强调的那样，亲爱的复律官，规定如此，我也没有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270102,
					"content": "洛耶茨先生确实已经寄来了所需文件的清单，我也准备好了那些文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270103,
					"content": "但是，你不能就这么走过来「取走文件」，这不符合寄送信函的规定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270104,
					"content": "欸？艾尤恩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "你好呀，艾尤恩。看起来你状态不错嘛，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270108,
					"content": "您也好。这都是多亏了洛耶茨先生和瑟米安先生帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270109,
					"content": "#咦？艾尤恩，你和{NICKNAME}认识吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270110,
					"content": "#当然，{NICKNAME}之前帮了我很大的忙，要是少了{M#他}{F#她}，我肯定不会继续在复律庭工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270111,
					"content": "#竟然还有这种事？{NICKNAME}不愧是我们枫丹科学院的荣誉高级研究员啊，哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270112,
					"content": "我很擅长提供精神支持的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "无论如何，要是当初没了您的支持，我肯定…肯定没法撑下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270115,
					"content": "我刚才听舒瓦瑟尔先生说，您是枫丹科学院的「荣誉高级研究员」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270116,
					"content": "可不是，我还有奖状呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "还拍了画片呢！画片里还有我，可惜我没有奖状…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270118,
					"content": "#没错，为了表彰{NICKNAME}之前所作出的功绩，我院已为{M#他}{F#她}授予了荣誉高级研究员称号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270119,
					"content": "#至于这「功绩」是什么…就让{NICKNAME}自己告诉你吧，我们还是继续谈正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270120,
					"content": "那份文件，我的确无法现在就交给你，艾尤恩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270121,
					"content": "但你之前说，想要请一位研究员为你引路，去枫丹科学院附近留影…这件事毫无问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270122,
					"content": "#我认为{NICKNAME}完全堪当此任，{M#他}{F#她}对这周围的地形再熟悉不过了，一定能胜任这份工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270123,
					"content": "#您怎么说？{NICKNAME}{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270124,
					"content": "没问题，交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "您心真好，有您同行我就放心了。我来的时候看见这周围又是失控的机关，又是魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270127,
					"content": "但留影这件事并不是重点…说真的，舒瓦瑟尔先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270128,
					"content": "艾尤恩，我也想帮你，但规定如此，我也是有心无力啊。你就别为难我这个只会盖章的事务官啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270129,
					"content": "好吧，好吧…我回去和洛耶茨先生再商量商量这件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270130,
					"content": "再见，舒瓦瑟尔先生，祝您有愉快的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270131,
					"content": "谢谢你，在枫丹科学院里，也祝你愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "舒瓦瑟尔"
				},
				{
					"id": 741270132,
					"content": "#{NICKNAME}，那么引路的事就拜托您了，我们先去「玛丽安纪念公园」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270125,
					"content": "很高兴能帮上艾尤恩的忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "我只是修了一下自动盖章机啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "那等会我带着你再飞过来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}！我真高兴能在这里见到你，真是太巧了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "艾尤恩"
				}
			]
		},
