							4471.684,
							541.04,
							3851.864
						],
						"pointId": 6040
					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "呃…这里就是「玛丽安纪念公园」吗？完全看不出来公园的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270202,
					"content": "洛耶茨先生肯定要失望了，他还打算请人来这里做个演讲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270203,
					"content": "看看这环境，演讲应该是做不成了…而且连标志性建筑都没有，合影也合不成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270204,
					"content": "可以抓点机关回去做纪念品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "哈哈哈，您真幽默。但复律庭里可没地方放这种东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270206,
					"content": "而且就算抓回去了，我还得把这机关拿去估价、备案、分类、然后再封存…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270207,
					"content": "喂！我们就是开个玩笑，不要突然这么认真地开始思考工作的事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270208,
					"content": "说起备案…我还是没把那份文件拿到，洛耶茨先生肯定又要叹气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270209,
					"content": "舒瓦瑟尔为难你了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "也谈不上为难，我…我的请求确实有些违反规定了，他不答应是很正常的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270212,
					"content": "事情是这样的。枫丹科学院不是正在筹划重建工作吗？一些物资和人员调配需要通过复律庭来沟通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270213,
					"content": "复律庭很重视这件事，于是就让洛耶茨先生组织一支考察队，准备来科学院附近实地考察一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270214,
					"content": "于是，洛耶茨先生留在复律庭里统计人员，我则来科学院协调接待事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270215,
					"content": "正好科学院要寄一份信函回复律庭，我就想着，既然我都来这边了，就顺便把信带回去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270216,
					"content": "但舒瓦瑟尔先生却说，这种行为不符合规定，怎么说都不给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270217,
					"content": "不符合规定？又是不符合哪一条规定呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270218,
					"content": "取一个文件都有规定？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "呜哇，难道又是那些跑来跑去盖章、到处签字、最后听人啰啰嗦嗦之类的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270220,
					"content": "简单来说，复律庭内大部分的公务信函往来，都必须要使用「信件投递」的模式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270221,
					"content": "欸？那…那假如要寄信的部门，相距就一条街，或者干脆就是对门呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741270222,
					"content": "…那也要用信件投递。这是为了保证复律庭内所有公务函件的「可追溯性」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270223,
					"content": "他们是真不嫌麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "我猜想，大家应该已经麻烦惯了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270225,
					"content": "算了，先不谈这些。我们去下一个地方吧，让我看看洛耶茨先生写给我的备忘录…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270226,
					"content": "这个地方叫…枫丹科学院的「学术会堂」。真奇怪，我来的时候没见到挂这牌子的建筑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270227,
					"content": "我知道在哪，你跟着我走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "您真是可靠！一如既往的可靠，没了您我还怎么工作呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270229,
					"content": "那咱们就快点出发吧，说不定这周围还有更多失控的机关呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270211,
					"content": "你和舒瓦瑟尔讨论什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
