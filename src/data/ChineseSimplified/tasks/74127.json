			"dialogs": [
				{
					"id": 741270301,
					"content": "这就是枫丹科学院的「学术会堂」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270302,
					"content": "我承认，这建筑看上去确实挺像「会堂」的，但学术在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270303,
					"content": "学术在研究员们的脑子里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "好吧，幸好我今天不是为了学术而来的。无论如何，这个建筑看着还挺…完整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270306,
					"content": "也就剩下完整了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "咳！来吧，咱们去周围逛逛，我觉得这里肯定很适合来一张合影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270308,
					"content": "我得先去找个好角度，免得到时候洛耶茨先生问起来，我又手忙脚乱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME}，请您也帮我去拍几张画片吧。我听说您很擅长留影，拍得肯定比我好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 741270310,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "反正肯定不在这些石头里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
