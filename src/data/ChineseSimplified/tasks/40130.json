				},
				{
					"id": 401300505,
					"content": "然后祖莉亚夫人就会好起来，对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300506,
					"content": "一定会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300507
					]
