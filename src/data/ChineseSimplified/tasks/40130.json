			"dialogs": [
				{
					"id": 401300201,
					"content": "喂？有人在吗？这里是祖莉亚夫人家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300202,
					"content": "哪位？屋内有病人在静养，没有要事就请回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300203
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300203,
					"content": "谁是病人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300204
					]
				},
				{
					"id": 401300204,
					"content": "门在一阵短暂的沉默后打开了，一个男人走了出来，他的眼神满是疑惑…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300205
					]
				},
				{
					"id": 401300205,
					"content": "这里是祖莉亚·德斯特雷家，我是她的家庭医生贾拉康。你们刚刚的话什么意思？还有谁是病人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300206
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300206,
					"content": "不是祖莉亚夫人的孩子吗？她亲口告诉我们的，说她的孩子得了孤独病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300207,
					"content": "没错，莱斯科少爷确实患过孤独病，可他…算了…总之少爷已经不在了，现在孤独病又缠上了夫人，你们…是她的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300208
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300208,
					"content": "在沉默的间隙中，讲述了这几天的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300209
					]
				},
				{
					"id": 401300209,
					"content": "原来这几天她要求的散心时间，是和你们在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300210
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300210,
					"content": "所以其实…陷入失控性幻想的人是祖莉亚夫人自己？她以为她的孩子还活着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300211
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300211,
					"content": "是的，少爷出事那天，夫人正在操办一场画展，那是专门为少爷准备的，可却反而让夫人没能见到她的孩子最后一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300212
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300212,
					"content": "或许这成了她的心结，又或许早在夫人的丈夫意外离世时，孤独病的种子就已经扎根在这个家庭了，先是少爷，再是夫人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300213
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300213,
					"content": "怎么会这样…可祖莉亚夫人明明看起来一切都很好…她笑得很开心，她还教我们乐观，她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300214,
					"content": "这正是病人混淆幻想与现实的表现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300215
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300215,
					"content": "那她和我们说的，关于她孩子的那些事…难道都是假的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300216,
					"content": "不，那些事都是真的，只不过是少爷离开之前发生的事，而夫人的时间也停留在了那一刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300217
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300217,
					"content": "所以在那之后，她就幻想出了一个世界，那个世界里她的孩子还在，她正努力想要治好孩子的病，她找到了我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300218
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300218,
					"content": "那现在祖莉亚夫人怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300219
					]
				},
				{
					"id": 401300219,
					"content": "这几天她情绪一直不错，每次散心都是哼着歌儿回来的，还主动和我讨论了关于引导幻想来缓解孤独症的疗法，直到昨晚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300220
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300220,
					"content": "夫人对着少爷的遗物看了一夜，是一颗刻着遗言的贝壳…然后她再次崩溃了…我给夫人开了一些镇静的药物，她现在还在休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300221
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300221,
					"content": "那…那该怎么办呀？怎么样能帮到她吗？我们快帮帮祖莉亚夫人吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300222,
					"content": "别着急派蒙…别着急…虽然这个消息让人难过，但我们现在必须要冷静一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300223
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300223,
					"content": "（怎么办？快想办法…想想曾经的壁炉之家…想想那些孩子…那些病人…还有医生的话…啊！有了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300224
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300224,
					"content": "贾拉康医生，你有没有见过一个绘本，祖莉亚夫人应该把它带回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300225
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300225,
					"content": "年轻人…你是想用夫人说的那个引导幻想的方法吗？我明白了，我去拿来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300226
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300226,
					"content": "医生很快拿着绘本交给了菲米尼。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300227
					]
				},
				{
					"id": 401300227,
					"content": "没错…就是这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300228
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300228,
					"content": "我们要继续完成绘本和历险？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300229
					]
				},
				{
					"id": 401300229,
					"content": "嗯…如果按照贾拉康医生所说，那我们这几天经历的一定对夫人有帮助，所以我们该继续完成它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300230
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300230,
					"content": "我们要让祖莉亚夫人看见，她的孩子在那个世界有了美好的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300231
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300231,
					"content": "但是…这难道不会让她更难以接受现实吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300232,
					"content": "接受现实的前提是直面现实，夫人被崩溃的情绪击倒，不敢再看一眼现实，我们首先得帮她脱离这个状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300233
					],
					"speakerTitle": "贾拉康"
				},
				{
					"id": 401300233,
					"content": "嗯…在今天前，我以为《特尔克西的奇幻历险》是祖莉亚夫人用来拯救她孩子的，但现在我想，那也许是用来拯救夫人自己的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300234
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300234,
					"content": "如果我们完成它，我想祖莉亚夫人就能获得些许慰藉和鼓舞，也就能获得些许直视现实的勇气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300235
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300235,
					"content": "只能试一试了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300236
					]
				},
				{
					"id": 401300236,
					"content": "事不宜迟…我们现在就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲米尼"
				}
			]
		},
