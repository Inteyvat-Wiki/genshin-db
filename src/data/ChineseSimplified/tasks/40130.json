						401300647
					]
				},
				{
					"id": 401300647,
					"content": "#{NICKNAME}，派蒙，你们来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300648
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300648,
					"content": "菲米尼！这么急着找我们，是不是有祖莉亚夫人的消息啦？不是好消息我不听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300649,
					"content": "放心，是很好的消息。刚才在医生的陪同下，夫人来了一趟，她看起来气色很不错，人也很有精神。",
					"roleType": "TALK_ROLE_NPC",
