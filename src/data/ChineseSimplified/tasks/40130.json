			"dialogs": [
				{
					"id": 401300801,
					"content": "嘿！菲米尼！「特尔克西」！我们来啦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300802,
					"content": "#你好，派蒙，还有{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300803
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300803,
					"content": "-.. -... .-- -...？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300804
					],
					"speakerTitle": "「特尔克西」"
				},
				{
					"id": 401300804,
					"content": "今天王冠是不是已经做好啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300805,
					"content": "嗯，现在就等祖莉亚夫人了，她还没到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300806
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300806,
					"content": "那我们再等一会好啦，或者直接去找她，反正离的也不远，她家就在那边的山坡上吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300807,
					"content": "#喂！{NICKNAME}！派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300808
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300808,
					"content": "嘿嘿，说着说着就来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300809,
					"content": "终于找到你们了…你们没事真是太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300810
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300810,
					"content": "咦？德拉萝诗小姐，怎么是你？我们能有什么事呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300811,
					"content": "什么事？当然是特尔克西啊！那个可怕的水妖！那天委托你们之后，我也放不下心，又去打听了一下那个走进水里的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300812
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300812,
					"content": "那个我们都调查清楚了，其实就是菲米尼这家伙啦，鱼群也是他吓跑的。你放心，等我们完成工作，就能帮你把鱼群找回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300813,
					"content": "抱歉，我是一名潜水员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300814
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300814,
					"content": "欸？菲米尼？潜水员？不不不…这不对吧？我的消息可不是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300815
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300815,
					"content": "我打听到，大概一个月前，有个孩子在身上绑满了沉重的贝壳，走进了身后这片水中…再也没回来…这绝对是被水妖蛊惑了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300816
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300816,
					"content": "什么？你…你应该搞错了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300817,
					"content": "千真万确，我向几位德高望重的渔师都确认过了，那孩子今年八岁，叫莱斯科，莱斯科·德斯特雷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300818
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300818,
					"content": "等等…莱斯科·德斯特雷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300819
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300819,
					"content": "对，就是这个名字，据说他家祖上是从一个叫斯特雷的地方搬来的，他母亲是一位小有名气的画商，父亲说是早就意外离世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300820
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300820,
					"content": "唉…出了这事，他母亲大受打击，一病不起，听说现在已经离开枫丹廷，不知去哪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300821
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 401300821,
					"content": "不会吧？莱斯科·德斯特雷…祖莉亚·德斯特雷…不会这么巧吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401300822,
					"content": "看来得去一趟祖莉亚夫人家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300823
					]
				},
				{
					"id": 401300823,
					"content": "这位小姐，抱歉了！我们有事得先离开一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300824
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401300824,
					"content": "噢噢…你们先忙，我就是来看看，你们没事就好，那我就先回去了…你们注意安全哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德拉萝诗"
				}
			]
		},
