			"dialogs": [
				{
					"id": 722392401,
					"content": "（墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "一块古老的石碑"
				},
				{
					"id": 722392402,
					"content": "（第二排为通用文字，上面写着：）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "一块古老的石碑"
				},
				{
					"id": 722392403,
					"content": "「义士斯巴达克，今称『须婆达之彦』，之凭吊处。以下为其罪诏之翻译。望参观诸君谨记历史。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "一块古老的石碑"
				},
				{
					"id": 722392404,
					"content": "「贼子须婆达之彦，兴大罪之师，动国之根基。今奉常世大神谕，抉其目，菹其魂，羁幻之重狱，永生永世。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一块古老的石碑"
				}
			]
		}
	]
}