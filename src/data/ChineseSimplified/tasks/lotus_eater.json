			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"须婆达之彦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "孩子们，永远不要放弃，希望就在你们之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390102,
					"content": "是你们吗？孩子们，你们成功了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390103,
					"content": "不，不是…我感觉到了，你们不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}，他好像个目盲之后被留影的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390105,
					"content": "不论你是什么人，请帮帮我！帮我找到孩子们，我有话要告诉他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390106,
					"content": "可是，你是谁呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "我…我的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390108,
					"content": "我…忘记了我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390109,
					"content": "我只记得…我曾为白夜国站了出来，为了希望战斗过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390110,
					"content": "我至今仍然是反抗军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390111,
					"content": "可是在白夜国这样的地底国家，你在反抗什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390112,
					"content": "当然是庙堂之上污秽的贵人们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390113,
					"content": "他们号称接收着神明的旨意，嘴上打着神明的旗号，做的事却只为满足他们的低劣欲望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390114,
					"content": "表面上是太阳之子们的监护者，实际上就是国家的统治者，本质上却是趴在人民身上吸食血肉的虫豸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390115,
					"content": "他们必须要被消灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390116,
					"content": "这些记得这么清楚，却连自己的名字都忘记了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390117,
					"content": "那是因为他们的手段就是这么残忍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390118,
					"content": "因为上次的失败，他们抓住了我，将我囚禁在这处祭坛里折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390119,
					"content": "这是一个恶毒的囚牢，我能感觉到，我的灵魂被碾磨，有珍贵的东西在流失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390120,
					"content": "善良的人啊，我恳求你，趁我还记得这些，请去帮我找到孩子们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390121,
					"content": "告诉他们，永远不要放弃，希望就在他们之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390122,
					"content": "孩子们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "有一批愿意跟随我的青年人，他们很聪明。他们是我的学生，也是我们的后备军。我把他们看作是我的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390124,
					"content": "邪恶的大人们想尽各种办法要撬开我的嘴，让我交代孩子们的情报，我不可能开口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390125,
					"content": "因为我知道，希望就在他们之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390126,
					"content": "现在这个时间点，他们应该都不在了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390127,
					"content": "不，不会的！他们都是好孩子，一样怀揣着理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390128,
					"content": "我都没有放弃…他们一定还在坚持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390129,
					"content": "应该如何找到他们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "我肯定记得，这种事我肯定记得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390131,
					"content": "我告诉你他们的藏身处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390132,
					"content": "但是如果找到了他们，要怎样说明来意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390133,
					"content": "「我们是一位忘记名字的反抗军大叔派来的」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390134,
					"content": "不，这还不够，我把他们教得很好。除非你们能够证明自己，否则他们绝对不会信任你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390135,
					"content": "但我现在却连名字都想不起来了，可恶啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390136,
					"content": "#{NICKNAME}，这位大叔看起来曾经是白夜国的重犯。怎么说也是个历史里能留名的级别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390137,
					"content": "他的线索应该不难找到吧，说不定附近就有。我们可以先找找看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390138,
					"content": "如果在历史里留下名字，我希望这名字让我们事业的后继者来书写。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "须婆达之彦"
				}
			]
		},
