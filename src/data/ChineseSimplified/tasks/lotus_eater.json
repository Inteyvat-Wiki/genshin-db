						722391906
					]
				},
				{
					"id": 722391906,
					"content": "斯巴达克老师？！是老师吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391907,
					"content": "他在哪里？我只知道他在动乱里被太阳之子的党羽抓住了。之后就再也没有他的消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "阿多尼斯"
				},
				{
					"id": 722391908,
					"content": "他被关在蛇心之地的祭坛…以他的状态恐怕出不来了，所以拜托我们来寻找你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722391909,
					"content": "该死的太阳之子…",
					"roleType": "TALK_ROLE_NPC",
