					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390301,
					"content": "你们…你们是谁？你们的声音有熟悉的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390302,
					"content": "欸？这么快把我们忘了...大叔的状况已经这么差了吗？好担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390303,
					"content": "谢谢，我们真的认识吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390304,
					"content": "我们刚刚才见过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "啊，我想起来了…在这里灵魂会被磨损，我的记忆衰退太严重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390307,
					"content": "抱歉，我…唉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390308,
					"content": "你们找到了有用的信息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390309,
					"content": "你的名字是须婆达之彦吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "须婆达之彦...须婆达之彦，没错！我就是反抗军的首领，斯巴达克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390313,
					"content": "所以须婆达之彦和斯巴达克，都是大叔的名字吗？不愧是首领大叔啊，连名字都有两个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390314,
					"content": "感谢你们找回了我的名字，我好像还想起了一些别的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390316,
					"content": "「黑暗来自太阳之后，光明藏于你我之中。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390317,
					"content": "这是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "这是我们反抗军的秘密口令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390319,
					"content": "找回了名字，记忆也逐渐回来了。这应该就是我们的暗号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390320,
					"content": "现在，让我把孩子们的藏身处告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390321,
					"content": "有什么需要我带话的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "让我想想，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390323,
					"content": "把我的话带给他们，让他们永远不要放弃，白夜国的希望就在他们之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390324,
					"content": "你希望我带他们回来见你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "不，永远不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390326,
					"content": "我们唯一的优势，就是敌明我暗，而且所有白夜之民的心都和我们在一起。不要轻易暴露自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390327,
					"content": "更何况，现在我已经不能记住他们每个人的名字了。甚至连自己的名字都已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390328,
					"content": "把我的话带过去，让他们永远不要放弃，白夜国的希望就在他们之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390329,
					"content": "如果他们已经不在了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "不会的。只要操纵太阳之子的肮脏大人们还存在一天，他们就一直在。而反抗也会一直继续。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390331,
					"content": "把我的告诫带给他们，让他们永远不要放弃，白夜国的希望就在他们之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390332,
					"content": "这样就已经足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "须婆达之彦"
				},
				{
					"id": 722390310,
					"content": "你的名字是贼子须吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "哎呀，不是贼子须，是须婆达之彦啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722390305,
					"content": "我们刚刚在寻找你的身份。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
			]
