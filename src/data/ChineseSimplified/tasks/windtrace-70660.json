					"content": "咳，不说这么多了，不如你直接来试玩一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590302,
					"content": "游玩「风行迷踪」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "离开。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "好吧，如果有兴趣试玩「风行迷踪」的话，就过来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉盖克斯"
				}
			]
		}
	]
