				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "你好，冒险家，最近的冒险行动还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706600102,
					"content": "还算顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "顺利就好，继续这么磨炼下去，你一定能成为一名伟大的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706600104,
					"content": "对了，如果你有兴趣的话，可以去吉盖克斯先生那边，试玩一下最新的「风行迷踪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706600108,
					"content": "这…和冒险家协会有关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "这个啊…因为吉盖克斯先生在协会这边挂了一个委托，拜托我们帮他招募试玩「风行迷踪」的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706600110,
					"content": "从这方面说…勉强算是有些关系吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706600111,
					"content": "总之，如果你愿意的话，就过去试玩一下吧。据试玩过的冒险家们说，「风行迷踪」玩起来还挺有意思的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706600105,
					"content": "有什么新委托吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "委托…倒是没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706600107,
					"content": "但如果你有兴趣的话，可以去吉盖克斯先生那边，试玩一下最新的「风行迷踪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 7066002,
			"completionStepIds": [
				7066002,
				7066005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
