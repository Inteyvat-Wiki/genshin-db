			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"吉盖克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600201,
					"content": "你好，想试试「风行迷踪」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600202,
					"content": "「风行迷踪」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600204,
					"content": "你应该知道，在之前的蒙德城里有一群「贵族」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600205,
					"content": "他们在蒙德城里暴行不断，让不少人都苦不堪言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600206,
					"content": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600207,
					"content": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600208,
					"content": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600209,
					"content": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600210,
					"content": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600211,
					"content": "曾经？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600213,
					"content": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600214,
					"content": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600217,
					"content": "关于「风行迷踪」的情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "我之前就招募过一次试玩「风行迷踪」的人，那些人里有几个技术很出众，让我印象很深。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600219,
					"content": "但除了他们之外，还是有不少人和我说这个游戏很难，要么游侠很难跑掉，要么猎手找不到人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600220,
					"content": "还有人向我抱怨，如果想要玩好这游戏，就必须熟悉每张图的每个细节，实在是太麻烦了，希望我简化游戏的玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706600221,
					"content": "唉，我也不知道他们说的对不对，所以我就想再招募一批人来试玩，听听他们的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉盖克斯"
				}
			]
		},
