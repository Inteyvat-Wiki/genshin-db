						9901520
					]
				},
				{
					"id": 9901536,
					"content": "有什么想做的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "嗯，我很喜欢这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901510,
					"content": "与蒙德城不同的风景，对我来说很有新鲜感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901511,
					"content": "练习唱歌的时候，也可以放开歌喉。不用担心万一打扰到了别人该怎么办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901512,
					"content": "芭芭拉的歌声不能说是打扰吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "那就太好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901514,
					"content": "谢谢你能这样说。但我…还是要多考虑点别人的感受嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901515,
					"content": "总之，我很开心能收到你的邀请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901517,
					"content": "嗯，我很开心能收到你的邀请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901518,
					"content": "我还想在这里多待一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901520,
					"content": "啊，好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901521,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901522,
					"content": "你怎么突然笑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "啊，我刚刚意识到，自己很久没有像现在这样，轻轻松松地和朋友聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901525,
					"content": "突然就觉得很幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901526,
					"content": "芭芭拉很容易满足啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "因为芭芭拉总是在为别人考虑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "唔，唔，是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901528,
					"content": "好像，这也不是什么坏事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901529,
					"content": "很容易就感到幸福的话，就会有很多的能量，然后就可以把幸福的感觉传递给别人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901531,
					"content": "那也是理所当然的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901532,
					"content": "我一直受到着大家的照顾，我也想用自己的努力来回应这些善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901533,
					"content": "真不愧是芭芭拉啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "唔，你不要总是夸我啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901535,
					"content": "有批评…才会有进步，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901537,
					"content": "啊，我最近练习了一首新的曲子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901538,
					"content": "但有些细节我还把握不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901539,
					"content": "副歌在重复的时候要不要升个调，舞步有没有优化的空间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901541,
					"content": "我会为你「全力应援」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "这是我的荣幸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "如果不麻烦你的话，我希望你能看我的表演，再给我一些建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901543,
					"content": "谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901544,
					"content": "唔…如果有不成熟的地方，不要笑话我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901545,
					"content": "我思考过很多次，现在是鼓起勇气，才敢在那么近的地方表演给你看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901547,
					"content": "不会的，放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
