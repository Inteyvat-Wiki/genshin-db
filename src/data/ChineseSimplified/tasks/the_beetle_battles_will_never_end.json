			"dialogs": [
				{
					"id": 727310201,
					"content": "哈哈哈哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310202,
					"content": "尽兴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310203,
					"content": "哈哈哈哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310204,
					"content": "痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310205,
					"content": "尽管斗虫的风格与我不同，但你倾注在鬼兜虫身上的一腔热血，让我找到了强烈的共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310206,
					"content": "假以时日，你必定能成为斗虫界的佼佼者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310207,
					"content": "你也不赖！整整一千一百四十一场较量，居然能勉强战胜本大爷五百七十场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310208,
					"content": "和本大爷拉锯百场以上的对手里，你最有毅力，不得不说，你让本大爷刮目相看了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310209,
					"content": "是五百七十一场，我赢的次数更多哦。考虑到客场作战的因素，本来应该是我占上风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310210,
					"content": "嘿？怎么了你？这种时候还嘴硬？本大爷记得清清楚楚，阿守也可以作证！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310211,
					"content": "你说是吧，阿守？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310212,
					"content": "老大…我，我实在撑不住了…让我睡一会儿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727310213,
					"content": "呜哇，难道这段时间，他们一直在这里斗虫，完全没有休息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310214,
					"content": "他们一直在这里斗虫，完全没有休息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310215,
					"content": "擂台都快被震裂了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "行！本大爷宽宏大量，让你一局也无所谓，反正接下来，本大爷还会赢回来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310218,
					"content": "看你不服气的样子，之后的较量，就去你的主场吧。本大爷要让你明白，场地没什么影响，关键还是斗虫的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310219,
					"content": "正合我意，且随我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310220,
					"content": "嗯？我的挚友和飞行矮堇瓜，你们可算来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310221,
					"content": "怎么又变回飞行矮堇瓜了，难道我不帮你斗虫的时候，你就只能想起难听的外号吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310222,
					"content": "这个先放一边！说好要给你们的两月份免费拉面优惠券，拿着吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310223,
					"content": "拉面优惠券？对哦，拉面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310224,
					"content": "这样才像话嘛，还算你识相！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310225,
					"content": "撒花庆祝！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "不对不对，这次只算是「荒泷极意堂堂斗虫大试合」的预演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310228,
					"content": "毕竟完全没有任何观众，未免也太冷清了，不能就这样草草了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310229,
					"content": "走运的是，「花角玉将」总算放下了他的架子，承认本大爷是难得一遇的斗虫强者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310230,
					"content": "我们的较量还没结束，之后，本大爷要孤军深入「花角玉将」的阵地，打他个心服口服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310231,
					"content": "到时候，「花角玉将」也会听候本大爷的调遣，一起把「荒泷极意堂堂斗虫大试合」办得红红火火！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310232,
					"content": "这次就多谢你们了，等着本大爷的捷报吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310233,
					"content": "嘿嘿，这回放牛的可算是玩了个爽快，我们也赚到了整整两个月的拉面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310234,
					"content": "全员大丰收！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "老大，老大！忍姐来信了，你快看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310237,
					"content": "咦？老大跑哪儿去了？之前明明一直在这儿斗虫的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310238,
					"content": "欸？有什么要紧的事吗？放牛的刚刚才跟着「花角玉将」走了，说是要继续去切磋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310239,
					"content": "倒也不是什么要紧的事，就是有点意外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310240,
					"content": "具体的内容，请你们看一下信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310241,
					"content": "呃啊，结果到头来，「花角玉将」也算是荒泷派的自己人吗？只不过「花角玉将」根本不好好说话，搞得放牛的如临大敌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310242,
					"content": "和阿忍的预料一样，放牛的确实在废寝忘食地斗虫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310243,
					"content": "不过找了我们来举办「荒泷极意堂堂斗虫大试合」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310244,
					"content": "倒也算不上消停…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "这样看来，拉面的优惠券，更应该奖励给阿忍才对嘛！等到阿忍回来了，我们一起去吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310246,
					"content": "欸？等等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310247,
					"content": "说起来，放牛的根本还没有告诉我们，这张优惠券究竟能被用在哪家拉面店呢...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310248,
					"content": "难不成，还得我们自己去找吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310235,
					"content": "好啦，其实开心更重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "「斗虫大试合」完满结束！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "鬼兜虫都要累趴了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
