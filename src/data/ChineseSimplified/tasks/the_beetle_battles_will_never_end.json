				"points": []
			},
			"dialogs": [
				{
					"id": 727310701,
					"content": "原来如此，原来如此啊…再打一场吧，我一定能看透你斗虫的门道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310702,
					"content": "比试的胜负似乎已经没那么重要了，我们就斗个爽快，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310703,
					"content": "难得有这么合拍的对手，短短几分钟就结束，未免也太不尽兴了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727310704,
					"content": "哈！来就来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310705,
					"content": "不过…看穿本大爷斗虫的秘技？你可别痴心妄想啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310706,
					"content": "如果你肯承认，是我斗虫的本领更强，无论斗多少场，我都会奉陪到底！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727310707,
					"content": "唔，放牛的和「花角玉将」还是热血沸腾呢，就让他们继续斗虫吧，斗到他们完全满足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
