			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390102,
						710390103
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390102,
					"content": "你好，瑾武姐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390105,
					"content": "哇啊，吓我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390106,
					"content": "抱…抱歉。那个，如果你们要找志琼的话…她离队了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390107,
					"content": "她去哪里了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "我不知道…只是疏忽了一会，她就这样不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390112,
					"content": "我和她谈过了…她还是执意要走。好话坏话，或者拳头都留不住她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390113,
					"content": "唉…希望她知道她自己在做什么吧。希望如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390114,
					"content": "希望如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390115,
					"content": "对了，这件事一定要和沐宁说。让他尽快组织一支搜救队，尽早找到那孩子才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390116,
					"content": "我们会去的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "真是的…志琼怎么又不见了！我们快去地面找沐宁吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390117,
					"content": "请你稍微安心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "她离开时情况如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390111,
					"content": "海迪夫给她做过了检查，她的情况很不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390103,
					"content": "你还好吗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103903",
							"2"
						],
						"stepId": 7103903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐宁",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "嗯？志琼没和你一起上来吗？总务司的荐书下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390202,
					"content": "因为她绘制的地图给辉山厅帮了大忙，总务司破格聘任她为…嗯，我看看…顾问向导，享受正式职位待遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390203,
					"content": "恭喜志琼啦，先前那样四处乱跑果然不是白做工的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390204,
					"content": "她退出了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "退出了？什么意思…？她先离开了吗？可是千岩军没有和我说有人离开过层岩巨渊啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390206,
					"content": "志琼退出了勘探队。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "啊？哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390208,
					"content": "等等！等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390209,
					"content": "不对不对…你说，她，退出了勘探队？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390210,
					"content": "志琼，退出了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390211,
					"content": "对呀！你是哪个部分听不懂呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390212,
					"content": "…我明白了，我会即刻组织起一支搜救队。如果她还留在层岩巨渊，我们应该还能找到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390213,
					"content": "不管她是又一次自己犯傻，还是别的什么原因…要找到她才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390214,
					"content": "以她现在的状态，脱离队伍擅自行动完全是在胡闹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390215,
					"content": "需要我帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "抱歉，这次就不需要劳烦你帮忙了…我也总得派上点用场嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390233,
					"content": "如果需要我帮忙，我一定尽快赶到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "嗯嗯，我也是！不能放着后辈不管呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390235,
					"content": "我们也在路上多多注意吧，说不定什么时候就能遇见她了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710390217,
					"content": "关于志琼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "她是个不安分的家伙，但我们再怎么说也算是朋友。我知道我不讨人喜欢…但我可不能随随便便就把朋友忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390219,
					"content": "这家伙总是在做什么冒险家的大梦，之前受过几次重伤…还差点把命也搭进去。后来好不容易才安生了一段时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390220,
					"content": "本来以为她已经把不切实际的美梦抛之脑后了…罗尔德、斯坦利，哪有那么好当！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390221,
					"content": "唉…可是没想到…或许这次我不应该推荐请你来探索层岩巨渊才是，不然也不至于引起志琼的这把火…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390222,
					"content": "但她的努力并非毫无收获。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "收获…？你这样说，未免有点太功利了。她画下了地下大部分区域的地图，我们很感激没错…但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390224,
					"content": "把「愿望」这种虚无缥缈的东西，和追求它的行为，放置于生命本身之上…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390225,
					"content": "我是无论如何也不能理解的，我也不能想象有人真的为此置身危险之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390232,
					"content": "所以，寻找她的事情，就请包在我身上吧…呃，我是说，包在千岩军的搜救队身上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390226,
					"content": "但这是她的选择。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "选择，选择，选择…什么借口！她是在去送死，你没意识到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390228,
					"content": "咳咳…抱歉，我的话说得有点太重了。但…在我们凡人无法扭转的情势面前…她应该更耐心些的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390229,
					"content": "再等…二三十年，也许只用十年，说不定她就能等到更加安全的矿下设备研发完成了呢？到那时候她也用不着急着勘探地下地图了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390230,
					"content": "但她一点也不愿意等等…只想在自己最年轻的时候，就完成别人一辈子的成就！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390231
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710390231,
					"content": "这家伙太傻了…作为朋友，这件事我不能不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "沐宁"
				}
			]
		}
	]
}