			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪卢克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "啊，迪卢克老爷，你看见那两个小偷了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 3760602,
					"content": "发生了什么，怎么出动了这么多人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760603,
					"content": "迪卢克老爷没听说吗？有两个小偷，居然打起了天空之琴的主意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "麦尔斯"
				},
				{
					"id": 3760604,
					"content": "哦？真是奇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760605,
					"content": "是吧。天空之琴可是风神他老人家亲手弹过的宝物，这样珍贵的文化财产——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "麦尔斯"
				},
				{
					"id": 3760606,
					"content": "居然有人会傻到偷一件卖不出去的东西，还不如偷我家酒窖划算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760607,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 3760608,
					"content": "啊，抱歉离题了。那一黄一绿的两个人，好像往那边去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760609,
					"content": "好的好的。谢谢迪卢克老爷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麦尔斯"
				}
			]
		},
		{
			"id": 37607,
			"completionStepIds": [
				37608
