			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪卢克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760701,
					"content": "今天想喝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760702
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760702,
					"content": "把从柜子后面摸来的酒给我放下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760703
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760703,
					"content": "…想喝冰一点的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760704
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760704,
					"content": "好了，你们该好好回答一下我的问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760705
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760705,
					"content": "先让我喝完，我会付账的啦…嗯，用表演抵债。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760706
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760706,
					"content": "不是钱的问题，你看起来还没到能买酒的年纪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760707
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760708,
					"content": "不如先回答我的问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760709
					]
				},
				{
					"id": 3760710,
					"content": "这是哪位？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760711
					]
				},
				{
					"id": 3760707,
					"content": "这你可以放心，我喝酒的时候你还在——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760708,
						3760710
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760709,
					"content": "你想问「这是哪位」，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760711
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760711,
					"content": "想必这位就是<color=#00E1FFFF>迪卢克</color>老爷，酒馆老板背后的…大老板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760712
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760712,
					"content": "是很有名的人呢。顺带一提，我很喜欢他家出品的蒲公英酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760713
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760713,
					"content": "虽然大部分时间我只买得起散装的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760714
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760714,
					"content": "我刚从卫兵那里听说小偷的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760715
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760715,
					"content": "先说明一下，你们居然敢去偷天空之琴，我很欣赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760716
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760716,
					"content": "就算你们是傻子，那也是千年少见的傻子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760717
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760717,
					"content": "不是我们偷的啦！真犯人另有其人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3760718,
					"content": "这位可是骑士团的当红新人，怎么会去偷蒙德的圣物呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760719
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760719,
					"content": "当红新人…？啊，原来就是你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760720
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760721,
					"content": "其实也没那么熟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760722,
					"content": "只是听过一场演奏的关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760720,
					"content": "怎么，你和那个吟游诗人是熟人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760721,
						3760722
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760723,
					"content": "嗯…身为旅行者，却愿意对危难中的蒙德伸出援手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760724
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760724,
					"content": "这样的人，加入骑士团太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760725
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760725,
					"content": "西风骑士团…在风魔龙问题上一直畏首畏尾，效率低下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760726
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760726,
					"content": "外交上对<color=#00E1FFFF>「愚人众」</color>也是弱势又保守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760727
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760727,
					"content": "啧…算了，我也不想多提这个话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760728
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760728,
					"content": "看来迪卢克老爷非常不喜欢西风骑士团呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760729
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760729,
					"content": "道路不同罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760730
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760730,
					"content": "我对蒙德这座城市，有我自己的期许…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760731
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760731,
					"content": "那么回答我的问题吧。你们为什么要偷走天空之琴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760732
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760732,
					"content": "你真的想知道吗？可能会卷入与骑士团有关的麻烦哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760733
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760733,
					"content": "…呵。我不怕麻烦，我本人就是骑士团的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760734
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760734,
					"content": "那么，如果我来演奏真实的故事，你会相信我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760735
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760735,
					"content": "视情况而定，我会作出判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760736
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760736,
					"content": "那么——你会付我演出的赏额吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760737
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760737,
					"content": "报酬从5摩拉到天空之琴，视你的故事而定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760738
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760738,
					"content": "很好。我就再追加一场吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760739
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760739,
					"content": "刚才的叙事诗，究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760740
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760740,
					"content": "这是重要的秘密。为什么让我知道这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760741
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760741,
					"content": "为什么呢？嗯，也许是因为风的流向正在变化吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760742
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760742,
					"content": "——怎么样，迪卢克老爷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760743
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760743,
					"content": "有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760744
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760744,
					"content": "给我一些时间，我可以想办法牵线搭桥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760745
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760745,
					"content": "异乡人，你似乎是因为骑士团的身份，没有遭到怀疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760746
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760746,
					"content": "通缉令上写的特征只是金发，卫兵应该不会找上你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760747
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760747,
					"content": "但吟游诗人，你最好还是不要离开酒馆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760748
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760748,
					"content": "没问题！我喜欢酒馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760749
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760749,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760750
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760750,
					"content": "那么，晚上酒馆打烊以后，我们在这里再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760751
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4820221,
					"content": "按照我给你<color=#00E1FFFF>标记好的路线</color>，一路平稳地飞到终点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "安柏"
				}
			]
		}
	]
}