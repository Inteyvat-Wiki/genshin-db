			},
			"dialogs": [
				{
					"id": 3760401,
					"content": "迪卢克老爷，这周的账面就是这样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 3760402,
					"content": "这次风灾，对生意的影响果然很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760403,
					"content": "希望这段时间早点过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 3760404,
					"content": "老板，我们…想要一个，稍微隐蔽点的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760405,
					"content": "要说隐蔽的话，二楼人少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760406,
					"content": "但你不是吟游诗人吗？不如选个热闹的位置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760407,
					"content": "啊哈哈，收费演出就等下次吧。我们先上去了，一会见~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3760408,
					"content": "看好他们。那个诗人很可疑，我要去问问情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3760409,
					"content": "呃…问谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 3760410,
					"content": "蒙德城的「保安」们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪卢克"
				}
			]
		},
		{
			"id": 37605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
