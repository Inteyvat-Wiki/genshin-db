			"dialogs": [
				{
					"id": 760761101,
					"content": "你好，我的朋友，很高兴与你墓里再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761102,
					"content": "向菲林斯描述了你所见到的「誓言之灯」与灯上不明意义的话语。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "「风已醒来，落叶飞旋」…这是人们在加入执灯人时立下的誓言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761104,
					"content": "平时每一个执灯人成员都会随身携带自己的灯，只有在最无奈的情况下，他们才会放弃照看自己的灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761105,
					"content": "每一盏无主的灯恐怕都意味着一桩不幸，我很遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761106,
					"content": "不过早在立誓之时，他们就已经明白这种命运无可避免。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761107,
					"content": "如果说还有什么我们能为他们做的事，那就只有铭记了，铭记他们的誓言吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760761108,
					"content": "「守护永燃的希望」…这是他们最大的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		}
	]
}