			},
			"dialogs": [
				{
					"id": 740911701,
					"content": "那些麻烦的检修工作既然有人帮忙，何必要自己费那么大劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911702,
					"content": "关于这个码头…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "梅洛彼得堡那么多管道，总得有人维护吧？我们就是干这个的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911704,
					"content": "不过大部分时候都只是些小修小补罢了，毕竟真要出了大问题，靠我又有什么用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911705,
					"content": "还是做些自己力所能及的事吧，比如趁休假时帮人捎些信去城里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911706,
					"content": "不打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "反正我闲得很，哪有什么打扰不打扰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾古伊"
				}
			]
		}
	]
