			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"艾古伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "那小子，该不会被丘丘人抓去煮汤了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910102,
					"content": "谁被抓走了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "那边，你们瞧，能看到水上的丘丘人营地吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910106,
					"content": "简直就像一夜之间突然冒出来的，该休息的时间不休息，拼命干活，哎哟，和巴朗那臭小子一模一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910107,
					"content": "依我看，他要是走运，现在没在锅里，那说不定正跟丘丘人聊得火热呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910108,
					"content": "欸？你的意思是说，你认识的人被那边的丘丘人抓走了？你怎么一点也不着急，如果是真的，得赶紧救人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910109,
					"content": "救人？救什么人？我早跟他说了，危险的工作没必要自己拼命，等艾蒂安定期联络的时候报告一声，让艾蒂安找人处理就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910110,
					"content": "我好心教他，可他小子是什么嘴脸？反过来指责我工作不认真，玩忽职守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910111,
					"content": "既然他不把老前辈的经验和智慧当回事，那我只好说，都是他自己选的，年轻人就该吃点苦头，不吃点教训怎么能成长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910112,
					"content": "只听一面之词难以评判。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "嗯，现在救人要紧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910115,
					"content": "危险得很呀！你们这些小孩子，受伤了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910116,
					"content": "#那你就放心好啦，{NICKNAME}很强的！老爷爷在这里等等好了，我们去去就回！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910113,
					"content": "万一遇险了，命都没了还怎么成长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "什么汤？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "重点在这里吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "派蒙"
				}
			]
		},
