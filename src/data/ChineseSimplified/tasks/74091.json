			"dialogs": [
				{
					"id": 740910401,
					"content": "两位…好心人…谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910402,
					"content": "你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910403,
					"content": "我…我…还行…大概还行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910404,
					"content": "看起来快不行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "麻…麻烦两位带我去那边的码头…我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910406,
					"content": "你还是先别说话了，我们带你回去就是了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
