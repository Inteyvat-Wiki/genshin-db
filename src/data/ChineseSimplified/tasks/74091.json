			"dialogs": [
				{
					"id": 740910501,
					"content": "艾古伊先生，我…我回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910502
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910502,
					"content": "你们是…看样子是你们救了巴朗，谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910503
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910503,
					"content": "你这臭小子…我早跟你说了，危险的工作没必要自己拼命，等艾蒂安定期联络的时候报告一声，让艾蒂安找人处理就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910504
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910504,
					"content": "我当初好心教你，可你小子是什么嘴脸？反过来指责我工作不认真，玩忽职守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910505
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910505,
					"content": "看看，我说什么来着？太危险了，你应付不来。你还不信，现在吃到教训了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910506
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910506,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910507
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910507,
					"content": "怎么，你还想嘴硬？我倒要听听，你还有什么高见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910508
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910508,
					"content": "让我喝口水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910509
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910509,
					"content": "巴朗找到水瓶，咕噜咕噜猛灌了几口，接着又掰了一块干面包嚼了起来。\\n其间不管老人说什么，他都好像没听见似的，只顾吃喝。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740910510
					]
				},
				{
					"id": 740910510,
					"content": "呼…总算是…总算是活下来了。感谢两位相助，不然我恐怕是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910511
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910511,
					"content": "恐怕是只能留下些抚恤金给你的父母了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910512
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910512,
					"content": "哼，那也比因为玩忽职守而导致重大安全事故最后被革职要强得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910513
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910513,
					"content": "臭小子…唉，真是跟你说不通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910514
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910514,
					"content": "两位，虽然这么说非常厚脸皮…可是我必须说，这也是为了大家的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910515
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910515,
					"content": "两位应该会潜水吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910516
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910516,
					"content": "会倒是会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910517,
					"content": "我被丘丘人抓住的时候，潜水服也丢失了，此前例行检查时发现备用品损坏了，虽然重新申请了，但还没送到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910518
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910518,
					"content": "但是管道的维护工作不能怠慢，两位会潜水的话，能否麻烦两位代替我下水检查一下梅洛彼得堡的管道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910519
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910519,
					"content": "当然，酬劳我一定会准备好，不会亏待两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910520
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910520,
					"content": "既然关系到大家的安全，这忙我们也不是不能帮。但是检查管道听起来好像是很专业的工作，交给我们真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910521,
					"content": "只是例行检查而已，我估计是会有一些小问题，上次检查的时候就发现有四处风险…但处理起来应该不会太难，我给你们讲讲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910522
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910522,
					"content": "如果在水下发现管道有<color=#00E1FFFF>气体外泄</color>的情况，应该是水下生物…或者是非生物的冲撞导致的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910523
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910523,
					"content": "应急处理的方法是<color=#00E1FFFF>控制调节阀调整流量，暂时止住气体外泄</color>。你们只需要做到这种程度就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910527
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910527,
					"content": "调节阀的操作是有技巧的，<color=#00E1FFFF>转动手轮时需要观察气体流量，如果气体流量变小了，就说明思路没问题</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910524
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910524,
					"content": "哦…好像听懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910525,
					"content": "如果还有哪里不明白，在例行检查完成之前，有任何问题我随时为两位解答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910526
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910526,
					"content": "好吧，总之我们先去试试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
