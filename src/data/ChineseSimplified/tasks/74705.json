			"dialogs": [
				{
					"id": 747050101,
					"content": "…我觉得是这条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050102,
					"content": "有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747050103,
					"content": "为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "千织"
				},
				{
					"id": 747050104,
					"content": "看看这尾摆的颜色，整个水族箱里没有比它更时髦的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050105,
					"content": "虽然颜色艳了点，但好吧，就当你是在夸我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "千织"
				},
				{
					"id": 747050106,
					"content": "哇！好多人呀！大家都是来逛水族馆的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050107,
					"content": "嗯，刚拍完一个镜头，趁休息时间来欣赏一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747050108,
					"content": "你们刚刚在聊什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050109,
					"content": "哪条鱼和千织比较像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050110,
					"content": "怎么你们也…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050111,
					"content": "啊…哈哈，好像是聊天时听哥伦比娅小姐提到类似的话题，觉得很有趣，我们不知不觉就也这么玩上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747050112,
					"content": "原来这东西还能传染的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747050113,
					"content": "哦！那条像你，夏沃蕾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "千织"
				},
				{
					"id": 747050114,
					"content": "怎么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 747050115,
					"content": "一闲下来就绕着水缸游圈，在锻炼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "千织"
				},
				{
					"id": 747050116,
					"content": "…我在你心里就这形象吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏沃蕾"
				}
			]
		}
	]
