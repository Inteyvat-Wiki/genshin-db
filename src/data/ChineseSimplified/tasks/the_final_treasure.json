	"talks": [
		{
			"id": 7902701,
			"completionStepIds": [
				7902701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902701",
							"2"
						],
						"stepId": 7902701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「大肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "欸呀，你们来啦，我还以为你们每天用那个什么翅膀，在海岛间飞来飞去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270102,
					"content": "早就忘了泡在水里的老伙计「大肉丸」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270103,
					"content": "我们这不就想起你了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270104,
					"content": "对了，你之前说要帮忙的，是什么事呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270105,
					"content": "其实也不是什么重要的事…上次你们不是帮我找到了我身躯的碎片嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270106,
					"content": "该怎么说呢，不知道是因为达成了一些心愿…还是这片海域让我能开口说话的力量在逐渐消退…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270107,
					"content": "最近清醒的时候少，睡着的时候倒是越来越多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270108,
					"content": "难道和那个装置有关？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#原来如此，是因为什么装置，我才能够变成{NICKNAME}你的浪船，也可以开口与你交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270111,
					"content": "啊…那等装置的影响结束以后，「大肉丸」岂不是不能再开口说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}，不如我们快想些办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270113,
					"content": "哈哈，不用啦，派蒙…能够像现在这样与你们说话，我已经感到十分满足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270114,
					"content": "呀…这么一想，我身为一艘船却能在过去几日和你们那样畅快交流，本身就是如梦幻一般的美好之事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270115,
					"content": "不过我现在还有一事相求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270116,
					"content": "但说无妨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "之前不是一直说，等找到我的身体以后，就带着你们在这儿兜风嘛，只不过我的身体早就变成了那个样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270125,
					"content": "宝藏大部分也被带走，没留下什么好东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270118,
					"content": "但是这次，我以大海盗船之名起誓，一定会有了不起的大宝藏的！就当是再被我骗一次，跟我一起去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}，「大肉丸」说不定马上就没法说话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270120,
					"content": "#而且…那可是有宝藏呢！我们就一起去吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270121,
					"content": "真拿你没办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "那我们现在就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270124,
					"content": "好嘞，那就请两位立刻上船吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270122,
					"content": "既然都这么说了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "被装置的关闭影响了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
