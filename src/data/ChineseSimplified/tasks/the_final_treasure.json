			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「大肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "真是险呀，感觉刚才差点就要被击沉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270602,
					"content": "「越石丸」，了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270603,
					"content": "#哈哈，会说话的船也不过是船罢了，能够穿越雷暴，{NICKNAME}精湛的驾驶技术才是真的功不可没。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270604,
					"content": "要再来一次吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "哈哈，那还是别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270607,
					"content": "唉，刚才的雷暴，恐怕是因为受到了我的影响，这么看来，这片海域的环境已经变得没那么稳定啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270608,
					"content": "#不过，也是正好…{NICKNAME}，派蒙，宝藏就在上面哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270609,
					"content": "这不是我们第一次找宝藏的地方吗，上面只有「越石丸」你的半截断船而已吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270610,
					"content": "这次上面肯定有宝藏啦，这可是…怎么说的来着，这可是「大海盗船的直觉」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270611,
					"content": "是嘛…对了，之前「越石丸」说有两件事要告诉我们，一件事是你记起了你的名字，另一件事是什么呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270612,
					"content": "哈哈哈，我还以为你忘记了呢，剩下的一件事，就等你们回来再告诉你们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270605,
					"content": "谢谢夸奖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
			"completionStepIds": [
				7902708,
				7902710
