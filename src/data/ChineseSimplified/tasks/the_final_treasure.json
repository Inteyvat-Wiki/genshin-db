				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「大肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "「越石丸」、「越石丸」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271002,
					"content": "我们找到宝藏啦，你看，是一艘海盗船的模型呢！这次你的直觉终于准了一次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271003,
					"content": "对了对了，你之前说，要告诉我们的第二件事到底是什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271004,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790271005,
					"content": "「越石丸」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271006,
					"content": "（其名为「越石丸」的船并没有作出任何反应…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790271007,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "…哼，还说我们回来就告诉我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "派蒙"
