					"nextDialogs": [
						411500303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500303,
					"content": "你把这份给她送过去吧。<color=#00E1FFFF>走路稳点，不要乱飞乱跑</color>，怕漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>还有就是别沾着奇怪的元素搅和了味道</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500305,
					"content": "如果餐点成色坏了，你们就回来找我，我重新弄一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
