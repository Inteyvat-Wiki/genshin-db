			"dialogs": [
				{
					"id": 750300101,
					"content": "阿科米蒂，我们找到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750300102,
					"content": "你们还真的找到地窖来了？我还以为这个地窖这么隐蔽，你们找不到就该离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300103
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300103,
					"content": "怎么说？跟我们解释解释吧，那些突然冒出来的龙贩子可是把我们吓了一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750300104,
					"content": "真是爱追根究底的人，本来我觉得自己这点事不值得向别人大倒苦水，所以才干脆窝在这里不出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300105
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300105,
					"content": "不过你们碰上这档子事也是受了损失，既然都找到这里来了，应该得到一个解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300106
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300106,
					"content": "我是花羽会的阿科米蒂，刚刚通过驭龙师考核，算是飞行队正式成员了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300107
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300107,
					"content": "不对，我现在…应该已经被视为脱队的失翼者了，不知道队长打算怎么处理我的事，也没必要想这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300108
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300108,
					"content": "你们肯定也听到了，我其实没有违反规定，偷绒翼龙幼崽牟利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300109
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300109,
					"content": "至于那些龙贩子，你们放心，他们不敢再找你们寻仇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300110
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300110,
					"content": "花羽会里头脑正常的人不会闲着没事跟飞行队起冲突，刚才那几个想偷龙的家伙也不过是小混混。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300111
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300111,
					"content": "他们其实害怕得很，只敢趁我落单过来堵路，这下被你们揍回去之后绝对不敢声张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300112,
						750300114
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300112,
					"content": "你们怎么会起冲突？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300113
					]
				},
				{
					"id": 750300113,
					"content": "是啊，这些人到底在想什么啊，怎么会找飞行队的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750300116,
					"content": "不，跟身份无关，是我自己的问题，我可能…不适合进入飞行队吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300117
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300117,
					"content": "做预备役的时候想要成为正式队员，为追逐前辈们的速度拼命训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300118
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300118,
					"content": "没日没夜天天训练，一点做不好就战战兢兢，怀疑自己到底行不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300119
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300119,
					"content": "都没法跟爸妈还有姐姐说上几句话，脾气也变得古怪又急躁，饭不想吃，觉不想睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300120
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300120,
					"content": "好不容易通过了考核，成为正式队员之后，又得追逐队长的速度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300121
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300121,
					"content": "我永远不够好，永远有人比我有天分还更努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300122
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300122,
					"content": "萤火虫刚刚飞上天，就发现自己得追上麻雀的速度，就算追上了飞鸟，接下来又不得不追逐流星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300123
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300123,
					"content": "挺累的，说实话，定期要去烟谜主找人付费咨询，唉，钱花了不少，人没见好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300124
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300124,
					"content": "就是想嘴上撒撒气，龙贩子来搭讪的时候才会说「趁早把龙都弄走」，谁知道他当真了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300125
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300125,
					"content": "躲到这儿都跑不掉，结果被人堵在地窖里，我实在是厌倦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300126
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300126,
					"content": "怎么说呢…大家都有大家的问题吧，其实做冒险家也很辛苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750300127,
					"content": "对了，冒险家是不是能接委托？我想委托你们想个办法，给我一个充分的理由脱队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300128,
						750300133
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300128,
					"content": "真的要做失翼者吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300129
					]
				},
				{
					"id": 750300129,
					"content": "处理矿石的时候不是会切开原矿的外壳吗，就当我是被磨掉的那部分碎屑好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300130
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300130,
					"content": "已经到这个地步了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300131
					]
				},
				{
					"id": 750300131,
					"content": "人人都是宝石，等于人人都不是，就让我来当碎屑，衬托大家的杰出吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300132
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300132,
					"content": "一直追逐永远追不到的流星很痛苦，拜托饶了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300138
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300138,
					"content": "能不能这样，你们跟我一起飞一次行不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300139
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300139,
					"content": "你们来打破我的成绩，想一想，随便路过的冒险家，轻轻松松就把我超过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300140
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300140,
					"content": "教官还能说什么？什么难得的天才，不努力就是浪费自己的天赋和人生，根本都是胡说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300141
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300141,
					"content": "#我后悔刚才刺激他了，{NICKNAME}，现在我有种强烈的愧疚感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750300142,
					"content": "也不知道该说些什么，要不就顺着他的意思帮忙试试看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300143,
						750300144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750300143,
					"content": "真的会有用吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300145
					]
				},
				{
					"id": 750300145,
					"content": "大概吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300146
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300146,
					"content": "我可以帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300147
					]
				},
				{
					"id": 750300147,
					"content": "太好了，我们到开阔的地方去谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300144,
					"content": "如果这样你觉得好些的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300145
					]
				},
				{
					"id": 750300133,
					"content": "直接离开不行吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300134
					]
				},
				{
					"id": 750300134,
					"content": "原谅我的懦弱吧，虽然其实是自己想要放弃，但就是没有勇气面对别人的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300135
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300135,
