						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "你们来得正好，来帮个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300202,
					"content": "读心术？好恐怖！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "嘉维娅让我们来帮忙…你是怎么知道的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300204,
					"content": "啊？因为这里只有你们能帮忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300205,
					"content": "…也对哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300210,
					"content": "反正不是什么难事，这儿的研察终端需要两个人同时操作。具体的指令我已经录入完毕了，你们过去拉下拉杆就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300211,
					"content": "差点忘了…储能装置应该就在附近，麻烦你们先把储能装置安装上再开启吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300212,
					"content": "以及…我先确认一下，你们不是什么机械杀手吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300213,
					"content": "这取决于你对机械杀手的定义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "为什么问这个呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300216,
					"content": "之前让嘉维娜帮忙，我刚把视线移开没一会儿，研察终端就报废了。问她怎么回事，她自己也说不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300217,
					"content": "后来从她妹妹那里得知，没有机械造物能在她手里撑过半天。我猜就算是阿兰·吉约丹本人见了她也得叹气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300218,
					"content": "当时修理费用还是从我的报酬里扣的…如果你们也和她一样，那我辛勤劳动这么长时间，最后还得倒贴特许券…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300219,
					"content": "居然还有这种事…我们肯定不会跟她一样，你就放心交给我们好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300220,
					"content": "那就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300214,
					"content": "如果研察终端会攻击我，那我就是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "这忙不能白帮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "待会儿让嘉维娅给你们申请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300208,
					"content": "欸？可是她让我们直接找你索取报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300209,
					"content": "她是这么说的？那好吧。在这儿申请一点经费比在枫丹科学院还难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "克兰茨"
				}
			]
		},
		{
