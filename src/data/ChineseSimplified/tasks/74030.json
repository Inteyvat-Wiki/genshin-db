				"points": []
			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "你们好，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740300102,
					"content": "好巫师姐姐，帮帮我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "怎么连你也学起莉诺尔了？有什么话就直说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740300104,
					"content": "我们需要很多特许券！想问问有没有什么我们能做的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300107,
					"content": "你们该不会是加入了艾蒂安的游戏吧？玩闹也要适可而止哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740300108,
					"content": "…说起来，的确有件事想要拜托你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740300109,
					"content": "克兰茨现在应该正在海蚀裂隙那边修理他的什么装置…你们去帮帮他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740300110,
					"content": "至于报酬，就直接找他索取好了。他不会有异议的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740300111,
					"content": "嗯嗯，交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300105,
					"content": "有我们可帮忙的事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "最好是有报酬的那种！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7403002,
			"completionStepIds": [
				7403002
			],
