						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "你们还挺熟练的。要不是在这种地方，我都想雇你们当助手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300402,
					"content": "哼哼，这点小事怎么可能难倒我们。话说回来，这个装置到底是做什么用的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300403,
					"content": "这里原本有条通往外部的裂隙需要看守看管，现在用闭锁装置把路封上就可以节省一些人力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300404,
					"content": "这技术在枫丹科学院也不是什么新鲜玩意儿，不过反正闲着也是闲着，我就稍微做了点改造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300405,
					"content": "你们现在看到的还不是完全版，完全版被用在晶簇矿坑道…咳，好像说太多了。你们就当没听到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300406,
					"content": "晶簇矿坑道也有可以出去的路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "唉，是啊，你可真是太聪明了，如果更聪明一点，就应该把这句话放在心里，而不是直接说出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300411,
					"content": "好了，这下问题也算解决了，嘉维娜可以不用那么常来这里看守，我也可以歇会儿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300412,
					"content": "…差点忘了，这些是给你们的报酬。谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300408,
					"content": "完全版更厉害吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "那当然了，完全版还加装了配件…你打听这么多干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740300410,
					"content": "你要是想知道完全版的具体情况，可以自己去试试…被抓了别说是我怂恿你去的就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "克兰茨"
				}
			]
		}
	]
}