			]
		},
		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「女士」",
					"派蒙",
					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "风风火火地闯进来，一个又一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190102,
					"content": "若不是我知道此地是天守阁，估计要把这里当成什么街巷市集之类的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190103,
					"content": "这下总该懂事一点了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190104,
					"content": "啊，九条裟罗被「女士」给…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20190105,
					"content": "稻妻子民的过错，当由我来惩戒。你没有资格，「女士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20190106,
					"content": "…那真是抱歉了，将军大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190107,
					"content": "「女士」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "好了好了，知道你忘不掉我，不用总把我的名字挂在嘴上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190109,
					"content": "我也知道你记恨我…阴魂不散的旅行者，在这里见到你，我一点儿都不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190110,
					"content": "你在暗中推广邪眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "急着在将军面前揭露我的「罪行」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190113,
					"content": "呵呵呵…我不过是来自至冬的外交使节而已，你在讲什么，我可都不知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190114,
					"content": "她不把我们放在眼里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20190115,
					"content": "为了失去神之眼的民众…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "别讲那些我根本不关心的人和事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190118,
					"content": "本就连名字都不会被人记住的小角色们，能参与到这场为了抵达「永恒」的革命之中，成为垫脚石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190119,
					"content": "对他们短暂的人生来说，岂不已经是莫大的荣幸了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190120,
					"content": "将军大人，我所说的应该没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20190122,
					"content": "还有温迪的神之心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "翻起旧账了么，你还真是记仇啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190125,
					"content": "至冬女皇的理想，是这世间最为高洁而纯粹之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190126,
					"content": "相比而言，你所说的那些…不过是些不足挂齿的「必要的牺牲」罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190127,
					"content": "是时候做个了断了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "呵，了断？哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190129,
					"content": "我也对你这张脸，稍微有些厌倦了。不过我倒是没想到，你是这般有勇无谋的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190130,
					"content": "在你说大话之前，可曾意识到…你还是稻妻的头号通缉犯呐，先好好想想自己的处境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190131,
					"content": "闯进天守阁，在御前大放厥词，不是自投罗网是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190132,
					"content": "希望你能认识到你我之间的差距，不论是地位…还是实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190133,
					"content": "我要——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "——向你发起「御前决斗」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190136,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20190137,
					"content": "居然，还有这一手…你也学会利用这个国度的「规则」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190138,
					"content": "勉强把你我拉到对等的位置上，我承认，有些出乎我的意料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190139,
					"content": "但败者…可是会死哦？你想清楚了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20190141,
					"content": "呵呵呵…那就让我屈尊和你共舞一曲，直到你与我一方…生命的尽头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「女士」"
				},
				{
					"id": 20190123,
					"content": "置璃月民众于险境…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "为了遭邪眼反噬的战友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "企图一手掌控稻妻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}