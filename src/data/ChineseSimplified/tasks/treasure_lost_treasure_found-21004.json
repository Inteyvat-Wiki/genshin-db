			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "「归终四诫」…到底是在暗示什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040102,
					"content": "我准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "哈哈哈，你可真有干劲，那好吧，我们开始解读一下这个「归终四诫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040106,
					"content": "「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040107,
					"content": "从字面上来看，确实是类似于一种对于日常生活的「劝诫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040108,
					"content": "不过，这句话哪里是在暗示着宝藏的线索呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040109,
					"content": "…没办法了，还是用我们学者最笨，也是最自讨苦吃的方法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040110,
					"content": "先前，我们发现那七段话的地方，都是在各种形式的「遗迹」里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040111,
					"content": "既然现在我们不知道如何入手，那么，就继续去搜索「遗迹」看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040112,
					"content": "到哪里找…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "嗯…搜索区域的话，就暂时划定在「归离原」里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040114,
					"content": "但是你看我这样的学者，一定跟不上你的步伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040115,
					"content": "所以，搜索遗迹的事就拜托你了，如果找到线索的话，就回来告诉我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040129,
					"content": "这么说起来，我曾经在这附近发现过一处遗迹，而且，我还在里面发现了一个奇怪的圆盘，上面还有字迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040130,
					"content": "不过，当时我也只是做了一些孤立的研究，没有再做发散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040131,
					"content": "现在回想起来，说不定那片遗迹里的那个圆盘，会和这「归终四诫」有所关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040132,
					"content": "唔…这样，我给你在地图上标记出来，你可以去看一下，说不定真能发现什么线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040116,
					"content": "全，全部要找一遍吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "当然不是，如果把搜索范围扩大到整片璃月的话，就凭我们两个人绝对搜索不完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040118,
					"content": "既然是「归离原」上「归离集」的宝藏，那么我们就缩小搜索范围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040119,
					"content": "搜索区域就暂定在这片「归离原」之内吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040120,
					"content": "啊，对了，你看我这样的学者，一定跟不上你的步伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040121,
					"content": "所以，搜索遗迹的事就拜托你了，如果找到线索的话，就回来告诉我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040122,
					"content": "我这就去把璃月里的遗迹全部找一遍！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "等一下！你别这么激动，璃月这么大，你想要找到什么时候去啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040124,
					"content": "听见宝藏就激动成这样…我到底该说你什么好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040125,
					"content": "既然宝藏来自于「归离原」上的「归离集」，那我们首先缩小一下搜索范围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040126,
					"content": "我想想…搜索范围就暂定在这片「归离原」之内…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040127,
					"content": "喂，听我说完再走！记住了，一定要仔细搜索遗迹，如果有什么发现，就带回来告诉我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040128,
					"content": "记住了，在「归离原」之内搜索就好，别跑太远了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210040104,
					"content": "去找宝藏吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "一说到宝藏，感觉你就精神焕发…算了，我们开始解读这个「归终四诫」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "索拉雅"
				}
			]
		},
