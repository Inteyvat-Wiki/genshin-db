			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "怎么样？你们找到宝藏了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045003,
					"content": "找到了，确实是在「汇成之地」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "原来如此…还真是和「归终四诫」里说的一样，宝藏在四诫的「汇成之地」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045005,
					"content": "设置谜题的那个人，一定很尊敬「归终」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045006,
					"content": "即使故乡被毁灭，也要以这种方式把「归终四诫」给流传下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045007,
					"content": "而那位定下这四诫的「归终」，也一定深爱着她庇护着的子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045008,
					"content": "她希望自己的子民们拥有智慧，用道德约束自己，祝福他们身体强健，而且团结一心，一同保护自己的家园「归离集」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045009,
					"content": "但是她还是失败了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "失败了？这么说也没错，她死去了…「归离集」被毁灭，她的子民们也流离失所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045011,
					"content": "不过，如今我们不是让她的「归终四诫」重见天日了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045012,
					"content": "这是那位「归终」为她的子民们亲手订下的诫语，和送上的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045013,
					"content": "秉承着这份「归终四诫」，她曾经在这片大地上，和自己的子民们携手前进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045014,
					"content": "即使她已经死去了，但是她的信念和理想绝不会就此消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045015,
					"content": "而且，那位崇敬着她的人可真是聪明，居然想到用「藏宝」的方式，把「归终四诫」给传下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045028,
					"content": "不过，也不知道在那个人心中，真正的宝贝到底是金银珠宝，还是这份「归终四诫」呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045029,
					"content": "哈哈，要我说，比起那些金银珠宝，这份「诫语」才是真正的宝物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045030,
					"content": "…但是，要真让人选，又有多少人会抛弃财宝，选这份「诫语」呢？唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045016,
					"content": "是一位温柔的魔神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "用「温柔」来形容一位「魔神」，真是感觉有点不搭边际…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045018,
					"content": "在很久很久之前，在那些引导着人们的魔神之中，也许真有「温柔」的魔神吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045019,
					"content": "保护着自己的子民，和他们一同在这片大地上漫步，一同携手前进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045020,
					"content": "…不过这样温柔的魔神，最终还是什么也没能保护下来。就连她给自己子民的诫语，都要借助「宝藏」这种东西才能流传下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045021,
					"content": "真想见她一面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "居然想要去见魔神，你还真是异想天开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045023,
					"content": "不过，如果你真见到了「归终」，你会做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045024,
					"content": "难道想要说「辛苦了」、「谢谢你」之类的话，来安慰她吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045025,
					"content": "如果要我说的话，不如流利背诵一遍「归终四诫」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045026,
					"content": "然后告诉她，她的信念和理想还没有消失，这片大地上还有人牢记着她的教诲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210045027,
