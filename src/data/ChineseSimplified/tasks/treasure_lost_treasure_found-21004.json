			"dialogs": [
				{
					"id": 210040301,
					"content": "…到底发生了什么事，才会让「归离集」毁灭呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
		{
			"id": 2100409,
			"completionStepIds": [],
