				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040901,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040902
					]
				},
				{
					"id": 210040902,
					"content": "要走了吗？有什么新奇的故事，记得回来告诉我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "即使是魔神，也有着逃不脱的命运…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042002,
					"content": "在四个遗迹里找到了四条线索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "四个遗迹，四条线索…刚好和「归终四诫」的诫语数量一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042004,
					"content": "不过，这四句话都是关于「归终四诫」中某一条的解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042005,
					"content": "想要正确解读，「归终四诫」的原文应该才是关键，这四条都是辅助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042006,
					"content": "要把这五段话都结合起来，但是到底该怎么理解呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042007,
					"content": "「汇之而成」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "汇之而成…听起来像是在说，这四段话可以用某种方式结合起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042009,
					"content": "等等，我记得，这四段「诫语」都各自存在于某一处遗迹之中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042010,
					"content": "唔…我有一个不成熟的猜测。如果想要解读这四段「诫语」，也许还需要借助一下这些「诫语」各自所在的<color=#00E1FFFF>「遗迹」</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042011,
					"content": "不过，具体的解读方式，我还要再思考一下…你也可以想想，如果有什么好想法，直接去付诸实施也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042012,
					"content": "毕竟你不像我这个「弱不禁风」的学者，跑几步就没劲了…唉，真羡慕你，有这么好的体力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210042013,
					"content": "好了，我再在这里仔细思考一下，如果你有什么想法，或者发现的话，就来告诉我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
