			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿弗拉图"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840201,
					"content": "你们是受本人阿弗拉图委托而来的镀金旅团吗？如果不是的话，还是请在此留步吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840202
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840202,
					"content": "前面的区域很危险，我已经委托了聚砂厅让镀金旅团来处理了，普通人还是小心为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840203
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840203,
					"content": "作为教令官，你们要是出了什么意外的话，那就是我的失职了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840204,
						730840206
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840204,
					"content": "我们不是普通人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840205
					]
				},
				{
					"id": 730840205,
					"content": "唔…那些初来乍到的冒险家们都这么说，在沙漠过于自信可是很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840208,
					"content": "注意到那边的巨大机械了吗，那是传说中荼诃人的遗物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840209
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840209,
					"content": "荼诃人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840210
					]
				},
				{
					"id": 730840210,
					"content": "嗯，通常的说法应该是坎瑞亚？荼诃是我们因论派喜欢用的古称。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840211
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840211,
					"content": "传说五百年前，荼诃{RUBY#[D]坎瑞亚}古国的「白鹄骑士」曾驾驶着这些巨大的机械对抗黑渊涌出的魔群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840212
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840212,
					"content": "在残酷的战争后，最终残留下来的三台遗迹巨像被贤者们所封印，这台遗迹巨像就是其中之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840213
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840213,
					"content": "按理来说这台机械已经在此静默了数百年了，但是不知道怎么最近突然活跃了起来，甚至还开始攻击附近的人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840214
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840214,
					"content": "无差别地用激光炮攻击附近的活物，这样危险的机能在这些被封印的遗迹巨像身上还是第一次见。没办法放任不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840215
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840215,
					"content": "明明为这些机械提供能源的混沌炉心早就进行过无害化处理了，没想到过了几百年竟然还能运行，真是奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840216
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840216,
					"content": "虽然一句话也没听懂，但是这个遗迹巨像，应该和我们之前在降诸魔山见过的一样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840217,
					"content": "不过之前的那个大家伙可不会乱攻击人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840218,
					"content": "哦哦，你们知道遗迹巨像吗，那就不用我再解释了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840219
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840219,
					"content": "那么你们应该知道的，遗迹巨像虽然也装载了自律系统，但主要还是由人类操纵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840220
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840220,
					"content": "这也是最奇怪的地方，进入遗迹巨像的通路都被贤者利用「须陀流心」的力量封印起来了，应该没有人能够进去启动它才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840221
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840221,
					"content": "是有人通过其他的方法进去了吗？还是说触发了什么我们还不知道的自启动机制呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840222,
						730840227
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840222,
					"content": "要是加扎里在的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840223
					]
				},
				{
					"id": 730840223,
					"content": "对哦，加扎里先生不是专门研究这个遗迹巨像的吗？要是他在的话，肯定迫不及待的要进去看看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840224,
					"content": "嗯？你们认识加扎里吗，确实他的话确实对这些东西有些研究。虽然我也有找他协助调查，不过他好像正忙着闭关写什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840225
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840225,
					"content": "该说是妙论派的家伙特有的天真吗？要是他能对教令院的事务多上点心，就不会到现在还止步在陀裟多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840226
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840226,
					"content": "不如让我们来协助调查吧，之前加扎里先生的调查，也是我们协助的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840231,
					"content": "#如果能把给镀金旅团的报酬给我们的话。对吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840232,
					"content": "真的吗？你们有这样的经验的话，那可真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840233
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840233,
					"content": "不过你们是冒险家吗？如果是一般民众的话，我可不能让你们冒这样的风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840234
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840234,
					"content": "就算你们说之前也协助调查过类似的机械，但是和这个不同，这家伙的激光炮可不是闹着玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840235
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840235,
					"content": "要是让你们白白送命的话，我可没法向教令院交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840236,
						730840238
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840236,
					"content": "我们是注册在籍的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840237
					]
				},
				{
					"id": 730840237,
					"content": "如果是这样的话，程序上倒是没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840240,
					"content": "毕竟我也还有重要的研究工作，一直耽搁在这里也不是办法。为了尽快解决就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840241
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840241,
					"content": "那么委托就是进入遗迹巨像里面关闭它的自律系统，如果能搞清楚遗迹巨像发生异变的原因就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840242
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840242,
					"content": "自律系统的开关应该是在驾驶舱里，成功关闭之后会进入手动模式。不过驾驶舱也被封印了，只有将封印解除才能进到里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840243
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840243,
					"content": "嗯…根据记载，维持封印力量的是散布在巨像内的三组「须陀流心」，只要把它们都打破就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840244
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840244,
					"content": "不过要注意小心不要破坏机关内部的结构啊，毕竟这可是教令院登记在册的重要文物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840245
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840245,
					"content": "嘿嘿，好说好说，就交给我们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840238,
					"content": "我们是闻名诸国的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840239
					]
				},
				{
					"id": 730840239,
					"content": "是吗？我之后会向冒险家协会查证的，现在就先姑且相信你们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840227,
					"content": "要进去看看才知道吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840228
					]
				},
				{
					"id": 730840228,
					"content": "话是这么说，不过不知道是不是聚砂厅的业务太忙了，这么久也没有镀金旅团的人过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840229
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840229,
					"content": "教令院的封印还好说，问题是进入遗迹巨像的通路入口是被巨石堵住的，靠我自己可没办法挪开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840230
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840230,
					"content": "哦哦，听上去我们倒是可以帮忙，毕竟之前也进去过一次呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730840206,
					"content": "前面发生了什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840207
					]
				},
				{
					"id": 730840207,
					"content": "发生了一些异变哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "阿弗拉图"
				}
			]
		},
		{
			"id": 7308403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿弗拉图"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840301,
					"content": "虽然作为教令官负责这里，但我其实是因为要去考察，结果正好在附近而被临时委派到这里来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840302
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840302,
					"content": "况且我来自伐护{RUBY#[D]因论派}末那学院，对遗迹巨像的了解也仅限于历史书上的只言片语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840303
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730840303,
					"content": "不过如果借此能对荼诃{RUBY#[D]坎瑞亚}古国的历史有更多了解的话，对我接下来的研究应该也会很有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿弗拉图"
				}
			]
		},
		{
			"id": 7308417,
			"completionStepIds": [
				7308417
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308417",
							"2"
						],
						"stepId": 7308417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿弗拉图"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730841701,
					"content": "情况如何？我注意到遗迹巨像发生了一些异动，是你们进去把它的自律系统关闭了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841702,
						730841704
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841702,
					"content": "已经轻松解决了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841703
					]
				},
				{
					"id": 730841703,
					"content": "那真是太好了，这样委托也算是完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841706,
					"content": "不过关于它到底为什么会突然启动，你们在遗迹巨像里面有发现什么线索吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841707
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841707,
					"content": "向阿弗拉图回报了在遗迹巨像内部的发现。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730841708
					]
				},
				{
					"id": 730841708,
					"content": "嗯…过度生长的藤蔓…不像是沙漠中会出现的生态啊。虽然我也不是很清楚，不过听上去像是和地脉之类的有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841709
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841709,
					"content": "之前也有接到过类似的，炉心被破坏的遗迹机关因为地脉的原因还能不断「复活」的报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841710
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841710,
					"content": "荼诃人制造的机关和地脉能源之间，应该还有很多我们尚不清楚的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841711
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841711,
					"content": "而且古代贤者们使用的封印原本就是利用了地脉的力量构筑的，要是地脉发生了什么异变的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841712
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841712,
					"content": "如果我的推论没错，可能各地被封印的遗迹巨像都会开始出现问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841713
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841713,
					"content": "听上去有点麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841714
					]
				},
				{
					"id": 730841714,
					"content": "只能先向教令院报告看看了，这种事情我也没办法处理啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841715
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841715,
					"content": "本来我此行是为了前往荼诃人的遗迹考察，好不容易才从教令院申请到了许可，还联系到了当地的教团来接我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841716
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841716,
					"content": "结果刚一出城就碰到这种麻烦事，但是教令院派下来的任务也没办法拒绝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841717
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841717,
					"content": "现在事情总算解决了，我也能继续我的游学之旅了，剩下的工作就等教令院派其他人来处理好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841718
					],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841718,
					"content": "那么请收下报酬。如果有缘的话，或许我们还会在沙漠的某处再见的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿弗拉图"
				},
				{
					"id": 730841704,
					"content": "已经关闭了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841705
					]
				},
				{
					"id": 730841705,
					"content": "嗯，这样它应该就不会乱攻击附近的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "阿弗拉图"
				}
			]
		}
	]
}