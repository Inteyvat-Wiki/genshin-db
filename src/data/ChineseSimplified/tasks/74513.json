			},
			"dialogs": [
				{
					"id": 745130101,
					"content": "路过的客人，生论派的学者、兼大巴扎与海露港的新星商人拜希麦五世恳求您，别急着离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130102
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130102,
					"content": "请放松身体，放空思绪，听我说一件重要的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130103
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130103,
					"content": "团雀最可爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130104
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130104,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130105,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130106
					]
				},
				{
					"id": 745130106,
					"content": "团雀确实很可爱，但拜希麦小姐说自己是…学者兼商人？一句话没有限制范围，不是会引发很激烈的争论吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130107,
					"content": "我的印象里，学者的发言都很谨慎的，商人也不敢随便说出很夸张的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130108,
					"content": "如果你和别人说，「我的理论最正确」或者「我的商品最厉害」，那不是会被很多不服气的人盯上，用力找茬吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130109,
					"content": "奇怪，怎么感觉这段对话好像发生过，有种熟悉感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130110,
						745130111,
						745130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130110,
					"content": "那我还要说！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130113,
					"content": "#噫！{NICKNAME}，为什么这么突然啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130114,
					"content": "就算不是开玩笑，也不要那么大声嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130115,
					"content": "哈哈哈！就是这种气势！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130116
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130116,
					"content": "我当然知道，世上任何东西都没有绝对的第一。任何学术理论都有被推翻的可能，任何商品都会被新品超越。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130117
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130117,
					"content": "但不管客观的世界怎么变，每个人心里都存在一些…自己最认可的人与事物。不管别人怎么说，它们的价值都是最高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130118
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130118,
					"content": "要是害怕被人否认，对自己失去信心，那就永远不可能成为自己心里最棒的模样，更没法找到认可自己的知音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130119
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130119,
					"content": "如果你们来玩过我这款桌上游戏「哐哐当当雀雀球」，也会像我这样大声告诉别人，团雀最可爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130120
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130120,
					"content": "哐哐…当当…雀雀球？就是你旁边这张桌子上的东西吗？也有点眼熟呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130121,
					"content": "没错哦，玩过这个游戏以后，你们就能深刻领会到团雀的可爱之处啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130122
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130122,
					"content": "我正在推广这种桌上游戏，如果在游戏里得到高分，还可以获得一些奖品哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130123
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130123,
					"content": "我确实觉得团雀很可爱啦，就算奖品不多也没关系，只要能玩得开心就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130124,
					"content": "#你觉得呢，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130125,
						745130126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130125,
					"content": "我也想来试试看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130127,
					"content": "嘿嘿嘿，看来我们的意见即将统一了！那就请你们尽情体验吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 745130126,
					"content": "团雀究竟多可爱！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130111,
					"content": "派蒙最可爱！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130112,
					"content": "什么都不管！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				}
			]
		}
	]
}