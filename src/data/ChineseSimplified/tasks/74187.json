					"nextDialogs": [
						741870612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741870612,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741870613,
					"content": "咳，总之，我们是过来视察前线军团的情况的！",
