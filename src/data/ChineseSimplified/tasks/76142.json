			"dialogs": [
				{
					"id": 761420401,
					"content": "菲拉耶夫，别怕，我和帕托利会带你一起出去的。精神点，像个合格的执灯人一样，把剑拿稳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420402,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420403,
					"content": "有什么计划？能有什么计划，帕托利。如果这就是结局，那我会在这里战斗到底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420404,
					"content": "你们是最棒的小队，不论结果会如何，曾与你们一同并肩是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420405,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420406
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420406,
					"content": "这也是我们的荣幸，队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420407,
					"content": "来吧，准备防守！让这群狗东西见识一下「凛风之马」的厉害！",
