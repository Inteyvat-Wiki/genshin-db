			"dialogs": [
				{
					"id": 761420301,
					"content": "嘿，契诺夫，你还好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420302,
					"content": "还拿得动刀…队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "契诺夫"
				},
				{
					"id": 761420303,
					"content": "肖诺科维奇…菲拉耶夫…你们没事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420304,
					"content": "呃啊…我的腿好像断了，万幸我还活着，你计数了吗？我杀了几个了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "肖诺科维奇"
				},
				{
					"id": 761420305,
					"content": "到…到底有多少魔物啊，我们…我们不会要死在这里了吧，队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "菲拉耶夫"
				},
				{
					"id": 761420306,
					"content": "你个混小子在说啥呢？我们肯定能安全出去的！别担心，斥候肯定已经回城告诉老爷子了，我们的增援已经在路上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420307,
					"content": "又来了，这群狂猎真是没完没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 761420308,
					"content": "嘿！拿好你们的武器和灯，我们还有一场硬仗要打呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
