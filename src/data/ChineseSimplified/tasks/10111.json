			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯坦利",
					"杰克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101110402,
					"content": "我刚才以为自己会死！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110403,
					"content": "确实只差一点点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110404,
					"content": "对了，你就是冒险家杰克吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110405,
					"content": "对，请问你是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110406,
					"content": "我们是来找你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110407,
					"content": "艾琳托我们带个口信给你：今天她没法跟你商量冒险计划了，得改天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110408,
					"content": "呃…原来是这样，真不好意思，还麻烦你们到这里来找我…还救了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110409,
					"content": "哈！多管闲事！根本就不用救，难道我斯坦利还搞不定这种简单的情况吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101110410,
					"content": "哇，你就是那个名震蒙德、曾经抵达「烬寂海」的传说级大冒险家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110411,
					"content": "没错，我就是斯坦利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101110412,
					"content": "哈哈，很荣幸见到这种传说级的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110413,
					"content": "那么各位，现在怎么打算？往前？还是回头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110414,
					"content": "斯坦利先生怎么想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "#哈哈，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}，跟你们在一起的，可是名震蒙德的大探险家斯坦利啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101110416,
					"content": "难道还有走回头路的必要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101110419,
					"content": "全票通过，那就继续前进咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110417,
					"content": "杰克怎么想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "我们还是继续向前走吧，有斯坦利先生在，一定没问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "杰克"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
							"2"
						],
						"stepId": 1011106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "旅行者，我有一个小小的发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110602,
					"content": "可以请你打开探测仪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110603,
					"content": "哎？斯坦利居然也有「幻想朋友」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110604,
					"content": "看起来，他的朋友是一位久经沙场的战士…浑身都是伤痕，表情也十分坚毅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110605,
					"content": "像是斯坦利描述里的自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "他的幻想朋友，难道是理想化的自己？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110607,
					"content": "有意思。但，真的是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110611,
					"content": "那么，我先走咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101110612,
					"content": "斯坦利先生再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110613,
					"content": "二位，请问有空吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110614,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110615,
					"content": "其实，前几天斯坦利先生喝醉酒，说了一些不为人知的秘密给我听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110616,
					"content": "他当年冒险时用的武器，是大英雄温妮莎的遗物，<color=#00E1FFFF>「辉煌勇气之剑」</color>和<color=#00E1FFFF>「光耀意志之盾」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110617,
					"content": "说出来怕你们不信，这两件武器现在都还藏在蒙德境内，就在<color=#00E1FFFF>达达乌帕谷</color>哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110618,
					"content": "你们这么厉害，能不能陪我去找这两件神器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110619,
					"content": "竟然有这么厉害的武器？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "当然有啊！毕竟那可是斯坦利先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110623,
					"content": "如果能找到足够厉害的东西证明自己，家里说不定就会支持我做冒险家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110624,
					"content": "现在我还是能力不足的新人，而且父亲和母亲对我的理想非常反对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110625,
					"content": "所以求求你了，帮帮我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110626,
					"content": "我不敢把这个自私的念头说给斯坦利先生听…但我保证，用完马上就还给他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110627,
					"content": "好可怜…喂，我们就帮帮他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110628,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "温迪，你来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110631,
					"content": "这个嘛…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110632,
					"content": "前年我托人搞来一瓶珍贵名酒，只要帮我找到神器，酒就归你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110633,
					"content": "<color=#00E1FFFF>达达乌帕谷</color>对吧？！事不宜迟，我们现在就动身！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110629,
					"content": "不能视而不见吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "他把神器随便丢在野外？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "厉害的人总是有些怪癖嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101110608,
					"content": "说起来，他的故事也有点奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "哦？你也觉得有问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101110610,
					"content": "看来，斯坦利的故事还有隐情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "温迪"
				}
			]
		}
	]
}