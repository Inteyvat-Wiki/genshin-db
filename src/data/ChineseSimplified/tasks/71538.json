			},
			"dialogs": [
				{
					"id": 715380101,
					"content": "#{NICKNAME}，你好。海灯节快乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380102,
					"content": "你…是来办案的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "我正在被强制休假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380105,
					"content": "强制…休假？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "按照执律庭的规定，到每年年底，每一个人的公假都必须休完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380107,
					"content": "但是，今年的年终核算结束之后，队里发现我没有休过一天公假。所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380108,
					"content": "特巡队真辛苦啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "不是，特巡队里本来有轮班休假制，但我身为特巡队队长，必须常驻值守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380111,
					"content": "再加上，时不时有些突发情况必须要我去处理，久而久之…我就忘记休假了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380112,
					"content": "虽然这些公假对我来说没什么所谓，但我一说不如就不休假了，队里的人一下子都激动了起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380113,
					"content": "这群家伙嚷着什么「这可是白纸黑字的规定啊队长，我们特巡队怎么能违规」，一定要我出去休假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380114,
					"content": "还有一个总是来我们队办事的复律官在旁边帮腔，甚至他还突然掏出了一张船票，说璃月正好在举办海灯节，还向我保证，这里绝对是休假的最佳地点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380115,
					"content": "但不得不说，璃月确实不错。我刚从翘英庄回来，那边用茶叶做的点心味道都非常好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380116,
					"content": "我买了不少点心，准备带回去给队里的人尝尝，还想按照璃月的习俗，做几封「祝柬」附在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380117,
					"content": "只是…我并不是很会做这种东西，怎么做都感觉怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380118,
					"content": "#{NICKNAME}，你明白这种东西的做法么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380119,
					"content": "我倒是有些建议…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "特巡队每个人都这样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "你…看着不像是来工作的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
