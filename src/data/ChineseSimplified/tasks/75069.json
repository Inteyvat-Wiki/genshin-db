			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夸恩因"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "啊呀，这里，很少有人来呢…因为毕竟是，危险的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750690202,
					"content": "难道你也是冒险团的人吗…哼，听说黑色巨蛇的影子自天蛇船降临…你也要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750690203,
					"content": "或者，不如早点离开吧，冒险团里，哈，也藏着非人之物啊…那些声音，咒骂，好吵闹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750690204,
					"content": "在这里反而能平静一点，因为瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
