			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "（破碎的纸张，一开始，写着整齐的文字…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690502,
					"content": "「…深渊的魔物变得越来越多，这都是可预见的…冒险团最终还是失败了，撤退的计划正在进行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690503,
					"content": "「必须得，让剩下的人安全撤离，得小心防备那些突然在夜晚消失的，或是那些自无光之处重新归来的人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690504,
					"content": "「…那些深渊的魔物出现得越来越多，据点或许也会被发现，但是得在那之前…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690505,
					"content": "（下面的字开始变得歪歪扭扭起来…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690506,
					"content": "「啊，好冷…好冷，在那里，在那里，血也流空了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690507,
					"content": "「瀑布声音，好大，对，这样就好。只要这样…只要在瀑布底下，在那里就会安静了，白色的脸，张开的嘴巴，流光的血…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690508,
					"content": "「就在那里，在…那里，有什么东西…有什么在…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "夸恩因的日记"
				},
				{
					"id": 750690509,
					"content": "「在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因的日记"
				}
			]
		},
