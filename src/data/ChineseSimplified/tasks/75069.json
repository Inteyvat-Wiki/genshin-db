					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750691203,
					"content": "你为什么在这？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "我是…冒险团的战士，不过，我的勇武比不上领队的泰卡大人，不过，也有用得上我的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750691205,
					"content": "我负责保护冒险团的营地…有的时候在夜里也，无法睡去，所以干脆起来巡逻，保护营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750691206,
					"content": "不知道什么时候，营地里的人越来越少了…啊，咦，奇怪，为什么我现在在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750691207,
