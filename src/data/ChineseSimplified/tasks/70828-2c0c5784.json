					"埃尔西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "（交出《阿伊·哈努姆之歌》。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "哇哦，好漂亮的书！让我看看里面写了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280203,
					"content": "「…没有无蛇的宝座，没有无刺的蔷薇。把苦痛一饮而尽吧，菲莉吉丝啊，再用你甜美的双眸，与我彼此许下…许下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280204,
					"content": "…呃，后面这字儿念什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280205,
					"content": "不行，太深奥啦！舌头都要打结了！总之我先买回去慢慢读…谢谢你啦，金发的冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔西"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
