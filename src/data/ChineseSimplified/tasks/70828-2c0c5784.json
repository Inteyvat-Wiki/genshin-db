			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "（交出《罗纳布韦之梦》。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "哦哦，是枫丹的诗集！让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280403,
					"content": "…回到过去…纯水骑士的王庭…和侍女一见钟情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280404,
					"content": "笑死我了，怎么会有这么傻的人啊！明明有机会回到过去，结果满脑子居然只有怎么找和自己祖宗一个年龄的人谈恋爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280405,
					"content": "这不是爱情诗嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280406,
					"content": "唉，我懂了，爱情就是让人发昏。总之我先买回去慢慢读，谢谢你啦，金发的冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔西"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
