					"埃尔西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "哈哈，谢谢你啦，金发的冒险家！你真是我的大大大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280502,
					"content": "我现在感觉脑海中的灵感就像风龙废墟的狂风、沉玉谷的瘴气、清籁岛的雷霆，正在呼啸着往外涌——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280503,
					"content": "听起来好危险！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "哼哼，你就等着吧！我这就把它们写下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280505,
					"content": "莱纳斯那种酸溜溜的诗歌根本不堪一击，等我的旷世巨作完成，全提瓦特的酒馆都会为本小姐沸腾的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔西"
				}
			]
		},
		{
