				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃尔西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "啊！那边那位金发的冒险家，请等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280103,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "不是不是，只是想问你有没有关于爱情的诗集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280107,
					"content": "你看，本小姐是超厉害的吟游诗人，也许是蒙德历史上除了巴巴托斯大人以外最厉害的吟游诗人…总之就是特别厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280108,
					"content": "但那个叫莱纳斯的吟游诗人似乎总是不服气，一天到晚跑来找本小姐念诗！不管怎么看都是在故意挑衅，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280109,
					"content": "更可气的是，他念的还都是什么爱情啊、恋人啊…都是本小姐完全没写过的主题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280110,
					"content": "所以，我决定亲自出马，写一首震撼全蒙德的伟大爱情诗，让他见识一下什么叫真正的才华！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280111,
					"content": "不过嘛…本小姐把时间都奉献给了伟大的艺术，暂时还没空去体验爱情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280112,
					"content": "所以，要是有什么关于爱情的诗集，可以卖给我！只要让我随便翻翻，以本小姐的天赋，绝对立刻就能文思泉涌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280104,
					"content": "帮不了，我还有事，告辞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "不是让你帮忙啦！话又说回来，要是人人遇到问题，都靠在路边随便拉一个陌生人解决，那大家恐怕都不敢上路了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280106,
					"content": "咳咳，只是想问你有没有关于爱情的诗集而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "埃尔西"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
