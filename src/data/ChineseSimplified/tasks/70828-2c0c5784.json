			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃尔西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "（交出《爱、圣启与美德的典律》。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "啊，我听说过这个！是西风教会的诗集，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280303,
					"content": "我看看…「她的灵魂如焚烧的原野，向风发出炙热的歌唱；在星辰、月光与日轮间，灼伤了我的光芒…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280304,
					"content": "写的什么玩意儿啊，怪吓人的。而且西风教会的人一看就不会写诗嘛，星星、月亮和太阳怎么可能一块儿出现呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "埃尔西"
				},
				{
					"id": 708280305,
					"content": "好，有自信了！本小姐再怎么说也能比这诗集的作者写得好！这书我买下了，谢谢你啦，金发的冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃尔西"
				}
			]
		},
