			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丹纳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736940101,
					"content": "唔，大家怎么都一副疲惫的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940102
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940102,
					"content": "这里在举办什么活动吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940103
					]
				},
				{
					"id": 736940103,
					"content": "你是…旅行者对吧？哈哈哈，久仰大名了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940104
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940104,
					"content": "没错，我们伐护末那学院正在这里举办一个有关「考古」的小游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940105
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940105,
					"content": "毕竟我们学院里有不少研究历史的学者，在这些学者的研究过程里，自然就免不了去亲自「考古」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940106
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940106,
					"content": "哎呀，别紧张，我们可不会让大家去真的考古啊。这次的活动，只是考古这种「行为」的一种模拟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940107
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940107,
					"content": "我们已经预先在须弥城周围埋了不少「文物模型」…我们就暂且把埋着这些东西的地方称作「考古区」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940108
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940108,
					"content": "参与活动的人，只需要拿上我们特别制作的探查器，在「考古区」内将埋藏的「文物模型」挖出来就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940109
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940109,
					"content": "多亏了其他学院的同学，帮忙特制了一批容器和对应的探查器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940110
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940110,
					"content": "怎么样，旅行者？你有没有兴趣试试看啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940111,
						736940112
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940111,
					"content": "听起来倒也不难…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				},
				{
					"id": 736940113,
					"content": "哈哈哈，好！这是探查器，你拿好了。我再把「考古区」所在的位置标在<color=#00E1FFFF>考古手册</color>上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940114
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940114,
					"content": "这样就行了，快去体验考古的乐趣吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940115
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940115,
					"content": "如果你把所有的「文物模型」都找到了，记得回来找我拿礼物啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940116
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940116,
					"content": "寻找模型的时候，只要跟着探查器走就好了。为了方便分类，还用元素类别做了区分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940117
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940117,
					"content": "不过…那些探查器原来是用来探测元素的，被临时改造后，还是可能被一些特定的元素影响…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940118
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940118,
					"content": "总之，只要把所有的「文物模型」都挖出来，我们还有好礼相赠喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736940112,
					"content": "试试也没问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				}
			]
		}
	]
}