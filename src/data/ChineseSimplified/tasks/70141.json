				"points": []
			},
			"dialogs": [
				{
					"id": 701411201,
					"content": "这座雪山可真危险…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701411202
					]
				},
				{
					"id": 701411202,
					"content": "嗯？你回来了，怎么样，看到那些冰了吧，呃…你怎么这么一副样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411203,
					"content": "关于洞窟中的气流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701411204
					]
				},
				{
					"id": 701411204,
					"content": "你已经到那么高的地方了？你还真是厉害啊。不过…被奇怪气流封堵的洞窟？唔，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411205,
					"content": "哦…我想起来了，之前有一支冒险队运气好，一直探索到了山顶附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411206
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411206,
					"content": "虽然他们还是没能靠太近，但是据他们说，山顶附近的一个洞窟里确实有一股奇怪的强气流涌出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411207
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411207,
					"content": "但按道理来说，那种地方即使有气流，也不该那么强才对，到现在也没人能找出原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411208
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411208,
					"content": "而且除了那股奇怪的气流之外，雪山中还有一些奇怪的冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411209
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411209,
					"content": "那些冰难以击碎，用火烤也不会融化，对我们的探索造成了很大的阻碍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411210
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411210,
					"content": "我们也一直找不到对付那些冰的办法，只能尽量绕开走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411211
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411211,
					"content": "而且在一些冰旁边，还生长着许多蓝色的植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411212
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411212,
					"content": "虽然我能隐约看见那些冰里似乎冻着什么，但我也没办法让那些冰解冻，也只能看看罢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411213
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411213,
					"content": "你有兴趣的话，可以循着那种蓝色植物，去看看那些冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411214
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411214,
					"content": "嗯…我想想，<color=#00E1FFFF>「雪葬之都·近郊」</color>和<color=#00E1FFFF>「星荧洞窟」</color>周围就长着很多那种植物，你可以去那里看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411215
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411215,
					"content": "奇怪的强气流、和奇怪的冰，还有奇怪的植物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411216
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411216,
					"content": "哈哈哈，要是在一般的探险故事里，这三者之间说不定会有什么关联。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411217
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411217,
					"content": "但在现实里，探险还是要脚踏实地…你要进雪山的话，记得也要做好充足的准备啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
