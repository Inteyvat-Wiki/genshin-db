			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701410101,
					"content": "关于雪山的情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410102
					]
				},
				{
					"id": 701410102,
					"content": "雪山的情况？我只能说，这里的环境比蒙德任何地方都要凶险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410103,
					"content": "除了恶劣的环境之外，这座山里还有一些奇怪的…冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410104,
					"content": "那些冰难以击碎，用火烤也不会融化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410105,
					"content": "最主要的是，有几条道路被这些冰堵住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410106,
					"content": "我们的好几支探险队都被那些冰拦住，用尽方法也绕不过去，只能折返回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410107
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410107,
					"content": "唉，不知道什么时候才能找到解决那些冰的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410108
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410108,
					"content": "我想去看看那些冰。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410109
					]
				},
				{
					"id": 701410109,
					"content": "你只是想去看看那些冰吧？我记得雪山的外围也有一大块类似的冰，不知道里面冻着什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410110
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410110,
					"content": "你可以去那附近看一看，不过记住，千万不要再往里走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
