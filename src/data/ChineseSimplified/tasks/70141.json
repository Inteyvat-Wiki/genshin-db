				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701410401,
					"content": "关于洞窟中的气流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410402
					]
				},
				{
					"id": 701410402,
					"content": "你已经到那么高的地方了？你还真是厉害啊。不过…被奇怪气流封堵的洞窟？唔，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410403
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410403,
					"content": "之前有一支冒险队运气好，也是一直探索到了很高的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410404
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410404,
					"content": "虽然他们还是没能靠太近，但是据他们说，那附近的一个洞窟里确实有一股奇怪的强气流涌出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410405
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410405,
					"content": "但按道理来说，那种地方即使有气流，也不该那么强才对，到现在也没人能找出原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410406
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410406,
					"content": "而且除了那股奇怪的气流之外，雪山中还有一些奇怪的冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410407
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410407,
					"content": "那些冰难以击碎，用火烤也不会融化，对我们的探索造成了很大的阻碍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410408
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410408,
					"content": "我们也一直找不到对付那些冰的办法，只能尽量绕开走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410409
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410409,
					"content": "而且在一些冰旁边，还生长着许多蓝色的植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410410
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410410,
					"content": "虽然我能隐约看见那些冰里似乎冻着什么，但我也没办法让那些冰解冻，也只能看看罢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410411
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410411,
					"content": "你有兴趣的话，可以循着那种蓝色植物，去看看那些冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410412
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410412,
					"content": "嗯…我想想，在雪山里，似乎<color=#00E1FFFF>「覆雪之路」</color>、<color=#00E1FFFF>「雪葬之都·近郊」</color>和<color=#00E1FFFF>「星荧洞窟」</color>周围就长着很多那种植物，你可以去那里看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410413
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410413,
					"content": "奇怪的强气流、和奇怪的冰，还有奇怪的植物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410414
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410414,
					"content": "哈哈哈，要是在一般的探险故事里，这三者之间说不定会有什么关联。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410415
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410415,
					"content": "但在现实里，探险还是要脚踏实地…你要进雪山的话，记得也要做好充足的准备啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
