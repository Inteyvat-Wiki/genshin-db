			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿守",
					"阿晃",
					"荒泷一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727300201,
					"content": "老大，不能就这么算了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300202
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300202,
					"content": "你好不容易打响了「真剑斗虫大鬼王」的名号，怎么能让那个小鬼得逞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300203
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300203,
					"content": "对，那个小鬼一定使诈了，他暗算了老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300204
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300204,
					"content": "你们两个，慌什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300205
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300205,
					"content": "之前的那一仗，本大爷也有点轻敌。谁让那个小鬼看起来太普通了嘛！不算数，不算数！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300206
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300206,
					"content": "别管那小鬼耍了什么把戏，我们就按计划，摆开「荒泷极意堂堂斗虫大试合」的阵势，再拿出本大爷锤炼多年的「赤红一杵」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300207
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300207,
					"content": "到时候，满场都是观众们为本大爷叫好的呼声，再加上「赤红一杵」碾压性的实力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300208
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300208,
					"content": "那个小鬼绝对会吓得两腿发抖吧，什么伎俩都使不出来！本大爷轻轻松松就能把他拿下，啊哈哈哈哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300209
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300209,
					"content": "老大英明！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300210
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300210,
					"content": "可是，忍姐不知道什么时候才会回来，要举办这场「荒泷极意堂堂斗虫大试合」，从什么地方下手才好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300211
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300211,
					"content": "根据「荒泷极上盛世豪鼓大祭典」的经验，我们需要提前向天领奉行报备，拿到活动举办许可…好像还有个场地租用凭证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300212
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300212,
					"content": "这些好像都需要经费，考虑到要把「极意大试合」举办得比「豪鼓大祭典」更热闹，至少得花三倍的摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300213
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300213,
					"content": "停停停停停！一听到天领奉行这四个字，我就头疼得厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300214
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300214,
					"content": "至于经费…大不了我们就别做一休三了！加把劲，做二休四！这样我们加起来多做了四天工，整整多赚四倍摩拉，肯定够了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300215
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300215,
					"content": "不愧是老大！这样一来，我们只需要考虑参战的将士了！参战的将士也不用太强，能帮老大应付对方的杂兵就行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300216
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300216,
					"content": "对哦！那小鬼说过，他还会带五个斗虫好手过来，和我们公正对决。问题是荒泷派里精通斗虫的，就只有老大你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300217
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300217,
					"content": "要是他们对老大发起车轮战，就算老大的实力再强，也会吃不消的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300218
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300218,
					"content": "你们两个！明明还没开始准备，怎么就畏手畏脚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300219
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300219,
					"content": "拿出荒泷派的志气来！这点小问题，本大爷会想办法解决的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300220
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300220,
					"content": "要不然，先去把以前斗虫的小友们找过来，商量一下？或者去长野原烟花店看看，问问她能不能参战…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300221
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300221,
					"content": "不成！那样的话，本大爷败给一个小鬼的事，很快就会传遍整个花见坂，谁丢得起那个脸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300222
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300222,
					"content": "嗯哼！放牛的，你又在搞什么名堂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300223,
					"content": "喂！吓死本大爷了，你们什么时候来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300224
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300224,
					"content": "居然还好意思问我们，我们站在这里很久了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300225,
					"content": "#我和{NICKNAME}本来想去冒险家协会，结果远远就看见你们在这里吵吵嚷嚷，说着一大堆不明所以的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300226,
						727300227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300226,
					"content": "「真剑斗虫大鬼王」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300228
					]
				},
				{
					"id": 727300228,
					"content": "是「大」试合！少了一个大字，可就完全不够热血了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300229
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300229,
					"content": "我的挚友啊，如果你也多多斗虫，一定能明白斗虫激动人心的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300230
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300230,
					"content": "所以说，你是不是被什么人打败了，正琢磨着怎么挽回面子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300231,
					"content": "话可不能这么说，那都是暗算，暗算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300232
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300232,
					"content": "没错，有个叫「花角玉将」的小鬼，看准老大和其他小友切磋后的疲劳时期，突然加入对局，向老大发起了挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300233
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300233,
					"content": "用一只大得夸张的鬼兜虫，哐哐两下就把老大的虫子挑翻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300234
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300234,
					"content": "还说什么，要让老大了解「斗虫强者的真实世界」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300235
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300235,
					"content": "喂，阿守！不用把我战败的过程说得这么清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300236
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300236,
					"content": "好像明白了原委…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300237
					]
				},
				{
					"id": 727300237,
					"content": "言归正传，我好像听说过，我的挚友无论干什么都很有天赋，两三下就能学会一门新技艺，而且比大部分人还厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300238
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300238,
					"content": "我已经猜到你要说什么了，放牛的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300239,
					"content": "你是不是想拜托我们帮你报仇，打败那个什么「花角玉将」，让我们打白工了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300240,
					"content": "打白工？飞行矮堇瓜，我荒泷一斗是那么不讲义气的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300241
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300241,
					"content": "要是我的挚友答应帮我，我就包下你们两个月的午饭，每天都请你们吃一碗招牌拉面，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300242
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300242,
					"content": "每，每天一碗？那我们确实可以考虑考虑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300243,
						727300244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300243,
					"content": "一斗居然这么阔绰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300245
					]
				},
				{
					"id": 727300245,
					"content": "哈哈哈，这可是老大用宝贵的胜利换来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300246
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300246,
					"content": "之前有一位小友自称「真剑斗虫大鬼王」，老大听说后很不服气，就向他发起了挑战。如果那位小友输了，就要让出这个称号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300247
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300247,
					"content": "经过长达一天一夜的九十二次苦战，老大终于险胜一场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300248,
						727300249
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727300248,
					"content": "怎么听起来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300250
					]
				},
				{
					"id": 727300250,
					"content": "不过，那位小友想用他家拉面摊「每天免费吃一碗招牌拉面」的优惠券，让老大网开一面，两个月后就把这个称号还给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300251
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300251,
					"content": "虽然不知道他家的拉面有多少斤两，但光冲这个分量，就是很诱人的提议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300252
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300252,
					"content": "而且，凭老大斗虫技艺的进步速度，两个月后肯定会有更威风的绰号，这笔生意确实很划算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300253
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300253,
					"content": "只不过，我们都忘了问那位小友，他家的拉面摊在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300254
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727300254,
					"content": "咳咳咳！都打住，都打住！过程不重要！总之，这些拉面都送给我的挚友和飞行矮堇瓜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300255
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300255,
					"content": "等等，我们还没想好呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300256,
					"content": "我已经向「玉将」发出战书了，他也答应，会带着几个外援，应对我们荒泷派的攻势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300257
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300257,
					"content": "至于场地，我好像知道要去哪了。首先要拜托我的挚友，把天领奉行那边的复杂手续统统搞定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300258
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300258,
					"content": "事不宜迟，我的挚友，还有飞行矮堇瓜，现在就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300259
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727300259,
					"content": "话都说到这份上了，好像也推脱不了了…看一斗这么激动，我们就跟过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300260,
					"content": "反正学学斗虫，帮他打败对手就行了吧？听起来也不复杂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300261,
						727300262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300261,
					"content": "我也想吃招牌拉面到撑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300263
					]
				},
				{
					"id": 727300263,
					"content": "唔…难道放牛的有什么「孩子气光环」吗？你也被影响了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727300264,
					"content": "前往天领奉行，帮助荒泷派办理了举办「荒泷极意堂堂斗虫大试合」的手续，随后来到了一斗所说的场地…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727300262,
					"content": "我也想试试斗虫的乐趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300263
					]
				},
				{
					"id": 727300249,
					"content": "像是对方受不了了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300250
					]
				},
				{
					"id": 727300244,
					"content": "难道打工挣了大钱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300245
					]
				},
				{
					"id": 727300227,
					"content": "「极意堂堂斗虫试合」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300228
					]
				}
			]
		},
		{
			"id": 7273004,
			"completionStepIds": [
				7273004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273004",
