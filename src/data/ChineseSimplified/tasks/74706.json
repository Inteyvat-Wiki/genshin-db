			"dialogs": [
				{
					"id": 747060101,
					"content": "…这条呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060102,
					"content": "好像还是差一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747060103,
					"content": "哥伦比娅，还有芙宁娜？你们在干嘛呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060104,
					"content": "在和芙宁娜导演一起…「选角」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060105,
					"content": "这么说倒也没错，只不过我们准备选的演员，是水族箱里的鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747060106,
					"content": "鱼都能演戏了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060107,
					"content": "现在动物演员也不少见嘛。我们想选一条气质比较符合的鱼，拍摄一些映影中用来烘托氛围的空镜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747060108,
					"content": "只不过看了一圈下来，还没有找到太合适的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747060109,
					"content": "#要试着拜托{NICKNAME}和派蒙吗？很多问题{M#他}{F#她}们都能解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060110,
					"content": "你这么信任我们倒是很高兴啦…但这个问题上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060111,
					"content": "我们可以多找一些鱼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "对哦！这水族馆就是你们负责经营的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747060114,
					"content": "也就是说，我们以后在下水的时候多留个心就行了？好像的确不难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060115,
					"content": "那就这么说定了！我稍后将想象中符合气质的鱼告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747060116,
					"content": "那你们现在就是「星探」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060117,
					"content": "你跟着芙宁娜还真是学到好多新词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747060112,
					"content": "我们可以多下水看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
