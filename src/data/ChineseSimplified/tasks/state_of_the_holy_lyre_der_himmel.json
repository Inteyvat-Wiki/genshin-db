			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3790201,
					"content": "哟，欢迎回来，我忠实的听众们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790202,
					"content": "啊，那是…天空之琴！看来你们搞定了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790203,
					"content": "流风纹的蔷薇木、微凉的星铁弦，真是怀念的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790204,
					"content": "怎么样，温迪？可以用它来呼唤特瓦林了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790205,
					"content": "嗯…虽然是如假包换的风神至宝，但现在恐怕还不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790206,
					"content": "——如你们所见，历经千年的时光，「风」的力量早就枯竭了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790207,
					"content": "这个状态的话，要在迪卢克家的酒馆驻唱，也许还行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790208,
					"content": "酒馆的演出位也是有一大堆歌手竞标的，你别太想当然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3790209,
					"content": "迪卢克老爷应该批评更重要的地方吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790210,
					"content": "喂，歌手！你把天空之琴借出来，就是为了弹给醉鬼听的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790211,
					"content": "欸嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790212,
					"content": "「欸嘿」是什么意思啊…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790213,
					"content": "总而言之，想要与特瓦林沟通，这还远远不够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790214,
					"content": "不过，并不是琴的问题，而是琴弦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790215,
					"content": "到你出马的时候了，异乡人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790216,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "放心，我不是说让你去维修这珍贵的竖琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790219,
					"content": "而是这些琴弦上附着的「风」之元素，浓度还远远不够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}，你有好好保存特瓦林的泪水结晶吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790221,
					"content": "（点头）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "我对乐器的修理没有什么心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
		{
			"id": 37903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
