			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3790401,
					"content": "哦呼。不出所料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790402
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790402,
					"content": "琴似乎有种…青春焕发的感觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790403,
					"content": "团长在夸奖自己耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790404,
					"content": "…我是说天空之琴啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790405,
					"content": "#全靠{NICKNAME}净化结晶，天空之琴的「风」之元素才没有继续枯竭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790406,
					"content": "但距离重新满溢也还有一些距离呢。如果能再多得到一些特瓦林的泪滴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790407,
					"content": "我们会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "但要怎么收集泪水结晶呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790411,
					"content": "即使是现在，特瓦林也正在哭泣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790412,
					"content": "承受着痛苦，在人迹罕至的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790413,
					"content": "特瓦林…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790414,
					"content": "真是个可怜的大家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790415,
					"content": "这不是荣誉骑士一个人的事，我们都会立刻开始行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790416,
					"content": "#得到泪滴结晶以后，就再拜托{NICKNAME}来净化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790417,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "嗯…真好啊。英雄们相互托付、携手启程的桥段，总是那么迷人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790419,
					"content": "就让我用这一曲来为你们送行吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790420,
					"content": "咦？你这是想偷懒…想只出一张嘴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790421,
					"content": "弹琴需要用到手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3790422,
					"content": "呜啊，好生气。我决定给你起一个难听的绰号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790423,
					"content": "唔…决定了，以后就叫你「<color=#00E1FFFF>卖唱的</color>」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790409,
					"content": "要怎么收集泪水结晶呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "要怎么让它哭？打就可以了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				}
			]
		}
	]
}