			"dialogs": [
				{
					"id": 742480201,
					"content": "「桌上剧团」真有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480204,
					"content": "嗯，坏坏的吸血鬼也要回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
