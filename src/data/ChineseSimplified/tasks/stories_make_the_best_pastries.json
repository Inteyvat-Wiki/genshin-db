			"dialogs": [
				{
					"id": 742480101,
					"content": "哥伦比娅小姐，桑多涅小姐！感谢你们抽空来参加我们的桌上剧团！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 742480102,
					"content": "没什么，我们之前没怎么玩过，倒是要麻烦二位多多关照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480103,
					"content": "不必有压力，大家享受故事的乐趣就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480104,
					"content": "嗯。我很期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480105,
					"content": "那么，就由我来简单说明一下此次故事的背景——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480106,
					"content": "「这是一个吸血鬼与人类共生的时代，故事就发生在两个种族共同生活的城市中…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德饰"
				},
				{
					"id": 742480107,
					"content": "「人类与吸血鬼的关系说不上敌对，但也不能称之为和谐。而一起夜晚的凶案，彻底打破了这个微妙的平衡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德饰"
				},
				{
					"id": 742480108,
					"content": "吸血鬼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480109,
					"content": "就是靠吸食人类血液才能活下去的种族啦，算是小说中的常见设定。哥伦比娅小姐看过类似的故事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 742480110,
					"content": "唔，好像听说过。那我们需要在故事中做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480111,
					"content": "各位先决定自己想要在这个世界中扮演的角色吧，贴合背景设定就行，身份和职业不做限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480112,
					"content": "想要扮演的角色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480113,
					"content": "如果自己不好决定的话，也可以和他人交换，让对方来决定你在这个世界的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480114,
					"content": "欸？意思是…让别人来写你的背景设定？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480115,
					"content": "哦！听起来很有趣呢！不如就这么办吧！我的角色卡就交给克洛琳德你来写吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 742480116,
					"content": "那我的角色，就交给桑多涅来决定吧。我也会为桑多涅设计一个符合你的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480117,
					"content": "哈…行吧。我刚好也对自己故事中的职业没有太多头绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480118,
					"content": "各位都写好了吗！嘿嘿，那我先看看自己的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 742480119,
					"content": "「我是一位商人，平时奔走于吸血鬼与人类所居住的城市…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "娜维娅",
					"speakerSubtitle": "游商"
				},
				{
					"id": 742480120,
					"content": "…等等。主持人，这不是和我以前的角色卡差不多嘛！连数值都一样！你这是偷懒了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 742480121,
					"content": "反正你到最后都会用奇奇怪怪的方式给我出难题，而且我觉得这种精明闹腾的角色很适合你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 742480122,
					"content": "…喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 742480123,
					"content": "哈哈。那我来看看我的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480124,
					"content": "「我是一位很坏很坏的吸血鬼。白天喜欢躺在家里睡觉，只在夜晚月亮出来的时候才会到花园中散步。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "很坏很坏的吸血鬼"
				},
				{
					"id": 742480125,
					"content": "「我喜欢唱歌，会用歌声诱惑自己的猎物。而见过我睁眼的人，更是没有一位能看到第二天的太阳。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "很坏很坏的吸血鬼"
				},
				{
					"id": 742480126,
					"content": "唔…在桑多涅看来，我是这么一个形象吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480127,
					"content": "哼哼，这不是挺适合你的吗？而且很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480128,
					"content": "好吧，但我还是想尽量做一个好的吸血鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480129,
					"content": "随你便，让我看看你写的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480130,
					"content": "「我是一位优雅的贵族大小姐。平时喜欢在房间里搞一些发明创造，睡觉睡得很晚，作息很不规律…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼猎人"
				},
				{
					"id": 742480131,
					"content": "喂！谁的自我介绍会写这种东西呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480132,
					"content": "啧…「但我同时也是一位吸血鬼猎人，只要城市里有人陷入了危险，我就会带着自己的发明挺身而出，拯救大家…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼猎人"
				},
				{
					"id": 742480133,
					"content": "…哈？这和我根本一点也不像吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742480134,
					"content": "是吗？我明明觉得很像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480135,
					"content": "但这么看来，哥伦比娅小姐的角色和桑多涅小姐就是对立关系了欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "娜维娅",
					"speakerSubtitle": "游商"
				},
				{
					"id": 742480136,
					"content": "嗯，看起来这故事会有很多奇妙的发展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "克洛琳德",
					"speakerSubtitle": "克洛琳德饰"
				},
				{
					"id": 742480137,
					"content": "哦！我已经等不及了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "娜维娅",
					"speakerSubtitle": "游商"
				},
				{
					"id": 742480138,
					"content": "哈…总感觉会有很多麻烦的发展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼猎人"
				},
				{
					"id": 742480139,
					"content": "你怕了吗？桑多涅。因为我是很坏很坏的吸血鬼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "很坏很坏的吸血鬼"
				},
				{
					"id": 742480140,
					"content": "嚯嚯？应该说我反倒等不及要把你揍一顿了才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」",
					"speakerSubtitle": "吸血鬼猎人"
				}
			]
		},
