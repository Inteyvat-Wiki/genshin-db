			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"菲多赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733410101,
					"content": "你好，请问你就是传闻中的那位异乡的「祭主」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410102
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410102,
					"content": "异乡的「祭主」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410103
					]
				},
				{
					"id": 733410103,
					"content": "嗯，我听说有位与花灵结为伙伴的勇士造访了花海，上一次有这样的盛事都已经是几百年前的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410104
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410104,
					"content": "在过去，花灵曾与人类同行，共同居住在「甘露花海」之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410105
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410105,
					"content": "即便需要对抗黑渊的威胁，但在「万种母树」与灵光的庇佑下，花海从未受到污秽的侵犯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410106
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410106,
					"content": "虽然已经过去了很多很多年，不过在我的记忆中，那是花海最美好的时代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410107,
						733410108
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410107,
					"content": "请问你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410110
					]
				},
				{
					"id": 733410110,
					"content": "我是负责看管「甘露池」的花灵，自从祖尔宛大人禁闭了花海之后，我就再也没离开过这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410111
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410111,
					"content": "「甘露池」是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410112
					]
				},
				{
					"id": 733410112,
					"content": "「甘露池」是赋予我们花灵生命的地方，是神明大人所留下的「原初之水」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410113
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410113,
					"content": "散落在大地上的「灵光」百种，都是因为甘露的存在获得了力量与生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410114
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410114,
					"content": "在耗尽了力量之后，我们便会化为「净光翎」，只留下纯粹的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410115
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410115,
					"content": "而所有属于灵光的记忆，最后也都会通过「甘露池」回到「万种母树」当中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410116
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410116,
					"content": "只要获得甘露的滋养，无论是怎样的痛苦与悲怨，都会被洗净，最后再度化为纯粹的灵光之属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410117
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410117,
					"content": "所谓「祭主」就是帮助耗尽力量的灵光之属回到花海的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410118
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410118,
					"content": "但自从人类的勇士不再履行应尽的职责，那些因为与污秽对抗而耗尽力量的花灵也再没办法再回到花海中来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410119
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410119,
					"content": "不过现在终于又再度见到了人类的勇士，想必散落在各处的「净光翎」也终于能够回到这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410120
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410120,
					"content": "只要向「甘露池」供奉，无论怎样的追忆都会被接纳，水与树也会降下恩赐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410121
					],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410121,
					"content": "这也是神明的慈悲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲多赫"
				},
				{
					"id": 733410108,
					"content": "虽然不知道在说什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733410109
					]
				},
				{
					"id": 733410109,
					"content": "我能感受到，你确实是与花灵建立了「劳{RUBY#[D]连结}帕」之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733410110
					],
					"speakerTitle": "菲多赫"
				}
			]
		}
	]
}