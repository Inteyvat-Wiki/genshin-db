					"塞琉斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "咦？这个人是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030102,
					"content": "难道是乔尔的父亲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "喔！你来了啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030105,
					"content": "我介绍一下，这位就是乔尔的父亲，乔瑟夫先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030106,
					"content": "爸爸！这位就是我和你说的旅行者，之前帮过我好多好多忙，这次还陪我一起堆雪人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708030107,
					"content": "乔尔都和我说了，哎呀，真是太感谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 708030108,
					"content": "团圆就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "是啊，这真是天大的好事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030111,
					"content": "帕拉德，这次你算是立了一个大功，干得不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708030112,
					"content": "又？帕拉德又做什么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030113,
					"content": "你们还记得，我之前说在雪山里看见了一个人影吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030114,
					"content": "那天你们陪我进了雪山，又帮我打倒了那些魔物之后，我又开始在周围搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030115,
					"content": "在搜索的时候，我一个不小心从山上滚了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030116,
					"content": "滚、滚了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030117,
					"content": "还好下面的雪层很厚，我没有受伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030118,
					"content": "正当我准备找回去的路时，突然听见旁边有响动，一个人突然钻了出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030119,
					"content": "我当时没有意识到他就是我要找的人，还以为是和我一样进山搜救的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030120,
					"content": "但聊了几句才发现，好多事情他都记不得了，连自己的名字都不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030121,
					"content": "当时我来不及多想，雪山上太冷了，我赶紧催他跟我一起翻山回营地，有什么事等回来再说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030122,
					"content": "回到营地，我们见到了乔尔，乔尔一见到他就愣住了，跟着大叫起来：「爸爸！」他就是在这个时候突然回忆起一些事情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030123,
					"content": "爸爸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708030124,
					"content": "乔尔，爸爸在，爸爸在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 708030125,
					"content": "乔瑟夫先生，真的想不起其他事情了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030126,
					"content": "《野猪公主》、还有雪山上你喂过的狐狸们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030127,
					"content": "很抱歉，我没有印象了。或许是因为脑袋受了外伤？我也不清楚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 708030128,
					"content": "当我醒来的时候，身上全是血。就连行李也丢了，没有能够证明身份的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 708030129,
					"content": "我只能爬进一个山洞，安顿下来慢慢养伤，在腿脚恢复点之后，靠打猎的本能才活了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 708030130,
					"content": "爸爸…我真的好担心你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 708030131,
					"content": "没事没事，乔尔不哭，爸爸这次哪里也不去了，就陪在你身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 708030132,
					"content": "乔瑟夫先生，那你接下来准备怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708030133,
					"content": "我…现在只想再和我的家人们多待一会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 708030134,
					"content": "能回来就好。这件事也算是有了个完美的结局了，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708030135,
					"content": "不过，帕拉德，在搜索的过程中居然能失足滚下山去，你的冒险能力还需要再加强啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708030136,
					"content": "回去协会，我得好好再给你补课了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708030137,
					"content": "欸？塞、塞琉斯会长…我不是都立功了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030138,
					"content": "走了！回协会去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 708030139,
					"content": "会长！你就饶了我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708030109,
					"content": "没事就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "大号的乔尔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}