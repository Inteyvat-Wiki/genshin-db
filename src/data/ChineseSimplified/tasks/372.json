			"dialogs": [
				{
					"id": 3720101,
					"content": "啊，你们是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "绿色的家伙"
				},
				{
					"id": 3720102,
					"content": "喔…呀！是那个时候，把特瓦林吓跑的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "绿色的家伙"
				},
				{
					"id": 3720103,
					"content": "特瓦林？谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720104,
					"content": "是风魔龙的真名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "唔…哦！我想起来了。可是一般人不都叫它「风魔龙」吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720107,
					"content": "为什么你要这样称呼它…难道你们很熟吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720108,
					"content": "你猜~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "绿色的家伙"
				},
				{
					"id": 3720109,
					"content": "#喂，{NICKNAME}，我感觉这个人怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720110,
					"content": "你好，打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "你好，一面之缘的异乡人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "绿色的家伙"
				},
				{
					"id": 3720113,
					"content": "我是吟游诗人，温迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720114,
					"content": "准确地说，是连续三届「蒙德城最受喜爱吟游诗人」的蝉联冠军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720115,
					"content": "你们找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720116,
					"content": "既然你都认出我们了，那就不用多解释了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720117,
					"content": "当然是关于风魔龙的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720118,
					"content": "嗯~~？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720119,
					"content": "喂！不用这样突然装失忆吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}，可以把那个拿出来给他看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720121,
					"content": "喔！这是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720122,
					"content": "咦？结晶被净化了？什么时候的事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720123,
					"content": "不知怎么就变成这样了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "这是特瓦林它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720126,
					"content": "这是风魔龙因为痛苦流出的眼泪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720127,
					"content": "眼…泪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720124,
					"content": "上一次看还是充满杂质的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "请问你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "你忘了吗？丽莎说的那些话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
