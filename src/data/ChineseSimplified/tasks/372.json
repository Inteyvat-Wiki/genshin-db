			"dialogs": [
				{
					"id": 3720501,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720502,
					"content": "你，真的拥有不可思议的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720503,
					"content": "像你这样的人，注定要登上吟游诗人们传唱的诗篇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720504,
					"content": "站在向阳处必能成就英雄，站在背阴处亦可引导灾祸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720505,
					"content": "啊…但我现在没有时间为你谱写新曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720506,
					"content": "特瓦林就算不被讨伐，生命力也会飞速流逝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720508,
					"content": "我也同情特瓦林。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "有什么我能帮忙的地方吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "作为骑士，我劝你和龙一起自首。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "他会在愤怒中把自己燃尽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720509,
					"content": "谢谢你的心意，也谢谢你帮我净化泪滴结晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720510,
					"content": "接下来就是我行动的时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720512,
					"content": "净化泪滴结晶已经是帮忙了，我很感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720513,
					"content": "但现在，我已经有了一个自己的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720515,
					"content": "哇，不要这么绝情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720516,
					"content": "自首就先不必了…我有另外的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720517,
					"content": "嗯？你的计划是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720518,
					"content": "看到龙的泪滴，我想起了一位故人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720519,
					"content": "故人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720520,
					"content": "嘿嘿，那我就先失陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720521,
					"content": "喂，你要去哪里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720522,
					"content": "——去「蒙德英雄的象征」。再见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3720524,
					"content": "是个奇怪的人，需要观察一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#唔…{NICKNAME}，你怎么看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720526,
					"content": "而且…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "对他来说，你也是奇怪的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720528,
					"content": "声音，有些熟悉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "而且？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
