			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "不要再打了！我投降！投降！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411302,
					"content": "你…你们是为了这些纸带来的吧？全都给你们！不要再打啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411303,
					"content": "愚人众指挥官老老实实地交出了所有的研究数据…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "怎么样，布罗意，这些就是全部了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411305,
					"content": "呃，这个…也许吧？嗯，没错，这应该就是全部了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411306,
					"content": "算了，就当我没问吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411307,
					"content": "你们的目的是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "对啊，老实交代！你们占领这些观测站，到底是想要做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411310,
					"content": "是…为了偷懒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411311,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411312,
					"content": "我的名字是马林诺夫斯基，第三十四独立侦察小队的队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411313,
					"content": "一开始，我们刚被调派到枫丹的时候，大家过得都很开心，也没有什么困难的任务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411315,
					"content": "呃…所以这跟你占领观测站有什么关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411316,
					"content": "没想到，就在几个月前，由于人事关系变动，至冬那边给我分派了一个叫舒米洛夫的家伙，作为我的新副官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411317,
					"content": "舒米洛夫？啊，是之前在桔桔薄饼站那边见到的那个小队长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411318,
					"content": "是啊！我实在是受不了那家伙了！但是又没有办法解决掉他，只好找个借口，主动外出执行任务，以便从他身边逃开——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411319,
					"content": "等等，你把我说糊涂了…那个叫舒米洛夫的家伙，是你的副官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411320,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411321,
					"content": "那他不就是你的下属嘛，上司为什么得听下属的话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411322,
					"content": "那个可恶的家伙，分明是我的下属，却总是摆出一副严肃的样子来，让其他人努力工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411323,
					"content": "他说的还都是无法反驳的正论——我总不能当着其他人的面，公开跟他说大家其实根本不想工作吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411324,
					"content": "正好，我看到附近有一些奇怪的塔，干脆就说我们要来这边调查，然后伪造了复律庭的信件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411325,
					"content": "哼，果然是你们伪造的！想想也是，复律庭怎么可能把水文监测站交给你们管理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411326,
					"content": "布罗意，你还有什么想问他的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411327,
					"content": "嗯…原来如此，您占据我们的观测站，只是想要偷懒…不，只是想要在这个喧嚣的世界中获得片刻的安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411328,
					"content": "所以呢？您觉得在这里休息的感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411329,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411330,
					"content": "呃…非常舒服？附近的风景也很漂亮，稍微午睡一下，就觉得心情都变得舒畅起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411331,
					"content": "对吧？尤其是一觉醒来，发现自己没有任何不得不做的紧急工作，也没有讨厌的人盯着您，只要安心享受午后的阳光与微风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411332,
					"content": "就像是从一场梦醒来，就进入了另外一场不必为任何事忧虑的梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411333,
					"content": "呵，这才是生活，先生！真遗憾，您应该还没有品尝过瓦萨里回廊限量贩售的红茶吧？要是您有机会的话——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411334,
					"content": "不不不，你们怎么突然开始聊这种莫名其妙的话题啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411335,
					"content": "好了，你这家伙，还是老老实实跟我们走一趟吧！是时候向枫丹科学院细数你的罪恶了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411336,
					"content": "噫呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411337,
					"content": "请、请等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411338,
					"content": "#{M#两位恩人}{F#两位恩人小姐}！这位先生实际上并没有对我们的水文研究造成任何破坏，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411339,
					"content": "从客观结果上来说，这位先生甚至还帮助我们收集了一部分数据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411340,
					"content": "更何况，他也只是不想工作，想要过上美好幸福清闲的生活而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411341,
					"content": "是、是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411342,
					"content": "不，就算你们两个说得这么理直气壮，这也不是什么值得骄傲的事情吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740411343,
					"content": "#拜托了，好心的{M#先生}{F#小姐}！看在科学的份上，就请您宽宏大量，放过他这一次吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740411344,
					"content": "虽然和科学好像没什么关系…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "谢…谢谢你，先生，还有两位！我发誓，我绝对绝对不会再做这种事了！从今往后，我一定会拼尽全力，只靠自己的能力偷懒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740411347,
					"content": "没错！最重要的就是那样的决心！",
					"roleType": "TALK_ROLE_NPC",
