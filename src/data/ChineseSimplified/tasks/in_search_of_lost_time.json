			"dialogs": [
				{
					"id": 740410101,
					"content": "布罗意，你说的那两座观测站的数据，我们已经拿到手啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410102,
					"content": "真的吗？！那可真是太好了！拜托了，快点让我看看——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410103,
					"content": "喏，给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "将之前收集到的纸带交给了布罗意…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "啊啊啊，没错，就是这个，就是这个！两位简直就是上天派来救我脱离苦海，重新过上美好幸福清闲生活的天使——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410109,
					"content": "也不至于夸张到这个地步吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410110,
					"content": "#总之，事不宜迟，好心的{M#先生}{F#小姐}，我这就去找主管申请中枢处理站的钥匙，请您稍微等我一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410111,
					"content": "唉，真是的…记得快一点呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410112,
					"content": "没过多久，布罗意兴奋地回来了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#{M#先生}{F#小姐}，我已经拿到钥匙了！接下来只要前往中枢处理站，完成对这些数据的整理，水文观测事业就可以顺利恢复了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410114,
					"content": "哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "考虑到「果果软糖站」和「桔桔薄饼站」的情况，中枢处理站说不定也有那些来自至冬的先生们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410117,
					"content": "所以…拜托了，请两位陪伴我一起去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410118,
					"content": "唔，你可别忘了给我们报酬呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410115,
					"content": "这种事情也需要我们跟着去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "我们的报酬呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "这个…请您不必担心，只要主管能批准恢复原本的水文研究，报酬一定不会少了您的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410106,
					"content": "嘿嘿，那就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
