			"dialogs": [
				{
					"id": 740410601,
					"content": "嗯，让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410602,
					"content": "如果能把先前收集到的数据汇总起来，应该能取得不错的成果…恢复水文监测的事情，指日可待，指日可待呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410603,
					"content": "哦哦，那真是太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410604,
					"content": "咦？总觉得好像缺了一部分数据…是错觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "布罗意"
				},
				{
					"id": 740410605,
					"content": "为什么说得这么不确定啦！这不是你自己负责的数据吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740410607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410608,
					"content": "…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "…呃，抱歉，走错房间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "马林诺夫斯基"
				},
				{
					"id": 740410610,
					"content": "愚人众指挥官，以一种与体型完全不符的敏捷，飞也似的溜走了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "等…等一下，刚才什么东西过去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410612,
					"content": "好快，比龙蜥还要快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "不不不，现在好像不是关心那种事情的时候啦！那家伙是愚人众吧！为什么会出现在这里啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}，我们快点追上去，好好问个清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740410613,
					"content": "还真是个灵活的家伙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
