			},
			"dialogs": [
				{
					"id": 221040101,
					"content": "真是烦人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "咦，抱歉，您是什么时候来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040104,
					"content": "是这样，周围的怪物越来越多了，虽然我丈夫老是说，他们不敢进客栈来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040105,
					"content": "但是只有他一个人的拳脚…我还是有点担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040106,
					"content": "您如果有空的话，能帮我去客栈周围看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "谢谢您愿意帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040113,
					"content": "总之，就拜托你了，报酬我也不会少您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040108,
					"content": "这家客栈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "唔…只是一家很普通的客栈啦，只不过开的地方偏了点，收的客人多了点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040111,
					"content": "不过流落野外的人，有个地方能吃饭睡觉总是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 221040112,
					"content": "我和我丈夫是这么想的，也就是这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "菲尔戈黛特"
				}
			]
		},
