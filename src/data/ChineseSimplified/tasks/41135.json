					"古德温"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "你们把那些魔物都清理掉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350302,
					"content": "已经清理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "感谢你，旅行者。这下那些魔物应该暂时形不成威胁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350304,
					"content": "你也快点回城里去吧，这种情况还让你在野外跑，真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350305,
					"content": "呃，然后…你回去城里的时候，能不能帮我留意一件事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350306,
					"content": "很简单的！就，就帮我留意一下就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350307,
					"content": "到底是什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "那个，你回去城里之后，能不能帮我去看看葛罗丽的情况？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350309,
					"content": "她应该一直待在城里，不会有什么危险，但我就是放心不下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350310,
					"content": "拜托你，帮我去看看她的情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350311,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "谢谢你，旅行者。对了，请你…别告诉葛罗丽我在这，就…就说我还在很远的地方执行任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350313,
					"content": "抱歉，拜托你了，请一定要对她这么说，我有我的苦衷，拜托你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德温"
				}
			]
		},
		{
