			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "大团长到底在哪啊…出了这么大的事，也不知道他收没收到消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350202,
					"content": "不过，就算他收到了消息，应该一时半会也赶不回来，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德温"
				}
			]
		},
		{
