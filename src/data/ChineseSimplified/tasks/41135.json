			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛罗丽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "希望古德温平安无事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350402,
					"content": "古德温拜托我来看看你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "古德温？您，您知道他在哪吗？我很久都没他的消息了，一直在担心他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350404,
					"content": "他还在很远的地方执行任务。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "是…这样吗？那好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350406,
					"content": "如果没有这些陨石，我都想要去骑士团问问他的下落了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350407,
					"content": "我一直待在城里，所以很安全。但他应该会去野外执行任务吧，如果全世界的各种地方都有陨石坠落的话，那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350408,
					"content": "唉，希望他平安无事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350409,
					"content": "他一定会平安无事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "谢谢您，这样的话就最好了。对了，如果您愿意的话，能帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350411,
					"content": "我找芙萝拉小姐买了一份蒲公英籽，本来想找人帮我去高处播撒…让风把它们带给古德温。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350412,
					"content": "但现在城里的情况您也看到了，一时间我也找不到人帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350413,
					"content": "现在正好您来了，您愿意帮我把这些蒲公英籽带给古德温吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350414,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "谢谢您，他现在一定在很远的地方吧，毕竟他是跟着那位大团长去执行任务了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "葛罗丽"
				},
				{
					"id": 411350416,
					"content": "请您把这份蒲公英籽带给他，告诉他我很好，然后…让他也注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛罗丽"
				}
			]
		},
