			"trigger": {
				"objectNames": [
					"古德温"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "不知道葛罗丽怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "你…是旅行者啊，现在野外很危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350104,
					"content": "如果你想找个安全的地方避难，就快点回蒙德城吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350105,
					"content": "你不进城吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "我…我暂时，就不回去了，毕竟我也是一名西风骑士…这个时候可不能退缩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350107,
					"content": "虽然因为一些原因，我不能回蒙德城里帮忙，但是我也能在野外做些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350108,
					"content": "陨石落下了之后，很多魔物被陨石影响，变得格外凶暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350109,
					"content": "如果放着不管的话，一定会酿成大祸，我正准备去把它们给清理掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350110,
					"content": "你一个人可以吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "呃，虽然那些怪物的数量有些多…但只要小心应对，我应该没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350112,
					"content": "但我一个人去清理，不知道要清理到什么时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350113,
					"content": "旅行者，如果你愿意的话，能帮我去清理一些怪物的营地吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350114,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "那就拜托你了，实在是帮大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350116,
					"content": "为什么不去找骑士团求助？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "找骑士团求助…呃，这个嘛，真的不行…我有我自己的苦衷，你就别追问了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "古德温"
				},
				{
					"id": 411350118,
					"content": "请你帮帮我吧，清理掉那些怪物营地，也算是给骑士团帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德温"
				}
			]
		},
