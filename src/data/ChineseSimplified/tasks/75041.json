				]
			},
			"dialogs": [
				{
					"id": 750410301,
					"content": "你们怎么还逗留在此处呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410302
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750410302,
					"content": "冒险团的领队，那位戴着鹰隼战面的英雄都已经…我们已经无力抵挡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410303
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750410303,
					"content": "快走吧，快走吧，这里是被诅咒之地啊，勇士，不是人该涉足的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因"
				}
			]
		},
