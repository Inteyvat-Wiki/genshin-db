						],
						"pointId": 361100039
					},
					{
						"sceneId": 3,
						"position": [
							5225.431,
							340.113,
							9401.865
						],
						"pointId": 361100040
					},
					{
						"sceneId": 3,
						"position": [
							5228.457,
							340.132,
							9401.264
						],
						"pointId": 361100049
					}
				]
			},
			"dialogs": [
				{
					"id": 766720202,
					"content": "白灵蛋卷、烟熏鱼排、浆果煎肉还有夜守暖汤…这么多菜，我都要吃不完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720203,
					"content": "嗯…我是按照给执灯士们准备晚餐的份量做的，对三个人来说可能确实有点多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720204
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720204,
					"content": "不过没关系，你们慢慢吃。我一会还要去见老爹一趟，你们待到晚上都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720205,
						766720206
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720205,
					"content": "没想到你厨艺这么好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720208
					]
				},
				{
					"id": 766720208,
					"content": "其实在当队长以前，我可是经常给大家做饭的，只是最近都没有这样的空闲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720209
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720209,
					"content": "皮拉米达里的人来自天南海北，口味也各有不同。所以各种风味的料理都得掌握一点，才能让每一个人都尽兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720210
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720210,
					"content": "不过我不太知道你们的喜好，所以这次各种风格的都做了一点。有什么合你们口味的吗？请一定要告诉我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720211,
						766720214
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720211,
					"content": "派蒙爱吃的我也爱吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720212
					]
				},
				{
					"id": 766720212,
					"content": "什么意思啦！我先说，那盘浆果煎肉已经被我看中了，你可不要跟我抢呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720213,
					"content": "哈哈，你们不用抢，我再多做点就好啦。怎么能让我的队员饿肚子呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720216,
					"content": "不管大家嘴上怎么说，吃到爱吃的东西的时候，脸上幸福的表情可是不会骗人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720217
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720217,
					"content": "对我来说，没有比看到大家幸福的笑容更开心的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720218
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720218,
					"content": "只要能让大家露出笑容，无论是履行执灯人的职责还是端上美味的料理，我都愿意去做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720219
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720219,
					"content": "在你们看来这些可能都是微不足道的小事吧，但这的确就是我最真实的愿望了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720220,
						766720221
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720220,
					"content": "不要妄自菲薄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720222,
					"content": "对呀！你为大家做了这么多，大家一定都很感谢你的。要是看你老是说自己不好，他们说不定还会生气呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720223,
					"content": "#至少在他们之前，我跟{NICKNAME}就会生气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720224,
					"content": "嘿嘿，谢谢你们。好了，与饭桌无关的话题就不说啦，请好好享用料理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720221,
					"content": "你能做到这些已经很厉害了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720214,
					"content": "是你做的我都爱吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720215
					]
				},
				{
					"id": 766720215,
					"content": "恭维的话就不必啦。你这样说，我就更想要做出能最合你心意的料理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766720206,
					"content": "派蒙肯定能吃完。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720207
					]
				},
				{
					"id": 766720207,
					"content": "那是当然啦，别人的心意就是要好好吃完才对吧！不过没想到叶洛亚你的厨艺这么好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720208
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}