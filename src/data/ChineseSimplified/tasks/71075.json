			"dialogs": [
				{
					"id": 710750101,
					"content": "嘿，就是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750102,
					"content": "那个什么二哥，翻了半天翻不到，你这个对这个地方熟悉的家伙总能找到吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750103,
					"content": "找不到？只要等到一个能找到的人，逼你们把找到的东西交出来不就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750104,
					"content": "我江湖人称「小轻策」，区区层岩巨渊这儿一群挖矿的摆不平，还怎么在外面混？来，把东西给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750105,
					"content": "千岩军的宝藏，我们盗宝团就收下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750106,
					"content": "无论你想要什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "你说没有就没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750109,
					"content": "…哼，我还以为你们每天跑上跑下，身子板看上去能结实点呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750110,
					"content": "你选吧，是被我一拳撂倒搜个全身，还是自己亲手把「庇佑之冠」呈上来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750111,
					"content": "我觉得你不会想和我打的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "呦，语气很大嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750113,
					"content": "我看你这是敬酒不吃吃罚酒了！",
