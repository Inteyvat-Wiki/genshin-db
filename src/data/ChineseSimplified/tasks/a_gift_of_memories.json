				]
			},
			"dialogs": [
				{
					"id": 765000101,
					"content": "#{NICKNAME}！快过来这边！给你看一个超级棒的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000102,
					"content": "当当——！你看，这是我费了好大劲，才从这个乱糟糟的市集里淘到的好宝贝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000103,
						765000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000103,
					"content": "这留影机…看起来很有年代感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000106
					]
				},
				{
					"id": 765000106,
					"content": "听那个神神秘秘的卖家说，这可是几十年前，枫丹那位超级有名的摄影大师——皮埃尔·勒布朗先生用过的留影机哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000107,
					"content": "据说啊，他当年用这台留影机拍摄的画片，每一张都很受欢迎，时不时就会登上《蒸汽鸟报》的头条呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000108,
					"content": "#如果{NICKNAME}也用上这么厉害的相机，说不定也能拍出传世名作呢！搞不好还能卖出天价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000109,
						765000112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000109,
					"content": "这相机…应该不便宜吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000110
					]
				},
				{
					"id": 765000110,
					"content": "欸嘿嘿，还好啦！派蒙也是有悄悄攒下来一点「应急储备金」的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000111,
					"content": "#只要{NICKNAME}喜欢，这点摩拉不算什么啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000116,
					"content": "谢谢你，派蒙。我很喜欢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000118,
					"content": "太好了，你喜欢就好！刚好我们来到了新的国家，这里肯定有很多好玩的好看的，把这些通通都拍下来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000119,
					"content": "新的留影册，我也早就替你准备好了。是不是超级贴心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000120,
					"content": "好啦好啦， 我们一起去发掘那些有意思的地方吧！出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000117,
					"content": "我会努力用它拍出好画片的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000112,
					"content": "派蒙没有遇上无良商人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000113
					]
				},
				{
					"id": 765000113,
					"content": "放心啦，为了确保万无一失，我已经拜托一位非常可靠的工程师帮忙鉴定过了，这就是勒布朗大师当年使用的那个型号，错不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000114,
					"content": "而且，工程师拆开机器的时候，还发现内部有一个小小的、刻着他名字缩写的印记呢。这可是独一无二的证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000115,
					"content": "哼哼，作为你的向导，我还是很靠得住的。关键时刻绝不掉链子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765000104,
					"content": "派蒙打算做起古董生意了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000105
					]
				},
				{
					"id": 765000105,
					"content": "才不是呢！这是我特意为你准备的惊喜礼物!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000106
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}