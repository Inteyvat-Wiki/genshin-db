				]
			},
			"dialogs": [
				{
					"id": 140300201,
					"content": "哎？是那维莱特和莱欧斯利！他们怎么也在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300202,
					"content": "#{NICKNAME}，派蒙，很高兴见到你们，愿一切都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300203
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300203,
					"content": "一个大新闻，最高审判官因要事出访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300204
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300204,
					"content": "嗯？大家会对这样的新闻感兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300205
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300205,
					"content": "不会吗？毕竟是「要事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300206
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300206,
					"content": "哦…确实如此。在关心的人需要情感支撑时出现在适当的时间、地点，是非常必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300256
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300256,
					"content": "自从收到逐影庭的报告，我就觉得我必须来一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300207
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300207,
					"content": "请看，这就是那维莱特关心大家的方式。因此我们出现在了这里——来陪同护士长拜访她那位已故的老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300208
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300208,
					"content": "这么说，希格雯准备祭奠的故人就是她的老师？那个「巫婆」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300209,
					"content": "啊，对不起对不起，我不是故意这么说的，只是之前一直听希格雯这样称呼她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300210,
					"content": "我猜，在她看来这种说法并无冒犯，派蒙不用担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300211
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300211,
					"content": "嗯，在希格雯看来，这个称呼可能很亲切吧。我曾很多次听希格雯讲起这位医生，她为人十分宽厚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300212
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300212,
					"content": "在那个大部分人类都排斥美露莘的时代，只有她愿意当希格雯的老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300213
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300213,
					"content": "哇，那维莱特和莱欧斯利果然都很贴心呢！这算是关心职场上的后辈吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300214,
					"content": "职场上的后辈？也就是这位先生的后辈吧，我可不敢当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300215
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300215,
					"content": "护士长早在几百年前就已进入梅洛彼得堡服刑，并且在刑期结束后留了下来，成为了梅洛彼得堡管理体系中相当重要的成员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300216
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300216,
					"content": "严格来说，梅洛彼得堡的绝大部分人都是护士长的后辈，自然也包括我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300217
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300217,
					"content": "服刑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300218,
					"content": "希格雯犯过罪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300219
					]
				},
				{
					"id": 140300219,
					"content": "是的，早在我任职最高审判官之前，枫丹就有着一条极为古老的律法，禁止任何尝试将其他物种转化为人类的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300220
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300220,
					"content": "最初我和大部分研究员一样，认为这只是一条用来规范科学伦理的律法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300221
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300221,
					"content": "现在想来，更像是厄歌莉娅为了让自己的子民能够在不谙真相的同时享受更为纯粹、幸福的人生，才制定了这重保险吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300222
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300222,
					"content": "啊，无知是福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300223
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140300223,
					"content": "希格雯获得人类外貌的行为切实地违反了这条律法，即便她有自己的苦衷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300224
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300224,
					"content": "当年到底发生了什么？可以讲给我们听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300225,
					"content": "没关系，希格雯并不排斥让她的朋友知道这件往事，当年的她就是主动找到我并向我坦白了一切…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300226
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300226,
					"content": "即便自己女儿病情严重也要把你拒之门外吗？这帮顽固的家伙…人心里的成见，也是我治不好的一种病啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300227
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300227,
					"content": "唉…可惜我现在没力气赶过去，真是一个可笑的老巫婆，想要拯救全枫丹的人，到头来却连眼前的病人都救不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300228
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300228,
					"content": "老师，您到底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300229
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300229,
					"content": "我发现了一种怪病，那可能是全枫丹人都患有的一种怪病。没有目击者，没有证据，不会有人相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300230
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300230,
					"content": "我只能拿自己作为实验对象寻找治疗的方法，但到头来似乎撞上了一条死路，还把自己折腾成了这个样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300231
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300231,
					"content": "那…我先想办法治好老师，让老师去治好她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300232
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300232,
					"content": "不用了…我的情况我明白，你做不了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300233
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300233,
					"content": "老师…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300234
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300234,
					"content": "就像我之前说过的那样，一名医生最大的责任是治好自己能治好的病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300235
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300235,
					"content": "我明白了…但是，他们根本不信任我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300236
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300236,
					"content": "咳咳…说起来，那个女孩儿是你的第一个病人，你真的很想治好她，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300237
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300237,
					"content": "嗯，我愿意做任何事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300238
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300238,
					"content": "即便是触犯律法，背负刑罚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300239
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300239,
					"content": "…只要不会伤害到别人，我愿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300240
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300240,
					"content": "哈哈，你果然是我带出来的学生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300241
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300241,
					"content": "那就让我再赌一把，把实验进行到底吧。你先离开这里，两个小时后再来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300242
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300242,
					"content": "如果奇迹发生，那我已经找到了拯救所有枫丹人的办法，也有力气去帮你治好那个女孩儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300243
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300243,
					"content": "如果奇迹没有发生…那我治不好的病就又多了一种，不要寻找我的下落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300244
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300244,
					"content": "我会给你留下一份礼物，那是我在研究这种怪病时偶然得到的一个发现。这个发现意义不大，但至少可以帮你救治眼前的病人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300245
					],
					"speakerTitle": "「巫婆」"
				},
				{
					"id": 140300245,
					"content": "希格雯返回后，奇迹并没有发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300246
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300246,
					"content": "她在桌上找到了一瓶药水和一张便签，按照指示使用那瓶药水后，她变成了现在的模样，也触犯了枫丹的律法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300247
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300247,
					"content": "我确认了既定的事实，对她做出了判决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300248
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300248,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300249,
					"content": "老师牺牲了自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300251
					]
				},
				{
					"id": 140300250,
					"content": "留下了药水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300251
					]
				},
				{
					"id": 140300251,
					"content": "这一点，希格雯恐怕是直到枫丹人溶解的真相被揭露后才明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300252
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300252,
					"content": "后来了解到这一切的我，感到十分惋惜…我在维护律法公正的同时，也必须接受它的无情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300253
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300253,
					"content": "幸好，经过反复确认，根据枫丹的律法，希格雯不会因为这部分隐藏的真相而背负额外的刑期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300254
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140300254,
					"content": "真不知道希格雯是什么感受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300255,
					"content": "既然希格雯主动邀请你们来到这里，就说明她准备好与你们谈起这些过往了，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那维莱特"
				}
			]
		},
