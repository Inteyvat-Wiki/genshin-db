				"points": []
			},
			"dialogs": [
				{
					"id": 140305101,
					"content": "有关昨日那起越狱案，我谨代表逐影庭再一次感谢梅洛彼得堡提供的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305102
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140305102,
					"content": "#主要是靠护士长，以及{NICKNAME}和派蒙的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305103
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140305103,
					"content": "看希格雯精神不错，最近的工作应该不太繁重吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305104
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140305104,
					"content": "嗯。虽然长期驻留在梅洛彼得堡的医务人员依然只有她一位，但有医学知识、愿意提供帮助的人一直有不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305105
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140305105,
					"content": "听你这样说我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305106
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140305106,
					"content": "哈哈，你关心护士长的样子看起来就像她真正的家长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305107
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140305107,
					"content": "不瞒你说，我一直都这样定义自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305108
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140305108,
					"content": "这就让你的年龄有了些实感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305109
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140305109,
					"content": "嗯。其实，我时常会忘记我年纪比你大很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305110
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140305110,
					"content": "说起来，你在干这份工作之前都在做些什么呢？每天泡在海里，从东边游到西边，再从南边游到北边？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305111
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140305111,
					"content": "嗯…嗯，有时也从上边游到下边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305112
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140305112,
					"content": "喔，真厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305113
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140305113,
					"content": "…抱歉，刚刚是开玩笑的，请不要当真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140305114
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 140305114,
					"content": "呵，没关系，不影响我想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				}
			]
		},
