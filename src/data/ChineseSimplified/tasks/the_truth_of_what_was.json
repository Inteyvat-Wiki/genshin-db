			"dialogs": [
				{
					"id": 140300301,
					"content": "#{NICKNAME}，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300302
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300302,
					"content": "我要祭奠的故人就是我的老师哦，她没留下遗体，只有一座衣冠冢，不过现在已经在水下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300303
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300303,
					"content": "希格雯…那个提供魔药的巫婆就是你的老师吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300304,
					"content": "嗯，看来那维莱特先生跟你们讲了很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300305
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300305,
					"content": "知道真相后，心情一定很复杂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300306,
					"content": "嗯…其实我知道那一晚具体发生的事情之后，只是觉得那果然是老师会做的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300307
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300307,
					"content": "甚至连牺牲自己的事也要瞒着你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300308,
					"content": "只要确定一种药对病情有帮助，哪怕用欺骗的手段也要让孩子喝下去，老师她本来就是这样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300309,
						140300310
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300309,
					"content": "真是一位伟大的医生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300311
					]
				},
				{
					"id": 140300311,
					"content": "好吧…那最后希格雯为什么要去自首呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300312,
					"content": "因为触犯了律法就要接受惩罚哦，老师做出了她的选择，我也做出了我的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300313
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300313,
					"content": "我知道，只是…之前那个波顿质问希格雯的时候，我很气愤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300314,
					"content": "我觉得希格雯才不会跟他是一种人呢，听那维莱特讲完真相后，我更这么觉得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300315,
					"content": "但是一想到最后希格雯也还是一样被判了罪，进了监狱，就感觉很不好受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300316,
					"content": "派蒙，其实恰恰相反哦。如果没有那段服刑的经历，我面对波顿的质问或许就不会那么坚定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300317
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300317,
					"content": "为什么希格雯会这样认为？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300318,
					"content": "#派蒙和{NICKNAME}都很好奇吧，我可以讲给你们听哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300319
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300319,
					"content": "嗯嗯，这才是我想要的结局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300320,
					"content": "听完波顿的坦白后，我一直想告诉他，是波顿还是拉瓦特，其实并没有那么重要。但还是太晚了，他掌心的温度已经消失了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300321
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300321,
					"content": "我尝试过治好他，可惜他的症结不在脸上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300322,
						140300323
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300322,
					"content": "不值得为他感到遗憾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300324
					]
				},
				{
					"id": 140300324,
					"content": "#我明白的，{NICKNAME}，我知道你和派蒙想开导我，谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300325
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300325,
					"content": "这不算什么啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300326,
					"content": "另外，邀请你们来这里还有一件事，我还没有把承诺好的报酬交给你们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300327
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300327,
					"content": "逐影庭特批让我额外调制几瓶那种药水，用来给那些被掉包的犯人恢复容貌。我多调制了一瓶，专门留给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300328
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300328,
					"content": "哎？这个我们用不到，不应该拿去销毁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300329,
					"content": "#那也应该是我先交给你们，再由你们决定送去销毁哦。{NICKNAME}和派蒙出了很多力，我怎么能不兑现诺言呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300330
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300330,
					"content": "确实是这个道理，但现在我可不想用这种东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300331,
					"content": "不过，这应该是提瓦特仅剩的一瓶了吧？总感觉不能直接送去销毁，得想办法给它一些特殊的意义呢…嗯，有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300332,
					"content": "美露莘的体质没有因为那场大洪水发生变化，肯定还可以永久享受这种药水的效果，那希格雯有想过重新变回原本的样子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300333,
					"content": "毕竟，对于美露莘来说，果然还是美露莘的样子更可爱吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300334,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300335
					]
				},
				{
					"id": 140300335,
					"content": "派蒙，是人类还是美露莘，有那么重要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300336
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300336,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300337,
					"content": "我在想什么呢，希格雯早就知道答案了才对，那就在这里把它销毁吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140300338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140300338,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				},
				{
					"id": 140300323,
					"content": "他确实有些可惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300324
					]
				},
				{
					"id": 140300310,
					"content": "真是一位古怪的医生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140300311
					]
				}
			]
		},
