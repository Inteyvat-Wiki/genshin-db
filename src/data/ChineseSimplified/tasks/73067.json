					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰沙恭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "你就是兰沙恭吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670402,
					"content": "呜呜…兰沙恭确实是我的名字，呜哇，别突然靠那么近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670403,
					"content": "虽然很感谢两位将我救出险境，但、但是兰沙恭还是请求两位能保持一定的距离…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670404,
					"content": "这样能让兰沙恭，稍微安心一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670405,
					"content": "什么呀，刚刚明明就是我们把你救出来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670406,
					"content": "啊啊，对不起对不起，是兰沙恭提出的要求太过分了…才让你生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670407,
					"content": "可是兰沙恭被围困在此，惊魂未定，呜呜，就算有失礼之处，还希望两位能够原谅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670408,
					"content": "没关系啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670409,
					"content": "那就好那就好，不知兰沙恭能知道两位的名字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670410,
					"content": "我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670411,
					"content": "#我是{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#呜呜，金色的那菈{NICKNAME}和派蒙，那个…为何会知道兰沙恭的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670413,
					"content": "我们看了屋子里的笔记…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#金发的那菈{NICKNAME}，看到了笔记，便来寻找兰沙恭的踪迹，又帮兰沙恭解围，真是心善又厉害的好那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670415,
					"content": "呜呜…如果兰沙恭没有失去「勇气」，就不会像刚才那样被困住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670416,
					"content": "对哦，之前在笔记里也看到了，兰沙恭，你说自己失去了「勇气」到底是怎么一回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670417,
					"content": "这是很久以前的故事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670418,
					"content": "在许多月亮之前，兰沙恭就像现在这样，是没有「勇气」的兰沙恭…那时，即使是树枝断裂的声音，也会让兰沙恭夜不能寐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670419,
					"content": "但是，即使是胆小的兰沙恭，也有一个愿意陪伴兰沙恭的那菈朋友，虽然那菈朋友不是伟大的那菈法留纳，但也是很好的那菈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670420,
					"content": "他从不会因为兰沙恭胆小而故意捉弄兰沙恭，在兰沙恭觉得害怕的时候，会主动握起兰沙恭的手…是兰沙恭永不会忘记的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670421,
					"content": "可有一天，那个那菈被「毛毛脸面具魔王」抓走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670422,
					"content": "等等，所以那个「毛毛脸面具魔王」是什么呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670423,
					"content": "「毛毛脸面具魔王」，就是毛毛脸，戴着面具的，魔王呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670424,
					"content": "…是、是哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670425,
					"content": "派蒙知道是什么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "能知道才奇怪啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670429,
					"content": "总之，就是那个「毛毛脸面具魔王」抓走了兰沙恭的朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670430,
					"content": "…「毛毛脸面具魔王」，十分阴险狡猾，只是想想，兰沙恭全身就开始颤抖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670431,
					"content": "…呜呜，那时兰沙恭的那菈朋友被抓走，十分害怕，兰沙恭虽然害怕被「毛毛脸面具魔王」打，但更害怕再也见不到那菈朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670432,
					"content": "所以兰沙恭很努力的，闭着眼睛！咬着牙！用手拍拍！救出了兰沙恭的那菈朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670433,
					"content": "那之后呀，那菈朋友就用花做了「勇气的护身符」，对兰沙恭说，「兰沙恭是有勇气的好兰那罗！不是胆小的兰那罗！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670434,
					"content": "兰沙恭因此获得了「勇气」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670435,
					"content": "咦，可是按这样来说，你的「闭着眼睛！咬着牙！用手拍拍！」不就是很有勇气的行为了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670436,
					"content": "不是的不是的，兰沙恭是那之后才从那菈朋友那里，获得了「勇气」的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670437,
					"content": "可是，你救你的朋友本身，就很勇敢了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670438,
					"content": "没有没有，在救那菈朋友的时候，兰沙恭可害怕了，手软软脚软软，可是获得了「勇气」后，兰沙恭就再没有手软软脚软软了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670439,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670440,
					"content": "护身符只是契机！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#呜呜…那菈{NICKNAME}的话好复杂，兰沙恭只知道，「勇气护身符」在，兰沙恭就有「勇气」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670443,
					"content": "之前兰沙恭的「勇气」被偷走，所以就想来「毛毛脸面具魔王」的洞穴偷偷寻找，希望能寻到兰沙恭的「勇气」的踪迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670444,
					"content": "结果就被几只史莱姆围困在了洞穴里呢…幸好没被那个什么「毛毛脸面具魔王」发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670445,
					"content": "#啊，说到这个，{NICKNAME}，还记得我们之前从丘丘人那里捡到的…不会就是兰沙恭的护身符吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670446,
					"content": "兰沙恭，我们说不定捡到你的「勇气」啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670447,
					"content": "#真的吗！那菈{NICKNAME}和派蒙，真的捡到兰沙恭的「勇气」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670441,
					"content": "勇气本就存在兰沙恭心中！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "是兰那罗风格的回答呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "是啊，完全猜不到那个「毛毛脸面具魔王」是什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "派蒙"
				}
			]
		},
