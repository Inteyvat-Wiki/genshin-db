			"dialogs": [
				{
					"id": 730670701,
					"content": "虽然隐约猜到了…不过「毛毛脸面具魔王」真的就是丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670702,
					"content": "丘丘人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670703,
					"content": "嗯，「毛毛脸面具魔王」是丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670704,
					"content": "「球球人」都是「毛毛脸面具魔王」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670705,
					"content": "不是不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670706,
					"content": "兰沙恭这么理解就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "嗯，兰沙恭了解了。",
