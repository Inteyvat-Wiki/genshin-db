						730670602
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670602,
					"content": "这就是兰沙恭的「勇气护身符」，离开了兰沙恭身边几天，花的颜色也有点黯淡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670603,
					"content": "但是没有关系，兰沙恭以后会好好保护它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670604,
					"content": "「兰沙恭是有勇气的好兰那罗！不是胆小的兰那罗！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670605,
					"content": "#真是感谢你啊，那菈{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670606,
					"content": "现在的兰沙恭已经是寻回「勇气」的兰沙恭，再没有什么能够阻拦我。区区「毛毛脸面具魔王」，不过是兰沙恭的手下败将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670607,
					"content": "（呜哇，感觉说话的语气都和之前不一样了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670608,
					"content": "#「毛毛脸面具魔王」作恶多端，那菈{NICKNAME}和派蒙，请随我来，有二位的帮助，一定能够解决掉它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670609,
					"content": "兰沙恭能感觉到，今天…就是去它的魔窟，了结它的日子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "兰沙恭"
				},
				{
					"id": 730670610,
					"content": "#哦哦，{NICKNAME}，我们也一起去吧…看看那个「毛毛脸面具魔王」到底是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
