				"points": []
			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "咦，这些丘丘人好像掉了一个奇怪的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670102,
					"content": "看上去好像是用花朵做的，奇怪，明明只是普通的花，已经摘下来很久了…却没有坏掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670103,
					"content": "上面能感受到相当多的草元素…而且还丢在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670104,
					"content": "肯定是兰那罗的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "嗯，一定是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670108,
					"content": "唔，这个花朵做的东西上有那么多的草元素，就连在丘丘人手里都没有枯萎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670109,
					"content": "也许是一直随身携带着…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "嗯，我们还是尽快把这个东西还给兰那罗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670112,
					"content": "#我们进屋子看看，{NICKNAME}，说不定那个丢了东西的冒失鬼正在房子里唉声叹气呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730670110,
					"content": "也许是很宝贵的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "是草元素丘丘人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "那是什么啦，怎么想都是住在这里的兰那罗掉的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
