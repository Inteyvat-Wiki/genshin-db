					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "先生，值得一提的是，算上今天，我们已经连续吃了整整六天的萝卜时蔬汤了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980102,
					"content": "除却费用危机之外，我们的肠胃问题也已经不可忽视…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980103,
					"content": "你说得对！非常对，亲爱的路通，你总是这么敏锐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980104,
					"content": "我们也许正是因为肠胃问题，才不能准确地判断出这道菜的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980105,
					"content": "我们得去找个旁证！路通，得去找个第三方旁证才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980106,
					"content": "谢谢夸奖，先生。但我的重点其实并不在此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980107,
					"content": "请问，您们在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "啊…哈！咱们的旁证者来了，太棒了！甚至还不止一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980110,
					"content": "欸？什、什么？旁证者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980111,
					"content": "你说我们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "没错，您吃过萝卜时蔬汤吗？熟悉它的味道吗？明白它的做法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980113,
					"content": "先生，你得先说清楚事情的原委…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980114,
					"content": "#嗯…吃过！熟悉！{NICKNAME}会做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980115,
					"content": "派蒙，你得先听清楚事情的原委…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "还是由我来陈述一下我们的委托吧…希望您愿意接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980117,
					"content": "我是路通，这位是我的老板，来自枫丹的加尔恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980118,
					"content": "加尔恰先生正在研究一种…嗯…被他称为「推数机」的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980119,
					"content": "具体来说，就是一种能够…帮人计算各种数值的工具，我这么概括对吗，先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980120,
					"content": "非常准确，亲爱的路通，「推数机」的功能就是这么简洁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980121,
					"content": "对，要简洁…必须要简洁，那个转化符太复杂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980122,
					"content": "但是，这些和萝卜时蔬汤又有什么关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980123,
					"content": "这部分就由加尔恰先生来说明吧，先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980124,
					"content": "可是要怎么简化…喔！是的，没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980125,
					"content": "呃…我们得从简单的地方开始说，你们知道「公式」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980126,
					"content": "公式？嗯…没听说过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980127,
					"content": "不太了解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "好吧…没关系，你们就把公式理解成…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980129,
					"content": "一个…一个用于表达各个量之间的一定关系的式子，有一定的普遍应用性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980130,
					"content": "欸？欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980131,
					"content": "听起来很厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "简单来说，在「推数机」的辅助下，我们正在尝试写出「萝卜时蔬汤」的菜谱公式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980133,
					"content": "加尔恰先生相信，只要找到了正确的公式，我们就能将「萝卜时蔬汤」的做法转写为一种…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980134,
					"content": "一种「通用式流程」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980135,
					"content": "一种…「傻瓜式流程」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980136,
					"content": "只要按照这种流程操作，无论是谁都能烹饪出美味的「萝卜时蔬汤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980137,
					"content": "听起来好麻烦…就不能直接找人请教做菜方法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980138,
					"content": "这种方法…实在是太过考验人的天赋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980139,
					"content": "像我和加尔恰先生这种对烹饪毫无天赋的人，就算是厨师教得再认真，我们也完全无法学到精髓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980140,
					"content": "这一点，我相信这家客栈的言笑先生有着十分深刻的体会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980141,
					"content": "你们需要我们帮忙算「公式」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "当然不会，我绝不会拿这件事来为难您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980145,
					"content": "准确地来说，我们是希望您为我们提供一个「第三方旁证」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980146,
					"content": "通俗地来说，就是请您来尝一尝加尔恰先生按照公式制作出来的「萝卜时蔬汤」，给出您的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980147,
					"content": "总之！就是帮你们尝尝好吃的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980148,
					"content": "你总结得也太简单了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "没关系啦，按照「公式」做出来的「萝卜时蔬汤」，我还从来没吃过呢，我们就去尝尝看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710980150,
					"content": "那么，这件事就这样说定了，我刚向言笑先生预约了他的厨房，我们先上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980151,
					"content": "加尔恰先生？您在听吗？我们还是按照之前的步骤来实验吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "路通"
				},
				{
					"id": 710980152,
					"content": "呃？噢！抱歉，我准是又走神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980153,
					"content": "那些参数在我脑子里打转，就是不听我使唤…没错，还是按照之前的三道步骤来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980143,
					"content": "你们需要我们教你们做菜吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "呃…也不完全是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 710980108,
					"content": "关于萝卜时蔬汤的「制作公式」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109804",
							"3"
						],
						"stepId": 7109804,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "为什么会有人连萝卜时蔬汤都学不会啊！",
					"roleType": "TALK_ROLE_NPC",
