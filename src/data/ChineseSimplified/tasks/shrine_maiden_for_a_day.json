					"nextDialogs": [
						191451602
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 191451602,
					"content": "关于婆婆的眼睛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "你们也注意到了吗？是啊，婆婆看东西不太清楚，每次上山来我们都有些担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 191451604,
					"content": "不过她总是不愿意多麻烦我们，说自己走了这么多年，一个人也能上下山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 191451605,
					"content": "还好山道上也有神社的巫女，多少也能照看着些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 191451606,
					"content": "雷神保佑，祝婆婆和她的孙女都能一路平安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻城萤美"
				}
