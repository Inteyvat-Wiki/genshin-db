					"id": 730741818,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741819
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730741819,
					"content": "#不过还是先结出惟耶之实再说吧！因为，要帮助那菈{NICKNAME}、派蒙和兰拉娜的朋友才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741820
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730741820,
					"content": "嗯！兰罗摩接下来也要去找觉树之堂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730741821,
					"content": "对！我们一定会再见的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741822
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730741822,
					"content": "要注意安全哦，兰罗摩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730741823,
					"content": "#你们也是，那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730741814,
					"content": "觉王的梦之树让梦跑不掉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
