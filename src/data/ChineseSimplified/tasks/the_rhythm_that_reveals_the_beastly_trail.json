				"points": []
			},
			"dialogs": [
				{
					"id": 730740101,
					"content": "#你好，那菈{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740102
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730740102,
					"content": "又见面啦，兰罗摩！还有这个兰那罗是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740103,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740104
					],
					"speakerTitle": "兰陀娑"
				},
				{
					"id": 730740104,
					"content": "嗯。兰陀娑是「采歌者」，经常去收集各种各样的歌曲。他不喜欢说话，因为说话不如唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740105
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730740105,
					"content": "唔…虽然也不是不能理解…言归正传，这里就是觉树之堂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740106,
					"content": "虽然没有树，倒是有不少玫瑰…在半空中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740107,
					"content": "啊。不是的，但这也是很厉害的发现。在这里，沉睡着很多年没有兰那罗找到的歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740108
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730740108,
					"content": "兰那罗的采歌者，会一直一直追求歌的美丽。所以，在时间的最后，会把只属于自己的歌留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740109,
						730740111
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730740109,
					"content": "那和觉树之堂有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740110
					]
				},
				{
					"id": 730740110,
					"content": "嗯！这边似乎是兰雅玛留下的歌。如果是这样的话，附近应该就有莎兰树了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740113
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730740113,
					"content": "莎兰树…之前兰拉迦好像说过，就是那个什么来着，我看看森林书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740114,
					"content": "#莎兰树！就是能结出恒素果的莎兰树！我们也帮忙吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740115,
					"content": "谢谢你们！在那些玫瑰当中，隐藏着歌曲。唔…但是，我和兰耶娑看了好久好久，都没找到。那些玫瑰，也不和我们说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740116
					],
					"speakerTitle": "兰罗摩"
				},
				{
					"id": 730740116,
					"content": "#原来如此…{NICKNAME}，我们也调查一下看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740117,
						730740118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740117,
					"content": "既然是为了帮助拉娜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740119,
					"content": "嗯！找东西嘛，我们很擅长的，对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730740118,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740111,
					"content": "祝你们好运。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740112
					]
				},
				{
					"id": 730740112,
					"content": "#嗯！谢谢那菈{NICKNAME}。这边似乎是兰雅玛留下的歌。如果是这样的话，附近应该就有莎兰树了。运气很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740113
					],
					"speakerTitle": "兰罗摩"
				}
			]
		},
