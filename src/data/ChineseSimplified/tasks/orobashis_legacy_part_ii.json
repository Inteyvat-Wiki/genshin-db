			"dialogs": [
				{
					"id": 721300101,
					"content": "形状奇特的石灯，似乎放射着令人不安的能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721300102,
					"content": "这个石灯笼好邪门…散发着一种似曾相识的气息呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721300103,
					"content": "欸，好像有人在灯柱上写了字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721300104,
					"content": "「驻守的兵士，关于此镇物如有疑问，请至无想刃狭间，与梶先生商谈。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721300105,
					"content": "字看起来很新，但也有被雨水冲刷的痕迹。下面还有几列更清晰的小字",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721300106,
					"content": "「陌生笔记，请勿轻信。行军贵在神速，此必为贼人缓兵之计。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721300107,
					"content": "「私自离队开小差者，必有重罚！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721300108,
					"content": "这个梶先生似乎对石灯笼很在意的样子，我们不如去无想刃狭间问问他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
