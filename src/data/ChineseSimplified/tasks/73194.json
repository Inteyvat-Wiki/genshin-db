						731941002
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731941002,
					"content": "此人假扮教令官，游走巴扎港口各处，敲诈勒索，抢劫商队。现已由聚砂厅介入调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731941003,
					"content": "有消息称此人已藏身密林之中，广大市民如有目击，务必上报。",
					"roleType": "TALK_ROLE_NPC",
