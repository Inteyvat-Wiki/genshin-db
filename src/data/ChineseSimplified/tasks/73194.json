			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "须弥内外大事公告现已转由虚空投放，请大家随时佩戴「虚空终端」，以免错过重要消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940302,
					"content": "为方便异邦商旅与长者小孩，此公告板暂时保留。未来随时可能撤除，大家请勿过分依赖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
