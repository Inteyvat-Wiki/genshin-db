			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "健康之家乃阿弥利多学院下属的医疗服务机构，为须弥内外居民提供免费医疗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940702,
					"content": "该处执业医师皆获得生论派授予的行医许可，诊疗方案提供虚空多次审核，为百姓提供最专业、最安全的服务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940703,
					"content": "请广大居民切勿相信来路不明的医师，以免人财两空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319408,
