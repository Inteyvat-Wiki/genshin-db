			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "本年度的「丰沃之惠」已开始发放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940402,
					"content": "原则上将继续按照上年的发放政策和要求进行，具体内容已通过虚空投放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940403,
					"content": "如有变化请提前联系附近的教令官向教令院提出修改申请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
