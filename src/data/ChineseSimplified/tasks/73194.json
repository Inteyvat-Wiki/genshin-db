			"dialogs": [
				{
					"id": 731940801,
					"content": "请勿在城里人多的地方携带过多的金钱，以防遭遇偷窃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940802,
					"content": "如若发生财物被窃，也请不要向附近巡逻的镀金旅团求助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940803,
					"content": "因为很可能正是他们拿走了你的钱财。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
