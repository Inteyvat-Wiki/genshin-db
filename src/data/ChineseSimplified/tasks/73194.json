			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "近期城内「魔鳞病」多发，如您出现皮肤麻木、肢体无力等症状，或是观察到身体出现灰黑色的鳞片状组织，请及时前往健康之家接受治疗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940502,
					"content": "若错过最佳治疗时间，使病情发展恶化，可能导致丧失行动能力等严重后果，希望大家加以重视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
