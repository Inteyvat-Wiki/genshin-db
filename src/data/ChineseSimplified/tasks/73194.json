			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "此为教令官所设公告板，须弥城内重要事务皆在此公示，如有相关问题也可在此留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "「听说了吗？听巡林的人说，北边的森林里不知道什么时候建起了一座华丽的宫殿」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940202,
					"content": "「不过好像去过那里的人最后都被骗得身无分文，被巡林官发现的时候就剩个裤衩了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940203,
					"content": "「问他们到底怎么回事也不说，就知道在那哭，真是可怕啊。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940204,
					"content": "「大家还是不要在森林里乱跑了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
