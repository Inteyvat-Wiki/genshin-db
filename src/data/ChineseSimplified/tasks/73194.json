			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "特别提醒，整个须弥的佣兵行业都由「镀金旅团」承接，绝无二家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940602,
					"content": "请勿轻信他人，以防被来头不明的人骗取佣金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 731940603,
					"content": "如需雇佣保镖、守卫亦或有其他需求，请联系「三十人团」掌旗官鲁克沙或通过教令院联络员阿芬迪派发委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
