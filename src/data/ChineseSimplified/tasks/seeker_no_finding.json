					},
					{
						"sceneId": 3,
						"position": [
							-3012.201,
							380.705,
							8549.574
						],
						"pointId": 8161
					},
					{
						"sceneId": 3,
						"position": [
							-3014.803,
							380.927,
							8549.981
						],
						"pointId": 8670
					},
					{
						"sceneId": 3,
						"position": [
							-3014.679,
							380.789,
							8548.529
						],
						"pointId": 8671
					}
				]
			},
			"dialogs": [
				{
					"id": 750110101,
					"content": "原来这里就是「浮土静界」，从下面往上看的时候，还以为上面会是灰扑扑的，什么都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110102,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110103,
					"content": "没想到是这个样子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110104,
					"content": "嗯，据说这里的浮土本身都是用燃素的力量聚合在一起的，燃素本身也是一种生命力特别旺盛的能源…能源有点怪，先这么理解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110105
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110105,
					"content": "所以上面也能够长出草与花，能够让冷却的土地重新温热，能够在黑暗之中炽燃灵魂点亮火光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110106
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110106,
					"content": "这就是「燃素」…是由「盗火贤者」从巨龙的手中抢夺至我们手中的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110107
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110107,
					"content": "说到这个，想到有点生气的事情，哼，部族里的有些人啊，看到「浮土静界」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110108
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110108,
					"content": "就说人类使用燃素绝对达不到能够造出浮岛的程度，所谓的「盗火贤者」其实也是巨龙之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110109
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110109,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110110,
						750110111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110110,
					"content": "还有这种观点？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110113
					]
				},
				{
					"id": 750110113,
					"content": "自己做不到就说能够做到的人「其实不是人哦」，真是没有志气的家伙，我才不要和他们做朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110114
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110114,
					"content": "啊，说起来，宝藏，秘药呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110115,
					"content": "从这个意义上来说，这里看上去什么都没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750110116,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110117,
					"content": "嘿嘿，这可是那个被称为疯子的「盗火贤者」的试炼，怎么会这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110118
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110118,
					"content": "按照古织卷里的说法，现在我们要启动一些机关，完成最后的试炼，就可以达到「浮土静界」的中心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110119
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110119,
					"content": "不过我也不知道所谓「浮土静界」的中心是什么样的。总觉得记忆中看到的浮岛的图，和现在看到的有点差距…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110120
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110120,
					"content": "不过有可能是年纪到了以后连原本引以为傲的记忆都变得不可靠了。不过没关系…都已经到这儿了，就靠着直觉来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110121
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110121,
					"content": "那么，机关如何开启…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110122
					]
				},
				{
					"id": 750110122,
					"content": "嗯，应该也和「燃素刻录」一样，使用燃素的话就能打开了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110123
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110123,
					"content": "至少古卷上是这样画的，据说遍布纳塔的「燃素刻印碑」其实就是以这里的机关为原型制作的…机关也是了不得的古物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110124
					],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110124,
					"content": "#前途无量的{M#少年}{F#少女}，哼哼，快去试试看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇科娅"
				},
				{
					"id": 750110111,
					"content": "观点是自由的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110112
					]
				},
				{
					"id": 750110112,
					"content": "我知道，别人认为世界是什么样的想法，其实都是很难撼动的，不过还是很火大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110113
					],
					"speakerTitle": "奇科娅"
				}
			]
		},
