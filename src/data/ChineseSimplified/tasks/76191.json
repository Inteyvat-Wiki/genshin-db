			"dialogs": [
				{
					"id": 761910201,
					"content": "三番五次提醒你，让你招子放亮点，这压箱底的尖货，可是至冬堡的熟客点名要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "艾霍玛"
				},
				{
					"id": 761910202,
					"content": "得，你倒好，到我手下改吃素了还是怎么？突然就善心大发，给它放生了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "艾霍玛"
				},
				{
					"id": 761910203,
					"content": "大哥，你听我解释，这真怨不得我，是那丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "耶洛"
				},
				{
					"id": 761910204,
					"content": "丘丘人？亏你还好意思说呢！咱们盗宝团的招牌都要砸你手里了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "艾霍玛"
				},
				{
					"id": 761910205,
					"content": "打不过啊，大哥，真打不过！它们那一个蓝的一个绿的下手比债务处理人还狠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "耶洛"
				},
				{
					"id": 761910206,
					"content": "（这两个家伙看起来就是走私贩了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910207,
					"content": "…谁在那儿？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "艾霍玛"
				},
				{
					"id": 761910208,
					"content": "哎呀露米！还没到出场的时候呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910209,
					"content": "这是个什么玩意儿…看着挺稀罕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "艾霍玛"
				},
				{
					"id": 761910210,
					"content": "喂，小姑娘你总应付得来了吧？我看这货也够尖，就拿它替了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "艾霍玛"
				},
				{
					"id": 761910211,
					"content": "是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "耶洛"
				},
				{
					"id": 761910212,
					"content": "居然还想打露米的主意！盗宝团的名声就是被你们这种人败坏的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910213,
					"content": "呃，盗宝团有什么名声？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "耶洛"
				},
				{
					"id": 761910214,
					"content": "少跟她废话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾霍玛"
				}
			]
		},
