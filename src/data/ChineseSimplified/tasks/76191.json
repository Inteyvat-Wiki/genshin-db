			"dialogs": [
				{
					"id": 761910301,
					"content": "真的是银色的豚兽，不是染色的也不是看错，太少见了，不可思议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910302,
					"content": "之前在纳塔费尽心思也没找到，原来是被走私贩给抓到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910303,
					"content": "不过看起来好像没受伤…嘿嘿，银色的豚兽，真没想到能亲眼见到，让我摸摸看，银色的和普通的有没有区别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910304,
					"content": "…好烫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910305,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "豚兽"
				},
				{
					"id": 761910306,
					"content": "差点忘了，你还在锅里呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910307,
					"content": "难道是已经习惯了纳塔的液态燃素，所以这点温度不算什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910308,
					"content": "不管怎么说，你先跟我回去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761910309,
					"content": "♪～",
					"roleType": "TALK_ROLE_NPC",
