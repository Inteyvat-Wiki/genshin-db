			"dialogs": [
				{
					"id": 721840501,
					"content": "谢谢你，有这些食材就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840502
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840502,
					"content": "加入了稻妻本地食材的披萨，不知道做出来会是什么味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840503,
					"content": "完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840504,
					"content": "这披萨…看上去还不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840505,
					"content": "谢谢你帮忙，旅行者，这些东西请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840506,
					"content": "我等会就去仔细品尝一下这份披萨的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840507,
					"content": "如果还不错的话…应该很快就能作为新品正式推出啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
