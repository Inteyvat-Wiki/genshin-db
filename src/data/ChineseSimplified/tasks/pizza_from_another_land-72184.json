			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "旅行者，你回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840302,
					"content": "怎么样，你有问到什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840303,
					"content": "关于客人们的反馈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "用堇瓜做的披萨…倒也不会太复杂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840305,
					"content": "其余的材料就照常准备好了，唔，既然都说要「融入一些稻妻本地食材」了，那我就再加一点其他的材料好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840306,
					"content": "唔，海灵芝？鸣草？嗯…幽灯蕈怎么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840307,
					"content": "那个，要我帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "喔！抱歉，我光顾着想放什么食材好了！我看看，店里的堇瓜好像没多少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840309,
					"content": "旅行者，请你去帮我拿一个堇瓜来吧，材料的话…应该就只差这个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840310,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "嗯，那就拜托你了，只要一个堇瓜就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840312,
					"content": "还要找其他的食材吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "其他的食材店里还有些存货，你带一个堇瓜回来就好，拜托你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
			]
		},
