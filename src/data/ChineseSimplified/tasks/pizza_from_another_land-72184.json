			},
			"dialogs": [
				{
					"id": 721840201,
					"content": "你好呀，有什么事找我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "梨绘"
				},
				{
					"id": 721840202,
					"content": "关于「木南料亭」的披萨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "哦，你说那个披萨啊，味道确实很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "梨绘"
				},
				{
					"id": 721840204,
					"content": "但是…怎么说呢，总感觉不太吃得惯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "梨绘"
				},
				{
					"id": 721840205,
					"content": "我个人是觉得，要是能在那种披萨里融入一些稻妻本地食材的话，比如堇瓜之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "梨绘"
				},
				{
					"id": 721840206,
					"content": "说不定，这种披萨会更受大家欢迎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梨绘"
				}
			]
		},
		{
			"id": 7218403,
			"completionStepIds": [
				7218403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
