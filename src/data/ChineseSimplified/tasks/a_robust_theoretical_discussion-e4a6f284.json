					}
				]
			},
			"dialogs": [
				{
					"id": 746900101,
					"content": "来了来了，主角入场，准备开机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900102
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900102,
					"content": "——呵！不对不对！商业合作的模式应该像是映影的脚本一样，有起承转合才是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900103
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900103,
					"content": "按照惯例，邀请大明星入伙的第一步通常是递上名片，辅以华丽的自我介绍以抬高身价，随后再提出一个美好的合作愿景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900104
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900104,
					"content": "待对方显露出一定兴趣后，才可以开始深入探讨合作形式，就像你提出的速览映影想法一样，实在是太过激进了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900105
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900105,
					"content": "梅里爱小姐，坦率而言，如果你的第一部「实验映影」没有亏损这么严重的话，你的理论或许会更有说服力一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900106
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900106,
					"content": "#况且，在映影欢乐城的时候，你肯定尝试过和{NICKNAME}搭话吧？不过我认为，对方估计没有很深的印象吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900107
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900107,
					"content": "…你的想法不过是小孩子的一厢情愿罢了！大人的世界可复杂得多了！没有这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900108
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900108,
					"content": "唉，试图用年龄来衡量正确性，实在是非常肤浅的行为，梅里爱女士。你现今的言行，正好为我的正确性提供了更多佐证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900109
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900109,
					"content": "你说什么？啊——你这个喜欢装大人的臭小鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900110
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900110,
					"content": "呜哇！等一下等一下，不要吵架啊！有什么事情，不能心平气和地坐下来谈谈吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900111,
						746900112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746900111,
					"content": "别动气别动气…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900113
					]
				},
				{
					"id": 746900113,
					"content": "#这…{NICKNAME}和派蒙真的过来搭话了？这么简单的伎俩，居然有用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900114
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900114,
					"content": "梅里爱小姐你看，正如我所说的，相比冗长的铺垫，人们更在意抓人眼球的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900115
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900115,
					"content": "#要知道，{M#他们}{F#她们}可是需要排队三天三夜都无法接近的大名人，现在却因为目睹了我们的争吵主动来搭话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900116
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900116,
					"content": "接下来，就到了直接说明我们的合作意愿的部分了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900117
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900117,
					"content": "咳，来得正好，两位。你觉得我们的「实验速览映影」效果如何？是否很有吸人眼球的能力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900118
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900118,
					"content": "欸？「映影」？你们不是在…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746900119,
					"content": "吵架？呵呵，没有没有，端庄的大人一定不会因为小鬼的几句话而生气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900120
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900120,
					"content": "哼，确实。尤其面对的是那种喜欢装老成的小鬼的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900121
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900121,
					"content": "你们这明明就是真吵架吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900122
					]
				},
				{
					"id": 746900122,
					"content": "言归正传，两位你们不觉得，一见面，就撞上了非常有情绪张力的画面，会令观者产生强烈观影欲望吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900123
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900123,
					"content": "一般人会上来劝架才对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746900124,
					"content": "但倘若你们刚才就知道，这是映影呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900125
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900125,
					"content": "你这么一说也对哦…如果一上来就是那种我感兴趣的场面的话，我一定会想继续看下去的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746900126,
					"content": "这就是「速览映影」的优势所在——观者只需花最短的时间就能看到最具张力的片段！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900127
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900127,
					"content": "不仅如此，映影通常需要较长的时间观看，而这种速览映影只需碎片化的时间，甚至可以在冒险途中的休息间隙观看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900128
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900128,
					"content": "制作者也不一定要是专业的导演和摄影师。任何人、任何时间、任何地点，都可以创作或欣赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900129
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900129,
					"content": "而内容也不一定局限于故事，甚至可能只是一段好看的舞蹈，或者一片令人赏心悦目的风景。这样的形式是不是很有吸引力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900130
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900130,
					"content": "唔，没错。你这么一说我都想自己拍摄一下试试了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746900131,
					"content": "当然，想要达成这种吸引力还需要强大的「明星效应」，只有闻名整个提瓦特的名人，才能引来人们对「速览映影」的兴趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900132
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900132,
					"content": "没错，我说的就是你们二位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900133,
						746900134
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900133,
					"content": "明星的出场费可是很高的哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900135
					]
				},
				{
					"id": 746900135,
					"content": "这一点你们放心好了，我和小露米埃尔先生在映影欢乐城历练之后，筹集了足够的资金，用来充当你们的出场费绝对没有问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900136
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900136,
					"content": "#更何况，等到「速览映影」风靡提瓦特，你们说不定还能获得速览映影之{M#父}{F#母}的殊荣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900137
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900137,
					"content": "不仅如此，「速览映影」这一形式还放大了镜头语言的作用。像你们这样熟练的拍摄者，甚至可以做到不使用对白进行叙事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900138
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900138,
					"content": "#感觉好像很有趣！{NICKNAME}，要不我们参与一下试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900139,
						746900140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746900139,
					"content": "有趣！那就交给我们吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900141
					]
				},
				{
					"id": 746900141,
					"content": "太好了！那等你们两位准备好，我们就开拍。具体的机位我已经选好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900142
					],
					"speakerTitle": "小露米埃尔"
				},
				{
					"id": 746900142,
					"content": "映影机、道具和后期工作我这边也准备好了！你们只需要随心所欲地操作就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900143
					],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900143,
					"content": "那事不宜迟，我们快点开始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅里爱"
				},
				{
					"id": 746900140,
					"content": "有钱？那就试试看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900141
					]
				},
				{
					"id": 746900134,
					"content": "如果这是委托的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900135
					]
				},
				{
					"id": 746900112,
					"content": "一切都好商量…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900113
					]
				}
			]
		}
	]
}