			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰阿帕斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "哇，这个锅里炖的是什么呀，闻上去真香。只是闻着，口水就不停流下来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210102,
					"content": "好像是什么汤的样子，嗯…也看不出来是用什么材料做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210103,
					"content": "#哎呀，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210104,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "你看现在，炖汤的人也不在，这个汤这么香，我们不如偷偷喝上一口尝一尝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210106,
					"content": "那我们就偷偷喝一口吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210112,
					"content": "锅容量比看上去的要小。\\n里面的内容物就这样全部不见了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "噗哈…嗯？这个汤，香倒是很香，但是怎么感觉尝不出什么味道呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210114,
					"content": "兰穆护昆达在上！你们这些那菈，怎么回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210115,
					"content": "兰、兰那罗？到底是从哪里突然出现的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210116,
					"content": "从地里啦！不说这个，你们怎么能偷喝我做的汤，那可是我兰阿帕斯辛辛苦苦做出来的汤耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210117,
					"content": "对不起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210119,
					"content": "哼，偷喝了我做的汤，一句对不起就够了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210123,
					"content": "你们知道在这里做汤有多难吗？一会儿，天上下雨。一会儿，太阳出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210124,
					"content": "我好不容易做了这么一锅，竟然在采新鲜的香辛果的时候，被你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210125,
					"content": "我们只是因为味道太香才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210126,
					"content": "不过，既然这么困难，为什么要在这里做汤呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210127,
					"content": "哼，烹饪最关键的东西，必须每天都要取得的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210128,
					"content": "是身为厨师的自尊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "是水！是水啦！汤的香味，受水影响很大，当然要用最好的水来做汤啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210131,
					"content": "我一路上，在水天丛林取各个地方的水来做汤。采集了好多好多、有树上的叶子那么多的水样以后，才找到了最好的「活源水」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210132,
					"content": "那才是配得上无忧节的「至上珍馐」！就算跟你们说这个，你们肯定也不明白吧…只有之前那个那菈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210133,
					"content": "说到这个，其实我们是从兰帕卡提那来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210134,
					"content": "向兰阿帕斯述说事情的经过。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "啊，原来是「妹妹」的那菈朋友！而且，要举办无忧节了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210136,
					"content": "不过没有关系，我已经取得「活源水」，我的「至上珍馐」已经完成。就在这个锅里…然后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210138,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "欸嘿嘿。你别难过，汤闻起来真的很香…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210140,
					"content": "啊，我的「活源水」！水的源头住着「亚普修那」，好不容易等到它们离开水源，我才取了一锅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210141,
					"content": "不行，你们一定要再取一锅「活源水」赔给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210142,
					"content": "「亚普修那」…？那是什么东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210143,
					"content": "哼，那菈对森林真是一点也不了解。就是那种住在水里的，四条腿、有尾巴、会咬咬的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210144,
					"content": "…狗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210145,
					"content": "狗不住在水里吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "啊，也对。那「亚普修那」到底是什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210148,
					"content": "别管「亚普修那」了！我要水！而且要那边的「活源水」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210149,
					"content": "#好啦好啦…{NICKNAME}，没办法，我们走吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210150,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "一定要「活源水」，其他的水都不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210151,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "哪来的水狗。水之幻形狗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "是不忘初心的意志？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "都、都是派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#喂！{NICKNAME}，你居然出卖我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210122,
					"content": "我才不管是谁喝的啦，反正我的汤没有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210108,
					"content": "这不太好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "我是真的很好奇嘛，呜，我就偷偷喝一口，就一口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210110,
					"content": "要是喝坏肚子就不好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "哼哼，可不要小看派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "派蒙"
				}
			]
		},
