					"兰阿帕斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210301,
					"content": "我的汤…呜呜…怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210302
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210302,
					"content": "（默默离开吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7302104,
			"completionStepIds": [
				7302103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302103",
							"2"
						],
						"stepId": 7302103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰阿帕斯",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "…嗯，确实是河流源头的水，「活源水」凛冽又干净，和月光一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210402,
					"content": "如果兰茶荼、兰萨卡和兰非拉是吸着这样的水长大的，那肯定不会变成现在这样的笨蛋。只有兰帕卡提，我的妹妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210403,
					"content": "咳咳，接下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210404,
					"content": "嗯？对了，接下来，你们要做一锅汤赔给我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210405,
					"content": "在兰阿帕斯的指导下，在水中加入了一些蔬果，开始烹饪。\\n锅中慢慢传出了不错的香味。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "完成后，一同品尝了刚刚做好的「汤」。\\n…应该说是符合预期吧，虽然确实有食材的香味…\\n但没有任何调味的汤果然还是太纯粹了。\\n一点味道也没有。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "嗯嗯，「至上珍馐」当然就是要有这样的香味才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210408,
					"content": "#嗯…你觉得呢，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210409,
					"content": "以汤的角度来说，确实能解渴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "我觉得，如果加点盐和胡椒，应该会比较美味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210412,
					"content": "任何东西加盐和胡椒都会变得美味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "兰穆护昆达在上！竟然要加盐…盐是多么可怕的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210414,
					"content": "有盐的土地上，就没有生命，兰那罗只能退缩成干种子…那菈竟然要放盐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210415,
					"content": "汤没有味道，是理所应当的！你们这些那菈，竟然不懂这样的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210416,
					"content": "以前那个那菈，喝了汤以后，就告诉过我们这样的道理：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210417,
					"content": "「我们那菈呀，到了孩子们要回家的时候，家里都会传来汤的香味。所以，汤只需要有香味。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210418,
					"content": "#然后，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}夸我兰阿帕斯的汤做得很好，很香。我一直记得。所以，我才不信你说的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210419,
					"content": "但只有香味也不行吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210420,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210421,
					"content": "哼，不过既然你们是这次无忧节的那菈，那一定是兰拉迦、兰帕卡提他们认可的。没办法，就想办法做有味道的汤吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210422,
					"content": "那下次就找更好的水来做汤，一定能做出更好的汤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210423
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210423,
					"content": "…我倒觉得和水没关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210424
					]
				},
				{
					"id": 730210424,
					"content": "是嘛…不过这次的「烹饪修行」已经圆满结束了。好，一切都等到无忧节再说吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210425
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210425,
					"content": "做汤的办法也教给你们了。这可是伟大那菈认可的味道，你们多尝尝吧。但是，记住：一定要用好水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210426
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730210426,
					"content": "#({NICKNAME}，下次我们加点调味料试试吧。味道应该会不错…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
