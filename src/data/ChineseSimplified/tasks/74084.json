			"dialogs": [
				{
					"id": 740840605,
					"content": "快看！祭坛旁边有只龙蜥！它是不是睡着了？我们要小心点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840601,
					"content": "咦？这里…这里怎么没有钥匙？难道这座祭坛已经被提前激活了？该不会已经有人拿走钥匙了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840602,
					"content": "吼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "沉睡的龙蜥"
				},
				{
					"id": 740840603,
					"content": "不好了！那只龙蜥醒了！我们快跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840604,
					"content": "祭坛旁的龙蜥摇晃着醒来，双眼喷出愤怒与恶意…\\n你们急忙向岸上游去…但它在后面紧追不舍…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
