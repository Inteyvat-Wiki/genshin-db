			"dialogs": [
				{
					"id": 740840801,
					"content": "…美露莘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840802,
					"content": "珀西芙，你怎么在这里？快离开那只龙蜥，很危险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840803,
					"content": "善良派蒙，珀西芙！危险，美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840804,
					"content": "珀西芙伸出手抚摸着龙蜥的脑袋，暴怒的龙蜥乖乖低下了身子。\\n它张开嘴，吐出了一颗晶莹的水珠，然后转身跳进了水中。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "是钥匙！钥匙居然被龙蜥藏在嘴里了！而且它居然主动把钥匙交出来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840806,
					"content": "蓝东西，好东西，钥匙，保护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840807,
					"content": "蓝东西是刚刚那只龙蜥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "珀西芙，你和那只龙蜥是朋友吗？它在帮你保护钥匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840809,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840810,
					"content": "紫东西，抢钥匙…蓝东西，晕过去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840811,
					"content": "紫、紫东西？那是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840812,
					"content": "#紫东西，坏东西…蓝东西，派蒙，{NICKNAME}，好东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840813,
					"content": "嗯…好吧，虽然听出来你在夸我们，但总觉得有点怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840814,
					"content": "紫东西，十分很坏，伊黎耶，十分美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840815,
					"content": "你是说…危害这座岛的家伙就是这个紫东西？好在钥匙现在在我们手里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740840816,
					"content": "#派蒙，{NICKNAME}，珀西芙！但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840817,
					"content": "钥匙，钥匙，钥匙，广场，西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740840818,
					"content": "知道啦，珀西芙别着急，我们现在就去西边的广场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
