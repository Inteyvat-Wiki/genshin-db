				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#金色的那菈，兰弥那离知道，是帮助过兰那罗的好那菈。所以，兰弥那离的「宝箱」，给那菈{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
