			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#兰弥那离听说了，那菈{NICKNAME}在桓那「大展身手」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000302,
					"content": "#「宝」已经放进「箱」里，那菈{NICKNAME}可以打开「宝箱」，「不要客气」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰弥那离"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
