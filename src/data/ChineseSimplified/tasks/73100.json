				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#那菈{NICKNAME}想要打开「宝箱」？但是…桓那还有很多兰那罗需要帮助，如果金色的那菈可以去帮助这些兰那罗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000102,
					"content": "兰弥那离会准备好满满的「宝箱」！连同兰宁巴送回的「宝贝」一起，把「箱」喂得饱饱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰弥那离"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
