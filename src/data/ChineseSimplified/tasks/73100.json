				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰弥那离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#那菈{NICKNAME}，还有派蒙，好慢！兰弥那离的「宝箱」，早早准备好了，和兰弥那离一起等了好久好久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000402,
					"content": "兰那罗的好朋友，「宝箱」已经满满了，可以打开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰弥那离"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰弥那离",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#很多兰那罗告诉兰弥那离，那菈{NICKNAME}和派蒙，做了很多好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000502,
					"content": "兰弥那离早就知道啦，那些夸奖的话，跑过林间的枝桠，趟过细细的水流，跟着微风一起，都吹进了兰弥那离的「快乐小窝」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000503,
					"content": "#所以兰弥那离，这次也把「箱」塞得满满，就等那菈{NICKNAME}来打开啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000504,
					"content": "#兰宁巴送回了一些亮晶晶，兰弥那离也都塞进了「箱」里，也许那菈{NICKNAME}会喜欢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000505,
					"content": "兰宁巴没有回来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "嗯，兰宁巴不像大树，根扎得很深，他是停不下来的兰那罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000507,
					"content": "欸…那兰弥那离独自一个在这里不会寂寞吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731000508,
					"content": "「寂寞」是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000509,
					"content": "唔…就是，就是独自一个的时候，很想很想同伴在身边的感觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731000510,
					"content": "桓那兰那有很多兰那罗，所以兰弥那离一点也不「寂寞」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000511,
					"content": "不过，兰雅玛和兰宁巴都不在桓那兰那了。以前，三个兰那罗在一起，不管做什么都很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000512,
					"content": "兰雅玛的兰迦拉梨很强，很弱的那菈没办法破解。兰宁巴很会画画，画各种各样的东西，好看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000513,
					"content": "但是现在，只有兰弥那离和兰弥那离的「宝箱」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000514,
					"content": "兰弥那离…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731000515,
					"content": "没关系，兰弥那离有很多「宝箱」，虽然不知道为什么那菈这么喜欢开箱子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000516,
					"content": "但是兰弥那离是「宝箱」的主人，喜欢宝箱的那菈，也会喜欢兰弥那离的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000517,
					"content": "不过，兰弥那离没有更多「宝」了，唔…「箱」要过一段肚子空空的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000518,
					"content": "#虽然兰弥那离的「宝箱」之后要空空了，那菈{NICKNAME}，还是要做兰那罗的好朋友呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰弥那离"
				}
			]
		},
