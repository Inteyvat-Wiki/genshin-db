			"dialogs": [
				{
					"id": 731000601,
					"content": "#兰弥那离还没有准备好！「宝箱」也还没有吃饱。那菈{NICKNAME}和派蒙可以「游手好闲」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 731000602,
					"content": "唔，不对，是「四处漫游」。这样，说不定会碰到需要帮助的兰那罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰弥那离"
				}
			]
		},
