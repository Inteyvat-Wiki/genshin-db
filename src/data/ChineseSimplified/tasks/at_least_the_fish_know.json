			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉诺蕾娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240140801,
					"content": "这些机关鱼…真见鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140802,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "修好过，但很快又坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140805,
					"content": "这片区域里的机关鱼不知道为什么，就像是发了疯一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140806,
					"content": "我刚把鱼苗投放出去，它们就直接扑了过来，不停地吞吃着鱼苗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140807,
					"content": "因为有几只鱼苗挂在了潜水服上，所以有些机关鱼径直朝我扑了过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140808,
					"content": "虽然我知道它们其实不会攻击我。但我…还是害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140809,
					"content": "然后，我就在水里胡乱地挣扎，手脚乱挥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140810,
					"content": "不知道什么时候，又把潜水服撞出了一道大口子…还好当时离岸边不远，我用尽方法，总算是上了岸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140811,
					"content": "但看现在的情况，我暂时是无法下水继续投放鱼苗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140812,
					"content": "旅行者，你还愿意再帮我去投放一下鱼苗吗？无论深水区或浅水区都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉诺蕾娅"
				},
				{
					"id": 240140803,
					"content": "你修好潜水服了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}