			"dialogs": [
				{
					"id": 1903201201,
					"content": "唉，好累，终于可以休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201202,
					"content": "是不是有点过火了呢，好像有几个人被吓破胆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201203,
					"content": "请问你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "啊啊，这里不应该靠近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201205,
					"content": "唉，算了，被你听到了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201206,
					"content": "我就是在这里扮演鬼怪的工作人员，现在轮到我休息，所以又热又不透气的衣服被我脱掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201207,
					"content": "果然这里没有鬼吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "是啊，怎么可能会有真正的鬼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201210,
					"content": "无论是我们，还是来参加试胆大会的人，都不希望看到真正的鬼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201211,
					"content": "他们想要的，只是一种氛围，或者说，契机。最重要的是刺激的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201212,
					"content": "在提心吊胆中，遭遇一些意外，顺势说出平时不敢说的话，这就是试胆大会的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201213,
					"content": "我觉得也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "好了，我差不多该继续工作了，你和你的朋友也要玩的开心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201214,
					"content": "（重云应该很失望。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "都只是吓唬人的对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}