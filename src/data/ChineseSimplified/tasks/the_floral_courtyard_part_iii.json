			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726890101,
					"content": "两位，你们果然按时前来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890102,
					"content": "经过两次修习，你们对于花艺的理解有了质的飞跃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890103,
					"content": "因此，今天的「花题」将稍有变化，在两位的构图思维中开垦一方新的培土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890104
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890104,
					"content": "我们准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890105
					]
				},
				{
					"id": 726890105,
					"content": "唔…这么一说，我忽然有点紧张了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726890106,
					"content": "呵呵，不必忐忑。放松身心，平心静气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890107
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890107,
					"content": "凭两位的才华，深思「花题」后，相应的图景就会在脑海中浮现出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890108,
						726890111
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890108,
					"content": "过奖了，请赐教。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890109
					]
				},
				{
					"id": 726890109,
					"content": "那么，今天的花题是「栖凭翠羽，遐籁生花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890110,
					"content": "两位会给出怎样的答卷呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890111,
					"content": "还有别的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890112
					]
				},
				{
					"id": 726890112,
					"content": "没关系。「插花」需要安神定气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890113
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726890113,
					"content": "等到二位忙完手头的事，摆脱了喧扰。必定能将题中的「花庭」构筑得更加完满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		},
		{
			"id": 7268903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268903",
							"2"
						],
						"stepId": 7268903,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268901",
							"2"
						],
						"stepId": 7268901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "接下来的几天，我会一直守候在这里，引导容彩祭的客人们，让他们感受「花影瑶庭」的精妙之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870202,
					"content": "两位也别忘了每天揭晓一道的「花题」哦，一共有四道「花题」等着你们作答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870203,
					"content": "当然，要是两位还有其他问题，我也会尽力为你们解答的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870204,
					"content": "关于这里的花卉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有着难以挑剔的品质和亲民的价格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870206,
					"content": "也许你们已经见过咲耶了，我们曾在同一位老师门下学习「插花」的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870207,
					"content": "咲耶对于花艺的理解也可圈可点，但是听说容彩祭的客人络绎不绝时，她似乎有些怯场，认为在这种环境里难以静下心来插花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870208,
					"content": "所以，我也会向其他客人宣传她的「咲耶花屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870209,
					"content": "有机会的话，我们也可以帮忙哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870219,
					"content": "那么，还有什么问题吗，两位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870220,
					"content": "谢谢你，柴染小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "不用客气。如果你们有空，随时都可以来找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870210,
					"content": "关于社奉行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "社奉行一直支持着稻妻的花艺事业。准确来说，为这次活动出资的贵人，是那位白鹭公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870212,
					"content": "白鹭公主自小就表现出惊人的花艺天赋。我曾看过她的「插花」表演，有幸与她交流过心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870213,
					"content": "虽说我比她年长，但论插花的技巧和对花艺的理解，完全没法与她相提并论呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870214,
					"content": "在条件允许的情况下，白鹭公主每年都会提供资金，推广「插花」这门艺术。听说有时她还会用掉自己的积蓄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870215,
					"content": "白鹭公主曾坦率表达过自己的愿望——她想让更多人了解「插花」，对花艺产生兴趣，进而沉下心来修习这门学问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870216,
					"content": "原来绫华为稻妻的花艺付出过这么多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870217,
					"content": "希望她的愿望能实现。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "感谢两位，你们真是善解人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870222,
					"content": "暂时没有问题了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "如果你们有空，随时都可以来找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		}
	]
}