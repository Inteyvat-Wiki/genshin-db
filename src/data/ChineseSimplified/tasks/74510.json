			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"左右加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745100101,
					"content": "是我们赢啦！蕈兽伙伴们大获全胜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100102,
					"content": "真是华丽的战斗策略，不愧是你们，「黄金流星」和「白银伴星」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100103
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100103,
					"content": "你们的驯兽才能完全超出了常理，即便面对常理以外的对手，蕈兽伙伴们也能在你们的指挥下立于不败之地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100104,
						745100105
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100104,
					"content": "嘿嘿！被海妮耶夸了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100106
					]
				},
				{
					"id": 745100106,
					"content": "不过，前几次有大雪猪王和魔偶剑鬼登场，这次居然连刀子狗都找来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100107,
					"content": "左右加，你设置对手的阵容，还真是随心所欲啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100108,
					"content": "这些强敌可都是各地冒险家故事中传说般的存在哦！名气多多少少漂洋过海，能引起各地玩家的共鸣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100109
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100109,
					"content": "作为一个小说作者，我也很喜欢…各种本来无关的角色比拼一番实力的场景，想想都兴奋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100110
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100110,
					"content": "那么，「智巧勇武双连星」，你们已经体验了本次「小小灵蕈大幻戏」的所有关卡，感觉怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100111,
						745100113,
						745100115
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100111,
					"content": "关卡有点少，不够玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100112
					]
				},
				{
					"id": 745100112,
					"content": "嗯，这符合我们的第二种预期。那下一次预热活动，还是按照最高规格，制作更多关卡好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100117,
					"content": "总之，左右加之后还会查阅更多资料，设计更多强大有趣的对手，让枫丹人们逐渐喜欢上这个游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100118
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100118,
					"content": "如此一来，我们的赞助商枫达就会持续为我们提供大笔资金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100119
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100119,
					"content": "等到筹集了足够的经费，就能再次举办「月莲杯」那种规模…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100120
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100120,
					"content": "不，是比「月莲杯」更大的盛会！大赛的赛制也会做出大幅改进，要做到激动人心，又生动有趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100121
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100121,
					"content": "欸嘿嘿，想想就兴奋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100122,
						745100123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100122,
					"content": "有需要就找我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100124
					]
				},
				{
					"id": 745100124,
					"content": "这是一个长期的计划，不必计较短时间的进展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100125
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100125,
					"content": "经过左右加和贝尔福先生的指导，我也算是个基本合格的商业人士了，当然不能劳烦你们亲自处理细节问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100126
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100126,
					"content": "就算预热活动和商业洽谈结束了，我和左右加也会在枫丹停留很久，带着蕈兽伙伴们好好旅游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100127
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100127,
					"content": "我们想定期给你们寄信，附上蕈兽伙伴的近况和项目进展的报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100128
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100128,
					"content": "当然，这需要你们确认一个固定的收信地点，不然就容易出现以前那样的情况，联系不上你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100129
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100129,
					"content": "固定的收信地点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100130,
						745100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100130,
					"content": "每隔几天就去的地方嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100132
					]
				},
				{
					"id": 745100132,
					"content": "完美！那就由我给「智巧勇武双连星」写信，代表海妮耶和蕈兽伙伴，向你们定期汇报情况！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100133
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745100133,
					"content": "那就这么说定了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100134,
					"content": "现在「小小灵蕈大幻戏」的热度还没降下来，我们还打算再办一段时间活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100135
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100135,
					"content": "如果你们不忙的话，还可以再来玩玩这个游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100136,
						745100137
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100136,
					"content": "没问题哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100138
					]
				},
				{
					"id": 745100138,
					"content": "嘿嘿，感觉这次，海妮耶、左右加和蕈兽伙伴们不会再离开我们很远，也不会分别许久，安心了很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100139,
					"content": "我越来越期待了，下次驯兽师大赛，到底能办成什么样子呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745100137,
					"content": "时间还多！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100138
					]
				},
				{
					"id": 745100131,
					"content": "好像只有冒险家协会了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100132
					]
				},
				{
					"id": 745100123,
					"content": "我们也懂经营！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100124
					]
				},
				{
					"id": 745100113,
					"content": "关卡刚刚好，很合适。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100114
					]
				},
				{
					"id": 745100114,
					"content": "多谢肯定…不过，也有可能是你比较忙，没有太多时间。我们还是再准备一些备用关卡为妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100115,
					"content": "有蕈兽伙伴，我都行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100116
					]
				},
				{
					"id": 745100116,
					"content": "啊呀，你还是这样率性。按照左右加的话，现在你是我们的老板，有什么要求，直接和我们提就可以的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745100105,
					"content": "哈哈！海妮耶也很强！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100106
					]
				}
			]
		}
	]
}