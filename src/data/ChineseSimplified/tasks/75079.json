				},
				{
					"id": 750876002,
					"content": "你在这里做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876004
					]
				},
				{
					"id": 750876004,
					"content": "给学员必要的指引和帮助。现在和以前可真不一样了，要知道以前可是没有这些贴心的服务的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876005
					],
					"speakerTitle": "琪希可"
				},
				{
					"id": 750876005,
					"content": "但是有一次因为教练在指导时言辞有些…严厉？偏偏那个学员也是个脾气火爆的人物…唉，当时的场面我都不愿再提。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876006
					],
					"speakerTitle": "琪希可"
				},
				{
					"id": 750876006,
					"content": "总之自那之后飞行学校就改变了指导的方针。伸手不打笑脸人，谁也不会讨厌被夸吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琪希可"
				},
				{
					"id": 750876003,
