			"dialogs": [
				{
					"id": 750790701,
					"content": "这里就让我作为人生的前辈、你的兄长，来好好教教你怎样融入集体并且成为一个受欢迎的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750790702,
					"content": "多谢你的好意，但是我不需要。再说了，你也不是我的兄长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790703,
					"content": "还有，能请你不要再给奥伯龙喂饼干了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790704,
					"content": "呜呜，啊呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750790705,
					"content": "不懂事的小鬼，要不是看在你姐的面子上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750790706,
					"content": "打扰了，我来领奖品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "哦，这还真是稀罕的客人，我们这儿可不常见小嵴锋龙。还有这边的…你的伙伴品种真是多样啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750790709,
					"content": "#品种…我跟{REALNAME[ID(2)|SHOWHOST(true)]}可不是一回事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790710,
					"content": "嗯？呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#欸？不是，我们都是{NICKNAME}的伙伴没错，但是也不完全一样吧，呃，不一样的意思不是说谁更好谁不好，所以别难过啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790712,
					"content": "无意说出的真心话才致命…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#{NICKNAME}明明知道我不是那个意思，就别让问题变得更复杂啦。{REALNAME[ID(2)|SHOWHOST(true)]}也是我们的好伙伴哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790714,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也是好伙伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "呜呜？呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#嘿嘿，我就知道{REALNAME[ID(2)|SHOWHOST(true)]}是聪明小龙，一定不会误会我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790717,
					"content": "真是叫人羡慕的默契。看你们的装束也不是本地人，却能和小嵴锋龙有这样深厚的信赖和友谊，是不是有什么诀窍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750790718,
					"content": "实不相瞒，塔卢加和他的小绒翼龙虽然是搭档，相处得却并不好。如果有什么融洽相处的诀窍，真想让他学学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750790719,
					"content": "比起我的事…他们的奖品呢？总不会还没准备好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790720,
					"content": "当然准备好了！你倒是会转移话题，算了，这个先不提…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750790721,
					"content": "近期还会举办飞行竞赛，如果几位感兴趣的话，千万不要错过观赛的机会，不要错过我精彩的表演！我还有事，就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉密萨纳"
				}
			]
		},
