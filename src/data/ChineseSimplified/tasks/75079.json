			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "抱歉，葵莉娅小姐，刚才加勒弗大汪没伤到你吧？它很少对陌生人这么热情的，真的有点反常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "帕朗"
				},
				{
					"id": 750791802,
					"content": "呵呵，不碍事。我很习惯跟动物打交道，它这么亲近我不如说叫我很高兴呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "葵莉娅"
				},
				{
					"id": 750791803,
					"content": "话说回来，豪卡可是很挂念你呢，他一听说我最近会来这边，就拜托我来打听一下你的近况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
