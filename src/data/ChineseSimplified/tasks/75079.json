					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉密萨纳",
					"塔卢加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "嘿，你真该改改你那臭脾气，我这么说也是为你好，你也过了不懂事的年纪了，不说为了你姐，就算为了自己也该考虑考虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750791702,
					"content": "呜，啊呜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750791703,
					"content": "你看，它也觉得我说得对呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "拉密萨纳"
				},
				{
					"id": 750791704,
					"content": "我们之中如果有谁不懂事那也一定不会是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750791705,
					"content": "哎！你这臭小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉密萨纳"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507909",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
