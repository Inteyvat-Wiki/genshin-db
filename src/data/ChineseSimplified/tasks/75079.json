					}
				]
			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "居然这么轻松就能拿到奖品…要是冒险家协会的委托也都这么容易就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790902,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}你们是冒险家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790903,
					"content": "我有冒险之证，派蒙没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "#哼哼，就算没有文件，我也可以有冒险家之心嘛。就像我虽然没有飞行执照，但要论飞行技巧，肯定不会输给{NICKNAME}哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790905,
					"content": "你这么问是有什么委托想要交给我们吗？等一等，你先不要说，让我猜猜看，答案只有一个——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790906,
					"content": "#你看到我们和{REALNAME[ID(2)|SHOWHOST(true)]}关系这么好，想要请教和小龙融洽相处的诀窍！对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790907,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "唉，根本不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790909,
					"content": "欸欸？可是刚才拉密萨纳他明明就说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790910,
					"content": "问题就出在他身上。那可是个擅长笼络人心的家伙，就连奥伯龙也因为吃了他给的龙龙饼干变得对他言听计从。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790911,
					"content": "啊呜，呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750790912,
					"content": "摆出一副委屈的样子也没用，一流的绒翼龙就是要严格控制饮食的，而且你原本就容易发胖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790913,
					"content": "那家伙还隔三岔五对莉瓦姐姐献殷勤，肯定是别有用心…莉瓦姐姐也是，一点警惕性也没有，还跟他有说有笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790914,
					"content": "嗯？怎么听起来感觉他人还挺好的？难道不是因为你不喜欢他，所以对他有偏见吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790915,
					"content": "不是，还不止是这样，那家伙最近一段时间鬼鬼祟祟的，不知道在忙活些什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790916,
					"content": "大人总是有很多事要忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "是呀，他不是说过要举办什么飞行竞赛吗？说不定是在筹备那个呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790918,
					"content": "之前提过要举办飞行竞赛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "可是他又没出多少力气，准备工作都是帕朗在做，这阵子总能看到他和加勒弗大汪四处奔忙，辛苦的是帕朗才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790920,
					"content": "而且我昨天听到了！他和外边来的人小声商量些什么危险的事，我不敢靠太近所以没有听得特别完整，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790921,
					"content": "「飞行竞赛当天准时」、「下手…分寸」、「人命」，「事成之后再付另一半」，「具体安排明天深夜北部营地详谈」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790922,
					"content": "怎么只有后半听得格外清楚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "那还不是多亏了奥伯龙，那时候不知道为什么特别不安分，一直想往拉密萨纳那边去，最后我实在没拦住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790924,
					"content": "啊呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "奥伯龙"
				},
				{
					"id": 750790925,
					"content": "笨蛋，我可没在夸你啊。总之，看到我追着龙过去，另一个人很快离开了，剩下的拉密萨纳也表现得很不自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790926,
					"content": "他一定是担心事情败露，所以今天才来找我的茬，用着冠冕堂皇的借口，其实只是为了监视我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790927,
					"content": "哇，你明明还是个小孩子，想的事情却很复杂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790928,
					"content": "我知道，你也觉得小孩子的话不可信，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790929,
					"content": "#所以我想拜托{NICKNAME}{M#哥哥}{F#姐姐}晚上和我一起去北部营地调查看看，万一他真的在秘密推进什么危险的计划…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790930,
					"content": "#必须想办法阻止他！有{NICKNAME}{M#哥哥}{F#姐姐}帮我作证，其他人…莉瓦姐姐也一定会相信我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790931,
					"content": "#要是{NICKNAME}{M#哥哥}{F#姐姐}觉得我说的这些都是小孩子的胡思乱想，不值得亲自去一次，那至少帮我带个信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790932,
					"content": "我已经写好了一封说明情况的短信，如果我明天还没有回来，就请把这封信转交给莉瓦姐姐，之后奥伯龙也要拜托她照看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790933,
					"content": "等一下等一下！你怎么越说越吓人了，应该不会真的有这样的事吧…唔，可是万一是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}，要不我们还是调查看看？要是现在置之不理，结果真的出了什么事，之后一定会做噩梦的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790935,
					"content": "#你们愿意帮我吗？太好了！那{NICKNAME}{M#哥哥}{F#姐姐}，晚上我们一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790936,
					"content": "交给我们就行了，你留下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "嗯，像调查这类委托，人多反而误事呢，所以你就留在这里等我们消息好啦。你瞧，我是不是很有冒险家的心得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790938,
					"content": "你这么一说…确实很有道理。那我就留在这里照看奥伯龙好了，还要劝一下莉瓦姐姐不要和拉密萨纳走得太近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "塔卢加"
				},
				{
					"id": 750790939,
					"content": "那就拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔卢加"
				}
			]
		},
