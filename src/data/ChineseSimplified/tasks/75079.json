			"dialogs": [
				{
					"id": 750790301,
					"content": "#欢迎…呃，看来你们之中至少有一个已经熟练掌握了翱翔的要义，那么是这位{M#小兄弟}{F#小妹}想学习飞行技巧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750790302,
					"content": "我已经有飞行执照了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "飞行执照？这倒是个新鲜词儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750790305,
					"content": "咱们这儿主打一个人和龙共同进步，你的伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750790306,
					"content": "唔，呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "…嗯，小家伙，看来帕帕卡飞行学校不是能让你一展身手的地方。别太介怀了，这当然不是你的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750790308,
					"content": "呜嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}还小，还有潜力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "嵴锋龙的潜力怎么想也不会是和绒翼龙暝视龙比飞行吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790311,
					"content": "#不管怎么说，{M#小兄弟}{F#小妹}如果对咱们这儿的飞行训练感兴趣，不妨试试开放的训练赛道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750790313,
					"content": "不管是躲避障碍物还是灵活转向，都是驾驭绒翼龙所需的必备能力，到底有几分本事，训练赛道一试便知！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750790312,
					"content": "#实话说为了推广，咱们也是费了不少心思，又是准备奖品又是筹办比赛。{M#小兄弟}{F#小妹}顺利通过的话就去找拉密萨纳领奖吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750790304,
					"content": "你能教我什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
