					"nextDialogs": [
						750875102,
						750875103,
						750875104
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750875102,
					"content": "关于帕帕卡飞行学校…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875105
					]
				},
				{
					"id": 750875105,
					"content": "其实我也不知道为什么会叫这个名字，说起帕帕卡…你听过昆图尔和坏巫师茹米的故事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875106
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750875106,
					"content": "部族的战士输给了坏巫师茹米，被他变成了帕帕卡…听起来好像不是什么好事？可能帕帕卡真的飞得很快吧，谁知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750875103,
					"content": "关于拉密萨纳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875107
					]
				},
				{
					"id": 750875107,
					"content": "哈哈…他是个好手，但不擅长教人。当飞行竞赛的对手…还算说得过去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875108
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750875108,
					"content": "要不是飞得不好，谁会来这里呢？这时候如果太过严厉…唉，以前可不是没发生过这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875109
					],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750875109,
					"content": "所以现在的方针已经改成鼓励为主了，相信多夸夸也能有进步的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特马乔"
				},
				{
					"id": 750875104,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875110
					]
				},
				{
					"id": 750875110,
					"content": "再见，也欢迎你随时回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特马乔"
				}
