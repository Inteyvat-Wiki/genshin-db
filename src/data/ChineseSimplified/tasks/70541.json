			"dialogs": [
				{
					"id": 705410101,
					"content": "喵嗷~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410102
					],
					"speakerTitle": "「大桔骑士」"
				},
				{
					"id": 705410102,
					"content": "嘿嘿，「大桔骑士」也变得乖巧听话啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410103,
					"content": "以后，你千万要做一个温柔的好孩子，快快乐乐地和大家一起生活哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410104,
					"content": "我，我也想挠挠它的头，捏捏它的耳朵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410105
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410105,
					"content": "不闹腾的时候，明明是个非常讨人喜欢的家伙…那它眼睛上的伤是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410106
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410106,
					"content": "根据复原制剂的残留痕迹，「大桔骑士」应该就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410107,
					"content": "#唔，{NICKNAME}和派蒙…教会的罗莎莉亚修女，还有一位冒险家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410108
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410108,
					"content": "看样子，「大桔骑士」已经和你们交上朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410109
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410109,
					"content": "阿阿阿阿阿贝多？好久不见了！见到你很开心，不过…你确定没走错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410110,
					"content": "调查小队的队长突然造访一间流浪动物收养所，是有什么重要的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410111
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410111,
					"content": "你说队长？他是骑士团的队长？重要的长官没有任何预兆地来了…我都没有准备招待客人的茶和点心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410112
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410112,
					"content": "不对，请听我解释，我们「猫茸茸城堡」是拿到了经营许可的正式营业场所！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410113
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410113,
					"content": "瓦乐瑞娜误以为自己的收养所会被查处，慌慌张张地找来骑士团开具的文件，向阿贝多解释了一番「猫茸茸城堡」的用途…\\n其实她只是被调查小队的前缀给震慑了，调查小队并不负责城市管理方面的事务…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705410114
					]
				},
				{
					"id": 705410114,
					"content": "请别紧张，我只是顺路帮部下解决麻烦而已，那只猫就是我此行的目的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410115
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410115,
					"content": "不久前，「临时队猫·三号治疗病例·大桔骑士」打晕了照顾它的武器官，逃窜至城门附近，失去了影踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410116
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410116,
					"content": "「属于调查小队，戴着骑士团徽记的大猫在城里作乱」，多少会造成不妙的影响，还是尽早制止为妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410117
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410117,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410118,
						705410119
					],
					"speakerTitle": "「大桔骑士」"
				},
				{
					"id": 705410118,
					"content": "它原来是调查小队的猫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410120
					]
				},
				{
					"id": 705410120,
					"content": "「大桔骑士」居然能打晕调查小队的骑士？名字前面还有好长的一串称号…好像还有什么隐情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410121,
					"content": "说来确实很巧。两个月前，它在野外迷路，误食了骗骗花蜜，结果由于某些暂不明确的反应，体型膨胀成了原本的三倍大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410122
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410122,
					"content": "三倍！一般的猫猫凶起来就很难安抚了…三倍大的话，岂不是连丘丘人都不怕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410123,
					"content": "这样啊，难怪它那么紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410124
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410124,
					"content": "对于猫…以至于生活在野外的所有生物而言，体型太大并不会带来多少益处，反而会让自己更醒目，动作变得更迟缓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410125
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410125,
					"content": "最后只会让它们生活在极易暴露的危险处境中，频繁遭到其他掠食者的攻击，受到过度惊吓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410126
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410126,
					"content": "是的，它出现在调查小队的驻地附近时，显然吃了不少苦，全身伤痕累累，异常惊恐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410127
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410127,
					"content": "好，好可怜…这样一想，被它打了，我也不觉得难过了…换成我，我也会害怕陌生的人和动物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410128
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410128,
					"content": "不用担心，问题已经解决了。之前我开发了一种消除炼金药剂影响的复原制剂，就用这种制剂让它的体型恢复正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410129
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410129,
					"content": "虽然体型依然大于普通的猫，但至少不会影响它的生活了，骑士们也能轮流照顾它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410130
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410130,
					"content": "可莉根据它的颜色，给它起了「大桔骑士」这个名字，大家都觉得很合适，还给它定制了这条围巾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410131
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410131,
					"content": "嘿嘿，明明没有和可莉商量过，却起了完全一样的名字，看来我俩的想法超级合拍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410132,
					"content": "喵呜~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410133
					],
					"speakerTitle": "「大桔骑士」"
				},
				{
					"id": 705410133,
					"content": "或许是因为后遗症，它面对每个人都紧张兮兮，过度戒备，小队的武器官和信号官总是被它欺负，可莉又不会经常到驻地来玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410134
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410134,
					"content": "#现在看来，「大桔骑士」似乎很喜欢{NICKNAME}和派蒙。队里的大家应该也想不到，「大桔骑士」会这么亲近人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410135
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410135,
					"content": "毕竟是伟大的猫猫救星，荣誉骑士和白猫魔法师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410136
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410136,
					"content": "#不管是多凶多吓人的猫，和{M#他们}{F#她们}一起玩了以后，都会变得乖巧可爱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410137
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410137,
					"content": "#既然如此，{NICKNAME}和派蒙愿意收养「大桔骑士」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410138
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410138,
					"content": "咦？这样没关系吗？「大桔骑士」不是你们的队猫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410139,
					"content": "临时队猫的头衔也是出于无奈，我们本来打算在「大桔骑士」的状况稳定后，寻找一位好心人，正式收养它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410140
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410140,
					"content": "调查小队毕竟是骑士团的作战单位，一直待在我们身边，生活条件并不理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410141
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410141,
					"content": "熟悉它的骑士们终归是要出勤的，把「大桔骑士」留在营地里，就会让它不知所措，带着它行动的话，又会让它再次受到惊吓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410142
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410142,
					"content": "明智的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410143
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410143,
					"content": "对于受到过惊吓的动物，尽量让它远离一切刺激，才能使它慢慢走出阴影，彻底变得平和…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410144
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410144,
					"content": "这么说来，我们确实可以在尘歌壶里搭一个暖暖的猫窝，让「大桔骑士」安安心心快快乐乐地生活，再也不用担心被魔物欺负。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410145,
					"content": "喵嗷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410146,
						705410147
					],
					"speakerTitle": "「大桔骑士」"
				},
				{
					"id": 705410146,
					"content": "好耶！我们收养新的猫猫！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410148
					]
				},
				{
					"id": 705410148,
					"content": "实在太谢谢你啦，阿贝多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410149,
					"content": "别客气，等到你们不忙时，还可以带着「大桔骑士」来驻地，看望一下调查小队的大家，让大家见见它乖巧时的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410150
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410150,
					"content": "真是…真是令人感动，我见证了意义非凡的领养现场！这应该是「猫茸茸城堡」帮助流浪动物找到新家的第一个案例！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410151
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410151,
					"content": "喂，别拿我的头巾擦眼泪啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410152
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410152,
					"content": "说起来，原来罗莎莉亚修女喜欢和小动物打交道吗？有点令人意外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410153
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410153,
					"content": "对哦对哦，我好像感觉到了！罗莎莉亚对猫猫应该也有一种亲和力，只不过自己也没有发现，一般不会表现出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410154,
					"content": "一开始，「雪糕」也亲近了罗莎莉亚，「大桔骑士」刚来的时候，也是罗莎莉亚稳住了它的情绪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410155,
					"content": "呃…我只是一直在旁边看着热闹而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410156
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410156,
					"content": "我悟了！罗莎莉亚小姐！最近我从荣誉骑士和白猫魔法师那里学到了好多好多安抚猫猫的技巧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410157
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410157,
					"content": "我决定延长试营业的时间，好好领会这几天的学习成果，迅速成长为…嗯…猫猫见习魔法师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410158
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410158,
					"content": "到时候，我们继续一起管理「猫茸茸城堡」，一起帮帮全蒙德的流浪猫，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410159
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410159,
					"content": "罗莎莉亚要继续协助瓦乐瑞娜吗…猫猫魔法师和猫猫修女？是很特别的组合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410160,
					"content": "罢了…这份差事的感觉还不错，工作不多，没什么烦人的点。这样的热闹，继续看下去也无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410161
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705410161,
					"content": "虽说不太了解流浪动物收养的细节，但你们似乎迈过了一个里程碑，恭喜你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410162
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410162,
					"content": "之后我会提醒其他骑士，要是遇见了不知该如何处置的流浪猫，就优先送到你们这里来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410163
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 705410163,
					"content": "太太太太太感谢各位的支持了！我要给各位一大笔酬谢金！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410164
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410164,
					"content": "「猫茸茸城堡」的试营业阶段超级成功！等到正式开张时，我一定宴请几位来剪彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410165
					],
					"speakerTitle": "瓦乐瑞娜"
				},
				{
					"id": 705410165,
					"content": "圆满成功，好心情和摩拉双收，还领养了特别的「大桔骑士」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410166
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410166,
					"content": "我也开始期待「猫茸茸城堡」开业的那天啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410167,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「大桔骑士」"
