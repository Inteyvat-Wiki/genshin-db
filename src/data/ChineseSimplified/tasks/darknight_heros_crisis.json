			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪卢克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "迪卢克老爷！快听我说，刚刚我们在骑士团…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650202,
					"content": "是深渊教团下的战书吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650203,
					"content": "我已经知道了，谢谢你们特地跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650204,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650205,
					"content": "晨曦酒庄的情报网可并不限于商业情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650206,
					"content": "那么迪卢克老爷打算怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650207,
					"content": "你们的意见呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650208,
					"content": "还是和骑士团联手吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "那样就正中深渊教团的下怀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650210,
					"content": "他们看准我与骑士团合不来，想要逼我在他们面前现身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650211,
					"content": "一旦我的身份暴露，以后的行动就难免会受到骑士团的干预。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650212,
					"content": "毕竟没有哪个掌控着权力的组织，甘愿由外人来「代行正义」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650217,
					"content": "唔…深渊教团这下可真是出了个大难题呀，好狡猾的家伙们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650218,
					"content": "办法还是有的，只是需要先建立一些情报优势…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650219,
					"content": "…战书里的那些被刻意掩盖的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4650220,
					"content": "刻意掩盖？你指的是看不懂的那些部分吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650221,
					"content": "想必那是一种只有他们才懂的，在内部流传的「暗文」格式。",
