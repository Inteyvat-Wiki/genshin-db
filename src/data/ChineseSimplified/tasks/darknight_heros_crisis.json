			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "霍夫曼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650102,
					"content": "哦，是你们。感谢你们二位的配合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650103,
					"content": "上次我们聊到「暗夜英雄」的事…请问还有其他情报可以提供吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650104,
					"content": "我可以先问问发生什么事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "说的也是，提问之前自己要先提供必要的情报，是我疏忽了骑士的礼节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650108,
					"content": "其实事情是这样的…你们先看看这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650109,
					"content": "呜哇，好丑的字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650110,
					"content": "唔，仔细看看…好像有很多地方看不太懂的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650111,
					"content": "确实，虽然是「通用语」，但很多地方写成了「密文」的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650112,
					"content": "只看可以读懂的部分倒是也能大致理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650119,
					"content": "这是，深渊教团对「暗夜英雄」下的战书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650113,
					"content": "也就是说「暗夜英雄」彻底被坏蛋盯上咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4650114,
					"content": "这么说没错。所以可能的话，我们希望尽早与他一同商议对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650115,
					"content": "毕竟这不仅是「暗夜英雄」一个人的事，也是整个蒙德城的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650116,
					"content": "谢谢你分享情报。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "嗯，最近如果有什么发现，欢迎随时来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 4650117,
					"content": "我会留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "抱歉，真的没有别的情报了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "是吗…那可真是遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 46502,
			"completionStepIds": [
				46505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
