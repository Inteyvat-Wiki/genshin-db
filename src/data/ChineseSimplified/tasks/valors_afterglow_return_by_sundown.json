	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "你好，前辈！请找个地方坐坐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360402,
					"content": "关于冒险的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "你是想问，为什么我之前那么倔强，让大家如此费心吗？哈哈…我知道错啦，请不要再教训我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360404,
					"content": "不过话说回来，对「危险」的痴迷，或许是我们这些冒险家的本性吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360405,
					"content": "毕竟我们生来拥有坚韧的脊梁，轻捷的四肢…一想到身怀利器却安于无风无浪的一生，就总觉得不甘心呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360406,
					"content": "至于致命的风险，我也不是没有考虑过，但…嗯，我可以问你一个问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360407,
					"content": "请说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "蒙德的大冒险家斯坦利因他横穿烬寂海的壮举而闻名…他在这场冒险中失去了自己的挚友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360409,
					"content": "因为他的这场冒险，那位死去的挚友…尽管很少有人知道他的名字是什么，但关于他的记忆却在冒险家中间流传至今。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360410,
					"content": "我在想…哈哈，请前辈不要笑我幼稚。斯坦利那位再不归来的友人…会不会并未逝去，而是正在真正地「活着」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360411,
					"content": "唯有生命本身才最重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "但为人所铭记这件事本身…即使事业令他早夭，不也是一种生命的延续吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360413,
					"content": "就这样借助他人的憧憬与纪念，评价与凝视…以另一种方式活在众人中间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360422,
					"content": "请不要太过在意别人的看法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "已经有很多人这样劝过我了，「做你自己就好」「管好自己的事情就行了」…表面上是开导人的话，终究只是劝人放弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360424,
					"content": "其实我之前就说过了，我的冒险，不是为了别人…甚至不是为了自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360425,
					"content": "嗯…你有这样想过吗，前辈…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360426,
					"content": "这个世界是由众神摆布的…但我们作为凡人，即使没有神灵恩赐的「眼」，也同样拥有不甘于安宁与遗忘的执着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360427,
					"content": "我相信这份不甘的心情并非毫无意义，所以才会不要命地跑去探索那些险地。毕竟呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360428,
					"content": "以弱小之身与纵使神灵也为之恐惧的永恒角力，这才是人之所以为「人」的理由…我是这样相信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360429,
					"content": "但赋予冒险意义的不仅你自己一人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "唔…我明白的。我不会忘记大家的帮助，不会忘记给前辈带来的麻烦的…毕竟这场冒险并不仅是我一个人的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360437,
					"content": "哈哈，这不就是冒险家嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360432,
					"content": "就这么想要逞英雄吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "比起前辈来，我差得可太远啦…比起想做英雄，唔…不如说是，「想活着的人才不怕会死于非命」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360434,
					"content": "这话是一个须弥的前辈告诉我的，她也是在「镀金旅团」听来的就是啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360435,
					"content": "我觉得很有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360436,
					"content": "不如说是在一个劲地追求不吉利的倒霉事呢…这个人呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710360414,
					"content": "能被人记住，也是一种成功吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "唔…我从没想过过一场「成功」的人生啦。相反，即使「失败」，只要能让众人都留下印象就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360416,
					"content": "至少有人会说：「志琼这个人，也是挑战过层岩巨渊的啊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360417,
					"content": "至少不会像那些牺牲在无人之地的前辈一样…至少不会像现在的我一样，被人遗忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360418,
					"content": "从来没想过这种问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "这样吗…？或许那是因为像前辈这样的外来人，无论在哪里出现都会自然而然地成为视线的焦点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360420,
					"content": "就像含着金汤匙出生的孩子，也只会把贫穷当成一场并非必需的刺激冒险一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710360421,
					"content": "啊，抱歉…我不是那个意思，我只是说…没什么。当我没有问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志琼"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "又是志琼那家伙，她去回收信标了…但现在还没回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380202,
					"content": "本来我也知道她那喜欢到处乱跑的臭毛病，给她多预留了三个小时回程…可现在都已经至少五六个小时了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380203,
					"content": "那个孩子很尊敬你，还请你帮忙找找她吧。我可不希望再有人在我眼皮底下出事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380204,
					"content": "嗨呀！这家伙怎么回事啦！怎么又跑丢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710380205,
					"content": "好的，我这就去。",
					"roleType": "TALK_ROLE_PLAYER",
