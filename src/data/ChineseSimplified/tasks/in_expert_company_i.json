			"dialogs": [
				{
					"id": 740510301,
					"content": "太好了，映影机完好无损，里面的映影也没有被破坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510328,
					"content": "谢天谢地，我还以为又要从头开拍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510302,
					"content": "你们为什么在这里拍映影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "看起来你们也不是枫丹人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "这事情就说来话长了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510304,
					"content": "简短截说吧。我们三个人来自于璃月的「翘英庄」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510305,
					"content": "庄里的人大部分都是做茶叶生意的，但我们…对茶叶生意没什么兴趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510306,
					"content": "所以就转了行，去帮庄里的茶叶商拍宣传用的记录映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510307,
					"content": "其实是做茶叶生意的人太多，我们原本的生意比不过他们啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "弈丰"
				},
				{
					"id": 740510308,
					"content": "店里的好手也一个接一个地跑去别家干活，再做茶叶生意，我们就没饭吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 740510309,
					"content": "你们两个…就不能说点好听的吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510310,
					"content": "给庄里的茶叶拍宣传映影这件事，赚得也不少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510311,
					"content": "可是，最近庄里也有其他人开始拍宣传映影了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "弈丰"
				},
				{
					"id": 740510312,
					"content": "有的映影里还有人唱戏呢，派头可大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 740510313,
					"content": "所以我们才来枫丹，寻求映影专家的建议啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510314,
					"content": "所以，你们是来枫丹学拍摄映影的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "没错。我们找到了一个名叫热塞尔的「映影专家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510316,
					"content": "他很擅长在映影中用光影来…那什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510317,
					"content": "「叙事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "弈丰"
				},
				{
					"id": 740510318,
					"content": "对！用光影来「叙事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510319,
					"content": "有了热塞尔先生的指导，我们一定能拍出整个翘英庄里最好的映影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510320,
					"content": "老板，你上个月才说要拍出整个璃月里最好的映影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 740510321,
					"content": "做生意就是要合理地调整自己对未来的预期…你懂什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510322,
					"content": "总之，感谢您的帮忙，旅行者，这些钱请您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510323,
					"content": "兴晔、弈丰，把东西赶紧架起来！今天必须把样片拍完，拿过去给热塞尔先生看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510324,
					"content": "注意打光！镜头要…这么对着光源，打出一个…有高级质感的光线！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510325,
					"content": "你们都看过那本书了吧，光影要有质感，质感你们明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "邱老板"
				},
				{
					"id": 740510326,
					"content": "老板，虽然热塞尔先生的那本书我们的确都看过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "兴晔"
				},
				{
					"id": 740510327,
					"content": "但就凭这个镜头，就算我们再折腾，拍出来的光线质感也高级不到哪去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弈丰"
				}
			]
		},
