				]
			},
			"dialogs": [
				{
					"id": 733520101,
					"content": "异乡的旅者和小朋友，你们好啊，花神诞祭玩得还开心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520102,
					"content": "要是两位还有兴致，我「幻之玩具王」诚邀你们来玩玩新游戏——只在花神诞祭期间才开放的「花车摇曳」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520103,
					"content": "花车摇曳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733520104,
					"content": "一听这个名字，我好像能想象出…纳西妲坐在花车里开心摇摆的画面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733520105,
					"content": "听得我也有点开心了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "好呀，「草神大人每天都快快乐乐」是我们这些须弥人的愿望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520108,
					"content": "你们的联想…是何等美妙的画面，值得画成一幅华丽的绘卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520109,
					"content": "不过，这个游戏的氛围更加活泼，比起欣喜的庆祝，更像是一场历险——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520110,
					"content": "「无论聪明与否，不管乖巧还是顽皮，每个拥有美好心灵的孩子，都在花神诞祭的庆祝上得到了一辆自己的花车…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520111,
					"content": "「乘着这辆花车，孩子们开启了自己独一无二的旅程，遭遇了惊险，也成功化险为夷，寻得了千朵鲜花的至宝…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520112,
					"content": "派蒙聪明又乖巧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "嘿嘿，说得对！千朵鲜花的至宝，我们也能拿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733520115,
					"content": "那就请两位尽情游玩，好好享受游戏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麦斯欧德"
				},
				{
					"id": 733520113,
					"content": "我们都很擅长化险为夷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "听得我想看纳西妲摇摆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}