			},
			"dialogs": [
				{
					"id": 726850101,
					"content": "你好啊，容彩祭的客人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850102
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850102,
					"content": "来试试全新版本的「机关棋谭」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850103,
						726850119
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850103,
					"content": "「机关棋谭」是什么?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850104
					]
				},
				{
					"id": 726850104,
					"content": "是一种来自璃月的桌上「游戏」，很有意思哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850105
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850105,
					"content": "「机关棋谭」的发明者是瑞锦小姐，她给了我「海外代理」的资格，让我在稻妻推广这款「游戏」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850106
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850106,
					"content": "最近我一直在和瑞锦小姐书信来往，和她一起改进「机关棋谭」的玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850107
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850107,
					"content": "正巧，我们刚刚完成新的规划，就收到了「光华容彩祭」即将举办的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850108
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850108,
					"content": "决定参展后，过了一段时间，我听说会有一位大人物到场，考察「机关棋谭」的商业潜力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850109
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850109,
					"content": "那我就更得加把劲了！希望大家都能喜欢有趣的「机关棋谭」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850110
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850110,
					"content": "你们想体验一下「机关棋谭·巧策之局」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850111
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850111,
					"content": "「巧策之局」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850112
					]
				},
				{
					"id": 726850112,
					"content": "简单来说，是「机关棋谭」的最新玩法，灵感来源于璃月棋类游戏中的「残局」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850113
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850113,
					"content": "在「巧策之局」的棋局揭晓之时，棋盘上已经布置了一些机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850114
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850114,
					"content": "棋手们需要分析局势，决定如何利用这些机关，谨慎取舍，思考取胜的对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850115
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850115,
					"content": "相比以前的版本，「巧策之局」的节奏更快，也更考验棋手的判断力，相当具有挑战性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850116
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850116,
					"content": "那就试试看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850117
					]
				},
				{
					"id": 726850117,
					"content": "希望「巧策之局」能为你带来满意的体验！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850118
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850118,
					"content": "游玩「机关棋谭」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 726850119,
					"content": "又见面了，驹形小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850120
					]
				},
				{
					"id": 726850120,
					"content": "啊呀，没想到你还记得我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850121
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850121,
					"content": "上次多亏了你！你发掘了很多奇妙的玩法，让我意识到「机关棋谭」还有很大的改进空间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850122
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850122,
					"content": "「灵妙之局」的推广活动结束后，我就写信给瑞锦小姐，表达了我的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850123
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850123,
					"content": "没想到瑞锦小姐的想法居然和我一样！我果然是个合格的「海外代理」啊，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850124
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850124,
					"content": "总之，我和瑞锦小姐多次交流后，一同推出了最新版的「机关棋谭」，就是现在这款「巧策之局」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850125
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850125,
					"content": "「巧策之局」的灵感来源于璃月棋类游戏中的「残局」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850126
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850126,
					"content": "在「巧策之局」的棋局揭晓之时，棋盘上已经布置了一些机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850127
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850127,
					"content": "棋手们需要分析局势，决定如何利用这些机关，谨慎取舍，思考取胜的对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850128
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850128,
					"content": "相比以前的版本，「巧策之局」的节奏更快，也更考验棋手的判断力，相当具有挑战性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850129
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850129,
					"content": "听起来很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850130
					]
				},
				{
					"id": 726850130,
					"content": "是吧是吧！我已经等不及要看客人们游玩后的反应了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850131
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850131,
					"content": "经过一段时间的代理，我也差不多上道了。所以我打算趁着容彩祭，让更多人熟悉这款「游戏」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850132
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850132,
					"content": "听说还会有大人物到场，考察「机关棋谭」的商业潜力呢！希望容彩祭能成为「机关棋谭」火爆的契机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850133
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850133,
					"content": "怎么样，现在就试试「巧策之局」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850134
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726850134,
					"content": "游玩「机关棋谭」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
