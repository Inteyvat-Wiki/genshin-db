			"dialogs": [
				{
					"id": 740660301,
					"content": "前台登记处…就是这里啦！我们去碰碰运气吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660302,
					"content": "莫莱妮小姐，你好~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660304,
					"content": "（呜哇——感觉好难相处的样子。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660305,
					"content": "（要不试试「交涉的艺术」？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "（对哦，还有这个呢！没想到这本书还能在这里派上用场。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660307,
					"content": "我看看…找到啦！「如果你先声夺人在气势上压倒了对手…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660308,
					"content": "就是这个！气势上压倒对手！我明白了！总而言之声音大一点就好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660309,
					"content": "喂喂——莫莱妮小姐，你好——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660310,
					"content": "…听见了，请问您需要帮助吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660311,
					"content": "欸？居然真的有用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660312,
					"content": "#嘿嘿，莫莱妮小姐，我们是来接受满意度调研的！啊，不对，我是陪{M#他}{F#她}来的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660313,
					"content": "#（别担心{NICKNAME}，我们有这本书。我会偷偷看书提醒你的！总之…嗯！总之你听我指示就好。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660314,
					"content": "又是看到书里的通知来的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660315,
					"content": "嗯！对呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660316,
					"content": "到底放了多少张啊…其实…唉，算了，没事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660317,
					"content": "咳咳，请您稍等…我先解释一下规则。本次的问卷一共有5个问题，请根据直觉快速回答。请注意，快速回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660318,
					"content": "明白了吗？等您准备好了我们就开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫莱妮"
				}
			]
		},
