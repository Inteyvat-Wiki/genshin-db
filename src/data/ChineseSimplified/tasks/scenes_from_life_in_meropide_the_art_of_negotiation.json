			"dialogs": [
				{
					"id": 740660201,
					"content": "——「交涉的艺术」…？哼，看书名就很无聊！我才没兴趣呢…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660202,
					"content": "咦？这里还夹着一张通知？唔…「前往前台登记处参与特许食堂内部满意度调研，有机会获得特许券奖励…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660203,
					"content": "「特许券」…哇！你看到了吗？有特许券可以领欸！没想到还有意外收获，我们赶快去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
