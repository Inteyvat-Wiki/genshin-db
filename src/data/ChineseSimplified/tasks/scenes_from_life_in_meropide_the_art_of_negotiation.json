			"dialogs": [
				{
					"id": 740660901,
					"content": "（我已经准备好啦！放马过来吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660902,
					"content": "第一问，请问您认为保持现今特许食堂内食物的低廉价格是否合理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660903,
					"content": "（唔——这个可怎么回答啊？我找找…找到了！就试试这个万能公式吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660904,
					"content": "（书上说这个「我同意你的观点，但…」什么情况都可以用。即使是深渊法师都会跟你好好交流，感觉好像很厉害的样子。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660905,
					"content": "合理，派蒙很喜欢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "嗯…？那么难吃的东西，白送我我都不要啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660907,
					"content": "可万一没有伙食费了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "唔…你这么一说还真是…不、不对！那我宁愿饿着也不吃这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660918,
					"content": "咳咳，打断一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660919,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660920,
					"content": "根据规定，本项调研需要快速作答，我们先继续下一题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660921,
					"content": "好，好吧…既然是规定的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660922,
					"content": "第二问，请问就餐时间内特许食堂的食物供给是否充足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660923,
					"content": "买倒是能买到…但是真的很难吃啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660924,
					"content": "是的，比提瓦特大陆的薄荷多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "那我宁愿吃薄荷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660926,
					"content": "真的？那今天吃薄荷沙拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "不要！我两个都不要吃！呜呜，我想吃甜甜花酿鸡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660928,
					"content": "总之…回到问卷上来？那我就写「是」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660935,
					"content": "唉…好累，我们开始下一问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660936,
					"content": "在第三问之前我想重新提醒一下，本项调研是需要快速作答的。所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660937,
					"content": "那么第三问，请问现有的随机出餐制度是否充满趣味性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660938,
					"content": "多关注一下味道啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660939,
					"content": "我同意你的观点，但…随机出餐不是会有一种完全不知道接下来会吃到什么的惊喜感吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660940,
					"content": "对哦…听你这么一说还真的感觉很有趣欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660941,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "怎么啦？莫莱妮小姐确实说的很有道理啊，感觉很难不认同呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660943,
					"content": "咳，请快速作答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660944,
					"content": "有趣，包括签文也很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "对！每次还有那个签文，就像抽签一样，很不错呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660946,
					"content": "「努力工作，就能获得成功！」感觉很棒呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660947,
					"content": "向导的工作的的确很辛苦呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660957,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660958,
					"content": "第四问，您认为特许食堂有嗜好品出售是否合理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660959,
					"content": "（欸？欸？怎么语速突然快起来了？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660960,
					"content": "（「先声夺人」？「话题引导」？不对不对好像都不对。要不然…还是万能公式吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660961,
					"content": "（不太对…这些问题…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "咳，请不要过度思考，也不要闲聊。就像我们刚才说的，根据直觉，快速作答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660964,
					"content": "很合理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "好，感谢您的作答。然后是最后一问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660968,
					"content": "被无视了？ 我们的回答根本不重要吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660969,
					"content": "基于上述的几个问题的答案，请问您是否满意特许食堂的现状？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660970,
					"content": "之前问的什么来着？好像有点记不清楚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660971,
					"content": "没关系的，就当是都满意就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660972,
					"content": "那好吧…但我总觉得哪里不太对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660973,
					"content": "顺便一提，回答「否」的话，会没有特许券的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660974,
					"content": "太过分了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660975,
					"content": "#那这位{M#先生}{F#女士}呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660976,
					"content": "不要无视我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660977,
					"content": "是的，很满意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "好的。感谢配合，您的支持就是我们进步的动力。请在这边签名并领取特许券。旁边的智能飞行发条装置也可以一起签名领取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660983,
					"content": "欸？我也有份？！我还没参加呢，真的可以吗？等一下，我是派蒙！不是什么飞行发条装置啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660984,
					"content": "好的。总之我们的原则是尊重所有的建议，所以人人…人机有份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660985,
					"content": "都说了不是飞行发条装置，是派蒙啦！别无视我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660986,
					"content": "了解了…总之为了帮您节省宝贵的时间，我可以代为填写问卷。别担心，特许劵的发放数量是一样的，不会有任何差别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660987,
					"content": "我猜您所有的答案都是「满意」对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660988,
					"content": "嗯！特许券！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660989,
					"content": "既然这样的话，您只用在这里签名，剩下的就交给我好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660990,
					"content": "好耶！既能拿特许券又可以省去麻烦，那就麻烦你啦，莫莱妮小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660991,
					"content": "感谢您的支持，请拿好您的特许券，我们下次调研再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660992,
					"content": "在领取了特许券后，你和派蒙告别了莫莱妮小姐。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "#{NICKNAME}现在回头想想…感觉莫莱妮小姐根本不在意我们回答了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660994,
					"content": "是问题设置的原因吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "——唔，对。那个问卷的确好奇怪。还有…感觉莫莱妮小姐也好疲惫呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660996,
					"content": "「交涉的艺术」失败了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "什么「交涉的艺术」嘛，这种书果然一点用都没有!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660998,
					"content": "是的，是书的问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "对吧对吧，你也觉得是书有问题吧？不过看在特许券的面子上，这次就算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740661000,
					"content": "不对，是派蒙的问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "欸——？可是，我都是按照这个书上写的方法来的啊。你看，「所以我就是要大声…」。果然还是书的错嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740661002,
					"content": "我同意你的观点，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "喂——不许这么糊弄我！什么「交涉的艺术」嘛，果然一点用都没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660978,
					"content": "不，完全不满意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "不不不，还是填满意吧，就当是为了特许券…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660980,
					"content": "满意是吗？明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660981,
					"content": "虽然很满意，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "不合理，应该…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "我同意你的观点，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "（这是在…话题引导？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "不有趣，因为根本吃不到我想要的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "…每次都是奇怪的味道。哪里来的惊喜感嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660951,
					"content": "我同意你的观点，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "要是每吃十八次就能送一次美味的食物就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660953,
					"content": "为什么是十八次？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "我是听别人说的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660955,
					"content": "好像是…唔——因为一天正好三顿饭，到周日之前正好六天。然后六天就是十八顿饭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660956,
					"content": "等到第七天就能吃到好吃的！每周都有好心情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660929,
					"content": "不够，韦尔赛先生自己都吃不到！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "他根本就是不想吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660931,
					"content": "明白了，总之就是不充足对吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660932,
					"content": "我同意你的观点，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "但反正我们不吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660934,
					"content": "唉…我知道你们看过那本书啦…总而言之，我写「是」就可以了对吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660909,
					"content": "不合理，我要求涨价！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660910
					]
				},
				{
					"id": 740660910,
					"content": "欸？！为什么啊?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660911,
					"content": "不要最好的，就要最贵的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "这是什么奇怪的想法啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660913,
					"content": "你…你还好吗…感觉你不太对劲，不会是吃了什么奇怪的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660914,
					"content": "我同意你的观点，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660915
					]
				},
				{
					"id": 740660915,
					"content": "但？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660916
					],
					"speakerTitle": "莫莱妮"
				},
				{
					"id": 740660916,
					"content": "#但还有提升的空间！如果要再好吃一点就好了，你说对不对{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660917,
