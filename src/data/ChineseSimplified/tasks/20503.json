					"nextDialogs": [
						205030502,
						205030503
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030502,
					"content": "采到铁块了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "哦对，好像有这么回事，我都忙忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030505,
					"content": "还行吧，看这成色，不是不能用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030506,
					"content": "想委托锻造",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030503,
					"content": "你之前让我去采铁块…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				}
			]
		},
