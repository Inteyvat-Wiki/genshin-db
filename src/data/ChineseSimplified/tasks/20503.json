				{
					"id": 205030601,
					"content": "以后找到了矿石，都可以来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030602,
					"content": "当然，最好是在我不忙的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030603,
					"content": "感觉你心情不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "打铁要全神贯注，我不喜欢和客人闲聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030605,
					"content": "手艺好，生意就好，做其他的都是投机取巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030606,
					"content": "没事的话，我就继续忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦格纳"
