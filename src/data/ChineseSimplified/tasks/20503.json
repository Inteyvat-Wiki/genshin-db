			"dialogs": [
				{
					"id": 205030201,
					"content": "什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030202,
					"content": "想看看武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "都在那边，自己挑吧。想要更称手的，我也能定做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030207,
					"content": "原来还能定做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205030208,
					"content": "当然。贩卖，定做，精炼，都是铁匠铺的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030209,
					"content": "只要你有矿石就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030210,
					"content": "在哪里能找到矿石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "哪里都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030214,
					"content": "这样吧，看你迷迷糊糊的，我把附近铁块比较多的地方告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030215,
					"content": "如果你能把铁块带回来，我就帮你锻造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030216,
					"content": "好的，谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "用不着。那我继续忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030212,
					"content": "你这里卖吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "找别人去，我自己都不够用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "瓦格纳"
				},
				{
					"id": 205030204,
					"content": "想帮派蒙看看武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "没听说这回事啊！要让我打头阵吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205030206,
					"content": "这么小一只，嗯，那要定做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "瓦格纳"
				}
			]
		},
