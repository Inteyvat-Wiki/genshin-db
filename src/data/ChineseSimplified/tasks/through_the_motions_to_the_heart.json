			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"谢尔盖",
					"舒伯特",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220501,
					"content": "（这个人，我好像在哪里见过…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220502
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220502,
					"content": "请问，这位是？请不要随随便便把信不过的人带进来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220503
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220503,
					"content": "#这是我找来的新的盟友，我以劳伦斯的名字起誓，你可以完全相信{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220504,
						101220505
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220504,
					"content": "请多指教。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220506
					]
				},
				{
					"id": 101220506,
					"content": "我们的计划是机密，不应当中途让外人参与。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220507
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220507,
					"content": "更何况我听说了有一位加入了骑士团的外来者，最近在蒙德附近十分活跃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220508
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220508,
					"content": "#那不可能，这个人精通旧贵族的礼仪，所以我也要以尊重与信任回敬{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220509
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220509,
					"content": "骑士团的人对这种东西从来都是不屑一顾，绝对不可能掌握得这么好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220510
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220510,
					"content": "还有这个家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220511
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220511,
					"content": "我怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220512,
					"content": "行了！连我说的话你都不信任了吗？别忘了是谁在支援你们在蒙德的行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220513
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220513,
					"content": "要是少了劳伦斯家族的支持，你们早就被骑士团赶走了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220514
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220514,
					"content": "你应该立刻向我被冒犯的朋友，呈上最诚挚的歉意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220515
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220515,
					"content": "嘁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220516
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220516,
					"content": "好好好，既然是你说的，我就不再追究什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220517
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220517,
					"content": "直接切入正题吧，你许诺的蒙德城防图，已经带来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220518
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220518,
					"content": "（一上来就是这么劲爆的交易？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220519,
					"content": "啊，当然，就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220520
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220520,
					"content": "我看看…呃，为什么这么丑？线条歪歪扭扭的，这方块和圆圈又是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220521
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220521,
					"content": "你说什么？这是我花了好长的时间才一点一点画下来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220522
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220522,
					"content": "那也不是什么方块和圆圈！是代表西风骑士的标记！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220523
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220523,
					"content": "唉，行吧，简陋了点，勉强能看懂。你能保证这些信息全都可靠吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220524
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220524,
					"content": "那当然，放心好了。你也别忘了我们的约定，要让劳伦斯家族的旗帜飘扬在骑士团总部的楼顶上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220525
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220525,
					"content": "那栋楼的归属权，还有整个城市的直接管理权，都属于劳伦斯家族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220526
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220526,
					"content": "嗯，双赢的交易，没必要讨价还价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220527
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220527,
					"content": "我们会好好利用这份情报。对了，考虑到外交影响，请不要在任何场合暴露我们的身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220528
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220528,
					"content": "放心放心，这件事天知地知你知我知，还有我这位朋友知，不会再有别人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220529
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220529,
					"content": "到时候我站在骑士团总部的楼顶，痛骂他们对蒙德的软弱统治。所有的市民，都要再度臣服于劳伦斯的脚下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220530
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220530,
					"content": "哈哈，都回来了，全都回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220531
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220531,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220532
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220532,
					"content": "最后提醒一句，不要贸然行动，那就这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220533
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220533,
					"content": "那就这样吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220534
					]
				},
				{
					"id": 101220534,
					"content": "那就这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220535,
					"content": "怎么了，突然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220536,
						101220537
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220536,
					"content": "不用再装下去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220538
					]
				},
				{
					"id": 101220538,
					"content": "#蒙德城西风骑士团荣誉骑士，{NICKNAME}！和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}最好的伙伴，派蒙！要粉碎你们的邪恶计划！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220539,
						101220540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220539,
					"content": "…用力过猛了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220541
					]
				},
				{
					"id": 101220541,
					"content": "你、你居然敢骗我！用我们引以为傲的礼貌与优雅，骗取我的信任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220542
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220542,
					"content": "那是因为你太盲目相信这种东西了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220543,
					"content": "计划了这么久，居然这样就败露了…你给我等着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220544
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220544,
					"content": "唉，果然如此吗，一开始就不该相信这种蠢货贵族的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220545
					],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220545,
					"content": "不过情报到手，我也不用浪费时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "谢尔盖"
				},
				{
					"id": 101220540,
					"content": "不用这么夸张也没关系的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220541
					]
				},
				{
					"id": 101220537,
					"content": "我摊牌了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220538
					]
				},
				{
					"id": 101220505,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220506
					]
				}
			]
		},
		{
			"id": 1012206,
			"completionStepIds": [
				1012212
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012212",
							"2"
						],
						"stepId": 1012212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"舒伯特",
					"优菈",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220601,
					"content": "别碰我，闪开！我自己会走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220602
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220602,
					"content": "看起来是赶上了，这里确实有很多愚人众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220603
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220603,
					"content": "哦，是你，调查已经有收获了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220604,
						101220605
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220604,
					"content": "完全不费工夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220606
					]
				},
				{
					"id": 101220606,
					"content": "难道，这家伙的礼仪，全都是从你那里学的？你不是从来都不把这些东西放在心上吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220607
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220607,
					"content": "而且，家族有规矩，这些东西是不可以教给外人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220608
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220608,
					"content": "哦，好像是有这么回事来着。然后呢？好像也没有不能这么做的理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220609
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220609,
					"content": "你…你这是触犯了家里的大忌！害得我准备了好久的计划，都泡汤了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220610
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220610,
					"content": "我知道叔父花了很大的力气，但你也知道这是不该做的事，作为西风骑士，我没有理由视而不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220611
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220611,
					"content": "还西风骑士，搞清楚！我是你的叔父！你是劳伦斯家族的人，应该帮助家族重获荣光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220612
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220612,
					"content": "你现在还有争取原谅的机会，把这里的西风骑士全都干掉，跟我一起走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220613
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220613,
					"content": "那我就会在家里为你求情，给你一个改过自新的机会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220614
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220614,
					"content": "没听懂，你要西风骑士去干掉西风骑士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220615
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220615,
					"content": "再重复一次，你才不是什么西风骑士，你是我们家族的末裔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220616
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220616,
					"content": "你是流着劳伦斯家族之血的贵族！应该要顺应家族的意志！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220617
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220617,
					"content": "…可是，从以前到现在，我什么时候顺应过家族的意志？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220618
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220618,
					"content": "你、你…！你这个大逆不道的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220619
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220619,
					"content": "真要发脾气，生气的也应该是我才对。你明知你是劳伦斯家族的一员，还在搞这种威胁蒙德安全的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220620
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220620,
					"content": "你想过你给多少人添了麻烦吗？你又想过，为了平息这次的事，我要和多少人结仇吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220621
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220621,
					"content": "你在教训我？你居然敢教训我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220622
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220622,
					"content": "是的，我在教训你。叔父，以你最看重的劳伦斯家族之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220623
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220623,
					"content": "我没有经历过你所说的「荣光」的时代，也不理解家族对此狂热的追求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220624
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220624,
					"content": "但我有能力判断是非对错，也深知「自由」对蒙德人的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220625
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220625,
					"content": "——劳伦斯家族不会，也不应该变成你心中的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220626
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220626,
					"content": "唔，唔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220627
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220627,
					"content": "家门不幸！家门不幸啊！家里怎么出来你这么一个大逆不道的怪物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220628
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220628,
					"content": "看上去一幅歇斯底里的样子。总是挂在嘴边的礼貌和优雅，完全不见了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220629,
					"content": "不太明白你在吵什么。麻烦两位把他带走吧，我和荣誉骑士，接下来还有事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220630
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220630,
					"content": "既然你们动手了，就说明已经掌握决定性的证据了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220631,
						101220632
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220631,
					"content": "愚人众手上有一张城防图。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220633
					]
				},
				{
					"id": 101220633,
					"content": "我偷偷看了一眼，你的叔父靠观察和绘画，把西风骑士的巡逻路线，还有其他好多信息，都标记出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220634,
					"content": "唉，原本觉得他只是个不务正业的长辈，没想到在这种事上，居然这么执着。这个仇我也记下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220635
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220635,
					"content": "剩下的话等会儿再说吧，我们要先把那张图纸抢回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220632,
					"content": "愚人众在计划危险的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220633
					]
				},
				{
					"id": 101220605,
					"content": "进展太快了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220606
					]
				}
			]
		},
		{
			"id": 1012207,
			"completionStepIds": [
				1012214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012214",
							"2"
						],
						"stepId": 1012214,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"优菈",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220701,
					"content": "就是这个，不过不知道他们有没有趁这个机会制作出备份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220702
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220702,
					"content": "不过，如果没有叔父当他们的傀儡，就算攻打蒙德也没有什么好处吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220703
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220703,
					"content": "愚人众应该不至于一定要依靠你的叔父吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220704,
					"content": "的确，但如果不是想要靠扶持傀儡来接管蒙德，单纯只是进攻，就没必要绕这个弯子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220705
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220705,
					"content": "就算愚人众很不老实，也不至于现在就要对外开战，那样的话他的对手可不止蒙德一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220706,
						101220707
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220706,
					"content": "我也是这么想的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220708
					]
				},
				{
					"id": 101220708,
					"content": "总之，这层隐患我也会告诉代理团长，她会妥善处理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220709
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220709,
					"content": "对了，你为什么会跟来呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220710
					]
				},
				{
					"id": 101220710,
					"content": "对哦，你出现的时机也太巧了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220711,
					"content": "这个嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220712
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220712,
					"content": "因为一开始你击败了我追踪的愚人众，抢了我的功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220713
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220713,
					"content": "所以现在我就来报仇了，既然你抢了我的功劳，那我一定要抢回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220714,
						101220715
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220714,
					"content": "原来图纸就是你的「复仇」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220716,
					"content": "嘿嘿，这么长时间下来，我终于能听懂你说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220717,
					"content": "其实你只是隐约察觉到，我们这边可能会有事发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220718,
					"content": "担心我们，又担心你的叔父，所以就带着小队过来看看，是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220719,
					"content": "是报仇，不要曲解我的意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220720
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220720,
					"content": "哼，你这小家伙，看上去不太机灵，心机真的不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220721
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220721,
					"content": "这个仇我记下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220722
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220722,
					"content": "看上去不太机灵是什么意思啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220723,
					"content": "你们两个，这次我们算是结下深仇大恨了，给我等着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220724
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220724,
					"content": "就算你们化成了灰，我也绝对不会忘记你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220725
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220725,
					"content": "那我们就是「仇人」了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220726
					]
				},
				{
					"id": 101220726,
					"content": "放马过来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220727,
					"content": "哈哈哈，就是这个气势。那我就带上图纸回骑士团了，接下来的事，都交给我处理就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220728
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220728,
					"content": "嗯嗯，我们有机会再见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220729,
					"content": "当然会再见的，下次我们见面的时候，可不要让我失望了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "优菈"
				},
				{
					"id": 101220715,
					"content": "那我们扯平了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220707,
					"content": "那就本末倒置了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220708
					]
				}
			]
		},
