			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"达列尔",
					"舒伯特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220401,
					"content": "等等，这个人是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220402
					],
					"speakerTitle": "达列尔"
				},
				{
					"id": 101220402,
					"content": "我有必要告诉你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220403
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220403,
					"content": "我带来的，自然是客人。若是得罪了我们的客人，你可逃不掉劳伦斯家族的问责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220404
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220404,
					"content": "但这件事是机密中的机密，谨慎一点没有坏处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220405
					],
					"speakerTitle": "达列尔"
				},
				{
					"id": 101220405,
					"content": "贵族行事，岂容你在我面前指指点点？我不想废话，把路让开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220406
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220406,
					"content": "趾高气昂，不知道有什么本事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220407
					],
					"speakerTitle": "达列尔"
				},
				{
					"id": 101220407,
					"content": "行行行，你们请进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "达列尔"
				}
			]
		},
		{
			"id": 1012205,
			"completionStepIds": [
				1012209,
