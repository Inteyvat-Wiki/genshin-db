	"talks": [
		{
			"id": 1012201,
			"completionStepIds": [
				1012201
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012201",
							"2"
						],
						"stepId": 1012201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"舒伯特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220101,
					"content": "（帐篷破破烂烂的，却有一把看起来很不错的椅子…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220102,
					"content": "（这也是贵族的礼数之一吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220103,
					"content": "又是你们？唉，能不能不要来烦我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220104,
						101220106
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220104,
					"content": "听说贵族向来宽宏大量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220105
					]
				},
				{
					"id": 101220105,
					"content": "「宽宏大量」…有点意思，不错，正是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220108,
					"content": "行吧，我也绝非心胸狭隘之人，此前的小小不悦就既往不咎了。你若想进言，我便姑且一听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220109
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220109,
					"content": "（哇，这高高在上的姿态！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220110,
						101220112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220110,
					"content": "在那之前，烦容我表达抗争意志。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220111
					]
				},
				{
					"id": 101220111,
					"content": "原来如此，同道中人，「抗争」——即反抗无能的骑士团。你，深明大义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220114,
					"content": "表现很不错，我的本意就是对你自谦品格的试探。果然，你已经深谙此道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220115
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220115,
					"content": "（原来是试探？！这样说话也太麻烦了吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220116,
					"content": "嗯，礼数上是合格了。很难想象这么短的时间，你们就有如此进步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220117
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220117,
					"content": "如此温文明礼的遣词造句，是从何处学来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220118,
						101220119
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220118,
					"content": "蒙受友人之慧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220120,
					"content": "不错，不错，聪慧有加，和蒙德的贱民相比，实在是可造之材。假若是出自贵胄血脉，则前途不可限量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220121
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220121,
					"content": "对了，我们还有礼物…呃，咳咳，小小礼物，不成敬意，还请收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220122,
					"content": "啊，这个是…「酱菜煎肉」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220123
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220123,
					"content": "果然不是装模作样，是真的下了功夫。当今的年轻人，只要认真还是能做到的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220124
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220124,
					"content": "正好我很久都没吃…不，我的意思是，既然到了用餐时间，那我就不客气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220125
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220125,
					"content": "啊，好香，还是原来的味道，一点都没变。尤其是这股酸香，嗯——这就是贵族才能理解的享受啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220126
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220126,
					"content": "搞得我都有点好奇它的味道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220127,
					"content": "好吧，我感受到你们的诚意了。如此诚恳，一定是有求而来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220128
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220128,
					"content": "好像听说劳伦斯家有个大计划？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220129
					]
				},
				{
					"id": 101220129,
					"content": "连这都知道了吗？这本来是我们家族的机密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220130,
						101220131
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220130,
					"content": "我想助你们一臂之力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220132,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220133
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220133,
					"content": "好吧，看你礼数周全，想必是未来可期的人才，我愿意给你充分的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220134
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220134,
					"content": "那么跟我来吧，我们现在正需要更多的帮手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220135
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220135,
					"content": "要去什么地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220136
					]
				},
				{
					"id": 101220136,
					"content": "见见我们远道而来的朋友，他们将会伸出援手，帮助劳伦斯家族重现荣光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220137
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220137,
					"content": "只是因为礼数周全，就完全相信我们了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220138,
						101220139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220138,
					"content": "我也觉得，小心一点吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220140,
					"content": "好了好了，跟上来，就什么都知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220139,
					"content": "或许这也是旧贵族的「讲究」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220131,
					"content": "我想为贵族献上微薄之力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220119,
					"content": "经友人指点，引经据典，参悟而来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220112,
					"content": "此番面见，仿若在沐浴无上的光辉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220113
					]
				},
				{
					"id": 101220113,
					"content": "原来如此，同道中人，「光辉」——即存续至今的贵族荣光。你，赤胆忠心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220106,
					"content": "请允许我斗胆一言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220107
					]
				},
				{
					"id": 101220107,
					"content": "「斗胆」…有点意思，听到了一个很恰当的词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "舒伯特"
				}
			]
		},
		{
