				"objectNames": [
					"舒伯特",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220301,
					"content": "嗯？为什么要突然带上面罩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220302,
						101220303
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220302,
					"content": "不想被陌生人看见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220304
					]
				},
				{
					"id": 101220304,
					"content": "对哦，就算他们实力强大，在蒙德这片土地上，我们的地位还是远高于他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220305
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220305,
					"content": "既然如此，的确不该那么容易让他们瞻仰到你的真容，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220306
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220306,
					"content": "还好你反应够快，我还以为会露馅呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101220307,
					"content": "那我们继续前进吧，我会给他们介绍，你是我的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101220303,
					"content": "这才符合贵族的礼仪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220304
					]
				}
			]
		},
		{
			"id": 1012204,
