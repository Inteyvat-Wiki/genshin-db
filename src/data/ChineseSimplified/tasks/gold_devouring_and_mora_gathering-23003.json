			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "旅行者！啊不对，财富之子，幸运之人！你来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030202,
					"content": "上次吃了你准备的「吞金料理」，我在交易所里简直是大杀四方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030203,
					"content": "不管买入什么期货，今天过来一看，全都是大赚特赚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030204,
					"content": "走走走，去兰巴德酒馆，随便点菜，今天我请客，我要好好感谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "多亏了你们的帮忙啊，今天想吃什么随便点！哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030402,
					"content": "看来你真的赚了很多嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030403,
					"content": "放在一般人身上还行吧，不过跟我哈特姆的资产比起来，也就意思意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030404,
					"content": "毕竟我也是纵横交易所几十年的老专家了，要是你们对期货也有兴趣，我倒是可以跟你们分享一点个人的心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030405,
					"content": "上次说好了的，有额外的好处给你，你们可别跟我客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030406,
					"content": "原来好处就是指这个啊，感觉跟没好处也差不多嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030407,
					"content": "毕竟我们也不做期货…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "哪里的话，摩拉当然少不了你们那份，但比起那个，我哈特姆的指点，才是真正有价值的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030409,
					"content": "那我有个问题...真的会有史莱姆期货吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030410,
					"content": "不，不是想赚钱！就是这么问一问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030411,
					"content": "只有流通的商品才会成为期货，也就是说，如果市场上有面粉那么多、牛奶那么多的史莱姆凝液，那才有可能形成史莱姆凝液的期货交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030412,
					"content": "就和我之前说的一样。如果史莱姆凝液想要形成期货交易，那只怕野外的史莱姆都要被抓光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030413,
					"content": "而且，说不定还会出现专门饲养史莱姆，持续产出大批史莱姆凝液的机构或个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030414,
					"content": "到时候，史莱姆凝液的价格说不定也会水涨船高…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030415,
					"content": "呜哇！只不过是买点史莱姆凝液，怎么这么复杂呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030416,
					"content": "#我，我还是让{NICKNAME}直接帮我去打倒史莱姆吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030417,
					"content": "财运之子，你呢，你有什么问题的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030418,
					"content": "你是怎么研究出「吞金料理」的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "哈！果然不愧是财运之子啊，一下就问到了致富的关键。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030420,
					"content": "不能说是「研究」出的，只能说…这些「吞金料理」是我在长久的期货交易生涯里「总结」出的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030421,
					"content": "虽然期货交易市场波诡云谲…但只要有「吞金料理」在，我一定能狠狠地把握住投资之船的船舵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030422,
					"content": "果然没有根据啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "先不说了，来！吃菜吃菜！多吃一点，多吃一点，以后我还要多多请你帮忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030425,
					"content": "来！尝尝这道烤肉卷，这可是须弥的特色菜，不得不品尝啊，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030426,
					"content": "与哈特姆一起享用了美食…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "这不就是「只求心安」吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "明明是在「蓄财之地」吃下的「吞金料理」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030702,
					"content": "最后居然跌成这样…不讲道理！这个市场还有规律可言吗，有规则可讲吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030703,
					"content": "哈特姆，我们找你半天呢，你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230030704,
					"content": "是你们啊…我我…没事，我好着呢…你们看，我也没缺条胳膊少条腿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030705,
					"content": "不过就是亏走了保证金而已…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030706,
					"content": "抱。抱歉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "不！这不是你的问题，不用放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030708,
					"content": "当然，这肯定也不是我的问题，真要怪就怪这个市场太烂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030709,
					"content": "没有道理！不讲规律！说跌就跌，说涨就…他也一直就不涨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030710,
					"content": "真是，哎哟，我真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030711,
					"content": "算了算了，我还就不信了…我卡里米的不凡富翁哈特姆，还征服不了期货交易！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030712,
					"content": "你不都亏了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "哼，没关系，我还有充足的后备资金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030714,
					"content": "就算手头分文不剩了，在别处我还有周转的资金和资产呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230030715,
					"content": "等着吧，卡里米交易所，我哈特姆还会回来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		}
	]
}