					"瓦尔特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736780101,
					"content": "旅行者，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780102
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780102,
					"content": "告诉你们一个好消息，因为之前找到了雪猪存活的确凿证据，刚刚我收到了导师的来信，我的论文选题已经在学院通过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780103
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780103,
					"content": "哇，听起来很顺利呀，真是恭喜你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736780104,
					"content": "嗯，虽说开了个好头，不过后续的研究工作应该还会持续很长时间，我也做好了长期留在蒙德的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780105
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780105,
					"content": "接下来我要弄清楚的，就是雪猪们到底是以何种路径离开雪山，出现在了林子里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780106
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780106,
					"content": "根据之前找到的痕迹，我推测它们是从龙脊雪山的西侧下山，途径晨曦酒庄，然后再前往清泉镇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780107
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780107,
					"content": "如果这个推断是正确的，我们应该能够在附近发现它们的踪迹，所以今天我们的目标，就是调查这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780108
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736780108,
					"content": "原来如此。说起来你身边这位猎人打扮的大叔是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736780109,
					"content": "你们好，我叫瓦尔特，最近负责保护晨曦酒庄附近的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780110
					],
					"speakerTitle": "瓦尔特"
				},
				{
					"id": 736780110,
					"content": "你们找雪猪的事，埃德蒙德那小子已经和我说了，今天你们就跟我一起行动吧，刚好我这里的人手也很紧缺呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780111
					],
					"speakerTitle": "瓦尔特"
				},
				{
					"id": 736780111,
					"content": "唉，昨天晚上有野林猪闯进了附近的农舍，把居民养的鸽子和鸭子都惊飞了，到现在还没全部找回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780112
					],
					"speakerTitle": "瓦尔特"
				},
				{
					"id": 736780112,
					"content": "旅行者，待会我们去捕猎的时候，如果你发现了这些小动物，就把它们捉住一并带回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780113
					],
					"speakerTitle": "瓦尔特"
				},
				{
					"id": 736780113,
					"content": "没问题，交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780114
					]
				},
				{
					"id": 736780114,
					"content": "听说你会用猎人的捕猎工具，我在附近也放了一些，到时候你可以自行取用。等你做好准备，我们就可以出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780115,
						736780116
					],
					"speakerTitle": "瓦尔特"
				},
				{
					"id": 736780115,
					"content": "准备好了，出发吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736780116,
					"content": "等等，我还有些其他事要做。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780117
					]
				},
				{
					"id": 736780117,
					"content": "嗯，别着急。我就在这等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦尔特"
				}
			]
		}
	]
}