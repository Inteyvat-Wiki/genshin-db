					"奥妮"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1648.494,
							213.477,
							9656.33
						],
						"pointId": 11564
					},
					{
						"sceneId": 3,
						"position": [
							1651.032,
							213.487,
							9656.428
						],
						"pointId": 360700011
					},
					{
						"sceneId": 3,
						"position": [
							1650.233,
							213.48,
							9657.646
						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}比那些大个子更厉害啊，原来不是个头越大越厉害喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240202,
					"content": "#哼哼，是吧？{NICKNAME}虽然个子不高，但是就算对付大过自己几倍的魔物也不在话下呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240203,
					"content": "哪里哪里，比起派蒙还是略逊一筹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "欸？就、就算你这么夸我…好吧，下次有什么好吃的，分给你的那一半一定多分一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240206,
					"content": "#那{NICKNAME}{M#哥哥}{F#姐姐}肯定可以把盗宝鼬大哥也赶出莫雷谷吧？这里又不是他们的家，却被他们搞得一团乱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240207,
					"content": "原本要办的葬礼也办不了，莫雷爷爷说不定也被他们害死啦，不过就算要举办新的葬礼，也得先找到他们一家才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240208,
					"content": "欸？！盗宝鼬居然…不过你说的葬礼，之前没来得及问，不、不会真的有人要在这里举办葬礼吧？为什么会选在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240209,
					"content": "当然要的，我都准备好了，葬礼时要唱的歌也想好了。喏，给你们看看，不过要小声一点，让他安静地休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240210,
					"content": "奥妮从口袋里掏出一个小小的火柴盒，打开之后，在一块小小的花色衬布上躺着一只颜色漂亮的小小甲虫，周围还妆点了若干白色的花瓣…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "因为他已经永远地休息了，所以要给他举办葬礼。不过我选好的地方都被盗宝鼬占掉了，就是那些有机器的小丘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240212,
					"content": "莫雷爷爷一家如果不是逃掉了，就是死掉了吧。他们的家就这样被盗宝鼬糟蹋啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240213,
					"content": "#（{NICKNAME}，你说奥妮说的莫雷爷爷，该不会是…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240214,
					"content": "（应该是什么小动物吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "（嗯，我觉得也是，可能是她的动物朋友呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240218,
					"content": "嗯，既然是这样，要不我们来帮奥妮逮住做坏事的盗宝鼬吧！至于莫雷爷爷一家…等逮住盗宝鼬之后我们再一起找找看好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240219,
					"content": "#哇，{NICKNAME}{M#哥哥}{F#姐姐}，派蒙妹妹，你们真好，我会邀请你们来参加葬礼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240220,
					"content": "那、那倒也不用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240221,
					"content": "好吧。那就，之前买的糖雕…咦，原来已经没有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240222,
					"content": "不过尤尔瓦哥哥给的零花钱还有。唔，那就给你们零花钱，你们自己去买糖雕吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240223,
					"content": "拜托别人帮忙，要付报酬，还要说谢谢，这样才是对的。嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240224,
					"content": "派蒙居然要从小孩手里抢糖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "怎么说得我好像是什么大坏蛋一样！不过奥妮年纪这么小，却很有礼貌呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240227,
					"content": "谢谢你夸我，但是一人一个糖雕的摩拉，夸我也没有更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240228,
					"content": "这种地方倒是很现实…对了，听你刚才的说法，干坏事的盗宝鼬应该不止一只吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240229,
					"content": "嗯。刚才逃跑的那只不是我之前见过的盗宝鼬大哥，他有多少小弟，我也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240230,
					"content": "但是那边也有和这边一样的会发射子弹的机器爪子，说不定能在那边找到盗宝鼬小弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760240231,
					"content": "#好哦，这次可不能再让盗宝鼬逃跑了！{NICKNAME}，我们去教训一下那些坏盗宝鼬吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240226,
					"content": "奥妮好懂礼貌哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "（可能是原来住在这里的人吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "（欸？这里看起来不像有人长期居住的样子…我觉得说不定是奥妮的动物朋友！你看，她还会给甲虫举办葬礼呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760240205,
					"content": "对付小只的魔物也不会手软！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
