			"dialogs": [
				{
					"id": 760241501,
					"content": "哇，是莫雷一家，爷爷、爸爸妈妈、小莫雷还有小小莫雷…还有其他莫雷都在，一个都没少呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760241502,
					"content": "原来是嗅嗅鼹鼠呀！不过奥妮是怎么分辨它们的？它们看起来全都一个样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760241503,
					"content": "他们每个性格都不一样，相处得久了就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760241504,
					"content": "不过他们都有的坏习惯就是向人乞讨，唉，真是可怜的动物，要是人类灭绝了，他们该怎么办呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760241505,
					"content": "…人类灭绝？而且在那之后嗅嗅鼹鼠还在吗？应、应该不会吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760241506,
					"content": "莉奈娅姐姐说过，动物是会灭绝的，因为各种各样的原因。那人类当然也有可能会灭绝的，派蒙妹妹为什么觉得不会呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760241507,
					"content": "我应该会比鼹鼠活得长久一点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "不过这样也回答不了奥妮的问题吧。唔，这么一想，人类的处境还真是危险呢，有那么多会威胁到人类生存的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760241512,
					"content": "不过话说回来，既然鼹鼠一家都找到了，那这三只盗宝鼬该怎么处理呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760241513,
					"content": "不知道该怎么办的话，就交给「旗舰」的人好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 760241514,
					"content": "宝箱！呃，还是说这种情况应该说是贿赂？不管了，既然是给我们的，那我们就收下啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760241515,
					"content": "#看它们的样子，应该是知道错了。{NICKNAME}，这次我们就放过它们吧。当、当然不是完全看在宝箱的份上啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760241509,
					"content": "据说有昆虫在人类诞生之前就存在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "人类灭绝之后它们大概还会在的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "居然还要输给昆虫吗…有种好不甘心的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "派蒙"
				}
