			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350701,
					"content": "怎么样，你拿到骗骗花蜜了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350702,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "我看看，哎，就是这个，不错不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350704,
					"content": "等我把颜料调制好，再找个取景点，我就开始画画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350705,
					"content": "哼，等那个诗人看到了我画的画，一定心服口服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350706,
					"content": "啊…对了！我记得，璃月的海灯节是要放「霄灯」，还要在上面写愿望什么的…对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350707,
					"content": "嘿嘿，我也把霄灯准备好了，愿望嘛…我就不告诉你了，不然说不定就不灵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350708,
					"content": "哦，差点忘了…这些东西给你，就当是报酬吧，谢谢你帮我的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350709,
					"content": "我的这幅画，肯定会让那个诗人心服口服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				}
			]
		},
		{
			"id": 4133508,
			"completionStepIds": [
				4133508
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
