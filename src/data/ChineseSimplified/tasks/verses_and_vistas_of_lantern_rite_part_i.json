			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "这里的景色还不错。咦，这位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350302,
					"content": "在下清昼，自诩诗客。您是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350303,
					"content": "哈哈，你是个诗人吗？我是个画家，正在这附近取材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350304,
					"content": "取材？巧了，我也正在取材，敢问您是为何取材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350305,
					"content": "唔，我想要画一幅画来描绘海灯节和璃月港，正在和这位旅行者一起找最佳取景点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350306,
					"content": "对了，您又是为什么在这取材的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350307,
					"content": "嗯…这确实是巧了，我也正好想要写一首诗来描述海灯节和璃月港，也正在这里取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350308,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350309,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350310,
					"content": "一首诗…有点简单了吧，海灯节和璃月港用几行字怎么能描述得下来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350311,
					"content": "哈哈，要我说，还是得画一幅大画，才能把这些事物全部给描绘下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350312,
					"content": "一幅大画？呵呵，我倒是觉得这样太费笔墨，反倒是把海灯节的神韵给遮盖了下来，也失了璃月之风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350313,
					"content": "再说了，如此大的璃月，又怎么能是一幅画能画下来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350314,
					"content": "哈哈，我看，还是画好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350315,
					"content": "呵呵，我想，还是诗好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350316,
					"content": "你们冷静点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "这么争下去也没个头，不如这样，我们各自去创作一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350318,
					"content": "等创作完了，再把作品摆在一起，请个人来评判，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350319,
					"content": "这样也好，那等你画好了画，就来望舒客栈找我吧。然后我们再去找人评判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350320,
					"content": "好，那就一言为定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350321,
					"content": "一言为定，在下就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350322,
					"content": "这个诗人真是大言不惭，凭几行字就想概括海灯节和璃月港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350323,
					"content": "哼，等我把画画出来了，这诗人肯定得认输。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350324,
					"content": "这幅画我得好好画…画材也得特别准备一下才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350325,
					"content": "旅行者，能请你帮我去搜集一点特别的材料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350326,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "那就拜托你了，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350329,
					"content": "唔…请你帮我去从炽热骗骗花那里搜集一份骗骗花蜜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350330,
					"content": "有了它，我一定能做出一份特别的颜料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 413350328,
					"content": "要什么材料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
