					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705270101,
					"content": "你们好呀！是在聊什么好吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270102,
						705270103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270102,
					"content": "你们好，莎拉、娜扎法琳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270107
					]
				},
				{
					"id": 705270107,
					"content": "又见面了，二位。确实我们聊的也算是和吃的有关系吧，不过…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270108
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270108,
					"content": "发生什么事情了呀，快说吧，说不定我们能帮上忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270109,
					"content": "#既然事关好吃的，那我们一定不会袖手旁观的！嘿嘿，对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270110,
						705270111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270110,
					"content": "没错，为了好吃的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270112
					]
				},
				{
					"id": 705270112,
					"content": "噢，草王在上。二位大人还是一如既往，非常热心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270113
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270113,
					"content": "是这样子的，上次二位大人救我于水火之中后，我回到须弥，整理出了一份璃月调料市场调研报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270114
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270114,
					"content": "没想到被鼎鼎有名的桑歌玛哈巴依老爷给看上了，她表示希望买断我研究出来的调料配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270115
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270115,
					"content": "这位善良好心的大商人甚至愿意出资支持我后续的调研！噢，多么幸运！我毫不犹豫地答应了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270116
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270116,
					"content": "我给好朋友芭尔瓦涅写了信，告诉了她这件事情，她也非常支持我的决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270117
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270117,
					"content": "所以你现在是在蒙德展开你的调料调研吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270118,
					"content": "噢，派蒙阁下真是说到点子上了。我本来应该已经展开了我的蒙德调料调研，只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270119
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270119,
					"content": "只是，娜扎法琳想要和猎鹿人合作，在猎鹿人的菜肴里加入她所谓的秘制调料，再让我们的客人食用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270120
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270120,
					"content": "但猎鹿人身为餐厅，出餐是有标准的，没办法加入新的调料，要不然恐怕会有很多老客人投诉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270121
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270121,
					"content": "唉，说实话，其实在你们来之前，我们聊了很久，都没有什么比较好的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270122
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270122,
					"content": "甚至还在想，要不要找琴团长帮忙解决，她一定能完美解决这种棘手的问题吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270123
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270123,
					"content": "呜哇！琴团长那么忙，这种小事情就不用打扰她啦！都交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270124,
					"content": "噢，瞧瞧，我之前说什么来着。二位大人果然是拯救娜扎法琳的大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270125
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270125,
					"content": "太好了，那么事不宜迟，这口锅请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270126
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270126,
					"content": "就按我们之前那样吧，制作调料，加入料理中，再邀请您的朋友们试吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270127
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270127,
					"content": "嘿嘿，就按我们之前那样吧，最好的伙伴派蒙来当您的第一位试吃员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270111,
					"content": "好吧，就当是为了派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270112
					]
				},
				{
					"id": 705270103,
					"content": "你们好，请问这位是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270104
					]
				},
				{
					"id": 705270104,
					"content": "噢，您好，我的小吉祥草王啊。大人您不记得我了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270105
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270105,
					"content": "可能我的存在感，就像是一粒沙尘，风一吹就消散了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270106
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270106,
					"content": "不过二位大人之前在璃月，帮忙制作调料，又邀请大家试吃，大恩大德，我一直铭记于心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270107
					],
					"speakerTitle": "娜扎法琳"
				}
			]
		}
	]
}