					},
					{
						"sceneId": 3,
						"position": [
							2427.081,
							200.4,
							8922.118
						],
						"pointId": 14143
					},
					{
						"sceneId": 3,
						"position": [
							2427.91,
							200.376,
							8922.991
						],
						"pointId": 14144
					}
				]
			},
			"dialogs": [
				{
					"id": 760420201,
					"content": "看你的打扮…你也是来寻宝的宝藏猎人？你们这些人隔三岔五地来，还真是乐此不疲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420202
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420202,
					"content": "老爷子看得挺准。这不是听说之前有同行折在这儿了么，还到处嚷嚷，说什么自己是被鬼魂给袭击了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420203
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420203,
					"content": "我不信邪，偏要来看看这里到底有没有会打人的鬼…当然，要是能找到同行没本事拿到手的宝物，那就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420204
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420204,
					"content": "老爷子，你给我说说呗，他们说的会打人的鬼，到底是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420205
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420205,
					"content": "哪有什么会打人的鬼，挨打的是人，打人的自然也是人。不过说起来，那确实是恶鬼一样的人，虽然活着，说不定早就死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420206
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420206,
					"content": "…啊？老爷子，你该不会是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420207
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420207,
					"content": "我可没糊涂。阿特拉号你听过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420208
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420208,
					"content": "听过。不过它不是早沉了吗，而且就在这附近吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420209
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420209,
					"content": "船上最值钱的宝贝，就要数能带人找到雷德·米勒留下的「伟大财宝」的信物了，不过到现在还没人找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420210
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420210,
					"content": "你知道得还挺多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420211
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420211,
					"content": "哼哼，这叫职业素养。欸？这么说，打人的人和阿特拉号有关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420212
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420212,
					"content": "没错。当年的海难虽然惨烈，但也有不少幸存者，「裂颚」哈尔克就是其中之一。阿特拉号叫得上名号的海盗也就剩他一个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420213
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420213,
					"content": "听说他这些年先是去了至冬堡，近来又跟着什么商队做事。最近是在那夏镇犯了什么事吧，商队也容不下他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420214
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420214,
					"content": "那天几个宝藏猎人在阿特拉号的残骸附近翻找，「裂颚」哈尔克瞧见了，就给他们一顿好打。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420215
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420215,
					"content": "那是他的船，哪怕沉了，也还是他的船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420216
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420216,
					"content": "是啊。听说在海难之后他再也不敢乘船远航，想必是不打算也做不了海盗了。但像他那样的人要做正经的营生，可不是容易的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420217
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420217,
					"content": "过去被他…被阿特拉号「关照」过的人肯定不会善罢甘休。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420218
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420218,
					"content": "不过这都是他自己选的，也怨不得别人。自己选的，就得自己受着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420219
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420219,
					"content": "人活着哪有不犯错的，要紧的是及时转舵。这哈尔克自己就是舵手，却一错再错，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420220
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420220,
					"content": "看来是这个哈尔克在那夏镇捅了娄子之后回到这儿，对他来说是结束的地方，也是开始的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420221
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420221,
					"content": "但是这一次他也做了错误的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420222
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420222,
					"content": "本性难移说的就是这么回事吧。他在这块儿害了不少人，后来人就跟滑手的鱼似的，一下没了影儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420223
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420223,
					"content": "听说那夏镇的「旗舰」也开出了悬赏，那么多人撒网去找，连根头发丝都没捞着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420224
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420224,
					"content": "没想到老爷子鱼没钓到几条，消息倒挺灵通的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420225
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420225,
					"content": "你这牙尖嘴利的…那我再告诉你一个好消息吧，阿特拉号的残骸就在那边，你大可以去碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420226
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420226,
					"content": "碰碰运气？那要是他真的不知道从哪儿蹦出来揍我，老爷子你帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420227
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420227,
					"content": "当然不帮，我只是个钓鱼的，能帮什么忙。最多陪你到附近，给你指个路吧…反正这里看起来是钓不上什么鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420228
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760420228,
					"content": "唉，说得也是。没事，打不过我还不能开溜么，逃跑我还是很擅长的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
