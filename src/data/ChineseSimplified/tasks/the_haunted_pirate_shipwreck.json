					}
				]
			},
			"dialogs": [
				{
					"id": 760420101,
					"content": "宝藏猎人在搜刮海盗船残骸时被鬼魂袭击…听起来像是三流娱乐小说会写的题材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420102
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420102,
					"content": "挨揍的那几个家伙向来说话不着边际，也不知道他们的话有几分真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420103
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420103,
					"content": "那艘海盗船，雅珂达也听说过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420104
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760420104,
					"content": "听过听过，虽然那时候我还小，但阿特拉号的大名我也是知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420105
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420105,
					"content": "「要是不听话，就会被『盾女』洛维萨抓走，被『疯子』格瑞蒂尔扔进海里喂鱼！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420106
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420106,
					"content": "以前还有大人拿这些话吓唬小孩呢，当然，我是一点也不怕啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420107
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420107,
					"content": "呵呵，既然如此，那这次的任务的人选也非你莫属了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420108
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760420108,
					"content": "…欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420109
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420109,
					"content": "好吧…虽然有点远，不过我会好好调查的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420110
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420110,
					"content": "（那片海域沉船不少，时不时有人挖到宝物，说不定这次我也…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420111
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760420111,
					"content": "可别因为寻宝而耽误了正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420112
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760420112,
					"content": "知、知道了，老板！我一定速去速回！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
		{
