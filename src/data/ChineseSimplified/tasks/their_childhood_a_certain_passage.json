			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "洛薇？你找到什么好东西了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070102,
					"content": "没有呀，这里什么也没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070103,
					"content": "你们在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "#{M#大哥哥}{F#大姐姐}，我们正在「寻宝」呢，嘿嘿…你要不要和我们一起呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070105,
					"content": "寻宝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "别听韦吕吹牛啦，其实我们就是想在这里捞一些零件上来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070107,
					"content": "这些零件就是宝物…咦？这里应该有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070114,
					"content": "唔…看来这里是找不到了，我换个地方吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070115,
					"content": "行！我们再往前面走走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070116,
					"content": "我和你们一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "#呜哇，{M#大哥哥}{F#大姐姐}说话的语气好像哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070119,
					"content": "那我们再往前走走，我记得这附近的水里有很多零件的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070117,
					"content": "可不要到处乱跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "怎么没看见奥雷勒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "哥哥去城里找德勒吕叔叔啦，他说有些问题想要请教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070110,
					"content": "我们呢，就只能乖乖听话不乱跑…一直在这里「寻宝」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070111,
					"content": "#嘿嘿…{M#大哥哥}{F#大姐姐}要不要和我们一起呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
