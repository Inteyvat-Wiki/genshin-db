			"dialogs": [
				{
					"id": 240070501,
					"content": "我看看…这枚齿轮可以用，这个轴承如果锯开的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070502,
					"content": "你找这个做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "我想要自己做一个发条人偶。其实…我之前一直在悄悄地学习相关的知识啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070504,
					"content": "等我学好了，就要做一个大大的发条机关，给爸爸一个惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070505,
					"content": "我去爸爸房里看了好多书，也按照书上的方法做过一些简单的部件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070506,
					"content": "只要再加把劲，我一定能完成我想做的那个发条机关！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070507,
					"content": "但我可不能在城里研究发条和机械，否则马上就会被我爸爸发现，那样就给不了他惊喜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070508,
					"content": "所以，这里就成了洛薇研究发条机械的秘密基地啦，而我嘛…就是她的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240070509,
					"content": "多说无益，助手！开始研究吧！今天我们必须做出一个能动的机关胳膊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240070510,
					"content": "是！开始研究吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "韦吕"
				}
			]
