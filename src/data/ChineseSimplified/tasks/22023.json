			"dialogs": [
				{
					"id": 220230201,
					"content": "这么快就回来了？你不会是个隐藏身份的大厨吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230202
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220230202,
					"content": "嗯...我都快要等不及了，请让我尝一尝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220230203,
					"content": "请享用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "我想想...刚刚讨论了哪些菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "唔…是摩拉肉，干锅腊肉，还有稠汁蔬菜炖肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220230206,
					"content": "决定好就交给汤雯小姐吧!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
