			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿虎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "你是这里的工人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210302,
					"content": "啊对、对！你们是来调查失踪案的吧，求求你们，一定要救回大家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210303,
					"content": "我不知道…不知道发生了什么，那天天色很阴暗，工头带着几个兄弟去外头办事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210304,
					"content": "我和其他四个兄弟留在矿区工作，中间我偷了一小会儿懒…就一会儿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210305,
					"content": "我在最里面的棚子睡觉，等我醒来，所有人都消失得无影无踪了！明明不久前才跟他们说过话，突然…人就没了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210306,
					"content": "该不会、该不会什么时候就轮到我了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210307,
					"content": "躲在棚子里的人没有失踪，在外劳作的人却没了踪影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210308,
					"content": "莫非是工作区出了什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210309,
					"content": "呃啊！好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210310,
					"content": "工作区或许有状况，把这条线索记录下来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "你们看，这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210402,
					"content": "散乱的衣服、裤子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210403,
					"content": "摆放在矿区内的生活物资，应当属于老戴他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210404,
					"content": "一、二、三、四…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210405,
					"content": "唔…没错没错，总共十件衣服，十条裤子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210406,
					"content": "这些是替换的衣服吧？你看，老戴身上也穿着一样的服装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210407,
					"content": "那四个人出门六天至今未归，却没带替换衣物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210408,
					"content": "周围还有洗脸用的布帕和皂角…还有这些腰包，是随身的小工具包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210409,
					"content": "晨起洗漱的用具，采矿的装备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210410,
					"content": "也就是说，这些人没带行李？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210411,
					"content": "对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210412,
					"content": "也许用不到吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "不像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210415,
					"content": "开采用的矿镐少了四把，说明他们很可能带着工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210416,
					"content": "有时间带上工具，却没时间打包生活用品？不合常理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210417,
					"content": "唔…人在什么情况下才会不带行李，只带工具出门？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210418,
					"content": "一，他们到附近工作，不需要行李，但这些人至今未归，这个说法不攻自破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210419,
					"content": "二，如果他们不是出于自身意愿而离开，也就无暇思考行李的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210420,
					"content": "咿——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210421,
					"content": "你是说，被人带走了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "这种可能性不小。更进一步的推论，需要更多线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210423,
					"content": "不是自发离开而是被人带走，把这种可能性记录下来转告给老戴吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210413,
					"content": "会不会是忘带行李了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "你们回来了，调查得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210702,
					"content": "我们在附近找到三条线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210703,
					"content": "第一，矿镐少了四把，生活用品却一件都没带走，说明那些工人很可能不是自发离开，而是被人带走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210704,
					"content": "被人带走？！可是…谁会劫持工人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210705,
					"content": "第二，矿区内原本有五名工人。其中一人为了偷懒，离开工作区打了个瞌睡。等他一觉醒来，同伴已经消失得无影无踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210706,
					"content": "留在工作区的人纷纷失踪，躲在休息区的人却安然无恙。可见，事情是发生在工作区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210707,
					"content": "这么一说，阿虎确实提过他偷懒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210708,
					"content": "难道有人走进工作区带走了他们？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210709,
					"content": "这正是我要说的第三点。昆兄用他特别的手段推算出来，那些人是被一个孩童带离了矿区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210710,
					"content": "孩童？！这附近住户很少，不可能有孩子跑到矿区里来啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210711,
					"content": "但结果就是，四个工人跟着一个小孩子走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210712,
					"content": "他们去哪儿了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210713,
					"content": "根据我们的推测，他们沿路向北行走，应该是出了矿区，往遗迹方向去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210714,
					"content": "北方！好，我这就带人去找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210715,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "都把调查的事交给你们了，跑腿就让我们弟兄几个来吧。先走一步，说不定快马加鞭还能追上他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210717,
					"content": "且慢。事情发生在六天前，哪怕只是步行，他们也走得很远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210718,
					"content": "唔…说得也是。这样吧，一会儿我带兄弟几个到远处的住户那儿打听打听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210719,
					"content": "离开矿区，想投宿就只有那么几户人家。调查这些就交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210720,
					"content": "几位，我想麻烦你们继续追查线索。咱们兵分两路，要是途中没有碰面，就于明晚在望舒客栈汇合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210721,
					"content": "也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210722,
					"content": "那我就和兄弟们先走一步了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210723,
					"content": "现在的情况是，我们继续调查，他们去附近的住户那里打听消息，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210724,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210725,
					"content": "可是，矿区内没有更多线索了…我们是不是应该往北方追？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210726,
					"content": "等等，少了一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210727,
					"content": "哎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210728,
					"content": "对哦，小昆这家伙，多半还在调查。去叫他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
