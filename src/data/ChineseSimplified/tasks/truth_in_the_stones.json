			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "哇，这片矿区可真不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210102,
					"content": "各位，这里就是事发地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210103,
					"content": "六天前我带几个伙计外出办事，一回来，就听说留守的四个兄弟不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210104,
					"content": "我带人搜遍整个矿区，怎么也找不到他们。实在没有头绪，才请几位来帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210105,
					"content": "也就是说，有四位矿工不明所踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210106,
					"content": "对。原本我们有十个人，丢了阿龙、岑大、岑二、小茂，都是跟着我做活儿的矿工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210107,
					"content": "这行工人大多是青壮年男性。四个矿工，会不会是去别处矿洞了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210108,
					"content": "不像。这一带周围没什么落脚地，咱们一路过来也没看见有其他开采中的矿洞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210109,
					"content": "唔…这么大的矿区，你们全都找遍了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210110,
					"content": "一寸不落，井下也找过，就差掘地三尺了。可四个大活人，总不能一下钻进地底吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111210111,
					"content": "看过现场才能作出结论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210112,
					"content": "哎，好的好的。我在这里候着，你们随意搜查，要是有失踪兄弟的线索，务必告诉我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老戴"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112102",
							"2"
						],
						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"昆钧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "小昆，你在看什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210202,
					"content": "是你们啊，来得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210203,
					"content": "有什么发现？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210204,
					"content": "这里有块矿石，我想，或许能从中获得一些线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210205,
					"content": "矿石？这种矿石跟失踪案有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210206,
					"content": "这种事，试试就知道了。稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210207,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210208,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210209,
					"content": "他好像很专注，是在做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210210,
					"content": "看见了。四个大人…跟着一个像是小孩的身影走出了矿区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210211,
					"content": "小孩？矿区里怎么会有小孩子？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210212,
					"content": "我也不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210213,
					"content": "还有，「看见」是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210214,
					"content": "啊，就是字面意义的「看见」。你们听了，可别告诉别人！我觉得这事比较古怪，一直没敢和人说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210215,
					"content": "其实，我能看见矿石的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210216,
					"content": "哎——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210217,
					"content": "不是猜测，不是估算，而是「看见」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210218,
					"content": "像刚才那样把手放到石头上就行了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210219,
					"content": "嗯，对我来说，矿石也有「记忆」。它们偶尔会记录下周遭发生的事，我只要触摸并用心感知，就能看见那些「记忆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210220,
					"content": "这么厉害！那你岂不是什么都知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111210221,
					"content": "还得看具体的石块。不同矿石记忆能力有所不同，铁矿、白铁块之类的常见矿石基本派不上用场，记忆很模糊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210222,
					"content": "石珀、水晶的记忆能力更强，能记录的景象更多也更清晰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210223,
					"content": "以石为目…有趣。这种能力实在罕见，老戴请昆兄出马，实在是明智之举。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210224,
					"content": "哈哈，能帮上大家的忙就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210225,
					"content": "依我所见，他们应该是沿这条路向前去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111210226,
					"content": "这条路指向北方，沿着它一直走就能离开矿区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111210227,
					"content": "他们往北走了，把这条线索记录下来，告诉老戴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
