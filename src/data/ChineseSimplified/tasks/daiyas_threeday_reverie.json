			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 10,
						"position": [
							420.771,
							402.75,
							-188.577
						],
						"pointId": 59
					}
				]
			},
			"dialogs": [
				{
					"id": 790440701,
					"content": "唔…等等，之前还没有注意到，这里有一个隐藏的门？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440702,
					"content": "我好像明白了，念出报名时的那句暗号，就能打开新的道路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440703,
					"content": "我们一起来念暗号吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440704
					]
				},
				{
					"id": 790440704,
					"content": "好啊！报名的时候，我们就是一起喊出口号的，这种时候当然也要注重仪式感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440705
					],
					"speakerTitle": "派蒙"
				},
