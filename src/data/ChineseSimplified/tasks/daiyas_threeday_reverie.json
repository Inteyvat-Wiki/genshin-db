			},
			"dialogs": [
				{
					"id": 790440101,
					"content": "由衷感谢命运的指引，四处徘徊的旅人们啊，你们总算来到了这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440102
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440102,
					"content": "你们必然也在寻找一场超越惊喜的邂逅，一次超乎想象的旅途？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440103
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440103,
					"content": "如今，我们互相成全的机会，正摆在你们面前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440104
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440104,
					"content": "投身于全新的剧集「黛依阿的三日遐想」，置身于话剧的舞台之上，你们就能获得前所未有的新奇体验！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440105
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440105,
					"content": "畅游于摩拉的浴池之中…驱散古堡中的幽魂…挣脱重力的束缚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440106
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440106,
					"content": "轻轻念出暗号：「带我们前往遐想的世界」，昭示你们的好奇与热情，就此启程吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440107
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440107,
					"content": "唔，喇叭那一头的人真是激动啊，虽然不知道她具体在说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440108,
					"content": "旅途？剧集？舞台？还有什么…摩拉的浴池！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440109,
						790440110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440109,
					"content": "可能是一种新的游乐项目。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				},
				{
					"id": 790440111,
					"content": "喔！这么一说，我好像能理解了，以前听说过类似的活动呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440112,
					"content": "所以喇叭后面正在说话的那个人，就是「黛依阿」吗？她是话剧的导演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440113,
					"content": "如果我们报名，就可以成为这些话剧中的角色？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440114,
						790440115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440114,
					"content": "派蒙感兴趣吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440116,
					"content": "听起来还挺有意思的！我想见识一下摩拉的浴池…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440117,
					"content": "呃…不对！我想看看，能在「琉形蜃境」里占据一席之地的游乐项目，究竟有什么神奇的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440118,
					"content": "那，我们就一起念出报名的口号吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440119,
					"content": "带我们前往遐想的世界吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440120
					]
				},
				{
					"id": 790440120,
					"content": "带我们前往遐想的世界吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440121,
					"content": "居然这么干脆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440122
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440122,
					"content": "咳咳，简直完美！报名信号已确认，「黛依阿的三日遐想」即将开幕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440123
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440123,
					"content": "「古老的传说重现天日，价值连城的宝藏有了新的线索，一队侠义的海盗擦亮了武器，升起了船帆…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440124
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440124,
					"content": "「漂浮在天空之中的小镇遭遇了空前的危机，创造奇迹的建筑师要及时挽救这座正在坠落的高城…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440125
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440125,
					"content": "「为了拯救不幸罹难的伙伴，落单的水形幻灵即将闯入幽魂盘踞的古堡，寻找破除『魔咒』的希望…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440126
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440126,
					"content": "三个不同主题的剧集，任各位自由赏玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440127
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440127,
					"content": "寻找这样的告示喇叭，遵循旁白的指引，就能向着遐想之地进发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440128
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440128,
					"content": "#我明白了！{NICKNAME}，接下来我们就去找找这样的喇叭，好好试试看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440115,
					"content": "我们一起来当演员？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440110,
					"content": "比如游客参与表演的话剧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				}
			]
		},
		{
			"id": 7904406,
			"completionStepIds": [
				7904405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904405",
							"2"
						],
						"stepId": 7904405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440601,
					"content": "呜啊！怎么有这么多的「小水珠」…它们围着一台超大的机器，在忙来忙去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440602,
					"content": "完全不明白，这台机器是干什么的？黛依阿又在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440603,
					"content": "欢迎探访「三日遐想」最真实的幕后！你们现在一定很疑惑吧——眼前的场景说明了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440604
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440604,
					"content": "我们这就向你们详细展示！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440605
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440605,
					"content": "「偷懒鬼」，别打盹了，快去一号位置，进行二号操作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440606
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440606,
					"content": "「由衷感谢命运的指引，四处徘徊的旅人们啊，你们总算来到了这里！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440607
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440607,
					"content": "那个「小水珠」在操纵喇叭，播放…录音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440608,
					"content": "好耳熟…总觉得在哪里听过这句话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440609,
						790440610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440609,
					"content": "最开始发现活动的告示喇叭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				},
				{
					"id": 790440611,
					"content": "「全勤王」，在三号位置进行七号操作，拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440612
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440612,
					"content": "「出现在新人眼前的大副衣衫褴褛，全身上下打满绷带，显然，不久之前，他才经历过一场激烈的战斗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440613
					],
					"speakerTitle": "来自喇叭的旁白"
				},
				{
					"id": 790440613,
					"content": "我想起来了！这一段是「黑水晶号与吞金海怪」的旁白，我们与大副刚刚见面的情景！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440614,
					"content": "原来当时听到的录音是这样播放出来的…时机也很准确呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440615,
					"content": "「大冒失」，「黑水晶」号快要抵达宝藏前的关隘了，赶快把所有布景和机关都升起来…千万别搞错了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440616
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440616,
					"content": "那个「小水珠」好像在用什么看不见的方法…操作面前的仪器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440617,
						790440618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440617,
					"content": "监测、播音和机关控制…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440619,
					"content": "没错，这台巨大设备的功能，正是对剧目中的所有功能进行调度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440620
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440620,
					"content": "勤恳的水形幻灵们时刻观察着剧目演出的进度，在游客抵达特定位置时，就播放剧本上的旁白，启动相应的机关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440621
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440621,
					"content": "只要游客老老实实跟着流程走，就能顺利观赏到「三日遐想」的全部演出！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440622
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440622,
					"content": "当然，假如游客中途跳车，或者做出了其他超出预期的行为，那就没法完整体验剧目了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440623
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440623,
					"content": "我们的员工数量不够，暂时没法应对这种情况…但我们相信，游客们肯定不会乱来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440624
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440624,
					"content": "好，好厉害！我们当时光顾着玩了，没想到幕后还有这么多门道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440625,
					"content": "现在想想，一路上有那么多机关要启动，控制演出的难度不是一般的高呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440626,
						790440627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440626,
					"content": "真是巧妙的设计。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440628,
					"content": "所以说…现在正在和我们说话的这个声音，就是黛依阿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440629,
					"content": "你在借助这些水形幻灵控制「三日遐想」演出？为什么不亲自和我们解释呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440630,
					"content": "我还有好多问题想问你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440631,
					"content": "猜对了，但也不全对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440632
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440632,
					"content": "你们所见的，这间广播室里的一切——控制器、「总导演」、「假编剧」、「偷懒鬼」、「全勤王」和「大冒失」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440633
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440633,
					"content": "当然，还有没露面或者没发声的，其他维护着剧目演出的水形幻灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440634
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440634,
					"content": "所有组合在一起，才是这道声音——「黛依阿」的本尊，创造并控制演出的关键体系，而非一个具体的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440635
					],
					"speakerTitle": "乐园告示喇叭"
				},
				{
					"id": 790440635,
					"content": "黛依阿不是一个人…是一个体系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440636,
					"content": "慢着慢着，有点超出我的理解能力了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440637,
					"content": "虽然我知道「小水珠」们也很聪明，但只凭「小水珠」们，真的能设计出这么复杂的一套…体系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440638,
						790440639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440638,
					"content": "幕后应该有着专门的设计师。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440640,
					"content": "最初的确是这样啦，你们的惊讶也在预料之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440641
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440641,
					"content": "说来话长了，「黛依阿的三日遐想」起源于热情洋溢的佐西摩斯导演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440642
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440642,
					"content": "他在「琉形蜃境」中暂住时，将大部分精力放在了那部最精彩的舞台剧上，无暇再筹备其他剧目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440643
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440643,
					"content": "与水形幻灵们相处一段时间后，他发现了水形幻灵们的智慧与丰富的情感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440644
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440644,
					"content": "水形幻灵们很喜欢他的话剧，想要见证更多精彩的演出，并将这份喜悦传递给其他访客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440645
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440645,
					"content": "一个想法在佐西摩斯导演心中萌生了：可不可以让水形幻灵们自行导演剧目，甚至设计剧目？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440646
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440646,
					"content": "好大胆！听起来就像是…教一群孩子来当导演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440647,
					"content": "确实有难度，好在大家一起努力，成功克服了所有困难！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440648
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440648,
					"content": "佐西摩斯导演努力教导几位热爱话剧的水形幻灵，让它们理解了操办演出的关键流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440649
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440649,
					"content": "经过一番试错，他用水形幻灵们能理解的语言，写下了许多部范例剧目，以及详实的剧作说明书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440650
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440650,
					"content": "在伊迪娅的帮助下，他制造了这台控制器，在各地搭建了与其相连的机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440651
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440651,
					"content": "除了剧本里的台词，佐西摩斯导演还录下了大部分常见字词的语音，好让我们组合出正确的语句，和游客们沟通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440652
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440652,
					"content": "经过一段时间的磨合，我们终于可以顺利运作三部范例剧目了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440653
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440653,
					"content": "它们正是「黑水晶号与吞金海怪」、「瞳孔里的固形魔咒」、还有「天空高城救守记」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440654
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440654,
					"content": "也就是说…佐西摩斯导演为「黛依阿的三日遐思」留下了基础的条件，合适的剧本，还有详细的说明书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440655
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440655,
					"content": "我们在游玩的过程中完全没有察觉到，这一切都是「小水珠」们在控制的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440656,
					"content": "多谢夸奖！你们的游玩肯定了我们的努力，验证了我们的许多想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440657
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440657,
					"content": "所以，我们想给你们一份丰厚的谢礼，并将创作路上的一切与你们分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440658,
						790440659
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440658,
					"content": "客气客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440660,
					"content": "对哦，我们体验到了特别的游乐项目，还开拓了眼界，我们也要谢谢你们，黛依阿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440661,
					"content": "啊哈哈！现在我们要向着下一个目标前进了，那就是独立创作剧本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440662
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440662,
					"content": "为此，我们还要进一步加强我们对「剧作」的理解，不断取材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440663
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440663,
					"content": "我们当中有一位「假编剧」，它会听取各种访客的故事，充实我们的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440664
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440664,
					"content": "就算没有遇见合适的访客，「假编剧」也会探访其他水形幻灵，聊聊它们与访客们的经历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440665
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440665,
					"content": "原来如此，所以说，我们和「假编剧」讲故事，就是在帮你们创作新的话剧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440666
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440666,
					"content": "没错没错！如果你们有空，就请和「假编剧」多聊聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440667
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440667,
					"content": "另外，还请你们继续在「琉形蜃境」里好好游玩，尽情冒险，多多和其他水形幻灵互动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440668
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440668,
					"content": "#不用担心哦，我和{NICKNAME}可喜欢这里了，一定会为你们提供很多素材的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440669
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440669,
					"content": "嗯…还有一个问题…我已经好奇很久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440670
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440670,
					"content": "「三日遐思」里的「三日」到底是什么意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440671
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440671,
					"content": "难道说，佐西摩斯导演写下每个剧本的时间，都是三天？还是说，一共用了三天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440672,
						790440673
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440672,
					"content": "哈哈，这一题我会！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440674,
					"content": "「昨天」、「今天」和「明天」？好像很有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440675
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440675,
					"content": "这说明佐西摩斯导演…不对，是「黛依阿」的所有成员，每天都在专心创作，超级努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440676
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440676,
					"content": "好想法！可惜有点抬举我们了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440677
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440677,
					"content": "「三日」的真实含义其实是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440678
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440678,
					"content": "「时间还早的明天」、「状态更好的明天」和「再不搞定就完蛋了的明天」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440679
					],
					"speakerTitle": "黛依阿"
				},
				{
					"id": 790440679,
					"content": "欸？怎么这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790440673,
					"content": "是「昨天」、「今天」和「明天」吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440659,
					"content": "我们也玩得很开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440639,
					"content": "还要有把控剧本的人才对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440627,
					"content": "真是准确的配合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440618,
					"content": "有这些控制功能就够了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440610,
					"content": "它就在播放这一段宣传词。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				}
			]
		},
		{
			"id": 7904407,
			"completionStepIds": [
				7904406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
