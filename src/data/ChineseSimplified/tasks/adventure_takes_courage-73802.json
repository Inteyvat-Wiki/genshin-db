			"dialogs": [
				{
					"id": 738020101,
					"content": "向着星辰与深渊！欢迎来到冒险家协会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020102,
					"content": "你好呀，凯瑟琳小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 738020103,
					"content": "你好，凯瑟琳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "你们好，看起来两位今天的状态很不错啊。请问您是来接取委托的吗？还是来处理其他事务的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020105,
					"content": "嗯…两位为什么一直盯着我？是…有什么事要问我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020106,
					"content": "没有！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "这样啊…看您的样子，冒险的经验应该很丰富了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020109,
					"content": "算是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "那么，想必你也已经很熟悉冒险家协会的运作模式了，我就不多赘述，以免耽误您的时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020111,
					"content": "如果您对协会内的事务有任何疑问，都欢迎来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020112,
					"content": "在须弥城里，也请您多多完成委托吧。像您这样实力强大的冒险家，一定能帮上人们不少忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020113,
					"content": "请继续勇敢冒险吧，向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 738020107,
					"content": "只，只是想要接点委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
	]
