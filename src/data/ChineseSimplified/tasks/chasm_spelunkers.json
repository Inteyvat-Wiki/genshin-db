			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "啊，你们回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370302,
					"content": "老何留下了些信息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "哦？他还真留了些东西！来，告诉我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370306,
					"content": "你们向瑾武具言了此前寻到的信息。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "嗯…黑色「熔岩」…流明石…蘑菇…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370305,
					"content": "哼…真是邪门，似曾相识的邪门。我们也别在这里久留了，一起动身去营地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
						],
						"stepId": 7103711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "就是这里了…奇怪，志琼那娃子在哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370402,
					"content": "志琼，志琼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370403,
					"content": "唉…对，那娃子又自顾自跑到矿洞深处画地图了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370404,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "刚刚你们离开的时候，她画了这幅地图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370408,
					"content": "她应该又跑去深处探险了。请替我告诉她一声，前方很危险，不要冒冒失失地甩下大家自己一个人乱撞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370409,
					"content": "…如果再惹出什么麻烦拖累大家，瑾武姐的拳头是不会留情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370410,
					"content": "呜哇…好凶恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370411,
					"content": "好凶恶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "好啦，两位也不要闲着。要么帮我布置营地，要么去前面探路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370413,
					"content": "抱歉，我不太会说客气话…总之，至少要对大家有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370414,
					"content": "啊，顺便一提，如果你们在路上看见了流明石的原晶，就请带给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370415,
					"content": "我会想办法把它们加工成更有效用的「触媒」。根据我的经验…这些东西在矿下会很有用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370405,
					"content": "志琼有危险了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "现在还没…哼，不过她如果再不通知我就乱跑的话，她的屁股就有危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "瑾武"
				}
			]
		},
