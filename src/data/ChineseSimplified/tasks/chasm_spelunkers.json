			"dialogs": [
				{
					"id": 710371101,
					"content": "多谢前辈的帮助，请收下这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710371102,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "哈哈，前辈不用这么客气啦，反正是海迪夫出钱…嘘，小声点，别被那个须弥小气鬼听见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710371104,
					"content": "咳咳…抱歉，我们去找瑾武姐吧？之前一路上的许多疑问，或许可以借助她的经验解答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710371105,
					"content": "就像前辈在雪山那样…瑾武姐虽然不太愿意提起，但她年轻时也是矿上的传奇人物呢…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710371106,
					"content": "听说她为千岩军的搜救队引路，从险境救出了许多矿工…哈哈，不过那些旧事我就不提啦，免得她生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710371107,
					"content": "好了，我就不啰嗦强留你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				}
			]
		}
