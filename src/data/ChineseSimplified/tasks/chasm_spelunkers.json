			"dialogs": [
				{
					"id": 710370901,
					"content": "等你们回来，志琼的地图应该也差不多画好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370902,
					"content": "不过在这之前，我还要等上面的运输队把我的工具都带下来，这段时间请你们自由探索吧。",
					"roleType": "TALK_ROLE_NPC",
