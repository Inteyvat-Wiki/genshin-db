			"dialogs": [
				{
					"id": 710370601,
					"content": "多谢前辈的帮助，请收下这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370602
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370602,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370603
					]
				},
				{
					"id": 710370603,
					"content": "哈哈，前辈不用这么客气啦，反正是海迪夫出钱…嘘，小声点，别被那个须弥小气鬼听见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370604
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370604,
					"content": "咳咳…抱歉，我们去找瑾武姐吧？之前一路上的许多疑问，或许可以借助她的经验解答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370607
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370607,
					"content": "好了，我就不啰嗦强留你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				}
			]
		},
