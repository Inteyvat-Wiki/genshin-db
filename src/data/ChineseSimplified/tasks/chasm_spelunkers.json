				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#啊，是{NICKNAME}前辈，你们来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370502,
					"content": "瑾武有事嘱咐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "又是那套安全叮嘱吧？唉…我听都听烦啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370504,
					"content": "我从小也是在矿上长大的，矿坑里的危险哪有不知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370505,
					"content": "至于那些未知的事物，长辈们总是喜欢借经验来判断是否危险…然后反过来用结果来证明自己的经验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370506,
					"content": "我是受够他们这种自大了…我相信身为冒险家的前辈你，也是一样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370507,
					"content": "如果霞姐一味警告你雪山的危险，而前辈就听信了，就这样裹足不前的话，那得错过多少精彩的冒险呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370508,
					"content": "好啦——不要再劝我了，我不想和前辈为这种小事吵起来…唔，我们换个话题吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370509,
					"content": "前辈你看，我现在正在勘探这里的地形，以便绘制地图…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370512,
					"content": "只不过…之前在探索矿洞的时候，前路被几处奇怪的异变点阻挡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370513,
					"content": "如果能够取样或者拍下照的话，总务司与冒险家协会应该都会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370514,
					"content": "说来丢人…下矿时我的留影机不小心摔坏了，所以只能仰赖前辈高超的摄影技巧啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370515,
					"content": "还有另一些地点…嗯，这里和这里，有盗宝团的踪迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370516,
					"content": "什么呀…完全看不出哪里是哪里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370517,
					"content": "只是几个叉号和几条线呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "哈哈，抱歉抱歉…只是自己习惯，就忘记不是人人都有制图师的直觉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370519,
					"content": "不过没关系，我会随前辈一起去，给你们指路的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370520,
					"content": "这几处地点，我们先去解决哪里都可以的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370521,
					"content": "那我们就出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "路上你要小心安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "谢谢前辈关心！我明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370510,
					"content": "你在这里做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "嗯…我刚刚说了呀，我在勘探地形，绘制地图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "志琼"
				}
			]
		},
