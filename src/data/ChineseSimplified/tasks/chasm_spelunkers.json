	"talks": [
		{
			"id": 7103701,
			"completionStepIds": [
				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼",
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "呼，好久没有下来过了…是矿下熟悉的空气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370102,
					"content": "可不要太懈怠了，小琼。我怎么闻到了不熟悉的气味呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370103,
					"content": "毕竟我们又不能直接跳下来…摇摇晃晃的起重机太让人分心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370104,
					"content": "你呀…还是在地面上时间长了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370105,
					"content": "我怎么什么都没闻到呀…你们矿工，鼻子都这么灵吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370106,
					"content": "哈哈，在矿下鼻子不灵的话可是会要命的。不过现在还好啦，团雀们还很有精神呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370107,
					"content": "看那边，流明晶石都长到这里来了…上次下矿时还没有延伸到这边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370108,
					"content": "真的呀，我们一起去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370109,
					"content": "唔…总感觉有人抢了我的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"志琼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "没想到流明晶石会出现在距离地面这么近的地方…我本以为这些东西不会增生在结构比较脆弱的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370202,
					"content": "它们是地下那个「东西」的碎片，沿着岩石的脉络而迁移，最终来到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370203,
					"content": "别乱说。它们就是本地的岩石，之所以变成这样，只是因为经历了某种转化作用，形成了结晶而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370204,
					"content": "「七星」委托我们做过分析…成分上大部分还是层岩巨渊本地的矿物，但只是…受到外力影响，重构成了奇特的结晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370205,
					"content": "#快看，那块晶石和{NICKNAME}身上的「触媒」似乎差不多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME}也快把流明石「触媒」拿出来看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370232,
					"content": "没错，流明石「触媒」和此种晶石实际上是同一种东西。其结构一致，自然会彼此共鸣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370206,
					"content": "好邪门…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "喂，你就只会说这个吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370209,
					"content": "你们先不要吵架啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370210,
					"content": "我们没有吵架…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "#{NICKNAME}没有在和我吵架啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370212,
					"content": "我是说，我没在关心你们有没有吵架，志琼和我要在前方布置一个临时的前进营地，这段时间请不要到处乱跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370213,
					"content": "我们刚刚发现的结晶，对于接下来的探险十分有用，如果接下来再有新发现，请务必通知我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370214,
					"content": "我的手艺还没有生疏，可以替你们精加工一下这些粗糙的原晶…对后面的冒险很有用处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370215,
					"content": "嗯，还有就是…不要吵架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370216,
					"content": "知道啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710370217,
					"content": "知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "真乖，等下给你们发糖。对了，如果你们在附近遇到了什么奇怪的东西，请及时回来报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370219,
					"content": "对了，上次瑾武姐说的，关于老何的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370220,
					"content": "#我还没忘呢。既然{NICKNAME}也来了，就麻烦再帮我一个忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370221,
					"content": "老何是我们矿上的前辈，前些年层岩巨渊疏散矿工时，他是不幸失踪的其中一个…他耳朵背，也许没注意到警报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370222,
					"content": "辉山厅与盛露厅的抚恤也到位了，他家里也把白事办好了…不过我还是不信邪，我总觉得他还活在矿下某个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370223,
					"content": "老何他算是资深矿工啦…如何规避矿难、如何逃生、如何等待救援，等等等等…他懂得可多了，也教了我不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370224,
					"content": "所以我相信，这么久了，他一定还在哪里活着…可不能放弃搜救才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370225,
					"content": "稍后我给你们指出几个方位，是矿工撤离前老何曾经所在的工作地点…说不定在那边还能找到什么线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370226,
					"content": "至于我呢，就先去矿洞深处勘察啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370233,
					"content": "对了，别忘了你们的糖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370227,
					"content": "你不一起来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "她还要为我们绘制地图，层岩巨渊的地下结构错综复杂，没有地图可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370229,
					"content": "注意安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "没关系的啦，我也不是新手了。请你尽管放心吧，前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710370207,
					"content": "好神奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
			"completionStepIds": [
				7103709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
