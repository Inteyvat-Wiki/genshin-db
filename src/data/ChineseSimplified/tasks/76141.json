			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尼可"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "作为世界变动的不动观测点之一，我需要拥有良好的视野条件。就像雕塑家离不开錾子，作家离不开笔墨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410202,
					"content": "我在那两个领域取得的建树另当别论，但对于我的本职工作，我可是很认真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410203,
					"content": "#{NICKNAME}，你一定有所体会，近来在提瓦特，「命运」被撼动的情况已经越来越多见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410204,
					"content": "有时我也不免会设想，如果我还具备着当年全盛之时的形态、力量与能力，我能做的事一定比现在更多吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410205,
					"content": "但我很快又会否定自己，因为那样，我所受到的来自高天的限制也会一并增多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410206,
					"content": "一想到碰都不能碰的话题变多了，就觉得不划算，那要我怎么讲故事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410207,
					"content": "所以啊，我并不后悔我付出的代价，也不后悔在这条道路上做出的每一个选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410208,
					"content": "我想成为人类，像个普通人那样生活…但那样的生活终归是奢侈的，我不会忘了自己是名天使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410209,
					"content": "就算只是沉默天使，我也依旧会完成属于自己的那份职责。守护文明，守护地上的生灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410210,
					"content": "哎呀，好像不小心把话题带得太严肃了呢！可能是场地的关系吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410211,
					"content": "其实我对我身为天使的那部分还是挺满意的呢，甚至称得上自豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410212,
					"content": "对的对的，尼可很厉害呢！不太出手，但偶尔出手的每一次都给人很大的安心感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761410213,
					"content": "自豪是应该的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "是吗？呵呵，你们记下的是我可靠的样子，那我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410215,
					"content": "时间不早了。去吧，带着我的祝福，继续你们的冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410216,
					"content": "别害怕迷路，别忘了有一名天使会在这里悄悄守望你们的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
