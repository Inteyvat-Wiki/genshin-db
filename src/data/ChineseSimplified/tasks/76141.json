			"dialogs": [
				{
					"id": 761410101,
					"content": "欢迎回来，二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410102,
					"content": "不过，还没有到我们恋恋不舍告别彼此的时候，这栋小屋你们还没有参观完毕呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410103,
					"content": "房间不是都进去看过了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761410104,
					"content": "我可没说过没有秘密隐藏房间。魔女嘛，都是有点小心思的，你们要早点开始习惯哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410105,
					"content": "这边请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
