			"dialogs": [
				{
					"id": 400221101,
					"content": "三位，你们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221102
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221102,
					"content": "人到齐，就该去找最后的答案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221103
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221103,
					"content": "你们好像恶战了一场啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221104
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400221104,
					"content": "一场？哼…已经不知多少场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221105,
					"content": "我打得还不错吧，「式大将」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221106
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221106,
					"content": "达达利亚先生对这类秘境很是熟悉，无论多强的魔物，他都能完美应对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221107
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221107,
					"content": "我认为，我们有望突入秘境最深处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221108
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221108,
					"content": "哦？一起待了几天，关系亲近了不少嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400221109,
					"content": "哈哈，已经是战友了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221110
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221110,
					"content": "重组期间，我听「式大将」说，它感到最关键的「拓本」出现了，就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221111
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221111,
					"content": "那枚「拓本」中蕴含的符法之力远超其他拓本。只要回收顺利，我应该就能回想起这座秘境的真相了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221112
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221112,
					"content": "不是就在那里吗？你们怎么不过去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400221113,
					"content": "「式大将」…你是在等我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221114
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400221114,
					"content": "多亏各位陪伴，我才能走到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221115
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400221115,
					"content": "我的记忆是靠着你们一点点找回的，至于这最后也最重要的时刻…我想请大家一起为我见证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「式大将」"
				}
			]
		},
