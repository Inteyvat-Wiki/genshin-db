	"talks": [
		{
			"id": 4002201,
			"completionStepIds": [
				4002201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002201",
							"2"
						],
						"stepId": 4002201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220101,
					"content": "旅行者，这段时间我从驻兵们那里打听到一个好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220102
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220102,
					"content": "听说九条裟罗被城中事务困住了，她的部下暂时没有动静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220103
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220103,
					"content": "说到底，这个秘境已经很久没有放出魔物了，他们小心地把守着重要关口，没必要急着向秘境内进军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220104
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220104,
					"content": "给我们争取了不少时间呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220105
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220105,
					"content": "那我们赶快进去吧，那两个家伙一定等得不耐烦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4002203,
			"completionStepIds": [
				4002203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002203",
							"2"
						],
						"stepId": 4002203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220301,
					"content": "一直以来零散破碎的记忆，总算汇聚成型了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220302
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220302,
					"content": "我全都想起来了…这座「诀箓阴阳寮」的过去…它的本质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220303
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220303,
					"content": "它不是用来试验「阴阳术」的场所，也不是滋生邪祟之物的巢穴。晴之介创造我和这座秘境的目的…是为了「守护」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220304
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220304,
					"content": "「守护」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220305,
					"content": "我们的国度曾遭到某种灾害的侵袭。那次变故夺去了晴之介最珍视的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220306
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220306,
					"content": "晴之介十分悔恨，因此，他开始渴求能够抵御邪祟的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220307
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220307,
					"content": "他渡海前往璃月，寻访仙人，修习仙法，将这种奥妙之术与自身研习多年的「神通」相结合，缔造出了最早的「阴阳术」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220308
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220308,
					"content": "随后，他召集有志报国的武士，又创造出我和这座阴阳寮，以我为原型制作众多「拓本」，将它们分发给武士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220309
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220309,
					"content": "武士和「式神」组成搭档，用符法配合武艺，更为稳妥地对抗魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220310
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220310,
					"content": "他们两两成组，外出与魔物战斗。战败魔物的信息会被「式神」拓写下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220356
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220356,
					"content": "返回秘境后，这些信息借由「镜返魔物」的姿态重现于世，充当武士训练的对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220311
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220311,
					"content": "我作为「式神」的统筹者，会不断吸收「拓本」们的见闻与经验，调整秘境的架构，为武士们提供更有效的训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220312
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220312,
					"content": "长此以往，这些志向高远的武士都能锻炼出傲人武艺。等他们离开，下一批新人又会到来。新的见闻、新的对手…循环不息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220313
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220313,
					"content": "演武的秘境？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220314
					]
				},
				{
					"id": 400220314,
					"content": "难怪能无止境地战斗下去…这里本就是一座训练场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220315
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220315,
					"content": "也就是说，惟神晴之介建立这座阴阳寮是为了训练武士，让他们更好地对抗魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220316,
					"content": "那他不就是个彻彻底底的大好人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220317,
					"content": "如果是这样的话，他为什么要躲在秘境深处呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220318
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220318,
					"content": "不，晴之介早已不在寮内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220319
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220319,
					"content": "不知为何，晴之介遣散了所有武士，废弃了整座秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220320
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220320,
					"content": "这段记忆，这最后的碎片，还没能补全…我甚至想不起晴之介离去前对我说过什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220321
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220321,
					"content": "离开的意思是…他还活着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220322
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220322,
					"content": "也许吧。至少…我希望是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220323
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220323,
					"content": "我是被晴之介创造出来的一种「兵器」。我与阴阳寮的使命，是不断创造战斗，锤炼自己也锤炼他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220324
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220324,
					"content": "可如今这座秘境已经没用了。除了你们，没有人会来这里…被主人抛弃的兵器，还有什么价值可言呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220325
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220325,
					"content": "他好难过的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220326,
					"content": "被主人抛弃的兵器…哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220327
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220327,
					"content": "做一把兵器也没啥不好的吧？每个在战斗中沉沦的人，都渴求着自身的意义与价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220328
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220328,
					"content": "是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220329
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220329,
					"content": "你不是对我的秘密很好奇吗？为什么我能坚持抵抗秘境的排斥，为什么我能从容面对复杂无比的战局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220330
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220330,
					"content": "我不过是在「树根」的缝隙中战斗过而已。无止境的险境、夺命的危险…只有得到这些养分，我才能更快地变强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220331
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220331,
					"content": "我要的不是胜利，而是打磨。我想要的，就只是让自己变得锋利，变得让人畏惧。我和你一样，也是「兵器」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220332
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220332,
					"content": "若是如此…你所追逐的战斗，它的终点在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220333
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220333,
					"content": "渴望结束的人才会寻找终点。我不一样，我根本不在乎这些虚无缥缈的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220334
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220334,
					"content": "我是为战斗而生的，只要我还活着，终点就不会出现…我选择的路，每一步都是极限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220335
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220335,
					"content": "舍弃困惑吧。带着忧愁和犹豫，可没法成为无情的兵器啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220336
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220336,
					"content": "我要怎么做才能舍弃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220337
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220337,
					"content": "我倒觉得，舍弃只是一种形容，不是真的要你丢弃什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220338
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220338,
					"content": "「式大将」，你不需要丢弃任何东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220355
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220355,
					"content": "你才刚找回记忆，现在正是捡起过去的大好机会，只要找回那件对你来说正确又重要的事就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220339
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220339,
					"content": "正确又重要…的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220340
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220340,
					"content": "我有哦。我喜欢摇滚乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220341
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220341,
					"content": "很少有人喜欢摇滚乐对吧？确实是冷门了些，但没关系，我高兴就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220342
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220342,
					"content": "别人喜不喜欢，与我何干？我只做自己想做的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220343
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220343,
					"content": "假如有谁爱给白眼，那就给吧！我的音乐，本来也不是给不懂行的人听的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220344
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220344,
					"content": "曲子…我记得你弹给我的那个「测试」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220345
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220345,
					"content": "你说你孤独地走在路上，偶尔与人在篝火旁相遇，大伙儿还会一起吃些烤鱼什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220346
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220346,
					"content": "能理解这一点，说明你已经很了解人的情感了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220347
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220347,
					"content": "我们每个人或多或少都走过这条孤独的路，你也在那里，自然是我们的同伴。所以我们会在篝火旁相遇，然后，成为朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220348
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220348,
					"content": "路很难走，但我们并不孤单。「式大将」，这是我音乐中的语言，是我坚持正确之事的收获。你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220349
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220349,
					"content": "一定也有必须去做的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220350
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220350,
					"content": "辛焱小姐…也许我现在还拿不出你那样的豁达。但我知道，我不能停留在此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220351
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220351,
					"content": "前进吧，各位！我想…不，我要找回最后的「拓本」，重新掌控这座秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220352
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220352,
					"content": "一定…一定还存在着只有我能做到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220353
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220353,
					"content": "没错，振作起来，我们还要战斗呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220354
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220354,
					"content": "大家一起前进，就没问题啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4002206,
			"completionStepIds": [
				4002206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002206",
							"2"
						],
						"stepId": 4002206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220601,
					"content": "并不是晴之介抛弃了我，而是我开导了他，让他放下背负了太久的重担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220602
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220602,
					"content": "对于我和「诀箓阴阳寮」，晴之介有着美好的祝愿。非要说的话，可能是我们都有些生不逢时吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220603
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220603,
					"content": "武士们竭尽全力锻炼，这种锻炼也被证明是小有成效的，然而，凡人的力量终究有着极限，我们所创造的进步…太慢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220604
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220604,
					"content": "就在我们苦修时，那位掌握着「无想的一刀」的神明，带领着其他勤奋又强大的战士，拔除了埋藏在这片土地上的隐患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220605
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220605,
					"content": "毕生的心血突然成了不被需要之物…想必，任何人都无法轻易接受这种结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220606
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220606,
					"content": "神明的力量有时很残忍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220607
					]
				},
				{
					"id": 400220607,
					"content": "根本没法想象那种事，但好像又听说过相似的例子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220608,
					"content": "我迷茫过，消沉过，怀疑一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220609
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220609,
					"content": "可我们创造的结果，我们付出的代价，即使再怎么渺小，也是真实存在过的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220610
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220610,
					"content": "不管怎么说，晴之介和武士们渴望的「目标」已经达成了，武士们不用再埋头苦练了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220611
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220611,
					"content": "这本该是一件值得庆贺的事。晴之介是因为太有感情，太过在乎世间的一切，才会拘泥于自己失去的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220612
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220612,
					"content": "「守护」是我们共同的心愿。晴之介想要「守护」大家…那么，我就「守护」晴之介吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220613
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220613,
					"content": "作为晴之介最得意的造物，也是他在这「诀箓阴阳寮」中唯一的挚友，我劝导了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220614
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220614,
					"content": "他告诉我，他要去寻找新的「意义」，也许需要一个月，一年，或是几百年。无论多久，我都期盼着有朝一日他能完成心愿回到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220615
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220615,
					"content": "日复一日的等待中，我陷入了沉睡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220616
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220616,
					"content": "晴之介啊…你应该是不会回来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220617
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220617,
					"content": "别太难过，「式大将」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220618
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220618,
					"content": "惟神晴之介学到了那么强大的仙法，又会「神通」，也许他能长生不老吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220619,
					"content": "各位，我想明白了一件事。无论晴之介是否还在世上，我都不该只为他而活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220620
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220620,
					"content": "遇见你们之后，我学会了一件事，那就是相信。相信晴之介正走在他自己的路上…相信我也会拥有这样一条路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220621
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220621,
					"content": "自从诞生于世，我们便开始向着孤独的尽头行走，但迷雾之中会有火光，夜空之下会有新的伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220667
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220667,
					"content": "我们的使命，从不因远行而告终。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220622
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220622,
					"content": "晴之介所做的一切都有价值。而我的「意义」，正是我的使命。这一点从未改变，更不会被剥夺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220623
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220623,
					"content": "我是辅佐武人的「式神」之首「式大将」，这座「诀箓阴阳寮」不变的「寮司」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220624
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220624,
					"content": "我的职责是辅佐武人，帮助他们锤炼极致的武艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220625
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220625,
					"content": "世间一定还有正在攀登高山的人，我很乐意成为山间的绳索，成为他们的兵器，陪伴他们走向山顶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220626
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220626,
					"content": "好极了，就是这种态度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220627,
						400220628
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220627,
					"content": "你已经找到答案了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220629
					]
				},
				{
					"id": 400220629,
					"content": "记忆完全恢复的「式大将」…给人一种坚定又可靠的印象呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220630,
					"content": "我已重新掌控「诀箓阴阳寮」，今后不会再有任何「镜返魔物」外逃。本次风波，就到此为止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220631
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220631,
					"content": "只需几日时间，我就能理清符法之力的脉络，将「诀箓阴阳寮」恢复成原貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220632
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220632,
					"content": "这里是变幻莫测却安全可靠的试炼之地。今后我会一直守在这里，为渴求极致武艺的人提供最为有效的试炼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220633
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220633,
					"content": "天领奉行那边应该也准备好进入秘境了吧。等他们过来，我会和他们详细说明这次事件。交涉方面，几位大可放心交给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220634
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220634,
					"content": "好好好，意思是我们都不用善后了对吧？嗯~我就喜欢这种一身轻的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220635,
					"content": "多亏你们，我才能找回真正的自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220636
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220636,
					"content": "我准备了一点薄礼。虽说无法与各位的恩情相比，应该也能派上些用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220637
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220637,
					"content": "「拓本」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220638
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220638,
					"content": "你们可以称呼他为「式小将」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220639
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220639,
					"content": "「式小将」与其他「拓本」不同，不管在大陆哪一处，它都能与我保持联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220640
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220640,
					"content": "离开「诀箓阴阳寮」后，他无法再运用「式札」和符法，不过，也还是能为你们带去加护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220641
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220641,
					"content": "带着他游历各地，就相当于把我带在身边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220642
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220642,
					"content": "（「式大将」的口吻有些悲伤…是担心我们不会再见面吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220643
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220643,
					"content": "喂！别说丧气话，我们不是还在嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220644
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220644,
					"content": "而且托旅行者、九条裟罗和北斗姐的福，我来稻妻也不是那么困难。说不定隔三差五就到这里来看你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220645
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220645,
					"content": "辛焱小姐…这样不会太耽搁你的时间吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220646
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220646,
					"content": "我问你，摇滚怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220647
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220647,
					"content": "摇滚…对我来说，是非常好的音乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220648
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400220648,
					"content": "那就够了。我从来只为懂得欣赏的人演奏音乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220649
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220649,
					"content": "大家，准备好耳朵，我要露一手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220650
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220650,
					"content": "哦？！居然要弹曲子吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220651
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220651,
					"content": "原来这首曲子还有这么振奋人心的部分啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220652,
					"content": "达达利亚不是会跳舞吗？让他跟着…哎？达达利亚人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220653,
					"content": "喂——！达达利亚！你要去哪儿啊，不会是想偷偷溜走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220654
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220654,
					"content": "溜走？我只是找个地方休息一下，想想问题而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220655
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220655,
					"content": "旅行者，是时候告诉你我在调查的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220656,
						400220657
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220656,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220658
					]
				},
				{
					"id": 400220658,
					"content": "还是那么敏锐啊。有时候真怀疑你的眼睛能看透人心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220659
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220659,
					"content": "这次我玩得很开心，说真的，我挺喜欢稻妻的呢。只要不去想那些小小的麻烦…和它们带来的后患就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220660
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220660,
					"content": "本以为这座秘境与「散兵」有瓜葛，我才会来这里。没想到，他根本不在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220661
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220661,
					"content": "带着「神之心」的「散兵」与我们失去了联络…这背后恐怕还有故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220662
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220662,
					"content": "不过「散兵」会做出这种事，我一点都不觉得意外。倒不如说，就像我当执行官只是为了寻求争斗，愚人众大部分执行官也有自己的打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220663
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220663,
					"content": "就让那颗「心」再逃一会儿吧。你迟早会知道它去了哪里。届时，你会怎么选择呢？旅行者，你的终点又是哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220664
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220664,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220665
					]
				},
				{
					"id": 400220665,
					"content": "真想再多停留一会儿啊。驻足越久，下一次见面时喜悦就越大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220666
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220666,
					"content": "就像晚星一般…你总是令人倍感惊喜，我的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220657,
					"content": "和我之前的经历有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220658
					]
				},
				{
					"id": 400220628,
					"content": "我也很受启发哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220629
					]
				}
			]
		},
