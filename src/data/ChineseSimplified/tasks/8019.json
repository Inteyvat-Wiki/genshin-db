				]
			},
			"dialogs": [
				{
					"id": 80190301,
					"content": "哟，你好，是想买点什么东西吗，我在这一带做生意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190302
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190302,
					"content": "不是不是，我们是专程过来的冒险家，刚刚在凯瑟琳那里接到了维摩庄的委托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190303,
					"content": "那件事啊，唉…也算是劳烦你们这些冒险家一趟一趟往这里跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190304
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190304,
					"content": "老实说，我们大家都不怎么抱希望了，每次都是有人信誓旦旦来帮忙找人，结果很快就铩羽而归。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190305
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190305,
					"content": "各种线索我们都被问烦了，维摩庄周边也快被掘地三尺了，就是没有任何新的进展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190306
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190306,
					"content": "那他到底叫什么？原本住在哪里？他的亲人们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190307,
					"content": "不知道，不知道，不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190308
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190308,
					"content": "呃…就这么不耐烦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190309,
					"content": "啊…不好意思，我那不是不耐烦，而是依次回答了你的三个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190310,
						80190311
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190310,
					"content": "三问三不知吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				},
				{
					"id": 80190312,
					"content": "话虽这么说，但其实我们都对他印象很深的，都是在维摩庄过日子的人嘛，记忆里也一起做过很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190313
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190313,
					"content": "只是并不了解他的这些具体情况罢了，也可能以前知道，但现在没人记得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190314
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190314,
					"content": "反正村里大家交换过情报，结论就是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190315
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190315,
					"content": "好吧，就当是这样吧…那么他是一个怎样的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190316,
					"content": "他呀，印象里是个二十岁出头的小伙子，非常热心肠，人又和善…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190317
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190317,
					"content": "我这边没什么客人的时候，偶尔就和他聊聊天。有时候又看见他冒冒失失地给人家帮忙，哈哈…挺有意思的小伙子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190318
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190318,
					"content": "看起来你对他的评价还不错嘛，一聊起他，表情都不像之前那么愁眉苦脸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190319,
					"content": "可不是嘛，大家应该都挺喜欢他的，不然也不会一起到冒险家协会发委托找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190320
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190320,
					"content": "像他这样单纯的年轻人不多见了，怎么就忽然消失了呢，但愿不是出了什么不好的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190321
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190321,
					"content": "或许…只是偷偷搬走了之类的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190322,
					"content": "不会的，以他的性格不可能会不辞而别。就算如此，他搬家的事也不可能躲过我们维摩庄所有人的视线…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190323
					],
					"speakerTitle": "巴兰"
				},
				{
					"id": 80190323,
					"content": "唔…好吧，谢谢你的情报，我们再到别处问问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190311,
					"content": "那你们究竟知道点什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				}
			]
		},
		{
