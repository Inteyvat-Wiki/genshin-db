			"dialogs": [
				{
					"id": 80190401,
					"content": "是客人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190402
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190402,
					"content": "你好，阿玛兹亚爷爷，我们是接到维摩庄的委托才过来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190403,
					"content": "哦，那可真是辛苦你们了，这么大老远过来，那孩子的事儿就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190404
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190404,
					"content": "能多给我们讲一些失踪者的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190405,
					"content": "当然可以，只要能对你们有帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190406
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190406,
					"content": "我虽然眼睛不太好，但过去总是能听到他的声音，现在听不到了就感觉心里空落落的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190407
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190407,
					"content": "他的父母好像都不在维摩庄，但那孩子看起来一点也不孤单，还总是愿意做那个陪伴他人的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190408
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190408,
					"content": "他经常去孤寡老人家里做客，也喜欢带着村里的孤儿一起玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190409
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190409,
					"content": "不管谁遇到了伤心的事，他都乐意听人家倾诉，又总是很会安慰人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190410
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190410,
					"content": "身为村长，我真的要好好感谢他。从精神上帮助那些身处困难的人，本应是我职责的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190411
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190411,
					"content": "难怪他失踪了以后，你们那么着急，原来是这样一个温柔的好人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190412,
					"content": "可是…关于他的名字、住所、家庭情况之类的，村长你也完全没有线索是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190413,
					"content": "唉…这也是让我十分惭愧的事，无论如何我都应该记得的，或许是我真的年纪大了…这些我怎么也想不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190414
					],
					"speakerTitle": "阿玛兹亚"
				},
				{
					"id": 80190414,
					"content": "啊…没关系的，不用强求，我们会想想办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190415,
					"content": "#{NICKNAME}，你现在怎么看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190416,
						80190417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190416,
					"content": "感觉…并不是一个简单的失踪案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				},
				{
					"id": 80190418,
					"content": "是呀，我也这么觉得…再怎么说，他的名字都没人记得了也太奇怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190419,
					"content": "住所和家人也都没有相关线索，这个人简直就像从现实里被抹去了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190420,
						80190421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190420,
					"content": "不，我倒觉得更像是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190422,
					"content": "唔…你的意思是说，从现实的角度来看，不是「被抹去」，而是从来都「不存在」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190423,
					"content": "等等，这对我来说有点难理解…只存在于记忆里的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190424,
					"content": "（会不会和大慈树王那时候一样，出现了群体性的记忆变动…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190425
					]
				},
				{
					"id": 80190425,
					"content": "你们是…刚到维摩庄的冒险家？是接到委托才来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190426
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190426,
					"content": "啊，没错没错，我们正在调查失踪者的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190427,
					"content": "太好了，谢谢你们还没有放弃，我一直都担心冒险家协会要把我们的委托撤掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190428
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190428,
					"content": "我叫阿托莎，也住在维摩庄。请你们一定要再努力试试看，拜托了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190429,
						80190430
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190429,
					"content": "一定会找到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190431,
					"content": "这位小姐你不要着急，你和失踪者很熟吗？有没有可以提供给我们的线索呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190432,
					"content": "线索…我也不知道能不能算是线索，你们跟我来，我带你们去一个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190430,
					"content": "只能说尽力而为。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190421,
					"content": "…只存在于记忆里的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190417,
					"content": "不协调的地方很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				}
			]
		},
