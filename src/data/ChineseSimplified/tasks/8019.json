			"dialogs": [
				{
					"id": 80190501,
					"content": "就是这里吗？这棵树下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190502,
					"content": "嗯，看似平平无奇，但对我来说又充满回忆的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190503
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190503,
					"content": "我们曾经会坐在这棵树下聊天，看着天空中的云朵，感受风的方向，一坐就是很久很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190504
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190504,
					"content": "我是在森林里被巡林员发现，后来被维摩庄收养的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190505
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190505,
					"content": "尽管大家对我很好，每天也过得很热闹，但曾经的我还是会感觉到孤独…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190506
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190506,
					"content": "孤独？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190507,
					"content": "唔…怎么说呢，有些心事不管是开心也好，伤心也罢，总是不知道该向谁倾诉，或者说不知道该不该倾诉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190508
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190508,
					"content": "大家都有自己的生活，有些时候敞开心扉或许只会给别人带来麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190509,
						80190510
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190509,
					"content": "我大概能懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				},
				{
					"id": 80190511,
					"content": "欸，你也是这样的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190512,
						80190513
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190512,
					"content": "我曾经有一位亲人愿意听我倾诉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190514,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190515,
					"content": "是吗，那可太好了，真是羡慕你…而对我来说，「他」应该又像是亲人，又像一位能理解我的朋友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190516
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190516,
					"content": "不管我遇到了什么，都可以毫无顾忌地对他说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190517
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190517,
					"content": "他的心思单纯又细腻，脸上的表情也总是充满了耐心与兴趣，就好像在听他自己的事情一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190518
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190518,
					"content": "…自从他消失以后，我真的有好多事情想要和他讲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190519
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190519,
					"content": "不不，那些事情也都没那么重要了，只要能再见到他就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190520
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190520,
					"content": "你们两个，关系真的很好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190521,
					"content": "那在你的印象里，他有说过什么关于自己的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190522,
					"content": "唔…他讲的大概都是维摩庄里他见到的趣事，还有自己的很多天马行空的想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190523
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190523,
					"content": "哦对了，我有一次问过他，他的父母在哪里…但他只是回答说——「他们不在这里了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190524
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190524,
					"content": "我也不敢追问，那究竟只是离开了，还是不在人世了的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190525
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190525,
					"content": "还是没什么线索吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190526,
					"content": "聊了这么多，还是没能帮上忙，实在是抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190527,
						80190528
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190527,
					"content": "别这么说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190529,
					"content": "上次一口气说这么多话，还是和他一起的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190530
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190530,
					"content": "这么说来，好像每次和他聊天，也都是在这样的黄昏时分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190531
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190531,
					"content": "在记忆里，时间会变得很慢很慢，有时候感觉明明聊了很久很久，可是天却还没有暗下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190532
					],
					"speakerTitle": "阿托莎"
				},
				{
					"id": 80190532,
					"content": "#好像放松下来以后，时间就是会变慢呢…欸，你怎么了，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190533,
						80190534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190533,
					"content": "每次都是同一时间…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190535,
					"content": "（情报收集到这里，感觉已经完全不能作为普通的寻人委托来处理了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190536
					]
				},
				{
					"id": 80190536,
					"content": "（反倒是刚刚阿托莎所说的，关于时间的问题，或许才是解开谜团的契机…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190537
					]
				},
				{
					"id": 80190537,
					"content": "#…喂，{NICKNAME}，那边的几个丘丘人，是不是样子有些古怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190538,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190539
					]
				},
				{
					"id": 80190539,
					"content": "欸，深渊教团？难道是他们搞的鬼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190540,
					"content": "#发现我们了，{NICKNAME}，快迎战吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80190534,
					"content": "时间似乎不会流逝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190528,
					"content": "至少我们更加了解他了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190513,
					"content": "不过我现在拥有更多理解我的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190510,
					"content": "这就是「亲人」存在的意义吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				}
			]
