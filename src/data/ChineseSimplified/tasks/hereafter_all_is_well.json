				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "英雄住手！我们认输了，认输了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300402,
					"content": "收拾东西，滚远点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "是，是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300405,
					"content": "但不知道…我们兄弟是哪里冒犯了英雄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300406,
					"content": "难不成英雄正在这周围发财？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300407,
					"content": "我们正在这附近修庙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "修、修庙？这荒郊野岭的，英雄怎么会在这里修庙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300409,
					"content": "这…这周围居然有供着仙师的庙？等会，难道那个破屋子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300410,
					"content": "老大，我们上次去那边休息的时候，我看见了一只鸟的雕像，那不会就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "盗宝团小弟"
				},
				{
					"id": 718300411,
					"content": "那就是夜叉「铜雀」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300413,
					"content": "老、老大！我们是不是冒犯仙师了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "盗宝团小弟"
				},
				{
					"id": 718300414,
					"content": "别、别瞎说！我们之前又不知道，那算是…算是无心之过！仙师应该…应该不会怪罪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300415,
					"content": "英雄！给仙师修庙这件事，我们知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300416,
					"content": "之前是我们有眼无珠，对仙师不敬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300417,
					"content": "我们这就回去，让周围的兄弟离那座庙远点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300418,
					"content": "老大，我们要不要抽个空去那边烧几柱香，给仙师赔个罪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "盗宝团小弟"
				},
				{
					"id": 718300419,
					"content": "哪来这么多废话，赶紧走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盗宝团老大"
				},
				{
					"id": 718300403,
					"content": "以后离这里远一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
