				},
				{
					"id": 718300602,
					"content": "这座庙还得一段时间才能完工，这段时间我会一直待在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300603,
					"content": "您要是有空的话，也可以多来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				}
			]
		},
