					"王平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "这可真是个大工程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300202,
					"content": "你还真在修庙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "是您啊。可不是，我都说了我是正经人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300204,
					"content": "不过，我还是没想到工程量会有这么大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300205,
					"content": "那位设计屋子的师傅一听是供奉「夜叉」的庙，整个人都来劲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300206,
					"content": "不仅把设计图画了厚厚一大叠，还抓着我到处去采购材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300207,
					"content": "我看他那架势，要是再年轻个几十岁，非要自己过来亲自修不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300208,
					"content": "没有遇见什么危险吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "危险？噢，您是说魔物和盗宝团吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300212,
					"content": "这您不用担心，听说我要给夜叉修庙之后，总务司那边也派了几位千岩军随行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300213,
					"content": "这附近的魔物，基本上都被那几位千岩军赶走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300214,
					"content": "至于盗宝团嘛…他们看见千岩军在这，估计也不敢露头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300215,
					"content": "不过，修这庙的工程量超乎我的想象，原本准备的材料也不够了，我们只能从城里再运一些材料过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300216,
					"content": "我觉得…那群盗宝团虽然不敢对工地动手，但他们也许会埋伏在路上，等着抢劫那些运过来的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300217,
					"content": "虽然千岩军能守住工地，但要是那些运材料的人在路上被盗宝团袭击，那千岩军肯定也没法及时过去援助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300218,
					"content": "英雄，我能请您帮个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300219,
					"content": "我知道您身手很好，对付那些盗宝团肯定不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300220,
					"content": "能请您去附近教训一下那群盗宝团，别让这群家伙捣乱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300221,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "那就拜托英雄了，真是太感谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300223,
					"content": "为什么不拜托千岩军去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "他们不分日夜守着工地，已经够累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300225,
					"content": "这件事就拜托您了，英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300210,
					"content": "我记得这周围不太安全…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "您是说，这周围有魔物和盗宝团吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "王平安"
				}
			]
		},
