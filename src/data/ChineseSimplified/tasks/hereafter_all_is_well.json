			"dialogs": [
				{
					"id": 718300701,
					"content": "您回来了，周围有盗宝团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300702,
					"content": "走了就好，走了就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300703,
					"content": "还有什么我们能帮上的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "哈哈哈，谢谢您好心，但您都帮了我那么多忙，我可不能让您再跑前跑后了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300705,
					"content": "但如果您愿意的话，倒是可以找些<color=#00E1FFFF>却砂木</color>给我，这样您也算是真正参与建筑这座庙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300706,
					"content": "修庙可是件积德的事，您亲自参与一下，说不定也能沾点福气呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300707,
					"content": "我会找点却砂木来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "哈哈哈，好。您找到<color=#00E1FFFF>却砂木</color>之后，直接带来给我就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300709,
					"content": "有其他人捐物资来修庙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "嗯…老实说，其实没多少人。毕竟这荒郊野岭的，大部分人都不知道这里还有一座庙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300711,
					"content": "而且，那位名为铜雀的仙师，现在也没多少人记得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300712,
					"content": "好了，不说这些了。您找到<color=#00E1FFFF>却砂木</color>之后，直接带来给我就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				}
			]
		},
