			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160701,
					"content": "可真是好好锻炼了一番呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160702,
						20160703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160702,
					"content": "不过如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160704
					]
				},
				{
					"id": 20160704,
					"content": "话说回来，神子你为什么知道这么多有关雷电将军的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160705,
					"content": "欸，你问我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160706,
					"content": "可能因为…我就是「雷神眷属」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160707
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160707,
					"content": "欸！类似特瓦林和巴巴托斯的关系那样吗？还真是看不出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160708,
					"content": "呵呵，那听上去你们对我「狐狸小姐」的模样更感兴趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160709,
						20160710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160709,
					"content": "想看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160711
					]
				},
				{
					"id": 20160711,
					"content": "想得美哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160712
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160712,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160713,
					"content": "其实奇怪的地方并非我的身姿，而是我与她已经不再相见了，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160714
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160714,
					"content": "「永恒不变的国度」是我与她共同的梦想，但我并不认为那意味着完全的「静止」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160715
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160715,
					"content": "从某个时刻开始，她便走上了我愈发难以触及的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160716
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160716,
					"content": "在影踏入「一心净土」之前，并没有与我道别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160717
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160717,
					"content": "或许是一厢情愿吧，我想，这也是她所认为的，让友谊保持永恒的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160718
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160718,
					"content": "不去道别，也不再见面，我们之间的关系便恒久地维持在当年的模样，至少在她心里是这样想的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160719,
						20160720
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160719,
					"content": "一厢情愿的或许是雷电将军。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160721
					]
				},
				{
					"id": 20160721,
					"content": "既然已经踏上了两条截然不同的永恒之路，我可以继续维持现状，也可以选择不计代价地将她带回正轨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160722
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160722,
					"content": "如今我选择后者，正因为…如果遁入「一心净土」是她对永恒的一意孤行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160723
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160723,
					"content": "那把她从自我的世界里揪出来，便是我作为「永恒的眷属」的践行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160724
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160724,
					"content": "神子小姐…是个很好的朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160725,
					"content": "呵，不过是为了方便你们理解我的计划，才把这些知会你们，可别得意忘形哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160726
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160726,
					"content": "好了，聊天到此为止，是时候进行<color=#00E1FFFF>「反雷电将军训练第二期」</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160727
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160727,
					"content": "原来还有呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160720,
					"content": "雷电将军过于偏颇了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160721
					]
				},
				{
					"id": 20160710,
					"content": "感兴趣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160711
					]
				},
				{
					"id": 20160703,
					"content": "有些吃力。",
					"roleType": "TALK_ROLE_PLAYER",
