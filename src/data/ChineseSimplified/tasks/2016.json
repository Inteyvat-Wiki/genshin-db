			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160401,
					"content": "呼…完成啦，这下怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160402,
					"content": "嗯，完成情况很不错，我看到你们的决心和努力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160403,
					"content": "那你觉得，我们这下能打赢雷电将军了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160404,
					"content": "我看嘛…完全不是对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160405,
					"content": "喂！那不是全白费了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160406,
					"content": "呵呵，你们是计划当中最重要的一环，我自有盘算，又怎会让你们毫无胜机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160407,
					"content": "说起来…旅行者，你对反抗军势力怎么看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160408,
						20160409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160408,
					"content": "老实说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160410
					]
				},
				{
					"id": 20160410,
					"content": "呵，的确如此。即便偶尔能跟幕府军在正面战场取得些优势，但真正面对雷电将军的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160411,
					"content": "就凭那些神之眼都被嵌进神像了的人们所组成的部队，或许真的是些虾兵蟹将而已了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160412,
					"content": "不要说得那么直白啦，旅行者可还是「剑鱼二番队」的队长呐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160413,
					"content": "呵呵，我没有贬低他们的意思，倒不如说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160414,
					"content": "正因为他们的渺小，正因为他们失去了神之眼，他们才有更加珍贵的「意志」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160415
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160415,
					"content": "总之，如果能按计划进行的话，是一群还算帮得上忙的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160416,
					"content": "计划…究竟是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160417
					]
				},
				{
					"id": 20160417,
					"content": "唔…时间差不多了，我还有另外一位客人，先随我回<color=#00E1FFFF>鸣神大社</color>再谈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160418,
					"content": "怎么突然又要去接待客人了！真搞不懂你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160409,
					"content": "也不是雷电将军的对手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160410
					]
				}
			]
		},
		{
			"id": 201605,
			"completionStepIds": [
				201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201609",
							"2"
						],
						"stepId": 201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160501,
					"content": "好了，就先在这里聊吧。关于你之前问及的计划，其实我也揣摩了很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160502
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160502,
					"content": "你知道制定计划之前，最重要的事是什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160503,
					"content": "是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160504,
					"content": "——认清时局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160505,
					"content": "眼狩令的颁布，明显是有人利用「人偶将军」一心只为永恒的特点所做出的诱导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160506,
						20160507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160506,
					"content": "「散兵」的情报也证实了这一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160508
					]
				},
				{
					"id": 20160508,
					"content": "嗯，这一点的确是最好的佐证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160509,
					"content": "而回想一下眼狩令的颁布与执行，从来都是由天领奉行左右其中，并且助推着法令的进展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160510,
					"content": "好像绫华也说过，每次呈上反对眼狩令的文书的时候，天领奉行和勘定奉行都会马上否决，没有商量的余地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160511,
						20160512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160511,
					"content": "天领奉行正在为愚人众做事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160513
					]
				},
				{
					"id": 20160513,
					"content": "嗯，其实早就已经很明显了，除社奉行外的两奉行，都与愚人众有所勾结。哼，利欲熏心的愚蠢人类们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160514
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160514,
					"content": "于是，现状便是愚人众那边的「搅局者」依旧存在，笼络了两奉行，又在暗中推广邪眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160515
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160515,
					"content": "只可惜如今，在两奉行与雷电将军的庇护下，还揪不出那个搅局人的尾巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160516,
					"content": "那要怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160517,
					"content": "把切入点放在稻妻人身上，总归要好下手一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160518
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160518,
					"content": "我准备…策反天领奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160519,
					"content": "策反天领奉行？你在说什么呀，天领奉行不是已经在造反了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160520,
					"content": "呵呵，我指的不是天领奉行背叛幕府的事，而是…让某个人背叛如今的天领奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160521,
					"content": "利用「她」的话，想必一定可以把你…再次带到雷电将军的面前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160522,
						20160523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160522,
					"content": "别卖关子了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160524
					]
				},
				{
					"id": 20160524,
					"content": "正统领着幕府军的人，每个月的这个时间，都会来神社祭拜，也是我们今天的客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160525
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160525,
					"content": "她好像…已经在你身后了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160526,
					"content": "不要动！通缉犯居然敢大摇大摆地出现在神社！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160527
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160527,
					"content": "#别想动什么歪心思，老实跟我一起去奉行所。抓住{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160528
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160528,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160529
					],
					"speakerTitle": "元助"
				},
				{
					"id": 20160529,
					"content": "九条…裟罗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160530,
					"content": "哟，是不是几位都忘了，这里可是鸣神大社…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160531,
					"content": "在这里动武的话，不敬将军的罪名…你们准备谁来顶一下呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160532,
					"content": "…嘁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160533
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160533,
					"content": "八重宫司大人，你莫非…是在庇护这个通缉犯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160534
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160534,
					"content": "朋友之交而已，哪里谈什么庇护不庇护。你先叫那些手下退下吧，有些事我们可以好好谈谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160535,
					"content": "你们先去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160536
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160536,
					"content": "遵命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160537
					],
					"speakerTitle": "陶义隆"
				},
				{
					"id": 20160537,
					"content": "那么，敢问八重宫司大人，在神社藏匿通缉犯一事，是否也是对将军不敬呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160538
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160538,
					"content": "呵呵呵…还是老样子，九条裟罗大人，论对将军的忠心，没人能及得上你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160539,
					"content": "身为臣下，自当忠于将军，身为武人，将军的境界亦是我一生所求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160540
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160540,
					"content": "即便雷电将军…迟早要把你的神之眼也夺走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160541
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160541,
					"content": "眼狩令是将军的决断，我绝无怨言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160542
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160542,
					"content": "唉，只可惜…一片赤诚，终被时局所负。该说你是糊涂，还是唯一清醒的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160543
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160543,
					"content": "请您直说，宫司大人，您此话是何意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160544
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160544,
					"content": "眼狩令不过是受了愚人众的误导，让稻妻国民自废双手的愚政罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160545
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160545,
					"content": "而「蒙蔽圣听」的正是你自家的主子，天领奉行——九条家的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160546
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160546,
					"content": "你是说，九条家…叛变了幕府？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160547
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160547,
					"content": "正是，你理解的不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160548
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160548,
					"content": "八重宫司大人，您的指控不仅危险，而且可笑。三奉行自古侍奉将军，绝无二心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160549
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160549,
					"content": "我被九条家收养以来，耳濡目染，天领奉行上上下下都对将军忠心耿耿，尤其是家主孝行大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160550
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160550,
					"content": "他对「无想的一刀」的崇拜，胜于所有人，我对将军的尊崇之情不及他万分之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160551
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160551,
					"content": "试问家主又怎么可能做出于将军不利之事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160552
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160552,
					"content": "三天后…等三天后你再来这里，我会把证据给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160553
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160553,
					"content": "作为宫司，我很清楚一件事，人们总是喜欢相信自己愿意相信的事。所以有些事，可能只是你不愿看到而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160554
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160554,
					"content": "那就只好…由我来当这个坏人，把它抽丝剥茧，好好呈现给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160555
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160555,
					"content": "哼…三天对吧，我会来。但如果我没看到证据，那还请宫司大人对妄测九条家一事道歉，还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160556
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160556,
					"content": "#…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}我也会一并带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160557
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 20160557,
					"content": "好了~那就三天后，恭候您的光临了，客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160558
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160558,
					"content": "吓死我了，想不到九条裟罗会到这里来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160559
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160559,
					"content": "话说神子，你刚才所说的，天领奉行叛变的证据…已经有眉目了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160560
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160560,
					"content": "怎么总是在问这样的问题，当然没有了。我是看刚才说服不了裟罗，才临时想到这么讲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160561
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160561,
					"content": "唔…不出所料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160562
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160562,
					"content": "「扭转神明的意志」这件事，本身就是一场大的赌局啊，有谁可以面对神明还有十成的把握呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160563
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160563,
					"content": "那我们该怎么办，时间只剩下三天了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160564
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160564,
					"content": "想拿到证据的话，我们还需要一个帮手，现在…随我去把那位<color=#00E1FFFF>「专业人士」</color>给叫醒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160523,
					"content": "那个人究竟是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160524
					]
				},
				{
					"id": 20160512,
					"content": "勘定奉行也早已背叛幕府了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160513
					]
				},
				{
					"id": 20160507,
					"content": "是愚人众为了趁势推广邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160508
					]
				}
			]
		},
		{
			"id": 201606,
