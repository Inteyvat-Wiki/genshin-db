	"talks": [
		{
			"id": 201601,
			"completionStepIds": [
				201601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201601",
							"2"
						],
						"stepId": 201601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160101,
					"content": "跟着我说，「三二一，一二三，啊啊——」，快一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160102,
						20160104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160102,
					"content": "「三二一，一二三，啊啊——」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160103
					]
				},
				{
					"id": 20160103,
					"content": "嗯嗯，不错不错，说明至少脑子目前还是没什么大碍的，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160106,
					"content": "好不容易把你这个像是嵌在了地里的小家伙给捞回来，要是坏掉了可就太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160107,
					"content": "唔，从一开始我就想问，神子，你的谈吐举止和第一次见到你的时候怎么完全不一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160108,
					"content": "是吗？可能是屏退了其他那些巫女们的缘故吧。而且，我一直都是这个样子哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160109,
					"content": "人们所展现出来的，从来都是自己想展现出来的一面，这点我可清楚得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160110,
					"content": "所以，不论哪一面其实都是真正的「自我」，只是人们总喜欢无意义地去定义罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160111,
					"content": "在这姑且属于人类的社会里，我也不过凭自己兴趣照做而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160112,
					"content": "我，好像没听太懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160113,
					"content": "呵呵，多多研究人类吧，小家伙，你也会明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160114,
						20160115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160114,
					"content": "你究竟是如何…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160116,
					"content": "是呀！我当时光顾着照看旅行者，完全没注意你究竟做了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160117,
					"content": "是「鸣神大社的秘法」，一下子就让那个叫散兵的家伙跪地求饶，你相信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160119
					]
				},
				{
					"id": 20160119,
					"content": "呵呵，比起思考这样的问题，你更应该好好想想该怎么回报我…不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160120,
					"content": "还是说，你的脑袋回路，果然还是出了些问题呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160121,
					"content": "非常感谢你，八重神子大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160122
					]
				},
				{
					"id": 20160122,
					"content": "倒也不必这么郑重就是了，我需要的是你的行动，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160123,
					"content": "你现在应该…还在惦记「邪眼」的事，是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160124,
						20160125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160124,
					"content": "没错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160126,
					"content": "放心好了，那个海祇岛的领航人已经带手下前去清剿了，也向全军颁布了严肃的军令，禁止邪眼的使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160127
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160127,
					"content": "散兵那家伙也不会在据点都暴露的情况下，替他的同僚做些自讨没趣的顽抗吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160176
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160176,
					"content": "唉，要是有时间，真想看看那些愚人众大吃苦头的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160128
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160128,
					"content": "做得可真不错啊，名为珊瑚宫心海的女人，好想当面再跟她好好聊聊，只可惜…信仰分歧真是碍事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160129
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160129,
					"content": "碍事？你可是鸣神大社的宫司呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160130,
					"content": "好了，告诉你这些只是为了让你放心，然后专心…替我办一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160131,
						20160132
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160131,
					"content": "什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160133,
					"content": "你…见过她了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160134,
						20160135
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160134,
					"content": "你是说雷电将军？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160136,
					"content": "我说的，不是那个「人偶」，我是说…你应该见过「她」了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160137,
						20160138
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160137,
					"content": "你是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160139,
					"content": "嗯，为了维持「自我」，而在「一心净土」中进行着无穷无尽冥想的，真正的雷电将军…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160140
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160140,
					"content": "——其名为「影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160141
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160141,
					"content": "你是说，仪式上出现的只是人偶，而真正的雷电将军是旅行者后来见到的那个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160142,
					"content": "也就是说，当时变换过的不只是「战场」，连「对手」也换过了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160143,
						20160144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160143,
					"content": "我也留意到过一些微妙的差别…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160145,
					"content": "这才是那位雷电将军的「永恒」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160146
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160146,
					"content": "在追求这个国度的永恒之前，势必自己要先触及永恒才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160147
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160147,
					"content": "肉身终会归于尘土，就由「人偶」之身来替代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160148
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160148,
					"content": "精神亦难逃磨损，她便将意识寄宿于佩刀之中，用冥想来规避一切纷扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160149
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160149,
					"content": "那么，她用刀划开的那个空间就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160150,
					"content": "「一心净土」，即是与她的「内心世界」一样的空间，一般只容许「自我」的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160151
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160151,
					"content": "封闭在自我的世界里，外部的繁杂都交给那个只会不顾一切奔向永恒的人偶来处理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160152
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160152,
					"content": "…这就是影摸索出的永恒之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160153,
						20160154
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160153,
					"content": "钟离也谈及过「磨损」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160155,
					"content": "你说的是摩拉克斯吗？许久不见，原来璃月的神做出了这样的选择，果然是位有趣的神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160156
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160156,
					"content": "不过雷电将军这样做，好像确实可以避免钟离那样的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160157,
					"content": "呵呵，可是…她的做法不也很像是发脾气把自己关在屋里的孩童一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160158
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160158,
					"content": "而且她所谓的「永恒」，也早已变成了她自己以为的「永恒」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160159
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160159,
					"content": "说到底…不过是在害怕失去而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160160
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160160,
					"content": "我还不清楚你想要我做什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160161
					]
				},
				{
					"id": 20160161,
					"content": "其实…你我立场一致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160162
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160162,
					"content": "你想要拯救眼狩令之下的稻妻子民，我也一样，只不过顺带还想拯救一下这个国家，也拯救一下她而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160163
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160163,
					"content": "而关键就在于——既然「一心净土」也代表着影的内心世界，那么在那里击败她的话，就有着「扭转」雷电将军意志的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160164
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160164,
					"content": "这就是你想到的，废除眼狩令的方法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160165,
					"content": "不是靠言语驳倒她，也不是借用反抗军的力量政变，而是…直接扭转雷电将军的内心世界？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160166
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160166,
					"content": "理解得很快嘛，总之，这是稻妻坠入「黑暗的永恒」之前，唯一还赶得上让它重新走上正轨的方法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160167,
						20160168
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160167,
					"content": "可是为什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160169,
					"content": "你还没意识到自己的特殊之处吗？我说过，「一心净土」一般来说是只容许自我存在的空间，而你可以出现在那里就证明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160170
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160170,
					"content": "…她对你有着足够的兴趣。或许…她也从未见过对永恒来说显得如此「不稳定」的个体吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160171
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160171,
					"content": "没有其他人进去过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160172,
					"content": "从那个永恒的信徒开始封闭自我时起，从来没有过，甚至没人知道那个空间里究竟是什么样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160173
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160173,
					"content": "你的存在不仅是契机，更是「钥匙」…你果然没让我的期待落空啊，小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160174
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160174,
					"content": "欸，你怎么就走了？要去哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160175
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160175,
					"content": "<color=#00E1FFFF>「反雷电将军特训」</color>啊，我可是为你精心准备的，快跟上来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160168,
					"content": "一定要我来呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160154,
					"content": "也是他退位的原因之一。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160144,
					"content": "可她为何要如此费周折？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160138,
					"content": "在那个「空间」里的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160135,
					"content": "见过，就在神像之下的仪式上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160132,
					"content": "这就是救我的原因吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160125,
					"content": "后来怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160115,
					"content": "从散兵手上救下我的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160104,
					"content": "八重神子！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160105
					]
				},
				{
					"id": 20160105,
					"content": "哦？一下子就认出我来了，说明至少脑子目前还是没什么大碍的，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "八重神子"
				}
			]
		},
		{
			"id": 201604,
			"completionStepIds": [
				201604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201604",
							"2"
						],
						"stepId": 201604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
