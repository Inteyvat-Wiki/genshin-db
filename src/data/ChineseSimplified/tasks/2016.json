				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160601,
					"content": "就是这里了吗？前面那个<color=#00E1FFFF>机关</color>是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20160602,
					"content": "就当做是可以复现雷电将军招式的法器吧，我凭着记忆制作的…如果她的武艺没有退步的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160603,
					"content": "能提前摸索好她的出招路数，并找到应对策略的话，会有很大帮助的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160604
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160604,
					"content": "你去试着不要被那些招式打到吧，毕竟从她手中死里逃生过一次，估计难不倒你们吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				}
			]
		},
		{
			"id": 201607,
			"completionStepIds": [
				201607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
