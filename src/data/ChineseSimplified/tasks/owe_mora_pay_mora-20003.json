				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歌德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "谢谢你，这些木材就够了，我这就拿去给木匠…对了，还得去收房租才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030302,
					"content": "唉，也不知道那个…阿斯…阿斯…什么莫娜…这次在不在家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030303,
					"content": "是阿斯托洛吉斯·莫娜·梅姬斯图斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "对！就是这个名字，哎哟…我是真的记不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030305,
					"content": "咦？莫娜还没交房租吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030306,
					"content": "可不是嘛，其他的租客都把房租交了，就剩她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030307,
					"content": "我跑了好几趟了，但她一直都不在家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030308,
					"content": "旅行者，请你帮我跑一趟，去催催她交房租吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				}
			]
		},
