			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歌德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030101,
					"content": "唉，看来我还是得自己跑一趟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030102
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030102,
					"content": "我这把老骨头，非得散架不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030103
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030103,
					"content": "有什么急事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030104
					]
				},
				{
					"id": 200030104,
					"content": "旅行者？唉…也不能算是急事，但我是真的操办不过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030105
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030105,
					"content": "你也知道，那群愚人众把我的酒店给包下来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030106
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030106,
					"content": "他们包下了酒店之后，我作为「歌德大酒店」的老板，自然也得在旁边照应着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030107
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030107,
					"content": "帮着联系食材供应商，物件坏了及时叫人去修，还有一些杂七杂八的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030108
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030108,
					"content": "最近酒店里有几间屋子的桌椅坏了，我得赶紧去联系人，把合适的木材送去给木匠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030109
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030109,
					"content": "还有城里几间屋子的租金没收…玛文那小子又成天不见影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030110
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030110,
					"content": "唉，也不知道我这把老骨头能折腾几年，玛文到底什么时候才能懂事点呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030111,
						200030112
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030111,
					"content": "我来帮您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				},
				{
					"id": 200030113,
					"content": "你，你愿意帮我吗？唉，真的太麻烦你了，玛文那小子要是有你一半懂事，我也不会累成这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030114
					],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030114,
					"content": "那就麻烦你，先帮我去拿一份杉木和一份桦木回来吧，我要赶紧把这些木材交给木匠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌德"
				},
				{
					"id": 200030112,
					"content": "你先在这歇一会吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				}
			]
		},
		{
