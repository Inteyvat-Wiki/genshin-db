			},
			"dialogs": [
				{
					"id": 200030601,
					"content": "骑士团里的图书馆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030602
					]
				},
				{
					"id": 200030602,
					"content": "图书馆啊…嗯！骑士团的图书馆特别大，莫娜说不定会去那边查资料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030603,
					"content": "那我们就过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
