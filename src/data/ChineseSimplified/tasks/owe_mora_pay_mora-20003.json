				"points": []
			},
			"dialogs": [
				{
					"id": 200030501,
					"content": "莫娜，你在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030502,
					"content": "莫娜，该交房租啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "呃…莫娜好像不在呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030504,
					"content": "奇怪，她一般不都是在房间里吗？难道今天出门办事去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030505,
					"content": "难、难道！莫娜已经被饿晕在房间里了，根本没力气来开门吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030506,
					"content": "不至于啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "是、是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030509,
					"content": "但是，我们要去哪里才能找到莫娜呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200030507,
					"content": "她之前都说自己想到赚钱的方法了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
			]
		},
