			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泽田",
					"亚卡巴",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "我想好了！小说的结尾可以放在御舆长正身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "泽田"
				},
				{
					"id": 30320302,
					"content": "意思是，故事里的其他人都不在了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "亚卡巴"
				},
				{
					"id": 30320303,
					"content": "是啊，听说御舆长正一直活到了寿终正寝呢，很适合当小说结尾的叙事者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "泽田"
				},
				{
					"id": 30320304,
					"content": "「怪异的氛围散去了，可未来几十年里，这件事仍如阴云缭绕在御舆长正心头。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "泽田"
				},
				{
					"id": 30320305,
					"content": "「年迈的他做了一个梦。名为『大踏鞴长正』之宝刀锻成那夜，众人欢呼雀跃，作画、起舞、饮酒。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "泽田"
				},
				{
					"id": 30320306,
					"content": "「…万般欢喜都熔在了炉火中，化作红云，围抱着御舆长正一生最后所见的那片朝阳。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "泽田"
				},
				{
					"id": 30320307,
					"content": "「此生路遥远，欲行已忘言。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "泽田"
				},
				{
					"id": 30320308,
					"content": "…哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
			"completionStepIds": [
				303204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303204",
							"2"
