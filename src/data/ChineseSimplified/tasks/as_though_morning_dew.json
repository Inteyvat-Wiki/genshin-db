						"stepId": 303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天音",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "呼——！终于到休息时间啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320502,
					"content": "一旦放松下来，突然觉得好饿好累哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320503,
					"content": "派蒙好好休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "哇！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320506,
					"content": "…咦？那个瓶子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320507,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "是谁来打扫的时候碰碎了吗？可是，没听说有人来收拾过房间呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320509,
					"content": "（那天晚上在住宿处，派蒙被散兵的事吓到，一不小心撞到桌子，导致这只瓶子被打碎。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "（可是紧接着散兵就抹去了自己存在过的事，他是改变了世界吧？那这只瓶子…为什么还是碎的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "听起来，你很迷茫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320512,
					"content": "…是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "我明白你的苦恼。任何人知道这些，都会觉得头晕脑胀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320514,
					"content": "咦？有人在我们耳边说话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320515,
					"content": "不过很可惜，提瓦特的命运轻易无法撼动。神明尚且有微小的可能，非神之身…就难说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320516,
					"content": "小小的动物撞在树干上会令它摇摆，可歪斜不等于位移，命运也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320517,
					"content": "就像瓶子落到地上，小猫打碎的也好，飞鸟打碎的也好。结果它都碎成这样了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320518,
					"content": "你、你是谁啊！为什么你会知道这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320519,
					"content": "历史不会轻易被改变，但人们的心会。相信自己的眼睛，你所见才是真实，未见则为虚幻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "天音"
				},
				{
					"id": 30320520,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
