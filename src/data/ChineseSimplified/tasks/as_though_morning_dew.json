				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#欢迎回来，{NICKNAME}，派蒙，散兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320102,
					"content": "呼！感觉经历了很长的旅途…累死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "莫非你是对这个名字感到不满？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320105,
					"content": "没什么。只是在想，我也该换个名字了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "你不打算叫「散兵」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "明知「博士」做了那么多事，我怎么可能继续采用跟他有关的称号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "我不打算也不可能回到愚人众那边。一定有许多人被这次的事影响，未必还能记得第六席是谁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "意思是你要脱离组织了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320110,
					"content": "也算是变相逃亡吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "正如你所说，小吉祥草王。一切看似徒劳，但并非没有意义，至少能让不少人忘记我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "可那也不意味着你身上的往事就此消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320114,
					"content": "这是自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "另外，你倾尽全力去追求的事，它最核心的目的…并没能达成，这一点还请你明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320116,
					"content": "改变世界、改变过去…改变他人命运，并不是那么容易的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320117,
					"content": "你所渴望的答案是极致的毁灭…它本质是虚妄。即便世上再没有「散兵」，世界也不会遵循你的意志而动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320118,
					"content": "…是啊。哈哈，真可笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "为这样的结果做到这种地步…不会后悔吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320120,
					"content": "哪怕我一文不值，世上也从来没有值得后悔的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "小吉祥草王，世界树里的信息，是你故意留在那里的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "为了让你尽可能自然地收获信息，我也费了不少心思呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320123,
					"content": "为什么不惜做到这一步？你也想拉拢我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "必须诚实地说，过去的经历使你成为了一个对我和须弥有用的个体。拉拢你的确是我计划的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320125,
					"content": "但在那之前，我想把过去的真相告诉你。如果只是利用，我就与「博士」毫无分别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320126,
					"content": "…你很聪明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "这大概是我应具有的美德吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320128,
					"content": "对他人有用就是价值。所以即使身为罪人，我也重新拥有了被利用的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "纳西妲并不是那么想的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "噢对，差点忘了…你们是「正义」的一方，与我不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "不好意思，我看待事物的角度略有不同。但我不会称这一切为算计，你的智慧注定了你会拥有更好的帮手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "你能这么想就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}，未来我还会进一步研究并挖掘世界树里深藏的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320134,
					"content": "包括你血亲被记录在世界树中的旅程之始。前后究竟还有什么？我也想知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320135,
					"content": "那就拜托你为我寻找了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "为什么在我跳进世界树的信息洪流之后，你就去了稻妻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "因为我想知道你改变了什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "…所以才打听到了那些人被改变后的命运吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "不管怎么说，你帮了我的忙，这份恩情我都会尽力偿还。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "…我做这些不是想要回报。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "个体与个体之间只存在「借」和「还」的关系。我们迟早会两清，你不需要在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "不是这样的哦。人与人的关系，绝不是轻易就能抚回原状的白纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320147,
					"content": "你一定感受过。生命中出现过的人不会像水滴蒸发一样消失，世上不存在真正的「两清」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320148,
					"content": "正因为有些事不能挽回也不能改变，人间才会有情感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320149,
					"content": "你感受的所有东西都是真实，你欠下的事物也不会被弥补。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320150,
					"content": "背负裂痕生活下去是人的行为。你可以选择是否成为人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320151,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "没有缺失心脏的人类，不是吗？再说，我早就不想成为人类了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "没有心脏的你依然能理解痛苦。你只是封闭了感情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320154,
					"content": "过去不会被撼动，但你可以继续走。只要未来的线够长，总有一天「过去」会变成比例尺上很短小的一段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320155,
					"content": "听起来，你已经想好怎么安排我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "希望你能配合纳西妲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "很多事情混在一起，都说不清楚了，反正最重要的是，你最好跟随纳西妲，否则我们为什么要做这么多嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320158,
					"content": "…那就让我作为黑暗中的助力与你们同在吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "很高兴你能接受我们的提议。为表庆祝，不如给自己起个新名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320160,
					"content": "快快快，我也要给你起个难听的绰号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320161,
					"content": "为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "因为…因为我还是不怎么喜欢你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320163,
					"content": "哼。那以后我们最好不要经常见面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "「名字是人生第一份馈赠」——虽然你没明说，但我知道你是这么想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320165,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#这次{NICKNAME}和派蒙帮了你不少忙，假如你无法决定要叫什么名字，可以问问他们的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30320167,
					"content": "欸？要我们来决定吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "不行，我只会起绰号，不会起正经名字…交给你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30320144,
					"content": "请不要说得像是我在勒索你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
