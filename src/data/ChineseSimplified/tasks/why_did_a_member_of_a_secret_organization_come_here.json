	"talks": [
		{
			"id": 7565801,
			"completionStepIds": [
				7565801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7565801",
							"2"
						],
						"stepId": 7565801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756580101,
					"content": "欸？从冒险家协会得知的信息不是「不便透露详情的组织」发布的超高难度委托吗？委托人怎么会是小孩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580102,
					"content": "#想必两位就是{NICKNAME}和派蒙了。初次见面，我是委托人赫卡，本次委托的内容两位应该已经了解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580103
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580103,
					"content": "协助我收集巨大怪物的情报，也包括在战斗方面的表现。那么接下来的一段时间要受两位照顾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580104
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580104,
					"content": "哦！就交给我们好了…不对！我们都还没有自我介绍，你怎么会知道我们的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580105,
					"content": "考虑到这次委托的难度，冒险家协会大概率会将任务交给有资历和实绩的冒险家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580106
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580106,
					"content": "而在这些小有名气的候选之中，金发旅行者和小小白色向导的组合也并不多见，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580107
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580107,
					"content": "原来是这样，不过你明明是个小孩子，懂得真多呢！说话也有点老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580108,
					"content": "…咳，比一般小孩沉稳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580109
					]
				},
				{
					"id": 756580109,
					"content": "啊，对！说回正题，你真的是委托人吗？还有「不便透露详情的组织」也很令人在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580110,
					"content": "委托的确是我发出的，至于「不便透露详情的组织」…是卡嘉教我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580111
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580111,
					"content": "虽然很不甘心，但比起一个没有来历的小孩，背景模糊的组织显然更能让协会的人拿出认真的态度对待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580112
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580112,
					"content": "不过关于组织的事我可没有骗人，我的确是这个「不便透露详情的组织」的成员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580113
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580113,
					"content": "我只是把我认为他们应该知道的部分告诉了他们，至于他们从中解读出了怎样的信息，就取决于他们的想象力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580114,
						756580116
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580114,
					"content": "不会是偶尔聚餐的那种组织吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580115
					]
				},
				{
					"id": 756580115,
					"content": "原来是偶尔聚餐的「秘密组织」啊…那根本就是普通朋友聚会吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580117,
					"content": "嗯。毕竟出发之前和玫熙约好了，绝对不说谎话欺骗别人，也不做危险的事。这两项我都做到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580118
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580118,
					"content": "只说实话也可以让事情朝着有利自己的方向发展。只要带上强力的帮手，危险的地方也是安全的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580119
					],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580119,
					"content": "是、是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756580120,
					"content": "当然是了。所以，两位准备好了的话，我们这就启程吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫卡"
				},
				{
					"id": 756580116,
					"content": "哇，是「秘密组织」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580117
					]
				}
			]
		}
	]
}