				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德鲁苏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "今天也没人来吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020302,
					"content": "这就是「知识殿堂的正门」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "没错！这里就是「知识殿堂的正门」，您…看来是解开了我所有的谜语啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020304,
					"content": "太好了！我还以为今天也没人能做到这件事呢！再等一会我可就要回去吃午饭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020305,
					"content": "你为什么要写这些谜语？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "当然是因为「有趣」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020307,
					"content": "回答得好快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735020308,
					"content": "除了这个理由之外，你们觉得我又为什么会写下这些谜语呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020309,
					"content": "难道你们以为，我就是单纯地在享受刁难人的感觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020310,
					"content": "说不定呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "哈哈哈，那你们就和教令院里的某些人一样误解我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020313,
					"content": "我之所以写下这些谜语，就是单纯地喜爱解读谜语时的那种思辨感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020314,
					"content": "你们现在回过头来看我的谜语，里面总是有一个能够解开谜语的「关键词」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020315,
					"content": "只要以这个关键词为突破口不断思考，就一定能解开谜语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020316,
					"content": "如果我是单纯地想要刁难人，那我只要抹去一切线索，把这段谜语变成真正的「无解之题」就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020317,
					"content": "先不说这些了，既然你们解开了我所有的谜语，那这些东西你们就拿着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020318,
					"content": "这是你们用自己的「思辨」赢来的奖励，可要收好了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德鲁苏"
				},
				{
					"id": 735020311,
					"content": "我说不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
