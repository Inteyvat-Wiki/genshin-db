			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布列松"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746690101,
					"content": "布列松，你要相信自己…相信自己，所有的器材都准备好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690102
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690102,
					"content": "只要…呼…只要你下水…下水证明一下这些器材的可靠性，一切就大功告成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690103
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690103,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690104
					]
				},
				{
					"id": 746690104,
					"content": "哎哟！您是从哪冒出来的，怎么连一点声响都没有？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690105
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690105,
					"content": "我吓得差点栽进水里…要是我刚才没稳住，枫丹留影技术就没有未来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690106,
						746690107
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690106,
					"content": "抱歉啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				},
				{
					"id": 746690108,
					"content": "不过，你不会游泳吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746690109,
					"content": "看起来你也是个枫丹人啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690110
					]
				},
				{
					"id": 746690110,
					"content": "谁…谁说枫丹人一定要会游泳了？也不是每一个璃月人都会做菜，每一个蒙德人都会作诗吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690111
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690111,
					"content": "我不和您说了，好不容易才借来这一套潜水设备，今天我必须去水下留影一趟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690112
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690112,
					"content": "原来是这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746690113,
					"content": "这留影机有什么特别之处？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690114
					]
				},
				{
					"id": 746690114,
					"content": "特别之处？这台留影机是由我布列松·卡蒂亲自改造过的，这就是它的「特别之处」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690115
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690115,
					"content": "我的改造方法既严谨，又巧妙，采用的材料也都是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690131
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690131,
					"content": "镜头更是比其他留影机好上无数倍，在水下留影时，画片的质量没有丝毫折损！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690116
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690116,
					"content": "但协会里的那群家伙…对我的新技术根本不在意，还说什么留影主要靠留影者的技术，留影器材不重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690117
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690117,
					"content": "等我拍出几张漂亮的画片，准能让这群压根不懂留影器材重要性的家伙闭嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690118
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690118,
					"content": "呼…布列松，你要相信自己…相信自己…水温很合适，水里也没有会吃人的鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690119
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690119,
					"content": "我…我…哎哟！这潜水服真能管用吗？说不定它会在水底突然爆裂啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690120
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690120,
					"content": "然后我就会被暗流卷到水底，谁也发现不了我，天哪，哎哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690121,
						746690122
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690121,
					"content": "实在不行，我可以帮忙啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690123,
					"content": "#真的吗？！您愿意帮我？慷慨的好{M#先生}{F#女士}，您真是我的大救星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690124,
						746690125
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690124,
					"content": "你还是得付我报酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690126,
					"content": "我当然不可能让您白帮我跑这一趟，您一定能拿到一大笔报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690127
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690127,
					"content": "对了，我还得把几处水底的好风景标在您的地图上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690128
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690128,
					"content": "还有一些地上的，呃…应该是在这附近…这是全新的器材，得多找几个地方测试一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690129
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690129,
					"content": "这样就行了，枫丹留影技术的未来，还有我的留影机器材事业，就全部拜托给您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690130
					],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690130,
					"content": "我就…呃…在岸上等着您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布列松"
				},
				{
					"id": 746690125,
					"content": "但报酬要按照协会的规矩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690122,
					"content": "不然…我帮你去水下留影吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690107,
					"content": "也没想到你反应这么大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				}
			]
		}
	]
}