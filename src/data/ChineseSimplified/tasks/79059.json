			"dialogs": [
				{
					"id": 790590101,
					"content": "此处为短剧《东行·旅途的开始》片场的弃用场景",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790590102,
					"content": "原本构想的是试图从枫丹出发，向东前往须弥城寻找智慧宫不智之智的旅者的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790590103,
					"content": "这一幕是他在路上解救了被巨岩压身的「变幻大师」，与之一起踏上旅途的情节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790590104,
					"content": "啊不过，不管是饰演旅者的水形幻灵，还是饰演「变幻大师」的水形幻灵都不知道到哪去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "片场备注"
				},
				{
					"id": 790590105,
					"content": "如果能<color=#00E1FFFF>把他们全都找回来</color>，捕捉到在巨岩边练习的时刻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "片场备注"
				}
			]
