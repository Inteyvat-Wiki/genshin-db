				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "咦？这边好像还有一幅画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761240402,
					"content": "啊哈，好眼色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240403,
					"content": "这是那些个自称古华传人的小娃娃先前委托卡斯蒂廖内画出来的玩意儿，说是他们引以为傲的「演武场」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240404,
					"content": "不过嘛，他们心气都高傲得很。觉着自个儿已经是绝顶高手，早就不需要这般基础的修习了，就把画送给我咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240405,
					"content": "欸？你不是古华派的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761240406,
					"content": "哈哈哈，我倒想说自己是。可惜呀可惜，古华小子怕是没胆子收我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240407,
					"content": "当初他跟我在归离原剿灭贼匪的时候，那小子还险些因为学艺不精、丢了性命，叫我不得不…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240408,
					"content": "罢了罢了，都是些没意思的事儿，不过这画倒是还有些意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240409,
					"content": "你要是有兴趣，不妨展开看看？撕坏了也没事儿，反正卡斯蒂廖内一天到晚也闲得无事可做，叫他再画一幅便是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妌癸"
				}
			]
		}
	]
}