			"dialogs": [
				{
					"id": 761240301,
					"content": "好嘞，结束！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240302,
					"content": "#多谢两位，让我开心得很。尤其是这位金发的{M#小哥}{F#小妹}，身手着实不凡，怕是比我知道的古华小子强多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240303,
					"content": "不愧是我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "拜两位所赐，我也久违地有了些感悟。鱼酱果然还是得加点剁碎的新鲜兽肉提味，否则放久了以后，腥气还是遮不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240307,
					"content": "哦哦，原来如此原来如…咦？好像完全不挨着啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761240308,
					"content": "哈哈，这种小事就别放在心上啦！等我下回让卡斯蒂廖内给我多画些鱼，我再请你们吃鱼酱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妌癸"
				},
				{
					"id": 761240304,
					"content": "过誉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "哈，不必谦虚。你的剑技很强，这我还是看得出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "妌癸"
				}
			]
		},
