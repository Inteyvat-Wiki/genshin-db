			"dialogs": [
				{
					"id": 718120201,
					"content": "怎么样，有什么发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 718120202,
					"content": "发现了这个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "这是…我从来没见过这种东西，这是在哪里发现的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 718120205,
					"content": "在遁玉陵附近…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "遁玉陵？那里怎么还有这种东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 718120207,
					"content": "谢谢你帮忙解开了那条线索，按照冒险家的规矩，这件东西就归你了，这些报酬也请收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 718120208,
					"content": "我也会尽快安排人，去遁玉陵那边进行更细致的搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 718120209,
					"content": "真奇怪…遁玉陵那一带都搜索过好几次了，怎么还会有遗漏的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
		},
