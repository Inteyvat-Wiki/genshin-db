			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#{M#大哥哥}{F#大姐姐}！请等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390102,
					"content": "请问…你是冒险家吗？就是那种去过很多地方冒险，很擅长战斗的冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390103,
					"content": "算是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#你看！希尔米，我就说这位{M#大哥哥}{F#大姐姐}一定是冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390106,
					"content": "但是冒险家不都是穿那种绿绿的衣服吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "希尔米"
				},
				{
					"id": 230390107,
					"content": "我比较厉害，不用那么穿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "喔——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "希尔米"
				},
				{
					"id": 230390110,
					"content": "喔——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390111,
					"content": "#那{M#大哥哥}{F#大姐姐}！你肯定能帮我们这个忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390112,
					"content": "你看见村子里那个大大的仓库了吗？哈巴奇哥哥说，里面装着很重要的东西，必须要好好防守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390113,
					"content": "他还和我们说，如果有坏蛋来攻击村子，他就要先去把升降梯停掉，然后切断吊桥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "希尔米"
				},
				{
					"id": 230390114,
					"content": "可那个仓库离升降梯还有好一段距离呢，哈巴奇哥哥要是想停掉升降梯，还得拼命跑过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390115,
					"content": "我们就提出，我们可以陪他练习，但哈巴奇哥哥都不搭理我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390116,
					"content": "明明每次我们想去打水漂的时候，他都反应那么大，嘁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "希尔米"
				},
				{
					"id": 230390117,
					"content": "咳，总之！如果坏人来攻击村里，哈巴奇哥哥又跑不动了，那就只能由我们去停掉升降梯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390118,
					"content": "#{M#大哥哥}{F#大姐姐}，你是个冒险家，肯定很擅长跑步吧，就请你陪我们训练一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390119,
					"content": "那我就陪你们跑一段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "#好耶！谢谢{M#大哥哥}{F#大姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390126,
					"content": "#我们已经选好起点了，我们去那边吧，{M#大哥哥}{F#大姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "希尔米"
				},
				{
					"id": 230390127,
					"content": "嘿嘿，这次就由我来和你对决。先说好，我可是很擅长跑步的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希尔米"
				},
				{
					"id": 230390121,
					"content": "可以相信哈巴奇的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "欸…就陪我们玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390123,
					"content": "#陪，陪我们训练一下吧，{M#大哥哥}{F#大姐姐}，拜托啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390124,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "#好耶！谢谢{M#大哥哥}{F#大姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "奥贝德"
				},
				{
					"id": 230390108,
					"content": "我比较特别，不用那么穿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "这么说倒也没问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
