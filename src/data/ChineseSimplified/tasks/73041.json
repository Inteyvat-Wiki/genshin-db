					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "那菈朋友是不是怕输？玩游戏，不要在乎输赢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
