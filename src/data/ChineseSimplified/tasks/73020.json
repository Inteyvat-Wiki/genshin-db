			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰茶荼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "呜噢？呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200102,
					"content": "啊。是那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200103,
					"content": "咳咳。让那菈目睹我狼狈的模样，真是十分羞愧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200104,
					"content": "善良的那菈，我是兰茶荼。二位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200105,
					"content": "#我叫{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "我叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200107,
					"content": "#那菈{NICKNAME}和派蒙，我明白了。真是十分感谢。倘若不是在这里与你们有缘相遇，要恢复还得花上一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200108,
					"content": "一点时间是多久啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200109,
					"content": "实在惭愧，以前也因为不好的蘑菇，遇到过类似的情况。后来，水中的月莲绽开又合上，重复了两次，我就恢复了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200110,
					"content": "绽开又合上…那不是要花两天时间吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200111,
					"content": "啊，两天。原来如此，原来这就是「天」的意思。你们那菈真有意思。两天算是长还是短呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200112,
					"content": "#嗯…{NICKNAME}，你觉得呢？两天算长还是短？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200113,
					"content": "算是长吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "嗯嗯。很难想象兰茶荼「呜噢噢噢噢」整整两天呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200115,
					"content": "是吗？原来这样算很长时间啊，不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200126,
					"content": "不过，这么说来，你叫兰茶荼的话…是兰帕卡提的亲人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200127,
					"content": "不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200128,
					"content": "欸？但是…你是兰帕卡提的哥哥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200129,
					"content": "咦，你们怎么知道？兰帕卡提是我的「妹妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200130,
					"content": "到底是怎么回事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200131,
					"content": "可能兰那罗的概念不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "总之，事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200133,
					"content": "向兰茶荼述说事情的经过。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "无忧节又要举办了吗…该怎么办呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200135,
					"content": "我还没有准备好重要的「食材」，在无忧节向兰萨卡、兰阿帕斯、兰非拉证明，蘑菇菜肴才是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200136,
					"content": "这么说来，兰斯…斯帕…兰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200137,
					"content": "兰萨卡、兰阿帕斯、兰非拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "啊啊啊！兰那罗的名字好难记喔！兰茶荼，你的兄弟到哪去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200139,
					"content": "我们在各自修行的道路上渐行渐远。就像河流变成溪流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200140,
					"content": "也就是分散了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200141,
					"content": "我们「烹饪修行」是为了做出「至上珍馐」，可是他们竟然不承认蘑菇菜肴。明明「一头菇」无可匹敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200142,
					"content": "总之，我们决定完成各自的菜肴，等完成后再比较。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200143,
					"content": "原来是这样。既然是对美食的追求，那就完全可以理解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200144,
					"content": "那么，你的「一头菇」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200145,
					"content": "近来「无留陀」的蔓生频繁，「一头菇」所生长的环境也被占据了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200146,
					"content": "啊，也就是死域…希望拉娜一切安好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200147,
					"content": "珍贵的蘑菇恐怕也被枯萎的爪牙刨走。想必二位也明白，「无留陀」之地凶险非常，非常凶险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200148,
					"content": "没有「一头菇」，就尝试了不曾有兰那罗吃过的怪怪蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200149,
					"content": "结果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200150,
					"content": "结果就是我们看到的样子吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "实在是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200153,
					"content": "不过这么说来，死域…也就是「无留陀」，我们之前也对付过吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200154,
					"content": "轻轻松松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "喔，真是不可思议。你们居然有与「无留陀」抗衡的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200157,
					"content": "#不过这样就说得通了。既然那菈{NICKNAME}能使用草王的力量治愈我，那消除「无留陀」的影响想来也不是问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200158,
					"content": "#那么，我想请求那菈{NICKNAME}随我一同，深入「一头菇」生长的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200159,
					"content": "#是品尝美味无比的蘑菇菜肴的机会！{NICKNAME}，为了让他们兄妹团聚，我们就帮帮忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200160,
					"content": "好。反正本来也答应了兰帕卡提。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "好。就在前方的洞窟里。请陪我一起去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200161,
					"content": "你只是想吃吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "一举两得，有什么不对嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200155,
					"content": "勉勉强强。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "「呜噢噢噢噢——！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "算是短吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "唔…确实，这么想来，我们已经认识了这么久。但感觉就像昨天一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200118,
					"content": "是吗？那我就放心了。在森林里失控两天原来也不算太长时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200119,
					"content": "倒不是这个意思啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200120,
					"content": "取决于这个时间用来干什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "嗯，确实呢。如果「呜噢噢噢噢」整整两天，就是很长时间。如果是野林猪从小长大，就是很短时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200122,
					"content": "是吗？原来这样算很长时间啊，不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200123,
					"content": "时间是主观概念，没有意义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#嗯。那菈{NICKNAME}，你很明白森林的道理。对于森林来说，生命诞生、生命成长、生命回归土地，都不需要「天」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200125,
					"content": "什么乱七八糟的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰茶荼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "啊啊，我朝思暮想的「一头菇」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200202,
					"content": "「一头菇」，倘若你失去了你的芬芳，你还会是「一头菇」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200203,
					"content": "嘿嘿，蘑菇。闻起来确实很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200204,
					"content": "不管怎么说，我们出去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰茶荼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "能遇到你们，真是一件幸事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200302,
					"content": "这是完全成熟的「一头菇」的味道，比起上次我闻到的更醇厚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200303,
					"content": "看来即使生长之处被「无留陀」占据，你也好好成长了，真是了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200304,
					"content": "嗯，那个，「一头菇」…能让我们尝尝吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200305,
					"content": "自然。且不论二位有恩于我，再一次用最美味的蘑菇菜肴招待那菈本来就是我「烹饪修行」的目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200306,
					"content": "好耶！一头菇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200307,
					"content": "兰茶荼立刻进行了烹饪…\\n蘑菇鲜香的风味自锅中满溢而出。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "随后，兰茶荼将成品交给你与派蒙。\\n…应该说是令人失望还是符合预期呢，并没有什么滋味。\\n而且充满了强大的生命力，组织实在太过坚韧，难以嚼碎。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "…完成了。我的「烹饪修行」，已经抵达了完满的终点。如何？对于那菈来说，想必是最好的美味吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200310,
					"content": "嚼嚼…咕噜…唔…该怎么说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200311,
					"content": "（用力咀嚼）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "（用力吞咽）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "算是可以吃。够努力的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "嗯…确实是很香的蘑菇呢，不过味道和口感不太适合我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200317,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200318,
					"content": "#怎么会这样呢，之前同样做给那菈吃的时候，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}明明说好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200319,
					"content": "之前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200320,
					"content": "#以前，我也做过蘑菇菜肴给那菈吃。而且因为好吃，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}咽下去的时候还特别用力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200321,
					"content": "应该没有问题才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200323,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "唉。就像不同的兰那罗，会长出不同的叶子。蘑菇的滋味，或许也不一定适合所有那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200325,
					"content": "是啦，不过说起叶子…你们兰那罗难道不怕火吗，明明自己看上去也有很多叶子一样的成分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200326,
					"content": "火当然是可怕的，有时森林中燃起的山火，会将一整座山头化为荒地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200327,
					"content": "但是，毕竟是为了「烹饪修行」，忍住心中对于火的恐惧，控制火候的大小，也是修行的一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200328,
					"content": "原来如此…也是时候回去了，兰帕卡提还在等着你们呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200329,
					"content": "嗯。我马上就回桓那兰那。不然，让重要的「妹妹」担心，可不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200330,
					"content": "至于那几个家伙…兰萨卡、兰阿帕斯、兰非拉分别在<color=#00E1FFFF>化城郭附近</color>、<color=#00E1FFFF>水天丛林</color>和<color=#00E1FFFF>降诸魔山</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200331,
					"content": "#谢谢你们。金灿灿的那菈{NICKNAME}，就如太阳般耀眼。派蒙，也有点了不起。妹妹的委托，就麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200332,
					"content": "为什么到了我这里就变成了「有点了不起了呀」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200333,
					"content": "哎呀，不要在意…总之，你们帮了我那么多，我都不知道该怎么报答你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200334,
					"content": "嗯，我决定将「至上珍馐」的做法教给二位。或许将来，长大以后，你们能明白个中滋味吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200335,
					"content": "#（{NICKNAME}，这个食谱，让我调整一下吧…应该有办法变成不错的原创菜式！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730200314,
					"content": "至少没有毒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "这种滋味对我来说或许有点太早了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
