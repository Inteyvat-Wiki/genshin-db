			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "采到了「一头菇」，完成了烹饪修行，认识了高大又可靠的那菈。真是开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200402,
					"content": "#兰帕卡提、兰萨卡、兰阿帕斯、兰非拉一定也会感谢你的。那菈{NICKNAME}，你是个好那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730200403,
					"content": "感谢我？为什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "当然是因为，通过帮助我，给了他们品尝「一头菇」的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰茶荼"
				}
			]
		},
