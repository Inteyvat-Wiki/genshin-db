			"dialogs": [
				{
					"id": 730240501,
					"content": "哎呀，真是帮大忙了！谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240502
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240502,
					"content": "如二位所见，我是这边的巡林官。名字嘛，叫拉娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240503,
						730240505
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240503,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240504
					]
				},
				{
					"id": 730240504,
					"content": "我的名字叫派蒙！我们是从别的国度来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240507,
					"content": "原来如此。嗯…从穿着打扮来看，确实不像是森林的子民…也不像是从黄沙里来的。透气性看起来很好，很适合在须弥行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240508
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240508,
					"content": "咳咳！不管怎么说，我们巡林官的职责是保护森林、帮助旅人、提供指引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240509
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240509,
					"content": "#诚如{NICKNAME}和派蒙所见，最近林子…应该说状况不太理想吧？无论是「蕈兽」，还是猛兽，都特别狂躁。还有「死域」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240510
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240510,
					"content": "不如让我送你们一程吧？我的巡林路线接下来会经过维摩庄。到那边沿着水路，无论是去奥摩斯港，还是须弥城，都很方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240511,
						730240513
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240511,
					"content": "可以，我们走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240512
					]
				},
				{
					"id": 730240512,
					"content": "嗯，我会保障二位平安的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240513,
					"content": "好，不过暂时有点别的事要处理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240514
					]
				},
				{
					"id": 730240514,
					"content": "我明白了，我会暂时在这里等你们。要注意安全喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240505,
					"content": "我们来自很远的地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240506
					]
				},
				{
					"id": 730240506,
					"content": "#嗯！我叫派蒙，{M#他}{F#她}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
