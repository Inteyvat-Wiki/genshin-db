			},
			"dialogs": [
				{
					"id": 730240101,
					"content": "哎呀，真是帮大忙了！谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240102,
					"content": "如二位所见，我是这边的巡林官。名字嘛，叫拉娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240103,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "我的名字叫派蒙！我们是从别的国度来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240107,
					"content": "原来如此。嗯…从穿着打扮来看，确实不像是森林的子民…也不像是从黄沙里来的。透气性看起来很好，很适合在须弥行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240108,
					"content": "嗯？这么说来，既然拉娜是巡林官的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240109,
					"content": "应该认识提纳里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#哦哦！{NICKNAME}也认识前辈吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240111,
					"content": "提纳里前辈虽然有着「生人勿近」的气场，但其实是很不错的人。见习的时候，受了他很多照顾呢。而且，他的耳朵很漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240112,
					"content": "嗯嗯！其实我也很想摸摸看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240113,
					"content": "其实我也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "嗯…如果悄悄飞过去的话，是不是可以摸到呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240115,
					"content": "哈哈哈，如果贸然动手，提纳里前辈应该会生气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240118,
					"content": "对吧？看起来很有光泽，不知道是什么样的触感。他现在在带的孩子对这个也很有兴趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240119,
					"content": "咦？拉娜说的，难道是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240120,
					"content": "是柯莱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#咦，{NICKNAME}也认识柯莱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240122,
					"content": "柯莱的身体似乎不太好。就算是这样，她也很努力地看护着森林、祓除死域。大家都很担心她的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240141,
					"content": "咳咳！不管怎么说，我们巡林官的职责是保护森林、帮助旅人、提供指引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240142,
					"content": "#诚如{NICKNAME}和派蒙所见，最近林子…应该说状况不太理想吧？无论是「蕈兽」，还是猛兽，都特别狂躁。还有「死域」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240143,
					"content": "不如让我送你们一程吧？我的巡林路线接下来会经过维摩庄。到那边沿着水路，无论是去奥摩斯港，还是须弥城，都很方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240144,
					"content": "可以，我们走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "嗯，我会保障二位平安的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240146,
					"content": "好，不过暂时有点别的事要处理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "我明白了，我会暂时在这里等你们。要注意安全喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240116,
					"content": "派蒙可以悄悄飞过去摸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "喂！这样的话，提纳里会生气吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730240123,
					"content": "应该认识柯莱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#咦，{NICKNAME}和那个孩子见过面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240125,
					"content": "柯莱的身体似乎不太好。就算是这样，她也很努力地看护着森林、祓除死域。大家都很担心她的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240126,
					"content": "不过，既然她身边有那个「耳朵看起来很好摸」的前辈，应该不会有问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730240127,
					"content": "咦？耳朵…难道是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
