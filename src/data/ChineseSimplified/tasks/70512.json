			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"爱德琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "贵安，两位。好久不见了，你们还是很有精神呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120202,
					"content": "爱德琳女仆长，你好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120203,
					"content": "两位是来找迪卢克老爷商议要事的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120204,
					"content": "只是为了葡萄汁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "确实，既然爱德琳小姐站在门口，还是直接拜托爱德琳小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120207,
					"content": "爱德琳小姐，我们总是错过酒庄的特价葡萄汁，这次想早点过来预定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120208,
					"content": "我们多付一点定金也可以哦，请给我们预留一瓶吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120209,
					"content": "当然没问题，完全不用定金！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120210,
					"content": "只不过，要麻烦你们稍微等等了。晨曦酒庄的特价葡萄汁需要不少准备时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120211,
					"content": "每年夏天，迪卢克老爷都会亲自挑选两桶品质上好的葡萄，用来制作特价葡萄汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120212,
					"content": "为什么要把良品低价卖出去呢？「品质上好的葡萄」，明明一听就很贵啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120213,
					"content": "老爷没有明确解释过，我也只能揣测他的想法——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120214,
					"content": "特价只是一种手段，标着特价的商品往往能吸引更多顾客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120215,
					"content": "也许老爷希望用这种方法让果汁流行起来，为人们提供一种新的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120216,
					"content": "酗酒的人能找到理想替代品，这样就不会在酩酊大醉后闹事，不能喝酒的人们也可以获得别样的乐趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120217,
					"content": "酒庄的生意不会变差吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "老爷不是计较那一点小钱的人。也许，相比毫无节制地增长营收，他更希望人们都能适度饮酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120220,
					"content": "享受美酒和生活的同时也保持理智，不给别人增加麻烦…这不是很好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120221,
					"content": "迪卢克老爷可真是用心良苦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120222,
					"content": "所以现在，迪卢克正在挑选今年的葡萄吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120223,
					"content": "暂时还没有。等到老爷处理完手边的麻烦事，就会开始这道工序的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120224,
					"content": "如果你们有兴趣，老爷或许会邀请你们，参考你们的建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120225,
					"content": "麻烦事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "两位是知道的，老爷常常听见风声，提前去「招待」一些无礼无德之徒，这次也一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120227,
					"content": "今天老爷大概是去鹰翔海滩附近了，还请两位少安毋躁，先到酒庄里边坐坐吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120228,
					"content": "我还要在门口等待某些客人，海莉和摩可会招待你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120229,
					"content": "无德…无礼？有点不明白爱德琳小姐的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120230,
					"content": "我猜，是迪卢克的「兼职」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "欸？难道说的是暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120232,
					"content": "咳咳！对付暗中作祟的深渊教团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120233,
					"content": "作为迪卢克老爷的伙伴，我们可不能坐视不理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120238,
					"content": "如果你们两位愿意协助，也是一件好事。毕竟你们是老爷信任的人，实力有保障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120239,
					"content": "感谢两位主动伸出援手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "爱德琳"
				},
				{
					"id": 705120240,
					"content": "没什么啦！迪卢克老爷早点闲下来，我们也能更早买到好喝的葡萄汁嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120241,
					"content": "#走吧，{NICKNAME}，我们现在就去鹰翔海滩那边看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120234,
					"content": "那就先去酒庄里等迪卢克吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "唔，总觉得迪卢克在外面忙，我们却坐在他家里发呆，有点不合适呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120236,
					"content": "我们还是去鹰翔海滩那边看看，帮迪卢克搞定那些麻烦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120237,
					"content": "虽然迪卢克老爷很强，但帮手总是多多益善的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120218,
					"content": "这是在开展额外业务吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "好像算不上要事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "看起来不像是迪卢克的帐篷，会是冒险家的营地吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120402,
					"content": "那里有一张纸条和一本笔记？我们读读看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120403,
					"content": "诰告「暗夜英雄」，当年的异常现象再次出现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705120404,
					"content": "原本你已彻底解决问题，但这次地脉又受到了某种刺激，再次释放出了记录中的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705120405,
					"content": "你想必会在第一时间赶来，处理掉威胁最大的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705120406,
					"content": "我就遵照行动守则，先去通知必要人士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705120407,
					"content": "嗯…看这张纸条的口吻，好像是迪卢克认识的人呢，就先叫他「老爷朋友」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120408,
					"content": "他在这里发现了什么不得了的事，给迪卢克老爷留下纸条以后就离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120409,
					"content": "真粗心啊，这种纸条要是被别人看到了怎么办？还有笔记本，也没带走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120410,
					"content": "不过这么说来，海滩上那个奇怪的地脉淤积点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120411,
					"content": "就是他所说的「异常现象」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "周围没有魔物，也没有不对劲的地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}，你还想读一读老爷朋友的笔记吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705120414,
					"content": "如果你不想读了，我们就直接过去，凑近点看看吧。",
					"roleType": "TALK_ROLE_NPC",
