			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「散兵」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "哦？这就是从前的尖帽子峰吗？变得好小呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141102,
					"content": "哎，有人先到了？这里是什么观光景点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141103,
					"content": "啊！是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141104,
					"content": "唔…嗯？是你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141105,
					"content": "你是怎么找到这里的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "他这个样子，难道是刚从梦境里出来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141108,
					"content": "竟然有人能凭自己的力量苏醒过来…怎么可能？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141109,
					"content": "哼，你们做不到，不代表我也做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141110,
					"content": "你们来晚了一步，我的「研究」已经完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141111,
					"content": "果然这一切都是你们愚人众搞的花样吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141112,
					"content": "别那么紧张，我今天没时间陪你们玩。下回再找你的麻烦也不迟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141113,
					"content": "等等！你到底有什么目的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "你刚才进入了那个众人共通的雪山梦境吧？你对莱纳德的事知道多少？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141115,
					"content": "莱纳德？什么莱纳德…哼，不管了，现在可不是关心杂鱼的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141116,
					"content": "我发现了…更可怕、更重要的事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141117,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141118,
					"content": "是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "星空本身，就是个巨大的谎言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141120,
					"content": "星空…谎言？这是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141121,
					"content": "是想反驳莫娜的什么占星术理论吗？那也不用说「星空本身是谎言」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141122,
					"content": "在夜里，抬头往天上看，不就能直接看到星星吗？这种常识…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141123,
					"content": "哈…哈哈哈哈哈哈！还在说这种天真的话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141124,
					"content": "不过，这也不是你的错，因为直到不久之前，我也是这样相信的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141125,
					"content": "直到刚才？你是指…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411141126,
					"content": "哼，我可没空再陪你们探讨这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141127,
					"content": "「丑角」那家伙…把这种任务交给我，居然不事先预警可能的「发现」…是想故意吓我一跳吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141128,
					"content": "我现在必须去确认「真相」。那么，再见了，菜鸟们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141106,
					"content": "你是刚睡醒吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
