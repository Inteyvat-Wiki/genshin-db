			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"菲谢尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "咦，菲谢尔在等我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140102,
					"content": "来得可真是时候。虽然不舍，也必须和各位说出这番话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411140103,
					"content": "暂且与本皇女辞别吧，同行者。一路上你展现了非凡的勇气，这股嘉奖的风正是为你而起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140104,
					"content": "哎哎哎？怎么突然道别呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140105,
					"content": "菲谢尔，你要走了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "大陨石加剧了昏睡现象，连身强体壮的士兵也支撑不住。现在到处都缺乏人手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411140107,
					"content": "皇女与我要代替士兵看护那些患者，剩下的事就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411140108,
					"content": "#{NICKNAME}…再见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140109,
					"content": "你是很好的聆听者，愿意陪我聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140110,
					"content": "平时，即使在协会里，许多冒险家愿意跟我搭档，也只是为了从我的话里听出奥兹侦察的结果而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140111,
					"content": "这次的一小段旅途，是一场很好的冒险。突然说要走，我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140112,
					"content": "咦？菲谢尔的说话方式，是不是有点不像平常的那种…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140113,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140114,
					"content": "（啊——啊啊啊刚才不小心出神了…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140115,
					"content": "小，小姐的意思是…你们是如此勇敢，又有常人难及的智慧，任何谜题在你们面前都会化为乌有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411140116,
					"content": "怎么这次奥兹「翻译」的方向完全反过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140117,
					"content": "咳，咳咳…小姐想说，如果是你们几位，一定可以抵达幻象背后的真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411140118,
					"content": "咳咳…唔，没错。你们是皇女的扈从。断罪的骑士，你要带领他们走出黑暗，回归光明之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411140119,
					"content": "谁是你的扈从啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140120,
					"content": "奥兹，菲谢尔，谢谢你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "还会再见的，等一切结束，再约着喝杯酒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411140122,
					"content": "哎，可惜了两个好帮手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140123,
					"content": "别愁眉苦脸的，说个好消息吧，我有新发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140124,
					"content": "我从大陨石上刮来一些粉末帮助占卜，卓有成效哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140125,
					"content": "这些坠落的石头已经存在成百上千年，莱纳德应该是很久之前的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140126,
					"content": "陨石传递着他的意志，也就是说，千百年来他的愿望一直没有减弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140127,
					"content": "一个热切渴望登上山顶的古人…我敢断定，他和你一样，也是冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140128,
					"content": "冒险家？难怪这么想爬上雪山！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140129,
					"content": "目前的办法几乎是跟时间赛跑，我们很被动。必须转换思路，从根本上解决问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140130,
					"content": "我支持！我认为现在应该把重心放在莱纳德身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140131,
					"content": "嗯…如果陨石承载了某种愿望，那这些石头就正如菲谢尔所说，算是某种形式的「诅咒」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140132,
					"content": "真难得，她蒙对了…咳咳，算了，优雅的占星术士不该这样评价别人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140133,
					"content": "总之，我们只要去解开诅咒就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140134,
					"content": "现在就出发吧，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140136,
					"content": "既然要调查从前的冒险家，就该从<color=#00E1FFFF>冒险家协会</color>入手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4111407,
