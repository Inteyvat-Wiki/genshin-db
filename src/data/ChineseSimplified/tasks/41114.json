			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140701,
					"content": "叫这个名字的冒险家有好几个，我也不敢断论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411140702,
					"content": "但我有印象看过叫这个名字的人写的书，不如去图书馆看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411140703,
					"content": "但我记得，有一本作者名叫莱纳德的书，你们不如去<color=#00E1FFFF>图书馆</color>看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 4111408,
			"completionStepIds": [
				4111414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
