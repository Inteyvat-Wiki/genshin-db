			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "找到了！冒险家手册《山与海之书》，作者莱纳德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141402,
					"content": "可是，这本书居然缺字少页，根本看不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141403,
					"content": "怎么这样，呜…该不会白来了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411141404,
					"content": "别放弃，拿给莫娜看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "啊，对哦，说不定她有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
