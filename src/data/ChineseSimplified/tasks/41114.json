			},
			"dialogs": [
				{
					"id": 411140801,
					"content": "作者，莱纳德…莱纳德…有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140802,
					"content": "索引上说，莱纳德的冒险家手册在图书馆<color=#00E1FFFF>一楼</color>的<color=#00E1FFFF>西北角</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140803,
					"content": "西北角…应该就是那边吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4111409,
			"completionStepIds": [
				4111409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111409",
							"2"
						],
						"stepId": 4111409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "找到他的书了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140902,
					"content": "快给我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140903,
					"content": "内容有缺损，完全不连贯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "哼哼，我就知道会这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140905,
					"content": "如果是一般的占星术士，多半已经投降了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140906,
					"content": "但我莫娜可是未来的占星术第一人，没有什么东西能难倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140907,
					"content": "用星盘推算缺漏的部分填入其中，再进行解读…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140908,
					"content": "呼——！终于看完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140909,
					"content": "说了什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140910,
					"content": "和我想的一样，莱纳德是一名两千年前的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140911,
					"content": "他毕生的梦想就是登上一座名叫「尖帽子峰」的雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140912,
					"content": "两千年？这些陨石是…古代人的「命之座」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140913,
					"content": "他的命之座由于某种原因被召唤到大地上。关于这点，我认为和愚人众有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140914,
					"content": "同意，稀奇古怪的事情就数他们干得最多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140915,
					"content": "这些陨石内含元素力，以一种精神暗示的方式辐射了周围居民，使他们陷入梦境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140916,
					"content": "另外如果我猜得没错，这批陨石中应该有一颗类似核心的存在，是莱纳德精神的结晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140917,
					"content": "它会在哪里呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "如果我是莱纳德，这颗核心一定会按我所想，从空中抵达生前没能登上的山顶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140919,
					"content": "核心会在尖帽子峰吗？可是…尖帽子峰在哪里呀？我都没听说过这个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140920,
					"content": "我也是第一次知道。对比书中地图与现在的蒙德地形，我发现，尖帽子峰已经不存在了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140921,
					"content": "那么大一座雪山也会消失吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411140922,
					"content": "我在书上读到过，风神巴巴托斯为了他的人民，曾经动用神力吹散冰雪，也改变了蒙德的地貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140923,
					"content": "过去的山峰被一望无垠的大海取代了。但若将那座山放入海中，以它曾经的高度，还是会留下一些痕迹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140924,
					"content": "——峰顶露出水面的部分，如今叫做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 411140925,
					"content": "<color=#00E1FFFF>「马斯克礁」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 4111411,
