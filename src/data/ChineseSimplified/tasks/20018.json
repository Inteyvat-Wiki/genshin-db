			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "谢谢你，旅行者，呜…我就知道，我肯定会把工作给搞砸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "害怕的玛伽"
				},
				{
					"id": 200180102,
					"content": "就是运一车酒而已我都能搞砸，我到底能做成什么事情呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "害怕的玛伽"
				},
				{
					"id": 200180103,
					"content": "这么下去肯定会被酒庄开除，康纳先生说不定早就觉得我工作能力不行，埃泽先生也许把我的辞退信都拟好了，完了，全都完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "害怕的玛伽"
				},
				{
					"id": 200180104,
					"content": "你…你冷静点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "唉，我肯定完蛋了，但是这车酒还是要运到才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "害怕的玛伽"
				},
				{
					"id": 200180106,
					"content": "车也被打坏了…旅行者，能麻烦你帮我找点材料来吗？只要一块<color=#00E1FFFF>结实的木板</color>就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "害怕的玛伽"
				}
			]
		},
