						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"派蒙"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							229.674,
							237.95,
							9642.107
						],
						"pointId": 9945
					}
				]
			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "没想到还发生过这样的事…密力奇，还有留下这篇笔记的人，大家真的都好勇敢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751260602,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "这个是…是刚才手记里提到的，那颗休眠的龙蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751260604,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你是想让我们用孵化器把它孵出来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751260605,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "#——唔，龙蛋看起来状态蛮不错的，孵化器上正好也有操作指南。{NICKNAME}，要不我们就试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260607,
						751260608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751260607,
					"content": "虽然不知道行不行，但值得一试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				},
				{
					"id": 751260609,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
