				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "呼——吓死我了，突然就有怪物袭击过来了，还好我们足够厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940602,
					"content": "那下次就拜托派蒙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "啊？不行不行不行，我不行的！我才不要跟那么可怕的怪物战斗呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940606,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "#{NICKNAME}，你看小家伙都着急了。我们还是先想办法孵化龙蛋吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940608,
					"content": "启动孵化器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "孵化器恢复了工作…\\n接下来需要做的，似乎只有等待…\\n然而，时间过去了很久…龙蛋没有发生任何的变化，一丝一毫都没有…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "嗯…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "好奇怪，感觉好像没有任何反应欸？难道是我们的操作有问题吗？我们要不再试一遍吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940612,
					"content": "再试一遍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "你们按照说明重新启动了孵化器…\\n但跟之前一样，龙蛋上依旧没有出现任何变化…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "呜…到底还要等多久啊，我感觉我的眼睛快要花掉了…头也好晕…肚子也好饿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940615,
					"content": "呜…咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "欸？！欸？！等等！它好像动了一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940617,
					"content": "那要不再等等…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "又经过了一段漫长的时间…\\n龙蛋仍然一切如故，没有任何的反应，更没有任何即将要破壳而出的迹象。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "还是没有反应…不会是孵化器坏了吧…可它明明都亮起来了！难道问题出在龙蛋上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940620,
					"content": "——唔，感觉再这样等下去也不是办法…要不然，我们把龙蛋带走吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940621,
					"content": "再饿也不能想着吃龙蛋哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "哇！哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#才不会吃呢！不要让{REALNAME[ID(2)|SHOWHOST(true)]}产生奇怪的误解呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940626,
					"content": "小家伙，我的意思是说，如果问题真的出在龙蛋身上的话，那这颗龙蛋它可能永远都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940634,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#别伤心，{REALNAME[ID(2)|SHOWHOST(true)]}，这也是没有办法的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940636,
					"content": "或许，只是这里的环境不适宜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "说、说得对！孵不出来可能是因为龙蛋觉得现在的纳塔和以前一样，不适合当它的家呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940639,
					"content": "毕竟，它一直藏在这里，根本不可能知道外面已经变得多棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940640,
					"content": "所以，我们把它带回去好好照顾吧！每天都给它讲故事！讲漂亮的风景、精彩的冒险、还有那些很好很好的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940641,
					"content": "总而言之，告诉它现在的纳塔有多棒！等它心动了，一定会自己主动破壳而出的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940642,
					"content": "…啵嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "或许，是它认为还不是时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你怎么看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "嗯…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "根本没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#欸？！可是…刚才明明…难道是我的错觉？不对，不对，{REALNAME[ID(2)|SHOWHOST(true)]}，你刚才看到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940629,
					"content": "嗯…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#啊…小家伙也没看到？难道真的只是我的错觉而已？那怎么办，{NICKNAME}，我们还要继续等下去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940631,
					"content": "还是说…问题出在龙蛋上？可、可是，如果问题真的出在龙蛋上，那不就意味着永远孵不出来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940632,
					"content": "问题应该出在龙蛋上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "啊？那、那就是说，这颗龙蛋有可能永远孵不出来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750940604,
					"content": "哼，不过如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "就是！张牙舞爪的，我还以为是什么特别厉害的角色呢！结果就这，这样的攻击还不如小家伙撞人痛呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7512606,
			"completionStepIds": [
				7509402
			],
