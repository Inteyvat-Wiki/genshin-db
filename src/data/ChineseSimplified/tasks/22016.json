				"points": []
			},
			"dialogs": [
				{
					"id": 220160801,
					"content": "阁下，请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160802,
					"content": "你为什么会答应旭东？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "正如旭东阁下说的，目前…如果我想要吃饱的话，为他工作是最好的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160804,
					"content": "而且，朱莉小姐和旭东阁下，我认为都是品德高尚之人，与他们同行是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160805,
					"content": "芭尔瓦涅阁下…是一个心思缜密的人，她对我有所警惕也属正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160806,
					"content": "而且她也仅是警惕，并未排斥我，这就…足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160807,
					"content": "你真的一直在外游荡吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "在下自然不会说谎。从幕府离开后，我就一直在外徘徊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160809,
					"content": "一般来说，我会用野果来填肚子，运气好的话，会有一些猎物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160810,
					"content": "我偶尔也会帮助一些需要帮助的人，比如击退魔物，或者海乱鬼，这样也会得到一些报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160811,
					"content": "呵呵…对我这种除了挥剑外别无长处的人来说，工作的机会实在有些少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160812,
					"content": "更不用说我还有「离开幕府」这种背景在，人们总是会把我和海乱鬼联系在一起，如此…就更难找到工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160813,
					"content": "我在稻妻也没什么居所，也没有亲眷可投奔，除了在外游荡，我也没有地方可去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160814,
					"content": "你为什么要离开幕府？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "只不过是…不能认同幕府在稻妻施行的某种做法罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160816,
					"content": "我只是一介武夫，也并不知道那种做法究竟是否有益于国家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160817,
					"content": "我只知道那种做法与我心中的想法有悖，所以，我选择了离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160818,
					"content": "呵呵，也许是我太过古板，不知变通了吧…让您见笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160819,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "再见，阁下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				}
			]
		}
