			},
			"dialogs": [
				{
					"id": 220160701,
					"content": "这两个人实在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160702,
					"content": "你好像还是不太信任他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "你说龟井宗久吗？那当然了…我们见都没见过这个人几次，怎么能轻易信任他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160704,
					"content": "…但是，虽然我不相信龟井宗久，但我还是会相信旭东的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160705,
					"content": "你来自教令院？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "我…算是吧，我本来是从教令院出来游学的，在璃月遇见了旭东。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160707,
					"content": "他打算去四处旅行研究食谱，我研究的课题恰好也和美食有关。在和他讨论过几次之后，我们就一起同行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160708,
					"content": "我们首先去了蒙德，在那里被一堆魔物围住了，还好朱莉过来帮忙赶走了它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160709,
					"content": "她听说我们想要四处旅行寻找美食之后，就也加入了我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160710,
					"content": "虽然她说自己本来就打算四处冒险，但我总感觉，这家伙就是想要吃好吃的而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160711,
					"content": "我们下一站应该会去须弥，我的课题也研究得差不多了，也该回教令院一趟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160712,
					"content": "哼，等到了须弥，一定要让他们感受一下须弥的特色美食…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160713,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "嗯，再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭尔瓦涅"
				}
			]
