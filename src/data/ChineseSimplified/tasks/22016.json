					"朱莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160601,
					"content": "嘿嘿，其实还挺好吃的，我还要再吃一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160602,
					"content": "你为什么要送吃的给他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "嗯…我就是不想看见大叔饿肚子嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160604,
					"content": "而且，上次见到大叔的时候，他好像很难过的样子，我觉得，说不定就是因为没吃饱的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160605,
					"content": "所以我想要给大叔送点吃的，只要吃饱了，大叔也许就不会那么难过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160606,
					"content": "你为什么会相信他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "那是…冒险家的直觉喔。我可是很会分辨好人和坏蛋的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160608,
					"content": "而且我真的觉得，在饿肚子的时候还把食物分给别人…只有好人才会做这样的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160609,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "再见。我以后一定记得吃早饭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				}
			]
		},
