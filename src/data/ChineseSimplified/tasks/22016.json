				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭东"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "芭尔瓦涅…还有旅行者，你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160202,
					"content": "我来帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "是吗…多谢了，朱莉那家伙好像往更深处去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160204,
					"content": "那里魔物众多，只凭我们两个，应该很难对付得过来，有你帮忙再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160210,
					"content": "我们这就出发吧，朱莉应该就在树林里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160205,
					"content": "来找你要那顿大餐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "没问题，不过只凭我一个人，应该没法做那顿大餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160207,
					"content": "旅行者，请你先帮我个忙，和我们一起去把朱莉找回来，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160208,
					"content": "朱莉那家伙应该走得很深了，那里魔物众多，只凭我们两个，应该很难对付得过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160209,
					"content": "把朱莉找回来之后，我就给你兑现那顿大餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "旭东"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭尔瓦涅",
					"旭东",
					"朱莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "你、你这家伙…要是把锅砸坏了，我们还用什么做饭啊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160302,
					"content": "别小看璃月的铸锅技术，我这口锅可是专门用来练习颠锅的特制铸铁锅，可不会轻易坏掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160303,
					"content": "再说了，只是几个魔物而已。连魔物都没法砸倒，还算什么铁锅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160304,
					"content": "你对这口铁锅的期望未免太高了些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160305,
					"content": "旭东可真是有气势。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "那是当然了，这可是做厨师的必修课。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160307,
					"content": "完全没听说过好吗？！为什么厨师要学习用铁锅砸翻魔物啊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160315,
					"content": "好了，朱莉，我们现在赶紧离开这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160316,
					"content": "等、等一下，快去帮帮大叔，他一个人去树林里和那些海乱鬼战斗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160317,
					"content": "海乱鬼？不是魔物吗？为什么还会和那种家伙扯上关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160318,
					"content": "我、我之后会说的…快去帮帮大叔吧，他只有一个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160319,
					"content": "我知道了。旅行者，请再和我们同行一段吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160320,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "我们快点出发吧，走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160321,
					"content": "你要和海乱鬼战斗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "那是当然，我这口锅可是在跃跃欲试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160323,
					"content": "而且，厨师可不能临阵脱逃啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160324,
					"content": "都说了，不要对厨师和铁锅有这种过高的期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160308,
					"content": "那么，在哪里可以买到这口锅呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "哈哈哈，问得好，我是找「寒锋铁器」的那个大叔特别铸造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160310,
					"content": "据说大叔还往里面加入了一些从层岩巨渊里开掘出来的材料，如果你想买的话，直接去找他就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160311,
					"content": "不过我听说层岩巨渊已经被封锁很久了，估计现在你找他，他也没法做了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160312,
					"content": "芭尔瓦涅的气势也很足。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "咦？那个啊…哈哈哈，我只不过就是往那些魔物头上丢了几本书而已，还是靠你才击退了魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160314,
					"content": "等等，我的那本《与神性同行》第六卷呢？不、不会也丢出去了吧…我还没看完呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "芭尔瓦涅"
				}
			]
		},
		{
			"id": 2201604,
			"completionStepIds": [
				2201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"2"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龟井宗久",
					"朱莉",
					"旭东",
					"芭尔瓦涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "咳…咳，居然被那群恶徒逼成这样，让各位见笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160402,
					"content": "大叔，你没事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160403,
					"content": "只不过是输了几招，没有大问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160404,
					"content": "朱莉，现在你可以把事情的来龙去脉好好说一下了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160405,
					"content": "全都说清楚，不然我这些书可就白丢了，啊…书页都皱了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160406,
					"content": "事情很简单啦…就是，我想要送点吃的东西给大叔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160407,
					"content": "我说你啊…只不过是见了一面而已，你为什么就这么信任…他了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160408,
					"content": "大叔肯定是好人！那个时候他明明都那么饿了，还愿意把食物分给我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160409,
					"content": "饿肚子的时候，还愿意把食物分给人家的人，肯定是好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160410,
					"content": "这善恶观还真是纯粹初始又机械…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160411,
					"content": "你也许并不是生活在提瓦特大陆，而是生活在什么童话世界吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160412,
					"content": "哈哈哈，但是我觉得朱莉说得没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160413,
					"content": "我觉得，能在饿肚子的时候也保持气度的人，一定不会是坏人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160414,
					"content": "这逻辑还真是简单直接…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "总之，朱莉你接着往下说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160416,
					"content": "我就做了点野菇鸡肉串，想去第一次遇见大叔的地方碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160417,
					"content": "然后，我就过去那里，结果真的看见了大叔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160418,
					"content": "但我刚想和大叔打招呼，突然发现他在和几个海乱鬼对峙，好像还在说什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160419,
					"content": "我刚想先离远点，但是却被海乱鬼发现了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160420,
					"content": "接下来，就由在下说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160421,
					"content": "那些…人，其中有几位在下的「旧友」，之前和在下一起，在幕府效力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160422,
					"content": "在稻妻横生变故后，我们先后都离开了幕府，各自谋生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160423,
					"content": "刚才就是他们的谋生手段？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "…正是。我们除了挥剑之外，也没有什么谋生手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160432,
					"content": "在那之后，他们成为了那样的「海乱鬼」，以劫掠为生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160433,
					"content": "而在下不愿与他们为伍，就一直在四处游荡，想找些工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160434,
					"content": "但听说了我是离开幕府的武士后，也没有人敢雇佣我做事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160435,
					"content": "然后，就如同阁下所见，我只能去野外搜刮些食物果腹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160436,
					"content": "最近几天，我的那些前同僚们似乎缺了人手，所以每天都来劝我入伙，我也每次都拒绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160437,
					"content": "今天…朱莉小姐出现后，他们还以为我投靠了哪家，想要把他们给吃掉。所以就向我们发动了攻击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160438,
					"content": "完全没道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "他们从来不讲什么道理。但处于他们那种境地…确实也没有什么道理好讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160444,
					"content": "然后，大叔就去对付那些坏蛋，我就留在原地等他回来，但是却突然有一群魔物冒了出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160445,
					"content": "你应该能够对付它们吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "平时是可以啦。但今天早上走的时候没吃东西，肚子很饿，没什么力气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160447,
					"content": "而且被那群海乱鬼发现的时候，野菇鸡肉串也都弄丢了…还好有大叔保护我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160448,
					"content": "这就是吃早饭的重要性。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "但是，稻妻还有很多那样不讲道理的海乱鬼吧，我们还得呆在稻妻一段时间，总感觉很危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160451,
					"content": "而且凭我们几个人，对付些弱小魔物还凑合，也不太好对付这群会武艺的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160452,
					"content": "唔…大叔，你刚才说，你在找工作对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160453,
					"content": "如果愿意的话，要不要和我们同行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160454,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160455,
					"content": "可是，他不是离开幕府的武士吗？这种身份在稻妻，会不会惹上麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160456,
					"content": "…没错，在下身份特殊，如果与各位同行，说不定会害各位惹上各种麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160457,
					"content": "哈哈哈，我倒觉得没关系。我们只是到处去寻找食材做饭而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160458,
					"content": "以大叔这种身份，做这种完全和幕府和武士搭不上关系的事才最合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160459,
					"content": "要是大叔真的去给人做护卫，或者帮人守门的话，反而会引人猜忌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160460,
					"content": "而且，大叔这样子的好人却被迫饿着肚子，我觉得是十分没有道理的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160461,
					"content": "作为厨师，我可看不过去，虽然其他的事没法管，但我至少要管一管他的饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160462,
					"content": "阁下，您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160463,
					"content": "嘿嘿，怎么样大叔，你愿意和我们同行吗？工钱虽然开不了多少，但饭一定管够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160464,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160465,
					"content": "在下，从命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160466,
					"content": "好耶——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220160467,
					"content": "这也算是好事吧，算是好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220160468,
					"content": "好嘞！大家辛苦了这么久，肚子都要饿扁了，虽然这里不太好起灶…但我还是能想办法做点食物的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160469,
					"content": "旅行者，你也别忙了，我来搞定就好，你就在这里等着开饭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160470,
					"content": "那么，开始动手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160471,
					"content": "这样就行了…哈哈，用剩饭做的「饭团」，虽然有点粗糙…但填饱肚子应该够了，大家开吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160472,
					"content": "对了旅行者，这一路上谢谢你了，这份食谱给你，这是宗久大叔刚给我的，我也给你抄了一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160473,
					"content": "他说这是他在幕府的时候记下的食谱，据说还挺有特色的，有兴趣的话，你也研究一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160474,
					"content": "好了好了，不多说了，快点开吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160449,
					"content": "以后一定要记得吃早饭喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "他们也太敏感了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "处于他们那种境地，敏感也属正常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160442,
					"content": "但我猜，其实他们也只是想要借这个理由，彻底把我这个「不听话」的人斩掉，以此来立威吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160443,
					"content": "毕竟，我三番五次地拒绝他们，肯定也让他们脸上挂不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160425,
					"content": "难道，那些海乱鬼都是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "也并不尽然。但总归都是些挥剑向弱者的懦夫罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160427,
					"content": "你为什么要离开幕府？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "只不过是…不能认同幕府在稻妻施行的某种做法罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160429,
					"content": "我只是一介武夫，也并不知道那种做法究竟是否有益于国家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160430,
					"content": "我只知道那种做法与我心中的想法有悖，所以，我选择了离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220160431,
					"content": "呵呵，也许是我太过古板，不知变通了吧…让您见笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "龟井宗久"
				}
			]
		},
		{
			"id": 2201605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"3"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭东"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160501,
					"content": "总算是吃饱了…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160502,
						220160513
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160502,
					"content": "你为什么要帮他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160503
					]
				},
				{
					"id": 220160503,
					"content": "你说宗久大叔？那当然是出于一个厨师的职业道德了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160504
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160504,
					"content": "开玩笑的。但我是真的不愿意看见大叔这样的好人饿肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160505
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160505,
					"content": "不，或者说…我不想看见任何一个人饿肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160506
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160506,
					"content": "饥饿是一种很可怕的感觉，我…感受过这种感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160507
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160507,
					"content": "在饥饿感的逼迫下…人会做出很可怕的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160508
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160508,
					"content": "我想，如果这个世界上人人都能吃饱吃好，或许，就能避免很多坏事发生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160509
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160509,
					"content": "虽然我一个人没法做到这种事，但我至少能做个厨师，努力让我身边的人吃饱吃好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160510
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160510,
					"content": "哈哈哈，说白了，我就是想要让大家都能吃饱吃好而已，是不是个很没意思的理想？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160511
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160511,
					"content": "是个很伟大的理想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160512
					]
				},
				{
					"id": 220160512,
					"content": "嘿嘿，多谢啦。呃…不说了，你快再吃点，可别剩下了，剩饭可是大罪过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220160513,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160514
					]
				},
				{
					"id": 220160514,
					"content": "你要走了吗？不然…再吃点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				}
			]
		},
		{
			"id": 2201606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
