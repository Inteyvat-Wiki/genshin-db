	"talks": [
		{
			"id": 2201602,
			"completionStepIds": [
				2201603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
