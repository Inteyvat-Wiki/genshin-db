					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 700740402,
					"content": "…打住！这句话我耳朵都要听出茧子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740403,
					"content": "嗯…这份木屑…不管是形状还是质感都很像…成色很不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740404,
					"content": "木屑究竟能有什么成色啦…不过你满意就行。下一份材料是…「欢欣而落的鸽羽」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
