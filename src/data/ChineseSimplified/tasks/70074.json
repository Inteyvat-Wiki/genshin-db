			"dialogs": [
				{
					"id": 700740801,
					"content": "咕咕——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "鸽子"
				},
				{
					"id": 700740802,
					"content": "羽毛！我拿到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740803,
					"content": "可算拿到了，这课题确实比想象的要艰难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740804,
					"content": "只差一步了…「大锅烹煮的药汤」，没记错的话是在达达乌帕谷吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740805,
					"content": "我这就过去，你们快点跟上来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740806,
					"content": "喂——这家伙，兴致也太高了吧？跑得比飞得还快？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740807,
					"content": "不愧是像风一样自由的人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "…那个酒鬼大叔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740810,
					"content": "嗯？谁在那里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740812,
					"content": "迪奥娜？你怎么在这里？还专门藏起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740813,
					"content": "我…我就只是出门采点果子，没想到突然就碰到那个大叔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740814,
					"content": "他最近老是缠着我不放，想让我再给他调一次上回的酒…我被烦得不行，就只好到处躲着他了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740815,
					"content": "上回的酒…是什么情况？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "他前阵子不是和一些远征军一起回来了吗？就到猫尾酒馆里喝庆功酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740817,
					"content": "猫尾酒馆？我还以为会在骑士团里开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740818,
					"content": "我还以为会去「天使的馈赠」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "呃…他们全都去了。猫尾酒馆已经是第三轮了——城里所有酒馆他们都打算喝上一轮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740820,
					"content": "…我强烈怀疑等下一波远征军回来，他们还能用这借口再喝一轮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740821,
					"content": "我毫不怀疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "…总之！那帮酒鬼大叔的样子，我实在是看不下去了！就想调杯最难喝最反胃的饮料让他们醒一醒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740823,
					"content": "但你的体质不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "是啊，所以我一开始是让小王子去帮我调的…谁知道那群家伙一喝醉就想逗小王子玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740826,
					"content": "…所以小王子没调到最后就跑了，哦，顺便还挠了那个酒鬼大叔一爪子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740827,
					"content": "（法尔伽说的那道疤…该不会就是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "我为它深入了一片混沌的秘{RUBY#[D]酒馆}境，跟最凶最狠的魔{RUBY#[D]小王子}物搏斗…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740829,
					"content": "…我看着差不多调完的饮料，想着就只差那么一点了，是不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740830,
					"content": "结果还是亲手完成最后一步了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740832,
					"content": "我再好奇一问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "呃，有骑士们身上沾的木屑、从林子里捡的鸽子羽毛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740835,
					"content": "还有最后一种，原本打算拿来醒酒的…丘丘人的草药汤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 700740836,
					"content": "#{NICKNAME}…你说法尔伽他刚回来没多久…会不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740837,
					"content": "…还没人告诉过他这些材料…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "这家伙…要出大事了！快去阻止他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740838,
					"content": "只有迪奥娜自己能这么调！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "你都往里面加了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "调什么都会变成美味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "想喝酒的心情都溢出来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
