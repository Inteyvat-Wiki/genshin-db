			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "难以置信…丘丘人居然这么好说话了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700740902,
					"content": "艾拉！你有看到法尔伽吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740903,
					"content": "嗯，他刚刚说是要去向丘丘人借锅子用…然后丘丘人一见到他，就连忙把锅给让出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700740904,
					"content": "明明也没有交流几句，怎么会这么顺利？难道大团长还掌握了我不知道的丘丘人肢体语言？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700740905,
					"content": "我觉得那不算交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "——重点不在这吧喂！法尔伽他现在人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740908,
					"content": "喏——就在那儿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700740909,
					"content": "终于…完成了！全提瓦特最棒的美酒！此时此刻，就在我的手中！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740910,
					"content": "法尔伽——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "哦？你们可算来了啊？那些丘丘人意外地很通情达理嘛，调酒的进度比想象得要快一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740912,
					"content": "现在，就是品鉴之时！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740913,
					"content": "——你先别喝！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "嗯？你们是想尝第一杯？哼哼…这第一杯的荣耀我是绝对不会让出去的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740915,
					"content": "不是这个问题！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "放心吧！我会给你们留一点的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740917,
					"content": "咕…咕…哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740918,
					"content": "嗯？怎么感觉…有点…坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740919,
					"content": "法尔伽！你还好吗？法尔伽？法——尔——伽——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740920,
					"content": "——团长！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "喂！都从魔神嘴里头凯旋了，倒在这种地方算什么啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740923,
					"content": "唔…啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740924,
					"content": "…感觉刚刚有一瞬间，好像看到了历代北风骑士啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740925,
					"content": "该说你怎么能倒在这好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "让我再消化一下吧…不管是刚才那杯酒也好，还是这个惨痛的教训也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740928,
					"content": "向法尔伽说明了迪奥娜「百分百调出美酒」的祝福…\\n只有经过她手，奇怪的材料才会变成美酒…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "原来是这样啊…缺的那份材料，其实是泉水精灵的祝福吗…哈哈，还真是没想到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740930,
					"content": "喂，不要一脸清爽得好像什么事都没了！你骗我们的账都还没算呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740931,
					"content": "抱歉抱歉…我是真以为这酒方没问题的，还想着调完之后，一边跟你们喝一边解释呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740932,
					"content": "现在么…你们应该不会想喝了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740933,
					"content": "算了算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "嗯…那这次的酒就当是我欠你们吧，回头去猎鹿人餐馆再请你们一顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740936,
					"content": "——请客？这还差不多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740937,
					"content": "你也太好收买了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "呃…你看他喝了那杯酒难受这么久，也算是尝到教训了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740939,
					"content": "唉，自作自受啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740940,
					"content": "不过你的空白课题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "哈哈，本来还想拿来当下酒故事的，现在也只能就着西北风来讲了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740943,
					"content": "…给蒙德的大家定制一套「课题」？挺好的点子，能不能给我也来一份？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740944,
					"content": "呵，你的课题——「改变水占盘里倒映的命运」——在你决定开启远征的时候，就已经完成了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700740941,
					"content": "究竟是什么情况？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "怕了怕了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "还是说你这都能站起来好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "你在干什么啊团长！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "起码不是用语言…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
