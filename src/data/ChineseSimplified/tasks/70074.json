			"dialogs": [
				{
					"id": 700740201,
					"content": "…说起「骑士击碎的木屑」，果然就是这里了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740202,
					"content": "啊！大团长！荣誉骑士！你们今天也是来训练的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 700740203,
					"content": "为了追求「目标」而奋进…嗯，确实是一种训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740204,
					"content": "明明都已经这么强了，却还在精益求精吗…两位请随意训练吧！我会在旁边做笔记的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
