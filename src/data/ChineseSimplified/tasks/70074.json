			},
			"dialogs": [
				{
					"id": 700740501,
					"content": "喂！你们把鸽子全给…吓跑…了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740502,
					"content": "…大…大团长？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740503,
					"content": "哦？这不是小提米吗？看起来个子长高了不少啊？有在好好吃饭吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740504,
					"content": "有…有的！我一直记得您说的！想成为顶天立地的男子汉，就要好好吃饭！好好锻炼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740505,
					"content": "这小子的态度…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "没办法…我估计这座城里没有哪个小孩子不崇拜西风骑士团的当代传奇吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740508,
					"content": "抱歉啊，把你的鸽子全吓跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740509,
					"content": "我刚好也想问一下，有什么方法能接近鸽子却不惊动它们…还能让它们保持心情愉悦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740510,
					"content": "呃…我平时，会静静地走到它们身边，再撒下饲料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740511,
					"content": "——对了！就是这个！你身上还有多的饲料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740512,
					"content": "饲料倒是有不少…不过…大团长…那个…你们是要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740513,
					"content": "放心吧，我向你保证——只是找它们借点羽毛而已，这是大人之间的约定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 700740514,
					"content": "啊…好的！谢谢大团长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 700740506,
					"content": "跟以前完全不一样！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
