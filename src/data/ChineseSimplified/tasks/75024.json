			"dialogs": [
				{
					"id": 750240601,
					"content": "嘎呜——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "「金盏花」"
				},
				{
					"id": 750240602,
					"content": "你不要激动，我们只是担心那个人有没有受伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240603,
					"content": "看来只能决斗了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "不要这么快就放弃嘛！小金盏花，我们没有恶意的，我们也知道，呃，好勇斗狠绝对不是你的本意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240606,
					"content": "嘎！呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "「金盏花」"
				},
				{
					"id": 750240607,
					"content": "哇…它怎么更生气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750240605,
					"content": "「我心爱的金盏花」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
