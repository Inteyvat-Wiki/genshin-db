			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							907.387,
							214.468,
							326.214
						],
						"pointId": 310400531
					}
				]
			},
			"dialogs": [
				{
					"id": 401430101,
					"content": "「招聘启事…望舒客栈现高薪急聘临时厨师一位，待遇从优，酬劳面议…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430102,
					"content": "#——{NICKNAME}！你看你看，高薪急聘！有赚钱的机会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430103,
					"content": "望舒客栈怎么会突然招厨师？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430104
					]
				},
				{
					"id": 401430104,
					"content": "欸…你说的对哦，不会是言笑出什么事了吧？那家伙连别人随便进厨房都要训一顿…不像是会招人来帮工的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430105,
					"content": "告示后面好像还有…「有意者请移步楼上与掌柜淮安详谈…」要不我们也上去看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430106,
						401430108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430106,
					"content": "你是想去问问言笑的情况吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430107
					]
				},
				{
					"id": 401430107,
					"content": "嗯——顺便也去问问酬劳有多少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430108,
					"content": "你是想去问问酬劳有多少吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430109
					]
				},
				{
					"id": 401430109,
					"content": "…顺、顺便也能关心一下言笑嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4014302,
			"completionStepIds": [
				4014302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4014302",
							"2"
						],
						"stepId": 4014302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							896.893,
							265.09,
							332.755
						],
						"pointId": 310400532
					}
				]
			},
			"dialogs": [
				{
					"id": 401430201,
					"content": "…掌柜的，真没必要。不过是烫着手而已，也不耽误我做菜呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430202
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430202,
					"content": "就算现在不耽误做菜，也耽误你痊愈啊。这几天你先歇着，我们来想办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430203
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430203,
					"content": "嘿，掌柜的！还有言笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430204,
					"content": "#嗯？是{NICKNAME}和派蒙啊！什么风把你俩给吹来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430205,
					"content": "我们在楼下看到了招聘启事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430206
					]
				},
				{
					"id": 401430206,
					"content": "然后就想上来…上来问问言笑怎么了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430207,
					"content": "唉！我就说不该贴那张告示，居然连你们也开始担心了…多大点事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430208
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430208,
					"content": "哈哈，两位能有这份心，我先替言笑谢过了。欸，你也别不好意思了，就跟他们说说呗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430209,
					"content": "行吧…其实就是前阵子过海灯节，来的客人太多。起锅的时候有点心急，不小心烫着了手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430210
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430210,
					"content": "没想到言笑也会犯这种错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430211
					]
				},
				{
					"id": 401430211,
					"content": "咳！常在河边走，哪能不湿鞋嘛。再好的厨子也总有失手的时候！况且这点小伤，根本不碍事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430212
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430212,
					"content": "你可别逞强了，到时候伤势要是更重，就不是休养一天两天的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430213
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430213,
					"content": "可这海灯节过去没多久，店里的客人那么多，还不是休息的时候吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430214
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430214,
					"content": "客人里头还有不少远道而来的外宾，这要是随便找个厨子应付，万一砸了我们客栈的招牌…我第一个不答应！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430215
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430215,
					"content": "瞧你这话说的，都不知道谁是掌柜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430216
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430216,
					"content": "不过他说的也在理，言笑怎么说也是当初「厨王争霸赛」的种子选手，随便找个厨师，还真不好代班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430217
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430217,
					"content": "也不是我自夸，这种水平的厨师，应该都有自己的生意要照顾吧？能抽出空来客栈帮忙的，怕是不好找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430218
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430218,
					"content": "唉，看来还得再提高一点报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430219
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430219,
					"content": "唔…厨艺很好、又有时间的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430220,
						401430221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430220,
					"content": "远在天边。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430222
					]
				},
				{
					"id": 401430222,
					"content": "啊——不就是你吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430223,
					"content": "对呀，仔细一想，之前是有听说过…当时只记着你身手了得，都忘了你还有这手厨艺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430224
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430224,
					"content": "不记得厨艺只记得身手…这是客栈掌柜该记的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430225,
					"content": "哈，不用在意细节。总之，你要是愿意来的话，言笑应该也能放心把厨房交给你吧？你说是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430226
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430226,
					"content": "#这…如果是{NICKNAME}的话…唉，确实，总比交给其他人要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430227
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430227,
					"content": "#那，{NICKNAME}，我们要接下这份工作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430228,
						401430230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430228,
					"content": "掌柜刚才说提高报酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430229
					]
				},
				{
					"id": 401430229,
					"content": "哈哈，说话算话，一言为定。这酬劳绝对少不了你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430231
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430231,
					"content": "不过我还是要提一句，在客栈里掌勺，跟自己做饭可不一样。这几天，我也会留在厨房里帮你熟悉工作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430232
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430232,
					"content": "结果还是放心不下嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430233,
					"content": "掌柜的，记得店里应该还有一些闲置的厨具，你看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430234
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430234,
					"content": "哦，好说好说，我这就去准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430235
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430235,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401430236
					]
				},
				{
					"id": 401430236,
					"content": "呼——完工了。快来看看，这可是为你量身打造的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430237
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430237,
					"content": "掌柜的，你这木工…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430238
					]
				},
				{
					"id": 401430238,
					"content": "哎呀，一点点小手艺，不值一提，不值一提。那言笑，这里就先交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430239
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430239,
					"content": "居然这么大动干戈…就不能直接用现成的灶台吗？你是有多不想让别人碰你的厨具啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430240,
					"content": "欸，哪有的事，老板说过，用人不疑，疑人不用。我只是觉得原先的灶台对你来说…呃…有点高了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430241,
						401430242
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430241,
					"content": "是你看谁都觉得矮吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430243
					]
				},
				{
					"id": 401430243,
					"content": "咳咳——之前不也说了吗，在客栈掌勺跟给自己做菜不同，既要讲究色、香、味，也要讲究快、准、稳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430244
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430244,
					"content": "用不合适的灶台做一天菜，累得手酸背疼不说，出菜的效率一慢，外头的客人也要不耐烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430245
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430245,
					"content": "所以做菜的家伙事，一定要准备妥当——这就是「快」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430246
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430246,
					"content": "那「准」跟「稳」又是什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430247,
					"content": "嘿，所谓「准」，就是放亮眼睛，一块肉从哪里下刀、一勺油舀起多少、一锅菜要到什么时候起锅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430248
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430248,
					"content": "给自己做菜的时候，可以水多了加盐、盐多了加水，看情况调味，但客栈里可没那么多机会试错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430249
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430249,
					"content": "这我还算有自信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430250
					]
				},
				{
					"id": 401430250,
					"content": "万一真做糟了，就交给我来解决掉吧！嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430251,
					"content": "最后的「稳」，是说不管多刁钻的要求，都要用最稳妥的手法实现。尤其是招待天南地北、口味迥异的客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430252
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430252,
					"content": "既要照顾他们原本的饮食习惯，又要考虑到他们想尝试本地特色的心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430253
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430253,
					"content": "呃…这个倒是没那么好懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430254,
					"content": "#不打紧，{NICKNAME}走南闯北见得多了，实际应付起来，估计只会比我更得心应手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430255
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430255,
					"content": "何况这几天，我也会留在后厨支援你们。一定能让每个客人，都觉着「宾至如归」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430242,
					"content": "对我来说也不算碍事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430243
					]
				},
				{
					"id": 401430230,
					"content": "难得见言笑让出厨房…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430231
					]
				},
				{
					"id": 401430221,
					"content": "近在眼前。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430222
					]
				}
			]
		},
