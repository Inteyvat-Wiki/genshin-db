			"dialogs": [
				{
					"id": 401430501,
					"content": "久等啦！请用——「金玉满堂」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430503
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430503,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430504
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430504,
					"content": "#…啊，说起来{NICKNAME}跟派蒙也忙了一天吧，不如一起吃吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430505
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430505,
					"content": "被你这么一说，肚子还真有点饿…嘿嘿，那就「恭敬不如从命」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430506,
					"content": "不过第一筷还是由客人先动吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430507
					]
				},
				{
					"id": 401430507,
					"content": "对、对哦，毕竟这次你们才是客人…嗯？你们怎么都不吃啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430508,
					"content": "（酱汁…看起来有点重…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430509
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430509,
					"content": "（按璃月的餐桌礼仪…我是不是该先让一让…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430510
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430510,
					"content": "#…咳，那么，就让我先来尝尝{NICKNAME}的手艺吧！嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430511
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430511,
					"content": "怎么样？要喝点水吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430512
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430512,
					"content": "不用…很鲜，非常纯粹的味道。明明裹了一层酱汁，却只有海洋本身的鲜味…你们也尝尝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430513
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430513,
					"content": "好、好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430514
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430514,
					"content": "这味道…难道是蟹黄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430515
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430515,
					"content": "答对咯！不愧是琳妮特！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430516,
					"content": "难怪能跟虾仁的味道融合得这么好，居然还有这种做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430517
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430517,
					"content": "嘿嘿，这道菜讲究「虾上加蟹，鲜上加鲜…虾仁之嫩滑，佐以蟹粉之沙糯，鲜香美味，口感绝佳！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430518,
					"content": "「更有蟹黄灿烂胜金，虾仁晶莹如玉…」这才有了「金玉满堂」的美名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430519,
					"content": "这名字原来还有这种说法，确实是挺贴切的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430520
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430520,
					"content": "奇怪…派蒙什么时候这么有学问了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430521,
						401430522
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430521,
					"content": "菜谱背得挺熟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430523
					]
				},
				{
					"id": 401430523,
					"content": "这道菜应该挺对你胃口吧，琳妮特…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430524
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430524,
					"content": "啊！「金玉满堂」只剩一半了？什么时候被吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430525,
					"content": "就在你滔滔不绝的时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430526
					]
				},
				{
					"id": 401430526,
					"content": "我听说在璃月，食客对厨师最好的致意，就是多吃一点。非常美味，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430527
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430527,
					"content": "啊——你们怎么都开始抢了…喂，给我留点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430522,
					"content": "现学现卖罢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430523
					]
				}
			]
		},
