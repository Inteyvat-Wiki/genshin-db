			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰百梨迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "那菈…和会飞的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160302,
					"content": "#对啦，我是会飞的派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160303,
					"content": "你应该就是兰百梨迦了吧，话说回来，你一点也不怕我们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160304,
					"content": "金色的那菈，有兰般度的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160305,
					"content": "啊，这个嘛，的确是兰般度让我们来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160306,
					"content": "感受不到恶意。想对我下手，应该趁大铁块还能动的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160307,
					"content": "确实，这就叫「趁兰那罗之危」吗…不对不对，我们才不会做那种事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160308,
					"content": "为什么不做？如果我是敌人，包夹敌人是好的方法，连动物捕猎时都会用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160309,
					"content": "唔…好有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160310,
					"content": "派蒙糊涂啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "…总之，总之！我们肯定不会「趁兰那罗之危」就对了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160312,
					"content": "因为兰那罗是朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#对对对，就是这个，因为兰那罗都是朋友！我和{NICKNAME}是不会做对不起朋友的事情的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160314,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160315,
					"content": "呃…怎么感觉他好像很不满意的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160316,
					"content": "派蒙没有留下好的第一印象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "可是我也没觉得自己做错了什么呀…唔…兰那罗的脾气真难捉摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160320,
					"content": "对了，兰般度说过，兰百梨迦的「兰迦拉梨」非常厉害。刚才他能够击败遗迹守卫，一定就是靠的「兰迦拉梨」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160321,
					"content": "派蒙知道兰迦拉梨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160322,
					"content": "…哦、哦！我当然知道啦！就是…就是那个嘛！很厉害很厉害的…什么能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160323,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160324,
					"content": "呜哇！感觉又被瞧不起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160325,
					"content": "还是说正事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "嗯…我们是来帮忙治好法留纳神机的！这里应该也有法留纳神机的「枝」和「叶」吧，不过好像没看到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160327,
					"content": "什么「枝」和「叶」，更像是「根」才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160328,
					"content": "诶？是这样吗？可是兰般度说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160329,
					"content": "有了遍布桓那的「根系」，法留纳神机才能从桓那获得力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160330,
					"content": "哦…好像也有点道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160331,
					"content": "而且，「根」在地下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160332,
					"content": "这里的石头和铁块，不属于兰那罗。要下去，得先打败铁块。铁块很强，但是金色的那菈也不弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160333,
					"content": "#那是当然，{NICKNAME}已经不知道打败过多少大铁块啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160334,
					"content": "哦？那就让兰百梨迦也见识一下那菈的本领！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160335,
					"content": "诶？！他怎么钻进土里了…啊！难道是已经去遗迹守卫那边了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}，我们快跟上他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160318,
					"content": "可能他对谁都是这样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "怎么会这样呢？明明外表这样可爱，脾气却这么坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰百梨迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "我们已经打败了大铁块，现在只要让水流走，就可以下到地下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160702,
					"content": "但是，很久没有来，全都和过去不一样了，说不定地下也有大铁块，能感受到铁的味道，是不好的味道，所以要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160703,
					"content": "#那菈{NICKNAME}是有本领的，不用担心。但是派蒙，和兰那库拉一样弱，小心被蘑菇吞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160704,
					"content": "唔…是兰百梨迦太强啦！我们之前也遇到过很多兰那罗，应该还没有谁能一击就让遗迹守卫倒下的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160705,
					"content": "派蒙对兰那罗知道得太少，如果是兰帝裟，闭上眼睛再睁开的工夫，大铁块就被解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160706,
					"content": "兰帝裟的兰迦拉梨，过去是顶厉害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160707,
					"content": "过去？那现在呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160708,
					"content": "现在，兰帝裟不在现在，所以兰百梨迦才要更努力修炼兰迦拉梨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160709,
					"content": "要是我也能学会「兰迦拉梨」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160710,
					"content": "那以后战斗就交给派蒙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#嘿嘿，就让我来保护{NICKNAME}吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160712,
					"content": "派蒙，加油！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "交给我吧！全都可以交给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160718,
					"content": "派蒙很会做梦，不知道是好事还是坏事。但是现在我们要找到石头的机关，让水流走，否则没办法到地下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160719,
					"content": "兰那罗可以钻进土里，不能钻进水里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730160720,
					"content": "#嗯，{NICKNAME}，我们在附近找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160714,
					"content": "派蒙应该学不会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "我只要想学肯定也能学会的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730160716,
					"content": "会这样说的人多半都…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "要不等我们到了安全的地方，吃过饭，休息好了，再拜托兰百梨迦教我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
