			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安娜",
					"安东尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "原来如此，原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200102,
					"content": "哥，你知道这些植物除了做菜之外的用途吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200103,
					"content": "我怎么可能知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200200104,
					"content": "我只知道在哪可以采到它们，还有它们到底能不能吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200200105,
					"content": "唔…那我就自己出去看看好了，放心啦哥，我只是去采集植物，绝对不会靠近魔物的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200106,
					"content": "唉，你自己心里有点数就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200200107,
					"content": "我知道啦。那我今天可要晚点回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200108,
					"content": "你还在训练吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "旅行者！你来得正好，我正准备去野外观察植物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200111,
					"content": "塞琉斯叔叔和我说，冒险家会经常在野外露宿，寻找食物是一项很重要的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200112,
					"content": "所以，我打算先去观察一下野外的植物，把它们的分布点和特性都记录好，再慢慢背下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200113,
					"content": "这样子，以后我在野外寻找食物的时候，至少知道哪些植物能吃，哪些植物不能吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200114,
					"content": "但是…光用文字描述的话，我觉得实在不够直观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200115,
					"content": "旅行者，我听说你有一种叫做「留影机」的东西，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200116,
					"content": "能不能请你帮我用「留影机」记录一下几种植物的生长环境？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200117,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "那就请你先帮我去记录一下嘟嘟莲，小灯草，还有塞西莉亚花的生长环境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200119,
					"content": "然后再把这三种植物采下来带给我，我要把它们做成标本保存下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200120,
					"content": "植物生长环境的记录画片、真实的植物标本，还有详细的文字说明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200121,
					"content": "我的「冒险家植物笔记」读起来一定会很不错的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200122,
					"content": "那就拜托你啦，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200123,
					"content": "清泉镇的那潭泉水旁应该有很多嘟嘟莲，小灯草能在奔狼领里找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200124,
					"content": "塞西莉亚花嘛…那当然要去摘星崖啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200125,
					"content": "我得去其他的地方继续观察植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200126,
					"content": "等你拍到了画片，我们还是在城里碰头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200200109,
					"content": "你训练得怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
