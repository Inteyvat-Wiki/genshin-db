			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "旅行者，你已经回来了啊，怎么样？你拍到画片了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201002,
					"content": "全部拍好了，还都采来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "哇！你怎么能这么快全部拍好的…这就是经验丰富的冒险家吗？真厉害啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201004,
					"content": "谢谢你，旅行者！嗯…这样吧，为了感谢你，我来亲手做一道好菜给你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201005,
					"content": "怎么样，看起来还不错吧，要好好品尝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201006,
					"content": "我回去接着写笔记去了。嗯…这些植物的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201007,
					"content": "我得去问问杰克，看他知不知道怎么做植物标本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200201008,
					"content": "塞西莉亚花就不做标本了，插在花瓶里好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				}
			]
		},
