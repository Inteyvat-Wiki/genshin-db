			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#{NICKNAME}，这里这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570202,
					"content": "记得吗？这是我们旅程的起点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570203,
					"content": "不知不觉中居然已经走过了那么多地方，派蒙我心生感慨，想要赋诗一首！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570204,
					"content": "请，派大诗人——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "噗嗤。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "你不要打岔呀，让我酝酿一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570207,
					"content": "啊！好大一个提瓦特！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570208,
					"content": "啊！走了那么远还是没有把你走遍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570209,
					"content": "（保持沉默）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "根本没有押韵啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "啊！啊…啊不出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570212,
					"content": "哈哈哈哈哈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "派蒙在感叹这一路的艰难？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "哼，你就笑吧，跟你旅行了这么久我已经习惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570215,
					"content": "没错，这就是我想表达的中心思想，哎呀还是你懂我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570216,
					"content": "说正经的，旅行得太久，很容易忘记最开始的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570217,
					"content": "比方说现在，我就有点记不起来甜甜花酿鸡的味道了，明明以前那么喜欢吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570218,
					"content": "所以我才会想到买这份留影册，一起给走过的路和遇到的人留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570219,
					"content": "轻小说和映影里不是经常有这种桥段嘛，一旦回到最初的起点，就离大结局不远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570220,
					"content": "之所以选这里留影，不是为了感伤，而是希望我们都能记得来时的路，旅途走得更从容…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570221,
					"content": "你偷听我和万叶说话了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "派蒙进化了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "唔…我承认你和万叶说话的时候，我在旁边偷听来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570224,
					"content": "真是的，我好不容易创造出的氛围，这下都没有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570225,
					"content": "我明白派蒙的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "我们还要一起走下去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "嘿嘿，你明白我的意思就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570228,
					"content": "好啦，这张画片就由提瓦特最好的向导来给你当模特。你觉得什么样的姿势好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756570101,
					"content": "欸，等一下，我借给你的留影机呢？不会丢了吧，快找找有没有带在身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
