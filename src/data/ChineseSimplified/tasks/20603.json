			"dialogs": [
				{
					"id": 206030501,
					"content": "你们这么快就回来了，看来确实没什么大事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206030502,
					"content": "还有不少魔物在活跃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "什么？还有魔物在游荡，数量比原来的还多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206030504,
					"content": "奇怪，先前来攻击蒙德城的大部队都已经被击退了，为什么它们还在蒙德城附近游荡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206030505,
					"content": "难道它们还有什么计划…不行，我得把冒险家们都召集回来，重新发布委托，不能对这些魔物掉以轻心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206030506,
					"content": "对野外游荡的魔物进行秘密调查，这可是冒险家协会的专业范围…是时候展现冒险家协会的力量了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206030507,
					"content": "对了，这是给你的谢礼，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				}
			]
		}
