					{
						"sceneId": 3,
						"position": [
							-305.218,
							275.02,
							2159.738
						],
						"pointId": 330201529
					},
					{
						"sceneId": 3,
						"position": [
							-306.286,
							274.946,
							2159.712
						],
						"pointId": 330201530
					}
				]
			},
			"dialogs": [
				{
					"id": 735300101,
					"content": "哈哈…唉…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300102
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300102,
					"content": "#{NICKNAME}，快看，这里有个又哭又笑的家伙…咦，好像还有点眼熟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300103,
					"content": "啊！好久不见，两位，你们还记得我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300104,
						735300106
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300104,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300105
					]
				},
				{
					"id": 735300105,
					"content": "是我啦，我！生论派学者贾米，调配出「溢神剂」的那个人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300108,
					"content": "哦哦，我好像有点印象了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300109,
					"content": "怎么样，最近你的研究还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300110,
					"content": "哈哈…这个嘛…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300111
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300111,
					"content": "看来不怎么顺利？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300112
					]
				},
				{
					"id": 735300112,
					"content": "不不，托各位的福，上次关于溢神剂的研究取得了相当不错的成绩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300113
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300113,
					"content": "之前我提心吊胆，总怕对不起导师的期待。没想到他看了我的研究之后，竟然对我大加赞赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300114
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300114,
					"content": "「贾米，你做的好哇，不愧是我最骄傲的学生！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300115
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300115,
					"content": "这不是挺好的吗？恭喜你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300116,
					"content": "如果到这里的话，确实很美好…唉，只可惜后面发生的事情，对我来说却是不折不扣的噩梦啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300117
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300117,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300118
					]
				},
				{
					"id": 735300118,
					"content": "或许是上次的实验数据过于理想，我的导师——那个笑起来满脸褶皱的老头，竟然产生了「亲自试一试」的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300119
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300119,
					"content": "于是，我帮他重新搭好了实验场地，并且精心调配了效果最好的溢神剂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300120
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300120,
					"content": "然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300121,
					"content": "然后，怎么说呢…在无数学生的围观下，他在魔物面前堂而皇之地饮用溢神剂，遭到了魔物的偷袭，转眼间败下阵来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300122
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300122,
					"content": "幸好人没事，只是要在床上多躺一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300123
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300123,
					"content": "噗，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300124,
					"content": "哈哈…咳。不管怎么说，是我学艺不精，让导师丢了面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300125
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300125,
					"content": "事后那个臭脾气的老头，更是斥责我「没有考虑用户需求」、「无法满足实际情况」，把我狠批了一顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300126
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300126,
					"content": "这不是强人所难嘛，明明他自己也有错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300127,
					"content": "谁说不是呢？所以我想拜托两位，帮我——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300128,
						735300129
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300128,
					"content": "教训教训他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300130,
					"content": "不是，不是啦！我可没有这么可怕的想法，至少现在没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300131
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300131,
					"content": "嘿嘿，也就是说「曾经」有过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300132,
					"content": "呃…有那么一点儿…这个不重要啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300133
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300133,
					"content": "我是想说，在重新审视之前的实验后，我调配出了一种「长效溢神剂」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300134
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300134,
					"content": "长效溢神剂？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300135,
					"content": "我回忆起导师被偷袭时的反应，突然意识到一个问题：我们这些普通人面对危机时，通常会脑袋空空、身体僵硬、不知所措…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300136
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300136,
					"content": "如果等遇到危险时再找出溢神剂喝下，说不定就等不到溢神剂生效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300137
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300137,
					"content": "但是长效溢神剂不同。喝下之后，每次遇到危险都会自动生效，可以为普通人争取更多的反应时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300138
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300138,
					"content": "怎么判断是否「遇到危险」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300139
					]
				},
				{
					"id": 735300139,
					"content": "还记得我刚刚说的吗？普通人面对危机会身体僵硬。喝下长效溢神剂后，只要实验者正常行动，长效溢神剂就不会生效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300140
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300140,
					"content": "可一旦他们停止行动、僵在原地，长效溢神剂就会发生作用，让他们的「主观」时间变得非常缓慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300141
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300141,
					"content": "原来是这样，我差不多听懂了。所以…你刚刚是想拜托我们帮你完成实验吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300142,
					"content": "没错，虽然长效溢神剂是为普通人开发的，但实验有一定的风险，还是要先找有战斗经验的人帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300143
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300143,
					"content": "嗯，让我想想，要不要帮忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300144,
					"content": "#突然有点饿了呢，好想去兰巴德酒馆大吃一顿呀…{NICKNAME}，我们的摩拉还够用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300145,
						735300146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300145,
					"content": "很遗憾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300147,
					"content": "咳。实不相瞒，导师虽然把我骂得狗血淋头，但过后还是特批了一笔不菲的实验经费。我打算重金聘请两位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300148
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300148,
					"content": "既然这样，就让我们助你一臂之力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300149,
					"content": "太感谢了！呜呜，如果能挽回我那支离破碎的学术声誉，两位就是我的救星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾米"
				},
				{
					"id": 735300146,
					"content": "这个月已经超支了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300129,
					"content": "收买收买他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300106,
					"content": "一直在唉声叹气的那个？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300107
					]
				},
				{
					"id": 735300107,
					"content": "你还记得那个外号啊。没错，是我啦…辜负导师期望、一直在唉声叹气的生论派学者，时至今日已经羞于报上名字的贾米——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "贾米"
				}
			]
		}
	]
}