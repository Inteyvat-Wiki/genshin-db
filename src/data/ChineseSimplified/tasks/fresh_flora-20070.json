			"dialogs": [
				{
					"id": 200700201,
					"content": "花怎么样啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700202
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200700202,
					"content": "对不起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700203
					]
				},
				{
					"id": 200700203,
					"content": "嗯？怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700204
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200700204,
					"content": "我不小心把盒子和花弄坏了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700205
					]
				},
				{
					"id": 200700205,
					"content": "弄、弄坏了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700206
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200700206,
					"content": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700207
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200700207,
					"content": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700208
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200700208,
					"content": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700209
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200700209,
					"content": "唉，不然…我还是再用莎拉小姐的办法试试吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				}
			]
		},
