			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉米雅",
					"振尘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "好，这些食物我们会用食盒装好送出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680402,
					"content": "每一只动物都有自己独特的习性，我们并不会把动物关在笼子里，而是雇佣专业的饲养人员跟踪监控它们的身体状况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680403,
					"content": "要找到它们不是容易的事情，你会需要拉米雅女士研制的特殊器材「铭随流镜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680404,
					"content": "这方面我不如她本人懂行，还是请她向你解释吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680405,
					"content": "嗯，还是让我来说明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680406,
					"content": "「铭随流镜」这种装置的底层技术和虚空有一定关联，具体的运行逻辑可能有点复杂，总之你放心，是实测安全的装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680407,
					"content": "使用的时候，因为我们已经在动物身上绑上了微型发讯装置，只要读取装置信号，镜子里就能显露动物视角中的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680408,
					"content": "尽管这个装置还有需要改进的地方，但这些影像暂时够我们定位活跃中的动物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680409,
					"content": "大体来说就是这样，如果你准备好了，欢迎加入「伴爪同行」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680410,
					"content": "用「铭随流镜」找一找我们的动物朋友吧，认养人的礼物和小动物们都在等着和你打招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振尘"
				}
			]
		},
