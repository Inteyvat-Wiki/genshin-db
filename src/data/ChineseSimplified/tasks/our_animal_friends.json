					"振尘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "欢迎大家加入「伴爪同行」动物救助会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#是{NICKNAME}啊，你好你好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680105,
					"content": "我们商会正在办活动，有没有兴趣来看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680106,
					"content": "是什么样的活动？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "简单来说，是加入飞云商会资助的「伴爪同行」动物救助会，和我们一起认养被抛弃或者濒危的动物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680108,
					"content": "飞云商会一直在和世界各国的志愿者合作，通过社会认养的方式解决广泛存在的流浪动物问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680109,
					"content": "最近这几年救助会越做越大，我们开始考虑和拉米雅女士这样的学者合作，接触濒危动物保护领域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680110,
					"content": "能把研究成果用在这种地方，我也很开心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "拉米雅"
				},
				{
					"id": 716680111,
					"content": "哈哈，能和您合作，对我们来说也是乐事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680112,
					"content": "多亏我们的志愿者和拉米雅女士这样有远见的研究人员，很多流浪动物有了一个家，濒危动物得到了保护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680113,
					"content": "除了璃月本土，还有蒙德、须弥…只要是飞云商会活跃的国家，到处都有「伴爪同行」的动物饲养点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680114,
					"content": "为了感谢志愿者们，也为了让大家都知道，「伴爪同行」的伙伴有很多很多，我们举办了这个活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680115,
					"content": "你可以前往被认养动物栖息的区域找一找，去看看它们实际的生活状态，顺便领取一份小礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680116,
					"content": "礼物是由救助会工作人员和其他认养人共同准备的，当然，在领取礼物之前，你也得给其他的认养人准备点东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680117,
					"content": "届时，礼物会有专人回收，并传递给原本的认养人。礼物不需要多贵重，只要能传递心意就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680118,
					"content": "#怎么样，{NICKNAME}，有兴趣参加吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680119,
					"content": "可以看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "太好了，有你这样的社会名人参与，我们也很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680122,
					"content": "你准备好了的话，现在就可以把礼物交给我，由我们的工作人员在活动结束后分送给认养人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680123,
					"content": "对了，以我和认养人打交道的经验来看，有些认养人对地区特产感兴趣，有些比较喜欢美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振尘"
				},
				{
					"id": 716680120,
					"content": "我想参加。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
