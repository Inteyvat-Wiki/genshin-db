			"dialogs": [
				{
					"id": 760930101,
					"content": "为边地照亮黑夜的铸灯者啊，吾等执灯人在此宣誓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930102
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930102,
					"content": "「如是我预见：海浪翻起白沫，死寂毁灭了星月夜。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930103
					],
					"speakerTitle": "执灯士众人"
				},
				{
					"id": 760930103,
					"content": "「如是我宣告：谁掌中灯火不灭，就不必陷入如此黑暗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930104
					],
					"speakerTitle": "执灯士众人"
				},
				{
					"id": 760930104,
					"content": "「我们是执灯人，无尽雪原中执灯守护永燃的希望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930105
					],
					"speakerTitle": "执灯士众人"
				},
				{
					"id": 760930105,
					"content": "那么诸位，此次作战的目标是击退盘踞在苦壑崖的魔物…以及调查引发此次狂猎的罪魁祸首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930106
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930106,
					"content": "时隔三年，如今我们将再度踏足崖上，进行决胜之战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930107
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930107,
					"content": "我知道你们当中许多人和我一样，有着不得不加入这次作战的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930108
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930108,
					"content": "要记住，我们的身后就是皮拉米达城，为了生者，为了未来，我们绝不能后退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930109
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930109,
					"content": "正如誓言所说，「我们将使骨血做燃料，我们将使生大于死」…完成我们作为执灯士的职责吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930110
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930110,
					"content": "出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930111
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930111,
					"content": "是！队长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "执灯士众人"
				}
			]
		},
