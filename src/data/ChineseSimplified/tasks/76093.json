			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲林斯$UNRELEASED",
					"尼基塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760930601,
					"content": "放平时我恐怕不会主动请缨，但这次的麻烦真的不需要我出手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930602
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930602,
					"content": "哦，你来了啊，菲林斯。我还以为你不会来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930603
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930603,
					"content": "如果您真那么想，为何不直接减少给我寄信的频次呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930604
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930604,
					"content": "没记错的话，您一个星期前就把通知送到我的灯塔来了，我要是都不来看看，也太不尊重您这位执灯长了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930605
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930605,
					"content": "总部的通知从来也没落下你，说到底还是因为那孩子吧。在执灯人里他跟你走得最近，总向我打听你的近况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930606
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930606,
					"content": "他的近况如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930607
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930608
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930608,
					"content": "你还是选择了将重任放在他的肩上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930609
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930609,
					"content": "是啊。我需要他，而我也深切地信任着他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930610
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930610,
					"content": "我已经给出了忠告，那并非寻常的狂猎。那些魔物是被吸引过来的，被某个过去被封印在苦壑崖的古老存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930611
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930611,
					"content": "关于「他」，我也略知一二，我曾在白沙皇的宫廷中与他有过一面之缘，那条毒蛇绝非等闲之辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930612
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930612,
					"content": "我记得他的眼睛，就和现在正盯着我们的那只一模一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930613
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930613,
					"content": "我说，菲林斯啊，你还记得我们是怎么成为执灯人的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930614
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930614,
					"content": "你是说「你们」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930615
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930615,
					"content": "「我们」，菲林斯，我们。最近我总梦到过去的事情，梦见你我一起经历过的那些战场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930616
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930616,
					"content": "灾难总是突然到来的…无论是枕戈待旦、坦然面对之人，还是提心吊胆、心怀侥幸之辈，大限来时，无人能够幸免。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930617
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930617,
					"content": "但你我都知道，在永恒的宁静到来前，人的抗争是有意义的。而我们执灯人正是这样，用五百年的抗争，铸成了这座堡垒的根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930618
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930618,
					"content": "我看叶洛亚没到需要补上这一课的程度吧？你比我更清楚他曾经失去过一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930619
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930619,
					"content": "这道理他想必早已知道，只是眼下，少年的心气让他还不愿意承认罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930620
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930620,
					"content": "但我的时间也不多了…比起他即将肩负的责任，我本该为他争取的岁月，现在也所剩无几了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930621
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930621,
					"content": "看来你决心已定了。那我就不再白费口舌了，毕竟你才是执灯长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930622
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930622,
					"content": "话说回来，上次托你寻的物件，你还记得吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930623
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930623,
					"content": "执灯长先生的委托我怎么会忘？五百年前的古物，且与最初的咏月使有着千丝万缕的联系。即使是我也费了不少周折…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930624
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930624,
					"content": "呵呵，既然如此，我们也该开始准备了。铸灯者留下的「弓矢」，就让我们见识一下它的威力吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼基塔"
				}
			]
		},
