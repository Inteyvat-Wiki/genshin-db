			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安莱夫",
					"罗洛"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5153.061,
							228.983,
							9598.229
						],
						"pointId": 13595
					},
					{
						"sceneId": 3,
						"position": [
							5150.815,
							228.122,
							9597.794
						],
						"pointId": 13664
					},
					{
						"sceneId": 3,
						"position": [
							5152.701,
							228.696,
							9595.494
						],
						"pointId": 14738
					}
				]
			},
			"dialogs": [
				{
					"id": 760930501,
					"content": "罗洛老弟，你真的没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930502
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930502,
					"content": "我没事。抱歉…想到马上能回到皮拉米达城，精神稍微松懈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930503
					],
					"speakerTitle": "罗洛"
				},
				{
					"id": 760930503,
					"content": "你没事就好。刚才你中了狂猎的招，多亏这位小英雄出手相助…总之谢谢你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930504
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930504,
					"content": "举手之劳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930505
					]
				},
				{
					"id": 760930505,
					"content": "#对{NICKNAME}来说就是小菜一碟啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930506,
					"content": "说来小英雄的身手不错啊。怎么样，要不要加入我们执灯人军团呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930507
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930507,
					"content": "不过说起来，在这个节骨眼上邀请你们，在外人看来可能有点恩将仇报的意思…还是算了，你们就当我没说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930508
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930508,
					"content": "刚才我们对付的就是来自苦壑崖的狂猎，这些狂猎怪得很，不仅会成群结队地袭击遇上的活物，据说还有摄人心智的能力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930509
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930509,
					"content": "不知道它们使的什么邪术，会在人意志松懈的瞬间趁虚而入，把人裹挟进狂猎的队伍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930510
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930510,
					"content": "这次的作战就是要对付它们，要是不顺利，从今往后还有没有「执灯人」都难说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930511
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930511,
					"content": "这、这么严重吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930512,
					"content": "是啊，不过这不是你们冒险家…而且还是小孩子该担心的事，就交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930513
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930513,
					"content": "若是还能再见的话，我一定请你们喝「皮拉米达的夜莺」，再来点肉馅黑麦包表达感谢，这才是我们执灯人的待客之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930514
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930514,
					"content": "一定会再见的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930515
					]
				},
				{
					"id": 760930515,
					"content": "加油啊，一定要平安回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930516,
					"content": "那借两位的吉言，我们就先回皮拉米达城了。有缘再会吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安莱夫"
				}
			]
		},
		{
			"id": 7609306,
			"completionStepIds": [
				7609308,
				7609309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
