				]
			},
			"dialogs": [
				{
					"id": 760930301,
					"content": "真够见鬼的，这破车怎么又停着不动了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930302
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930302,
					"content": "我说月厢车大哥，你就不能再多撑一会吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930303
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930303,
					"content": "就差那么几步路，咱们就能回到皮拉米达了，到时候你是熄火还是趴窝都没人管你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930304
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930304,
					"content": "结果你呢，偏偏要停在这里。怎么着，难道是要我们把你给抬回城里去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930305
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930305,
					"content": "哎，真是多事之秋，不管干什么都触霉头。我可没工夫跟你耗，罗洛老弟，看来我们得多找几个帮手来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930306
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930306,
					"content": "哎哟，我这还没叫人呢，怎么就有两位朋友来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930307
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930307,
					"content": "看起来不是很眼熟啊，难不成是新入行的宝藏猎人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930308
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930308,
					"content": "#你们好，我是派蒙，{M#他}{F#她}是{NICKNAME}，我们是路过这里的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930309,
					"content": "看你们的样子，是遇到什么困难了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930310,
					"content": "喔！你们好，我叫安莱夫，是一名执灯士。原来两位是冒险家啊…那你们恐怕来错地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930311,
						760930312
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930311,
					"content": "放心，我们不会乱动东西的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930313
					]
				},
				{
					"id": 760930313,
					"content": "倒也不是这个意思，你们刚来或许不知道，最近北边的苦壑崖一带爆发了大规模的狂猎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930314
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930314,
					"content": "那里有一座开拓时代遗留下来的古老遗迹，几年前就出过事故，但没想到会突然变得这么严重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930315
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930315,
					"content": "你们往北边看，瞧见了吗？这阵子不少魔物从那儿冒出来，很不太平，你们要是没什么要紧事，最好也别在这一带游荡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930316
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930316,
					"content": "这次我们就是受到了老爷子的召唤，为了参加讨伐狂猎的行动才赶回皮拉米达城的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930317
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930317,
					"content": "你说对吧，罗洛老弟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930318
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930318,
					"content": "喂，你这是怎么了，从刚才开始就一言不发的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930319
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930319,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 760930312,
					"content": "这里不欢迎冒险家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930313
					]
				}
			]
		},
