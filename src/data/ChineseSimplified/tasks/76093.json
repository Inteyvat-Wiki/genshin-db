			},
			"dialogs": [
				{
					"id": 760930801,
					"content": "为边地照亮黑夜的铸灯者啊，吾等执灯人在此宣誓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930802
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930802,
					"content": "「如是我预见：海浪翻起白沫，死寂毁灭了星月夜。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930803
					],
					"speakerTitle": "执灯士众人"
				},
				{
					"id": 760930803,
					"content": "「如是我宣告：谁掌中灯火不灭，就不必陷入如此黑暗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930804
					],
					"speakerTitle": "执灯士众人"
				},
				{
					"id": 760930804,
					"content": "「我们是执灯人，无尽雪原中执灯守护永燃的希望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930805
					],
					"speakerTitle": "执灯士众人"
				},
				{
					"id": 760930805,
					"content": "那么诸位，此次作战的目标是击退盘踞在苦壑崖的魔物…以及调查引发此次狂猎的罪魁祸首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930806
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930806,
					"content": "时隔三年，如今我们将再度踏足崖上，进行决胜之战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930807
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930807,
					"content": "我知道你们当中许多人和我一样，有着不得不加入这次作战的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930808
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930808,
					"content": "要记住，我们的身后就是皮拉米达城，为了生者，为了未来，我们绝不能后退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930809
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930809,
					"content": "正如誓言所说，「我们将使骨血做燃料，我们将使生大于死」…完成我们作为执灯士的职责吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930810
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930810,
					"content": "出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930811
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760930811,
					"content": "是！队长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "执灯士众人"
				}
			]
		}
	]
