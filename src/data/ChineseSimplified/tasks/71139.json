				"points": []
			},
			"dialogs": [
				{
					"id": 711390601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390602,
					"content": "怎么了，灵渊？一直盯着我看，我身上有什么奇怪的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390603,
					"content": "我只是在想…不，没什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390604,
					"content": "就算你和蛇一起要求，我也不会再化成人形了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390605,
					"content": "呵呵，我也没要求过你呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390606,
					"content": "…算了。走吧。你不是还要去看现在的茶园吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "灵渊"
				}
			]
		},
		{
			"id": 7113907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
