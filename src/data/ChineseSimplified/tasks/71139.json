					{
						"sceneId": 3,
						"position": [
							1621.245,
							338.875,
							2414.79
						],
						"pointId": 311500192
					}
				]
			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "欸，这不是灵渊吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390303,
					"content": "啊，对不起！难道说你是在狩猎，我们不小心打扰了你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390304,
					"content": "我没有在狩猎。你们也没有打扰我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390305,
					"content": "呃，那你这是在…发呆？比方说，在想好吃的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390306,
					"content": "我也没在想你的事情。我在思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390307,
					"content": "思考…不对，你前半句话是什么意思啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390308,
					"content": "#我在思考{NICKNAME}之前的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390309,
					"content": "「如果人类活动也是自然法则的一部分，该如何看待人类。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390310,
					"content": "浮锦和蛇，她们离开后，我太久没有接触过组成聚落的人类了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390311,
					"content": "你这话说的，小茂不也是人类嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390312,
					"content": "#小茂是属于聚落的人类，而不是组成聚落的人类。你和{NICKNAME}「组成」了旅行的同伴，而不「属于」{NICKNAME}。这就是区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390313,
					"content": "你认为小茂不是社会秩序的一部分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "还没有完全成为这种秩序的一部分。人类的幼崽几乎都是这样，直到他们被这种秩序彻底涂抹，就像是自然那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390317,
					"content": "我太久没有接触过组成聚落的人类了。或许是出于厌恶，或许是出于恐惧，或许两者皆有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390318,
					"content": "因为他们侵占了属于自然的土地？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390321,
					"content": "也许不存在明显的区别，划分「我们」和「他们」，但我无法确定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390322,
					"content": "人类的幼崽会与我同行，我也有年幼的同族，出于好奇选择与人类同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390323,
					"content": "欸？年幼的同族？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390324,
					"content": "那孩子在山中遇到了烟火气的人类，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390325,
					"content": "所以，我现在依然没办法回答你的问题。我需要继续观察人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390326,
					"content": "许多事情，我不理解。我会试着理解，直到我能够按照约定，回答你的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390319,
					"content": "因为浮锦为了他们选择牺牲自己？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "这可不好说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "喂！不要说这么奇怪的话啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113904",
							"2"
						],
						"stepId": 7113904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小茂",
					"沃特蒙泰涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "听大山这么讲，我感觉枫丹的「歌剧」和我们这边的戏好像也差不多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390402,
					"content": "骑士呀，巫师呀，勇士呀，恶龙呀，你杀我，我杀你的，最后大家都死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390403,
					"content": "重要的不是结局啦，而是过程，过程！不是所有悲剧都能当武打戏那么看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "沃特蒙泰涅"
				},
				{
					"id": 711390404,
					"content": "还有还有，大山刚才说的「累牡蛎牙魔像」，听上去好像很有趣！不知道和阿蓝比起来哪个更大呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390405,
					"content": "欸？阿兰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "沃特蒙泰涅"
				},
				{
					"id": 711390406,
					"content": "对喔，我好像还没给大山讲过阿蓝的事情…这样吧，你再给我讲一讲「累牡蛎牙」的魔像，我就给你讲阿蓝的故事好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小茂"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浮锦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "哇啊！不知不觉间，我们已经收集到这么多仙力啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390502,
					"content": "不愧是我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "按照浮锦之前的说法，这些仙力都用在「祀珑」上了。这样一来，翘英庄明年应该也会大丰收啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390506,
					"content": "到了那时候，我要让罗叔给我准备好多好多好吃的！我想想，比如说茶糕，乳鸽，红烧肉圆，蜜汁叉烧，还有还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390507,
					"content": "对对对，还有沉玉茶露！这个一定要记下来…欸？不对，什么人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390508,
					"content": "浮、浮锦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390509,
					"content": "呵呵，抱歉，吓到你们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390510,
					"content": "你已经能变回人形啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390511,
					"content": "是呀。咳咳，小仙我不是说过嘛，又不是受了什么严重的伤，只要稍微休养一段时间，就能恢复我最喜欢的模样啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390512,
					"content": "#谢谢你们，在我休养的这段时间，为祀珑收集了这么多的仙力。来年的丰收，{NICKNAME}和派蒙是最大的功臣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390513,
					"content": "#哼哼，对本{M#少爷}{F#小姐}来说不过是举手之劳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "说到这个，既然浮锦现在已经恢复人形了，也不用再被关在这个黑漆漆的地方了，接下来有什么想做的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390516,
					"content": "嗯…具体的我还没有想好呢。说不定会先在附近走走看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390517,
					"content": "品一品现在的茶，听一听现在的戏，见一见现在的人…呵呵，抱歉，总是强调「现在」，感觉像是什么讨人厌的老古董一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390518,
					"content": "不过，我真的很喜欢「现在」这个词。过去没办法做到的事情，「现在」也能做得到了。过去没办法实现的、好多好多的约定，「现在」也能实现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390519,
					"content": "之后，我想要到归离集去看一看，到璃月港去看一看，去见见她们所说的可爱的人们，也想要见见药君…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390520,
					"content": "需要我带你去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "是呀，我记得浮锦好像说过，「没办法离开清水太长时间」、「需要依靠仙家的茶壶才能去很远的地方」什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390522,
					"content": "呵呵…谢谢你还记得这件事，也谢谢你愿意帮我。不过，我还是希望先在沉玉谷停留一段时间，好好欣赏一下家中的风景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390523,
					"content": "至于远游，我想想…嗯，要不然等小茂长大吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390524,
					"content": "这也太久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390525,
					"content": "开玩笑的啦！总之，我还是打算先在这边停留一段时间，也顺便试试看能不能劝灵渊和我一同出游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390526,
					"content": "#对了，{NICKNAME}！在你走之前，还有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390527,
					"content": "无论是灵渊还是我，都给你们添了太多太多的麻烦。我的仙力也稍稍恢复一些了，还请让我为你们献上真正的祝福，护佑你们接下来的旅途吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390528,
					"content": "呵呵，好了！这样一来，应该就没问题啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390529,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#那么，再一次…谢谢你们，{NICKNAME}和派蒙，谢谢你们为我，为沉玉谷做的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390530,
					"content": "总觉得好像没什么变化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "毕竟「福运」也不是一下子就能看出来的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390514,
					"content": "能帮上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#不愧是本{M#少爷}{F#小姐}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "喂！都过去那么久了，就别再用那种奇怪的说话方式啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7113906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
