			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小茂",
					"灵渊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390201,
					"content": "阿蓝，阿蓝，你上次给我讲的那个故事，还没有结尾呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390202
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390202,
					"content": "嗯。我记得。不过，我改变主意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390203
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390203,
					"content": "「改变主意」是什么意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390204
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390204,
					"content": "这个故事的结尾，就交给你来讲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390205
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390205,
					"content": "欸？！阿蓝也太耍赖啦！明明说好的，我给你讲一个故事，你给我讲一个故事，怎么现在两个故事全都变成我来讲啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390206
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390206,
					"content": "我只是愚钝的野兽。想不出好的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390207
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390207,
					"content": "我想出的结局是坏结局，故事也是没有人会欢笑的坏故事。所以，你来讲故事的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390208
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390208,
					"content": "可这还是在耍赖嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390209
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390209,
					"content": "我不否认。作为补偿，我可以带你去看灵濛山中隐藏的绝景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390210
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390211
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390211,
					"content": "不要露出那种表情。我特别允许你…坐在我背上，五分钟左右。十分钟也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390212
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390212,
					"content": "那…那就这样说好了，我想想这个故事该怎么结尾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小茂"
				}
			]
		},
		{
			"id": 7113903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
