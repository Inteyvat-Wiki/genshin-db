			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"灵渊"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1621.539,
							339.454,
							2412.706
						],
						"pointId": 311500191
