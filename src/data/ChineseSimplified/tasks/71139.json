							"7113907",
							"2"
						],
						"stepId": 7113907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浮锦",
					"灵渊"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1499.263,
							-45.19,
							2743.714
						],
						"pointId": 311600090
					},
					{
						"sceneId": 3,
						"position": [
							1499.039,
							-45.012,
							2744.685
						],
						"pointId": 311600091
					},
					{
						"sceneId": 3,
						"position": [
							1498.467,
							-44.813,
							2746.65
						],
						"pointId": 311600093
					}
				]
			},
			"dialogs": [
				{
					"id": 711390701,
					"content": "话说回来，这里就是浮锦的洞天吧？总觉得和我们见过的其他洞天不太一样，怎么说呢，好像更…有现实感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390702,
					"content": "既没有什么奇奇怪怪的机关，也没有什么透明的浮空桥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390703,
					"content": "实在是对不起…之前觉得太丢人了，一直没能解释清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390704
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390704,
					"content": "我没办法像南方众仙那样，创造出新的空间来。「锦落庭」不是什么「洞天」，充其量也就只是个「洞穴」而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390705
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390705,
					"content": "「洞天」也好，「洞穴」也好，不都是仙家的「洞府」嘛！不过，也不知道浮锦什么时候才能变回人形呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390706,
					"content": "她积攒的力量已经全部逸散到了这片土地上。短时间内应该没办法再恢复人形了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390707
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390707,
					"content": "我耗尽力量的时候也是一样。主人死去后，从雪落到雪融，再从雪融到雪落，如此反复不知多少次，我才能再度化为人的模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390708
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390708,
					"content": "原来是这样…欸？等一下，原来灵渊也能化成人形吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390709,
					"content": "哼哼，那是当然！二位有所不知，想当初，在药君山的时候，灵渊的姿容可是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390710
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390710,
					"content": "浮锦。没必要说下去。这和现在的话题没有任何关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390711
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390711,
					"content": "欸？那化为人形以后，因为在庙会上吃了太多茶糕，哭着跑去求药君帮自己调配减肥茶的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390712
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390712,
					"content": "或者不小心把庆典上的酒当作茶水喝了下去，拽着山间的林猪，问「药君和我谁更美」的事情，果然还是没必要说下去了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390713
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390713,
					"content": "…浮锦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390714
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390714,
					"content": "呜啊，你这么一说，我开始好奇灵渊化成的人形到底是什么样的了！会是像现在一样蓝蓝的吗？还是会…呃，更白一点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390715,
						711390717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390715,
					"content": "我也很好奇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390716
					]
				},
				{
					"id": 711390716,
					"content": "我不理解你好奇的原因。你也是人。对人的形态感兴趣，看看自己就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390721
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390721,
					"content": "#呵呵…总之，谢谢你们，{NICKNAME}和派蒙。我也没有想到，有朝一日，还能像这样和其他人交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390722
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390722,
					"content": "咳咳——既然小仙我心情大悦，不妨就护佑二位，接下来的旅途能够一帆风顺，时通运泰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390723
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390723,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390724,
					"content": "…对不起是我得意忘形了。我刚才想要像仙人那样，说一下这句话试试看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390725
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390725,
					"content": "无论如何，我都会在这里祈愿，愿你们接下来的旅途一帆风顺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390717,
					"content": "灵渊，可以变一下看看吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390718
					]
				},
				{
					"id": 711390718,
					"content": "我拒绝。人类的身躯过于羸弱。没有撕碎猎物的尖牙，没有逐狩仇敌的利爪。除非浮锦命令，我不会做那种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390726,
						711390727
					],
					"speakerTitle": "灵渊"
				},
				{
					"id": 711390726,
					"content": "好可惜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390721
					]
				},
				{
					"id": 711390727,
					"content": "浮锦，拜托你了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390719
					]
				},
				{
					"id": 711390719,
					"content": "…欸？这、这个，我觉得还是应该尊重灵渊的想法吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390720
					],
					"speakerTitle": "浮锦"
				},
				{
					"id": 711390720,
					"content": "我没有什么想法。你要是有想法的话，可以直接告诉我。",
