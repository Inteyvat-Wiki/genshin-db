			"dialogs": [
				{
					"id": 400390801,
					"content": "停手！都给我停手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "卡门"
				},
				{
					"id": 400390802,
					"content": "你们这帮不长眼的，连北斗大姐都不认识了吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "卡门"
				},
				{
					"id": 400390803,
					"content": "嘿嘿…北斗姐，这么长时间没见，您身手还是这么好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "卡门"
				},
				{
					"id": 400390804,
					"content": "卡门，一段时间不见，你怎么又胖了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390805,
					"content": "再胖下去，你躲在草丛里的时候可就要藏不住自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390806,
					"content": "您说笑了，说笑了…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "卡门"
				},
				{
					"id": 400390807,
					"content": "说正事吧，这些东西我要了。把东西放下，我不为难你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390808,
					"content": "是是是，都听北斗姐的…把东西都放下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "卡门"
				},
				{
					"id": 400390809,
					"content": "东西都给您放在这了，那…那兄弟们就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "卡门"
				},
				{
					"id": 400390810,
					"content": "卡门带着盗宝团迅速离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "居然答应得这么爽快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400390812,
					"content": "投降得很利落。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "跑得也很利落啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400390814,
					"content": "别在他们身上浪费时间了，我们快点去海上接着打捞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390815,
					"content": "对了，还得把这些东西搬上船才行…旅行者，过来搭把手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
		},
