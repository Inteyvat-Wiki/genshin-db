					"nextDialogs": [
						400391204
					]
				},
				{
					"id": 400391204,
					"content": "盗宝团也掺和进来了啊，确实有些麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391205
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400391205,
					"content": "你们这次能吓退他们，但只是一时，这群家伙不会善罢甘休。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400391206,
					"content": "不过，这件事就交给北斗吧，她擅长对付这些人。她的报酬，我也会准备好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391207
					],
					"speakerTitle": "凝光"
				},
				{
