					"content": "多谢你们专程回来告知我这些事。我为你们也准备了一些酬劳，还请收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391208
					],
					"speakerTitle": "凝光"
				},
