					"nextDialogs": [
						740770209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740770209,
					"content": "这么多年，水仙十字圣剑才第一次被修复啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770210
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770210,
					"content": "如果当年的设计无误，解除最终封印的钥匙就是圣剑本身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770211
					],
					"speakerTitle": "卡特皮拉"
				},
				{
