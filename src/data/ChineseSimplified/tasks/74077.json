			},
			"dialogs": [
				{
					"id": 740770801,
					"content": "你好，有什么能为你效劳的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770802
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740770802,
					"content": "关于警卫发条机关…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770803
					]
				},
				{
					"id": 740770803,
					"content": "请不必担心。它们都处在非激活状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770804
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740770804,
					"content": "而且年代久远，加上是初期型号，它们苏醒过来的概率并不是百分之百。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770805
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740770805,
					"content": "根据我身边这几位的记录来看，开启下层的入口就会触发激活唤醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770806
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740770806,
					"content": "到时候大概会有六成机关能成功启动。剩下四成，启动不了的概率也不是百分之百。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770807
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740770807,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770808
					]
				},
				{
					"id": 740770808,
					"content": "至少漫长的时间有概率帮我们减轻备战压力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770809
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740770809,
					"content": "这几句话逻辑好绕哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770810
					]
				},
				{
					"id": 740770810,
					"content": "#抱歉，{NICKNAME}{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "西摩尔"
				}
			]
		},
