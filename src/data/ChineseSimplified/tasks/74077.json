				{
					"id": 740770708,
					"content": "哪怕是对雅各布或者，纳齐森科鲁兹来说，钟声响起都有特别的意义吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770709
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770709,
					"content": "特别的意义？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770710
					]
				},
				{
					"id": 740770710,
					"content": "钟响之时，世界终结、冒险结束，或者大梦初醒。谁知道呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
