					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772203
					]
				},
				{
					"id": 740772203,
					"content": "应该会去看看，不过我应该还是会继续流浪吧。我的内心有很多问题需要得到解答。",
					"roleType": "TALK_ROLE_NPC",
