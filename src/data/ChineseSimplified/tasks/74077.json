				{
					"id": 740772101,
					"content": "#{NICKNAME}骑士，还有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772102
					],
					"speakerTitle": "安"
				},
				{
					"id": 740772102,
					"content": "结束之后，有什么想做的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772103
					]
				},
				{
					"id": 740772103,
					"content": "说实话，没有想那么多。感觉我已经无处可去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772104
					],
					"speakerTitle": "安"
				},
				{
					"id": 740772104,
					"content": "知道真相之后，我再也回不到小卷心菜和阿尔身边了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772105
					],
					"speakerTitle": "安"
				},
				{
					"id": 740772105,
					"content": "我应该去哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772106
					],
					"speakerTitle": "安"
				},
				{
					"id": 740772106,
					"content": "算了，以后的事情以后再想吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
