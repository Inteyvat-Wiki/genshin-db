					"nextDialogs": [
						740770206
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770206,
					"content": "你的猜测没错。刚才已经检验过了，这批发条机关仍有唤醒启动可能。",
					"roleType": "TALK_ROLE_NPC",
