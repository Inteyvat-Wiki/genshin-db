			"dialogs": [
				{
					"id": 740771201,
					"content": "#{NICKNAME}，为什么人们都喜欢沉浸在梦里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771202,
					"content": "那个「玛丽安」编织着大家环绕的梦境，纳齐森科鲁兹活在拯救世界的梦想里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771203,
					"content": "明天的事情都是我在操心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771204
					]
				},
				{
					"id": 740771204,
					"content": "…派蒙不理解很正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771205
					]
				},
				{
					"id": 740771205,
					"content": "因、因为我是一个活在当下的类型！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771206,
					"content": "是梦总是会醒的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771207
					]
				},
				{
					"id": 740771207,
					"content": "梦醒来的话，就只有两个选择了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771208,
					"content": "赶紧接着睡，看能不能重新做那个梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771209,
					"content": "或者，就在清醒的世界里，好好面对自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771210,
					"content": "既然梦醒了，就该吃早餐了吧。那就吃个野菇鸡肉串犒劳自己吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771211,
					"content": "又要清醒、勇敢地面对一天现实了呢。给自己加个油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771212,
					"content": "哇塞，真是伏笔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771213
					]
				},
				{
					"id": 740771213,
					"content": "伏笔？什么伏笔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
