				"points": []
			},
			"dialogs": [
				{
					"id": 200270101,
					"content": "#谢谢，谢谢你，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200270102,
					"content": "我本来是想去看看葡萄藤的情况，结果却撞上这倒霉事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200270103,
					"content": "唉，请你别告诉我儿子，他是城里的西风骑士。他平时工作肯定也很辛苦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200270104,
					"content": "我这个老头子的一点小麻烦，就不要让他再烦心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200270105,
					"content": "但是最近，酒庄附近总是会出现史莱姆，我每天都在担心葡萄藤会被史莱姆给毁了，睡也睡不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200270106,
					"content": "如果你们有空的话，就帮我老头子一个忙，再去周围看看，把史莱姆都赶走，别让它们再来破坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200270107,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "太好了，我总算能休息一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特纳"
				},
				{
					"id": 200270108,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "唉，本来说我自己来也行…但是老头子我真的动不了了，年轻人，你就帮帮我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特纳"
				}
			]
		}
	]
