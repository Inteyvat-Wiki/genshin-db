			},
			"dialogs": [
				{
					"id": 230200501,
					"content": "喔！多谢你了，旅行者。这是你的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200502,
					"content": "不过，这材料真是出乎意料的重啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200503,
					"content": "我会尽快开始建造的，这艘小船花不了多长功夫，应该过段时间就能下水试航了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200504,
					"content": "…到时候你可要准备好救生用具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230200505,
					"content": "哎呀，没问题的，绝对没问题，你就相信我吧。",
					"roleType": "TALK_ROLE_NPC",
