			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉菲克",
					"绮珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "…所以说，我觉得这一块区域的材料是不能这么省的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230200102,
					"content": "放心吧，这部分区域的强度肯定足够了，我算了很多遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200103,
					"content": "唉，都说了有很多问题是算不出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230200104,
					"content": "你们在争什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "是你啊，我们正在讨论我那艘船的设计问题呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200106,
					"content": "我已经进行了充分的计算，保证每一个区域都有充分的强度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200107,
					"content": "但绮珊坚持说，那些区域的强度不一定可靠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200108,
					"content": "你说的那些「强度」都只存在于理论上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230200109,
					"content": "船下水了之后要承受的强度，一定会远远高于这个数值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230200110,
					"content": "道理我都明白…但，但我手头的资金有限…还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200111,
					"content": "要是再采购更贵的材料，我顶多就能把这艘船的龙骨造完了…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200112,
					"content": "总之！目前这艘船就先按照我的方案来吧，材料我都采购完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200113,
					"content": "旅行者，如果你愿意的话，能帮我去先搬一部分材料回来吗？我一个人实在是搬不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200114,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "那就拜托你了，我还得在这里计算一些东西。等计算完了，我再去把剩下的材料搬回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200115,
					"content": "绮珊也懂造船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "那可不，她在计算某些部分的时候比我算得还快呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230200117,
					"content": "真不知道她为什么在这里做服务生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "拉菲克"
				}
			]
		},
