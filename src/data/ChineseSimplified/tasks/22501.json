				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "嗯…这一句还是不妥，不妥。唉，说不得还是要去看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "您好您好，在下清昼，自诩诗客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010104,
					"content": "最近我偶得妙诗一句，却始终不知道如何能续，思索至今，始终不得头绪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010105,
					"content": "最近天有异象，众多陨石坠地，此类景观实在人间少有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010106,
					"content": "我想，要是能去陨石近前一观，搜得些许灵感，那下一句诗说不定就能水到渠成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010107,
					"content": "不，不太合适…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "不太合适？您这又是从何说起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
