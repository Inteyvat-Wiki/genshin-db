				"points": []
			},
			"dialogs": [
				{
					"id": 225011201,
					"content": "我思来想去，你的担心不无道理，我还是不去陨石旁边自找麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225011202,
					"content": "那就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "况且，好诗未必一定以新奇词句见长，于细微处见博大胸怀才更妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225011204,
					"content": "以花草等微小之物入诗，或许也能写出妙句，但世间咏花的诗文实在数量众多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225011205,
					"content": "唔，俗话说「旁观者清」，以你看来，何种花入诗合适？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
