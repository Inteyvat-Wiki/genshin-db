				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "您说的「不太合适」，到底是指什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010202,
					"content": "摸到陨石的话会陷入昏睡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "唔，这件事我也有所耳闻，但如果只是近观一番，想必也没有什么大碍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010204,
					"content": "你能保证绝不摸陨石吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "这个…这个我心中自有分寸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
