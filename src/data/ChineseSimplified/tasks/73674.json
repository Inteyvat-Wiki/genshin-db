				"points": []
			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "小家伙，不是你带我来的吗？来点作用，再动一动啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740102,
					"content": "唉，行吧，你就待着别动吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740103,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "唉，我这次算是又被这小家伙给坑了…我从头和你简单说说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740107,
					"content": "说出来你可能不太相信，但是我这人不知道为什么，总是特别容易吸引仙灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740108,
					"content": "在那些过来跟着我不走的仙灵里，我发现了一种特别热衷于寻宝的仙灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740109,
					"content": "我也不会取名，就直接叫它们「寻宝仙灵」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740110,
					"content": "它们很擅长寻宝，在它们的帮助下，我也挖到了不少宝贝，小小地赚了一笔钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740111,
					"content": "但它们有时候会突然不搭理我，也不知道是寻宝累了，还是觉得我这个人没什么意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740112,
					"content": "这个时候，我一般就会找个能让仙灵看顺眼的帮手合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740113,
					"content": "他负责带着「寻宝仙灵」寻宝，而我嘛…就负责把这些宝贝变现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740114,
					"content": "我之前听人说，须弥这里遍地遗迹，满地古玩，所以就想要过来捞一笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740115,
					"content": "来了之后，我果然又吸引来了一堆仙灵，其中的几个「寻宝仙灵」把我带到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740116,
					"content": "但我没挖几铲子，这些小家伙又不搭理我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740117,
					"content": "咦？它怎么突然动弹起来了？难道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740118,
					"content": "旅行者，你对和仙灵一起寻宝这件事，有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740119,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "不用和它说话，只要跟着它走，看它停下了就往下挖，就这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740122,
					"content": "怎么样？你就试试看吧，嗯…如果你真找到了宝藏，我只要里面的「古铁钱」，其他的东西全都归你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740123,
					"content": "而且，要是你真能帮我找到一些「古铁钱」，那我也会付给你相应的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740124,
					"content": "我可以试试…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "爽快！我就喜欢你这种人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740130,
					"content": "总之，我们现在就是合作关系了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740131,
					"content": "这个笔记本你先拿好，这是我之前找到的一些藏宝地，还没来得及去挖呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740132,
					"content": "那就拜托你了，旅行者。如果找到「古铁钱」的话，记得带回来给我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740126,
					"content": "「古铁钱」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "简单来说，就是一种另类的古董啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740128,
					"content": "只要找到好门路，我就能用这些「古铁钱」换到不少好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740129,
					"content": "虽然…现在我还没有找到好门路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 736740120,
					"content": "我不会和仙灵说话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "这是…仙灵？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "你说这小家伙？呃…就算它是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "乌尔曼"
				}
			]
		},
