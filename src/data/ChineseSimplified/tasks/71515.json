			"completionStepIds": [
				7151501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151501",
							"2"
						],
						"stepId": 7151501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"和声"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150101,
					"content": "「港内北码头现有演出。」唔，这个通知也写得太模糊了吧，既没说是什么演出，也没说是谁演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150102,
					"content": "我们还是自己找找演出的地方吧，实在不行，还可以问路人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150103,
					"content": "那里有好多人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150104
					]
				},
				{
					"id": 715150104,
					"content": "啊，我看到了。这么多人都聚集在这里，说不定就是来看演出的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150105,
					"content": "我们去问问看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7151502,
			"completionStepIds": [
				7151502
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151502",
							"2"
						],
						"stepId": 7151502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庆兴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150201,
					"content": "「如意康宁，平安吉庆…♪」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150202
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150202,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150203
					]
				},
				{
					"id": 715150203,
					"content": "请问这里是不是马上要有演出啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150204,
					"content": "对呀，马上就要演纸映剧了，你们也是来看纸映剧的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150205,
						715150206
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150205,
					"content": "原来这场戏叫《纸映剧》。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150207
					]
				},
				{
					"id": 715150207,
					"content": "不是啦，纸映剧和璃月戏不是一回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150208
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150208,
					"content": "庆兴庆兴，戏快开场了，你们别说话了，会影响大叔表演的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150209
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150209,
					"content": "哦哦，纸映剧什么样，反正你们两个看了就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150210
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150210,
					"content": "…列位小看官们，咱们今天演的是虬髯公的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150211
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150211,
					"content": "话说在前头，有想上厕所的，要买糖水的，大可先去。待到角儿们出场，戏就不等人喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150212
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150212,
					"content": "（所以这出戏叫《虬髯公》，是完全没听说过的故事欸。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150213,
					"content": "嘘，就算小声说话，我们还是听得到，你安安静静听啦，后面点戏的时候才可以说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150214
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150214,
					"content": "唔…对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150215,
					"content": "点戏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150216
					]
				},
				{
					"id": 715150216,
					"content": "虬髯公的故事特别长，全都演完就太长了，所以每次大叔都会让大家选想看哪个部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150217
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150217,
					"content": "庆兴！我听不清大叔念戏文了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150218
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150218,
					"content": "哦哦，这次我真的不插嘴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150219
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150219,
					"content": "看官们，今天大家想品鉴《全本虬髯公》里的哪段故事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150220
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150220,
					"content": "是想看《投山》呢，还是《拜仙》？是《缚鬼》还是《登天》？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150221
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150221,
					"content": "只有小看官们报不出名儿的，没有我不会演的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150222
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150222,
					"content": "我想看虬髯公和妖魔打架，他特别帅，每次都能赢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150223
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150223,
					"content": "《拜仙》和《缚鬼》都看了好多遍了，你不腻吗？我选虬髯公回家看妹妹那段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150224
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150224,
					"content": "虬髯公还有妹妹吗？我怎么不知道，这个我没看过欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150225
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150225,
					"content": "这位小看官是行家啊，《奔乡》这段啊点的人不多，不是老剧迷都不知道有这出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150226
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150226,
					"content": "好，恰逢海灯佳节，咱们不演什么妖魔鬼怪，来瞧瞧有情人怎么终成眷属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150227
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150227,
					"content": "这一场上要出现的角儿有三人，除了咱们的熟面孔虬髯公，还有一位伶仃孤女，名叫意冰，一位志诚君子，唤作南风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150228
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150228,
					"content": "#{NICKNAME}，你听明白了吗？我怎么还是云里雾里的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150229,
					"content": "现在要演的，好像是一个叫虬髯公的人的事？但听起来，除了男主角，还有其他配角啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150230,
					"content": "可我们面前只有一个演员…呃，还有一架…屏风？这怎么演戏啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150231,
					"content": "哎呀，这儿有个人没看过纸映剧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150232
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150232,
					"content": "哦？后面一位小看官问了，我应公只有人一个，又没有分身化形的本事，这戏怎么演呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150233
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150233,
					"content": "您有所不知，我们这纸映剧虽不及璃月戏讲究，也自有一番特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150234
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150234,
					"content": "演璃月戏的那些个角儿们都是血肉之躯，但咱们纸映剧的演员却是纸糊绢裱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150235
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150235,
					"content": "人家的戏台是木头搭的，咱们的戏台是一张薄纸蒙在木架子上，说来说去都是纸，所以叫做纸映剧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150236
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150236,
					"content": "旁白是我，演戏的却不是我，您一会儿就能见到那三位纸演员啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150237
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150237,
					"content": "#大叔，他们应该也不认识虬髯公，给{M#他们}{F#她们}说说虬髯公的事行不行，就是每次开头都有的那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150238
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150238,
					"content": "那个叫定场话，我也喜欢听，大叔给我们念念吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150239
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150239,
					"content": "定场话！定场话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150240
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150240,
					"content": "如此听了，雄心欲把天纲正，无奈人间鬼气高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150241
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150241,
					"content": "只说一位公子桓光，受尽人间不平气，投入山川苍莽间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150242
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150242,
					"content": "机缘巧合，他拜入一位仙人座下，便改换了形貌，蓄起一部乌黑胡须，号称虬髯公。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150243
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150243,
					"content": "他奉仙人之命，一剑东来，把那魑魅荡平，唬得魍魉屏迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150244
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150244,
					"content": "虬髯公辗转修行多年，终于得悟大道，正待要返归仙家洞府时，才由仙人点拨，忆起前尘往事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150245
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150245,
					"content": "原来他尘缘未尽，家中尚有一妹。可怜妹子意冰如今孤苦伶仃，无可依靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150246
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150246,
					"content": "她本以为兄长这一生襟抱送凄凉，如何能想到不日旧人返归乡。欲知后事如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150247
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150247,
					"content": "马上为您分解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150248
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150248,
					"content": "好欸！别愣着啊，这里该鼓掌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150249,
						715150250
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150249,
					"content": "好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150251
					]
				},
				{
					"id": 715150251,
					"content": "什么时候鼓掌也有规定吗？好、好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150252,
					"content": "多谢捧场。话说到这里，本该请出演员开戏，但我看这两位还有些疑惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150253
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150253,
					"content": "我看不如请两位看官上前来，与我做个帮手，指挥布景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150254
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150254,
					"content": "既能让您二位看个清楚明白，也能帮助演员在这方寸舞台上前行。你们意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150255
					],
					"speakerTitle": "应公"
				},
				{
					"id": 715150255,
					"content": "哇，怎么不叫我，我很熟悉纸映剧的，叫我叫我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150256
					],
					"speakerTitle": "庆兴"
				},
				{
					"id": 715150256,
					"content": "你都上去过多少回了，别起哄了，好好看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150257
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150257,
					"content": "我没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150258
					]
				},
				{
					"id": 715150258,
					"content": "帮忙指挥布景吗？听起来好新鲜，我也没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150259
					],
