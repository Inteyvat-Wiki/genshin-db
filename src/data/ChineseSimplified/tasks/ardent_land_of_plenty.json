			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "原来你就是瓦雷莎，我们听过这个名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180202,
					"content": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}，我们是最好的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180203,
					"content": "#好的，派蒙和{NICKNAME}，真是不错的名字，我记住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180204,
					"content": "那我们这就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
