			"dialogs": [
				{
					"id": 150180101,
					"content": "这个立在路边的木板是干什么用的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180107,
					"content": "哦，这是我们部族的健身器材，我也经常用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180108,
					"content": "健身器材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180109,
					"content": "嗯，我想想…比起解释还是直接演示一下更快。瓦雷莎，要上了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180103,
					"content": "平稳落地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180104,
					"content": "呜哇啊啊，就这么跳过去了，你好厉害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180105,
					"content": "没什么，没什么，只要多加练习，很多人都可以做得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180110,
					"content": "哦！你甚至都不需要训练，直接飞过来就好，这不是比我厉害多了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180112,
					"content": "这不一样啦…嗯，但你说的有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
