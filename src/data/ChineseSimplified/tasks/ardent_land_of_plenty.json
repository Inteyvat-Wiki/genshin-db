						150180403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180403,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180404,
					"content": "#你们…难道就是派蒙和{NICKNAME}？！终于等到你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180405,
					"content": "哇啊！你认识我们？原来我们名声已经这么响了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180406,
					"content": "不过…我们来「沃陆之邦」这件事难道和谁说过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180407,
					"content": "欸，你们不知道？伊安珊老师和我说邀请你们来「沃陆之邦」做客，所以我很早就在这里边训练边等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180408,
					"content": "你们真的来了…嘿嘿，居然真的来了，太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180409,
					"content": "也、也不用这么激动吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180410,
					"content": "你们可是对抗深渊的英雄啊，事迹已经传遍纳塔了，我听了好几遍「杜麦{RUBY#[S]希望}尼」的故事，印象深刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180411,
					"content": "从伊安珊老师说你们可能会来「沃陆之邦」开始，我就特别期待！哦，对了，我叫瓦雷莎，伊安珊老师应该提过我的名字吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180412,
					"content": "啊，我有印象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180413,
					"content": "那个时候深渊打进来，我们问伊安珊需不需要回「沃陆之邦」支援，她说瓦雷莎已经把那边的威胁解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180414,
					"content": "这么说你也很厉害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "没有啦，还是阿卡特叔叔指挥得好，我只是清理了一些魔物而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180417,
					"content": "想想那时候发生的事，还是觉得有点后怕呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180418,
					"content": "不过现在这些已经结束了，「沃陆之邦」受到的影响比较小，重建也已经完成，我们部族的人最近都在到处支援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180419,
					"content": "嘿嘿，就让我带你们去部族的营地看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180420,
					"content": "好啊，这就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180415,
					"content": "是名副其实的英雄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
