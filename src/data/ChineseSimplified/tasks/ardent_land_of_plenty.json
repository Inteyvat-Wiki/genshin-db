			"dialogs": [
				{
					"id": 150180301,
					"content": "你好，请问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180303,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180304,
					"content": "你们是不是迷路了？需要我帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180305,
					"content": "没有没有，我们只是正巧路过这里，想去「沃陆之邦」看看…请问是往这个方向去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180306,
					"content": "没错，那里是我的家，如果需要的话，现在我就能带你们过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180307,
					"content": "#太好了，{NICKNAME}，又遇到了当地的向导！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180308,
					"content": "你想偷懒的语气太明显了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "向导啊…我应该没问题吧，嘿嘿，那我现在就是你们的向导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180310,
					"content": "这一路上有很多特别的风景，我可以帮你们介绍，几乎每个刚来我们这里的人，都会发出「哇哦——」的感叹呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180311,
					"content": "谢谢你的好意，不过等等…你接受得这么快，我反而有点愧疚…呃，没关系吗？会不会耽误你本来要做的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180312,
					"content": "没关系没关系，我本来是到这边训练的，正好打算收拾东西回家，我们也算顺路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180313,
					"content": "而且我来当向导的话，你们会了解更多这里的风土人情，收获很多新知识，就会很开心对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180314,
					"content": "你们开心的话，我就会开心。阿卡特叔叔说，这叫「待客之道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180315,
					"content": "好、好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180316,
					"content": "感觉是个单纯又热情的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180317,
					"content": "运气挺好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "是吧，我也这样觉得，我喜欢她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180319,
					"content": "怎么啦，如果准备好了的话，我们就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150180320,
					"content": "对了，还没有问你叫什么名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150180321,
					"content": "对哦，我叫瓦雷莎，很高兴认识你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				}
			]
		},
