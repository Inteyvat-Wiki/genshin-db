			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"砂糖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400501,
					"content": "咦，蒂玛乌斯先生今天好像不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400502,
					"content": "（咦，这两位是…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400503
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400503,
					"content": "#那个！嗯…是派蒙和{NICKNAME}啊，请问，你们是找蒂玛乌斯有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400504
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400504,
					"content": "没什么没什么，只是平时他总是站在这里，有点奇怪而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400505,
					"content": "哦，这样啊。他刚刚被阿贝多先生叫走了，我是被叫来照看炼金铺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400506
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400506,
					"content": "需要我帮忙的话，就叫我的名字，如果不需要，我…我就在那边看书，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400507
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400507,
					"content": "#嘿嘿，谢谢你的好意，不过不用担心啦，炼金台的使用已经很熟悉了，对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400508,
					"content": "嗯，不会打扰到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400509
					]
				},
				{
					"id": 110400509,
					"content": "#{NICKNAME}，不愧是击退了那个风魔龙的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400510
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400510,
					"content": "对了，如果是你的话，一定能帮上阿贝多先生的忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400511
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400511,
					"content": "说起来，上次就一直从你和蒂玛乌斯口中听到什么「阿贝多先生」，他也是蒙德城的炼金术士吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400225,
					"content": "确实是没听过的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "抱歉，一直没能介绍，阿贝多先生是西风骑士团首席炼金术士，也是我和蒂玛乌斯先生的老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400228,
					"content": "平时看到的都是蒂玛乌斯先生在教别人炼金术。这么说，那他就是老师的老师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400229,
					"content": "是的，他致力于探究世界的真相，已经有了很多很多伟大的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400230,
					"content": "经常会有炼金术士不远万里来到蒙德，请求他的帮助。在他们看来艰深复杂的问题，只需要阿贝多先生稍加指点，就能完美解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400231,
					"content": "哇，居然是这么厉害的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400232,
					"content": "嗯。可是，最近他的研究好像遇到了瓶颈，我见到他的时候，他总是一副愁眉不展的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400233,
					"content": "我能帮得上这么厉害的人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "你在冒险中一系列非凡经历，一定会让阿贝多先生特别感兴趣，这应该能为他提供很多很多灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400236,
					"content": "阿贝多先生是一位很有风度的人，如果你帮助了他，他肯定会给你相应的回报的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400237,
					"content": "能让我变得更强吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "我想应该没问题，探究生命的极限本来也是阿贝多先生的研究内容之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400241,
					"content": "阿贝多先生现在应该和蒂玛乌斯先生一起在雪山做研究，我很想带你们去，可是炼金铺不能没人照看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400242,
					"content": "就麻烦你们去雪山的入口找找看吧，是一位温文尔雅的年轻先生，很有学者气质，然后，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400243,
					"content": "…抱歉，我也不知道要怎么说得更清楚，还要麻烦你们努力辨认了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400244,
					"content": "嗯，好，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400239,
					"content": "能让派蒙变得更强吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "我没有这个需求啦。想回报我的话，嘿嘿，用摩拉结算怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400234,
					"content": "我对炼金的了解只有炼金台。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "好像听说过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				}
			]
		}
	]
}