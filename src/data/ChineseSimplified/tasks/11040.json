				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400201,
					"content": "咦，蒂玛乌斯先生今天好像不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400202,
					"content": "（是、是客人？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400203
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400203,
					"content": "那个！嗯…请问，你们找他有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400204
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400204,
					"content": "没什么没什么，只是平时他总是站在这里，有点奇怪而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400205,
					"content": "哦，这样啊。他刚刚被阿贝多先生叫走了，我是被叫来照看炼金铺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400206
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400206,
					"content": "我叫砂糖，是阿贝多先生的助手。炼金术方面如果有问题，也可以问我，我…会尽量帮上忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400207,
						110400209
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400207,
					"content": "自信一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400208
					]
				},
				{
					"id": 110400208,
					"content": "我…其实我很不擅长做这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400211,
					"content": "不、不好意思，平时我都在实验室里，不怎么出门，也不太经常和别人说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400212
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400212,
					"content": "需要我帮忙的话，就叫我的名字，如果不需要，我…我就在那边看书，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400213
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400213,
					"content": "#嘿嘿，谢谢你的好意，不过不用担心啦，炼金台的使用已经很熟悉了，对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400214,
						110400215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400214,
					"content": "嗯，不会打扰到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400216,
					"content": "#欸？{NICKNAME}…难道你就是传说中的那位，击退了风魔龙的旅行者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400217,
						110400218
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400217,
					"content": "「传说中的」太夸张了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400220
					]
				},
				{
					"id": 110400220,
					"content": "我听说了很多关于你的故事，一直心想能有机会近距离研究你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400221
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400221,
					"content": "研、研究？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400222,
					"content": "啊，对不起，不用在意，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400223
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400223,
					"content": "不过，既然是你的话，一定能帮上阿贝多先生的忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400224
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400224,
					"content": "说起来刚刚就一直听到「阿贝多先生」，他也是蒙德城的炼金术士吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400225,
					"content": "确实是没听过的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "抱歉，一直没能介绍，阿贝多先生是西风骑士团首席炼金术士，也是我和蒂玛乌斯先生的老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400228,
					"content": "平时看到的都是蒂玛乌斯先生在教别人炼金术。这么说，那他就是老师的老师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400229,
					"content": "是的，他致力于探究世界的真相，已经有了很多很多伟大的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400230,
					"content": "经常会有炼金术士不远万里来到蒙德，请求他的帮助。在他们看来艰深复杂的问题，只需要阿贝多先生稍加指点，就能完美解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400231,
					"content": "哇，居然是这么厉害的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400232,
					"content": "嗯。可是，最近他的研究好像遇到了瓶颈，我见到他的时候，他总是一副愁眉不展的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400233,
					"content": "我能帮得上这么厉害的人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "你在冒险中一系列非凡经历，一定会让阿贝多先生特别感兴趣，这应该能为他提供很多很多灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400236,
					"content": "阿贝多先生是一位很有风度的人，如果你帮助了他，他肯定会给你相应的回报的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400237,
					"content": "能让我变得更强吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "我想应该没问题，探究生命的极限本来也是阿贝多先生的研究内容之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400241,
					"content": "阿贝多先生现在应该和蒂玛乌斯先生一起在雪山做研究，我很想带你们去，可是炼金铺不能没人照看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400242,
					"content": "就麻烦你们去雪山的入口找找看吧，是一位温文尔雅的年轻先生，很有学者气质，然后，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400243,
					"content": "…抱歉，我也不知道要怎么说得更清楚，还要麻烦你们努力辨认了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400244,
					"content": "嗯，好，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400239,
					"content": "能让派蒙变得更强吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "我没有这个需求啦。想回报我的话，嘿嘿，用摩拉结算怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400234,
					"content": "我对炼金的了解只有炼金台。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "好像听说过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400218,
					"content": "可以免费为你签名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400219
					]
				},
				{
					"id": 110400219,
					"content": "啊，谢谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400220
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400215,
					"content": "好…好像有点忘记了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400209,
					"content": "别紧张。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400210
					]
				},
				{
					"id": 110400210,
					"content": "欸？我…我看上去很紧张吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "砂糖"
				}
			]
		},
		{
			"id": 1104003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
