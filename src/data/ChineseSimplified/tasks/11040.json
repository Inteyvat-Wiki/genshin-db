					"砂糖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400301,
					"content": "不好意思，关于阿贝多先生，我只能给出这种程度的描述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400302
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400302,
					"content": "要是能给你们画一幅他的肖像画就好了，但是我的画技也远远不如他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "砂糖"
				}
			]
		},
		{
			"id": 1104004,
			"completionStepIds": [
				1104004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104004",
							"2"
						],
						"stepId": 1104004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"罗莎莉亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400401,
					"content": "原、原来你在这里，罗莎莉亚小姐，唱诗班的活动马上就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400402
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400402,
					"content": "都说了我不参加这种活动，我还有更重要的事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400403
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400403,
					"content": "可是，这次是有纪念性的活动，希望所有的修女都要出席。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400404
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400404,
					"content": "希望归希望，我的工作内容里又没有「满足别人希望」这一条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400405
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400405,
					"content": "这、这个，话不能这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400406
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400406,
					"content": "倒是你，你是这次活动的组织者吧，你不觉得很奇怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400407
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400407,
					"content": "哪、哪里奇怪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400408
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400408,
					"content": "按现在的时间算，就算你立刻赶回蒙德城，估计也赶不上活动开始的时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400409
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400409,
					"content": "难道不是有人算好了这个，想让你出丑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400410
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400410,
					"content": "欸欸？怎、怎么可能！大家不是这样的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400411
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400411,
					"content": "是不是这样的人，讲的是证据，而不是你的感觉。唉，还是说你太容易相信别人了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400412
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400412,
					"content": "放心吧，即便你就这么回去了，也不会有人责怪你。因为估计也没有几个人觉得我真的会去参加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400413
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400413,
					"content": "但再磨蹭下去，你就真的迟到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400414
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400414,
					"content": "对啊！重要的纪念活动，如果迟到了就…那、那我回去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400415
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400415,
					"content": "听上去…这位修女好像完全是在靠诡辩骗人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400416,
					"content": "从刚才起，就注意到你们了——你们是什么人，又为什么要偷听？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400417
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400417,
					"content": "小心点！我觉得她是个危险人物…呃，至少，有点狡猾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400418,
					"content": "哦？相比起历史悠久的西风教会的成员，你这种来历不明的小漂浮物才更危险吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400419
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400419,
					"content": "被听到了？！我还以为我说得够小声了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400420,
					"content": "嗯，带着小漂浮物的外乡人…原来如此，你就是…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400421
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400421,
					"content": "击退了风魔龙的「荣誉骑士」，凭这层身份，就先不急着追究你的偷听了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400422
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400422,
					"content": "否则…视你们的回答而定，最坏的情况可能会是牢狱之灾呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400423
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400423,
					"content": "欸！蒙德城的修女还能负责抓捕可疑人士的吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400424,
					"content": "至少不能对明显存在的隐患视而不见吧，修女就不可以拥有正义感吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400425
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400425,
					"content": "呃，听上去怪怪的，但好像没办法反驳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400426,
					"content": "还是说说你们吧，你们是为什么要到雪山来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400427,
						110400428
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400427,
					"content": "来找阿贝多先生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400431
					]
				},
				{
					"id": 110400431,
					"content": "找他的话，我之前特意留意了一下他的足迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400432
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400432,
					"content": "雪停之后，往来雪山的人很多，希望一路上的痕迹还没有被盖掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400433
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400433,
					"content": "难不成，你也是来找他的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400434,
					"content": "不是的，这应该算职业习惯吧，因为我察觉到这些足迹上残留了元素力，警惕一点总没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400435,
						110400436
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400435,
					"content": "以修女而言，你好像太神秘了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400437,
					"content": "无所谓你怎么想，走吧，我也顺路去看看他在干什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400436,
					"content": "像侦探一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400428,
					"content": "来探究世界的真相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400429
					]
				},
				{
					"id": 110400429,
					"content": "但你只是个旅行者，并非什么伟大的炼金术士吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400430
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 110400430,
					"content": "无所谓，我大概知道你是想来找谁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400431
					],
					"speakerTitle": "罗莎莉亚"
				}
			]
		},
		{
			"id": 1104005,
			"completionStepIds": [
				1104002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104002",
