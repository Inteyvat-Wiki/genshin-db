			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "终于到<color=#00E1FFFF>璃月</color>了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010202,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_GIRLA]}，冒昧问一下。你身边飘着的这个小东西，多少钱可以卖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010203,
					"content": "多少钱也不卖！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "多少钱也不卖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010209,
					"content": "哈哈哈哈，最近手头周转不开，的确出不起价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010210,
					"content": "毕竟我只是个普通商人，也不倒腾奇珍异宝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010211,
					"content": "…听语气感觉很可疑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010212,
					"content": "别这么说嘛。小家伙，你要吃糖吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}，我认为这个人可以信任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010214,
					"content": "对了，你们来璃月，也应该是冲着「海灯节」来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010215,
					"content": "今年的「明霄灯」壮景可期啊。用来让巨灯浮空的那块「浮生石」，是二十年来最大的一块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010216,
					"content": "大到让人不禁要想，神话中云间的浮城要是真的存在的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010217,
					"content": "也只是下面装了一块差不多大的浮生石吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010218,
					"content": "听起来好厉害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010219,
					"content": "哈哈哈哈，有缘再见吧。欢迎你们来璃月——这话代表不了<color=#00E1FFFF>璃月港</color>，但我的小店永远欢迎你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				},
				{
					"id": 400010205,
					"content": "你出不起我心中的价位。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "这话听着怪怪的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010207,
					"content": "说实话还有点在意…究竟这个价位是多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010208,
					"content": "算了，我就当你是在说「多少钱也不卖」好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江舟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#{NICKNAME}，快看！那块石头浮在空中欸，而且连链子都拉直了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010302,
					"content": "如果没有锁链拴住，不知道它会飞去哪里呢？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010303,
					"content": "这就是用来制作「明霄灯」的浮生石。整个「霄市」就是围绕着它布设的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010304,
					"content": "啊，请问你是…？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010305,
					"content": "我是江舟，最近负责明霄灯的建设进度统计。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010306,
					"content": "看样子你们是第一次来璃月见识海灯节吧？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010307,
					"content": "没错…你怎么知道的？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010308,
					"content": "去年我可不记得有带着奇怪吉祥物的旅行者来过。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010309,
					"content": "我来介绍一下吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010310,
					"content": "所以「明霄灯」是…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "节日里，人们手中放飞的小灯叫做「霄灯」。而全璃月人共同建造的巨灯，就是「明霄灯」了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010312,
					"content": "「霄市」上的摊位，是璃月各路商行一年一度、难得不为赚钱，只为筹集「明霄灯」的建设资材而开设的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010313,
					"content": "你们如果愿意，也可以一起来帮忙。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010314,
					"content": "那，那有什么好处吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010315,
					"content": "你的努力「明霄灯」是会记住的。等到新年第一次月圆，辞旧迎新之时，你的愿望也会…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010316,
					"content": "就没有更实际一点的吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010317,
					"content": "唉，何必如此务实？脚踏实地之外，也需要仰望星空啊。人生不能缺少梦想家的气质…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010318,
					"content": "总而言之，帮助建设「明霄灯」的话，在<color=#00E1FFFF>「霄市」</color>也自有回报。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010319,
					"content": "总而言之，只要努力就能换到好吃的，对吧？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}，要加油哦！我们去问问<color=#00E1FFFF>「霄市」</color>上的人吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "今年「明霄灯」的造型是纪念「移霄导天真君」啊，那个喜欢逞威风的家伙应该会高兴的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010602,
					"content": "关于「移霄导天真君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "今年海灯节在建造的「明霄灯」，就是「移霄导天真君」的形象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010604,
					"content": "希望他们会把鹿角修得大一些，毕竟头上的角可是那位仙人最引以为傲的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010605,
					"content": "据说，他的角吸收了岩王帝君岩之力的神髓，曾是整个璃月最坚硬的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010606,
					"content": "可就在「那场决战」中，劲力迸出，山岳倾倒，他为了不波及到山脚的村庄，主动让朋友将他的鹿角砍下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010607,
					"content": "他将那鲜血淋漓的鹿角作为支点，撑起了整个山岳。而他自己也坚持战斗到自己流尽最后一滴血…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010608,
					"content": "如今，曾被他撑起的「天衡山」依然巍然屹立，他死战之中流出的鲜血则汇聚而成「碧水河」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010609,
					"content": "呵呵…不论你是否相信我讲的，能有人愿意听听这些陈年旧事，就已经是很大的安慰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010610,
					"content": "海灯节之所以存在，也是因为那些「老朋友们」不甘寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 400010611,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "再见。愿薪火相传，美德不灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		},
