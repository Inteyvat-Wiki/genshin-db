			"dialogs": [
				{
					"id": 755040101,
					"content": "嗨呀！你们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040102
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040102,
					"content": "看你们的眼神，想必饱览了各地的风光和物产，找到了灵感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040103
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040103,
					"content": "马马虎虎吧…这一路上玩得倒是挺开心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040104,
					"content": "有了特定的目标以后，还真能注意到不少以前忽略的细节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040105,
					"content": "我们也算是大开眼界，收集了许多素材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040106,
						755040107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040106,
					"content": "可惜不一定能运用在涂鸦上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				},
				{
					"id": 755040108,
					"content": "不要紧，慢慢来！我也不至于急切到要你们在纳塔游览一番，就顿悟前卫为何物嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040109
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040109,
					"content": "那么，向我细说你们的见闻吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040110
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040110,
					"content": "向「炫彩呆子」展示了你们在涂鸦指南上的记录，以及拍摄到的各种画片…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						755040111
					]
				},
				{
					"id": 755040111,
					"content": "等等…你们拍摄画片时的意识…不是很妙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040112
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040112,
					"content": "没想到你们使用留影机的经验相当丰富，下意识为这些画片选取了绝佳的构图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040113
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040113,
					"content": "既然如此，我说太多反而是揠苗助长，只需稍微给你们一点引导，应该就能打通你们的思维。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040114
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040114,
					"content": "那就请你们收下我的手记，之后的旅途中，没事对着眼前的风景读一读，也许眼前就能浮现出富有张力的构图！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040115
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040115,
					"content": "欸？我还以为你会给我们分析每张画片，然后上一堂…前卫理念入门课呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040116,
					"content": "而且我也有点想试试涂鸦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040117,
					"content": "这不是显得你们天赋异禀，有望无师自通吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040118
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040118,
					"content": "对于无师自通的天才，让他们按部就班，循规蹈矩地学习涂鸦技巧，或许会扼杀他们发展的潜力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040119
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040119,
					"content": "所以，我就要从全责任的导师和引路人，转变成给你们提供帮助的前辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040120
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040120,
					"content": "等到灵感喷涌，时机成熟了，你们拿起涂鸦的颜料罐，就能大展身手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040121
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040121,
					"content": "我们居然还有这种天赋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040122,
					"content": "嘿嘿…看来之前接了那么多画家、映影导演的委托，全都没有白费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040123,
						755040124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040123,
					"content": "那就借你吉言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040125,
					"content": "放轻松，凭你们的才气，肯定能以自己的理解，抓准前卫艺术的脉络！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040126
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040126,
					"content": "我一般会待在「烟谜主」那边，筹备建设涂鸦联盟总部的事。要是有什么想要咨询的事，还可以来问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040127
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040127,
					"content": "下次过来的时候，我给你们搭配一套上好的涂鸦装备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040128
					],
					"speakerTitle": "「炫彩呆子」"
				},
				{
					"id": 755040128,
					"content": "好，涂鸦联盟的总部预定要建设在「烟谜主」那边，我们记住了…祝你们一切顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040129,
						755040130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040129,
					"content": "这次的交流很愉快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040131,
					"content": "等到空闲下来，我们就多看看「炫彩呆子」的手记，让自己的艺术思维变得更厉害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040132,
					"content": "说不定以后，等我们真的成为了涂鸦和画画的高手，还能用这门本领狠狠赚外快？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755040130,
					"content": "下次再见了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040124,
					"content": "我们会努力去悟的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040107,
					"content": "前卫的理念还得琢磨琢磨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				}
			]
		}
	]
}