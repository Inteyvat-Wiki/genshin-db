					"nextDialogs": [
						240040514
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040514,
					"content": "然后…你还要再顺便去和我爸讨论问题，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040515
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040515,
					"content": "我，我确实有几个地方弄不明白，得向叔叔请教…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040516
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040516,
					"content": "好啦，我爸现在肯定在家，我们快回去吧。我妈妈上次还说要留你们吃晚饭呢…",
					"roleType": "TALK_ROLE_NPC",
