			"dialogs": [
				{
					"id": 240040201,
					"content": "…这一页我应该已经看过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040202,
					"content": "你在…看书？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "#没想到{M#大哥哥}{F#大姐姐}这么快就来了，我才刚翻开这本书呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040205,
					"content": "这本书是洛薇的爸爸特意让她带给我的，还说我有什么不懂的地方可以去问他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040206,
					"content": "但是…呵呵，说实话这本书我几乎没有看得懂的地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040207,
					"content": "先不说这些，我先回去集合点了，毕竟我已经被你找到了，玩游戏就得遵守规则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040203,
					"content": "你还真是时刻不忘学习…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
