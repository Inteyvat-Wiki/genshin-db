			"trigger": {
				"objectNames": [
					"韦吕",
					"奥雷勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "哥哥！我们藏到那边去，肯定比她选的位置好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240040102,
					"content": "别乱跑，韦吕！要是你跑丢了，我可没办法马上把你找回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040103,
					"content": "你怎么在这？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "#哇！{M#大哥哥}{F#大姐姐}！你有空吗？快和我们一起藏起来，洛薇估计早就藏好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240040106,
					"content": "关于洛薇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "来不及说了，快点快点，她可熟悉这里了…我们得找个更好的地方藏起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240040108,
					"content": "韦吕飞快地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "唉，韦吕这家伙…什么时候能听点话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040110,
					"content": "抱歉，只能麻烦您再陪我们玩一场了，韦吕不知道为什么，突然这么兴奋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040111,
					"content": "也许是因为找到新玩伴了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "我也这么想。但无论如何，只要韦吕玩得开心就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040113,
					"content": "不过…这家伙也太兴奋了，不会跟洛薇跑去什么奇怪的地方躲着吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040118,
					"content": "#{M#大哥哥}{F#大姐姐}，那就只能拜托你再陪我们玩一次了，麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040119,
					"content": "那我也得快点去找个位置藏着，不然韦吕可要不高兴了，要是他当街哭起来，我可就彻底没办法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040120,
					"content": "奥雷勒离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "关于洛薇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "是我们刚认识的一个女生。看我们在玩捉迷藏，也吵着要来玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040116,
					"content": "她的性格和韦吕差不多，所以这两个人很玩得来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040117,
					"content": "而且…她的父亲似乎也没什么时间陪她玩，这倒是和我们两个差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040104,
					"content": "你们还在玩捉迷藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
