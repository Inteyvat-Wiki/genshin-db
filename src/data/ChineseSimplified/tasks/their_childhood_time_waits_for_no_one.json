			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "#好吧…还是被你找…咦？{M#大哥哥}{F#大姐姐}，你是谁呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040402,
					"content": "是奥雷勒和韦吕的朋友啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "喔！我听他们提起过你，韦吕说你可擅长玩捉迷藏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040404,
					"content": "#今天我可算是见识到啦，{M#大哥哥}{F#大姐姐}果然很厉害啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040405,
					"content": "认输认输，我去集合点等着啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛薇"
				}
			]
