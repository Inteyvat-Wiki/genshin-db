			"dialogs": [
				{
					"id": 240040501,
					"content": "你们两个…为什么这样看着我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040502,
					"content": "哥…你不会又是躲在哪里偷偷看书了吧？没有认真陪我们玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240040503,
					"content": "对啊，好不容易玩次游戏，认真点啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040504,
					"content": "好位置都被你们占着了，我又不擅长捉迷藏…可不就只能看看书打发时间了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040505,
					"content": "嘁！哥哥骗人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240040506,
					"content": "哼！就爱看书！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040507,
					"content": "你们就饶了我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240040508,
					"content": "你们就饶了他吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "嘿嘿，洛薇可擅长玩捉迷藏了，还知道很多有趣的地方可以藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240040517,
					"content": "嘿嘿嘿，有洛薇陪着玩，这里也挺有意思的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240040511,
					"content": "韦吕的爬起墙来可快了，力气还很大，有好多地方都是他拉我上去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040512,
					"content": "#只要我们俩一起走，除了{M#大哥哥}{F#大姐姐}之外的一般人可找不到我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040513,
					"content": "好啦，你们玩得也差不多了。洛薇，我们先送你回家吧。",
