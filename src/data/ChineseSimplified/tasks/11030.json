					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300610,
					"content": "要什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300611,
					"content": "呼…从那边过来了，那个难对付的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300612
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300612,
					"content": "就先交给你应付了，甘雨，这…嗯，这也是修行的一环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300613
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300613,
					"content": "难对付的家伙？居然能在这里碰到让魈皱眉头的家伙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300614,
					"content": "天…天呐！帝君在天之灵保佑，我终于访到仙人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300615
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300615,
					"content": "敢问各位都是这山上的仙人吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300616
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300616,
					"content": "太好了，小民辛程，求各位仙人保佑恋爱、保佑财运、保佑仕途…拜托拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300617
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300617,
					"content": "原来是访仙者呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300618,
						110300619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300618,
					"content": "好功利…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300621
					]
				},
				{
					"id": 110300621,
					"content": "我…应该也算仙人吧，也可以说是还在修行中的仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300622
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300622,
					"content": "太好了！果真没白来，虽然听起来好像是个半吊子，嗯…也无所谓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300623
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300623,
					"content": "那您能保佑我什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300624
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300624,
					"content": "…哇，这人讲话真是过分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300625,
					"content": "这位…访仙人，我觉得您不该这般妄图走捷径，仙人也不是都要无偿帮助每个访仙者的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300626
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300626,
					"content": "无偿？您这意思是，仙人保佑还要收费的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300627
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300627,
					"content": "啊，我不是这个意思，我只是想说凡事还是应当靠努力工作和认真生活来争取…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300628
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300628,
					"content": "平白无故得到一切的话，对其他普通人是不公平的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300629
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300629,
					"content": "好了好了，这段话我来之前，也听我爹爹唠叨过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300630
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300630,
					"content": "因为您父亲应该体会过，普通人辛劳却幸福的一生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300631
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300631,
					"content": "像您这样的年纪，还是应该把注意力集中在工作和家庭上，不要寄希望于虚无缥缈的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300632
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300632,
					"content": "您真的是仙人吗…为什么想法和说话方式都这么像我们城里人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300633
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300633,
					"content": "该不会是那种冒充仙人传道，其实是想骗钱的骗术吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300634,
						110300635
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300634,
					"content": "居然还倒打一耙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300638
					]
				},
				{
					"id": 110300638,
					"content": "唉，算了，不管仙人是真是假，看起来都没什么用了。下山吧下山吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300639
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300639,
					"content": "哼，你这种家伙还是赶紧走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300640,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300641
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300641,
					"content": "甘雨小姐，不要因为这种无理的家伙影响了心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300642,
					"content": "我…我不是因为他的态度，而是…他有些话说得确实有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300643
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300643,
					"content": "我以为回到绝云间努力修行，就能找回仙人的身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300644
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300644,
					"content": "可被他质疑了以后，我果然还是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300645,
						110300646
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300645,
					"content": "那就回到璃月港吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300647
					]
				},
				{
					"id": 110300647,
					"content": "可是…璃月港已经不欢迎我了，作为仙人，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300648,
						110300649
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300648,
					"content": "都说了是误会！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300650
					]
				},
				{
					"id": 110300650,
					"content": "是呀！就相信旅行者吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300651
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300651,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300652
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300652,
					"content": "那好吧，我再回璃月港转转。虽然这件事我还是坚持我原有的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300653
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300653,
					"content": "如果证明我的判断没错，我便一定会再次回到绝云间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300654
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300654,
					"content": "可算踏出一步了…那我们走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300649,
					"content": "相信作为人类的我一次？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300650
					]
				},
				{
					"id": 110300646,
					"content": "还是人类的一面更适合你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300647
					]
				},
				{
					"id": 110300635,
					"content": "请你态度尊重一点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300636
					]
				},
				{
					"id": 110300636,
					"content": "唔…你突然凶我干什么，你不也是来访仙的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300637
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300637,
					"content": "这么说来，毕竟也是找甘雨有所求，不能说不算…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300619,
					"content": "确实是魈不擅长应付的类型…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300620
					]
				},
				{
					"id": 110300620,
					"content": "嗯，降妖除魔他在行，对付奇奇怪怪的人类，就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300607,
					"content": "令人敬佩的特立独行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300608
					]
				}
