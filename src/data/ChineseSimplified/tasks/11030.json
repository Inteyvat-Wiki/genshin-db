					"nextDialogs": [
						110300234
					]
				},
				{
					"id": 110300225,
					"content": "相谈甚欢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300226
					]
				},
				{
					"id": 110300215,
					"content": "没有人打算排挤你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300216
