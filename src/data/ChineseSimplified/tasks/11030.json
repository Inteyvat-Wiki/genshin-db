			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百晓",
					"百识",
					"百闻"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110300101,
					"content": "这工作量也实在太惊人了，我们明明有三个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300102
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300102,
					"content": "她一直都是怎么过来的…「七星」的秘书果然不是一般人，这种挫败感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300103
					],
					"speakerTitle": "百识"
				},
				{
					"id": 110300103,
					"content": "欸，你们是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300104
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300104,
					"content": "你们不是凝光的三个跟班吗！怎么在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300105,
					"content": "咳…是凝光小姐的私人秘书，不是跟班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300106
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300106,
					"content": "请问你有见过甘雨小姐吗？旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300107
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300107,
					"content": "自从她前往绝云间之后，已经有很多天没回来了。她是辅助「璃月七星」这个整体的秘书，我们正在替她打理工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300108,
						110300109
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300108,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300110
					]
				},
				{
					"id": 110300110,
					"content": "唔，之前众仙来璃月问罪，虽说事情已经谈和，但「七星」还是希望能展现对仙人们敬重的一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300111
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300111,
					"content": "于是派甘雨小姐作为使者，带信函前往绝云间，将最近璃月风波的处理情况交给仙人过目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300112
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300112,
					"content": "可是…理论上甘雨小姐应该已经回来继续投入工作了，可一直没见她的踪影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300113
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300113,
					"content": "这样啊…可能甘雨小姐只是顺路旅游去了？工作久了也要放松一下心情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300114,
					"content": "这个恐怕不会的…自从我们认识甘雨小姐以来，说她是全璃月最勤奋的人也不为过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300115
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300115,
					"content": "就算是每年固定时间的休假，甘雨小姐也会以「还有很多事情要忙」为由，继续留守月海亭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300116
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300116,
					"content": "这样的她会借出差的机会去偷懒…实在有些难以想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300117
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300117,
					"content": "原来是这样呀…可是，她也有一半是仙人，应该不至于出什么意外吧？你们又为什么一副特别着急的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300118,
					"content": "这个嘛…当然是因为，她那「不可理喻」的工作量了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300119
					],
					"speakerTitle": "百识"
				},
				{
					"id": 110300119,
					"content": "唉…原先得知要为甘雨小姐代班，而且是三个人一起，以为不过是换换工作环境罢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300120
					],
					"speakerTitle": "百识"
				},
				{
					"id": 110300120,
					"content": "嗯，可想不到，原来甘雨小姐一个人的日常工作，就远远超过我们三人可以处理的范畴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300121,
						110300122
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300121,
					"content": "仙人的血脉果然非同一般…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300125
					]
				},
				{
					"id": 110300125,
					"content": "说到这，听说旅行者您也可以自由出入绝云间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300126
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300126,
					"content": "当然，我们去过很多次啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300127,
					"content": "果然，太好了…请问您能不能代我们去绝云间找找甘雨小姐呢？在我们倒在工作岗位上之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300128,
						110300129
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300128,
					"content": "好像确实只有我才行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300130
					]
				},
				{
					"id": 110300130,
					"content": "呼…得救了。还记得甘雨小姐说过准备先去留云借风真君那里，不妨您先去那边找找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300131
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110300131,
					"content": "时间也差不多了，再不回去继续工作的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300132
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300132,
					"content": "不，又或者，是不是应该先去跟凝光大人再提一提加班补贴的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百识"
				},
				{
					"id": 110300129,
					"content": "人命关天，好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300130
					]
				},
				{
					"id": 110300122,
					"content": "要不你们再多加加班？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300123
					]
				},
				{
					"id": 110300123,
					"content": "我们已经不知道连续工作多长时间了…像现在这样出来小憩一会儿，都感觉很有负罪感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300124
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110300124,
					"content": "那还真是，不得了，很紧急的情况了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300109,
					"content": "她为什么会去绝云间？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300110
					]
				}
			]
		},
		{
			"id": 1103002,
			"completionStepIds": [
				1103003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103003",
							"2"
						],
						"stepId": 1103003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110300201,
					"content": "甘雨小姐！你原来在这儿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300202,
					"content": "二位…真没料到会在这里相见。请问有公事还是私事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300203
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300203,
					"content": "啊…不对，如今我已脱离尘世，如果是商港事务的话，还请到月海亭去咨询。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300204,
						110300205
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300204,
					"content": "脱离尘世？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300206
					]
				},
				{
					"id": 110300206,
					"content": "欸，甘雨小姐难道不做「七星」的秘书了吗？他们都还在等你回去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300207,
					"content": "要我回去…原来这就是你们的来意吗？不好意思，要让两位无功而返了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300208,
					"content": "怎么会…莫非是发生什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300209,
					"content": "云卷云舒，潮起潮落，不过是历史的选择罢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300210
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300210,
					"content": "自上次仙众将璃月港的「监督」之权交还给百姓之后，我便已经知道，离开璃月只是时间问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300211
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300211,
					"content": "拥有仙人血脉的我，在璃月港其实并没有容身之所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300212
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300212,
					"content": "此行送达信函之后，我曾回到璃月港，发现我的工作已被百闻、百晓、百识接替…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300213
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300213,
					"content": "想必这次送信的工作，也只是将我支开的借口吧？既然「七星」给了我体面退场的机会，我也自然应该识趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300214,
						110300215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300214,
					"content": "我感觉…有很大的误解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300216
					]
				},
				{
					"id": 110300216,
					"content": "二位的好意，甘雨心领，不过无需再讲这些安慰我的话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300217
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300217,
					"content": "能回到这千年未归的绝云间，看看山间的浮云，我现在心境很平和，如此便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300218
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300218,
					"content": "唔，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300219,
					"content": "是谁在扰这山间清静？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300220
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110300220,
					"content": "留云借风真君？真不好意思，我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300221,
					"content": "呵呵，玩笑话罢了，你们踏入此地之时我便早已觉察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300222
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 110300222,
					"content": "哇，不愧是仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110300223,
					"content": "如何，你们是专程来找甘雨叙旧的吧？看你们相谈甚欢…",
