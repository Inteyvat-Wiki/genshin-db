			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "就是这里了，璃月的「玩具研究所」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120102,
					"content": "到了到了！我已经听到里面机器的声音了，好酷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120103,
					"content": "这里究竟是什么地方，你为什么会知道这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120104,
					"content": "我之前略有了解，这里应该算是「博士」的「玩具研究所」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120105,
					"content": "「博士」是愚人众的另一位「执行官」，平时偶尔有些鼓捣旧东西的…癖好。这处遗迹是被他改造了，用来研究遗迹守卫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120106,
					"content": "欸？遗迹守卫难道是你们愚人众制造的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120107,
					"content": "不，那种怪物和「深渊」的关系更近些，严格来说也算我们的敌人…我们只是单纯地做研究而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120108,
					"content": "至于最近为什么会有遗迹守卫跑出来…大概只是因为他玩腻了，对这里失去兴趣了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120109,
					"content": "又是一个性格恶劣的执行官呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120110,
					"content": "这么说，怪不得你敢带托克来这里，原来是早就做过功课了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120111,
					"content": "其实…也不算做过功课吧，这座「研究所」的内部究竟是什么样，我还完全不了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120112,
					"content": "那、那你难道不在乎弟弟的安危吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120113,
					"content": "怎么会…不论有什么危险，我都会替他全部接下——「哥哥」不就是这样的角色么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120114,
					"content": "而且连托克也能理解战斗的意义，再怎么说，这意义也在我心里沉淀了这么多年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120115,
					"content": "哥哥，你们还在聊什么？快带路呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120116,
					"content": "哈哈，好，交给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "好在被你们先找到了…带伤发动「魔王武装」，原来比想象中更费劲些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120202,
					"content": "不然让托克看到我这副提不起劲的样子，可就太难堪了…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120203,
					"content": "你不怕我趁现在结果了你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "哈哈，我记得你也有兄弟姐妹吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120205,
					"content": "我了解你，所以我知道，不论如何…你也不会在我弟弟面前对我出手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120206,
					"content": "可是，没想到你居然会做到这种程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120208,
					"content": "我只是…不会放弃任何一个锻炼自己的机会而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120209,
					"content": "这就是我达达利亚不断变强的理由啊，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120210,
					"content": "而且，孩童时期的梦是最易碎的东西。哪怕放着不管，也总有一天会自己碎掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120211,
					"content": "所以，一定要有人来保护才行吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120212,
					"content": "许下的承诺就该好好遵守，做错了事就该好好道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120213,
					"content": "给予他的梦，就该好好呵护到最后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120214,
					"content": "这才是身为家人该有的样子，就是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120215,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "莫非…引起你的什么回忆了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120217,
					"content": "咳咳…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120218,
					"content": "你这副样子居然还要耍帅，赶紧去看医生吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120219,
					"content": "呵…不错的提议，不过在这之前…有件东西，要请你转交给托克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120220,
					"content": "欸，这是…「独眼小宝」的玩偶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120221,
