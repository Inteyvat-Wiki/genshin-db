			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"离可琉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "嗯？别来打扰我，我在想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450102,
					"content": "我在想很重要的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450103,
					"content": "很重要的事？是什么事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450104,
					"content": "你看到那个叫大日御舆的东西了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450105,
					"content": "就整个白夜之国最高的建筑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450106,
					"content": "我在想呀，要怎么做个更高的建筑，比大日御舆还高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450107,
					"content": "嗯，可是大日御舆建那么高，是为了照亮白夜国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450108,
					"content": "你的那个建筑做那么高是为了什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450109,
					"content": "当然是为了彰显我离可琉大人的声名啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450110,
					"content": "只有这样，就能证明我比阿倍良久那个大叔要厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450111,
					"content": "你认识…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "那是当然了，建造大日御舆，让白夜国摆脱危机…我以前，正是因为崇拜他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450114,
					"content": "可是，他居然想要图谋王位，要不是那些大人，说不定我就要丢掉性命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450115,
					"content": "哼，我一定要建造比大日御舆还高的建筑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450116,
					"content": "那、那要建多久啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450117,
					"content": "我才不管呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450118,
					"content": "白夜之国的人民能受我谕令，建造一个留名青史的奇观，感恩戴德还来不及呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450119,
					"content": "好了，别打扰我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450120,
					"content": "让我想想，梁高如果…这样的话，承重和斗拱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "离可琉"
				},
				{
					"id": 722450112,
					"content": "阿倍良久吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
