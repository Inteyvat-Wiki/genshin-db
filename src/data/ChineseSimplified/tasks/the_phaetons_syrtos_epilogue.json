			"dialogs": [
				{
					"id": 722450501,
					"content": "哎呀，这位旅者，咱看你眉心发黑，不如让咱给你算个命吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450502,
					"content": "咱可是百算百灵的伊恩大人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450503,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450504,
					"content": "这在桥下拉客的人的语气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450505,
					"content": "（而且，我记得他的墓碑上写着……）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450506,
					"content": "那是什么怀疑的眼神，好了好了，咱平时给别人算命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450507,
					"content": "但是白夜国的国民…很少有幸福快乐的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450508,
					"content": "所以咱就欺骗他们，说他们走了好运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450509,
					"content": "咱觉得，这样他们好歹也能快乐一些嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450510,
					"content": "结果他们就说咱根本就不会算，真是令人悲伤呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450511,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450512,
					"content": "怎么样，小家伙，就让咱给你算一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450513,
					"content": "那、那好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450514,
					"content": "嗯…让我仔细算算，咦，怎么牵涉的东西这么多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450515,
					"content": "诶呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450516,
					"content": "怎、怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450517,
					"content": "算不出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450518,
					"content": "怎么会这样呢，咱平时算出来的虽然不准，但也不会到算不出来的地步啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "伊恩"
				},
				{
					"id": 722450519,
					"content": "看来水平不是很高嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450520,
					"content": "…所言甚是，看来，咱还得再努力学习呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊恩"
				}
			]
		},
