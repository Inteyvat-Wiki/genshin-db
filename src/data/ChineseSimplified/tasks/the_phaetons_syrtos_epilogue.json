			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"依栖目那须",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "嗯？从未在白夜之国见过你们这样穿着的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450202,
					"content": "难道你们是从什么天外之处来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450203,
					"content": "原来世上不只有白夜之国，那，呈上你们通行使用的地图，给我一观吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450204,
					"content": "（给予地图…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "哦哦，真是精巧，不仅陆地轮廓精确，连山川走势也隐隐所现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450206,
					"content": "那么这名为提瓦特之国的国土大小，能和白夜之国相比吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450207,
					"content": "提瓦特是整片大陆的名字啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450208,
					"content": "还有，渊下宫，啊，也就是白夜国，在地图南边的这个小块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450209,
					"content": "荒谬！我白夜国土如此辽阔，怎么可能才只有这点大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450210,
					"content": "此图看上去精巧，实为妄诞乱画之作，拿去拿去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450211,
					"content": "我本还有些敬佩之心，没想到竟是伪作，真是污了我的眼睛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "依栖目那须"
				},
				{
					"id": 722450212,
					"content": "哼，你不信就算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
