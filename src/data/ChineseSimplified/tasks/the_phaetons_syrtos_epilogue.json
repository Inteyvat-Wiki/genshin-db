				"objectNames": [
					"栖令比御",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "远方到来的旅者，咳咳，你看上去相当疲惫啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450302,
					"content": "疲惫可不行，很多病，都是从疲惫开始的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450303,
					"content": "每日要保证足够的睡眠，才能，咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450304,
					"content": "咳咳咳咳，咳咳咳…才能健康成长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450305,
					"content": "总觉得你自己不是很健康呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450306,
					"content": "哈哈，这是老毛病了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450307,
					"content": "旅者啊，只有完备健全的身躯，才可寄寓完备健全的魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450308,
					"content": "唉，如果再有点时间就好了，我一定能够成为世上最好的医生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "栖令比御"
				},
				{
					"id": 722450309,
					"content": "这样，就算是我这样的身躯，恐怕也可以健康地走出房间，肆意玩耍了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "栖令比御"
				}
			]
		},
