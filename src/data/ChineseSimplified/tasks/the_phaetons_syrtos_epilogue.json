			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "啊，看你的样子，你是从异国而来的旅者吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450602,
					"content": "是从什么地方来的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450603,
					"content": "我们是从蒙德来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450604,
					"content": "蒙德？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450605,
					"content": "向比螺梦门简单讲述了蒙德城的风物…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "从来没有听说过的城邦，是嘛，了不起，居然还有这样的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450607,
					"content": "哈哈哈，我就说世上怎么会只有白夜国那么大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450608,
					"content": "世上只有白夜国，嘿，那岂不是寂寞得要死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450609,
					"content": "看古籍的时候也有提到白夜成国之前的故事，那时我就觉得天外有天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450610,
					"content": "不过，我原本还是害怕的，害怕白夜国之外其实空无一物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450611,
					"content": "旅者，你的到来让我安心好多。哼，世上原来还有这么多有趣的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450612,
					"content": "只可惜我现在还有一个叫归日之祭的祭典要完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450613,
					"content": "旅者啊，不如这样，你告诉我你进入此处的路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450614,
					"content": "等到归日之祭的祭典礼成，我就找机会偷偷从大日御舆跑出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "比螺梦门"
				},
				{
					"id": 722450615,
					"content": "到时候一起喝杯果汁吧！哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "比螺梦门"
				}
			]
		},
