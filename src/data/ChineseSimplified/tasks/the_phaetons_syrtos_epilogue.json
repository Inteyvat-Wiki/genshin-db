			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里栖太御须",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "不许动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450402,
					"content": "啊，不要动，不要动啊！诶呀，都说了不要动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450403,
					"content": "诶，可是，突然让我不要动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450404,
					"content": "让派蒙不动…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "才不会呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450407,
					"content": "哎呀，那就转个身吧，我可从来没见过这样的衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450408,
					"content": "虽然有点丑陋，但也不是什么意思都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450409,
					"content": "居然觉得丑，那还不如不要看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450410,
					"content": "真是的，以往我让那些女官们给我作范本，可没有那么烦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450411,
					"content": "不过，白夜国的人啊，穿的衣服，长的样子我也全都看腻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450412,
					"content": "你们身上的倒是少见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450413,
					"content": "嗯嗯，我知道了，原来这个衣服是这样的结构的…你们异乡还真是不知羞耻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450414,
					"content": "原来如此，衣服结构若是这样的，那身躯就做成这个造型吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450415,
					"content": "你这是在做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450416,
					"content": "造像啊，用泥水混合，用双手捏出造型。每每只有做这事的时候，内心才能平静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450417,
					"content": "平时的议会，照本宣科地按着大人们写好的词句读，总让人不安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450418,
					"content": "…好了，你的造型我也已经看腻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450419,
					"content": "别烦我，去做自己的事去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里栖太御须"
				},
				{
					"id": 722450405,
					"content": "会掉下来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
