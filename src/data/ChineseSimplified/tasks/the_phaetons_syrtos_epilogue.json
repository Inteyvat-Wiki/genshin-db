			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "唉，你就是异乡的旅者吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450702,
					"content": "你是在追寻什么吗，你行走的姿势，实在是，令人感到忧伤啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450703,
					"content": "忧伤？有什么让人觉得忧伤的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722450704,
					"content": "对于歌者来说，世界上任何事都是值得悲伤的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450705,
					"content": "譬如，结合就意味着分离，活着就意味着有一日会被埋入尘土之下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450706,
					"content": "譬如，重逢短暂，消解不了别离之苦，这位旅者呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450707,
					"content": "只有追寻什么的人才会踏上远离故土的旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450708,
					"content": "这旅程对于长住一地的居民来说想必相当浪漫，但对于旅者自己，或许是难言的苦楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450709,
					"content": "若是从前，我便要在此为你歌唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450710,
					"content": "只是，我在日前与人立下誓言，如果我听不到她的声音，那我也不再展露自己的歌喉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450711,
					"content": "我只能祝福你，虽然你看上去也已比我年长许多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "御琉部栖"
				},
				{
					"id": 722450712,
					"content": "祝你如愿以偿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御琉部栖"
				}
			]
		}
	]
