			},
			"dialogs": [
				{
					"id": 705450101,
					"content": "喵，喵喵——喵——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450102,
					"content": "喵！喵喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "「兔叽」"
				},
				{
					"id": 705450103,
					"content": "嗯…「兔叽」和安柏都说得很有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450104,
					"content": "喔，原来如此啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450105,
					"content": "确实，说得是呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "其实我也不太明白啦，但我明显感觉到，安柏和「兔叽」达成了共识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}和派蒙啊！你们来啦，我刚想着去找你们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450109,
					"content": "你们协助运营这家「猫茸茸城堡」的事，我已经听瓦乐瑞娜小姐说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450110,
					"content": "#不愧是{NICKNAME}，一回蒙德就帮了这么大的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450111,
					"content": "毕竟我是什么任务都干的荣誉骑士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "说起来，刚才安柏和「兔叽」正在聊什么呢？好像聊得很开心的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450114,
					"content": "喵，喵喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "「兔叽」"
				},
				{
					"id": 705450115,
					"content": "嗯…我正在问「兔叽」今天的天气怎么样，会不会下雨呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450116,
					"content": "欸？小猫还擅长做这种事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450117,
					"content": "嘿嘿，我也是听丽莎小姐说的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450118,
					"content": "丽莎小姐看过的一本书里写着，小猫们对湿气很敏感，而且也不太喜欢湿漉漉的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450119,
					"content": "所以，如果感觉到空气中的湿气突然增大，就会焦躁不安地不断开始揉脸和舔毛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450120,
					"content": "小猫们一旦作出这样的举动，就预示到可能会有大雨来到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450121,
					"content": "原来还有这种神奇的道理…无意中学到了很特别的知识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}，以后我们旅行的时候，可以多多观察猫猫，这样就不至于…老是被乌云倒下来的大雨浇得一身湿了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450123,
					"content": "那以后还真得多注意注意了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "本来我今天是来向瓦乐瑞娜小姐打听一件事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450126,
					"content": "我正在和她聊着呢，这只小猫就凑过来，趴在我旁边打了大大的一个哈欠，太可爱了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450127,
					"content": "她都对我这么亲近了，那…那我也得表示一下友好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450128,
					"content": "然后，我就想起了丽莎小姐告诉我的事，就顺便向「兔叽」问问天气啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450129,
					"content": "但是「兔叽」一会揉脸，一会摇尾巴，一会又趴在地上蹭我的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450130,
					"content": "唔，未来几天，到底会不会下雨呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450124,
					"content": "我本来就很关注路边的猫猫！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "守护蒙德城的小猫也是职责之一嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "慢着，我没懂呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}