			"dialogs": [
				{
					"id": 790041201,
					"content": "你好朋友，请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041202,
					"content": "那个，你是「学者」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790041203,
					"content": "呵呵，算是吧。虽然严格来说，我其实是一位「游学者」，但…「游学者」当然也算是「学者」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041204,
					"content": "怎么，你们遇见了什么必须要「学者」才能解决的问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041205,
					"content": "是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "海上的岛屿…还有岛屿里的壁画，有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041207,
					"content": "然后，你们之所以想要寻找学者，其实也是想要解读那些壁画，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041208,
					"content": "您愿意帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "当然，对于这些未知的故事，我从来都无法拒绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041213,
					"content": "那我们事不宜迟，请把那些壁画给我看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041214,
					"content": "这些是我们记录的壁画。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "嗯…不错，不错。抱歉，请容我思索一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041210,
					"content": "我们可以付报酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "哈哈哈，看你这作风，你应该是一位经验丰富的冒险家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790041212,
					"content": "不过对我来说，这些未知的故事就是最好的报酬，你不用再额外付我什么东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "萨义德"
				}
			]
		},
