			},
			"dialogs": [
				{
					"id": 790040101,
					"content": "咦？你看这里，石头上好像…画着什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "观察"
				},
				{
					"id": 790040102,
					"content": "看起来，像是一艘船遇上了海难…然后还有好多人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "观察"
				},
				{
					"id": 790040103,
					"content": "真难懂…总之先把这幅壁画记录下来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "观察"
				}
			]
		},
