				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "已经记录了这么多壁画了。连起来看的话，也能大致理解上面记录的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萨义德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "嗯，这些壁画里所描绘的内容倒是不难解读。虽然我不太拿得准这些壁画之间的顺序，但我们一幅幅地来理解，应该也不会有什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040402,
					"content": "首先是这幅画，上面记录了一群遭遇了海难的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040403,
					"content": "在遭遇海难后，他们应该是流落到了你找到壁画的那片岛屿上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040404,
					"content": "然后，他们就在那片岛屿上住了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040405,
					"content": "我们再看看这幅壁画，这幅画中描绘了五个物体，而且这五个物体内部，还有着不同的标识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040406,
					"content": "就像是五个盛了水的杯子一样，而且每个杯子里所盛水的量还不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040407,
					"content": "一般来说，这种描绘方式其实是在暗示着某种事物状态的变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040414,
					"content": "事物状态的变化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "但具体什么事物我可没法推测出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040409,
					"content": "不过，如果这是一座在海中的岛屿，那这种事物，也许就是「海水」也说不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040410,
					"content": "我们往后看，接下来是这一张",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040411,
					"content": "在又一次的海难后，这片岛屿迎来了新的「客人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040412,
					"content": "你看，这应该是第一批人正在试图营救第二批人，而且，你看这里描绘的断船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040413,
					"content": "在第一幅壁画里，船只是一个用来暗示他们处境的意象，但在这一幅画中，对于断船的描绘却格外具体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040416,
					"content": "或许这艘断船对这群流落荒岛的人来说，有着非比寻常的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040417,
					"content": "之后就是这一幅壁画了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040418,
					"content": "在这幅壁画中，你们应该也能发现，在画中的山上，有一处特别的标记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040419,
					"content": "我想，对于那群人来说，那个位置应该有着什么重要的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040422,
					"content": "最后就是这一张，很明显，他们找到了离开这座岛屿的方法，并且就此离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040423,
					"content": "这些壁画所描绘的故事应该就是这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040424,
					"content": "谢谢您。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "不用客气，我本来就对这方面的研究有些兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 790040426,
					"content": "谢谢你们给我带来了这些壁画和故事，没想到在蒙德我还能有这样的收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "萨义德"
				},
				{
