			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "太好了，我就知道你果然会有办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940202,
					"content": "虽说獭懒羊无法在没有月矩力的环境下生存，不过至少在挪德卡莱的这段时间里也能给那位先生一点慰藉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940203,
					"content": "那么我就先行告退了，这是一点小小的感谢，不成敬意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦加劳"
				}
			]
		},
