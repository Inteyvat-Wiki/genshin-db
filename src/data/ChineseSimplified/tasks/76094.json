			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦加劳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "到底要怎么把那家伙弄出来呢，真是伤脑筋啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940102,
					"content": "有什么能帮上忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "嗯？哦哦，是热心的冒险家啊，遇上你真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940104,
					"content": "事情是这样的，穿过这里的岩洞原本有一条通往北方的道路，不过前段时间因为月矩力的异变而发生了坍塌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940105,
					"content": "虽然所幸没造成什么人员伤亡，但有位异国的行商说他的「伙伴」 被困在了里面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940106,
					"content": "那是一只他在附近结识的獭懒羊。你要是在这里待得够久就会知道，獭懒羊跟着你多半只是为了把携带的种子播撒到远方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940107,
					"content": "但那位先生怎么跟他解释都不听，一定要我们想办法把它救出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940108,
					"content": "要想重新连接通往洞穴深处的道路，只能利用这些璇珑花。可惜我既不会霜月之子的魔法，也没有强力的月矩力机关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940109,
					"content": "不过幸好遇上了你，如果是冒险家的话，应该能有办法把里面的獭懒羊带出来吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "瓦加劳"
				},
				{
					"id": 760940110,
					"content": "我会替那位先生感谢你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦加劳"
				}
			]
		},
