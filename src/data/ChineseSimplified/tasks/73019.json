			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杨尼斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "我家一直是在这条道上跑商的，从层岩巨渊到须弥。从璃月进口宝石原矿，再把香料送过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190502,
					"content": "有一次，因为有什么事情来着…记不清了，反正老爹把我留在了化城郭，好长一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190503,
					"content": "我记得当时在林子里，认识了一个朋友。我们一起到处跑，后来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190504,
					"content": "后来的事情，我都不记得了。他叫什么名字，长什么样子，也不记得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190505,
					"content": "我只记得那时候好像很开心。后来老爹终于回来了，把我接走了。我也想过，要回去找他，但一直没有机会，后来就忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190506,
					"content": "如果不是因为你问我要糖，这些事情，我应该早就全忘了才对。为什么会这样呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杨尼斯"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰萨卡",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "就是这个！没想到你们这么快就拿回来了…是真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190602,
					"content": "不会是你们为了骗我，所、所以仿造出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190603,
					"content": "就靠你那些描述，能仿造出来才怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190604,
					"content": "你要是不放心，就自己尝尝看嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190605,
					"content": "…你们不会往里面放了奇怪的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190606,
					"content": "当然不会啦，哼，你到底试不试，不试的话我们就拿走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190607,
					"content": "不、不行…你们不要拿走，让我、让我尝尝看嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190608,
					"content": "不要拿走啦，我现在就尝，现在就尝…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190609,
					"content": "啊，是真的…是「开心的味道」，就是这个味道…嘿嘿…再一次尝到，还是觉得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190610,
					"content": "没想到又能尝到这样的味道…呀，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190611,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "唔…怎么说呢…「开心的味道」还是和以前一样，但是不知道为什么，感觉吃起来没有第一次吃那样开心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190614,
					"content": "难道他给我们的糖不甜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190615,
					"content": "不是的，不是味道有差别…但是明明以前和朋友一起吃的时候…那是我第一次品尝「开心的味道」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190616,
					"content": "总觉得那个时候要比现在开心许多，到底是为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190617,
					"content": "#那不是挺正常的嘛，就算是同一道菜，每次{NICKNAME}做出来的味道都不一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190618,
					"content": "我吃的时候心情也不一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190619,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "…不、不会的，一定有一种方法，让我像第一次品尝「开心的味道」时那样开心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190622,
					"content": "我知道了，那个时候我是和朋友一起吃的。所以，「开心的味道」要和朋友一起，才会变得好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190623,
					"content": "一定是这样的。你们是好那菈，而且，找到了「开心的味道」。你们，是朋友。我要做给你们吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190624,
					"content": "嗯，我们是朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190625,
					"content": "兰萨卡立刻进行了烹饪，将墩墩桃与糖加入锅中…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "随后，兰萨卡将成品交给你与派蒙。\\n果不其然，除了压倒性的「甜」以外，并没有什么味道。\\n可能这就是「开心的味道」吧。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "啊，真是开心的味道。太美味了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190628,
					"content": "嗯，这道菜还挺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190629,
					"content": "还挺「开心」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190630,
					"content": "太甜了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "我也觉得，实在是太甜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190633,
					"content": "是、是嘛，欸呀，我好像一口气放得太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190634,
					"content": "但是…嘿嘿，果然，果然要和朋友一起分享，「开心的味道」才会更开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190635,
					"content": "虽然和第一次吃到「开心的味道」的时候感受到的开心也有区别，但是和你们一起吃…我感到了另外一种开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190636,
					"content": "开心就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "一开始的时候我还怀疑你们心怀不轨，但是你们不计前嫌，还、还帮我找到了「开心的味道」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190639,
					"content": "有你们的帮助，我才能做完我的「至上珍馐」，完成「烹饪修行」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190640,
					"content": "这都不算什么啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190641,
					"content": "那、那怎么可以，你们帮了我那么多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190642,
					"content": "对了。我教你们，这个菜肴的做法。这样的话，以后你们就能和朋友，分享「开心的味道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190643,
					"content": "(嗯…如果改一下原料的配比，再加点别的，应该可以做成不错的点心…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190637,
					"content": "我想喝水…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "我想喝水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "还能有这回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "有什么问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
		},
