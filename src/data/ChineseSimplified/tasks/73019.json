			},
			"dialogs": [
				{
					"id": 730190301,
					"content": "怎、怎么样，你们找到，「开心的味道」了吗…就在化城郭里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190302,
					"content": "有个那菈，背上有一个鼓鼓的东西。「开心的味道」一定装在里面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰萨卡"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"2"
						],
						"stepId": 7301904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"杨尼斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190402,
					"content": "唔，你们好…怎么，有什么想要的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190403,
					"content": "是的，其实我们是想要一样东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190404,
					"content": "呵呵，当然啦，所有人过来都是想要「一样东西」的。不过只说「一样东西」，我可不知道你们要的是「什么东西」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190405,
					"content": "嗯…我知道啦。怎么说呢，我们想要的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190406,
					"content": "白白方方的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "白白方方的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190408,
					"content": "对，而且还要一揉就碎成沙，还要装在硬硬的气泡里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190409,
					"content": "还真是奇怪的描述…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190410,
					"content": "光听你们这么说，还真不清楚到底是什么，不过，你们说的这种白白的方方的东西啊，它是干什么用的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190411,
					"content": "用途，用途总归是知道的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190412,
					"content": "是可以吃的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "可以吃的，白白方方的东西…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190416,
					"content": "啊！我知道了，我知道你们要什么了…哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190417,
					"content": "有这么好笑嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190418,
					"content": "哎呦，哈哈哈哈哈，我说啊，白白方方的，一揉就碎，变成沙…还能吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190419,
					"content": "那不就是「糖」吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190420,
					"content": "硬硬气泡，不会说的是装糖的玻璃瓶吧，我的天哪，硬硬气泡，哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190421,
					"content": "什么呀，原来是糖啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190422,
					"content": "有些难堪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "哎呀，笑得眼泪都快出来了。这些年为了生意奔波，都不知道上一次笑成这样是什么时候的事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190425,
					"content": "这么说来，真是怀念，我记得很久以前…啊，我还是小孩的时候，曾经有个朋友第一次吃糖，也说过类似的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190426,
					"content": "「这个白白方方的东西真好吃！好厉害！开心的味道。」可惊讶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190427,
					"content": "哈哈…都是多少年前的事了，现在回想，却连他长什么样子都记不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190428,
					"content": "哎呀，作为笑得这么开心的回礼，这瓶糖就送给你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190429,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "要注意，小心拿好哦，硬硬气泡虽然硬，一下摔在地上可还是会碎的。「硬硬气泡」，哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杨尼斯"
				},
				{
					"id": 730190423,
					"content": "有些尴尬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "是烹饪用的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "烹饪用的，白白方方的，难道是调味料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "杨尼斯"
				}
			]
		},
		{
			"id": 7301905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"3"
						],
						"stepId": 7301904,
						"stateName": "QUEST_STATE_FINISHED"
