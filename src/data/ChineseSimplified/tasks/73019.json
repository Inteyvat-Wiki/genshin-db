				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "要好好地吸食雨露，快快长大才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190102,
					"content": "你好！你是兰…兰什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190103,
					"content": "你是兰帕卡提的哥哥吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "哦哦，这招不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190107,
					"content": "…长大、长大，变成美味的菜肴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190108,
					"content": "完全听不进去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190105,
					"content": "兰萨卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "兰萨卡！你是兰萨卡吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "噫！是那菈…好高、好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190202,
					"content": "求求你了…不要摘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190203,
					"content": "好啦，我们不会摘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190204,
					"content": "那就好，呼呼…这些墩墩桃都是我，一点一点种出来的，从它们还是种子开始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190205,
					"content": "不、不对，你们这些那菈，坏！怎么能随便向别人种的墩墩桃下手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190206,
					"content": "那菈为什么会、会有这么可怕的习惯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190207,
					"content": "我们什么都没做，还没来得及摘啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190208,
					"content": "什么都没做，都已经那么可怕了，你们要是真做点什么，那岂不是要吓死我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190209,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190210,
					"content": "不行，兰萨卡…想想呀，为了你辛苦种出的墩墩桃，为了「烹饪修行」…不能在这里退缩，一定不能害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190211,
					"content": "果然，你就是兰萨卡呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190212,
					"content": "呜哇，你、你们怎么知道我名字的…你们是从哪里来的那菈…居、居然一见面就知道了我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190213,
					"content": "你自己说的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "真是祸从口出，完蛋了，我的名字将被用于可怕的诅咒…求求你们，饶了我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190215,
					"content": "除了把墩墩桃给你们，我什么都愿意做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190219,
					"content": "没必要那么紧张啦，我们其实是受兰帕卡提委托来找你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190220,
					"content": "兰、兰帕卡提？啊，我亲爱的「妹妹」，密林中的阳光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190221,
					"content": "向兰萨卡述说事情的经过。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "呜哇，无忧节、无忧节怎么会那么快…欸，你们就是来参加这次无忧节的那菈吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190223,
					"content": "对不起，刚刚说你们是坏那菈。你们一定是好那菈，因为只有好那菈才能进入桓那兰那，参加无忧节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190224,
					"content": "无忧节要到了，要是没有完成「烹饪修行」就回桓那兰那…不行…但是无忧节可不能不参加…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190225,
					"content": "怎么反而变得更紧张了…你不是还有你种的墩墩桃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190226,
					"content": "…只、只有我种的墩墩桃是不够的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190227,
					"content": "一定要拿到「开心的味道」。没有「开心的味道」，墩墩桃也只不过是墩墩桃而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190228,
					"content": "兰茶荼、兰阿帕斯和兰非拉，都不相信世界上存在「开心的味道」。我要做出来给他们看。也要给那菈品尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190229,
					"content": "「开心的味道」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "嘿嘿，「开心的味道」，我以前曾经尝到过一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190232,
					"content": "「开心的味道」。白白的，揉揉就碎…变成白色的巴螺迦，但是不像巴螺迦那样，又硬又痛。装在硬硬气泡里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190233,
					"content": "…白色的巴螺迦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "白色的巴螺迦，就是白色的沙子…吧？不过，硬硬气泡是什么啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190236,
					"content": "唔，搞不懂。那种「开心的味道」在什么地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190237,
					"content": "你、你问这个干什么，难道你想要在我之前，夺走「开心的味道」吗？好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190238,
					"content": "我们是想帮你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "帮我？帮我什么？我、我自己也能拿到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190242,
					"content": "只不过，那里有很多那菈走来走去。而且，其中有一个，还有那菈巴螺迦的味道。唔…我害怕…要是那菈少一点，我也可以的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190243,
					"content": "…唉。好吧，我就是拿不到，我…不敢进化城郭，那里那菈太多了。而且，都是死去的树，我好怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190244,
					"content": "我有一个那菈朋友住在里面。但是，过去了很久很久。现在，他变了，听不到我的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190245,
					"content": "这样啊，所以你说的「开心的味道」，其实在化城郭里就有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190246,
					"content": "「开心的味道」，不是从土地里长出来的，而是那菈做出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190247,
					"content": "我真的好想再尝一次呀，我还记得第一次品尝那个味道的时候，心里多么高兴。那是好厉害、好厉害的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190248,
					"content": "和那菈朋友一起在森林里，数从树叶间落下来的，像金箔一样的阳光有多少片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190249,
					"content": "一起唱歌，一起品尝「开心的味道」。每次看见树叶间的阳光，我就会想到他。每次想到他，我就想起「开心的味道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190250,
					"content": "所以，我想让兰帕卡提尝尝这样的味道。而且，等无忧节开始了，让那菈也尝尝这样的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190251,
					"content": "#我明白了，就交给我和{NICKNAME}吧！对吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190252,
					"content": "我也想要开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "真的？你们没有在骗我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190255,
					"content": "没有啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190256,
					"content": "不过化城郭那么多人，到底要去谁那里找啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190257,
					"content": "我知道。不久之前，看到一个那菈，从这里路过，<color=#00E1FFFF>去了化城郭</color>。他就带着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190258,
					"content": "他背上有一个鼓鼓的东西。是那菈用来装东西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190259,
					"content": "背上有鼓鼓的东西…嗯，<color=#00E1FFFF>应该是行囊或者背篓</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190260,
					"content": "知道了，我们这就去帮你找「开心的味道」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190253,
					"content": "既然已经答应了兰帕卡提…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "哇！派蒙，你好可怕！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "喂！我只是想帮兰萨卡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730190234,
					"content": "…硬硬气泡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "你说的「开心的味道」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "我们早就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "什么！早就知道？原来你们在很早之前就盯上了我…难、难道你们想从我这里得到什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730190218,
					"content": "难道是墩墩桃？不、不行，要是其他的东西我一定给…但，但是墩墩桃不行，无论如何都不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "兰萨卡"
				}
			]
		},
		{
			"id": 7301903,
			"completionStepIds": [],
