			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870101,
					"content": "你们好，有缘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870102,
					"content": "两位举手投足间散发着一股馨香，必定经受过风雅之物的熏陶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870103,
					"content": "#咦，我们身上香香的？让我闻闻你，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870104,
					"content": "真的诶，你身上有股松茸酿肉卷的香味！这个姐姐看人真准！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870105,
						726870106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870105,
					"content": "她说的应该不是这种香味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				},
				{
					"id": 726870107,
					"content": "也对哦，这种熟悉的展开…我明白了！这位姐姐果然也需要我们帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870108,
					"content": "两位是尽职尽责的向导，的确能为我招徕更多客人，但我希望你们也能以客人的身份享受这场祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870109,
					"content": "如果两位有空，要来试试看吗？构筑专属你们的「花影瑶庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870110,
					"content": "「花影瑶庭」是什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870111,
					"content": "我也想了解一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870112
					]
				},
				{
					"id": 726870112,
					"content": "如你所见，我是一名花匠。我身边这些花架上陈列着的，是以「插花」之道所构筑的「花庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870113
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870113,
					"content": "将精心修剪的花卉置入花器，辅以各色饰物，构建桌上庭院般的景致。这便是「花影瑶庭」，花艺的结晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870114
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870114,
					"content": "在社奉行的支持下，我携多座「花影瑶庭」参与容彩祭，希望能让客人们领略到花艺的美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870115
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870115,
					"content": "要是对「花影瑶庭」感兴趣，现在就可以来体验一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870116
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870116,
					"content": "确实…这些花艺作品都好漂亮，听起来也好高雅啊。不过，总觉得这种事情好难好难…我们能做到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870117,
						726870118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870117,
					"content": "派蒙有点手笨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870119,
					"content": "请别担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870120
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870120,
					"content": "为了让客人们充分体验花艺的魅力，我预先制作了许多部件，适当简化了「花影瑶庭」的制作步骤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870121
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870121,
					"content": "只需要选择「主花」「花景」和「茵席」，将它们适当组合，就能完成「花影瑶庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870122
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870122,
					"content": "当然，重要的是品味花艺的「表达」，因此，我会为你们提出四道「花题」，考验你们的构图思维。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870123
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870123,
					"content": "完成每天的「花题」后，就能将相应的「花庭」和花材带走留念，还可以获得额外的奖品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870124
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870124,
					"content": "真的吗！还有这种好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870125,
					"content": "#{NICKNAME}，这位姐姐这么尽心尽力地推崇花艺，我们就帮帮她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870126,
						726870127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870126,
					"content": "为了优美的花艺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870128,
					"content": "我们现在就要试试…什么来着？对！制作我们的「花影瑶庭」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870129,
					"content": "两位愿意对花艺投入心意和热情，实在感激不尽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870130
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870130,
					"content": "那我们现在就开始吧。今日的「花题」是「紫樱扶疏，澄砂薄香」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870131
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870131,
					"content": "请两位领会题中的深意，专注于花材与花器，开始构筑你们的「花影瑶庭」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870127,
					"content": "为了额外的奖品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870118,
					"content": "派蒙习惯大开大合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870106,
					"content": "重点错了啦，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				}
			]
		},
		{
			"id": 7268705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268702",
							"2"
						],
						"stepId": 7268702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "接下来的几天，我会一直守候在这里，引导容彩祭的客人们，让他们感受「花影瑶庭」的精妙之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870202,
					"content": "两位也别忘了每天揭晓一道的「花题」哦，一共有四道「花题」等着你们作答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870203,
					"content": "当然，要是两位还有其他问题，我也会尽力为你们解答的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870204,
					"content": "关于这里的花卉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有着难以挑剔的品质和亲民的价格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870206,
					"content": "也许你们已经见过咲耶了，我们曾在同一位老师门下学习「插花」的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870207,
					"content": "咲耶对于花艺的理解也可圈可点，但是听说容彩祭的客人络绎不绝时，她似乎有些怯场，认为在这种环境里难以静下心来插花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870208,
					"content": "所以，我也会向其他客人宣传她的「咲耶花屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870209,
					"content": "有机会的话，我们也可以帮忙哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870219,
					"content": "那么，还有什么问题吗，两位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870220,
					"content": "谢谢你，柴染小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "不用客气。如果你们有空，随时都可以来找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870210,
					"content": "关于社奉行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "社奉行一直支持着稻妻的花艺事业。准确来说，为这次活动出资的贵人，是那位白鹭公主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870212,
					"content": "白鹭公主自小就表现出惊人的花艺天赋。我曾看过她的「插花」表演，有幸与她交流过心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870213,
					"content": "虽说我比她年长，但论插花的技巧和对花艺的理解，完全没法与她相提并论呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870214,
					"content": "在条件允许的情况下，白鹭公主每年都会提供资金，推广「插花」这门艺术。听说有时她还会用掉自己的积蓄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870215,
					"content": "白鹭公主曾坦率表达过自己的愿望——她想让更多人了解「插花」，对花艺产生兴趣，进而沉下心来修习这门学问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870216,
					"content": "原来绫华为稻妻的花艺付出过这么多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726870217,
					"content": "希望她的愿望能实现。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "感谢两位，你们真是善解人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726870222,
					"content": "暂时没有问题了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "如果你们有空，随时都可以来找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				}
			]
		}
	]
}