				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "浪漫的红气球！真漂亮…我心爱的尤普依一定会喜欢的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710302,
					"content": "你说是吧？朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710303,
					"content": "呃…我不好说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "不论如何，非常感谢你，朋友，请别离开，我想让尤普依也认识你一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710306,
					"content": "算算时间，她马上就会过来了，我们约好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710304,
					"content": "当然，她一定会被你打动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
