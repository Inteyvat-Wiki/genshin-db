			"dialogs": [
				{
					"id": 752710601,
					"content": "尤普依！你来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710602,
					"content": "斯奇…？是你？你怎么穿成这个样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710603,
					"content": "这是你最喜欢的娜娜丝梨人…我去租来的，帅吗？还有这些气球，也是我专门准备的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710604,
					"content": "其实我有一句话，很早就想跟你说了…和我交往吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710605,
					"content": "你…你有病吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710606,
					"content": "不！我心爱的姑娘，尤普依，请和我交往吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710607,
					"content": "你真的不是脑子坏了吗？今天是我们结婚三周年啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710608,
					"content": "我当然记得！但…你一直说我不懂浪漫，结婚前连一次正经的告白都没有…所以…这就是我迟到的告白！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710609,
					"content": "哈…明白了，我同意了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710610,
					"content": "欸？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710611,
					"content": "我说我同意啦，我浪漫的小男子汉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "尤普依"
				},
				{
					"id": 752710612,
					"content": "悠悠的风儿吹过，将两人拥抱在了一起。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
