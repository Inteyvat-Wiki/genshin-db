			"dialogs": [
				{
					"id": 752710101,
					"content": "请不要弄坏了这些气球。如果你想玩气球，我可以送你一些别的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710102,
					"content": "这些气球还挺特别的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "说起来还有点不好意思，这是重要的道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710104,
					"content": "看它的样子，你应该也猜到是用来干什么的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710105,
					"content": "求婚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "是告白啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710109,
					"content": "我会在浪漫的气球中间向我心爱的尤普依表露心意，你觉得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710110,
					"content": "应该用红色的气球。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "欸？你说得有道理…我果然还是缺乏了一点浪漫精神吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710112,
					"content": "可尤普依马上就要来了，这时候去哪里找红气球啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯奇"
				},
				{
					"id": 752710107,
					"content": "告白？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "没…没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "斯奇"
				}
			]
		},
		{
