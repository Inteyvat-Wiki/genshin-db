			"trigger": {
				"objectNames": [
					"乌尔曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726510101,
					"content": "唉，难道我真是什么「吸引仙灵体质」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510102
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510102,
					"content": "你…旅行者？你怎么也在这？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510103,
						726510106
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510103,
					"content": "你是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510104
					]
				},
				{
					"id": 726510104,
					"content": "我啊！乌尔曼，我俩不是还合作寻过宝吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510105
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510105,
					"content": "哎呀，「寻宝仙灵」！记起来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510108,
					"content": "你怎么来稻妻了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510109
					]
				},
				{
					"id": 726510109,
					"content": "咳…上次我俩合作的时候，你不是帮我找到了那么多铁钱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510110
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510110,
					"content": "我把那些铁钱倒腾了倒腾，赚了不少摩拉，嘿嘿，还是得多谢你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510111
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510111,
					"content": "不过你也知道，这年头花钱的地方多，那么些摩拉也不经花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510112
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510112,
					"content": "但我没了「寻宝仙灵」，也没你帮忙，铁钱肯定是没法找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510113
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510113,
					"content": "所以，我就想要找另外的方法赚钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510114
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510114,
					"content": "我听某位…呃…前同事说，稻妻这边遍地宝藏，就想要来碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510115
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510115,
					"content": "你知道稻妻锁着国的吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510116
					]
				},
				{
					"id": 726510116,
					"content": "那我当然知道，但是嘛…嘿嘿，我有自己的门路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510117
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510117,
					"content": "我和我的某些「好朋友」友好沟通，并且付出了一点点小代价之后，弄到了一艘船，准备开船来稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510118
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510118,
					"content": "但是，唉…但是我越接近稻妻，天气就越怪，又是打雷，又是风暴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510119
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510119,
					"content": "然后，突然一道雷正巧劈在我的船上，船毁了，我也掉进了海里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510120
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510120,
					"content": "几个浪头拍过来，我喝了好几口水，人也晕了过去，再醒来的时候，就在海滩上趴着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510121
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510121,
					"content": "你运气可真好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510122
					]
				},
				{
					"id": 726510122,
					"content": "哈哈哈，那可不，我运气一向不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510123
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510123,
					"content": "而且…呃…怎么说呢，我上岸之后四处打探了一下，结果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510124
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510124,
					"content": "结果又遇见了这个小家伙，它还带着我找到了几处宝藏，我想，也许它也是那种「寻宝仙灵」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510125
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510125,
					"content": "而且，它也和之前的那家伙一样，寻了几处宝藏之后就歇了，只是一直跟在我身边转来转去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510126
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510126,
					"content": "又是这种仙灵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510127
					]
				},
				{
					"id": 726510127,
					"content": "我也不知道为什么，难道我是什么「吸引仙灵体质」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510128
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510128,
					"content": "或者说，是我身上有什么特别的东西吸引它？我是弄不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510129
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510129,
					"content": "但总之，既然来了稻妻，那我可不能白来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510130
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510130,
					"content": "根据我的打探，周围还颇有些宝藏，我都记在我的这个手册上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510131
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510131,
					"content": "但这小家伙似乎又提不起干劲了，就凭我找这些宝藏可是有点费劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510132
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510132,
					"content": "旅行者，如果你有兴趣的话，那就再和我合作合作吧，你的那个「寻宝仙灵」，应该还愿意干活吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510133
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510133,
					"content": "还是上次的规矩，宝藏点我给你标好，你帮我去找到这些宝藏，里面的宝贝都归你，我分文不取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510134
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510134,
					"content": "但如果你找到了「铁钱」的话，就带来给我吧，嘿嘿，我会出个好价钱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510135
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510135,
					"content": "希望真是个好价钱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510136
					]
				},
				{
					"id": 726510136,
					"content": "那当然了，你和我都合作过了，就放心相信我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510137
					],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510137,
					"content": "这本手册给你，祝你寻宝愉快，也祝咱们合作愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌尔曼"
				},
				{
					"id": 726510106,
					"content": "你是那个「寻宝仙灵」的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510107
					]
				},
				{
					"id": 726510107,
					"content": "对，就是我，乌尔曼。我俩不是还合作寻过宝吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "乌尔曼"
				}
			]
		},
