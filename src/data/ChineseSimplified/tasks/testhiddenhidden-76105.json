					"玛尔塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#大哥哥}{F#大姐姐}，你看到那些岩居蟹了吗？好像在进行什么神秘的仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "玛尔塔"
				},
				{
					"id": 761050102,
					"content": "这就是它们的生态吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "是这样吗？哦…我好像懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "玛尔塔"
				},
				{
					"id": 761050104,
					"content": "那夏镇也有很多人跟这些岩居蟹一样，有的会勾肩搭背走在一起，有的一见面就拳脚问候然后分开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "玛尔塔"
				},
				{
					"id": 761050105,
					"content": "这就是那夏镇的生态吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "玛尔塔"
				},
				{
					"id": 761050106,
					"content": "没错，你理解得很快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#那{M#大哥哥}{F#大姐姐}，你能让这些岩居蟹都进到小水潭里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "玛尔塔"
				},
				{
					"id": 761050109,
					"content": "唔…就像把所有的宝藏猎人都喊去「旗舰」？感觉会很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "玛尔塔"
				},
				{
					"id": 761051501,
					"content": "#好想看看岩居蟹都聚在一起的时候会发生什么…{M#大哥哥}{F#大姐姐}，你现在有空吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛尔塔"
				},
				{
					"id": 761050107,
					"content": "好像有点微妙的区别，不过算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
