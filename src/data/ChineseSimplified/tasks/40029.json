					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290101,
					"content": "阿贝多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290102,
					"content": "旅行者，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290103
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290103,
					"content": "看来你们已经想好故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290104
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290104,
					"content": "对呀对呀，你呢？需要再给你一些时间吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290105,
					"content": "不用。我也想好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290106
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290106,
					"content": "先来后到，我要先说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290107,
					"content": "好啊，请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290108
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290108,
					"content": "我开始了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290109,
					"content": "从前有一个邪恶的学者，抓着山上的骗骗花进行改造，这些骗骗花带着痛苦变成了人的样子，站在山路旁等着过往行人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290110,
					"content": "只要有人理，他们就会问对方一些问题，例如：我是谁？你是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290111,
					"content": "如果回答错误…就会哇的一声被吃掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290112,
					"content": "嗯，真可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290113
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290113,
					"content": "派蒙好可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290114
					]
				},
				{
					"id": 400290114,
					"content": "什么呀，你们完全没被吓到嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290115,
					"content": "可能是我太坚强了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290116
					]
				},
				{
					"id": 400290116,
					"content": "不许挑我的毛病啦！你要是不满意就自己想一个嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290117,
					"content": "那么，加入恐怖要素…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290118,
						400290119
					]
				},
				{
					"id": 400290118,
					"content": "骗骗花吃了人之后…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				},
				{
					"id": 400290120,
					"content": "也就是说，身为凶手的骗骗花完全取代了被害者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290121
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290121,
					"content": "而且还要利用这个身份。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290122
					]
				},
				{
					"id": 400290122,
					"content": "那接下来骗骗花就要进城了吧？！变成普通人的样子回到家里，把他们的家人统统吃掉…呜哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290123,
					"content": "明明是我开的头，我却觉得好可怕呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290124,
					"content": "不错的故事呢。我能记下来吗？下次跟人聊天也许会用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290125
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290125,
					"content": "你是想拿去吓唬人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290126,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290127
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290127,
					"content": "这人好坏啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290128,
					"content": "那你编了什么故事呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290129
					]
				},
				{
					"id": 400290129,
					"content": "我的故事比你的故事要长一些。最早，要从一个炼金术士说起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290130
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290130,
					"content": "伟大的炼金术士创造了一号。一号带着她的骄傲，完美地融入了普通人。谁也不会想到，身边这个朋友竟然是人造人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290131
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290131,
					"content": "然而，一号并不知道，在他诞生前，炼金术师还进行过许多次试验。有些失败的残次品遭到遗弃，可他并未死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290132
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290132,
					"content": "失败品二号被巨龙吞入腹中，跟随龙一起留在了雪山上，直到许多年后，他因为某种神秘的龙之力苏醒过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290133
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290133,
					"content": "他看见雪山上各式各样的人，以及那个…神奇地融入了他们的一号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290134
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290134,
					"content": "二号从未想过，他们这些试验品居然能完美骗过所有人的眼睛。人们接纳一号为朋友，亲切地称呼他的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290135
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290135,
					"content": "而那正是二号想要的。所以，二号想要替代一号，成为那个幸福的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290136
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290136,
					"content": "呜…我、我突然觉得好冷，好吓人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290137,
					"content": "二号展开了他的计划。他偷来一号的书本与笔记，研究一号那些继承自炼金术士的学识。他很聪明，学得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290138
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290138,
					"content": "随后，他改变了自己原本那张脸，变成与一号完全一样的面孔。又找到一株能够拟态的雪山植物，使用龙血和炼金术改造它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290139
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290139,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290140
					]
				},
				{
					"id": 400290140,
					"content": "二号将自己变成与一号完全相同的模样，又制造出了第三个个体：三号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290141
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290141,
					"content": "哎？！三个？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290142,
					"content": "但不同的是，二号想要成为真正的完美之人。于是，他抹去了自己和三号脖子上象征瑕疵的印记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290143
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290143,
					"content": "故意…抹去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290144
					]
				},
				{
					"id": 400290144,
					"content": "要我说的话，抹去印记可能只是下意识所为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290145
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290145,
					"content": "他太过渴望成为完美之人，以至于忘记了，人类本就因不完美而生动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290146
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290146,
					"content": "二号的计划非常周密，三号负责吸引注意力，等一号处理掉三号之后，认为威胁已经消失的一号必然会陷入松懈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290147
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290147,
					"content": "一号落单的时刻，就是二号动手的最佳时机。除掉一号，他就能成为唯一的那个个体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290148
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290148,
					"content": "他会神不知鬼不觉地替换掉所有人记忆中的一号，继承一号的身份、住所、衣物、宝剑、名字和朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290149
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290149,
					"content": "而人们并不知道，他们昨天与今天见到的竟然是两个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290150
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290150,
					"content": "好吓人，好吓人啊…我再也不要相信别人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290151,
					"content": "但就在二号实施计划之前，有个特别的陌生人出现了。二号尝试与他接触，却发现他能隐约感觉出自己和一号有所不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290152
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290152,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290153,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290154
					]
				},
				{
					"id": 400290154,
					"content": "怎么？被吓到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290155
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290155,
					"content": "后来呢？那个陌生人怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290156,
					"content": "当然是被二号列为了计划中的一环。对二号来说，必须除掉的人又多了一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290157
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290157,
					"content": "就像是院子里的三株玫瑰，外观完全一样。三株中只有一株是不带毒刺的优质品，剩下两株都是长有毒刺的劣等品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290158
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290158,
					"content": "而在这世界上，只有照顾它们的园丁能够分辨出哪一株才是优质品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290159
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290159,
					"content": "人们不喜欢带毒的植物，唯有完美的玫瑰可以卖出高价。劣等品想要掩盖自己不值钱的事实，就要用毒刺除掉园丁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290160
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290160,
					"content": "二号也是这样想的。所以他躲在暗处耐心地等待。也许再过一会儿，他的机会就要来了。他会成为真正的「人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290161
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290161,
					"content": "（这不只是故事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290162
					]
				},
				{
					"id": 400290162,
					"content": "（这是真实存在于过去的事。阿贝多想告诉我的，就是这些残酷又不可思议的真相。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290163
					]
				},
				{
					"id": 400290163,
					"content": "好压抑的故事啊，后来怎么样？二号成功了吗？我都不敢想了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290164,
					"content": "幸好故事只是故事，不会成真，二号在这个故事里也没能取得成功。但在雪山，你们不能放松警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290165
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290165,
					"content": "用杜林的力量和血肉变异而成的怪物，也能算是莱茵多特的造物，跟我没什么不同。你们要小心这类生物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290166
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290166,
					"content": "不是这样的！你是我的朋友，不是怪物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290167
					]
				},
				{
					"id": 400290167,
					"content": "很高兴听到你这么说。没关系，我知道自己的来历。你我同为异类，在你面前我无需掩饰真实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290168
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290168,
					"content": "只不过有时想到炼金术是如此伟大的学问，会有些无奈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290169
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290169,
					"content": "作为踏足大地的生命之一，渴望掌握命运，渴求创造的我们究竟有多傲慢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290170
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290170,
					"content": "旅行者，创造是傲慢的行径吗？如果不是，那我们为何称呼掌控我们、创造我们的事物为「神」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290171
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290171,
					"content": "如果是，那我们又有何资格去自居「创造者」这一身份呢。我们的敬畏和尊重，究竟要做到哪一步，要用到何处？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290172
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290172,
					"content": "处置冒牌货的时候，你是什么感觉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290173
					]
				},
				{
					"id": 400290173,
					"content": "没什么特别的感觉。不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290174
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290174,
					"content": "…偶尔想起这件事，会感到一丝悲哀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290175
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290175,
					"content": "阿贝多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290176,
					"content": "喂——！旅行者！你在这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290177
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290177,
					"content": "咦，安柏的声音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290178
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290178,
					"content": "果然在这里啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290179
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290179,
					"content": "旅行者，我们是来替塞琉斯先生传话的，山脚营地那边有重要的事，你也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290180
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290180,
					"content": "冬令营接近尾声，就算是挂名教官也得就位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290181
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290181,
					"content": "我们得走了，阿贝多，先再见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290182
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290182,
					"content": "去忙吧。我这里还有些事，就不陪各位下山了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290183
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290183,
					"content": "没关系没关系，最近上下山都很顺利哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290184
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290184,
					"content": "准备好就出发吧，别让营地那边久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290119,
					"content": "就会变成那个人的样子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				}
			]
		},
		{
			"id": 4002902,
			"completionStepIds": [
				4002904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002904",
							"2"
						],
						"stepId": 4002904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塞琉斯",
					"乔尔",
					"冒失的帕拉德",
					"乔瑟夫",
					"班尼特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290201,
					"content": "咦？这个人是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290202,
						400290203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290202,
					"content": "难道是乔尔的父亲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				},
				{
					"id": 400290204,
					"content": "我来介绍一下，这位是乔瑟夫，是乔尔的父亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290205
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290205,
					"content": "爸爸！这位就是我和你说的旅行者，之前帮过我好多好多忙，这次还陪我一起堆雪人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290206
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290206,
					"content": "乔尔都和我说了，哎呀，真是太感谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290207,
						400290208
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290207,
					"content": "团圆就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290209,
					"content": "是啊，这真是天大的好事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290210,
					"content": "等等，塞琉斯会长怎么在偷偷抹眼泪，帕拉德怎么也在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290211,
					"content": "这次帕拉德可是大功臣哦！帕拉德，你还是自己说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290212
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290212,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290213
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290213,
					"content": "我记得那时天气不错，我预感自己将要有好运气，就坚信着自己的理念，往危险的地方去，因为越危险的地方越有宝藏嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290214
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290214,
					"content": "怎么听开头就感觉不靠谱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290215,
					"content": "可我才稍微离队行动了一小会儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290216
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290216,
					"content": "不小心就失足从山坡上滚了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290217
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290217,
					"content": "呜哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290218
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290218,
					"content": "（该不会是因为和我在山上见了一面，就被我的倒霉传染了吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290219
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290219,
					"content": "我无意中摔在一个平时不太走到的地方…还受了点轻伤，正在感慨自己运气差到了极点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290220
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290220,
					"content": "（呃…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290221
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290221,
					"content": "然后，我就遇到了听见声音跑出来看的乔瑟夫先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290222
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290222,
					"content": "哎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290223
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290223,
					"content": "哇，简直是误打误撞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290224,
					"content": "我当时以为他是冒险家协会的人，也是来参加活动的。聊了几句才发现，好多事情他都记不得了，连自己的名字都不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290225
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290225,
					"content": "我哪来得及想这些来龙去脉啊，雪山上太冷了，我赶紧催他跟我一起翻山回营地，有什么事等回来再说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290226
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290226,
					"content": "回到营地，我们见到了乔尔，乔尔一见到他就愣住了，跟着大叫起来：「爸爸！」他就是在这个时候突然回忆起一些事情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290227
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290227,
					"content": "直到现在我的记忆都还没有完全恢复，但乔尔和他的妈妈…唯独他们，我不会…不，是不能忘记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290228
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290228,
					"content": "爸爸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290229
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290229,
					"content": "乔尔，爸爸在，爸爸在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290230
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290230,
					"content": "乔瑟夫先生，真的想不起其他事情了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290231,
					"content": "《野猪公主》、还有雪山上你喂过的狐狸们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290232,
					"content": "很抱歉，我没有印象了。或许是因为脑袋受了外伤？我也不清楚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290233
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290233,
					"content": "当我醒来的时候，身上全是血。就连行李也丢了，没有能够证明身份的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290234
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290234,
					"content": "我只能爬进一个山洞，安顿下来慢慢养伤，在腿脚恢复点之后，靠打猎的本能才活了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290235
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290235,
					"content": "爸爸…我真的好担心你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290236
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290236,
					"content": "没事没事，乔尔不哭，爸爸这次哪里也不去了，就陪在你身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290237
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290237,
					"content": "呜…太好了，太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290238
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290238,
					"content": "这样就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290239
					]
				},
				{
					"id": 400290239,
					"content": "说起来，我就是从在山上遇到班尼特之后才变得比之前更倒霉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290240
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290240,
					"content": "我就知道！唉…我…我真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290241
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290241,
					"content": "不不，我是想说，要不是因为这样，我根本就不可能在这么大的雪山里遇到乔瑟夫先生啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290242
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290242,
					"content": "再说，我们不都安全回来了吗？所以你也别自责，运气这种事，差到极点说不定就会引发奇迹呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290243
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290243,
					"content": "…帕拉德…嘿嘿，你这家伙，什么时候变得这么会说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290244
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290244,
					"content": "啊？是吗？实、实话而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290245
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290245,
					"content": "#啊，对了，我要谢谢旅行者{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，还有塞琉斯叔叔、优菈姐姐和安柏姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290246
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290246,
					"content": "大家都很照顾我，我非常珍惜这一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290247
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290247,
					"content": "不过，雪人离开雪山就会融化了吧。没有办法一起带走，好可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290248
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290248,
					"content": "…这我倒是有办法，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290249
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290249,
					"content": "欸？优菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290250,
					"content": "…好了。乔尔，收下这个。这是坚冰的粉末，只需要加在你的雪人里，它就永远都不会融化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290251
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290251,
					"content": "哇！是真的吗？太厉害了！优菈姐姐太厉害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290252
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290252,
					"content": "爸爸，我有不会融化的雪人了！太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290253
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290253,
					"content": "我实在是不知道要如何感谢各位了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290254,
						400290255
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290254,
					"content": "别客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290256,
					"content": "谢谢各位，谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290257
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290257,
					"content": "爸爸，我们一起去搬雪人，现在就去好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290258
					],
					"speakerTitle": "乔尔"
				},
				{
					"id": 400290258,
					"content": "行，那各位，我就先陪乔尔去玩了，我们改天见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290259
					],
					"speakerTitle": "乔瑟夫"
				},
				{
					"id": 400290259,
					"content": "好，好…我和帕拉德，也该再去谈一谈冒险过程中的纪律问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290260
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400290260,
					"content": "欸？塞、塞琉斯会长…我这算是将功补过，将功补过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290261
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290261,
					"content": "大家慢走——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290262,
					"content": "对了，我也做了这个给你和安柏，拿着吧，就当是冬天的纪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290263
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290263,
					"content": "真的可以吗？对优菈来说，这是很重要的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290264
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290264,
					"content": "你这家伙，这种时候就不要说那么多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290265
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290265,
					"content": "#哇，这下我们的雪人也不会融化了吧。太好了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290266,
						400290267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290266,
					"content": "谢谢你，优菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290268,
					"content": "…你好好收着就行，不用客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290269
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290269,
					"content": "那么，我和安柏还有事要处理，先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290270
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 400290270,
					"content": "嗯！回头见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290271
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290271,
					"content": "她们走啦，总觉得最近大家都有自己的事要做呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290272
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290272,
					"content": "啊！说起来，我们在雪山呆了那么久，却还是忘了找阿贝多帮忙做那个把果子变成果汁保鲜的机器…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290273,
					"content": "要不然还是让蒂玛乌斯想办法吧，谁让他看起来最好说话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290267,
					"content": "我会好好珍惜的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290255,
					"content": "大家都在为你们高兴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290208,
					"content": "没事就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290203,
					"content": "大号的乔尔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				}
			]
		},
		{
			"id": 4002903,
