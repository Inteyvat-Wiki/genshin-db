			},
			"dialogs": [
				{
					"id": 400290301,
					"content": "蒂玛乌斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290302,
					"content": "是旅行者和派蒙啊。有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290303
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400290303,
					"content": "等等…看你这有所图谋的表情，该不会还在想那个奇怪的要求吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290304
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400290304,
					"content": "蒂玛乌斯，你会帮我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290305,
						400290306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290305,
					"content": "是你，不是我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290307
					]
				},
				{
					"id": 400290307,
					"content": "旅行者说不用，那就不用了吧…毕竟，这个要求怎么听都很奇怪啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290308
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400290308,
					"content": "不行不行，没有这个我的日落果就浪费了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290309,
					"content": "可我研究这种东西的时间都够帮你采十次果子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290310
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400290310,
					"content": "研究哪种东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290311
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290311,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290312
					]
				},
				{
					"id": 400290312,
					"content": "又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290313
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290313,
					"content": "阿贝多先生！来得正好，是这样的，派蒙想要一个能把果子变成果汁，同时又能为水果保鲜的机器，这也太…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290314
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400290314,
					"content": "很重要！如果能发明这种东西的话，我们就再也不用担心水果腐烂啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290315,
					"content": "不可能啊！…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290316,
						400290317
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400290316,
					"content": "（……？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290318
					]
				},
				{
					"id": 400290318,
					"content": "把果子变成果汁不难，保鲜比较难办。如果只是希望水果不腐烂，倒是有不少办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290319
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290319,
					"content": "对吧，旅行者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290320
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290320,
					"content": "（？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290321
					]
				},
				{
					"id": 400290321,
					"content": "你的脖子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290322
					]
				},
				{
					"id": 400290322,
					"content": "（印记又出现了…是恶作剧？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290323
					]
				},
				{
					"id": 400290323,
					"content": "脖子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290324,
					"content": "怎么了？我脖子上有什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290325
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290325,
					"content": "…不，一切正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290326
					]
				},
				{
					"id": 400290326,
					"content": "看你的表情，还以为是我刚开了什么恶劣的玩笑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290327
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290327,
					"content": "（果然是恶作剧！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290328
					]
				},
				{
					"id": 400290328,
					"content": "阿贝多，你刚才说的防止水果腐烂的办法都有哪些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290329,
					"content": "比如说，把水果埋到雪山上终年不化的雪堆里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290330
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290330,
					"content": "那不就吃不到了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290331,
					"content": "你可以住在雪山上啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290332
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290332,
					"content": "不了不了，我怕冷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290333,
					"content": "或者把那些果实交给我，我帮你带去雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290334
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290334,
					"content": "不过你怕冷，那就要派其他人来取果子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290335
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290335,
					"content": "这份差事非你莫属啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290336
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290336,
					"content": "如果是别人去跑腿，听起来可行度很高呢…要不就这么办吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290337,
					"content": "果实埋在雪山，保质期是变长了，相对地，发芽长成果树的可能性也不是没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290338
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290338,
					"content": "也许你下次来的时候，那些日落果已经变成果园了哦。你可以给那些树木浇水施肥，等它们结果，你就有新的日落果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290339
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290339,
					"content": "哎——？！不要啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290340,
					"content": "那样一来我们不就变成园丁了吗？本末倒置了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290341,
					"content": "是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290342
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290342,
					"content": "我倒是觉得，当个园丁，也不坏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290343
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290343,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290344
					]
				},
				{
					"id": 400290344,
					"content": "（园丁…呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290345
					]
				},
				{
					"id": 400290345,
					"content": "（不过，没想到阿贝多会跟我开这种玩笑。难道…他一点都不在乎那个印记所代表的意义吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290346
					]
				},
				{
					"id": 400290346,
					"content": "阿贝多！你干嘛老打我那些超甜日落果的主意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290347,
					"content": "哦？你很介意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290348
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290348,
					"content": "当然啦！那可是难得一见的超超超级甜甜日落果呀，不会分你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290349,
					"content": "嗯，只是日落果而已。应该是因为你手上没有多少同等级别的果实，才会对此感到介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290350
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290350,
					"content": "如果一个人把口袋装得满满的，他的心灵也得到充实，就不会轻易陷入这种情绪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290351
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 400290351,
					"content": "哎？是这样吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290352,
					"content": "（…原来如此，是这样啊。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400290317,
					"content": "（等等，他的脖子？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290318
					]
				},
				{
					"id": 400290306,
					"content": "我不是很想要那种东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290345
					]
				}
			]
