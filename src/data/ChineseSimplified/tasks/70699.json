			"dialogs": [
				{
					"id": 706990101,
					"content": "能请到荣誉骑士前辈试玩游艺项目，实在是太幸运了，感觉安心了不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990102,
					"content": "说实话，我还是第一次参与这种开发工作呢，有点紧张，感觉脑力常常不够用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990103,
					"content": "明明只是给一个成熟的机关装上外壳，却要顾及方方面面的设计，调试许多参数…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990104,
					"content": "要是像阿贝多长官那样，从零开始制作专用装备，不知道会遇见多少难题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990105,
					"content": "现在的成品已经很稳定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "呜啊…谢谢…谢谢荣誉骑士前辈的肯定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990108,
					"content": "我，我会加油的，争取以后能独自为游击小队开发出更多实用的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990109,
					"content": "之前我赢来了几只玩偶，这一只送给你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990110,
					"content": "我有一只一样的，以后，只要看到这个玩偶，我就能想起你给我的鼓励！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990106,
					"content": "相信自己，你会不断进步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
