						20140802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140802,
					"content": "啊…是你们啊。你们来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140803,
					"content": "等一下啊，我先站起来…奇怪，总觉得身体没什么力气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140804,
					"content": "哲平…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140807,
					"content": "哦哦，还没来得及跟你细说。我最近啊，又立了好几件功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140808,
					"content": "乘船与幕府军海战、一个人击退幕府武士、营救被围困的同伴，以前的我做梦都不敢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140809,
					"content": "如果我能再强一点就好了。再强一点，就能做到更多的事了…奇怪，我的「秘密武器」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140810,
					"content": "那东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "什么时候…大概是在你被封为剑鱼二番队队长不久之后，我遇到了资助方的神秘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140813,
					"content": "他们给了我这个。然后跟我说，只要想变强，这个秘密武器就会回应我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140814,
					"content": "哈哈，简直就像是「神之眼」一样吧？我没用过神之眼，也不知道有什么区别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140815,
					"content": "这是…邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "邪…眼？听上去是个不太好的东西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140817,
					"content": "和神之眼，有什么不一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140818,
					"content": "会透支使用者的生命。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140820,
					"content": "这样吗…确实，像这样来历不明的东西，有风险也很正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140821,
					"content": "最近这几天，我越来越疲倦，心里也隐约有一种不好的预感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140822,
					"content": "之前只是战斗后会更累一些，结果今天回来之后，我突然发现自己看不清东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140823,
					"content": "真是遗憾啊，本来还以为，要赶上你了…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140824,
					"content": "我果然，没在被神明注视着啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "哲平"
