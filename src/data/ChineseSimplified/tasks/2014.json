					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "应该就是这里了。不过，确实没看到什么可疑的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140202,
					"content": "#难道说是躲起来了吗？{NICKNAME}，我们在附近搜寻一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140203,
					"content": "这些<color=#00E1FFFF>雷元素方碑</color>，感觉有些可疑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "呼…终于搞定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140502,
					"content": "真是个难对付的家伙啊，不过这里为什么会有这么大一个丘丘雷兜王呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140503,
					"content": "想不明白…而且这里的气氛也有点古怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140504,
					"content": "总之，这里的事情应该已经搞定了，我们还是快跑吧…欸，哲平，你怎么也在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140505,
					"content": "咳咳…我也很惊讶，原来是你们在这里调查啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140506,
					"content": "我刚刚运完物资从前线回来，想要顺便清理一下附近的威胁。咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140507,
					"content": "没事吧，你看上去有点怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140508,
					"content": "没事没事，估计是前两天出海的时候冻着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140509,
					"content": "路过这里的时候，我听说有人不久前刚刚登岛调查，就想过来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140510,
					"content": "万一有什么危险，说不定我还可以当一回英雄…可惜遇到的是你们，看来我算是白来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140511,
					"content": "哲平，你有没有觉得这里的氛围有些特别？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140512,
					"content": "嗯…这么说的话，确实有一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140513,
					"content": "可能是因为这里靠近魔神奥罗巴斯的骸骨，祟神的气息比较浓郁吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140514,
					"content": "魔神奥罗巴斯，那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140515,
					"content": "你看，那个就是奥罗巴斯留下来的骸骨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140516,
					"content": "呜哇！这么大的蛇骨，看上去好吓人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140517,
					"content": "是奥罗巴斯把我们的祖先从渊下宫带到地面上，才有今天的海祇岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140518,
					"content": "我们的祖先一直视它为守护神，但魔神战争期间，奥罗巴斯入侵了八酝岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140519,
					"content": "雷电将军亲自赶来，以「无想的一刀」将其斩杀。那一刀，也形成了如今的「无想刃狭间」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140520,
					"content": "「无想刃狭间」，居然是被雷电将军砍出来的…好厉害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140521,
					"content": "是啊，不过魔神战争异常残酷，八酝岛在那场战役中化为废墟，据说将军也曾在那时失去了珍视的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140522,
					"content": "奥罗巴斯死后，海祇岛与幕府就多有不和。但这次成立反抗军，不是为了信仰，只是针对眼狩令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140523,
					"content": "奥罗巴斯毁灭文明，是将军站出来阻止了它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140524,
					"content": "如今将军颁布眼狩令，剥夺民众的愿望，也必须有人站出来阻止将军…咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140525,
					"content": "我先回去了，刚解决完幕府军的精锐武士，我回去休息一下，等会儿还有其他要做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140526,
					"content": "你们也赶紧向珊瑚宫大人汇报吧。这里说不定还有残留的祟神气息，长时间呆在这里，对身体不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140527,
					"content": "咳咳…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140528,
					"content": "你也注意身体。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "别担心，我的身体硬朗着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140531,
					"content": "没想到哲平已经能和幕府军的武士交战了，不知不觉他也成长了很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}，我们回去向<color=#00E1FFFF>心海</color>汇报吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140529,
					"content": "你也当心点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201406",
							"2"
						],
						"stepId": 201406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "心海，我们回…咦，五郎也在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140602,
					"content": "发生什么事了吗？他们的表情看上去好严肃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140603,
					"content": "出现这种异常情况的人，大概有多少？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20140604,
					"content": "还没来得及完全统计…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140605,
					"content": "心海，五郎，发生什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}，最近反抗军部分军士，出现了诡异的老化症状。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140607,
					"content": "我将他们叫来盘问，才知道他们私底下从资助方那里拿到了一些「秘密武器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140608,
					"content": "他们大多争强好胜，对眼狩令极为不满，拿到这些秘密武器后，一直在悄悄使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140609,
					"content": "难怪最近战局异常顺利…但这绝非正道，必须尽快禁止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20140610,
					"content": "五郎，你有拿到他们所谓的「秘密武器」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20140611,
					"content": "大部分持有秘密武器的人不肯交出，但我还是拿到了一枚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140612,
					"content": "这是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}，你知道这个东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20140614,
					"content": "愚人众的…邪眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "这么说，资助方的身份其实是愚人众？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20140616,
					"content": "可愚人众为什么要这么做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20140617,
					"content": "没时间细想了，现在最重要的是，尽快通知军队放弃使用邪眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20140618,
