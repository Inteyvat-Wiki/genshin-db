					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#{NICKNAME}，能拜托你件事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140827,
					"content": "等到我们的队服做好了，你帮我，把我那份也取回来…我们一起换上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140828,
