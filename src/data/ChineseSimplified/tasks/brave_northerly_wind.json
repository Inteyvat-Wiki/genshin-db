				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "瞧，又来了两位勇士！您是想要来挑战「北风吹流」的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740102,
					"content": "来吧，往这边走，我期待着您能飞得比谁都好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740103,
					"content": "你冷静点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "飞行不需要冷静，这位客人。绝对不需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740106,
					"content": "冷静只会让你对风的感受变迟钝，只有在毫无准备的情况下面对狂风，才能发掘出自己的潜能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740107,
					"content": "如今的飞鼠都太胆小了！完全遗忘了那篇《勇敢的北风》里的教诲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740108,
					"content": "光是站在安全的地方，赞叹着树叶随风起舞的勇气，自己却怯手怯脚，不敢亲自踏进风里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740109,
					"content": "这样下去，我们还怎么和公主殿下一起守护整个王国！真是无理！无理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740110,
					"content": "还真是一位有活力的飞鼠呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790740111,
					"content": "看来他确实很喜欢飞行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "所以，我就找到了几条吹流格外激烈的风道，并且在里面设置了各类机关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740113,
					"content": "只有最勇敢，最擅长飞行的勇士，才能通过这条风道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740114,
					"content": "二位客人，你们有这个勇气吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740115,
					"content": "想要试试看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "很好，请跟我来吧，风道就在不远处！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740117,
					"content": "那个…还有别的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "怎么？还要做准备吗？好吧，我就在此等待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740119,
					"content": "二位客人想要挑战风道的话，尽管来这里找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克朗谢"
				},
				{
					"id": 790740104,
					"content": "我还一句话都没说啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}