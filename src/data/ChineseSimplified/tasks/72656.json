				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "来、来试试「机关棋谭」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560102,
					"content": "这是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "喔…喔！欢迎光临！这是我刚从璃月那边代理到的新游戏，叫做「机关棋谭」哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560104,
					"content": "简单来说，就是一种能在桌子上玩的「游戏」啦。最开始是由璃月的瑞锦小姐发明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560105,
					"content": "我…怎么说呢，按照瑞锦小姐的说法，我是「海外代理」之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560111,
					"content": "在获得…呃…「代理权」之后，瑞锦小姐就把整套的「机关棋谭」，还有相关的营业建议寄了过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560112,
					"content": "虽然寄过来的时候被远国监司扣住了…我折腾了好久才把这套「机关棋谭」带回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560113,
					"content": "远国监司扣这个做什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "只要是国外来的东西，他们什么不扣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560115,
					"content": "算了，不说这个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560116,
					"content": "你看到桌子上的这些摆件了吗？这些都是「机关棋谭」里要用到的道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560117,
					"content": "是不是很有璃月的感觉？哈哈哈，这可都是我按照瑞锦小姐信里的描述托人专门做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560118,
					"content": "连桌子都专门拜托人做了一个差不多的…花了一大笔钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560119,
					"content": "而且在这副「机关棋谭」里，我还按照瑞锦小姐的建议，加入了一个全新的玩法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560120,
					"content": "唔…这么说你应该也不明白，你就直接先试玩一局吧，亲自玩过之后，应该就都能弄懂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560121,
					"content": "试玩「机关棋谭」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "没问题，好好玩吧，这可是全新的「机关棋谭」，绝不会让你失望的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560123,
					"content": "还有别的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "嗯，等你有空了再来试玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560106,
					"content": "怎么这里也有「机关棋谭」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "欢迎…咦？你知道「机关棋谭」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560108,
					"content": "啊…我知道了，你应该是在璃月那边玩过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560109,
					"content": "瑞锦小姐和我说过她在海灯节的时候做的推广工作…看来确实还挺有效的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "驹形"
				},
				{
					"id": 726560110,
					"content": "我…怎么说呢，按照瑞锦小姐的说法，我是这套「机关棋谭」在稻妻区域的「海外代理」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "驹形"
				}
			]
		}
	]
}