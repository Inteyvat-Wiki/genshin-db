			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "…结果还是这一天吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110102,
					"content": "看来果然没有我们想的那么简单。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "纳西妲，其实昨晚你就知道「花神诞日的轮回」还是会继续的吧？怎么不直接和我们说呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110104,
					"content": "说了又如何呢，你们只会在新的焦虑中度过昨晚，明天依旧不会到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110105,
					"content": "反倒不如…在短暂的希望中彻底放松一下自己，这是难得的机会呀，说不定可以让你们的思维变得更加清醒呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110106,
					"content": "倒也是…纳西妲还是为我们在考虑的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110107,
					"content": "当然，至少最近这段时间里，你们就是我的全部嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110108,
					"content": "唔…怎么突然说出这么肉麻的话呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110109,
					"content": "呵呵呵…我的意思是，虽然是我在拜托你们两个破解谜团，但反过来，也只有你们两个才能看到我、感受到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110110,
					"content": "换言之，如果不是有你们两个在的话，我就和「不存在」是没有区别的。所以你们就是我的全部，懂了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110111,
					"content": "纳西妲又在讲些让人摸不着头脑的话了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110112,
					"content": "闲聊就到这里吧，根据昨天的新线索，旅行者对「现状」有新的认识了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110113,
					"content": "「时间循环」的确是错误的结论。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "欸，为什么忽然否定了之前的想法呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110115,
					"content": "迪希雅的武艺在进步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "唔，是呀，之前好像没有留意这种地方，单纯的时间循环应该会完全重置身体状态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110118,
					"content": "那新的结论是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110116,
					"content": "迪娜泽黛病情恶化想必也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "…你们原来在这里，可算找到你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110202,
					"content": "今天的迪希雅果然也没有受伤呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110203,
					"content": "受伤？受什么伤？别太小瞧我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110204,
					"content": "你的新大剑毕竟不是那么趁手嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110205,
					"content": "其实我也觉得很奇怪，今天突然就变得趁手了起来…不对，你们怎么知道我换过大剑的事？我应该不可能透露过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110206,
					"content": "唔，这次还是你来解释吧，我实在已经解释腻了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110207,
					"content": "其实也没必要完全让迪希雅理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "这样啊，也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110210,
					"content": "你的大剑忽然变得趁手的原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "是我们连续度过了许多个花神诞日。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "…我不在的这会儿你们怎么了，是被什么奇奇怪怪的人传教了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110214,
					"content": "哎呀，别管那么多，你就当做是真的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110215,
					"content": "…好吧，我理解你们的意思。就是说我的身体记忆已经让我完全适应这把剑了，只是我的大脑不记得这件事了，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110216,
					"content": "没错，每天都会忘记一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110217,
					"content": "那我可反驳了哦？这种情况是绝对不可能的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110218,
					"content": "哦？说来听听？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110219,
					"content": "如果一连很多天都是花神诞祭，只是我们不记得的话，那所有的物资消耗，花掉的钱，吃掉的东西该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110220,
					"content": "按理说我的钱包早该空空如也了，不可能没发现的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110221,
					"content": "这一点我也想到过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "在幕后黑手是贤者的情况下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "的确…用虚空记录全城人每天的行为，再动用全城的资源去恢复到这一天的开始…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110225,
					"content": "虽说不太可能，但或许还是可以做到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110226,
					"content": "不可能不可能，我有证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110227,
					"content": "你有证据？在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110228,
					"content": "唉…你们对这种莫名其妙的讨论还真是认真啊，好吧好吧，就让我再陪你们一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110229,
					"content": "跟我来吧，还有迪娜泽黛小姐也请一起，目前还没法保证这附近的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110223,
					"content": "如果利用虚空的数据和全城的资源…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "只是每天晚上会被消除当天的记忆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "直接切入重点好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "就是这个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110302,
					"content": "这什么呀，你练剑的木人桩吗？这个怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110303,
					"content": "看到上面的痕迹了吗？是我这几天的积累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110304,
					"content": "假设贤者不会每天来把它换掉，它应该早就已经被砍的破破烂烂了对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110305,
					"content": "对呀，那每天都换一个的情况呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110306,
					"content": "那贤者每次都要在新的木人桩上复制出我之前练剑的剑痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110307,
					"content": "好歹我也是武者，在我的武学流派里，对「控制」的讲求非常精细。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110308,
					"content": "每一次挥剑，力度、角度、切入点都是用心控制过的，所以上面每一道伤痕我都记得，也记得挥出那一剑的心境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110309,
					"content": "正如有句话，武者之剑乃独一无二，没有人可以挥出完全相同的两剑。想要完全复制我的剑痕，绝对不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110310,
					"content": "不可能吗？如果是用什么精细的仪器一点点「雕刻」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110311,
					"content": "常有人说，留影机的画片永远不能替代画家画出来的风景画，因为前者是没有灵魂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110312,
					"content": "对我也一样，雕刻出的剑痕和作为武艺修炼结晶的剑痕…我一眼就能分辨得出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110313,
					"content": "…也有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "呼…这回应该没什么疑问了吧？欸，这是不是最近学者之间流行的叫做「头脑急转弯」的游戏？想不到还挺有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110316,
					"content": "那就这样吧，我看时候也不早了，我护送迪娜泽黛小姐去妮露那边了，回见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30110317,
					"content": "唉…又是一条走不通的路，「记忆删除」理论也是错误的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110318,
					"content": "但至少我们也有了一些阶段性的结论吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110319,
					"content": "时间并未循环。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "嗯，的确如此，那现在我们还能找到一些新的思路吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110322,
					"content": "让我想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "蹊跷？我觉得最近全是很蹊跷的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110325,
					"content": "我们…为何从没考虑过出城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "欸…？出城…对哦！这么容易想到的尝试，我们居然没试过。看看城外的时间是不是还卡在同一天，就能确定很多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110327,
					"content": "真是不可思议，是我们之前太钻牛角尖了呢，还是累得晕头转向了才想不到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110328,
					"content": "这真的很奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "要不我们还是回去问问纳西妲吧，关于出城的事，莫非是我们忘记了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110329,
					"content": "总觉得应该很早就想到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "我忽然感觉有件事很蹊跷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "我们不在现实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "看来只能放弃这种可能性了吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
