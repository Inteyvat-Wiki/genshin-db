			"dialogs": [
				{
					"id": 30111113,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30111101,
					"content": "时间没有在循环…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "对哦！每天晚上虚空的那个音效，说不定就是在删除我们当天的记忆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111104,
					"content": "所以一觉醒来，所有人都以为花神诞祭还没有度过，明明已经是「明天」了，但都还以为是「昨天」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111105,
					"content": "可身体记忆是删除不了的，所以迪希雅的新大剑才越用越熟练！这下就都说得通了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111106,
					"content": "…很巧妙的推论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30111107,
					"content": "那到底说对了没有呀，纳西妲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111108,
					"content": "简单来说的话，像是捉了火元素的晶蝶来当作萤火虫去照明，太过注重「感受」，而忽略了其「本质」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30111109,
					"content": "这一点都不简单…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111110,
					"content": "依旧是错误的结论吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "不妨你们再去找那位迪希雅小姐聊聊吧，会有新的收获也说不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30111112,
					"content": "嗯，毕竟新的线索是从她身上发现的…我们走吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30111102,
					"content": "而是我们的记忆每天都在被删除。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
