			"trigger": {
				"objectNames": [
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "纳西妲，我们回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110402,
					"content": "今天回来得很早呢，莫非是有了什么新的收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110403,
					"content": "算是有吧，我们基本确定了时间并未循环，这里也应该不是现实…可同时我们又有了新的疑惑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110404,
					"content": "出城的话会怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "出城…在我印象里，有两次你们都提及过出城相关的计划…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110407,
					"content": "！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "我们说过吗！我们怎么完全没有印象了，后来呢？我们回来之后怎么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110409,
					"content": "让我想想…好像你们从未提起过出城计划的结果如何，哦，不如说，那两次出城计划的当晚你们都没有回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110410,
					"content": "不过平时你们也有不少个晚上「夜不归宿」的，所以我当时也不觉得这能证明什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110411,
					"content": "确实有的时候会调查事情忘了时间，直接就到了第二天。可是你所说的出城当天的记忆，我们两个却都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110412,
					"content": "这样吗，这倒有些奇怪。理论上应该已经唤起了你们全部的记忆才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 30110413,
					"content": "明天再试一次吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "嗯！绝对有猫腻，明天一定要想办法查清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110416,
					"content": "「嘀——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30110414,
					"content": "或许突破口就在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "我们是不是真的没试过出城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
