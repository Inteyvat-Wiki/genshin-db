			"dialogs": [
				{
					"id": 766580101,
					"content": "你好啊，茜涅特，上次找回来的机器人也都调试好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766580102,
					"content": "嗯，多亏了你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766580103,
					"content": "说起来，我们确实有些新的发现呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766580104,
					"content": "真的？请讲给我听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766580105,
					"content": "你和派蒙向茜涅特讲述了不久前的见闻。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "你们描述的那种表现…这些机器人似乎很喜欢你们，并向你们发出了「一起玩耍」的邀请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766580107,
					"content": "真的？好有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766580108,
					"content": "嗯…果然是这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766580109,
					"content": "茜涅特，又发现什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766580110,
					"content": "我现在能确定了，我的创意要通过机器人之间的交互来实现，找回的机器人越多，就越接近最初的设想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766580111,
					"content": "现在它们已经拥有了和他人交流的能力，只要把剩下的机器人也找齐…我的创意还是行得通的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766580112,
					"content": "哇，兴奋起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766580113,
					"content": "啊，不好意思，说起来还是要仰仗你们，下一片区域也在地图上标好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766580114,
					"content": "那我们尽快出发吧，我开始好奇这些机器人最终会变成什么样子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
