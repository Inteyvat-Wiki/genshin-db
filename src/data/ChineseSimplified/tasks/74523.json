			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "这风中…带来了海潮的咸味，远方商船的木香，还有…故人的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 745230402,
					"content": "#{NICKNAME}，别来无恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 745230403,
					"content": "万叶，好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "「南十字」船队在稻妻停靠补给。难得故地重游，便想四处走走，多看一眼故乡的景色，多听一听这里的风声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 745230406,
					"content": "离岛的风，总是比别处更喧闹些，混杂着离别与重逢，希望与迷惘…是个能听到许多故事的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 745230407,
					"content": "能让我为你留影吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "呵呵，万物皆有其形，风亦然。只是风的形貌，只在叶落、浪起、或是旅人衣袂飘举的一瞬才得以窥见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 745230410,
					"content": "希望借由我的身影，能让你捕捉到那一瞬即逝的「风之形」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 745230411,
					"content": "那我要开始了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "那么，就请你来采集属于此刻的诗篇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 745230412,
					"content": "请像刚才那样，感受风就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "我也想记录此刻的风。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "你怎么会在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
