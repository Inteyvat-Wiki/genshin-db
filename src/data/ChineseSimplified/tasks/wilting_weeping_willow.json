						740831003
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831003,
					"content": "哇，珀西芙，你是怎么突然冒出来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740831004,
					"content": "无影踪，珀西芙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831005,
					"content": "好吧…你真是我见过的最特别的美露莘…对了，我印象中的美露莘，大多都生活在枫丹廷或者海沫村…你怎么会在这里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740831006,
					"content": "枫丹廷？海沫村？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831007,
					"content": "看你好像很疑惑的样子，你没听过这两个名字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740831008,
					"content": "枫丹廷，美露莘…海沫村，美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831009,
					"content": "啊…伊黎耶，珀西芙，家乡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831010,
					"content": "伊黎耶，珀西芙，守护！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831011,
					"content": "等等，你说这里是你的家乡？你在守护你的家乡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740831012,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831013,
					"content": "可是美露莘的家乡是海沫村吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "是啊，好奇怪，还有出生在别的地方的美露莘吗？可这里看起来也没有其他美露莘了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740831015,
					"content": "珀西芙，你都是一个人生活在这里的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740831016,
					"content": "一个人？美露莘。那位来客！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831017,
					"content": "那…那位来客？还有一位来客？哪位来客？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740831018,
					"content": "#那位来客！派蒙，派蒙，{NICKNAME}，{NICKNAME}，那位来客，那位来客！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
