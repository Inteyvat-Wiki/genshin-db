					"nextDialogs": [
						740831037
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831037,
					"content": "钥匙，钥匙，钥匙，广场，西。邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831038
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831038,
					"content": "我们会尽快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831039
					]
				},
				{
					"id": 740831039,
					"content": "#派蒙，珀西芙！{NICKNAME}，珀西芙！",
