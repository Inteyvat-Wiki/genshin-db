			"dialogs": [
				{
					"id": 740820701,
					"content": "一滴晶莹的水珠出现在了祭坛上。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "咦，这滴水珠…这滴水珠不会就是宝藏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830103,
					"content": "长得不太像宝藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "我也觉得…毕竟这么顺利就得到了…那它会是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830105,
					"content": "说不定是镇压魔王的关键物品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "说不定是别人存放在这里的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "什么？那我们岂不是闯大祸了，快！快把它放回去！希望还来得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830107,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830108,
					"content": "完蛋了！魔王出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830109,
					"content": "魔王？美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830111,
					"content": "什么？完蛋了，那我们不就成小偷了？对不起对不起…我们快把东西放回去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830112,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830113,
					"content": "完蛋了！主人回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830114,
					"content": "主人？美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830115,
					"content": "吓死我了…原来是一位美露莘…你怎么在这里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830116,
					"content": "钥匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830117,
					"content": "什么…什么钥匙？这滴水珠是钥匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830118,
					"content": "珀西芙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830119,
					"content": "呃…这滴水珠是珀西芙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830120,
					"content": "美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830121,
					"content": "哎呀！什么意思？这滴水珠是美露莘？我有点晕了，到底是什么啦，你不才是美露莘吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830122,
					"content": "珀西芙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830123,
					"content": "呃…你是珀西芙？还是你叫珀西芙？等等…我肯定会被你的答案弄得更晕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830124,
					"content": "我决定就叫你珀西芙了，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830125,
					"content": "美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}…怎么办？我完全搞不懂她的意思，她到底在说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830127,
					"content": "你能听懂我们的话，对吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "珀西芙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830129,
					"content": "这滴水珠是钥匙，对吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "珀西芙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830131,
					"content": "你不是人，对吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830133,
					"content": "呃…突然骂人不太好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830134,
					"content": "我不是人，对吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "美…美露莘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830136,
					"content": "啊！等等，我好像有点听出来了…「珀西芙」的意思是肯定，「美露莘」的意思是否定，难道是这个意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830137,
					"content": "珀西芙！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830138,
					"content": "原来你不是叫珀西芙…对不起，我搞错了你的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830139,
					"content": "珀西芙…喜欢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830140,
					"content": "你喜欢这个名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830142,
					"content": "#太好了！那就这么叫你了，嘿嘿。我是派蒙，这是{NICKNAME}，很高兴认识你，珀西芙，我还没见过你这样的美露莘呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830143,
					"content": "#派蒙，珀西芙！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830144,
					"content": "伊黎耶…美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830145,
					"content": "…伊黎耶否定？呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830146,
					"content": "伊黎耶岛不好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "伊黎耶，美露莘，现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830148,
					"content": "珀西芙，伊黎耶，保护…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830149,
					"content": "伊黎耶岛正在变得不好，然后，你要保护它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830150,
					"content": "#派蒙，{NICKNAME}，伊黎耶，邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830151,
					"content": "#呃…这次有五个词，呃…你希望派蒙和{NICKNAME}给伊黎耶岛邦邦邦邦来两下子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830152,
					"content": "美露莘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830153,
					"content": "你希望我们帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830155,
					"content": "原来是帮忙呀，幸好幸好，如果要让我们给这座岛来两下子，那真的挺难办的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830156,
					"content": "邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830157,
					"content": "有报酬吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "那要怎么帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "报…酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830159,
					"content": "#哎呀，{NICKNAME}，你看珀西芙都不太会说话，肯定找不到其他人帮忙了，我们就帮帮她吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830160,
					"content": "那要怎么帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "钥匙，钥匙，钥匙，数量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830163,
					"content": "然后呢？钥匙的数量是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830164,
					"content": "钥匙！钥匙！钥匙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830165,
					"content": "三把钥匙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "珀西芙！钥匙，雾道，南…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830167,
					"content": "钥匙，泉眼，北…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830168,
					"content": "钥匙，垂柳，东…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830169,
					"content": "哦，原来是这个意思…那我先记一下…一共有三把钥匙，分别是南边的雾道，北边的泉眼，东边的垂柳…是这样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830170,
					"content": "钥匙，钥匙，钥匙，广场，西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830171,
					"content": "西边的广场还有三把钥匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830172,
					"content": "集齐三把钥匙去广场？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#派蒙，美露莘！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830174,
					"content": "#哎呀，珀西芙，你不要老是说这种显得{NICKNAME}比我聪明的话嘛！明明我和{M#他}{F#她}差不多聪明才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830175,
					"content": "总而言之，现在我们已经得到一把钥匙了，看来只要再弄到另外两把就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830176,
					"content": "伊黎耶，美露莘…珀西芙，保护！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740830177,
					"content": "你放心啦，虽然不知道发生了什么，但我们会帮你保护伊黎耶岛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830178,
					"content": "不过我再补充一小点哦，珀西芙，假如你碰巧看见一种没人要的，金灿灿的，圆滚滚的东西，或者一看就很贵的箱子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740830179,
					"content": "能跟我们说一声就再好不过啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820780,
					"content": "珀西芙似懂非懂地摸了摸头，又高兴地蹦跳了两下，然后略显匆忙地离开了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#啊，她就直接跑掉了，看来是很紧急的事啊。{NICKNAME}，我们现在就去寻找另外两把钥匙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
