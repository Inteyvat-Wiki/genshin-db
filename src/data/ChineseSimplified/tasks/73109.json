			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"贾维"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "咦？应该就在这附近啊，怎么不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090102,
					"content": "你在找什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "你是…喔，应该是旅行者吧，我听人家提起过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090104,
					"content": "我叫贾维，是个…是个普通的售货员，我正在这里找我之前埋下去的一个「梦想盒」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090105,
					"content": "好奇怪的名字…这盒子里面装着什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731090106,
					"content": "嗯…非要说的话，应该是装着我小时候「期待实现的梦想」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090107,
					"content": "为什么要这么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "哈哈哈，这是我在很小的时候，和我的朋友们一起做的一种游戏啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090109,
					"content": "把自己最想要实现的那个梦想写下来，然后埋在这里。然后再约定一个时间，一起过来把这「梦想盒」挖出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090110,
					"content": "现在就是我们约定的时间啦。但是…看来只有我一个人还记得这件事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090111,
					"content": "唉，这件事他们忘了就忘了吧…只要别忘了自己的梦想就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090112,
					"content": "总之，我这次过来就是想把自己的盒子挖出来，也算是了结一桩心事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090113,
					"content": "但我找了一圈，却什么也没找到，不会被人给挖走了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090114,
					"content": "你那个时候做了标记吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "我记得，那个时候我是埋在一棵树旁边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090119,
					"content": "一棵树？这，这周围可是有好多树啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731090120,
					"content": "我小时候也没有注意过这种事啊，当时我们就在埋盒子的地方插了一个小牌子做标记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090121,
					"content": "过了这么长时间，那个牌子已经不见了，周围的树我也完全认不出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090122,
					"content": "我就隐约记得，埋盒子的地方就在这附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090123,
					"content": "旅行者，能请你帮我一起找找看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090124,
					"content": "怎么找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "我把那个盒子埋在了一棵树的旁边，所以…就先在树旁边挖挖看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090126,
					"content": "帮帮忙啦旅行者，我会支付给你报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090130,
					"content": "你看，这片树林这么大，我一个人可找不过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090131,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "嘿嘿，多谢你了，那我们就分头行动吧，我在这边，另外一边就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090127,
					"content": "反正梦想都飞走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "就是因为我的梦想飞走了，我才更要挖出来那个盒子，看看我当初希望实现的梦想啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090129,
					"content": "拜托你啦旅行者，就帮帮我吧，我会支付给你报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090115,
					"content": "梦想飞走了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "哈哈哈…我倒是不否认这件事，毕竟我现在都不记得我当初写下来的梦想了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090117,
					"content": "但就算我的梦想会飞走，那个盒子也不会飞走啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "贾维"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310903",
							"2"
						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"贾维"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "坏了，这个「梦想盒」不是我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090302,
					"content": "我们挖到了一个盒子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "哈哈…我也挖到了一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090305,
					"content": "我还把这个「梦想盒」打开了，盒子里的纸条上还署着阿米的名呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090306,
					"content": "我记得这孩子，她是贾汉吉尔的女儿，经常在那个食品店旁边待着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090307,
					"content": "这孩子的梦想是当一个花匠，要种很多花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090308,
					"content": "没看出来啊，我还以为贾汉吉尔要把她培养成自家店的接班人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090309,
					"content": "先看看你的梦想吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "喔！对对，得先看看我自己的梦想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090312,
					"content": "我看看啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090313,
					"content": "「希望成为『林行者』，一直住在树林里…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090314,
					"content": "我小时候的梦想居然是这个？真不知道我当时在想什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090315,
					"content": "唉…臭小子，林行者可不是一个能轻松赚钱的活啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090316,
					"content": "我觉得没什么不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "那是小孩子才能有的想法，到我这个年纪了，梦想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090320,
					"content": "倒不如想想怎么多赚几个摩拉，晚上睡觉的时候能睡得安稳些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090321,
					"content": "行了，别说我那个无聊的梦想了，还是看看阿米的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090322,
					"content": "我把她的「梦想盒」给拆了，要做点事给她赔罪才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090323,
					"content": "嗯…让我想想，既然她想做花匠，那首先就要学一学种花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090324,
					"content": "我那里正好有闲置的花盆，可以拿去给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090325,
					"content": "旅行者，你知道怎么弄到花的种子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090326,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "那种子的事情就拜托你了，旅行者，我们等会在贾汉吉尔的店旁边碰头吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090327,
					"content": "你为什么要这么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "哈哈哈…算是一时兴起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090329,
					"content": "我是不可能再去追逐梦想了，一方面是年纪不小了，另一方面…是我也不怎么在意这个梦想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090330,
					"content": "但阿米还小，她还能尝试实现自己的梦想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090331,
					"content": "我这个无聊的大人也没什么能帮她的，就送个花盆，算是为她加油打气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090317,
					"content": "梦想没有好坏之分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "这是你的「梦想盒」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "你也挖出来一个？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
