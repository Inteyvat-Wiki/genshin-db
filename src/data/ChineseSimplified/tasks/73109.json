			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿米",
					"贾维"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "这个…是给我的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090502,
					"content": "那个盒子我是随便埋下去的，里面的纸条也是我随便写的，叔叔看到了没什么关系，不用向我道歉的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090503,
					"content": "没事，这花盆反正放在我那里也没用，就送给你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090504,
					"content": "我还拜托人去找种子，应该马上就会过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090505,
					"content": "种子来了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "欸？你是什么时候来的，我都没注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090508,
					"content": "咳…阿米，你不是想要做花匠吗？你就先用这些东西开始种花吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090509,
					"content": "谢谢…但我如果在爸爸的店旁边养花的话，虫虫说不定就会飞进那个锅里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090510,
					"content": "掉进锅里的虫虫很可怜，吃到虫虫的大人也很可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090511,
					"content": "如果把花挪远的话，我又担心会忘记去照顾它，枯掉的花也很可怜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090512,
					"content": "而且爸爸平时很忙，也不让我一个人跑太远…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090513,
					"content": "嗯…如果你愿意的话，我和你一起照顾这盆花，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090514,
					"content": "虽然我每天只能下班的时候过来，但多少也有点空闲时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090515,
					"content": "好呀！但是爸爸也许不会答应…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090516,
					"content": "我和贾汉吉尔先生也算是认识了，等会我们一起去和他说说，他应该会答应的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090517,
					"content": "好！那…那我还要再种几盆花！我最喜欢须弥蔷薇了！将来…我要在爸爸的店旁边种满须弥蔷薇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090518,
					"content": "行啊，小丫头还挺有理想的，那我们两个就一起努力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090519,
					"content": "到时候记得分我一朵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#嗯！谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想想…我还要再种一盆甜甜花，然后再种什么好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090522,
					"content": "看来这孩子是真心喜欢种花啊，希望她能一直坚持自己的梦想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090523,
					"content": "嘿嘿…可别和我一样，变成这么一个普通又无聊的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090524,
					"content": "咳！旅行者，谢谢你帮忙，这些报酬给你，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090525,
					"content": "认真的生活并不普通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "谢谢你啊，我也不是在抱怨什么啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090528,
					"content": "只不过…今天看见我埋下去的「梦想」，稍微有点感慨而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090529,
					"content": "好了，我也差不多要回去了，今天多谢你帮忙了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090530,
					"content": "我要不要…重新写一份「梦想」，然后再埋回去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾维"
				},
				{
					"id": 731090526,
					"content": "认真的生活并不无聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "加油啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "这些花种给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
