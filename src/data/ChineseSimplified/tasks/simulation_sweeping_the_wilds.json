			},
			"dialogs": [
				{
					"id": 745040101,
					"content": "两位老爷，你们这么迫不及待就要开工啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040102
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040102,
					"content": "偷偷说哦，其实我倒是觉得，我们这次的企划没前途啦。有这个时间，还不如去勒波特钟表店玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040103
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040103,
					"content": "呜哇！这是心声吗？居然就这么说了出来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745040104,
					"content": "嘘，老爷小点声，别给其他人听见了，不然把我当成是那边派来的间谍就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040105
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040105,
					"content": "哎呀，这个话题我们还是点到为止比较好。毕竟我只是个打工的，现在还是来聊工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040106
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040106,
					"content": "我先说明，本次企划的数据收集分为两大部分，我和阿尔邦分别负责其中之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040107
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040107,
					"content": "我这部分的数据收集，是为了模拟决斗代理人的战斗力，所以需要老爷完成一些战斗的项目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040108
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040108,
					"content": "我们在野外寻找了一些魔物的聚集点，并在附近安置了数据记录装置，只需要两位老爷前去清理掉那些家伙就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040109
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040109,
					"content": "具体的位置我已经标注在老爷的地图上了，至于其他注意事项，这里有一份手册，两位老爷稍后可以看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040110
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040110,
					"content": "怎么样，还有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040111
					],
					"speakerTitle": "阿尔贝"
				},
				{
					"id": 745040111,
					"content": "没问题了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745040112
					]
				},
				{
					"id": 745040112,
					"content": "那就预祝老爷数据收集顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿尔贝"
				}
			]
		}
	]
}