			"dialogs": [
				{
					"id": 721050301,
					"content": "这就是「神樱大祓」最后的结界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050302
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050302,
					"content": "那么，如果二位已经准备妥当…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050303
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050303,
					"content": "等等！在那之前，我还有些问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050304,
					"content": "请您尽管问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050305
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050305,
					"content": "之前面具巫女小姐说，等时机合适，会将一切都和盘托出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050306,
					"content": "确实是这样。但如果可以的话，能否等到「神樱大祓」完成之后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050307
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050307,
					"content": "神樱一直在述说她的苦痛呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050308
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050308,
					"content": "尽管这么说，真的相当失礼…毕竟，二位已经付出了这么多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050309
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050309,
					"content": "真的非常抱歉，请您谅解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050310,
						721050311
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050310,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050312
					]
				},
				{
					"id": 721050312,
					"content": "哼，好吧。一定要信守诺言喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050313,
					"content": "呵呵，那是自然。谢谢二位的体恤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050314
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050314,
					"content": "那么，我要解除结界了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050315
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050315,
					"content": "「…东至鲸渊，西达烬海。南至炎光，北达弱水…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050316
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050316,
					"content": "「…千枝万脉，请除祸灾。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050311,
					"content": "我相信你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050312
					]
				}
			]
		},
		{
			"id": 7210504,
			"completionStepIds": [
				7210503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
