			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050501,
					"content": "关于净化之事，您有什么疑问吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050502,
						721050507,
						721050522
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050502,
					"content": "我要做什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050503
					]
				},
				{
					"id": 721050503,
					"content": "到达底部之后，您应当能见到被树根紧紧缠绕镇压的「瘤」。那是秽物积年积累的结核，想办法消灭它就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050504
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050504,
					"content": "它受到攻击时，必定会奋力挣扎，滋生妖物阻挠您的行动。但我相信，对您而言不会是什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050505
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050505,
					"content": "期间，也需要您如同解除此前的五处封印那般，使周边的机关运作，以此巩固神樱之根的压制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050506
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050506,
					"content": "如此一来，神樱就会配合您的行动，为您创造攻击的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050507,
					"content": "「瘤」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050508
					]
				},
				{
					"id": 721050508,
					"content": "简单来说，就是积累在土地中的秽物的集合体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050509,
						721050512
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050509,
					"content": "就像愚人众？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050510
					]
				},
				{
					"id": 721050510,
					"content": "鱼人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050511
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050511,
					"content": "如果说的是「人鱼」之事的话，我倒是略有耳闻呢。但人鱼不是秽物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050515
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050515,
					"content": "无论如何，在这片大地上总有伤病、苦痛、恶念。虽然难以想象，但战争或许有朝一日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050516
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050516,
					"content": "发生战争的话，那就会带来更多的伤病、苦痛与恶念。而这些事物带来的污秽就会积累，对大地造成伤害，一切事物都会恶化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050517
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050517,
					"content": "（看来她不知道…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050518
					]
				},
				{
					"id": 721050518,
					"content": "任由污秽积累的话…菑疠横行、凶将跋扈、百鬼跳梁…因为实在太过可怕，请您允许我按下不表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050519
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050519,
					"content": "为了清除这些「秽物」，以前也听说过，不同的地方有不同的做法。譬如说，璃月就有仙家、方士等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050520
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050520,
					"content": "为此，雷樱的根系施展「离秽」的力量，吸收污秽。而其中的部分污秽，会通过根系，汇聚在影向之底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050521
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050521,
					"content": "经年累月，就会结成那样的「瘤」。而清除这样的瘤，就是「神樱大祓」的目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050512,
					"content": "就像深渊教团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050513
					]
				},
				{
					"id": 721050513,
					"content": "深渊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050514
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050514,
					"content": "虽然对您所说的事物不甚了解，但恐怕那也是即为黑暗污秽之物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050515
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050522,
					"content": "那么，我走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050523
					]
				},
				{
					"id": 721050523,
					"content": "我明白了。如果关于净化之事，有任何想问的，还请您随时来问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050524
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050524,
					"content": "这就是最后的最后了。祝您一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				}
			]
		},
		{
			"id": 7210506,
			"completionStepIds": [
				7210506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210505",
							"3"
						],
						"stepId": 7210505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210506",
							"2"
						],
						"stepId": 7210506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050601,
					"content": "那么，一切都结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050602
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050602,
					"content": "这么一来，神樱承受的痛苦也终于消解了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050603
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050603,
					"content": "人之子…干得太漂亮了。您果真是「命定之人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050604
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050604,
					"content": "#呼，真是一场恶战！还好平时我有在锻炼{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050605,
						721050607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050605,
					"content": "谢谢，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050606
					]
				},
				{
					"id": 721050606,
					"content": "什么嘛，不用这么认真谢我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050608,
					"content": "至于在最初约定好的报酬，稍后我会留下来，请二位稍安勿躁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050609
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050609,
					"content": "等一等等一等！之前不是说好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050610,
					"content": "「神樱大祓」完成之后，面具巫女小姐你会将自己的事情告诉我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050611,
					"content": "但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050612,
						721050613,
						721050614
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050612,
					"content": "我也想知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050615,
					"content": "就是就是。要不然，也太对不起我们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050616,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050617
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050617,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050618
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050618,
					"content": "在那之前，有一事实在不胜惶恐。这么一路上，我尚未有机会正式请教二位的名讳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050619
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050619,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050620
					]
				},
				{
					"id": 721050620,
					"content": "我叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050621,
					"content": "#{NICKNAME}大人，派蒙大人…真是好名字呢。我会铭记于心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050622
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050622,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050623,
					"content": "如我先前所说，我确实继承了「狐斋宫」的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050624
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050624,
					"content": "这部分我很好奇呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050625,
					"content": "「狐斋宫」原本是白辰的血脉，曾与雷神同行，守护稻妻的子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050626
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050626,
					"content": "直到最终，在…我也无从得知多久之前的灾厄中，「狐斋宫」为了保护鸣神岛，而与漆黑的灾厄作战，最终被灾厄吞没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050627
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050627,
					"content": "但受她在各处布下的结界保护的人们有许多。虽然单纯继承了「记忆」的我实在不应有此僭越之意，但我也为这份记忆感到骄傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050628
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050628,
					"content": "你是她的眷属吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050629
					]
				},
				{
					"id": 721050629,
					"content": "像之前说的「天狐」、「地狐」那样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050630,
					"content": "这么说来，此前我的确察觉到山顶的鸣神大社有相似的仙狐气息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050631
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050631,
					"content": "但不是这样的。我并不是她的眷属，倒不如说与此相反…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050632
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050632,
					"content": "吞食她的灾厄最终被斩落，而她的思念与记忆也回到了鸣神岛的大地中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050633
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050633,
					"content": "您在施行「神樱大祓」的过程中，斩落了不少「落武者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050634
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050634,
					"content": "唔…是说那些，像幽灵一样的武士吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050635,
						721050636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050635,
					"content": "轻轻松松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050637
					]
				},
				{
					"id": 721050637,
					"content": "那些妖物是污秽凝聚而成的。而这些妖物的形态，通常都会由时代的思念、记忆左右。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050638
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050638,
					"content": "如果可以的话，希望二位能坦诚告诉我。如今的稻妻，难道说，笼罩在战火之中吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050639
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050639,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050640,
					"content": "#（…怎么办，{NICKNAME}？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050641,
						721050643
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050641,
					"content": "（老实说吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050642
					]
				},
				{
					"id": 721050642,
					"content": "好、好像确实是这样呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050644,
					"content": "这样啊。果真如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050645
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050645,
					"content": "当您告诉我，净化雷樱树根时，被逼出来的妖物是「落武者」时，我就隐隐察觉到了。只要她走在自己坚信的路途上就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050646
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050646,
					"content": "…言归正传。我…我「花散里」，是「狐斋宫」大人的记忆，凝聚而成的污秽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050647
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050647,
					"content": "怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050648,
						721050649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050648,
					"content": "我也隐约察觉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050650
					]
				},
				{
					"id": 721050650,
					"content": "此前无法与二位一同行动、战斗，真的非常抱歉。因为我本身即是污物，所以无法净化其余的邪秽妖物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050651
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050651,
					"content": "因为她的记忆非常强大，所以即使是漆黑的灾厄，也没能将其完全消解。灾厄被击败后，它本身作为炽烈的污秽，流入了大地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050652
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050652,
					"content": "于是，我诞生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050653
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050653,
					"content": "之前说，如果「狐斋宫」身边有我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050654
					]
				},
				{
					"id": 721050654,
					"content": "是的。是有这么一回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050655
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050655,
					"content": "如果「狐斋宫」的身边曾经有您这样的人，或许她就能活下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050656
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050656,
					"content": "倘若她有机会与您相识，那该是多么美好的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050657
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050657,
					"content": "但念及此，我又不禁自私地想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050658
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050658,
					"content": "「如果，如果真是那样，那我也不会以这种方式，继承她的记忆而诞生，并在最后与您相遇了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050659
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050659,
					"content": "通过「留念镜」看到的你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050660
					]
				},
				{
					"id": 721050660,
					"content": "没错，那是过去的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050661
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050661,
					"content": "一开始，我相当不知所措。但随着记忆复苏，我已经掌握了自己的生世，也明白自己的职责了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050662,
						721050663
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050662,
					"content": "也就是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050665
					]
				},
				{
					"id": 721050665,
					"content": "我的职责就是守护鸣神岛，祓除瘴晦，实行「神樱大祓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050666
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050666,
					"content": "面具巫女…花散里小姐本身就是「污秽」，而「神樱大祓」的目标是清除污秽，也就是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050667
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050667,
					"content": "你也会被消灭掉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050668
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050668,
					"content": "嗯…消灭这个词，或许稍微有些过分了吧？但从结果而言，确实是这样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050669
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050669,
					"content": "怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050670
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050670,
					"content": "呵呵，原本当我意识到这件事的时候，也感到很不安呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050671
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050671,
					"content": "但是，自从认识了你们，通过你们了解到了如今稻妻的许多事情，我也渐渐释然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050672
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050672,
					"content": "五百藏活了下来。虽然被惟神封印在了石头里，却没有一丝消沉的意思，对「狐斋宫」似乎也没有怨恨…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050673
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050673,
					"content": "虽然不如过往，但绀田村的绀田、柴门的家系一直延续到了现在；大社的稻城弥里过去也曾是她的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050674
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050674,
					"content": "这些人，可是当年她在灾难发生时，保护过的人的后代呢。倘若知道他们安好，并让血脉一直传承下去，她一定会很骄傲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050675
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050675,
					"content": "虽然…虽然当时为「狐斋宫」赠给柊勘定头弘嗣的法器被破坏，而稍微有些焦躁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050676
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050676,
					"content": "已经不是稍微的程度了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050677
					]
				},
				{
					"id": 721050677,
					"content": "呵呵，您说得对。实在是太失态了。无论如何，见它以如此曲折的方式，辗转到您的手上，我也很高兴呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050678
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050678,
					"content": "…不知道这是「花散里」的心情，还是「狐斋宫」的心情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050679
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050679,
					"content": "此前，因为她的心意与我的心意混杂，而我又身为她必须清除之物，而时常感到苦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050680
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050680,
					"content": "但是…如今我已经释然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050681
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050681,
					"content": "有幸与您同行，我真的很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050682
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050682,
					"content": "不，不如说，正因为是您，我才能来到这里，毫无牵绊地履行我最后的职责吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050683
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050683,
					"content": "花散里小姐，真的要走么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050684
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050684,
					"content": "嗯。谢谢你，派蒙大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050685
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050685,
					"content": "#那么，请原谅我的僭越…{NICKNAME}大人，派蒙大人，请听我一言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050686
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050686,
					"content": "请说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050687
					]
				},
				{
					"id": 721050687,
					"content": "「不被蒙蔽、不受动摇，一直走在你们所坚信的道路上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050688
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050688,
					"content": "这是「狐斋宫」在最终分别前，向她道出的最后的箴言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050689
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050689,
					"content": "虽然我自觉没有这份资格，以「白辰血脉」自居。但我相信，倘若「狐斋宫」本人还在，对您一定不会吝于祝福吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050690
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050690,
					"content": "希望，她的箴言——不，我的箴言，能为未来的您，多少抵挡几句谎言、几分恶念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050691
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050691,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050692
					]
				},
				{
					"id": 721050692,
					"content": "呵呵，不必客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050693
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050693,
					"content": "那么，作为交换…就请您让我最后再任性一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050694
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050694,
					"content": "「狐斋宫」她向来偏爱短歌之美。虽然我继承了她的记忆，也继承了她所知的那一千一百一十一首，却没有她那般自如应用的风雅情趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050695
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050695,
					"content": "但偏偏此时此刻，我想起一首应景的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050696
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050696,
					"content": "「与君相别离，不知何日是归期，我如朝露转瞬晞。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050697,
						721050698
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050697,
					"content": "花散里小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050699
					]
				},
				{
					"id": 721050699,
					"content": "#谢谢。再见了，很高兴能认识二位…{NICKNAME}大人，派蒙大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050700
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050700,
					"content": "「千枝万脉，请除祸灾。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050701
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050701,
					"content": "「…于此，宣其祓却。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050698,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050699
					]
				},
				{
					"id": 721050663,
					"content": "有必要吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050664
					]
				},
				{
					"id": 721050664,
					"content": "有必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050665
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050649,
					"content": "原来如此…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050650
					]
				},
				{
					"id": 721050643,
					"content": "似乎确实如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050644
					]
				},
				{
					"id": 721050636,
					"content": "非常可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050637
					]
				},
				{
					"id": 721050613,
					"content": "我也很辛苦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050614,
					"content": "我们一起经历了很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050607,
					"content": "哦。谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050608
					]
				}
			]
		}
	]
}