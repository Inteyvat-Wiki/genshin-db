			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050202
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050202,
					"content": "面具巫女小姐，我们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050203,
					"content": "干得太漂亮了。雷樱的根枝，一直在向我传颂二位的功业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050204
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050204,
					"content": "实在惶恐，我有一事应当向您坦白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050205
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050205,
					"content": "但言无妨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050206
					]
				},
				{
					"id": 721050206,
					"content": "是什么事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050207,
					"content": "您在绀田村最初取得镇物时，我称您为「命定之人」。但在当时，我对您的品德与勇武并未毫无保留地完全相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050208
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050208,
					"content": "但随着「大祓」的进展，您不但证明了我的浅薄与愚拙，还远远超出我的预想。以至于…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050209
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050209,
					"content": "我不禁感到遗憾。倘若当初，在「狐斋宫」的身边，也有像您这样的人，那或许…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050210
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050210,
					"content": "或许？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050211
					]
				},
				{
					"id": 721050211,
					"content": "不，没什么。是我多言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050212
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050212,
					"content": "那么，事情也告一段落了。奖励呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050213,
						721050215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050213,
					"content": "奖励呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050214
					]
				},
				{
					"id": 721050214,
					"content": "在此之前，还有一事未了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050217,
					"content": "「神樱大祓」最终仍有一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050218
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050218,
					"content": "怎么还有啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050219,
					"content": "作为守护土地、吸收污秽的代价，瘴晦会积聚在根枝当中。您解除结界，击败了污秽幻造的妖物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050220
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050220,
					"content": "正如社有枝社，所有雷樱皆是影向山的「神樱」之旁枝，那五条树根更是其中为大者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050221
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050221,
					"content": "它们所吸收的污秽，其实有很大一部分都传到了影向山深处的神樱当中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050222
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050222,
					"content": "所以最关键的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050223
					]
				},
				{
					"id": 721050223,
					"content": "没错。「神樱大祓」最关键的是在解除最后一步，也就是解除神樱的结界，祓除神樱之根多年积聚的瘴晦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050224
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050224,
					"content": "欸！神樱是在鸣神大社吧？如果在鸣神大社痛殴妖怪，会引起骚动的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050225,
					"content": "呵呵，您多虑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050226
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050226,
					"content": "神樱之根位于影向山的深处，在封印之下，与大社有着相当的距离。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050227
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050227,
					"content": "真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050228,
					"content": "毋须担心。请您相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050229
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050229,
					"content": "既然面具巫女小姐都这么说了，那就没办法啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050230,
					"content": "谢谢。那么，我们尽快行动吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050215,
					"content": "事情还没结束吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050216
					]
				},
				{
					"id": 721050216,
					"content": "确实如此。不愧是轻易解除了五处结界的人呢，有着如同穿过云霭的月光般，看透事物的眼力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "花散里"
				}
			]
		},
