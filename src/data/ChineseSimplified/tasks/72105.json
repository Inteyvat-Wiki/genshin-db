			},
			"dialogs": [
				{
					"id": 721050401,
					"content": "封印解除了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050402
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050402,
					"content": "接下来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050403,
					"content": "这下面好深…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050404
					]
				},
				{
					"id": 721050404,
					"content": "接下来，还请您允许我冒昧斗胆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050405
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050405,
					"content": "请您跳进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050406,
						721050407
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050406,
					"content": "不、不太好办…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050409
					]
				},
				{
					"id": 721050409,
					"content": "这下面看起来好可怕，跳进去会出事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050410,
					"content": "二位不必担心，虽然神樱之根多有积秽，却也识得行本回「大祓」之人的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050411
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050411,
					"content": "她会保佑您安全着陆，以祛除最后的瘴晦的。我保证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050412
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050412,
					"content": "真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050413,
					"content": "请您相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050414
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050414,
					"content": "下去以后，我们要做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050415,
					"content": "一言以蔽之的话，施展您的勇武即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050416
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050416,
					"content": "积累的邪秽在影向山的最深处凝结成了硕大的「瘤」，现在由神樱之根紧紧缠绕压制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050417
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050417,
					"content": "抓紧时机，攻击瘴晦瘤。但它受到攻击时，必定会奋力挣扎，甚至会有妖物滋生，以此阻挠您的行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050418
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050418,
					"content": "期间，也需要您如同解除此前的五处封印那般，使周边的机关运作，以此巩固神樱之根的压制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050419
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050419,
					"content": "如此一来，神樱就会配合您的行动，为您创造攻击的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050420
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050420,
					"content": "听起来好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050421,
						721050422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050421,
					"content": "我打过更麻烦的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050423,
					"content": "我相信您的实力。那么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050424
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050424,
					"content": "你不能一起去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050425
					]
				},
				{
					"id": 721050425,
					"content": "战斗结束后，我在下面与您会合，完成「大祓」的收尾之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050426
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050426,
					"content": "真的非常抱歉。如我此前所说，以我的…身体状况，无法完成这样的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050427
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050427,
					"content": "还望您多多海涵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050428
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050428,
					"content": "那也没办法了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050429,
					"content": "那么…请问您准备得如何了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050430,
						721050432
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050430,
					"content": "我准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050431
					]
				},
				{
					"id": 721050431,
					"content": "那么，还请您向前迈步，实行「神樱大祓」最后的步骤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050434,
					"content": "无论如何，如果关于净化之事，有任何想问的，还请您随时来问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050435
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050435,
					"content": "那么…这就是最后的最后了。祝您一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050432,
					"content": "我还没有准备好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050433
					]
				},
				{
					"id": 721050433,
					"content": "这样啊…无论如何，禁锢此间邪秽的结界已经解除，如果可以的话，希望您能尽快解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050422,
					"content": "好可怕！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050407,
					"content": "派、派蒙会飞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050408
					]
				},
				{
					"id": 721050408,
					"content": "喂！你在说什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050409
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7210505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
