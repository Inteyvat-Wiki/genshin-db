			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050101,
					"content": "「噫！」…欸？我还以为花散里小姐会突然出现在我们身后呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050102,
					"content": "这么说来，这是最后的第五处树根了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050103,
					"content": "我还以为，这最后一处处理完了，她会像之前那样「咻啪！」一下，出现在我们身后，给我们宝藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050104,
					"content": "「咻啪！」那样是怎样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050105
					]
				},
				{
					"id": 721050105,
					"content": "就是「咻啪！」那样呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050106,
					"content": "无论如何，「神樱大祓」算是完成了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050107,
						721050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050107,
					"content": "轻轻松松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				},
				{
					"id": 721050109,
					"content": "确实呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050110,
					"content": "我们几乎走遍了整个鸣神岛，甚至还到了海底。好累呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050111,
						721050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050111,
					"content": "累的是我才对…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050112
					]
				},
				{
					"id": 721050112,
					"content": "喂！派蒙可是一直在很用力很用力地为你加油的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050114,
					"content": "之前，面具巫女小姐不是说，要我们净化了所有五处树根以后，就回去找她来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050115,
					"content": "#哼哼，肯定是要给我们奖励了。{NICKNAME}，我们去绀田村井下的结界那找她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050116,
					"content": "只要不是再给我们吃顿狸猫饭就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050113,
					"content": "还好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050114
					]
				},
				{
					"id": 721050108,
					"content": "经历了很多呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				}
			]
		},
		{
			"id": 7210502,
