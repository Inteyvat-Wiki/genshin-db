			},
			"dialogs": [
				{
					"id": 200500101,
					"content": "伤脑筋…这里要怎么解决啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500102,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "为了下一次的骑士选拔，我正在训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500104,
					"content": "唔…不过，我可没有琴大人那样的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500105,
					"content": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500106,
					"content": "比如，一口气把这些木桩全部破坏掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500107,
					"content": "你有空的话，也和我一起来想一想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500108,
					"content": "我想一想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "没关系，好好想喔，木桩不会自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500111,
					"content": "唯一会自己跑掉的只有被消耗的时间和生命，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500114,
					"content": "我听别人说，元素是能互相作用的，如果能让这个火盆里的火稍稍爆炸一下的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500115,
					"content": "不过，这个火盆里，首先得有火才行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500109,
					"content": "我们两个一起上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200500113,
					"content": "像我这样的，只能学习独自作战啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "艾琳"
				}
			]
		},
