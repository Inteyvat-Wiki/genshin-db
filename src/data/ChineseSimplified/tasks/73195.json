			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "「听说以前，底万是帮我们下城的百姓说话的机构，现在只知道对教令官言听计从的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951602,
					"content": "「什么维齐尔，平常说话也不算，只有教令官要推卸责任的时候才会想起来。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951603,
					"content": "教令院对各行政机构的指导乃是大慈树王的遗教，闲杂人等不得诋毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
