			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "「自从当上巡林官天天待在森林里，时间长了都想找暝彩鸟说话了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951302,
					"content": "「要是我真的能听懂它们说话就好了，就不会每天像现在这么无聊了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
