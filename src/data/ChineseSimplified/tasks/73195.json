			"dialogs": [
				{
					"id": 731950101,
					"content": "此乃维齐尔大人所设的告示板，须弥城内重要事务皆在此公示，如有相关问题也可在此留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "「关于延请专家处理长鬓虎的告示…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950202,
					"content": "告示的正式内容被画笔涂抹，旁边用歪斜而稚嫩的字迹写着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950203,
					"content": "「罗阇只是想跟大家玩而己！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "「如您在食用蕈类后看见小精灵跳舞，此为正常现象不用担心。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950302,
					"content": "「不过倘若您发现周围植物开始说话，那么请立即联系附近的巡林员寻求帮助。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "「由于不明原因，最近森林中的『死域』无论数量还是面积都有明显扩张。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950402,
					"content": "「『死域』不仅会使植物枯萎，还可能夺走动物和人类的生命。巡林官已为此设置了『污染区』，大家请勿靠近。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950403,
					"content": "「如在行走森林的过程中，发现新出现的死域，请就近联系附近的巡林员，交由专业人士处理。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "近期风纪官在对各地巴扎的日常巡查过程中，查获多起非法罐装知识交易案件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950502,
					"content": "罐装知识交易为教令院所严禁，一经发现，必将严惩不贷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950503,
					"content": "如因使用罐装知识导致任何后果，教令院亦概不负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "「一年一度的『花神诞祭』就要到了，今年大巴扎也会举办盛大的祭典。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950602,
					"content": "「为了让祭典更加热闹，今年我家小姐为各位前来参与祭典的商家提供了特别的补贴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950603,
					"content": "「希望大家能够一起为小吉祥草王大人庆生！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "「我家小姐近日离家出走，至今未归。如您看见一位棕色盘发，身穿紫色上衣淡蓝色长裙的年轻女孩，请与呼玛伊家联系，必有重谢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950702,
					"content": "「本人如见到启事后，速与家人联系，老爷和夫人很担心你。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
