			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "「说起来之前有个很不错的佣兵，我记得是叫『炽鬃之狮』什么的吧…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951402,
					"content": "「以前每次出海行商都会雇她帮忙护卫，不管是盗宝团还是千岩军都没在怕的。托她的福我可是狠赚了一笔呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951403,
					"content": "「不过最近似乎看不到她在接委托了，而且听说去璃月路上的魔物又变多了…这样下去我只能把钱放到卡里米交易所了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951404,
					"content": "「听上去你做的也不是什么正经生意吧…不过你说『炽鬃之狮』的话，我听说她最近接了呼玛伊家的大单，你可得好等一会了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951405,
					"content": "「另外奉劝一句，有钱的话宁愿去买一百条毛毯，也别投到卡里米交易所啊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951406,
					"content": "「这位大叔说得没错！请来本店买一百条毛毯吧，让我为您细说每一条都有什么妙用！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
