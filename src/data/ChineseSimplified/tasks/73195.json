				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "「回来了！我主阿赫玛尔回来了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950802,
					"content": "「当他重临世界之日，你们这些脑袋上长叶子的家伙都要遭到报应！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950803,
					"content": "此为不实消息，我们正在追查相关谣言的来源。须弥无论内外大事都会在虚空中定期投放，大家请勿轻信流言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "「朋友，遇到什么困难了吗？无所不能的桑歌玛哈巴依老爷诚心为您提供各类解决方案。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950902,
					"content": "「只需要付出一点小小的摩拉，便能帮您解决任何问题。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950903,
					"content": "「心动不如行动，联系方式…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950904,
					"content": "此乃维齐尔大人所设的告示板，为规范市场交易行为，请大家不要在此张贴广告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
