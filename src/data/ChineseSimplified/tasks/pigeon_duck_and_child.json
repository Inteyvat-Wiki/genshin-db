				},
				{
					"id": 200480302,
					"content": "下次走过的时候，记得不要再吓到鸽子了，它们好不容易才愿意回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480303
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480303,
					"content": "知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "好啦，我原谅你了。这个给你，我最喜欢吃的蒙德土豆饼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480305,
					"content": "要对世界保持善意啊…这是妈妈教我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
