					"提米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "哇啊！又是你！鸽子又全都飞走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480102,
					"content": "我还在喂它们呢，你做什么啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480103,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "妈妈说，歉意要用实际行动来表示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480105,
					"content": "桥上的鸽子是我的好朋友，我一直在喂它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480106,
					"content": "但最近附近的鸭子们经常来抢食物吃，搞得它们谁也吃不饱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480107,
					"content": "我想请你帮我找三份小麦来，帮我喂下鸭子们，我也会在桥上把鸽子们也喂饱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480108,
					"content": "都吃饱了之后，它们一定会友好相处吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480109,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "那就拜托你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480112,
					"content": "好好对待动物的话，你也可以和它们做朋友的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 200480110,
					"content": "我不太想和鸽子做朋友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "无论想不想做朋友…你都要先向它们道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200480114,
					"content": "所以——快点去找小麦啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				}
			]
		},
