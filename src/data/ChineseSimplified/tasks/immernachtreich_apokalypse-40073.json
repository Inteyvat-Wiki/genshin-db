					"奥兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730601,
					"content": "这里有个城堡，但不完整。菲谢尔，这是你的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730602,
					"content": "唔…待本皇女思量片刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730603
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730603,
					"content": "不必想了小姐，这正是您从前因悲伤过度不慎手滑打碎的城堡玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730604
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400730604,
					"content": "奥兹！不要说出来！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730605
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730605,
					"content": "本皇女刚刚想起，有关我之皇城，可是缺失了两部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730606
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730606,
					"content": "所以是要找两个碎片对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
