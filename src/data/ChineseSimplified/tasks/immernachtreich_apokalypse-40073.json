			"dialogs": [
				{
					"id": 400731801,
					"content": "（真是令人高兴的日子。我找回自己，成为了真正的皇女。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731802
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731802,
					"content": "（幽夜净土真的降临了。尽管如此，我也明白，隐藏在我心中的负面情感并不会就此消逝。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731803
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731803,
					"content": "（没关系，我会带着这些弱点继续战斗。因为我已经明白，我所拥有的东西独一无二，如此美妙。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731804
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731804,
					"content": "菲谢尔，听说外面剧场已经搭起来了，你不去看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731805,
					"content": "派蒙卿，注意言辞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731806
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731806,
					"content": "哦哦！好吧，皇女殿下，您不愿赏光外出看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731807,
					"content": "噗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731808
					]
				},
				{
					"id": 400731808,
					"content": "咳！身为臣子，竟敢嘲笑光彩荣耀伟大的皇女。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731809,
						400731810
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731809,
					"content": "不是嘲笑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731811
					]
				},
				{
					"id": 400731811,
					"content": "…嘿嘿，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731812
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731812,
					"content": "尽情狂欢吧，今天可是幽夜净土的大日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731813
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731813,
					"content": "噢，小姐的意思是，诚心邀请诸位奉上最大的热忱，尽情庆贺这至夜圣土降临于世的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731814
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731814,
					"content": "好啦好啦，别再翻回菲谢尔语了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731815,
					"content": "…噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731816
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731816,
					"content": "假如是这样的国度…当地的戏剧表演，一定很好看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731817
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731817,
					"content": "至于我关注的谜题，应该也快有答案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731818
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731818,
					"content": "对了，好像还有件事没做。皇女殿下，奥兹，我们失陪一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731819,
					"content": "好的，二位一会儿见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731820
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731820,
					"content": "再试试，看能不能联系上温迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731821,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731822
					]
				},
				{
					"id": 400731822,
					"content": "嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731823
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400731823,
					"content": "嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731824
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400731824,
					"content": "咦，是你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731825
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400731825,
					"content": "这个声音…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731826
					]
				},
				{
					"id": 400731826,
					"content": "我从来没听过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731827
					]
				},
				{
					"id": 400731827,
					"content": "欸？不是卖唱的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731828,
					"content": "对不起，你是哪位？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731829
					]
				},
				{
					"id": 400731829,
					"content": "嗯，我们确实素不相识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731830
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400731830,
					"content": "我知道你想联络海岛之外的人，但现在还不行哦。所以，我截断了你的通讯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731831
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400731831,
					"content": "咦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731832,
					"content": "比起询问，你不想自己找出答案吗？不可思议的幻境，它代表「深梦」，正是人心最本质的映射。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731833
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400731833,
					"content": "去看吧。亲眼看清这一切，待故事落幕，再告诉我你的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731834
					],
					"speakerTitle": "嘟嘟通讯仪"
				},
				{
					"id": 400731834,
					"content": "…联络断开了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731835
					]
				},
				{
					"id": 400731835,
					"content": "#喂{NICKNAME}，刚才那是谁啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731836
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731836,
					"content": "好奇怪，为什么这个人能截断我们跟温迪的联络…她又为什么要问你的感受呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731837,
					"content": "唔…不行，我想不明白！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731838,
					"content": "我也还不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731839
					]
				},
				{
					"id": 400731839,
					"content": "有点害怕，但…但我会保护你的，不论发生什么事，我都陪着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731840,
					"content": "嗯。我们先保密。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731841
					]
				},
				{
					"id": 400731841,
					"content": "（那个人的话语中没有半点恶意，反倒带着强烈的试探。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731842
					]
				},
				{
					"id": 400731842,
					"content": "（不知她想从我这里得到什么答案，但在那之前…我会看完所有的故事。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400731810,
					"content": "看到你打起精神来就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731811
					]
				}
			]
		}
	]
