			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神情严肃的夜鸦",
					"眼神凛冽的夜鸦",
					"莫娜",
					"菲谢尔",
					"奥兹",
					"辛焱",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730201,
					"content": "站住！又是你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730202
					],
					"speakerTitle": "神情严肃的夜鸦"
				},
				{
					"id": 400730202,
					"content": "干什么？我们可是皇女殿下的家臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730203,
					"content": "不不，胡言乱语！皇女殿下可不认得你们这种小人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730204
					],
					"speakerTitle": "眼神凛冽的夜鸦"
				},
				{
					"id": 400730204,
					"content": "哈？你能为自己说的话负责吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730205
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400730205,
					"content": "我再说一次，皇女殿下可不认得你们这种…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730206
					],
					"speakerTitle": "眼神凛冽的夜鸦"
				},
				{
					"id": 400730206,
					"content": "汝刚才说，谁是小人物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730207
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730207,
					"content": "皇女殿下和奥兹大人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730208
					],
					"speakerTitle": "神情严肃的夜鸦"
				},
				{
					"id": 400730208,
					"content": "对幽夜净土的诸位臣子说出这种话，守卫先生们未免太冒犯了些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730209
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400730209,
					"content": "哼。本皇女精心挑选的臣子，岂容汝等看轻？还不速速退下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730210
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730210,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730211
					],
					"speakerTitle": "神情严肃的夜鸦"
				},
				{
					"id": 400730211,
					"content": "没有可是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730212
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730212,
					"content": "是、是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730213
					],
					"speakerTitle": "眼神凛冽的夜鸦"
				},
				{
					"id": 400730213,
					"content": "菲谢尔，奥兹，你们归队啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730214,
					"content": "嗯哼，汝暂且这样认为罢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730215
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730215,
					"content": "小姐的意思是，我们花了不少时间才找到这里。虽说不愿面对这处幻境，但也不能抛下各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730216
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400730216,
					"content": "莫娜说对了呢，「不愿面对」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730217
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400730217,
					"content": "有种日记本被人偷看的感觉对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400730218,
					"content": "…肤浅。本皇女若真是轻易就能动摇之人，世上可不会有如此壮丽的幽夜净土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730219
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730219,
					"content": "小姐的意思是，这里还有别的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730220
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400730220,
					"content": "麻烦？你们遇到什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730221
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400730221,
					"content": "…呜…这件事稍后再议，先办正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730222
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730222,
					"content": "动起来动起来，书就在眼前，可不能傻站着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4007304,
