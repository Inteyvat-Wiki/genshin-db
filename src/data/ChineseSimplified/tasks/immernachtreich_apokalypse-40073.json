					"奥兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730401,
					"content": "呵…壮丽又脆弱，庞大又胆怯…令我赞叹，也让我作呕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730402
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400730402,
					"content": "小姐的意思是，从没见过这么夸张的幻境，即使是她本人也叹为观止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥兹"
				}
			]
		},
		{
			"id": 4007306,
			"completionStepIds": [
				4007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
