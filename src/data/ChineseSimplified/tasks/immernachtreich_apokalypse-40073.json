					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731301,
					"content": "小哥，你这个样子，以后怎么出门啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731302
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731302,
					"content": "旅行需要耐力、勇气和危机意识。你有了耐力和勇气，之后还请注意增强危机意识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731303
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400731303,
					"content": "各位的话，我会牢牢记在心中。但这一次，我们真的该告别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731304
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731304,
					"content": "您或许还没有察觉，但我知道，天气变得晴朗，海面平静又美丽…为了这一天，我们等待许久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731305
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731305,
					"content": "各位一定为我这样冒失的人都能当上演员感到奇怪，但请相信我，这不是偶然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731306
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731306,
					"content": "每一只夜鸦都在寻找工作。工作，等同于我们的命运。我们生来便要找到自己命中注定该扮演的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731307
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731307,
					"content": "各位或许还没听说，《圣国的咏唱》，是一本预言书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731308
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731308,
					"content": "预言书？可它不是你们的圣典吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731309,
					"content": "是的。数百年前，幽夜净土被不祥之气覆盖，我们的主人却像失去了治国的兴趣一般，未采取任何行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731310
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731310,
					"content": "随后有一天，大书记官奥兹出现在我们之中。它带来圣典与一则振奋人心的预言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731311
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731311,
					"content": "那预言正如书中所写，昭示着幽夜净土真正的幸福。为此，我们坚信满天阴霾必会散去，我们衷心期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731312
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731312,
					"content": "救世的主宰者…皇女殿下。她一定会想起这里本是怎样的乐土，为了她，我们要仿照预言，献上戏剧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731313
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731313,
					"content": "所以我站出来，扮演勇士。我愿走过千难万险，踏过刀山火海…去向她献上我的真心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731314
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731314,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731315
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731315,
					"content": "您…您是皇女殿下？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731316
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731316,
					"content": "对哦，刚才救援的时候她不知为什么躲在后面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731317,
					"content": "我之臣民，汝的意志足以斫断邪龙的手足。现在，我会收下汝的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731318
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731318,
					"content": "我倍感荣幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731319
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731319,
					"content": "汝做得很好。骑士的美德，汝也已然具备。去吧，就位，等待演出开幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731320
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731320,
					"content": "赞美您对皇女殿下的虔诚之心。覆盖幽夜净土全境的阴霾，将由皇女殿下率领我等扈从击溃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731321
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731321,
					"content": "…感谢殿下，也感谢各位英雄！那么，我就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731322
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731322,
					"content": "对了，如果各位需要…请务必记得，前方大门的口令是「永夜的序曲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731323
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400731323,
					"content": "我都糊涂了，你们刚才在演哪出？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731324,
					"content": "难道在场诸卿就没有一人能听懂我之箴言么？愚笨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731325
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731325,
					"content": "小姐的意思是各位很笨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731326
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731326,
					"content": "这种话就不用翻译了！你说谁笨，我已经完全明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731327
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731327,
					"content": "嗯，皇女殿下先前说的「正事」，就是这个吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731328
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400731328,
					"content": "速战速决，走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731329
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731329,
					"content": "欸？等等，怎么了，究竟怎么了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007315,
			"completionStepIds": [
				4007315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007315",
							"2"
						],
						"stepId": 4007315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"菲谢尔",
					"幽夜菲谢尔",
					"奥兹",
					"辛焱",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731501,
					"content": "图书馆？我们在图书馆里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731502
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731503
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731503,
					"content": "…呵，我苦苦搜寻的宿敌，无为又懦弱的所谓皇女，就是你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731504
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731504,
					"content": "可笑。你又为什么觉得自己能够战胜我呢？要知道，你先前表现出的恐惧和犹豫，我可是看得一清二楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731505
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731505,
					"content": "怎么还有一个你啊，是影子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731506,
					"content": "影子？对…我们之间确实如此。你是来向我投降的吗？小艾咪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731507
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731507,
					"content": "呜…你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731508
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731508,
					"content": "那边那位夜鸦，你是奥兹？很好，我也等待了许久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731509
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731509,
					"content": "听说，有位名叫奥兹的大书记官把《圣国的咏唱》带入幽夜净土。想必，就是你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731510
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731510,
					"content": "…诚惶诚恐，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731511
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731511,
					"content": "你怎么叫她小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731512
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731512,
					"content": "如各位所见，那边的也是小姐。既是小姐，就是我奥兹的主人，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731513
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731513,
					"content": "…不无道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731514
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400731514,
					"content": "不妨告诉各位，幽夜净土是有来无回的地方。你们来到这里，就要被我征服，成为我的奴隶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731515
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731515,
					"content": "至于奥兹，虽然你带来令我不快的预言之书，还令愚蠢的臣民们疯狂朝拜那言之无物的东西，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731516
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731516,
					"content": "你可是奥兹啊，那不如到我身边来。毕竟，「菲谢尔就是要与奥兹搭档的呢」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731517
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731517,
					"content": "感谢小姐的赏识，那我就恭敬不如从命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731518
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731518,
					"content": "奥兹？！你去哪里？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731519
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731519,
					"content": "他居然去对面了，菲谢尔，这就是你养的好乌鸦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731520
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731520,
					"content": "呜啊啊啊现在不是数落我的时候吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731521
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731521,
					"content": "奥兹，你被蛊惑了吗？为什么相信她说的话，幽夜净土不该是自由与戏剧的圣土吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731522
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731522,
					"content": "大错特错。幽夜净土才不是那种儿童游乐园一样的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731523
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731523,
					"content": "听好了…它是为无法面对现实之人准备的坟墓。你会葬身此地，我则带着我们幻想出来的奥兹，永居王城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731524
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731524,
					"content": "…坟墓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731525
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731525,
					"content": "你应该最清楚才是。为什么幽夜净土下着雨？为什么这片乐土上没有真正的歌声？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731526
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731526,
					"content": "…是因为你，就是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731527
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731527,
					"content": "哦呵呵，太可笑了，你才是罪魁祸首吧！小艾咪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731528
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731528,
					"content": "呃…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731529
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731529,
					"content": "幻想出如此庞大的国度，却不能承受。对自身创造的事物感到动摇，就算再怎么逃避，也无法改变你自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731530
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731530,
					"content": "是因为你无法真正抵达这里，我才降临于此，代行职责。幽夜净土现今是我的东西，轮不到你来指手画脚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731531
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731531,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731532
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731532,
					"content": "小艾咪，你是一个软弱的傻瓜，不配拥有这个世界。滚出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731533
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731533,
					"content": "喂，说够了没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731534
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731534,
					"content": "自己骂自己还能骂得这么精彩，看来这件事困扰你很久了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731535
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731535,
					"content": "莫娜…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731536
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731536,
					"content": "你这是什么表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731537
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731537,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731538
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731538,
					"content": "哼。你该不会要认输吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731539
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731539,
					"content": "…我不想承认，可是…她说的，也许没错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731540
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731540,
					"content": "不，请别这么想。皇女殿下，还记得我们为何来到这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731541
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400731541,
					"content": "万叶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731542
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731542,
					"content": "我是来自稻妻的剑客，负责守护你的安全。至于这几位，也都应你呼唤而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731543
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400731543,
					"content": "有自己的坟墓，听起来也挺酷的。但很可惜，幽夜净土不是坟墓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731544
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731544,
					"content": "辛焱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731545
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731545,
					"content": "…哦，交到朋友了呢。但你以为这样就能赢过我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731546
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731546,
					"content": "我可是你的恐惧与黑暗，是你这么多年来始终无法逃避的噩梦，在我面前，你一无是处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731547
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731547,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731548
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731548,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731549
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731549,
					"content": "…不对。我不能…我…还不能输。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731550
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731550,
					"content": "我才是赢家！给我等着，你会后悔的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲谢尔"
				}
			]
		},
		{
			"id": 4007317,
			"completionStepIds": [
				4007317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007317",
							"2"
						],
						"stepId": 4007317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"幽夜菲谢尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731701,
					"content": "不可能，你竟然能通过那个噩梦般的图书馆…给我退下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731702
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731702,
					"content": "…现在，你还觉得我会输吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731703
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731703,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731704
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731704,
					"content": "你看不起我，觉得我懦弱，渺小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731705
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731705,
					"content": "我是有过那样的日子，因为…我是一个不能面对现实，成天做白日梦还不堪一击的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731706
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731706,
					"content": "可现在我明白了，在看到这片幻境的一瞬间，我就想明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731707
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731707,
					"content": "看到外面那么惊人的幻象了吗？无比庞大，无比美丽…这就是我的想象力，我力量的根源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731708
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731708,
					"content": "你似乎很自大，黑暗的东西总是很狂妄。但不应该是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731709
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731709,
					"content": "你根本不是一个完整的皇女，只是钻在我影子里沾沾自喜的灰尘！你才是失败者，那个拖我后腿的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731710
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731710,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731711
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731711,
					"content": "懦弱，所以浑身尖刺，胆小，所以靠自暴自弃来伪装。这样的你…比我更弱小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731712
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731712,
					"content": "还给我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731713
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731713,
					"content": "什、什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731714
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731714,
					"content": "把属于我的东西还给我！幽夜净土、王城、子民…还有还有最重要的，我的伙伴，奥兹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731715
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731715,
					"content": "哎呀，小姐竟然能说出如此流利又极富气魄的话语，您当真成长为皇女了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731716
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731716,
					"content": "还敢说话，你这个叛徒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731717
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731717,
					"content": "不，小姐，我之所以在这里，是为了向各位证明一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731718
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731718,
					"content": "众所周知，奥兹会跟随断罪之皇女菲谢尔。二位既然都是菲谢尔，我出现在谁的身边都不要紧才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731719
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731719,
					"content": "可是您看，当我站在这一边的时候，您也没有失去自己的身份不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731720
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731720,
					"content": "原来如此，高明的劝诫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731721
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400731721,
					"content": "我的身份？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731722
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731722,
					"content": "您认为，「菲谢尔」究竟是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731723
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731723,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731724
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731724,
					"content": "这是我给小姐您的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731725
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731725,
					"content": "菲谢尔…是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731726
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731726,
					"content": "是生活的失败者，一个心怀恐惧的胆小鬼，无法面对幻想之外缺乏谎言的自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731727
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731727,
					"content": "不，您说得不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731728
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731728,
					"content": "菲谢尔…是…我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731729
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731729,
					"content": "噢，反应很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731730
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731730,
					"content": "欸？就这么简单？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731731
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731731,
					"content": "这才对，小姐。菲谢尔，或许是断罪之皇女，却不总是。或许勇敢高傲，却也胆小懦弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731732
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731732,
					"content": "菲谢尔是您自己。既高贵又平凡，是水平一流可总也交不到太多朋友的冒险家，是不可思议之国的皇女殿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731733
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731733,
					"content": "菲谢尔，既胆小又强大，惧怕他人的闲言碎语，也渴望得到他人的崇敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731734
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731734,
					"content": "更重要的是…菲谢尔，是一个常在心中自我批判，被自己打败无数次，又无数次站起的进取者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731735
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731735,
					"content": "小姐，除了您，没有人当得起菲谢尔这个名字。它是复杂而单纯的符号，指向梦想与自由之美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731736
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731736,
					"content": "无论是否受人追随，小艾咪就是菲谢尔。菲谢尔是您——在心中无意识写下那句箴言的贤明之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731737
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731737,
					"content": "…「令我的子民自由，不囿于古老法则。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731738
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731738,
					"content": "感谢您创造幽夜净土，为我等搭建家园，又于潜意识中写下《圣国的咏唱》，使我等永远坚信光明将到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731739
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731739,
					"content": "现在，殿下，请接受您的黑暗，恢复成原本的姿态吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731740
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400731740,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731741
					],
					"speakerTitle": "幽夜菲谢尔"
				},
				{
					"id": 400731741,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731742
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731742,
					"content": "呜哇，穿礼服的那个消失了！欸等等…又冒出来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400731743,
					"content": "看来，影子回到了她本来的位置，也就是菲谢尔心里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731744
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731744,
					"content": "…哦呵呵呵，来了吗，诸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731745
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731745,
					"content": "哦？这种感觉是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731746
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400731746,
					"content": "啊哈哈哈，我之臣民们！听见了吗，本皇女的召唤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731747
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731747,
					"content": "听到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731748
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400731748,
					"content": "一恢复精神就吵吵嚷嚷的，受不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731749
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400731749,
					"content": "奥兹所言甚是，今日正是本皇女取回真心，再度君临幽夜净土的伟大时刻。现在，我宣布——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731750
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731750,
					"content": "——欢迎来到幽夜净土！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731751
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400731751,
					"content": "太好了太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
