			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂玛乌斯",
					"砂糖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400250101,
					"content": "喂，蒂玛…咦，那是阿贝多吗？他怎么走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250102,
						400250103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250102,
					"content": "（而且表情有些冷淡的样子。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250104
					]
				},
				{
					"id": 400250104,
					"content": "哎呀？是旅行者和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250105
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250105,
					"content": "两位，你们好！好久不见了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250106
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250106,
					"content": "你们刚刚是在讨论什么重要的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250107,
					"content": "我们一般都会约在这里见面，例行交流最近的研究课题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250108
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250108,
					"content": "可恶，来晚一步，要是能叫住阿贝多该多好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250109,
					"content": "不过看他刚才那个表情，比平时冷淡一点，该不会是遇到什么不高兴的事了吧？要是那样，估计也没心情帮我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250110,
					"content": "那个…请问你说的不高兴，是指阿贝多先生吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250111
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250111,
					"content": "对呀，我看他刚才表情和平时不太一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250112,
					"content": "不高兴…呃，该不会是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250113
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250113,
					"content": "你、你看我干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250114
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250114,
					"content": "难道是蒂玛乌斯最近想出来的研究课题太无聊，激怒了阿贝多先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250115
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250115,
					"content": "不、不至于这么无聊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250116
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250116,
					"content": "不会吧？我还想让蒂玛乌斯帮忙来着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250117,
					"content": "帮忙？哈哈，可以啊，请问是什么事需要我帮忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250118
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250118,
					"content": "是这样的，前些日子我在山上捡到一批特别特别甜的日落果，但这么甜的果子，吃完就没了，很舍不得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250119,
					"content": "所以，我想让你帮我做个装置，果子放进去直接变成果汁，这样就能一直保存了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250120,
						400250121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250120,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250122
					]
				},
				{
					"id": 400250122,
					"content": "你说的这种事…恐怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250123
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250123,
					"content": "咦？这点事都做不到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250124,
					"content": "啊哈哈，派蒙这家伙从刚才开始就一直在说些离谱的话呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250125
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250125,
					"content": "那砂糖有头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250126,
					"content": "抱歉…你要的东西好像不属于我擅长的领域，非要尝试的话，有可能把你珍贵的果子都变成有手有脚的果子哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250127
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250127,
					"content": "哇…好平静又好可怕的描述，幸亏我习惯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250128
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250128,
					"content": "毕竟我的研究方向是生物炼金呀…再说，一直保鲜这种事也不太实际。如果几位是想改良果子或种子，我倒能帮上一点忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250129
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250129,
					"content": "炼金术士一般都会有独属于自己的研究课题，举例来说，蒂玛乌斯、阿贝多先生和我，研究方向都不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250130
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250130,
					"content": "派蒙想要的东西，充满了想象力…同时也超出了我和蒂玛乌斯的能力范围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250131
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250131,
					"content": "我想，就连阿贝多先生也不一定能做出那种不可思议的装置吧…说到底，炼金术并不是机械技术，两者之间有很大不同呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250132
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250132,
					"content": "抱歉，派蒙就是满嘴胡话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250133
					]
				},
				{
					"id": 400250133,
					"content": "这样吗…亏我还以为炼金术是万能的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250134,
					"content": "其实，早在阿贝多先生出现前，蒙德城的大家一度以为炼金术是没什么用的学科呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250135
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250135,
					"content": "不过就算是现在，我也得承认，炼金术也只是世界的奥秘之一，而不是什么能让物质永驻的万能法术…啊！抱歉，不是在打击你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250136,
						400250137
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250136,
					"content": "别自责，是派蒙的错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250138
					]
				},
				{
					"id": 400250138,
					"content": "我只是想要果汁而已，有什么不对嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250139,
					"content": "啊不过，刚才说的都是我和蒂玛乌斯主观的感受，如果两位真的很想要这个神奇的装置…可以试着请教阿贝多先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250140
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250140,
					"content": "要是他也没办法的话，应该就真的没有可能了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250141
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250141,
					"content": "他今天心情不太好的样子，会不会不理我们呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250142,
					"content": "不会的啦，阿贝多先生才不是那种人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250143
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 400250143,
					"content": "（不过…今天的阿贝多…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250144
					]
				},
				{
					"id": 400250144,
					"content": "（似乎有些不同，为什么？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250145
					]
				},
				{
					"id": 400250145,
					"content": "对了，阿贝多这会儿会去哪里呢？还是雪山吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250146,
					"content": "没特别说明的话，他一般都会在雪山。阿贝多先生似乎对雪山一带情有独钟，也真佩服他不怕冷呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250147
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400250147,
					"content": "那我们就去雪山找他好了，事不宜迟，现在就出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250137,
					"content": "我会严加管教派蒙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250138
					]
				},
				{
					"id": 400250121,
					"content": "完全没有逻辑可言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250122
					]
				},
				{
					"id": 400250103,
					"content": "（是发生什么事了吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250104
					]
				}
			]
		},
		{
			"id": 4002502,
			"completionStepIds": [
				4002503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002503",
							"2"
						],
						"stepId": 4002503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏",
					"塞琉斯",
					"冒失的帕拉德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400250201,
					"content": "嗯？那边好热闹，我们过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250202,
					"content": "啊，是旅行者和派蒙！没想到会在雪山遇见你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250203
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250203,
					"content": "居然是安柏，还有塞琉斯会长、帕拉德…大家怎么都跑到雪山来了？不怕冷吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250204,
					"content": "各位，好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250205
					]
				},
				{
					"id": 400250205,
					"content": "哦？连旅行者也要加入了啊。好事，天大的好事！哈哈哈，人就是要越多越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250206
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250206,
					"content": "是啊，一下就放心了呢，旅行者一定会是可靠的同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250207,
						400250208
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400250207,
					"content": "加入什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250209
					]
				},
				{
					"id": 400250209,
					"content": "对哦！仔细看看好多都是冒险家协会的人，其中还混进了一位侦察骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250210,
					"content": "哈哈哈…还是让我来解释吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250211
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250211,
					"content": "我们冒险家协会最近在雪山举办了一个冬季特训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250212
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250212,
					"content": "你们也知道，成员的冒险经验各不相同，为了寻求突破独自冲进雪山是很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250213
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250213,
					"content": "所以我们提前做好安排，让前辈带领后辈，行家陪同菜鸟。大家一起进入雪山，在有保护的环境下进行训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250214
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250214,
					"content": "这样，冒险家们就能共同进步了。这就是我筹备了半年的伟大计划！很棒对不对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250215
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250215,
					"content": "#{NICKNAME}，你作为优秀冒险家，当然也会愿意加入我们，助我们一臂之力，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250216
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250216,
					"content": "呃…安柏，你怎么在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250217
					]
				},
				{
					"id": 400250217,
					"content": "难道是冒险家协会的前辈人手不够了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250218,
					"content": "也、也有一部分原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250219
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250219,
					"content": "我这次巡逻经过了雪山边界，发现一个叫乔尔的孩子独自迷路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250220
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250220,
					"content": "我听说他长期住在这个营地，就把他送了回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250221,
						400250222
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250221,
					"content": "我记得那个孩子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250223
					]
				},
				{
					"id": 400250223,
					"content": "可是乔尔的父亲失踪了，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250224
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250224,
					"content": "我非常能够理解乔尔思念家人的心情。雪山上人烟稀少，他一定特别孤单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250225
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250225,
					"content": "安柏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400250226,
					"content": "嗯，我希望至少能给乔尔带去一些安慰，就打算按照乔尔说的习惯，陪他一起堆雪人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250227
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250227,
					"content": "同时，也可以在这里稍作停留，帮塞琉斯会长一点忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250228,
						400250229
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250228,
					"content": "陪乔尔的话，也算我一个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250230
					]
				},
				{
					"id": 400250230,
					"content": "欸，真的吗？谢谢你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250231
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250231,
					"content": "那我们现在就去找乔尔吧。我还叫上了一位朋友，时间差不多也快到了，她应该会很适合这次的活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250232
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250232,
					"content": "塞琉斯会长，那我们就先过去了哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400250233
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400250233,
					"content": "没问题，放心去吧。我这边还要再清点清点，出发前再来叫你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 400250229,
					"content": "能帮安柏忙的话，也算我一个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250230
					]
				},
				{
					"id": 400250222,
					"content": "可是乔尔的父亲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250223
					]
				},
				{
					"id": 400250208,
					"content": "大家为什么聚在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400250209
					]
				}
			]
