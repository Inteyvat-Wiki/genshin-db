	"talks": [
		{
			"id": 4002501,
			"completionStepIds": [
				4002502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
