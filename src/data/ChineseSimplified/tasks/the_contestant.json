			"dialogs": [
				{
					"id": 735220101,
					"content": "又到了桑歌玛哈巴依老爷的情报售卖时间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220102
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220102,
					"content": "两位客人要不要买一份最新的情报呢？让我看看，这次的情报不怎么重要，所以只卖五十万摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220103
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220103,
					"content": "相较于之前的价格，竟然直接便宜了一半，真是太划算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220104
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220104,
					"content": "可以送我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735220105
					]
				},
				{
					"id": 735220105,
					"content": "咳咳，竟然一口气砍到零摩拉，真是出我所料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220106
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220106,
					"content": "不过谁叫我是好心的桑歌玛哈巴依老爷呢？既然你如此感兴趣，那我就免费告诉你，但你可不能外传啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220107
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220107,
					"content": "听说二十年前有一位参赛者，参加比赛后性格却突然发生了很大的转变！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220108
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220108,
					"content": "然后呢，貌似有人曾在阿如村见过他哦。不知道他最后去了哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220109
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220109,
					"content": "免费消息到此为止，想听后续的话，请付两百万摩拉。谢谢惠顾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220110
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 735220110,
					"content": "怎么想都不划算！我们自己去阿如村打听一下好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7352202,
			"completionStepIds": [
				7352202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352202",
							"2"
						],
						"stepId": 7352202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽什蒂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735220201,
					"content": "二十年前…确实有一位年轻人曾经来过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220202
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220202,
					"content": "那时候，生活比现在要艰苦多了。贫穷、疾病、愚昧…时刻困扰着我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220203
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220203,
					"content": "那名年轻人，明明是教令院出身，有着大好的前程，却甘愿跑来我们这里受苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220204
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220204,
					"content": "他教给我们知识，告诉我们如何应对沙暴与魔物；他自掏腰包为我们添置了很多药材，照顾病人也是亲力亲为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220205
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220205,
					"content": "听上去是个大好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735220206,
					"content": "是啊…只可惜好人不长命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220207
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220207,
					"content": "他总是皱着眉，没人知道他在为什么发愁。大家就想啊，会不会是他要离开了？这里太穷了，甚至没法好好招待他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220208
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220208,
					"content": "不过，也有很多人说他原本就有些疯癫。比如他有时候还会给孩子们讲故事，讲自己小时候曾经教一种奇特生物写字的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220209
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220209,
					"content": "后来，他经常离开村子，去沙漠里考察。有一次我问他在找什么，他说自己要与那伽什么团的人聊聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220210
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220210,
					"content": "再后来，听说他死在了流沙中。据说是考察的路上遇见了陷入流沙的商队，他救了很多人，自己却没回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220211
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220211,
					"content": "当时，家里还有他没写完的半封信，是写给他的孩子的。他死后，我的儿子将那封残信带在身上，想着今后或许有机会帮他转交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220212
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220212,
					"content": "那封信…还在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735220213,
					"content": "不在啦。不在了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220214
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220214,
					"content": "为了过上好一点的生活，我的儿子当了佣兵。几年前的一场混战里，他丢了命，身上的东西也被搜走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220215
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220215,
					"content": "一晃都过去这么些年了啊。不知道他的孩子有没有健健康康地长大、会不会记恨他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220216
					],
					"speakerTitle": "丽什蒂"
				},
				{
					"id": 735220216,
					"content": "这些事，已经没有多少人知道了。我也老了，估计很快就会忘干净了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽什蒂"
				}
			]
		},
