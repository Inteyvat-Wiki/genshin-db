			"dialogs": [
				{
					"id": 741361001,
					"content": "艾德温…我就知道！是你把他们引过去…你嫉妒我！担心我的研究成果超越你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 741361002,
					"content": "是啊，我真嫉妒你这副无知又不自知的样子，怪不得你之前在科学院里活得那么好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361003,
					"content": "要是舒瓦瑟尔看见这个场景，一定会昏过去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741361004,
					"content": "他最好别醒过来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "你就跟着他们回科学院认错吧，我要继续去研究了…你没弄坏我的研究设备吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361007,
					"content": "谁让你回去研究了？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "你们还要做什么？难道要把我抓回科学院，那样我还怎么进行研究？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361010,
					"content": "雷蒙多那个蠢货一定把科学院里变得一团糟，还有舒瓦瑟尔那个白痴，哎哟…想想都头疼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361011,
					"content": "把科学院变得一团糟的人就是你啊！别推卸责任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741361012,
					"content": "我？好吧，现在科学院把中央实验室爆炸的责任全甩在我头上了，对吧？我当时都不在科学院里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361013,
					"content": "科学院里的蠢货太多了，就连倒杯咖啡都可能让研究设备停机，弄出一场爆炸也不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361014,
					"content": "那你为什么不解释清楚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "解释？我才不给他们做替罪羊呢。我还有很多研究要做，绝不能浪费时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361016,
					"content": "所以，你就和那个叫做孔锡尼的人搅在一起了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741361017,
					"content": "喔，孔锡尼也好不到哪去…他连一台精密装置都买不到，全都要我自己亲手做。好在他愿意出钱，我的研究还算顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361018,
					"content": "但没想到，亲爱的纳克先生抱着那台连功能都不完整的核心原型机来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361019,
					"content": "我已经改造过它了！我用的技术，你绝对开发不出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 741361020,
					"content": "哈、哈、哈。纳克先生，现在没有孔锡尼需要你讨好，别骗自己了。你连一点研究员的自尊也没有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361021,
					"content": "你…！那些不完整的功能，只是因为你不知道如何弥补！我知道，我能做到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 741361022,
					"content": "是啊，现在你就拿着这台垃圾回科学院继续刨食吧，我有更重要的事要忙。那个叫菲什么的…这件事交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361023,
					"content": "这两个人怎么自顾自地吵个不停…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741361024,
					"content": "…够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361025,
					"content": "干什么，能不能别浪费我的时间了，我还要继续工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361026,
					"content": "我说…够了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361027,
					"content": "艾德温·伊斯丁豪斯！你，是科学院爆炸的元凶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361028,
					"content": "纳克！你，盗窃了科学院资产！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361029,
					"content": "还让科学院又爆炸了一次。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "你们伤害了科学院的利益…作为枫丹科学院特别调查员，我将把你们全部带回科学院，等待进一步处置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741361031,
					"content": "可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "纳克"
				},
				{
					"id": 741361032,
					"content": "喔，拜托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741361033,
					"content": "我和勒马克会帮忙押送这两个人的。忙前忙后了这么久…科学院总该给我们点报酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741361034,
					"content": "记住，在路上的时候把嘴闭紧点。不然你们就要提前到达终点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741361008,
					"content": "你给我站住，站好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "我也快要昏过去了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
