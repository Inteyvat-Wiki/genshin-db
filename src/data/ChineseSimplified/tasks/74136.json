			"dialogs": [
				{
					"id": 741363401,
					"content": "你怎么…你果然回来了，瞧瞧，我就知道你们找五圈也找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741363402,
					"content": "实在不行，坐下来喝杯茶吧，我刚好买了五个茶杯…和几个碗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741363403,
					"content": "您真的很喜欢五这个数字，艾德温先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "勒马克"
				},
				{
					"id": 741363404,
					"content": "喔，这可是一个具有神奇魔力的数字，只要使用恰当，就能打开灵感的大门啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741363405,
					"content": "顺便一提，灵感的大门一共有五扇，你至少要拧五次门把手…五！知道吗？五次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "艾德温·伊斯丁豪斯"
				},
				{
					"id": 741363406,
					"content": "抱歉，我现在真的很想给您五拳，请您捂紧自己的嘴，好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒马克"
				}
			]
		}
	]
