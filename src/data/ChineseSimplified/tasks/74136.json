			"dialogs": [
				{
					"id": 741360601,
					"content": "好大一片空地，里面…什么也没有。我们不会扑了个空吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741360602,
					"content": "这周围的植物被特意清理过，修剪的痕迹还很新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741360603,
					"content": "…亏我还专门为他趟这摊浑水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741360604,
					"content": "总之，我先一个人下去看看，你们陪着科学院小姐，如果情势太坏…就赶紧带她走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741360605,
					"content": "但这里什么东西也没有，情势再坏应该也坏不到哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741360606,
					"content": "吱——嘎嘎——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741360607,
					"content": "呜哇！小心那边！有东西冲过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
