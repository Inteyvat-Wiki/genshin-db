			"dialogs": [
				{
					"id": 741360401,
					"content": "原来他之前一直重复着「五」，是为了告诉我们解谜的方式啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741360402,
					"content": "明明直接告诉我们就好了，为什么要这么别扭呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741360403,
					"content": "哼，谁知道这家伙在打什么鬼主意…不过，他好像一直在引着我们去找纳克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741360404,
					"content": "这些潜水服，就放在那间屋子旁边，简直就像是专门为我们准备的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741360405,
					"content": "看来，是他找到了我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "没有研究价值…我…我花了那么多心思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "菲希里耶"
				},
				{
					"id": 741360408,
					"content": "菲希里耶小姐…碎碎念了一路呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741360409,
					"content": "#不过…{NICKNAME}，你有没有一种被人盯着的感觉？我、我总觉得背后毛毛的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741360410,
					"content": "…我走第一个，继续往里面探一探吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "肖西韦尔"
				},
				{
					"id": 741360406,
					"content": "无论如何，先处理纳克。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
