					"科里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "怎么了，你也对力量训练营有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150102,
					"content": "器械可以随意试用，但看你细胳膊细腿的，可别把自己弄伤了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150103,
					"content": "我每天运动量可大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "真的吗？在和我吹牛之前，不如先和旁边的大方块较较劲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150106,
					"content": "<color=#00E1FFFF>攻击</color>或者<color=#00E1FFFF>撞击</color>大方块，根据力量的大小就能得到不同的分数。让我看看你有多大能耐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科里"
				},
				{
					"id": 752150104,
					"content": "我能一拳打飞丘丘人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
