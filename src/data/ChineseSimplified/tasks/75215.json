			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"科里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "不会吧，你居然把大方块撞碎了一角？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150202,
					"content": "上一位能有这种力气的人还是瓦雷莎前辈…看来你和她一样，都是天赋型选手啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150203,
					"content": "还是有点费劲的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "真是人不可貌相啊，有机会的话真想请你来当教练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150206,
					"content": "对了，这瓶沃陆果饮据说能提升运动效果，学员们都爱喝，你也拿去尝尝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科里"
				},
				{
					"id": 752150204,
					"content": "这种程度的话，轻轻松松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
