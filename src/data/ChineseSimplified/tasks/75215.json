			"dialogs": [
				{
					"id": 752150301,
					"content": "招揽新人其实不难，问题在于训练一段时间之后，就有不少人找借口请假，或者干脆不来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150302,
					"content": "教练为了提高大家的积极性，想了很多办法，那个方块挑战就是其中一项。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150303,
					"content": "结果有些人为了提高分数，一个劲地往大方块上面撞，最后搞得鼻青脸肿的，请假的人更多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科里"
				}
			]
		},
