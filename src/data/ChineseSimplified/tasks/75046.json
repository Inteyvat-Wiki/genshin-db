					"乌鲁班巴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "呜噜噜——噜——快回来吧，呜噜噜——噜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460102,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "呜噜噜——噜——唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460104,
					"content": "我不好，这里，伤心，好不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460105,
					"content": "就只是出去买点干草的功夫，我养的另外八只小突角龙就不知道跑哪里去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460106,
					"content": "它们还那么小，要是在外面被丘丘人欺负了怎么办？迷路了怎么办？被困住了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460107,
					"content": "好心人，你有没有见过我养的小突角龙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460108,
					"content": "它们长什么样子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "这八只小突角龙的妈妈由我一手带大，跟我的女儿没什么区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460110,
					"content": "她可是沃陆之邦数一数二的美龙，还拿过我们地区选美大赛的特等奖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460111,
					"content": "我这八只小调皮鬼遗传了它们妈妈的美貌，白皙透粉的皮肤，完美对称的扇形角上有一抹紫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460112,
					"content": "如果你见到它们，想点办法让它们回到我这儿来吧，拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460113,
					"content": "我的小龙…爷爷再也不凶你们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "乌鲁班巴"
				},
				{
					"id": 750460118,
					"content": "我会留心的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "谢谢你，好心人。你今天卧推一定破记录，引体向上绝对不抽筋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌鲁班巴"
				}
			]
		},
