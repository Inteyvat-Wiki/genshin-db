					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "饭送到了没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030602,
					"content": "送到了，他说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "哼，你别说了，那个吃白食的肯定又要说谢谢之类的穷酸话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030604,
					"content": "这些年听着我耳朵都起了茧了，谢什么谢，有什么好谢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030605,
					"content": "有空说谢谢，有空去钓鱼，不如来客栈打工赚钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030606,
					"content": "啧，我和你说这个做什么，这是给你的报酬，拿好了，忙你的去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
