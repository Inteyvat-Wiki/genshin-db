			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "快点去吧，免得那个吃白食的饿出个好歹来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030402,
					"content": "你为什么要送饭给他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "问这个做什么，他个孤家寡人，整个璃月港只认识我一个人，也只敢到我这来蹭吃蹭喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030404,
					"content": "原因？你还要什么原因，我乐意管他饭，行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030405,
					"content": "再说，要是我不管他的饭，他再去荻花洲发一次疯怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030406,
					"content": "你怎么还在这！快去快去！磨蹭什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
