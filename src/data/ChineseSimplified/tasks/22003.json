					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "你在这等等，我把菜做好你顺便送过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030302,
					"content": "你这是什么表情，我不会让你白打工，该给多少我就给你多少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030303,
					"content": "行了，你把饭给那个吃白食的送过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030304,
					"content": "那家伙叫<color=#00E1FFFF>江雪</color>，一直在水边钓鱼，一眼就能看见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
