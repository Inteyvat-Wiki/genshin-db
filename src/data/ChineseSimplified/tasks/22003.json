				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "哼，也亏得他能腆着个脸，蹭吃蹭喝这么久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "我？我正在给某个吃白食的家伙做饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030104,
					"content": "成天一副游手好闲的样子，来客栈帮个工都不肯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030105,
					"content": "天天钓鱼，也没见着钓出个多大的鱼来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030106,
					"content": "要是没我，早晚得饿死在客栈旁边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030107,
					"content": "算了，不说了，反正说了他也听不到，听到了也装作听不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030108,
					"content": "你有空的话，去帮我找点菜来吧，我这的菜有点不够用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030109,
					"content": "也不用多，就找一个<color=#00E1FFFF>绝云椒椒</color>，和一个<color=#00E1FFFF>莲蓬</color>来就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "行，你找了就回来，我赶紧把菜给做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030112,
					"content": "客栈里有很多菜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "那是老板花的钱，他个吃白食的给钱了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030114,
					"content": "这些菜都是我自己出的钱…哼，我真是欠了他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030115,
					"content": "行了，你快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
