			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030501,
					"content": "咦？你来找我有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030502,
					"content": "这是言笑给你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "我说这股香味是从哪来，这厨子的手艺果然不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030504,
					"content": "谢谢你，回去的时候，也记得帮我谢谢他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 2200306,
			"completionStepIds": [
				2200305
