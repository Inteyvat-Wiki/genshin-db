			"dialogs": [
				{
					"id": 220030201,
					"content": "你找好菜了没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030202,
						220030203
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030202,
					"content": "找好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220030203,
					"content": "没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030204
					]
				},
				{
					"id": 220030204,
					"content": "你…你尽量快点，不然那个吃白食又得饿出个好歹来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200303,
			"completionStepIds": [
