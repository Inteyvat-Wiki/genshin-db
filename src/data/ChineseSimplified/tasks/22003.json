					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030701,
					"content": "唔？快些回去吧，那厨子等急了，说不定又要发飙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030702,
					"content": "他为什么要送饭给你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "我们是…认识了很久的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030704,
					"content": "嗯…我之前去了荻花洲一趟，做了件我必须做的错事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030705,
					"content": "整座璃月港，只有这家客栈让我住，那个厨子管我的饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030706,
					"content": "再往下讲就没完了，而且你也没那么多时间听我讲故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030707,
					"content": "好了，快回去吧，那厨子一向是没什么耐心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		}
	]
