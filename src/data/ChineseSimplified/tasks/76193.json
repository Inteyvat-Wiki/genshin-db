			"dialogs": [
				{
					"id": 761930130,
					"content": "（欸？那该不会是…是、是美露莘！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930101
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930101,
					"content": "呜啊！真的是美露莘！可爱的美露莘，乖乖的美露莘，小小的美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930102
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930102,
					"content": "欸…？你是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930103
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930103,
					"content": "那个…我可以摸摸你吗？我一直都很好奇，像美露莘这样又可爱又聪明的小家伙，摸起来到底是什么感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930104
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930104,
					"content": "是滑滑的，还是软软的，还是毛茸茸的…嘿嘿，别害怕喔，真的只是摸摸而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930105
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930105,
					"content": "欸、欸…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930106
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930106,
					"content": "请保持冷静，小姐，以免触犯法典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930107
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 761930107,
					"content": "玛梅赫小姐是枫丹廷的公民。未经允许的身体接触可能会招致误会，并导致包括三年以上监禁及永久禁止入境在内的严重后果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930108
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 761930108,
					"content": "哇啊——！会、会动还会说话的机械——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930109
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930109,
					"content": "…咳！抱歉抱歉，因为美露莘实在是太可爱了，所以我情不自禁就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930110
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930110,
					"content": "我叫莉奈娅，是冒险家协会的顾问！真的不是什么奇怪的人喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930111
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930111,
					"content": "否定。任何奇怪的人都不会自称是「奇怪的人」。这是基本的逻辑推理，尊敬的莉奈娅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930112
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 761930112,
					"content": "呜…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930113
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930113,
					"content": "不可以随便说别人是奇怪的人啦，西摩尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930114
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930114,
					"content": "个子不怎么高的妖精小姐，颜色很漂亮。虽然不像父亲{RUBY#[D]厄里那斯}大人，但是暖暖的，很好看。所以不是奇怪的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930115
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930115,
					"content": "否定。除紫色外，颜色通常与立场无关。这是基本的逻辑推理，玛梅赫小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930116
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 761930116,
					"content": "…不是说衣服的颜色啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930117
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930117,
					"content": "咦？为什么要排除紫色来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930118
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930118,
					"content": "总之…你好，莉奈娅。我叫玛梅赫，是从枫丹来的旅行画家。他是西摩尔，是我的好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930119
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930119,
					"content": "没想到会在这种地方遇到其他人。莉奈娅，也是来取材的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930120
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930120,
					"content": "取材…嗯，让我想想，增补图鉴应该也能算是取材吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930121
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930121,
					"content": "向玛梅赫说了那头粉色霜鳍鲸的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761930122
					]
				},
				{
					"id": 761930122,
					"content": "不过…嘿嘿，说不定玫熙说得对，那头霜鳍鲸确实是会给人带来好运的动物呢！甚至还能让我见到可爱的美露莘——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930123
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930123,
					"content": "请保持冷静，小姐，以免触犯法典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930124
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 761930124,
					"content": "我、我知道啦！不会随便摸摸的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930125
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930125,
					"content": "原来如此。莉奈娅，很喜欢动物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930126
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930126,
					"content": "是的！呜呜，要是我也能像美露莘一样，在水里游得那么快就好了！那些霜鳍鲸玩得好开心，我也想和它们一起玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930127
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 761930127,
					"content": "嗯…那就把这幅画送给莉奈娅吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930128
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930128,
					"content": "虽然不能让你在水里游得很快。但是，挂在房间里，说不定也会有「和霜鳍鲸一起玩」的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930129
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761930129,
					"content": "哇啊，谢谢你！好漂亮的画！等回去以后，我一定要给「斯佩兰扎」的大家都看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈娅"
				}
			]
		}
	]
}