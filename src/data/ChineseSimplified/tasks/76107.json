			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "我就是你们的执行官「木偶」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "欸？原、原来我们现在用这套说法了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761071103,
					"content": "哼，我欣赏你的胆识，但这种明目张胆的谎言，也未免太低估我们愚人众了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "我是「木偶」…特聘的研究员。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "特聘研究员？那位大人对机械体和月矩力的研究都已经到了登峰造极的程度，很难想象她还需要外聘研究员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "科学研究是建立在合作的基础上的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "的确，我也为那位大人搜集过不少枫丹科学院的研究报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "里斯托"
				},
				{
					"id": 761071303,
					"content": "既然您是这方面的专家，那么，这台巡陆艇发生的故障，对您来说解决起来一定十分容易了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "呃…我专注于理论研究…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "原来是这样，月矩力的理论研究是最艰深的学问，太了不起了！而维修巡陆艇相对来说更偏应用型，两者的确不能混淆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "里斯托"
				},
				{
					"id": 761071403,
					"content": "不过，「木偶」大人此刻不在这里，您可以先去找阿扎莉娅长官，或许她会知道接下来的安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "那当然，交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "在巡陆艇身上叮叮咣咣敲击了几下，这下彻底不动弹了…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "好像…完全坏掉了？现在要怎么办哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761071504,
					"content": "哼，从刚才我就觉得你不对劲。真正的研究员怎么会夸下这种海口？你果然是冒牌的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
