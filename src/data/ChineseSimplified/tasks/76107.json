					"里斯托"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "可以说我就是她的老师也不为过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "噢噢！我曾经为那位大人搜集过不少枫丹科学院的研究报告，她对莫索博士的研究成果赞不绝口。莫非您就是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "里斯托"
				},
				{
					"id": 761071603,
					"content": "咳咳…嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "没、没错，原来莫索博士的名号已经传到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761071605,
					"content": "哼，据我所知，莫索博士三十年前就逝世了。那就请你也步上他的后尘吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里斯托"
				}
			]
		},
		{
