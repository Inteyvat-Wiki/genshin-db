			},
			"dialogs": [
				{
					"id": 728130601,
					"content": "呜…我就是想写一篇论文，怎么又被关起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				}
			]
		},
		{
			"id": 7281307,
			"completionStepIds": [
				7281308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281308",
							"2"
						],
						"stepId": 7281308,
						"stateName": "QUEST_STATE_UNFINISHED"
