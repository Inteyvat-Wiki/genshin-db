				{
					"id": 728130901,
					"content": "你回来了，旅行者，我已经把那个肥料堆处理掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130902
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130902,
					"content": "唉，我得再找个地方实验了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130903,
					"content": "咦？这位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130904,
					"content": "这是五郎给你找的帮手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "你好，我叫爱拉尼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130909,
					"content": "那个…总之，那位五郎「大将」让我来协助你进行肥料的研究工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130910,
					"content": "之后，我们就好好合作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130911,
					"content": "是吗…太好了！要是真能成功把肥料制作出来，那海祇岛上就能种更多的作物了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130912,
					"content": "记得把肥料堆放远点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "啊？哦…哦，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130914,
					"content": "总之，我们就好好合作吧！请多多指教了，爱拉尼小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130915,
					"content": "好的，我一定会努力的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130916,
					"content": "为了我的论文，我一定会努力的，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130906,
					"content": "这是来自须弥的肥料专家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "你好，我叫爱拉尼…等一下，谁是肥料专家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130908
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130908,
					"content": "我就是…略微了解一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "爱拉尼"
				}
			]
