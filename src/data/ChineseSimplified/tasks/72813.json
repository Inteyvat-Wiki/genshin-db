			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"考什克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "图腾的含义…嗯？旅行者，你找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130702,
					"content": "关于爱拉尼的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "你说爱拉尼来海祇岛了？奇怪，她怎么来这里了…她不是应该去璃月吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130704,
					"content": "她被士兵抓住了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "什么？唉…在这种情况下来海祇岛…她当然会被怀疑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130706,
					"content": "先不说这个了，我们赶紧过去吧，这孩子太莽撞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "考什克"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281309",
							"2"
						],
						"stepId": 7281309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"考什克",
					"爱拉尼",
					"五郎",
					"博行",
					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "爱拉尼，真的是你，你、你怎么来稻妻了？你不是应该在璃月吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130802,
					"content": "呜…这个说起来就没完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130803,
					"content": "考什克先生，你认识爱拉尼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130804,
					"content": "您是…噢，您是五郎大将吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130805,
					"content": "您说得没错，爱拉尼和我一样，都是在教令院求学的学者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130806,
					"content": "我们各自为了不同的课题离开了教令院。没想到会在这里遇见她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130807,
					"content": "但是…你们学者，都可以自由离开教令院吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130808,
					"content": "也不能说都能「自由离开」。我和爱拉尼都属于「帝利耶悉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130809,
					"content": "对我们来说，在外游学是研究的一部分，所以离开教令院是被允许的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130810,
					"content": "五郎大将，我可以为爱拉尼做担保，你看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130811,
					"content": "有了您做担保，那就没问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130812,
					"content": "呼…得救了…谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130813,
					"content": "博行，大久保，你们也去忙自己的吧，这里没事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130814,
					"content": "是，大将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130815,
					"content": "是，大将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130816,
					"content": "抱歉了，爱拉尼小姐，之前把你当做可疑人士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130817,
					"content": "嗯…虽然你的嫌疑已经洗清了，但是你擅自闯入海祇岛，给我们也添了很多麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130818,
					"content": "欸？有、有什么惩罚吗？我可没有带多少摩拉，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130819,
					"content": "既然你之前说，你是一个肥料推销员…而且，还是一个有学者身份的肥料推销员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130820,
					"content": "那正好，我们这边有一个叫做岩田的人，正在研究肥料的事，爱拉尼小姐，请你去协助他一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130821,
					"content": "假如你能帮助他制作出不那么「扰民」的肥料，那你就可以像考什克先生一样，在这附近自由研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130822,
					"content": "肥、肥料？不，那个，我只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130823,
					"content": "她没问题的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "爱拉尼，这可是个取材的好机会，你既然来了稻妻，那就证明，你的论文应该还…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130826,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130827,
					"content": "教令院的毕业准则你也知道，要是连续几年都没法毕业的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130828,
					"content": "我、我做！我做就是了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130829,
					"content": "我也在瓦希德先生那边了解过肥料了…看我一口气搞定它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130830,
					"content": "毕业真是催人成长啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "那这件事就这么定了，肥料的事就拜托你了，爱拉尼小姐，我要先去处理其他的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130833,
					"content": "对了，你们记得告诉岩田，让他把那个…肥料堆，稍微放远一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130834,
					"content": "那我也继续去研究去了，爱拉尼，如果有什么问题的话可以来问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "考什克"
				},
				{
					"id": 728130831,
					"content": "毕业真是最强动力啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "交给你了，爱拉尼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
