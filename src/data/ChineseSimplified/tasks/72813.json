			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博行",
					"爱拉尼",
					"五郎",
					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "老实点！别乱动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130502,
					"content": "我、我也没动啊！你们听我解释，我真的是教令院的学者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130503,
					"content": "你刚才不是说，你只是来推销肥料的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130504,
					"content": "我…教令院的学者也可以推销肥料啊！你们听我解释…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130505,
					"content": "就是这个人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130506,
					"content": "是，大将。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130507,
					"content": "我们抓到她的时候，她正在外面鬼鬼祟祟地游荡，还不停地记着什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130508,
					"content": "大将，她肯定是幕府那边派来刺探情报的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130509,
					"content": "我不是！我没有！都说了我是个学者，正在为论文取材啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130510,
					"content": "别开玩笑了！为了那个什么论文，你连战场都敢来吗？肯定是有什么其他的目的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "博行"
				},
				{
					"id": 728130511,
					"content": "呜…除了论文之外，我怎么敢还想着其他的目的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130512,
					"content": "你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "旅行者！太好了，你在这，你快和他们说说，我不是坏人，我只是来写论文的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 728130515,
					"content": "你认识她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130516,
					"content": "算是吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "须弥的学者…居然能为了「毕业」这件事，做到那种地步吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130518,
					"content": "不过，听你的说法，你似乎也不知道她的底细。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130519,
					"content": "至于「从须弥来的学者」这件事，你也只是从她嘴里听说的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130520,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "唔…这些证据，实在都是缺乏可信度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130522,
					"content": "但有你担保，我也愿意相信，她应该不是个坏人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130523,
					"content": "大将，我倒是有一个想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130524,
					"content": "您记得考什克吗？那位一直在研究我们岛上的文化和历史的学者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130525,
					"content": "他之前就一直待在这里，学者的身份也很可信…不然，让他来辨认一下，这位…肥料推销员，到底是不是学者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130526,
					"content": "嗯，这样不错。旅行者，能麻烦你跑一趟，把考什克先生带过来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130527,
					"content": "为了防止意外，我会在这里守着这位…肥料推销员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130528,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "那就拜托你了，请快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130513,
					"content": "爱拉尼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
		{
			"id": 7281306,
