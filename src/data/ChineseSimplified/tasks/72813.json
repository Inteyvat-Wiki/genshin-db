					"大久保大介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "谢谢，谢谢你，旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130302,
					"content": "我肥料刚做到一半，那些魔物就突然不知道从哪冲了过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130303,
					"content": "真是莫名其妙…还好你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130304,
					"content": "也许是那堆肥料的原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "是、是吗？不过，我听说，有这种气味就是成功的前兆啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130306,
					"content": "先不说这些了，来来，你来看看我做的肥料堆，我来打开给你详细讲讲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130307,
					"content": "给我等一会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130308,
					"content": "咦？五郎先生，您今天怎么有空过来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130309,
					"content": "是在巡逻吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "我是在…呃…先不说这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130311,
					"content": "这堆…东西，是你们做的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130312,
					"content": "哈哈哈，是的，这堆肥料正是我和这位旅行者做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130313,
					"content": "五郎先生，难道你也是想要看看这肥料的情况，所以才过来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130314,
					"content": "嘿嘿，你来得正好，我们现在就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130315,
					"content": "等一会！我不是来看这个的，不对，我就是来看这个的…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130316,
					"content": "五郎一脸无法忍受的表情啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728130317,
					"content": "我们先离这堆肥料远点吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "好，我们先去旁边说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130319,
					"content": "五郎先生，到底您是来做什么的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 728130320,
					"content": "最近，很多居民都说闻到了一股可怕的异味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130321,
					"content": "为了保险起见，我就稍微侦察了一下，循着气味一路找了过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130322,
					"content": "然后，就找到了你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130323,
					"content": "岩田，我听说你一直在研究肥料，但你这种制作方法，实在是太…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130324,
					"content": "扰民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "没错。无论如何，岩田，你先把肥料堆撤掉，关于肥料的事，我会想想其他的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130327,
					"content": "大将！五郎大将！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130328,
					"content": "我在，怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130329,
					"content": "大将，我们在外围抓到了一个鬼鬼祟祟的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130330,
					"content": "那个家伙鬼鬼祟祟的，一个劲说自己是什么…肥料的推销员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130331,
					"content": "我们觉得不对劲，就把那个人给扣了下来，请您赶快过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 728130332,
					"content": "又是肥料，我今天真是和肥料过不去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130333,
					"content": "我知道了，马上就过去，你先到那边维持住秩序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130334,
					"content": "岩田，你先处理好肥料堆的事情，后面的事后面再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130335,
					"content": "旅行者，你也一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 728130336,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "推销肥料的人？总感觉，有一种熟悉的感觉…但是又想不起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728130339,
					"content": "算了，总之先过去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728130337,
					"content": "肥料…推销员？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "刺激。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
