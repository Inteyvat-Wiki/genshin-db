			"dialogs": [
				{
					"id": 736860501,
					"content": "天色不早了，我和千里小姐就先回去了。你们这两天也要好好休息，不要太劳顿了。我们比赛当天再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860502
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860502,
					"content": "嗯，绫华，千里，我们比赛当天见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7368606,
			"completionStepIds": [
				7368609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
