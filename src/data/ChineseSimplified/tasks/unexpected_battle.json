							"2"
						],
						"stepId": 7368601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"忠常",
					"忠明"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860101,
					"content": "师兄，多年来我们情同手足，这次，我本来是不想以真剑对决的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860102
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860102,
					"content": "别说这种软弱的话了，你我之中只能有一个胜者，来吧，师弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860103
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860103,
					"content": "欸，这两个人怎么突然在路上打了起来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860104,
					"content": "嗯？有路人？你们两个，给我走开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860105
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860105,
					"content": "我们「狐野一刀流」直传弟子要在此对决，不通剑术的外人别旁观碍事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860106
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860106,
					"content": "呜哇，好不讲理，挡在路中间的是你们两个才对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860107,
					"content": "#而且，什么叫不通剑术？要说到剑术，我身边的这位{NICKNAME}可是很强的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860108,
					"content": "哦？又是一个来抢夺资格的。既然如此，师兄，我们还是先联手对外吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860109
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860109,
					"content": "正有此意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "忠明"
				}
			]
		},
		{
			"id": 7368602,
			"completionStepIds": [
				7368603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368603",
							"2"
						],
						"stepId": 7368603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斑目百兵卫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860201,
					"content": "旅行者，派蒙，好久不见。真不凑巧，今天社奉行大人和神里小姐都有公务在身，目前不在府上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860202
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860202,
					"content": "不是哦，今天我们不是来找他们的，而是要打听社奉行举办的「演武传心剑道大赛」活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860203,
					"content": "啊，旅行者是想报名参加比赛？实在不好意思，因为这次赛事的报名人数众多，参赛资格券早在上周就已经发完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860204
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860204,
					"content": "不过如果你们是想要最后那场表演赛的门票，我现在去想想办法，或许还能帮你们弄到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860205
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860205,
					"content": "不不，你误会了。其实我们今天偶然得到了一张参赛券，但还没决定要不要参加，所以就先来这里打听一下情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860206,
					"content": "不过听你刚才的意思，这个比赛好像相当火爆啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860207,
					"content": "确实，「演武传心」本就是稻妻历史悠久的剑道赛事，对武人来说，参加比赛既是检验自身实力的好机会，更是一种荣誉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860208
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860208,
					"content": "将军大人也希望借此机会，让更多人了解剑道的魅力，本次大赛就引入了不少新形式，普通民众们都很感兴趣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860209
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860209,
					"content": "旅行者，既然你手里已经有参赛券，就考虑考虑参加比赛怎么样？毕竟机会难得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860210,
						736860211
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860210,
					"content": "好的，那我考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860212
					]
				},
				{
					"id": 736860212,
					"content": "哦对了，你们既然是今天才听说「演武传心」，那应该还不知道吧？其实神里小姐她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860213
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860213,
					"content": "这么好的机会，有什么可犹豫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860214
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736860214,
					"content": "如果你们并不以参与「演武传心」为荣，就没必要占着这张参赛券，盼着得到参赛资格的人可有的是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860215
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736860215,
					"content": "宏达，你这是在说什么呀，如此出言不逊可不是我们的待客之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860216
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860216,
					"content": "#斑目，不是我有意羞辱{M#他们}{F#她们}。其实正相反，本来我是很想见识见识这位旅行者的身手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860217
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736860217,
					"content": "我们全府上下都听说过你的名字，小姐她本人也十分看重你，我还以为你是个了不起的英杰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860218
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736860218,
					"content": "现在看来也不过如此，既没气魄，剑术本领嘛…大概也挺一般的，要不然早就干脆参赛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860219
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736860219,
					"content": "哎呀宏达，旅行者又不是武家出身，想法肯定会有差异。再说了，气魄和剑艺，又不是一定要靠比赛体现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860220
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860220,
					"content": "真是岂有此理，今天一连碰到的两拨人居然都这么不会说话，可恶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860221,
					"content": "#除了饿肚子之外，派蒙我最讨厌的事之一，就是{NICKNAME}被根本不了解{M#他}{F#她}的人看轻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860222,
						736860223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860222,
					"content": "派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860224
					]
				},
				{
					"id": 736860224,
					"content": "这个宏达根本就不了解你，居然就说你又没气魄又没本领，我好生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860225,
					"content": "我要给他起个难听的绰号，就…就叫他「没眼力」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860226,
					"content": "话倒是不少，本事可不是耍耍嘴皮子就能证明的。我宏达是个货真价实的武人，不靠吹牛皮博名声，就不奉陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860227
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736860227,
					"content": "唉，旅行者，真是不好意思，宏达就是这种心直口快的类型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860228
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860228,
					"content": "没关系，我会用实力让他心服口服。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860229
					]
				},
				{
					"id": 736860229,
					"content": "这是准备要参赛了吗？太好了，我举双手赞成！让那个宏达看看你的本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860230,
					"content": "开赛时间是两天后，赛场在离岛。刚才没来得及告诉你们，其实今天小姐就是前往离岛，和柊千里小姐核对比赛的各项事宜去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860231
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 736860231,
					"content": "是吗？既然这样，我们就去离岛和绫华见一面吧，也可以顺便问问她关于「演武传心」的其他事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860223,
					"content": "我已经习惯了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860224
					]
				},
				{
					"id": 736860211,
					"content": "但我们还有其他事情要做…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860212
					]
				}
			]
		},
		{
			"id": 7368603,
			"completionStepIds": [
				7368604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368604",
							"2"
						],
						"stepId": 7368604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华",
					"柊千里",
					"小野寺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860301,
					"content": "绫华，千里——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860302,
					"content": "旅行者，派蒙，好久不见，原来你们最近也在稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860303
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860303,
					"content": "嗯，其实我们决定参加「演武传心剑道大赛」了，听说你们正在离岛做准备，所以就过来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860304,
					"content": "这真是巧了，我们才聊完「代神使」的工作，刚说到旅行者会不会对「演武传心」感兴趣呢，你就出现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860305
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860305,
					"content": "「代神使」？那是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860306,
					"content": "欸，你们还不知道？难道说，你们不是因为收到绫华小姐的信才赶回稻妻的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860307
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860307,
					"content": "咦，信？什么信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860308,
					"content": "啊，没什么，你们别在意。派蒙，你刚刚是问「代神使」对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860309
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860309,
					"content": "对，那是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860310,
					"content": "「代神使」是「演武传心」中一项很特殊的职责。说起这个，就不得不提起这一赛事的由来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860311
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860311,
					"content": "「演武传心」起源于稻妻古代传说，据说在很久以前，剑术冠绝稻妻的武人，将获得面见将军大人，与之切磋剑术的殊荣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860312
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860312,
					"content": "只不过，将军大人的实力实在高出人类太多，如果直接与武人较量，这场对决恐怕瞬间就结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860313
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860313,
					"content": "因此，将军大人派出自己的眷属作为接引武人的使者，并在切磋中为武人提供援护，让两人一同与自己对战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860314
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860314,
					"content": "由于将军大人选择以演武的形式，将自身的技艺与守护稻妻的意志传达给子民，因此这场切磋被称为「演武传心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860315
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860315,
					"content": "后来，「演武传心」的传说演变为了剑道比赛，这场神明传授技艺的切磋，也作为赛事最后的「表演赛」被保留了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860316
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860316,
					"content": "通过它，后世就能了解「演武传心」的由来，也能了解到武艺所承载的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860317
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860317,
					"content": "听起来是很重要的表演呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860318,
					"content": "是的。现在的表演赛上，将军大人虽然不会亲自出席，但会派遣特使代表自身参战，以示神威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860319
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860319,
					"content": "饰演「武人」的，自然就是大赛的胜者了；「神明眷属」会由一位官家出身的剑士饰演，这一职责也被称为「代神使」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860320
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860320,
					"content": "本次，就是由我来担任「代神使」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860321
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860321,
					"content": "原来如此！我总算知道这次比赛那么火爆的原因了！毕竟绫华在稻妻民众眼里，就是很有人气的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860322,
					"content": "派蒙说得没错，白鹭公主虽然会出席一些祭典仪式，但能近距离见识到她超群剑术的场合可不多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860323
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860323,
					"content": "将军大人说，这次要打造面向大众的赛事，要选一位有号召力的形象大使。既然这样，「代神使」一职也就非绫华小姐莫属了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860324
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860324,
					"content": "哦对了，这位是八重堂的小野寺先生，专门负责筹备各类活动，也是我们的外援。最早就是他建议由绫华小姐来担任「代神使」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860325
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860325,
					"content": "除此之外，他提出的「扩大受众面」、「提升话题度」这两个方案，也大大增加了赛事的热度，真是帮了大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860326
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860326,
					"content": "听上去好专业！这些方案都是什么意思呀，快说给我听听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860327,
					"content": "说到「扩大受众面」，自然是要让更多的人能参与到比赛中来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860328
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860328,
					"content": "过去演武传心的参赛者，必须是稻妻剑道流派的人。这次则不同，不论国籍与身份，只要有向武之心，就都能参与。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860329
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860329,
					"content": "同时在比赛中，使用的武器也不仅仅局限于单手剑，只要是近战武器，并且符合比赛要求的长度与重量规则即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860330
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860330,
					"content": "至于「提升话题度」，就我个人的经验来说，最有效的办法就是——举办投票。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860331
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860331,
					"content": "投票？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860332
					]
				},
				{
					"id": 736860332,
					"content": "没错。「代神使」在表演赛中穿着的华服，以往都是由将军大人指定，但这次在将军大人支持下，我们把选择权交给了观众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860333
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860333,
					"content": "大家可以在「春樱」、「秋叶」等象征四季风物的款式中选择一种进行投票，神里小姐将身着得票最多的服装出席表演赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860334
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860334,
					"content": "虽然投票要到比赛当天才会开始，但最近我家仆人已经在猜测服装的主题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860335
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860335,
					"content": "多亏神里小姐答应担任「代神使」一职，这些方案才能够成立。我知道这对于神里小姐来说，也是不小的压力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860336
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860336,
					"content": "没关系，能对推广剑道有帮助，对我而言也是一种荣幸。小野寺先生为赛事尽心尽力，大家有目共睹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860337
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860337,
					"content": "神里小姐过奖了。各位，我还要回去准备投票的事，就先走一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860338
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860338,
					"content": "旅行者，派蒙，既然你们来了，我和千里小姐就带你们去比赛的场地看看吧，也能熟悉一下环境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860339
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860339,
					"content": "好呀好呀，那我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7368604,
			"completionStepIds": [
				7368606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368606",
							"2"
						],
						"stepId": 7368606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华",
					"柊千里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860401,
					"content": "好气派的赛场啊…原来远国监司里还有这种地方，我之前都不知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860402,
					"content": "这里是勘定奉行的室内练兵场。这次多亏有千里小姐帮忙，才能借用到这里的场地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860403
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860403,
					"content": "不用客气，绫华小姐，能帮上忙我也很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860404
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860404,
					"content": "千里，那边那个是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860405,
					"content": "哦，那个啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860406
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860406,
					"content": "旅行者，现在方便…稍微和你说几句话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860407
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860407,
					"content": "当然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860408
					]
				},
				{
					"id": 736860408,
					"content": "嗯，这件事应该从何说起才好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860409
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860409,
					"content": "绫华，难道是想说「信」的事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860410
					]
				},
				{
					"id": 736860410,
					"content": "啊…果然瞒不过你的眼睛。其实，一开始听说大家希望由我来担任「代神使」时，我心里真的有些忐忑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860411
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860411,
					"content": "虽说我从小就经常在公众面前露面，但作为剑道赛事的活动大使，还要身着盛装参加演武，这还是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860412
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860412,
					"content": "以前，有资格担任「代神使」的，都是稻妻官家剑术最精湛的武者，我自知和他们比起来还差得太远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860413
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860413,
					"content": "我担心自己无法胜任这一职责，所以那个时候，我曾想写封信给你，问问你的建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860414,
						736860415
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860414,
					"content": "我们是朋友，你不用顾虑的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				},
				{
					"id": 736860416,
					"content": "嗯，是啊，我知道的。不过，大概正因为知道这一点，我最后才没有寄出那封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860417
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860417,
					"content": "之前，你已经帮了我很多次，也倾听了我的许多烦恼。但如果我总是向你寻求帮助的话，就感觉自己有点「输给你」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860418
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860418,
					"content": "呵呵，作为朋友，会这样想很奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860419,
						736860420
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860419,
					"content": "并不奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860421,
					"content": "谢谢你。但今天得知你也来参加比赛了，我真的很开心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860422
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860422,
					"content": "绫华…欸，你们两个刚刚在说什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860423,
					"content": "#我刚刚在说，得知旅行者来参加比赛，我觉得很高兴。以{M#他}{F#她}在稻妻的人望，肯定又能为赛事增加不少热度呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860424
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860424,
					"content": "#嘿嘿，我觉得有{M#他}{F#她}出场的话，比赛一定会很精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860425,
					"content": "派蒙说的没错，我也很看好你哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860420,
					"content": "我能够理解你的心情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860415,
					"content": "我很愿意为你分忧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				}
			]
		},
		{
			"id": 7368605,
