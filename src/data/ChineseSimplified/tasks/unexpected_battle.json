						"rawParams": [
							"7368609",
							"2"
						],
						"stepId": 7368609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华",
					"柊千里",
					"小野寺",
					"水田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860601,
					"content": "#{NICKNAME}，你看，绫华和千里她们在那边呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860602,
					"content": "旅行者，派蒙，你们来了。昨天休息得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860603,
						736860605
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860603,
					"content": "休息得不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860604
					]
				},
				{
					"id": 736860604,
					"content": "不愧是旅行者，一副气定神闲的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860607
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860607,
					"content": "哼哼，赛前保持良好状态可是很重要的，这次的比赛我们志在必得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860608,
					"content": "各位看起来状态不错，今天的开幕赛一定会顺利的…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860609
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860609,
					"content": "说起来，难道这两个箱子里装着的就是选票？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860610,
					"content": "我都安排好了，左边这箱是演武传心的选票，右边是给其他活动用的，投票的结果将会在你们参加第三轮比赛的时候揭晓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860611
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860611,
					"content": "以旅行者的实力，参加第三轮比赛肯定是板上钉钉的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860612
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860612,
					"content": "那还用说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860613,
					"content": "小野寺先生，那我们就先把「演武传心」用的投票箱拿走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860614
					],
					"speakerTitle": "水田"
				},
				{
					"id": 736860614,
					"content": "好的，辛苦你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860615
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860615,
					"content": "#{NICKNAME}，时间差不多了，我们准备进赛场吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860616,
					"content": "旅行者，祝你比赛取得好成绩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860617
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736860617,
					"content": "好啦，我和绫华小姐也该去场边观赛了，一会儿见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860605,
					"content": "没怎么睡着呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860606
					]
				},
				{
					"id": 736860606,
					"content": "话虽这么说，但你还是平常那副气定神闲的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860607
					],
					"speakerTitle": "柊千里"
				}
			]
		},
		{
			"id": 7368607,
			"completionStepIds": [
				7368610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368610",
							"2"
						],
						"stepId": 7368610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"忠常",
					"忠明"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860701,
					"content": "呼…可算让他们停下了。喂，你们两个是误会了吧，我们只是路过，没有和你们抢东西的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860702,
					"content": "参赛资格？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860703
					]
				},
				{
					"id": 736860703,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860704
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860704,
					"content": "这…师兄，怎么会这样？刚才这个年轻人没用几招，竟然就把我们两个逼得毫无招架之力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860705
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860705,
					"content": "我还以为，这次我们一定能让「狐野一刀流」扬名天下，可谁知道还没踏进赛场，就栽在了这种地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860706
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860706,
					"content": "师弟，不用再说了。会有这样的结果，只说明我们实力不济。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860707
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860707,
					"content": "唉，师父之前常说天外有天，可这话我们都没听进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860708
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860708,
					"content": "现在看来，这张唯一的「参赛资格券」，落在我们谁手里，恐怕结果都一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860709
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860709,
					"content": "等等，你们两个自顾自的，到底在说什么呀？而且明明刚才还是一副掐起来的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860710,
					"content": "不好意思，让两位误会了。我们是剑道流派「狐野一刀流」的弟子，刚才动手，只是为了角逐「演武传心剑道大赛」的参赛资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860711
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860711,
					"content": "这场赛事对习剑之人来说意义非凡，这附近又很少有人路过，我们没有细想就误以为二位是来抢夺参赛资格的，实在抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860712,
						736860713
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860712,
					"content": "误会已经澄清…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860714
					]
				},
				{
					"id": 736860714,
					"content": "请等一下！如果不是阁下出手点醒了我，我这井底之蛙恐怕无法意识到自己的不足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860715
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860715,
					"content": "的确，和您切磋之后我才意识到，无论剑术还是心态我都需要精进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860716
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860716,
					"content": "#师兄，我有个提议，不如就把那张参赛券送给{M#他}{F#她}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860717
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860717,
					"content": "嗯，我没有异议。只有真正的剑术好手，才有资格站在演武传心的赛场上，我们还需历练啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860718
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860718,
					"content": "#欸，你们的意思是，希望{NICKNAME}代替你们参赛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860719,
						736860720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860719,
					"content": "这也太突然了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860721
					]
				},
				{
					"id": 736860721,
					"content": "是否参赛，就由阁下定夺吧。至少这张参赛券，现在对于我们而言，已经没有用处了。二位，我们就此别过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860722
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860722,
					"content": "他们两个就这么走掉了…唔，他们留下的这张什么什么大赛的参赛券要怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860723,
					"content": "让我看看…「演武传心剑道大赛」，「承办方社奉行」。既然是社奉行负责筹备的赛事，那我们就到神里屋敷去问问看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736860720,
					"content": "可我们完全不了解那个比赛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860721
					]
				},
				{
					"id": 736860713,
					"content": "你们继续。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860714
					]
				}
			]
		},
