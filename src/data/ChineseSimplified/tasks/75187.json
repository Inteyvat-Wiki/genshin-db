			"dialogs": [
				{
					"id": 751870101,
					"content": "#角上没有火焰一样的花纹…不是{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870102,
					"content": "唔，这个小家伙又是哪来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870103,
					"content": "奥奇卡纳塔的龙蛋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "哦，是那个时候的龙蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870105,
					"content": "呜呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870106,
					"content": "没想到蛋里的也是一只嵴锋龙呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870107,
					"content": "我记得之前保护这枚龙蛋的人给它取名…这个小家伙的名字是「阿瓜拉」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870108,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870109,
					"content": "哦哦，看来你对自己的名字有反应呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870110,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870111,
					"content": "#就跟{REALNAME[ID(2)|SHOWHOST(true)]}一样，这家伙也没有家了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870112,
					"content": "#那不然就跟我们一起吧！嘿嘿，我和{NICKNAME}，可会和嵴锋龙做朋友了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870113,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "阿瓜拉"
				},
				{
					"id": 751870114,
					"content": "嘿嘿…我就知道你会答应的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870115,
					"content": "你像一度为曾经的伙伴那样，为它系上了丝巾。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "嗯，上一只戴着丝巾的小龙，最后成长成了很了不起，很了不起的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751870117,
					"content": "阿瓜拉！希望、希望你也能像它一样，健康长大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
