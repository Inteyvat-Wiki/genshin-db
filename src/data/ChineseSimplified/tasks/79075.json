						],
						"pointId": 311
					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "呼…风总算停下来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750302,
					"content": "请听我们说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "好吧。我会听你们说的。但在那之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750305,
					"content": "瞧瞧二位震惊的样。想必也是想要问我「为什么一盆花会说话」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750306,
					"content": "或者是，「为什么你会变成一盆花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750307,
					"content": "有很多人问过你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "在外面的时候，有很多人这么问。回家了之后…倒是没有人问了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750309,
					"content": "你说的「外面」，是指这个世界外吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750310,
					"content": "我听说，你是远游后才变成这样的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "你倒是消息齐全。应该是帕纽尔告诉你的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750312,
					"content": "没错。在远游的途中，我变成了这样。呵呵，用罗泽尔那家伙的话说…这就是我自愿做出的「改变」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750313,
					"content": "改变倒是能够理解啦。但你为什么要变成一盆花呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750314,
					"content": "该不会是太喜欢植物了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "不是。我只是…想要找到自己的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750317,
					"content": "我在这个世界外，见到了许多人。他们有的是厨师，有的是花匠，有的是教师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750318,
					"content": "几乎每个人都找到了一个足以让自己安心的「位置」。如此，才能在生活中立足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750319,
					"content": "而我呢？我只擅长远游，也从未想过，要给自己寻找到一个稳定的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750320,
					"content": "这个「花盆」就是你的「位置」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "没错。你理解得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750322,
					"content": "做一棵在花盆里的花，就可以让我时刻拥有一个让自己安心的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750323,
					"content": "但是…唉，我既然有了一个盆，也有了属于我的「位置」，那我又为什么要出去远游呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750324,
					"content": "可我又是一个冒险客，没了远游，我又能做什么有价值的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750325,
					"content": "我不明白。越是见识了外面世界的事物，我就越是不明白…「位置」和「远游」，究竟谁更重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750326,
					"content": "我越是思考，就越是头痛…帕纽尔和我聊天时，我也总是答非所问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750327,
					"content": "我害怕误导帕纽尔。如果他原本就喜爱远游，看见了我这副模样后，会不会厌弃远游？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750328,
					"content": "可帕纽尔是我的朋友，永远都是。我得对他诚实，他问我的所有问题， 我都回答了个遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750329,
					"content": "包括…我之所以会成为花，是想要一个能让自己安心的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750330,
					"content": "或许是我的回答让帕纽尔难过了…又或者，是他不喜欢我的这副模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750331,
					"content": "我们逐渐分开，而我这么一盆花，又没办法自己上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750332,
					"content": "但这样也好，帕纽尔想必也不想见我，他肯定在生我的气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750333,
					"content": "喔…原来是这样。你们两个，都分别认为「对方在生自己的气」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750334,
					"content": "所以才不愿意见对方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "什么？你，你是说，帕纽尔并没有生我的气？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "肖维涅"
				},
				{
