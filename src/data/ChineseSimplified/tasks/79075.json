					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "将帕纽尔的想法全部告诉了肖维涅…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "天哪，我怎会这么想，我从来不愿见到他难过，哪怕他的嘴角垂下去一点，我的心也是要碎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750340,
					"content": "两位客人！请你们将我带上去，求你们，我得快点见到帕纽尔！一分一秒也等不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "肖维涅"
				},
				{
					"id": 790750341,
					"content": "就等你这句话呢，老兄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#嘿嘿，就等你这句话呢。我们出发吧！{NICKNAME}！",
