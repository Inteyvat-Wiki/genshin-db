			"dialogs": [
				{
					"id": 790750201,
					"content": "我…我要打扫打扫这里，给肖维涅找一个最适合晒太阳的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "帕纽尔"
				},
				{
					"id": 790750202,
					"content": "说服肖维涅的事就拜托你们了，两位客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "帕纽尔"
				},
				{
					"id": 790750203,
					"content": "要是我去见肖维涅，说不定他又会嫌我唠叨，开始生闷气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕纽尔"
				}
			]
		},
