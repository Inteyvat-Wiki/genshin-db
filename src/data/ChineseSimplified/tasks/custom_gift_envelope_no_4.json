			"dialogs": [
				{
					"id": 715360301,
					"content": "#原来是这样…这份「祝柬」真好看，谢谢你，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
