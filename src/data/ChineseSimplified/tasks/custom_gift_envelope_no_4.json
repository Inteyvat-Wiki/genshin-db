			},
			"dialogs": [
				{
					"id": 715360101,
					"content": "#{NICKNAME}？海灯节快乐，你帮迪希雅做「祝柬」的事，我已经听说了，很漂亮，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 715360102,
					"content": "村里的事已经安排妥当了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "多亏了迪希雅她们帮忙，村里现在有人守着，我也能安心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 715360104,
					"content": "这段时间就好好休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "嗯，我会的。迪希雅还说，过几天想去「翘英庄」看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 715360106,
					"content": "她说那边景色非常不错，还产出好茶，正好买一些带回去给村里的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 715360107,
					"content": "我本来也想按照璃月的传统，做几张「祝柬」，附在礼物里送出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 715360108,
					"content": "可是迪希雅的日程安排太满，我们俩到处跑，根本没什么空写「祝柬」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 715360109,
					"content": "我听迪希雅说，你很擅长做「祝柬」，能教我做一封么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 715360110,
					"content": "好呀，交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
