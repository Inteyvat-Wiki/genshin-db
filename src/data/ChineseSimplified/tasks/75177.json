			"dialogs": [
				{
					"id": 751770101,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770102,
					"content": "#哎呀，{REALNAME[ID(2)|SHOWHOST(true)]}你是从哪里弄来的这个留影机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770103,
					"content": "不会是趁着别人不注意…这样可不行哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770104,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "嗯…呀！呀！呱呀……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "很熟悉的动作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "哦哦，这不是「大炖肉火焰」嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770110,
					"content": "嘿嘿，是在「回声之子」那会儿，有个想要当导演却放反了留影机的部族人…啊！留影机是从他那借来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770111,
					"content": "呀！嗯…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "你想要跟我们一起拍一张画片，嘿嘿，是这个意思吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770113,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "是哦，一起冒险了那么久，还没有一起拍画片留念呢，小家伙身上的诅咒已经去除，可以健康长大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770115,
					"content": "#不知道长成大嵴锋龙要多久，如果明天一下子就变成大嵴锋龙了，那不是再也见不到{REALNAME[ID(2)|SHOWHOST(true)]}还是小龙的样子了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770116,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "嘿嘿，就来拍一张嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770119,
					"content": "调整好了，大概是这样，检查过了，我可没有弄反！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770120,
					"content": "嗯，那倒数结束就喊「大炖肉火焰」！三、二、一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770121,
					"content": "「大炖肉火焰」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770123,
					"content": "#这样就拍好啦，你看，{REALNAME[ID(2)|SHOWHOST(true)]}也很有气势…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770124,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770125
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}接过画片中的其中一张，转过身去，很小心地放在了坚硬壳下，柔软的背中。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#不过，{REALNAME[ID(2)|SHOWHOST(true)]}为什么突然想要拍画片呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770127,
					"content": "波嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770128,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770129
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770129,
					"content": "呜呀…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770130
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770130,
					"content": "#咦，怎么了，{REALNAME[ID(2)|SHOWHOST(true)]}，是哪里不舒服吗，看上去，看上去不太开心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770131,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770132
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770132,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770133
					]
				},
				{
					"id": 751770133,
					"content": "想要开始属于自己的冒险了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770134
					]
				},
				{
					"id": 751770134,
					"content": "欸，什么，自己的冒险…是、是不想跟我们一起旅行了吗，呜，是不是我说了什么话让你生气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770135,
					"content": "我、我以后再也不说你贪吃了，你不要离开我们，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770136,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770137
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770137,
					"content": "…派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770138
					]
				},
				{
					"id": 751770138,
					"content": "呜…我知道，我知道的啦…小家伙总有一天会长大，它也有、也有自己要去的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770139,
					"content": "可是，就算是这样，突然说要离开，还是会感到寂寞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770140,
					"content": "没关系，以后还会见到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770141
					]
				},
				{
					"id": 751770141,
					"content": "#真的吗？以后、唔，以后我们需要帮助的时候，{REALNAME[ID(2)|SHOWHOST(true)]}可要赶过来哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770142,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770143
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770143,
					"content": "#那以后，{REALNAME[ID(2)|SHOWHOST(true)]}的冒险要是遇到了难题，也得立刻来找我们，不许逞强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770144,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770145
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770145,
					"content": "…还有，平时不要吃得太多了，遇到打不过的大家伙就要及时逃跑。虽然说不能吃太多，但是该吃的炖肉也要吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770146,
					"content": "然后，最最最最，最重要的就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770147,
					"content": "要好好长大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770148
					]
				},
				{
					"id": 751770148,
					"content": "对，要好好长大！起码要长成三座山大小那么大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770149,
					"content": "呀！呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770150
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770150,
					"content": "就是…呜，就得有这样的气势！一定、一定要记得我们呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770151,
					"content": "在静谧的林中，你们一同享用了告别的火焰炖肉，而后，整理起了这片偶尔前来的营地。\\n你为今后将要独自前行的伙伴整理一路上的纪念品，你们想起这段旅途上发生的所有事，堵住洞口的匿叶龙，海畔边的膨膨兽，和在纳塔遇到的许多个性各异的人们…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770152
					]
				},
				{
					"id": 751770152,
					"content": "还有…还有那个凭借古怪金文说话的家伙…\\n派蒙说：「那个家伙就是在利用我们嘛，从头到尾也没露过面。」\\n这让你回想起在图兰圣山之底时，一度成长的幼龙眼中曾流露过的复杂的情绪。\\n…现在它仍然幼小，但总有一天会变成那样了不起的大龙吧。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770153
					]
				},
				{
					"id": 751770153,
					"content": "最后的最后，它轻轻用角抵触派蒙的额心，又蹭蹭你伸出的手掌。\\n然后，像是要劝自己下定决心那样——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770154
					]
				},
				{
					"id": 751770154,
					"content": "幼小的龙坚决地转身离开了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751770118,
					"content": "嗯，来拍吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770119
					]
				},
				{
					"id": 751770108,
					"content": "是「大炖肉火焰」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770109
					]
				},
				{
					"id": 751770109,
					"content": "哦哦，你这么一说，我就有点印象了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}