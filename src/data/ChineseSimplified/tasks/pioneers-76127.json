			"dialogs": [
				{
					"id": 761270201,
					"content": "#呜呜呜，{NICKNAME}！我就知道你一定会没事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270202,
					"content": "派蒙还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270203
					]
				},
				{
					"id": 761270203,
					"content": "刚才很不好，我从逃生舱里出来一看，你们都不见了，差点吓死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270204,
					"content": "不过现在找到了你，一下就好多了，嘿嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270205,
					"content": "快让我看看，你有没有哪里受伤？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270206,
					"content": "放心，我也没事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270207
					]
				},
				{
					"id": 761270207,
					"content": "这样我就不担心了，没想到飞船居然出了问题…不对，其实这种事早就该想到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270208,
					"content": "毕竟它都被埋在地下不知道多少年了，能飞起来已经是奇迹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270209,
					"content": "而且虽然过程有些糟糕…但我们最后还是成功来到了月球上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270210,
					"content": "真是强劲的龙族科技。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270211
					]
				},
				{
					"id": 761270211,
					"content": "都怪刚才黑蛋太引人注意，让我忘记好好检查一下飞船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270212,
					"content": "啊对了！黑蛋呢？我记得她也钻进了逃生舱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270213,
					"content": "我们得去找她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270214
					]
				},
				{
					"id": 761270214,
					"content": "希望她不要有事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
