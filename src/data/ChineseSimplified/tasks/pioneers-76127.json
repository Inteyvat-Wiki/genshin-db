					"nextDialogs": [
						761272615
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272615,
					"content": "哇！这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272616
					],
					"speakerTitle": "派蒙"
				},
				{
