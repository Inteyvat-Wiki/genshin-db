						761270307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270307,
					"content": "我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270308
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761270308,
					"content": "这里面有你的名字？你叫宁宁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270309,
					"content": "月亮的力量…能够记录…信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270310
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761270310,
					"content": "它们…就储存在终端里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270311
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761270311,
					"content": "原来黑蛋能够读取终端的信息吗？那你知道这里是什么地方了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270312,
					"content": "是一个能源发生站…用来制造…存储能源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270313
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761270313,
					"content": "这么说，刚才那些光球，应该就是某种能源了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270314,
					"content": "黑蛋一定是因为身上有同样的力量，才被当成能源抓走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270315,
					"content": "能源发生站是用来做什么的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270316
					]
				},
				{
					"id": 761270316,
					"content": "为…「伊比尼伯龙之眼」…供能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270317
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761270317,
					"content": "伊比尼伯龙…之眼？那又是什么？听起来有些耳熟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270318,
					"content": "是飞船降落地点之一。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270319
					]
				},
				{
					"id": 761270319,
					"content": "伊比尼伯龙…之眼？那又是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761270320,
					"content": "这里有工程蓝图…给你们看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270321
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761270321,
					"content": "中间的高塔…就是「伊比尼伯龙之眼」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270322
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761270322,
					"content": "好厉害！旁边那三个矮一些的呢？是能源发生站吗？",
