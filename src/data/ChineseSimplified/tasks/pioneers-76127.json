						761272623
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272623,
					"content": "黑蛋你怎么了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272624,
					"content": "有一个隐藏模块…「望月者计划」…它响应了我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272625
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272625,
					"content": "是什么新情报吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272626
					]
				},
				{
					"id": 761272626,
					"content": "这个模块…记录着这座高塔的起源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272627
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272627,
					"content": "它来自一位龙族先驱，名字是「伊比尼{RUBY#[S]最初的望月者}伯龙」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272628
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272628,
					"content": "我们乘坐的登月飞船…也是他的成果…是他带领着普通的龙族学者来到了月亮上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272629
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272629,
					"content": "好、好厉害！那这座「伊比尼伯龙之眼」一定是为了纪念他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272630,
					"content": "不是这样的…终端里记录了这样一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272631
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272631,
					"content": "在那位先驱登陆月球后…就开始了对月亮和近月带的探索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272632
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272632,
					"content": "直到有一天…他在近月带接收到了一个…来自星空深处的神秘信号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272633
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272633,
					"content": "星空深处的信号？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272634,
					"content": "学者们没能解读信号的含义…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272635
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272635,
					"content": "但那位先驱认为…那是他们前往星海的王…传回的讯息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272636
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272636,
					"content": "王的名字是…「尼伯龙根」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272637
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272637,
					"content": "是…是那位龙王？！真的是他传回来的信号吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272638,
					"content": "不知道…因为学者们无法进入深空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272639
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272639,
					"content": "所以…他们建设了这座高塔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272640
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272640,
					"content": "这座「伊比尼伯龙之眼」…最初其实是一座深空信号接发站…为了再次捕捉那个信号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272641
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272641,
					"content": "那后来他们成功了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272642
					]
				},
				{
					"id": 761272642,
					"content": "后来…过去了很多年…直到那位先驱离世…信号都没有再出现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272643
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272643,
					"content": "再后来…他的学生也放弃了…转去了更加务实的方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272644
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272644,
					"content": "他们将「伊比尼伯龙之眼」改造成月球表面监测站…方便他们进行更实际的月球研究工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272645
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272645,
					"content": "好遗憾啊…感觉我们知道了很不得了的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272646,
					"content": "这就是「望月者计划」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272647
					]
				},
				{
					"id": 761272647,
					"content": "不…这些只是我读取到的日志信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272648
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272648,
					"content": "真正的「望月者计划」被加密了…我无法打开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272649
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272649,
					"content": "咦？你刚才不是说它在响应你吗？那不是应该能直接打开吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272650
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272650,
					"content": "我的信息与它匹配…但也许因为…数量还不够…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272651
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272651,
					"content": "什么叫数量还不够？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272652,
					"content": "就像是…零食与派蒙匹配…但是两成的零食不够派蒙吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272653
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272653,
					"content": "两成是你的，我有八成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272654
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272654,
					"content": "听起来黑蛋像是一个钥匙模具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272655
					]
				},
				{
					"id": 761272655,
					"content": "缺少了内容物，所以打造不出钥匙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272656
					]
				},
				{
					"id": 761272656,
					"content": "欸？好像感觉就是这个意思！这么想的话，这个「望月者计划」会不会跟黑蛋的使命有关呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272657
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272657,
					"content": "它居然主动响应黑蛋的信息，感觉就像是等着她来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272658
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272658,
					"content": "我不知道…但我想…打开它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272659
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272659,
					"content": "那我们来帮忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272660
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272660,
					"content": "既然是信息的数量不够，那我们去找更多终端就好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272661,
					"content": "刚才我就发现了，黑蛋每吸收一座终端，说话就更利索一些，个性也更膨胀一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272662
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272662,
					"content": "虽然我不喜欢这样的变化，但如果和她的使命有关，我也只能支持她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272663,
						761272664
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272663,
					"content": "哇，是细心派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272665
					]
				},
				{
					"id": 761272665,
					"content": "哼哼，毕竟黑蛋也有帮我们找哥伦比娅嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272666
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272666,
					"content": "你放心吧，黑蛋，既然这里有终端，前面一定也有！跟我们走，总会把你喂饱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272667
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272667,
					"content": "谢谢…派蒙…那我会尽力…不变膨胀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272668
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272668,
					"content": "嘿嘿，那我们现在该去下一站了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272669
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272669,
					"content": "出发吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272670
					]
				},
				{
					"id": 761272670,
					"content": "好耶！月球大冒险第二站——「乌吉乌吉圈」！出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272671
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272671,
					"content": "…是「乌吉恩圈」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761272672
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761272672,
					"content": "「乌吉乌吉圈」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761272664,
					"content": "哇，是大方派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761272665
					]
				}
			]
		}
	]
}