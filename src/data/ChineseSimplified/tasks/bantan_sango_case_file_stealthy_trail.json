			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320102,
					"content": "找到线索了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "嗯。这次多亏珊瑚社长了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320104,
					"content": "根据她的「演绎」，大致上确定了几处地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320105,
					"content": "目前来看，有一处营地是由昨天那个「帽子狗」看守的，需要格外小心应对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320106,
					"content": "感觉像派蒙会起的外号。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "喂！派蒙才不会起这样的外号。如果是我的话，应该会叫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320108,
					"content": "嗯——就叫「刀子狗」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320109,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320110,
					"content": "总之，我在那边设置了一些一样的机关。希望这次也能凑效吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320111,
					"content": "哇！竟然被无视了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320112,
					"content": "那么，就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320113,
					"content": "还有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320114,
					"content": "地点可靠吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "绝对可靠。毕竟，我去实地考察过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320116,
					"content": "龙二为什么这次不和我们一起去呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320117,
					"content": "虽然我也很想和你们一起，但今天不巧有珊瑚社长给我安排的其他任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320118,
					"content": "大体来说，她对「帽子狗」的来历有些想法。所以委托我顺便去调查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320119,
					"content": "「刀子狗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320120,
					"content": "「帽子狗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320121,
					"content": "「帽子刀子狗子」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320123,
					"content": "这是什么外号，好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320125,
					"content": "…算了，还是叫它「黑影」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320126,
					"content": "无论如何，小动物就拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320124,
					"content": "别争了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "辛苦你们了。我看看…数量还是对不上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320302,
					"content": "原来丢了那么多小动物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320303,
					"content": "是的。按照接到的委托来看，我们已经找到大概半数的失踪小动物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320304,
					"content": "只可惜现在也没有更多的线索了。不过没关系，活物比没有生命的物品更加好调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320305,
					"content": "之前有帮大户人家找过被偷走的物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320306,
					"content": "曾经一再断了线索，多亏了珊瑚社长的推理，最后才找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320307,
					"content": "能具体说说吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "好像很有趣的样子，快展开讲讲嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320309,
					"content": "想不到你们对探案也有兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320310,
					"content": "其实当时，我们已经锁定了嫌疑人。只是他家里并没有找到赃物，也没有其他线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320311,
					"content": "后来，我在外打听的时候，无意间得知，嫌疑人在一天前卖出过鸣草。我去找买家看过鸣草，还算是新鲜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320312,
					"content": "珊瑚社长听说后，马上就让我去影向山山脚一带调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320313,
					"content": "咦？为什么是影向山？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320314,
					"content": "「首先嫌疑人住在鸣神岛上。虽然稻妻有很多地方都有鸣草，但是如果要去别的岛上，普通人必然需要船，但是我们没有发现船。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320315,
					"content": "「再加上天领奉行由于锁国令对船十分敏感，他如果打算作案，必然不会让自己暴露在天领奉行的眼皮子底下。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320316,
					"content": "「所以基本可以排除掉其他岛。」珊瑚社长是这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320317,
					"content": "但是鸣神大社附近也有鸣草吧？为什么是影向山山脚呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320318,
					"content": "这点珊瑚社长也考虑到了。「虽然鸣神大社附近也有鸣草分布，但是鸣神大社有巫女在，也有去参拜的信众。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320319,
					"content": "「如果有什么不同寻常的地方，大家来来往往很容易就会被发现。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320320,
					"content": "原来是这样子！现在我相信她是头脑派了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320321,
					"content": "然后在影向山山脚果然发现了一处土堆，有近期松动过的痕迹。嫌疑人把赃物先埋掉，打算等风头过了，再来取出销赃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320322,
					"content": "但是他觉得自己背着背篓出去又空手回来会让人起疑，于是摘了路边的鸣草回去卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320323,
					"content": "但又恰恰是鸣草暴露了他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400320324,
					"content": "没错。所以一定还有什么线索，在我们没有注意到的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320327,
					"content": "我觉得我们这样的合作也不错。毕竟，我的特长本来也是跑腿，而不是潜入和战斗。这部分交给你，真是再合适不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320328,
					"content": "如何？有没兴趣来「万端珊瑚」就职？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320329,
					"content": "珊瑚…社长她虽然看起来有点难以沟通，会说「良知是智慧的累赘」之类的话，但骨子里其实是很温柔的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320330,
					"content": "算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "真可惜呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320333,
					"content": "不过说得也是，要是珊瑚社长身边有像你这么能干的人，我就该失业了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400320334,
					"content": "接下来我会继续调查的。如果你们有别的事情需要忙的话，请放心去吧。",
					"roleType": "TALK_ROLE_NPC",
