		},
		{
			"id": 1200102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200102",
							"2"
						],
						"stepId": 1200102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "唔，到底要怎么样才能知道茂才公和「愚人众」有勾结呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010202,
					"content": "要有决定性的证据。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "那…直接去找他？能抓到现场最好，抓不到也能吓唬吓唬他，说不定就告诉我们了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010205,
					"content": "先和守卫打听打听吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "那就交给你了！我会配合你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010203,
					"content": "如果能看到现场就好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200103",
							"2"
						],
						"stepId": 1200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "什么人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010302,
					"content": "我是蒙德来的商人，与茂才公有约。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "咦？应该已经提前告知过了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010306,
					"content": "老爷今天临时有要事，所有会面都取消了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010307,
					"content": "「要事」…是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010308,
					"content": "最近老爷在忙一笔重大的生意，早早就出门接待贵客了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010309,
					"content": "那他现在在哪儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010310,
					"content": "抱歉，这个老爷特别叮嘱了，不能透露…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010311,
					"content": "意思是我们就不是贵客了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "不不不，我没有冒犯的意思，请不要介意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010313,
					"content": "如果不让我见茂才公，有你好受的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "对不起，对不起！老爷现在在新月轩谈生意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010316,
					"content": "还望您大人有大量，别让老爷怪责下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010317,
					"content": "我家老爷还有要事在身，就不和你纠缠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010318,
					"content": "#你就期待{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}和茂才公谈完生意之后，能把你的冒犯忘掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010319,
					"content": "太、太谢谢你们了！愿你们的生意永远有岩王爷庇佑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "大武"
				},
				{
					"id": 120010320,
					"content": "#没想到{NICKNAME}你还有这种天赋啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010321,
					"content": "只是顺势…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "以后我可要长个心眼，不能随随便便被你唬住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010325,
					"content": "看样子守卫提到的贵客，应该就是「愚人众」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010326,
					"content": "我猜也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "嗯，那就去新月轩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010327,
					"content": "来得早不如来得巧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "你演得也不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "嘿嘿，那作为感谢，要请我吃点心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010314,
					"content": "等你老爷为你的冒犯买单吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#我是{NICKNAME}，你家主子的贵客！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "奇怪了，名册上没有这个名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "大武"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茂才公"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "我知道，我知道，放心，订单我一定会完成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010702,
					"content": "但我之前派给你的手下回复我说，进度不太乐观啊…有人不愿配合，是么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120010703,
					"content": "呃…是，在原料上出了点小问题，石珀暂时还没收购到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010704,
					"content": "不过这不需要您担心，就算那个常九爷不卖，我从其他人手上买就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010705,
					"content": "那是最好，之前我就说过，「愚人众」只重视结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120010706,
					"content": "为了完成订单，「愚人众」可以给你一定支持，但如果按时完不成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120010707,
					"content": "我们的好意可不是免费的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120010708,
					"content": "明白明白，承蒙您关照，我又怎么敢辜负您的期望呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "茂才公"
				},
				{
					"id": 120010709,
					"content": "那就到时候看你的成果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "债务处理人"
				},
				{
					"id": 120010710,
					"content": "呼…该死的老常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茂才公"
				},
				{
					"id": 610045701,
					"content": "这个茂才公果然和「愚人众」有勾结！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 610045702,
					"content": "不知道书呆子那边有没有什么进展，我们去告诉他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200108,
