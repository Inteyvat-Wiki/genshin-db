				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "说是有其他想了解的事，搞得神神秘秘的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010802,
					"content": "结果你只是换了个地方看书吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010803,
					"content": "茂才公的生意我们弄清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "原来如此，和我猜得差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010805,
					"content": "你真的有猜过吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010806,
					"content": "办法我已成竹在胸。我这里有封信，拜托你们带去给「飞云商会」的家丁，他知道该怎么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010807,
					"content": "因为一些难以言述的苦衷，在下不能与二位一同前往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010808,
					"content": "至于信中内容你们不必查看，到时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010809,
					"content": "哇，字好丑！这种字就算查看了也看不懂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010810,
					"content": "古代文字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010813,
					"content": "所以说你们不必查看，不看…也不会有什么关系！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010814,
					"content": "那个人是读得懂这封信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010815,
					"content": "可是，是要找「飞云商会」帮忙吗？那可是璃月大名鼎鼎的商会之一，没理由帮我们吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010816,
					"content": "「飞云商会」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "来璃月之后，经常听到这个名字，好像有很多很多生意都是他们主导的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010818,
					"content": "像这样的大商会如果愿意帮忙是很好，但他们真的会帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010819,
					"content": "这个不用担心，据我了解，他们都跟我一样，有一颗侠义心肠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010820,
					"content": "读了我晓之以理、动之以情的这封信，一定会出手相助的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010821,
					"content": "真的会有用吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "要给茂才公一个深刻的教训，只靠我们是不够的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010824,
					"content": "而且我也不想让别人知道这件事是我做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010825,
					"content": "为什么？你不是为了报答常九爷吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010826,
					"content": "「事了拂衣去，深藏功与名」，此乃侠义之本，回味无穷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010827,
					"content": "滴水之恩，定当涌泉相报，但这仅仅是报答，我不想要人情，也不想要回报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010828,
					"content": "说得这么帅，其实你只是想继续看你的书吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010829,
					"content": "那就拜托二位送信给「飞云商会」的家丁了，他现在应该在琉璃亭附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120010830,
					"content": "不准无视我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120010822,
					"content": "为什么要找他们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "加了密的密文？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
