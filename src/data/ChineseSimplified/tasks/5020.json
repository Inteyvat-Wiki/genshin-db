			},
			"dialogs": [
				{
					"id": 50202001,
					"content": "阿伽娅…对我来说也是一位可敬的长辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202002,
					"content": "祖父过世后，我是许多长辈们推举着成为了「部族首领」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202003,
					"content": "因为我总是有许多新奇的想法，大家相信我能将「流泉之众」带向「不一样的未来」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202004,
					"content": "但是，在很长一段时间里，我也不知道自己该做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202005,
					"content": "阿伽娅阿姨经常勉励我，哪怕我犯了错，她也从不会跟我说「怎么做成这个样子」。她会很认真地陪我分析问题出在哪里，让我能做得更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202006,
					"content": "我很尊敬她。所以…我会记住她教给我的一切，努力做好我该做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿米娜"
				}
			]
		}
	]
