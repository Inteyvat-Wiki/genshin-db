			"dialogs": [
				{
					"id": 740430301,
					"content": "嗯，确实收到了，七个神秘的核心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430302,
					"content": "所以核心到底是干什么用的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "我怎么知道？老板只是说，需要七个这些神奇机器里的神奇核心。能弄到核心，就能赚大钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430304,
					"content": "这样好了！我跟老板约好了今天在这里见面，汇报工作进度。你们当面问他吧？反正也要等他结帐，我才能跟你分钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430305,
					"content": "真拿你没办法。既然恩里这么说了，就等一会吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430306,
					"content": "等了一会…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "亲爱的恩里，情况如何啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "「老板」"
				},
				{
					"id": 740430308,
					"content": "好得很，老板！您要的七个神秘核心都收集齐全了。来来，让我介绍一下，这是我的合伙人…叫啥来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430309,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "「老板」"
				},
				{
					"id": 740430311,
					"content": "呃呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430312,
					"content": "哎？你们认识啊？那就好说了！事情是这样的，老板…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430313,
					"content": "#「哎吔！是{NICKNAME}！为什么{NICKNAME}在这里？！」\\n「老板」转身就跑，却被不知从什么地方冒出来的亨特和特纳逮住了！\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "哎吔！饶命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "「老板」"
				},
				{
					"id": 740430316,
					"content": "呜哇，这两个人好熟练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430317,
					"content": "老板别担心，没有生命危险的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430318,
					"content": "当然，当然。当然不会有生命危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430319,
					"content": "就目前而言呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430320,
					"content": "就、就目前而言…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "「老板」"
				},
				{
					"id": 740430321,
					"content": "接下来呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430322,
					"content": "是烤鸡，抑或是…烤鸡以外的东西，就取决于老板您的态度了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430323,
					"content": "噫噫——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "「老板」"
				},
				{
					"id": 740430324,
					"content": "你们怎么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430325,
					"content": "上次，我们…有幸相遇以后，我们决定监视恩里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430326,
					"content": "等等，为什么要监视我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430327,
					"content": "不对，归根到底，你们为什么要针对我！明明我只是在努力工作而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430328,
					"content": "你拆掉的机器是枫丹科学院的人用来监测、优化水质的装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430329,
					"content": "哎？不是用来制造污染的机器吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430330,
					"content": "拆出来的核心包含着最先进的机芯和枫丹的水文数据。我们希望能…认识您的交易对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430331,
					"content": "哎？哎？什么？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430332,
					"content": "恩里！你骗我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "震惊！我们被骗了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "不对不对，你是我的大恩人，我怎么可能骗你啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430335,
					"content": "老板，你骗我！你竟然骗我把这么重要的东西弄坏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430336,
					"content": "我、我不是故意…我只是最下面的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "「老板」"
				},
				{
					"id": 740430337,
					"content": "啊啊？老板，说的什么胡话我没听清，我还以为您说自己「不是故意」…您再说一遍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430338,
					"content": "噫噫——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "「老板」"
				},
				{
					"id": 740430339,
					"content": "这位老板看来是累了。睁着眼晕过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430340,
					"content": "呃呃，我、我们也不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430341,
					"content": "关于这个嘛。我们决定，不追究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430342,
					"content": "欸？没关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430343,
					"content": "反正只要核心完好，其中的数据完好，机器根本没所谓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430344,
					"content": "上面说了没所谓。反正不能跟你们过不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430345,
					"content": "有什么跟我过不去的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "没什么，没什么。您瞧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430347,
					"content": "我们只是在散步而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430348,
					"content": "真是偶遇，不是吗？美好的天气，美好的邂逅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430349,
					"content": "但是美好的邂逅总会结束。我们该…告别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430350,
					"content": "就让美好的邂逅留在心中，或者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430351,
					"content": "忘了更好。忘了更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430352,
					"content": "欸…所以我们没事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430353,
					"content": "怎么，你想有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430354,
					"content": "没事没事！哈哈，当然没事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430355,
					"content": "唉，本来我还以为遇上了好心人，总算能通过劳动改变命运了。到头来，这世上还是坏人多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430356,
					"content": "…喂，恩里。来搭把手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430357,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430358,
					"content": "真是不幸啊，这位好心的老板神志不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430359,
					"content": "我们需要一位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430360,
					"content": "干活认真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430361,
					"content": "忠实可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430362,
					"content": "希望用劳动改变命运的…好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430363,
					"content": "没错，一位好朋友。来帮忙把这位好老板带到我们的安全屋去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430364,
					"content": "我们才方便…好好跟这位好心的老板聊聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "亨特"
				},
				{
					"id": 740430365,
					"content": "当然了，我们会充分地…表达我们的谢意。通过摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 740430366,
					"content": "嗯？嗯！算我一个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430367,
					"content": "太好了！谢谢你们！也很感谢你们，那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430368,
					"content": "#我是{NICKNAME}，她是派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#谢谢你们，{NICKNAME}、派蒙！遇到你们以后，我的命运都改变啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430370,
					"content": "不用谢！要加油哦，恩里！不要再被骗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430371,
					"content": "嗯！不会的！我要努力工作，成为大富翁！以后雇佣别人给我干活！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430372,
					"content": "亨特、特纳和恩里将不省人事的愚人众挖了出来，带走了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "希望恩里能获得幸福呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740430374,
					"content": "等等！恩里说好的，给我们的报酬呢？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}