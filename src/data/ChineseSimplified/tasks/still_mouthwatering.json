			"dialogs": [
				{
					"id": 740430201,
					"content": "抗议！抗议！为我劳动的权利抗议！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430202,
					"content": "你要的核心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "哦？让我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430204,
					"content": "为什么在这里抗议…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "在哪里跌倒的，就要在哪里站起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430206,
					"content": "我要干什么来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "真拿你没办法。在地上和水下的一些地方，有人部署了这种奇怪机器。识别的方法也很简单，机器的周围会产生很奇怪的光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "恩里"
				},
				{
					"id": 740430208,
					"content": "把它解决掉，把里面这种特定的核心带给我，一共<color=#00E1FFFF>需要七个</color>。拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恩里"
				}
			]
		},
