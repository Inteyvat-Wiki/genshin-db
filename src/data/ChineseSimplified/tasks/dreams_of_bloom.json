			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"咲耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726580101,
					"content": "你好！想要试试亲手种一盆花吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580102
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580102,
					"content": "什么种花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580103
					]
				},
				{
					"id": 726580103,
					"content": "喔，你有兴趣吗？不了解也没关系，我来和你简单说明一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580104
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580104,
					"content": "我是咲耶，是一个种花的花匠，同时也做一些和花有关的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580105
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580105,
					"content": "哈哈哈，虽然说是生意，但其实大部分时候都是帮人送花，或者是帮哪家店制作「插花」啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580106
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580106,
					"content": "插花是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580107
					]
				},
				{
					"id": 726580107,
					"content": "咦？你不知道吗？「插花」在稻妻可是一项很重要的事情喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580108
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580108,
					"content": "虽然简单来说，「插花」就是将花卉和其他植物仔细裁剪处理后，以一个合适的方式摆放起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580109
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580109,
					"content": "但在具体制作上…裁剪花卉和植物时，需要细细地把握植物的状态，细心地为植物修剪掉不体面的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580110
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580110,
					"content": "摆放时，又要根据具体的场景氛围来调整摆放的方式。有时候，甚至要细致到每一支花卉向外延伸的角度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580111
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580111,
					"content": "这些细节，每个都需要细心考究，实在是…繁琐到了极点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580112
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580112,
					"content": "就算是对我这个喜爱插花的人来说，这项工作也够让我疲惫的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580113
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580113,
					"content": "之前我在城里还有一个店面，但街上实在太吵，我根本没法静下心来插花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580114
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580114,
					"content": "所以我就关了店面，只在我的花田旁边接待顾客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580115
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580115,
					"content": "但是…虽然店里是清净了，但生意也少了一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580116
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580116,
					"content": "所以我特意设计了一个推广计划，来城里宣传一下我的「咲耶花屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580117
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580117,
					"content": "我把这个计划叫做…「梦里生花」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580118
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580118,
					"content": "这计划具体是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580119
					]
				},
				{
					"id": 726580119,
					"content": "具体来说，就是一个让顾客们亲手种出花，然后再亲手制作插花的活动喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580120
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580120,
					"content": "如果你有兴趣，想要体验一下的话，就和我说一声吧。无论是种花和插花，都是很有趣的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咲耶"
				}
			]
		}
	]
}