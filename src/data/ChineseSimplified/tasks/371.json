			"dialogs": [
				{
					"id": 3710101,
					"content": "刚才…有一件事你没说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710102,
					"content": "那时我们看到的东西，除了龙和结晶，明明还有一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710103,
						3710104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710103,
					"content": "我想自己先调查一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				},
				{
					"id": 3710105,
					"content": "嗯，你果然还记得他，那个绿色的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710106,
					"content": "——就和楼下那个路人穿得一样绿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710107,
						3710111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710107,
					"content": "真的是同一种色号呢，好巧啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710108
					]
				},
				{
					"id": 3710108,
					"content": "是吧？是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710109,
					"content": "不过…怎么总觉得那个人…越看越像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710110,
					"content": "同一个人——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710111,
					"content": "那个…好像就是他本人啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710112
					]
				},
				{
					"id": 3710112,
					"content": "咿——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710104,
					"content": "我觉得他看上去不是坏人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				}
			]
		},
