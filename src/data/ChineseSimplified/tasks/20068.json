			"dialogs": [
				{
					"id": 200680301,
					"content": "…吃吧，吃吧，吃好了就快点走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680302,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "怎么又是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680308,
					"content": "你到底想做什么啊，难道还想对鸭子和鸽子下手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680309,
					"content": "这份土豆饼是给你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "土豆饼？咦，你怎么知道这个土豆饼的做法的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680312,
					"content": "我知道了，你绝对是去找葛瑞丝妈妈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680313,
					"content": "哼，用这个就想收买我，你也想得太美了，你对鸽子和鸭子做的事，我比谁都清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680314,
					"content": "…不过，葛瑞丝妈妈都让你送这个土豆饼来，肯定是不想我接着闹下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680315,
					"content": "她还要照顾诺拉和葛罗丽，我再给她添麻烦，就太不懂事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680316,
					"content": "不过先说好，我可没有原谅你！只是不想再给妈妈添麻烦了，知道了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680317,
					"content": "哼，不过…反正我只是个小孩子，这种口头的约定，你肯定说忘就忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680318,
					"content": "等我爸爸回来了，我要再和他好好说说你的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 200680310,
					"content": "请收下这份土豆饼吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "提米，那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "怎么又是你？你到底有完没完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "提米"
				},
				{
					"id": 200680304,
					"content": "发，发生什么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "你还好意思问我！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "提米"
				}
			]
		},
		{
			"id": 2006804,
			"completionStepIds": [
				2006804
			],
