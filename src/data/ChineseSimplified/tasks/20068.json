			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞丝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "这些就足够了，谢谢您，请您稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680402,
					"content": "这样就可以了，请您把这份「蒙德土豆饼」送给提米吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680403,
					"content": "请您以后别做这种…不好的事了，实在是得不偿失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680404,
					"content": "希望您能记住我的告诫，别让我和提米太失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680405,
					"content": "不过…唉，要是人人都能记住告诫，那维多利亚修女就不会那么忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
		{
			"id": 2006805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006803",
							"2"
						],
						"stepId": 2006803,
						"stateName": "QUEST_STATE_UNFINISHED"
