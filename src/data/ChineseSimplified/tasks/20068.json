			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞丝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "唉，这可怎么办才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680102,
					"content": "呃，发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "是您啊，您来得正好。提米已经把您对鸭子做的事告诉我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680104,
					"content": "您…您…唉，我该怎么说您好呢，您的事迹我也不是没听说过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680105,
					"content": "您的那些勇气和力量…怎么能用在这种地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680106,
					"content": "实在是太饿了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "您…如果实在肚子饿的话，可以去正经工作赚钱啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680110,
					"content": "以您的实力，在冒险家协会绝对能占得一席之地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680113,
					"content": "唉，事情已经发生了，多说无益，提米因为这件事已经闷闷不乐很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680114,
					"content": "我曾经从提米的…父亲那里，学过一道菜谱。加入了「慕风蘑菇」的「蒙德土豆饼」，是提米最喜欢吃的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680115,
					"content": "您帮我找三个「慕风蘑菇」来吧，提米能吃到这个，心情应该会好些…您也能向他道歉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680116,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "那就请您快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680120,
					"content": "慕风蘑菇的话…我记得在城里南边房子的房檐下应该就能找到一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680121,
					"content": "请您快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680117,
					"content": "无论多少蘑菇都可以！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "只用三个就够了。您拿那么多，难道是准备以后每次惹提米生气，就拿出来用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680107,
					"content": "只是失手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "失手打到鸽子和鸭子？那么您遇见的那些强敌，一定也是您「失手」击败的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680108,
					"content": "力量就是来自于这种平时的累积。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "您…您，我…算了，看来您的实力，确实是很全面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
