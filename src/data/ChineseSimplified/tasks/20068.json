			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞丝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680501,
					"content": "请您快把土豆饼送去给提米吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680502,
					"content": "提米说的妈妈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "是我。我一直在照顾着一些需要照顾的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680504,
					"content": "提米是我照顾时间最长的，逐渐就叫我「葛瑞丝妈妈」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680505,
					"content": "但是，我终归不是他真正的家人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680506,
					"content": "提米为什么会这么生气？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "您…您怎么会问出这种问题来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680508,
					"content": "那孩子在城里也没多少朋友和亲近的人，除了诺拉和葛罗丽之外，就只有小动物们愿意一直陪他玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200680509,
					"content": "而且，那群鸽子还…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680510
					],
					"speakerTitle": "葛瑞丝"
				},
