	"talks": [
		{
			"id": 7352701,
			"completionStepIds": [
				7352701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352701",
							"2"
						],
						"stepId": 7352701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沙蒂永"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735270101,
					"content": "没想到啊，被警告后，你们两位不是直接离开，而是顺着广播的声音找过来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270102
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270102,
					"content": "不好意思，这个游乐项目还没正式启动，要麻烦你们再等一会儿了，几分钟就好，我正在做最后的调试…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270103,
						735270104
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270103,
					"content": "你在谋划什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270105
					]
				},
				{
					"id": 735270105,
					"content": "我们听见了很危险的词——水炮！应该就是那边的大东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270106,
					"content": "呜哇！单看外形就很吓人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270107,
					"content": "你想在这里搞什么名堂？我们不能坐视不理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270108,
					"content": "不不不，两位误会了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270109
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270109,
					"content": "我是游乐项目「飞迸湍流大作战」的负责人沙蒂永，这个项目只是个以海上大战为背景的，轻松愉快的游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270110
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270110,
					"content": "「飞迸湍流大作战」得到了伊迪娅女士的批准，安全性你们大可放心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270111
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270111,
					"content": "要是不信我，可以看看伊迪娅女士签字的文件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270112
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270112,
					"content": "可疑的工程师沙蒂永找来了相关证明，均为用词相当严谨正式的文书，每一份都可见伊迪娅字迹灵动的签名。\\n旁边还附上了几句祝福，单论字迹和语言风格，的确是伊迪娅本人没错…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735270113
					]
				},
				{
					"id": 735270113,
					"content": "原来是伊迪娅允许的游乐项目啊…吓我们一大跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270114,
					"content": "那你提到过的水炮，是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270115,
					"content": "只是一个简单的比方而已，游乐装置的全名实在太长了，一般人肯定会根据外形，直接叫它们水炮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270116
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270116,
					"content": "不过，这种装置发射的水球是无害的，只不过打中靶标后，飞溅的水可能把附近游客全身弄湿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270117
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270117,
					"content": "有的人喜欢被水打湿后冰凉凉的感觉，有的人却很讨厌湿漉漉的衣服贴在身上，不能让后者心情不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270118
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270118,
					"content": "如果有余力，我还想在附近布置一些警告牌呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270119
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270119,
					"content": "没想到你还挺贴心的嘛，说得很有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270120,
						735270121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270120,
					"content": "我也有点好奇了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270122
					]
				},
				{
					"id": 735270122,
					"content": "其实是「鳄型涡流聚引原理鳄式外甲海战用重型舰炮式娱乐水球发射炮」，兼顾了原理和外形的准确命名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270123
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270123,
					"content": "真的好长！完全没记住，没理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270124,
					"content": "但简称成水炮，好像又缺少了一点气势？那不如就叫它…「鳄鳄炮炮」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270125,
					"content": "这种叠词的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270126
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270126,
					"content": "很形象！既简单好记，又模拟了海战过程中，炮弹飞掠而过的声音，我觉得好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270127
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270127,
					"content": "鳄鳄~炮弹来袭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270128
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270128,
					"content": "鳄鳄~水球发射！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270129,
						735270130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270129,
					"content": "你认真的吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270131
					]
				},
				{
					"id": 735270131,
					"content": "总而言之，我觉得我们很合拍！你们肯定也能在这个游乐项目中找到独一无二的乐趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270132
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270132,
					"content": "不如，就由你们两位来当「飞迸湍流大作战」的第一批顾客吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270133
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270133,
					"content": "游戏的原理很简单！调整「鳄鳄炮炮」的指向，打中各种气球标靶，就能获得相应的积分，得分够高时还能获得一些奖励！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270134
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270134,
					"content": "也对，聊了这么久，我也想试试看了，操纵「鳄鳄炮炮」的感觉究竟是什么样的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270135,
						735270136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735270135,
					"content": "那好吧，我也来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270137
					]
				},
				{
					"id": 735270137,
					"content": "完美！我这就把最后一点设备调试完毕，你们马上就可以开始游戏了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270138
					],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270138,
					"content": "希望你们玩得开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙蒂永"
				},
				{
					"id": 735270136,
					"content": "鳄鳄炮炮~开火！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270137
					]
				},
				{
					"id": 735270130,
					"content": "不准敷衍派蒙哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270131
					]
				},
				{
					"id": 735270121,
					"content": "它的本名是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270122
					]
				},
				{
					"id": 735270104,
					"content": "赶快住手吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270105
					]
				}
			]
		}
	]
}