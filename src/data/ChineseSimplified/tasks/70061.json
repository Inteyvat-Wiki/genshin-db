			"dialogs": [
				{
					"id": 700610701,
					"content": "哦…你们回来了？怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610702,
					"content": "已经赶跑啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "啊，真是太感谢你了，来，这是给你的酬劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610704,
					"content": "付出了劳动，就应该拿到报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610705,
					"content": "这下也能重新修整花田了，希望这次不会再有什么不是人的家伙来捣乱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
