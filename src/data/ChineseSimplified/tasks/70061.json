			"dialogs": [
				{
					"id": 700610101,
					"content": "唉，又是这样，怎么花田又变成这个样子…真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610102,
					"content": "这样，花又不能按期交付，该怎么和收花的人说呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610103,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "花田被毁了…唉你看看，本来多好的花呀，被祸害成了这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610105,
					"content": "都是那个家伙干的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610106,
					"content": "过分，真不是人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "是啊！真不是人…虽然这么说，但做出这种事的确实不是人，而是一只林猪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610108,
					"content": "不知道为什么，最近总是跑下来啃花，还在花田里滚来滚去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610109,
					"content": "又特别狡猾，每次弄出动静，一旦有人围过来，就会立刻逃跑，刚刚还差点把路过老人的腰撞坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610110,
					"content": "过分，真不是…真不是好林猪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610111,
					"content": "唔，仔细一看…哦，你不是荣誉骑士吗，拯救蒙德的大英雄，就，就请帮帮我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610112,
					"content": "好，我来赶跑它！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "你愿意出手帮忙就太好了…我记得，它好像跑到山谷里去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610114,
					"content": "但这家伙特别狡猾，说不定得用花才能把它引诱出来…可惜花田现在变成这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "莉奥波汀"
				},
				{
					"id": 700610115,
					"content": "也许你能在路上采几朵风息花，把它骗出来，让它也知道被人捉弄的味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奥波汀"
				}
			]
		},
