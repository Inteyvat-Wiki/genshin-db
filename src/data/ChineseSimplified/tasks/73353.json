				]
			},
			"dialogs": [
				{
					"id": 733530101,
					"content": "#打扰一下，请问是{NICKNAME}吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530102,
						733530103
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530102,
					"content": "是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530104
					]
				},
				{
					"id": 733530104,
					"content": "你好你好，幸好没有认错人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530105
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530105,
					"content": "自我介绍一下，我是生论派的陀裟多，名字是陀罗诘利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530106
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530106,
					"content": "之前虽然听说过您的事情，但我们其实并不了解您本人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530107
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530107,
					"content": "正好我们最近在做与梦境相关的研究，草神大人便告诉我们您在辨别梦与现实方面，比她见过的所有人都要冷静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530108
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530108,
					"content": "过奖过奖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530109
					]
				},
				{
					"id": 733530109,
					"content": "您太谦虚了，我们项目处理的就是梦与现实的问题，数据告诉我，入眠后能主动醒来是件很难的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530110
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530110,
					"content": "我们的研究是利用梦境对人的心理影响，调节人们的各种心理障碍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530111
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530111,
					"content": "具体来说，我们会根据每个病人的情况，通过针对性的环境暗示与引导，塑造一个合适的梦境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530112
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530112,
					"content": "进入共同梦境的这部分技术还不成熟，中间依靠草神大人做了许多改进，简单来说我们的目标是在梦境中调整病人的认知，以改善心理问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530113
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530113,
					"content": "听起来好复杂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530114
					]
				},
				{
					"id": 733530114,
					"content": "啊，不好意思，说到自己项目的事就变得话多了起来，是有些复杂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530115
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530115,
					"content": "说白了，我们在做梦境影响心理的医学研究，比较糟的是，现在卡在了实践这一步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530116,
						733530117
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530116,
					"content": "你们要我帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530118
					]
				},
				{
					"id": 733530118,
					"content": "被您一下子猜到了，真是不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530119
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530119,
					"content": "我们项目组的成员都没办法在梦境中保持清醒的认知，本来沮丧得不行，知道有您这样的人存在才燃起了希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530120
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530120,
					"content": "还得感谢草神大人，要不是她听完我们的汇报之后建议我们找您商量，这个项目大概就得搁浅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530121
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530121,
					"content": "我有信心，如果能把这套心理疗法推广开的话…教令院的年度心理疾病统计数能降不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530122
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530122,
					"content": "所以您刚才的意思是愿意帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530123
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530123,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530124
					]
				},
				{
					"id": 733530124,
					"content": "太好了！我马上就整理安排病人的资料，您方便的时候可以来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530125
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530125,
					"content": "实验流程是这样的，您只需要放松，和病人一起进入梦境就完成了一半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530126
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530126,
					"content": "接下来只需要根据资料中的指示，找到梦中与病人有关的扭曲异常之处，纠正它们，再离开梦境就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530127
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530127,
					"content": "放心，我们准备了脱离梦境的应急措施，比起实验成功，志愿者和病人的安全更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530128
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530128,
					"content": "每一位病人的情况各有不同，需要酌情应对。只要您有空，请随时来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530129
					],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530129,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530130
					]
				},
				{
					"id": 733530130,
					"content": "感谢您的慷慨，我们稍后见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "陀罗诘利"
				},
				{
					"id": 733530117,
					"content": "帮忙的报酬怎么算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530118
					]
				},
				{
					"id": 733530103,
					"content": "有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530104
					]
				}
			]
		}
	]
}