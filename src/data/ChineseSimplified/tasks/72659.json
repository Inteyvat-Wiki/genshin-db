			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉玮",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726590201,
					"content": "大海就像美女，偶尔见见就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590202
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590202,
					"content": "你是嘉玮吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590203
					]
				},
				{
					"id": 726590203,
					"content": "嗯，找我有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590204
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590204,
					"content": "喔——「海中月」！居然是「海中月」啊！那段经历，真是令人印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590205
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590205,
					"content": "鲸井那家伙，果然也是念念不忘，毕竟她的愿望…嗯…嗯…嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590206
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590206,
					"content": "那我就把最美好的祝福送给你们，祝你们成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590207
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590207,
					"content": "欸？我们是来邀请你的呀，你不打算一起去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726590208,
					"content": "哎呀，当年那趟出海，我可是差点没命呢。大海呢，就像美女，偶尔见见就好啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590209
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590209,
					"content": "而且，作为一个已经成家的男人，怎么能弃家庭不顾？我当然要承担起丈夫的责任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590210
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590210,
					"content": "毕竟我付出了多少努力、多少汗水，才娶到一个这么慷慨、富有的妻子！所以，抱歉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590211
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590211,
					"content": "你的老朋友会失望的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590212
					]
				},
				{
					"id": 726590212,
					"content": "不要说这种话…让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590213
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590213,
					"content": "虽然我没法加入，但我会用另一种方式支持你们，我要把我的钓鱼技巧与宝贵经验全部传授给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590214
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590214,
					"content": "「海中月」这种传说中的生物，可不是随随便便就能钓上来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590215
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590215,
					"content": "所以，请接受我的训练，继承我的意志，再去追寻神秘大鱼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590216
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590216,
					"content": "哦对了，你们是不是急着去找楠塔克？别急，那家伙就像个冬眠的老海龟一样，一直在呆在蒙德呢，据说是在写书还是干嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590217
					],
					"speakerTitle": "嘉玮"
				},
				{
					"id": 726590217,
					"content": "现在集中精力，嘉玮的魔鬼钓鱼训练要开始了！训练完成之后再去找他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉玮"
				}
			]
		},
		{
