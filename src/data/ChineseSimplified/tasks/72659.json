				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鲸井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726590101,
					"content": "「海中月」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590102
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590102,
					"content": "什么「海中月」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590103
					]
				},
				{
					"id": 726590103,
					"content": "啊，你好！你就是那个...来自冒险家协会的钓鱼家吧？我是鲸井椛，稻妻本地的渔师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590104
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590104,
					"content": "我从鱼协听说了你的事迹，今天一见，果然是年轻有为的样子，希望我没找错人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590105
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590105,
					"content": "我最近正在寻找一条传说中的大鱼，叫作「海中月」，传说中，它能够实现人们的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590106
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590106,
					"content": "呜哇——实现愿望的大鱼欸！是我喜欢的传说故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726590107,
					"content": "嗯，虽然大家都觉得是故事，但…我相信这是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590108
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590108,
					"content": "因为几年前，我可能真的遇到过「海中月」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590109
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590109,
					"content": "那它实现了你的愿望吗?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590110
					]
				},
				{
					"id": 726590110,
					"content": "嗯…算是吧，事情是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590111
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590111,
					"content": "几年前，因为各自的愿望，我和两个朋友，一个叫嘉玮，一个叫楠塔克，我们一起出海，去追捕这条传说中的「海中月」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590112
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590112,
					"content": "但路途很不顺利，我们遭遇了雷暴，虽然渔船撑了下来，可罗盘彻底损坏了，我们迷失在一片未知的海域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590113
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590113,
					"content": "几天后，还是没有找到回家的方向，淡水已经告罄，大家虽然嘴上没说，但心里已经绝望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590114
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590114,
					"content": "甚至有天半夜，嘉玮那家伙偷偷起来，写了遗书，放进漂流瓶丢了出去，接着想要投海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590115
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590115,
					"content": "他不知道，我们也没睡着，听见动静出去，这才拉住了他。也就在那时候，我们看见，海面下忽然浮现出了一个巨大的影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590116
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590116,
					"content": "那影子发着淡淡的荧光，星星点点地闪耀着，像打碎的月亮落入海洋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590117
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590117,
					"content": "那是「海中月」吗？走投无路的我们这样想着，慌忙许愿，请它保佑我们平安返航。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590118
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590118,
					"content": "是的，跟你想的一样，我们活下来了。那影子就像有魔力一样往远方游去，我们跟着它，那就是我们回家的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590119
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590119,
					"content": "呜哇——真是个令人感动的传说故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726590120,
					"content": "不，这是真的！相信我。我们一定还能再找到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590121
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590121,
					"content": "要怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590122
					]
				},
				{
					"id": 726590122,
					"content": "先去找我那两位老朋友吧，他们都是经验丰富的渔师，有他们加入会轻松不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590123
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590123,
					"content": "<color=#00E1FFFF>嘉玮就在璃月港，</color>我知道他回了璃月港就没有出去过了，应该也很怀念「海中月」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590124
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726590124,
					"content": "至于楠塔克，我只听说他后来当了海洋作家，等你们见到嘉玮，可以和他打听一下他在哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井椛"
				}
			]
		},
		{
			"id": 7265902,
			"completionStepIds": [
				7265902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
