			"trigger": {
				"objectNames": [
					"宁禄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "唉，怎么办才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111402,
					"content": "你就是宁禄吗？凯亚说你找他有事，他现在走不开，让我们来帮你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111403,
					"content": "嗯？旅行者，没想到是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111404,
					"content": "是这样的，我在为我太太准备风花节的礼物，想麻烦酒友凯亚出个主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111405,
					"content": "呃…我、我这人，酒瘾有些重，三天两头泡在酒馆。我太太反对我喝酒，为此我们总是吵架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111406,
					"content": "原来你是个酒鬼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111407,
					"content": "我明白，酒是好东西！不过你这样的喝法，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111408,
					"content": "道理我都懂，所以才觉得，有些对不起她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111409,
					"content": "旅行者，能麻烦你们帮我搜集材料吗？我想亲手制作一份礼物送给我太太。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111410,
					"content": "按理说我得自己准备，可最近酒喝多了，一不留神睡了过去。醒来时庆典已经开始啦！凭我自己，多半是来不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111411,
					"content": "这人也太乱来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111412,
					"content": "未婚的蒙德人可不敢在庆典期间托人办事，宁禄，还好你已经结婚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111413,
					"content": "哎哎，是啊…真抱歉，让你们看笑话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111414,
					"content": "真没办法。说吧，需要什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111415,
					"content": "我会在城里搜索木材，用于填充的植物只能到野外采集，就拜托你们了。我需要2株小灯草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111416,
					"content": "小灯草和木板，能做出什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111417,
					"content": "我想用木板搭一间小房子，配上发光的花朵和手工制作的小家具…送给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111418,
					"content": "很温情的礼物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111419,
					"content": "一点心意，哈哈。我刚认识她那会儿，经常给她做手工小礼物，她非常喜欢，还说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111420,
					"content": "啊！咳咳，抱歉，以前的事就不提了。总之，麻烦各位啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414111421,
					"content": "算你运气好，遇到我们这么好心的帮手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111422,
					"content": "走吧！去找他要的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
