			"dialogs": [
				{
					"id": 414110101,
					"content": "哟哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110102,
					"content": "旅行者，派蒙，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110103,
					"content": "我才想到你们，你们就来了，真巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110104,
					"content": "凯亚，你的作业写完了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110105,
					"content": "恐怕要让你失望了，我还没开始写。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110106,
					"content": "不交作业的学生可不是好学生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110107,
					"content": "凯亚不做作业是在忙什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110108,
					"content": "嗯~如你所见，在帮琴团长处理各种事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110109,
					"content": "庆典期间蒙德城里热闹得很，随之而来的杂事也多得可怕。我已经忙了好久啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110110,
					"content": "旅行者，能请你帮个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110111,
					"content": "有位酒友托我办事，但我实在脱不开身…想请你代我跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110112,
					"content": "酒友，是在酒馆认识的朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110113,
					"content": "是啊。下班偶尔去酒馆喝一杯，不知不觉结交了许多朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110114,
					"content": "他叫宁禄，一般会在酒馆附近出没。这个时间，我猜他应该闲着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110115,
					"content": "我得留下来写作业，宁禄的事就麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110116,
					"content": "凯亚，作业加油哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "好吧，也算是融入庆典。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
