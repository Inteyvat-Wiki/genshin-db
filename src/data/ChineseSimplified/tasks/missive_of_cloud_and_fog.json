			"dialogs": [
				{
					"id": 414110301,
					"content": "谢谢，谢谢你们！有了这个，我马上就能开工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414110302,
					"content": "不要只是做礼物，以后也要好好对你太太呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110303,
					"content": "一定，一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414110304,
					"content": "唉，要是我做的这些礼物能让她喜欢就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 414110305,
					"content": "没人不喜欢饱含情意的礼物，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110306,
					"content": "好好做哦，不要浪费了我们辛辛苦苦找来的材料。",
