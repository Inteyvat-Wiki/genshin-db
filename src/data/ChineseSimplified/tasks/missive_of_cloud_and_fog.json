			"dialogs": [
				{
					"id": 414110501,
					"content": "我们回来啦！凯亚，你写完了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110502,
					"content": "老师要来收作业啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110503,
					"content": "欢迎回来，我这边刚好也差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110504,
					"content": "快快快，交作业交作业~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110505,
					"content": "来了来了，别笑话我就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110506,
					"content": "嗯…嗯？唔唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110507,
					"content": "卖唱的，点评一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110508,
					"content": "凯亚，我可以把这首诗读出来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110509,
					"content": "请吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110510,
					"content": "咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110511,
					"content": "「mi muhe ye\\n在丘丘人的语言里\\n是我爱你。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110512,
					"content": "嗯？嗯？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110513,
					"content": "读完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110514,
					"content": "没啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110515,
					"content": "主旨清晰，表达到位，我认为这种长度足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110516,
					"content": "哎哎哎？！完全就是丘丘语教学啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110517,
					"content": "太扯了，根本没有爱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				},
				{
					"id": 414110519,
					"content": "哈哈哈，不觉得是很有我风格的情诗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110520
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 414110520,
					"content": "更像是敷衍的情诗呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110521
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414110521,
					"content": "凯亚居然会丘丘人语？好奇怪啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110522,
					"content": "哈哈，别小看西风骑士团骑兵队长的知识储备哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110523
					],
