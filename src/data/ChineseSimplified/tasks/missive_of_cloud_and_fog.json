					"id": 414111023,
					"content": "这位修女小姐要同行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111024
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111024,
					"content": "我就不必了。一看就知道，不是什么大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111025
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 414111025,
					"content": "嗯？她刚才说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111026
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111026,
					"content": "没什么。你们去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111027
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 414111027,
					"content": "芭芭拉小姐，你好点了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111028
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111028,
					"content": "嗯！我、我没事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111029
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111029,
					"content": "罗莎莉亚说得对，与其自己吓自己，不如直接去领教犯人的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111030
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111030,
					"content": "没错没错，我们几个一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111031
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111031,
					"content": "谢谢各位，那我们现在就去地图指向的地方看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111032
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111032,
					"content": "好，芭芭拉冲呀——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4141113,
			"completionStepIds": [
				4141113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141113",
							"2"
						],
						"stepId": 4141113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111302,
					"content": "这是什么，快打开看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111303,
					"content": "我、我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111304,
					"content": "这么精致的礼盒，却出现在这种荒郊野岭，好有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111305,
					"content": "……咦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111306,
					"content": "哇，好精致的风车菊花环，还有很多纸星星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111307,
					"content": "是恶作剧吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "所谓的「犯人」好像是芭芭拉小姐的粉丝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111310,
					"content": "还有张字条，写了什么呢？我看看…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111311,
					"content": "「很抱歉用这样的方式吸引您，为您的美德与可爱献上饱含诚意的风之花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111312,
					"content": "哈？以恐吓为手段的骗局？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111313,
					"content": "无论是对神明还是对重要、挚爱之人，都要以最饱满的情感献上鲜花。这才是如今风花节的核心仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111314,
					"content": "为了在特殊的节日里向你送出爱与祝福之花，不惜选择引人瞩目的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111315,
					"content": "看似吓人，背后却是精心准备的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111316,
					"content": "呜，真离谱…怎么听都是个没分寸的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111317,
					"content": "哈哈哈，确实。这样的人选，我心中似乎有一个哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111318,
					"content": "你说的是谁呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111319,
					"content": "（我好像也想到了呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "嘘…不要说出来，让小派蒙猜一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 414111321,
					"content": "啊！怎么这样啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111308,
					"content": "是引起注意的手段吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
			"id": 4141114,
			"completionStepIds": [
				4141114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
