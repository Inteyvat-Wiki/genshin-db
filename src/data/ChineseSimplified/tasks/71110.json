			"dialogs": [
				{
					"id": 711101001,
					"content": "两位，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101002,
					"content": "看见这些展出的画片了吗？这次的「沉玉之旅」一共有八幅入选作品，你们包揽了其中一半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101003,
					"content": "恭喜你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101004,
					"content": "哇！这也太棒了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711101005,
					"content": "#{NICKNAME}！我就说吧，最后的结果是四分之四呢！我的算数真是越来越厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711101006,
					"content": "明明是八分之四吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "呵呵，就和我昨天的看法类似，评委们对你们另外两幅作品也赞赏有加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101009,
					"content": "所以，请收好这份限量版「沉玉之旅」留影纪念册，里面收录了这次的全部入选作品。这是你们应得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101010,
					"content": "这就是惊喜吗？看起来很漂亮呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711101011,
					"content": "如果不嫌弃的话，我这里还有一些摩拉，请收下吧。我要再次感谢你们的支持，这次是以私人的身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101012,
					"content": "因为这里是我的家乡，你们把她美丽动人的地方永远地记录了下来，这些画片一定会让更多人喜欢上这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101013,
					"content": "谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "方矩"
				},
				{
					"id": 711101007,
					"content": "哇！派蒙真是太会算数了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
