			"dialogs": [
				{
					"id": 711100101,
					"content": "两位是来参加「沉玉之旅」风光留影赛的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100102,
					"content": "风光留影赛？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100103,
					"content": "顾名思义，是一个为了宣传沉玉谷美丽风光的留影比赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100104,
					"content": "早先我们发出了问卷，向广大居民收集沉玉谷最有魅力的风光点。而参赛者则需要前往被挑选出的地点，用留影机拍下对应的画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100105,
					"content": "最后我们会评选出一些优秀的画片，作为宣传示例，放在合辙驿外的大街公开展出。怎么样，两位有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100106,
					"content": "我是个俗人，有什么奖励吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "若您提交的作品成功入选，当然有一份专属于您的惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100110,
					"content": "哇！有惊喜！那我们一定要努力把惊喜拿到手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100111,
					"content": "呵呵，即便最后遗憾落选，我们也准备了一份小小的报酬，为两位所付出的时间与心力。希望能让两位满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100112,
					"content": "那要怎么开始？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "请看看这份指南，里面是由沉玉谷居民们推荐的魅力风光点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100115,
					"content": "咦？怎么还有些被划掉的地方呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100116,
					"content": "呵呵，因为那些地点的报名人数已经满了，我们希望能更加全面地展示沉玉谷美景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100117,
					"content": "剩下这四处是仍然可以报名的地点，您可以从中任选一处或几处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "方矩"
				},
				{
					"id": 711100118,
					"content": "#原来是这样…{NICKNAME}，不如我们把剩下的地方都包了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100119,
					"content": "假如拍一张画片的获奖概率是四分之一，那我们拍四张，这样就是四分之四了！也就是一定能拿到获奖的惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100120,
					"content": "不是这么算的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "不是吗？可四分之一乘以四不就等于四分之四吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100122,
					"content": "这倒是没错，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "嘿嘿，那还说什么，我们现在就出发吧！为了最后的惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711100123,
					"content": "算的不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "很好，没人比我更擅长留影。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "看来您已经干劲满满了。请容我补充，若您提交的作品成功入选，我们还有一份专属于您的惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "方矩"
				}
			]
		},
