			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "我亲爱的朋友，你也是来参加留影风光赛的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "马里"
				},
				{
					"id": 711100202,
					"content": "作为一名从留影机的发源地走出的枫丹摄影师，让我给你们一个忠告：所谓留影，精髓中的精髓其实就在于留影机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "马里"
				},
				{
					"id": 711100203,
					"content": "所以，我给你们介绍一个人吧，在我的家乡，他制作的留影机没有人不喜欢，价格也实惠，我手里就有购买渠道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "马里"
				},
				{
					"id": 711100204,
					"content": "欸欸…别露出那种不感兴趣的表情啊，我再多给你们申请点折扣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "马里"
				},
				{
					"id": 711100205,
					"content": "欸欸…别走啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马里"
				}
			]
		},
