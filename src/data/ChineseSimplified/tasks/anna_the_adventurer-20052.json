				{
					"id": 200520301,
					"content": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520302
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200520302,
					"content": "你不希望她做冒险家吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520303
					]
				},
				{
					"id": 200520303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520304
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200520304,
					"content": "我尊重我妹妹的梦想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520305
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200520305,
					"content": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520306
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200520306,
					"content": "作为她的哥哥，我…会全力支持她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520307
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200520307,
					"content": "就这样。",
