			"dialogs": [
				{
					"id": 700160201,
					"content": "Yoyo dada! Mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160202
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160202,
					"content": "Mimi muhe du, du ya Wei zido dala si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160203
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700160203,
					"content": "Mi mito nye. Mi mito du, du ya mito Wei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160204
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160204,
					"content": "它把我们指到了这个地方。说这里应该有人看过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160205
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700160205,
					"content": "Valo! Tomo!",
