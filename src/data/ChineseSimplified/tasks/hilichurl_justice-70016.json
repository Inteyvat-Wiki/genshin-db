			"dialogs": [
				{
					"id": 700160101,
					"content": "…Yaya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160102
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160102,
					"content": "Mimi tomo, mimi mosi mita, Muhe mita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160103
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700160103,
					"content": "Mita…? Gusha… Dada ika odomu Plata mimi, mimi mosi gusha…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160104
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160104,
					"content": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700160105,
					"content": "Mani…? Dada! Kundala zido mi, mi dada, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160106
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160106,
					"content": "他们两个聊得很开心的样子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160107,
						700160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700160107,
					"content": "不愧是马斯克小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				},
				{
					"id": 700160109,
					"content": "其实它只是不爱说话而已，不过我已经问到需要的信息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160110
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700160110,
					"content": "帮助它打败敌人就好，接下来就交给你们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160111
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700160111,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160108,
					"content": "对话进行得很顺利呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				}
			]
		},
