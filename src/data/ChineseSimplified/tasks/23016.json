							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿汉格尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "都说了等一会…嗯？怎么是你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160202,
					"content": "我是代他来请教的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "他还真去自己做了啊…真是个怪人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160205,
					"content": "我打了这么多年铁，从来没见过要求这么细致的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160206,
					"content": "他居然还会拿着尺量铁管之间的接缝粗细，还有螺纹的间距。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160207,
					"content": "我实在是不耐烦了，就说他有本事自己去做…结果他第二天还真的过来请教铸造的手法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160208,
					"content": "我真是服了他了，就随他去了，只要他自己出材料钱，工具什么的都让他用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160209,
					"content": "唉，真不知道这家伙想做什么东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160210,
					"content": "他在做一个伟大的机器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "行吧…反正都是怪东西。你们是来问铸造手法的对吧？做齿轮这件事我也没什么好教的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160213,
					"content": "不过，我注意到这家伙要的齿轮边缘都很锐利，中间却要凹下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160214,
					"content": "这种异型齿轮单靠模具很难直接做出来，他必须要再把齿轮二次加工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160215,
					"content": "具体操作我之前都教过他了，你就回去告诉他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160216,
					"content": "首先，二次入炉的时候，<color=#00E1FFFF>燃料记得加多点</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160217,
					"content": "然后，拿出来加工的时候，<color=#00E1FFFF>从内向外敲打</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160218,
					"content": "怎么样，记住了吗？记住了就回去告诉他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160219,
					"content": "真是个怪人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230160211,
					"content": "他在做一个奇怪的机器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "他手敲麻了，休息一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
