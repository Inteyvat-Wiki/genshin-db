			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加尔恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "我的手…呃！全麻了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160102,
					"content": "先生，您过段时间还要给迦雅小姐计算账目，可不要过分劳累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160103,
					"content": "我，我知道！别提这个，路通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160104,
					"content": "当然，如果您不能去的话，我也可以为您代劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160105,
					"content": "不！我自己会去，我只要再…再砸出几个齿轮来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160106,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160107,
					"content": "好吧，我砸不动了，我真的砸不动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160108,
					"content": "你又在干啥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "是你啊，旅行者…哎哟…我的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160110,
					"content": "是这样，因为阿汉格尔先生还有其他的工作，不能一直帮我制作我要的零件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160111,
					"content": "而且他所制作的零件，总是和我想要的有一些细微的差别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160112,
					"content": "所以，为了保证这些零件的可靠性，我就直接向阿汉格尔先生请教了一下铸造的手法，决定自己来亲手铸造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160113,
					"content": "还好在枫丹的时候我有过类似的工作经验…但阿汉格尔先生和我说的那些手法，有些我是真记不住，哎哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160114,
					"content": "旅行者，请您代我向阿汉格尔先生再请教一下手法，我是真的需要休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160115,
					"content": "你在这好好休息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "谢谢您愿意帮忙，哎哟…我的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160116,
					"content": "迦雅是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "生意伙伴！一个…呃…才华横溢，财富也横溢的…生意伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160118,
					"content": "我们之间签了长期的账目管理合同！所以我才会一直去找她，对吧路通？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230160119,
					"content": "您说得很有道理，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160120,
					"content": "总，总之就是这样…旅行者，请您快些去找阿汉格尔先生请教一下吧，我就在这等您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
