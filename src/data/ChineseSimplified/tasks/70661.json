					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "向着星辰与深渊，欢迎来到冒险家协会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706610102,
					"content": "我们最近接到了一份钓鱼协会的委托，他们声称附近水域的鱼类活动出现了异常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706610103,
					"content": "不过具体情况倒没有说明，您能帮忙去看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706610104,
					"content": "我想是您的话，无论什么情况，一定都能轻松应对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706610105,
					"content": "钓鱼协会？是那个钓鱼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "欸？那个钓鱼？我不太明白…您说的钓鱼，是哪个钓鱼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 706610107,
					"content": "哎呀，钓鱼协会钓鱼协会，一听就是钓上了很多好吃的鱼的协会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610108,
					"content": "不要浪费时间了啦，我们赶紧去看看吧！嘿，嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
