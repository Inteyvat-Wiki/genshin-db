			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楠塔克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "就这里了！看见水里那些小鱼儿了吗？真漂亮...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610402,
					"content": "这些是给你准备的工具，有鱼竿、鱼饵、还有鱼饵的制作配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610403,
					"content": "先在鱼钩上填好鱼饵，再瞄准鱼群聚集的地方…抛竿！然后乖乖等鱼儿上钩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610404,
					"content": "听说新人身上都会有「新手好运」啊，我当年可是钓上了一条半米多的大鲈鱼！你也来试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610405,
					"content": "希望能再钓一只小派蒙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "有一个我还不够吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610407,
					"content": "派蒙？这个名字倒是很陌生，也是一种鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610408,
					"content": "是以前钓的「神奇海鲜」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "喂！已经从「应急食品」变成「神奇海鲜」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610410,
					"content": "原来如此！没想到你已经是个小有经验的钓鱼家了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610411,
					"content": "那我就更加期待你的收获了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楠塔克"
				}
			]
		},
