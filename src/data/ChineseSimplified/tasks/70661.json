			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楠塔克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "最近的鱼可真是活跃啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610202,
					"content": "有什么需要帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "啊，帮手终于来了，你们好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610204,
					"content": "我是楠塔克，蒙德鱼协的资深钓鱼家，咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610205,
					"content": "最近，附近水域突然出现了很多新鱼种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610206,
					"content": "我立刻和其他地区的同好交流，果然，各地都出现了这种情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610207,
					"content": "还有人说，这是提瓦特来到了百年一见的鱼类爆发期呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610208,
					"content": "其实原因还没有完全查明，但我猜多少都跟生态环境变好有关系...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610209,
					"content": "喔——一定是这些家伙太多，给你们带来了麻烦吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610210,
					"content": "别担心，包在派蒙身上吧！只要它们不难吃的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610211,
					"content": "哈哈，倒也不是麻烦，对钓鱼协会来说，鱼群当然是越多越好，只不过前提是人手足够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610212,
					"content": "但实话说，以我们现有的人力来看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610213,
					"content": "要在短期钓上来所有的新鱼种来做研究…确实有些压力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610214,
					"content": "不过反过来看，这不也是钓鱼协会发展的绝佳机会吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610215,
					"content": "所以我就在冒险家协会挂上了委托。怎么样？有兴趣加入我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610216,
					"content": "钓鱼可是很有意思的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610217,
					"content": "没问题，我很擅长钓鱼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "好，真是充满干劲的年轻人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610223,
					"content": "那么现在，先跟我去果酒湖另一边吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610224,
					"content": "那里有我们给新人准备的钓鱼场地，我先教你些最基本的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610219,
					"content": "我可以直接下去抓吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "直接跳下去多危险呀？你们这些冒险家还真是勇敢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610221,
					"content": "可惜那些鱼儿没你们勇敢，看见这么大个活人跳进水里，它们肯定全吓跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610222,
					"content": "还是不要做这种事比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "楠塔克"
				}
			]
		},
