					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040102,
					"content": "胡塞尼，你怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040103,
					"content": "之前在矿道处为了想出将「普尔希娜光钉」搬运到地脉喷口的办法，在矿道逗留了太久，受到了一些影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040104,
					"content": "不过没什么大碍，休息了一会儿以后，已经恢复很多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040105,
					"content": "与此同时，我也已经想出了解决方案，只是找一个搬运「普尔希娜光钉」的办法，还能比找一个拖延交研究报告的借口困难？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040106,
					"content": "黑泥覆盖了地面，那就稍微浮空一点，用热气球在矿道进行搬运不就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040107,
					"content": "这么一说，热气球确实还算是不错的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040108,
					"content": "当然，这样虽然可以一定程度上解决了黑泥的问题，但是存在过量黑泥淤塞通道的时候，也还是会影响热气球的前进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040109,
					"content": "以及，黑泥周围还会有引来的怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040110,
					"content": "这些恐怕就得交给你们解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040111,
					"content": "#放心吧，我和{NICKNAME}联手，一定能把那些靠近热气球的怪物统统打跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040112,
					"content": "待会儿主要看你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "我、我主要是在旁边负责给你加油打气嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715040115,
					"content": "哈哈哈呃咳、咳咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040116,
					"content": "这么笑了一下就咳得那么厉害…总之老图和阿昊在帮忙打包「普尔希娜光钉」，做热气球的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040117,
					"content": "本来我想亲手做「普尔希娜光钉」的打包的，可就多站了一会儿，咳嗽咳得手都发抖了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040118,
					"content": "真是惭愧，看来以后不仅要做学术研究，还得注意锻炼一下身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040119,
					"content": "你快点去找他们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715040113,
					"content": "我手上这把剑就暂借你一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
		{
