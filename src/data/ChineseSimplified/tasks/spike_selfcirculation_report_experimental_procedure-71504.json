			"trigger": {
				"objectNames": [
					"老图",
					"阿昊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#嘿，{NICKNAME}，我们这刚打包好你就下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715040202,
					"content": "那个须弥佬已经跟你说了吧，要用这个热气球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715040203,
					"content": "什么叫「须弥佬」啊，胡塞尼可是来帮我们处理这些黑泥的，须弥的大学者，你就不能尊重别人一点嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715040204,
					"content": "你、你懂什么，这种称呼也是一种表示熟络的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715040205,
					"content": "行了，热气球也确定能够使用，清理黑泥用的仪器也都准备好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}，如果你需要挖矿巨星我的帮忙…咳咳…咳咳…算了，我估计也帮不上什么忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "老图"
				},
				{
					"id": 715040207,
					"content": "知道就好，你还是好好休息着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "阿昊"
				},
				{
					"id": 715040208,
					"content": "唉，总之，你要是打算开始搬运，启动热气球就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老图"
				}
			]
		},
