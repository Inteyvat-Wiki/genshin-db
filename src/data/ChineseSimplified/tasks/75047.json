				},
				{
					"id": 750470202,
					"content": "这就是人类。草和颗粒果一起吃的原因吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌尔"
				}
			]
		},
		{
			"id": 7504703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"呼噜克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470301,
					"content": "好困，好想睡觉…但是，要一起站着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "呼噜克"
				},
				{
					"id": 750470302,
					"content": "为什么，人，要在这里站一整天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "呼噜克"
				}
			]
		},
		{
			"id": 7504704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "唔，体重倒是控制住了，不过…嗯？怎么了，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "库西"
				},
				{
					"id": 750470402,
					"content": "请问你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "啊，我是这边哨站的看守之一，不过现在处于休假状态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "库西"
				},
				{
					"id": 750470404,
					"content": "如果有事的话就找旁边的尤考姆吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库西"
				},
				{
					"id": 750470405,
					"content": "在烦恼什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "哎呀，其实是这样，因为最近体重稍微变重了一点，所以往平时吃的颗粒果里加了很多健康的蔬菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "库西"
				},
				{
					"id": 750470407,
					"content": "但是不知道为什么，我的伙伴乌尔最近也学着吃了很多草…虽然龙都是杂食动物，可吃草太多，营养大概跟不上吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "库西"
				},
				{
					"id": 750470408,
					"content": "还是找机会好好和它聊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库西"
				},
				{
					"id": 750470409,
					"content": "没什么事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "好吧，那就祝你旅途顺利了，异邦人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库西"
				}
			]
		}
	]
