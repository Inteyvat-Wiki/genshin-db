			"dialogs": [
				{
					"id": 200380301,
					"content": "您清理完七天神像了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380302
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380302,
					"content": "都清理完了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380303
					]
				},
				{
					"id": 200380303,
					"content": "真是太感谢了，愿巴巴托斯保佑您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380304
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380304,
					"content": "请收下这些谢礼吧，以后可能也要麻烦你了呢。",
