			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"吉丽安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "唉，不知道那些七天神像怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380102,
					"content": "七天神像怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "是这样的…我以往每周都会去七天神像前祈祷，顺便为神像扫除尘埃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380104,
					"content": "多亏了神明，我才有了现在的幸福生活，这么做，也是我报答神明的一种方式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380105,
					"content": "可是自从我有了莉莉以后，出行的机会越来越少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380106,
					"content": "那些七天神像，肯定因为没人清洗而蒙尘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380107,
					"content": "虽然这么说，有点像是推卸责任。但能不能请您替我去清除一下七天神像上的灰尘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380109,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "太感谢您了，愿风神保佑您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380115,
					"content": "对了，七天神像有着神明的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380116,
					"content": "上面的「尘埃」并不能用普通的方法清理掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380117,
					"content": "不过您有着「元素」的力量，应该能轻松解决吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380118,
					"content": "不像我，一尊神像就要清理整整一天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380110,
					"content": "就让风把灰尘给吹干净…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "巴巴托斯大人和他的风，肯定每天都很繁忙，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380113,
					"content": "而且，也不能事事指望神明，自己却偷着懒呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200380114,
					"content": "就请您和我一起，为巴巴托斯大人分忧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "吉丽安娜"
				}
			]
		},
