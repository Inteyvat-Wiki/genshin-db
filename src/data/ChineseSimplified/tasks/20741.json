			"dialogs": [
				{
					"id": 207411001,
					"content": "您搜集到蒲公英了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207411002,
					"content": "搜集到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "这些就足够了，请您在这里稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207411004,
					"content": "…巴巴托斯大人，请您聆听我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207411005,
					"content": "呜哇…她好虔诚啊，说了好多话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 207411006,
					"content": "…也不知道那个「卖唱的」能不能听到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 207411007,
					"content": "好了，这些蒲公英籽交给您，请您帮我上去播撒一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207411008,
					"content": "其实是应该我自己去的，但是…以我的身手，就算能爬上去，应该也难得下来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207411009,
					"content": "所以，就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
