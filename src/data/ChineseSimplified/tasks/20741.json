			"dialogs": [
				{
					"id": 207412001,
					"content": "您把蒲公英播撒出去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412002,
						207412003
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207412002,
					"content": "已经播撒出去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412005
					]
				},
				{
					"id": 207412005,
					"content": "无论如何，希望巴巴托斯大人能够听到我的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412006
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207412006,
					"content": "谢谢您愿意帮忙，这是谢礼，请收下吧。愿风神护佑您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 207412003,
					"content": "应该会随风飘很远的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412004
					]
				},
				{
					"id": 207412004,
					"content": "那样就太好了，巴巴托斯大人也会更容易注意到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412005
