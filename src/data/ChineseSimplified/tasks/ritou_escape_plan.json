					"speakerTitle": "柊千里"
				},
				{
					"id": 20131010,
					"content": "心上人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131011,
					"content": "喂，不是吧，新之丞你难道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131012,
					"content": "没、没什么…咳咳…我只是随便问问，我怎么可能、怎么可能做那种梦呢…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131013,
					"content": "二位不必担心，这件事还请二位先当做不知道，如果家父怪罪下来，我会一人承担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131014,
					"content": "也只能如此了，唉…都听您的，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131015,
					"content": "可是千里小姐，如果真的被发现了可怎么办…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20131016,
					"content": "没关系的，家父自我小时候便非常宠我，最多会罚我半日禁食之类的而已，不必担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131017,
					"content": "原来那个老头子还有这样的一面…那好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20131018,
					"content": "请二位路上小心，我们有缘再见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131019,
					"content": "嗯，再见，千里小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20131020,
					"content": "走啊，继续运货啊，愣着干什么呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131021,
					"content": "呜…咳咳…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131005,
