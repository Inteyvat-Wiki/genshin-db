			"dialogs": [
				{
					"id": 20130701,
					"content": "啊，你们终于来了吗…我…我叫柊千里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130702,
					"content": "算是…第二次见面了吧，请多关照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130703,
					"content": "哇，真的是柊家的大小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130704,
					"content": "我才是，请多关照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "不用…不用这么客气，我早就很仰慕您的事迹，终于找到这样的机会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130707,
					"content": "嗯？怎么感觉气氛有点奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130708,
					"content": "这次偷偷见面，主要是在想…如果错过了机会，是不是就再也没办法和你讲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130709,
					"content": "讲…讲什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130710,
					"content": "讲…想让你帮忙送信的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130711,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "你和你父亲果然是父女呢！不能换一换事情做吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130714,
					"content": "不不…请等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130715,
					"content": "我是希望二位可以替我送信去鸣神岛，到天领奉行的二少爷镰治先生那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130716,
					"content": "我父亲一直反对我们联络，想必在政治上他对我的婚配对象有更好的期许，可是我的心里却只有镰治先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130717,
					"content": "在离岛没有人可以违抗父亲的意思，而你们又是难得的想往鸣神岛去的异乡人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130718,
					"content": "原来是有这样的苦衷啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130719,
					"content": "当然，与此相对的，我会全力帮助你们离开这里，请相信我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "柊千里"
