			"trigger": {
				"objectNames": [
					"小林",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "等一下！请出示「通行凭证」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "小林"
				},
				{
					"id": 20130102,
					"content": "抱歉，我们有急事要去鸣神岛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130103,
					"content": "未持有「通行凭证」的话就请回吧，这是规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "小林"
				},
				{
					"id": 20130104,
					"content": "唉…果然嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130105,
					"content": "旅行者，快想想办法，现在要怎么办才能出去呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130106,
					"content": "如果社奉行的人听说过我们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "你是说，直接去见勘定奉行本人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130109,
					"content": "…尽管对他手下的人很有意见，但好像也只能试试看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130110,
					"content": "万一他很崇拜我们呢？嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130107,
					"content": "勘定奉行应该也听说过吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
