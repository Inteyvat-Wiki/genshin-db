			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柊慎介",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "我是柊慎介，勘定奉行柊家的家主，很荣幸见到二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130202,
					"content": "我也很荣幸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "很高兴见到你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130205,
					"content": "我们这次来找你，是想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130206,
					"content": "欸，不急不急。好不容易见到闻名遐迩的两位旅者，何必这么匆忙谈正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130207,
					"content": "嘿嘿，我们果然很有名气吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130208,
					"content": "当然。能挫败风魔龙，镇压漩涡之魔神的凡人，普天之下又有几人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130209,
					"content": "确实！这点说的对，嗯嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130210,
					"content": "还有…在璃月港破坏愚人众的计划，在决斗中战胜他们的执行官的事，也是真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130211,
					"content": "哇，连这你都知道，当然是真的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130212,
					"content": "嗯…果然吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130213,
					"content": "怎么了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130214,
					"content": "呵呵，没什么没什么，老朽由衷敬佩二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130215,
					"content": "过奖了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "…能有二位光临离岛，也是本岛的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130218,
					"content": "早就听闻二位的热心肠，不知可否能屈尊为我们勘定奉行办些小事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130219,
					"content": "#尽管说吧，客气了客气了！对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130220,
					"content": "又到了帮忙的时间，对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "呵呵，那便好。这样的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130223,
					"content": "清心，你知道吧，那种经常长在璃月山顶上的植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130224,
					"content": "知道，我们摘过，难道还要我们回一趟璃月吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130225,
					"content": "嗯，就帮我摘三百株新鲜的清心来吧？要刚摘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130226,
					"content": "我是不是听错了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130227,
					"content": "数量级是不是有些不对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "啊？有点麻烦是吗…唔，这样啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130230,
					"content": "那不如，岛上有些信件需要派送，不知能否帮忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130231,
					"content": "这还差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130232,
					"content": "一共七百零九封。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130233,
					"content": "喂！怎么回事呀！而且这种事真的需要我们来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130234,
					"content": "呵呵，真是不好意思，岛上确实有些人手不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130235,
					"content": "理由也好俗套！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130236,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "怎么办，旅行者，我们真的要帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130238,
					"content": "我会考虑考虑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "不愧是阁下，那我就等您的消息了，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130239,
					"content": "等我先去勘察下情况。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "等摘完早就不新鲜了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "这个我擅长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "虽然最后还是让他们得逞了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				}
			]
		},
		{
			"id": 201304,
