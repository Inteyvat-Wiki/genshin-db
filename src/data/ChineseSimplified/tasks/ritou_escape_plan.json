				"objectNames": [
					"新之丞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130401,
					"content": "二位请留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130402,
						20130403
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20130402,
					"content": "果然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				},
				{
					"id": 20130404,
					"content": "欸？我们怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130405,
					"content": "我们家小姐有封信要交给您，请一定要看一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130406
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20130406,
					"content": "信？让我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130407,
					"content": "见信如晤：如此唐突地递上信笺，实在抱歉。希望没有让您为此感到困扰。写信邀约来自异乡的陌生人，这种事情对我来说也是第一次呢。但我相信与您的相遇绝非偶然。所以，恰好今夜月色尚佳，望您不吝相会。请不用担心家臣与侍卫盘查，我自有办法引离。企盼着您务必前来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130408,
					"content": "是说…要你晚上偷偷去找她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130409,
					"content": "刚才你好像早就知道会发生这样的事…是为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130410,
						20130412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130410,
					"content": "我和她确认过眼神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130411
					]
				},
				{
					"id": 20130411,
					"content": "唔？你们在背着我搞什么名堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130414,
					"content": "嗯…还是晚上问问她看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130412,
					"content": "慎介根本不打算让我们离开。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130413
					]
				},
				{
					"id": 20130413,
					"content": "我就觉得哪里不对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20130403,
					"content": "来了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				}
			]
		},
