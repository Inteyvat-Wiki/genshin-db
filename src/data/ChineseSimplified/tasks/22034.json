	"talks": [
		{
			"id": 2203401,
			"completionStepIds": [
				2203401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203401",
							"2"
						],
						"stepId": 2203401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "旅行者，请留步，社长有事拜托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340102,
					"content": "是案情有进展了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "社长没有说，只是说，还需要做更多准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340104,
					"content": "她还让我等着你，然后拜托你和我一起去野外进行搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340105,
					"content": "她到底要干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "你要是问我…说实话，我也不知道，但只要按照社长说的来做，一般都能把案件解决掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340112,
					"content": "唔，我们还是说正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340113,
					"content": "据社长说，自从天野和安藤把那件事向上报告后，城内的巡逻确实加强了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340114,
					"content": "但奇怪的是，城内商户还是不断地遭到盗窃，而且犯罪者的目的似乎十分明确，除了目标物品之外，其他的看也不看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340115,
					"content": "情况如此，社长认为，城外盗宝团偶然流窜进城作案的可能性已经很低了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340116,
					"content": "犯下这桩案子的犯人…或者犯人们，作案时有明确的目的性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340117,
					"content": "现在最大的可能性，就是有一个始终待在城内的「内应」，不断地向城外的人传递消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340118,
					"content": "那同心们不是在做无用功？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "不，正因为那个家伙意识到，同心们的目标并不是他，所以现在他还没有停止犯罪活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340120,
					"content": "他犯的案越多，就越容易露出马脚，社长弄清他真面目的机会也越大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340121,
					"content": "所以，我们还需要继续做样子给那个盗贼看，让他放松警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340122,
					"content": "旅行者，所以我才来拜托你，和我一起去野外再去找找那些盗宝团的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340123,
					"content": "当然，报酬会如数支付。而且…在了结这桩案子后，还有另外的礼物奉上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340124,
					"content": "这些也是珊瑚让你说的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "唔…你感觉到了？你的直觉还真是敏锐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340126,
					"content": "这些确实是社长交代我，让我用来说服你的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340127,
					"content": "但是请相信我，我说的这些话绝不作假。至少…那些报酬都实实在在地拿在我手里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340128,
					"content": "所以，这件事就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340129,
					"content": "但我到底要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "很简单，我们只需要…去折腾一下那些野外的盗宝团就行了，折腾出的动静越大越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340131,
					"content": "社长已经把一些盗宝团营地的所在地标记给我了，我也帮你标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340132,
					"content": "好了，我们就去这个地方碰头，现在就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340107,
					"content": "她自己怎么不来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "这是社长的习惯了。她说自己…「只擅长思考，不擅长行动」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340109,
					"content": "之前，一个写小说的人来采访社长，说要把她的事迹写成一本小说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340110,
					"content": "还说社长是…「安乐椅侦探」。社长对这个称呼好像还挺喜欢的，一直想要买一把安乐椅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340111,
					"content": "但是因为社里的经费问题，这把安乐椅一直没有置办下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "龙二"
				}
			]
		},
		{
