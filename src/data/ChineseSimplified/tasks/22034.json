			"dialogs": [
				{
					"id": 220340203,
					"content": "这些家伙，跑得倒是挺快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340204,
					"content": "他们应该会回去通风报信，这样我们的目的也达到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340205,
					"content": "辛苦你了，旅行者，这些报酬请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340206,
					"content": "我也会马上回去，向社长报告这里的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220340207,
					"content": "不知道社长有没有推理出来什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				}
			]
		},
