			"dialogs": [
				{
					"id": 210330401,
					"content": "怎么样，旅行者？这次你找到什么东西了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330402
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330402,
					"content": "找到了这个剑柄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
