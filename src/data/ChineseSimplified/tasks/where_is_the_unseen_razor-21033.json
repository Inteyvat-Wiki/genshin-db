				"points": []
			},
			"dialogs": [
				{
					"id": 210330403,
					"content": "这剑柄…倒是还算完整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330404,
					"content": "它和「藏锋」有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "我还要仔细分辨后才知道…喔，忘了告诉你，我前段时间就开始四处搜集武器的碎片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330406,
					"content": "我从市场上，野外，还有冒险家的手里得到了不少碎片，想着也许能从这方面找到「藏锋」的线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330407,
					"content": "但直到现在，我也没能找到它的任何踪迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330408,
					"content": "没关系，我们璃月有句话叫「有志者，事竟成」，我还是会一直找下去…直到找到「藏锋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330409,
					"content": "啊，这些报酬给你，辛苦你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
