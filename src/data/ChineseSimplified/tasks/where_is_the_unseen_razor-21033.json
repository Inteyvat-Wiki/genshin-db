			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "不知道…这个思路能不能管用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330102,
					"content": "你还在找那把剑吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "旅行者？是你啊…是的，我还在找那把「藏锋」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330104,
					"content": "但到现在，我也没有找到什么有价值的线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330105,
					"content": "不过这也是没办法的事，毕竟在整个璃月寻找一把剑…实在是太难了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330106,
					"content": "有人和我说，那把剑也许早就被魔物毁了…但即使它碎了，我也要把所有碎片都找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330107,
					"content": "抱歉，自顾自地说了这么多。这次的委托地点我已经标在你的地图上了，拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 210330108,
					"content": "希望…那把剑不要真的碎了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				}
			]
		},
