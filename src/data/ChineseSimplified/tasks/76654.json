			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7665401",
							"2"
						],
						"stepId": 7665401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菈乌玛"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1801.445,
							240.255,
							10364.15
						],
						"pointId": 12540
					}
				]
			},
			"dialogs": [
				{
					"id": 766540101,
					"content": "这样就算是，把「大书库」建好了吧。接下来是…鸟架、坐垫，还有存钱罐也要放过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540102
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540102,
					"content": "#啊，你们好，{NICKNAME}和小派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540103
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540103,
					"content": "多亏了你们的帮忙，书库修缮得也差不多了，算是…有模有样了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540104
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540104,
					"content": "你刚才说的东西，是准备也放在书库里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540105,
					"content": "是啊。但数量太多了，我一个人可能忙不过来。我正准备拜托手艺灵巧的族人，也帮我做一些呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540106,
						766540107
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540106,
					"content": "这些东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540108
					]
				},
				{
					"id": 766540108,
					"content": "这间「大书库」对所有人和动物开放。既然有给人坐的家具，自然也要给小动物们准备一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540109
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540109,
					"content": "对喔…这么一说倒是挺有道理的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540110,
						766540111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540110,
					"content": "不对不对…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540112
					]
				},
				{
					"id": 766540112,
					"content": "这些都是我之前听小动物们的烦恼时用的，本来想着新做一些，但有些小动物念旧，我就把这些老物件也拿过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540113
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540113,
					"content": "听小动物们的烦恼？难道还要给它们做心理辅导？嘿嘿，听起来就像是小动物版本的「秋沙钱汤」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540114,
						766540115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540114,
					"content": "菈乌玛也太辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540116
					]
				},
				{
					"id": 766540116,
					"content": "作为「咏月使」，这是我的职责之一，谈不上辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540117
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540117,
					"content": "况且，无论是人还是动物，确实都需要一个倾诉对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540118
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540118,
					"content": "我一直鼓励大家，有麻烦的话就直接来找我，不要有任何顾虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540119
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540119,
					"content": "把心思藏在心底，并不会解决任何问题。有时候反而会让问题更加难以处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540120,
						766540121,
						766540122
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540120,
					"content": "唔，我有点好奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540123
					]
				},
				{
					"id": 766540123,
					"content": "这个…我还真没统计过。但从感觉上来说，应该是小动物来咨询的比较多吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540124
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540124,
					"content": "毕竟，我和人们的作息差不多，平时大家也不会在我工作的时候过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540125
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540125,
					"content": "只有在我闲下来的时候，才会有零星的人陆陆续续来向我倾诉问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540126
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540126,
					"content": "但小动物们…它们的作息可和我们的不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540127
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540127,
					"content": "帔髦獾偶尔会在凌晨时分拜访，长翎鹮则常常在太阳出来后登门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540128
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540128,
					"content": "团雀们总是在中午成群结队地过来，叽叽喳喳地说个不停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540129
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540129,
					"content": "凛角鹿会在傍晚单独过来，有时候会带上一两个朋友。入夜后，盗宝鼬偶尔会悄悄地钻进屋子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540130
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540130,
					"content": "这不是完全没有任何空档吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540131,
					"content": "一整天都占满了啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540132
					]
				},
				{
					"id": 766540132,
					"content": "是啊。有一次盗宝鼬偷走了团雀囤的松果，大概有二十只团雀在深夜飞到了我的床头，叽叽喳喳地告状。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540133
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540133,
					"content": "我还是拜托一只刚和我聊完天的嗅嗅鼹鼠，把那只盗宝鼬请了过来，费了好大的劲，才让它说出了藏松果的地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540134
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540134,
					"content": "等大家都满意离开，太阳都已经升起来了。我倒头就睡，一直到中午才醒过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540135,
						766540136
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540135,
					"content": "二十只团雀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540137
					]
				},
				{
					"id": 766540137,
					"content": "要是我的话，肯定谈到一半就会崩溃，嚷着我要睡觉我要睡觉，然后用被子蒙住头，谁的话也不听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540138,
					"content": "大家既然都找到了我，那我就有义务为它们排解烦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540139
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540139,
					"content": "而且，排解烦恼的效果很明显。在吵完之后，团雀们依然每天都高高兴兴地蹦来蹦去，盗宝鼬也每天都在兴冲冲地找宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540140
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540140,
					"content": "人们却不像小动物们一样直接，总是把心思藏在心底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540141
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540141,
					"content": "即使是那些找我倾诉问题的人，所说出来的…我觉得也不是真正困扰他们内心的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540142
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540142,
					"content": "…或许，是他们不愿说出…或者面对那些真正的问题吧。毕竟，在那个以人为主的社会里，人们总是习惯于把真心伪装起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540143
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540143,
					"content": "就像是习惯于躲藏在枯叶中的蝴蝶一般，把自己的双翼也变成和环境一样的枯黄色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540144
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540144,
					"content": "我也知道人世交际，复杂艰深，每个人都有自己的处世之道，我不会对此多加置喙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540145
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540145,
					"content": "但…一直把心思藏在心底，难免会变得忧伤抑郁。即使我再如何规劝，也难解他们的心结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540146
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540146,
					"content": "所以我想，或许可以让心思复杂的人，和心思直接的动物们待在一起。这样，说不定两方都会有不一样的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540147
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540147,
					"content": "于是，我才把「大书库」改造成了现在的样子。四面敞开，通风透气，无论是人或动物，都可以随意造访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540148
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540148,
					"content": "除了大雨天要躲躲雨之外…在大部分时间里，大家可以和小动物们待在一起，轻松地看书、休息和晒太阳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540149
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540149,
					"content": "…或许，在面对这些不会说话的朋友时，人们反而愿意敞开心扉，说出些心里话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540150
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540150,
					"content": "欸？原来你改造书库的时候，还有这方面的打算吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540151,
					"content": "嘿嘿，听起来很不错呢。能抱着毛茸茸的小动物，窝在椅子上发一天的呆，想想就很开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540152,
						766540153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540152,
					"content": "我也要来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540154
					]
				},
				{
					"id": 766540154,
					"content": "呵呵，你们可是帮我修缮书库的重要帮手，「霜月之子」的书库，随时为你们敞开大门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766540153,
					"content": "给我留把椅子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540154
					]
				},
				{
					"id": 766540136,
					"content": "已经感觉到耳鸣了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540137
					]
				},
				{
					"id": 766540121,
					"content": "到底是人来咨询的多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540123
					]
				},
				{
					"id": 766540122,
					"content": "还是小动物来咨询的多？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540123
					]
				},
				{
					"id": 766540115,
					"content": "无论是人还是动物都来找你倾诉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540116
					]
				},
				{
					"id": 766540111,
					"content": "那存钱罐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540112
					]
				},
				{
					"id": 766540107,
					"content": "是应该放在书库里的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540108
					]
				}
			]
		}
	]
}