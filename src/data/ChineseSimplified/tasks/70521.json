			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"优菈",
					"安柏",
					"伯恩哈德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705210101,
					"content": "优菈和安柏！你们也来玩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210102,
					"content": "#找到你们了，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210103
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210103,
					"content": "咦？你俩是专程来看望我们的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210104,
					"content": "当然了，你们的店铺名气可大了，人们都在议论呢——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210105,
					"content": "「荣誉骑士和白色小帮手的『西风哗哗义卖联盟』在出售各种宝物，还有神奇的赠品，不容错过！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210106,
					"content": "结果我又变成「白色小帮手」了…不过听见大家这么评价我们的店铺，还是很开心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210107,
						705210108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210107,
					"content": "还是多亏了顾客们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210109
					]
				},
				{
					"id": 705210109,
					"content": "说起来，之前一直没有看见安柏和优菈呢，你们俩出远门了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210110,
					"content": "哈哈，我们还在工作嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210111,
					"content": "欸？还在工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210112,
						705210113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210112,
					"content": "节日无休？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210114
					]
				},
				{
					"id": 705210114,
					"content": "确切地说，我和安柏属于骑士团中的「半休假人员」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210115
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210115,
					"content": "佳酿节期间，荆夫港和蒙德城之间的商队来往频繁，正是需要加强戒备的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210116
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210116,
					"content": "因为魔物和歹徒会出来捣乱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210117,
					"content": "没错。游击小队的任务就是在两地之间巡逻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210118
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210118,
					"content": "跟随商队，保护大宗货物的同时，还要主动出击，调查可疑地点，提前排除威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210119
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210119,
					"content": "哇，听上去好辛苦。你们要这样连轴转…一直忙到佳酿节结束吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210120,
					"content": "那倒不至于，我们会轮班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210121
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210121,
					"content": "一组人手在岗巡逻，一组人手放假休息，还有一组人手机动待命，作为预备队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210122
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210122,
					"content": "每隔一段时间，各个小组就进行轮换。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210123
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210123,
					"content": "毕竟优菈是经验丰富的队长嘛。多亏了优菈的安排，游击小队才能一直高强度执勤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210124,
					"content": "这不是什么要夸一句的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210125,
						705210127
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210125,
					"content": "好热情啊，侦察骑士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210126
					]
				},
				{
					"id": 705210126,
					"content": "嘿嘿，下次有机会，再和你说说优菈刚当上队长时候的事吧，可精彩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210129,
					"content": "咳咳…我们今天来还是有正事的，让优菈讲——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210130
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210130,
					"content": "嗯，麻烦你们准备40份「骑士团特色北地烟熏鸡」，40份「西风加护堆高高」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210131
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210131,
					"content": "好惊人的数量！一次买这么多吃的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210132,
					"content": "难道…骑士团准备办宴会了？怎么没人通知我们呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210133,
					"content": "哈哈，没有那么夸张哦，优菈队长是准备犒赏她的队员们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210134
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210134,
					"content": "嗯…游击小队成员们的日常消耗量很大，一顿…确实能吃掉四五人份的食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210135
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210135,
					"content": "加上最近有位老队员归队了，就想着好好庆祝一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210136
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210136,
					"content": "与其买别的，倒不如用这笔钱来支援你们，还能充实慈善资金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210137
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210137,
					"content": "喔噢噢！优菈的决定真是太明智了！一举两得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210138,
					"content": "谢谢惠顾！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210139
					]
				},
				{
					"id": 705210139,
					"content": "对了…优菈刚刚提到的「老队员」，该不会就是我们之前见过的那位吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210140,
					"content": "前进测绘员米卡。在跟随大团长出征前，他一直是我们小队的核心队员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210141
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210141,
					"content": "对，就是他！没想到那个看起来很腼腆的小骑士这么厉害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210142,
						705210143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210142,
					"content": "但他好像害怕我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210144
					]
				},
				{
					"id": 705210144,
					"content": "米卡并不是害怕你们啦，虽然有那么一点点绕弯子，但这是他对你们的「尊重」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210145
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210145,
					"content": "他认为强大的人都有独特的个性，要了解这些人，理解对方的想法后，再和他们深入交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210146
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210146,
					"content": "这样，就能做到轻松愉快的沟通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210147
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210147,
					"content": "最初他对我和安柏也这样。和我们逐渐熟悉以后，他才表现得自然起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210148
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210148,
					"content": "原来是这样…米卡的性格还真是独特呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210149,
						705210150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210149,
					"content": "我记下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210151
					]
				},
				{
					"id": 705210151,
					"content": "嗯，等之后有时间，多接触几次就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210152
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210152,
					"content": "你是骑士团的重要人物，我作为他的长官，有义务防止你们误解彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210153
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210153,
					"content": "嘿嘿，优菈不用这样解释啦。你其实是在关照他，我们都懂的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210154,
					"content": "啊，优菈，刚刚你把我的份也算上了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210155
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210155,
					"content": "摩拉我得单独给才行，毕竟我不是游击小队的成员呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210156
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705210156,
					"content": "一样是我请客，就别客气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210157
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 705210157,
					"content": "向优菈和安柏交付了指定的菜肴，两人道谢后离去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705210158
					]
				},
				{
					"id": 705210158,
					"content": "嘿嘿，多亏了优菈和安柏，一下子就挣到了之前一整天的摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210159,
					"content": "荣誉骑士，派蒙！特大喜讯——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210160
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210160,
					"content": "多亏你们两位，这次活动筹集的资金远超预期！可以说是大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210161
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210161,
					"content": "哼哼，我就说吧，我们肯定能搞定所有麻烦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210162,
						705210163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210162,
					"content": "大家都辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210164
					]
				},
				{
					"id": 705210164,
					"content": "还得是你们两位的功劳，你们指导有方，义卖才能如此顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210165
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210165,
					"content": "我已经将所有收益交给了慈善资金的负责人，这次义卖活动到这里就圆满结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210166
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210166,
					"content": "为表谢意，我们想给两位一笔辛苦费，请两位务必收下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210167
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210167,
					"content": "我感觉自己再也不怕开店了，希望以后还能与你们合作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210168
					],
					"speakerTitle": "伯恩哈德"
				},
				{
					"id": 705210168,
					"content": "#嘿嘿，{NICKNAME}，我也觉得很充实！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210169,
					"content": "下次如果还有这种机会，我们再来试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705210163,
					"content": "伯恩哈德也受累了。",
					"roleType": "TALK_ROLE_PLAYER",
