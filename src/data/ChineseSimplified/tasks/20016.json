			"dialogs": [
				{
					"id": 200160101,
					"content": "餐品外送订单",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160102,
					"content": "旅行者！你来的正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160103,
					"content": "抱歉，虽然你饿着肚子，但是能不能请你帮我个忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160104,
					"content": "最近的送餐订单越来越多，我一般是先把订单按照地区分好，然后再标好是谁订的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160105,
					"content": "但是这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>的订餐人标签被我弄丢了，只知道订餐的人在清泉镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160106,
					"content": "你能帮我把这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>送去清泉镇，再找找是谁订的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160107,
					"content": "好吧，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "等你回来的时候，会有一顿大餐做回报的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160109,
					"content": "拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200160110,
					"content": "太饿了，我只是来吃饭的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
