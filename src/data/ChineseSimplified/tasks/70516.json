			"dialogs": [
				{
					"id": 705161101,
					"content": "阿贝多亲启：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161102
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161102,
					"content": "感谢你详尽的说明。我已拜读你的论文，内容详实易懂，是不可多得的优秀文献。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161103
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161103,
					"content": "相关信息我都记录下了，但愿日后能用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161104
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161104,
					"content": "预防危机是项相当重要的技术。我会继续留意深渊教团，必要时动用武力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051612,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
