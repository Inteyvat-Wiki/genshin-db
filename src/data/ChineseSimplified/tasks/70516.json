			"dialogs": [
				{
					"id": 705132401,
					"content": "字迹疏朗的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132402
					]
				},
				{
					"id": 705132402,
					"content": "老爷亲启：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132403
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132403,
					"content": "凯亚少爷请假回晨曦酒庄小住了几天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132404
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132404,
					"content": "非常难得，他就住在原来那间卧室。闲暇时四处散步，还请爱德琳做了他喜欢吃的菜肴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132405
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132405,
					"content": "那种感觉，让我像是回到了从前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132406
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132406,
					"content": "不瞒您说，凯亚少爷出现在我们面前说要住几天时，我深感惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132407
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132407,
					"content": "但我们没有拒绝。我们觉得，即便您在，也不会明着反对他住下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132408
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132408,
					"content": "晨曦酒庄向来算得上清净，或许是因为住在此地的人都较为安分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132409
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132409,
					"content": "…房屋，总是跟着人的氛围走。凯亚少爷难得来一回，倒是让这里热闹了几分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132410
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132410,
					"content": "愿您旅行在外也能过得好。酒庄所有人都很想念您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132411
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132411,
					"content": "请务必平安健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
