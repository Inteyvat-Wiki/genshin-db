			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705161401,
					"content": "艾莉丝女士亲启：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161402
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161402,
					"content": "必须承认，我在阅读信件开头时，没有想到这封信出自您之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161403
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161403,
					"content": "或许有许多次您就近在我身旁，只是我没能注意到。我为我的疏忽向您致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161404
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161404,
					"content": "曾有耳闻，您是非常厉害的魔女，即使没有我，可莉也一定能安全返回家中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161405
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161405,
					"content": "即便如此，您却依然为我寄来这封信。对此我唯有感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161406
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161406,
					"content": "如您所说，旅行是眼下最好的选择。我会依照您所说，去感受世间的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161407
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161407,
					"content": "父亲那份意志，将在我的生活中延续下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161408
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161408,
					"content": "我不在的这段时间，也欢迎可莉到晨曦酒庄做客。爱德琳会准备足够多的点心和葡萄汁，期待小客人光临。若您不嫌弃，也请一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161409
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161409,
					"content": "祝您和可莉身体健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051615,
