			"dialogs": [
				{
					"id": 705132501,
					"content": "方才的来信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132502
					]
				},
				{
					"id": 705132502,
					"content": "诰告「暗夜英雄」，骑士团已在蒙德各地加强警戒，而且没有明显的调动，不会引发深渊教团的警觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132503
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132503,
					"content": "我正在龙脊雪山一带侦察，这里的魔物较为零散，并没有被深渊教团集结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132504
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132504,
					"content": "蒙德南部也没有敌人活动的迹象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132505
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132505,
					"content": "如果你确认其他方向也没有魔物，那就可以确认了，这次的地脉异常与深渊教团无关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		}
	]
}