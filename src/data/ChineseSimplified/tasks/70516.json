			},
			"dialogs": [
				{
					"id": 705161501,
					"content": "这些信件里谈论的事情好像不止一件，原来以前发生过这么多复杂的事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705161502,
					"content": "想要搞清楚事情的来龙去脉，的确要仔细推敲细节呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705161503,
					"content": "#{NICKNAME}，你还要读哪一封信呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
