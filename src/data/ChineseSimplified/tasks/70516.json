			"dialogs": [
				{
					"id": 705132201,
					"content": "字迹粗犷的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132202
					]
				},
				{
					"id": 705132202,
					"content": "迪卢克 收：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132203
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132203,
					"content": "最近琴给我写信了，我非常震惊，如果我没猜错，她也给你写了吧。她的问候代表骑士团全体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132204
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132204,
					"content": "克利普斯老爷是个非常好的人，我个人相当认可他。听闻他遭遇这种事，我实在痛心，也深表遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132205
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132205,
					"content": "另外，击退魔龙一事，功劳理应属于你父亲。他付出所有换取的战果被伊洛克夺走，我无法认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132206
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132206,
					"content": "靠欺骗获取名望，于情于理我都不允许这种事发生在西风骑士团内部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132207
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132207,
					"content": "我已通知琴，伊洛克需要被从严处理。等有结果，骑士团将第一时间通知你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132208
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132208,
					"content": "听说你最近在外散心，很难联系。我不敢指望这封信一定能送到你手上，所以就先写到这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132209
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132209,
					"content": "如果送到了，那祝你身体健康，旅行途中注意安全。有什么需要尽管联系我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132210
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132210,
					"content": "希望你的鹰足够争气，让你有机会看到这封信。我亲笔所写，很难得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132211
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132211,
					"content": "或许在现在的你看来，以下这句是风凉话，但希望你记得：再大的灾难也总会过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132212
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132212,
					"content": "我们在蒙德等你回来。若你愿意，随时可以回骑士团报道。（若你不愿意，当我没说。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051619,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705132301,
					"content": "字迹灵动的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132302
					]
				},
				{
					"id": 705132302,
					"content": "莱艮芬德家的贵公子收：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132303
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132303,
					"content": "冒昧来信，你或许不记得我是谁了，但我们确实见过几次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132304
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132304,
					"content": "有时是在广场附近，有时是在「猎鹿人」坐邻桌，有时是在你的酒馆里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132305
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132305,
					"content": "你总是忙于各种事务，甚至更早些时候，你显得比后来健谈许多，常与你的兄弟朋友们相谈甚欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132306
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132306,
					"content": "对那时的你来说，注意不到我也很正常。不过，我可是一直记着你这位小朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132307
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132307,
					"content": "我记得很清楚，有一回可莉跑到你家葡萄园里抓晶蝶，把整齐的葡萄架弄得一团糟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132308
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132308,
					"content": "你没有生气，亲自送可莉回来，还给了她几瓶新榨的葡萄汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132309
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132309,
					"content": "也许你开始有一点印象了，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132310
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132310,
					"content": "最近听可莉说，「红头发的奇怪大人好久没出现」，我十分好奇，忍不住打听了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132311
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132311,
					"content": "对于你父亲的遭遇，我深表遗憾。请节哀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132312
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132312,
					"content": "在我听到的故事里，人们总说你是完美高傲，锐气满满的名门骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132313
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132313,
					"content": "但我知道你比外表亲切。若非如此，你不会那样对待可莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132314
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132314,
					"content": "你帮助了我的小朋友，我也想将你当作我的小朋友来对待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132315
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132315,
					"content": "因此我由衷祝愿，你能尽早走出阴霾，不必长久地浸泡在悲伤和懊悔中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132316
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132316,
					"content": "分别最令人痛苦，却也促使人成长。失去了遮雨屋檐的飞鸟，会比其他同类飞得更高远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132317
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132317,
					"content": "外出走走吧，游历是再合适不过的选择了。对此刻的你而言，唯有感受、观察和聆听能治愈你的心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132318
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132318,
					"content": "父母总期盼自己能长久地陪伴子女。天空、海洋与群星将会见证这一誓言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132319
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132319,
					"content": "你父亲的一切都在你身上延续。你在世间感受到的，或许也正是你父亲曾感受过的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132320
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132320,
					"content": "愿你能在前行的风中品味到好的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132321
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132321,
					"content": "振作起来，年轻的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051620,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
