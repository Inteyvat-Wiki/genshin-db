			"dialogs": [
				{
					"id": 705132001,
					"content": "字迹隽秀的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132002
					]
				},
				{
					"id": 705132002,
					"content": "迪卢克前辈——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132003
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132003,
					"content": "欢迎回到蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132004
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132004,
					"content": "那件事已经过去一段时日了，我们查明是伊洛克从中作梗，他已被严厉惩办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132005
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132005,
					"content": "希望听见这个消息，你的心境能稍微平复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132006
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132006,
					"content": "此外，我们的人发现，最近深渊教团在奔狼领到石门一带活动愈发频繁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132007
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132007,
					"content": "还有一名被称作「暗夜英雄」的神秘人，最近他常在午夜时分出没，活跃于蒙德城四周。行动目的尚不明朗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132008
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132008,
					"content": "请务必注意安全，发现异常尽早通知骑士团。我们将是你的助力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132009
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132009,
					"content": "不论是否任职于骑士团，你对骑士团的贡献仍会被每位信念坚定的骑士铭记在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132010
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132010,
					"content": "祝你健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
