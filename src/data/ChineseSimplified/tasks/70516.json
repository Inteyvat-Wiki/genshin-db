			},
			"dialogs": [
				{
					"id": 705161301,
					"content": "（这块砖…似乎有点奇怪？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161302
					]
				},
				{
					"id": 705161302,
					"content": "取下墙砖",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161303
					]
				},
				{
					"id": 705161303,
					"content": "（这是…暗格？里面有个匣子…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161304
					]
				},
				{
					"id": 705161304,
					"content": "打开匣子",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161305
					]
				},
				{
					"id": 705161305,
					"content": "匣中的物品似乎都有些年头了。其中有张纸片十分显眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161306
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161306,
					"content": "它被烧掉了一块，剩余部分看起来就像是从火堆里抢救出来的残渣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161307
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161307,
					"content": "纸上，每两行内容都完全相同。看笔迹似乎是有个孩子先写了一遍，某位大人又握着孩子的手再教了一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161308
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161308,
					"content": "所写内容如下：「…务必记得，独眼的王者伊尔明失能之后，是不流有王血的亚尔伯里奇一族挺身而出，暂任摄政。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161309
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161309,
					"content": "「虽无法使坎瑞亚起死回生，可我亚尔伯里奇一族的生命应是瞬息辉煌的烈焰，而非黯淡苟活的余烬。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161310
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161310,
					"content": "将纸张翻过来，背面还有别的字，应该是批注之类的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161311
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161311,
					"content": "「趁『父亲』不注意从火堆中抢回的唯一纪念。我违背了原则，有关家族的事本不该被记录下来。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161312
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161312,
					"content": "「于我，这张纸不能成为任何身份证明，无法支撑我去往任何地方。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161313
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161313,
					"content": "「如今看来，他的笔迹也如行将燃尽的火焰一般悲戚。生活在蒙德的我，是无法写出那种笔迹的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161314
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161314,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161315
					]
				},
				{
					"id": 705161315,
					"content": "拿开纸张，底下还有只布袋，里面是一只陈旧的眼罩。旁边附有标签纸，其上的文字是：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161316
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161316,
					"content": "「没想到从前假装独眼海盗骗人，终有一日自己也伤了一只眼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161317
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161317,
					"content": "「我从没有责怪迪卢克的意思。选在义父去世那日吐露实情，发生纠纷也很正常。这都是我自找的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161318
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161318,
					"content": "「他好像当真了。不过我没有真瞎，骗了他好一阵子…也好，就这样继续下去吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161319
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161319,
					"content": "布袋下方摆着两封信，署名都是「D」。信件被保存得非常好，背面标有时间，应该是收信的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161320
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161320,
					"content": "信上的字迹潇洒有力又不失华美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161321,
						705161325
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161321,
					"content": "阅读第一封来信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161322
					]
				},
				{
					"id": 705161322,
					"content": "给K：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161323
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161323,
					"content": "知道了，感谢你的来信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161324
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161324,
					"content": "另外，不建议你在写给我的信里提什么眼睛。别以为我不知道你右眼没瞎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161330
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161330,
					"content": "在这两封信的旁边，还有一个小小的纸包。打开后是几只贝壳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161331
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161331,
					"content": "贝壳表面光泽并不明显，也不知是经过了多久的时光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161332
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161332,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161333
					]
				},
				{
					"id": 705161333,
					"content": "（还是收好这个匣子，把一切恢复原样吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705161325,
					"content": "阅读第二封来信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705161326
					]
				},
				{
					"id": 705161326,
					"content": "给K：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161327
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161327,
					"content": "感谢你的来信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161328
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161328,
					"content": "与骑士团合作一事客观有利，自然也会有弊，就像硬币的正反面。相信你比我更明白这一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161329
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161329,
					"content": "安全问题无需担忧。自保不难，难的永远是向外推进目标。还是照顾好你自己吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161330
					],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
