			"dialogs": [
				{
					"id": 705161001,
					"content": "琴亲启：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161002
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161002,
					"content": "衷心感谢代理团长的关心。你说得不错，我或将不再对那件事耿耿于怀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161003
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161003,
					"content": "惩办渎职的伊洛克，其本质是纠正骑士团过去的错误。对骑士团本身意义重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161004
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161004,
					"content": "至于我的个人安全，暂时还无需骑士团操心。骑士团应当将人力用在刀刃上，照顾那些需要帮助的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161005
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161005,
					"content": "也祝你身体健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
