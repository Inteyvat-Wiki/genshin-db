			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160101,
					"content": "咦，这里放着另一组信？好像不久前也被迪卢克读过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160102,
					"content": "我们要先读哪些呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160103,
						705160108,
						705160115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160103,
					"content": "字迹华丽的信·其一",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160104
					]
				},
				{
					"id": 705160104,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160105
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160105,
					"content": "骑士团内部刮起了一场风暴。法尔伽的心腹预备彻查伊洛克和他的党羽，他很快就会落马了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160106
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160106,
					"content": "或许你不那么想看到我的来信，但我的本意是希望这件事能尽快传到你耳朵里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160107
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160107,
					"content": "不用回信也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				},
				{
					"id": 705160108,
					"content": "字迹华丽的信·其二",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160109
					]
				},
				{
					"id": 705160109,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160110
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160110,
					"content": "听说你决定出门远游，即便是我也感到有些意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160111
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160111,
					"content": "琴想写信劝你，我建议她不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160112
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160112,
					"content": "至于法尔伽那边，应该是还不清楚这件事。否则以他的个性，多半会约你去酒馆面谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160113
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160113,
					"content": "你想走就趁最近。知道的人越少，告别仪式就越少。最好选在夜晚出发，以免感伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160114
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160114,
					"content": "一路顺风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				},
				{
					"id": 705160115,
					"content": "字迹华丽的信·其三",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160116
					]
				},
				{
					"id": 705160116,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160117
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160117,
					"content": "半条坏消息。伊洛克没那么容易被扳倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160118
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160118,
					"content": "大团长下令调查的确给了他很大打击，但相关势力仍未被连根拔除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160119
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160119,
					"content": "目前这件事由琴跟进。她应该会尽到职责，伊洛克本来也是她执权路上绕不过的坎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160120
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160120,
					"content": "你只需要静候佳音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051602",
							"2"
						],
						"stepId": 7051602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160501,
					"content": "这里有两篇笔记，我们先读哪一篇比较好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160502,
						705160509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160502,
					"content": "阅读第一篇笔记。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160503
					]
				},
				{
					"id": 705160503,
					"content": "上次地脉发生异常，主动放出侵略性很强的魔物，已经是好几年前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160504
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160504,
					"content": "「暗夜英雄」准确控制时间，将所有魔物分批引导到开阔地带，逐一击败…的确是一种策略。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160505
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160505,
					"content": "事后伪装成受重伤的模样，引诱幕后的深渊教团主队现身，再给对方迎头痛击，更是精彩绝伦的反击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160506
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160506,
					"content": "但这中间存在太多不确定因素了。「暗夜英雄」本人也表示不能每次都像这样冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160507
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160507,
					"content": "查明原理，提早预防这种地脉异常现象，才是最稳妥的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160508
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160508,
					"content": "虽然不太明白，但好像提到了迪卢克以前的战果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160509,
					"content": "阅读第二篇笔记。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160510
					]
				},
				{
					"id": 705160510,
					"content": "地脉还有很多秘密，我们这些普通人没必要搞得太清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160511
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160511,
					"content": "不过「暗夜英雄」要长期对抗深渊教团，还是深入了解一下为妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160512
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160512,
					"content": "听说西风骑士团调查小队的队长有着很高的学术造诣。他不像丽莎，和代理团长走得很近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160513
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160513,
					"content": "向他请教一些问题，不太可能被骑士团的人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160514
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160514,
					"content": "应当建议「暗夜英雄」向他咨询地脉的技术难题，由我来将信件送到他在雪山的营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160515
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160515,
					"content": "咦？这篇笔记好像提到了阿贝多呢。难道迪卢克给阿贝多寄过信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7051607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160701,
					"content": "还有一组信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160702,
					"content": "#{NICKNAME}，你觉得我们要先看哪一封呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160703,
						705160709,
						705160714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160703,
					"content": "字迹华丽的信·其四",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160704
					]
				},
				{
					"id": 705160704,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160705
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160705,
					"content": "近期有批商人回到了蒙德城，说是在外经营不利，退回蒙德发展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160706
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160706,
					"content": "经我观察，他们的员工常往「天使的馈赠」跑。也正是这批人，多次出没在野外危险地带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160707
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160707,
					"content": "其中有几位不够谨慎，居然把笔记的残页落在地上。好心如我，就先替他们送回「天使的馈赠」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160708
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160708,
					"content": "会去那里，应该是与你有关。我看他们的笔记都用了暗语，情报贩子？还是秘密组织？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160720
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160720,
					"content": "总之，虽然只凭单眼很难看清那些模糊的字，我也还是认真看了。这件事我会帮忙保密的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				},
				{
					"id": 705160709,
					"content": "字迹华丽的信·其五",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160710
					]
				},
				{
					"id": 705160710,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160711
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160711,
					"content": "我可没有故意瞒着你，不过，倒也没想到你已经发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160712
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160712,
					"content": "似乎没人规定过瞎了才能戴眼罩吧。右眼有疤痕，戴个眼罩遮一下不也是天经地义吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160713
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160713,
					"content": "等候已久的好消息来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160721
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160721,
					"content": "在伊洛克离职当天端着酒杯茶杯赶去看热闹，目送他收拾东西滚蛋，应该挺有趣的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160722
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160722,
					"content": "以你的性格多半不会这么做。但我喜欢，我可以代劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				},
				{
					"id": 705160714,
					"content": "字迹华丽的信·其六",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160715
					]
				},
				{
					"id": 705160715,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160716
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160716,
					"content": "真不巧！你才回蒙德没多久，城里就出现了一个神秘人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160717
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160717,
					"content": "听说他被称为「暗夜英雄」。此人曾多次打击蒙德周边的盗宝团和魔物，甚至主动进攻深渊教团据点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160718
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160718,
					"content": "目前看来，他的行动对蒙德尚算有利。但骑士团不可能允许独立的武装势力存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160719
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160719,
					"content": "我总觉得你们会很合得来，你快找个机会认识一下这位，最好能再劝劝他。可别被骑士团抓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051604",
							"2"
						],
						"stepId": 7051604,
						"stateName": "QUEST_STATE_UNFINISHED"
