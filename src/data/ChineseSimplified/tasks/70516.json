				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705160801,
					"content": "这里也有几封信呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160802,
					"content": "#来，{NICKNAME}，选出你想读的信件吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160803,
						705160810,
						705160816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705160803,
					"content": "字迹华丽的信·其七",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160804
					]
				},
				{
					"id": 705160804,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160805
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160805,
					"content": "例行公务，骑士团需要对相关人士取证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160806
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160806,
					"content": "最近骑士团收到几例目击报告，称「暗夜英雄」曾在晨曦酒庄一带出没。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160807
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160807,
					"content": "大团长指定骑兵小队执行本次任务。因此，我将在三天后登门拜访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160808
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160808,
					"content": "他似乎觉得，强迫我们面对面交流就能改善我们的关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160809
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160809,
					"content": "当然了，我不会多说半个字，只是走个流程。提前三天通知你，算是给足了准备时间吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				},
				{
					"id": 705160810,
					"content": "字迹华丽的信·其八",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160811
					]
				},
				{
					"id": 705160811,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160812
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160812,
					"content": "上次深渊教团来袭，「暗夜英雄」的出现的确为骑士团争取到了一定时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160813
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160813,
					"content": "这也让琴有了服众的理由，骑士团不会再重点防备「暗夜英雄」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160814
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160814,
					"content": "「暗夜英雄」受到的限制将会减少，但处境未必会变好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160815
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160815,
					"content": "锋芒太过锐利的事物，势必容易遭到折损。独自行动意味着怎样巨大的风险，你应该很清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160823
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160823,
					"content": "我不推荐这样做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				},
				{
					"id": 705160816,
					"content": "字迹华丽的信·其九",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705160817
					]
				},
				{
					"id": 705160817,
					"content": "给D：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160818
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160818,
					"content": "听说晨曦酒庄幸未遭受任何损失。骑士团也只有几人轻伤，短时间内就能恢复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160819
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160819,
					"content": "只是，有位商铺员工失踪了。失联地点与深渊教团的行动路线巧妙地重合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160820
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160820,
					"content": "骑士团已经派人前去搜救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160821
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160821,
					"content": "你必须意识到，深渊教团已经变得越来越危险，甚至开始组织多线攻势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705160822
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705160822,
					"content": "「暗夜英雄」或许该考虑与骑士团合作，那样才能万无一失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
