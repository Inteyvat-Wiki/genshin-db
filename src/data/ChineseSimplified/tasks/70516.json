					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705161201,
					"content": "法尔伽团长亲启：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161202
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161202,
					"content": "我由衷地感谢您能关心并慰问这些事。父亲如能知道，一定也会为您的赞许感到光荣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161203
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161203,
					"content": "没有什么比受到北风骑士的认可更值得他高兴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161204
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161204,
					"content": "我正在旅途中，非常幸运，顺利收到了您的来信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161205
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161205,
					"content": "不出意外的话，我应该不会回骑士团。但过去的经历我不会忘记。骑士团教会我的事，我也谨记在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705161206
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705161206,
					"content": "祝您身体健康。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
		{
			"id": 7051613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
