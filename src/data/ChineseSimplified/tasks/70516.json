			"dialogs": [
				{
					"id": 705132101,
					"content": "字迹工整的信",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705132102
					]
				},
				{
					"id": 705132102,
					"content": "迪卢克先生亲启：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132103
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132103,
					"content": "很高兴能与你一同探讨有关地脉的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132104
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132104,
					"content": "如你所知，我的主要研究领域是炼金术，对地脉了解不深，只能简单谈谈个人理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132105
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132105,
					"content": "据各种已有文献表明，地脉可以被视为一种信息载体，其会在特定状态下开始记录周边事象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132106
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132106,
					"content": "所有信息都将经历被记录到被沉淀的过程。经过一定时间后，亦可能被地脉再次释出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132107
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132107,
					"content": "我大胆猜想，世上应该存在刺激地脉运作的办法。掌握相关手法，就可能掌控地脉记录与放出信息的时机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132108
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132108,
					"content": "从符文及其他方面推测，一些特殊的深渊教团成员确实有极小概率能做到这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132109
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132109,
					"content": "假如你认为有必要深究，这些个体也许会成为你的突破口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132110
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132110,
					"content": "几年前我在我的一篇论文中研判过地脉流动及相关问题。论文副本已随信附上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705132111
					],
					"speakerTitle": "调查"
				},
				{
					"id": 705132111,
					"content": "希望它能解答你的疑惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "调查"
				}
			]
		},
