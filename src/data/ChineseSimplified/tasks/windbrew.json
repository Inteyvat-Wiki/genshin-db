			"trigger": {
				"objectNames": [
					"玛格丽特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "好了，这下两份辅料都齐了，我们开始调制饮品吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083802,
					"content": "到底会是什么味道呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "怎么，你也想尝尝这种饮品吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083804,
					"content": "嗯…这种饮品的调制手法也不复杂，只要按照我设计的流程调制，就一定会成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083805,
					"content": "旅行者，不如…你来亲手调制一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083806,
					"content": "我来试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "没问题，我先说一下调制这种饮品的流程，你可要记住了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083808,
					"content": "首先放入<color=#00E1FFFF>甜甜花</color>，再浇入调酒专用的基酒…当然，我们这次用的是<color=#00E1FFFF>牛奶</color>，这就有了口感清甜的基底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083809,
					"content": "为了增添风味，这时候再加入<color=#00E1FFFF>风车菊</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083810,
					"content": "然后别急着混合，得<color=#00E1FFFF>静置</color>一会儿，让花的香味慢慢散发出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083811,
					"content": "再撒入<color=#00E1FFFF>蒲公英籽</color>，酒液里就会像散满星星一样好看，最后放入<color=#00E1FFFF>冰块</color>就大功告成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083812,
					"content": "顺序就是这样，要调出可口的酒可不能弄乱这个顺序，得好好记住哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 700083813,
					"content": "记住的话就来试试吧，如果忘记了再来问我也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛格丽特"
				}
			]
		},
