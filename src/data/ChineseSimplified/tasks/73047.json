			"trigger": {
				"objectNames": [
					"兰拉迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#那菈{NICKNAME}、派蒙，又见面了。呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470102,
					"content": "兰拉迦看起来很开心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470103,
					"content": "呵呵呵…老身看到桓那兰那这么热闹，有这么多兰那罗回家了，真是太高兴了。哎呀，没想到能亲身参与无忧节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470104,
					"content": "你没参加过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "老身在故事中，曾经参与过一次。那是很久很久以前的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470108,
					"content": "老身、兰穆护昆达、兰拉娜、兰拉吉…我们许许多多的兰那罗，与那菈法留纳一同，庆祝无忧节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470109,
					"content": "那是十分艰难的时期。但是，在无忧节中，我们还是一同欢笑、歌唱。老身非常喜欢这个故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470110,
					"content": "咦，兰拉迦这不是参加过吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470111,
					"content": "喔，在故事中，确实参加过。但是，老身已经不记得了。那些故事，都是兰拉娜他们后来告诉老身的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470112,
					"content": "嗯…感觉兰拉迦说话像老爷爷似的，可能是因为年纪大了，记不清了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470113,
					"content": "#或许是这样也不错…不管怎么说，那菈{NICKNAME}、派蒙，你们愿意收下这个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470114,
					"content": "是小花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470115,
					"content": "嗯。希望在未来的旅途中，这朵花能一直陪伴着你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470116,
					"content": "我收下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "那菈的时间比兰那罗珍贵许多，老身便不耽误你们了，尽情享受吧。晚点你们去找找兰加惟，他也在准备无忧节的仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730470117,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "我也很开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "我也很开心！不过，兰拉迦以前没有参加过无忧节吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}