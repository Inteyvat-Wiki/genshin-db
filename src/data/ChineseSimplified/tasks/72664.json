			"trigger": {
				"objectNames": [
					"琳阳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "唔…还得再去布置一批宝箱才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640102,
					"content": "什么宝箱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "欸？！你是…旅行者吗？你也是来参加「逐月节」的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640104,
					"content": "算是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "那你来得刚好。为了庆祝逐月节，我们冒险家协会正在举办活动呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640106,
					"content": "怎么样，你想要了解一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640107,
					"content": "具体是什么活动？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "逐月节期间，我们冒险家协会在各地布置了一种叫做「逐月符」的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640111,
					"content": "找到这些逐月符的人，可以将它们带回协会，兑换各种奖励。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640112,
					"content": "另外，协会还派遣了一批冒险家，在野外布置了一大批特别宝箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640113,
					"content": "这些特别宝箱里面，都装着协会专门准备好的各种宝物哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640114,
					"content": "除了这两项活动之外，协会还为那些想要挑战自我的精英冒险家们，设置了一连串的高难度挑战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640115,
					"content": "具体来说…就是一连串的魔物营地啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640116,
					"content": "这和逐月节有关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "啊…哈哈哈，这个…这…你别这么说嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640119,
					"content": "只要讨伐了那些魔物，协会也会给予相应报酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640120,
					"content": "这和平时的委托有什么区别？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "拜托，拜托你啦！逐月节期间，大部分冒险家都去过节了，好多委托都没人接。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640122,
					"content": "怎么样？凭你的身手，对付那些魔物肯定不在话下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640123,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "报、报酬方面一定不会让你失望的，放心吧旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640126,
					"content": "逐月节期间，我会一直待在这里，有什么问题，你直接过来问我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640127,
					"content": "那就拜托你了，旅行者。那个…好好享受逐月节吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳阳"
				},
				{
					"id": 726640124,
					"content": "准备好报酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "这和逐月节一点关系都没有！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "不会又是各种日常杂务吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "不会啦！这次的活动可都是很有冒险感的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "琳阳"
				}
			]
		}
	]
}