					"松本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850201,
					"content": "唉，这个世界上还有能满足我味蕾的新奇菜肴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850202,
					"content": "关于「木南料亭」的披萨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "你说那个披萨啊，味道确实不错，还融合了不少本地的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850204,
					"content": "不过，我之前也尝过正宗的「烤蘑菇披萨」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850205,
					"content": "我记得，那种披萨是由奶酪，卷心菜和蘑菇做成的来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850206,
					"content": "哈哈哈，我个人是觉得，这种异国的食物，最好还是保持着异国的特色比较好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "松本"
				}
			]
		},
		{
			"id": 7218503,
			"completionStepIds": [
				7218503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
