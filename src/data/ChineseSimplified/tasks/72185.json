			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "旅行者，你回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850302,
					"content": "怎么样，你有问到什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850303,
					"content": "关于客人们的反馈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "原汁原味的「烤蘑菇披萨」啊…嗯，倒是可以试试看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850305,
					"content": "要准备的材料是奶酪、卷心菜和蘑菇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850306,
					"content": "其余的材料店里倒是有，可是这个奶酪，店里平时也没储备多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850307,
					"content": "旅行者，能请你帮我去拿一份奶酪来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850308,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "那就拜托你了，只要一份奶酪就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850310,
					"content": "店里平时都不用奶酪的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "也不能说完全不用，只能说用得很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850312,
					"content": "毕竟，店里的这些菜，也没几道要用到奶酪的，所以储备得很少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850313,
					"content": "总之，就拜托你了旅行者，请帮我带一份奶酪回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
			]
		},
