			"dialogs": [
				{
					"id": 721850501,
					"content": "谢谢你，有这些食材就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850502
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850502,
					"content": "原汁原味的蒙德「烤蘑菇披萨」，不知道能不能顺利做出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850503,
					"content": "完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850504
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850504,
					"content": "这披萨…看上去还不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850505,
					"content": "谢谢你帮忙，旅行者，这些东西请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850506,
					"content": "我等会就去仔细品尝一下这份披萨的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850507,
					"content": "如果还不错的话…应该很快就能作为新品正式推出啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
