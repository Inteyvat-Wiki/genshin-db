					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "哇。这里的大海，漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620102,
					"content": "欸？荻花洲不是大海啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620103,
					"content": "但荻花洲的水域确实和海连在一起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "嗯，说得也是…不过，如果要说荻花洲是海，感觉还是不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620105,
					"content": "呶…不是很明白。「大海」和「不是大海」，区别是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620106,
					"content": "水的味道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "喔！森林的溪水有点甜味，所以不是海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620108,
					"content": "但是，如果果酒湖里都是果酒的话，应该算什么呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620109,
					"content": "那样的话温迪会很快乐吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "不过，这个问题先放一边，吉法师是不是越来越会说话了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620121,
					"content": "按照之前五百藏的说法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "五百藏说了什么来着？「吾辈乃是名震天下的妖狸」…不对，不是这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620124,
					"content": "「想挠肚皮，呜呶呶。」…「咿！」…也不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620125,
					"content": "呶哈哈，派蒙学得好像。好好笑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620126,
					"content": "「适应吉法师的气息…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "啊，对哦！我们越适应吉法师的气息，就越能理解吉法师的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620128,
					"content": "#还有修行呶！和{NICKNAME}、派蒙一起，吉法师学会了好多好多事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620129,
					"content": "派蒙可是个好向导呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620131,
					"content": "#那么久以前的事，{NICKNAME}还记得呀。好开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620132,
					"content": "#嗯！谢谢派蒙和{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620136,
					"content": "这里的「不知道算不算大海」很漂亮，后面还有好高好高的漂亮房子。帮吉法师拍照？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620137,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "一起冒险的伙伴，能一起成长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "嗯！伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620135,
					"content": "最好的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620122,
					"content": "出发前，五百藏好像说过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "陆地主体之外的大型水域是海？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "哇，听起来好严谨的答案！但是，这样的话，问题又回到了「分界」上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME}刚刚说，荻花洲的水和大海连在一起。那「陆地煮煮」和不是「陆地煮煮」，区别又是什么哩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620113,
					"content": "…虽然听起来严谨，却没有解决任何问题呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620114,
					"content": "这些概念都是人强加的。没有意义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "荻花洲觉得自己是大海，就是大海。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "吉法师觉得自己是仙人，就是仙人呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620117,
					"content": "#喂！吉法师别听{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的。{NICKNAME}，你在说什么呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620118,
					"content": "…不过，虽然是歪理，也不是完全没道理啦。吉法师想成为什么样的妖狸，就能成为什么样的妖狸！说不定未来能变成仙狸呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620119,
					"content": "仙狸！耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "「吉法师」"
				}
			]
		},
