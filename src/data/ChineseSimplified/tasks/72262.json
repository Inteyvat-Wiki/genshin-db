			"dialogs": [
				{
					"id": 722620201,
					"content": "拍好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620202,
					"content": "接下来的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620203,
					"content": "嗯，就这么办吧！吉法师，钓过鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620204,
					"content": "钓鱼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620205,
					"content": "看来没试过呢！走，我们到水边去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620206,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				}
			]
		},
		{
			"id": 7226203,
			"completionStepIds": [
				7226207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226207",
							"2"
						],
						"stepId": 7226207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「吉法师」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "呜呶呶…为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620302,
					"content": "吉法师真是的！怎么就冲进丘丘人的据点里了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620303,
					"content": "本来以为…能和丘丘人一起玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620304,
					"content": "欸？为什么这么想？丘丘人是很危险的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620305,
					"content": "噗，丘丘人也没有很危险啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "喂！吉法师可不是像你这样身经百战的旅行者啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620309,
					"content": "在镇守之森第一次见面的时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "对呀，当时吉法师不是被丘丘人包围着，变成了什么东西躲起来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722620311,
					"content": "刚刚见到你们的时候…我想想…我想想…啊，对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620312,
					"content": "那时候，是在和丘丘人捉迷藏。森林里的丘丘人，是不会攻击妖狸的。而且，经常陪我们玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620313,
					"content": "欸？是形成了什么和谐共生的关系吗…",
