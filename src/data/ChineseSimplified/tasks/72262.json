					"nextDialogs": [
						722620315
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722620315,
					"content": "总之，在外面要多加小心啦！即使是丘丘人…不对，应该说，正因为是丘丘人…",
