			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210501,
					"content": "哇！你在这里啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210502,
					"content": "哟，都来了吗。让我等了好久啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210503,
					"content": "你们错过了一场好戏，实在可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210504
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210504,
					"content": "这家伙，状态看起来还不错嘛，看来没受伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210505,
					"content": "嗯？你们担心我了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210506,
						400210508
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210506,
					"content": "并没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210507
					]
				},
				{
					"id": 400210507,
					"content": "看来你很信得过我的实力啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210510,
					"content": "作为伙伴兼老对手，你一定知道的，这种出其不意的战斗场合最合我胃口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210511
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210511,
					"content": "秘境重组期间，房间会上下移动，魔物也被带着四处乱窜。嗯！这几天，我打得很尽兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210512
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210512,
					"content": "还找到一些「拓本」，就是「式大将」需要的那种。里面应该藏有它的记忆和力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210513
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210513,
					"content": "正所谓来得早不如来得巧，赶快回收它们吧，「式大将」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210508,
					"content": "只有一点点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210509
					]
				},
				{
					"id": 400210509,
					"content": "真的？能让你操一点心，我还是挺有面子的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 4002108,
			"completionStepIds": [
				4002108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002108",
							"2"
						],
						"stepId": 4002108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210801,
					"content": "这座房间已经非常接近阴阳寮的最深处了。我记得…我和晴之介在这里停留了很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210802
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210802,
					"content": "我们一直在观察那些来自稻妻各地的武人。他们喝酒庆祝时，总是高声呼喊着：「我们也拥有战胜强大魔物的力量了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210803
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210803,
					"content": "莫非，你和惟神晴之介，是带着那些武士前来铲除魔物的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210804
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210804,
					"content": "有这种可能，但也不止一种可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210805
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210805,
					"content": "换句话说，那样的景象也有可能是晴之介故意安排的。为了重新掌握失控的阴阳寮，他征召这些武士，命令他们进入秘境铲除魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210806
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210806,
					"content": "「式大将」是在猜测达达利亚的想法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210807,
					"content": "什么嘛，我也不是每次都往坏处想的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210808
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210808,
					"content": "只是合理全面的猜测而已，并不是要冒犯几位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210809
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210809,
					"content": "我的记忆还不完整，但缺失的部分越来越少，应该就快要全部复原了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210810
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210810,
					"content": "而且，我有种感觉…继续向前的话，我们说不定真会遇见晴之介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210811
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210811,
					"content": "这座阴阳寮也不是最近才建成的吧？那他一直在里面吗？呜哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210812,
						400210813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210812,
					"content": "「式大将」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				},
				{
					"id": 400210814,
					"content": "旅行者？等一下，你该不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210815
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210815,
					"content": "有些话，需要由我来说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210816
					]
				},
				{
					"id": 400210816,
					"content": "看几位严肃的神情…应该是有很重要的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210817
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210817,
					"content": "我说，太严肃也不好吧？这里本来就有点阴森了，再这么一来，像在内斗一样！还是我来说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210818,
					"content": "是这样的，最开始，我们听说秘境里有魔物逃出来，就和天领奉行的武士们一起赶到这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210819,
					"content": "我们遇到你的时候，你完全不知道秘境的来历，也不知道自己是为何而生…但我们相信那时你真的一无所知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210820,
					"content": "就算不相信你，我们也要相信辛焱。辛焱认可了你，我们就和你一起行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210821,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210822
					]
				},
				{
					"id": 400210822,
					"content": "随着探索，我们不断深入秘境，眼看就要找到真相了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210873
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210873,
					"content": "可直到现在，我们也无法确定这座秘境是不是为了某种…邪恶的目的…而被制造出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210823,
					"content": "一只箱子里可能藏着宝藏也可能藏着灾难，那我们就是到了开箱前的最后时刻呀！总不能毫无准备地打开它吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210824,
						400210825,
						400210826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210824,
					"content": "如果惟神包藏祸心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210827,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210828
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210828,
					"content": "我不喜欢看别人做没有退路的选择，但…就像旅行者说的那样，我们确实应该做好准备，我们要对彼此负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210829
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210829,
					"content": "我明白…到我做决定的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210830
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210830,
					"content": "迄今为止，我始终是带着谜团来承受你们的帮助。即使只并肩战斗了短短几天，我们之间也不该有隐瞒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210831
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210831,
					"content": "单凭目前的信息，我不能给出保证。我想去相信晴之介，可我不知道这些年他是不是变了，又或者我的记忆是假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210832
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210832,
					"content": "我是「阴阳师」创造出来的「式神」，记忆残缺不全。对如今的我而言，你们四位朋友是我能够完全信赖、托付一切的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210833
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210833,
					"content": "我对你们是信任，对晴之介…是责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210834
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210834,
					"content": "他创造了我，我有义务跟随他。要是如你们所说，他是个坏人，那被他所掌控，也是我的命运…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210835
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210835,
					"content": "要是可能，我想保持这颗善良的心直到最后一刻。但武器不能违背主人的意志，他能创造我，就能控制我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210836
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210836,
					"content": "如果之后我和晴之介做出了伤天害理之事，我也相信…你们会为我们安排一个合适的结局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210837
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210837,
					"content": "呜…竟然反过来把难题抛给我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210838,
					"content": "但它意想不到地诚实呢，还说了那么大义凛然的话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210839
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210839,
					"content": "#{NICKNAME}，这个回答完全符合你的期待吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210840,
						400210841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210840,
					"content": "嗯。「式大将」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210842,
					"content": "你们俩…该不会早就串通好了吧？一个唱红脸，一个唱黑脸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210843
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210843,
					"content": "哈哈哈，不错的手法。用这种方式「试探」「式大将」的记忆是否还有缺损…旅行者，你成长了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210844
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210844,
					"content": "什么叫「试探」！我们这是有预谋的一搭一唱，一次成功的智取！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210845
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210845,
					"content": "辛焱不是说过吗？她会用她的方式确认同伴是否可信，我们也有我们的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210846
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210846,
					"content": "而且，趁着现在说，还能给「式大将」打打气呢！让它知道，就算它还很迷茫，我们也愿意信任它，愿意跟它一起前进！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210847
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210847,
					"content": "假如「式大将」真是伙伴，就不会过快地选择阵营。只有老实说出自身存在的威胁，才是对同伴负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210848
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210848,
					"content": "我能感知到真诚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210849
					]
				},
				{
					"id": 400210849,
					"content": "我不擅长撒谎…谢谢你能感受到我的真心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210850
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210850,
					"content": "好人也会有欺骗他人、利用他人的时候，反之，坏人也会有顾虑和牵挂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210851
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210851,
					"content": "能说出对自己而言无比残忍的答案…你确实做好了觉悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210852
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210852,
					"content": "就像辛焱说的，呃…怎么说来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210853
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210853,
					"content": "哪句啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210854
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210854,
					"content": "想起来了想起来了！「这种语言非常诚实，只会触动人心底最真诚的部分」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210855
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210855,
					"content": "只字不差，真亏你记得这么牢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210856
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210856,
					"content": "所以，我们的战前动员会开完了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210857
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210857,
					"content": "开完了就走吧，速战速决！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210858
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210858,
					"content": "「式大将」，别太担心，我们都在你身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210859
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210859,
					"content": "我明白。我会全力以赴，不给你们添麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210860
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210860,
					"content": "添一点也没关系啦！只要我们能赢就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210861
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210861,
					"content": "只要打赢关键的一战…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210862
					]
				},
				{
					"id": 400210862,
					"content": "不，也要做好最坏的打算。假如这扇门并不通向秘境深处，而是一道机关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210863
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210863,
					"content": "不会吧？你不要乌鸦嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210864
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210864,
					"content": "万一嘛。谁也不能保证这件事绝对不会发生，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210865
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210865,
					"content": "遗憾的是，就算真是如此，凭目前的我多半也无法阻止…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210866
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210866,
					"content": "我还没能完全掌控这里。抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210867
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210867,
					"content": "我倒觉得没什么。像这样机会难得的挑战圣地，再重组十次都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210868
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210868,
					"content": "呜呜…我才不要，你自己一个人去享受吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210869
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210869,
					"content": "总之，如果触发重组，你们就在确保自身安全的前提下尽量集体行动吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210870
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210870,
					"content": "那你呢？又要去战斗了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210871
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210871,
					"content": "不用担心，我啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210872
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210872,
					"content": "当然是要好好享受一切危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210841,
					"content": "现在我完全信任你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210825,
					"content": "如果他想要危害稻妻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210826,
					"content": "你会站在我们这边吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210813,
					"content": "我有事要坦白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				}
			]
		},
		{
			"id": 4002109,
			"completionStepIds": [
				4002109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
