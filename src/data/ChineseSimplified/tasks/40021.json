			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210901,
					"content": "可恶，我们又被弹出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210902,
					"content": "下次别让小哥开口了，这乌鸦嘴…未免太过灵验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210903
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210903,
					"content": "我受不了这个秘境啦——！惟神晴之介是不是不敢面对我们，他是不是胆小鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210904,
					"content": "不过，考虑到附近还有天领奉行的武士驻扎，小哥和「式大将」待在里面，也算是避开了一些麻烦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210905
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210905,
					"content": "（惟神…究竟在哪儿呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210906
					]
				},
				{
					"id": 400210906,
					"content": "老规矩，等秘境重组完进去找他们会合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210907
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210907,
					"content": "在此之前我们得隐藏好自己，别被天领奉行的人发现我们还在这一带徘徊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210908
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210908,
					"content": "下次进去，一定要把罪魁祸首揪出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4002114,
			"completionStepIds": [
				4002114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002114",
							"2"
						],
						"stepId": 4002114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400211401,
					"content": "「拓本」里残留的符法之力有限，我能找回的记忆也有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211402
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211402,
					"content": "还不够吗？那就按计划，继续朝秘境深处前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211403
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211403,
					"content": "不对不对，秘境重组过，我们好不容易找到的路线早就没用啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211404,
					"content": "关于这一点，请不必担心，秘境的重组也是有规律的，我隐约记得方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211405
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211405,
					"content": "朝那边走，应该不会有错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211406
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211406,
					"content": "等一下，我有问题！「式大将」，你刚才说「拓本」里残留的力量不够，记忆恢复得也很有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211407,
					"content": "那你怎么知道自己走的路就是正确的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211408,
					"content": "上次跟着你穿过那道门之后，我们就被送出了秘境…说明这个地方的门并不一定都是真门！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211409,
					"content": "要是你分辨不清把我们带到了危险的地方，岂不是完蛋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211410,
					"content": "你有这样的担心并不奇怪，可惜我还给不出令人信服的答案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211411
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211411,
					"content": "如果我说，这是作为「寮司」的直觉，你能接受吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211412
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211412,
					"content": "总感觉心里好没底啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211413,
					"content": "派蒙的问题不无道理，但我们也只能相信「式大将」这个领路人，否则，难道要一直在这里等着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211414
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400211414,
					"content": "而且，万一秘境再次动起来…到那时，说不定我们就更没方向了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211415
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400211415,
					"content": "嗯，出去一趟回来，变得心急了些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211416
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211416,
					"content": "我猜猜…是遇到什么麻烦了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211417
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211417,
					"content": "据我所知，现阶段稻妻的局势还没完全稳定下来。像这样的秘境应该归天领奉行处理，可天领奉行人手短缺，不足以控住全局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211418
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211418,
					"content": "所以，你们来这里是受人所托，而且很有可能就是受天领奉行所托。你们领了他们的命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211419
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211419,
					"content": "以那些人的作风，恐怕会直接杀入秘境，碾碎一切。要是在那之前找不回「式大将」的记忆，它就没有机会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211420
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211420,
					"content": "所以你变得有些心急，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211421
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211421,
					"content": "你果然在调查稻妻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400211422
					]
				},
				{
					"id": 400211422,
					"content": "这一切还是你们的阴谋吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211423,
					"content": "我确实在调查一些事，不过不是你想的那些。这件事稍后再说，现在先解决眼前的问题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211424
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211424,
					"content": "旅行者，我跟你有交情，没必要在这些地方故意撒谎。抵达稻妻之后，我在周边地区发现了魔物的踪迹，自然就追到这座秘境里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211425
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211425,
					"content": "这里就像是一座为斗士而设的训练场…只有战斗，只有厮杀。在这里，我能尽情释放自己，尽情享受！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211426
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211426,
					"content": "这话可能不太好听，但除了旅行者和派蒙，我跟另外两位是第一次见。你们应该不知道，我并不是那么在乎立场的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211427
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211427,
					"content": "善恶、正邪、使命…这些事真有那么重要吗？能比极致的战斗，酣畅的厮杀更吸引人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211428
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211428,
					"content": "果然是好战之人。小哥，那你的意思是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211429
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400211429,
					"content": "我没什么特别的想法，只是告诉你们，尽管前进吧，别畏惧路上的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211430
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211430,
					"content": "假如你们无法全力以赴，我会代替你们碾碎一切。假如你们对此有所抗拒，我将扛下一切杀戮之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211431
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211431,
					"content": "因为…战斗才是我最擅长的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211432
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211432,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211433
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400211433,
					"content": "别、别都看我啊！那我走，我走行了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}