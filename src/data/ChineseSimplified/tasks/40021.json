			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210301,
					"content": "辛焱，旅行者，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210302
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210302,
					"content": "刚才有位女将领带着一些人手到这附近侦察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210303
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210303,
					"content": "她是天领奉行的人，九条裟罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210304,
					"content": "九条裟罗…天领奉行有这么一号人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210305
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210305,
					"content": "我似乎听说过天领奉行主将的名字，是一位男性，叫九条…呃，什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210306
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210306,
					"content": "有些记不清了，但我想起了一些琐事。我记得，晴之介和那位天领奉行的主将下过棋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210307
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210307,
					"content": "这个晴之介，莫非还是个有头有脸的人物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210308,
					"content": "闲话稍后再说吧，趁没人发现，我们赶紧溜到阴阳寮里去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210309
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210309,
					"content": "对哦，还要找那个丢了的家伙呢！快走快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210310,
					"content": "好，各位，请随我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「式大将」"
				}
			]
		},
