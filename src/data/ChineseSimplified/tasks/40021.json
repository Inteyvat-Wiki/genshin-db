			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210101,
					"content": "旅行者，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210102
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210102,
					"content": "刚才九条裟罗来了，就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210103
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210103,
					"content": "她这去而复返的样子，是真对我们放心不下吧…警惕心很重呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210104,
					"content": "是认真负责的表现啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210105
					]
				},
				{
					"id": 400210105,
					"content": "情况有些复杂，我们先去跟她沟通吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4002102,
			"completionStepIds": [
				4002102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002102",
							"2"
						],
						"stepId": 4002102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条裟罗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210201,
					"content": "三位，这段时间有劳你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210202
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210202,
					"content": "我带人手过来了，可以说，最危急的时刻已然过去。之后，我们只需扼守这条要道就能有效防备魔物，如有逃窜者，也可将它们封堵在荒海一带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210203
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210203,
					"content": "先前我听见秘境内有巨大的响声，恐怕这里面有大量机关…我们正在筹备，打算等一个合适的时机举兵攻入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210204
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210204,
					"content": "你们不打算驻扎在离秘境更近的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210205,
					"content": "上次行动时，武士们没想到要跟秘境保持足够的距离。魔物突袭，他们只能仓皇后撤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210206
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210206,
					"content": "一次是意外，两次是失误。我不会允许这种事再次发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210207
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210207,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210208,
					"content": "（正好，给了我们机会。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210209
					]
				},
				{
					"id": 400210209,
					"content": "稍后我将返回九条阵屋，统筹其他地区的防务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210210
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210210,
					"content": "虽然来得晚了些，但天领奉行已接手这里，感谢三位鼎力相助。承诺的报酬，我也记着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210211
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210211,
					"content": "辛焱小姐，请拿着这封信，里面有我亲自为你开具的「通行凭证」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210223
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210223,
					"content": "我为你申请了最长的停留时限，希望你能利用这段时间在稻妻好好游览一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210212
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210212,
					"content": "此外我还为你安排了食宿，等回到城里，你直接照信中指示前往下榻处即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210213
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210213,
					"content": "天哪！这得算天降横财了吧？食宿全免，畅游稻妻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210214
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210214,
					"content": "不必客气，理应如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210215
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210215,
					"content": "谢谢你啦。看你最近这么忙，也不知道什么时候才能闲下来…要是你休假时我还在稻妻，请来看看我的街演吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210216
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210216,
					"content": "实不相瞒，我对诗歌音律兴趣不大。但你帮了天领奉行许多，我想…有机会的话，我会去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210217
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 400210217,
					"content": "这么一来，辛焱最操心的事就解决啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210218,
					"content": "不不，最让人操心的是「式大将」才对吧！接下来就无关我的个人利益了…作为朋友，我还得回去帮它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210219
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210219,
					"content": "还有那位小哥，旅行者，我们肯定得去救他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210220,
						400210221
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210220,
					"content": "虽然他应该没事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				},
				{
					"id": 400210222,
					"content": "那走吧，我们偷偷去找「式大将」会合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210221,
					"content": "但也不能放着不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				}
			]
		},
		{
