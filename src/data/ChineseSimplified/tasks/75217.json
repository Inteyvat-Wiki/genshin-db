			"dialogs": [
				{
					"id": 752190101,
					"content": "#啊…那边的，是{NICKNAME}吧，还请留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190102,
					"content": "这里有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190103,
					"content": "哦，怎么了？有什么需要帮忙的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190104,
					"content": "哈哈，不是，是你们有一封快件，真是凑巧，我正想着要去哪里找你们呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190105,
					"content": "你们就出现在我面前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190106,
					"content": "咦，是谁寄过来的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190107,
					"content": "说到这个，这可是长途跋涉来到这里的快件啊，辗转了很多手，才从冒险家协会转到悬木人的讯使这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190108,
					"content": "毕竟纳塔最近的情况比较特殊，正常的商队往来都搁置了好一段时间，没写寄件人，不过看落款…似乎是从枫丹来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190109,
					"content": "看来你们在枫丹也有不少朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190110,
					"content": "那我就收下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190111,
					"content": "嗯，交给我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "嗯，真是火神保佑，刚拿到的快件就找到了收货人，今天的工作有了个好的开头啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190113,
					"content": "好了，我接下来要去送其他东西了，祝你们今天也一切顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "胡奇鲁"
				},
				{
					"id": 752190114,
					"content": "好哦，你也工作顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190115,
					"content": "唔，是枫丹来的，看上去轻飘飘的，与其说是快件，看上去就像是一封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190116,
					"content": "我们快拆开来看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190117,
					"content": "啊，原来是夏洛蒂寄过来的，唔，原来是离开枫丹的时候拍摄的画片呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190118,
					"content": "明明离拍这张画片的时候还没有多久，可是又觉得已经隔了很长很长的时间了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752190119,
					"content": "嘿嘿，我们这就把这张画片好好收起来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}