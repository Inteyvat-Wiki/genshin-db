			"dialogs": [
				{
					"id": 80030501,
					"content": "看来，我们到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030502,
					"content": "怪异、枯萎…令人不快的房间。我理解你们所说的恶质气氛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030503,
					"content": "呜呜呜…还是这么恐怖的环境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030504,
					"content": "小心，不要被「污秽逆位神像」的力量压倒了——「深渊使徒」就在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030505,
					"content": "呵呵呵呵…敏锐的嗅觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80030506,
					"content": "你还是这么讨人厌啊，教团之敌，戴因斯雷布！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80030507,
					"content": "我能感受到，你身上有股可怕的血腥味。是来自漆黑的噩梦，亦或是…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80030508,
					"content": "噢噢…真危险。你也有那种「腐朽」的味道，让我熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80030509,
					"content": "你和我们一样，都是危险的事物。但「教团」以外的危险之物，都该被放在笼子里才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "深渊使徒"
				},
				{
					"id": 80030510,
					"content": "啧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030511,
					"content": "你的舌头，恐怕也「腐朽」了太久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030512,
					"content": "该切了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				}
			]
