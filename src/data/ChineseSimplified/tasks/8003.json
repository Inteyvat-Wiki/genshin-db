			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "呀，戴因在这里。你有见过琴团长吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030102,
					"content": "我见到她了，但刻意避开了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030103,
					"content": "她是「狮牙骑士」，又是代理团长，必然会对我抱有戒心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030104,
					"content": "若我不谨慎，总有一天会变成她的调查对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030105,
					"content": "话说回来，我这边只是解决了些魔物，没找到什么情报。你们那边，有收获吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030106,
					"content": "原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030107,
					"content": "那么，「世上第一座耕地机」动向的全貌，大致就已经能够拼凑齐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030108,
					"content": "咦？真的吗？就凭「王狼」说的那些话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030109,
					"content": "不止是凭这一条信息，而是更综合的考虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030110,
					"content": "比如，你们之前告诉我说，教会传下的那个「老故事」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030111,
					"content": "「暴君的遗怨」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "没错。正是你口中那位修女提到的，曾被误认为暴君遗怨的奇怪事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030113,
					"content": "如果从天而降的火球是导弹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "啊，我懂了！所以「暴君的遗怨」，其实是从奔狼领逃走的那座机器，自动发射的导弹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030116,
					"content": "它在「狼的试炼」里损坏以后，游荡到了「旧蒙德」的废墟，住了下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030117,
					"content": "只要有人接近，就咚咚咚——地发射。直到有一天，它终于坏掉了，所以从天而降的火球也消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030118,
					"content": "那时候的蒙德人还没大量接触过「遗迹守卫」，就只能解读成是「暴君的遗怨」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030119,
					"content": "看来，我们该去那个现在叫做<color=#00E1FFFF>「风龙废墟」</color>的地方，开始地毯式搜查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030120,
					"content": "不。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "哦？你的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030123,
					"content": "我有…现成的「记忆」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "咦…你是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030125,
					"content": "哦！我也懂了！没错没错，那台<color=#00E1FFFF>「坐在高塔上的守卫」</color>，确实很让人印象深刻呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030121,
					"content": "不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "当时的蒙德想不通火球是什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "其实芭芭拉是祈礼牧师来着…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
			"completionStepIds": [
				800305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
