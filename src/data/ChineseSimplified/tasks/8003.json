			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "就是这个吗？好，用元素视野看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030302,
					"content": "唔唔唔唔——怎么样，有什么发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030303,
					"content": "欸？你说什么都没发生？明明我还这么期待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030304,
					"content": "怎么会，是不是哪里搞错了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030305,
					"content": "是方法的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030306,
					"content": "对「耕地机」用元素视野是不可行的，因为驱动它的能源从来不是「元素」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030307,
					"content": "交给我吧，我来尝试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030308,
					"content": "…好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030309,
					"content": "哇，这就是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030310,
					"content": "深渊使徒一直寻找的关键，「世上第一座耕地机的眼睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030311,
					"content": "如今留存的所有遗迹守卫，都是这台机器的仿制品。作为「原型机」，它的战斗力不受控制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030312,
					"content": "「原型机」…难懂的词，是坎瑞亚人的术语吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030313,
					"content": "正如深渊教团所想，若能将「眼」置于「污秽逆位神像」之手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030314,
					"content": "以此作为基底，接合「漩涡之魔神」奥赛尔的肢体，制造机械魔神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030315,
					"content": "就能为新诞生的污秽魔神，赋予「动摇天空岛上神座」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030316,
					"content": "极端又危险的行为…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030319,
					"content": "那那那，这「眼睛」该怎么处理？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030320,
					"content": "找个隐秘的地方藏起来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "不。由我来保管它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030323,
					"content": "欸？！你？戴因…你该不会拿它去做奇怪的事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030324,
					"content": "随你质疑我的立场吧，但我必须确保它的力量不被旁人利用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030325,
					"content": "隐秘之地会被挖掘，而教会——在我眼中不值得信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030326,
					"content": "呃…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030327,
					"content": "不仅如此，为了永绝后患，我们还要「处理」那座「污秽逆位神像」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030328,
					"content": "怎么处理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "不能让教会介入，我们自己处理。至于「处理」的意思…自然是销毁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030331,
					"content": "销、销毁？！那可是七天神像啊！不仅是很有意义的文物，而且是真正的、神灵的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030332,
					"content": "幸亏之前瞒着芭芭拉，否则她现在一定会疯的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80030333,
					"content": "呵…七神之物，难道还要我帮他们悉心爱护？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030334,
					"content": "走吧，回<color=#00E1FFFF>那座遗迹</color>。我们去砸毁逆位的神像，而且，运气好的话，还能遇到「深渊使徒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030335,
					"content": "有我在，它就没可能再从你眼前消失一次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80030329,
					"content": "可以交给教会去办吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "交给西风教会保管吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "一定要阻止深渊教团。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
