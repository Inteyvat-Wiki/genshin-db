			},
			"dialogs": [
				{
					"id": 205160401,
					"content": "这孩子，不是一直在生病吗？怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 205160402,
					"content": "请问您看见过一个女孩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "呼…您是在找安娜吧，您往上看，她就在风神像的手上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 205160404,
					"content": "她跑过来的时候，我还在奇怪，这孩子不还是在生病吗？怎么突然这么有活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 205160405,
					"content": "我就是一个愣神，这孩子就爬到风神像手上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 205160406,
					"content": "您…为什么不生气？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "生气？啊…当然是有一些的，不过，那孩子之前一直被病痛折磨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 205160408,
					"content": "现在看见她这么健康的样子，怎么说呢，我反而生气不起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 205160409,
					"content": "不过，上面风很大，这孩子别着凉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
