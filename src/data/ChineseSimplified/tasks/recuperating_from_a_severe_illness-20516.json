			},
			"dialogs": [
				{
					"id": 205160101,
					"content": "这丫头，又跑到哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160102,
					"content": "安娜又出去玩了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "我说啊，你怎么一副习以为常的表情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160104,
					"content": "安娜是越来越不听话了，我一个不留神，她又溜出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160105,
					"content": "她的病还没有好全呢，你快点帮我找找安娜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160106,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160115,
					"content": "对了，之前安娜一直和我说，想要去看看风神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160116,
					"content": "我记得，葛瑞丝修女经常呆在那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160117,
					"content": "你可以先去问问她，说不定她会注意到什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160108,
					"content": "你找过了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "我当然找过了，连城外都去过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160110,
					"content": "就是找不到，才只能拜托你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160111,
					"content": "安娜喜欢吃什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "哦，她喜欢吃…喂！都说了不要把我妹妹当成猫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160113,
					"content": "再说了，她喜欢吃的东西多了去了，我数得过来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160114,
					"content": "好了，拜托你快去找找吧，我就在这等你。找了一圈，我都快累死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "安东尼"
				}
			]
		},
