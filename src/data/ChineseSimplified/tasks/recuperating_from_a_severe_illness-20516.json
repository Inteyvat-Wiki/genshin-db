					"nextDialogs": [
						205160303
					]
				},
				{
					"id": 205160303,
					"content": "风，风神像的手上？！她到底是怎么爬上去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160304,
					"content": "我马上去那边，把她给叫下来好好教训一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160305
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205160305,
					"content": "辛苦你了，这些就收下吧。",
