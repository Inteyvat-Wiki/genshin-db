			},
			"dialogs": [
				{
					"id": 221010101,
					"content": "没完没了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "唉，在这里开个客栈可不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010104,
					"content": "不知道是不是我的错觉…总觉得周围的那些怪物，是越来越多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010105,
					"content": "虽然它们也不会靠近客栈，但是客人总要进出，来往道路上的千岩军也不可能时刻把守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010106,
					"content": "如果有空的话，你能帮我去周围看看，把客栈旁边的怪物给清一清吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "哈哈，您说话做事真是爽利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010113,
					"content": "让您受累，实在是有些不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010114,
					"content": "事结之后，报酬我绝不会少您一分的，请您放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010115,
					"content": "那么，就万事拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010108,
					"content": "这家客栈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "在这种地方开客栈，这种问题也免不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010111,
					"content": "不过，要是没了我们这家客栈，那野外的行人去哪落脚呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010112,
					"content": "虽然累，不过开着也是好事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "淮安"
				}
			]
		},
