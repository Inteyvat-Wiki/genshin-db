			"dialogs": [
				{
					"id": 221010201,
					"content": "怎么样？周围的怪物都清干净了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010202,
					"content": "还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "倒也不用太着急，那些个怪物也顶多敢骚扰骚扰来往进出的人，不敢进客栈来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010204,
					"content": "就算是有三五只胆子大的进来了，唔…我倒也能赶出去，客人不用担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010205,
					"content": "哈哈哈，在这郊外开客栈，会点拳脚防防身，也是很正常的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
