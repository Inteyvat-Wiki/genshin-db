			"dialogs": [
				{
					"id": 711160601,
					"content": "两位豪侠！多谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160602,
					"content": "不用谢不用谢！不管在哪里交易，都要遵守契约才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160603,
					"content": "呵呵，这位小豪侠说的是。不过这样看，两位似乎对我们的交易很清楚嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160604,
					"content": "是铁豆儿告诉我们的啦，她说你们在这里走砂什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160605,
					"content": "不过走砂是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160606,
					"content": "好像不是什么正规的交易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "既然这样，那我必须得要好好感谢两位豪侠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160608,
					"content": "来人！把他们绑好咯，丢去海里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160609,
					"content": "记得多绑几块石头，这两位对我们铁盐帮有恩，别叫他们多遭了罪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160610,
					"content": "什么？！你…你要对我们做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160611,
					"content": "这位小豪侠，你刚才不是还很明白吗？璃月是讲究契约的国度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160612,
					"content": "撞破了非法团伙的交易，自然就会被灭口，这不是人尽皆知的契约吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160613,
					"content": "哪有这种契约啊！你这种恩将仇报才是不讲契约！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160614,
					"content": "不要白白浪费我的好意，等我亲自动手，你们就有苦头吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160615,
					"content": "你知道我是谁吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "少废话！铁豆儿！铁船儿！还不动手？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160618,
					"content": "铁明老大，你果然还是这么不仁不义啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "铁船儿"
				},
				{
					"id": 711160619,
					"content": "也不枉我们费一番功夫，绝对不能再放你这样的人在璃月为非作歹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160626,
					"content": "收网！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160620,
					"content": "什…什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160621,
					"content": "贼人铁明！睁大你的眼睛再好好看看！我们是谁？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160622,
					"content": "千…千岩军？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160623,
					"content": "喂喂！怎么回事？！怎么突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160624,
					"content": "我只当你们几个是新上了跳板，没想到是该死的鹰爪孙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160625,
					"content": "别以为我会束手就擒！我跟你们拼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160616,
					"content": "喔唷！我好怕怕！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
