				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "合字上的朋友，大恩不讲谢，有什么需要的，招呼一声就成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160203,
					"content": "喔！你这个人还怪客气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160204,
					"content": "那我就直说了，最近手头有点紧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "需要摩拉？哈哈，这倒是好说。就是办起来还有点小小的麻烦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160206,
					"content": "俺们的摩拉，全被瓢把子带走了。现在这土窝已经成黄草窑子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160210,
					"content": "瓢把子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "就是俺们铁盐帮的老大，他在那边的山崖底下，跟一伙枫丹佬走砂，留下俺们守着窝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160212,
					"content": "但是刚刚朋友也瞧见了吧？那些枫丹皮娃子，居然趁着瓢把子在谈事儿，偷偷摸了来，捅屁股！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160213,
					"content": "呜哇…捅屁股…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160214,
					"content": "呜哇…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "好崽子，这是把俺们当羊牯了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160216,
					"content": "现在这边水漫了，瓢把子指不定也要吃暗青子。好朋友，话说帮人帮到底，还请再帮俺们一把？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160217,
					"content": "若瓢把子没事，保准有你们吃香喝辣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160218,
					"content": "在哪里？我先去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "就在那边山崖底下的海滩，你们过去指定能瞧见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160220,
					"content": "两位朋友，托你们先走一步，俺收拾收拾就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160207,
					"content": "路见不平，拔刀相助而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "义薄云天！义薄云天啊！既然这样，两位朋友，俺正好有个事儿想说说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "铁豆儿"
				},
				{
					"id": 711160209,
					"content": "俺觉得瓢把子那边，搞不好也得遭事，得去帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "铁豆儿"
				}
			]
		},
