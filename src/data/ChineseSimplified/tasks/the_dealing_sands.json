			"dialogs": [
				{
					"id": 711160401,
					"content": "尊尼老大，你我朋友一场，我呢，也明白你们近来有难处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160402,
					"content": "有什么问题当面和我商量就好，搞成这样…未免有点伤感情了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160403,
					"content": "嘿，朋友…你知道，我们这边的生意不同往常了。「刺玫会」近来得了势，我们的兄弟颇有些成了干货，落了水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160404,
					"content": "小鸟儿们都还嗷嗷待哺呢。再这样下去，我们恐怕连鸟嘴都沾不湿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160405,
					"content": "我们的生意很好，很合理，如果多给我们一点…将来感谢的机会，我想朋友们会更能体会到我的诚意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160406,
					"content": "不然…哈哈，大海这样广阔，铁明先生，你们也不是不好找到新朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160407,
					"content": "这样说，尊尼老大，这个报价，就是你的意思了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160408,
					"content": "这样的价格有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160409,
					"content": "枫丹佬！招子放亮点！这点钱打发谁呢？！放那么多的屁干什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "铁船儿"
				},
				{
					"id": 711160410,
					"content": "多嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160411,
					"content": "尊尼老大，我的货卖给唐佩西家族，一箱五万八。卖给德尼禄家族，一箱七万。他们都是柔灯港地下响当当的帮会，这不必我说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160412,
					"content": "我的货卖给你，三箱只要十万，专人接，专人送…为什么？为的是珍惜你这个朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160413,
					"content": "大道理我就不多说了…我相信尊尼老大还是欠考虑了！我们找个地方喝一杯，再聊聊怎么样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160414,
					"content": "呵呵，没那个必要。我知道璃月人最讲究契约，契约最在乎公平。可没听说过情理能大于公平的说法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160415,
					"content": "呵呵，尊尼老大！如此注重契约精神，我的小弟们也该多多向你学习，哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160416,
					"content": "只不过，在这件事上，我要首先看到你们对契约的尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160417,
					"content": "当然，当然！您的话再有道理不过了，璃月的古老契约真是令人崇敬，看来我必须要展示一下我的敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160418,
					"content": "沃克，你觉得给每件货的报价再提高…一摩拉，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160419,
					"content": "十分恰当，尊尼先生。这些璃月人如此辛劳，理应再获得每件货一摩拉的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160420,
					"content": "枫丹佬！你们到底什么意思？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "铁船儿"
				},
				{
					"id": 711160421,
					"content": "朋友，你们还感受不到这份远道而来的诚意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160422,
					"content": "尊尼老大，你们这是执意要违背约定了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160423,
					"content": "哦？是吗？沃克，你觉得是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160424,
					"content": "尊尼先生，若您问我的意思…大海如此广阔，是虾米就该有点自知之明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160425,
					"content": "沃克，我为你羞愧，你怎能如此侮辱我们的璃月朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160426,
					"content": "毕竟稍后就要收下他们的地盘，我们不该心怀感恩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160427,
					"content": "对不起，尊尼先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160428,
					"content": "你们！混账东西！你们居然打着这个主意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "铁船儿"
				},
				{
					"id": 711160429,
					"content": "怎么还骂起人了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "哦？这两位小朋友是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160431,
					"content": "呵呵，可真是有趣啊，璃月的小朋友都这么有胆色吗？沃克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160432,
					"content": "喂！哪来的小鬼，赏你们点摩拉，赶紧滚去买奶喝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160433,
					"content": "你！你们这些人也太没礼貌了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711160434,
					"content": "你们两位是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160435,
					"content": "我们是来吃香喝辣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "哈哈哈哈！这样说来…你们是铁明先生请来的帮手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160438,
					"content": "原来铁明先生也早就对我们有想法了啊？哼，我们也不是毫无准备。沃克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160439,
					"content": "出来吧！兄弟们！到时候了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "沃克"
				},
				{
					"id": 711160440,
					"content": "什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "铁船儿"
				},
				{
					"id": 711160441,
					"content": "哎呀，哎呀，怎么回事？好像还是我们的人比较多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160442,
					"content": "铁明先生，真遗憾，我事先给手下安排了一些活，现在您留在营地的人，应该已经被清理干净了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160443,
					"content": "请安心的去吧，您的生意我们会好好打理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160444,
					"content": "尊尼老大…想淌我们铁盐帮的线，没那么简单！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "铁明"
				},
				{
					"id": 711160445,
					"content": "希望您的命和嘴一样硬，动手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尊尼"
				},
				{
					"id": 711160436,
					"content": "我们是来送某些人回家喝奶的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
