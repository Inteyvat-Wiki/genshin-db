			"dialogs": [
				{
					"id": 150470101,
					"content": "你们来了！这里的工作人员好像临时有事走开了，不过我已经弄明白要怎么玩…我是说，完成测试了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470102,
					"content": "好呀，那你教教我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470103,
					"content": "简单来说，需要一方登上游船，另一方给龙员工发送信号。通过默契的双人合作，将游船安全送到目的地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470104,
					"content": "#要说考验默契，我对我和{NICKNAME}的配合可是很有信心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470105,
					"content": "是吗？一般说完大话就离翻船不远了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470106,
					"content": "喂喂，派蒙，不吉利的话可不要乱说噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470107,
					"content": "好吧，那…那祝你们一帆风顺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470108,
					"content": "哼哼，一定会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470109,
					"content": "其实我挺想坐船的，平时高难度的冲浪挑战惯了，换个口味也很新鲜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470110,
					"content": "我也开腻浪船了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "哇！一拍即合？！这就是我们牵绊的证明吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470113,
					"content": "我已经等不及想要给豚豚泳装充足气，一个弹跳飞到游船上去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470111,
					"content": "我来发信号吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
