						150470405
					],
					"speakerTitle": "幼暝视龙"
				},
				{
					"id": 150470405,
					"content": "把它…放到这里…造出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "幼暝视龙"
				},
				{
					"id": 150470407,
					"content": "它好像看不懂你的比划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470408,
					"content": "是啊…怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470409,
					"content": "慢着慢着慢着，我突然想到新办法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470410,
					"content": "「咿——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "幼暝视龙"
				},
				{
					"id": 150470412,
					"content": "「咿——」「咿——」「咿——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150470413,
					"content": "……",
