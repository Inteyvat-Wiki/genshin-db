					"content": "有只暝视龙员工在这里！是不是应该拜托它帮忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470403,
					"content": "可以请你把它们建造出来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "玛拉妮"
