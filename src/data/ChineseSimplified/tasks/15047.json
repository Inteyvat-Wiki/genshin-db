					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#噢！你好你好，你看起来好乖哦，{NICKNAME}没有跟你一起来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
