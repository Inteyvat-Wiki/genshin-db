			"trigger": {
				"objectNames": [
					"韦尼尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "一百三十六…好，再来十四次，就可以休息了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230202,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "帮忙？不不，不用，哪有锻炼还需要别人帮忙的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230204,
					"content": "只有锻炼出强悍的体魄，才能像这位长官一样，加入不朽军团成为一名荣耀的士兵啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230205,
					"content": "…………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230206,
					"content": "忘了介绍了，这位是我的教官。只有经过了他的考核，才能有获得擢升的资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230207,
					"content": "这不是个雕像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "你在说什么呢，公民？雷穆利亚人不都长成这个样子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230209,
					"content": "怎么样，你要试试吗，只要能同时打碎这些石柱，就算是通过初步的考核了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230213,
					"content": "可别小看这些石柱，我锻炼了这么久也才勉强能一拳打碎一个呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230210,
					"content": "考核？什么考核？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "当然是战斗的考核，就算擢升后能获得不朽的身躯，战斗的技能也是要通过自己的锻炼才能习得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "韦尼尔"
				},
				{
					"id": 742230212,
					"content": "怎么样，你要试试吗，只要能同时打碎这些石柱，就算是通过初步的考核了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "韦尼尔"
				}
			]
		},
