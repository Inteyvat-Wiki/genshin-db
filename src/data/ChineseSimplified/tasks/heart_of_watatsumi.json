			"trigger": {
				"objectNames": [
					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#欢迎回来，{NICKNAME}。请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490202,
					"content": "关于你的委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "我们已经取得四颗「御灵珠」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490204,
					"content": "这样吗？真是太可靠了，非常感谢！那么接下来距离解开最后的「心」之封印就只有一步之遥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490205,
					"content": "接下来还要辛苦两位随我一同前去，希望您不要介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490206,
					"content": "#既然都到这里了，我们也不在乎多走两步路啦！对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490207,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "那么事不宜迟，我们现在就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721490208,
					"content": "我没什么所谓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
			"id": 7214903,
			"completionStepIds": [
				7214906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
