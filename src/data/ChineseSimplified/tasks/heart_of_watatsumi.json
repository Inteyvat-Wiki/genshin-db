					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490302,
					"content": "露子小姐…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "啊，抱歉，刚刚太入神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490304,
					"content": "多谢你们的帮助，终于取得「月浴渊之钥」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490305,
					"content": "「余哕鱼圆只月」…好拗口…那是什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490306,
					"content": "哈哈，简称「渊之钥」就好，我们不会强求外国人的读音准确与否的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490307,
					"content": "这是打开渊下宫入口的必备之物，由大御神大人身上流出的血铸结而成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490308,
					"content": "至少传说是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490309,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490310,
					"content": "玄之又玄呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "一点也不玄啦，恰恰相反…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490312,
					"content": "接下来要上报现人神巫女大人，等她批准，再等灵脉的流动正确…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490313,
					"content": "之后，就可以进入渊下宫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490314,
					"content": "所以你在支使我们做什么啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490315,
					"content": "你们这趟又不是全无收获！对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490316,
					"content": "比如…你们收获了珊瑚宫官方长久的友谊！海祇岛今后会一直欢迎你们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490317,
					"content": "什么啦！说得像真的一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490318,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490319,
					"content": "记载中有说，「御灵珠」只会应正直纯良之辈的召唤，「月浴渊之钥」也只会为心灵清澈如水之人凝聚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490320,
					"content": "虽然我不总是相信那些文书，但我相信您能给海祇岛带来转机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490321,
					"content": "那么，待下渊下宫之刻到来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490322,
					"content": "我们后会有期。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "那么，再见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721490323,
					"content": "你会再求一次签？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "呵呵，我签运很好的。我们一定还会再见面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "露子"
				}
			]
		},
