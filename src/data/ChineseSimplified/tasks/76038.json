			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乌娜亚塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "（或许<color=#FFCC33FF>奈芙尔</color>会对糖雕有兴趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "给我来一份糖雕吧，乌娜亚塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760380103,
					"content": "奈芙尔老板，你怎么有空过来买糖雕了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380104,
					"content": "偶尔出来散散步，对我的身体和精神都有好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760380105,
					"content": "吃点甜的，也有助于我进行思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760380106,
					"content": "好嘞~稍等一下，我这就给您做一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380107,
					"content": "行。对了，这些钱给你，下次雅珂达来的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760380108,
					"content": "给她做得大一些？还是甜一些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380109,
					"content": "把这些钱给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760380110,
					"content": "就说：「奈芙尔出双倍的钱，请你在偷懒完毕后，帮她也带一份糖雕回去。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙尔"
				}
			]
		},
