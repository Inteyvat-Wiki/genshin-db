			},
			"dialogs": [
				{
					"id": 760381109,
					"content": "（或许<color=#FFCC33FF>莉奈娅</color>会对糖雕有兴趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "莉奈娅小姐，又来给露米买糖雕了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760381102,
					"content": "是呀，露米可喜欢你做的糖雕啦，每次都不舍得吃，只是舔舔就让我收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 760381103,
					"content": "不过，毕竟是糖雕嘛…舔多了也就化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 760381104,
					"content": "所以，拜托乌娜亚塔小姐，再帮露米做一份糖雕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 760381105,
					"content": "没问题！稍等一下喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760381106,
					"content": "（哎呀，露米太可爱了！好想摸一摸！但随便摸的话，算了算了，这样太失礼了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760381107,
					"content": "做好了，请拿好，莉奈娅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760381108,
					"content": "谢谢你！露米，糖雕好了，现在要吃么…咦，已经睡着了，那我等一会再把糖雕给它吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈娅"
				}
			]
		}
	]
