			"dialogs": [
				{
					"id": 760380409,
					"content": "（或许<color=#FFCC33FF>菲林斯</color>会对糖雕有兴趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "乌娜亚塔小姐。如果可以，请为我做一份糖雕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760380402,
					"content": "好嘞，你是…那位执灯士，菲林斯先生吧，我之前在商店里看见过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380403,
					"content": "是的。我偶尔回来采购物资，您能记住我，是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760380404,
					"content": "今天恰好路过此处，看见了您高超的糖雕技艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760380405,
