				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "（或许<color=#FFCC33FF>菈乌玛</color>会对糖雕有兴趣…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "乌娜亚塔小姐，请为我做几份糖雕吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760380302,
					"content": "没问题，菈乌玛小姐。上次你带回去的糖雕，孩子都喜欢么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380303,
					"content": "呵呵，他们很喜欢，有的孩子拿着糖雕不舍得吃，一直到糖雕快融化了，才慢慢品尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760380304,
					"content": "这样啊…嗯，下次我带上工具，直接到你那边去，给孩子们现场做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380305,
					"content": "这样就太好了~孩子们一定会很高兴的~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760380306,
					"content": "噢，聊远了…我稍后就去做糖雕。等做完了，就托人直接送到你们那边去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380307,
					"content": "但在那之前…嘿嘿，我刚巧有一个灵感~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "乌娜亚塔"
				},
				{
					"id": 760380308,
					"content": "稍等一下喔，菈乌玛小姐，我这就给你做一份特别的糖雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乌娜亚塔"
				}
			]
		},
