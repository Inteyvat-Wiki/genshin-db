			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "…事情的经过，就是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3580102,
					"content": "蒙德欢迎你们，随风而来的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580103,
					"content": "我是代理团长，琴。这位是丽莎，骑士团的图书管理员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580104,
					"content": "呀，是因为人手不足，所以来帮忙的好心孩子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580105,
					"content": "真可爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580106,
					"content": "只是，时机不怎么巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580107,
					"content": "风魔龙自从复苏以来，一直在城市周围活动，制造混乱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580108,
					"content": "现在蒙德的元素流动、地脉循环，都已经变得好像被猫咪抓过的线团一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580109,
					"content": "对魔法师来说这是最糟糕的情况喔…皮肤和心情都会变差…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580110,
					"content": "如果不受这些干扰，骑士团就有比寻人启事更好的办法来帮助你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580111,
					"content": "现在就请在蒙德暂住一下，由我们西风骑士团来努力解决问题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580112,
					"content": "也不能只让骑士团烦心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "派蒙也会帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3580116,
					"content": "那么，就来决定一下作战计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3580117,
					"content": "风魔龙进攻蒙德，反而让我们见到了终结灾难源头的契机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580118,
					"content": "在丽莎的魔法侦测之下，笼罩蒙德的飓风已经暴露了源流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580119,
					"content": "哦？ 那么答案是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3580120,
					"content": "被废弃的<color=#00E1FFFF>「四风守护」庙宇</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580121,
					"content": "风魔龙能够掀起这种程度的暴风，就是借助了那些残余的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3580122,
					"content": "而我们的目标，是这四座废弃庙宇中的<color=#00E1FFFF>三座</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580123,
					"content": "只选三座的理由…大家应该都明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580124,
					"content": "我不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3580125,
					"content": "这可能是本地人的默契…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "各位西风骑士，事不宜迟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580128,
					"content": "暴风正在肆虐，被动防守也没有意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580129,
					"content": "在龙灾扩大之前，就由我们抢先一步，向<color=#00E1FFFF>废弃庙宇</color>的<color=#00E1FFFF>遗迹</color>进发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 3580126,
					"content": "我们过会再问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "那就全靠骑士团了。旅馆在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "喂！不要偷懒，我们也该参与进来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}