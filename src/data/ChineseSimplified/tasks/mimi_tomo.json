			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "旅行者，请您过来这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240102,
					"content": "抱歉占用您一些时间，请问您有兴趣接受一份新委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240103,
					"content": "请讲无妨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "是这样的。根据最近协会收到的报告，野外的丘丘人们又聚集了起来，侵扰商道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240106,
					"content": "为此我们也派出了不少冒险家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240107,
					"content": "但根据那些冒险家的说法，在集结起来的丘丘人里，他们总能发现一个奇怪的丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240108,
					"content": "我们猜测，那个奇怪的丘丘人，或许会和这次丘丘人骚乱有关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240114,
					"content": "所以，我们需要有人去捕获，或者至少驱赶那个奇怪的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240109,
					"content": "旅行者，您有兴趣接受这份委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240110,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "谢谢您。我已经在您的地图上标注了几个地点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240113,
					"content": "这些地方都有丘丘人出没，请您先从这些地方开始调查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240115,
					"content": "如果遇见了那个奇怪的丘丘人…请您务必小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 700240111,
					"content": "我会留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "请问是什么委托？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
						],
						"stepId": 7002404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾拉·马斯克",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "幸好我们来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "你还好吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "呼…好险，幸好你们来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240204,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240205,
					"content": "明明刚刚进展还很顺利的…究竟是哪句话说错了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240206,
					"content": "不管怎样…感谢你们及时搭救…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240207,
					"content": "她看上去很消沉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700240208,
					"content": "毕竟刚刚发生的事你们也看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240223,
					"content": "自己跑出来和丘丘人沟通，果然还是风险太大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240210,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "有什么能帮上忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "可是…与丘丘人正常交流的机会，就这样浪费的话还是很不甘心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240212,
					"content": "这样的话，词典的编纂工作又要继续拖延了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240213,
					"content": "我可以帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "如果有人能替我验证书中内容的准确性就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240214,
					"content": "真、真的吗！太好了！那么请你们务必带上这本书！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240215,
					"content": "哇啊…瞬间变成了使唤人的口气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700240217,
					"content": "理论…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "如果在沟通中遇到什么困难，只需查阅词条就可以解决…至少理论是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240218,
					"content": "所以马斯克小姐自己也不知道自己写的是什么吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700240219,
					"content": "外行才会提这样的问题！科学研究不导入现实中验证，怎么知道是否符合逻辑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240225,
					"content": "哼…算了，反正再说下去你也未必听得懂。不管怎样，这次真的很感谢你们能来相救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 700240221,
					"content": "欢迎加入！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "既然来都来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "接下来你们不介意的话，就让我和你们一同去与丘丘人交涉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "艾拉·马斯克"
				}
			]
		}
	]
}