			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "两个小娃娃干什么呢，你们也是来看我这个「种石头」老头笑话的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040102,
					"content": "我好着呢，用不着村里人费心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040103,
					"content": "呜哇，不用一上来就这么大敌意吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040104,
					"content": "你搞错了，我们不是阿如村的人，也不是来看笑话的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040105,
					"content": "我们只是路过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "路过的人？这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040110,
					"content": "平时只有几个老相识会来我这儿，一个劲叫我放弃这里的苗圃，搬回村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040111,
					"content": "还有几个坏小子，老是跑到我这里来调皮捣蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040112,
					"content": "我倒是第一次见到打扮成你们这样的，两个小娃娃，你们是做什么的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040113,
					"content": "是正在寻亲的旅人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "是啊，为了这个目标，我们走过了很远的路，一路冒险一路寻找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME}{M#他}{F#她}啊，是个很有正义感的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040119,
					"content": "欺负独居老人什么的，这种事我们才不会干呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040120,
					"content": "所以老爷爷，你不用担心啦，我们不是坏人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040121,
					"content": "咳咳，让我给两个小娃娃道歉还真是有点不好意思，谁叫我没看清楚就胡说呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040122,
					"content": "两个小娃娃，老头阿凡给你们道歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040123,
					"content": "你们年纪还这么轻，就自己养活自己了，挺有本事的，比我年轻时候强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040124,
					"content": "照你们刚才那么说，如果我遇上了解决不了的麻烦，是不是也能委托你们帮忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040125,
					"content": "哦？这是有工作要委托我们的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040126,
					"content": "遇到了什么问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "我原本开了两块苗圃，这里是一块，另外一块在村子的西边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040128,
					"content": "也是我年纪大了，之前一个人照看不过来，几天没去看，另外那块苗圃就被黑乎乎的奇怪东西给祸害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040129,
					"content": "危险得很，进去一次我差点就出不来了，吓得我再也不敢往那片地里跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040130,
					"content": "我现在最大的希望就是把苗圃的地治好，方便以后再种上花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040131,
					"content": "#听起来不太复杂。怎么样？{NICKNAME}，我们要不要接受这个委托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040132,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "那块苗圃在村子西边，你们可别走错路啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040134,
					"content": "小意思，你就放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040116,
					"content": "是探索世界的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "是啊，我们翻越了好多好多座高山，跨越了好大好大的水泊，来到了须弥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040118,
					"content": "那个话怎么说来着，我们是…嗯…心胸宽广的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040107,
					"content": "听说这里有人在种花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "没错，我种的是花，可不是什么烂石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040109,
					"content": "我刚才还以为…哎哟，叫我说什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "你们两个回来了？那块苗圃的状态怎么样，你们觉得它有救不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040402,
					"content": "已经解决了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "将死域的事解释给阿凡听。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "原来是这么回事，我就说好端端的地里怎么会突然冒出这么多黑乎乎的怪东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040405,
					"content": "好好好，这下我可以安心把种子种上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040406,
					"content": "等这三颗种子发芽开花结新种子，再往那块地里种，以后这花就能开得到处都是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040407,
					"content": "欸，这些…形状奇怪的石头吗？它们能长出花来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040408,
					"content": "阿凡爷爷，你这是在哪里买来的呀，别被人骗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040409,
					"content": "这个小娃娃心地还挺好，你们放心，摩拉可买不到这些花种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040410,
					"content": "这三颗都是鬼…咳咳…一个朋友留给我的珍贵种子，当然跟普通的果子啊花苗啊不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040411,
					"content": "越听越奇怪呢，阿凡爷爷，你种的到底是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040412,
					"content": "呵呵，我种的是一个朋友的嘱托，是他的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040413,
					"content": "好奇怪的说法，这种东西是可以种的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040414,
					"content": "小娃娃，跟你说了你也不会明白的，以后有机会再来看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040415,
					"content": "别看这里现在空荡荡的，将来这片苗圃里的三颗种子都会发芽开花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040416,
					"content": "以后它们会越长越多的，哈哈，那时候一定很漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040417,
					"content": "好了好了，说好了委托你们帮忙，报酬我是不会赖着不给的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040418,
					"content": "你们俩拿着吧，我能给的也不多，都在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040419,
					"content": "呼，委托完成，跑了这半天感觉肚子有点饿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040420,
					"content": "明明都是我在跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "我也有一路陪你说话嘛，说话也是会消耗能量的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040422,
					"content": "#别那么小气啦，{NICKNAME}，我们拿上酬金去买点好吃的犒劳自己一下，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040423,
					"content": "快看看报酬有多少，够我们吃几顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040424,
					"content": "我看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "欸，比起摩拉，更多的是食物…烤肉卷、米圆塔，还有好多蔬菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040426,
					"content": "这也太多了。我们…是不是拿了阿凡爷爷一天的口粮啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040427,
					"content": "这个阿凡爷爷一个人住在村子外面，应该也挺不容易的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040428,
					"content": "摩拉就算了，把口粮都给我们的话，唔…感觉有点沉重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040429,
					"content": "而且，他明明种着石头一样的种子，却说自己种的是…愿望？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040430,
					"content": "你说，他会不会是一个人住了太久，产生了幻觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040431,
					"content": "越想越觉得不放心，我们有空的时候就去看看他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
