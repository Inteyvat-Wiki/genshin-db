			},
			"dialogs": [
				{
					"id": 3960001,
					"content": "袭击你们的人…是「愚人众」？真过分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960002
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960002,
					"content": "琴团长刚才回骑士团总部了，说是要想办法找出证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960003
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960003,
					"content": "但如果他们没有留下痕迹，骑士团可能也很难对他们提出指控吧…琴团长是这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
		{
			"id": 39602,
			"completionStepIds": [
				39602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39602",
							"2"
						],
						"stepId": 39602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "这位就是教会方面负责回收天空之琴的专员，祈礼牧师芭芭拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960202,
					"content": "愿风神护佑你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960203,
					"content": "虽然比起代理团长，我可能没资格说这话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960204,
					"content": "但，我还是要替蒙德感谢各位的努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960205,
					"content": "幸亏是和平解决！如果真的调动军力与龙开战，很难想象要怎样收场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960206,
					"content": "而且，「愚人众」那边也不能多说什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960207,
					"content": "事情变成这样，他们一定在暗中气恼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960208,
					"content": "这一次，他们失去了向西风骑士团施压的最佳借口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960209,
					"content": "只印证了至冬国使臣蛮横无理的形象，却没有得到实际的外交进展呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960210,
					"content": "好啦，所以你们把天空之琴带来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960211,
					"content": "代理团长的担保也不是无限的，枢机大人已经催了一阵子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960212,
					"content": "倒…倒是带来了，只不过…嗯…这个…稍微有点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960213,
					"content": "嗯？放心，不会收你们租金的，教会一直有专门的供奉拨款…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
