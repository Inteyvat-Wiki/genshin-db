			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960501,
					"content": "呀！荣誉骑士，你醒啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960502,
						3960505
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960502,
					"content": "温迪…他没事吧？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960503
					]
				},
				{
					"id": 3960503,
					"content": "唔…他的状态，说不上是「没事」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960504
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960504,
					"content": "刚才我发现你们晕倒在教堂外，就用元素力为你们治疗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960510,
					"content": "那位诗人是先醒的，但奇怪的是，我的治疗对他的伤几乎没有效果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960511
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960511,
					"content": "这种病人，我还是第一次遇见。他自己却说着「这很正常」之类的话，想要离开教堂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960512
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960512,
					"content": "离开？他去了哪里啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960513,
					"content": "<color=#00E1FFFF>「蒙德英雄的象征」</color>…他是这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960514
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960514,
					"content": "我想阻止他，但琴…琴团长却说，「让他去吧」。好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960515,
						3960516
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960515,
					"content": "（我大概明白为什么了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960517,
					"content": "我记得以前，温迪也在<color=#00E1FFFF>那棵树</color>下疗过伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960518,
					"content": "（是因为风神和风起地之间的联系吧，琴团长应该也猜到了，但不能和芭芭拉说呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960516,
					"content": "（琴大概也明白为什么了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960505,
					"content": "这是…哪个星球…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960506
					]
				},
				{
					"id": 3960506,
					"content": "星球？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960507
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960507,
					"content": "#啊！芭芭拉小姐不要听{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说胡话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960508,
					"content": "咦？嗯…好的，总之，刚才我发现你们晕倒在教堂外，就用元素力为你们治疗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960509
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960509,
					"content": "看来她应该多给你浇点水，帮你激活一下脑子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 39606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39604",
							"2"
						],
						"stepId": 39604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960601,
					"content": "树间的风很好，有我喜欢的气味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960602
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960602,
					"content": "哈哈，上次我也是这么说的呢。唉，为什么每次说这句话，都是在运气不顺的时候呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960603
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960603,
					"content": "所以…什么是「神之心」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960604
					]
				},
				{
					"id": 3960604,
					"content": "…你注意到了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960605
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960605,
					"content": "唉…这本来不是能和普通人谈论的话题。但，悄悄告诉你也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960606
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960606,
					"content": "你应该知道，「神之眼」是这世上极少数人才拥有的外置魔力器官。他们通过「神之眼」来引导元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960607
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960607,
					"content": "其实，每一位「神之眼」的拥有者，都是有资格成神的人，因此被称作「原神」，拥有登上天空岛的资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960608
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960608,
					"content": "「原神」？以前好像从来没听过这个词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960609,
					"content": "哼哼，因为这是真正神灵才知道的秘密呀。总之，我们是不需要「神之眼」这种初级器官的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960610
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960610,
					"content": "作为替代，神灵的魔力器官与天空岛共鸣相连…也就是「神之心」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960611
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960611,
					"content": "那你腰上挂的这个是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960612
					]
				},
				{
					"id": 3960612,
					"content": "欸嘿。只是发光的玻璃球而已，用来避免无谓的猜疑啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960613,
						3960614
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960613,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				},
				{
					"id": 3960615,
					"content": "那么，刚才那个见面就把我吹飞、还抢走温迪「神之心」的坏女人，到底是谁…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960616,
					"content": "她是「女士」——愚人众十一执行官的第八席，代号「女士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960617
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960617,
					"content": "愚人众的每一位执行官，都像她一样，被至冬国的女皇赐予了神灵般的权柄，获得超越了凡人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960618
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960618,
					"content": "至冬国的…女皇？那不就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960619,
					"content": "嗯，七神之一，端坐于至冬宫的「冰之女皇」，全体愚人众执行官的唯一效忠对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960620
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960620,
					"content": "虽然七神之间的关系，并不全都非常融洽，但我也没想到，她居然正在谋夺其他神灵的「神之心」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960621
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960621,
					"content": "冰之女皇是怎样的神？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960622
					]
				},
				{
					"id": 3960622,
					"content": "啊…该怎么说呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960623
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960623,
					"content": "我认识「五百年前的她」，但对「现在的她」已经很陌生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960624
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960624,
					"content": "五百年前的一场大灾之后，她就断绝了和我的一切交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960625
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960625,
					"content": "不过，有关冰之神和愚人众的事，还是过一会再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960626
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960626,
					"content": "#{NICKNAME}，你要寻找全部七神，旅途中恐怕还有许多艰难之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960627
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960627,
					"content": "先往蒙德的邻国去吧——那里的「岩」之神与我不同，亲自治理着「璃月」全境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960628
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960628,
					"content": "他每年只会正式降临一次，赐下神谕，指引这一年里经营璃月的方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960629
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960629,
					"content": "即使是这样，听起来工作频率也比某位大人高多了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960630,
					"content": "欸嘿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960631
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960631,
					"content": "…总之，今年的「请仙典仪」好像就快开始了。嗯，错过的话，就要再等一整年咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960632
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960632,
					"content": "#哇？！这么重要的信息怎么不早说？那就再见了，{NICKNAME}，我们快走——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960633,
					"content": "等一等，「捕风的异乡人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960634,
						3960636
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960634,
					"content": "是在叫我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960635
					]
				},
				{
					"id": 3960635,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960638,
					"content": "旅行者…当你重新踏上旅途之后，一定要记得旅途本身的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960639
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960639,
					"content": "提瓦特的飞鸟、诗歌和城邦，女皇、愚人和怪物…都是你旅途的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960640
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960640,
					"content": "终点并不意味着一切。在抵达终点之前，用你的眼睛，多多观察这个世界吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960641,
						3960642
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960641,
					"content": "温迪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960643,
					"content": "嗯！风神的告诫到此为止！接下来是温迪时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960642,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960636,
					"content": "不好意思，擅自借用了七天神像的风…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960637
					]
				},
				{
					"id": 3960637,
					"content": "哈哈，心怀感激地用吧——能请我一杯蒲公英酒就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960614,
					"content": "又欺骗感情，但我已经习惯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				}
			]
		},
		{
			"id": 39608,
			"completionStepIds": [
				39604
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "想多聊些什么的话，就趁现在聊吧。因为吟游诗人，可不会总在一个地方驻唱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960702,
					"content": "关于特瓦林…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "特瓦林…到最后也还记得「四风守护」的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960704,
					"content": "所以，我也并不打算强行卸下他身上的责任、把我理解的「自由」强塞给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960705,
					"content": "——而是希望，特瓦林能自己选择、自己理解，何为自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960706,
					"content": "因为我在成神之前，也是这样被一个朋友…教导了「何为自由」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960707,
					"content": "关于深渊教团…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "嗯？你说凯亚的情报…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960709,
					"content": "#…原来如此，深渊教团里有一位「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」，主导了腐化特瓦林的计划？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960710,
					"content": "#看来是想把特瓦林改造成深渊的战争兵器吧。话说回来，我可从没听说过，深渊教团里有什么「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960711,
					"content": "看来那不是教团的古老传承。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960714,
					"content": "#但最近才出现的「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」，又为什么能走上统领深渊教团的位置呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960712,
					"content": "看来是最近才出现的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "关于「女士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "刚才的愚人众执行官，抢走「神之心」以后，马上就离开了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960717,
					"content": "这是为了避免出现「骑士团的目击证人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960718,
					"content": "毕竟这种事要是留下把柄，就等于公开毁灭与西风骑士团的外交关系了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960719,
					"content": "做出这种事来，却还好意思继续当蒙德的盟友吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960720,
					"content": "唉…面对深渊教团的威胁，人类的七国本该结成联盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960721,
					"content": "「愚人众」拥有七国最强的武力，却用来盗窃天空之琴、觊觎神力、借龙灾对骑士团施压…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960722,
					"content": "啊，说到「天空之琴」…那时，好像听迪卢克提过这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960723,
					"content": "他说，「愚人众」能够横行七国、威胁西风骑士团，完全是由于这十一位执行官的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960724,
					"content": "是的，就像我刚才说的，他们被冰之神赐予了权柄，获得了超越凡人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960725,
					"content": "「冰之女皇」…五百年没见了，她究竟在想什么呢？又在计划着什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960726,
					"content": "这件事的答案，或许也会对你寻找七神的旅途，产生未知的影响吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960727,
					"content": "关于神灵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "刚才说过，「神之眼」的拥有者，被世界称作「原神」，拥有登上天空岛的资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960729,
					"content": "「神之心」是更高位的元素控制中枢，是七神之座的象征。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960730,
					"content": "#对不起，我不知道是七神中的哪一位，带走了你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960731,
					"content": "呀，话说回来，身为七神之一，我自己的嫌疑都还没洗清…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960732,
					"content": "你长得和那个神一点都不像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "可是，「卖唱的」只是化身形象，不能作为判断依据——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960734,
					"content": "相处这么久，不用继续怀疑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#啊哈哈，我们确实是很好的搭档呢。等你找回{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}，有没有兴趣来当新的「四风守护」啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960736,
					"content": "也许…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#嗯？{NICKNAME}，你好像不太热衷的样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960738,
					"content": "那么卖唱的！如果当了「四风守护」就有民众供奉好吃的话，不如考虑一下…我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960739,
					"content": "哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3960741,
					"content": "没别的事了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "那么，就往<color=#00E1FFFF>璃月</color>去吧。错过今年的「请仙典仪」的话，就要再等一整年咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		}
	]
}