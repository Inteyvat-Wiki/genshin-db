					"nextDialogs": [
						710440716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440716,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440717,
						710440718
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440717,
					"content": "就先不追究你的渎职了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440719
					]
				},
				{
					"id": 710440719,
					"content": "好、好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440718,
					"content": "我们先去解除阵法吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440719
					]
				},
				{
					"id": 710440705,
					"content": "甚至有盗宝团！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440706
					]
				},
				{
					"id": 710440706,
					"content": "他们也奇怪为什么没人看守呢！",
