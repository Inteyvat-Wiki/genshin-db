	"talks": [
		{
			"id": 7104406,
			"completionStepIds": [
				7104406
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104406",
							"2"
						],
						"stepId": 7104406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710440601,
					"content": "原来还有讲我们的评书呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440602,
					"content": "那是当然，在城里可流行呢！我吧，觉得茶博士和田铁嘴他们各有各的特点，只是我更喜欢田…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440603,
						710440604
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440603,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440605
					]
				},
				{
					"id": 710440605,
					"content": "哈哈，我明白的，我明白的，不是每个人都能接受田铁嘴的风格，我有时候也觉得他说书的用词造句有点太俗俚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440606
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440606,
					"content": "但是茶博士说书呢，他慢热，你明白吧？有时候一个故事捂上两个时辰才觉出味道来，有人喜欢这个，我是觉得没意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440607
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440607,
					"content": "你说这幸好是故事，不怕会变质对吧？这要是什么吃的喝的，裹个包袱捂半天不给抖开，那不是早就臭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440608,
						710440611
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440608,
					"content": "咳咳…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440609
					]
				},
				{
					"id": 710440609,
					"content": "你没事吧，嗓子不舒服吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440610
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440610,
					"content": "唔，也没有啦…就是突然接受了太多信息，脑子有点不舒服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440613,
					"content": "啊…这样啊，不好意思。实在有点太兴奋了，自顾自说了好多，也没有顾及你们的感受，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440614
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440614,
					"content": "#不过{NICKNAME}这次来到这里，是受七星的委托吗？沐宁有没有向你们透露别的什么信息？嗯，比如说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440615
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440615,
					"content": "「千万不要接近『磐键』！」「层岩巨渊下面什么也没有！」「志琼这个人不会帮你们的！」这种话？而且反复强调？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440616
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440616,
					"content": "沐宁确实有这样说过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440617
					]
				},
				{
					"id": 710440617,
					"content": "哼哼，他可吓不住我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440618,
					"content": "嘿嘿，他没有在吓唬你们啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440619
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440619,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440620,
						710440621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440620,
					"content": "所以他说的都是真的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440622
					]
				},
				{
					"id": 710440622,
					"content": "咳咳，是这样的。沐宁毕竟是总务司的专员，即使想要请求帮助，也是有很多事情不方便在公开场合透露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440623
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440623,
					"content": "所以呢，就只能用「警告」这种方法，变相地把进入层岩巨渊的方式告诉你。他说的「你不应该」，理解成「你可以」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440624
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440624,
					"content": "哼…真是个别扭的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440625,
					"content": "况且你也提到，他给你开了许可字条，让你来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440626
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440626,
					"content": "你手上的字条，就意味着在层岩巨渊畅通无阻的权利。当然啦，前提是七星不会亲自干涉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440627
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440627,
					"content": "而他建议你来找我呢，就意味着让我告诉你进入层岩巨渊深处的方法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440628
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440628,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440629,
						710440630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440629,
					"content": "沐宁这家伙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440631
					]
				},
				{
					"id": 710440631,
					"content": "哈哈，事先如此遮遮掩掩真是不好意思，不过我们是有充分理由的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440632
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440632,
					"content": "层岩巨渊下面挖到的那个「东西」实在非比寻常，调查活动不可大操大办，否则会令群众恐慌…这是七星的指令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440633
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440633,
					"content": "所以我们就只能在禁入令的掩护下，秘密招募探险家和学者进入层岩巨渊进行调查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440634
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440634,
					"content": "如有必要的话，或许可以做点什么，缓解地下蠢蠢欲动的危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440635
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440635,
					"content": "所以营地里那些人都是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440636
					]
				},
				{
					"id": 710440636,
					"content": "没错，他们都是来辅助勘探队工作的。都是些可靠的前辈…大部分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440637
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440637,
					"content": "你之所以来到这里也绝非偶然，七星里不止一位大人物已经指名推荐你前来帮忙了，我们没有不从命的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440638
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440638,
					"content": "况且，两位前辈比较容易以利诱之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440639
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440639,
					"content": "欸…那不就是说我们好骗吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440640,
						710440642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440640,
					"content": "派蒙，我们走！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440641
					]
				},
				{
					"id": 710440641,
					"content": "哼，别想把我们当笨蛋耍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440644,
					"content": "请留步呀！我只是转述大人的话而已！是她这样说的，不是我！我这就收回那句话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440645,
						710440646
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440645,
					"content": "告辞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440647
					]
				},
				{
					"id": 710440647,
					"content": "请两位想想七星的酬谢，一定不会少的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440648,
						710440650
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440648,
					"content": "我又不缺摩拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440649
					]
				},
				{
					"id": 710440649,
					"content": "我也…！唔…我倒是不嫌摩拉多啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440652,
					"content": "咳咳…如果能够以任何措施缓解层岩巨渊的安全风险，在地下寻到的财物与宝藏便可全归发现者所有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440653
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440653,
					"content": "这是七星的大人们议定的特别许可权，只限此时，只限此地，只限两位前辈享有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440654
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440654,
					"content": "哇！真的吗！你可不要骗我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440655,
						710440657
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440655,
					"content": "既然如此…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440656
					]
				},
				{
					"id": 710440656,
					"content": "有宝藏哦，有宝藏哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440659
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440659,
					"content": "哈哈，好啦好啦…所以说，前辈会接受这个委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440660,
						710440663
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440660,
					"content": "好吧…看在宝藏的面子上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440661
					]
				},
				{
					"id": 710440661,
					"content": "好耶！新的宝藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440662
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440662,
					"content": "好耶！新的冒险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440665
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440665,
					"content": "实在不好意思，耽搁了两位前辈这么多时间，闲扯了些没用的东西…我们这就开始张罗正事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440666
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440666,
					"content": "如果想要进入层岩巨渊，我们首先需要找到「流明石」制成的触媒，有这个东西才能在下面的黑暗中行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440667
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440667,
					"content": "只有「神之眼」持有者才能妥善利用触媒，不过前辈即使没有神之眼也能够将元素力驱动自如，使用触媒大概也没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440668
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440668,
					"content": "我们要去哪里寻找触媒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440669
					]
				},
				{
					"id": 710440669,
					"content": "就放在南边的仓库里，仓库看守完备，很安全的。取回来以后找我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440663,
					"content": "好吧…看在派蒙的面子上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440664
					]
				},
				{
					"id": 710440664,
					"content": "哼哼，我的面子还挺大的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440665
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440657,
					"content": "又是派蒙的「哇宝藏！」时间…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440658
					]
				},
				{
					"id": 710440658,
					"content": "你看嘛…毕竟层岩巨渊这么大…有多少宝藏给我们随便拿呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440659
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440650,
					"content": "没有再贴一次寻人启事的必要了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440651
					]
				},
				{
					"id": 710440651,
					"content": "那你要求些别的不就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440646,
					"content": "哼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440647
					]
				},
				{
					"id": 710440642,
					"content": "这样啊，再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440643
					]
				},
				{
					"id": 710440643,
					"content": "欸…？不问问他们会拿什么利来诱我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440630,
					"content": "这也太弯弯绕绕了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440631
					]
				},
				{
					"id": 710440621,
					"content": "所以他想说的是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440622
					]
				},
				{
					"id": 710440611,
					"content": "我是说…对评书不感兴趣，抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440612
					]
				},
				{
					"id": 710440612,
					"content": "唔…你说这些我们也不懂呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440604,
					"content": "唔…我不是很懂评书…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440605
					]
				}
			]
		},
