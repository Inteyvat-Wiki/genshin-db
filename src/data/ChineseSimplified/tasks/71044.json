			"dialogs": [
				{
					"id": 710442001,
					"content": "要是真明白了我的话，就请不要在这里晃来晃去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442002
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442002,
					"content": "否则…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442003
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442003,
					"content": "否则…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442004
					]
				},
				{
					"id": 710442004,
					"content": "唉，没什么否则的。我能做的，最多就是写写周报罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442005
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442005,
					"content": "周报？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442006
					]
				},
				{
					"id": 710442006,
					"content": "一些麻烦、没什么意义，但是又不得不写的文书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442007
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442007,
					"content": "那就不写？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442008
					]
				},
				{
					"id": 710442008,
					"content": "那可不行，至少像是你出现在这里的消息，总是要写进去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442009
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442009,
					"content": "上次提交报告是昨天，也就是说，再过不了几天，总务司的人就会知道你在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442010
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442010,
					"content": "到时候，说不定就会有人过来，强行把你带出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442011
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442011,
					"content": "所以呢，在那之前，你还可以自由行动，明白了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710442012
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710442012,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710442013
					]
				},
				{
					"id": 710442013,
					"content": "明白了就好…哼，如果不是看在你为璃月立过大功的面子上…算了算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐宁"
				}
			]
		}
	]
