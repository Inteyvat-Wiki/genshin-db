			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710441701,
					"content": "请暂时不要和我说话，不然我又会受处分的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441702
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441702,
					"content": "「又」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441703
					]
				},
				{
					"id": 710441703,
					"content": "不要在意那种小事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				}
			]
		},
		{
			"id": 7104418,
			"completionStepIds": [
				7104426
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104426",
							"2"
						],
						"stepId": 7104426,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710441801,
					"content": "好厉害…不愧是前辈！这应该就是最后一座了，封锁层岩巨渊的阵法应该已经失效了。我们随时可以下去探索啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441802
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441802,
					"content": "唔…不过在那之前，还是要先跟沐宁打声招呼才行…哼，那家伙又要摆臭脸教训我们咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				}
			]
		},
		{
			"id": 7104419,
			"completionStepIds": [
				7104429
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104429",
							"2"
						],
						"stepId": 7104429,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐宁",
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710441901,
					"content": "瞧我说什么来着！你果然没有老老实实看守仓库！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441902
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710441902,
					"content": "这下事情闹大了，你想怎么收场呀，志琼？你能负得了擅自解除阵法的责任吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441903
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710441903,
					"content": "啊，你来了。唉…擅自破坏「磐键」的事情，你怎么解释？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441904,
						710441905
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710441904,
					"content": "美观起见，这里拆掉柱子顺眼多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441906
					]
				},
				{
					"id": 710441906,
					"content": "你…！哼，先说好责任由你自负，剩下的等七星怪罪下来再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441907
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710441907,
					"content": "嘿嘿，没关系的。沐宁这人就是这样，只会对那些不管事的人发脾气…别看他性子急，人还是不坏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441908
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441908,
					"content": "不用管他的臭脾气。等你准备好，我就叫上大家一同随你下矿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441918
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441918,
					"content": "我们这次的目的，是进入层岩巨渊的最深层，测绘地图，以及…嗯，调查层岩巨渊异变的源头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441909
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441909,
					"content": "啊！抱歉，差点忘了…欢迎加入层岩巨渊勘探队！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441910
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441910,
					"content": "请容我浪费一点时间，介绍一下勘探队的成员吧：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441911
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441911,
					"content": "首先是海迪夫，从须弥来的特约学者。主要研究方向是矿产和生物学。他是勘探队的主要负责人…嗯，我是说科学和财政方面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441912
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441912,
					"content": "然后，是瑾武姐，她是我们的安全技术员。负责设备修理和维护，我们的安全由她来保障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441913
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441913,
					"content": "还有…呃，塔列辛。是蒙德来的吟游诗人…不知为什么坚持要和我们一同下矿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441914
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441914,
					"content": "或许在下矿以后，我们还会遇见意料之外的新伙伴吧？哈哈，谁知道呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441915
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441915,
					"content": "最后，我呢，是亲力亲为的勘查员！负责为大家探路以及绘制地图！和前辈共勉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441916
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441916,
					"content": "等前辈准备好了，就去矿坑边的起重机那里吧…以前是运货用的，不过吊几个人上下矿也完全不是问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441917
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441917,
					"content": "唔，对哦…既然前辈有「风之翼」，即使不用起重机也可以很方便地下去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441905,
					"content": "如果你真想阻止我，早就赶我走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441918
					]
				}
			]
		},
