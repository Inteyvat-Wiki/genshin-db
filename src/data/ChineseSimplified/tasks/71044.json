					"nextDialogs": [
						710440707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440707,
					"content": "唔…不应该呀。我看守仓库的时候，盗宝团都不敢靠近的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440708
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440708,
					"content": "欸…等等，你说谁看守仓库…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440709,
					"content": "我呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440710
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440710,
					"content": "那你有在看守仓库吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440711
					]
				},
				{
					"id": 710440711,
					"content": "哈哈，哪会有冒险家愿意把时间浪费在那种无聊的事情上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440712
					],
					"speakerTitle": "志琼"
				},
				{
