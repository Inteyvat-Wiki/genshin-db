			},
			"dialogs": [
				{
					"id": 710441301,
					"content": "欸，是你呀！你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441302
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441302,
					"content": "是沐宁介绍我来的，这里是他的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441303
					]
				},
				{
					"id": 710441303,
					"content": "哈哈，别管那纸条啦！我早认出你来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441304
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441304,
					"content": "他呀，天天就喜欢给人摆架子，开条子，什么小事都要走个流程…显得自己是个什么大人物一样。我可不管那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441305
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441305,
					"content": "#毕竟{NICKNAME}的大名早就传遍冒险家协会了；更不用提你为璃月做的一切，我们都看在眼里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441306,
						710441307
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441306,
					"content": "我有这么出名吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441309
					]
				},
				{
					"id": 710441309,
					"content": "那是当然，协会的许多新人冒险家都听霞姐讲过你在龙脊雪山的探险故事——嘿嘿，也包括我在内啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441310
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441310,
					"content": "穿越雪暴在寒冬极境之中开辟通路，在冰霜之下发掘被遗忘的古王国，登上险峻峰顶，以肉体凡躯直面宏伟无情的异变…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441311
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441311,
					"content": "#真的，{NICKNAME}前辈经历的事件也好，克服的障碍也好，发掘的真相也好，终归一句话…这才叫冒险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441312,
						710441314
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441312,
					"content": "说得好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441313
					]
				},
				{
					"id": 710441313,
					"content": "哇…我都有点晕头转向了…我们真的有那么厉害来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710441316,
					"content": "哈哈，更不用说两位在群玉阁上大战海魔的事迹…虽然我没有现场目睹，但评书我可一场都没落下过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710441314,
					"content": "请给我指北针。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441315
					]
				},
				{
					"id": 710441315,
					"content": "喂，你也太不经夸了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710441307,
					"content": "不愧是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710441308
					]
				},
				{
					"id": 710441308,
					"content": "#不愧是传说中的{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710441309
					],
					"speakerTitle": "派蒙"
				}
			]
		},
