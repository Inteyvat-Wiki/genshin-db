			"dialogs": [
				{
					"id": 710440801,
					"content": "原来这样就能轻易破坏…呃，解除掉「磐键」的约束了！信任前辈果然没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440802,
						710440803
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440802,
					"content": "这属于破坏公共财产吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440804
					]
				},
				{
					"id": 710440804,
					"content": "没关系的，沐宁已经事先报损了。所以这些「磐键」，其实在我们来之前就已经「损坏」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440805
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440805,
					"content": "接下来还有四处「磐键」需要处理…啊，我画了一张简图，标出了其中三处的位置，希望能帮到你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440806
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440806,
					"content": "至于另外一处…唔，现在我也很难分辨位置了。矿工撤离后，那座矿洞发生过一次渗漏事故，柱体被淹没在了水下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440807
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440807,
					"content": "等你解除其余三处，再回来找我吧，最后一处我们再一起想想办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440808
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440808,
					"content": "你不一起来吗?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440809
					]
				},
				{
					"id": 710440809,
					"content": "这次还是不了…本来被委托了看守仓库的工作，结果一时疏忽，差点让盗宝团趁虚而入…我已经要感谢前辈不上报之恩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440810
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440810,
					"content": "万一再被沐宁那家伙抓住开小差的话可就不得了啦，至少这段时间我得回去看守仓库才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440811
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440811,
					"content": "不过我相信，这点问题即使靠两位前辈也是能解决的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440803,
					"content": "「七星」不会追究吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440804
					]
				}
			]
		},
		{
			"id": 7104409,
			"completionStepIds": [
				7104421
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104421",
							"2"
						],
						"stepId": 7104421,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志琼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710440901,
					"content": "我们回来啦！三处「磐键」全都破坏掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440902,
					"content": "嘘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440903
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440903,
					"content": "……？突然怎么了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440904,
						710440905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440904,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440907
					]
				},
				{
					"id": 710440907,
					"content": "不要大惊小怪的…！没什么…只是大地在震动。或许是因为封印松动，附近的山岩也开始变得不稳定了…你有感觉到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440908
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440908,
					"content": "完全没有欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440909,
						710440911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440909,
					"content": "你一直飞着，当然感觉不到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440910
					]
				},
				{
					"id": 710440910,
					"content": "你说得很有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440912,
					"content": "矿工的直觉而已…如果你从小在矿上长大，也会对山石的语言略通一二的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440913
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440913,
					"content": "等等…小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440914
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440914,
					"content": "哇呀！地面震动得好厉害！站都站不稳了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440915,
						710440916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440915,
					"content": "你本来也没有在站着！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440917
					]
				},
				{
					"id": 710440917,
					"content": "呜哇…！欸…地震…停下来了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710440918,
					"content": "呼…应该是结束了。幸好我们都在地面上，如果是在矿道里遇到这样的地震可就惨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440919
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440919,
					"content": "希望沐宁他们别把地震怪到我们头上...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440920
					],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440920,
					"content": "现在封印阵法的力量已经大大减弱，只剩最后一处「磐键」需要解决了。我们一起去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志琼"
				},
				{
					"id": 710440916,
					"content": "怎会如此！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440917
					]
				},
				{
					"id": 710440911,
					"content": "我也没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440912
					]
				},
				{
					"id": 710440905,
					"content": "附近有敌人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710440906
					]
				},
				{
					"id": 710440906,
					"content": "欸？敌人？！在哪里呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710440907
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7104413,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
