			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提佐科"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960201,
					"content": "「山王火榴」终于成熟了，真是让人松了口气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960202
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960202,
					"content": "咦，是你啊，怎么了，如果要进去的话就速去速回，别被部族的人发现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960203,
						750960208,
						750960212
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960203,
					"content": "关于「山王」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960204
					]
				},
				{
					"id": 750960204,
					"content": "哦，是想问关于「山王」的事吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960205
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960205,
					"content": "「山王」康加玛托，是从前与英杰一起对抗深渊的了不起的龙，部族里的所有人都很尊敬它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960206
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960206,
					"content": "「山王火榴」其实也会有专人采摘献给它食用。不过也有说法，其他的匿叶龙也会偷偷给「山王」大人喂吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960207
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960207,
					"content": "所以「山王」大人才会比别的匿叶龙…呃，健硕那么多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960208,
					"content": "关于火榴果…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960209
					]
				},
				{
					"id": 750960209,
					"content": "这你就问对人啦，火榴果是很了不起的燃素植物，哎，能够把自己的根系伸入液态燃素，对于植物来说很有勇气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960210
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960210,
					"content": "而且，结出来的果子里也满含燃素，多吃吃对匿叶龙也有好处…只要它们别扔出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960211
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960211,
					"content": "毕竟剧烈碰撞，火榴果就会爆裂开来嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960212,
					"content": "只是路过啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960213
					]
				},
				{
					"id": 750960213,
					"content": "是嘛…真的不进去看一眼「山王火榴」吗？多看看「山王火榴」，就觉得心情也变好了…如果觉得烦恼，一定得来看看哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提佐科"
				}
			]
		}
	]
}