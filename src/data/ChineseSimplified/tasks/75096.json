			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"波卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960101,
					"content": "你们回来啦，还去得挺久的呢，怎么样，有遇到什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960102
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960102,
					"content": "那我们在下面可做了很多事了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750960103,
					"content": "向波卡说了发生在火榴树根系的事…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750960104
					]
				},
				{
					"id": 750960104,
					"content": "真的被这家伙解决了…好，这下能向瓦伊纳大哥报告，就不用拉下脸去找烟谜主或者沃陆之邦的人啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960105
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960105,
					"content": "我就说他能做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960106
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960106,
					"content": "咦，原来你们的瓦伊纳大哥居然早就知道火榴树根系有问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750960107,
					"content": "那是当然的，火榴大母树的状况大家当然都知道，只有提佐科这家伙觉得大家没有发觉，还死脑筋地想要自己解决问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960108
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960108,
					"content": "虽然脑子转不过弯来，不过我就觉得就是这家伙这点很讨人喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960109
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960109,
					"content": "#这次也多谢你们啦，哈哈，{NICKNAME}和派蒙，你们的名字我其实早就知道了，毕竟讯使是靠信息吃饭的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960110
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960110,
					"content": "所以就稍微顺水推舟了一把…在你们会出现在的地方放了通行证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960111
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960111,
					"content": "好啊，原来都是你安排的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750960112,
					"content": "哈哈，好，估计那个死脑筋也给了你们一份酬劳，我可不能给的比他少，来，这些给你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960113
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960113,
					"content": "就看在报酬的份上，两位，就大人不记小人过吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "波卡"
				}
			]
		},
		{
			"id": 7509602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
