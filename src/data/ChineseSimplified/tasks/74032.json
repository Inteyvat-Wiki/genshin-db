				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "那些黄绿黄绿的石头…肯定大有问题，我要命丧于此了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320202,
					"content": "呃…你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320203,
					"content": "我…从长远来看，我们都会没事的。只是我要先各位一步没事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320204,
					"content": "没事就好，再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "不不不，怎么听都不是真的没事的意思吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320208,
					"content": "不，我真的没事。如果有事，那一定也为时已晚了，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320209,
					"content": "所以到底是有事还是没事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "我都被绕晕了，能不能说明白点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320211,
					"content": "明白点说，我这阵子一来生产区就头痛欲裂，手脚发凉，还不时有心悸的症状…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320212,
					"content": "我肯定是要完蛋了！你们懂吗，要完蛋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320213,
					"content": "一定是那些黄绿色石头…那是很邪恶的石头！你们肯定知道吧，枫丹科学院的中央实验室…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320214,
					"content": "都怪那些黄绿色石头，把一切都毁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320215,
					"content": "去看看医生吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "我自己就是医生我当然知道！哦不，我现在已经不是医生了…我已经没资格了，不能下诊断了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320218,
					"content": "求求你们，去找真正的医生，有资格的医生，救救我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320219,
					"content": "#唔，感觉他真的病得不轻…{NICKNAME}，我们去找医生问问看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320216,
					"content": "要不去医务室休息一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "感觉你在用什么很新的修辞手法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "听着一点也不像没事的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
