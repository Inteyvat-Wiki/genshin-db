			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿德纳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "遇到麻烦了吗？还是其他人有麻烦？看你们俩都面色红润，应该是其他人有麻烦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320302,
					"content": "确实是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320303,
					"content": "说明了勒克莱德的情况…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "又是他啊…老毛病了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320305,
					"content": "那还有得治吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "你是指头痛，还是妄想症？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320307,
					"content": "欸？所以说，他是根本没什么大病？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320308,
					"content": "从之前检查的结果来看，多半是没有吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320309,
					"content": "听说他过去在外边的时候曾经误诊，忽略了早期征兆，导致患者…唉，总之，或许自那之后他就有些神经过敏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320310,
					"content": "对别人是这样，对他自己更是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320311,
					"content": "那黄绿色石头没问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "你看除了他之外，其他人不都活蹦乱跳的么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320313,
					"content": "话虽如此，也不能放着不管。你们把这个带给他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320314,
					"content": "这个…这不是「纯洁之水」吗？真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320315,
					"content": "哦，你们也知道这个啊。没关系的，至少对身体没害处，还能让他打起精神来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320316,
					"content": "那他不知道吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "据我所知，他对这些饮料都是敬而远之，之前也给他捎过…以对健康有益的药剂的名义，他喝完之后确实恢复了活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320322,
					"content": "好吧，那我们就先把这个带给他。如果还是不行的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320323,
					"content": "那就让他去医务室躺下吧。就说是医嘱，他会听的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320324,
					"content": "#好哦，那我们回去找他吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320318,
					"content": "那不如喝枫达。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "这就是问题所在，这里没人不知道枫达的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320320,
					"content": "但据我所知，他没试过「纯洁之水」，毕竟流通的范围相当有限…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "阿德纳"
				},
				{
					"id": 740320321,
					"content": "之前也给他捎过…以对健康有益的药剂的名义，他喝完之后确实恢复了活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "阿德纳"
				}
			]
		},
		{
			"id": 7403204,
