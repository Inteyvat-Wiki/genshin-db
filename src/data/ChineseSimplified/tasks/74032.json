			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"勒克莱德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320401,
					"content": "我们回来了，医生让我们把这个交给你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320402,
					"content": "勒克莱德接过「纯洁之水」，一饮而尽。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "我感觉好多了！活力重新回到了我的身体！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320404,
					"content": "这就好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "见效也太快了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320408,
					"content": "阿德纳医生不愧是有资格的医生，药到病除。不像我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320409,
					"content": "那黄绿色的石头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320410,
					"content": "大有问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320411,
					"content": "呃…看来是头痛治好了，但是另一边的问题还是没解决呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740320412,
					"content": "这下我可以继续工作了。谢谢你们，辛苦你们跑这么一趟，这些特许券你们就收下吧，一点小小心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320413,
					"content": "希望你们身体健康！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒克莱德"
				},
				{
					"id": 740320406,
					"content": "我觉得你根本没病…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
				{
					"id": 740320407,
					"content": "病是真的病，药也是真的药！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "勒克莱德"
