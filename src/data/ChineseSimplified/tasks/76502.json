			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"爱诺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#是{NICKNAME}和派蒙呀？怎么啦怎么啦？难道有什么超级厉害的委托，需要本天才机械师出马？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020102,
					"content": "嘿嘿，熟人好说，可以给你们打个八折！只要你们悄悄给我带点零食就行——嘘，千万别让伊涅芙知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020103,
					"content": "我们正在四处参观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "那你们算是来对地方了。我爱诺的工坊里，到处都是闪闪发光的好东西，别的地方绝对见不到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020106,
					"content": "不过，你们走路的时候要小心脚下哦，不要被那些零件绊倒啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020107,
					"content": "这个机器人的样子很奇特呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "哼哼，那当然。它叫做「重拳出击鸭」，本来我想把它做成一个垃圾分类机器人，帮我把那些废铜烂铁都整理好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020110,
					"content": "结果一不小心，我把它造得太结实了，悬臂又特别灵活。于是我灵光一闪，就给它加入了超强的防卫机能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020111,
					"content": "这样一来，要是有哪个不长眼的坏蛋想偷偷溜进我的工坊，它就会把他们全部打扫成「不可回收垃圾」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020112,
					"content": "爱诺的想法还是那么天马行空呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765020113,
					"content": "机会难得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "我、我吗？和「重拳出击鸭」一起？大家平时只对我的发明感兴趣，很少有人想拍我耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020116,
					"content": "不过，如果你们想要记录本天才机械师和无敌小弟的工作日常，也不是不行啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020117,
					"content": "可是…我平时都不怎么给自己拍照的，也不知道要摆什么姿势才帅气啦…万一拍出来不好看怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020118,
					"content": "像平时一样就可以了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "好吧，那就交给你了哦。要把「重拳出击鸭」的威猛也一起拍出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱诺"
				},
				{
					"id": 765020119,
					"content": "我会努力拍下最帅气的一刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "可以为你拍摄画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "它也是爱诺的「小弟」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "顺便寻找拍摄素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
