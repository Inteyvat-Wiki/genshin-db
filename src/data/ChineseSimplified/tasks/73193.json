				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "你能够使用草元素力？难道我碰上神之眼持有者了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930902,
					"content": "好久没见过这样的人了，真让人怀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930903,
					"content": "赛芭小姐，赛芭小姐，这样就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731930904,
					"content": "没错，而且直接使用草元素力的话，它们应该很快就能发芽，我们等等看吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930905,
					"content": "慢慢地，几根细弱的幼芽从土坑里钻了出来。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "展开几片绿叶后，幼芽不再生长。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#发芽了发芽了，我就说嘛，{NICKNAME}什么都能做好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731930908,
					"content": "果然立刻就看到效果了，感谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930909,
					"content": "可惜没有开花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "啊，这是很自然的事，不能着急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930911,
					"content": "植物总要经历发芽、抽枝、结苞、开花这样的生长阶段，你能那么快就让种子发芽，已经很厉害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930912,
					"content": "多给蔷薇点时间，让它们继续汲取些养分再开花吧，这样对它们也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930913,
					"content": "况且今天的事已经让我很感激了，再麻烦两位就太不礼貌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 731930914,
					"content": "以后你们空闲的时候，能来看看它们就很好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				}
			]
		}
	]
}