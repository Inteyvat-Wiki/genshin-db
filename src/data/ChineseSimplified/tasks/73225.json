					"nextDialogs": [
						732250102
					],
					"speakerTitle": "调查"
				},
				{
					"id": 732250102,
					"content": "哇…好乱的脚印…看起来…好可怕…我们还是快点走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250103,
					"content": "放心，这里没什么可怕的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250104
					]
				},
				{
					"id": 732250104,
					"content": "就是因为这样才吓人呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
