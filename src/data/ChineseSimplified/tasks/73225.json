				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奈兰",
					"雷兹吉",
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732250401,
					"content": "呼…呼…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250402
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250402,
					"content": "现在我们可以好好谈谈了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250403
					]
				},
				{
					"id": 732250403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250404
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250404,
					"content": "我不会动手的，我需要你相信我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250405
					]
				},
				{
					"id": 732250405,
					"content": "随便吧，先是阿萨里格，然后又是你…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250406,
					"content": "你冷静一点，我们都被骗了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250407
					]
				},
				{
					"id": 732250407,
					"content": "对呀！你说主母交待你追踪我们，因为我们叛变了…可她同样给了我们相同的任务，要我们来追踪你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250408,
					"content": "我们相信你肯定不会叛变的，所以想着找到你好好谈谈这件事到底是怎么回事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250410
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250410,
					"content": "我没有叛变，我也没有理由背弃部族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250411
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250411,
					"content": "芭别尔主母那边有人证，尤夫腾目睹了你们和北方人的交易，马塞拉也看到你们和北方人在营帐附近活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250412
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250412,
					"content": "怎么可能！芭别尔她也跟我们说…她有人证能证明你叛变了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250413,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250414
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250414,
					"content": "所以，你们叛变的事情，到底是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250415
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250415,
					"content": "唔…我们也不知道呀…你还是听我们说啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250416,
					"content": "假如芭别尔决心要离间你我的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250438
					]
				},
				{
					"id": 732250438,
					"content": "他们会替我说话，还是替主母说话？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250417
					]
				},
				{
					"id": 732250417,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250418
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250418,
					"content": "对呀，婕德！你是更信得过我们，还是他们两个呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250419,
					"content": "派蒙，别吵。这件事是很不对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250420
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250420,
					"content": "呼…你终于把刀收起来了，可别再拿出来啦！看着怪吓人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250421,
					"content": "话别说得太早，小家伙…她的刀，还用得上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250422
					],
					"speakerTitle": "奈兰"
				},
				{
					"id": 732250422,
					"content": "奈兰，雷兹吉！你们怎么来了？这里只需要我一个人就能搞定，你们不必来帮忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250423
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250423,
					"content": "嗯，我看得出来。你干得挺不错，婕德…但你们两个，我们出马才能搞定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250424
					],
					"speakerTitle": "奈兰"
				},
				{
					"id": 732250424,
					"content": "…还有一个小精灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250425
					],
					"speakerTitle": "雷兹吉"
				},
				{
					"id": 732250425,
					"content": "哦，还有个小精灵。我还挺喜欢她的，留着她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250426
					],
					"speakerTitle": "奈兰"
				},
				{
					"id": 732250426,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250427,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250428
					],
					"speakerTitle": "雷兹吉"
				},
				{
					"id": 732250428,
					"content": "…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250429
					],
					"speakerTitle": "雷兹吉"
				},
				{
					"id": 732250429,
					"content": "等等，你们…你们也背叛了塔尼特吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250430
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250430,
					"content": "不，恰恰相反，我们是来处理叛徒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250431
					],
					"speakerTitle": "奈兰"
				},
				{
					"id": 732250431,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250432
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250432,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250433
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250433,
					"content": "这些人是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250434
					]
				},
				{
					"id": 732250434,
					"content": "不重要了，他们曾是很不错的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250435
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250435,
					"content": "奈兰、雷兹吉…我很高兴能和你们成为家人，请原谅我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250436
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250436,
					"content": "嗯，我们开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250437
					],
					"speakerTitle": "雷兹吉"
				},
				{
					"id": 732250437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
		{
			"id": 7322506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322506",
							"2"
						],
						"stepId": 7322506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7322504"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732250601,
					"content": "他们是芭别尔主母派来的…你们有什么想法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250602
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250602,
					"content": "你应该看看这些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7322508,
			"completionStepIds": [
				7322508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322508",
							"2"
						],
						"stepId": 7322508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭别尔",
					"婕德",
					"门达斯",
					"乌格威"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732250801,
					"content": "…是你，婕德。你…你回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250802
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250802,
					"content": "嗯，我们活着回来了。很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250803
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250803,
					"content": "你能活着回来就好…你现在需要休息，来吧，让我好好招待一下你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250804
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250804,
					"content": "我不需要休息，我需要解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250805
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250805,
					"content": "为什么把我骗入北方人的圈套？为什么要派出族人追杀我？你为什么要置我于死地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250806
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250806,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250807
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250807,
					"content": "请冷静，请听我说，婕德…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250808
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250808,
					"content": "你还记得我和你说过什么吗？「永恒绿洲」是塔尼特的希望，它将兴旺我们的家园…你也是因为这个而忠诚于我的，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250809
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250809,
					"content": "如今，「永恒绿洲」的门户已经向塔尼特洞开，我们必须保证它不为外人所知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250810
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250810,
					"content": "我们必须保证，塔尼特部族是绿洲女王最为青睐的子民…只有这样，才能进一步号召起流散沙漠的其他部民，聚集在绿洲周围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250811
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250811,
					"content": "到那时候…你好好想想吧，我们将会借助信仰，重新聚集起流散沙漠的人力与资源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250812
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250812,
					"content": "靠着我们的双手，靠着「绿洲女王」的指引，我们就能在这片沙漠中重建绿洲的国度，摆脱向那些城里人低头的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250813
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250813,
					"content": "我们能建立起自己的宫殿，发展起自己的学问，甚至能与那个温室牢笼中的神分庭抗礼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250814
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250814,
					"content": "我们曾经谈过这些，难道你都当做耳旁风了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250815
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250815,
					"content": "我说过，那是不可能的！绿洲女王早就逝去了！她根本不在绿洲！我们是不可能复活她的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250816
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250817
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250817,
					"content": "你太放肆了，我最宠爱的女儿。你怎么能说出这种话来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250818
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250818,
					"content": "她「活着」，或是「死了」，她还能否、或如何「复活」…只要「永恒绿洲」归我控制，就都取决于我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250819
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250819,
					"content": "我将成为沉睡的女神唯一的女神谕者，塔尼特的律令将成为神的律令，塔尼特的繁荣将成为神谕之下的必然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250820
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250820,
					"content": "但在那之前…婕德，改悔还来得及。你是我最宠爱的女儿…我不想你这样迷误下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250821
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250821,
					"content": "我…我听不懂，你想说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250822
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250822,
					"content": "我的意思很明白：唯一确定的神谕，容不得异议者。目睹了绿洲真相而没被刺盲双眼的，只有你和你的外人朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250823
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250823,
					"content": "#况且，{M#他}{F#她}仍旧是「镇灵主人」，即使镇灵已经不再言语…只要除掉{M#他}{F#她}，便有可能夺取镇灵的控制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250824
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250824,
					"content": "我才更加尊重她的远古智慧与重建绿洲的能力，我们将会是更加称职的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250825
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250825,
					"content": "欸，你这是什么意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250826,
					"content": "我们上次面谈时，你逃避了这个问题…我可以理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250827
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250827,
					"content": "但今天，你必须做出选择。塔尼特，你的家；或是这个外人，你的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250828
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250828,
					"content": "等等…你们之前讨论过如何处置我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732250829
					]
				},
				{
					"id": 732250829,
					"content": "#是的…但我没有答应她。{M#毕竟你是我的朋友。}{F#因为…你对我很重要。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250830
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250830,
					"content": "#我很抱歉，孩子。但牺牲是必要的…请相信我，我们不会让{M#他}{F#她}高贵的血白白流淌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250831
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250831,
					"content": "而你，婕德，将会成为我的接班人，以后你会成为塔尼特部族新的主母，娜布·玛莉卡塔的女神谕者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250832
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250832,
					"content": "好好想想吧，家园的未来尽在你的手中，我的女儿。如果你开口请求，我会给你机会，给你时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250833
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250833,
					"content": "不需要了，我意已决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250834
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250834,
					"content": "唔，还是多想想比较好啦…不然好吓人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250835,
					"content": "芭别尔，一直以来我很感谢你的照顾…即使我明白，自己出自叛徒和外人的血脉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250836
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250836,
					"content": "对于你的安排，我深感…恩宠，受宠若惊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250837
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250837,
					"content": "…先前为你效劳的那些事情，为你封掉的嘴巴，那些消失的长老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250838
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250838,
					"content": "布列达长老，他喜欢鳄鱼，你一定记得。他把你当做亲生女儿看待，对我更是宠爱…所以我能把浸毒的匕首刺进他的怀里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250839
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250839,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250840
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250840,
					"content": "戈瓦法长老，你的眼中钉，他一定也是这样看你的。真遗憾，我只能用驮兽的颌骨一下一下、一下一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250841
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250841,
					"content": "那是我第一次被吓哭，被自己吓哭。是你帮我擦掉了眼泪…我还记得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250842
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250842,
					"content": "等等…你是说…？！唔…怎么会这样呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250843
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250843,
					"content": "等等…你提这个干什么…你在他们面前提这个干什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250844
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250844,
					"content": "啊，忒雅长老。她年轻，漂亮，又是猎团首领，比你更有竞争力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250845
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250845,
					"content": "她以为我喜欢她，但我只是为你做事，因为我相信你才是我真正的家人，我相信你能又一次擦去我的眼泪，给我家的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250846
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250846,
					"content": "我让她消失在沙漠里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250847
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250847,
					"content": "不要说那些没用的了！你到底想要说什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250848
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250848,
					"content": "「唯一的女神谕者」，我的「母亲」，不应该有什么可隐藏的秘密，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250849
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250849,
					"content": "如果你还想听，我会一件一件都讲给你听，讲给塔尼特的每一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250850
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250850,
					"content": "我为你做过的一切，我为了「母亲」，为了这个「家」做过的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250851
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250851,
					"content": "#而我已经做够了，已经受够了。现在，我不想背叛{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250852
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250852,
					"content": "你发疯了…竟敢污蔑部族的主母！你忘记了母亲的名字！闭嘴吧，现在闭嘴还来得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250853
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250853,
					"content": "我的母亲叫优菲，优菲·欣迪。她是一个正直的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250854
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250854,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250855
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250855,
					"content": "啊，我明白了。叛徒的女儿，终究是个养不熟的杂种狗…和她的父亲一模一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250856
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250856,
					"content": "哲伯莱勒和那个外来女人为自己的顽劣付出了代价，他们的女儿同样软硬不吃，好歹不分…我早该料到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250857
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250857,
					"content": "优菲·欣迪，那是她的名字…也将是我的氏名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250858
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250858,
					"content": "叛徒…我的话全都白费了！沙漠会铭记你的，叛徒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250859
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250859,
					"content": "够了，我的族人。你们知道该怎么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250860
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250860,
					"content": "她让我很气愤…和悲伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250861
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732250861,
					"content": "#欸…！等一下啦，不是…你们不要生气呀！你才说你拿婕德当女儿看的不是吗…而且，{NICKNAME}明明帮了你好多忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250862
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250862,
					"content": "总之…总之，我们一定还有别的办法和好的，对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250863
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250863,
					"content": "派蒙，躲起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250864
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732250864,
					"content": "不要看接下来要发生的事…别脏了你的白衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
		{
			"id": 7322511,
			"completionStepIds": [
				7322511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322511",
							"2"
						],
						"stepId": 7322511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732251101,
					"content": "嗯！婕德你永远可以信任我们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251102,
					"content": "嗯…只是，我又无家可归了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251103,
					"content": "或者说，你可以四海为家了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251104
					]
				},
				{
					"id": 732251104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251105,
					"content": "噗…如果是以前的我，肯定会觉得你这句话欠揍到不行！唉…不过你说的没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251106
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251106,
					"content": "你说的没错…现在我是我氏名的主人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251107
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251107,
					"content": "我不再是「塔尼特」这个名字的奴仆，而是「婕德」这个名字的主人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251108
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251109,
					"content": "我取回了母亲的氏名…我自由了，或许「婕德」这个名字，以后也会成为新的氏名…我不知道，也许吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251110
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251110,
					"content": "我母亲的名字带给我骄傲，父亲的名字保存着我的回忆。只要铭记着他们，在荒芜的沙漠里…这不就是我一直寻求的「家」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251111
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251111,
					"content": "终于不用再为「家」担忧了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251112
					]
				},
				{
					"id": 732251112,
					"content": "嗯，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251113
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251113,
					"content": "呃…你知道吗，我还挺想和你继续并肩一同冒险的…哈哈，让你这么多次置身险地…我一定烦到你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251114
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251114,
					"content": "但是…我看得出，你还有自己的路要走，我看得出你还要忍受更大的孤独，完成更远的目标…大过我能承受，远过我能想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251115,
					"content": "而我呢，我也有我自己的路要走！我的路…你也看到了，一定不会很和平安稳…所以，我就不拖累你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251116
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251116,
					"content": "你也不要这么说呀…有什么拖累的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251117,
					"content": "就这样吧…不过，如果什么时候你累了，想要歇一歇脚的话…我相信，我们一定会在某条路上相遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251118
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251118,
					"content": "到那时候，我说不定会邀请你们，再来一次天翻地覆的冒险呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251119
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251119,
					"content": "呼…好了，我的话说得够多了…是时候离开这个伤心地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251120
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251120,
					"content": "#{M#婕德与你在黄沙中拥别。\\n她紧紧地搂了你一下，你感受到她似乎正强忍着抽泣…\\n然后，她快速抽身离开你的怀中，若无其事地擦了擦眼角，对你咧嘴笑了。}{F#婕德与你在黄沙中拥别。\\n她紧紧地搂着你，仿佛生怕你被遮蔽天幕的沙暴带走，你感受到她似乎正强忍着抽泣…\\n然后，她轻轻把你推开，擦了擦湿润的眼角，对你露出微笑。}",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251121
					]
				},
				{
					"id": 732251121,
					"content": "「我希望我们下次相见，会是在一个阳光更好的日子。」婕德对你说。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251122
					]
				},
				{
					"id": 732251122,
					"content": "婕德转身离去。\\n你们看到，奔奔也从营地的废墟中出来，急忙跟上了婕德的脚步。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7322512,
			"completionStepIds": [
				7322520
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322520",
							"2"
						],
						"stepId": 7322520,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭别尔",
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732251201,
					"content": "咳咳…瞧瞧吧…塔尼特…塔尼特被一个叛徒…被一个叛徒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251202
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251202,
					"content": "我的…部族…我的族人…我的…「永恒绿洲」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251203
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251203,
					"content": "对那些说再见吧，你还有时间说遗言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251204
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251204,
					"content": "为什么…我曾经…那么爱你…为什么…你要背叛我…背叛…塔尼特…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251205
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251205,
					"content": "为什么？你是恶人，我是好人，我没必要和你讲道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251206
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251207
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251207,
					"content": "唉…好吧，好吧。芭别尔，我就告诉你好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251208
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251208,
					"content": "#{NICKNAME}，{M#他是我最好的朋友。}{F#她是我最好的朋友！}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251209
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251209,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251210
					]
				},
				{
					"id": 732251210,
					"content": "#你想要害{M#他}{F#她}，我拒绝了，然后你想要连我一起除掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251211
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251211,
					"content": "#不，比那还要卑劣…你想让我别无选择地与{M#他}{F#她}自相残杀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251212
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251212,
					"content": "直到这时候，我才意识到，你不是什么「女神谕者」，你配不上绿洲女王的青睐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251213
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251213,
					"content": "你只是一条狗而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251214
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251214,
					"content": "是你…太蠢了…咳…一个外人…一个外人…为了一个外人…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251215
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251215,
					"content": "我…我，我们才是你的家人！你毁了一切，你毁了…塔尼特的希望…和镀金热砂上所有流散民族的…咳咳…希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251216
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251216,
					"content": "少自大了，我不过推倒了一座小小的沙丘而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251217
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251217,
					"content": "#倒是你，我问你！什么样的母亲会逼迫自己的女儿谋害{M#朋友}{F#她所中意的人}呢！回答我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251218
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251219
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251219,
					"content": "你想害我，你就不配做我的家人。去你的什么先知大梦吧，将来自然有人替你实现的…好歹要用更干净的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251220
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251220,
					"content": "呵呵…呵…但是…我已经派出斥候，向沙漠各部通报了…你叛变的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251221
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251221,
					"content": "很快，他们都会知道…你…是一个玷污氏族之名的叛徒…咳咳…广阔的沙漠…很快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251222
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251222,
					"content": "很快，就不会再有任何人会接纳你…你将再也找不到安全的落脚点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251223
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251223,
					"content": "…什么时候？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251224
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251224,
					"content": "咳咳…！哈哈…就在…你们…回来之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251225
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251225,
					"content": "所以…从一开始她就没想让我们活。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251226
					]
				},
				{
					"id": 732251226,
					"content": "等等，之前…你让我改悔的那一大番话…也是假的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251227
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251227,
					"content": "我以为…你会心软…那样更好对付些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251228
					],
					"speakerTitle": "芭别尔"
				},
				{
					"id": 732251228,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251229
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251229,
					"content": "你让我恶心。你们所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
