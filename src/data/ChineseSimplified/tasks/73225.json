			},
			"dialogs": [
				{
					"id": 732250201,
					"content": "（被外力砸烂的板条箱，点点痕迹暗示里面曾经装着什么活物…但无论那是什么，现在它们都自由了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250202
					],
					"speakerTitle": "调查"
				},
				{
					"id": 732250202,
					"content": "唔…这气味…真是不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732250203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732250203,
					"content": "咳、咳…！我们别留在这里啦，前面还有别的遗骸，说不定能引导我们找到婕德所在的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
