			"dialogs": [
				{
					"id": 732251401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251402
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251402,
					"content": "也就是说…她从一开始就布下了这个陷阱，只等我们稀里糊涂地踏进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251403
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251403,
					"content": "等等…为什么…不早给我看这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251404
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251404,
					"content": "可是那会儿你看见我们就开打，也听不进去道理呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251405,
					"content": "呃…唉，对不起啦，你们都没事就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251406,
					"content": "不管怎样，我们要回去找她问清楚这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251407
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251407,
					"content": "唔…好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251408
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251408,
					"content": "先休息一会也来得及。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251409
					]
				},
				{
					"id": 732251409,
					"content": "嗯，是呀…没必要太着急的，反正现在我们随时可以回去，但芭别尔她要等着我们才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251410,
					"content": "派蒙说得对，现在我们才是主动方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251411
					]
				},
				{
					"id": 732251411,
					"content": "#{M#嗯，你说得对…抱歉，之前没能信任你…}{F#主动方…吗？嗯…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251412
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251412,
					"content": "好啦，婕德，你伤在哪里啦？我们来帮忙包扎一下伤口吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251413,
					"content": "伤在哪里？噗…哪里都是。不过没关系啦…我还能撑住就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251414
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251414,
					"content": "不要任性了，让我们看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251415
					]
				},
				{
					"id": 732251415,
					"content": "#{M#唉…好吧，抱歉…}{F#嗯…好吧…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251416
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251416,
					"content": "于是，你们决定在这里稍事休息，简单地搭起了营火…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251417
					]
				},
				{
					"id": 732251417,
					"content": "#{M#你为婕德仔细包扎了伤口，伴着火光一同休息了半晌。\\n在无言的默契中，你们已经决定好了下一步行动。}{F#你为婕德仔细包扎了伤口，伴着火光一同休息了半晌…\\n婕德在你身边安睡了许久，血与汗的气息混合着胡杨枝燃烧的焦味，也没能掩盖她身上淡淡的香料味道。\\n她的鼾声轻细，呓语荒唐…看来她真的累坏了。\\n待她醒来后，你们已经达成了默契，决定好了下一步行动。}",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732251418
					]
				},
				{
					"id": 732251418,
					"content": "…我们走吧，去找芭别尔。让她解释清楚这一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		}
