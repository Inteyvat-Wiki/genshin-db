			},
			"dialogs": [
				{
					"id": 732251301,
					"content": "呼…呼…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251302
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251302,
					"content": "没错，是婕德！她好像受伤了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251303,
					"content": "布列达…戈瓦法…伊吉德尔…梅杜尔…忒雅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251304
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251304,
					"content": "乌萨德…塔夫列…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251305
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251305,
					"content": "那是…人名吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251306,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251307
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251307,
					"content": "#{NICKNAME}…你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251308
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251308,
					"content": "抱歉，我有点丧失理智了…被他们抓了，真是抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251309
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251309,
					"content": "那种事先放一边啦，你受伤了吗？严重吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251310,
					"content": "过来吧，你们。我有话要和你们说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251311
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251311,
					"content": "告诉我，你还记得母亲的名字。然后，用你的剑来证明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251312
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251312,
					"content": "你…你在说什么啊…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732251313,
					"content": "告诉我，你们不是可耻的叛徒，然后证明它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732251314,
						732251316
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251314,
					"content": "你冷静一下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251315
					]
				},
				{
					"id": 732251315,
					"content": "我很冷静，你的剑在哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732251316,
					"content": "我不是叛徒，你这是怎么了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732251317
					]
				},
				{
					"id": 732251317,
					"content": "你不是叛徒，就用剑证明自己的清白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
