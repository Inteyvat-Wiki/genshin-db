					}
				]
			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#{NICKNAME}最近做委托很辛苦吧，我都看在眼里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510102,
					"content": "作为一个贴心称职的向导，我有责任帮你放松一下，当当——快看这是什么地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510103,
					"content": "招牌上写着呢，达莫维百货。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "摩拉小偷的住所，钱包坟场。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "你们好，欢迎来到达莫维百货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510106,
					"content": "顾客，这么说就不妥了。达莫维百货主打的一直是价廉物美，你们可以看看价格嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510107,
					"content": "这可不是一家普通的商店，这里是辛苦的劳动者通过消费获得精神放松的好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510108,
					"content": "说的没错，我们最近还推出了买一送一促销活动！欢迎所有顾客参加！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510109,
					"content": "买了我吃亏，不买你吃亏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510110,
					"content": "之前路过的时候，看到达莫维百货的活动海报，我就记住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510111,
					"content": "花一份钱，能买两份货，怎么看怎么划算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510112,
					"content": "#总有种不在这里消费，我的人生就有点缺憾的感觉…我今天就要带上{NICKNAME}一起弥补这份缺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510113,
					"content": "派蒙想买什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "派蒙想怎么弥补缺憾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "嘿嘿，这个先不告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510116,
					"content": "那我可不付钱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "哼哼，今天不需要你来付，我自己带钱来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510118,
					"content": "#老板，预订商品到货了吗？预订人的姓名是派蒙和{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510119,
					"content": "有的，稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510120,
					"content": "店主布希柯取出了一件被过度包装得看不出是什么的商品，在一旁的派蒙掏出了一大堆零钱。眼看这一大堆零钱就这么离开了自己，派蒙的脸上流露出一丝不舍。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "和派蒙一起拆开厚厚的包装后，你意识到这是两本留影册。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "终于拿到了，我等了好久呢，心愿达成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510123,
					"content": "平时拍了那么多画片，这下有地方存了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510124,
					"content": "没看到派蒙用留影机啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "没在你面前掏出来而已啦，趁你不注意我可是拍了不少你的糗照，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510126,
					"content": "竟然有点想看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "快给我看看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "现在不行，等我拍满一整本再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510129,
					"content": "小气派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "坏心眼儿派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "我才不是你说的那样呢。喏，这本留影册给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510132,
					"content": "虽然这一本有点薄，但也能放不少画片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510133,
					"content": "我们去过那么多地方，经常帮别人留影，给自己留下的画片却不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510134,
					"content": "要是能多留下一些自己的回忆就好了，所以我买了这两本留影册。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510135,
					"content": "这是礼物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510136,
					"content": "对啊，买一送一，你一本我一本，预订的时候我就想好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510137,
					"content": "要立刻用起来哦，可以去拍一拍我们一起走过的地方，找一找过去的回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510138,
					"content": "对了，要不要用我的留影机来拍？你好像还没用过它呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510139,
					"content": "当时费了那么大力气让百货店联络定制款，不多用用就可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510140,
					"content": "我来试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "谢谢你，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "你喜欢就最好啦，这都是一个贴心称职的向导该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510143,
					"content": "走，我陪你一起去留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}