			"dialogs": [
				{
					"id": 750080101,
					"content": "曼科，我们回来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080102,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "嗯，这可真是一阵苦等啊，等待的时间越久，实不相瞒，我的心情就越焦虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080104,
					"content": "虽然…提出建议的人是我，但是若是你们进入遗迹而无法归来，我也实在是良心难安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080105,
					"content": "不过，恕我直言，你们应该找到「盗火贤者」留在遗迹里的信物了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080106,
					"content": "费了番功夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "我就相信你们一定可以成功的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080109,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "你看，就是这个圆盘一样的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080111,
					"content": "啊…「通牒金盘」，传说中的「通牒金盘」居然是真的，太好了，我一定要将它记录在我研究的成果里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080112,
					"content": "原来这东西叫做「通牒金盘」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080113,
					"content": "是、是的。唉恕我冒昧，我真是太激动了，据说这可是那位「盗火贤者」亲自经手的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080114,
					"content": "刚才有一瞬间，我想要将之占为己有，作为传家宝之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080115,
					"content": "#那可不行，我们是要用来救{REALNAME[ID(2)|SHOWHOST(true)]}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080116,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "我知道…不过，信物的线索，我也只知道这枚，另外一枚究竟在何处，我就实在不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080118,
					"content": "奥奇卡纳塔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#咦，恕我直言，{NICKNAME}，你是说奥奇卡纳塔吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080120,
					"content": "（述说触摸石碑时看到的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "唔，居然在奥奇卡纳塔…那是花羽会北边，隔海相望的一座古城遗址…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080122,
					"content": "如果是奥奇卡纳塔，恕我抱歉，我爱莫能助。那里不仅仅是部族人的禁地，更是龙遗物研究协会的禁地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080123,
					"content": "据说许多年前，曾经有龙遗物研究协会的组织成员受人委托前去调查，结果就像石头沉入水中那样，再无半点消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080124,
					"content": "自那以后，我们协会就不再插手任何和奥奇卡纳塔相关的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080125,
					"content": "没关系，知道这些已经很足够啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750080126,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "嗯，我要再度感谢你们，能够看到「通牒金盘」，对我真的十分重要，不行，我得快点回去将这些记录下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080128,
					"content": "#再度感谢你们，{NICKNAME}，派蒙，祝你们的旅途顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080129,
					"content": "#然后，也祝愿{REALNAME[ID(2)|SHOWHOST(true)]}，祝愿你能去除「焰主之祝」的印记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080130,
					"content": "再见！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "嗯…在旅途的终点，在所有灵魂的归处，我们一定能够再见的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼科"
				},
				{
					"id": 750080107,
					"content": "轻轻松松啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
