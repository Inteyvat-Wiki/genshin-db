			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "下次再设计一下团队战好了？或许对战也是不错的主意？哦，是你们呀，欢迎来到训练场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "瓦伊诺"
				},
				{
					"id": 760570102,
					"content": "关于训练场…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "客人渐渐多了起来，这还是多亏了你们。当然，还有孩子们和「地隐会」的功劳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "瓦伊诺"
				},
				{
					"id": 760570104,
					"content": "我发现，训练场会是一个很适合聚会的地方。和多年不见的朋友突然相聚，一时会不知道该说些什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊诺"
				},
				{
					"id": 760570105,
					"content": "关于「地隐会」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "啊…暂时还没有找到比靶标更合适的鼹鼠窝垫材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "瓦伊诺"
				},
				{
					"id": 760570107,
					"content": "我和孩子们试了好几种材料了，它们就是特别中意靶标。目前为止还是只能去和它们交易换回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "瓦伊诺"
				},
				{
					"id": 760570108,
					"content": "不过，我们也渐渐掌握了它们的宝物汇率，净赚不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊诺"
				},
				{
					"id": 760570109,
					"content": "下次再来找你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "嗯，请随时来！记得哦，只要是你们，永远免费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊诺"
				}
			]
		},
