			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"施芮娅",
					"维纳亚克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735130101,
					"content": "…所以说为什么连铆钉也要订制！根本不能提高几点性能吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130102
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130102,
					"content": "——铆接装甲可是妙论派的浪漫啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130103
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130103,
					"content": "你们…这是从昨天算账到现在？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130104
					]
				},
				{
					"id": 735130104,
					"content": "啊，你们已经来了吗？倒也不算，其实经费的问题昨天已经辩论完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130105
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130105,
					"content": "呼…刚刚是在争论其它问题，只是不知不觉，就又绕回经费了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130106
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130106,
					"content": "其他问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130107
					]
				},
				{
					"id": 735130107,
					"content": "我连零件的接缝都打磨到发亮了，施芮娅这家伙，居然想中止计划！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130108
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130108,
					"content": "不是中止！只是暂缓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130109
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130109,
					"content": "你没发现环境参数好像有点不对劲吗？就这么继续铺设的话，装置的充能效率会远低于预期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130110
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130110,
					"content": "我们得先搞清楚这片区域到底发生了什么，排除掉所有影响因素，然后再按计划组装…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130111
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130111,
					"content": "理想环境和实际环境对不上的情况多了去吧，没必要这么斤斤计较。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130112
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130112,
					"content": "我在出图纸的时候就考虑过容错范围，这点影响根本不算什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130113
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130113,
					"content": "何况有些时候就得先上手实验过了，才能发现问题出在哪里啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130114
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130114,
					"content": "——这就是你当年强行实验二号机然后炸膛的理由？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130115
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130115,
					"content": "这、这跟那时候不一样吧！那时候我不还没意识到要留容错空间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130116
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130116,
					"content": "…有没有安全点的实验方法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130117
					]
				},
				{
					"id": 735130117,
					"content": "我想想…或许可以先关闭炮塔的发射功能，就模拟实验一下它的充能进程？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130118
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130118,
					"content": "…不行，我信不过你，还是把炮塔的点火模块卸了吧，我先给你保管着。别的东西随你装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130119
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130119,
					"content": "卸掉点火模块？——那这「对沙虫用杀虫炮」不就成空架子了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130120
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130120,
					"content": "你不是说就实验一下充能吗？果然还是在打开炮的主意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130121
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130121,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130122,
						735130123
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130122,
					"content": "就先关闭发射功能吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				},
				{
					"id": 735130124,
					"content": "唉，行吧…就当是试组装了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735130125
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735130125,
					"content": "早这样不就好了…安装过程中估计会有不少魔物被引来，到时候就麻烦你了，冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735130123,
					"content": "总之先把架子搭出来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735130124
					]
				}
			]
		}
	]
}