					"雷泽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "我们回来啦！你看看这些够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540302,
					"content": "足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540303,
					"content": "刚才和他谈了一下。狼群世界的规则，很不可思议啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540304,
					"content": "谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540305,
					"content": "绕了一圈都没有找到其他狼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540307,
					"content": "狼平常是这样的。刚才抓到那条明显是智力有点问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "约顿"
				},
				{
					"id": 4540308,
					"content": "干、干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540309,
					"content": "找你算账。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540310,
					"content": "就是他，传闻里被狼养大的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "约顿"
				},
				{
					"id": 4540311,
					"content": "嚯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540312,
					"content": "原来就是你。我还在想狼怎么这么聪明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540313,
					"content": "是你在帮着畜生算计人啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540314,
					"content": "谁给吃谁就是父母吗，你忘了自己是个什么东西了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "神奇的霍普金斯"
				},
				{
					"id": 4540315,
					"content": "够了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540316,
					"content": "你们这是欺负雷泽不擅长说话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540317,
					"content": "嗯？！骑士团要袒护这个人吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "约顿"
				},
				{
					"id": 4540318,
					"content": "不是我们，袭击的村子——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷泽"
				}
			]
		},
