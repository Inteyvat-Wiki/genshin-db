			},
			"dialogs": [
				{
					"id": 4540101,
					"content": "是谁？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540102,
					"content": "别紧张，雷泽，是我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540103,
					"content": "你是…你也是骑士团的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540104,
					"content": "什么，原来你们不认识吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540105,
					"content": "「红色，很烫的女孩子」——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "不认识。 虽然也是红色，但是没有那个人那么烫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540108,
					"content": "啊，我明白了。 你们之前说的狼少年就是他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540109,
					"content": "正是。 他叫做雷泽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540110,
					"content": "帮我一个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540111,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540112,
					"content": "来不及解释了。我让卢皮卡散开了。因为那群人来了。他们没有善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540113,
					"content": "就是刚才那些家伙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4540114,
					"content": "明白了。不过在那之前，我有些事情想要问你——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540115,
					"content": "有血的气味。我们要快点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4540116,
					"content": "难道说是那群傻子被狼袭击了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4540106,
					"content": "真的不是安柏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
