			},
			"dialogs": [
				{
					"id": 4541501,
					"content": "这里是……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME}，请你帮我一个忙。帮我收集这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541503,
					"content": "这个不是钩钩果的种子嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541504,
					"content": "它碾碎了包扎，可以止血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541505,
					"content": "的确。钩钩果的种子上面有层汁液，不仅能轻微麻醉痛觉，还能止血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541506,
					"content": "书上这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541507,
					"content": "为什么会这样啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541508,
					"content": "这我就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541509,
					"content": "钩子让种子散布。麻醉与止血，为了不痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541510,
					"content": "我们会更难察觉它，把它带得更远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541511,
					"content": "…紫色的老师，是这么和我说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541512,
					"content": "我要留在这里照看它。还有，回答另一个红色女孩子的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541513,
					"content": "嗯，如果人群回来了，骑士团的面子应该有点作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541514,
					"content": "#你的狼朋友们并没有洗脱嫌疑呢。不过，{NICKNAME}，草药还是麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		}
	]
