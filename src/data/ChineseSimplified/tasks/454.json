			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "是血迹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541102,
					"content": "不是人，是狼的。是卢皮卡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541103,
					"content": "所以卢皮卡究竟是什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541104,
					"content": "卢皮卡——是命运的家族。如果狼接纳了人，或者人接纳了狼。他们就是卢皮卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541105,
					"content": "听起来不像是人的语言啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541106,
					"content": "这话就很奇怪了。难道狼的交流还会用语言的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541107,
					"content": "是它定下的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541108,
					"content": "…它，说的是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541109,
					"content": "这片土地的领主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541110,
					"content": "蒙德的主人，不应该就是巴巴托斯吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541111,
					"content": "之后再说，我好像又找到线索了。跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541112,
					"content": "欸，你等等！我可是在给你机会解释自己的清白哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541113,
					"content": "啊，雷泽已经走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
