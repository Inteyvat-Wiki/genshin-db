				"points": []
			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "是它。被那群人抓住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541302,
					"content": "真是过分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541303,
					"content": "虽然我也觉得很凄惨，但是我的立场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541304,
					"content": "袭击村子的不是我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541305,
					"content": "是流浪而来的黑狼，还有它的狼群。它们想要领地。它们破坏了它定下的规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541306,
					"content": "<color=#00E1FFFF>它？</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4541307,
					"content": "这片土地的领主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4541308,
					"content": "这句话刚才听过了。你还是解释一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4541309,
					"content": "我要把卢皮卡抱到深处去。和我一起来吧。或许它会现身回答你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷泽"
				}
			]
		},
