						"stepId": 4140202,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_LESS_THAN",
						"rawParams": [
							"220019",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"季同"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "这位旅行者，请你留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020202,
					"content": "有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "虽然有点突然…但是，请问你对「留影机」有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020204,
					"content": "有一点兴趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "哎，我这台「留影机」可不是一般的「留影机」，这可是枫丹最新的技术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020207,
					"content": "从这台「留影机」里印出来的画，能有一种普通「留影机」没有的色调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020208,
					"content": "这是怎么做到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "哎！你怎么一副不相信的样子，你不信的话，就去冒险家协会那边问问去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020211,
					"content": "之前我也不相信，摆弄了这台「留影机」半天没摆弄好，还是协会里的一位冒险家帮了我的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020212,
					"content": "这「留影机」啊，和普通的「留影机」不一样的地方，就是在它里面的有个小结构。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020213,
					"content": "这个结构里填着一种特别的药剂，能让印出来的画带有特别的效果，可比普通「留影机」拍出来的画好看多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020214,
					"content": "怎么样？有兴趣的话，您先拿着这个玩玩？虽然这台里面的药剂种类不太多，但体验体验还是足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020215,
					"content": "我之后还会去枫丹进一批全新的药剂，要是您有兴趣，欢迎来光顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020216,
					"content": "那…谢谢了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "那这台「留影机」就送给您玩了，如果觉得不错，以后记得多多光顾我的生意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020217,
					"content": "那些药剂多少钱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "这个…咳，您别担心，单支非常便宜。如果您买得多，到时候也能商量着优惠点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020209,
					"content": "真的假的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "没什么兴趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4140203",
							"2"
						],
						"stepId": 4140203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"季同"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "好了这台「留影机」就送给您了，请您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020302,
					"content": "这台「留影机」就…送我了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "这些药剂也够您用一段时间的了，药剂用完了的话…您就可以找我买嘛，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020305,
					"content": "再说了，我还准备去找那个人，进更多种类的药剂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020306,
					"content": "您以后要是有兴趣，欢迎您来我这光顾啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020307,
					"content": "哎呀…没想到，买台「留影机」，还能买出一桩好生意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020303,
					"content": "要是那种药剂用完的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}