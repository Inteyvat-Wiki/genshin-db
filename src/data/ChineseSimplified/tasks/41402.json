			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"季同"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "哎，你来了，我正好有事和你说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020102,
					"content": "有什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "不用了不用了，我已经弄清原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020105,
					"content": "前几天，我总算找到那个卖我「留影机」的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020106,
					"content": "我说他的「留影机」有问题，但是他怎么都不信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020107,
					"content": "多亏了你之前帮我拍了那么多画，要不是我有那么多画，那家伙估计不肯认账。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020108,
					"content": "有了你帮我拍了那些画，他才答应回去检查一下卖给我的那批「留影机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020109,
					"content": "这不，昨天他刚给我拿了一瓶什么药剂过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020110,
					"content": "他说这种「留影机」的结构和普通的不一样，需要往机器添加点药剂，印出来的画才是出正常的画面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020111,
					"content": "要是不加那种药剂，那就和你之前拍的那种画一样，只有颜色，没有清晰的画面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020112,
					"content": "机器没事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "唔，话是这么说，但比起「留影机」，我其实对那种药剂更感兴趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020115,
					"content": "你想，大多数人只会买一台「留影机」对吧？买了也可以一直用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020116,
					"content": "但那种药剂可是耗材，用完了之后，想用就得接着卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020117,
					"content": "而且据那个人说，根据药剂的不同，印出来的画效果也不一样。他那边也正在研究更多的药剂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020118,
					"content": "也许…那种药剂才是真正的大生意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020119,
					"content": "咳，抱歉，我一个人在这自言自语个没完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020120,
					"content": "谢谢您帮忙，您先把这台「留影机」给我一下，我给您把那种药剂添进去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020113,
					"content": "那…就都没问题了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "今天也要拍「颜色」强烈的东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
			"completionStepIds": [
				4140202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
