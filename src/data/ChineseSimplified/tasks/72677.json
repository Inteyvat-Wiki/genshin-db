					"nextDialogs": [
						726771009
					]
				},
				{
					"id": 726771009,
					"content": "和派蒙一样厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771010
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726771010,
					"content": "#唔…{NICKNAME}可能不是那个意思，但总之…吉法师就是很聪明呢！哼！",
