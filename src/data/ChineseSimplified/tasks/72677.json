			"dialogs": [
				{
					"id": 726770101,
					"content": "这里的景致，很特别吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770102,
					"content": "一层一层的水，颜色很特别呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770103,
					"content": "派蒙和吉法师的词汇量一样匮乏…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#但是，真的很特别嘛！这个颜色，{NICKNAME}要怎么形容呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770105,
					"content": "像冰元素…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "什么嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770113,
					"content": "#不过，这里的景色真的很特别呢。{NICKNAME}还记得之前那位画家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770114,
					"content": "梵米尔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "嗯！就是梵米尔！当时，咱们不是还帮他在那两个大雕像上装超级发光大珠子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770118,
					"content": "最后还送了一幅画给我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770119,
					"content": "是这个吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "嗯！就是这个！吉法师，快看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770121,
					"content": "呶！好像！是拍照吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770122,
					"content": "不是哦，是人画的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770123,
					"content": "咦？但是、为什么人能拍照，还要画画呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770124,
					"content": "#唔…是呀，{NICKNAME}，这是为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770125,
					"content": "因为想要创造只属于自己的东西吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "好像很有道理的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770130,
					"content": "而且，自己画的东西，有很多心意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "嗯，一笔一笔把自己心里想的东西画出来，很辛苦的事情呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770132,
					"content": "嗯…那给我拍照，是不是很容易、不辛苦，所以没有很多心意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770133,
					"content": "欸！不是这样的，是因为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770134,
					"content": "画画要好长时间。吉法师会累。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "对对！画画要好长时间的，吉法师要是一直保持一个姿势，会很累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770136,
					"content": "以前被封印变成石头的时候，就一直站着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770137,
					"content": "所以，挣脱封印以后，好长时间里，脚好难受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770138,
					"content": "呜哇，听起来就觉得好辛苦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770139,
					"content": "但是，派蒙可以飞飞。应该脚不会累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770140,
					"content": "喂！飞的时候，全身的幻肢都在运动，很累的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770141,
					"content": "哇！着火的花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770142,
					"content": "好好听人说话啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770143,
					"content": "烈焰花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "对喔，在镇守之森好像确实没怎么见过烈焰花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770145,
					"content": "吉法师想要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770146,
					"content": "想要！看上去很暖和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770147,
					"content": "#那要好好拜托{NICKNAME}喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}，想要。谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770149,
					"content": "妖狸说话就是这种风格吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770127,
					"content": "因为留影机很贵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "欸？！留影机很贵吗？那平时战斗、游泳、爬山，又从山上掉下来会不会弄坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770129,
					"content": "呜哇，不得了，以后要小心才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770116,
					"content": "谁啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "是梵米尔啦！当时，不是还帮他在那两个大雕像上装超级发光大珠子来着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770106,
					"content": "像风元素？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "吉法师的词汇量和派蒙一样丰富…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "和派蒙一样厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726770110,
					"content": "#唔…{NICKNAME}可能不是那个意思，但总之…吉法师就是很聪明呢！哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770111,
					"content": "真的很特别呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#哎？{NICKNAME}的词汇量是不是有点匮乏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "派蒙"
				}
			]
		},
