			"trigger": {
				"objectNames": [
					"傅三儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "一个人走在这里，很危险的哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102102,
					"content": "因为，你根本不知道会遇到什么人，或者说，是不是人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102103,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "哼哼，没想到你还挺冷静的。有句俗话说，常在河边走，哪有不湿鞋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102106,
					"content": "行走在这种阴森诡异的地方，说不定就会看到什么不该看到的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102107,
					"content": "只要看到了，它就会化作噩梦，纠缠你一生一世！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102108,
					"content": "哦，这样啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "不对啊，你也太冷静了，一般人的话，我说到一半就已经吓得逃跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102111,
					"content": "因为你看起来就是个普通人啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "虽然这么说，但真正高明的扮鬼方法，是利用对方的恐惧心理，制造恐怖的气氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102113,
					"content": "至于我什么样，其实不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102117,
					"content": "所以像你这样不相信鬼的人，我用什么办法吓唬都没用啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102118,
					"content": "我觉得你只是在找理由偷懒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "别这么说嘛，好了，我要去找其他的胆小鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102120,
					"content": "你也赶快回去找你的同伴吧，说不定他已经被吓得不行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102114,
					"content": "你们没有戏服之类的东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "有是有，但是穿着太热了…而且真正高明的扮鬼方法，是利用对方的恐惧心理，制造恐怖的气氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102116,
					"content": "至于我什么样，其实不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "傅三儿"
				},
				{
					"id": 1903102109,
					"content": "听不太懂，请问你有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
