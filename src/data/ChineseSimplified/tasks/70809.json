			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "（鸟巢内有许多零散的碎纸条，似乎还有七零八落的字迹…）",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "这些纸条…不会是它们为了筑巢特意撕开的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090303,
					"content": "上面好像还有字呢，要不要拼起来看看写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090304,
					"content": "搞半天还是要自己拼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "你就不好奇吗？说不定是什么藏宝图呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090306,
					"content": "在派蒙的连声催促下拼好了纸条…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "让我看看…这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090308,
					"content": "这…这难道是…「犯罪计划书」吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090309,
					"content": "谁的犯罪计划会被鸟叼走啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "但…但是小说里经常有这种情节吧！万无一失的计划，偏偏就在最不可能的地方出了疏漏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090313,
					"content": "我们去附近的酒馆里打听一下吧？看看有没有谁听说过，「最近有人要犯罪了！」什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090311,
					"content": "宁可信其有，不可信其无…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "你…你说得对，不怕一万，就怕万一…如果真有人打算犯罪，回头后悔可就晚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "派蒙"
				}
			]
		},
