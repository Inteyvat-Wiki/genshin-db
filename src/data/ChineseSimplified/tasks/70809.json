			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "这…这是…我的「作案手法」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "内田幸太郎"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}！他居然直接就承认了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090403,
					"content": "啊！请别误会，这是我打算写进下一部小说里的诡计，是我之前喝酒的时候想出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "内田幸太郎"
				},
				{
					"id": 708090404,
					"content": "没想到酒一醒这页纸就消失了…我差点以为自己是在做梦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "内田幸太郎"
				},
				{
					"id": 708090405,
					"content": "总之，多谢你帮忙找回它啦。这下我的小说应该就能顺产了，到时候我先送你一本！带签名的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内田幸太郎"
				}
			]
		},
		{
			"id": 7080905,
