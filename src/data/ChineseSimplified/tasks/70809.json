			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "哦？有点意思，让我看看…嗯，创意可以给六分，可行性大概就四分吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 708090502,
					"content": "这…这是「犯罪计划书」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 708090503,
					"content": "哈哈，其实我从驻地跑来这里，就是听说了有人在这儿盘算一些稀奇古怪的「犯罪计划」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 708090504,
					"content": "…不过看过这页笔记之后，我大概知道那些流言是怎么起来的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "洛恩"
				},
				{
					"id": 708090505,
					"content": "这份「犯罪计划书」就交给骑士团来处理吧，回头要是有空就来我的驻地逛逛？没准会有好戏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛恩"
				}
			]
		}
	]
