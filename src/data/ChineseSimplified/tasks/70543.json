			"dialogs": [
				{
					"id": 705430101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430102,
					"content": "…喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "「团团灰」"
				},
				{
					"id": 705430103,
					"content": "…是你们。我在，聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430104,
					"content": "聊天…雷泽是在和「团团灰」聊天吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430105,
					"content": "喵，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "「团团灰」"
				},
				{
					"id": 705430106,
					"content": "「团团灰」的意思好像是…「没错」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430107,
					"content": "闻到熟悉的味道，找朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430108,
					"content": "它很好，高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430109,
					"content": "喵，喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "「团团灰」"
				},
				{
					"id": 705430110,
					"content": "气味吸引朋友，你也来了，高兴。你身上，风和雨的味道，很熟悉…猫的气味，也熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430111,
					"content": "派蒙，甜甜的味道，好闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430112,
					"content": "欸？！甜甜的…难道是瓦乐瑞娜给我们的松饼的味道？我、我有吃那么多吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430113,
					"content": "我的都分给你一半了啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "完全没注意…哎呀，都怪松饼太好吃了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430116,
					"content": "嘿嘿，我还想吃甜甜花酿鸡、烤肉排和土豆饼…还有苹果酿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430117,
					"content": "#那菜单就这么定啦，{NICKNAME}，我们快去找瓦乐瑞娜下单吧，雷泽也一起来嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430118,
					"content": "谢…谢谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430119,
					"content": "「团团灰」给我带来了很多…坚果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430120,
					"content": "还有，盒子的肉…我， 吃得很饱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 705430121,
					"content": "听起来好像是瓦乐瑞娜小姐点的外送订单？难道「团团灰」把外送餐品拿给了雷泽吃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430122,
					"content": "喵喵。喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "「团团灰」"
				},
				{
					"id": 705430123,
					"content": "没想到，「猫茸茸城堡」里还会有猫猫反过来招待客人的事呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430124,
					"content": "看来雷泽真的「猫缘」很棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705430114,
					"content": "没事，你还能再吃三倍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}