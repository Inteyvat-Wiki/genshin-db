			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尼可"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "呃啊，吓我一跳！突然就被吸进画里了。等等，这场景好眼熟…是魔女们聚会的长桌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030202,
					"content": "——具体就要从我第一次被艾莉丝邀请参加茶会的时候说起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030203,
					"content": "不过，当天我并没有亲自出席，因为那时的我都没有想好要不要正式加入魔女会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030204,
					"content": "在场众人只有艾莉丝知道我的真实身份，她事先提醒我不要说话，不要暴露马脚，默默观察大家就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030205,
					"content": "后来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030206,
					"content": "…后来我认定那是对我的犹豫的报复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030207,
					"content": "大家的聊天内容那么有趣，怎么能忍住不插话呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030208,
					"content": "聊着聊着有人抛出了一个你明确知道答案的问题，又怎么能忍住不分享呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030209,
					"content": "这就要说起艾莉丝和芭比洛斯的赌局，莱茵多特禁忌的创造，伊万诺夫娜的政治手腕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030210,
					"content": "简直是一幕幕浓缩在茶杯之中的美妙戏剧，光凭言语就触动了我想要揭示真相的本能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030211,
					"content": "那你在大家脑袋里说话了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030212,
					"content": "怎么会呢，就算憋闷到呼吸困难，我也仍然是一名负责任的天使，知道「想说」和「能说」之间的区别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030213,
					"content": "所以到了最后，我也只是私底下找艾莉丝一口气说了个痛快，顺便答应了加入魔女会的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030214,
					"content": "她对后者接受得很快，但前者嘛…她说她那几天脑袋疼到去璃月找大夫了，可这也不能全怪我呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
