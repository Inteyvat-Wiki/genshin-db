					},
					{
						"sceneId": 1156,
						"position": [
							19.488,
							0.278,
							-25.627
						],
						"pointId": 32
					},
					{
						"sceneId": 1156,
						"position": [
							21.366,
							0.278,
							-24.957
						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "噢，你们来了！我还想着需不需要给你们什么更明显的指引呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030102,
					"content": "但又想到提示太显眼，反而容易打断你们的旅行计划…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030103,
					"content": "就在我这么犹豫的时候，你们像及时雨般出现了，可以说是皆大欢喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030104,
					"content": "你好呀，尼可，你看起来精神真好！而且…今天也很健谈呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030105,
					"content": "那我就当作赞美收下了。好了，来下一个房间看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
