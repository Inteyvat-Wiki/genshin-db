					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "银白古树？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030302,
					"content": "噢，是这幅画，你们对白树已经不算陌生了，不过你们是否知道，最初天使的背叛就是在白树下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030303,
					"content": "不太了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "我有点好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030306,
					"content": "嗯，那就久违地讲一个恐怖爱情故事好了。让我保留一下当事人隐私…有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030307,
					"content": "#很久很久以前，有一位漫行于星间的旅者——和{NICKNAME}很不一样，说来话长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030308,
					"content": "一天，他前往银树之下拜访晨星的公主，不出片刻就向她询问起了王国最为禁忌的机密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030309,
					"content": "他的言语令公主疑惑：他怎么会知道那些不被神明许可之事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030310,
					"content": "少年袒露了他的来历，同时展现的还有公主从未见过的，自由意志与崇高的精神之爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030311,
					"content": "他的话语点醒了公主被神明禁锢的自我，她的心飞扬起来，越过了从未跨越的藩篱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030312,
					"content": "晨星公主向少年倾吐了王国的秘密，二人之间不仅萌生爱意，更萌生了反抗神明的决心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030313,
					"content": "到这里为止，还算是个标准的爱情故事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030314,
					"content": "恐怖的部分马上就到。他们渴望帮助民众获得不被束缚的自由生命，但这种背叛不被神明容赦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030315,
					"content": "神明降下雷霆与怒火，毁灭了他们的居所。而当大战平息后，公主永远地失去了她的力量与智慧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030316,
					"content": "甚至就连那些曾与她亲近的朋友，也被一并烙下了诅咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030317,
					"content": "呃…结尾的部分好吓人啊…",
					"roleType": "TALK_ROLE_NPC",
