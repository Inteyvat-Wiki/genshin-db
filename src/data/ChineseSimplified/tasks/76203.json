					"nextDialogs": [
						762030320
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030320,
					"content": "嗯，那就久违地讲一个恐怖爱情故事好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030321,
					"content": "让我保留一下当事人隐私…",
