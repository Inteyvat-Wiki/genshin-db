					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "您、您愿意帮我？太感谢了，太感谢了——那…就请您帮我拿<color=#00E1FFFF>五颗白灵果</color>来吧，这些就够用了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670303,
					"content": "等您拿来了之后，我一定会给您做一份最好吃的「飨月餐」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉希"
				}
			]
		},
