					"莉莉希"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "…呜…早知道就多准备一些白灵果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670102,
					"content": "（上次菈乌玛在这里的时候…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#{NICKNAME}，您好，您是来领「飨月餐」的么？抱歉，您可能要稍等一下了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670105,
					"content": "「飨月餐」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "咦？您上次不是拿到过么…喔，上次是菈乌玛大人主持的，好像没告诉您这种餐食的正式名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670107,
					"content": "简单来说呢，「飨月餐」就是我们「霜月之子」为有需要之人免费发放的餐食啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670108,
					"content": "我们「霜月之子」原本就有接济求助者的传统，最开始，只是限于希汐岛周围…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670109,
					"content": "但在菈乌玛大人的主持和大家的努力下，我们也逐渐扩大了「飨月餐」的发放范围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670110,
					"content": "菈乌玛大人说，这也是为了将月神的赐福遍施众人，就是那句，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670111,
					"content": "「采获所得首例珍果，须置于月光祭坛。此非奉神，乃是为迷途的猎人留存…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670112,
					"content": "留存…留存什么来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670113,
					"content": "咳，总之！这家店呢，就是发放「飨月餐」的主要地点之一，哼哼，我可是几乎一个人在打理这里喔，厉害吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670114,
					"content": "虽然在那夏镇里发放「飨月餐」遇见了很多困难…但我相信菈乌玛大人所说的，这样一定能帮助更多需要帮助的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670115,
					"content": "不过…昨天准备食材的时候，我忘记把箱子盖盖紧了，早上起来的时候，好多果子都被小鸟们啄破，完全用不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670116,
					"content": "剩下的白灵果压根做不了多少「飨月餐」，呜…这下怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766670103,
					"content": "（好像是在发放餐食…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
