			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#是你啊，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270402,
					"content": "爱可菲，好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "今天的我不负责烹饪，只是单纯地在试吃而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270405,
					"content": "莎凡娜想推出一道新菜品，拜托我来帮她把把关。但这道菜…已经是第五次重做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270406,
					"content": "不是火候差了几秒，影响了食材的口感；就是调味的比例偏高，让香料的味道喧宾夺主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270407,
					"content": "爱可菲还是那么严格啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "那是当然！烹饪可是一门科学，不会因为她是我朋友就变了味。不如说就是因为要对她和顾客负责，我才更得严格吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270409,
					"content": "其实，我有一个小小的请求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "…在这种时候吗？如果是要用于公开展示的画片，我建议另找时间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270412,
					"content": "我们需要好好挑选布景，仔细调整光线和角度，才能达到最佳的呈现效果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270413,
					"content": "只是想为朋友留影纪念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "…好吧。反正要等她重做第六次，现在还有点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270416,
					"content": "那就让我看看，你的新镜头和那道新菜品，哪边能发挥得更好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 745270414,
					"content": "也能测试新镜头的性能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "能让我为你拍张画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "在研发新的菜谱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
