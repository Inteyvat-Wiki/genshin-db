			"dialogs": [
				{
					"id": 752460101,
					"content": "#{NICKNAME}，快看那边，有人在呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460102,
					"content": "唔？这两个背影是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "欧洛伦和伊法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460104,
					"content": "#熟悉的声音，是{M#爷爷}{F#奶奶}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460105,
					"content": "噢哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460106,
					"content": "好久不见，你们也来度假村了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460107,
					"content": "恰斯卡说过你们来度假村工作的事，没想到突然就遇到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460108,
					"content": "是啊，这里氛围不错，听说大家都玩得很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460109,
					"content": "嘿嘿，希望这里办得越来越好、游客越来越多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460110,
					"content": "你们呢？工作还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460111,
					"content": "还不错，我们负责照顾的龙员工和蜜虫都很健康，活力十足。托这个的福，我们也有空到处转转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460112,
					"content": "…员工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460113,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460114,
					"content": "蜜虫员工。龙员工和蜜虫员工，你说漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460115,
					"content": "没错哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460116,
					"content": "哎…抱歉啊。那么感谢所有的员工，以及积极为各位员工服务的欧洛伦先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460117,
					"content": "早到几天，为重要的事物奋斗。嗯，很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460118,
					"content": "这哥们第一次接到如此正式的邀请函，可积极了，你别见怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460119,
					"content": "保持热情是好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#你看，{M#爷爷}{F#奶奶}也这么说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460121,
					"content": "每一天都很重要，每一天的工作都是为守护重要的事物而战。这是咔库库教会我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460122,
					"content": "哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460123,
					"content": "可是…看样子你们是在钓鱼吧？钓鱼也算为重要的事而战？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460124,
					"content": "听听你说的话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460125,
					"content": "很重要，因为钓鱼是一位朋友给我们的建议。他是蒙德有名的冒险家，运气极佳，听他的准没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460126,
					"content": "（啊…班尼特吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "那位哥们用树枝转了一圈，指向这片水池，欧洛伦说择运不如撞运，就过来钓鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460128,
					"content": "等一等等一等，我从刚才就想问了，这池子周围不都是豚兽嘛！真的能钓上鱼来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460129,
					"content": "没问题的。豚兽性情温和，不太野，所以不需要警惕。有水就能野钓，这是奶奶的教诲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460130,
					"content": "奶奶还说有饭就吃，有台阶就下呢，你记住了没？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460131,
					"content": "#我现在正在给出台阶。{M#爷爷}{F#奶奶}，派蒙，来都来了，要不要一起钓鱼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460132,
					"content": "顺便一提，钓到最大的鱼的人，可以得到这家伙的蜜酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460133,
					"content": "有这种好事怎么不早说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460134,
					"content": "#哼哼，看来你还不知道自己招惹了什么人…面对挑战、说干就干！遇到{NICKNAME}你可真是遇到对手啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460135,
					"content": "亲爱的哥们，一决胜负吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "真有干劲，那我就奉陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460137,
					"content": "亲爱的孙子，一起钓鱼吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "没问题。赌上鱼的一切和蜜虫员工的酒，一决高下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "欧洛伦"
				}
			]
		},
