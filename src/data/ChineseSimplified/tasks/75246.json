			"dialogs": [
				{
					"id": 752460384,
					"content": "#有请辈分最高的{M#爷爷}{F#奶奶}先来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460385,
					"content": "那我就不客气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#哇，一上来比赛就进入高潮！高手{NICKNAME}使出绝技，拉杆出水！甩出一条…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460302,
					"content": "呃…一只…一位…阿夏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460303,
					"content": "真不得了…一上来就钓到了意想不到的东西，直接对评分系统发起挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460304,
					"content": "#不愧是{M#爷爷}{F#奶奶}！如果其他人不能钓到更特别的嘉宾，我觉得这就是冠军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460305,
					"content": "谢谢强大的对手们，谢谢亲爱的观众们！借乖孙吉言，本人有望成为冠军。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#真是太好了呢！{NICKNAME}旗开得胜，为另外两位选手带去压力了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460307,
					"content": "伊法选手请就位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460308,
					"content": "加油，哥们！搭把手哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460309,
					"content": "抱歉，咔库库，现在不是互帮互助的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460310,
					"content": "你们消停点…等等，来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460311,
					"content": "伊法拼尽全力拉动钓竿，看起来像是钓到了大的。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "然而浮出水面的却是…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "呃…伊法选手从池子里钓上来一条鳍游龙，后面还拖着一只豚兽？不知道它们为什么接在一起呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460314,
					"content": "真棒，还是这么受动物欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460315,
					"content": "不对，这条鳍游龙的尾巴不对劲…难道是它被水底的石头卡住了，然后这只豚兽想要帮它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460316,
					"content": "也有可能是豚兽想吃鳍游龙的尾巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460317,
					"content": "不对吧哥们。咔库库，去问问看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460318,
					"content": "嗯嗯…对的哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460319,
					"content": "你看，我猜对了吧…不对不对，当务之急是这个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460320,
					"content": "伊法迅速检查了鳍游龙的尾巴。还好只是轻微擦伤，并无大碍。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "简单消毒和上药后，鳍游龙和豚兽结伴离开了。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "交到朋友了呢。看来今天也是它们的幸运日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460323,
					"content": "「也」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460324,
					"content": "嗯，我有赢的预感。轮到我奋斗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460325,
					"content": "搭把手吧！哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460326,
					"content": "到底从哪学来的…不会是在给我们加油的意思吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460327,
					"content": "「钓鱼鼓励大师」咔库库！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "我们在奋斗，所以它应该叫「奋斗鼓励大师」，这样听起来更宏大…嗯？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460329,
					"content": "什么东西？！大家快闪开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460330,
					"content": "虽然看起来有些特别…但怎么又是豚兽啊！不是说这种生物性格很温和的吗，今天居然这么有干劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460331,
					"content": "一定也在为自己的重要之事奋斗吧，嗯，我能感觉到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460332,
					"content": "…唔，好像不对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460333,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "豚兽"
				},
				{
					"id": 752460334,
					"content": "它现在心情不好，该奋斗的是我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460335,
					"content": "哦我亲爱的老伙计！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460336,
					"content": "——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "豚兽"
				},
				{
					"id": 752460337,
					"content": "哈哈！太棒了哥们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460338,
					"content": "什、什么意思？咔库库在说服它吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460339,
					"content": "应该是在安抚。别看咔库库这个样子，它在安抚患者情绪方面技术高超。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460340,
					"content": "原来如此，不过咔库库的词汇量够用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460341,
					"content": "派蒙，用人的词汇本来也无法和豚兽交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460342,
					"content": "啊？对哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460343,
					"content": "在这种情况下，就得相信哥们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460344,
					"content": "而且我认为，交流时比起内容，声调更重要，更具有说服力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460345,
					"content": "比如像这样，「你好」。这是高兴的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460346,
					"content": "「你好」…这是无奈的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460347,
					"content": "「你好」！这是生气的意思，一般表示有危险靠近，要躲避。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460348,
					"content": "不能说完全没有道理，但怎么想都太难理解了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460349,
					"content": "学到了，非常感谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "真的吗？为你开心。我一般都是这样跟蜜虫交流的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460351,
					"content": "「员工」。「蜜虫员工」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460352,
					"content": "也有不想当员工的蜜虫，我理解它们的心情，尊重它们的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460353,
					"content": "…那能不能先理解一下我的心情？我现在心情很复杂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460354,
					"content": "真的吗？我觉得你现在应该感到骄傲才对。看那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460355,
					"content": "——。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "豚兽"
				},
				{
					"id": 752460356,
					"content": "哈哈！对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460357,
					"content": "——。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "豚兽"
				},
				{
					"id": 752460358,
					"content": "天哪天哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460359,
					"content": "聊得热火朝天的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460360,
					"content": "骄傲多少有点，但我觉得…欸？欧洛伦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460361,
					"content": "别担心，我有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460362,
					"content": "你好，豚兽大王。要吃点零食吗？新鲜的饼干，伊法刚做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460363,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "豚兽"
				},
				{
					"id": 752460364,
					"content": "豚兽大王？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460365,
					"content": "吃了！看起来很高兴的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460366,
					"content": "哎呀！哎呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460367,
					"content": "话说回来，谁还记得我们是在比赛钓鱼啊？这里都快成动物乐园了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460368,
					"content": "不也挺好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "也是…那，这次钓鱼比赛的冠军，应该是欧洛伦对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460371,
					"content": "因为他钓上了那个什么…豚兽大王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460372,
					"content": "真是个好名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "可以，就算他吧，反正大家钓上的都不是鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460374,
					"content": "哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "咔库库"
				},
				{
					"id": 752460375,
					"content": "那蜜酒就归我了，真好！不过，东西本来就是我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460376,
					"content": "能留住手里的好东西也是一种好运呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460377,
					"content": "你说得对，而且我们还有额外收获。看，豚兽大王好像给我们拿了礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 752460378,
					"content": "「闪闪礼蛋」和一张画片？画片上拍到的地方有些眼熟呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460379,
					"content": "难道是豚兽大王要我们去这个地方吗？看上去是某种指引呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460380,
					"content": "不如找找看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "我也这么想，大家有空可以留意一下画片上的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460382,
					"content": "希望豚兽大王准备了好东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "说不定有什么呢…以防万一，大家带齐装备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460369,
					"content": "气氛很融洽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				}
			]
		}
	]
}