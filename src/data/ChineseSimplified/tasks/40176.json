			"dialogs": [
				{
					"id": 401730501,
					"content": "#{NICKNAME}，有事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730502,
					"content": "我稍后要去首领那里还仪式剑，营地的其他东西就暂时留在这里。你有兴趣的话可以随便使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730503,
					"content": "我有一本《蜃楼战记》最新卷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730505,
					"content": "还有《奥西兹小姐事件簿》番外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "欸欸欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730507,
					"content": "要来一起看看吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730509,
					"content": "#（怎么回事？怎么回事？{M#他}{F#她}怎么知道我喜欢那些？难道，{M#他}{F#她}在关注我？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730510,
					"content": "（不，我怎么会有这种不切实际的想法…肯定是欧洛伦暴露了我，可恶…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730511,
					"content": "#（可…{M#他}{F#她}记住我的喜好了吗？欸？其实不记住也没关系，又不是什么重要的事…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730512,
					"content": "#（但…{M#他}{F#她}正在邀请我欸！怎么办怎么办，要怎么回应？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730513,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730514,
					"content": "好啊，有空吧，等我忙完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		}
	]
