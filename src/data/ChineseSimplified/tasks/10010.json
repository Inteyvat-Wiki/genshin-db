			"dialogs": [
				{
					"id": 100100101,
					"content": "嗯…嘟嘟可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100102,
					"content": "哎呀，可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100103,
					"content": "#荣誉骑士{M#哥哥}{F#姐姐}！小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100104,
					"content": "#妈妈说，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙，会和可莉一起帮助嘟嘟可，没想到这么快就来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100105,
					"content": "帮助嘟嘟可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100106,
					"content": "…咦，「课题」，是这个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100107,
					"content": "可莉不知道…但是可莉是可莉，不是可提？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100108,
					"content": "啊，我没有念错可莉的名字啦，可莉是可莉，课题是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100109,
					"content": "课题是课题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100111,
					"content": "…唉，谢谢你没什么用的说明啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100112,
					"content": "嗯…课题就是，唔，好难直接解释哦。总之，课题就是，可莉想要做的，要帮助嘟嘟可完成的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100119,
					"content": "哦！谢谢小派蒙，可莉虽然不明白，但好像又有点明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100120,
					"content": "那么我们这就出发吧，去帮助嘟嘟可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100121,
					"content": "等等，所以可莉呀，你说要帮助嘟嘟可，具体是要做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100122,
					"content": "嗯，每一个嘟嘟可都要找到红色的四叶草，这样才能变成与众不同的嘟嘟可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100123,
					"content": "然后，然后嘟嘟可要与很多人成为朋友，经历「嘟嘟大魔王」的试炼，才能成为了不起的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100124,
					"content": "「嘟嘟大魔法师」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100125,
					"content": "…至少妈妈是这样说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100126,
					"content": "哇，「大魔王」管着「大魔法师」…听上去还挺合理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100127,
					"content": "那么我们具体要做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100128,
					"content": "可莉不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100129,
					"content": "#但是妈妈说，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙会告诉可莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100130,
					"content": "对、对哦，可莉，看看这本书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100131,
					"content": "啊，里面夹着一张纸条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100132,
					"content": "那就让我们一起来看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100133,
					"content": "「…试炼的第一站，嘟嘟可来到了树叶呢喃的森林，在那里，要找到埋藏的秘密，在重重的障碍之下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100134,
					"content": "听上去像是什么嘟嘟可故事的一部分呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100135,
					"content": "啊，可莉知道在哪里了，一定是在可莉经常炸…经常与嘟嘟可玩耍的森林里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100136,
					"content": "#可莉，嘟嘟可，荣誉骑士{M#哥哥}{F#姐姐}，小派蒙，出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100137,
					"content": "好哦！出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100113,
					"content": "是要去做的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "对，就是要完成的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100115,
					"content": "哦，那…可莉用蹦蹦炸弹炸鱼也是「课题」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100116,
					"content": "不，那应该不是吧，也不是所有的事都能被称之为「课题」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100117,
					"content": "可莉有点弄不明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100118,
					"content": "唔，总之就是艾莉丝说的，要让可莉完成的事，就是「课题」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "派蒙"
				}
			]
		},
