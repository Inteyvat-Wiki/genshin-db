					"nextDialogs": [
						100100829
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100829,
					"content": "呜，又要进禁闭室了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100830,
					"content": "#这次因为有{NICKNAME}为你作担保，所以就罚你…跟我去猎鹿人好好吃一顿吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100831
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100831,
					"content": "跑出来折腾那么久，应该也饿了吧。",
