					"nextDialogs": [
						100100832
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100832,
					"content": "今天是好人琴团长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100833
					],
					"speakerTitle": "可莉"
				},
				{
