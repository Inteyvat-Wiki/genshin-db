					"nextDialogs": [
						100100503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100503,
					"content": "可莉有好好控制蹦蹦炸弹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100504
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100504,
					"content": "现在可莉进禁闭室的次数，已经越来越少啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100505
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100505,
					"content": "可莉，了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100506,
					"content": "但是什么时候可莉能够不进禁闭室呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100507,
					"content": "要是琴团长同意可莉炸掉禁闭室的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100508,
					"content": "不是在说用这种方法实现啦！啊对了，嘟嘟可的试炼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100509,
					"content": "啊，可莉拿到了，就在刚才蹦蹦炸弹炸出的土坑里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100510,
					"content": "是新的纸条呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100511,
					"content": "嗯，上面的是妈妈写的字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100512,
					"content": "「嘟嘟可有没有把所有的障碍炸飞呢，有的时候直接才是最具有美学的做法呢。然后，嘟嘟可到了试炼的第二站…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100513,
					"content": "「其实也就是最后一站，即使是再有活力的孩子，也要好好控制每日活动的时间，那么…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100514,
					"content": "「在星星坠入的湖水之畔，嘟嘟可经过了试炼，得到了最终的褒奖，但是事情真的会如此简单吗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100515,
					"content": "说起星星和湖的话，那就是星落湖了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100516,
					"content": "那我们就去湖边看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100517,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100518,
					"content": "真好奇这个最终的褒奖是什么，说不定是了不起的宝藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
