			"dialogs": [
				{
					"id": 200010901,
					"content": "旅行者，谢谢你赶走了这些家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010902,
					"content": "多亏你来了，呃…但路障竖在这，我还是走不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010903,
					"content": "这么下去，我辛辛苦苦摘下来的水果都要烂掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010904,
					"content": "你能帮我把这个路障给处理掉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010905,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "哈哈，那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010906,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "啊…啊？我说，帮人帮到底嘛，无论如何，我只能指望你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				}
			]
		},
