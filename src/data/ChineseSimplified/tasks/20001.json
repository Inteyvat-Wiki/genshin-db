			"dialogs": [
				{
					"id": 200011001,
					"content": "太感谢了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011002,
					"content": "我就是想来这摘点水果，带回城里卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011003,
					"content": "没想到却被这个路障拦住，然后那群家伙就跳出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011004,
					"content": "我这就回蒙德城去了，记得来城里光顾我的生意啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011005,
					"content": "这些就当做谢礼吧，我的水果都是这么新鲜的…所以贝雅特丽奇那家伙，才会一直过来缠着我买。",
					"roleType": "TALK_ROLE_NPC",
