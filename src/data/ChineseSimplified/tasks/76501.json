			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菈乌玛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#是你们啊，{NICKNAME}和派蒙。林间的飞鸟刚刚就在谈论你们的到来。今日前来，可是有什么要事，或是…需要我稍作指引？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010102,
					"content": "我们正在四处参观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "这里深受月华浸润，无论是植被还是栖息于此的生灵，都与外界不尽相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010105,
					"content": "的确是个能留下许多珍贵画片的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010106,
					"content": "二位请随意徜徉，若有任何好奇之处，随时可以问我，我会尽我所能解答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010107,
					"content": "这里的气氛非常宁静呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "是的，这里是我的静思之地，也是我与万物低语、交流的所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010110,
					"content": "仅仅是站在这里，心神就会归于安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010111,
					"content": "哇，听起来好有诗意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765010112,
					"content": "其实，我有一个小小的请求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "是啊，菈乌玛小姐站在这里，和这里的景色浑然一体，简直美得像一幅画！用留影机拍下来一定特别好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765010115,
					"content": "为我…留下画片么？这倒是新奇的体验。若你们认为此刻的宁静，以及我的身影，值得被你们的镜头记录，我很乐意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010116,
					"content": "能成为你们旅途中一段美好的回忆，也是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010117,
					"content": "那么，我该如何配合呢？是需要我望向某个方向，还是保持自然的姿态便可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010118,
					"content": "像平时一样就可以了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "好的，那接下来就交给你了。愿你能捕捉到那瞬息的灵感之光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 765010119,
					"content": "我会努力捕捉最动人的一刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "我们希望能为你拍摄画片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "菈乌玛平时都会待在这附近吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "顺便寻找拍摄素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
