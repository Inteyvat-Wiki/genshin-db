			},
			"dialogs": [
				{
					"id": 790130201,
					"content": "嗯，甜甜花酿鸡真的很好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130202,
					"content": "确实能理解为什么这个叫「沃尔夫冈」的冒险家会念念不忘呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130203,
					"content": "不过被关在这里，最后连甜甜花酿鸡都吃不到，真是可怜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130204,
					"content": "这本笔记很旧了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#是哦…但是这么说来…{NICKNAME}，还记得我们从岛上的水池那样的东西进入另一边的岛吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130217,
					"content": "水池里岛上的建筑比起水池外的岛，看上去要完整很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130218,
					"content": "现在岛上的建筑跟那里的建筑比起来，就像遗迹一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130219,
					"content": "会不会水池里的建筑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "很有可能！说不定水池里岛上的建筑，就是水池外岛上遗迹很久以前的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}，你说会不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130223,
					"content": "水池里的岛，是以前的岛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130207,
					"content": "而且，你看…我们要是找到了以前的这个密室在哪，不就能够救到这个冒险家了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130208,
					"content": "只是发生在幻境的影响里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "可是…就算一切都是假的，这个冒险家说不定也不存在，但看到他说的那么可怜，也是想帮一下的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130212,
					"content": "确实，派蒙说得对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#嗯！我就知道{NICKNAME}也会这样觉得的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130216,
					"content": "我们这就去水池里的岛那儿看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130214,
					"content": "那就去看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "嗯，要是能帮到这个叫「沃尔夫冈」的冒险家就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790130209,
					"content": "是改变不了现实的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "水池里的建筑就是原本的样子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "应该是很久之前的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
