			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "什么呀，这家伙只顾着说一些帅气的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131602,
					"content": "不行，我们得去雪山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131603,
					"content": "幻境中的改变，改变不了过去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "…啊…对哦，金苹果群岛整个都被那个装置影响，沃尔夫冈才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131606,
					"content": "所以我才以为沃尔夫冈已经被救出密室了…其实到最后，他都在最初的密室里没有出来吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131607,
					"content": "不过！不过这个「沃尔夫冈」还是让人生气…我们都那么帮助他了，他还觉得「帮别人踩坑」就不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131608,
					"content": "他就不能，更珍惜自己的生命一点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131609,
					"content": "每个人都有追求之物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "我明白啦，我知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131612,
					"content": "但是我还是觉得他们应该有更好的结局嘛，比如回到蒙德，成为大冒险家…然后还能去餐馆逗猫，尽情地吃甜甜花酿鸡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131613,
					"content": "为什么他们就不能有个好结局呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131610,
					"content": "正是因为有他们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "「沃尔夫冈」是到不了雪山的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
