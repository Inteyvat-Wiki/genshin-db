			"dialogs": [
				{
					"id": 790131801,
					"content": "（老旧的刻痕，留下刻痕的人写着…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131802,
					"content": "「风很大，就不用笔记本了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131803,
					"content": "「这里日出很美，历经艰险来到此处，心中十分满足。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131804,
					"content": "「不知在我之后，是否有人能来这儿看到同样的景色呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131805,
					"content": "「…如此险境我也来过了，下次，就去龙脊雪山吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131806,
					"content": "「此处甚好，可惜没有甜甜花酿鸡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "刻痕"
				},
				{
					"id": 790131807,
					"content": "「沃尔夫冈留。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "刻痕"
				}
			]
		},
