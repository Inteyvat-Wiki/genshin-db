					"nextDialogs": [
						790131102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131102,
					"content": "#{NICKNAME}，这里好像还没有沃尔夫冈的笔记…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131103,
					"content": "说明他还没来过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "那我们就算提前帮他解开密室了…这下他就不会被关起来了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131105,
					"content": "若是反复触发的机关…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "那怎么办呀…唔，不如我们给他留言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131108,
					"content": "我们用刻痕，把留言留在比较显眼的地方，告诉他解开机关的方法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790131106,
					"content": "就算这次解开了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
