			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽莎",
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "啊…就是这种甜味，真不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060202,
					"content": "咖啡非常醇厚，苦味也恰到好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060203,
					"content": "两位满意就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "…丽莎会那样说，其实我也明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060205,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060206,
					"content": "最近我常常反思自己的不足。工作效率也好，办事手腕也好…各方面都有提升空间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060207,
					"content": "看来我身上这份压力，已经在不知不觉中扩散给丽莎了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060208,
					"content": "这不完全没明白吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060210,
					"content": "是啊。喏，小可爱一眼就看出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060211,
					"content": "我是看你太过操劳，想带你品品酒，喝喝茶，体验点开心的事情而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060212,
					"content": "结果来到酒馆，你还满心想着工作，这才有些失落的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060213,
					"content": "总像这样紧绷神经，早晚会累趴下的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060214,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#{NICKNAME}，连你也这样想吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060216,
					"content": "唔，所以说…学会休息，对我来说才是最大的挑战吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060217,
					"content": "借一句璃月俗语：「张弛有度」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "嗯！该工作的时候工作，该休息的时候休息。简单来说，就是你们俩加一加再除以二啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060219,
					"content": "好怪的说法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060221,
					"content": "我，我明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060222,
					"content": "谢谢你们。没想到来这里除了喝饮品，还能让心情轻松不少。这就是丽莎和凯亚喜欢酒馆的原因吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060223,
					"content": "是，也不全是。更重要的还要看调酒的是谁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060224,
					"content": "今天也是托小可爱的福才能说动琴，你可真有口才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060225,
					"content": "这没什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "呵呵，那我们就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060228,
					"content": "今后有机会的话，我也会考虑再来这里放松一下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060229,
					"content": "好耶，两位慢走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060226,
					"content": "能帮到你们就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}