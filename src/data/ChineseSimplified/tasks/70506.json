				"points": []
			},
			"dialogs": [
				{
					"id": 705060101,
					"content": "嗨，小可爱，见到你真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060102,
					"content": "虽然很少会在这种地方见面，但我此刻的心情，和丽莎是一样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060103,
					"content": "欸，怎么能叫「这种地方」呢？酒馆明明是娱乐休闲的好去处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060104,
					"content": "你一定想不到，我可是费尽力气劝了半天，才把这位大忙人从她那把椅子上请起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060105,
					"content": "才到这里坐了没多久，琴那张脸上呀，又写满了担忧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060106,
					"content": "丽莎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060107,
					"content": "毕竟骑士团事务繁多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "是啊，琴团长是代理团长嘛，当然会挂念团里的事啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060109,
					"content": "不过那句话怎么说的来着…「来都来了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060110,
					"content": "#让{M#他}{F#她}为你们调两杯好喝的吧，喝完就开心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060111,
					"content": "就当换换心情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "唉，需要学会放松的，就只有琴啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060113,
					"content": "小可爱，麻烦给我一杯情诗吧，中杯，要甜一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060114,
					"content": "琴呢？来点什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705060115,
					"content": "我的话…咖啡就好，也要中杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060116,
					"content": "琴团长平时咖啡喝得够多了吧，要不要换点别的口味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705060117,
					"content": "谢谢你，不过，我还是想喝点提神的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 705060118,
					"content": "明白了，请稍等片刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "嗯，辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
		},
		{
			"id": 7050602,
			"completionStepIds": [
				7050604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050604",
