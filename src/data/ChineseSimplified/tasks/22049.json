			"dialogs": [
				{
					"id": 220490301,
					"content": "你们回来了，烟花怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490302,
					"content": "很好看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "你们喜欢就好，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490306,
					"content": "好了，我也该去打理打理店里了，最近来买烟花的人真是越来越多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490307,
					"content": "那丫头怎么到现在还没回来，到底去哪鼓捣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490304,
					"content": "还没玩够…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "你们很喜欢吗？那就好，下次你们再来拿点去玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "长野原龙之介"
				}
			]
		}
