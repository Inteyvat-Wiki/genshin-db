			"trigger": {
				"objectNames": [
					"长野原龙之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "哦呀，这不是丫头的新朋友吗？今天又来玩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490102,
					"content": "今天的生意还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "很好，很好！哈哈哈，都是我那丫头把烟花鼓捣得好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490104,
					"content": "你们今天，是来找她的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490107,
					"content": "真不巧，那丫头说，她要去外面找做烟花的材料，已经出门去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490108,
					"content": "那她去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "什、什么？你说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490110,
					"content": "宵宫，她去哪里了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "喔，哎呀…这个我可不太清楚哟，那丫头也许说过了，但我这耳朵啊，真是听不清…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490112,
					"content": "你们找那丫头有什么事吗？是想要，买点烟花玩玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490113,
					"content": "想找宵宫玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "唔，这次你们估计是找不着她啦，那丫头每次出去鼓捣烟花，都不知道什么时候才回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490115,
					"content": "这样，那丫头出门之前，做了一些新烟花放在店里，你们就先拿这些烟花去玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490118,
					"content": "我把那些烟花放哪了…好像放屋里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490119,
					"content": "这样是不是不太好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "没关系，没关系，店里还备着很多货，你们拿一两个去玩玩，没什么大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490122,
					"content": "再说了，我那丫头本来就打算找人来试玩这些新烟花的，你们今天过来，也正好来试玩一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490123,
					"content": "你们就放心大胆地拿着这些烟花出去玩，玩好了之后，回来告诉我烟花怎么样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490124,
					"content": "等那丫头回来，我再转告她一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490125,
					"content": "放心吧，那丫头要是知道那些烟花是你们拿去玩的，高兴还来不及呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490126,
					"content": "快点去吧，你们放烟花的时候可要在城外放。在城里放烟花啊，又要招来好些人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490120,
					"content": "也没告诉宵宫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "想玩烟花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "哈哈，那好说啊。那丫头出门之前，做了一些新烟花放在店里，你们就拿这些烟花去玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "长野原龙之介"
				},
				{
					"id": 220490105,
					"content": "请问宵宫在吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "哎呀，你们今天是来找她的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "长野原龙之介"
				}
			]
		},
