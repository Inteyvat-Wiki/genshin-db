			"dialogs": [
				{
					"id": 745280401,
					"content": "是你啊。我们的旅途，又交汇到了一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280402,
					"content": "丝柯克，好久不见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "我在观察这个世界留下的「伤疤」。那次爆炸将这里夷为废墟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280405,
					"content": "但如今，人们又在废墟之上建起了新的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280406,
					"content": "万物皆有终点，但凋亡之后，亦会孕育新的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280407,
					"content": "你的力量比上次见面时又成长了些。看来你没有懈怠锻炼。不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280408,
					"content": "其实，我有一个小小的请求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "留影吗？对这个世界而言，我只是过客，又何必留下存在的印记呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280411,
					"content": "但对我而言，你不是过客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "…既然是你想做的事，那就去做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280414,
					"content": "我就在这里。随时可以开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丝柯克"
				},
				{
					"id": 745280412,
					"content": "每次重逢都值得纪念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "我希望能为你拍张画片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "你在这里做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
