			"dialogs": [
				{
					"id": 401030501,
					"content": "卡莉娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030502,
					"content": "呼…你们终于回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030503
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030503,
					"content": "真是让我一顿好找，你们刚刚去哪了？第三轮比赛已经开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030504
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030504,
					"content": "我们刚刚去抓了一些盯上萨齐因的坏人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030505,
					"content": "不对，这不是重点！才识之冠可能有问题，我们想好好调查一下它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030506,
					"content": "才识之冠有问题？不应该吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030507
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030507,
					"content": "二十年来，每届比赛都会用到才识之冠，从来没出过什么问题啊？你们哪里来的消息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030508
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030508,
					"content": "是我们的一些推测。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030509
					]
				},
				{
					"id": 401030509,
					"content": "这件事很重要，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030510
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030510,
					"content": "实不相瞒，在第三轮比赛开始之前，我们已经将冠冕放在无郁稠林里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030511
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030511,
					"content": "第三轮比赛的内容，正是到无郁稠林中找出冠冕，然后将冠冕带出来，放到指定的台子上。最先将冠冕放好的人会得到4点积分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030512
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030512,
					"content": "考虑到之前参赛者的分数没有拉开差距，第一个放好冠冕的人很可能就是最后的冠军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030513
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030513,
					"content": "所以我猜这轮比赛应该很激烈。你们未必赶得上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030514
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030514,
					"content": "总要试一试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030515
					]
				},
				{
					"id": 401030515,
					"content": "我会将冠冕的位置标注出来，也请你们立刻前往现场查看情况，希望不要出什么事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030516
					],
					"speakerTitle": "卡莉娜"
				},
				{
					"id": 401030516,
					"content": "好！我们马上出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
