						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401030201,
					"content": "你们来了。很抱歉我刚审完犯人，还没来得及派人去通知你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030202
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030202,
					"content": "问出什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030203,
					"content": "怎么说呢，很多让人意想不到的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030204
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030204,
					"content": "干绑票的那些佣兵比想象中好抓，我让人假扮成萨齐因，没多久就把他们钓出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030205
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030205,
					"content": "问题是审完之后才知道，雇他们来的人，好像就是萨齐因自己的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030206
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030206,
					"content": "孩子找人绑架自己的父亲？为什么要这么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030207,
					"content": "谁知道呢…进城的佣兵只是一小部分，还有很多人留在城外接应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030208
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030208,
					"content": "我们正准备抽调人手，去将他们一网打尽。你们要不要也一起来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030209
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 401030209,
					"content": "好吧，正好我们也去看看到底是怎么回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4010304,
