			"dialogs": [
				{
					"id": 401030601,
					"content": "这样就结束了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030602
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030602,
					"content": "卡维…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401030603,
					"content": "你没事吧？身体感觉怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030604
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401030604,
					"content": "我…没事…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030605
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030605,
					"content": "谢谢你提纳里，别担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030606
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030606,
					"content": "别太勉强自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030607
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 401030607,
					"content": "卡维先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030608
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401030608,
					"content": "虽然冠冕被卡维选手摔碎，但他在摔碎前就已完成比赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030609
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030609,
					"content": "按规则，他是第三轮比赛的胜者，从总积分来看，也是本届学院争霸赛的冠军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030610
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030610,
					"content": "作为学院争霸赛的冠军，以及萨齐因亲自拟定的继承者，卡维选手享有对萨齐因所有财产的继承权。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030611
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030611,
					"content": "我再问一次，你确定要捐出萨齐因所有的财产吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030612
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030612,
					"content": "我刚刚说过了。他觉得这个世界不好，那就用他留下来的产业去做一些改变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030613
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030613,
					"content": "单纯的否定不能促成任何结果。我和他…不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030614
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030614,
					"content": "好。作为书记官，我会将这件事记入档案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030615
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030615,
					"content": "至于这些财产具体的使用细节，赛后将由贤者亲自与你沟通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030616
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030616,
					"content": "…就这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030617
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030617,
					"content": "我不知道那个人的研究是否正确，也不知道该怎么帮他去完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030618
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030618,
					"content": "我只知道，让一切停在这里，所有参赛者就不会感到痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030619
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030619,
					"content": "我们不会是最后一届，将来还会有人来到这个比赛…还会有未来的学者继续为这个赛事前赴后继。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030620
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030620,
					"content": "萨齐因的话会让人痛苦。所以…到此为止，不要再继续传播下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030621
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030621,
					"content": "我们都是学者，贸然推翻他的观点也是独断傲慢。没关系，这份责任我来背负就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030622
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030622,
					"content": "对我来说这样就好。我也…只能做到这么多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030623
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030623,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030624
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030624,
					"content": "说得不错，陈述了大部分人渴望却未必敢去执行的正义和理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030625
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030625,
					"content": "虽然在我看来还是那么可笑。你早已察觉到自身的问题，仅仅是碍于自尊心不愿承认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030626
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030626,
					"content": "不过你的这些观点很适合在领奖台上发表。我谨代表本次比赛组委会祝贺你获得冠军，卡维选手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030627
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401030627,
					"content": "哈？别搞错了，我不需要没有诚意的赞扬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030628
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030628,
					"content": "另外现在不是辩论的场合，请你专注评论比赛而不是我的观念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030629
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401030629,
					"content": "恭喜你，卡维先生！也请您准备一下出席颁奖仪式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露"
				}
			]
		},
		{
