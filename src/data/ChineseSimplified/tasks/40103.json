			"dialogs": [
				{
					"id": 401035101,
					"content": "艾尔海森、妮露，你们看到其他参赛者了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401035102,
					"content": "没有，暂时还没有人完成比赛…发生什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035103
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 401035103,
					"content": "那个冠冕可能有问题…对了，艾尔海森，你也在这里，你应该知道什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401035104,
					"content": "你指什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035105
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401035105,
					"content": "你——算了！我们先去把冠冕找回来，然后再来问你！",
					"roleType": "TALK_ROLE_NPC",
