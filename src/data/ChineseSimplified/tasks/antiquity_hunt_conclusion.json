			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丹纳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "喔？你已经把所有「文物模型」都找到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950202,
					"content": "了不起！你很有考古方面的天赋嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950203,
					"content": "那么，这份礼物就送给你了，感谢你来参加我们学院举办的活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950204,
					"content": "希望你从这次的活动里感受到了一些考古的乐趣啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950205,
					"content": "虽然在真实的考古工作里，大部分时候都枯燥乏味又辛苦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950206,
					"content": "但在挖掘到关键性文物的那一刹那，又会感觉到一切的辛苦都是值得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950207,
					"content": "那要是没挖出来呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "没挖出来的话…那就和俗话说的一样，这一趟「白忙活」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950210,
					"content": "而且这种白忙活的情况才是常态，能顺利挖到关键性文物的次数少之又少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950211,
					"content": "不过做考古工作嘛，就是要习惯这种情况，时刻保持着乐观的心态，不然工作不了多长时间，就要撑不住喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丹纳"
				},
				{
					"id": 736950208,
					"content": "也有没挖出来的情况吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
