					"content": "我来帮忙置办吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "咦？哦…你愿意帮忙那就最好了，我正发愁怎么置办食材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413310304,
					"content": "我看看…请你帮我准备三份兽肉和三份禽肉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413310305,
					"content": "其余的材料，我会想办法准备的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				}
			]
		},
