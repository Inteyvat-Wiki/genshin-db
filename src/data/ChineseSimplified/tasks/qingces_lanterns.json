			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "又到了海灯节了，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310202,
					"content": "您在担心什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "到海灯节啦，按理说，是该热热闹闹地过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310204,
					"content": "但是这轻策庄里…老的老，小的小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310205,
					"content": "去城里工作的那些孩子们，要么是说工作忙请不到假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310206,
					"content": "要么就是离得远，怎么样都赶不及回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310207,
					"content": "明明是个大家伙聚在一起，团团圆圆热热闹闹的节日，结果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310208,
					"content": "我也理解他们在外的难处，但是大过节的，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310209,
					"content": "哎呀，不说了，不说了。大过节的可不能这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310210,
					"content": "对了，如果你愿意的话，能去帮一下小白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310211,
					"content": "那孩子说想要给大家置办桌好菜，正在那忙呢，我担心她一个人会有点忙不过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310212,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "那就拜托你了，实在是太谢谢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 413310213,
					"content": "您别担心，我这就去帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
