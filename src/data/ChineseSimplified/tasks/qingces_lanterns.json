					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313702
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313702,
					"content": "呵呵，我们就一起放了这盏霄灯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313703
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313703,
					"content": "希望新的一年里，大家都能身体健康，万事如意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313704
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313704,
					"content": "还有在外奔波的那些孩子们，也能万事如意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313705
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313705,
					"content": "好了若心奶奶，再不去吃，我准备的那些饭菜可都要凉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413313706,
					"content": "哇，有好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "小六"
				},
				{
					"id": 413313707,
					"content": "奶奶，那我们去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "东东"
				},
				{
					"id": 413313708,
					"content": "你们这群孩子啊…好，好，快去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313709,
					"content": "您不去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "我？我不急，我想再看会霄灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313711,
					"content": "对了孩子，这些给你，收下吧，谢谢你在这里忙前忙后的帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313712,
					"content": "谢谢奶奶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "不用谢，我看你的年纪也不大，这样子在外面跑，一定很辛苦吧，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313714,
					"content": "不然，你就在这再待一会，和大家一起过个节吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313715,
					"content": "奔波了一整年，能歇息一会总是好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
