							9052.41
						],
						"pointId": 350200533
					}
				]
			},
			"dialogs": [
				{
					"id": 765080301,
					"content": "#啊呀，啊呀呀！这不是大名人{NICKNAME}嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080302
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 765080302,
					"content": "我以为请到妮露小姐已经是万幸中的万幸了，没想到，还有高手中的高手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080303
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 765080303,
					"content": "#多夸夸{NICKNAME}，我爱听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080304
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080304,
					"content": "欸？这不是我的台词吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080305,
					"content": "没错！同样的字词由派蒙参谋说出来，听感灵巧轻盈，好比悠可琴的音轨，软软弹弹可可爱爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080306
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080306,
					"content": "而由我来说，听感就像是…鼓手喝了半桶酒后打出来的段子，顿挫管够，劲道踏实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080307
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080307,
					"content": "当然，按伊安珊大师的教诲，底鼓的双踩也多多益善，最好像自动枪一样连绵不停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080308
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080308,
					"content": "这样，就算我们说了一样的台词，也不嫌重复啰嗦，而是互相补全了多个声部，还能让你卡准节奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080309
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080309,
					"content": "还，还有这种事？被你说晕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080310,
					"content": "努斯妲大姐聊到点子上了——节奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080311
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 765080311,
					"content": "我们的舞蹈自由而张扬，但也不能完全无拘无束，至少，最关键的动作需要精准卡点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080312
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 765080312,
					"content": "最近的新舞已经编排好动作了，但前来体验的新人和…新龙们，都不太擅长找准节奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080313
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 765080313,
					"content": "#正好，就由{NICKNAME}来给出节奏的指导吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080314
					],
