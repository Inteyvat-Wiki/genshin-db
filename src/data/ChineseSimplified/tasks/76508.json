					}
				]
			},
			"dialogs": [
				{
					"id": 765080101,
					"content": "最近「流泉之众」是在举办什么活动吗？好像多了一些游客？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080102,
					"content": "那边有一位须弥客人…在给大家表演舞蹈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080103,
					"content": "啊呀呀，闪亮亮的大英雄和可爱的派蒙参谋也来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080104,
					"content": "向您致以最真挚的问候，我最敬重的战士、武力和舞力的双重勇者，以及生活享受家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080105,
					"content": "咦，这位小姐有点眼熟欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080106,
					"content": "#而且，你怎么知道{NICKNAME}跳起舞来很开心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080107,
					"content": "#当然是在圣火竞技场前看过{M#他}{F#她}欢快的舞姿啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080108,
					"content": "#合过影后，我找了个不那么显眼的地方，一边吃龙龙饼干，一边看完了{NICKNAME}的祝福舞蹈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080109,
					"content": "#跳舞就是要轻轻松松，释放自我嘛！我都想上去为{NICKNAME}伴舞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080110,
					"content": "想起来了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "我的荣幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080114,
					"content": "言归正传，如您所见，最近有些须弥朋友盛情来访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080115,
					"content": "经过穆托塔、阿米娜、帕加尔和玛拉妮的商量，我们「花羽会」决定联合「回声之子」与「流泉之众」，好好招待他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080116,
					"content": "看起来，有不少「镀金旅团」的佣兵呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080117,
					"content": "让我猜猜，是不是在沙漠旅行时，不打不相识，打成了朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080118,
					"content": "哎，八九不离十了！不过，不是我们之间互斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080119,
					"content": "我们在千壑沙地南边大办烤肉聚会时，引来了一群凶狠的赤鹫，它们专挑我们吃撑喝撑，跑不动道的时机下手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080120,
					"content": "打法还十分狡猾，我们一番苦斗无果，被它们利用熟悉地形的优势打得疲惫不堪，只能先撤离。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080121,
					"content": "没想到，一队佣兵出现在我们后退的路上，对着赤鹫们跳起了神秘的战舞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080122,
					"content": "结果那些赤鹫好像和他们达成了共识，退了回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080123,
					"content": "用，用战舞让赤鹫离开了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080124,
					"content": "是舞姿怪异吓退了它们…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "特别神奇，对不对？我们也很好奇那种舞蹈的奥秘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080127,
					"content": "收拾好营地后，我们一起大口吃肉大桶喝酒，等到酒足饭饱，就开始交流舞蹈的技巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080128,
					"content": "要是中途还有别的魔物和野兽来打搅我们的兴致，我们就一起抄家伙上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080129,
					"content": "不出两个礼拜，我们就成了过命的战友和舞友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080130,
					"content": "分别前，我们约好，以后还要正式造访各自的营地，继续「舞术交流」，这次就是开头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080131,
					"content": "#你别说，{NICKNAME}，好像以前我们还没参加过这种…须弥和纳塔朋友互相交流跳舞的活动？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080132,
					"content": "确实新奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "这可是难得的好机会，来为我们指导一番，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080135,
					"content": "玛拉妮也在场哦，她算是我们之中最为欢乐的舞蹈代言人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080136,
					"content": "而且，「镀金旅团」的朋友还花重金邀请了当地有名的舞者，来作为须弥方的领队和顾问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080137,
					"content": "我想，你们肯定也认识那位舞者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080138,
					"content": "好像已经猜到是谁了，嘿嘿，待会儿我们给她一个大惊喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765080139,
					"content": "好啊好啊，我要加入！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "哈哈哈哈！这下更热闹了，用玛拉妮的话来说，气氛达到了最嗨点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080142,
					"content": "走吧，我们去找塔拉内小妹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 765080140,
					"content": "这种活动，不能错过！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "想要看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "还是两边本来就认识？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "以后肯定记住。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "那说明我干活还不够卖力，没留下什么亮眼的成就，仍需努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "努斯妲"
				}
			]
		},
		{
			"id": 7650803,
			"completionStepIds": [
				7650802
