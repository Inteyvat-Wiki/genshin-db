					"nextDialogs": [
						10031003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031003,
					"content": "神神鬼鬼的，我可见得多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031004
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10031004,
					"content": "啊，说起来，别人好像也不知道仙人在客栈出没，但戈黛特老板…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031005
					],
					"speakerTitle": "派蒙"
				},
