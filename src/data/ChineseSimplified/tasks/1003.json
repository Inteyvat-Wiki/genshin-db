			"dialogs": [
				{
					"id": 10039301,
					"content": "关于你丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039302
					]
				},
				{
					"id": 10039302,
					"content": "他就在那边，是客栈的掌柜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039303
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039303,
					"content": "别看他笑嘻嘻的，其实拳脚功夫很厉害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039304
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039304,
					"content": "我也是，我们的厨子也是，都是这么招进来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039305
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039305,
					"content": "不会功夫还怎么招待好客人呢，你说是不是这个道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				}
			]
		},
