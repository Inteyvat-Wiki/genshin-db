			"trigger": {
				"objectNames": [
					"菲尔戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "关于那位仙人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "哦？你们已经见过魈了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030403,
					"content": "不错嘛，难得他心情好，居然愿意出来见人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030404,
					"content": "原来这样的态度就已经是「心情好」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030405,
					"content": "是啊，仙缘难得，许多人一心访仙，却终生未见仙人一面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030406,
					"content": "岩神建立璃月时，借助了仙人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030407,
					"content": "但因为仙人中的大多数，都只懂得以战斗来守护璃月…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030408,
					"content": "所以数千年来，终究还是人类掌握了贸易之都的运作，而仙人隐居在外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030409,
					"content": "老板娘懂得真多啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030410,
					"content": "不是「老板娘」，是「老板」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030411,
					"content": "总之，既然你们这么有仙缘，那事情就好办多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030412,
					"content": "要问我的建议嘛…嗯，其实只要试着去哄魈开心就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030413,
					"content": "开心…？那位「护法夜叉」大人，很难想象他开心起来是什么样子的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030414,
					"content": "哼哼，很期待吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030415,
					"content": "（其实我也从没见他笑过…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030416,
					"content": "这样吧，先去找大厨要一份杏仁豆腐，再加上一道你拿手的菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030417,
					"content": "杏仁豆腐是魈难得喜欢的人间食物，拿手的菜就靠你自由发挥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10030418,
					"content": "#唔，自由发挥…{NICKNAME}，你最擅长做什么菜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030419,
					"content": "「满足沙拉」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "是那种很难出错的食物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030423,
					"content": "不过，送给仙人的礼物还是保守一点，就用「满足沙拉」好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030421,
					"content": "「大红莲麻辣火史莱姆」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "哇，听起来很新奇，想吃吃看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 100306,
			"completionStepIds": [
				100306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100306",
							"2"
						],
						"stepId": 100306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030601,
					"content": "大爷我正在休息，闲人勿扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030602,
					"content": "请问，杏仁豆腐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "闲人勿扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030604,
					"content": "呜…这位大厨的服务热情，和蒙德的铁匠瓦格纳先生不相上下呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030605,
					"content": "菜是戈黛特老板点的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030607,
					"content": "原来如此。老板吩咐下来的事，那就没办法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030608,
					"content": "但很可惜，我现在有心无力，没法做出杏仁豆腐这种细致甜食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030609,
					"content": "这是为什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030610,
					"content": "剑客的手必须稳定，咱当厨子的自然也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030611,
					"content": "但现在我的手，不好意思…有点不太稳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030612,
					"content": "原因嘛…是因为有客人传言，这客栈里…闹鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030613,
					"content": "而且就在刚才！刚才…我在厨房…也看见了…不太对劲的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030614,
					"content": "（这位大厨看起来这么凶恶，说起灵异话题来，语气就变得很虚弱呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030615,
					"content": "总之…一想到连望舒客栈都不安全了，我磨甜杏仁的手就稳定不下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030616,
					"content": "#好吧，{NICKNAME}。为了最高品质的精美杏仁豆腐，我们就去厨房看一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 100308,
			"completionStepIds": [
