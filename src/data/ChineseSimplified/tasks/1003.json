			"dialogs": [
				{
					"id": 10039401,
					"content": "请问你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039402
					]
				},
				{
					"id": 10039402,
					"content": "我叫戈黛特，来自蒙德。是望舒客栈的老板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039403
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039403,
					"content": "不是老板娘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039404,
					"content": "是、老、板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039405,
					"content": "有些传闻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "哈哈哈，能在这里开店，怎么可能和七星没有关系呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039407,
					"content": "我意思是，肯定需要他们同意嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039408,
					"content": "其他一些有的没的，那当然都是谣言啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039409,
					"content": "这么说来，您听到过什么有意思的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039410,
					"content": "关于这猫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "唉…这猫是自己跟来的，不过看着挺可爱的就留下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039412,
					"content": "名字吗，叫阿伟，随便起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039413
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 10039413,
					"content": "它可能会捣蛋一下，猫嘛，是这样的。您可千万别和它一般见识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				}
			]
