					"nextDialogs": [
						10030307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030307,
					"content": "过分接近仙与魔的世界，即为逾矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030308
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10030308,
					"content": "人的灵魂不如仙人强韧，血液中也难以承载如此浓度的仙家气运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030309
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10030309,
					"content": "算是为你们好，抓紧离开吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030310
					],
					"speakerTitle": "魈"
				},
