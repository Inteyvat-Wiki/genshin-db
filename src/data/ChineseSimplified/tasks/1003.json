					"nextDialogs": [
						10030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030312,
					"content": "好想给他起个难听的绰号…但要是得罪了仙人，以后发现宝箱的时候，会不会只能开出卷心菜…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030313,
					"content": "唉…我们还是去请教一下客栈的老板娘，问问她怎么和仙人正常交流吧。",
