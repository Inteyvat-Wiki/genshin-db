					"汤雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "啊！没错！这、这就是我梦寐以求的家乡味道啊…真是…呜呜…真是令人感动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330302,
					"content": "谢谢你！有了这些好吃的，我也能提起劲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330303,
					"content": "这些送给你，祝你往后的旅程顺遂无忧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
			],
			"beginWay": "TALK_BEGIN_AUTO",
