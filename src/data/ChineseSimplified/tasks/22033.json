					"汤雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330801,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330802
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330802,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330803
					]
				},
				{
					"id": 220330803,
					"content": "你是？这身打扮…你就是旅行者吧。抱歉，我就是有点想家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330804,
						220330805
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330804,
					"content": "你刚刚说想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				},
				{
					"id": 220330818,
					"content": "欸？莫非...你会做璃月菜吗？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330819
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330819,
					"content": "那、那就请你快点帮帮我，做点正宗的璃月菜给我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330820
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330820,
					"content": "让我想想...我现在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330821
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330821,
					"content": "我想吃点心。古朴甜蜜的璃月点心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330822
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330822,
					"content": "最近我一闭眼，就像做梦一样，总能看见一位风姿绝世的点心公子，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330823
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330823,
					"content": "脚踩锅巴靴，头戴豆腐冠，身披米窝氅，手摇花酥扇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330824,
						220330825
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330824,
					"content": "这位听着就招老鼠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330826,
					"content": "他从街边的点心铺子间走出来，带着清香，从我身边过，我就再也忘不了那味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330827
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330827,
					"content": "拜托了，请把点心公子带来吧，拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330825,
					"content": "这位听着就费米面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330805,
					"content": "遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330806
					]
				},
				{
					"id": 220330806,
					"content": "先自我介绍一下，我叫汤雯，是来自璃月的历史学者，之前正在实地调研稻妻的特色风俗与民话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330807
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330807,
					"content": "本来资料已经搜集的差不多了，正准备返回璃月。但是因为最近稻妻发生了很多大事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330808
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330808,
					"content": "我感觉，此刻的稻妻正处于一个历史性的时刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330809
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330809,
					"content": "这段特殊的时期，必然会在提瓦特的史册上留下浓墨重彩的一笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330810
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330810,
					"content": "亲眼见证这样的历史，然后真实、完整、清晰地将这一切记录成册，留给后人，就是历史学者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330811
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330811,
					"content": "不过…虽然这样的事业很让我振奋，但它可没法满足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330812
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330812,
					"content": "你是饿了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330813
					]
				},
				{
					"id": 220330813,
					"content": "也不能说…是饿啦…哈哈哈，稻妻的食物都还挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330814
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330814,
					"content": "我特别喜欢这边的「天妇罗」，虽然感觉…就是裹上面衣炸一切啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330815
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330815,
					"content": "但是吃久了稻妻菜，我还是想要再吃点璃月菜。不过，我一直都找不到能做出正宗璃月菜的餐馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330816
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330816,
					"content": "我前几天都狠下心来，去冒险家协会挂了一道「烹饪委托」，但到现在也没回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330817
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330817,
					"content": "我可以试试吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				}
			]
		}
	]
}