			"dialogs": [
				{
					"id": 220330201,
					"content": "这么快就回来了？你不会是个隐藏身份的大厨吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330202,
					"content": "嗯...我都快要等不及了，请让我尝一尝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330203,
					"content": "请享用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "我想想...刚刚讨论了哪些菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "唔…是米窝窝，莲花酥，还有三彩团子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220330206,
					"content": "决定好就交给汤雯小姐吧!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 2203303,
