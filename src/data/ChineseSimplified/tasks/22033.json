					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "嘿嘿，没问题的，你就相信我的品味吧，快来选一样~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
