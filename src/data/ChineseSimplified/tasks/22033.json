				"points": []
			},
			"dialogs": [
				{
					"id": 220330601,
					"content": "咦？这、这道菜的味道怎么…这么…这么微妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330602,
					"content": "也不能说是微妙…应该是说…奇异，还是什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330603,
					"content": "居然能做出这样的菜，你的厨艺还真是…另辟蹊径呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330604,
