					"汤雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330101,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330102
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330103
					]
				},
				{
					"id": 220330103,
					"content": "你是？这身打扮…你就是旅行者吧。抱歉，我就是有点想家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330104,
						220330105
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330104,
					"content": "你刚刚说想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				},
				{
					"id": 220330118,
					"content": "欸？莫非...你会做璃月菜吗？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330119
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330119,
					"content": "那、那就请你快点帮帮我，做点正宗的璃月菜给我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330120
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330120,
					"content": "让我想想...我现在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330121
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330121,
					"content": "我想吃点心。古朴甜蜜的璃月点心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330122
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330122,
					"content": "最近我一闭眼，就像做梦一样，总能看见一位风姿绝世的点心公子，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330123
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330123,
					"content": "脚踩锅巴靴，头戴豆腐冠，身披米窝氅，手摇花酥扇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330124,
						220330125
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330124,
					"content": "这位听着就招老鼠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330126,
					"content": "他从街边的点心铺子间走出来，带着清香，从我身边过，我就再也忘不了那味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330127
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330127,
					"content": "拜托了，请把点心公子带来吧，拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330125,
					"content": "这位听着就费米面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330105,
					"content": "遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330106
					]
				},
				{
					"id": 220330106,
					"content": "先自我介绍一下，我叫汤雯，是来自璃月的历史学者，之前正在实地调研稻妻的特色风俗与民话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330107
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330107,
					"content": "本来资料已经搜集的差不多了，正准备返回璃月。但是因为稻妻的锁国令结被迫滞留在这里，已经有一段时间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330108
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330108,
					"content": "其实，我觉得这对我来说也算是好事。因为我感觉，此刻的稻妻正处于一个历史性的时刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330109
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330109,
					"content": "我很确信，这段特殊的时期，必然会在提瓦特的史册上留下浓墨重彩的一笔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330110
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330110,
					"content": "亲眼见证这样的历史，然后真实、完整、清晰地将这一切记录成册，留给后人，就是历史学者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330111
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330111,
					"content": "不过…虽然这样的事业很让我振奋，但它可没法满足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330112
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330112,
					"content": "你是饿了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330113
					]
				},
				{
					"id": 220330113,
					"content": "也不能说…是饿啦…哈哈哈，稻妻的食物都还挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330114
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330114,
					"content": "我特别喜欢这边的「天妇罗」，虽然感觉…就是裹上面衣炸一切啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330115
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330115,
					"content": "但是吃久了稻妻菜，我还是想要再吃点璃月菜。不过，我一直都找不到能做出正宗璃月菜的餐馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330116
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330116,
					"content": "我前几天都狠下心来，去冒险家协会挂了一道「烹饪委托」，但到现在也没回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330117
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330117,
					"content": "我可以试试吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				}
			]
		},
		{
