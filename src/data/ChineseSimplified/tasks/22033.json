					"汤雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "唔，这种味道…好、好像不是璃月的菜，也不是稻妻的菜，味道还真是新鲜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330402,
					"content": "虽然不是我想要吃的那一道，但能够尝到这种新鲜的菜品，我也已经很满足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330403,
					"content": "谢谢啦，旅行者，这些东西给你，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				}
			]
		},
		{
			"id": 2203305,
			"completionStepIds": [
				2203305
			],
