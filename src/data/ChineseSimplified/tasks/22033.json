			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "欸？这、这应该还是稻妻的菜吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330502,
					"content": "我记得我要的好像不是这道菜来着…唔，算了，这道菜也能填饱肚子就是了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220330503,
					"content": "还是谢谢你了，旅行者，这些东西请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				}
			]
		},
		{
			"id": 2203306,
			"completionStepIds": [
				2203306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
