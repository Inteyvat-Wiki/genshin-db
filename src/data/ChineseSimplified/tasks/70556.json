				]
			},
			"dialogs": [
				{
					"id": 705560101,
					"content": "#你们来啦，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560102,
					"content": "先认识一下新同事？这是第七小队的信号官耶嘉，还有她的搭档灰郁香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560103,
					"content": "初次见面，荣誉骑士和白色小帮手，向你们致以敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560104
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560104,
					"content": "灰郁香，来问好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560105
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560105,
					"content": "嘎啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560106,
						705560107
					],
					"speakerTitle": "灰郁香"
				},
				{
					"id": 705560106,
					"content": "又一位信号官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560108
					]
				},
				{
					"id": 705560108,
					"content": "这只大大的鹰好听话欸！居然还穿着铠甲一样的衣服，还背着一个小包？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560109,
					"content": "等等，我有点迷糊了…安柏说的表演又是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560110,
					"content": "和耶嘉小姐，还有这只鹰有关吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560111,
					"content": "啊哈哈，我来简单解释一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560112,
					"content": "琴团长应该和你说过，我们这边在举办风之翼竞速射击活动，没错吧？这是一种便于理解的说法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560113,
					"content": "其实，有可能不同于你们的预期，这次更像是一次「飞行表演与指挥挑战」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560114,
					"content": "核心不是传统的风之翼滑翔，而是从地面给灰郁香这样的空中单位发信，引导它进行各种复杂的行动，战胜魔物标靶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560115,
					"content": "算是一种新奇的体验，能给大家带来小小的惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560116,
					"content": "嘎呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560117,
						705560118
					],
					"speakerTitle": "灰郁香"
				},
				{
					"id": 705560117,
					"content": "从自己滑翔，改成指挥飞鹰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560119
					]
				},
				{
					"id": 705560119,
					"content": "没错，这次飞行挑战也是一种技术演示，目标是向同僚们展现骑士团侦察力量的发展方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560120
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560120,
					"content": "并非每位骑士都像安柏前辈这样，能在滑翔中准确捕捉敌情，并进行简明扼要的记录…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560121
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560121,
					"content": "而我和灰郁香的使命，就是写好条令，让普通骑士与训练有素的蒙德鹰达成配合，运营一双「空中的眼睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560122
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560122,
					"content": "这样一来，就算没有强劲的侦察骑士，也能长时间探明敌情，稳定地向前行军。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560123
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560123,
					"content": "甚至，通过灰郁香装备的前向武器，还能提前排除一些较为弱小的空中魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560124
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560124,
					"content": "好…好专业的感觉？口吻有点像工程师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560125,
					"content": "放轻松，耶嘉，不用像面对芙蕾德莉卡阿姨那样严肃嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560126,
					"content": "荣誉骑士和派蒙，你们就当是和新认识的动物朋友一起游玩就好，开心最重要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560127
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560127,
					"content": "不好意思，前辈，我们只是有点…跃跃欲试。因为我和灰郁香一直在为这次演示反复练习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560128
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560128,
					"content": "如果能被荣誉骑士和白色小帮手认可，说明条令已经趋于完善，稍稍润色就能投入使用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560129
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560129,
					"content": "当然，演示过程中可能出现一些机械故障…这都是因为之前训练的强度太高，耗尽了某些部件的使用寿命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560130
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560130,
					"content": "等到消耗性的部件到位，统统替换上去，灰郁香的背包在正式行动中就绝不会有差池，请别在意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560131
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560131,
					"content": "嘎嗷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560132,
						705560133
					],
					"speakerTitle": "灰郁香"
				},
				{
					"id": 705560132,
					"content": "我会严格一些，但不至于苛责。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560134
					]
				},
				{
					"id": 705560134,
					"content": "那，那我也要来好好试一试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560135,
					"content": "嘿嘿，听起来，你们四位都干劲满满啊，那就祝你们玩得开心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560133,
					"content": "没事，我不会乱挑毛病的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560134
					]
				},
				{
					"id": 705560118,
					"content": "我们不上阵，坐镇发令就行？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560119
					]
				},
				{
					"id": 705560107,
					"content": "是没听过的职位…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560108
					]
				}
			]
		}
	]
}