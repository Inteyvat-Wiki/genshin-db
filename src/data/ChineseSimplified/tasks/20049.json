					"宁禄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "好想喝杯酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490102,
					"content": "但要是被优律发现我喝了酒，那就全完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490103,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "嗯？哦…哦，我就是想喝点酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490105,
					"content": "我老婆优律最看不得我喝酒了，平时在家里，我几乎滴酒不能沾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490106,
					"content": "我只能趁她上街买东西的时候，才能偷偷过来安静地喝几杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490107,
					"content": "你也太喜欢喝酒了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "你这话说的！蒙德人怎么可能不喝酒嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490109,
					"content": "拜托你，去帮我拖住优律一点时间，让我喝个一杯两杯就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490110,
					"content": "买东西的时候，只要有很多选择，优律就会一直犹豫，下不了判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490111,
					"content": "如果能让她一直有很多选择，她就会一直犹豫下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490112,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "哈哈哈，那就拜托你了，祝你酒运昌隆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490114,
					"content": "你要喝多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "哈哈哈，那就要看你能够拖多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490116,
					"content": "不，不是，我只要能安静地喝一杯就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 200490117,
					"content": "这是一位蒙德酒客的承诺，拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宁禄"
				}
			]
		},
