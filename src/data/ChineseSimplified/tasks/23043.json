					"阿扎莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430301,
					"content": "还是得拜托里夫帮忙找个人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430302
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430302,
					"content": "你怎么愁眉苦脸的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430303
					]
				},
				{
					"id": 230430303,
					"content": "旅行者，你是想买什么吗？抱歉，现在店里可能有些缺货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430304
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430304,
					"content": "你就是为这个发愁吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430305
					]
				},
				{
					"id": 230430305,
					"content": "是啊…我们这村子在沙漠里，运送货物本来就很不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430306
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430306,
					"content": "我如果想进货，还得先拜托外出的人帮我去订货，然后再和里夫他们一起把货接进村里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430307
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430307,
					"content": "这么一来二去的，我做生意的成本蹭蹭地往上涨，为了维持生计，我也只能把这些货物稍微卖贵一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430308
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430308,
					"content": "还好村里的人都理解我，也愿意光顾我的生意，不然…我这小店铺，估计早就倒闭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430309
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430309,
					"content": "但是…唉，我也不是随时都能找到准备出村的人，里夫他们也不是随时都有空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430310
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430310,
					"content": "如果运气不好，某些存量少的货物就会断货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430311,
						230430314
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430311,
					"content": "那些货物是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430312
					]
				},
				{
					"id": 230430312,
					"content": "都是一些和日常用度有关的货物，这些东西我进得虽然不慢，但卖得更快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430313
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430313,
					"content": "我这里本来就是小本生意，也不可能经常大批量进货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430317
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430317,
					"content": "咳，先不说这些。旅行者，你是准备出村子去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430318
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430318,
					"content": "我最近想要进一批鱼干，需要有人帮我去下订单…你能帮我这个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430319,
						230430320
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430319,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430322
					]
				},
				{
					"id": 230430322,
					"content": "我想想…<color=#00E1FFFF>布特罗斯</color>做的鱼干价钱很公道，味道也还…算是能入口吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430323
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430323,
					"content": "<color=#00E1FFFF>贾汉吉尔</color>最近好像用新方法制作了一批鱼干，据说用了很多香料，味道非常不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430324
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430324,
					"content": "我想进一些过来试着卖卖看，但就是不知道价钱怎么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430325
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430325,
					"content": "但我这次用来进货的钱就只有这一些，也不知道到底从哪家进货最合适…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430326
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430326,
					"content": "旅行者，请你帮我去看看这两家售卖鱼干的情况，再帮我找一家订货吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430327
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430327,
					"content": "哦对了，之前托人订货的时候，我会拜托他们帮我订一些价格相对便宜的货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430328
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430328,
					"content": "你帮我订货的时候，记得也帮我找一家货物相对便宜的店下订单啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430329
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430329,
					"content": "在阿如村做生意嘛，还是保持着「薄利多销」的原则比较好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430330
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430330,
					"content": "所以，这次就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430331,
						230430332
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430331,
					"content": "我先去<color=#00E1FFFF>布特罗斯</color>那边看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430333
					]
				},
				{
					"id": 230430333,
					"content": "谢谢你愿意帮忙，我把他的所在位置给你标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430334
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430334,
					"content": "那就拜托了，如果你有什么问题的话，随时都可以回来问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430332,
					"content": "我先去<color=#00E1FFFF>贾汉吉尔</color>那边看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430333
					]
				},
				{
					"id": 230430320,
					"content": "我还以为大家会直接晒鱼干呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430321
					]
				},
				{
					"id": 230430321,
					"content": "哈哈哈…相信我旅行者，在沙漠里晒鱼干可不是个好主意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430322
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430314,
					"content": "如果能找个长期伙伴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430315
					]
				},
				{
					"id": 230430315,
					"content": "哈哈哈…我也想过，但你看看周围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430316
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430316,
					"content": "往这个村子里运货做生意，可不是一件容易的事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430317
					],
					"speakerTitle": "阿扎莱"
				}
			]
		},
