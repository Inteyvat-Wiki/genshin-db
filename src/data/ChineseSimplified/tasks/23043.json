			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿扎莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430101,
					"content": "还是得拜托里夫帮忙找个人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430102
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430102,
					"content": "你怎么愁眉苦脸的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430103
					]
				},
				{
					"id": 230430103,
					"content": "旅行者，你是想买什么吗？抱歉，现在店里可能有些缺货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430104
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430104,
					"content": "你就是为这个发愁吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430105
					]
				},
				{
					"id": 230430105,
					"content": "是啊…我们这村子在沙漠里，运送货物本来就很不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430106
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430106,
					"content": "我如果想进货，还得先拜托外出的人帮我去订货，然后再和里夫他们一起把货接进村里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430107
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430107,
					"content": "这么一来二去的，我做生意的成本蹭蹭地往上涨，为了维持生计，我也只能把这些货物稍微卖贵一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430108
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430108,
					"content": "还好村里的人都理解我，也愿意光顾我的生意，不然…我这小店铺，估计早就倒闭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430109
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430109,
					"content": "但是…唉，我也不是随时都能找到准备出村的人，里夫他们也不是随时都有空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430110
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430110,
					"content": "如果运气不好，某些存量少的货物就会断货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430111,
						230430114
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430111,
					"content": "那些货物是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430112
					]
				},
				{
					"id": 230430112,
					"content": "都是一些和日常用度有关的货物，这些东西我进得虽然不慢，但卖得更快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430113
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430113,
					"content": "我这里本来就是小本生意，也不可能经常大批量进货…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430117,
					"content": "咳，先不说这些。旅行者，你是准备出村子去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430118
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430118,
					"content": "我最近想要进一批香料，需要有人帮我去下订单…你能帮我这个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430119,
						230430120
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430119,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430122
					]
				},
				{
					"id": 230430122,
					"content": "我想想…<color=#00E1FFFF>拉玛</color>卖的香料价钱很公道，质量也…还算过得去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430123
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430123,
					"content": "<color=#00E1FFFF>朱特</color>好像进了一批新型香料，质量很不错。我想要进一些回来试着卖卖看，但就是不知道价格怎么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430124
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430124,
					"content": "但我这次用来进货的钱就只有这么一些，也不知道到底从哪家进货最合适…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430125
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430125,
					"content": "旅行者，请你帮我去看看这两家售卖香料的情况，再帮我找一家订货吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430126
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430126,
					"content": "哦对了，之前托人订货的时候，我会拜托他们帮我订一些价格相对便宜的货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430127
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430127,
					"content": "你帮我订货的时候，记得也帮我找一家货物相对便宜的店下订单啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430128
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430128,
					"content": "在阿如村做生意嘛，还是保持着「薄利多销」的原则比较好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430129,
						230430130
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430129,
					"content": "我先去<color=#00E1FFFF>拉玛</color>那边看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430131
					]
				},
				{
					"id": 230430131,
					"content": "谢谢你愿意帮忙，我把她的所在位置给你标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430133,
					"content": "那就拜托了，如果你有什么问题的话，随时都可以回来问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430130,
					"content": "我先去<color=#00E1FFFF>朱特</color>那边看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430132
					]
				},
				{
					"id": 230430132,
					"content": "谢谢你愿意帮忙，我把他的所在位置给你标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430120,
					"content": "店里的香料断货了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430121
					]
				},
				{
					"id": 230430121,
					"content": "断货倒是谈不上…但这种销量大的货物，多备点总是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430122
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430114,
					"content": "如果能找个长期伙伴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430115
					]
				},
				{
					"id": 230430115,
					"content": "哈哈哈…我也想过，但你看看周围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430116
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430116,
					"content": "往这个村子里运货做生意，可不是一件容易的事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "阿扎莱"
				}
			]
		},
