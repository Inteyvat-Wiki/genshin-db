			"dialogs": [
				{
					"id": 230430201,
					"content": "怎么样？你订到货了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430202,
						230430203
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430202,
					"content": "关于<color=#00E1FFFF>拉玛</color>的位置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430204
					]
				},
				{
					"id": 230430204,
					"content": "你不太清楚她具体在哪里？行…我把她的所在位置给你标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430206
					],
					"speakerTitle": "阿扎莱"
				},
				{
					"id": 230430206,
					"content": "这样就行了，拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎莱"
				},
