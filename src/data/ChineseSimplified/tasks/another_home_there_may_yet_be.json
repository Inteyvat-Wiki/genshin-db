						130280101
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130280101,
					"content": "为了它们有机会能重逢，我很想再做点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130280102,
					"content": "除了这两只蕈兽，我也有点担心浮游风蕈兽的营地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130280103,
					"content": "嗯，我也有同感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130280104,
					"content": "我有个想法，要不要把它们送去，让它们在一起生活呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130280105,
					"content": "既然平日里都有元素生物在引导，它们的生活习惯应该也比较接近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130280106,
					"content": "对哦，互相也能有个照应！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130280107,
					"content": "那你们愿意跟我们走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280108
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130280108,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280109
					],
					"speakerTitle": "浮游水蕈兽"
				},
				{
					"id": 130280109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280110
					],
					"speakerTitle": "浮游水蕈兽"
				},
				{
					"id": 130280110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280111
					],
					"speakerTitle": "浮游水蕈兽"
				},
				{
					"id": 130280111,
					"content": "看来是被说服了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280112
					],
					"speakerTitle": "派蒙"
				},
				{
