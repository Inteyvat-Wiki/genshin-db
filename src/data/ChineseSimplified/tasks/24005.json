						],
						"pointId": 340100216
					}
				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "这里就是「蒸汽鸟报」报社吗，看起来是不是…完全没什么特别的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050302,
					"content": "很普通的房子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "哇！居然真的有机械鸟！好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050305,
					"content": "厉害吧？爸爸经常带我来这里买报纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050306,
					"content": "他可喜欢「蒸汽鸟报」了，每天早上都会拿着报纸看个不停。偶尔还会把报纸上的一部分剪下来，贴在一个本子上保存起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050307,
					"content": "爸爸说这是他所发表的「评论」，有时候他甚至会自己读那些评论给我和妈妈听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050308,
					"content": "我们俩可不喜欢听，一直用「好啊」，「是吗」或者「原来如此」来回答他，但爸爸根本没察觉到，自己读得可开心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050309,
					"content": "「评论」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "如果简单来说，「评论」就是从评论家自己的观点出发，对某件事发表一些意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050311,
					"content": "洛薇的父亲，德勒吕叔叔是一位枫丹科学院的科学家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050320,
					"content": "同时，也是一位经常在「蒸汽鸟报」上发表「评论」的「评论家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050312,
					"content": "对呀，爸爸对任何事情都喜欢长篇大论地发表「评论」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050313,
					"content": "有时候说着说着，他就会和想起什么一样，冲回屋里闷头写稿，连饭都不吃，只是一个劲地喝茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050314,
					"content": "欸…还有这种只用发表意见就能赚钱的职业吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050315,
					"content": "光是发表意见可称不上是「评论家」。如果想要发表一篇值得被认可的评论，首先要遵循几个要素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050316,
					"content": "#那个…那个…韦吕！还有{M#大哥哥}{F#大姐姐}，你们肚子饿了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050317,
					"content": "路易哥哥前几天和我说，他最近会卖泡泡桔味的薯条，我们快去买了尝尝吧，我们请你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050318,
