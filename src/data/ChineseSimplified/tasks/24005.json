			"dialogs": [
				{
					"id": 240050401,
					"content": "路易哥哥！我要买几份泡泡桔味的薯条！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050402,
					"content": "是洛薇啊，真不好意思，今天港口上的人特别多，我准备的泡泡桔全用光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "路易"
				},
				{
					"id": 240050403,
					"content": "我，我都提前好久说过了，我还专门带了朋友过来吃呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050404,
					"content": "唉，客人太多，我一下子给忘记了…这里还剩下一些普通的薯条，就不收你们钱了，拿去吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "路易"
				},
				{
					"id": 240050405,
					"content": "好吧，谢谢路易哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050406,
					"content": "你只缺泡泡桔吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "如果真有泡泡桔的话，我倒是可以马上做一批泡泡桔酱出来，其他的调味料也剩下一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "路易"
				},
				{
					"id": 240050409,
					"content": "#好欸！{M#大哥哥}{F#大姐姐}最厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050410,
					"content": "#谢谢{M#大哥哥}{F#大姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050411,
					"content": "真是不好意思，每次遇见我们的时候，都要麻烦你一阵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050412,
					"content": "不用这么客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "好吧…我得向您学习才是，德勒吕叔叔也经常说我太古板了，如果未来也想做评论家的话，职业道路会很艰难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050415,
					"content": "咳！不提这些，我会在这里照顾他们的，泡泡桔的事就麻烦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050413,
					"content": "可不能扫了兴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "我可以去拿点泡泡桔回来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
