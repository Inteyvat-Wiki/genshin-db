				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "哇…好想进去踩水，或者用喷泉洗个澡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050202,
					"content": "这样肯定会挨骂的啦，在外面看看就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050203,
					"content": "但是，既然不让人进去玩，那把喷泉做这么大干嘛呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050204,
					"content": "就算它再好看，如果只能看的话，那也就是一池子普通的水而已，一点意思也没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050205,
					"content": "这里可不是普通的喷泉啦。不过…爸爸倒是说过其他的普通喷泉，他怎么说来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050206,
					"content": "「枫丹廷市政美化工程最大的作用，是灵活地解决报税问题。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050207,
					"content": "今天德勒吕叔叔刚和我讲解过这方面的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050208,
					"content": "就连说话的语气，和我爸爸一模一样…怪不得爸爸这么喜欢奥雷勒哥哥，每次都要拿一大堆书去和你聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050209,
					"content": "虽然听不懂，但哥哥肯定又在说扫兴的话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050210,
					"content": "洛薇，我们快去下个地方玩吧，今天你好不容易不用学习了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050211,
					"content": "嗯，我们接下来去看看其他地方吧，我想想…报社应该还开着门，我们去那里吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛薇"
				}
			]
		},
