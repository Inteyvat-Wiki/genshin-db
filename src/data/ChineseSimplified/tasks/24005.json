					"洛薇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "哥哥，快点快点，走这边啦。那边的大房子我们还没看过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050102,
					"content": "走慢点，别又摔着了。洛薇你也是，你爸爸说你身体不好，可不要着凉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050103,
					"content": "呜哇，你哥哥好啰嗦，和我妈妈一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050104,
					"content": "我也这么觉得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050105,
					"content": "你们两个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050106,
					"content": "又见面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#{M#大哥哥}{F#大姐姐}好！又见面啦，这次我们可没有玩捉迷藏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050109,
					"content": "准确地来说，是刚刚已经玩过了…还被诺尔小姐给训斥了一顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050110,
					"content": "诺尔姐姐在工作的时候一直那么严肃，总是爱教训人，亏我还请她吃过饼干呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050111,
					"content": "不过，反正也玩累了，我正想带奥雷勒和韦吕到处逛逛，吃点好吃的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050112,
					"content": "#{M#大哥哥}{F#大姐姐}，你想和我们一起…嗯…那个叫什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050113,
					"content": "散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "奥雷勒"
				},
				{
					"id": 240050114,
					"content": "对，和我们一起散步吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050115,
					"content": "我们快去那边的广场看看吧，我还想去看看喷泉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "韦吕"
				},
				{
					"id": 240050116,
					"content": "那就麻烦小姐带路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "好呀，那我们就…先去那边的广场吧，里面的喷泉确实都很好看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240050117,
					"content": "那就麻烦各位带路了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "你们在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
