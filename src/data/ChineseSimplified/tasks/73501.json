			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉齐",
					"丹吉尔",
					"柯莱",
					"马姆杜",
					"法伊兹",
					"卡西特",
					"阿利娅",
					"鲁希"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "犯了错的兰那罗父亲，主动承认错误，获得了兰那罗儿子的原谅吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010202,
					"content": "嗯，我觉得小朋友们会喜欢这个故事的，但是这个兰那罗父亲主动认错的原因，好像还是太简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010203,
					"content": "要不要在故事里让兰那罗父子一起面对什么困境？这样他们会互相体谅，兰那罗父亲看着儿子努力的样子，也会心生愧疚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "丹吉尔"
				},
				{
					"id": 735010204,
					"content": "那么，兰那罗父亲在心生愧疚的时候，说话是快一点好还是慢一点好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010205,
					"content": "这个其实就要取决于兰那罗儿子了，让他们说话速度不一样会更有趣一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "丹吉尔"
				},
				{
					"id": 735010206,
					"content": "丹吉尔先生，拉齐，你们好！你们在干什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010207,
					"content": "嗯，我在和爸爸讨论新童话的内容，这一次，就会由我自己来向大家讲述童话啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010208,
					"content": "不过一想到要在很多人面前讲自己的故事，我还是有点紧张，所以想要知道有哪些需要注意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010209,
					"content": "噢！须弥要多一位年纪不大的童话作者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010210,
					"content": "谢谢你们，如果不是你们及时出现，拉齐恐怕真的会离我而去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "丹吉尔"
				},
				{
					"id": 735010211,
					"content": "真不错，看起来一切都解决了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010212,
					"content": "不过，我突然想起来，有一件事还是很可疑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010213,
					"content": "嗯？什么事？需要我帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010214,
					"content": "为什么道成林的那个树洞里，会有蒙德人留下的纸条呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010215,
					"content": "为…为什么到现在还想着这件事，我觉得单纯就是巧合啦，巧合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010216,
					"content": "把秘密写到纸条上再贴到树洞里也是很常见的习惯啦。我觉得这件事没什么好在意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010217,
					"content": "柯莱突然好激动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "呜…呜呜呜…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010220,
					"content": "其实，我也有秘密，一些烦恼。我也有向着树洞说出秘密的习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010221,
					"content": "不过，看到现在的拉齐和丹吉尔先生，我有了一个想法：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010222,
					"content": "#{NICKNAME}，你可以成为我的树洞吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010223,
					"content": "乐意之至。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "真的很常见吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
