							"2"
						],
						"stepId": 7350101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡西特",
					"阿利娅",
					"马姆杜",
					"法伊兹",
					"鲁希",
					"柯莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "唔…怎么今天买到的还是这一种，我明明想要那个最圆嘟嘟，看起来最弹弹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010102,
					"content": "算了，再攒一点零花钱吧，我一定要收集全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010103,
					"content": "欸…我记得你最近每天都有来买吧？还没有收集全？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "阿利娅"
				},
				{
					"id": 735010104,
					"content": "不如买那个兰那罗木刻套装，一套里面有七个不重复的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "阿利娅"
				},
				{
					"id": 735010105,
					"content": "那就没有惊喜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010106,
					"content": "我不想要惊喜，就只想每一种都要有，这才是用心的表现！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "阿利娅"
				},
				{
					"id": 735010107,
					"content": "今天我就是攒齐了钱，特意来买木刻套装的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "阿利娅"
				},
				{
					"id": 735010108,
					"content": "啊，非常抱歉，刚刚卖给卡西特小朋友的是最后一件，今天本店的货物已经卖完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "马姆杜"
				},
				{
					"id": 735010128,
					"content": "我们正在招募新的雕刻师，还请明天再次光临。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "马姆杜"
				},
				{
					"id": 735010109,
					"content": "好吧…那我明天再来。等等，你怎么能称呼兰那罗木刻叫做货物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "阿利娅"
				},
				{
					"id": 735010110,
					"content": "就是就是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "卡西特"
				},
				{
					"id": 735010111,
					"content": "好好好，我错了，我错了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "马姆杜"
				},
				{
					"id": 735010112,
					"content": "抱歉，今天本店的兰那罗木刻已经全都卖完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010113,
					"content": "卖完了？这可怎么办…我还打算多买几个，送给明天来玩的表弟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "鲁希"
				},
				{
					"id": 735010114,
					"content": "那这样吧，小朋友，我记得你家是住在拉齐家附近吧？明天一早我们就把新雕好的木刻送到你家里去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010115,
					"content": "谢谢你，法伊兹叔叔！千万不要忘了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "鲁希"
				},
				{
					"id": 735010116,
					"content": "不会的，我们阿折罗造像，从不辜负小朋友们的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010117,
					"content": "啊，又有新的客人来了。抱歉，今天本店的兰那罗木刻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010118,
					"content": "原来是你们，谢谢你们的帮助。本来我们还想专程道谢，但是如你们所见，最近实在是太忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010119,
					"content": "没有你们，阿折罗造像的二十年庆可能就是另外一副样子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010120,
					"content": "看起来生意非常好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "兰那罗真的很受欢迎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "这些都是托拉齐的福，没想到小小年纪就能有那么多奇思妙想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010123,
					"content": "哦对了，为了表示感谢，本店还打算把「试作兰那罗」赠送给你们，当做纪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "法伊兹"
				},
				{
					"id": 735010124,
					"content": "哇这是什么…让人觉得很…很…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010125,
					"content": "震撼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "对对对，震撼，看起来很神秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010127,
					"content": "唔，到底要不要接收这份礼物，请等我们再仔细考虑考虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010129,
					"content": "阿折罗造像的危机已经解决。接下来的拜访对象是拉齐与丹吉尔。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
			"completionStepIds": [
				7350101
