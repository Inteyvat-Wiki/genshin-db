					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010304
					],
					"speakerTitle": "丹吉尔"
				},
				{
					"id": 735010304,
					"content": "那么，兰那罗父亲在心生愧疚的时候，说话是快一点好还是慢一点好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010305
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010305,
					"content": "这个其实就要取决于兰那罗儿子了，让他们说话速度不一样会更有趣一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010306
					],
					"speakerTitle": "丹吉尔"
				},
				{
					"id": 735010306,
					"content": "丹吉尔先生，拉齐，你们好！你们在干什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010307,
					"content": "嗯，我在和爸爸讨论新童话的内容，这一次，就会由我自己来向大家讲述童话啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010308
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010308,
					"content": "不过一想到要在很多人面前讲自己的故事，我还是有点紧张，所以想要知道有哪些需要注意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010309
					],
					"speakerTitle": "拉齐"
				},
				{
					"id": 735010309,
					"content": "噢！须弥要多一位年纪不大的童话作者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010310,
					"content": "谢谢你们，如果不是你们及时出现，拉齐恐怕真的会离我而去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010311
					],
					"speakerTitle": "丹吉尔"
				},
				{
					"id": 735010311,
					"content": "真不错，看起来一切都解决了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010312,
					"content": "不过，我突然想起来，有一件事还是很可疑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010313,
					"content": "嗯？什么事？需要我帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010314
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010314,
					"content": "为什么道成林的那个树洞里，会有蒙德人留下的纸条呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735010315,
					"content": "为…为什么到现在还想着这件事，我觉得单纯就是巧合啦，巧合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010316
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010316,
					"content": "把秘密写到纸条上再贴到树洞里也是很常见的习惯啦。我觉得这件事没什么好在意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010317,
						735010318
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010317,
					"content": "柯莱突然好激动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010319
					]
				},
				{
					"id": 735010319,
					"content": "呜…呜呜呜…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010320
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010320,
					"content": "其实，关于那个蒙德人的身份，我已经有一些头绪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010321
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010321,
					"content": "等以后有机会的话，我一定会告诉你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010322,
						735010323
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 735010322,
					"content": "好的呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010323,
					"content": "期待那一天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010318,
					"content": "真的很常见吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010319
					]
				}
			]
		}
	]
