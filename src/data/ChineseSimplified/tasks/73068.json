			"dialogs": [
				{
					"id": 730680201,
					"content": "#那菈{NICKNAME}和派蒙？兰那库拉跟着兰般度去了善见地还没回来，不如趁现在去吃点蘑菇。",
					"roleType": "TALK_ROLE_NPC",
