			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰那库拉",
					"兰伽卢"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "是兰那库拉！顺利回到桓那兰那了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680302,
					"content": "#那菈{NICKNAME}，还有派蒙！法留纳神机治好了，兰那库拉可以专心照看苗圃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680303,
					"content": "这里就是兰那库拉总是提起的苗圃啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680304,
					"content": "是的，是兰那库拉和兰伽卢一起照料的苗圃。这里的土，原本适合生长，可以种出高兴的毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680305,
					"content": "还有不高兴的毗波耶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680306,
					"content": "也不是不高兴，只是没那么高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680307,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680308,
					"content": "就像，有适合生长的土壤，也不缺雨水和阳光，成长的过程中也没有遇到什么阻碍…好像没什么不高兴的，但是也没那么高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680309,
					"content": "哦…感觉就普普通通的。欸？那这里和其他地方不一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680310,
					"content": "桓那兰那的土，都很好，但是这里格外好。而且还有更重要的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680311,
					"content": "兰伽卢和兰那库拉，会照看它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680312,
					"content": "照看…具体是指哪方面呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680313,
					"content": "会演奏音乐给它们听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680314,
					"content": "还会夸它们长得漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680315,
					"content": "这就是野生和家养的区别吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "好像也不是不能理解…如果每天都有悦耳的音乐可以听，还会被夸漂亮，确实很难不高兴呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680317,
					"content": "#对了，就像我，在被{NICKNAME}钓起来之前，没有不高兴，可也没那么高兴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680318,
					"content": "#和{NICKNAME}一起旅行之后，虽然有时会遇到困难，但是高兴的时候也会加倍高兴呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680319,
					"content": "派蒙很对，兰伽卢要用高兴的毗波耶，造漂亮的灯，为了无忧节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680320,
					"content": "嘿嘿，既然兰那库拉也回来了，我们就赶紧开始吧！毗波耶的种子…毗波耶也有种子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680321,
					"content": "毗波耶，是大地的梦呓，是大地在梦中想起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680322,
					"content": "那种子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680323,
					"content": "毗波耶没有种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680324,
					"content": "欸？可是没有种子要怎么在苗圃种植…啊！难道是兰那库拉有什么可以凭空种出毗波耶的兰迦拉梨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680325,
					"content": "不对，派蒙不对…要让苗圃长出毗波耶，需要桓斯弥利底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680326,
					"content": "桓…桓什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680327,
					"content": "「桓斯弥利底」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "桓那会记得一切，所以，有桓斯弥利底的话，大地会在梦中重新记起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680329,
					"content": "苗圃也会生出高兴的毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680330,
					"content": "#唔…那、那这个「桓斯弥利底」，只有兰那罗才能获得吗？我和{NICKNAME}是不是没机会在苗圃培育毗波耶了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680331,
					"content": "#金色的那菈帮助过兰那库拉，还有其他兰那罗，是兰那罗的朋友，所以兰那库拉和那菈{NICKNAME}一起培育毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680332,
					"content": "#让桓斯弥利底沉入泥土里，就能生出毗波耶，那菈{NICKNAME}，试试看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680333,
					"content": "按兰那库拉所说，让「桓斯弥利底」沉入泥土。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "这样就好了吗？好像和种植其他的植物也没什么区别嘛！把种子埋进土里，然后等种子发芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680335,
					"content": "桓斯弥利底不是种子。就像派蒙不是会飞的猫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680336,
					"content": "唔…好、好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680337,
					"content": "话说回来，苗圃还有好些空地呢，一、二、三…居然还有十二块看起来可以培育毗波耶的地。兰那库拉还有更多桓斯弥利底吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680338,
					"content": "以前有，但是现在没有更多的了，需要重新收集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680339,
					"content": "在梦境之外，有十二座苗圃，会凝结出桓斯弥利底。有了它们，桓那兰那的苗圃就能生满毗波耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680340,
					"content": "#无忧节需要很多毗波耶，桓那兰那有很多，但如果有更多高兴的毗波耶，兰那罗会高兴，那菈{NICKNAME}和派蒙也会高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680341,
					"content": "既然是这样的话，我们也来帮忙收集桓斯弥利底吧！不过，这东西该怎么收集呀？兰伽卢刚才说是在梦境之外的苗圃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680342,
					"content": "金色的那菈，需要遍历苗圃的土地，但是只需要一次，太多，不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680343,
					"content": "只需要一次遍历…苗圃的土地就会凝结出桓斯弥利底，就像前一夜的涟涟雨丝，在天蒙蒙亮以后，凝聚成叶片上的露珠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730680344,
					"content": "…唔…根本听不懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680345,
					"content": "不过根据之前和兰那罗打交道的经验…等我们找到了梦境之外的苗圃，应该自然而然就知道兰那库拉在说什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680346,
					"content": "之后如果找到苗圃的话就去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
