			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰伽卢"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "你好！这边的土地看起来和其他地方不太一样呢，是有什么特别的用途吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680103,
					"content": "欸？他怎么没反应？是没听到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680104,
					"content": "你——好——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "…咕？那、那菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680108,
					"content": "怎、怎么会？桓那兰那怎么会有那菈？是来抓我去烤的吗？兰伽卢可没有蘑菇好吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680109,
					"content": "那么可怕的事情我们怎么可能会做嘛，我们可是大家公认的「兰那罗的愉快的好伙伴」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680110,
					"content": "根本没人这么说过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "哎呀，大家虽然嘴上没说，心里一定是这么想的，不用问我也知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680114,
					"content": "#总之，我是派蒙，这边的金色的家伙是{NICKNAME}，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是个好那菈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680115,
					"content": "你是兰伽卢对吧？你独自一个兰那罗在这里干什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680116,
					"content": "派蒙问这个做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680117,
					"content": "呃…我就是好奇嘛！就像看到蝴蝶就要扑，看到蜥蜴就要抓，已经跟本能一样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680118,
					"content": "派蒙是会飞的猫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680119,
					"content": "不是啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680120,
					"content": "唔…如果是什么不方便说的兰那罗的秘密之类的就算啦，我们也不是那么不识趣的家伙，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680121,
					"content": "虽然还是挺好奇的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "话是这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680123,
					"content": "「秘密」？兰伽卢没有「秘密」。兰伽卢没有在做什么，兰伽卢在等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680124,
					"content": "在等？是指其他的兰那罗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680125,
					"content": "兰那库拉，跟兰般度一起去了善见地，不知道什么时候才能回来。法留纳神机不好，不是照料苗圃的时候，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680126,
					"content": "#那菈{NICKNAME}喜欢种地吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680127,
					"content": "种地好麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "在巴螺迦种地才麻烦，桓那种地不麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680131,
					"content": "为什么不问问我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680132,
					"content": "派蒙不是扑蝴蝶，就是抓蜥蜴，看起来不像喜欢种地的样子，问了白问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680133,
					"content": "虽然很想反驳…反正我就是比起过程，更在意结果啦！所以，这里的苗圃是种什么的呀？是好吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680134,
					"content": "好吃，但是也有别的用处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680135,
					"content": "不过现在，派蒙要是饿了，不要来苗圃吃，去吃蘑菇。桓那的蘑菇太多了，要吃掉一些才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680136,
					"content": "总之，兰那库拉还没回来，什么都没办法开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680137,
					"content": "#好吧，看来只能等兰那库拉回来了…我们先走吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680129,
					"content": "最喜欢种地了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "太好了，兰伽卢也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "兰伽卢"
				},
				{
					"id": 730680112,
					"content": "派蒙说得对！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730680106,
					"content": "开饭啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "蘑菇好吃！…那菈？好吃？不对，那菈不能吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "兰伽卢"
				}
			]
		},
		{
