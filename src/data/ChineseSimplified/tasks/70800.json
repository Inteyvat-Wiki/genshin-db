			"dialogs": [
				{
					"id": 708001501,
					"content": "你们回来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001502
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001502,
					"content": "肉已经带回来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "那太好了！欸？舒特呢…他没遇见危险吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001504,
					"content": "他应该已经没事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "那就好，幸好没有出大事…等我把新菜做好了之后，也带过去给他尝尝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001506,
					"content": "话说回来，这「冷鲜肉」看着确实和普通肉类不一样，用这个做材料，说不定真能做出那种有「噼咔」感的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001507,
					"content": "不过，要想让菜带有「风的味道」的话，还需要蒲公英籽来做辅料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001508,
					"content": "但如果只是这样的话，感觉跟普通的肉类菜品也没有很大区别，还少一种决定性的辅料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001509,
					"content": "对了，对了！在那场对决之后，其实我还见过几次香菱，还从她那里听到了一道叫做「史莱姆滑蘑菇」的菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001510,
					"content": "这种新奇的材料，我还从来没用过…不过，想要做出新奇的菜，就要尝试新奇的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001511,
					"content": "旅行者，那就拜托你帮我去找一份史莱姆凝液和一份蒲公英籽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001512,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "嗯，那就拜托你了，我在这里再思考一下我的那份菜谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
		},
