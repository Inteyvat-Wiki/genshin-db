					"布洛克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "啊，你们来了吗，兽肉准备的怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000702,
					"content": "已经带来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "嗯，我来看看…确实很新鲜，这样应该就可以了。主料就用这些兽肉，再准备一点有「风的味道」的辅料就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000704,
					"content": "唔，说到带有「风的味道」的辅料…那当然就是「蒲公英籽」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000705,
					"content": "旅行者，你能帮我去收集一点蒲公英籽吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000706,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "那就麻烦你了，我先去处理一下兽肉，搜集好蒲公英籽之后，就直接拿来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
		},
