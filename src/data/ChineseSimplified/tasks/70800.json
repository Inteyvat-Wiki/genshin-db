					"害怕的舒特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "活，活过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001302,
					"content": "是你生的火吗…好心的旅行者…谢谢你，多谢你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001303,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "现在暖和点了，还好…还好…我本来是接到委托，进雪山取那种「冷鲜肉」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001305,
					"content": "我最开始就是想在雪山外围找找看就好，但是走着走着不小心弄丢了火种，又不小心迷了路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001306,
					"content": "要是没有你，我都不知道怎么办才好了，多谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001307,
					"content": "关于布洛克的委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "是布洛克拜托你找我的，唉…她肯定已经等急了。但我实在没体力把这份肉再大老远送回镇上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001309,
					"content": "虽然很不好意思，但能请你帮我把这份「冷鲜肉」送过去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001310,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "多谢你了。我得回山下的营地去，好好喝口热汤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "害怕的舒特"
				}
			]
		},
