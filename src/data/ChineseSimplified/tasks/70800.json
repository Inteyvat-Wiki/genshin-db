			"dialogs": [
				{
					"id": 708001001,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "你是…我记得你，你是香菱的那位助手，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001003,
					"content": "上次的对决真是让人印象深刻，我现在还记忆犹新呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001004,
					"content": "虽然上次我输给了香菱，但这一次，我决定要研究出一道带有「风的味道」的菜。然后，用这道菜再和香菱一决胜负！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001005,
					"content": "为了这道菜，我还特地去拜托了一位冒险家，帮我去雪山里取一些「冷鲜肉」回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001006,
					"content": "但那位叫做舒特的冒险家，到现在还没有回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001007,
					"content": "我听说雪山里十分危险，那位冒险家不会是遇到什么危险了吧…你能帮我去找找他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001008,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
				},
				{
					"id": 708001009,
					"content": "你愿意帮忙那真是太好了，雪山的气候严寒，记得随时生火取暖啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
		},
