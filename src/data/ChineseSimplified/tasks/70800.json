			"dialogs": [
				{
					"id": 708000901,
					"content": "谢谢，这下材料就都准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000902,
					"content": "辛苦你了，这些东西请你收下吧，就算是报酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000903,
					"content": "不过要怎么处理，才能让整道菜都带上「风的味道」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000904,
					"content": "蒸煮煎炸…唔…不然，还是以食材的原味为主，在整道菜出锅之后再把蒲公英籽撒上去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
