			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾伦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "得，得救了…真是太谢谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 708000602,
					"content": "真没想到，就是猎个林猪也能这么麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 708000603,
					"content": "关于布洛克要的食材…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "是布洛克让你来的？啊…其实她要的新鲜兽肉，我已经弄到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 708000605,
					"content": "不过我追林猪的时候太大意，一不小心就惊动了附近的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 708000606,
					"content": "虽然林猪是猎到了，但我也被魔物们给围住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 708000607,
					"content": "旅行者，能拜托你把这些肉送给布洛克吗，我要先去城里，拜托教会那边治疗一下我的伤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 708000608,
					"content": "唉，又搞成这个样子，杜拉夫先生肯定又要说我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾伦"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
