				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "其实我正打算配合风花节开发一道新菜，主推「风的味道」，现在正在准备食材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000203,
					"content": "不过，我明明拜托了艾伦帮我去明冠峡猎最新鲜的肉，怎么这么久了他还没回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000204,
					"content": "再拖下去，说不定那些食材都要不新鲜了，旅行者，能拜托你去明冠峡那边看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000205,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "那就辛苦你了，回头请你尝尝我的最新菜品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
