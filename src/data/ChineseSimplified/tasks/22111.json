			},
			"dialogs": [
				{
					"id": 221110101,
					"content": "关于新的委托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110102,
					"content": "你好，冒险家。你的冒险事迹，已经在蒙德广为人知了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110103,
					"content": "以这样的势头接着努力，你一定会成为一个伟大的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110104,
					"content": "有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "如果想要成为一个伟大的冒险家，那你可不能只在熟悉的地方冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110106,
					"content": "既然你已经有了如此充足的冒险经验，要不要试试去别的地方探索一番？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110110,
					"content": "请拿好这封信，把它带给璃月港的凯瑟琳小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110111,
					"content": "璃月港的…凯瑟琳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "是的，您会很容易就找到她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110115,
					"content": "有了这封信，她也会像我一样，为您的各种冒险活动提供最专业的服务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110116,
					"content": "如果您再回到蒙德城，我也会继续为您提供服务，请尽管放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110117,
					"content": "对了，还请您不要随意拆开这封信，不然说不定会遗落掉什么东西，造成不必要的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110118,
					"content": "向着星辰与深渊，请您大步向前吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110113,
					"content": "那以后要叫你「蒙德城的凯瑟琳」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "您大可选择一个便于您开展冒险活动的称呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110107,
					"content": "只是在蒙德…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "因为到目前为止，你也只是在蒙德周围展开冒险呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110109,
					"content": "不过，你很快就能向更外面的世界迈进了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 2211102,
			"completionStepIds": [
				2211102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
