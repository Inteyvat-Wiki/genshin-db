			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110201,
					"content": "有一封信给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110202,
					"content": "向着星辰与深渊！欢迎来到冒险家协会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110203,
					"content": "这封信应该是给你的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "信？让我看看，唔…您是从蒙德来的冒险家啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110205,
					"content": "咦？这是…蒲公英？信里为什么会夹这种东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110206,
					"content": "冒险家，请问是您把蒲公英夹在里面，想以此来证明您从蒙德来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110207,
					"content": "您多虑了，这封信里的信息已经足够证明您的身份和来历了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110208,
					"content": "不是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "不过，这并不是什么重要的事，不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110214,
					"content": "从蒙德冒险家协会的信上看，您已经是个经验丰富的冒险家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110215,
					"content": "那么想必您也准备好，面对璃月冒险家协会的各类委托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110216,
					"content": "向着星辰与深渊，崭新的伟大冒险正在等着您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110210,
					"content": "难道是凯瑟琳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "凯瑟琳？喔，您说的是「蒙德城的凯瑟琳」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110212,
					"content": "她为什么要在里面夹蒲公英呢？真奇怪…蒲公英对冒险可没什么帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 221110213,
					"content": "不过，这并不是什么重要的事，不用在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		}
	]
