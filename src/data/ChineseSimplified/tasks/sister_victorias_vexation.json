			"dialogs": [
				{
					"id": 190010101,
					"content": "芭芭拉小姐…不会出了什么事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190010102,
					"content": "芭芭拉怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "芭芭拉小姐说自己要外出采药，但是到现在还没回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190010104,
					"content": "难道要向西风骑士团报告吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190010105,
					"content": "我去找芭芭拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "你？哦…你这位「荣誉骑士」确实很合适…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190010107,
					"content": "这样的话，倒也免了向骑士团报告后的一堆麻烦事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190010108,
					"content": "那就拜托你了，芭芭拉小姐在离开之前说，她准备去奔狼领附近采药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "维多利亚"
				},
				{
					"id": 190010109,
					"content": "你可以去那边找找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "维多利亚"
				}
			]
		},
