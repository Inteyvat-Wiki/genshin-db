			},
			"dialogs": [
				{
					"id": 751420501,
					"content": "圣山大人因为肚子不舒服，每天都在往外吐那么多东西，你又不是没见过！现在出去玩太危险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420502
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420502,
					"content": "以前叔叔给我讲的故事里都说了，每次遇到火山不舒服的时候，只要大伙用力拍两下就好了…只可惜我的手太小了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420503
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420503,
					"content": "但是那些大人们肯定能拍得动，就是不想我们到部族外去玩，所以才拖着不去拍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420504
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420504,
					"content": "哈哈，杜兹厄原来是这样想的呀！哼哼，可是要让圣山大人恢复正常，就得…至少得部族里所有的大人一起拍才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420505
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420505,
					"content": "可大人们都是很忙的，就比如瓦雷莎姐姐，还得照顾果园呢。得等到大家都有空的时候，一起拍拍圣山大人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420506
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420506,
					"content": "你说的也不是没有道理…唉，得等大人们都有空呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420507
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420507,
					"content": "嗯嗯，所以在那之前，我们就遵守大人们的禁足令，在圣山大人活动这么激烈的时期好好待在部族里吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420508
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420508,
					"content": "…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420509
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420509,
					"content": "你们在这说什么呀，什么拍不拍的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751420510,
					"content": "我们在说…啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420511
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420511,
					"content": "我们在说不能被奇怪的异邦人听进耳朵里的部族秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420512
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420512,
					"content": "原来手拍火山是部族秘密啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420513
					]
				},
				{
					"id": 751420513,
					"content": "什、什么呀，你们不是全听进去了吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420514
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420514,
					"content": "是杜兹厄你讲得太大声了啦，下次要说秘密，就得把嘴巴贴到我耳朵边上说哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420515
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420515,
					"content": "好哦…咦，可是那样不会靠、靠得太近了吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420516
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420516,
					"content": "哈哈，好啦。嗯…异邦来的客人，我是度尼娅，这个家伙是笨蛋杜兹厄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420517
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420517,
					"content": "又叫我笨蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420518
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420518,
					"content": "欢迎你们来到沃陆之邦，还有这边的小嵴锋龙…奇怪，难道是因为圣山大人的状态不对吗…部族里应该有禁外龙的符石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420519
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420519,
					"content": "哼哼，这就说明符石也该被拍一拍啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420520
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420520,
					"content": "现在比较需要被拍拍的是杜兹厄的脑袋瓜…唉，幸好你们看上去不是什么坏人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420521
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420521,
					"content": "所以异邦来的客人是为了什么来的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420522
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420522,
					"content": "向度尼娅和杜兹厄做了自我介绍…\\n并且说明了想要进入圣山的目的…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751420523
					]
				},
				{
					"id": 751420523,
					"content": "想要「进入圣山」啊，那可不是容易的事呢…大人们还告诫我们，圣山是危险的地方，所以不能轻易进入…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420524
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420524,
					"content": "不过，异邦来的客人想要进入圣山内，想必也有自己的理由吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420525
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420525,
					"content": "嗯…我倒是知道有人曾经进过圣山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420526
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420526,
					"content": "我、我也知道呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420527
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420527,
					"content": "咦，那个「圣山」不是对于部族人来说很重要的地方吗？这样随便告诉我们真的好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751420528,
					"content": "「圣山」的称呼是很久很久以前的织卷留下来的…对我们来说，还是「圣火竞技场」要更「圣」一筹呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420529
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420529,
					"content": "我们被禁止进入只是因为里面比较危险啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420530
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420530,
					"content": "而且，以前「话事处」也组建过探险队进火山里…嘿嘿，等我长大了，我也要进去玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420531
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420531,
					"content": "说了多少次，那是很危险的事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420532
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420532,
					"content": "嗯…具体的事我也不太清楚，不过，如果你愿意的话可以找<color=#00E1FFFF>恩波索爷爷</color>，他要是能帮上你的忙，应该也会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420533
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420533,
					"content": "「无所事事的恩波索爷爷」吗…找他还不如去找<color=#00E1FFFF>基莫西</color>呢，嘿嘿，基莫西是我叔叔，以前也曾经参加过冒险队…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420534
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420534,
					"content": "不许说恩波索爷爷无所事事…唔，但是，他们现在一个在<color=#00E1FFFF>山南的挖掘地</color>，一个在<color=#00E1FFFF>村子西边的喷发遗迹</color>那边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420535
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420535,
					"content": "要是能够帮你们带路就好了，只不过现在圣山大人还在「喷吐」的时期…我们不能带你们去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420536
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420536,
					"content": "没关系，告诉我们这些就已经足够啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751420537,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}！回来啦，我们要出发了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751420538,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420539
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751420539,
					"content": "嘿嘿，真是可爱的家伙，尾巴上绑的丝巾也很漂亮。等圣山大人睡着了，到时候一起去部族外面玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420540
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420540,
					"content": "好哦，下次我们再一起玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
