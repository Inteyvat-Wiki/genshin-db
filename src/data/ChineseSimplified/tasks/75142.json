					"杜兹厄",
					"度尼娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420301,
					"content": "关于「喷发遗迹」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420302
					]
				},
				{
					"id": 751420302,
					"content": "哦哦，你想问「喷发遗迹」的事啊！这个我知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420303
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420303,
					"content": "很久很久以前…那个时候，纳塔还是一片安静祥和的乐土…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420304
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420304,
					"content": "啊，其实就是五百年前，纳塔受到深渊侵蚀最严重的时候，从火山里整个喷发出来的遗迹，很完整呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420305
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420305,
					"content": "啊…什么嘛，度尼娅，为什么要抢我的话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420306
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420306,
					"content": "因为每次杜兹厄说起喷发遗迹就得从很久很久之前开始说起，太啰嗦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420307
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420307,
					"content": "呜…这些都是基莫西叔叔和我说的啦，基莫西叔叔也是之前「话事处」组建探索团的成员之一呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420308
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420308,
					"content": "不过听说最近「喷发遗迹」附近又有些深渊的痕迹，不知道基莫西叔叔还好不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420309
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420309,
					"content": "如果你去「喷发遗迹」的话，能不能帮我和基莫西叔叔问好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜兹厄"
				}
			]
		},
