			},
			"dialogs": [
				{
					"id": 751420101,
					"content": "哎呀，异邦的英雄，还有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420102
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420102,
					"content": "一定是找不到「挖掘地」和「喷发遗迹」，既然如此，我们也只能稍稍违背大人们的禁令…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420103
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420104
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420104,
					"content": "呜，好吧…我不会出部族的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420105
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420105,
					"content": "#那么，{NICKNAME}…有什么想问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "度尼娅"
				}
			]
		},
		{
			"id": 7514202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7514201",
							"2"
						],
						"stepId": 7514201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"度尼娅",
					"杜兹厄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420201,
					"content": "关于「挖掘地」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420202
					]
				},
				{
					"id": 751420202,
					"content": "嗯，其实挖掘地应该被称为「秘源遗迹的挖掘地」，就在圣山的南侧，有一大片遗迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420203
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420203,
					"content": "据说也是很久很久以前的巨龙留下来的呢，为了防止有不怀好意的盗宝团偷偷发掘遗迹，恩波索爷爷每天会在那边巡逻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420204
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420204,
					"content": "从前恩波索爷爷就对这些遗迹啊，遗物什么的特别上心，还加入过龙遗物研究协会，每次都会和我们说过去的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420205
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420205,
					"content": "不过，恩波索爷爷讲故事的水平好差，而且都很枯燥无聊，什么从遗迹的什么纹路上就能看出什么图腾「葱白」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420206
					],
					"speakerTitle": "杜兹厄"
				},
				{
					"id": 751420206,
					"content": "是图腾「崇拜」啦…因为恩波索爷爷比起叙事人更像是个考古家嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420207
					],
					"speakerTitle": "度尼娅"
				},
				{
					"id": 751420207,
					"content": "据说，恩波索爷爷以前也曾经探索过火山内，说不定能帮上你们的忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "度尼娅"
				}
			]
		},
		{
			"id": 7514203,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
