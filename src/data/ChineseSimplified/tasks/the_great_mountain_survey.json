			"trigger": {
				"objectNames": [
					"艾斯特尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "你找到我的信标了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040202,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "给我看看，没错，这些是我的信标！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040204,
					"content": "这个状态…它们一定还是被魔物折腾过了，还好，总算是没有彻底坏掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040205,
					"content": "唉，但这些信标暂时是不能用了…算了，不能完全勘测就不能完全勘测吧，能测一点是一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040206,
					"content": "我这里还有几个信标，你能帮我把它们都放到山上去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040207,
					"content": "具体要放在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "你是答应我了吧！谢谢你，我这就把地点给你标注在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040215,
					"content": "好了，我已经把地点给你标好了，把信标放在那附近就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040216,
					"content": "你放置信标的时候，记得把信标放在高处啊，那样勘测的效果才最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040209,
					"content": "你怎么不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "我不敢去啦…连探险队都被怪物袭击成那个样子，我一个人怎么敢上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040211,
					"content": "而且我暂时也找不到另一支要进山的探险队，再这么拖下去，不知道要拖到什么时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040212,
					"content": "所以我只能拜托你了，你之前那么顺利就帮我拿回了信标，身手一定不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040213,
					"content": "这件事就拜托你了，我一定会准备好报酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "艾斯特尔"
				},
				{
					"id": 701040214,
					"content": "对了，我把要放置信标的地点给你标在地图上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "艾斯特尔"
				}
			]
		},
