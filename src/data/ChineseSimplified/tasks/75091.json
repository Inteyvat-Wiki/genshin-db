					"基斯庇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "呜哇，没想到上面真的长出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910302,
					"content": "「宝藏岩」，好厉害…不对，不会是基斯庇你放在「宝藏岩」上的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910303,
					"content": "…呵，呵呵，我怎么会做如此愚蠢之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910304,
					"content": "多亏了你们给的石头，「宝藏岩」也变得更具活力，啊，你们听不见吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910305,
					"content": "那仿佛地中流焰鼓动的声响，就像是…啊，就像是脉搏一般…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910306,
					"content": "果然，让它吃点别的石头…是对的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910307,
					"content": "唔，什么都听不到啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910308,
					"content": "#{NICKNAME}你能听到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910309,
					"content": "感觉只是正常岩石…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "是哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910313,
					"content": "哼哼，异邦的…啊，两位了不起的异邦的客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910314,
					"content": "如果可以的话，再给我一些石头吧，更好的，更漂亮的石头…相信，「宝藏岩」的力量不会让你们失望的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910315,
					"content": "我能感受到，我能感受到，这样一定对它也是有好处的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910316,
					"content": "总有种逐渐深入陷阱了的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910317,
					"content": "#{NICKNAME}，你觉得呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910318,
					"content": "能拿到更好的石头的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "确实有继续试试的价值呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910320,
					"content": "嘿嘿，那就，挑些比以前更好的石头交给我吧…啊，更好的石头，这样，「宝藏岩」的力量，也一定会有所增长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910311,
					"content": "「宝藏岩」在大叫！「呜哇哇」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "才不会呢！你又在吓我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7509104,
