			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"基斯庇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "一颗，两颗，嗯，三颗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910102,
					"content": "哼，哼，一颗…两颗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910103,
					"content": "呜哇，这里有个好奇怪的部族人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910104,
					"content": "奇怪的应该是你们这些异邦人才对，呵，呵呵，这可不是异邦人应该来的地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910105,
					"content": "这是什么禁地…或者圣地之类的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910106,
					"content": "并不是，这只是我偶然发现的，宝藏之地。哼，来吧，两位，靠近点，你有没有听见，这块特殊的岩石…「宝藏岩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910107,
					"content": "其中传来的，犹如低鸣般起伏，就仿佛，啊，就仿佛有人在呼吸一般的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910108,
					"content": "石头也很辛苦嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "只是呼吸而已，算什么辛苦啦，不对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910112,
					"content": "石头，石头也会呼吸吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910113,
					"content": "不仅有呼吸，如果将耳朵贴上去，还能听到它在律动，听到这粗糙的表皮之下，岩石摩擦的声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910114,
					"content": "嘿，嘿，真是美妙的声响啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910115,
					"content": "而且，而且哦，只要将一些小的石头喂给它，甚至能够吐出更好，更漂亮的石头来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910116,
					"content": "啊啊，很不可思议吧，你看，这些宝石，一颗，两颗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910117,
					"content": "原来刚才我们过来的时候，你在数这些宝石啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910118,
					"content": "对，而且，我能感受到，吃下不同石头的这块「宝藏岩」，变得更加强壮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910119,
					"content": "这一定是，了不起的奇迹，啊啊，「宝藏岩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910120,
					"content": "听上去很可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "呵，呵呵，本来就不指望你们这些异邦人会相信。如果不尝试一下的话，没人会相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910123,
					"content": "我也是偶然把收集到的矿石放在「宝藏岩」边上，才发现的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910124,
					"content": "对了，就让你们试一试吧！试一试你们就会相信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910125,
					"content": "正好，附近的石头，它已经全部吃过一遍了，得让它吃点新的石头…可是我没法去找给它吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910126,
					"content": "欸，为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910127,
					"content": "当然！我当然要一直看着「宝藏岩」啊！要是、要是在我离开的时候，它钻入地底，那该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910128,
					"content": "我已经在这里看守很久了…身上所有的石头都已经给它吃过一遍了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910129,
					"content": "你们，你们给我点新的石头吧，我来把石头喂给它，证明给你们看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910130,
					"content": "唔，听上去好像一个骗子哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910131,
					"content": "#怎么办，{NICKNAME}，要试试看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910132,
					"content": "反正只是石头的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "嘿嘿，那就，挑些石头交给我吧…「宝藏岩」一定会吐出更好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910121,
					"content": "真的吗，很像在骗人欸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "我也会呼吸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "对啊，会呼吸有什么了不起…唔，没人在说这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
