			"dialogs": [
				{
					"id": 750910201,
					"content": "嗯…要耐心一些，等到，等到安静的时候，我会将这些石头喂给「宝藏岩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910202,
					"content": "只要再过段时间，嘿，就会长出更好的石头的，嘿嘿，一颗…一颗，两颗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				}
			]
		},
