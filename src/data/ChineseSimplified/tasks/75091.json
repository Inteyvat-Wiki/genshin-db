				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "嗯，确实长出了更好的石头，虽然已经是第二次看到了，但感觉还是很神奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910502,
					"content": "呵，呵呵，多疑的外邦人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910503,
					"content": "这下你们终于能够明白…「宝藏岩」的伟大之处了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910504,
					"content": "啊啊，「宝藏岩」，得益于你们拿来的石头，「宝藏岩」的力量也变得更加深厚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910505,
					"content": "真不知道它最后会变成什么样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910506,
					"content": "嗯，这么一说，就连我都有些好奇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910507,
					"content": "到底是为什么，只要吃进去石头，就能吐出一些更好的？不如…我们把它打开来看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910508,
					"content": "你、你在说什么，决不允许这样做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910509,
					"content": "要是…要是你们想要把「宝藏岩」打开的话，首先就要从我的尸体上踏过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910510,
					"content": "唔，我只是随口一说啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910511,
					"content": "哼，看在你们之前为「宝藏岩」拿来石头的份上…这次就饶过你的冒犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910512,
					"content": "好、好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910513,
					"content": "我已经，哼哼，我已经感受到了，只要再给「宝藏岩」吃下更高级的石头，它一定能够产生了不起的变化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910514,
					"content": "异邦的旅人啊，我曾听外来的行商说，在沙漠之中有一种特殊的辉石，蕴藏了不起的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910515,
					"content": "它的名字，是…对，它的名字是「万相石」。如果、如果能够将那种石头带来，喂给「宝藏岩」的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910516,
					"content": "一定，一定就可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "基斯庇"
				},
				{
					"id": 750910517,
					"content": "#唔，{NICKNAME}，你觉得呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910518,
					"content": "那就试试吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "确实，很好奇会发生什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750910520,
					"content": "如、如果有「万相石」的话…给我，只需要给我一枚就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基斯庇"
				}
			]
