			"dialogs": [
				{
					"id": 766760101,
					"content": "鼓掌鼓掌！活动进行到现在，可以说，已经到了完美境界！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760102
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 766760102,
					"content": "好几位须弥朋友们学会了纳塔风格的舞蹈，我看到了我们的舞蹈走向全提瓦特的潜力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760103
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 766760103,
					"content": "期待之后，我们两边的「舞术交流」常态化，每隔一段时间，都稳定互访！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760104
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 766760104,
					"content": "那，纳塔的龙龙们也能像「镀金旅团」一样大耍刀舞了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760105,
						766760106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766760105,
					"content": "还有传说中的战舞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				},
				{
					"id": 766760107,
					"content": "啊？说的难道是…努斯妲她们最初见到弯刀叔叔时，弯刀叔叔他们用来吓退那些圣骸赤鹫的示威动作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760108
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760108,
					"content": "弯刀叔叔没和你们说明吗？那些动作的来源？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760109
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760109,
					"content": "有说啊，那支舞不是叫…「炽鬃之狮与苍鹭之守的二重奏」来着吗？是个优美与力量感并重的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760110
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 766760110,
					"content": "好，好熟悉两个称号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760111,
						766760112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766760111,
					"content": "似乎想起了两位朋友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760113,
					"content": "#{NICKNAME}和派蒙应该已经料到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760114
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760114,
					"content": "你们遭遇圣骸赤鹫的那片区域，正好在「炽光猎兽」驮兽车队常走的一条路附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760115
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760115,
					"content": "有些日子之前，车队载着迪希雅大姐和坎蒂丝大姐一起回阿如村时，就遭遇了那群赤鹫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760116
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760116,
					"content": "结果，两位大姐正觉得之前出门没好好活动筋骨，就把劲头全甩在了那群赤鹫身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760117
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760117,
					"content": "从那以后，只要「炽光猎兽」的成员们开始模仿她们两位出招的动作，那群赤鹫就会识相地逃开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760118
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760118,
					"content": "果然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766760119,
					"content": "该说那群圣骸赤鹫也是倒霉吗？居然被迪希雅和坎蒂丝来了个混合双打…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760120,
						766760121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766760120,
					"content": "它们是自讨苦吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760122,
					"content": "好家伙！上次居然错过了和这两位高手交流的机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760123
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 766760123,
					"content": "等我们再去须弥的时候，请务必将我引见给她们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760124
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 766760124,
					"content": "我很想向她们请教拳法，尤其是高速狂猛出拳时，从脚底至大腿，从大腿到腰背，再倾注力量到手臂与拳的节拍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760125
					],
					"speakerTitle": "努斯妲"
				},
				{
					"id": 766760125,
					"content": "啊哈，到时候，你们应该还会喝个痛快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760126
					],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760126,
					"content": "我得提前给你们准备好醒酒汤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔拉内"
				},
				{
					"id": 766760121,
					"content": "迪希雅和坎蒂丝干得漂亮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760112,
					"content": "好像能猜到来龙去脉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760106,
					"content": "能吓退赤鹫的那种…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				}
			]
		}
	]
}