			},
			"dialogs": [
				{
					"id": 760550101,
					"content": "（<color=#FFCC33FF>菈乌玛</color>似乎听到了什么…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "…奇怪。刚才听见了什么响动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760550103,
					"content": "（又有客人！转动轮盘，停下转盘，就有好吃的！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550104,
					"content": "（咦？客人怎么不转呀，快点快点，想吃好吃的！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550105,
					"content": "听起来，像是一只小狗…？转动轮盘，有好吃的…这又是什么意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760550106,
					"content": "（客人！能和我说话，客人，快点转动轮盘吧，不然我就吃不到好吃的啦。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550107,
					"content": "你饿了么？来，我带着一些饼干，先吃一点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760550108,
					"content": "（呜？客人不转轮盘，客人要给我吃的…嗯，先吃，先吃。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550109,
					"content": "（谢谢客人，我是巴甫洛夫，谢谢客人的饼干，好吃好吃。但你没有转动轮盘呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550110,
					"content": "不用客气，但…你刚才说的转盘，是什么意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760550111,
					"content": "（转盘动了，让它停下，好吃的会掉下来，每次都是这样。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550112,
					"content": "（客人，你真的不转转盘吗？每个人转完之后，都很高兴。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550113,
					"content": "我就不用了，看样子…你在这里过得还不错？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760550114,
					"content": "（好呀，好呀，有人陪着我玩，转盘陪着我玩，还有好吃的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "巴甫洛夫"
				},
				{
					"id": 760550115,
					"content": "这样就好。那么，替我向你的主人问好，我先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 760550116,
					"content": "（呜…客人再见，客人下次再见。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴甫洛夫"
				}
			]
		},
