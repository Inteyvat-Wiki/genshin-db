				]
			},
			"dialogs": [
				{
					"id": 700920201,
					"content": "欢迎来到提瓦特最具戏剧张力的地方——欧庇克莱歌剧院…的魔法拟造空间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920202
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920202,
					"content": "这次的课题是「辩论」，为此我专门打造了这样的魔法空间。还不错吧？诚意多多仪式感满满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920203
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920203,
					"content": "辩论？上次你已经彻底输给我了吧，还想来自取其辱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920204
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920204,
					"content": "呵呵…你在12岁的辩题里展现了高达16岁的智慧，不可思议！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920205
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920205,
					"content": "考虑到你是反驳型人格…所以这次我准备了一个你无法反驳的绝妙论题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920206,
						700920207
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920206,
					"content": "不好意思打扰一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				},
				{
					"id": 700920208,
					"content": "一场精彩绝伦的辩论少不了一位公平公正的评委，我们几个中你是最佳的人选，我想没有人会反对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920209
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920209,
					"content": "那…派蒙在那个位置合适吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920210
					]
				},
				{
					"id": 700920210,
					"content": "其实我早就想说了，派蒙那家伙已经在高处的贵宾席位上摆了很久的姿势了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920211,
						700920212
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920211,
					"content": "这句话似曾相识…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920213,
					"content": "嘻嘻…居然被传送到这个位置上，我就突发奇想模仿一下我们的朋友，她可是枫丹的大明星噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920214,
					"content": "我记得派蒙喜欢看热闹，这个观看席位视野最好，还满意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920215
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920215,
					"content": "原来这里看出去的视角是这样的啊…呃，可是我真的可以坐在这看吗？会不会太僭越了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920216,
					"content": "放心，这里是用魔法拟造的空间，魔女说了算。不会有警卫闯进来把你们抓走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920217
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920217,
					"content": "还有坐在山顶的朋友派蒙，对这个贵宾观看席还满意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920218
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920218,
					"content": "非、非常震撼！好气派呀…第一次坐在这种地方，我都有点说不出话来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920219,
					"content": "那请你快快适应哦，接下来的精彩瞬间很需要你的欢呼喝彩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920220
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920220,
					"content": "好了别闹了，速战速决吧，说出你的题目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920221
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920221,
					"content": "可莉是个坏孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920222
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920222,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920224,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920225
					]
				},
				{
					"id": 700920225,
					"content": "这就是你要反驳的辩题。如果你能证明「可莉不是坏孩子」，我就送你一份小礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920226
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920226,
					"content": "谁稀罕你的小礼物啊！可莉是你的亲生女儿，你怎么能出这样的题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920227
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920227,
					"content": "你…坏到极致的坏女人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920228
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920228,
					"content": "哼哼。正所谓「有其母必有其女」，既然你咬定我是坏人，那坏人的孩子就是坏孩子，没有错吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920229
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920229,
					"content": "反对！简直愚昧，你坏的是人品和作风，没有科学依据证明这种东西会遗传。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920230
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920230,
					"content": "再说了，比起遗传，成长环境更重要，蒙德那群人比你靠谱多了，可莉有他们陪着根本坏不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920231
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920231,
					"content": "但事实是，可莉很喜欢炸鱼，这就是坏孩子的有力证明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920232
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920232,
					"content": "这…这只是儿童善恶不明的天性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920233
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920233,
					"content": "港口的船也经常会捕鱼回来，对可莉来说她哪里分得清为什么捕鱼可以但炸鱼就不行嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920234
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920234,
					"content": "那我就要说了，可莉每次关完禁闭还是屡教不改哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920235
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920235,
					"content": "就凭可莉每次都能乖乖配合关禁闭，说明她从来都是认罚的，没有逃避过责任哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920236
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920236,
					"content": "不应该在可莉承担完后果后，再给她扣上坏孩子的帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920237
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920237,
					"content": "而且，上一次关完禁闭后，可莉虽然嘴上说着想要炸鱼，却没有「擅自」去做这件事，一次都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920238
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920238,
					"content": "最近的一次行动，全因受了信任之人的「唆使」和「纵容」。而这个人，是一位「混沌」的母亲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920239
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920239,
					"content": "嗯哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920240
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920240,
					"content": "归根到底，你才是那个最该被扣上坏孩子帽子的人！不对，坏大人！也不对，哪有这么幼稚的大人，坏大孩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920241
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920241,
					"content": "形势反转了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920242
					]
				},
				{
					"id": 700920242,
					"content": "听上去好有气势…是很漂亮的一击！对方辩手又该如何应对呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920243,
					"content": "就算如此，也只能说明可莉主观上没有坏心思。恐怕这不能成为大家眼里可莉不是坏孩子的理由哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920244
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920244,
					"content": "还想硬撑么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920245
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920245,
					"content": "那你听好了，这点你永远无法反驳——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920246
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920246,
					"content": "因为可莉很可爱，所以大家都会原谅她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920247
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920247,
					"content": "对！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920248
					]
				},
				{
					"id": 700920248,
					"content": "没错！可莉这么可爱，犯点小错怎么了，反正她在我眼里不是坏孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920249,
					"content": "比起你说的那些，明明她身上的优点更多：会把玩具分享给别人，想去玩的时候发现大家在忙就在一边乖乖等待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920250
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920250,
					"content": "最重要的是，对每个人都充满善意，所有人在她眼里都是好人，包括将她妈妈视为敌人的我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920251
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920251,
					"content": "总之，这么可爱的孩子，我不许你说她是坏孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920252
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920252,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920253
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920253,
					"content": "我投降啦！身为妈妈不可能不认同这句话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920254
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920254,
					"content": "而且终于从你嘴里听到这句话了，看来你是真心把可莉当成好朋友的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920255
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920255,
					"content": "我的女儿非常可爱对不对？我早就说过了，去找到她，你也会变得快乐的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920256
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920256,
					"content": "你还得意上了？我之所以千里迢迢跑到蒙德来不就是因为你的恶作剧吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920257
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920257,
					"content": "嘻嘻。可莉有你这位好朋友的陪伴，我就更加放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920258
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920258,
					"content": "真期待你们的成长啊，你也想象不到可莉到我这个年纪还炸鱼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920259
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920259,
					"content": "等等，你该不会说「这个课题真正要考验的是你对可莉的真心」这种超土的话吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920260
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920260,
					"content": "真聪明。那就快进到宣布挑战结果的环节吧。有请评委老师——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920261
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920261,
					"content": "咳咳，「布伦妮小朋友的魔女挑战课题，合格！现送出魔女的祝福」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920262
					]
				},
				{
					"id": 700920262,
					"content": "「祝你和可莉一样，身体好好吃饭饱饱烦恼少少，当个快乐的小孩」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920263
					]
				},
				{
					"id": 700920263,
					"content": "你和可莉都是好孩子，即便偶尔犯错或闹脾气，也是可以被允许的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920264
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920264,
					"content": "谢…谢谢？但一码归一码，说了多少次别把我当小孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920265
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920265,
					"content": "别忘了我是魔女猎人，不会跟你和解的，想都不要想！你输了，老实出来，别用这个大玩偶糊弄我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920266
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920266,
					"content": "今天玩得很开心，下次有空再来逗你玩。拜拜~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920267
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920267,
					"content": "跟你说话呢没听见吗？别跑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920212,
					"content": "这个场面也是！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920213
					]
				},
				{
					"id": 700920207,
					"content": "我在这个位置合适吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920208
					]
				}
			]
		},
