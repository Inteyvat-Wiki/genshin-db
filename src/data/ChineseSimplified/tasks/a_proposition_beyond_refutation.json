			"dialogs": [
				{
					"id": 700920101,
					"content": "给布伦妮的…与其说是课题，不如说是一封战书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920102,
					"content": "「哼哼，小小魔女猎人，想好打败我的方法了吗？大声喊出你酷酷的挑战宣言，准备好败给大魔王吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920103,
					"content": "这个口吻…是艾莉丝吧。要不是写了「魔女猎人」，我还以为这是给可莉写的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920104,
					"content": "布伦妮一直对艾莉丝敌意很大，收到这种挑衅会不会被激怒呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920105,
					"content": "很明显，艾莉丝是故意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920106
					]
				},
				{
					"id": 700920106,
					"content": "我们要不要换个委婉点的方式告诉布伦妮？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920107,
					"content": "要告诉我什么？我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920108
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920108,
					"content": "吓我一跳！你先不要激动，听我说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920109,
					"content": "…无聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920110
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920110,
					"content": "欸？意外地淡定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920111,
					"content": "哈。她这种幼稚的把戏我见多了，故作神秘，本质上就是场耍小孩的恶作剧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920112
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920112,
					"content": "谁会在路上「大声喊宣言」啊，不明真相的路人只会觉得莫名其妙吧，我才不上当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920113
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920113,
					"content": "简直等于在街上喊：我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920114
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920114,
					"content": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920115
					],
					"speakerTitle": "留声机"
				},
				{
					"id": 700920115,
					"content": "什、什么啊？！为什么我的声音会从那里冒出来啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920116
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920116,
					"content": "谁？谁在说话？哈哈，谁是大笨蛋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920117
					],
					"speakerTitle": "不明真相的路人"
				},
				{
					"id": 700920117,
					"content": "竟然会有人说自己是大笨蛋，哈哈哈，是不是玩游戏输了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920118
					],
					"speakerTitle": "爱凑热闹的路人"
				},
				{
					"id": 700920118,
					"content": "绝对是小孩的恶作剧，看来有个笨小孩上当受骗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920119
					],
					"speakerTitle": "理智的路人"
				},
				{
					"id": 700920119,
					"content": "可恶…快停下，不准叫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920120
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920120,
					"content": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920121
					],
					"speakerTitle": "留声机"
				},
				{
					"id": 700920121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920122
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920122,
					"content": "冷静一下布伦妮！先不要砸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920123,
						700920124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700920123,
					"content": "收手吧，布伦妮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				},
				{
					"id": 700920125,
					"content": "啊…艾——莉——丝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920126
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920126,
					"content": "嗨嗨各位。哎呀~没想到是这样的宣言呢，非常有意思。恭喜你成功开启魔女的课题挑战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920127
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920127,
					"content": "我为这次的挑战准备了一个很有仪式感的魔法空间，但魔法加载需要点时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920128
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920128,
					"content": "所以我早早就想好了，把挑战宣言做成加载音效，循环播放给你鼓舞士气，怎么样，喜欢吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920129
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920129,
					"content": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920130
					],
					"speakerTitle": "留声机"
				},
				{
					"id": 700920130,
					"content": "不，这不是什么宣言，快撤回这个破音效啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920131
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920131,
					"content": "看来闹乌龙了。可是音效跟挑战魔法是一个整体，撤回就等于放弃挑战哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920132
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920132,
					"content": "真的吗？确定吗？那只好有缘再见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920133
					],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920133,
					"content": "不…不准走！好不容易才逮住你。啊啊啊…你那破魔法到底还要加载多久啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920134
					],
					"speakerTitle": "布伦妮"
				},
				{
					"id": 700920134,
					"content": "早就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾莉丝"
				},
				{
					"id": 700920124,
					"content": "周围全是留声机！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700920125
					]
				}
			]
		},
