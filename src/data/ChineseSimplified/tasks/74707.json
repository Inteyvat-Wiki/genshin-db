			"dialogs": [
				{
					"id": 747070101,
					"content": "…好，没问题！再来一条——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747070102,
					"content": "好。停——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747070103,
					"content": "芙宁娜！还有哥伦比娅和千织，又见面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747070104,
					"content": "嗯，我们刚好拍完上次说的氛围镜头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747070105,
					"content": "哦！就是让鱼儿来当演员的那个吧，怎么样怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747070106,
					"content": "多亏你们的帮助，我们找到了一位合适的「演员」。拍摄很顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747070107,
					"content": "你们布置水族箱也很有一套。芙宁娜导演刚才还说看得她想去拍部水下纪录片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "千织"
				},
				{
					"id": 747070108,
					"content": "多谢夸奖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "嗯，我也很喜欢。我能感觉到鱼儿们游得很惬意，很满足，你们照料得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747070111,
					"content": "真希望这水族馆一直留在这里呢，这样就能时不时来看看这些鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747070112,
					"content": "真舍不得的话，就多剪几个镜头到映影里呗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "千织"
				},
				{
					"id": 747070113,
					"content": "你说得对。那干脆再补几条吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747070114,
					"content": "补几条鱼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747070115,
					"content": "补镜头啦…灯光师，摄影师，还有场记就位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 747070116,
					"content": "来啦！不过为鱼儿们打板还真是头一回呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747070109,
					"content": "你们喜欢就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
