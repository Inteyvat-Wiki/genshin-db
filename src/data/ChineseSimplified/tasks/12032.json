			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷电将军",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "接下来，稻妻一定会迎来更多挑战，不过我已经做好准备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320102,
					"content": "关于「挑战」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "解除锁国令难免牵连众多，不能说只有积极效应而毫无损害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320104,
					"content": "比如可预见的，外界对稻妻商业造成冲击等问题。这些都是接下来我会着手处理的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320105,
					"content": "影真是认真啊。我考虑的只有，以后鸣神大社是不是可以卖门票了之类的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320106,
					"content": "你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320107,
					"content": "关于神明的注视…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "真的视线一直在稻妻人民身上。我曾以为，这是她的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320109,
					"content": "可现在看来，这种注视饱含了赏识与期待，除了责任，她一定也乐在其中。她是非常爱人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320110,
					"content": "过去的人值得注视，现在与未来的人亦如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320111,
					"content": "嗯，我不会再忽视他们的热情与梦想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320112,
					"content": "关于几百年的战斗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "坦白说，那是一场看不到尽头的折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320114,
					"content": "面对无尽的战斗，必须时刻集中注意力。稍有松懈，将军的刀就会要了我的命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320115,
					"content": "可以说，若是没有此前的经历与见闻，没有刀中之力，我定会落败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320116,
					"content": "这之中，也有你的功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320117,
					"content": "关于神樱树的伤痕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "放心吧，我没有忘记，我会叮嘱天领奉行与社奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320119,
					"content": "除了魔物的威胁，我还在担心，神樱树中会不会逸散出其他东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320120,
					"content": "那可不好说，除了回忆，地脉里的东西还多着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320121,
					"content": "你也清楚的话，就不要偷懒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320122,
					"content": "八重神子说她的神明就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "哎呀？是谁在胡言乱语当面造谣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320124,
					"content": "有些话，是不可以随便复述的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320125,
					"content": "出卖我要付出什么代价，你不会想知道的。把我说的话当成我和你的秘密就好，明白了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320126,
					"content": "你们在讨论什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120320127,
					"content": "没什么，想吃油豆腐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320128,
					"content": "没其他想问的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}