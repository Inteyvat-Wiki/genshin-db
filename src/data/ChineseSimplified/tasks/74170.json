				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "哦！你又回来了。我也回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701702,
					"content": "院里听完简报之后让我在回收资产的时候也评估一下这里是否具有改造成素质拓展训练场地的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701703,
					"content": "唉，总觉得这种工作似曾相识。以前也有这么一段时期，事务官格外热衷于带大家进行潜水训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701704,
					"content": "我是觉得没什么用，不过工作就是工作，任务就是任务…而且这里的确结构很奇怪…我是说奇特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701705,
					"content": "所以我在各处放了一些桩锚复制品，简单说就是桩锚的模型啦，是完全没有风险的安全道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701706,
					"content": "我目前设想的训练内容是，<color=#00E1FFFF>在规定时间内回收建筑内的所有桩锚复制品。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701707,
					"content": "你想试试看吗？挑战成功的话我也会提供一些报酬，毕竟也是协助调研。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布里科勒"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
