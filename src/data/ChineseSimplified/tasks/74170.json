			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "你成功了！看来这并不是无法完成的挑战，我可以安心把方案提交给院里了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741700402,
					"content": "可惜这里的资产还没有清点完毕，之后我多半还得回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741700403,
					"content": "不管怎么说，感谢你的协助，对了，还有报酬。祝你旅途顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布里科勒"
				}
			]
		},
