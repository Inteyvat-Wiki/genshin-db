			"trigger": {
				"objectNames": [
					"弗雷瑞斯",
					"谢妮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "两位朋友，你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110102,
					"content": "你们是…警备队？找我们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110103,
					"content": "嘿嘿，猜猜看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110104,
					"content": "难道说是在城里飞檐走壁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "你们居然还做过这种事呀！慢点说，我立刻记录在案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110107,
					"content": "原来是在诈我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110108,
					"content": "开个玩笑。介绍一下，我叫谢妮，这位是我的前辈，弗雷瑞斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110109,
					"content": "前辈最近做了一款新发明，想找人帮忙尝试一下，不知道两位有没有兴趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110110,
					"content": "发明？什么新发明呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110111,
					"content": "一种可以远程控制的炮台。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110112,
					"content": "你们看，以前的炮台需要有人在旁边操控吧？那敌方只要瞄准炮台，就可以把我们一锅端掉啦。但是如果我们可以远程操控的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110113,
					"content": "就可以尽量减少伤亡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110114,
					"content": "就是这样！不愧是「曾三次拒绝枫丹科学院邀请」的弗雷瑞斯前辈，居然能轻松做出这么神奇的发明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110115,
					"content": "三次拒绝枫丹科学院邀请？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110117,
					"content": "没错！我跟你们说哦，枫丹科学院曾经看中弗雷瑞斯前辈的才华，三次花重金聘请他去做高端研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110118,
					"content": "前辈因为热爱警备队的工作，所以一直留在这里，多么感人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110119,
					"content": "即便如此，前辈还是不忍自己的才华被浪费，所以时不时会创造出一些新发明，为我们解决各种苦恼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110120,
					"content": "听起来好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110121,
					"content": "咳。过誉了。谢妮，还记得我对你的教导吗？越是聪明的人，越懂得谦虚的可贵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110122,
					"content": "是，弗雷瑞斯前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110123,
					"content": "总之，我们想请两位帮忙验证这款远程炮台的可行性。「场地」和「标靶」我们已经准备好了，关于酬劳，我们也绝对不会吝啬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110124,
					"content": "嘿嘿，这你可找对人啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110125,
					"content": "#我和{NICKNAME}一路走来，见过各种各样的新鲜东西。就让我们帮你鉴定一下，你的发明到底好不好用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110126,
					"content": "加油，两位。加油，弗雷瑞斯前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745110127,
					"content": "呃…总之，这边请吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110105,
					"content": "难道说是在城里舞刀弄剑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}