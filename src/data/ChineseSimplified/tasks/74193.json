			"dialogs": [
				{
					"id": 741930101,
					"content": "#派蒙！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930102,
					"content": "哇！居然是珀西芙！又见到你了，真高兴！你在这里做什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930103,
					"content": "珀西芙…干活！珀西芙…累累！珀西芙…躺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930104,
					"content": "呃…？你在干活？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930105,
					"content": "幽林枝…幽林枝…十分很丢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930106,
					"content": "幽林枝？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930107,
					"content": "幽林枝…信息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930108,
					"content": "垂柳，收集。雾道，处理。泉眼，发送。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930109,
					"content": "幽林枝，雾道信息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930110,
					"content": "那是幽林雾道的信息？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930112,
					"content": "幽林枝…十分很丢！十分很多地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930113,
					"content": "珀西芙…找！珀西芙…累累！珀西芙…吃！珀西芙…躺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930114,
					"content": "幽林枝…十分很不多！但是箱子，十分很多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930115,
					"content": "#啊…谢谢派蒙，谢谢{NICKNAME}，给！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930116,
					"content": "你又给我们找到了宝箱吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "珀西芙！箱子，宝贝，花花，闪闪，甜甜，十分很多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930118,
					"content": "哇，还有别的东西吗？珀西芙，你真好，但如果白拿你的东西就太不好意思了，不如我们来交换吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930119,
					"content": "交…换？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930120,
					"content": "因为我们是朋友，朋友就是用真心交换真心的那种！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930121,
					"content": "所以我们去帮你找那个幽林枝，然后来换你的东西，你觉得好不好呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930122,
					"content": "还可以给你找点吃的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "对哦，珀西芙一个人在外面应该很辛苦，我们可以帮她找吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930124,
					"content": "吃的！汐藻！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930125,
					"content": "你喜欢吃汐藻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "汐藻！汐藻！汐藻汐藻汐藻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930127,
					"content": "一天吃五顿？还是一顿吃五个？呜哇…感觉比我还能吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930128,
					"content": "那幽林枝呢？珀西芙，是不是去幽林雾道就可以找到啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930129,
					"content": "美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930130,
					"content": "幽林枝…十分很丢！十分很多地方！十分伊黎耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930131,
					"content": "幽林枝在整个伊黎耶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#聪明{NICKNAME}！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930133,
					"content": "雾道，有花花，幽林枝，也花花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930134,
					"content": "幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…数量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930135,
					"content": "啊…这次我一下就听懂了！幽林枝在的地方，长着和幽林雾道一样的花，一共有六个地方，是这样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930136,
					"content": "聪明派蒙！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930137,
					"content": "嘿嘿，这下我们就都清楚了。珀西芙，那你就先好好休息，这件事包在我们身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930138,
					"content": "#派蒙，{NICKNAME}，好东西！所以，慢慢…慢慢！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珀西芙"
				}
			]
