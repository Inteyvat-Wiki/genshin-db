				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡",
					"赛芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "静静等待了片刻之后，幼芽慢慢从土里冒了出来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "赛芭的方法真的有效！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732070302,
					"content": "终于发芽了，终于…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070303,
					"content": "看来，那位沙法卡特先生生前许下的心愿能够被实现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070304,
					"content": "阿凡老先生，你之前告诉我，这种蔷薇是由他培育出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070305,
					"content": "能培育出新品种，他和我一样，也是被驱逐到这里的学者对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070306,
					"content": "…是的。他被流放到了这个村子，在我们身后的屋子里度过了一生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070307,
					"content": "是这样啊，的确，既然成为了流放者，最后的结局都会如此吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070308,
					"content": "说起来，培育新品种是只有顶尖学者才办得到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070309,
					"content": "他这样的人，就这么籍籍无名地消失在教令院之外的地方，真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070310,
					"content": "赛芭是想到了自己的将来吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732070311,
					"content": "请振作起来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "是啊，孩子，你还有很长的路要走，还有很多事可以做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070313,
					"content": "不要被感伤困住，我可不想看到第二个鬼老头出现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070317,
					"content": "说的也是，我怎么在这种开心的时候伤感起来了，我们说正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070318,
					"content": "现在这些金蔷薇还只是发了芽，还没有开花。我想一直见证到金蔷薇盛开，你们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070319,
					"content": "我也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "那我们多等些时间，让它们汲取一点养分，过一段时间再一起来见证它们盛开吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732070314,
					"content": "（不知道该如何劝慰赛芭…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "别难过，你看，到最后他还是给我们留下了金蔷薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070316,
					"content": "它们还能证明沙法卡特叔叔来过这个世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "阿凡"
				}
			]
		},
