			"dialogs": [
				{
					"id": 732030602,
					"content": "这是我采到的须弥蔷薇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "多让人怀念的花，给你的礼物我也准备好了，你拿着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030604,
					"content": "都是无法在这里生长发芽的植物种子，如果你在别处有宅院的话，就能看它们长大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
