			"trigger": {
				"objectNames": [
					"赛芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "你是哪个学派的学者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "想聊聊我的学派？我能说上三天三夜都不停，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030607,
					"content": "我以前属于生论派，专攻植物演化，算是一门实证研究学科吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030608,
					"content": "这意味着没有新材料就很难发现新结论，你可以简单理解成：要考察过去的植物，历史标本是研究基础。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030609,
					"content": "但是便于搜集的标本就那么多，它们基本上都被搜罗得差不多了，教令院能提供的新标本有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030610,
					"content": "客观条件就是这样，但院内还是在不断要求研究指标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030611,
					"content": "有人就把以前的研究成果拿出来，改一改凑一凑，也算交差了。你肯定也觉得这样很没意思对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030612,
					"content": "其实我们完全可以尝试从历史地理的角度，找一找新材料，这样一定能有新发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030613,
					"content": "一些不受生论派重视的文学材料也是可以利用的。不过这样的话，难免要涉及因论派和知论派的领域了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030614,
					"content": "我并不具备那些领域的知识，申请相关「知识」的手续又太麻烦，和相关领域的学者合作更是难上加难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030615,
					"content": "但是我相信，如果我们能做到跨学科合作的话，过去的很多问题就可以得到突破性进展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030616,
					"content": "只是可惜这样的尝试没能进行下去，因论派和知论派的怪人们讨论事情的角度特别…嗯…奇妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030617,
					"content": "我交给他们的提案里，所有的措辞都得仔细斟酌，要不然就会出现误会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030618,
					"content": "被赶出教令院之前，我还在跟一个知论派的家伙吵架。现在好了，想找他们吵架也难了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030625,
					"content": "你看我，一下说了好多话，好畅快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030626,
					"content": "你来之前，我在这里没什么朋友，其实有些寂寞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030629,
					"content": "整个村子里，有闲心种花的人很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030630,
					"content": "嗯…这样说不准确，村子北面，也有位老爷爷开垦出了一片苗圃，拿来种花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030631,
					"content": "我去看望过他，是个有点奇怪的老人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030632,
					"content": "种下的明明是「石头」，却非说自己在种花，还把我赶走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030633,
					"content": "一个人生活也有点寂寞吧，我能理解那种心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030634,
					"content": "你能帮我的须弥蔷薇开花，说不定也能帮帮他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732030635,
					"content": "如果有机会的话，你和派蒙也可以去看看他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				}
			]
		},
