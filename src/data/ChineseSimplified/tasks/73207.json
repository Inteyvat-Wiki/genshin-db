					"赛芭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "多让人怀念的花，给你的礼物我也准备好了，你拿着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900202,
					"content": "都是无法在这里生长发芽的植物种子，如果你在别处有宅院的话，就能看它们长大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900203,
					"content": "你看我，一下说了好多话，好畅快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900204,
					"content": "你来之前，我在这里没什么朋友，其实有些寂寞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900207,
					"content": "整个村子里，有闲心种花的人很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900208,
					"content": "嗯…这样说不准确，村子北面，也有位老爷爷开垦出了一片苗圃，拿来种花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900209,
					"content": "我去看望过他，是个有点奇怪的老人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900210,
					"content": "种下的明明是「石头」，却非说自己在种花，还把我赶走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900211,
					"content": "一个人生活也有点寂寞吧，我能理解那种心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900212,
					"content": "你能帮我的须弥蔷薇开花，说不定也能帮帮他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732900213,
					"content": "如果有机会的话，你和派蒙也可以去看看他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				}
			]
		}
