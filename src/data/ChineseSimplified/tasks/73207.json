				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "「蔷薇啊蔷薇，实现我的愿望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070502,
					"content": "「花从石头中绽放，金蔷薇对我歌唱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070503,
					"content": "「她唱：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070504,
					"content": "「没有土地承载我，唯有歌谣承载我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070505,
					"content": "「歌谣战胜敌视我的命运，战胜我的结局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070506,
					"content": "「战胜我战胜时间，战胜永不消逝的消逝。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732070507,
					"content": "这就是沙法卡特叔叔以前教给我们的歌谣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
