			"dialogs": [
				{
					"id": 220460101,
					"content": "神社又有些乱了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "唔喵，是汝等啊，来得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460104,
					"content": "一段时间没打扫，神社的屋子周围，又有了好多污渍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460105,
					"content": "这样子可不能接待来神社的人类啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460106,
					"content": "汝等，能和上次一样，帮奴家打扫一下神社吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460107,
					"content": "不是有大祐和悦子吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "奴家可不会去主动找那两个绿绿的人类说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460109,
					"content": "那个高高的人类，看奴家的眼神总是很奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460110,
					"content": "另外一个绿绿的人类，又总是那副提不起劲的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460111,
					"content": "喵喵，无论怎么想，都是两个靠不住的人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460115,
					"content": "总之，就拜托汝等了。就和上次一样，用长棍子和水「打扫」，汝等明白了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460116,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "总之，这件事就拜托汝等了，奴家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460119,
					"content": "奴家在这里等着汝等，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460117,
					"content": "差不多明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "可以拜托大岛先生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "那个石头人类一直在忙个不停，不知道在咚咚咚地敲什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460114,
					"content": "明明石头已经敲好了，为什么还在咚咚咚呢，真烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「寝子」"
				}
			]
		},
