			},
			"dialogs": [
				{
					"id": 200530101,
					"content": "伤脑筋…这里要怎么解决啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530102,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "为了下一次的骑士选拔，我正在训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530104,
					"content": "唔…不过，我可没有琴大人那样的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530105,
					"content": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530106,
					"content": "比如，一口气把这些木桩全部破坏掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530107,
					"content": "你有空的话，也和我一起来想一想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530108,
					"content": "我想一想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "没关系，好好想喔，木桩不会自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530111,
					"content": "唯一会自己跑掉的只有被消耗的时间和生命，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530114,
					"content": "这种距离，自己对付一边，丢个炸弹炸掉另外一边就是最好的选择啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530115,
					"content": "哈哈哈我开玩笑的，炸弹这种东西，怎么可能这么轻松找到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530109,
					"content": "我们两个一起上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530113,
					"content": "像我这样的，只能学习独自作战啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "艾琳"
				}
			]
		},
