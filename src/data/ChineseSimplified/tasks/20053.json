			"dialogs": [
				{
					"id": 200530201,
					"content": "怎么样？想到好方法了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530202
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530202,
					"content": "还没有想好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530203
					]
				},
				{
					"id": 200530203,
					"content": "嗯…我之前遇见的冒险家，有些也偶尔会这样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530204
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530204,
					"content": "面对怪物时能利落地战斗，打木桩的时候却手忙脚乱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530205
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530205,
					"content": "而且还用各种手段加固木桩，就像生怕自己能轻松击碎一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530206
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530206,
					"content": "这么想寻求挑战的话，直接去野外找强大的魔物不就好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
		},
