							9078.747
						],
						"pointId": 13989
					}
				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "承让了，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810402,
					"content": "请您放心，在你们牺牲后，我的老爹尼基塔成为了新任执灯长，他带领着被你们所拯救的人们重建了执灯人的军团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810403,
					"content": "而如今，我们的力量已经成长到足以在狂猎的阴霾下守护这一方净土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810404,
					"content": "你们的奉献并非徒劳无功，你们的事迹、你们的意志没有也不会被遗忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810405,
					"content": "再见，西格德先生。我会时常来拜访的，愿您能够得到安息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "这种压制魔物的方式…不对，那个传奇人物应该已经牺牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760819902,
					"content": "难道他以某种方式醒来了吗？有空得去一趟苔骨荒原东北侧的海滩，他的墓地就在那儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760819903,
					"content": "我曾从老爷子那里听说过，过去他与之并肩作战的传奇执灯长西格德的事迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760819904,
					"content": "紫色的剑光，金色的头发…与传说中的一模一样，这段时间遇见的那个人该不会那就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760819905,
					"content": "苔骨荒原东北侧的海滩是他的埋骨地，有时间去那里看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		}
	]
}