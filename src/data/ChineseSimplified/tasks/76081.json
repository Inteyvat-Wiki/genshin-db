						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "西格德先生，您是我的恩人。当年若不是您率领执灯人南下抗敌，或许我早已在无知无觉中丢掉了性命，不知埋骨何处了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810302,
					"content": "但为何您的魂灵却没有得到安息，依旧在四处游荡、战斗不息呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810303,
					"content": "被狂猎的邪秽所浸染，就连身形也四分五裂…看来您从未走出过那个战场，对吗？对于您来说，战争还没有结束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810304,
					"content": "在这一点上，我或许也和您一样。只有等到狂猎彻底消失的那一天，才能得到真正的安宁吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810305,
					"content": "见到您是我的荣幸，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810306,
					"content": "我明白了，对于执灯人而言，最好的交流方式便是手握刀剑，互相切磋一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760810307,
					"content": "那么请容我向您展示，新一代执灯人的武勇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		},
		{
			"id": 7608104,
			"completionStepIds": [
