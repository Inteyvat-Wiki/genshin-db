						],
						"pointId": 13989
					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "与你的一战酣畅淋漓，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810202,
					"content": "英雄的末路如此，未免令人惋惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810203,
					"content": "孤独地游荡在你为之奉献、殒命的土地上…当初响应执灯人之誓的时候，你是否预计到了今天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810204,
					"content": "即便有过，或许你也不会犹豫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760810205,
					"content": "未来我还会前来拜访的，再会了，西格德先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
		{
			"id": 7608103,
			"completionStepIds": [
				7608102
