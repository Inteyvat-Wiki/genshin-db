						],
						"stepId": 201704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托马"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}，你们怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170404,
					"content": "见到反抗军了吗？现在战场情况如何？我能从这出去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170405,
					"content": "大概还不行…我们来的时候还看到附近有人在巡逻呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170406,
					"content": "看来还没结束啊…这么说来，你们出现在这里，应该是有事要找我们商量吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170407,
					"content": "我去找人叫小姐过来，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170408,
					"content": "将现状告诉了绫华与托马…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170409,
					"content": "原来如此，你们也经历了许多事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170410,
					"content": "情况我已经了解了，总之是要找到天领奉行叛变的证据，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170411,
					"content": "这么说来，确实有一点让我很在意。幕府军与反抗军交战已久，但将军却从未过问此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170412,
					"content": "我曾以为将军对此事并不在意，但现在来看，或许是天领奉行给将军的<color=#00E1FFFF>「上奏公文」</color>，从一开始就有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170413,
					"content": "绫华的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170414,
					"content": "天领奉行执掌国内军事事务，如果他们有瞒报的想法，我们也无从得知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170415,
					"content": "其结果，是将军错估眼狩令的危害，继续一意孤行。如果能拿到天领奉行的上奏公文，一看便知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170416,
					"content": "可我记得，有权力碰触上奏公文的，只有九条孝行一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170417,
					"content": "而且那里有重兵把守，就算有早柚帮忙，想悄悄拿走公文也是一件难事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170418,
					"content": "如果有什么东西，能够暂时引开那些守卫就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170419,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170420,
					"content": "要说吸引注意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "宵宫的烟花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170423,
					"content": "果然是托马会提出来的建议呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170424,
					"content": "倒也不无道理。天领奉行旁边就是千手百眼神像，如果能在神像周围点燃烟花，天领奉行不会不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170425,
					"content": "到时早柚就可以顺利潜入天领奉行，拿到公文和其他证据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170426,
					"content": "好！我感觉我离自由的日子越来越近了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170427,
					"content": "呼…像这样坐在一起聊天，总感觉已经是好久之前的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170428,
					"content": "好像也没有很久…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "对我来说已经很久了，我每天都在这里盼着你们啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170430,
					"content": "以前这里确实是我最喜欢的秘密场所，但这次进来之后，我已经不知道多久没有迈出茶室一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170431,
					"content": "可恶，好想去泡温泉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170432,
					"content": "托马，好可怜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170433,
					"content": "我们还是先解决眼下的问题吧。废除眼狩令之后，托马就自由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170434,
					"content": "虽然是再度重逢，但没有多少叙旧的时间呢。等一切结束，我们再好好庆祝一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170435,
					"content": "到时候我们再一起玩火锅游戏好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170436,
					"content": "你还惦记着那个啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170437,
					"content": "天领奉行附近的守卫很多，你们靠近的时候务必小心。之后我们再在这里碰面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170438,
					"content": "#那{NICKNAME}，我们就先去<color=#00E1FFFF>花见坂</color>找<color=#00E1FFFF>宵宫</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170421,
					"content": "好像之前也遇到过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
