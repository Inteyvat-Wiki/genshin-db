			"dialogs": [
				{
					"id": 20170901,
					"content": "#怎么样{NICKNAME}，计划还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170902,
					"content": "我也不知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "辛苦了，接下来就等早柚的消息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170905,
					"content": "一段时间后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170906,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170907,
					"content": "虽然运动有助于长高，但好像有些运动过头了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170908,
					"content": "晕乎乎的…大家…都在旋转…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170909,
					"content": "不行，睡觉前，好像还有重要的事情…对了，我拿到了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170910,
					"content": "我也不知道你们说的「公文」到底长什么样子，就把所有可疑的东西都偷回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170911,
					"content": "给你们…我要去睡觉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170912,
					"content": "小姐，这些是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170913,
					"content": "这一卷密封的，应该是天领奉行要呈给将军的「上奏公文」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170914,
					"content": "除此之外，这是…他们与愚人众来往的信件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170915,
					"content": "看来那位八重宫司的判断是正确的。如今稻妻的纷争，确实是他们推波助澜的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}，这些当证据应该足够了。接下来还请你将它们带给<color=#00E1FFFF>八重宫司</color>，相信她会有接下来的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170917,
					"content": "我也会召集人手，争取挖出更多潜伏在稻妻的愚人众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170918,
					"content": "不过，还是要小心将军大人，一想到她之前出刀的样子，我就浑身鸡皮疙瘩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20170919,
					"content": "也只能相信八重宫司了。她与将军关系密切，或许会有办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20170920,
					"content": "我记得，快到与八重神子约定的日期了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170921,
					"content": "我们还是快点收拾一下，准备赶往<color=#00E1FFFF>鸣神大社</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170903,
					"content": "点燃烟花就跑了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
