			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"早柚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "狸、狸猫玩偶变成人类了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170202,
					"content": "这是什么，我还是第一次见到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170203,
					"content": "不是狸猫…是貉…呼噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170204,
					"content": "好困…睡不饱的话…会长不高的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170205,
					"content": "难道说这位就是八重小姐所说的「专业人士」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170206,
					"content": "看上去完全不像呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170207,
					"content": "呵呵…这位可是「终末番」的成员，是货真价实的「忍者」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170208,
					"content": "忍者！那刚刚的，难道就是传说中的替身术？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170209,
					"content": "不过，「终末番」又是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170210,
					"content": "终末番隶属于社奉行，是神里绫人的秘密部队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170211,
					"content": "目前神里绫人和社奉行秉持中立态度，我也无法调动终末番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170212,
					"content": "不过，抓一个常年偷懒的终末番成员过来帮忙，还是可以做到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170213,
					"content": "咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170214,
					"content": "就是这样，就拜托你们进城，去寻找天领奉行叛变的证据了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170215,
					"content": "毕竟在那样的场合，我不适合露面嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170216,
					"content": "就算你这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20170217,
					"content": "感觉没什么头绪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "欸？我还以为你已经想到了呢。好吧，那我就再给你一点点提示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170220,
					"content": "对外人来说，想要摸清楚天领奉行的底细确实很难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170221,
					"content": "但三奉行共同辅佐将军，关系来往密切，想必其他奉行更容易察觉其中的蹊跷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170222,
					"content": "社奉行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "呵呵…看来你已经想到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170224,
					"content": "幕府军对你的搜捕，应该还没有结束。不过有这位终末番的忍者相助，相信你可以顺利与朋友再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170225,
					"content": "别忘了在约定的时间之前，把证据带回来哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170218,
					"content": "证据到底是什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
			"completionStepIds": [
				201704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
