			"trigger": {
				"objectNames": [
					"大嗓门的幽影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "喂，你是谁？这是我的椅子，酒馆里谁不知道这是我███的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150102,
					"content": "你是刚来岛上报到还是怎么回事？别乱占别人位置啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150103,
					"content": "我的啤酒怎么还没上，快点，我再坐会儿就得去巡夜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150104,
					"content": "酒馆？啤酒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "你非要坐也行，先来跟我们一起喝酒唱歌，熟了都是朋友，你要坐就坐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150107,
					"content": "会唱歌吧？哟吼，大伙唱一句你唱一句——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150108,
					"content": "「邻家的舞曲让我忍不住踏脚！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150109,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "不对不对，你这家伙真扫兴，挪德卡莱的人怎么可能不会唱这首歌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150113,
					"content": "你又不会唱歌又不会玩，怎么融入队伍？到时候狂猎来了身边没有队友照顾就完蛋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150114,
					"content": "去学了唱歌再来酒馆。哟吼，再来一杯啤酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150110,
					"content": "「我家的派蒙让我忍不住大笑！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "「岛上幽灵围着椅子又唱又跳！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "借我坐会儿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
