				{
					"id": 760150209,
					"content": "「我在拉琴你们在微笑。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "「大家都在开心跳舞，嘿！嘿！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150211,
					"content": "「我们聚起来，聚起来跳舞！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "啊哈，没错没错，就是这么唱，你习惯得很快嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150213,
					"content": "我的名字叫███，这下我们就算认识了。椅子你想坐就坐吧，我也不是小气的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150214,
					"content": "你也是执灯士对吧，这杯啤酒算我请你的，说不定我们还能在训练的时候遇上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150215,
					"content": "谢谢，尽管我喝不到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "我该去巡夜了，回头见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大嗓门的幽影"
				},
				{
					"id": 760150216,
					"content": "幸会，我叫作菲林斯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "如果我想坐在这里呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
