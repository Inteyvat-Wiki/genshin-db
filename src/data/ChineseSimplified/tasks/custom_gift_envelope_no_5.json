			"dialogs": [
				{
					"id": 715370101,
					"content": "荣誉骑士前辈，居然能在这里遇见你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 715370102,
					"content": "你在做「祝柬」么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "嗯，好不容易趁着休假来了璃月港，我正在采购礼物，准备带回去送给骑士团的各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 715370104,
					"content": "然后我听说，在海灯节期间，璃月人送礼物时一般会写一封「祝柬」附在里面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 715370105,
					"content": "所以，我就想要效仿一下。也做几封漂亮的「祝柬」。但怎么做，似乎都不太好看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 715370106,
					"content": "荣誉骑士前辈，你知道怎么做的「祝柬」最好看么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 715370107,
					"content": "放心，包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
