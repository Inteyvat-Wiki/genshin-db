			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"优菈",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200401,
					"content": "你们下手可真快，他们都是我追踪了很长时间的目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200402
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200402,
					"content": "这下子功劳都归你们了，这就是「先下手为强」吗？…可恶，这个仇，我记下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200403
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200403,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200404,
					"content": "等等，记仇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200405
					]
				},
				{
					"id": 101200405,
					"content": "是啊，我听到这边有很大的动静，连忙赶过来，发现你正在和愚人众战斗，还占据了上风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200406
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200406,
					"content": "如果我还不出手，别说是功劳，就连光都沾不上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200407
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200407,
					"content": "不过，幸好你没有受伤，和这么多愚人众交战，可是很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200408,
						101200409
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200408,
					"content": "我习惯和愚人众战斗了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				},
				{
					"id": 101200410,
					"content": "虽然没怎么听懂，但你是在关心我们的安危吧，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200411,
					"content": "啊？为什么我要关心仇人的安危？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200412
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200412,
					"content": "可是你刚刚说，「幸好你没有受伤」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200413,
					"content": "哦，我的意思是，如果你们有人受伤了，我不光是被抢了功劳，还要负责把你们带回蒙德城——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200414
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200414,
					"content": "那你们就又给我添了一笔麻烦！这个仇就更是结下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200415
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200415,
					"content": "居然是这种解读方式吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200416,
					"content": "你该不会就是优菈吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200417
					]
				},
				{
					"id": 101200417,
					"content": "对啊，没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200418
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200418,
					"content": "果然，我就觉得她怪怪的！虽然，也没有怪到无法交流的程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200419,
					"content": "上来就点评陌生人「怪怪的」，不说贵族礼仪，在普通人之间也是很不礼貌的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200420
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200420,
					"content": "说起来，为什么你们知道我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200421
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200421,
					"content": "#就是你说的礼仪问题啦。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是西风骑士团的荣誉骑士，我们正想调查一位名叫舒伯特·劳伦斯的贵族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200422,
					"content": "可是他非常讲究礼仪，完全不愿意和我们说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200423,
					"content": "哈哈哈，我明白了，他是我的叔父，就是这样的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200424
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200424,
					"content": "不过，为什么要调查他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200425
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200425,
					"content": "他好像和愚人众有些密谋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200426
					]
				},
				{
					"id": 101200426,
					"content": "原来如此，哈哈，真是好胆量，当着我的面，说我家里人的坏话。这个仇，又值得记一笔了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200427
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200427,
					"content": "不是啦，这个是琴团长的委托！而且只是怀疑而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200428,
						101200429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200428,
					"content": "你不好奇吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200430,
					"content": "在蒙德城的市民眼里，劳伦斯家族都是坏人嘛，所以因为流言蜚语招致怀疑什么的，一点都不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200431
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200431,
					"content": "嗯，有道理，毕竟以前是残暴的统治者，名声很不好嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200432,
					"content": "原来你也是这么想的…那我们这个仇，是彻底结下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200433
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200433,
					"content": "明明是你自己先说的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
