				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200101,
					"content": "荣誉骑士，感谢你在百忙中抽空过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200102
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200102,
					"content": "长话短说吧，骑士团现在有一件比较特殊的事想要拜托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200103,
						101200105
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200103,
					"content": "骑士团还是这么繁忙啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200104
					]
				},
				{
					"id": 101200104,
					"content": "嗯，近日风波不断，无论是我，还是所有留驻蒙德的骑士团成员，都不敢有片刻懈怠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200107,
					"content": "最近我收到了很多骑士团成员的汇报，说劳伦斯家族的人，和愚人众往来密切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200108,
					"content": "愚人众，又是他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200109,
					"content": "不过这个劳伦斯家族，又是什么人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200110,
					"content": "过去的蒙德，曾有一段被旧贵族统治的昏暗时期。从高塔孤王那里夺回的自由又被套上枷锁，奴隶制大行其道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200111
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200111,
					"content": "初代「蒲公英骑士」温妮莎引领了革命，推翻了旧贵族的统治，建立了西风骑士团，蒙德这才拥有了现在这番景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200112
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200112,
					"content": "而当年为蒙德带来苦难的旧贵族，就是劳伦斯家族了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200113
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200113,
					"content": "啊，我好像听明白了。那现在这帮坏人的后代，又想和愚人众一起做坏事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200114,
					"content": "目前只是怀疑，还没有什么确切的证据。我请你们来，就是为了调查这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200115,
						101200116
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200115,
					"content": "为什么是我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200117,
					"content": "唉，因为在过去，旧贵族和骑士团，一直相互敌对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200118,
					"content": "骑士团花了很长时间，想方设法化解双方的矛盾。但贵族的那些后代，依然很敌视骑士团…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200119,
					"content": "不管我们以什么样的态度和他们接触，都不会有好结果，还经常会引起他们的过度反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200120
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200120,
					"content": "虽然可以直接用「调查」的名义上门，但最后如果是冤枉了他们，一定会大大增加他们的不信任感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200121
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200121,
					"content": "以前的很多努力，就功亏一篑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200122
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200122,
					"content": "但我也是「荣誉骑士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200123
					]
				},
				{
					"id": 101200123,
					"content": "你已经是骑士团最适合出面的人选了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200124,
					"content": "你大可不必强调这层身份。你从远方旅行到此，并不是这座城的「大多数」，可以从这个角度与那位贵族找到共同的话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200125
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200125,
					"content": "和他建立起友善的关系之后，应该就能了解到一些关于愚人众的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200126
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200126,
					"content": "不愧是琴团长！考虑得可真周到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200127,
					"content": "过奖了，这只是在处理外交问题的时候，积攒下来的一些经验而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200128
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200128,
					"content": "那位劳伦斯家族的成员名叫舒伯特，最近他一直在蒙德北边的城墙附近闲逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200129
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200129,
					"content": "据说这个人的性格不太好相处，但是如果平心静气和他交流，应该不会有什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200130,
						101200131
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200130,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200132,
					"content": "谢谢你们的协助。如果遇到什么困难，我也会尽力提供帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 101200131,
					"content": "但愿一切顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200116,
					"content": "这是骑士团的分内工作吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200105,
					"content": "真有琴团长的风格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200106
					]
				},
				{
					"id": 101200106,
					"content": "如果状况允许，我也想和你多寒暄两句。但蒙德城的安全，还是要放在首位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "琴"
				}
			]
		},
		{
			"id": 1012002,
			"completionStepIds": [
				1012003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012003",
							"2"
						],
						"stepId": 1012003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "嗯？谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200202,
					"content": "你好，我们是来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200203,
					"content": "你好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200204,
					"content": "你、你好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "你好？我没听错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200208,
					"content": "哼，粗鲁又轻浮，竟然随随便便就走上来打招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200209,
					"content": "果然是无知的外来者，连我都不认识。我可是舒伯特·劳伦斯，货真价实的贵族后裔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200210,
					"content": "想跟我打招呼，要好好注意你的遣词造句，这样随意又懒散的言语简直不堪入耳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200211,
					"content": "若是听懂了我的话，你现在就该单膝跪地，谦卑地呈上自我介绍与歉意，这才是符合标准的礼仪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200212,
					"content": "欸？这么复杂的礼仪，完全没有听说过？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200213,
					"content": "哼，在那个大家都尊礼重道的时代，这种基础礼仪，可是面见贵族的常识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200214,
					"content": "若在礼仪上怠慢了贵族，至少都是一顿鞭刑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200215,
					"content": "再看看如今的世道，规矩废了，礼仪也忘了，腐坏到不堪入目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200216,
					"content": "太麻烦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200218,
					"content": "你说什么？你这是在质疑旧贵族的尊严？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200219
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200219,
					"content": "我告诉你，虽然劳伦斯家族现在落没了，但我等后裔，一直都在寻找重获荣光的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200220
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200220,
					"content": "周围的人越是散漫，我就越要坚持贵族的优雅与礼貌。毕竟，我们从生下来开始就是全然不同的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200221
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200221,
					"content": "我还什么都没说呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200222
					]
				},
				{
					"id": 101200222,
					"content": "别说了，你的言行举止让我厌烦，我与你这样的平民子弟无话可讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200223
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200223,
					"content": "而且，我也没有义务指点你应该怎么讲礼貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200224
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200224,
					"content": "我还有很重要的事，先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200217,
					"content": "怪不得旧贵族落没了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200206,
					"content": "怎么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200207
					]
				},
				{
					"id": 101200207,
					"content": "怎么了吗？我没听错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "舒伯特"
				}
			]
		},
		{
			"id": 1012003,
			"completionStepIds": [
				1012005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012005",
							"2"
						],
						"stepId": 1012005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200301,
					"content": "这不是「荣誉骑士」嘛！我刚刚打算去侦察，没想到会在这里碰到你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200302
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200302,
					"content": "欸？看你的表情，遇上什么不开心的事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200303
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200303,
					"content": "琴团长委托我们去办事，结果…好像有点搞砸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200304,
						101200305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200304,
					"content": "说来话长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				},
				{
					"id": 101200306,
					"content": "不要灰心啦，失败是常有的事。我也不能保证每次都找到有用的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200307
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200307,
					"content": "所以，打起精神来嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200308,
						101200309
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200308,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200310,
					"content": "嘿嘿。对了，这样吧，我来帮你想想办法，你们到底遇到什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200311
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200311,
					"content": "琴团长让我们去和一个人搞好关系，他名叫舒伯特·劳伦斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200312,
					"content": "但我们见到他才发现，他的性格很古怪，根本不好好听人说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200313,
					"content": "哦哦，我知道这个人！他一定说你们不懂礼貌吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200314,
						101200315
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200314,
					"content": "看来你也有所耳闻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200316,
					"content": "哈哈，我也被指点过好几次，劳伦斯家里的人都有些奇奇怪怪的讲究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200317
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200317,
					"content": "欸？所有人都是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200318,
					"content": "他们觉得贵族就要有贵族的矜持嘛，在我看来…唔，能够理解，但总觉得他们不像是这个时代的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200319
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200319,
					"content": "不过，在他们家里有个很特殊的例子，就是我的好伙伴，优菈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200320
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200320,
					"content": "伙、伙伴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200321,
					"content": "是的，她是劳伦斯家族的人，但同时也是骑士团第四小队的队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200322,
						101200323
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200322,
					"content": "琴团长说，劳伦斯把骑士团当敌人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200324,
					"content": "因为优菈是个特别的人嘛，她和家族的其他人都不同，有自己的想法和行动方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200325
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200325,
					"content": "换句话说，就是她没怎么把家里的条条框框放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200326
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200326,
					"content": "啊，不过如何跟劳伦斯家的人打交道，她还是很清楚的。你们只要见她一面，就明白我的意思啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200327
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200327,
					"content": "我有点好奇，既然优菈是劳伦斯家的人，为什么琴团长会找我们，而不是直接找这个优菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200328,
					"content": "这个嘛，就有点一言难尽了。简单来说，因为优菈加入了骑士团，所以她家里的其他人都不太喜欢她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200329
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200329,
					"content": "在他们的眼里，优菈就像是投敌的叛徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200330,
						101200331
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200330,
					"content": "确实挺有个性的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200332,
					"content": "嘿嘿，但她其实很容易相处，你们只要能把困扰告诉她，她肯定能教会你们怎么和舒伯特打交道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200333
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200333,
					"content": "她早上好像去野外巡逻了，你们应该能在望风山地附近找到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200334
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200334,
					"content": "嗯嗯，谢谢你，安柏，那我们就去找她了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200335,
					"content": "祝你们一切顺利！我也要出发去侦察了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200331,
					"content": "也不是不能理解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "劳伦斯家的人可以加入骑士团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200315,
					"content": "看来你也深受其害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200309,
					"content": "很有安柏的作风。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200305,
					"content": "不是我们的错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				}
			]
		},
		{
			"id": 1012004,
			"completionStepIds": [
				1012009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012009",
							"2"
						],
						"stepId": 1012009,
						"stateName": "QUEST_STATE_UNFINISHED"
