					"nextDialogs": [
						101200440,
						101200441
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200440,
					"content": "但你不是很记仇吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200442,
					"content": "两码事，两码事。既是代理团长的委托，又是安柏的推荐，我不能不给面子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "优菈"
				},
				{
					"id": 101200441,
					"content": "你不会是想趁机复仇吧？",
