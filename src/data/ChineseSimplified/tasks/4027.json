				]
			},
			"dialogs": [
				{
					"id": 40251323,
					"content": "#另外，{NICKNAME}，看你的表情应该是还有其他事想问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251324
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251324,
					"content": "请发问吧，我都会如实相告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251325,
						40251338,
						40251359,
						40251367,
						40251379
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251325,
					"content": "关于当初对「公子」的判决…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251326
					]
				},
				{
					"id": 40251326,
					"content": "有关「公子」一案，我多方追溯，得知他年幼时曾坠入未知的深渊，机缘巧合下唤醒了吞星之鲸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251327
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251327,
					"content": "但于情于理，并不应该因为这种原因，就将「公子」认定为灾难的根源，只能算作是连带责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251328
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251328,
					"content": "至于谕示机在那场庭审中的判决…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251329
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251329,
					"content": "是基于连带责任，还是因为芙卡洛斯猜到他能与吞星之鲸互相牵制，故意让他替枫丹拖延时间…就不得而知了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251330
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251330,
					"content": "芙卡洛斯果然还是在为枫丹人着想吧，甚至最后枫丹人真正成为人类也是托她的福…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251331,
					"content": "欸，这么说起来，我忽然想到一个问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251332,
					"content": "枫丹人还没有成为真正的人类之前，他们生出来的孩子难道也是纯水精灵变的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251333,
					"content": "生命本来就如水流般循环不息，你还记得枫丹人经常会来到露景泉这里求子的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251334
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251334,
					"content": "嗯，琳妮特说过，这里是枫丹所有水流的交汇处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251335,
					"content": "其实就连那些夫妻自己都不知道，这种求子其实并非只是一种风俗，而是一种仪式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251336
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251336,
					"content": "泉水中那些受到祝福的纯水精灵，真的会在数月以后作为新的枫丹人降生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251337
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251337,
					"content": "我…我大概明白了，看来这种仪式如今已经用不到了呢，但估计还是会作为习俗来延续下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251380,
					"content": "啊，等等，关于神之心的事，我还有一点问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251381
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251381,
					"content": "之前和林尼聊天的时候，林尼说你对送出神之心这件事的态度有过一次明显的变化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251382
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251382,
					"content": "我们都猜测可能还存在什么只有你知道的理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251383
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251383,
					"content": "难怪壁炉之家可以作为愚人众的情报机构，竟然这样敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251384
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251384,
					"content": "关于这个问题，我正巧也有件事准备和你们分享…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251385
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251385,
					"content": "嗯？还有什么事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251386
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251386,
					"content": "其实那天我将你们从原始胎海送回陆地上以后，我和那位名叫丝柯克的小姐之间还有过这样的对话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251338,
					"content": "关于枫丹的未来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251339
					]
				},
				{
					"id": 40251339,
					"content": "说起来，听莱欧斯利说芙宁娜已经离开了，那是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251340,
					"content": "芙宁娜女士…民众只知道她的死刑并未真正执行。她卸任了水神一职，将名义上的事务交付于我，离开了歌剧院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251341
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251341,
					"content": "我忠实而全面地转述了芙卡洛斯最后的话。她听完以后，没有表现出悲伤，也没有表示欣慰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251342
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251342,
					"content": "只是说…她累了，需要休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251343
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251343,
					"content": "…说完这些，她就收拾东西，像普通人搬家那样搬出了歌剧院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251344
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251344,
					"content": "芙宁娜…那她现在有地方住吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251345,
					"content": "请放心，我自然会安排妥当，她的衣食住行都不成问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251346
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251346,
					"content": "其实我…隐约为她感到高兴。尽管她精神上累积的创伤需要时间来慢慢修复…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251347
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251347,
					"content": "但不再需要扮演「水神芙卡洛斯」以后，她终于可以放下所有，去过普通的生活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251348
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251348,
					"content": "那你自己呢，得到水龙全部的力量以后，你有什么打算吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251349,
					"content": "芙卡洛斯逝去后，谕示裁定枢机也停止了运转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251350
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251350,
					"content": "这件事会直接影响审判，我慎重考虑后，决定取代它在庭审中的作用。今后我会自行审判，并将结果传达出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251351
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251351,
					"content": "看来你还是完全在以最高审判官的立场考虑事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251352,
					"content": "身为元素龙，我仍有许多未竟之事。可这份力量…这种责任，某种意义上都是被赋予的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251353
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251353,
					"content": "所以在履行其他责任之前，我首先要作为最高审判官继续为枫丹效力。二者将在我的生活中并存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251354
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251354,
					"content": "此外，水神的离开还会带来另一个问题…歌剧院将不再产出「律偿混能」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251355
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251355,
					"content": "是啊，那种能量来自于民众对水神的信仰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251356,
					"content": "可现在城里的机械都在正常运转啊，能量究竟是怎么来的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251357
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251357,
					"content": "如今的我已经可以完全掌控「芒荒能量」了，它完全可以用作替代能源，这也是我暂时离不开枫丹的原因之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251358
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251358,
					"content": "唔哇，古龙的权能真是好用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251359,
					"content": "关于枫丹的神之心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251360
					]
				},
				{
					"id": 40251360,
					"content": "噢噢对，听说你把神之心「外交赠予」了「仆人」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251361
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251361,
					"content": "那两位执行官在这场灾难中的确做出了诸多贡献，暂且不谈他们完全出于自愿的部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251362
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251362,
					"content": "单论现阶段愚人众在枫丹的目的，表面上看只有一个，那便是神之心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251363
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251363,
					"content": "如今谕示裁定枢机停摆，甚至水神之神座都不复存在，我也并不需要神之心的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251364
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251364,
					"content": "…神之心在枫丹已经彻底失去意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251365
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251365,
					"content": "假如愚人众的目的并不单纯，那不如就趁此机会满足愚人众的要求…免去更多不必要的周旋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251366
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251366,
					"content": "还真是复杂的考量啊…我还以为你只是为了感谢「仆人」以及给「公子」道歉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251367,
					"content": "关于旅行的下一站…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40251368
					]
				},
				{
					"id": 40251368,
					"content": "过一段时间，你们准备要去纳塔了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251369
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251369,
					"content": "我在做向导方面可没有什么天赋，只能尽可能把我所知道的情报告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251370
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251370,
					"content": "据我所知，纳塔可以说是「龙的国度」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251371
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251371,
					"content": "龙的国度？像你这样的龙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251372
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40251372,
					"content": "不，我想我在纳塔应该并不会受到欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251373
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251373,
					"content": "和像我这样的古龙不同，纳塔的龙类应该经历过漫长的发展和演化，如今正大量与人类共存着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251374
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251374,
					"content": "那里也是「战争」的国度，大地上延续着无休止的战火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40251375
					],
					"speakerTitle": "那维莱特"
				},
				{
					"id": 40251375,
