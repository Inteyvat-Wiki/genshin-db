			"dialogs": [
				{
					"id": 220000301,
					"content": "清洗好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000302,
					"content": "清洗好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "嗯！辛苦你啦，这些给你，谢谢你陪我们玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000304,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}以后也要做好人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000305,
					"content": "喂，什么时候能轮到我做船长啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220000306,
					"content": "下次吧，下次就归你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000307,
					"content": "哼，上次你就这么说的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿飞"
				}
