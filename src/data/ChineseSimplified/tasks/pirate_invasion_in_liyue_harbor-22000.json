			"dialogs": [
				{
					"id": 220000101,
					"content": "今天我们怎么玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000102,
					"content": "哼，要是没人来扮海盗，今天也玩不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220000103,
					"content": "可是，谁也不愿意扮海盗，怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000104,
					"content": "你们在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "我们在玩游戏呢，可总是缺一个人来扮海盗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000106,
					"content": "因为没人扮海盗来抢劫，我们一直没法开始玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000107,
					"content": "#对了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你能来扮海盗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000108,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "好哎！那我们就去准备啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000115,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}准备好了的话，就过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000110,
					"content": "我不太了解这方面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "没关系啦，海盗…唔，应该是那种蛮不讲理，随便抢走人家东西的坏人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000112,
					"content": "虽然我也没有见过，只是听北斗姐姐讲过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000113,
					"content": "但我觉得…这种人，应该挺好演的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000114,
					"content": "#嘿嘿，总之就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "小蒙"
				}
			]
		},
		{
