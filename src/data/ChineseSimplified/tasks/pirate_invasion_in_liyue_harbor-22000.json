			},
			"dialogs": [
				{
					"id": 220000201,
					"content": "准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "那我们直接开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000203,
					"content": "从哪开始呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000204,
					"content": "那个，抢劫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "呜哇！是海盗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220000206,
					"content": "璐璐快过来，我来保护你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 220000207,
					"content": "你是海盗吧，为什么要来抢劫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000208,
					"content": "我是海盗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "海盗也分好坏，不一定都要抢劫呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000211,
					"content": "北斗姐姐也说自己是海盗，可是她是很好的人，会给我好吃的，大家都很喜欢她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000212,
					"content": "#为什么{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}要做坏海盗，不做好海盗呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000213,
					"content": "明明是你说，海盗是那种「蛮不讲理」的人吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220000214,
					"content": "好吧，我错了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "唔，愿意改邪归正是好事。这也是北斗姐姐说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000217,
					"content": "那么，你就帮忙去清理一下周围吧，只要做好事，那就可以做好人，或者好海盗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000215,
					"content": "我想做个好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "海盗就是要抢劫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
