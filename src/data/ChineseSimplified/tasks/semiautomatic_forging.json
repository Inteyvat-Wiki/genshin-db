						],
						"pointId": 340100229
					},
					{
						"sceneId": 3,
						"position": [
							3606.78,
							428.202,
							4584.271
						],
						"pointId": 340100230
					},
					{
						"sceneId": 3,
						"position": [
							3606.759,
							428.202,
							4583.423
						],
						"pointId": 340100231
					}
				]
			},
			"dialogs": [
				{
					"id": 746700101,
					"content": "还有改进的空间啊，捶锻力度有问题，材料都一样，是因为锻造的方式有差别吗？夹材锻造和包材锻造…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700102
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700102,
					"content": "这样的话，是预先设定好相应的力度大小，还是做一个根据锻造方式进行判定的自适应机制呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700103
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700103,
					"content": "果然，走近了看还是觉得很神奇，像这种能够自己「铛铛」打铁的机器，看上去就连铁匠都不需要了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700104,
					"content": "哈哈，这台机器还没聪明到「不需要铁匠」的程度，每次进行锻造的时候，都要调整很多细节，后续的淬火和打磨也全靠人工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700105
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700105,
					"content": "不过，总有一天，我一定会让它变成全自动的锻造机器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700106
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700106,
					"content": "怎么样，是有什么委托锻造的需求吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700107
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700107,
					"content": "取决于锤锻机的表现…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700108
					]
				},
				{
					"id": 746700108,
					"content": "这我可就不得不露一手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700109
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700109,
					"content": "咦，原来你不仅仅是老板，还是铁匠吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700110,
					"content": "对，我就是这里的老板…兼铁匠，怎么样，看不出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700111
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700111,
					"content": "第一次知道的人都会露出你这样惊讶的表情。「这个人手臂没有那种浑圆厚实的肌肉，身形比普通人还瘦弱。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700112
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700112,
					"content": "是啊是啊，这样的人真的能做好铁匠的工作吗…喔，我可没有真的这样想，我刚刚只是顺着你的话说了下去啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700113,
					"content": "哈哈，没关系。实不相瞒，能让身形瘦弱的我胜任铁匠的工作，就是这台机器的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700114
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700114,
					"content": "人类会使用工具，而精巧设计的工具让不可能成为可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700115
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700115,
					"content": "也有人说什么机器锻造没有匠人的灵魂，在我看来机器和锤子一样都是工具，我倒是很想看看他们不用锤子徒手敲原胚的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700116
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700116,
					"content": "说远了说远了，好，现在就让我当场打把超锋利的剑给你们看看吧…啊，但是好像没有足够的材料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700117
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700117,
					"content": "哎呀，之前的试验好像用掉了太多份额，该怎么办好啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700118
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700118,
					"content": "我知道我知道，接下来就是拉动神秘大拉杆的环节，拉动拉杆，锻造机器就会「库库库」地变成发条机械，自己出去找材料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700119,
					"content": "哦…自动搜寻材料的机器，感觉也是一个需要的设计，要怎么识别材料呢，靠外表面的反光判断材质？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700120
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700120,
					"content": "伊丝黛莱小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700121,
					"content": "啊，不好意思，一下子走神了。抱歉抱歉，锤锻机就只是单纯的锤锻机，不会变形也没法到处走，材料还是要等人运送过来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700122
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700122,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700123,
					"content": "说到这个，如果你们收集到了各种各样的材料，也可以送到我这来，要一边试验一边调整锻造机器，各类材料总是很紧缺呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700124
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700124,
					"content": "作为回报…我就把这里的一些工坊产品的设计图给你们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700125,
						746700126
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700125,
					"content": "我闻到了商业机密的味道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700127
					]
				},
				{
					"id": 746700127,
					"content": "该怎么说呢，对我来说，重要的不是锻造出的「产品」，而是锻造用的「工具」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700128
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700128,
					"content": "让锤锻机接触各种材料，收集不同的数据，这样对以后锻造出更好的产品也有帮助，设计图的重要性反而在其次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700129
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700129,
					"content": "所以不仅仅是锻造用的素材，你要是碰到觉得可以用的材料，就尽情带过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700130
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700130,
					"content": "唔，你不会拿奇怪的设计图搪塞我们，在我们找你的时候，就发现这家店空空如也，连人带锤锻机一起不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700131,
					"content": "怎么可能，这也可以算是一种长期合作了，在这种合作之中，信誉比什么都重要，我能保证那些设计图的质量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700132
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700132,
					"content": "更何况，就算我能跑，让这个锤锻机长出腿来可不是容易的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700133
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700133,
					"content": "说的也是呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700134,
						746700135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746700134,
					"content": "那就这么说定了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700136
					]
				},
				{
					"id": 746700136,
					"content": "希望这是一次双方都会愉快的合作，嗯，我很期待你们会送来什么样的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 746700135,
					"content": "合作愉快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700136
					]
				},
				{
					"id": 746700126,
					"content": "真的可以吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700127
					]
				}
			]
		}
	]
}