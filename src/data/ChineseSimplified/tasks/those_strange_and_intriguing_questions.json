					"content": "哦，怎么样，要学习一下「伙伴冒险大战记」的规则吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040202
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040202,
					"content": "嗯，现在开始吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040203
					]
				},
				{
					"id": 402040203,
					"content": "好，那么…就让我打开一下教学用的地图和棋盘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "达尔维什"
