	"talks": [
		{
			"id": 4020401,
			"completionStepIds": [
				4020401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4020401",
							"2"
						],
						"stepId": 4020401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法德瓦",
					"阿塔希耶",
					"达尔维什"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402040101,
					"content": "阿塔希耶，我忍你很久了…你提交的这些东西，根本就没有能够用得上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040102
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040102,
					"content": "你看看你写的报告上都是什么东西…「可能」、「大概」、「差不多」，你就这样让我做数学模型？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040103
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040103,
					"content": "这个、这个，成立课题的时间有限，更何况我是妙论派的，谁知道对生物产生的影响应该怎么测量…比如、比如蕈兽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040104
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040104,
					"content": "总、总不能我把手伸到蕈兽嘴巴前面让它们咬一口，然后记录下来说「咬合力确确实实很惊人」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040105
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040105,
					"content": "达尔维什，你才是那个生论派的，你来评评理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040106
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040106,
					"content": "哈哈，如果要让我来评理，那我得说，阿塔希耶你的基础课程学得不太行，毕竟大家都知道大部分的蕈兽都没有嘴巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040107
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040107,
					"content": "哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040108
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040108,
					"content": "不过，法德瓦，我们这次也不需要这么严谨的数学模型，我们这次的课题面向的也不是院里的那些老学究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040109
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040109,
					"content": "我们要做的是面向那些孩子的课题…嗯，得有趣才行啊，或许适当的想象也是必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040110
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040110,
					"content": "唔…唔，既然前辈你这么说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040111
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040111,
					"content": "喂，法德瓦，你对待达尔维什的态度是不是和对我的态度差得有点太大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040112
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040112,
					"content": "好了好了，我这边的东西都负责的差不多了，阿塔希耶的结论我也经一遍手好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040113
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040113,
					"content": "而且，数据也可以在测试以后调整，这就是测试的意义嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040114
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040114,
					"content": "啊，不愧是达尔维什前辈…条理清晰，比某个人好太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040115
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040115,
					"content": "是是，我就不问你嘴里的「某个人」是谁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040116
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040116,
					"content": "好啦好啦，快去做最后的准备吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040117
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040117,
					"content": "好、好的！前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040118
					],
					"speakerTitle": "法德瓦"
				},
				{
					"id": 402040118,
					"content": "我也去看看画上的漆彩干了没…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040119
					],
					"speakerTitle": "阿塔希耶"
				},
				{
					"id": 402040119,
					"content": "不过说到测试…测试的人员啊，那边的那两位，有没有兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040120
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040120,
					"content": "刚才站在那边看了半天了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040121
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040121,
					"content": "咦，我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040122,
					"content": "对对，参与测试，还有大量新鲜水果吃哦，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040123,
						402040125
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040123,
					"content": "是新水果品种的测试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040124
					]
				},
				{
					"id": 402040124,
					"content": "不是，嗯…让我想想应该从什么地方说起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040130,
					"content": "不如这样，我不如先问两位一个问题吧…嗯，比如…「会滑铲的伸缩火蕈兽和长鬓虎打架谁厉害」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040131,
						402040134,
						402040137
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040131,
					"content": "会滑铲的伸缩火蕈兽吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040132
					]
				},
				{
					"id": 402040132,
					"content": "是嘛，我倒是觉得长鬓虎看上去比较能打呢…长鬓虎的爪子呼呼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040133,
					"content": "唔，怎么会有这么奇怪的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040140,
					"content": "嗯…还有呢，「浮游风蕈兽和风史莱姆谁更强」，「镀金旅团和纳塔的龙武士谁比较厉害，海乱鬼呢…」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040141
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040141,
					"content": "都是我们在给孩子们讲学的时候，他们问出口的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040142
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040142,
					"content": "小小年纪就关注这些比来比去的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040143,
					"content": "哈哈，不过孩子们的好奇心就是讲学教育的起点，他们「想要知道」…所以我们才做了这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040144
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040144,
					"content": "模仿正经的「推演」做的「伙伴冒险大战记」！让孩子们模拟养成他们的冒险队伍，然后和敌人对战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040145
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040145,
					"content": "阿塔希耶正好在做饮食和生活环境对于魔物的影响的课题，而法德瓦则帮忙建立「模拟养成」的模型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040146
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040146,
					"content": "模拟养成？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040147
					]
				},
				{
					"id": 402040147,
					"content": "嗯，毕竟不能真的让孩子去和蕈兽啊，镀金旅团接触嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040148
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040148,
					"content": "怎么样，有空的话就来看看吧，嘿嘿，参与测试的话，也能算作参与课题，这样不断积攒，也能有了不起的学历呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040149
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040149,
					"content": "#哦哦，听上去好棒哦…{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040150,
					"content": "好哦，派蒙积攒学历当贤者！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040151
					]
				},
				{
					"id": 402040151,
					"content": "哼，可别小看我，我可是很了不起的，以后会更了不起。嗯！我们待会儿就来看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040152,
					"content": "#那就欢迎你们来测试，{NICKNAME}，当然了，哈哈，还有了不起的未来贤者派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040153
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040153,
					"content": "嗯，你们想要试试的话就跟我说吧，我还得先跟你们交代下「模拟养成」的规则呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040134,
					"content": "当然是长鬓虎！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040135
					]
				},
				{
					"id": 402040135,
					"content": "哦哦！我也觉得长鬓虎比较厉害呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040136,
					"content": "唔，怎么会有这么奇怪的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040137,
					"content": "会滑铲的长鬓虎最厉害！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040138
					]
				},
				{
					"id": 402040138,
					"content": "到底什么是会滑铲的长鬓虎啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040139,
					"content": "唔，是谁问的这么奇怪的问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040125,
					"content": "抱歉，只对吵架感兴趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040126
					]
				},
				{
					"id": 402040126,
					"content": "别这么说嘛，听上去好像是什么路过的怪人一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040127,
					"content": "不如我们先听听他想做的测试是什么样再决定嘛。我对新鲜水果…我对他们的研究课题有点好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402040128,
					"content": "哎呀，这位白色的小小女士有这样的好奇心，旅途中的运气肯定不会太差的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040129
					],
					"speakerTitle": "达尔维什"
				},
				{
					"id": 402040129,
					"content": "那就让我为两位解释一下这个课题…应该从什么地方说起呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "达尔维什"
				}
			]
		},
		{
