			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "这就是高人的居所吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070102,
					"content": "呜…怎么感觉凉飕飕的呀…真有人住在这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070103,
					"content": "我、我也觉得有点意外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070104,
					"content": "奇怪，笔记上说的确实是这里没错啊，难道说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070105,
					"content": "也许我们搞错了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "呜…内心有点动摇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070108,
					"content": "不过既然已经走到这里，我认为，我们还是应该进去一探究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070109,
					"content": "嗯，也有道理，万一有什么惊喜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070110,
					"content": "对了，那本笔记上是怎么说的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070111,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070112,
					"content": "「鹤衔来<color=#00E1FFFF>一</color>朵装饰发梢的鲜花，白兔将<color=#00E1FFFF>四</color>片月光缝成裙摆，我打扮得当，<color=#00E1FFFF>向着东方</color>喊了<color=#00E1FFFF>七</color>声椿的名字，转眼便站在去往她家的小径上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070113,
					"content": "好像童话故事一样…难道说，只要这样做，「椿」就会来迎接你妈妈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070114,
					"content": "越来越像仙人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "总觉得，也像是某种暗号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070116,
					"content": "我们靠近一点再做判断吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070117,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070106,
					"content": "说不定是狐狸神使？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
