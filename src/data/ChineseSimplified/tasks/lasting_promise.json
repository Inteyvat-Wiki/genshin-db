					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "开了吗开了吗？有没有仙人留下的财宝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070202,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070203,
					"content": "唔…这是书吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070204,
					"content": "看起来也是本笔记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070205,
					"content": "难道这会是「椿」的笔记吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070206,
					"content": "各位，我们还是到外面去吧。这里气氛跟我想的有些不同，总觉得…不太想在这里翻开这本笔记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070207,
					"content": "说得对，光线不好容易看坏眼睛哦。走吧走吧，去外面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
