			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "到这里就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070302,
					"content": "快看看笔记里写了什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070303,
					"content": "呜~会不会是神秘宝藏呀，好期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070304,
					"content": "派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "怎么了？突然那么小声，搞得我也紧张起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070306,
					"content": "我们到边上去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070308,
					"content": "原来是不想打扰绫华看笔记啊，看来，那本笔记真是有来头的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070309,
					"content": "不过看她的神情…多半不是藏宝图了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070310,
					"content": "唔，里面会有什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070311,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070312,
					"content": "呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070313,
					"content": "旅行者，派蒙，抱歉让你们久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070314,
					"content": "才一小会儿，你已经看得很快啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070315,
					"content": "笔记看完了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "嗯，看完了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070317,
					"content": "我想，我应当和你们分享这本笔记的真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070318,
					"content": "虽然，里面的内容跟我想的完全不同就是了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070319,
					"content": "不同？这不是狐狸神使的笔记吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070320,
					"content": "不是狐狸神使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070321,
					"content": "「椿」的真身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070322,
					"content": "就是我的母亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070323,
					"content": "哎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070324,
					"content": "很惊讶对吧？我、我也很惊讶…但这本笔记一开始便这样写了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070325,
					"content": "「椿与平时的我既相同又不同，作为椿时，我不是神里华代，而是一个最最平凡的女子。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070326,
					"content": "「以下所有，仅仅是一个普通的我所记录的生活琐事罢了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070327,
					"content": "笔记中写的，大多是母亲平日里私密又琐碎的小心思…那些我们以为与「椿」有关的事，也是属于她的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070328,
					"content": "意思是说，设计图纸跟异国料理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070329,
					"content": "嗯，都是我母亲想要尝试的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070330,
					"content": "或许对你们来说有些奇怪，但作为我而言，非常能够理解母亲的这种行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070331,
					"content": "倒不如说，其实…其实我自己也有这样的一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070332,
					"content": "看笔记的时候甚至有些不知所措，就好像是我的一些想法被人看穿了、写到笔记上一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070333,
					"content": "绫华…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070334,
					"content": "母亲嫁给我父亲之后，就一直作为神里家的主母掌管各项事宜。社奉行身份相对尊贵，需要打点的方面非常多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070335,
					"content": "不仅如此，她的一举一动都代表着神里家族。人们总是注视着她，在这种情况下，她一定没有太多时间去做自己想做的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070336,
					"content": "父母过世后，我和哥哥接手了神里家的一切。期间遇到的许多困难，可能对外人来说有些难以想象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070337,
					"content": "每当我遇到麻烦事，总是会想：母亲当年是否也这样做过？这样的事，她会怎么处理呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070338,
					"content": "或许，真是太久没见她了吧。不知不觉中，就连我的记忆里也几乎只剩下母亲威严和高贵的一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070339,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "但…这是不对的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070341,
					"content": "当我看到这本笔记，就意识到了…她和我完全一样，无论我们背负着怎样的职责，也都只是一介普通人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070342,
					"content": "喜欢漂亮的着物，想要尝试每个地区的美食，渴望不曾见过的美景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070343,
					"content": "也许你们听见这样的话会笑话我不够成熟，但…我确实也有这样的想法。不是作为神里绫华，而是作为一个普通的女孩去生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070344,
					"content": "母亲写到，她一直想参加稻妻本地的民间祭典。她说，天气晴朗的夜晚，自家中向远方眺望，偶尔能看见祭典的灯火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070345,
					"content": "我也看到过哦！非常热闹，人很多，灯笼里的火非常明亮，能照亮大片夜空…有时我们还要操心那里的治安问题呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070346,
					"content": "只是，以我们的身份，贸然参加祭典或许并不合礼数。尤其在我父母的时代，社奉行与民众的关系还没有那么亲近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070347,
					"content": "就算没有人限制我们，社奉行的人突然出现在人群中，大家多少也会投来异样的眼光吧。会想着，我们去那里是要做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070348,
					"content": "母亲说，她不想让别人感到拘谨，希望大家尽情享受祭典的快乐与自由…她不愿打扰别人，也没有那么多闲暇，便一次都没有去过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070349,
					"content": "原来是这样…所以那张设计图纸上画的是她打算穿去祭典的衣服吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070350,
					"content": "是的。祭典上有时会售卖异国料理，那些也是她想要尝试的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070351,
					"content": "说来有些冒昧，但…真没想到我的妈妈也有这么少女心的一面呢，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070352,
					"content": "才不冒昧呢，我认为，你妈妈是个可爱又有责任心的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070353,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070354,
					"content": "不知不觉中，我为母亲完成了一些愿望。唯独去祭典一事，我无法替她完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070355,
					"content": "似乎…也没有机会见到她完成这件事了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070356,
					"content": "你已经做得很棒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "嗯，我明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070359,
					"content": "…谢谢你们，我好像明白了一些事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070360,
					"content": "母亲和我，在某些方面是完全一样的。她所面临的事，同样也是我将要面对的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070361,
					"content": "她把无法实现的事寄托在「椿」身上，而我…已经下定决心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070362,
					"content": "咦！难道你也要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070363,
					"content": "不，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070364,
					"content": "我不打算用这样的方式。我想…我有了新的目标，我会不留遗憾地度过每一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070365,
					"content": "那个…旅行者，我…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070366,
					"content": "呼…放松，放松…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070367,
					"content": "你对我们这里的祭典有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070368,
					"content": "从看到海报开始，我就一直想去哦！绫华是不是也有兴趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070369,
					"content": "绫华，你也没去过祭典吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "啊啊，请不要笑话我！我、我也曾担心过那些事…不过，已经不要紧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070371,
					"content": "我打算真诚地面对自己的心，完成这个同样属于我的愿望。如果是你的话，一定不会责怪我的任性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070372,
					"content": "我想…我想请你和我一起去祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070373,
					"content": "我非常乐意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "要去要去！祭典上肯定有很多好吃的吧？还有好玩的，嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070375,
					"content": "…太好了，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070376,
					"content": "现在去的话，应该还能赶上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120070377,
					"content": "对哦，今天好像是最后一天吧？还等什么，快走快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120070357,
					"content": "不是绫华的问题哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}