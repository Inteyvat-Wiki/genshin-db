			"dialogs": [
				{
					"id": 747110101,
					"content": "嗯！一切顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110102,
					"content": "现在我可以确定了，救治狂暴鱼儿们的工作，已经进入了最后阶段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110103,
					"content": "除了再找回一些病患鱼儿，查漏补缺，还有一个特别的任务——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110104,
					"content": "从受到影响的水域，找出关键的水下机关，回收它们的探测设备所记录的资料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110105,
					"content": "然后从中找出相关的规律…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "没错哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110108,
					"content": "还要给船主和潜水员提个醒，总结一下这次的教训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747110109,
					"content": "嗯，还有渔民和游客，在水面上坐船，在水下潜水的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110110,
					"content": "所有和水域打交道的人都要留个心眼，可别随意乱丢东西，搞得水域环境一团糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110111,
					"content": "不然，可能会有暴躁的鱼儿来掀翻你的小船哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747110106,
					"content": "以便之后防治类似的事故？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
