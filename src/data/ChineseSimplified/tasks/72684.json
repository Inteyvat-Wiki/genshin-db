			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"荒泷一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "哈哈哈哈哈哈哈！我的挚友啊！你终于到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840602,
					"content": "刚刚还在想，什么时候才能见到你，果然你就到了，真是让本大爷高兴啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840603,
					"content": "看看本大爷这场子，怎么样？是不是上佳的选择？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840604,
					"content": "三面环海，空气清新，远离城市喧嚣，坐拥绝版景观资源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840605,
					"content": "背靠甘金岛，独享祭典文化中心的顶级配套。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840606,
					"content": "水陆交通发达，无论是步行或是坐船都能便捷抵达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840607,
					"content": "确实，场子很不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "当初看到这个场子的瞬间，本大爷就决定，就是它了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840610,
					"content": "那一刻，世界大有不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840611,
					"content": "老大英明！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840612,
					"content": "明明是被天领奉行的人赶过来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840613,
					"content": "咳咳…我们还是先说正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840614,
					"content": "这次请你们过来，是想请你们参加我荒泷极上盛世豪鼓大祭典！这个祭典意义重大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840615,
					"content": "老大说，一来是为了宣传我荒泷派的名头，方便未来招新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840616,
					"content": "二来是为了忍姐毕业庆功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840617,
					"content": "最后还能补上前几次因为欠缺经费而延期的团建。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840618,
					"content": "还真是一典多用呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840619,
					"content": "阿晃...最后一条不必再提。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840620,
					"content": "怎么没有看见阿忍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "祭典这种事，多多宣传才有更多的人来参加，所以阿忍去发传单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840622,
					"content": "喂！明明阿忍是主角吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840623,
					"content": "居然她在外面干活，你们在这里游手好闲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840624,
					"content": "本大爷也有在认真…认真在这里接待你们啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840625,
					"content": "老大其实是刚刚回来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840626,
					"content": "说是估算着你们可能要到了，才特地回来迎接的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840627,
					"content": "本来他和忍姐一起，也在外面努力拉人参加祭典呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840628,
					"content": "不用夸我，不用夸我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840629,
					"content": "哟，放牛的居然也在认真做事了。难得的靠谱了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840630,
					"content": "哼，不跟你这飞行矮堇瓜一般见识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840631,
					"content": "话说回来，我的挚友啊，关于这次祭典，你还有什么疑问吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840608,
					"content": "确实，你们很乐观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
