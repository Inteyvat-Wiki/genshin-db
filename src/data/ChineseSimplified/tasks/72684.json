				"points": []
			},
			"dialogs": [
				{
					"id": 726847101,
					"content": "我是荒泷豪鼓祭反馈大使阿晃，您有什么要反馈的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847102,
						726847103,
						726847104
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847102,
					"content": "我觉得还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847105,
					"content": "好的，您的反馈我收到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847106
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847106,
					"content": "欸？您问别的？我没有别的话要说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847107
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847107,
					"content": "啊…老大的意思是，我的工作只要说，「您有什么要反馈的吗？」，「您的反馈我们收到了」这两句话就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847108
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847108,
					"content": "如果客人还要追问什么时候反馈才有消息，那就再加一句，「请您耐心等待」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847109
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847109,
					"content": "他说他在其他地方参加的活动都是这样的，想必是借鉴了一下优秀的经验吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847110
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847110,
					"content": "不过后来忍姐说这样实在太敷衍了啦，所以又给我准备了一个小本子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847111
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847111,
					"content": "瞧，您的意见我已经记下来了，等忍姐回来了再给她看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726847103,
					"content": "我觉得一般般。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847104,
					"content": "我觉得不太行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				}
			]
		},
