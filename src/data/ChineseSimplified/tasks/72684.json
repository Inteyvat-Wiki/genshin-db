				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840301,
					"content": "有什么需要帮忙的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840302,
					"content": "关于即将举办的祭典。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "什么？祭典？最近没听说要举办祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840304,
					"content": "二位能说得更详细一些吗？比如名字之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840305,
					"content": "名字是荒泷极上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "荒泷极上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840307,
					"content": "荒泷极上盛世…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "是荒泷派举办的荒泷极上盛世豪鼓大祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840310,
					"content": "啊！是上次在容彩祭上捣乱的那个荒泷派吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840311,
					"content": "原来你们说的是那个三无活动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840312,
					"content": "三无活动？不是不是，你搞错啦。是荒泷极上盛世豪鼓大祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840313,
					"content": "好了，不用强调这个名字，我大概知道了，总之我来告诉你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840314,
					"content": "前几天我确实在这里看到了荒泷派的成员，他们在四处堆放一些毫无美感的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840315,
					"content": "那个为首的家伙，还声称要在这里办一场超过容彩祭的大型祭典，应该就是你们说的那个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840316,
					"content": "结果稍微查问了两句，发现他们既没有活动举办许可，也没有场地租用凭证，更不用说事先应该去奉行所准备好的报批记录了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840317,
					"content": "这明显是板上钉钉的三无活动。按照规定，我们只好强制他们停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840318,
					"content": "欸？强制停止！难道他们已经被抓起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840319,
					"content": "那倒没有，看在他们是没有经验，而且好歹准备了安全预案的份上。我们也只是对他们进行了简单的教育。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840320,
					"content": "安全预案，这帮家伙还是挺有安全意识的嘛...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840321,
					"content": "如果你们在找荒泷派，也许可以去甘金岛看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840322,
					"content": "甘金岛是社奉行给各种大小祭典常备的场地，初衷是为了培育各种来自民间的文化活动，手续和费用都是从简。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840323,
					"content": "我们把这个告知了荒泷派的那几位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840324,
					"content": "如果他们仍然想要举办活动的话，那里是最合适的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840325,
					"content": "#唔...{NICKNAME}，虽然已经感觉不太靠谱的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840326,
					"content": "但是，来都来了...所以我们还是去甘金岛找找吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840308,
					"content": "荒泷极上盛世豪鼓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
		},
