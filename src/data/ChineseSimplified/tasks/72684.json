					"nextDialogs": [
						726840658
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840658,
					"content": "还警告我们不许涂改，这样针对我荒泷派，实在可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840659
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840659,
					"content": "总有一天我要在大街上堂堂正正地击败这个臭天狗！好好惩罚她一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "荒泷一斗"
				},
