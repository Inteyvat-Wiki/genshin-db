				"points": []
			},
			"dialogs": [
				{
					"id": 726847201,
					"content": "我是荒泷豪鼓祭氛围大使阿守，您有什么需要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847202,
					"content": "您问我的工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847203,
					"content": "啊，氛围大使嘛，主要就是营造火热的氛围，让参加祭典的人们产生「我快要嗨到不行了」的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847204,
					"content": "您有那种感觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847205,
					"content": "完全没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "请…请不要说这种话啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847208,
					"content": "不要这样冷漠地打击我的积极性啊！这样我的工作不就失去了意义吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847209,
					"content": "您是老大的挚友，请代替老大给我一些支持吧。拜托了，对我说那句话吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847210,
					"content": "哪句话？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "「我快要嗨到不行了」那句话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847212,
					"content": "我快要嗨到不行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "太棒了！太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847214,
					"content": "这是对我最好的认可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847218,
					"content": "来吧，朋友们！接着奏乐！接着舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847215,
					"content": "我快要…我快要…抱歉我说不出口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "唔…好吧。就算您这样说，但看着荒泷派的大家都在努力做好自己的工作，所以就算这样我也不能松懈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847217,
					"content": "无论遭受什么打击也不放弃，这是老大的教导！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726847206,
					"content": "根本不会有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
	]
