			"dialogs": [
				{
					"id": 726840632,
					"content": "祭典都有哪些内容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "哈哈哈哈！内容丰富的很！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840634,
					"content": "看见那边的小山坡了吗？那是豪歌岭，你们可以站在上面，面对大海，自由歌唱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840635,
					"content": "还有这团篝火，用来烤堇瓜绰绰有余。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840636,
					"content": "还有这堆箱子，不管是玩《七圣召唤》还是斗虫都不会感到拥挤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840637,
					"content": "听起来还真是「丰富」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840638,
					"content": "当然，祭典的重头戏还是这个豪鼓祭演啦。来，你们看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840639,
					"content": "偷偷告诉你们，这可是我从秘密渠道搞来的好东西，说是一位大阴阳师留下的宝具小鼓，本来要价800万摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840640,
					"content": "卖家说看我面目俊朗，与她有缘，于是给我打了个折，只要80万摩拉就卖给我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840641,
					"content": "800万摩拉变成80万摩拉，怎么听也像是骗人的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840642,
					"content": "当然！我怎么可能被这种低劣的手法骗到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840643,
					"content": "我一眼就看出了这个小鼓的边缘有些破损，这是瑕疵品！还说什么与我有缘，可笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840644,
					"content": "于是本大爷又砍了她一刀，最后只要8万摩拉成交。哈哈哈哈哈！捡到大便宜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840645,
					"content": "总觉得是人家捡到大便宜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840646,
					"content": "话说回来，放牛的居然出得起8万摩拉，让人有点刮目相看啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840647,
					"content": "不过是8万摩拉而已，不要随便看轻本大爷啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840648,
					"content": "我出了其中的2万...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840649,
					"content": "我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 726840650,
					"content": "啊？老大，为什么我出的是3万？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 726840651,
					"content": "2万加2万加3万等于…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840652,
					"content": "好你个放牛的，居然自己不出一分钱，就从小弟那里搜刮了8万摩拉出来...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840653,
					"content": "咳咳，你是怎么算的，我我我也是出了最后1万摩拉的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840665,
					"content": "好了，多的就不说了，看看时间，我也得回阿忍那里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840666,
					"content": "祭典才刚刚开始，我们还得再努力拉一些人过来才热闹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840667,
					"content": "收好这个小鼓，如果准备好要开始豪鼓祭演，找元太就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 726840668,
					"content": "回见了！我的挚友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
		},
