					"博彦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840501,
					"content": "二位有什么需要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840502
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840502,
					"content": "我们来找荒泷派。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "噢噢噢，我知道了，你们也是来参加那个荒泷极上什么什么大祭典的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840504,
					"content": "也是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "嗯嗯，不久前，天领奉行的九条裟罗大人，还有长野原烟花店的宵宫小姐都来过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840506,
					"content": "宵宫小姐是过来送烟花时，碰巧看见那伙人在张罗场地，可能是感兴趣吧，所以过去看了看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840507,
					"content": "至于九条裟罗大人为什么过来，就不太清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840508,
					"content": "#{NICKNAME}，居然有人比我们先到了呢！嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840509,
					"content": "所以荒泷派他们现在在哪里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726840510,
					"content": "说来惭愧，因为最近岛上已经没有额外的空余场地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840511,
					"content": "我们只好把他们安排在了西北边的小滩涂上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840512,
					"content": "如果他们能再早些申请，我可以为他们准备更好一些的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840513,
					"content": "你们往西北边走一走应该就能看见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博彦"
				}
			]
		},
		{
			"id": 7268406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
