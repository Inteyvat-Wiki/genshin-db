			},
			"dialogs": [
				{
					"id": 726840701,
					"content": "我是荒泷豪鼓祭接引大使元太，准备好开始豪鼓祭演了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840702
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840702,
					"content": "哦对了，关于这个小鼓，之前老大有一点忘记交代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840703,
					"content": "因为大家也不太懂乐器，所以您在开始之前，可以先调试一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840704
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840704,
					"content": "这样可以让最后的音色更加准确动听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840705
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840705,
					"content": "来，请您试试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元太"
				}
			]
		},
