				"objectNames": [
					"阿部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "哦哦！哈哈…真是奇形怪状！它们也有自己的「灵」吗？它们也凝结着人的记忆吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060502,
					"content": "还有这个…软软呼呼的，小翅膀一样，它是会飞吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060503,
					"content": "唉呀…没完没了的好奇，船夫都要生气了…真是不好意思，最终还是该走了，该上船咯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				}
			]
		}
	]
