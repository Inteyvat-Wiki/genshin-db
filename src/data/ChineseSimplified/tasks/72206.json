				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "喂！我还在这呢！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060102,
					"content": "现在的年轻人都是怎么回事，一点公德心都没有吗！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060103,
					"content": "对、对不起！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "哼…这还差不多，认错就好，那点蘑菇就当我送你的了…不要乱碰我的蘑菇啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060105,
					"content": "这是你的蘑菇吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "关你什么事！别再乱采摘了，乖乖离开就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
