			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "喂！我没有警告过你们吗！你们是耳朵不好还是没长眼睛呀？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060302,
					"content": "哇，是幽灵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "哇啊！什么幽灵？！哪里有幽灵！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060304,
					"content": "就在这里哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "呀啊！去，去！恶灵速去！！以我阿部的氏名，命你快快离去！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060307,
					"content": "唉呀，邪门，邪门！我活了这么些年，还没见过如此凶恶的灵！！为何还不速去！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060308,
					"content": "我是从岛外来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "雾海外的恶灵吗…哼，我可不怕你！你在这里站着别动，等着让雷鸟大人把你驱走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060310,
					"content": "雷鸟不会再来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "你说什么…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060313,
					"content": "大家都已经离去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "什么…你在说什么啊…别说让我害怕的话呀，鸡皮疙瘩都起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060316,
					"content": "不过…岛上的人是越来越少了…之前木奈那孩子说，大家都去坐船了呢…唉，也不知道那孩子跑去哪里玩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060317,
					"content": "对了，岛外来的恶灵大人，你不去吗…？海边那条银璨璨的船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060318,
					"content": "我没看到哪里有船。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "哼…我就知道，那船呀，岛外的人是看不到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060321,
					"content": "谢谢你催我上船，岛外的恶灵大人。只不过呀…我活了这么些年，还有好些东西没见识过呢，可舍不得离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060322,
					"content": "你需要什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "需要？哈哈，不算需要吧…也就是看个新鲜而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060324,
					"content": "我很小、很小的时候，曾经和宇奈大姐打过一个赌…我说岛外一定有不一样的蘑菇，可她就是不信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060325,
					"content": "后来…她的丈夫出海去了外人的土地，就再也没能回来…他的灵也只能在外人的土地上晃悠了…可怜呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060326,
					"content": "于是，宇奈大姐一直一个人过日子到现在…一想起来我就…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060327,
					"content": "请不要惦记别人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "我还求过祭司大人呢…好歹要给人家一个归宿…嗯？哦，对了，对了，蘑菇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060330,
					"content": "咳咳…就要登船了，我也没什么可遗憾的…就是没有见识过岛外的玩意。可是我最上心的呢…也就每天都在关照的蘑菇们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060331,
					"content": "就请你给我带来一些雾海外的蘑菇吧…也让我涨涨见识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060332,
					"content": "拜托你了，岛外的恶灵大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿部"
				},
				{
					"id": 722060328,
					"content": "关于蘑菇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "那不是为我准备的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "是时候告别了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "「雾海」已经是过去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "就是我啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
