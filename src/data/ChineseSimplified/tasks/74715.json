			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲米尼"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3509.359,
							452.648,
							4162.708
						],
						"pointId": 17298
					}
				]
			},
			"dialogs": [
				{
					"id": 747150101,
					"content": "菲米尼，你怎么看起来那么疲惫？是这阵子打捞得太累了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150102,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150103,
					"content": "也不要躲进潜水头盔里啦！我们都是好朋友，比起憋进心里，说出来会更好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150104,
					"content": "…嗯，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150105,
					"content": "刚才下水打捞的时候，我见到了一个有些讨厌的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150106,
					"content": "讨厌的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150107,
					"content": "呃…要从哪里讲起呢。按照枫丹法规，对于沉入水下的货物，如果原主获得了保险赔款，它们就会变成自由财产。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150108,
					"content": "基于这种规则，有些人将潜水视为发财的手段。通过打捞别人遗失的东西，在上岸后卖出摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150109,
					"content": "这么做并没有太高门槛，导致潜水员中混入了不少…一心只想获得财富的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150110,
					"content": "有时候，他们会粗暴地赶走鱼群和膨膨兽，只因它们碍了自己的生意…我不接某些委托，也与这样的人有一点关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150111,
					"content": "原来是这样…可以理解菲米尼的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150112,
					"content": "刚才在水下，我又遇到了这样的情况。我鼓起勇气，制止了对方的行为。尽管最后还是…被骂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150113,
					"content": "怎么这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150114,
					"content": "你做得没错！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "#谢谢{NICKNAME}和派蒙的好意，不过…虽然对我来说很难也很累，但我还是想靠自己的努力，去改变些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150117,
					"content": "我喜欢在水下遨游的感觉，观察苍晶螺的纹路，感受海露花的呼吸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150118,
					"content": "当水下的世界认可你时，它会给你善意的回应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150119,
					"content": "我认为这才是我们应该选择的，与世界相处的方式，而不是一味自私地夺取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150120,
					"content": "我觉得菲米尼说的这些也很好噢！你看，当你真的有什么想做的、想说的时候，表达出来其实更畅快吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150121,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150122,
					"content": "菲米尼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747150123,
					"content": "抱歉…我有点害羞。总之…我、我会继续努力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150124,
					"content": "差点忘了…这些是最新的水底勘测情报，请收下，它们应该能对你们派上用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747150115,
					"content": "下次我们也可以替你出面！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}