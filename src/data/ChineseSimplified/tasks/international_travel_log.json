			"dialogs": [
				{
					"id": 728010401,
					"content": "瞅我干啥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010402
					],
					"speakerTitle": "平八"
				},
				{
					"id": 728010402,
					"content": "一边去，别来耽误我的事！",
					"roleType": "TALK_ROLE_NPC",
