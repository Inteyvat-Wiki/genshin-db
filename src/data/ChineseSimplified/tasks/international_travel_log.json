				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "这位客人，今日光临「木漏茶室」有何贵干？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "梢"
				},
				{
					"id": 728010202,
					"content": "关于拉姆齐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "那位商人啊…他确实在茶室里，不过，最近他似乎看上去有些紧张，不知道遇见了什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "梢"
				},
				{
					"id": 728010204,
					"content": "你要是想找他的话，往里面走一走就能看见他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梢"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
