							"7280103",
							"2"
						],
						"stepId": 7280103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉姆齐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "你是…旅行者？找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010302,
					"content": "关于「游记」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "噢，你是说我写给小绿那孩子的「游记」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010304,
					"content": "这真是…我最近实在没空写了，估计那孩子肯定等急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010305,
					"content": "那些「游记」是真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "哈哈哈，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010307,
					"content": "不太像真的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "哈哈哈，不愧是四处旅行过的人，一看就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010311,
					"content": "没错，严肃地来说，这些「游记」都不是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010312,
					"content": "虽然有些地点和人物确实是取材于现实…但大部分的内容，都是出自于我个人的想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010313,
					"content": "当然啦，有些内容也不完全是想象。比如我正在写的一篇「游记」里，一个人制作了一个超级气球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010314,
					"content": "然后他召集了几位同伴，想要用这个气球在八十天内环游提瓦特大陆一圈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010315,
					"content": "而且，操作这个气球完全不需要「神之眼」，只需要有技术常识就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010316,
					"content": "这群人搭着气球环游着世界，一路上遇见了无数奇怪的事物和现象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010317,
					"content": "这篇本来就是我准备写给小绿的，但因为…某些原因，我到现在连一小段都没机会写完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010318,
					"content": "什么原因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "你看见走廊上那个家伙了吗？他叫平八，不知道从什么时候起，那家伙就一直盯着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010320,
					"content": "我本来想出去采风，给那篇「游记」取取材，但那家伙每次都跟着我，不知道想做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010321,
					"content": "因为担心这家伙对我图谋不轨，我也就不敢出去采风了，这篇「游记」也就搁置了下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010322,
					"content": "但还好现在你来了，旅行者，你能陪我出去采采风吗？有你陪着，谅那家伙也不敢对我做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010323,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010327,
					"content": "而且俗话讲「防人之心不可无」，有这么一位在后面盯着我，无论他打着什么主意，我多少也得防着点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010328,
					"content": "所以，在我采风的时候，护卫我的事就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010329,
					"content": "我之前其实已经定好了几处采风的地点，我们直接过去就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010330,
					"content": "第一个地点是附近的海滩，我们现在就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010325,
					"content": "他为什么要这么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "我不知道。但是…对某个人产生恶意，可不需要什么太充分的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010309,
					"content": "我希望是真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "哈哈哈，我也希望我写的这些东西能够成真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "拉姆齐"
				}
			]
		},
