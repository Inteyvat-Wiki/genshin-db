				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280105",
							"2"
						],
						"stepId": 7280105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉姆齐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "这片海滩的水质格外清澈，细砂的颜色也很白净，与狂躁的外海截然不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010502,
					"content": "从这里出海…起飞的话，应该还挺有氛围的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010503,
					"content": "咳，这里的景致很不错，我得记录一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010504,
					"content": "旅行者，请稍等片刻，我需要思考一下游记的写法，你们可以在附近走走，欣赏海滩的风光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "拉姆齐"
				},
				{
					"id": 728010505,
					"content": "…但是，请别离我太远，那个叫平八的家伙已经跟出来了，就在旁边。",
