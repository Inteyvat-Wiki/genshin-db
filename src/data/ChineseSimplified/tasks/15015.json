			"dialogs": [
				{
					"id": 150151101,
					"content": "噢，你们来了啊，事情都处理完了。呼啊…我正打算去睡觉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151102,
						150151107,
						150151112,
						150151116
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151102,
					"content": "关于特拉佐莉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151103
					]
				},
				{
					"id": 150151103,
					"content": "婶婶啊。部族里还在商量怎么处罚她呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151104
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151104,
					"content": "毕竟，用古名技术来犯罪的人，古往今来也没多少…帕加尔可要头疼一阵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151105
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151105,
					"content": "至于她的工坊，部族里已经派人去看着了，过几天应该就会彻底封闭，剩余那些未成型的「燃晶名刻」应该也会彻底销毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151106
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151106,
					"content": "还好她的「古名」没出问题，不然乱子可就大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151107,
					"content": "关于「燃晶名刻」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151108
					]
				},
				{
					"id": 150151108,
					"content": "说到这个，倒是有个好消息。「燃晶名刻」所汲取的记忆是可恢复的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151109
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151109,
					"content": "在「燃晶名刻」彻底停机后，那些回忆应该就会顺着原路，物归原主了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151110
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151110,
					"content": "婶婶想要妮赫佳回来，所以让整个部族的人都忘记了妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151111
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151111,
					"content": "现在妮赫佳真的离开了，大家却又即将想起她…真是乱七八糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151112,
					"content": "关于妮佩卡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151113
					]
				},
				{
					"id": 150151113,
					"content": "妮佩卡啊。现在正在我的工坊里帮忙呢，我也联系了同族的人，准备查一查这孩子的身世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151114
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151114,
					"content": "现在族里还没给我回信，所以我就先照顾着她，顺便教她点手艺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151115
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151115,
					"content": "妮佩卡的学习速度虽然慢了点…但态度还不错。等她在成长一些，说不定也能成为一名铸名师啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150151116,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151117
					]
				},
				{
					"id": 150151117,
					"content": "嗯，回头见。这事情有什么新进展了，我会告诉你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				}
