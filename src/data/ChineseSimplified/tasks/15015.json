					}
				]
			},
			"dialogs": [
				{
					"id": 150150101,
					"content": "刚才我看见妮赫佳了，她和我说了话，她去哪了…去哪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150102
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150102,
					"content": "妮赫佳！妮赫佳！你在哪！回答妈妈！求求你…求求你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150103
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150103,
					"content": "希诺宁…！你刚才也看见了对吧？你也看见了我的小妮赫佳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150104
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150104,
					"content": "我摸到她的手了，也抱住她了…我是对的…我是对的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150105
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150105,
					"content": "那些灰色的影子只是一点小错误…只要再启动一次，对，再启动一次，妮赫佳一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150106
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150106,
					"content": "…婶婶，你还没察觉到么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150107
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150107,
					"content": "察觉到…什么？没什么错，一切都没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150108
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150108,
					"content": "她只是在生我的气，不愿意理我…这孩子就喜欢闹脾气，我…我能理解，我能接受！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150109
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150109,
					"content": "特拉佐莉！够了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150110
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150110,
					"content": "你用「燃晶名刻」召出来的，根本不是真正的妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150111
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150111,
					"content": "你搜集了无数人有关妮赫佳的「回忆」。但是却漏了一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150112
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150112,
					"content": "那些被搜集的记忆中，除了真实的「回忆」外，还有着无数的「情绪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150113
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150113,
					"content": "你难道没有意识到…当人们探望病重中的妮赫佳时，会产生什么「情绪」么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150114
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150114,
					"content": "当人们握住一个临终孩子的手，感受着她无力的呼吸，绝望的眼神…还有逐渐降低的体温时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150115
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150115,
					"content": "除了痛苦和悲伤，他们还能感受到什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150116
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150116,
					"content": "我…把这些情绪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150117
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150117,
					"content": "这些「情绪」，全都被你吸纳进了「燃晶名刻」中，作为实际的「过去」固化了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150118
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150118,
					"content": "那些灰色的人影，是那些「过去」的「投射」。她们只会重复着妮赫佳临终前的模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150119
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150119,
					"content": "而真正的妮赫佳想要说的话，都被这些被扭曲的悲苦思绪所掩盖了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150120
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150120,
					"content": "我…我不想这样…我只是想要记住妮赫佳，我只是想…只想再见她一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150121
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150121,
					"content": "…妮赫佳，一直都陪在你身边，婶婶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150122
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150122,
					"content": "那枚被你称作「毫无作用」的「古名」，早就记录了一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150123
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150123,
					"content": "你用尽了一切方法，抛下了一切，试图拯救自己的女儿…这是不可动摇的事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150124
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150124,
					"content": "你难道忘了自己「古名」的真义了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150125
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150125,
					"content": "我的「古名」是…「翁{RUBY#[D]亲}杜{RUBY#[D]情}古」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150126
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150126,
					"content": "这枚「古名」，早就将你和妮赫佳之间不可动摇的亲情记录在内。但你却对此视而不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150127
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150127,
					"content": "「名字，是过去对未来的祝福。」这是你告诉我的，婶婶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150128
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150128,
					"content": "是你给妮赫佳取了名，是你为妮赫佳送出了最初的祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150129
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150129,
					"content": "现在，却亲手将妮赫佳这枚名字扭曲成了囚牢，囚禁着那个无辜的孩子…也囚禁了你自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150130
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150130,
					"content": "…妮赫佳是我生命的全部。失去了她，我根本看不见未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150131
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150131,
					"content": "至于祝福…哈哈…从妮赫佳离开后，我就再也感觉不到「祝福」了。我只会每天梦见那孩子抓着我的手，说自己很痛，求我抱她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150132
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150132,
					"content": "我却什么也看不见，也抓不住妮赫佳的手，只能不断地喊她的名字，直到从梦里惊醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150133
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150133,
					"content": "每一天，每一天…我都痛恨我自己，也痛恨「古名」。妮赫佳…或许也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150134
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150134,
					"content": "你觉得，妮赫佳也会恨你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150135
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150135,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150136
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150136,
					"content": "婶婶。你还记得妮赫佳对你说的最后一句话么？还记得…妮赫佳真正的遗言是什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150137
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150137,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150138
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150138,
					"content": "你之所以感觉不到「祝福」，是因为你已经遗忘了真正的「过去」。…婶婶，你只是沉溺在自己所想象出的回忆中，不愿自拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150139
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150139,
					"content": "失去「过去」的「名字」，只是一根无根的枯木，除了衰朽外，再无未来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150140
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150140,
					"content": "结束了。婶婶，一切都结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150141
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150141,
					"content": "哎呀，慢一点，不然你还是躺着吧？呃…不对不对，躺在这里也不太好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150142,
					"content": "希诺宁！妮赫佳…妮佩卡已经可以站起来了，我们过来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150143,
						150150144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150143,
					"content": "我来扶你吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150145
					]
				},
				{
					"id": 150150145,
					"content": "#谢谢你们，派蒙姐姐，{NICKNAME}{M#哥哥}{F#姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150146
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150146,
					"content": "我真的没事，刚才妮赫佳姐姐帮了我，已经没那么难受了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150147
					],
					"speakerTitle": "妮赫佳"
				},
				{
					"id": 150150147,
					"content": "那就好。如果你真的变成了妮赫佳，那这个故事，可真就要变成《勇敢的特奎》了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150148
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150148,
					"content": "这里不是聊天的地方，走吧，我们先出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150149
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150149,
					"content": "那…特拉佐莉女士怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150150,
					"content": "放心吧，她已经做不出出格的举动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150151
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150151,
					"content": "一切都结束了，你们离开了这座工坊。出去后，希诺宁拜托你们先陪陪妮佩卡，她还有事要和特拉佐莉单独谈谈…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150150144,
					"content": "我可以背你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150145
					]
				}
			]
		},
