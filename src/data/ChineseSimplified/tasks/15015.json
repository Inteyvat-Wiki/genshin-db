			},
			"dialogs": [
				{
					"id": 150150701,
					"content": "居然来得这么快，真佩服你们的脚力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150702
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150702,
					"content": "妮赫佳在上面！你到底想对她做什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150703,
					"content": "我没有对你们撒谎。从头到尾，我都只是在救我的女儿妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150704
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150704,
					"content": "虽然她现在还不是我的孩子…但等一切都结束，她就会真正成为妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150705
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150705,
					"content": "还，还不是妮赫佳？这到底是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150706,
						150150707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150706,
					"content": "注入记忆…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150708
					]
				},
				{
					"id": 150150708,
					"content": "你已经想通了？没错，我想要用「记忆」让妮赫佳醒过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150709
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150709,
					"content": "那孩子在夜神之国待得太久了…她怕黑，也怕冷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150710
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150710,
					"content": "是我让妮赫佳一个人待在那里的，我必须把她带回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150711
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150711,
					"content": "别怕，妮赫佳，妈妈什么都没有忘记，妈妈一直记得你的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150712,
						150150713
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150712,
					"content": "夜神之国？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150714
					]
				},
				{
					"id": 150150714,
					"content": "…恐怕，确实如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150715
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150715,
					"content": "那…那上面躺着的那个是谁啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150716,
					"content": "她也是我同族的孩子。父母在之前那次深渊袭击中去世了…说来也巧，她的生日，和我的小妮赫佳是同一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150717
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150717,
					"content": "我收养了她，照顾了好久好久。本来…我以为这能让我好过一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150718
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150718,
					"content": "当这孩子第一次愿意叫我妈妈的时候，我先是很开心，然后…突然害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150719
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150719,
					"content": "她是我的孩子？我的孩子…她的名字是妮赫佳，只能是妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150720
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150720,
					"content": "我怎么能开心？我…我的小妮赫佳，她还在等着我…等着我带她回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150721
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150721,
					"content": "我说过，只要能让妮赫佳回来，我即使献出一切，也在所不惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150722
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150722,
					"content": "现在，是献出一切的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150723
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150723,
					"content": "至于我这枚没用的「古名」，哼…也是时候让它派上点用场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150724
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150724,
					"content": "既然你不愿意帮我。那就成为妮赫佳「古名」的燃料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150725
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150725,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150726
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150726,
					"content": "希诺宁，你到现在还没有采取行动，是在观察这周围的刻录图么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150727
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150727,
					"content": "没用的。我已经布置好了所有的「燃晶名刻」，刻录图早就开始运转了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150728
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150728,
					"content": "多亏了你给我提供的思路。这枚「中枢名刻」，会真正成为妮赫佳的「古名」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150729
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150729,
					"content": "等妮赫佳回来后，我会请你参加她的生日宴会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150730,
						150150731
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150730,
					"content": "放了那孩子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150732
					]
				},
				{
					"id": 150150732,
					"content": "你要…你要硬闯上去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150733,
						150150734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150150733,
					"content": "妮赫佳已经死了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150735
					]
				},
				{
					"id": 150150735,
					"content": "…这幅刻录图有缺陷，薄弱点即将运转过来，听我口令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150736
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150736,
					"content": "妮赫佳…别怕，别怕…妈妈在呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150737
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150737,
					"content": "三。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150738
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150738,
					"content": "妈妈会一直陪着你，绝不会忘记你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150739
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150739,
					"content": "二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150740
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150740,
					"content": "妮赫佳…快醒过来吧，求求你，快点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150741
					],
					"speakerTitle": "特拉佐莉"
				},
				{
					"id": 150150741,
					"content": "一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 150150734,
					"content": "不能让她伤害无辜的孩子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150735
					]
				},
				{
					"id": 150150731,
					"content": "派蒙，到我身后去！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150732
					]
				},
				{
					"id": 150150713,
					"content": "难道…妮赫佳已经去世了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150714
					]
				},
				{
					"id": 150150707,
					"content": "遗忘过去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150708
					]
				}
			]
		},
