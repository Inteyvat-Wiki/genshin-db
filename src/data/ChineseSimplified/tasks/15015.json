			"dialogs": [
				{
					"id": 150150901,
					"content": "好了，我把婶婶锁在了屋里，也捆上了好几道绳子。等会我就把她带去部族，让她受到应有的惩罚。",
					"roleType": "TALK_ROLE_NPC",
