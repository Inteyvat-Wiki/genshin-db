				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萨莎",
					"乌布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "呼，这样就顺眼多了。就算是萨莎看到，也会为我们骄傲的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230102,
					"content": "强盗！有强盗啊——光天化日之下，居然有强盗啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230103,
					"content": "什么？！哪里有强盗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230104,
					"content": "我是说你们这对强盗搭档！不仅破坏我的大作，还拿走宝箱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230105,
					"content": "原来真的是协会的人干的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "我干什么了？不如问问你们干了什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230109,
					"content": "所以说，这些丑东西就是你的「大作」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230110,
					"content": "真失礼，什么叫丑东西？你们完全看不懂装置艺术吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230111,
					"content": "看来枫丹的审美教育还任重道远呀…哦，不过你们看起来不像是枫丹人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230112,
					"content": "#我们的确不是枫丹人，我是派蒙，{M#他}{F#她}是{NICKNAME}，也是冒险家协会的成员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230113,
					"content": "呜呜，是邪恶组织的成员。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "是呢，不过不用穿制服，所以不是邪恶绿衣人，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230117,
					"content": "我是冒险家，兼装置艺术家乌布。看到你们胡言乱语的样子，想来平日也是这样行事疯癫…这次的事姑且就先不计较了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230118,
					"content": "啊？其实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230119,
					"content": "怎么？如果有什么感谢的话要说就趁现在，我还得把作品复原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230120,
					"content": "感谢是一句没有，生气的话我已经装满一箱子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230121,
					"content": "萨莎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230122,
					"content": "有我在，派蒙妹妹就不用害怕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230123,
					"content": "邪恶绿衣人，你设下的陷阱已经全部被我们破坏掉了！快点放弃用邪恶陷阱毁灭美丽枫丹的企图吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230124,
					"content": "什么企图？等等，你说全部破坏掉了…你们把我的艺术作品全都毁掉了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230125,
					"content": "倒、倒也没有毁掉啦，只是重新摆放了一下，让它们看起来跟周围的景色更和谐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230126,
					"content": "你们…你们这些小鬼、俗人懂什么艺术！我的装置艺术，我的作品…居然全都变成这样平庸的东西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230127,
					"content": "可是那真的能叫艺术吗？虽然我不是太懂啦，但是会让人看了只觉得别扭的东西也能算艺术吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230128,
					"content": "那当然了，艺术的边界是由艺术家决定的。艺术家创作的作品，自然会被称作是艺术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230129,
					"content": "谁是艺术家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230130,
					"content": "那当然是我了，伟大的装置艺术家，乌布。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230131,
					"content": "如果是这样，作为打倒邪恶组织守护枫丹未来艺术家联盟的创始人，我否认那是艺术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230132,
					"content": "打…打倒什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230133,
					"content": "打倒邪恶组织。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "通常是指会用，呃，装置艺术？破坏风景的冒险家协会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230136,
					"content": "开什么玩笑，我都没听说过这什么打倒什么的联盟，你这个小姑娘凭什么说我的作品不是艺术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230137,
					"content": "因为我是画家，所以也算是艺术家，我当然有资格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230138,
					"content": "啊？小姑娘，艺术家可不是过家家，不是你想当就能当的，得有作品，还得受人认可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230139,
					"content": "那你的资格又是从哪里来的呢？你的作品，就是那些装置艺术…那些邪恶陷阱吗？有人为它们拍手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230140,
					"content": "那是因为俗人太多了，完全无法理解其中的精妙之处，真正的艺术总是曲高和寡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230141,
					"content": "还是先从大家能看懂的艺术做起吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "是啊，如果完全没人能看懂，该说是太过超前呢，还是根本就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230145,
					"content": "不…怎么会？我的作品是完美的，是不可能有问题的，只是你们不懂，只是其他人也都不懂而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230146,
					"content": "可恶，我是不会放弃的，咱们走着瞧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "乌布"
				},
				{
					"id": 740230147,
					"content": "乌布踉踉跄跄地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "真是顽固的敌人，不过我也不会轻易放弃，毕竟枫丹艺术的未来就靠我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230149,
					"content": "大家都有可以为之奋斗的事业了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "这算是好事吗？应该算吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230143,
					"content": "也就是说完全没人能看懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "怎么听都像是失败作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230135,
					"content": "目前看样子是要打倒你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "你好啊，伙伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "连名字都不知道的家伙应该不能说是伙伴吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740230107,
					"content": "哎吔，是邪恶绿衣人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "哎哟，还是会说怪话的强盗，今天这是什么日子呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "乌布"
				}
			]
		},
		{
			"id": 7402302,
			"completionStepIds": [
				7402304
