			},
			"dialogs": [
				{
					"id": 740230301,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}和派蒙妹妹，你们好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230302,
						740230304
					],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230302,
					"content": "给联盟找到新的成员了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230303
					]
				},
				{
					"id": 740230303,
					"content": "找到一些有意向参加的预备成员，不过我得严格考核他们，看看他们的资质是否符合。毕竟是关系到枫丹未来的事业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨莎"
				},
				{
					"id": 740230304,
					"content": "今天不用着急回家吗？",
