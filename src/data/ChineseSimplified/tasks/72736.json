			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "难能可贵，难能可贵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360102,
					"content": "真没想到，荒泷派居然能打败这么多斗虫强者。看来你们对斗虫也有着独特的理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360103,
					"content": "我收回之前的成见。接下来，我会将你们当成值得尊敬的对手，全力和你们比试一场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360104,
					"content": "放牛的，到你这个老大登场的时候啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727360105,
					"content": "可别把之前的话当真！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727360106,
					"content": "出阵吧，「真剑斗虫大鬼王」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "哈哈哈哈哈哈哈，那是当然了！最后对决，也一定会是我赢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727360109,
					"content": "虽然不知道你到底是怎么指导部下的，但结果已经没有悬念了，是本大爷的荒泷派更胜一筹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727360110,
					"content": "准备接招吧！「花角玉将」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727360107,
					"content": "大激斗，鬼王对玉将！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
