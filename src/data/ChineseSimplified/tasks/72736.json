				"objectNames": [
					"「花角玉将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "原来如此，原来如此啊…再打一场吧，我一定能看透你斗虫的门道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360202,
					"content": "比试的胜负似乎已经没那么重要了，我们就斗个爽快，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360203,
					"content": "难得有这么合拍的对手，短短几分钟就结束，未免也太不尽兴了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360204,
					"content": "哈！来就来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727360205,
					"content": "不过…看穿本大爷斗虫的秘技？你可别痴心妄想啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727360206,
					"content": "如果你肯承认，是我斗虫的本领更强，无论斗多少场，我都会奉陪到底！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727360207,
					"content": "唔，放牛的和「花角玉将」还是热血沸腾呢，就让他们继续斗虫吧，斗到他们完全满足！",
					"roleType": "TALK_ROLE_NPC",
