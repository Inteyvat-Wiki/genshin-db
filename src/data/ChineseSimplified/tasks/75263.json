					"基努"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "我也要报名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "出人意料的转折，一位英勇的挑战者出现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630203,
					"content": "哦？不自量力的小鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630204,
					"content": "真是百转千回的进展…最后的赢家到底是谁？那就让我们拭目以待吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630205,
					"content": "员工们布置好了赛场，观众也聚拢起来…你们站上了起跑线…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
