				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "各位游客，悠悠极速大赛马上就要开始了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630102,
					"content": "谁能击败昨天、前天和大前天的卫冕冠军「疾风娜娜丝」，谁就能得到我们今天的惊喜大奖！请还没有报名的游客抓紧最后的时间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630103,
					"content": "哼，面对我「疾风娜娜丝」，已经没有人敢再报名了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630104,
					"content": "唉，「疾风娜娜丝」太强了，已经连续三天拿走奖品了，没有人能赢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "嗷！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "欸？你想试试吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "哼，已经沦落到只敢让龙出场了吗？胆小鬼们，把你们各自的龙都派上来吧，我「疾风娜娜丝」会告诉你们什么才是速度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630108,
					"content": "真是一场别开生面的悠悠极速大赛！让我们看看强壮的龙伙伴们能否击败三连冠的「疾风娜娜丝」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基努"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
