			"dialogs": [
				{
					"id": 752630301,
					"content": "太不可思议了！真的有人击败了「疾风娜娜丝」！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630302,
					"content": "#这位挑战者用来去如风的步伐夺得了今天的冠军，让我们恭喜{M#他}{F#她}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630303,
					"content": "我居然输了…这不可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "「疾风娜娜丝」"
				},
				{
					"id": 752630304,
					"content": "#{M#他}{F#她}好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "但是——！老观众们应该都知道，「疾风娜娜丝」并不是悠悠极速赛场上出现过的最强选手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630306,
					"content": "在「疾风娜娜丝」之前，还有两位堪称恐怖统治级的本土选手，它们今天也来到了赛场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630307,
					"content": "让我们欢迎来无影——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630308,
					"content": "♪、♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "去无踪——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630310,
					"content": "♫ 、♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "挑战者，这两位可是真正可怕的对手，以你刚才表现的实力，要战胜它们恐怕难于登天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630312,
					"content": "你准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630313,
					"content": "准备好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "员工们布置好了赛场，观众也聚拢起来…你们站上了起跑线…",
