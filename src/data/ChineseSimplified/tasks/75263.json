			"dialogs": [
				{
					"id": 752630501,
					"content": "比赛结束！比赛结束！令人震惊的结果出现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630502,
					"content": "#我宣布，本场比赛最终的胜者是——{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "基努"
				},
				{
					"id": 752630503,
					"content": "#哇！{M#他}{F#她}也太强了吧！居然能打败「来无影」和「去无踪」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#{M#他}{F#她}的身影就像一道金色闪电！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "喂喂，没有银色闪电吗？你们都没看见银色闪电吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752630506,
					"content": "我输得好彻底…这大概是我永远抵达不了的速度吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "「疾风娜娜丝」"
				},
				{
					"id": 752630507,
					"content": "不要放弃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "我…我会以你为目标的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "「疾风娜娜丝」"
