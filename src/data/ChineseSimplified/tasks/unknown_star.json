						411111706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111706,
					"content": "陨石就在那边。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "我去看看有什么…咦？皇女，你的<color=#00E1FFFF>神之眼</color>在<color=#00E1FFFF>闪</color>哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111708,
					"content": "咦？难道说，冷冽诅咒已经意识到，这渊色秘珠里流淌的能量，正在奏响它命运的挽歌？",
					"roleType": "TALK_ROLE_NPC",
