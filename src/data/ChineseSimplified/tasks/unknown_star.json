					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "感觉…也许可以？要不我们就先试试，能不能利用<color=#00E1FFFF>神之眼</color>来搜索<color=#00E1FFFF>陨石碎片</color>、清理危害吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111718,
