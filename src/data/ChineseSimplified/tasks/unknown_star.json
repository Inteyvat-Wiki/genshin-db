			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "旅行者，你来得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110102,
					"content": "凯瑟琳，出什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110103,
					"content": "是的，发生了一件不得不请冒险家们出手相助的大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110104,
					"content": "有非常紧急的任务要委托给你，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110142,
					"content": "(test)陨石坠落Cutscene",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110105,
					"content": "呜哇…听起来很严重的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110106,
					"content": "实不相瞒，我们也是第一次遇到这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110107,
					"content": "协会里忙得不可开交，也要靠各位在外游历的冒险家齐心协力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110108,
					"content": "义不容辞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "请稍等，安全起见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110111,
					"content": "凯瑟琳！幽夜净土的子民啊，莫非是你在虔诚地高呼本皇女之尊名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110112,
					"content": "啊，来了来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110113,
					"content": "又见面了，凯瑟琳女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110114,
					"content": "啊！这只乌鸦会说话？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110115,
					"content": "哈哈，何必为这等小事惊讶呢，我的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110116,
					"content": "我忠诚的臣属，看你一脸忧虑，想必是那些罪愆邪佞又一次妄图染指蒙德的安宁吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110117,
					"content": "旅行者，这位是蒙德冒险家协会的资深成员菲谢尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110118,
					"content": "菲谢尔，奥兹，这位就是我提起过的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110119,
					"content": "哦？就是你吗？哼…眼神不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110120,
					"content": "西风骑士团荣誉骑士与其旅伴派蒙。久仰了，很高兴见到二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110121,
					"content": "旅人，你也想要对抗那无边深邃的黑暗结晶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110122,
					"content": "对抗…什么什么黑暗？黑暗什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110123,
					"content": "凯瑟琳，你刚才说的不是这个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "小姐说的，就是那些<color=#00E1FFFF>陨石</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110126,
					"content": "协会方面还不能确定陨石雨的成因及副作用。因此，我们希望冒险家能够组成二人小队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110127,
					"content": "旅行者，菲谢尔，希望你们能彼此关照，在保证自身安全的前提下行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110128,
					"content": "哼，既然是忠诚的凯瑟琳的请求，本皇女也只能允诺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110129,
					"content": "雀跃吧！能与断罪的皇女菲谢尔一同踏上征途，你之余生都应为此感到骄傲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110130,
					"content": "这位是我的主人，来自异界·幽夜净土的皇女菲谢尔，我是她的眷属夜鸦，奥兹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110131,
					"content": "好、好有来头的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110132,
					"content": "#我是派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}，请多关照啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110133,
					"content": "你刚刚说，异世界？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "呃，以后你会慢慢明白的…只要和菲谢尔相处久了，就能明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 411110136,
					"content": "区区旅人，未曾领略无尽幽夜净土的伟大也是意料之中。无妨，我宽恕你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110137,
					"content": "宽恕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110138,
					"content": "她的意思是「你好」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110139,
					"content": "这两个人从刚才开始就像唱双簧一样…主人神秘兮兮的，眷属却时不时拆台，好奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110140,
					"content": "二位想必有很多疑问，我们不如边走边说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110141,
					"content": "话说回来，我们哪是二人小队，明明是四人小队啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110134,
					"content": "幽夜净土…我还是第一次听说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "谢谢你告诉我，我马上动身。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
