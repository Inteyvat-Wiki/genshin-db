			"dialogs": [
				{
					"id": 411110601,
					"content": "凡人，本皇女恩许你免却礼节，就这样将机要线索悉数禀报吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110602
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110602,
					"content": "哎？你是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110603
					],
					"speakerTitle": "乔伊斯"
				},
				{
					"id": 411110603,
					"content": "无意冒犯，先生。只是想请您透露一些有关病患的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110604
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110604,
					"content": "啊啊请不要误会！我们是冒险家协会成员，受委托前来调查情况的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110605,
					"content": "噢，好的。昨天晚上，这个人摸了地上的陨石，很快便昏睡过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110606
					],
					"speakerTitle": "乔伊斯"
				},
				{
					"id": 411110606,
					"content": "所以，你们调查时千万不能直接触碰陨石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110607
					],
					"speakerTitle": "乔伊斯"
				},
				{
					"id": 411110607,
					"content": "粗莽的进谏。本皇女自有渊色秘珠秘法加护，区区黑晶可奈我何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110608
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110608,
					"content": "不不，小姐，您是皇女，有必要听取正确的谏言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110609
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 411110609,
					"content": "是吗…看来只能照办了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110610
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110610,
					"content": "#{NICKNAME}，您是…您是冒险家，有必要听取正确的谏言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110611,
					"content": "好、好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110612
					]
				},
				{
					"id": 411110612,
					"content": "难得说说这种话，感觉还不错呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110613,
					"content": "是在模仿本皇女吗？哼，一千世界寂灭的悲愿岂是凡人所能领会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110614
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110614,
					"content": "不过也好。毕竟对你而言，「断罪皇女」的命运还是太过沉重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110615
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 411110615,
					"content": "请、请皇女移驾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
