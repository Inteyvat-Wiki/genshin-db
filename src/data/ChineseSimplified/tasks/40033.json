			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "辛苦你们了！太好了！这下子应该对上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330302,
					"content": "嗯？怎么还少了几只…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330303,
					"content": "呜哇，怎么会这样。感觉没完没了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330304,
					"content": "确实，有时候查案需要很大的耐心。如果不凑巧走错了方向的话，可能也会竹篮打水一场空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330305,
					"content": "至少我们目前已经找回了很多小动物了，所以大方向应该是对的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330306,
					"content": "只是，可能我们遗漏了什么线索，或者没想到什么地方而已，所以陷入了僵局。不过我相信这是暂时的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330307,
					"content": "我懂了！你是说，我们缺了一点噼咔的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330308,
					"content": "噼咔的感觉…也可以这么说吧。而且我们进展并不算慢，这都是多亏了旅行者和派蒙，所以不用沮丧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330309,
					"content": "（居然听懂了派蒙的话…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "嘿嘿，我总感觉你说得很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330312,
					"content": "过奖了，不过是探案累积下来的经验罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330313,
					"content": "埋得越深的谜题，越有探究的价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330314,
					"content": "只可惜目前也没有其他信息了，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330315,
					"content": "这样好了，我先回去和珊瑚社长报告一下现在的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330316,
					"content": "珊瑚社长一定能想到些什么我们没想到的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330317,
					"content": "嗯！你说话很有道理，所以听你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330318,
					"content": "那就这么说定了。老样子，到时候我们老地方见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330319,
					"content": "万一我被什么事情缠住脱不开身，你们直接找珊瑚社长就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330310,
					"content": "（龙二已经很了解派蒙了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
