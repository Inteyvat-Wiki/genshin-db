				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "是你们啊。来得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330102,
					"content": "我刚刚考察完几处可疑的地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330103,
					"content": "其中有一处营地是由那个帽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330104,
					"content": "咳咳，是由那个「黑影」看守的。如果没有什么别的问题的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330105,
					"content": "昨天说的「调查」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "那个的话，我现在还什么都不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330107,
					"content": "咦？不是珊瑚让你去调查的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330108,
					"content": "没错，但是…该怎么说呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330109,
					"content": "比如说，「熟透了的堇瓜」和「门帘上的泥手印」，对我而言，是毫无关联的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330110,
					"content": "但在珊瑚社长的脑海中就能成为解开「寄木细工」的关键。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330111,
					"content": "「熟透了的堇瓜」和「门帘上的泥手印」…它们之间有什么关系呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330112,
					"content": "只是打个比方。我依照她的指示，在八酝岛和镇守之森调查了一些地点，将我的见闻报告给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330113,
					"content": "而她能从我报告的现象中得到什么结论，就只有她自己知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330114,
					"content": "只有鹿野院先生能和她的思维并驾齐驱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330115,
					"content": "鹿野院？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "天领奉行的人。之前查案的时候，有幸和他见过面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330117,
					"content": "是个…气质独特的人。如果见到了，你一定能一眼认出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330118,
					"content": "总之，小动物就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400330119,
					"content": "我还是好在意「熟透了的堇瓜」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
