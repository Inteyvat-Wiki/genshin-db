			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪卢克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3770201,
					"content": "你们来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3770202,
					"content": "#咦？你不是…{NICKNAME}吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770203,
					"content": "你不是…琴吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "首先，我联系的不止一人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770206,
					"content": "其次，这一位只是「琴」，不是作为「团长」的琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770207,
					"content": "这可是身为荣誉骑士的你，也没可能接触到的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770208,
					"content": "真是意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770209,
					"content": "虽然听说了天空之琴的事，但没想到居然是你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770210,
					"content": "那么，琴声的净化能让风魔龙恢复正常…这也是真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770211,
					"content": "#没错！现在{NICKNAME}正为了解决风魔龙事件，积极投身在最前线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3770212,
					"content": "#实在不愧于骑士团超新星{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3770213,
					"content": "虽然感觉上已经越过了违法的边缘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3770214,
					"content": "哼。这种牵扯上神话的荒诞解释，无法相信也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770215,
					"content": "但没关系。我们可以让诗人再上演一次那种歌谣，来说服…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770216,
					"content": "我相信你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770217,
					"content": "来说服固执的团长大…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770218,
					"content": "四风守护中的东风之龙，特瓦林，我一直想象不到它背叛的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770219,
					"content": "但如果是在多年前守护蒙德的战争中，受到了毒血的侵害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770220,
					"content": "苏醒后又被深渊法师腐蚀，那确实是会变得身不由己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770221,
					"content": "——但这些话，「代理团长」是绝对不能说出口的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770222,
					"content": "迫于「愚人众」的外交压力，骑士团很难公开表示对风魔龙的善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770223,
					"content": "那会被理解为纵容和不作为，所以我才只能私下行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770224,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770225,
					"content": "这也是我不喜欢骑士团的原因之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770226,
					"content": "不过我倒是没料到，你就这样相信了来历不明的异乡人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770227,
					"content": "#<color=#00E1FFFF>前辈</color>这样严厉又谨慎的人，不也愿意去相信{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770228,
					"content": "都说别叫我前辈…也罢，这回就难得地合作一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770229,
					"content": "前辈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770232,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770233,
					"content": "看来是有一些不该追问的过往呐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3770234,
					"content": "总之天空之琴的真正下落，我已经大致心里有数了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770235,
					"content": "（漂亮！看不出来她还有转移话题的天赋…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3770236,
					"content": "蒙德城与至冬国的冲突，本质上是七国与七神的冲突。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770237,
					"content": "冰之神统率的「愚人众」，正觊觎着风神留下的神力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770238,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3770239,
					"content": "所以他们会提出接管城防？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770242,
					"content": "如果公然杀死风龙的企图被骑士团阻止，那么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770243,
					"content": "天空之琴，就是他们唯一能得到的风神之力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770244,
					"content": "蒙德城里落单的「愚人众」成员，要多少就有多少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770245,
					"content": "我已经从他们嘴里撬了些情报出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770246,
					"content": "迪卢克得到的信息是，愚人众没有把天空之琴放在歌德大酒店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770247,
					"content": "即使是他们也不想太过嚣张、把偷来的圣物收藏在半公开的驻地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3770248,
					"content": "我懂我懂。事情闹太大的话，就会变成严重的外交危机呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3770249,
					"content": "呵…七国的关系就是这么回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770250,
					"content": "异乡人，做好出发的准备了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3770240,
					"content": "所以他们想要杀死特瓦林？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "（假装没听到那个词。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "为什么团长会在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
