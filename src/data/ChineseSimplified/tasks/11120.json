					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "凯瑟琳，我们来啦，有新委托吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200102,
					"content": "是的，有份新工作，我认为你们可以胜任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 111200103,
					"content": "老戴是璃月港辉山厅的工头之一，他希望冒险家协会能派几个人手给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 111200104,
					"content": "具体是要做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200105,
					"content": "听说是要找几个工人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 111200106,
					"content": "找人？太好了，是我们擅长的工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200107,
					"content": "是啊，旅行者的能力毋庸置疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 111200108,
					"content": "具体委托内容可以见面详谈。如果你们愿意接下这份工作，就到码头附近找老戴聊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112002",
							"2"
						],
						"stepId": 1112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "喂——你是老戴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200202,
					"content": "噢，找我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200203,
					"content": "嗯？等等，你们就是协会派来的冒险家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200204,
					"content": "哇，看得出来吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200205,
					"content": "看你们这副打扮和神情，应该是老手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200206,
					"content": "没错没错，你眼光真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200207,
					"content": "哈哈哈，干咱们这行，少不了鉴定的活儿。看石头也是看，看人也是看。一般人什么底细，老戴我一眼就瞧出来喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200208,
					"content": "二位稍等，我找的帮手还在路上，一会儿就到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200209,
					"content": "等一下等一下，你不是已经找了我们吗？不会还有其他人要来瓜分工钱吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200210,
					"content": "唉！实不相瞒，这次的事有些棘手。光是冒险家恐怕不够，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200211,
					"content": "果然还有其他人，哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200212,
					"content": "大叔，你是不是小看我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200213,
					"content": "派蒙，别这么说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "你们有所不知，这次的事发生在矿区，而且有些离奇。矿区向来多事故，以防万一，我才找了懂行的高手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200216,
					"content": "冒险家的主业总不会是矿石鉴定、地质分析之类的吧？身边带个行家，凡事也好照应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200217,
					"content": "再说，我找的这位可是顶尖高手，无论什么石头，他只要看上一眼，就能说个八九不离十！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200218,
					"content": "要我说啊，世上最懂石头的人，就得是他！遇见这等行家，还不赶紧请来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200219,
					"content": "不对不对，世上最懂石头的人怎么会被你找到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200220,
					"content": "怎么不会啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200221,
					"content": "当然不会了，因为世上最懂石头的人，是我们的朋友才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200222,
					"content": "该不会，你说的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "（刚好，我也有些事想问他。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "哼哼，天外有天，人外有人！你在这里等着，我们马上就带他过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200214,
					"content": "派蒙，开始争强好胜了呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
