			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "上一回说到啊，岩王帝君…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 111200302,
					"content": "找到你啦，钟离！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200303,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200304,
					"content": "你们兴致不错，也来这里听人说书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200305,
					"content": "不不，我们是来找你的，你现在有空吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200306,
					"content": "时间倒是有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200307,
					"content": "我们接到一份委托…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "这份工作需要了解地质与矿石的人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200310,
					"content": "地质与矿石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200311,
					"content": "放眼整片大陆，难道会有比你更懂这些的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200312,
					"content": "那个委托人自称找到了天下最懂石头的行家。我想向他证明，你才是提瓦特大陆上最了解这些的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200313,
					"content": "这无缘无故的攀比之心，是从何而来啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200314,
					"content": "不是攀比啦，是老戴不懂行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200315,
					"content": "我就是…想让他见识见识嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200316,
					"content": "哈哈，既然如此，我便随你们走一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200317,
					"content": "真的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200318,
					"content": "话说在前头，我虽有些见识，倒也未必是天下最精于此道的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200319,
					"content": "学海无涯，长些见识总是好事。一来，我在你们也可以放心，二来，若真有专家，也好让我切磋学习一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200320,
					"content": "唔…我觉得钟离可以不用这么谦虚的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200321,
					"content": "既然钟离答应了，那我们走吧，回去找老戴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200308,
					"content": "有一件特别的工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112004",
							"2"
						],
						"stepId": 1112004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "老戴，我们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200402,
					"content": "噢！这位就是你们的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200403,
					"content": "正是！我认为，这位先生才是天下最懂矿石与地质的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200404,
					"content": "过奖。略有心得罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200405,
					"content": "嗨，你要这么说，我找的那位也绝对不输他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200406,
					"content": "我说不清，一会儿等他来了，你们自己感受吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200407,
					"content": "呃…是这儿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200408,
					"content": "哎呀来得正好！给各位介绍一下，这是我找的帮手，昆钧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200409,
					"content": "小昆啊，这两位都是我找的冒险家，呃，至于这位先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200410,
					"content": "嗯…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200412,
					"content": "他叫钟离，是往生堂的客卿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "往生堂客卿钟离先生…我也有所耳闻，听说你学富五车，才高八斗。没想到，今天能见到本人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200414,
					"content": "嗯？有些眼熟…唔，难道是在往生堂见过吗？但我也没去过往生堂啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200415,
					"content": "老戴，你不试试吗？看他们谁才是真正的行家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200416,
					"content": "原来要当场比试啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "啊？这…我、我也不知从何比起啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200418,
					"content": "那你们自己想办法比试一下，要是钟离赢了，就请他帮忙，要是钟离…不对，他怎么会输呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200419,
					"content": "比试？好啊好啊，我愿意奉陪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200420,
					"content": "这位先生很有兴致嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200421,
					"content": "啊哈哈，我一见你的脸就觉得你肯定懂行。不过跟我比起来孰高孰低，还不好说呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200422,
					"content": "这个人口气好大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200423,
					"content": "实话实说而已，哈哈哈…再说，我也只会这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200424,
					"content": "昆兄可是鉴定师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200425,
					"content": "不，其实…其实我也忘了我来璃月港干嘛…有天站在路边，突然被老戴叫住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200426,
					"content": "老戴见我拿着石头，问了我几句，跟着便激动万分地约我来此地碰面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200427,
					"content": "哈？这也能忘记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200428,
					"content": "我来璃月港路上，遇见这人站在路边捯饬石头，嘴里还念念有词，好像对那些石头熟得不得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200429,
					"content": "出于好奇我就问了几句，谁知，他比我这个矿工头子还懂！反正他也无所事事，不如来帮我的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200430,
					"content": "这家伙，记性不好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200431,
					"content": "也不能说是记性不好…不过，只是石头的话，我一定能帮上忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200432,
					"content": "钟离先生，你觉得这块石头如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200433,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200434,
					"content": "这块石头表壳光滑，表面的裂痕是由火山喷发所致。如果我没猜错，这是出自别国的石胚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200435,
					"content": "哦~哦！眼光真不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200436,
					"content": "它不是普通的石胚。壳薄，线黑…我猜，其中包着上好的水晶矿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200437,
					"content": "一点不错，这块石头出自火山周边，我一边闲逛，一边在集市买了这个。卖家当它是边角料，却不知其中奥妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200438,
					"content": "水晶矿不是哪里都有吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "光是成色纯净质地高级，还不足以称为珍宝。更高一等的罕见水晶，有些包着水胆，有些则藏着金沙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200441,
					"content": "这层石壳下藏着的水晶，在其形成瞬间包裹住了一团水。水藏于底，犹如山中满月，映天而动，可谓是相当稀有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200442,
					"content": "这么详细，简直像是他亲眼看到的一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200443,
					"content": "不会是糊弄我们的吧？毕竟，你这块石头还没开呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200444,
					"content": "不，他说的都是实话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200445,
					"content": "水晶大多诞生于高温环境，高温与流水不兼容，水胆水晶因而珍贵。这块晶体内藏着的却是高山湖泊水，更为罕见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200446,
					"content": "连钟离都这么说…那应该是真的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111200447,
					"content": "钟离先生这种眼力，我还是第一次见！石壳下的模样，你是怎么知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200448,
					"content": "见得多了，自然有心得。小小卖弄，还请昆兄不要介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111200449,
					"content": "不不，怎么会呢！我觉得我俩很是投缘，我是真心想要结交你这个朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200450,
					"content": "老戴，带上钟离先生一起吧！信我没错，他绝对是个眼力过人的行家。这样的人，你一辈子也遇不到几个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111200451,
					"content": "也好，多一个人，多一份力量。各位，请跟我到层岩巨渊矿区走走，这次走丢的兄弟，还要靠你们找回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老戴"
				},
				{
					"id": 111200439,
					"content": "为什么这块就是上好的呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
			"id": 1112022,
			"completionStepIds": [],
