					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310301,
					"content": "嘿嘿，那我们就不客气地收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200310302,
					"content": "尽管收下，这是冒险家协会表示感谢的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310303,
					"content": "因为每天协会都会收到很多委托，如果不是各位冒险家鼎力相助，是肯定没办法完成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310304,
					"content": "当你每天完成足够数量的委托，就可以到我这里领取一份额外的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310305,
					"content": "「冒险之证」里会记录今天已经完成过的数量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310306,
					"content": "一定记得要当天过来领取礼物，因为数量有限，错过了是没办法补发的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310307,
					"content": "明白了，谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "不用客气，是应该谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310312,
					"content": "对了，如果你帮助你的冒险伙伴完成委托，同样会计算在领取礼物的数量之内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310313,
					"content": "也请多多与你的伙伴相互合作吧！向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310309,
					"content": "一天只有一份吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "现在的话是这样的…很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310311,
					"content": "不过也请放心，关于冒险家们的报酬，我们一直都在和总部争取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
