			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#完成得很好，{NICKNAME}，作为第一次来说相当出色了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310202,
					"content": "委托人都让我帮忙感谢你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310203,
					"content": "那么现在该我履行之前的约定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
