			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "我们又见面了，冒险家新星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310102,
					"content": "怎么样，最近的冒险还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310103,
					"content": "很顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "很不错的气势，记得一直保持下去哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310107,
					"content": "看起来你已经积累了很多的阅历，是时候介绍给你冒险家协会的重要工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310108,
					"content": "冒险家协会每天都会收到来自各处的<color=#00E1FFFF>委托</color>，并负责整理发放给各位冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310109,
					"content": "这也是冒险家们最主要的报酬来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310110,
					"content": "都是什么样的委托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200310111,
					"content": "什么类型都可能有，从帮助居民到清理怪物，有琐碎的也有很危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310112,
					"content": "俗话说百闻不如一见，还是亲自上手做一做更容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310113,
					"content": "这里就是今天的委托内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310114,
					"content": "麻烦完成之后来向我报告一下，我会提供一份丰厚的奖励的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310115,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#不愧是{NICKNAME}，很可靠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310119,
					"content": "#那我就在这里等你的好消息，{NICKNAME}，向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310117,
					"content": "有多丰厚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "别那么心急，保留一下期待吧，不会让你失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310105,
					"content": "有点吃力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "刚开始是会这样的，在冒险前做好准备会让你轻松不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
