			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#我听说了哦，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310402,
					"content": "你已经完成了冒险家协会承接的<color=#00E1FFFF>委托</color>，委托人都让我向你道谢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310403,
					"content": "委托？没什么印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310404,
					"content": "就是你在路上遇到的需要你帮忙的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310405,
					"content": "他们其实都是在协会发布了委托的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310408,
					"content": "总之，还是和你简单介绍下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310409,
					"content": "冒险家协会每天都会收到来自各处的委托，并负责整理发放给各位冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310410,
					"content": "这也是冒险家们最主要的报酬来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310411,
					"content": "说到报酬，就不得不提到协会为你准备的一个惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310406,
					"content": "路上正好看到就帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310407,
					"content": "不愧是我们的冒险者新星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 2003105,
