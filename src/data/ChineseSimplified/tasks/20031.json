			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "嘿嘿，那我们就不客气地收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200310502,
					"content": "尽管收下，这是冒险家协会表示感谢的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310503,
					"content": "因为每天协会都会收到很多委托，如果不是各位冒险家鼎力相助，是肯定没办法完成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310504,
					"content": "当你每天完成足够数量的委托，就可以到我这里领取一份额外的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310505,
					"content": "「冒险之证」里会记录今天已经完成过的数量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310506,
					"content": "一定记得要当天过来领取礼物，因为数量有限，错过了是没办法补发的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310507,
					"content": "明白了，谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "不用客气，是应该谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310512,
					"content": "对了，如果你帮助你的冒险伙伴完成委托，同样会计算在领取礼物的数量之内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310513,
					"content": "也请多多与你的伙伴相互合作吧！向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310509,
					"content": "一天只有一份吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "现在的话是这样的…很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200310511,
					"content": "不过也请放心，关于冒险家们的报酬，我们一直都在和总部争取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
