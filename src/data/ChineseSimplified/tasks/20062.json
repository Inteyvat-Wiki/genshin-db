			},
			"dialogs": [
				{
					"id": 200620501,
					"content": "到底怎么训练才好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620502,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "哦，我正在为了骑士选拔做训练呢。但是怎么样都不得要领，而且也没人指导我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620504,
					"content": "我爸一个劲说他是冒险家，他可以指导我，但是我才不信呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620505,
					"content": "他那样子，怎么可能指导我通过骑士选拔啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620506,
					"content": "他还说要帮我准备训练用的东西，他到底会准备什么呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
		},
