			},
			"dialogs": [
				{
					"id": 200620201,
					"content": "你找到木桩了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620202,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "唔…哈哈，你看，看着确实质量不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620204,
					"content": "这木桩能经得起丘丘人折腾，肯定也能经得起艾琳折腾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620205,
					"content": "谢谢你，哦对了，按照冒险家的规矩，这是你的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫尔曼"
				}
			]
		},
