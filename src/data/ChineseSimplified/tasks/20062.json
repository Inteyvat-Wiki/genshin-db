			"dialogs": [
				{
					"id": 200620601,
					"content": "这个木桩可真不错，这下子我训练起来可方便了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620602
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620602,
					"content": "不过，这么结实的木桩，老爸到底是从哪弄来的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620603
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200620603,
