						200620402
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620402,
					"content": "还没找到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "艾琳正在努力训练，我能为她做的也就这些了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620404,
					"content": "如果我还是个冒险家，就能自己去拿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620405,
					"content": "而且就蒙德城冒险家协会的现状…我的那些前「同伴」们，大部分也都不干冒险家这行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620406,
					"content": "这也没办法，蒙德城里的西风骑士团这么强势，年轻人都想去做西风骑士，至于在野外摸爬滚打的冒险家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620407,
					"content": "早就没多少人愿意做咯——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫尔曼"
				}
			]
		},
