					"赫尔曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "到底怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "是这样的…我女儿艾琳想要进入西风骑士团，正在为骑士选拔做准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620104,
					"content": "唉…我本来想要自己指导她，但是她怎么样也不相信我之前是个冒险家，坚持自己训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620105,
					"content": "我也没办法证明给她看…有了老婆孩子之后，我已经没有到处肆意冒险的资本了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620106,
					"content": "比起满足自己的冒险欲望和自尊心，好好照顾家庭才是我现在最重要的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620107,
					"content": "哈哈，不过我这个「冒险家」，终归还是能做点事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620108,
					"content": "我之前到处冒险的时候，留意过那些丘丘人用来训练的木桩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620109,
					"content": "那些木桩看着质量很不错，肯定很适合艾琳用来训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620110,
					"content": "帮我去找几个丘丘人训练木桩回来吧。按照冒险家的规矩，我也不会让你干白工的，你觉得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620111,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "哦，我就喜欢爽快的人，你很有我当年刚入行时的风采…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620114,
					"content": "开玩笑，开玩笑，好了，快点去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620112,
					"content": "只是丘丘人，你自己也可以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "不，不行不行，冒险家的能力也是有极限的。一位冒险家，同时只能应付一场冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620116,
					"content": "而「婚后生活」这场冒险…无论是多伟大的冒险家，都必须要全身心投入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "赫尔曼"
				},
				{
					"id": 200620117,
					"content": "所以，搜集木桩就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赫尔曼"
				}
			]
		},
