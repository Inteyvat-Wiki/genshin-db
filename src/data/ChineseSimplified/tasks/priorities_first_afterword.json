			"dialogs": [
				{
					"id": 760580101,
					"content": "我还从来没见过这么白的盗宝鼬呢，它不会是生病了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 760580102,
					"content": "看它活蹦乱跳的，刚才还想从尤尔瓦哥哥那儿抢吃的，哪里像生病的样子呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "米科"
				},
				{
					"id": 760580103,
					"content": "可能是很稀罕的品种？莉奈娅说不定知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "尤尔瓦"
				},
				{
					"id": 760580104,
					"content": "哇！是把我的小金库洗劫一空的摩拉小偷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760580105,
					"content": "盗宝鼬试图逃跑，但被三个孩子眼疾手快按了下来，挣扎了一会儿就放弃了，趁这时间向孩子们讲述了此前的遭遇…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "原来是惯犯，那得让它吃点教训才行，犯了错就得受惩罚，这样才对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "米科"
				},
				{
					"id": 760580107,
					"content": "可是…可是它只是个小动物，它又不懂这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 760580108,
					"content": "只要把派蒙的摩拉还回来就行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "不管怎么说，先把它身上带的摩拉还给派蒙吧，它也没处花这些摩拉，所以全都在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "尤尔瓦"
				},
				{
					"id": 760580111,
					"content": "太好啦！嘿嘿，这下我的小金库又充实起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760580112,
					"content": "如果能把它养起来就好了，那样的话，等赫卡回来了也可以让她看看稀罕的盗宝鼬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 760580113,
					"content": "欸？可是它都不会工作…偷东西可不算工作，不工作，凭什么白吃白喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "米科"
				},
				{
					"id": 760580114,
					"content": "好啦好啦，该拿它怎么办…我们之后和卡嘉商量一下再定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尤尔瓦"
				},
				{
					"id": 760580109,
					"content": "小动物也该知道知道世界的残酷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
