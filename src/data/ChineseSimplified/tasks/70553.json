					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530301,
					"content": "大团长，请收下你的特调！这回肯定能喝个尽兴了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530302
					]
				},
				{
					"id": 705530302,
					"content": "怎么搞的，这股气势…滚滚涌来的火水气味，好像要把空气点燃…这才对嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530303
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530304
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530304,
					"content": "痛快！我感受到了…你放下拘谨后，拿出了惊艳的实力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530305
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530305,
					"content": "入口瞬间，薄荷发动清凉的佯攻，暂时掩盖火水的行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530306
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530306,
					"content": "等到那股甜味消散，火水已经滑下喉咙，强劲的酒精味瞬间在口腔中爆发开来，正是我想要的冲击感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530307,
						705530308
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530307,
					"content": "然后再用酸奶油兜底…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530309
					]
				},
				{
					"id": 705530309,
					"content": "这一点尤为精妙！火水的尾段太过平淡，甚至是纯净无味，一直被人诟病，而酸奶油恰好将口感维持在热烈的峰值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530310,
						705530311
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530310,
					"content": "哎呀，给我夸得不好意思了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530312
					]
				},
				{
					"id": 705530312,
					"content": "很难想象，这居然是一位…不喝火水的酒保调制出来的绝品。我觉得它有成为蒙德与挪德卡莱双重名酒的实力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530313,
						705530314,
						705530315
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530313,
					"content": "「北风骑士」象征着狼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530316,
					"content": "「狼与铁」…好啊！够文雅，又狂放，还真是只有你能想出来的酒名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530317
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530317,
					"content": "我看啊，以后这骑士团的饮品小站，不如直接冠上你的称号，就叫「荣誉骑士特调屋」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530318
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530318,
					"content": "事不宜迟，我这就和赫塔的弟子聊聊看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530314,
					"content": "骑士团坚强如铁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530315,
					"content": "这杯就叫「狼与铁」如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530316
					]
				},
				{
					"id": 705530311,
					"content": "都是和大团长聊出来的灵感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530312
					]
				},
				{
					"id": 705530308,
					"content": "尾调也不会太过单薄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530309
					]
				}
			]
		}
	]
}