			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法尔伽"
				],
				"points": [
					{
						"sceneId": 51208,
						"position": [
							2200.306,
							230.219,
							-779.82
						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530101,
					"content": "哟！我们的荣誉骑士也被赫塔「逮捕」，来帮忙干活了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530102
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530102,
					"content": "之前聊到饮料摊位的时候，我看着酒单，就有些按捺不住了，现在正好验收一下成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530103
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530103,
					"content": "虽然不久前才在广场上喝过两杯，但…酒这种好东西，在不伤身的范围内，多多益善！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530104
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530104,
					"content": "既然事情已经告一段落，接下来，就是轻松享受的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530105,
						705530106
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530105,
					"content": "是平等雇佣关系哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				},
				{
					"id": 705530107,
					"content": "那可不得了，我必须好好尝尝你的手艺！给我来杯适合慢慢闲聊，但又足够有劲的酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530108,
						705530109
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530108,
					"content": "这指标还真像在开玩笑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530110,
					"content": "当然不冲突！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530111
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530111,
					"content": "「足够烈」，就意味着不能一口喝完；「要闲聊」的话就不能太辣嗓子，尾段最好偏甜，正巧卡在那个平衡点上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530112
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530112,
					"content": "酒单里目前最合适的选择，就是「带刺镜湖」了。几乎每个酒吧都会出售这款烈性特调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530113
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530113,
					"content": "当然，知道了配方还不够，调制的过程才是重点…有的酒保选择坚持经典，有的则会适当加入自己的理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530114,
						705530115
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530114,
					"content": "那我就来试试！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530116,
					"content": "气势不错！那就大展身手吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530115,
					"content": "知道配方就能开工了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530109,
					"content": "大团长这是正经考验吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530106,
					"content": "我好歹也是天才酒保！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				}
			]
		},
		{
			"id": 7055302,
			"completionStepIds": [
				7055306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
