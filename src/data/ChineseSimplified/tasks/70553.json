						"rawParams": [
							"7055306",
							"2"
						],
						"stepId": 7055306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法尔伽"
				],
				"points": [
					{
						"sceneId": 51208,
						"position": [
							2200.306,
							230.219,
							-779.82
						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530201,
					"content": "大团长，请检验这杯「带刺镜湖」的成色！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530202
					]
				},
				{
					"id": 705530202,
					"content": "嗯，色彩和香气到位了，酒体的火候嘛…入口便知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530203
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530203,
					"content": "不错，每种成分的用量都相当准确，可惜，还是显得太有「礼貌」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530204,
						705530205
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530204,
					"content": "礼貌？酒要怎么礼貌？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				},
				{
					"id": 705530206,
					"content": "当然是谦逊的礼貌！你选择了严格按照配方，甚至更保守的比例来调和这杯「带刺镜湖」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530207
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530207,
					"content": "好像在担心…只要这杯酒的口味有那么一丁点偏差，就会让我失望？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530208,
						705530209
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530208,
					"content": "确实是这样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530210,
					"content": "喂，我们并肩作战了这么久，搞定了神明都觉得棘手的大麻烦，称得上过命的交情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530211
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530211,
					"content": "大可以放开点，施展你天才酒保的鬼点子，给我来杯惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530212,
						705530213
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530212,
					"content": "那我就好好改进一番。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530214,
					"content": "慢慢来，不着急！边聊边想，看看你能把什么样的灵感搅拌到酒杯里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530215
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530215,
					"content": "除了「礼貌」，这杯「带刺镜湖」还有别的问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530216
					]
				},
				{
					"id": 705530216,
					"content": "我想想…大概还有一点是：缺少「冲击力」。在配方相同的情况下，混合各种成分的手法，也会对口感造成影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530217
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530217,
					"content": "有时，在酒体之间刻意营造出分层感，反而能强调两种酒体分别拍击味蕾时的「浪涛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530218
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530218,
					"content": "这方面，你也采用了非常柔和的手法，要不试试再放开点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530219,
						705530220
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530219,
					"content": "好像…明白了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530221,
					"content": "哈哈哈哈，果然一点即通，不用多说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530222
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530222,
					"content": "这个巨大的酒杯是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530223
					]
				},
				{
					"id": 705530223,
					"content": "看起来挺不错吧？像个锤头，能装酒，还能用来敲钉子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530224
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530224,
					"content": "这是霍夫曼拿主意，查尔斯设计，瓦格纳帮忙铸造，还有十来个骑士每人出一份心意钱，共同给我准备的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530225
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530225,
					"content": "他们早就等着和我痛痛快快喝一场了，这个酒杯就是我和他们公平对决的重要「武器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530226,
						705530227
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530226,
					"content": "…公平？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530228,
					"content": "我是大团长，酒龄比他们大一点，练得比他们多一点，身板也比他们壮一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530229
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530229,
					"content": "所以我每杯多喝点，对部下们才公平，很有道理吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530230,
						705530231
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530230,
					"content": "这一杯可不止一点点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530232,
					"content": "当然，也有酒龄和我差不多的老伙计，我就不照顾他们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530233
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530233,
					"content": "比如「果榛03」和「果榛05」，当年和我一起给了伊洛克两顿迎头痛击的好手，现在我让他们帮琴分摊杂务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530234
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530234,
					"content": "今天的下班酒会，他们硬是要和我喝个尽兴，结果输掉了飞镖游戏，不省人事了，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530235
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530235,
					"content": "我已经告诉琴了，明天无论如何都不给他们批假！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530236
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530236,
					"content": "在花园和酒馆里喝酒的感觉不一样吧？考虑到环境，也许可以加些植物香气的元素？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530237
					]
				},
				{
					"id": 705530237,
					"content": "嚯，你倒是挺有格调！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530238
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530238,
					"content": "说到这花园，我就想起许多年前的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530239
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530239,
					"content": "我年轻时，总喜欢去找遗迹守卫练拳练剑…有次，我不小心放跑了它们的飞弹，流弹炸坏了城墙上的一座哨塔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530240
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530240,
					"content": "结果我被罚绕城长跑五十圈，修好哨塔后，再到这座花园，帮忙砌好碎块打坏的砖墙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530241,
						705530242
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530241,
					"content": "听起来闹得还挺大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530243,
					"content": "确实是年轻犯下的错误当中，记忆比较深的一次…因为那天，克利普斯看见了灰头土脸的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530244
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530244,
					"content": "他带来了两瓶百年陈酿，让迪卢克…比现在的米卡看起来还年轻的迪卢克…支开了看守我的费鲁，方法很机灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530245
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530245,
					"content": "那天真热啊…我都快被晒晕了…一时兴起摘了几片薄荷叶，塞进酒瓶…结果味道好得出奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530246
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530246,
					"content": "克利普斯照样子试过后，也连连夸赞，后来还把我灵机一动的产物写进了正式配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530247
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530247,
					"content": "酒客们的反响都很不错呢！过了好几个夏天，克利普斯还在不停写信，说要给我分成…那我能要吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530248,
						705530249
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530248,
					"content": "听起来太久远了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530250,
					"content": "是啊，克利普斯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530251
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530251,
					"content": "…费鲁都退休好几年了吧，每次见面，还对我板着个脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530252
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530252,
					"content": "啊哈，那个老顽固…顶替他的迪卢克，还有后来的凯亚干得无可挑剔，新时代永远属于年轻人，他早该认输了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530253
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530253,
					"content": "下次找个机会，让凯亚带着他，见识下骑兵小队惊人的发展好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530254
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530254,
					"content": "话说回来，这座花园也成了举办活动的热门场所了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530255
					]
				},
				{
					"id": 705530255,
					"content": "哈哈，这花园可是骑士团打理了好多年的宝地，用来办活动，当然是最合适的选择！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530256
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530256,
					"content": "我听说了，远征队在外的这段时间，多亏有你帮忙操持，大家有了许多释放活力的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530257
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530257,
					"content": "有时候，我也会找找各种活动拍下的画片，可惜，不是每个人都入镜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530258
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530258,
					"content": "结论是，蒙德应该提升留影机的普及率！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530259
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530259,
					"content": "如果大团长没去远征，这些活动会办成什么样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530260
					]
				},
				{
					"id": 705530260,
					"content": "我来管活动？那大概…每次的主题都要包含美酒，或者在活动里加入一次酒会？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530261
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530261,
					"content": "比如，把这次的饮品小站做大，面向全城人开放，每个小队都派出一名甚至几名调饮代表，来好好比试一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530262,
						705530263
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530262,
					"content": "果然变成了这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530264,
					"content": "哈哈哈，也只能想想罢了！肯定不能闹得太过火…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530265
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530265,
					"content": "要是敢大张旗鼓办酒会，琴一定会提着剑找上门来…不，芙蕾德莉卡也会加入对我的讨伐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530266
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530266,
					"content": "哪怕在挪德卡莱，我们也有个规矩，执勤期间的队员绝不能喝醉。否则，有可能酿成玩忽职守的恶果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530267,
						705530268
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530267,
					"content": "我觉得这样很对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530269,
					"content": "嗯，随着远征的成员回归各个小队，希望这个规矩也能慢慢融入本土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530270
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530270,
					"content": "就像火水，还有酸奶油这种挪德卡莱的风味食材，走进了蒙德的家庭，成为了生活习惯的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530271
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530271,
					"content": "年轻人们也要懂得自然而然地克制啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530272,
						705530273
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530272,
					"content": "没想到大团长也有这样一面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530274,
					"content": "说到底，酒量不够好，就不要打肿脸充胖子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530275
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530275,
					"content": "水平不到我的三成，就别谈什么在工作日「享受微醺」了，多半要喝高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530276
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530276,
					"content": "周末跟着我慢慢练吧，哈哈哈，把他们灌个横七竖八，保证一周都不想碰酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530277
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530277,
					"content": "好像感动得有点早…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530278
					]
				},
				{
					"id": 705530278,
					"content": "好消息，我找到方向了，借你的酒杯一用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530279
					]
				},
				{
					"id": 705530279,
					"content": "哦？那就拿去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530280
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530280,
					"content": "这架势不一般啊，我有种撞上头彩的预感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 705530273,
					"content": "这就是酒豪的张弛有度吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530268,
					"content": "爱好不能影响正事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530263,
					"content": "还真是你的风格！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530249,
					"content": "是我来蒙德很久前的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530242,
					"content": "团长也有这么狼狈的时候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530231,
					"content": "你考虑公平的对象是不是反了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530227,
					"content": "…对决？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530220,
					"content": "之前没注意到这个细节…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530213,
					"content": "有你这话，我就要大开大合了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530209,
					"content": "可不能给行家乱调。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530205,
					"content": "难道是谐音笑话…狸猫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				}
			]
		},
		{
