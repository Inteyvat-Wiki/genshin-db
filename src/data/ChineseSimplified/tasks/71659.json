		},
		{
			"id": 7165903,
			"completionStepIds": [
				7165903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165903",
							"2"
						],
						"stepId": 7165903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莺儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590301,
					"content": "你们终于想起我啦？还带来了一位朋友…是特意来陪我的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590302
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590302,
					"content": "呜，我有点不好意思了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590303,
					"content": "其实…莺儿小姐，我们是来拜访「丹剂宗匠」的，请问你认识这位大师吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590304,
					"content": "啊呀，原来还是另有所图吗？我有一点失望哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590305
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590305,
					"content": "不过，你们居然在打听我的秘密，还挺让我惊喜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590306,
						716590307
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590306,
					"content": "秘密？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				},
				{
					"id": 716590308,
					"content": "等等！难道说，莺儿小姐就是「丹剂宗匠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590309,
					"content": "越来越聪明啦，真招人喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590310
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590310,
					"content": "完全没想到会是这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590311,
					"content": "「丹剂宗匠」竟然如此年轻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590312
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590312,
					"content": "和阿贝多老师给人的感觉截然不同，但也有一股深不可测的气息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590313
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590313,
					"content": "看你们急切的神情，似乎遇上了难题呢，不妨和我直说吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590314
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590314,
					"content": "不知为什么，总觉得事情要朝着无法预料的方向发展了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590315,
					"content": "和蒂玛乌斯一起向莺儿解释了「烟霰丹剂」的研究课题。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590316
					]
				},
				{
					"id": 716590316,
					"content": "原来如此，这位炼金术士正在研究奇妙的「烟霰丹剂」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590317
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590317,
					"content": "可惜啊，要让你们失望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590318
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590318,
					"content": "你们正在调查的「烟霰丹剂」只不过是我特制的一种古法香膏而已，和炼金术完全无关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590319
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590319,
					"content": "香膏？那不是一种固体香料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590320
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590320,
					"content": "「烟霰丹剂」这个名字听起来明明很厉害啊！书里也写着它能让人们变强…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590321,
					"content": "呵呵，大概是我的古法香膏太受欢迎的缘故吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590322
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590322,
					"content": "古代的文人曾强调「熏陶」一词。长期沉浸在香膏的芬芳中，人们的气质和心性也会受到影响哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590323
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590323,
					"content": "使用了我的古法香膏之后，人们的气质大变，魅力大增，待人接物的信心大涨，人际关系也不断改善。事业步步高升，生活顺心顺意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590324
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590324,
					"content": "就像是使用了仙人的丹药一样，运势明显好转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590325
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590325,
					"content": "因此，人们给我的古法香膏起了个富有诗意的称号，还写下了简单易懂的诗词，夸赞它们的功效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590326
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590326,
					"content": "原来是这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590327,
					"content": "不可能啊…难不成，我在那本书里读到的论文并不准确？或者说，我对诗词的理解出现了偏差？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590328
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590328,
					"content": "比如「丹香悠邈焕仪质」。这一段的含义应该是：「烟霰丹剂」能激发出人的威仪和潜质…没错吧，莺儿小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590329
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590329,
					"content": "啊呀，「仪质」其实是一个完整的词，意为人的风度和气质。这句诗词其实是在说，古法香膏令人拥有了焕然一新的容姿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590330
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590330,
					"content": "也不能怪你，诗词也是一门深奥的学问，可不能像分析数据那样，拆开成零散的文字来解读，而是要注意整体的意境哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590331
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590331,
					"content": "逐字逐句拆解的分析方法居然不管用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590332
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590332,
					"content": "可是那本书还提到了不少「烟霰丹剂」发挥神奇功效的例子，让我看得目瞪口呆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590333
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590333,
					"content": "刺激而神秘的事物总是令人神往的嘛，就像透过窗纸的婀娜身影。记录坊间传闻的书籍，也需要适当的艺术加工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590334
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590334,
					"content": "多谢那位作者的夸赞啦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590335
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590335,
					"content": "怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590336
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590336,
					"content": "也就是说，蒂玛乌斯的参考资料夸大了香膏的效果，他也错误地理解了诗词。导致他误以为「烟霰丹剂」是强大的炼金术药剂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590337,
						716590338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590337,
					"content": "还好有心理准备。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590339,
					"content": "到头来，我的研究课题完全建立在错误的理论上啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590340
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590340,
					"content": "这次研究失败了，我又做了无用功…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590341
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590341,
					"content": "欸呀，也不必丧气嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590342
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590342,
					"content": "有道是「峰回路转见蹊径，枯树新芽亦成荫」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590343
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590343,
					"content": "或许炼制香膏的古法能给你一些启示，让你突破最后的瓶颈，制作出理想中的药剂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590344
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590344,
					"content": "的确，虽然出发点不太靠谱，但蒂玛乌斯凭借自己的理解，也取得了一定的进展呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590345,
					"content": "既然莺儿小姐都这样提议了，不如就试一试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590346,
					"content": "也许能收获意外之喜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590347
					]
				},
				{
					"id": 716590347,
					"content": "说得在理…炼金术是一门深奥的学问，我也不是第一次失败了，必须打起精神来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590348
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590348,
					"content": "大多时候，我还是能准确解读资料的，这次是意外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590349
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590349,
					"content": "就算无法做出传说中的奇妙药剂，改进现有的炼金药剂，也算是不错的成就！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590350
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590350,
					"content": "莺儿小姐，旅行者，我们现在就去合成台附近吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590338,
					"content": "总感觉不太意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590307,
					"content": "惊喜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				}
			]
		},
		{
			"id": 7165904,
			"completionStepIds": [
				7165904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165904",
							"2"
						],
						"stepId": 7165904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂玛乌斯",
					"莺儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590401,
					"content": "制作古法香膏的流程啊，可是相当讲究的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590402
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590402,
					"content": "要像摩挲恋人的肌肤一样，以极为温柔的力道剥开花苞，取下花瓣，将它们细致地叠放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590403
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590403,
					"content": "纤薄的花瓣在上，厚实的花瓣在下，留下适当的空隙，再将它们捣碎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590404
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590404,
					"content": "臼杵不必握得太紧，手腕要放松，节奏要起伏有致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590405
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590405,
					"content": "等到花瓣的汁液弥漫，臼杵的底部完全湿润，再适当加快速度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590406
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590406,
					"content": "这…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590407
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590407,
					"content": "莺儿小姐的用词还真是…特别！我大概理解你的意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590408
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590408,
					"content": "谨慎处理原料，注意置入容器的次序，把握浸入基液的时间，以便精确控制火候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590409
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590409,
					"content": "制作一些高等炼金药剂时，也需要以这么严格的要求把控细节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590410
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590410,
					"content": "你的悟性很不错嘛，但制作香膏的要点远不止这些哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590411
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590411,
					"content": "有些香膏的「升华效应」极为重要，需要加入合适的辅料，比如薄荷和星螺磨制的粉末。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590412
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590412,
					"content": "这样一来，香膏的气味就能快速弥漫开来，让周围的人心旷神怡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590413
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590413,
					"content": "但「升华效应」也不能太强，否则，香膏很快就会消耗殆尽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590414
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590414,
					"content": "升华…升华？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590415
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590415,
					"content": "我懂了，古法香膏的这种特性，正是我所追求的关键之处！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590416
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590416,
					"content": "弥漫在空气里的药剂能同时作用于使用者和环境，相比普通的精油，效果应该更明显！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590417
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590417,
					"content": "而且，适当控制升华的速度以后，持续时间应该也会比普通的精油更长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590418
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590418,
					"content": "向这个方向努力，绝对不会有错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590419
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590419,
					"content": "进入学术讨论后，就完全插不上嘴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590420,
					"content": "还是不要打扰他们两位了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590421,
					"content": "在莺儿的指点下，蒂玛乌斯尝试制作了改进的炼金药剂。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590422
					]
				},
				{
					"id": 716590422,
					"content": "好香啊！只是闻到这种气味，就让人感觉十分清爽，又充满力量呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590423,
						716590424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590423,
					"content": "的确让人打起精神来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				},
				{
					"id": 716590425,
					"content": "成功了！我总算成功了！结合了香膏古法的炼金药剂完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590426
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590426,
					"content": "多亏了莺儿小姐的指导，我才能在这么短的时间内找到窍门，顺利制备这些药剂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590427
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590427,
					"content": "太谦虚的话，就会显得虚假和客套啦。你的学识和悟性才是成功的关键哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590428
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590428,
					"content": "现在…不如先为你的心血之作起个名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590429
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590429,
					"content": "就叫它们「烟霰魔药」吧！它们结合了莺儿小姐的香膏和炼金药剂的特性，意义非凡，一定会被记载在学术史上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590430
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590430,
					"content": "啊呀，真让我受宠若惊呢~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590431
					],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590431,
					"content": "不过这个名字和之前的「烟霰丹剂」…没什么区别吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590432,
					"content": "咳咳，言归正传！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590433
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590433,
					"content": "旅行者，你会是「烟霰魔药」的首位使用者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590434
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590434,
					"content": "目前的「烟霰魔药」还需要完善，能麻烦你试验一下这些药剂的效果吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590435
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590435,
					"content": "在空气流动相对缓慢的区域，「烟霰魔药」的效果会更明显。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590436
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590436,
					"content": "听说璃月有一些无人造访的秘境，它们是相当理想的试验场地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590437,
						716590438
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590437,
					"content": "帮人帮到底。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590439,
					"content": "那就有劳你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590440
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590440,
					"content": "我会在这里待上一段时间，继续和莺儿小姐交流学术，等着你的反馈，准备改进「烟霰魔药」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590441
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590441,
					"content": "等你们的好消息哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莺儿"
				},
				{
					"id": 716590438,
					"content": "我也起兴致了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590424,
					"content": "的确有着神奇的功效。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				}
			]
		},
