				{
					"id": 716590601,
					"content": "你好！请问你认识住在这附近的「丹剂宗匠」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590602,
					"content": "「丹剂宗匠」？没听说过这号人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590603
					],
					"speakerTitle": "小千"
				},
				{
					"id": 716590603,
					"content": "只有地位显赫的人才配得上「宗匠」这种称号吧？我这种小人物当然不认识了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590604
					],
					"speakerTitle": "小千"
				},
				{
					"id": 716590604,
					"content": "唔，那我们去问问其他人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
