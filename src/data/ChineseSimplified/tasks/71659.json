			"dialogs": [
				{
					"id": 716590701,
					"content": "你好！我们在找吃虎岩的「丹剂宗匠」，请问你知道他住在哪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590702,
					"content": "不好意思，我不了解街坊邻居们的绰号，只记得他们登记在册的正式姓名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590703
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 716590703,
					"content": "或许你们可以请教「春香窑」的莺儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590704
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 716590704,
					"content": "有道理哦！莺儿小姐应该很熟悉这方面的事吧，我们去问问她好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
