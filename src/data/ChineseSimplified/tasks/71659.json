			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂玛乌斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590101,
					"content": "似乎只差一点了…争取在九个小时内制作出第一份「烟霰丹剂」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590102
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590102,
					"content": "蒂玛乌斯？你在干嘛呀，表情这么严肃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590103,
					"content": "是你们！好久不见了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590104
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590104,
					"content": "实在不好意思，我正在试制「烟霰丹剂」，可能需要占用合成台一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590105
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590105,
					"content": "「烟霰丹剂」？完全没听说过这种东西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590106,
					"content": "这是近年来出现的神秘药剂，我也是在一本冷门的学术书籍上读到相关资料的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590107
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590107,
					"content": "据作者所说，「烟霰丹剂」起源于璃月，能让使用者的力量成倍增长，效果无与伦比，想必是强大炼金术的造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590108
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590108,
					"content": "「烟霰丹剂」在璃月得到了高度认可，有着诸如「丹香悠邈焕仪质」的描述…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590109
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590109,
					"content": "我仔细进行了评估——如果成功试制「烟霰丹剂」，我对炼金术的理解至少能进步十年！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590110
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590110,
					"content": "进步十年？这也太厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590111,
						716590112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590111,
					"content": "前提是那本书的说法属实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				},
				{
					"id": 716590113,
					"content": "放心吧！这本书的作者是个万事通，写过不少令人拍案叫绝的论文！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590114
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590114,
					"content": "炼金术是一门奇妙的学问，在发掘古代的技术的同时，参考当世之人的研究成果，不断演化和进步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590115
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590115,
					"content": "所以我才会寻找各种资料，从中发掘能为炼金术提供帮助的知识，推进我的主要课题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590116
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590116,
					"content": "蒂玛乌斯的心态还真是积极进取呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590117,
					"content": "如果两位能协助我，我肯定能顺利完成这次研究，获得阿贝多老师的认可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590118
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590118,
					"content": "也许我能借此机会成为阿贝多老师的助手，常驻在他的营地里，研究更高深的课题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590119
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590119,
					"content": "#怎么办，{NICKNAME}？我们要答应他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590120,
						716590121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590120,
					"content": "为了自由使用合成台…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590122,
					"content": "还是帮帮他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590123,
					"content": "感谢两位！我一定会全力答谢你们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590124
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590124,
					"content": "等到我的「烟霰丹剂」试制成功，两位就能第一时间享受到它的神奇功效，快速变强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590125,
						716590126
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590125,
					"content": "也不必这么客气…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590127,
					"content": "比起试用药剂和快快变强，我更想要很多很多好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590128,
					"content": "那更不成问题了！事成之后，我会支付足够的报酬，然后请两位任选餐馆，痛痛快快吃一顿大餐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590129
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590129,
					"content": "真的吗！一言为定哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590130,
					"content": "协助蒂玛乌斯，尝试制作传说中的「烟霰丹剂」…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590131
					]
				},
				{
					"id": 716590131,
					"content": "唉！只凭我掌握的工艺，还是没法制作出「烟霰丹剂」，果然还是要请教一下专家啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590132
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590132,
					"content": "比如阿贝多吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590133,
					"content": "不行！绝对不行，这么干不就等于在考试途中向老师询问答案吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590134
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590134,
					"content": "要是被阿贝多老师知道，我连这么一种药剂都做不出来，他就更不可能认可我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590135
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590135,
					"content": "有道理哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590136,
					"content": "不如去问问砂糖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590137
					]
				},
				{
					"id": 716590137,
					"content": "虽然砂糖小姐对炼金术的理解的确远远超过我，但她专攻的领域和「烟霰丹剂」基本无关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590138
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590138,
					"content": "而且她平时研究也很忙，我也不好意思去打扰她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590139
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590139,
					"content": "不如去请教丽莎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590140
					]
				},
				{
					"id": 716590140,
					"content": "丽莎小姐最近正在整理图书馆的藏书，据说工作量很恐怖…要是被人打扰了，丽莎小姐说不定心情也会不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590141
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590141,
					"content": "总之！我们还是、还是别去打扰她了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590142
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590142,
					"content": "那怎么办？这不是完全没办法了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590143,
					"content": "办法…倒是有。只不过不在蒙德，而是在…璃月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590144
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590144,
					"content": "那本书籍里提到过，「宗匠闲清隐隔邻，薰风郁霭笼岩港」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590145
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590145,
					"content": "听说「薰风」这个词在璃月有着「南风」的意思，所以创造出「烟霞丹剂」的「丹剂宗匠」应该就住在璃月港的南部区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590146
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590146,
					"content": "直接请教那位「丹剂宗匠」，当然是最有效的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590147
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590147,
					"content": "所以，能不能请二位和我一同前往璃月？我对那里实在是不熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590148,
						716590149
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590148,
					"content": "这句诗的含义…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590150,
					"content": "当然！请相信我分析资料的能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590151
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590151,
					"content": "还要去璃月…好远啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590152,
					"content": "对了，听说璃月的料理相当美味，事成之后，我们可以直接在璃月吃饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590153
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590153,
					"content": "好主意欸！我支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590154,
					"content": "那我要把「万民堂」的所有招牌菜都吃一遍！「万民堂」的菜，无论吃几次都不够呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590155,
						716590156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590155,
					"content": "会不会太破费了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590157,
					"content": "别担心，比起研究的成果…不对，是两位帮助我的恩情，这点钱根本不算什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590158
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590158,
					"content": "我们现在就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 716590156,
					"content": "蒂玛乌斯的资金储备…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590149,
					"content": "你确定吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590126,
					"content": "我不需要借助外力变强…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590121,
					"content": "为了蒂玛乌斯的学术生涯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590112,
					"content": "前提是你的评估足够准确。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				}
			]
		},
		{
			"id": 7165902,
