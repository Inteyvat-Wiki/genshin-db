			"dialogs": [
				{
					"id": 762020201,
					"content": "欢迎光临。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020202,
					"content": "你好啊，尼可。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "哇，好华丽气派的屋子，你装潢得很漂亮嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020205,
					"content": "哼哼，真有眼光，不枉费我这些日子里虽然是抽空但也很用心做的设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020206,
					"content": "——具体就要从这座秘密小屋建成之日说起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020207,
					"content": "我本来想趁手感不错，多去修建几座魔女小屋，但没人帮忙提供新的灵感，久了又觉得没劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020208,
					"content": "「就没有既有趣又好玩，还能得到成就感的做法吗？」我的脑海中咻地闪过了答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020209,
					"content": "等下，直接到答案了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020210,
					"content": "话不等人啊。喏，它就在你们的眼前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020211,
					"content": "这扇门后？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020212,
					"content": "其实不止这扇门，但也不算错，总要有个先后顺序，那就从它开始吧，准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020213,
					"content": "等…等一下，你语速太快了，我有点跟不上来…你要我们准备什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020214,
					"content": "噢，别紧张，什么都不用你们准备。我就象征性地问一声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020215,
					"content": "凭我的观察和对你们的了解…比起复杂的事先说明和解释，你们更喜欢在探索过程中挖掘乐趣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020216,
					"content": "倒是没说错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "哈哈，这话我爱听，那我就真的真的不客气喽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME}，你是了解我们天使的，引导人寻找宝藏的那份满足感向来叫我们无法自拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020220,
					"content": "既然一样要与人为善，助人为乐，怎么能不先想想自己的朋友呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020221,
					"content": "于是我灵机一动，把小屋打造成了可供你们休闲玩耍的游乐屋，还把宝物分别藏进了每个房间里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020222,
					"content": "实不相瞒，即使是在众多天使之中，我也是藏东西的好手噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020223,
					"content": "真要我去外面认认真真埋一个宝箱，还不给你们带路的话，只恐怕你们花上几个月都找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020224,
					"content": "咳咳，说远了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020225,
					"content": "总之，我不会故意为难你们，也不需要你们为了我的小小爱好在荒郊野岭东奔西跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020226,
					"content": "只要在房间里找到三片象征宝物的羽毛就可以过关了！到了那个时候，嘿嘿，请务必在我面前打开宝箱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020227,
					"content": "这下我全听懂了！宝藏，我等不及了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020228,
					"content": "宝藏，我也等不及了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020217,
					"content": "但尼可的说明还是想听听的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "很荣幸来这里做客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
