				]
			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "一阵风扑面而来。\\n真奇怪，它尝起来有双果卷、夏槲蛋糕、脆脆烤肉和花果草糖的味道。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "呃！突然有一股好甜的风钻进喉咙里了，咳咳咳…咦？我们这是在哪里？茶壶和杯子看着好大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020303,
					"content": "还是说…是我们变小了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020304,
					"content": "看起来像是尼可的魔法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "很抱歉，我没能邀请对应的动物演员，我平时都是和石头演员打交道的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020306,
					"content": "欸？尼可你也是小小的样子嘛，我还以为你也会变大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020307,
					"content": "蹲下身也能做到顶天立地的巨大魔女尼可？不了不了，我对我现在的形态已经足够满意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020308,
					"content": "总之，欢迎加入伟大魔女的茶会时光！现在，添茶吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
			"id": 7620204,
