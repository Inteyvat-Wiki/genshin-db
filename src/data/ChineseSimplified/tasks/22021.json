					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "还在幕府内任职的时候，在下经常做这种小菜，和几位同僚用来下酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "龟井宗久"
				},
