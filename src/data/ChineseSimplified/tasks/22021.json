					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210310,
					"content": "是你大意了啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "哈哈哈…是啊，一个不留神就输给大叔了，下次对决的时候，我可要更仔细一点才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210312,
					"content": "对了旅行者，这些东西给你，收下吧，谢谢你陪我和大叔折腾到现在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210313,
					"content": "下次我们对决的时候，你可一定也要过来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210314,
					"content": "大叔的「极意之串」更胜一筹了啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "极、极意之串？什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210316,
					"content": "意思就是「品质完美的串串三味」。",
