			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭东",
					"龟井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "我这道菜可是很厉害的，你可要做好准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210102,
					"content": "在下的这道菜同样很不错，请阁下也做好准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210103,
					"content": "你们干什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "是你啊旅行者。是这样，芭尔瓦涅和朱莉出去搜集食材了，我们本来打算给她们准备准备饭菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210105,
					"content": "但我和宗久大叔对于准备什么菜，有一点点分歧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210106,
					"content": "所以，我和宗久大叔就打算各自出一道菜切磋一下厨艺，顺便以此决定今天的菜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210107,
					"content": "我打算做一道璃月特色菜「珍珠翡翠白玉汤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210108,
					"content": "在下则准备用拿手的「串串三味」来应战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210109,
					"content": "需要我帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "唔，如果你有空的话，我们确实需要一个负责评判味道高低的裁判…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210113,
					"content": "但我俩各自都只有一个人，而且每道菜要准备四个人的份，说不定会有些忙不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210114,
					"content": "在评判味道之前，还是请你先帮我们准备准备那道菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210115,
					"content": "当然，你也只有一个人，所以你就挑一道你感兴趣的菜帮忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210116,
					"content": "旭东，你忙得过来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "你也不用担心我，我好歹之前在璃月也是个开餐馆的，只是准备准备饭菜而已，难不倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210118,
					"content": "只不过，如果有人帮忙的话，饭菜能做得更精细一些就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210122,
					"content": "总之，你就挑一道你感兴趣的菜帮忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210123,
					"content": "旭东，我来帮你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "噢！那太好了，宗久大叔，你可要准备好，可别被我的菜一口气打倒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210125,
					"content": "在下可不会轻易认输的，阁下尽管放手施为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210126,
					"content": "宗久大叔，我来帮你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "多谢阁下。旭东阁下，你可要小心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210128,
					"content": "没问题，你就尽管放马过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210119,
					"content": "宗久大叔，你忙得过来吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "阁下凭自己喜好挑选即可，在下还在幕府之时，也经常一人准备好几个人的下酒菜，现在只是四人份而已，不成问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210121,
					"content": "但如果阁下愿施以援手，那在下的饭菜一定能做出更好的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210111,
					"content": "你们一定缺一个裁判。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "哈哈哈，可不是，我们正需要一个负责评判味道高低的裁判呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "旭东"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭东",
					"龟井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "这样就做好了，多谢啦旅行者。这香味，闻着就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210202,
					"content": "我先来尝尝…嗬，不错，食材炖煮的程度刚好，香气也很足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210203,
					"content": "可以说是一道「完美的珍珠翡翠白玉汤」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210204,
					"content": "好嘞，宗久大叔，你的菜做得怎么样了？你也拿出来让旅行者品鉴一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210205,
					"content": "唔，在下失误了。在开始做菜的时候，才发现没有备足鸟蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210206,
					"content": "虽然在下马上从旁边的树林里取了些鸟蛋，但其余的食材却都过了最佳的处理期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210207,
					"content": "以这种新鲜度欠佳的食材制作的「串串三味」，已经不能称得上是一道好菜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210208,
					"content": "居然会如此疏忽，在下真是惭愧，在厨艺一道上，我还需要再多加训练才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210209,
					"content": "这次的比试，是在下输了。但下次，在下一定会赢过你的，旭东阁下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210210,
					"content": "要加油啊，大叔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "嘿嘿，不过我也不是那么好战胜的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210212,
					"content": "对了旅行者，这些东西给你，收下吧，谢谢你陪我和大叔折腾到现在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210213,
					"content": "下次我们对决的时候，你可一定也要过来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210214,
					"content": "其实我感觉味道还好啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "不，就算是做菜，也要怀着追求极致之心，不断追求厨艺的「极意」，绝不能满意于「差不多」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210216,
					"content": "这样，才能不断攀上厨艺之道上的一个个高点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210217,
					"content": "是…是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210218,
					"content": "是…是！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "这既是武道，也是厨道，更是在下的为人之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210220,
					"content": "啊…好！要加油啊，宗久大叔，要加油啊，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210221,
					"content": "呃啊…我对这种…这种严肃的人一点办法都没有…只有朱莉能对付宗久大叔，但是她现在又不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210222,
					"content": "完全被震慑住了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "咳，这次辛苦你了旅行者，这些东西请收下吧，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220210224,
					"content": "旭东阁下，在下还想请教您一些厨艺上的问题，请问您现在有空吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210225,
					"content": "啊？有！我有空，现在就来！马上就来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				}
			]
		},
