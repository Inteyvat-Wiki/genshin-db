					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "那就拜托阁下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龟井宗久"
				},
				{
					"id": 220210705,
					"content": "你怎么会做这个的？",
