			},
			"dialogs": [
				{
					"id": 130021301,
					"content": "地脉抽取机停止运转了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021302
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021302,
					"content": "空气中还残存着不少地脉能量，不过泄漏的源头被堵住，剩下来的这些可以用净化装置处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021303
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021303,
					"content": "另外就是那些受到地脉影响的人，必须趁早救治。嗯，就在公告板上写明进入污染区的危害，让病人统一去找柯莱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021304,
						130021305
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021304,
					"content": "卡卡塔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021306
					]
				},
				{
					"id": 130021306,
					"content": "按照教令院的规矩，需要把它们都带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021307
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021307,
					"content": "关于机械生命的研究资料统一销毁，卡卡塔则会被拆解封存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021308
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021308,
					"content": "怎么这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021309,
					"content": "你们先回去吧，这里的事我留下来处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021310
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021310,
					"content": "地脉泄漏的源头虽然堵住了，但空气中的地脉能量还是高于正常值，继续待下去，你们的身体撑不住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021311
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021311,
					"content": "可…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021312,
					"content": "#你姑且不论，{NICKNAME}本来就没有休息好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021313
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021313,
					"content": "这里的研究文件数量众多，打包需要时间。你们对这些实验了解吗？留在这里也帮不上什么忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021314
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021314,
					"content": "告诉冒险家协会事情已经解决了，然后去好好睡一觉，有什么事明天再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021317
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021317,
					"content": "提纳里在地图上标记了他做研究时会去的禅那园。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130021315
					]
				},
				{
					"id": 130021315,
					"content": "…哦对，阿巴图伊的事就别说了。牵扯到机械生命研究，知道的人越少越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021316
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021316,
					"content": "#好吧…那{NICKNAME}，我们先回去找凯瑟琳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021305,
					"content": "阿巴图伊的研究…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021306
					]
				}
			]
		},
