				"objectNames": [
					"提纳里",
					"阿巴图伊",
					"卡卡塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020701,
					"content": "你们有找到什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020702,
					"content": "实验笔记很多，全部看完太花时间了。我找了实验用的录像带，虽然看编号，应该是两年前的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020703
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020703,
					"content": "录像带？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020704,
					"content": "嗯。素论派曾经做过一种装置，用来记录实验影像，记录的成品就是录像带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020705
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020705,
					"content": "但这种装置造价高昂，而且不太稳定，所以只在部分实验室使用，没有对外公开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020706
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020706,
					"content": "那我们快看一看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020707,
					"content": "稍等，我看一下怎么播放。好了，这样应该就可以了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020708
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020708,
					"content": "放入录像带后，放映机上逐渐显示出过去的画面…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020709
					]
				},
				{
					"id": 130020709,
					"content": "卡卡塔，卡卡塔？真是的，一会儿不见，跑到哪里去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020710
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020710,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020711
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020711,
					"content": "原来你在啊！快过来看看，这里就是我们的新家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020712
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020712,
					"content": "我，阿巴图伊，要在这里大展拳脚，让教令院那些老古董们刮目相看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020713
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020713,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020714
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020714,
					"content": "哦？你也很高兴嘛！不过卡卡塔，你知道我们要做什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020715
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020715,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020716
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020716,
					"content": "哈哈哈哈…是啊，我猜你也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020717
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020717,
					"content": "听好了卡卡塔，我要在这里造出可量产的机械生命，所用的技术不同于以往任何一种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020718
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020718,
					"content": "我会用机械模拟器官，让电流如血液般流淌；钢铁铸造的心脏不停跳动，元件密布的大脑可以像我一样思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020719
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020719,
					"content": "从遗迹中得到的启示、被教令院禁止的研究…我希望一切都能在这里生根发芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020720
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020720,
					"content": "到时候，你们能听懂人类的语言，能够和人类一同生活。不是单调无趣的机关，而是货真价实的生命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020721
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020721,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020722
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020722,
					"content": "没关系。你会听懂的，总有一天会听懂的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020723
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020723,
					"content": "录像到这里就结束了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020724
					]
				},
				{
					"id": 130020724,
					"content": "卡卡塔，应该就是那只机械螃蟹吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020725,
					"content": "还有，听那个叫阿巴图伊的学者说，他好像要向教令院证明什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020726,
					"content": "「废止研究」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020727
					]
				},
				{
					"id": 130020727,
					"content": "我想起来了。当初我确实有一个叫阿巴图伊的后辈，因为研究机械生命被赶出了教令院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020728
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020728,
					"content": "「后辈」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020729,
					"content": "「后辈」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020730
					]
				},
				{
					"id": 130020730,
					"content": "怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020731
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020731,
					"content": "没有没有，只是感觉阿巴图伊，应该比提纳里的年纪要大？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020732,
					"content": "学级和年龄无关。我很早就学完了专业课，所以后入学的人一般都会称呼我为前辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020733
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020733,
					"content": "这样啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020734,
					"content": "当然，年龄也确实是个问题。有一段时间我感觉自己就像什么珍稀动物，经常被人拉去合影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020735
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020735,
					"content": "咳。这些不重要，还是去找找看有没有其他录像带吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
