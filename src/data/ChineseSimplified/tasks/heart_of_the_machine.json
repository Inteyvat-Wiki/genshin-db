			"dialogs": [
				{
					"id": 130020101,
					"content": "咕噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020102
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020102,
					"content": "咕噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020103
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020103,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020104
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020104,
					"content": "它在这里停下来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020105,
					"content": "仔细观察的话，这里的植物确实不太一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020106
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020106,
					"content": "地脉能量也比别处更强，看来这里或许就是我们要找的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020107
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020107,
					"content": "做好准备，进去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
		{
			"id": 1300204,
			"completionStepIds": [
				1300204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
