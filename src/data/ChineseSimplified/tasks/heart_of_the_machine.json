					"nextDialogs": [
						130020821
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020821,
					"content": "录像到这里就结束了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020822
					]
				},
				{
					"id": 130020822,
					"content": "阿巴图伊离开教令院之后，就直接失去了音讯。",
