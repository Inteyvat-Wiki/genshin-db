					"nextDialogs": [
						130020914
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020914,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020915
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020915,
					"content": "我正式启用了第三代地脉提取机，以地脉作为我们今后的能量来源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020916
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020916,
					"content": "研发机械生命需要大量能源，就算我省吃俭用，手上这点钱也远远不够用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020917
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020917,
					"content": "我也会累啊，卡卡塔。实验进行到现在，我已经不知道驱使我前进的动力是什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020918
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020918,
					"content": "他们说，就算模拟生物器官的运转，机械依旧是冰冷的工具。我想证明他们是错的，想让你们变成能听能说的鲜活生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020919
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020919,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020920
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020920,
					"content": "我没有在跟你说开心的事情，卡卡塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020921
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020921,
					"content": "语言模块、情感模块、动作模块…我不停地尝试，竭尽全力去丰富和完善你们的功能，却从未得到任何有效的回应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020922
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020922,
					"content": "你是我所有成果中最特别的那个，但即便是你也没办法理解我，只会对我预先设定的指令或关键词做出有限的反馈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020923
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020923,
					"content": "卡卡塔，哪怕一次也好，我多希望你能开口和我说说话啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020924
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020924,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020925
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020925,
					"content": "是啊。你听不懂，也没办法回答我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020926
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020926,
					"content": "就这样吧，过几天我会把研发失败的地脉提取机卖掉，换点钱来继续实验。路总要走下去，我没有别的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020927
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020927,
					"content": "录像到这里就结束了。提纳里平静地放入了下一份录像带。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020928
					]
				},
				{
					"id": 130020928,
					"content": "这倒是新的发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020929
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020929,
					"content": "如果从这里额外引入两个控制模块，来模拟大脑结构中的「丘脑」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020930
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020930,
					"content": "嘶…偏偏是这个时候开始心脏不适。果然不该从药钱里省的…卡卡塔？过来帮我一把…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020931
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020931,
					"content": "奇怪…身体使不上劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020932
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020932,
					"content": "糟了。得把装置关停…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020933
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020933,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020934
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020934,
					"content": "关停装置…咳咳…如果让它们不受限制地补充能源，会…失控…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020935
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020935,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020936
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020936,
					"content": "也对，我没有录入过关停装置的命令，所以你听不懂我在说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020937
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020937,
					"content": "结果还是像教令院那些人说的一样，机械生命带来的只有危险。我的研究…有什么意义吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020938
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020938,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020939
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020939,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020940
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020940,
					"content": "抱歉卡卡塔，直到最后还是没能让你成为…真正的机械生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020941
					],
					"speakerTitle": "阿巴图伊"
				},
				{
					"id": 130020941,
					"content": "最后一卷录像到这里就结束了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020942
					]
				},
				{
					"id": 130020942,
					"content": "原来是这样。看来地脉泄漏事件，更像是一个意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020943
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020943,
					"content": "阿巴图伊意外去世，机械怪物在「本能」的驱使下不停地从地脉抽取机中获取能源，最终导致地脉出现严重破损。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020944
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020944,
					"content": "那卡卡塔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020945
					]
				},
				{
					"id": 130020945,
					"content": "对哦。为什么卡卡塔没有像其他机械怪物一样失控呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020946
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020946,
					"content": "因为卡卡塔和那些机械怪物不太一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020947
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020947,
					"content": "与真实生命构造相似、会哭会笑、会自主思考…在阿巴图伊看来，拥有这些性能的机械，才能被称为机械生命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020948
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020948,
					"content": "或者说，只有造出这样的机械，才能让教令院认可他长期以来的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020949
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020949,
					"content": "但其实如果他能静下心来，把卡卡塔看做朋友而非实验品的话，他应该就能注意到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020950
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020950,
					"content": "卡卡塔确实不会说话，但它关心阿巴图伊，胜过关心它自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020951
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020951,
					"content": "这是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020952
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020952,
					"content": "等一会儿，你们自然就明白了。在那之前，我们还有更重要的任务——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020953
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020953,
					"content": "先找到地脉抽取机的控制装置，把它关停吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
		{
			"id": 1300210,
			"completionStepIds": [
				1300210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300210",
							"2"
						],
						"stepId": 1300210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提纳里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130021001,
					"content": "…这里应该就是控制装置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021002
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021002,
					"content": "关闭控制器后，地脉抽取机应该就会停止运转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021003
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021003,
					"content": "没有了破坏地脉的「外力」，地脉应该会缓慢地自我修复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021004
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021004,
					"content": "当然，我估计你们此时更关心卡卡塔在做什么。走，一起回去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
		{
			"id": 1300211,
			"completionStepIds": [
				1300211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300211",
							"2"
						],
						"stepId": 1300211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提纳里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130021101,
					"content": "所以…卡卡塔一直收集零件，是因为它觉得这样就能「修好」自己的主人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021102,
					"content": "对卡卡塔来说，它根本无法理解什么是「死亡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021103
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021103,
					"content": "但是它大概记得，自己曾经也出过「故障」，那时候阿巴图伊帮它更换了零件，成功让它恢复了「正常」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021104
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021104,
					"content": "卡卡塔确实不具备思考能力，很多事也不懂，但它就像小孩子一样，会模仿大人做过的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021105
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021105,
					"content": "所以它才一直抢夺机械零件…但，不管它怎么努力，其实都是修不好的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021106,
					"content": "是啊，但重要的是它产生了「想要修好阿巴图伊」的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021107
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021107,
					"content": "没人知道这个想法是怎么产生的，但这个想法本身，甚至压制了阿巴图伊为它设定的「本能」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021108
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021108,
					"content": "如果真如我们所推测，这确实是能够震撼教令院的研究。古代的一些科技或许能够做到，但还没有人依靠现代的科学成功实现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021109
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021109,
					"content": "卡卡塔？卡卡塔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021110,
					"content": "听得到吗？提纳里说你很厉害哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021111,
					"content": "它没有回应…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021112
					]
				},
				{
					"id": 130021112,
					"content": "已经到极限了吧。这段时间，它一直没有补充能源，也没有为自己替换掉严重磨损的零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021113
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021113,
					"content": "能撑到现在，已经是一个奇迹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021114
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021114,
					"content": "我去确认一下地脉抽取机是否已经关停，你们也跟我一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021115
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130021115,
					"content": "让他们…再单独呆一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
		{
			"id": 1300213,
			"completionStepIds": [
