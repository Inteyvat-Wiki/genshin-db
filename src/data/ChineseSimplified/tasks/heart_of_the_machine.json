			},
			"dialogs": [
				{
					"id": 130020501,
					"content": "快看！有人在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020502,
					"content": "是你在这里抽取地脉吗？快把那台机器停掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020503,
					"content": "你怎么不说话，是不是心虚了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020504,
					"content": "…他的身体没有任何温度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020505
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020505,
					"content": "骨瘦如柴、眼袋发青，应该是长期营养不良加上过度劳累，让他倒下后再也没有醒来。这里到底发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020506
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020506,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020507
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020507,
					"content": "…差点把你忘了。给，这是最后一个了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020508
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020508,
					"content": "咕噜！咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020509
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020509,
					"content": "它在做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020510,
					"content": "不清楚。从房间的布局来看，这里是实验室，往里走应该会有存放实验资料的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020511
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020511,
					"content": "资料室中肯定会留下一些线索，我们去看看吧，或许能搞清楚这里的来龙去脉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				}
			]
		},
		{
			"id": 1300207,
