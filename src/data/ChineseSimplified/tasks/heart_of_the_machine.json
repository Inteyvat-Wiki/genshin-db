					"nextDialogs": [
						130020823
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020823,
					"content": "当时我以为他心灰意冷，放弃了对机械生命的研究。没想到他一直躲在这里，继续实验。",
					"roleType": "TALK_ROLE_NPC",
