			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提纳里",
					"卡卡塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020401,
					"content": "这是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020402,
						130020403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020402,
					"content": "没见过的机器…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				},
				{
					"id": 130020404,
					"content": "地脉的能量就是从这里溢出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020405
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020405,
					"content": "这装置…在抽取地脉，而且是无休止地抽取地脉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020406
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020406,
					"content": "到底是谁做的，干这种事之前不考虑后果的吗？像这样不停地破坏地脉流动，地脉甚至无法完成自我修复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020407
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020407,
					"content": "怎么会…必须要让它停下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020408,
					"content": "让我看看…呃…找不到可以操作的地方呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020409,
					"content": "头开始晕了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020410
					]
				},
				{
					"id": 130020410,
					"content": "站在这里就等同于直接被地脉能量冲刷，可能会对身体产生不可逆转的损伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020411
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020411,
					"content": "#{NICKNAME}，你带着派蒙先退出去。我来研究一下怎么把这东西关掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020412
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020412,
					"content": "可是…就算是提纳里，也没办法避免地脉的影响吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020413,
					"content": "我们也要一起留下，不能让提纳里一个人在这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020414,
					"content": "那就一起找吧。看不见控制装置， 说明这附近应该有「暗门」才对——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020415
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130020415,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020416
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020416,
					"content": "咕噜！咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020417
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020417,
					"content": "难道说你知道暗门在哪吗？喂，等等我们呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020403,
					"content": "感觉不太舒服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				}
			]
		},
