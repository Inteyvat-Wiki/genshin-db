				]
			},
			"dialogs": [
				{
					"id": 747140101,
					"content": "#{NICKNAME}和派蒙，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140102,
					"content": "最近潜水员变多的原因，是要好好处理水下废弃品，加快修复环境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140103
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140103,
					"content": "如果是这样，我应该尽全力帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140104
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140104,
					"content": "要是水下污染变得严重，海露花的色彩都会黯淡下去，还有许多我不敢想的可怕后果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140105
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140105,
					"content": "我们也来出力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140106
					]
				},
				{
					"id": 747140106,
					"content": "好哦！一起加油吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140107,
					"content": "对了，菲米尼，之前我们在水下找到了一个看起来挺厉害的…结构？似乎是某种乐器的部件？你也看看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140108,
					"content": "好的…啊，非常精密的构造。我研究过一些机关，但在市面上，我还从没见过那么细致又独特的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140109,
						747140110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140109,
					"content": "感觉摆在这里还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				},
				{
					"id": 747140111,
					"content": "嗯，不过它还差一些部件才能复原的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140112
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140112,
					"content": "嗯！慢慢来吧。我也很好奇它修好后是什么样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140113,
					"content": "那我继续去水里帮忙了。二位可以再多休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140114
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747140114,
					"content": "好，你也注意休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140115,
					"content": "咦？这东西…是你们捞上来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140116,
					"content": "嗯，桑多涅你知道这是什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140117,
					"content": "哈，何止是知道？我以前每天都坐在花园里弹它呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140118,
					"content": "欸？！这是…你的东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140119,
					"content": "曾经是。这是阿兰发明的机械钢琴，既可以由人来弹奏，也可以自动演奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140120,
					"content": "这么厉害…那它怎么会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140121,
					"content": "阿兰病重后听不得琴声，我就拿去处理了。但没想到还能再次见到它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140122
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140122,
					"content": "我猜是拿到这架钢琴的人用坏了也不会修，最终就变成这样了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140123
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140123,
					"content": "你能修好它吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140124
					]
				},
				{
					"id": 747140124,
					"content": "当然可以。这能难倒我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140125
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140125,
					"content": "呃，不过这看起来散得也太彻底了…如果你们能找到钢琴的其他部分，我很快就能动手修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140126
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747140126,
					"content": "好！那我们平时下水的时候就多留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747140110,
					"content": "和这里的环境很搭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				}
			]
		}
	]
}