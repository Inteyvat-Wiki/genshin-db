			"dialogs": [
				{
					"id": 747030101,
					"content": "等等…这账目…你们确定没算错？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747030102,
					"content": "嗯？有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747030103,
					"content": "…这赚得也太多了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747030104,
					"content": "后悔只拿三成了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "我在你心中是那么小气的人吗？我单纯在感慨你们居然真能把水族馆运营得那么好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747030106,
					"content": "我觉得多少也有「千灵映影节」的功劳啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747030107,
					"content": "这营业额…不止赚回了我租维恩歌莱号的钱，甚至还有很多盈余。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747030108,
					"content": "想转行了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "那倒不至于。我知道自己不适合做生意。我还是对机械结构和术式研究更感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747030110,
					"content": "不过…也对，看着这地方从一条鱼都没有的房间，变成现在这副模样，的确令人惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747030111,
					"content": "嘿嘿，这里面也有桑多涅慷慨出借的功劳啦！自己装点的房间被大家喜欢，还是很开心的对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747030112,
					"content": "哼，有那么一点点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747030113,
					"content": "只有一点点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747030114,
					"content": "可能因为她只拿了三成。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "说了我不在意这个啦！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
