			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "您好，请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010202,
					"content": "我们想借这里的厨房用一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010203,
					"content": "我的朋友想吃特殊的菜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "原来如此，那当然可以。只要自备食材，厨房就请尽管借用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010206,
					"content": "不过我想多一句嘴，这位客人，想必烹饪技术很精湛吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010207,
					"content": "当然，做什么都是「美味的」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "哈哈，果然不凡。其实，我有一个小建议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010211,
					"content": "看您的衣服，像是外国人。但既然来了璃月，要不要试试看做璃月的菜式呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010212,
					"content": "我这里有一份「黄金蟹」的食谱，是非常经典的「月菜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010213,
					"content": "裹上面粉的螃蟹先用油炸，再跟姜蒜一起炒，盛到盘里的螃蟹就像躺在黄金上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010214,
					"content": "黄…黄金蟹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010215,
					"content": "听起来有点麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#黄金蟹！{NICKNAME}，黄金蟹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010218,
					"content": "知道了知道了，黄金蟹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "嘿嘿，那我们现在就去做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010221,
					"content": "凭借你在烹饪上的造诣，肯定一下——就学会了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010219,
					"content": "…也算是为你学的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "为了莫娜专门学一道菜是不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "也没有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "哈哈，真谦虚呢。其实，我有一个小建议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010204,
					"content": "我的朋友想吃我亲手做的菜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
			"id": 1050103,
