			"dialogs": [
				{
					"id": 105010501,
					"content": "哼，怎么样？这下算是回应了你们的期待了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010502,
					"content": "战斗力，很厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "对占星术士来说，这可是基本功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010505,
					"content": "在占星术的面前谎言毫无意义，「命运」与「真实」都在星空中一览无余。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010506,
					"content": "虽然结果越具体，就越花时间，但大概的趋势一眼就能明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010507,
					"content": "可是，一路上好像也有不少失算的时候啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010508,
					"content": "那是因为提瓦特的星空，只展示「此世」的命运与真实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010509,
					"content": "只要是和你们有关的事情，就会变得模糊起来，就算是我也没法准确判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010510,
					"content": "所以，我才要和那个继承者见面，结合她的知识，说不定就能洞悉你的命运了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010511,
					"content": "有点期待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "呵，无论如何，对你来说都是有益无害的一次旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010514,
					"content": "好了，我也休息够了，那我们就一口气走到<color=#00E1FFFF>蒙德城</color>去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010515,
					"content": "唉，要是有车坐就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 105010516,
					"content": "你不是不累吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 105010512,
					"content": "不太抱期望…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "看穿强盗的真实，很厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
