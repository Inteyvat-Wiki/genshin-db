				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "有人托我来找两本书…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "你向黑田描述了茜特菈莉想要的绝版书。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "《转生成为雷电将军，然后天下无敌》的第一版和《拜托了我的狐仙宫司》的限量精装版…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210104,
					"content": "不得不说，你的这位朋友真的很专业，谈到收藏价值，目前八重堂发行的书籍都比不上这两本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210105,
					"content": "这样的读者我竟然不认识，真是遗憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210106,
					"content": "现在还能找到吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "无论哪一本，都不可能再从市面上找到了，库存更不用说，早就被抢购光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210108,
					"content": "不过，我这里刚好各有一本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210109,
					"content": "我可以花钱买。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "不不，这两本藏书还是在你那位朋友手里更能体现它们的价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "黑田"
				},
				{
					"id": 751210111,
					"content": "就让我把它们作为礼物送给你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黑田"
				}
			]
		}
	]
