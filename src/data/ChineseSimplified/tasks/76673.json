				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5482.98,
							194.651,
							9710.385
						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#年轻人惊叹于魔女的高贵与美丽，许久的沉默过后，{M#他}{F#她}郑重地对魔女开口——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730202,
					"content": "「悠远的魔女、昳丽的魔女、富有智慧的魔女！一见到您，我就忍不住心旌摇荡。我愿以您的愿望为我的愿望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730203,
					"content": "魔女的脸上露出不易察觉的笑容：「既然这样，那就替我完成一些力所能及的事情吧。指引已至，奖赏在未来等候你的到来。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730204,
					"content": "指引…是说这个光球吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "「秘密小屋啊」，年轻人的眼中流露出疑惑，「小屋在哪呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730302,
					"content": "听到年轻人的问题，魔女的声音少见地出现了些许慌乱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730303,
					"content": "（等下她是这种娇羞的角色吗？算了先这样设定好了，九老师会帮忙润色的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730304,
					"content": "「咳咳，年轻人，不要问这么失礼的问题。魔女小屋正在修建当中，很快你就会被它的华丽惊掉下巴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730305,
					"content": "「这是给你的考验，为建设大魔女的领土贡献你的力量吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "观察"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "「好了，年轻人。如今你已经知晓了魔女的烦恼，尼古拉·可可正在建设她神圣的领地，需要你的帮助。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730402,
					"content": "魔女笑着为年轻人沏了一杯茶：「你的选择是什么？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730403,
					"content": "义不容辞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "等一下啦！像这样来路不明、自说自话的怪人，还是谨慎一些比较好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730406,
					"content": "咦…不过这个茶杯，总感觉看上去有点眼熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730407,
					"content": "终于意识到了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "尼古拉·可可…啊！难道说是魔女N——尼可吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730410,
					"content": "答对了。刚刚的故事怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730411,
					"content": "怎么样…根本没讲完吧？后来呢，年轻人和魔女怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730412,
					"content": "没想好呢。剩下的等我的魔女小屋修好后再想吧，到时候也许会有新的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730413,
					"content": "既然你们听到了我的声音，就说明你们现在在挪德卡莱吧，能拜托你们帮我收集点东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730414,
					"content": "什么东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "我打算在修建小屋的同时，做一些新的雕像。不过暂时没什么灵感，想委托你们帮忙拍些精彩的画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730418,
					"content": "真拿你没办法，那就包在我们身上好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730419,
					"content": "你等着，我们这就出去看看有什么好东西。等雕塑完成后，记得把刚刚的故事讲完呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730416,
					"content": "跟雕塑有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "对，我打算在修建小屋的同时，做一些新的雕像。不过暂时没什么灵感，可以帮我拍点画片吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730408,
					"content": "这家伙就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "遵从伟大魔女尼古拉·可可的指引！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
