			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尼可"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5481.038,
							194.726,
							9711.116
						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "接下来，只要找尼可做一点修饰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731133,
					"content": "敲掉多余的石块了？我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731134,
					"content": "嘿嘿，这样就完成啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731101,
					"content": "咦——魔女的小屋！什么时候出现的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731102,
					"content": "这就是魔女的力量吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "「这就是魔女的力量吗」，年轻人的表情充满了不可思议，「真是太了不起了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731104,
					"content": "终于要讲之前的故事了吗？魔女和年轻人后来怎么样了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731105,
					"content": "#{M#他们}{F#她们}开心地生活在了一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731106,
					"content": "…就是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731107,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731108,
					"content": "过程呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "真拿你们没办法，既然你们这么想听，那我就从头开始讲好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731111,
					"content": "#自从年轻人许下「以你的愿望为我的愿望」后，{M#他}{F#她}就顺利地吸引了大魔女尼古拉·可可的注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731112,
					"content": "然而就在两个人关系升温时，却突然闯入了一群不速之客，强行抓走了魔女！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731113,
					"content": "年轻人大惊，这时候新的魔女艾莉娜丝出现，跟年轻人签订了契约，让年轻人也拥有了魔法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731114,
					"content": "在经历了艰苦卓绝的特训后，却发现这背后其实是另一个阴谋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731115,
					"content": "原来大魔女尼古拉·可可其实是外星生命，是猫星国王喵特拉斯三世的大女儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731116,
					"content": "她们伪装成魔女，真实目的是为了让全世界都在不知不觉中信仰猫猫星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731117,
					"content": "「伟大的魔女啊，难道您一直在欺骗我吗？」年轻人只觉得自己心肝寸裂，声音不由得发颤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731118,
					"content": "「回去吧，我们猫猫星和你们注定会有一场战争，我们从一开始其实就是敌人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731119,
					"content": "魔女背过身，不让人看到她眼中的泪花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731120,
					"content": "年轻人却勇敢向前抓住了魔女的手腕，发誓要和她永不分开。魔女被年轻人的执着打动，决定要掀起反旗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731121,
					"content": "就在这个时候，当初帮助年轻人的艾莉娜丝却站在了国王那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731122,
					"content": "原来她是喵特拉斯三世的二女儿，帮助年轻人是为了促成姐姐的实质性背叛，从而争夺王位继承权——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731123,
					"content": "尼可滔滔不绝地讲述了曲折的过程，其中充满了各种奇怪的情节，最后甚至连主角都脱离了人类的范畴…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "总之就是这样啦，最后变成猫的年轻人和魔女一同粉碎了阴谋，回到了魔女小屋，过上了与世隔绝的平静生活。全剧终。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731125,
					"content": "呜呜…真好啊，充满爱与反抗的旅程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731126,
					"content": "感觉和开头已经是两个故事了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "没办法，任何事物一旦被创造出来，终有一天都会脱离创造者的掌控。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731128,
					"content": "就像我们「天使」，曾经被赋予引导人类的职责，却因为部分天使选择了「另一条路」，最终整个族群受到惩罚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731129,
					"content": "就算是天理，也无法完全掌控它创造的东西…何况我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731130,
					"content": "命运就是那么不可言说，不过嘛…我还是希望引导我所见到的人，获得一个美好的结局。哪怕是故事中的人也一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731131,
					"content": "好了，这个故事讲完，我的热情也燃尽了。下次有好的故事，再分享给你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731135,
					"content": "原来她是喵特拉斯三世的二女儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731136,
					"content": "帮助年轻人是为了促成姐姐的实质性背叛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731137,
					"content": "从而争夺王位继承权——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731109,
					"content": "中间省略太多了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
