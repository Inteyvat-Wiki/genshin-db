			"dialogs": [
				{
					"id": 766730801,
					"content": "#在很久很久以前，有一位离家出走的年轻人。{M#他}{F#她}用完了身上最后一枚摩拉，在寒冷的冬天穿着单薄的衣衫，瑟瑟发抖地走着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730802,
					"content": "#就在这时，年轻人的脚下一空，随后坠入了一片奇特的地方。未等{M#他}{F#她}反应过来，一个声音便从远处传来——",
					"roleType": "TALK_ROLE_NPC",
