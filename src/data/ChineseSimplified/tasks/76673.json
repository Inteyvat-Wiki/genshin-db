			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "尼可，我们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730902,
					"content": "这么快！真不愧是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730903,
					"content": "过奖啦，不过画片要怎么给你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730904,
					"content": "你们先带在身上吧。大概两天后我会到达那里，到时候我们可以一起聊聊有关雕塑的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730905,
					"content": "好呀，那我们不见不散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
