			"dialogs": [
				{
					"id": 766730501,
					"content": "来得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730502,
					"content": "你们拍的画片我很满意，都是我感兴趣的题材。雕刻工具我也准备好了，一起来试试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730503,
					"content": "雕刻工具…你是说这些方块吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730504,
					"content": "没错，雕像就在这些石材中，我们只需要把多余的部分去掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730505,
					"content": "为了方便你们理解，我将雕刻的方法也做了「引导」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730506,
					"content": "让我来做个示范吧，首先是大刀阔斧地勾勒出基本的造型——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730507,
					"content": "石块上的数字就是同一列要保留的数量。像这样…然后这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730508,
					"content": "哦！逐渐像那么回事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730509,
					"content": "明白了吧？雕刻成这样，就大概能看出来基本的形状了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730510,
					"content": "之后只需要再加入一点修饰…嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730511,
					"content": "等、等一下！我只是眨了一下眼，怎么就变成这样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730512,
					"content": "这部分看看就好，伟大的魔女可不会随便公布术法的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730513,
					"content": "修饰的环节交给我，雕刻的手法你们应该看明白了吧？就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730514,
					"content": "好吧，我们试试看——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730515,
					"content": "呜哇！这是什么，一上来就这么难吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730516,
					"content": "嗯？哦，抱歉抱歉，刚刚拿错了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730517,
					"content": "这个是我要做的，你们的在这边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730518,
					"content": "吓，吓我一跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
