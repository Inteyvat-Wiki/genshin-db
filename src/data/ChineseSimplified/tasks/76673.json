			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "#年轻人继续走着，{M#他}{F#她}留意到魔女的领土上有许多巧夺天工的雕塑。「这是什么？」年轻人不解地询问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730102,
					"content": "「这些都是魔女的反对者，它们觊觎魔女的力量，所以被变成了石头。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730103,
					"content": "这个设定不错，虽然是我现想的。魔女就应该是既强大又危险的存在…危险带来神秘，没有神秘，世间的一切都会黯淡无光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730104,
					"content": "（不过动辄把人变成石头会不会太过分了？没人愿意跟这样的怪人长期相处吧，还是把刚刚说的话当做警告好了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730105,
					"content": "听完之后，年轻人冷汗直流。就在这时，魔女的笑声再次响起：「呵呵，当真了吗？不过是以雕塑来定格时光而已。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "观察"
				},
				{
					"id": 766730106,
					"content": "「雕塑——这就是我需要你帮我完成的事情，魔女的小屋缺少更多可爱的小家伙。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "观察"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
