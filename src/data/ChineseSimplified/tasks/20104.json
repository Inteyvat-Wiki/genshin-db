						201040202
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040202,
					"content": "打扫干净了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040203,
					"content": "已经打扫干净了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "太厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040205,
					"content": "不愧是旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040206,
					"content": "这样就不用被女仆长骂了，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040207,
					"content": "这些请收下，就算是谢礼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040208,
					"content": "我们得赶紧打扫别的地方去了…再次谢谢你帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩可"
				}
			]
		},
