			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040102,
					"content": "又要挨女仆长骂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040103,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "爱德琳小姐本来是让我们打扫酒庄的外围…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040105,
					"content": "其他的地方还好，但是，周围还有很多堆起来的草垛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040106,
					"content": "这些是康纳先生特意堆在这，说是有用处的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040107,
					"content": "虽然因为捆得很牢，暴风的时候这些草垛没有被吹走，但是，有很多落叶被吹到了草垛里面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040108,
					"content": "我们费了好大的劲，也没有把落叶从草垛里清理干净。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040109,
					"content": "再这么耗下去，女仆长非得骂我们不可，这可怎么办啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040110,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "咦？可以交给你吗！太好了，那就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040112,
					"content": "很难清理吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "落叶和草垛都搅一起了，我们只能用手慢慢地分开，实在是太慢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040114,
					"content": "如果你有什么好办法，就请帮帮我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海莉"
				}
			]
		},
