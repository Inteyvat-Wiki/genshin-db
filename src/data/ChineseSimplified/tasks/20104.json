				{
					"id": 201040301,
					"content": "你，你做什么呀，怎么把整个草垛都烧掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040302,
					"content": "这回不是被骂就能了事了，一定会被开除…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040303,
					"content": "一不小心就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "早知道，我们还不如慢慢地一点点把落叶挑出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040305,
					"content": "完了…这下子全完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040306,
					"content": "那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "旅行者，请你快点离开吧，这件事是我们的责任…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040308,
					"content": "我们不该让不懂得打扫方法的人来帮忙，是我们错了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "海莉"
				},
				{
					"id": 201040309,
					"content": "女仆长会怎么处置我们呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "摩可"
				},
				{
					"id": 201040310,
					"content": "这下子，全都完了…",
