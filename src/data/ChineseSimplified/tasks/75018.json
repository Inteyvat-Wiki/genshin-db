				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "「嘎——！」\\n像是知道自己不是敌手，绒翼龙啸叫着飞向远方…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "哇！！飞、飞得好快！一眨眼就跑了那么远！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180303,
					"content": "派蒙，快追！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "欸，我去追？我么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180307,
					"content": "——嗯，飞得这么快，看来至少体力已经恢复得差不多了，接下来就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180308,
					"content": "话说回来，那头绒翼龙为什么会这么生气啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180309,
					"content": "…啊，我知道了！该不会是你偷吃了它的点心吧？因为食物而结下的仇怨可是很重的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180310,
					"content": "点心？吃倒是吃过，不过咕噜噜是不拘小节的绒翼龙，所以不会在意这种小事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180311,
					"content": "「咕噜噜」？原来它也是有名字的龙啊…不过看起来脾气很坏呢，刚才还乱打人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180312,
					"content": "嗯…这也不怪它，都是为了治疗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180313,
					"content": "原来挨打也是治疗啊，长见识了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#怎么可能会有这种疗法啊！你看，都怪你乱说，{REALNAME[ID(2)|SHOWHOST(true)]}都当真了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180316,
					"content": "嗯？呜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "哈哈，要是真的有这种疗法而且有效，那我也想试试看呢！不过龙和人不一样，就算跟它们说都是为了快些痊愈，它们也不懂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180318,
					"content": "对了，还没自我介绍呢，我是玛兹嘉，平时都在这附近照看受伤或者生病的龙，不是我自夸，我配的药风评还不错哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180319,
					"content": "嗯，你们的小小伙伴看起来很健康的样子，看来是不需要我的关照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180320,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "原来你是给龙看病的医生啊。呃，看咕噜噜的样子，应该是很辛苦的工作吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180322,
					"content": "我觉得也没有那么辛苦啦，只是咕噜噜的情况比较特殊…它现在极度地不信任人类，对于治疗和吃药也很抗拒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180323,
					"content": "唉，要是我也是龙就好了。之前观察下来，它和其他龙相处得还不错，如果是龙劝它吃药，说不定它就会愿意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180324,
					"content": "呜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "如果是这样的话，说不定我们能帮上忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180326,
					"content": "欸？难、难道你们虽然外表是这样，但其实是龙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180327,
					"content": "你的想法也太跳跃了吧！呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180328,
					"content": "#对、对了！其实是因为{REALNAME[ID(2)|SHOWHOST(true)]}是特别聪明的小龙！这件事可以让它来帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180329,
					"content": "欸？原来它这么厉害吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180330,
					"content": "能选中我，至少很有眼光。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "话是没错…但现在重点不是这个吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180333,
					"content": "#总之这点小事交给{REALNAME[ID(2)|SHOWHOST(true)]}，肯定没问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180334,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，那我就先替咕噜噜谢谢你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180336,
					"content": "原本真的很担心它再这样闹下去，不仅旧伤不能痊愈，还会添新伤…有你们帮忙就放心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180337,
					"content": "我为咕噜噜准备了两种药剂，虽然很想兼顾疗效和适口性，但是现在我还拿不出这样完美的配方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180338,
					"content": "所以现在两种药剂，疗效好的那种大概是龙不太喜欢的口味，而口味它们喜欢的，疗效可能又没那么好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180339,
					"content": "#唔…与其我来解释，不如让{REALNAME[ID(2)|SHOWHOST(true)]}闻闻看，你们看看它的反应，应该会更明白吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180340
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180340,
					"content": "这个是疗效更好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180341
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180341,
					"content": "呜…呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180342
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180342,
					"content": "这个是疗效没那么好的，但是颜色看起来让人觉得很有食欲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180343
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180343,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180344
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180344,
					"content": "哇，真的一目了然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180345,
					"content": "不管是哪种，只要咕噜噜愿意吃，总归是对它恢复有帮助的。所以两种药剂都交给你们，具体用哪一种就看你们的判断啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180346
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180346,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180347,
					"content": "嘿嘿，真可靠！那我先回营地做一些准备工作，咕噜噜就拜托你们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180348
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180348,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}可是很可靠的伙伴，这次就交给它吧！",
