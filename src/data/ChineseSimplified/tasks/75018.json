			"dialogs": [
				{
					"id": 750180101,
					"content": "——嘎嘎嘎嘎嘎嘎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "「咕噜噜」"
				},
				{
					"id": 750180102,
					"content": "好孩子，别闹啦，不吃药的话身体怎么恢复…哎呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "玛兹嘉"
				},
				{
					"id": 750180103,
					"content": "#危险！{NICKNAME}，我们得去帮帮她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
