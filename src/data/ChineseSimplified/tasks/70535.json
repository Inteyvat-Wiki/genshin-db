			"trigger": {
				"objectNames": [
					"可莉",
					"丽莎"
				],
				"points": [
					{
						"sceneId": 1004,
						"position": [
							-17.092,
							0,
							9.653
						],
						"pointId": 235
					}
				]
			},
			"dialogs": [
				{
					"id": 705350201,
					"content": "嗯嗯！可莉知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350202
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350202,
					"content": "但是…鱼还是刚刚炸上来的最新鲜嘛，放火上烤一烤，又脆又香又好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350203
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350203,
					"content": "不用担心，小可莉，琴早就和我叮嘱过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350204
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350204,
					"content": "我已经向「猎鹿人」下单了，这几天，大厨会挑选刚从湖里钓上来的好鱼，快快入锅烹饪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350205
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350205,
					"content": "配上可莉最喜欢的调味粉和酱料，还有我准备的特制茶点，肯定和你炸鱼时的收获一样美味~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350206
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350206,
					"content": "好！那就听丽莎阿…丽莎姐姐的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350207
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350207,
					"content": "这几天，可莉一定专心在城里玩「嘟嘟可轰轰奇遇记」，不去炸鱼，不给阿贝多哥哥的朋友添麻烦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350208
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350208,
					"content": "#那可莉出发去找荣誉骑士{M#哥哥}{F#姐姐}和小派蒙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350209
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350209,
					"content": "嘿嘿，谁要找我们呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350210,
						705350211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350210,
					"content": "难得看见你们两个待在一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350212
					]
				},
				{
					"id": 705350212,
					"content": "#荣誉骑士{M#哥哥}{F#姐姐}！还有小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350213
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350213,
					"content": "可莉刚刚在想你们，你们就出现了，是有什么魔法帮可莉把消息传给了你们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350214
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350214,
					"content": "啊呀？小可爱和派蒙，你们来得可真是时候，都不用辛苦我写信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350215,
						705350216
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350215,
					"content": "是可莉的心意召来了我们！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350217
					]
				},
				{
					"id": 705350217,
					"content": "我们俩比较闲，原本想来图书馆找书看…但「嘟嘟可轰轰奇遇记」是怎么回事？听着比普通的书有趣多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350218,
					"content": "是丽莎姐姐给我做的新游戏哦，名字是我们一起想的。小派蒙一下子就记住了，好聪明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350219
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350219,
					"content": "原来丽莎还会设计游戏啊！我还以为丽莎的博学…是书看得多的那种！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350220,
					"content": "呵呵，我只是参考了学生时期用来消遣的一款游戏「滚滚炸炸菇」，改进了它的设计，没有花费多少心力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350221
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350221,
					"content": "只要能让小可莉开开心心地度过这段「特殊时期」，要我再多设计几种也没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350222
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350222,
					"content": "「特殊时期」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350223
					]
				},
				{
					"id": 705350223,
					"content": "对哦，我想起来了。刚刚你们好像还提到了阿贝多的朋友？最近蒙德发生了什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350224,
					"content": "这次的意外嘛，说来不大不小，但确实要谨慎处理——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350225
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350225,
					"content": "近期，果酒湖里出现了来自须弥的鱼类，放任它们肆意繁殖的话，有可能威胁到蒙德水域的生态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350226
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350226,
					"content": "还好小可莉悄悄溜出去玩的时候，发现了没见过的鱼，嗯…抓了两条上来，问了问凯亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350227
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350227,
					"content": "不然，等到一般人发现它们的时候，说不定湖里的原住民已经被赶到不起眼的角落里去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350228
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350228,
					"content": "假如水下的生物群体发生了变化，影响到果酒湖的水质，进而影响酒业…这就是关乎蒙德经济的大问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350229
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350229,
					"content": "嘿嘿，这一次可莉有功！琴团长知道了以后，还特别表扬了可莉哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350230,
						705350231
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350230,
					"content": "可莉立大功！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350232
					]
				},
				{
					"id": 705350232,
					"content": "居然还有这种事？真是好险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350233,
					"content": "目前，调查小队派出了一些队员，正对果酒湖进行勘测，找出这些鱼类「入侵者」的老巢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350234
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350234,
					"content": "这段时间，为防惊扰「入侵者」，可莉就不能带着她的「宝物」到处跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350235
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350235,
					"content": "调查小队使用的仪器非常灵敏，湖边一定距离内的爆炸也会对勘测造成影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350236
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350236,
					"content": "琴说，一直让小可莉闷在城里，她肯定会觉得无聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350237
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350237,
					"content": "阿贝多正忙着改进游击小队的实验型装备，凯亚刚好也去出差了，照看她的任务，就落在了姐姐我的肩上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350238
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350238,
					"content": "#现在不无聊啦！丽莎姐姐发明了「嘟嘟可轰轰奇遇记」，可莉很期待！想跟荣誉骑士{M#哥哥}{F#姐姐}和小派蒙一起玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350239,
						705350240
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350239,
					"content": "一起玩吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350241
					]
				},
				{
					"id": 705350241,
					"content": "嗯，「嘟嘟可轰轰奇遇记」的游戏桌就放在花园那边，我在「猎鹿人」下的订单，也会送到那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350242
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350242,
					"content": "一边享受美食、花香和清风，一边和小可莉玩游戏，这么难得的机会，可要好好享受一番哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350243
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350243,
					"content": "咦，丽莎这话的意思…是不和我们一起去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350244,
					"content": "作为游戏的设计者，我参与的话未免有点犯规啦，会影响到你们游玩时的惊喜哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350245
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350245,
					"content": "而且，我这个图书管理员还是要待在岗位上，尽到我最基本的职责嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350246
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350246,
					"content": "听着像是你又在找理由不出门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350247,
					"content": "乖，你们安心陪着小可莉去玩就好~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350248,
						705350249
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705350248,
					"content": "好耶，丽莎姐姐放心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350250
					]
				},
				{
					"id": 705350250,
					"content": "好吧，那我们回头再见哦，丽莎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350249,
					"content": "呜呜，辛苦丽莎姐姐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350250
					]
				},
				{
					"id": 705350240,
					"content": "玩到天黑！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350241
					]
				},
				{
					"id": 705350231,
					"content": "琴团长夸夸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350232
					]
				},
				{
					"id": 705350216,
					"content": "是巧合的魔法找来了我们！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350217
					]
				},
				{
					"id": 705350211,
					"content": "好像达成了什么重要的约定？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350212
					]
				}
			]
		},
		{
			"id": 7053503,
			"completionStepIds": [
				7053503
			],
