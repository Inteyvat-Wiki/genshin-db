							-803.176
						],
						"pointId": 5744
					}
				]
			},
			"dialogs": [
				{
					"id": 705350301,
					"content": "#就是这里了，荣誉骑士{M#哥哥}{F#姐姐}，这就是「嘟嘟可轰轰奇遇记」的游戏桌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350302
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350302,
					"content": "嗯！这里的环境确实很好，游玩的体验肯定很不错，丽莎选起地方来真是没得挑呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350303,
					"content": "那就拜托小可莉教我们基本的玩法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350304,
						705350305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705350304,
					"content": "嘟嘟奇遇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350306
					]
				},
				{
					"id": 705350306,
					"content": "嘿嘿，那我们就开始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705350305,
					"content": "轰轰开玩！",
