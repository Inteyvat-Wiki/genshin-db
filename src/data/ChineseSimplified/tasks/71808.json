			"dialogs": [
				{
					"id": 718080201,
					"content": "待苏醒之时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080202
					],
					"speakerTitle": "阿鸠"
				},
				{
					"id": 718080202,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "你是想要来见证「那位」的复苏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "阿鸠"
				},
				{
					"id": 718080204,
					"content": "你来得稍微早了些…不过，也不算太晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "阿鸠"
				},
				{
					"id": 718080205,
					"content": "她在说什么呀，完全听不懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718080206,
					"content": "呃，你在说什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "呵呵，你还没有意识到么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "阿鸠"
				},
				{
					"id": 718080208,
					"content": "对你来说，这样也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "阿鸠"
				},
				{
					"id": 718080209,
					"content": "回去吧，等到「那位」复苏的时候，你会明白一切的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿鸠"
				}
			]
		},
