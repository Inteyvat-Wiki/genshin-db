			},
			"dialogs": [
				{
					"id": 761170501,
					"content": "嗯，委托已经完成了，稍等，我把协会的酬金拿来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 761170502,
					"content": "雅珂达小姐，您的脸色不太好，是遇见什么麻烦了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 761170503,
					"content": "没事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170504,
					"content": "那请您稍等，我这就去拿酬金过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 761170505,
					"content": "雅珂达，你没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "虽然说是不给他找医生…但伊赫安提先生看起来很难受，不然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761170507,
					"content": "不用了。既然我说了会守规矩，就要守规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170508,
					"content": "他是你之前的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "他是我之前的「同事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170510,
					"content": "虽然伊赫安提很胆小，但他可是所有人里最会捞钱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170511,
					"content": "其他人都只是傻乎乎地去骗去抢，他却能用各种手段运作，让人们心甘情愿地把钱给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170512,
					"content": "我在和伊赫安提做「同事」的时候，他也经常会教我各种话术，还带着我到处吃好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170513,
					"content": "他是你的朋友么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "朋友？哈，当然不是，在那个鬼地方，没有傻瓜会和其他人交朋友，我们顶多算是「认识的人」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170515,
					"content": "他之所以会那么照顾我，也是为了在我面前炫耀一下自己的实力，带着我这个小跟班，还能顺便给自己长长威风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170516,
					"content": "但他之前的确照顾过我，我现在帮他，也是单纯想还他那个人情债而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170517,
					"content": "好了，请您收好这些酬金，雅珂达小姐，感谢您对协会的帮助！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 761170518,
					"content": "#嗯，这一份是给你的，{NICKNAME}，刚才也谢谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170519,
					"content": "我也该回「秘闻馆」了，要是老板突然想办事又找不到我，肯定又要开始念叨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170520,
					"content": "（…虽然说了不给他找医生，但买点镇痛的药送过去总行吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170521,
					"content": "（老板肯定有门路，让她帮帮忙，大不了我这个月工资不要了呗…呃，也不能全不要，不要一半吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170522,
					"content": "（对，就这么做，最好明天就把药拿给伊赫安提…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
