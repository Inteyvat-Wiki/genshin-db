			"dialogs": [
				{
					"id": 761170401,
					"content": "…呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170402,
					"content": "是谁来了？我没有钱…什么也没有，如果你们想要我的命，就拿去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170403,
					"content": "伊赫安提，我帮你把东西拿回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170404,
					"content": "…雅珂达？是你么，我听见了你的声音，但我的眼睛看不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170405,
					"content": "是我，伊赫安提，是我在你面前。你病得这么重，为什么不去找我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170406,
					"content": "落魄的野狗就算濒死，也不敢踏入富丽堂皇的城市…毕竟它之前挨过太多富人的鞭子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170407,
					"content": "我不是那样的人，奈…老板也不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170408,
					"content": "那我就更不能去了，如果有人知道你们会付出好心，那你们可能每天都要付出好心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170409,
					"content": "没人敢在老板面前这么不长眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170410,
					"content": "但你总是偷偷发好心，然后，再被那些受到你好心的人倒刺一剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170411,
					"content": "我向老板学了很多，没有人能刺伤我了，之后再也不会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170412,
					"content": "你就是不愿意收起好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170413,
					"content": "这是我自己的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170414,
					"content": "呵呵，也许这就是老大看重你的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170415,
					"content": "也许这就是我活到现在的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170416,
					"content": "哈哈哈…咳…咳咳！你说得对，雅珂达，你说得对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170417,
					"content": "…好了，伊赫安提，有什么我能为你做的，现在就说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170418,
					"content": "你还是这样，就不怕我突然讹你一笔？或者给你挖个大坑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170419,
					"content": "你不会这么做的，我们认识很久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170420,
					"content": "就因为这？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170421,
					"content": "而且，瞧你这副模样，还能怎么威胁我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170422,
					"content": "哈！总算有点长进，救一条骨头已经被抖散架的毒蛇，相对来说还算安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170423,
					"content": "那就帮个忙，把那个袋子里的画卷起来，塞进我兜里吧，我没力气把它拿起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170424,
					"content": "这幅画是我和妻子还有女儿一起画的，也是我如今在这个世界上唯一关心的事物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170425,
					"content": "其他的东西对我来说，都已经没有意义了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170426,
					"content": "要是从前的你听见这句话，肯定会笑得打滚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170427,
					"content": "可惜…这些我之前无比重视的东西，到头来，既无法挽救我的妻子，也救不了我的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170428,
					"content": "或许这就是盗贼的宿命吧。我们掠夺而来的东西，到头来都会被再掠夺走，最后，重新变得一无所有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170429,
					"content": "那枚我用来发布委托的吊坠，也是我最后的一点财产…哈哈…也不能说是「我的」最后一点财产。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170430,
					"content": "这是你偷到手的第一枚首饰，你和我说过很多次了，你还和我说过你用的手段，还有那个富翁发觉自己被盗后的表情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170431,
					"content": "是啊，现在它是你的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170432,
					"content": "这枚首饰的主人是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170433,
					"content": "是个至冬人，叫霍洛莫夫，曾经在挪德卡莱居住过，但现在应该已经回至冬了，你想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170434,
					"content": "我已经不是盗贼了，也不会把偷来的东西据为己有，这枚首饰本来属于谁，就应该归还给谁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170435,
					"content": "哈哈…哈哈哈哈…！你真是个…真是个傻瓜，雅珂达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170436,
					"content": "老大说得对，你这样的人做贼，一辈子也…咳咳…也发不了财…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170437,
					"content": "咳咳…咳…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170438,
					"content": "好了，不要再说话了。我这就回去给你找医生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170439,
					"content": "不用了，就让我去我应该去的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170440,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170441,
					"content": "雅珂达，你知道老大定下的「规矩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170442,
					"content": "…「企望安息者，应得安息。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170443,
					"content": "履行它吧，你明白我的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170444,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170445,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170446,
					"content": "我很高兴，来帮我忙的人是你，雅珂达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170447,
					"content": "可惜，我没有什么宝物给你，如果你想要的话，就把这个布娃娃拿走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170448,
					"content": "这是…可是那些娃娃，我不是让你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170449,
					"content": "啊，别误会。这是我自己做的，你之前做的那些娃娃，我都按你说的，全部烧光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170450,
					"content": "怎么样，我在眼睛彻底瞎掉之前，手艺还挺厉害的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170451,
					"content": "拿去吧，雅珂达。就当做是我最后的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170452,
					"content": "我会回来看你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170453,
					"content": "去吧，再见了，雅珂达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170454,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊赫安提"
				}
			]
		},
