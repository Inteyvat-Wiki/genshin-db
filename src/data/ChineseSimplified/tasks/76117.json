			"dialogs": [
				{
					"id": 761170201,
					"content": "…嘁，真是个穷光蛋，怎么什么东西都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170202,
					"content": "喂，卡列瓦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170203,
					"content": "谁…哦哟，雅珂达，真是稀客上门，有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170204,
					"content": "没事，你前几天抢了一个叫伊赫安提的人，从他那里拿了点东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170205,
					"content": "这些钱你拿着，东西拿出来。今天我发好心，这东西当我从你们手上买的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170206,
					"content": "不愧是背靠奈芙尔的人，瞧瞧这做派…真文明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170207,
					"content": "那我要是不给你，你又能怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170208,
					"content": "呼…卡列瓦，我拜托你，你和你的那群傻瓜兄弟，能不能做一次正常人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170209,
					"content": "雅珂达，你大老远的跑过来，想要从一个贼的手上「买东西」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170210,
					"content": "塞进怀里的肉，我还能丢出来给你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170211,
					"content": "怎么感觉，这场谈判已经破裂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761170212,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170213,
					"content": "我的错，卡列瓦。我就不该学着奈姐的做派，和你们打交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170214,
					"content": "你们这群白痴，唯一看得懂的谈判手段就是拳头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170215,
					"content": "#{NICKNAME}，来，我们一起放倒他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761170216,
					"content": "看不起谁呢，兄弟们一起上！新仇旧恨，今天我们一起报了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡列瓦"
				}
			]
		},
