			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#你好，{NICKNAME}！最近过得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401703,
					"content": "我的话被派蒙抢掉啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "挺好的，你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401705,
					"content": "我看派蒙是想加餐了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "哈哈，只怪你自己反应慢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401707,
					"content": "我的意思是，你就是「加餐」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "当然啦，我天天都想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401708,
					"content": "喂——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401709,
					"content": "噗…哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401710,
					"content": "好啦好啦，你们别吵啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401712,
					"content": "说吧，什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "我尽力而为。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "我这边也还不错，不过还有件事想要拜托一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401714,
					"content": "#嗯，也没有别的要求啦，只是需要{NICKNAME}再帮我开采一些晶石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401716,
					"content": "我相信你，可是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "请相信我，我一定会好好报答你的…只要你相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401718,
					"content": "为什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "你答应过给我一个解释。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "可是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401720,
					"content": "对呀，我们还不知道你为什么这么需要晶化骨髓呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401722,
					"content": "可是幕府垄断了晶矿市场。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "你知道晶矿不好卖吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "嗯…我需要钱旅行才能找到妈妈，所以要用矿石来换钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401725,
					"content": "你在做危险的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "我在担心你的安危。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "我知道，我会自己找门路的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401727,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401728,
					"content": "长次，我们已经是朋友了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401729,
					"content": "说不定这次，我们还能再帮到你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401731,
					"content": "这是什么市侩哲学…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "而且，你答应要报答我们了。那么可能危及你自己，导致我们拿不到回报的事情，我们也是有权了解的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401732,
					"content": "噗…派蒙说的没错啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401733,
					"content": "我收集晶矿也不完全是为了赚钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401734,
					"content": "我一直在想…假如爸爸妈妈也像大家一样，得了「祟神」带来的病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401735,
					"content": "或许这些晶石能用来制药也不一定。因为它们也是大蛇的骨骸上生出来的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401736,
					"content": "而且保本先生也提到过，这些晶石可能有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401737,
					"content": "可是…这也不是百分百准确的假说吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401738,
					"content": "嗯，但我们也没有别的假说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401739,
					"content": "等找到妈妈…或许还有爸爸，我就带他们去须弥。听说那里有治疗这种怪病的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401740,
					"content": "但在那之前，我也不能放弃任何一分治疗的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401742,
					"content": "你不用问也会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "希望你能好好利用那些晶石。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "好啦，我说的也够多了，还愿意帮这个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401744,
					"content": "谢谢！我不会忘记的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "长次"
				}
			]
		},
