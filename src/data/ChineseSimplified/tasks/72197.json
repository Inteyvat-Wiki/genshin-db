				"objectNames": [
					"长次"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "这些晶化骨髓应该足够了。接下来我就要启程去冒险咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401903,
					"content": "照顾好自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "一定常联系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "还是好担心这孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401905,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401906,
					"content": "喂，长次你不要再满嘴跑舌头啦！还好是遇上了我们…不然会被打的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401907,
					"content": "还有还有，遇到坏人想要套话，也不要对他们讲实话！一定要乱胡诌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401909,
					"content": "派蒙变成老外婆了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "还有还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401911,
					"content": "我相信他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "这么小的孩子自己一个人出去冒险，谁会放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401912,
					"content": "…真是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401913,
					"content": "哈哈哈哈！谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401914,
					"content": "希望我们以后还会见面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401915,
					"content": "一定要注意安全呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401916,
					"content": "我没问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401917,
					"content": "接下来我应该会去踏鞴砂，妈妈曾在那里工作过。或许还有人能告诉我她是否经过那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401918,
					"content": "再然后…我会想办法去鸣神岛。然后搭一艘至冬国的商船…之后的事情，随机应变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401920,
					"content": "你知道自己在说什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "你了解自己面对的风险吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401922,
					"content": "如果只因为不知道会面对怎样的风险，就不去做的话…这个世界上也不会有冒险家这种职业了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401924,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "一定要小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "哇…这孩子真是气人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401926,
					"content": "哈哈哈，放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401927,
					"content": "#你们也一路平安！顺便，{NICKNAME}，希望你也能早日找到亲人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "长次"
				},
				{
					"id": 721401928,
					"content": "嗯！借你吉言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
