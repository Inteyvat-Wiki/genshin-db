				"points": []
			},
			"dialogs": [
				{
					"id": 745170101,
					"content": "#果然，这边刚刚摆开兵棋，准备好想定的脚本，准领队{NICKNAME}就出现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170102
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170102,
					"content": "不是吧你，还真应了那句传闻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170103,
					"content": "「感知到战术对抗的火热温度后，准领队必将如枪弹般赶来，给出最准狠的指挥…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170104,
						745170105
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170104,
					"content": "看来我来得正是时候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170106
					]
				},
				{
					"id": 745170106,
					"content": "懂了，您觉得目前的铳枪的弹头初速还有提升空间，我也有这种感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170107
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170107,
					"content": "#哎，蒂蕾娜，你先收敛点！好不容易把{NICKNAME}吸引过来，正事要紧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170108
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170108,
					"content": "我明白我明白，关于铳枪的发展方向，可以稍后再闲聊。现在，准领队应该状态绝佳，随时可以大展身手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170109,
						745170111
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170109,
					"content": "是新的桌上推演吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170110
					]
				},
				{
					"id": 745170110,
					"content": "没错！根据特巡队面临的作战环境，对推演的各种设计和规则进行了迭代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170113
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170113,
					"content": "总之，现在的推演变得更有挑战性了，还准备了不少特别的想定，包括特巡队精锐留下的难题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170114
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170114,
					"content": "有的想定，我应付起来都触角发麻。就让我见识一下吧，准领队带兵打仗的能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170115
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170115,
					"content": "苦劳费好说哦，肯定能让您玩个痛快，又大赚一笔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170116,
						745170117
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170116,
					"content": "那我就好好展现准领队的能力！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170118
					]
				},
				{
					"id": 745170118,
					"content": "#你就看着吧，蒂蕾娜，就算{NICKNAME}认认真真，也会被第三个进攻想定卡住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170119
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170119,
					"content": "#那关也不可能难住{M#他}{F#她}！只是教官现在闲了太久，变弱了而已嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170120
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170120,
					"content": "你这小妞！我…你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170121
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745170121,
					"content": "我和你打赌哦，教官！就赌…夏沃蕾队长同款的那种限量竞赛弹药！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170117,
					"content": "拿钱玩推演，这事我在行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170118
					]
				},
				{
					"id": 745170111,
					"content": "其实还没太看懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170112
					]
				},
				{
					"id": 745170112,
					"content": "简单说来，之前我们在璃月进行了一场联合推演，回来后，我们又按照特巡队面临的作战环境，对其迭代了多种设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170113
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 745170105,
					"content": "枪弹的比喻不如闪电…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170106
					]
				}
			]
		}
	]
}