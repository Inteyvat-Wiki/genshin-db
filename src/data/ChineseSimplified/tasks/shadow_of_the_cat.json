					"content": "唔？汝等在做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220450302,
					"content": "在拍画片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "…那是什么？汝等，真是奇怪啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220450304,
					"content": "算了，汝等继续吧，只要别把神社弄乱了就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
