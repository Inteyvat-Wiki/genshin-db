			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "嗯…这种感觉不太对啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "旅行者！你来得正好，我正想找你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450104,
					"content": "最近我制作木雕的时候，总觉得…制作出来的木雕没有灵性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450105,
					"content": "毕竟是木雕嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "哎呀，不能这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450108,
					"content": "嗯…怎么和你形容呢？简单来说，我想要的「灵性」就是一种…活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450109,
					"content": "你看，代宫司大人虽然平时都在睡觉，但偶尔也会起来转悠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450110,
					"content": "转悠的时候，代宫司大人偶尔就会跳一跳，扑扑落叶，或者是伸伸懒腰什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450111,
					"content": "这些动作，就是我想要的那种活力。我想…以这种动作为原型制作的雕像，应该也有着我想要的那种「灵性」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450112,
					"content": "那你直接去观察呗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "哎呀，我这…不是不好意思去嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450115,
					"content": "代宫司大人怎么说都是发我工钱的老板，总是蹲在它旁边观察，总感觉会惹代宫司大人不高兴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450116,
					"content": "你应该和代宫司大人关系很好吧，就请你帮我去拍几张画片回来给我参考吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450117,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "那就拜托你了，拍好画片之后，就快点拿来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450118,
					"content": "如果拍不到那种动作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "没关系，不用专门拍那种大动作，以我现在的技术，也雕不好那种大动作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450120,
					"content": "只要拍下代宫司大人的一些小姿态，就足够我练习了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450113,
					"content": "寝子不就在那边吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "你要追求什么样的「灵性」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
