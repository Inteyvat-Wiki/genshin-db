			"dialogs": [
				{
					"id": 220450401,
					"content": "怎么样，你们拍到画片了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450402,
					"content": "已经拍到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "我看看…喔！这角度，这姿态，真不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450404,
					"content": "气势…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "绝对没问题，这些画片用来做参考再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450407,
					"content": "谢谢你帮忙旅行者，这些东西请你收下，我等会就去接着练习木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450408,
					"content": "哎呀，真不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 220450405,
					"content": "这些能做参考吗？",
					"roleType": "TALK_ROLE_PLAYER",
