			"dialogs": [
				{
					"id": 220470101,
					"content": "又没射中…到底是哪里出了问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470102,
					"content": "你还在练习射箭吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "您是上次的…多谢您上次为我做射箭的示范！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470104,
					"content": "多亏了您，我已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470105,
					"content": "能百发百中了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "呃，倒也没有到这种地步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470108,
					"content": "不过，现在我射出的十支箭里，已经有五支能上靶了…这都是多亏了您的示范。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470109,
					"content": "虽然离教官的要求还有一段距离，但我还是会继续努力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470110,
					"content": "对了，既然您在这里，能再为我做做示范吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470111,
					"content": "有了您的示范，我一定能进步得更快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470112,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "谢谢您，我一定会认真学习的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470120,
					"content": "示范的事情就拜托您了，我一定会认真学习的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				},
				{
					"id": 220470114,
					"content": "上次的问题都解决了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "您是说…姿势不标准、力气不够大、握弓的手不够稳…那些问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470116,
					"content": "老实说，我还在一步步地解决它们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470117,
					"content": "不过除了这些问题之外，我更担心的是…如果真的上了战场，我还能把学习到的技艺发挥出来吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470118,
					"content": "咳，但在烦恼这些问题之前，我还是得先锻炼好我的武艺才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470119,
					"content": "示范的事情就拜托您了，我一定会认真学习的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				},
				{
					"id": 220470106,
					"content": "能百步穿靶了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
