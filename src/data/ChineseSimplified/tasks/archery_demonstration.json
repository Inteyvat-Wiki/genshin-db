			"dialogs": [
				{
					"id": 220470401,
					"content": "您的射箭技艺，还是和之前一样精湛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470402,
					"content": "看清楚了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "是的，无论是您握弓的姿势，还是您拉弓的方法…我都认真看清楚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470404,
					"content": "但是，怎么说呢…越是看您的示范，越是能感觉到我和您之间的差距，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470405,
					"content": "先、先不说这些了，这些东西请您收下，多谢您愿意为我做示范。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470406,
					"content": "我等会就回去自己接着训练了，下次的目标，就定在…十支箭里上靶七箭吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				}
			]
		}
