					"speakerTitle": "正二"
				},
				{
					"id": 220470302,
					"content": "能重新布置一下标靶吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470303
					]
				},
				{
					"id": 220470303,
					"content": "没问题，我这就去布置标靶，等会您直接过去就好。",
