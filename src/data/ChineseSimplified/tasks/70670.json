			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"吉盖克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706700101,
					"content": "你好，想试试「风行迷踪」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700102,
						706700107
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700102,
					"content": "你还在招募人来试玩啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700103
					]
				},
				{
					"id": 706700103,
					"content": "是您啊！您上次玩「风行迷踪」时所展现的技术，让我印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700104
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700104,
					"content": "不过，虽然您玩起来游刃有余，但还是有不少人和我说这个游戏很难，要么游侠很难跑掉，要么猎手找不到人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700105
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700105,
					"content": "还有人向我抱怨，被猎手抓住的游侠在游戏结束前根本就无事可干，只能在一旁干看着，实在有些无聊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700106
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700106,
					"content": "唉，我也不知道他们说的对不对，所以就想再招募一批人来试玩，听听他们的意见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700120
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700120,
					"content": "咳，不说这么多了，不如你直接来试玩一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700121,
						706700122
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700121,
					"content": "游玩「风行迷踪」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700123
					]
				},
				{
					"id": 706700123,
					"content": "好吧，如果有兴趣试玩「风行迷踪」的话，就过来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700122,
					"content": "离开。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700123
					]
				},
				{
					"id": 706700107,
					"content": "「风行迷踪」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700108
					]
				},
				{
					"id": 706700108,
					"content": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700109
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700109,
					"content": "你应该知道，在之前的蒙德城里有一群「贵族」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700110
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700110,
					"content": "他们在蒙德城里暴行不断，让不少人都苦不堪言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700111
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700111,
					"content": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700112
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700112,
					"content": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700113
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700113,
					"content": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700114
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700114,
					"content": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700115
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700115,
					"content": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700116
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700116,
					"content": "曾经？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706700117
					]
				},
				{
					"id": 706700117,
					"content": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700118
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700118,
					"content": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700119
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706700119,
					"content": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706700120
					],
					"speakerTitle": "吉盖克斯"
				}
			]
		}
	]
}