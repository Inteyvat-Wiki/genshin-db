			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯努瓦·勒鲁瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "阿托斯的衬衫一千摩拉…莫蒂西娅的项链…啧啧，现在的年轻人真会花钱啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490202,
					"content": "你好，勒鲁瓦先生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "你好呀，我们是从欧芙小姐那里来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490204,
					"content": "你们向勒鲁瓦先生说明了来意。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "哈哈，这都是大半年之前的事情了，欧芙小姐居然还留着我当时的委托记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490206,
					"content": "没错，我的确是有过招募钟点工的想法。人不管年轻的时候多能干，到老了总归需要别人照顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490207,
					"content": "我辛苦了一辈子赚了这么一栋房子，到老了，发现自己孤零零一个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490208,
					"content": "之前我的确是为这件事难受过一阵，好在这会儿我有女儿和女婿来照顾我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490209,
					"content": "这两个好孩子乖巧又相爱，有他们陪伴，我没有什么不满意的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490210,
					"content": "所以说呢，年轻人，我现在已经不需要招募护工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490211,
					"content": "可惜白跑一趟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "你们也别失望嘛，我最不喜欢看到年轻人失落的样子，年轻人就应该微笑着享受一切美好的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490214,
					"content": "毕竟你们特意跑了这一趟，又是报社的欧芙小姐推荐你们来的，我这里还是有些活请你们做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490215,
					"content": "正好，我的孩子们出门去了，这会儿不在家，我一个人也忙不动。当然，报酬一样会给。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490216,
					"content": "哇，勒鲁瓦先生，你真是个大好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490217,
					"content": "哈哈哈，这孩子嘴巴真甜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490218,
					"content": "去吧，帮我清扫一下门口和屋后的污迹，顺便喂娜娜点鱼肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490219,
					"content": "哦，娜娜是我的猫，就是门口那只。我先代它感谢你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490220,
					"content": "听起来很简单嘛，没问题，交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490212,
					"content": "欧芙小姐真是的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
