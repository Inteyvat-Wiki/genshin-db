			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"欧芙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "关于新工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "哦？看来对你而言，「人间百态」的委托工作太没挑战性了。还是说最近你手头紧，缺摩拉了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490103,
					"content": "摩拉永远不嫌多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "嗯哼，这种心态倒是常见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490107,
					"content": "我这里最不缺的就是委托工作，除了冒险家协会，蒸汽鸟报社大概算是全枫丹廷最大的雇佣信息集散地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490108,
					"content": "虽然理论上来说，我们没必要承担这样的社会功能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490109,
					"content": "总之，既然你需要摩拉，那我给你推荐一个长期的工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490110,
					"content": "这是勒鲁瓦先生大半年前给我们「人间百态」版块的留言，勒鲁瓦先生我们这条街的人都认识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490111,
					"content": "虽然他年轻的时候名声不太好，不过这些年我倒是没再听说过他有什么不好的传闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490112,
					"content": "他一辈子独身，唯一的女儿又不在身边，身边没人照顾，确实需要一位钟点工帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490113,
					"content": "据我所知，勒鲁瓦先生不缺钱，所以给的报酬应该不会太低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490114,
					"content": "我想这份工作没什么风险，报酬也不错，不妨考虑看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490115,
					"content": "只要帮忙做做家务就好了吗？我觉得这份工作好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490116,
					"content": "请给我联络地址。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "好啊，勒鲁瓦先生的房子你转过两个街角，然后再绕到…啊算了，我给你一张地图吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490118,
					"content": "记得跟他说是我介绍你们去的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "欧芙"
				},
				{
					"id": 741490105,
					"content": "都有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "还真是个努力的年轻人啊，也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "欧芙"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
