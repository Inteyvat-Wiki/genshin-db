				"objectNames": [
					"伯努瓦·勒鲁瓦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "你们忙完了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490502,
					"content": "是的，勒鲁瓦先生。那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490503,
					"content": "想要糖果还是想要报酬当零花钱使啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490504,
					"content": "都、都想要，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490505,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "贪心的孩子，哈哈哈。没关系，小孩子嘛，就是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490507,
					"content": "尤其是像派蒙这样可爱的小姑娘，就应该吃着马卡龙，穿着漂亮的小裙子，住在漂亮的屋子里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490508,
					"content": "#我也这么觉得！{NICKNAME}，{NICKNAME}，我可不可以买…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490509,
					"content": "不可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#呜呜，讨厌，{NICKNAME}好吝啬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490511,
					"content": "派蒙，我们是冒险家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "但是这跟马卡龙、小裙子还有漂亮的大房子有什么矛盾嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490514,
					"content": "看你们两个，怎么斗起嘴来了？真是孩子气。不过能像这样斗嘴也很好，证明你们还是孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490515,
					"content": "其实我的年纪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "童年是不长久的，要珍惜啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490518,
					"content": "好了好了，报酬和甜点都给你们，这下别闹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490519,
					"content": "好耶，有点心！谢谢勒鲁瓦先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490520,
					"content": "称呼我伯努瓦就可以了，勒鲁瓦是我的姓氏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490521,
					"content": "整个枫丹廷现在只有我一个勒鲁瓦了，特地强调姓氏只会让我这个老人寂寞，还是称呼名字吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490522,
					"content": "勒…伯努瓦的女儿难道不姓勒鲁瓦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490523,
					"content": "莫蒂西娅她不是我血缘上的女儿，只是我半年前收养的女儿。不过对我来说，她就和亲生的女儿一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490524,
					"content": "你们乐意的话，明天也可以来，那时候莫蒂西娅和阿托斯就回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490525,
					"content": "请两个可爱的孩子帮点小忙，吃些点心，我想莫蒂西娅是不会有意见的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490526,
					"content": "偶尔也会有其他孩子到我这里来，你们可以一起玩。我很喜欢小孩子，小孩子多，家里热闹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490527,
					"content": "以后你们来的时候，如果没有见到我就敲门问问，阿托斯会给你们开门的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490528,
					"content": "那就说好啦，明天我们会再来的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490529,
					"content": "好，好，正好我也要进屋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490530,
					"content": "明天再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "再会，孩子们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741490516,
					"content": "这是关系好的证明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "派蒙，不要忘记旅行的目的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
