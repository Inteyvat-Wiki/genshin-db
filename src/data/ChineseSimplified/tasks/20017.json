					"法拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "别，别打我！别…咦？旅行者，那些家伙呢？已经被你赶跑了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170102,
					"content": "太好了！太谢谢你了…他们真的都走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170103,
					"content": "呼…多亏了你，不过这么一耽搁，我肯定赶不上这趟商队了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170104,
					"content": "而且，车也被这群家伙给打坏了，得赶紧修好运回城里去，不然水果非烂在车里不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170105,
					"content": "你绝对不想知道，这么多水果在车里烂掉之后，车上那股子洗不掉的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170106,
					"content": "我要在这把这些水果都检查一遍，我已经能闻到有不少水果坏掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 200170107,
					"content": "拜托你去周围帮我找找修车的材料吧，我觉得…一块<color=#00E1FFFF>结实的木板</color>就够用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法拉"
				}
			]
		},
		{
			"id": 2001702,
