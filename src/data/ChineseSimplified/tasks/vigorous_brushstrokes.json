			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"闻冀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716730101,
					"content": "嗯…总感觉这幅画里缺了点什么，是不是应该再找点灵感呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730102
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730102,
					"content": "你是在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730103
					]
				},
				{
					"id": 716730103,
					"content": "#哎，这不是{NICKNAME}么？久闻大名，久仰啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730104
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730104,
					"content": "如您所见，在下正遵照总务司的安排，在这里布置节日游乐之所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730105
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730105,
					"content": "呃…你要教人画画？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730106
					]
				},
				{
					"id": 716730106,
					"content": "哎，非也非也，并非是「教人作画」，而是「替人作画」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730107
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730107,
					"content": "这海灯节一年比一年盛大，来往的客人也越来越多，其中不乏从璃月之外远道而来的游客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730108
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730108,
					"content": "虽然总务司也为他们安排了无偿的「纪念留影」，但留影嘛，毕竟还是缺少了点璃月风味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730109
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730109,
					"content": "于是，总务司就命我来港口，替来往游客作画留念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730110
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730110,
					"content": "我看最近在璃月港内，「白马仙人」的传说最为炙手可热，就想着干脆以此为主题作画好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730111
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730111,
					"content": "所谓龙腾虎跃，龙马精神，替各位客人以白马奔腾为题，作一幅「腾跃之画」，再吉利不过了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730112
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730112,
					"content": "#怎么样，{NICKNAME}，你心中可有什么适合作画的意象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730113
					],
					"speakerTitle": "闻冀"
				},
				{
					"id": 716730113,
					"content": "那还挺多的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730114
					]
				},
				{
					"id": 716730114,
					"content": "噢？哈哈哈哈，那好啊，有灵感的话，就尽管说来，待我为你泼墨一番！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "闻冀"
				}
			]
		}
	]
}