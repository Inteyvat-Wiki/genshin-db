			"dialogs": [
				{
					"id": 752520701,
					"content": "重要的是，你在这附近见过一个光头吗？我找他有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520702,
					"content": "我也是来找他的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "哦？他刚才在这里是吗？看来已经跑了，是知道我正在追他了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520709,
					"content": "哼，伊凯卡…你跑不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520706,
					"content": "看在我们还算有缘的份上，劝你离那家伙和我都远一点，免得你这张漂亮脸蛋溅到白白红红的脏颜料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520707,
					"content": "这些是我在营地里搜出来的东西，我猜是他来不及带走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520708,
					"content": "送给你了，别有什么顾虑，这些东西现在是我说了算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520710,
					"content": "那家伙的命迟早也都是我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泰克胡"
				},
				{
					"id": 752520703,
					"content": "没见过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "你没骗我吧？我暂且信了你这张诚恳的小脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "泰克胡"
