			},
			"dialogs": [
				{
					"id": 737050201,
					"content": "…人气真的有那么高吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050202
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050202,
					"content": "内藏行走机构的方法还算巧妙，地形识别、远程控制和重量感应的模块也处理得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050203
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050203,
					"content": "但外观上，怎么看都只是普通的布偶，要不然，还是改改吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050204
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050204,
					"content": "珐露珊前辈，我来告诉您一条好消息——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050205
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050205,
					"content": "#{NICKNAME}和派蒙加入了我们，「稳健知行」机构的队伍变得更厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050206
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050206,
					"content": "嘿嘿，珐露珊前辈好！我们来帮忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050207,
					"content": "啊呀呀，这可不得了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050208
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050208,
					"content": "真不错，柯莱！居然请来了两位业内公认的顶尖专家，那不管我给出什么评测，协会都要乖乖点头咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050209
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050209,
					"content": "正好，你们看看这个「解谜伙伴」，感觉怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050210
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050210,
					"content": "喔…居然直接用了珐露珊的形象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050211,
						737050212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050211,
					"content": "感觉舒适又惬意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				},
				{
					"id": 737050213,
					"content": "这就要问学院的后辈们，还有解谜协会和遗迹机关研讨会的成员了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050214
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050214,
					"content": "他们通力合作的产物，明明有着相当高的技术含量，却要用孩子气的外表来包装。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050215
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050215,
					"content": "尤其是后辈里的阿尼斯，一个劲地解说采用这个外观的优势，比她给课题答辩时还拼命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050245
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050245,
					"content": "当下的年轻人啊，是不是太过沉迷于可爱的东西了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050216
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050216,
					"content": "我可以说嘛？感觉这样还挺不错的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050217,
					"content": "柯莱和安柏刚刚还解释过，可爱的伙伴能让冒险家避免过度紧张，安安心心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050218,
					"content": "如果和珐露珊前辈的布偶一起冒险，哪怕是走进了到处黑咕隆咚的遗迹，应该也不会紧张吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050219,
					"content": "这种考虑确实有道理，后辈们选定这个外形，也算是对我的某种尊重吧…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050220
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050220,
					"content": "不过，也有相当多的冒险者，更重视机关的可靠性和技术水平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050221
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050221,
					"content": "他们大概会认为，「机关就应该表现得坚硬，要能承受落石轰击，要表现出尖端的科技水平」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050222
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050222,
					"content": "这个「解谜伙伴」的外形太蓬松柔软，反而不会给人…厉害和可靠的印象，说不定还有可能让人分心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050223
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050223,
					"content": "如果换成磨砂金属的厚重外壳，方方正正，并且适当展现复杂的机件，视觉上的鼓舞作用会更强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050224
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050224,
					"content": "哪怕是我，也有过因为外貌年轻而被人质疑的时候。假如我一头白发，他们大概就不会说闲话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050225
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050225,
					"content": "真，真的吗，那我岂不是能让那些人信服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050226,
					"content": "啊？这…呃…这可不能混为一谈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050227
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050227,
					"content": "没想到珐露珊前辈…在这方面意外地严格呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050228,
						737050229
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050228,
					"content": "我觉得现在的外形还不错喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050230,
					"content": "#欸？连{NICKNAME}也支持？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050231
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050231,
					"content": "呃咳咳…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050232
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050232,
					"content": "#好吧！既然{NICKNAME}都这么说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050233
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050233,
					"content": "#我提议，之后就由{NICKNAME}来操纵「解谜伙伴」，尝试破开几个谜题典例。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050234
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050234,
					"content": "#我会好好评估{NICKNAME}运用这种机关的效率，然后根据你的表现，制作它的使用规范手册…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050235
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050235,
					"content": "至于外形的改进，还需要长期观察，我就暂时搁置迭代的建议好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050236,
						737050237
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050236,
					"content": "好耶！待会儿我一定好好表现！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050238,
					"content": "等到你们准备停当，就来找我吧。我已经选中了最适合的几个秘境，随时可以开始解谜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050239
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050239,
					"content": "#辛苦珐露珊前辈了，还请您稍等，接下来，我带{NICKNAME}和派蒙去看看最后一个项目…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050240
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050240,
					"content": "哪里哪里，柯莱才是费神费力了，注意别累着自己哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050241
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050241,
					"content": "#闲下来了，就叫上{NICKNAME}和派蒙来前辈这里坐一坐，歇一歇，吃些古法点心，慢慢聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050242
					],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050242,
					"content": "古法点心！我我我，我一定会来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050243,
					"content": "谢谢前辈，我也要带几盒上好的花茶来给您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050244
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050244,
					"content": "去吧去吧，好好表现！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珐露珊"
				},
				{
					"id": 737050237,
					"content": "我会让解谜机关发挥最佳性能！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050229,
					"content": "方方正正的外形下次再说吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050212,
					"content": "完全看不出是探险装备。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				}
			]
		},
