			"dialogs": [
				{
					"id": 737050301,
					"content": "接下来就是最后的项目了——为了长久发展而建立的「安全分队」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050302
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050302,
					"content": "多亏大风纪官赛诺先生从中沟通，「稳健知行」机构请到了迪希雅和坎蒂丝小姐，分别担任教官与协调员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050303
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050303,
					"content": "她们两位正在筹备战斗考核的事宜，应该也快回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050304
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050304,
					"content": "哟，在找我们？看来我们出现得正是时候？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050305
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050305,
					"content": "#{NICKNAME}和派蒙也要入伙吗？那事情就变得轻松愉快了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050306
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050306,
					"content": "久等了，几位，我们带回了合适的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050307
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050307,
					"content": "收集情报？这么正经？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050308,
						737050309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050308,
					"content": "听起来像是大战前的准备…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050310
					]
				},
				{
					"id": 737050309,
					"content": "难道在筹划什么进攻行动…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050310
					]
				},
				{
					"id": 737050310,
					"content": "那可不，毕竟是关乎普通学生安全的大事，不把沙漠里的危险分子犁个干净，说不过去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050311
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050311,
					"content": "玩笑先放一边吧，迪希雅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050312
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050312,
					"content": "#说不定{NICKNAME}听了你的话，会认真地拔剑出击，从这里打到沙漠尽头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050313
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050313,
					"content": "#把所有危险分子都干掉…以{NICKNAME}的效率，得在沙漠里住上好几年，每天从日出工作到日落才行吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050314,
					"content": "旅行也得停下来，完全不敢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050143,
					"content": "毕竟沙漠实在太大了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737050144,
					"content": "根本数不清总共有多少敌人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737050315,
					"content": "时间是最简单的问题，很多危险都没法直接用肉眼确认，比如隐藏在地下的毒蝎，睡在树上的恐怖大怪鸟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050316
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050316,
					"content": "只有到了它们跳出来拦住去路的时候，才有可能和它们正面过招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050317
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050317,
					"content": "这种时候，应该按照珐露珊前辈的叮嘱，结合安柏的侦察思路，好好算一算接敌概率，和行动时间的综合期望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050318
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050318,
					"content": "喂喂，你们两个还真开始盘算了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050319
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050319,
					"content": "其实远没有那么夸张，「安全分队」的职责，是确保外出考察的学生队伍中，有着可靠的随行护卫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050320
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050320,
					"content": "这份差事一部分包给了「炽光猎兽」与合作佣兵，一部分由考察队伍中经过战斗考核的强者自行承接。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050321
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050321,
					"content": "考察队伍准备前往危险地带前，必须在队伍中编入至少两名通过了战斗考核的专业人员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050322
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050322,
					"content": "而我和迪希雅刚刚收集好的情报，就关乎战斗考核的场地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050323
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050323,
					"content": "嘿，找到了一座魔物和贼匪盘踞的秘境，各种水平的坏家伙管够，正好借他们脑袋一用，验证护卫们的本领。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050324
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050324,
					"content": "这么听起来，只要监督考核的过程就可以了？其实是考官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050325,
					"content": "请放心，我和迪希雅会安排可靠人士轮岗，保证参加者的人身安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050326
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050326,
					"content": "目前还有个没解决的问题——考核的标准。毕竟，战斗不是做题，没有唯一的解法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050327
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050327,
					"content": "我们每个佣兵都有自己习惯的战斗风格，实战完全不成问题，可要当教官的话，路子略微有点一成不变…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050328
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050328,
					"content": "所以需要一位见多识广、战斗思维灵活的专家，来给出一份可供参考的理想答卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050329,
						737050330
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050329,
					"content": "这是我的专长，我来搞定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050331
					]
				},
				{
					"id": 737050330,
					"content": "我来这里就是为了帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050331
					]
				},
				{
					"id": 737050331,
					"content": "#对哦对哦，要说眼界宽和灵活变通，我不知道有什么人能比过{NICKNAME}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050332,
					"content": "#爽快！和{NICKNAME}合作就是这么顺畅、愉悦，像抹足了油和香料的烤肉排！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050333
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050333,
					"content": "#记得准备好答谢{NICKNAME}和派蒙的报酬，迪希雅。你听了合作要求后就答应了，还没仔细算过账。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050334
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050334,
					"content": "#没事没事！柯莱帮我们和教令院谈下的报酬，二八分成，我一，你一，{NICKNAME}和派蒙拿八成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050335
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050335,
					"content": "咦！我们居然拿八成吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050336,
						737050337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050336,
					"content": "是不是有点多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050338
					]
				},
				{
					"id": 737050337,
					"content": "感谢迪希雅关照！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050338
					]
				},
				{
					"id": 737050338,
					"content": "哈哈哈，我们就别见外了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050339
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050339,
					"content": "总之，安全分队的工作，由你们来定标准，我们负责执行和长期经营，你们苦劳最大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050340
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050340,
					"content": "我们以前就谈好过合作的计划了，这次正好开个漂亮的头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050341
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050341,
					"content": "那，那我会好好算账的，仔细列出酬金的明细，让你们一眼就能看个明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050342
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050342,
					"content": "麻烦你啦，柯莱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050343
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050343,
					"content": "还有坎蒂丝小姐，也请放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050344
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050344,
					"content": "关于阿如村粮仓这片土地的临时租金，我也成功让教令院点头，在之前的基础上提了三成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050345
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050345,
					"content": "感谢理解，这笔钱会被用来修缮村内的设施。考察队伍在阿如村落脚时，也能得到更舒适的体验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050346
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050346,
					"content": "#那我们就在「安全分队」的小站稍作整理，以便{NICKNAME}开展行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050347
					],
					"speakerTitle": "坎蒂丝"
				},
				{
					"id": 737050347,
					"content": "待会儿见哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050348
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 737050348,
					"content": "嘿嘿，柯莱这次可是毋庸置疑的核心人物呢，把大家团结在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050349,
					"content": "没有啦没有啦，我只是尽了自己最大的努力而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050350
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050350,
					"content": "还有很多事情要学，很多工作要协调…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050351
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050351,
					"content": "#总之，{NICKNAME}和派蒙，我们一起加油吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050352
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050352,
					"content": "好哦好哦！目标是——把「稳健知行」机构办得无可挑剔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
