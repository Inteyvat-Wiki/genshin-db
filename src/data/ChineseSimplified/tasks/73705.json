			"dialogs": [
				{
					"id": 737050101,
					"content": "#{NICKNAME}和派蒙！这边这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050102
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050102,
					"content": "欢迎来到「稳健知行」机构的主场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050103
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050103,
					"content": "请看，几个核心项目的设施已经搭建好了，大家随时都可以投入工作——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050104
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050104,
					"content": "喔！这种氛围，好像轻小说里提过的…「年轻冒险家们的第一个据点」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050105,
					"content": "唔…又有点学园庆典的感觉，大家聚在一起，仔细研究课题后，组队出发历练自己…让人跃跃欲试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050106,
						737050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050106,
					"content": "没错没错，充满干劲！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				},
				{
					"id": 737050108,
					"content": "虽然这个场地不像学园庆典那样豪华，但按提纳里师父的说法，教令院会给我们调配「最有效能」的资源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050109
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050109,
					"content": "学生和学者们前往危险地带之前，会来我们这里仔细咨询，甚至接受一番紧急训练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050110
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050110,
					"content": "如果有必要的话，我们会派遣专人加入他们的队伍，充当可靠的向导和安全员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050111
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050111,
					"content": "按照时下流行的叫法，这里是一半训练，一半实战的「前进基地」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050112,
					"content": "让新兵们意识到自己即将面对的挑战，好好锻炼一下拳脚，再踏入未知的领域，才不会手忙脚乱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050113,
					"content": "安柏？居然是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050114,
						737050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050114,
					"content": "侦察骑士的工作范围拓展了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050116,
					"content": "嘿嘿，惊喜吧？我也觉得意外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050117,
					"content": "本来啊，我只是趁着轮岗的空闲期，来须弥看望柯莱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050118
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050118,
					"content": "没想到柯莱倒是忙了起来，那我可不能坐在一边呆呆看着，就来扮演柯莱的副手好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050119
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050119,
					"content": "不好意思，安柏，没能让你好好休假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050120
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050120,
					"content": "没这回事啦，充实和松弛对半分的假期也非常不错嘛！这份临时工让我开了不少眼界哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050121,
					"content": "#而且，正是因为来帮你的忙，我才能在意想不到的地方遇上{NICKNAME}和派蒙，更值得庆祝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050122,
					"content": "等到这边的工作差不多稳定下来，我们一起去吃顿大餐，好好庆祝下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050123,
					"content": "好哦！在须弥和我们冒险最初认识的伙伴碰头，一起聚餐，肯定会像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050124,
					"content": "大份的蜜酱胡萝卜煎肉一样开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050125,
						737050126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050125,
					"content": "那我们早些开工，早点收工！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050127,
					"content": "好呀！我们言归正传——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050128
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050128,
					"content": "柯莱和我负责的项目是「高速侦察伙伴」，旨在运用机关技术，快速通过危险地带，勘测地形与魔物的详情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050129,
					"content": "根据生论派的研究，在危险的环境中，可爱乖巧的伙伴能让冒险者的心神安定，避免过度紧张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050130
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050130,
					"content": "所以我们参考柯里安巴和兔兔伯爵的形象，制作了侦察机关「翠星柯里安巴」和「赤红飞兔伯爵」，反馈还不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050131
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050131,
					"content": "收集了充足的信息后，教令院还会对侦察伙伴进行修改，推出各种不同外形的款式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050132
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050132,
					"content": "柯里安巴和兔兔伯爵快速冲刺…会是什么样的画面呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050133,
						737050134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050133,
					"content": "很对！两位是让人安心的伙伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050135,
					"content": "#由{NICKNAME}来指引两位侦察伙伴行动，肯定能获得非常独特的数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050136
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050136,
					"content": "等你们了解整个「稳健知行」机构后，就可以来尝试一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050137
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050137,
					"content": "接下来，请跟着我去和其他几位顾问见个面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050138
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 737050138,
					"content": "那位青色头发的姐姐也有一名很可爱的伙伴机关哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050139
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050139,
					"content": "不过，用途和我们的「柯里安巴兔兔伯爵组合」不同呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050140
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050140,
					"content": "我很期待她们的表现！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050141
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050141,
					"content": "第二个项目…也是熟悉的面孔，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050142,
					"content": "我们这就去和老朋友打个招呼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050134,
					"content": "一时间还无法想象那种情景…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050126,
					"content": "为了开心地聚餐，先认真干活！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050115,
					"content": "柯莱招兵买马的范围这么广？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050107,
					"content": "容我先看看派蒙喜欢的轻小说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				}
			]
		},
