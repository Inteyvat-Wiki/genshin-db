			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "居然是住在<color=#00E1FFFF>遗迹</color>里的吗？蒙德人偶尔也有奇怪的癖好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010702,
					"content": "请不要这么随意揣测蒙德人的居住习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010703,
					"content": "我倒是觉得更像那些不讨人喜欢的「捣乱分子」的作风呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010704,
					"content": "是丘丘人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "偷盗书本的事可不太适合丘丘人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010706,
					"content": "毕竟它们大概只会把书本点着来取暖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010712,
					"content": "还是<color=#00E1FFFF>深渊教团</color>作案的可能性大一些，毕竟本来就是些神出鬼没的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010713,
					"content": "况且…这遗迹入口的元素封印，也像是深渊法师留下的魔力痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010714,
					"content": "是封印吗，那要怎么解开呢…该不会又要花很多功夫吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010715,
					"content": "如果这点程度的元素力，就想把我拒之门外，那还真是小瞧人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010716,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010717,
					"content": "我们进去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010718,
					"content": "呜…哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010719,
					"content": "这就是工作中的丽莎小姐吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010707,
					"content": "是深渊教团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "不愧是你，跟我心有灵犀哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010709,
					"content": "是冒险家协会？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "嗯…从总是在地下遗迹钻来钻去的角度上确实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010711,
					"content": "但他们不会随便拿别人的东西…唔，更正一下，至少不会拿活着的人的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "丽莎"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "是<color=#00E1FFFF>《白之公主与六侏儒》</color>！我记得这个名字，应该就是它了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010802,
					"content": "是的哦，好在书本没有受到什么损坏呢，不然的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010803,
					"content": "不然的话？难道丽莎还有什么更厉害的惩罚方式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010804,
					"content": "呵呵，那大概就要运用一些我在药剂学上的成果了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010805,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010806,
					"content": "不过话说回来，这本书根本不是「禁书区」的书，所以才会放心借给一般市民啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010807,
					"content": "除了我做的标记之外，也没有任何异常的元素波动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010808,
					"content": "是喔。感觉完完全全只是一本普通的童话书而已嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010809,
					"content": "但为什么深渊教团…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "（很神秘，令人好奇…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "从图书管理员的角度来看，麻烦的工作已经做完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010812,
					"content": "既然对这本书这么感兴趣，不如转借给你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010813,
					"content": "那…那还书期限是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "我可不想受到「惩罚」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "期限是无限期哦。我会把你登记为「保管人」而不是「出借人」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010816,
					"content": "这是对值得信赖的好市民的特殊福利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010817,
					"content": "说是福利…怎么感觉只是把麻烦甩给了别人的样子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101010818,
					"content": "哦~？对我的工作有什么不满吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 101010819,
					"content": "没、没有！",
