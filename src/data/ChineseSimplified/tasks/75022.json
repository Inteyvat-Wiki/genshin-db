			"dialogs": [
				{
					"id": 750220404,
					"content": "唔…没办法把它叫醒吗，真是，气死人了！它不会是在故意装睡吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220405,
					"content": "嗯唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "睡倒是真的睡了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "（将梦话的内容说了出来…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "你是说，它是故意堵在洞口要吃的？完全就是骗吃骗喝嘛…有种上当了的感觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220410,
					"content": "哼哼！不过既然这样，就别怪我们不客气了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220411,
					"content": "#不如就让{REALNAME[ID(2)|SHOWHOST(true)]}钻进去，把那个宝箱取出来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220412,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "它不仁，也不能怪我们不义啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220407,
					"content": "说着梦话呢，不过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
