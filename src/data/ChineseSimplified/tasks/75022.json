			"dialogs": [
				{
					"id": 750220801,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "嘿嘿，干得好！让我们看看宝箱里都有什么宝贝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220803,
					"content": "啊，什么都没有，怎么只有一张纸条？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220804,
					"content": "原来留下纸条的才是它真正的主人？那，我们不是被这条龙骗了，是被它的主人骗了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220805,
					"content": "真是不负责任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "是啊，虽然他重病缠身，也不能把匿叶龙扔在这种地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220807,
					"content": "居然这样利用别人的贪心…不对，是利用对龙的同情心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220810,
					"content": "唉，总而言之，总不能继续让它骗吃骗喝，不如去找悬木人的首领，告诉他这件事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220811,
					"content": "向「悬木人」的首领瓦伊纳述说此事，并将他带了过来。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "哎呀呀，你们找我的时候我就有所预感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220813,
					"content": "没想到是「那个家伙」留下的龙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220814,
					"content": "「那个家伙」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "唔嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "是个做了错事的人，因为害怕被惩罚，主动离开了部族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220817,
					"content": "不过，罪人的名字这里就不作赘述了。可能他也觉得不是什么好事吧，你看，他自己也未在这样的信件后留下名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220818,
					"content": "原来他的龙选择了和他一起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "不，不能说是选择，龙是单纯的生灵，不擅长衡量对错，大多数时候依照情感，信任着自己的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220820,
					"content": "…果然，他还是本性难移，有点小聪明都用在欺骗的伎俩上，用这种手段骗别人，也骗自己的龙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220821,
					"content": "我们会派人定期给这只匿叶龙喂点吃的，毕竟是部族的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220822,
					"content": "至于「那个家伙」…哎呀呀，这还真是个悲惨的结局，不过我也不会同情他，人应该对自己的所作所为负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦伊纳"
				},
				{
					"id": 750220808,
					"content": "所以吃得太多会被抛弃的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "哇！不要开这种玩笑啦！它也有点无辜呢，说不定还在原地呆呆地等着主人回来，这才不肯挪开的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "派蒙"
				}
			]
