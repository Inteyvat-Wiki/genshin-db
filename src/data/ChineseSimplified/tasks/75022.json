			"dialogs": [
				{
					"id": 750220703,
					"content": "眼前的匿叶龙一骨碌咽下了眼前的食物。\\n你甚至没看清它是怎么吃下去的…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "它它它…好能吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220305,
					"content": "派蒙这下有对手了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "一份食物…好像不够？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "什么呀！我对美食可是很讲究的，才不会这样狼吞虎咽、囫囵吞枣…根本连味道都吃不出来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220308,
					"content": "#是…是喔！没看出来，这家伙原来是只「大胃龙」，还好{REALNAME[ID(2)|SHOWHOST(true)]}没有这么能吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220309,
					"content": "不过，它是真的饿坏了吧！好可怜，不然再给它一份好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220310,
					"content": "啊呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也想吃吗？我们先把这只龙龙喂饱，就给你吃好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220312,
					"content": "很饿的龙一骨碌咽下了眼前的食物。\\n你眨眨眼睛，还以为是同样的画面出现了两次…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "嗯嗯，这下总应该吃饱了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220314,
					"content": "喂！等等，你怎么又坐下来了！难道两份也不够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220315,
					"content": "哇，吃饱了就趴下去睡，一点都不想让开这个洞穴的样子嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220316,
					"content": "#怎么办呀{NICKNAME}，这家伙的行为我已经看不懂了…就算吃饱了要睡觉，也不要堵在洞口睡嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220317,
					"content": "它好像也没答应我们会让开。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "总感觉被骗了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "好生气，吃了我们那么多东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750220320,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#连{REALNAME[ID(2)|SHOWHOST(true)]}都看不过去了，{NICKNAME}，我们试试能不能把它叫醒吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
