			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐宁",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "又是三枚「老石」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740602,
					"content": "这两位「热心群众」上交的「老石」，我就好好收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740603,
					"content": "没想到这么快就找到了两枚，而且品相比我之前见过的都好上不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740604,
					"content": "唉…这让我想起以前我有的那枚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740605,
					"content": "你的那枚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740606,
					"content": "你自己有还让我们找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "是「以前」我有的那枚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740609,
					"content": "我爸在盛露厅，那枚「老石」是一小块过他手的边角料，品相也不是很好，他就把那枚石头当玩具丢给了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740610,
					"content": "我那时天天和他吵架，游手好闲，还流连岩上茶室，欠了一大笔钱，走投无路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740611,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740612,
					"content": "有点差劲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "这个，谁都有年轻的时候嘛，反正就是我走投无路之时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740614,
					"content": "正好有认出「老石」的人愿意花钱买，一块石头罢了，卖就卖了，得了摩拉解了一时之忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740615,
					"content": "结果前几日我爸聊起这件事时，说，「沐宁啊，你以前玩的那块石头怎么不见了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740616,
					"content": "我只好说，「一块石头而已，还能留到现在？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740617,
					"content": "嘴上那么说，心里却想着，要是当初没卖那石头，他聊起的时候掏出来给他看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740618,
					"content": "…算了算了，想这些也没用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740619,
					"content": "现在改正了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740620,
					"content": "你说的是…只不过以前欠的钱还是要慢慢偿还。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740621,
					"content": "不说了，如果还有「老石」，记得带给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740622,
					"content": "还不够吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "我想想，再给我三枚吧，再给我三枚应该够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740625,
					"content": "老石本来就是稀有矿材，辉山厅如果还要，层岩这边估计也找不到更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740623,
					"content": "到底需要多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "来，把你自己的先缴了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
