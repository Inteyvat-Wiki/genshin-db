					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107404,
			"completionStepIds": [
				7107403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107403",
							"2"
						],
						"stepId": 7107403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐宁",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "果然是「老石」，还真是多谢你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740402,
					"content": "委托你们真是正确的决定。若是委托冒险家协会，他们都不可能那么快找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740403,
					"content": "那可不一定，说不定冒险家协会他们会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740404,
					"content": "直接把委托转给我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "确实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740406,
					"content": "冒险家…嗯…以前我还挺羡慕那些冒险家的，每天不是上高就是下低，好像没有他们不敢去的地方似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740407,
					"content": "像我被派来层岩巨渊干了这么多年了，连层岩巨渊之顶…啊就是丹砂崖，都没上去过一次呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740408,
					"content": "你居然没去过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740409,
					"content": "丹砂崖，怎么说呢，就像是那种「很知名，但是本地人却不怎么去的旅游景点」一类的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740410,
					"content": "可能是想着，反正离得那么近，之后有空的时候总有时间去看一眼…结果一次都没去成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740411,
					"content": "不如现在就去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740412,
					"content": "想到就做也是很重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740413,
					"content": "免了免了，现在还不是我「有空」的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740414,
					"content": "更何况，那种到处跑腿的事，交给那群冒险家做就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740415,
					"content": "他们去的都是些很危险的地方，我要是去了，半路受伤的话…那可就不好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740416,
					"content": "确实，受伤是件很严重的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740417,
					"content": "若是我受伤的话，下面勘探队就会没人监督，矿工安全检查也没人负责了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740418,
					"content": "但凡有什么意外，就要出很严重的大问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740419,
					"content": "原来问题严重在这里吗…我还以为沐宁只是怕受伤而已呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740420,
					"content": "像是层岩巨渊周围那些高得要命的悬崖呀、深得不行的深涧呀…还有岩王爷留下的古战场呀，那种危险的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740421,
					"content": "我可是一点都不想靠近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740422,
					"content": "好了，这就是你们找这三枚老石的酬金。辉山厅对老石的需求还是挺大的，要是你发现了老石，这里按照三枚一批来收…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740423,
					"content": "当然了，也会给到相应的报酬，找到老石记得来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710740424,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
