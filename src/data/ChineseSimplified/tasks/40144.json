			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "是你呀小可爱。今天怎么有空过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440102,
					"content": "是想看看书，还是看看姐姐我呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440103,
					"content": "来看看丽莎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "呵呵，你还是这么贴心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440107,
					"content": "不过今天有些不巧，我正好在处理一项工作，暂时没法招待你们喝下午茶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440108,
					"content": "哇，丽莎居然在认真工作，也太少见了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440109,
					"content": "确实是呢，上次像这样埋头研究，好像还是在教令院的时候吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440110,
					"content": "久违地认真思考，还挺累人的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440111,
					"content": "难道是在写论文…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "呵呵，看你这么有兴趣，要考虑加入进来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440114,
					"content": "陪姐姐一起重温学生时代如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440115,
					"content": "不要突然把工作塞给别人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440116,
					"content": "#{NICKNAME}不愿意吗？这可是难得的，跟姐姐一起携手攻克难关的机会呀。顺带一提，报酬也会相当丰厚哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440117,
					"content": "愿闻其详。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "你应该知道，骑士团一直在进行炼金术的相关研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440120,
					"content": "但是大多数的课题都在实验室里进行，民众对炼金术的了解程度不是很高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440121,
					"content": "这样的结果就是，花了许多资金投入的研究课题，却没能产生更广泛的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440122,
					"content": "于是，琴打算在普通民众间推广炼金术的成果…现阶段来说，就是炼金药剂哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440123,
					"content": "平时除了图书馆的事情，我也会帮忙管理骑士团的药剂供应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440124,
					"content": "再加上药剂学是我以前的研究方向之一，在琴看来，我就成了这份工作最合适的人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440125,
					"content": "但要兼顾民众的日常需求，就得对炼制的材料做一些调整，炼制的方式也要做适当简化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440126,
					"content": "一来二去，原以为简单的课题，逐渐变得越来越复杂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440127,
					"content": "难道说，是要我们帮忙研究吗？可是炼金术的理论，我们了解得也不是很多呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440128,
					"content": "呵呵，不是的，姐姐已经想好了更适合你们的工作哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440129,
					"content": "虽然炼制技术的研究正在稳步推进，但如果不实际收集民众的使用反馈，就没办法知道能不能满足大家的需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440130,
					"content": "可如果要一边研发药剂，一边收集反馈，就需要效率更高的方式了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440131,
					"content": "我想到的办法是，直接开一家售卖炼金药剂的商店。这样就能一边炼制药剂，一边了解大家的日常需求了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440132,
					"content": "哦！把两项工作合并成一项…不愧是丽莎能想出来的方法呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440133,
					"content": "#是呀，而最适合这份工作的，当然就是我们骑士团的精锐——{NICKNAME}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440134,
					"content": "在教令院的时候，同学之间也会互相给对方的课题帮忙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440135,
					"content": "小可爱难道不想体会一下这种青春洋溢的生活吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440136,
					"content": "说的好听，其实还是想偷懒吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440137,
					"content": "就当是为了丽莎吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "呵呵，我就知道你最可靠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440141,
					"content": "等工作告一段落，姐姐会亲自准备报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440142,
					"content": "店铺的前期准备已经完成了，接下来的事情，我们直接到那边再聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440139,
					"content": "就当是挑战一下自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "嗯，你果然很有干劲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440118,
					"content": "要先看看是什么事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "难道是在做课题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "正好路过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "顺便来找我聊聊天吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "丽莎"
				}
			]
		},
		{
