						],
						"pointId": 300300753
					}
				]
			},
			"dialogs": [
				{
					"id": 401440201,
					"content": "这里就是我们要开店的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440202,
					"content": "哇，这么多的准备，都是丽莎一个人做完的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401440203,
					"content": "这是骑士团的大家一起努力的成果哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440204,
					"content": "开店所需的启动资金，是琴特意筹备的。炼制药剂所需的药材和设备，得到了阿贝多和砂糖的支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401440205,
					"content": "至于后续的物资补充，则是由后勤小队来负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "丽莎"
				},
				{
