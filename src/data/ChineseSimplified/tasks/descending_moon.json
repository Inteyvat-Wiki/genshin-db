			"dialogs": [
				{
					"id": 60160301,
					"content": "#{NICKNAME}，派蒙，很高兴见到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160302
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160302,
					"content": "菲林斯！你这边准备得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160303,
					"content": "还不错。我已经做好正面迎战多托雷的准备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160304
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160304,
					"content": "哦哦，这一次看起来比平时还认真些呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160305,
					"content": "说真的，我平时不怎么喜欢全力以赴。那不利于隐藏身份，对吧？再说，一个人应当有选择地展露实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160306
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160306,
					"content": "养精蓄锐，更好地赢下关键之战。目前我正处于这个状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160307
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160307,
					"content": "#能看到你认真，心里都踏实了几分。对吧{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160308,
						60160309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160308,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160310
					]
				},
				{
					"id": 60160310,
					"content": "能得到两位的信任，我很荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160311
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160311,
					"content": "还请好好休息。我衷心希望，能在决战中见到精神抖擞的你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60160309,
					"content": "感觉很安心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160310
					]
				}
			]
