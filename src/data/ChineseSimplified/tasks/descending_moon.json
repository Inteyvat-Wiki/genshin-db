			"dialogs": [
				{
					"id": 60160401,
					"content": "看什么呢？咏月使小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160402
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60160402,
					"content": "你对我的称呼还真奇怪。咏月使小姐、咏月使女士…都叫过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160403
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60160403,
					"content": "是啊，不行吗？这不都是你吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160404
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60160404,
					"content": "但我已经想好直接叫你奈芙尔了。",
