					}
				]
			},
			"dialogs": [
				{
					"id": 60160201,
					"content": "喔，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160202
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160202,
					"content": "桑多涅！进度怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160203,
					"content": "你们将成为第一第二个见到我得意之作的人…或者飘浮灵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160204,
					"content": "喂！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160205,
					"content": "不管了。来，都不许眨眼，仔细地看清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160206
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160206,
					"content": "哇，是个从来没见过的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160207,
					"content": "看上去很不得了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160208
					]
				},
				{
					"id": 60160208,
					"content": "这个计程仪直观表现了「术式」的进展。目前，它还在构建最重要的联结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160209
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160209,
					"content": "进程完成时，我会将它送到你身边。这样才能迎回哥伦比娅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160210
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160210,
					"content": "送到身边？如果只是计算结果的话，直接用通讯仪告诉我们不就行了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160211,
					"content": "…啧。你这小东西还真是没见过世面。这不是简简单单的「算式」，而是能够构建某种规则的「术式」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160212
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160212,
					"content": "…算了，说多了你们也不明白，总之只要知道它是哥伦比娅回来所需的必要条件就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160213
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160213,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160214
					]
				},
				{
					"id": 60160214,
					"content": "我把这些数据分享给你。尼可同意我使用她构建的信息通道，所以可以通过嘟嘟通讯仪，像这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160215
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160215,
					"content": "好了。现在你也可以查看进程了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160216
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160216,
					"content": "真的有欸！你好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60160217,
					"content": "废话，我一直很厉害，哈哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160218
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160218,
					"content": "嗯，我需要交代给你的就这些。接下来要是有空，也去看看其他人，监督一下他们，别让任何人掉链子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160219
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160219,
					"content": "在愚人众，这类监督不属于苛责的范畴。我只是希望一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160220
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60160220,
					"content": "目前术式还在运转，我不方便移动。你就作为我的第二双眼睛，去完成使命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
