					}
				]
			},
			"dialogs": [
				{
					"id": 60161901,
					"content": "我知道你们在搞些自以为挣扎的小花招，不过看起来，似乎没能坚持到进程的最后一步啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161902
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161902,
					"content": "让我猜猜，你们是想让哥伦比娅回来吧，那怎么没见到桑多涅？难道你们在为她争取时间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161903
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161903,
					"content": "有趣…这两位的性格可不常规，居然也与你们建立了如此深厚的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161904
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161904,
					"content": "说到哥伦比娅，我也曾将她视作妹妹。她在愚人众那些年，我们一度关系良好，相处愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161905
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161905,
					"content": "只是后来突然有一天，她不再愿意参与任何实验。我至今都不明白，是什么事让她不高兴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161906
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161906,
					"content": "多令人惋惜啊，我本可以有一个妹妹，一个家人的。她竟然不怎么喜欢我了，唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161907
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161907,
					"content": "你不配成为她的家人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161908
					]
				},
				{
					"id": 60161908,
					"content": "这我倒不否认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161909
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161909,
					"content": "那么多人热衷于扮演这陈旧的戏码，世界真是太迂腐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161910
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161910,
					"content": "还有你，本来也可以走向正确答案的。想到要这样杀了你…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161911
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161911,
					"content": "但我向来具备诚意，再给你一次机会吧。要不要与我合作？在我数到十之前，做出决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161912
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161912,
					"content": "一，二，三…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161913
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161913,
					"content": "（别开玩笑了！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161914
					]
				},
				{
					"id": 60161914,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161915
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161915,
					"content": "桑多涅？真难得，你居然也跑到这么高的地方来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161916
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161916,
					"content": "做事风格依然那么倒胃口呢。可别以为人人都要感谢你给的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161944
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60161944,
					"content": "（桑多涅？可现在术式的进度还没完成...）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161917
					]
				},
				{
					"id": 60161917,
					"content": "#来得真巧。我原本在和{NICKNAME}谈合作，看见你，我必须得说，真是太浪费了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161918
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161918,
					"content": "浪费？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161919
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60161919,
					"content": "我说过，会平等地给所有人一次机会。但你主动送上门来…那就是浪费了一次机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161920
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161920,
					"content": "哈！骗谁呢，以为我会信吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161921
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60161921,
					"content": "原本还想着解决完上面的事再慢慢处理你那个术式，也好，辛苦你特地上来，帮我省了不少力气呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161922
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161922,
					"content": "CS",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60161923
					]
				},
				{
					"id": 60161923,
					"content": "桑多涅——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161924
					]
				},
				{
					"id": 60161924,
					"content": "你看。机械造物是如此脆弱，轻轻一弄…就碎掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161925
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161925,
					"content": "不论桑多涅再怎么醉心发明，她一死，存在于她体内的术式也会停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161926
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161926,
					"content": "当然，能坚持到现在也值得夸奖了。同事一场，我有能力欣赏她顽固的态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161927
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161927,
					"content": "你，到这里来。在我身旁找个位置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161928
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161928,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161929
					]
				},
				{
					"id": 60161929,
					"content": "刚才，计数被打断了。但我破例给出的第二次机会还在，你依然可以趁现在加入我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161930
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161930,
					"content": "你分明已经理解这力量与权能，为什么不愿意迈向更完美的可能性？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161931
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161931,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161932
					]
				},
				{
					"id": 60161932,
					"content": "不想跟我说话？好吧，今天的你和平时不太一样，话变少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161933
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161933,
					"content": "那聊点实在的吧。就以桑多涅作为话题好了，她以前就这样，从不真正相信别人，也很不喜欢分享研究成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161934
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161934,
					"content": "严格来说，她并非毫无长处，能从无数的信息中提炼并优化出如今这个世界式，当真不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161935
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161935,
					"content": "但她总是不愿给出信任。要是能将术式交给别人来看护或执行，你们说不定还有一丝胜算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161936
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161936,
					"content": "击败顽固而笨拙的人，真令人痛心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161937
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161937,
					"content": "…多托雷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161938
					]
				},
				{
					"id": 60161938,
					"content": "你大概从没想过，人是会变的吧。哥伦比娅逃离那次也是，桑多涅这次也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161939
					]
				},
				{
					"id": 60161939,
					"content": "变？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161940
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161940,
					"content": "任你摆出何种姿态，我都能感觉到，你才是信不过别人的那种人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161941
					]
				},
				{
					"id": 60161941,
					"content": "在你看来，我是那样的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161942
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "赝月的异端者"
				},
				{
					"id": 60161942,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161943
					]
				},
				{
					"id": 60161943,
					"content": "现在的你，还能做什么呢？",
					"roleType": "TALK_ROLE_NPC",
