			"dialogs": [
				{
					"id": 746870301,
					"content": "好呀，顶班的来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870302,
					"content": "咦？怎么是你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870303,
					"content": "我…我们怎么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "感觉你好像认识我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870305,
					"content": "没有任何问题，很好很好，你们出了名的强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870306,
					"content": "在单位里的时候，回村里以后，大家都在说，什么事都能放心交给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870311,
					"content": "相比之下，那边的两位同事，虽然也都很可靠，但总感觉有点，说不上来的别扭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870312,
					"content": "人类的情感真复杂啊…要不要推他们一把呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870313,
					"content": "别扭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "算了，正事要紧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870315,
					"content": "总之加油吧，那部重炮的操纵并不难，期待你们三下五除二，把所有目标都轰得一个不留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870307,
					"content": "我们之前好像见过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "居然还记得我？之前「海薇玛映影欢乐城」招募员工的时候，我还给你投过简历呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746870309,
					"content": "好像，确实有这么一回事来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870310,
					"content": "我知道你们很强，什么事都能放心交给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "玛因"
				}
			]
		}
	]
}