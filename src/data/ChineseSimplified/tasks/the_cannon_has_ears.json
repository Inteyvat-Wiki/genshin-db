			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "前辈，事态已经持续半天了，魔物还是没有减少的迹象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870102,
					"content": "要不然，我还是去呼叫增援吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870103,
					"content": "不用慌张，相信我的重炮和那位便衣同事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870104,
					"content": "此外，对危机有着敏锐嗅觉的冒险家，甚至是某位长官…应该也会在第一时间赶来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870105,
					"content": "又有什么危机？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "出现了…准领队居然真的带着小助手来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870108,
					"content": "两位好，请让我简单说明事态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870109,
					"content": "嘿嘿，前辈先休息一会儿吧，说明工作交给我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870110,
					"content": "咳！想操纵重炮狂轰一番吗？海军舰队全灭后，这种机会可不多了，说是梦回几百年前也不为过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870111,
					"content": "用特制的弹头成片成片击倒魔物，怎么想都很解压吧，还能拿到警备队的奖金呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870112,
					"content": "用大炮轰魔物…这个我们的确在行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870113,
					"content": "听起来确实不复杂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "前辈，我理解你的喜悦之情。但现在应该紧张一点，还是让我来为准领队解释吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870116,
					"content": "最近，工人们无意间在附近的地下挖出了一座遗迹，惊动了里边沉睡的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870117,
					"content": "为了不让魔物外逃，警备队建立了防御阵地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870118,
					"content": "不过，说是阵地，目前只有我们两人和一位度假中的美露莘探员，还有我们改进过的一种炮台…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870119,
					"content": "噫！感觉有点危险！那位美露莘探员没关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870120,
					"content": "放心，通过远程操纵遗迹出口的重炮，那位美露莘探员不必亲自上阵，也能将大部分魔物拦住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870121,
					"content": "她确实非常可靠，但长期高强度执勤，肯定也会累的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870122,
					"content": "准领队，你愿意帮帮我们吗？要是情况一直不妙，我会找来更多增援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870123,
					"content": "#不不，谢妮，你也知道准领队的手腕，应该做最好的打算——{M#他}{F#她}用我的炮台直接消灭所有魔物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870124,
					"content": "你别说，还真有兴趣试试重炮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "放着眼前的事态不管，也不是我们的作风！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746870127,
					"content": "太好了，多谢你们愿意出手相帮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870128,
					"content": "上次实验之后，我又重新调整了自己的发明，希望你们用得顺手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870129,
					"content": "哎，要是重炮能自己瞄准、自己发射就好了，前辈觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870130,
					"content": "对啊！下次我可以试着给重炮加上警卫机关的识别模块，让它们自行值岗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746870131,
					"content": "不愧是前辈，真聪明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746870125,
					"content": "无论事态好坏，我都想来帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "但为什么突然轰魔物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "我们来得正好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
