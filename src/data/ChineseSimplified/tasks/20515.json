			},
			"dialogs": [
				{
					"id": 205150101,
					"content": "安娜又跑到哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150102,
					"content": "又找不到安娜了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "对啊，我都要把全城找遍了，就是找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150104,
					"content": "你也帮我找找吧，我已经累得走不动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150105,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "那就拜托你了，这丫头，她的病是快好了，再这么折腾下去，我就要得病了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150111,
					"content": "对了…之前安娜说，她一直想去教堂感谢修女们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150112,
					"content": "你不如先去教堂附近看看，还有，你可以去问问艾伯特先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150113,
					"content": "他是经常在教堂附近…呃，逗留的，说不定注意到了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150107,
					"content": "说不定已经成了冒险家了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "不可能啦，不可能，怎么可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205150109,
					"content": "你，你怎么突然不说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "安东尼"
				}
			]
		},
