			"dialogs": [
				{
					"id": 760370101,
					"content": "四个悬赏目标的信息都在板上，问我也行，但赏金多少没有商量的余地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370107,
					"content": "提交解决了悬赏目标的证据。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "关于悬赏目标…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "目前有四个目标，但只有三个有线索。被人指控欺诈而悬赏的须弥占卜师希丁芭，常在<color=#00E1FFFF>南边港口附近</color>出没。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370104,
					"content": "发狂的稻妻海乱鬼，途经<color=#00E1FFFF>空寂走廊</color>的游商中，已有多人命丧他手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370105,
					"content": "走私危险物品的帮派成员，据说盘踞在<color=#00E1FFFF>镇子北面海滩的营地</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370106,
					"content": "穷凶极恶的海盗，「裂颚」哈尔克，暂时没有线索，或许在什么地方潜伏起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370108,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "不送。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒塞克"
				}
			]
		},
