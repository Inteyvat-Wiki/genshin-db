			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.274,
							451.958,
							4735.029
						],
						"pointId": 17224
					}
				]
			},
			"dialogs": [
				{
					"id": 746940101,
					"content": "那这么说来，我抽到的这张牌还算得上是一张好牌啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940102
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940102,
					"content": "呵呵，命运就只是命运，从来都不分什么好坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940103
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940103,
					"content": "不过，单单从你抽到的这张正位「力量」来说，其中的一层含义，倒是很适合你的职业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940104
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940104,
					"content": "这张牌象征热情、勇气、自信与渴望，也象征完美的、不迷失的爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940105
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940105,
					"content": "无论面对何种突发事态，想必你都一定能主导并掌控局面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940106
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940106,
					"content": "哈哈哈哈哈哈，您别夸了，按照我们的规矩，抽到了好卦，要多多的给卦钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940107
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940107,
					"content": "喏，我把钱袋子放桌上了，要是您有空，不如帮我们船上的兄弟都看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940108
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940108,
					"content": "呵，我还是第一次听到这种请求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940109
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940109,
					"content": "我这一船的兄弟走南闯北，风里来浪里去的，这么多年了，每个人都揣着一肚子的难题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940110
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940110,
					"content": "我虽然是他们的老大，但有些问题，我也没办法帮他们解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940111
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940111,
					"content": "如今遇见了您这么一位卦师，才想着请您去船上，帮他们多少开导一下心结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940112
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940112,
					"content": "报酬的话好说，反正我们这一趟过来，也做了几笔大生意，赚了不少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940113
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940113,
					"content": "虽然听着很有趣，但还是免了。我这个牌盒里，可没有那么多牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940114
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940114,
					"content": "#咦，{NICKNAME}，派蒙？真是好久不见，你们也来这里算卦么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940115,
						746940116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940115,
					"content": "算、算卦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940117
					]
				},
				{
					"id": 746940117,
					"content": "当然是来做生意的，顺便来帮某人查探一下新生意的商路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940118,
						746940119
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940118,
					"content": "这个某人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940120
					]
				},
				{
					"id": 746940120,
					"content": "还能有谁，当然是咱们的天权星大人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940121
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940121,
					"content": "这女人不知道又想出了什么鬼主意，前几天突然告诉我，枫丹有好生意可以做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940122
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940122,
					"content": "还没等我说什么，她就摸出了一张详尽的计划表，让我按着上面的商路走就好，她已经派人过去查探过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940123
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940123,
					"content": "最近正好也没什么急生意，我就按着她说的来了，结果一来之后，所有事情都办得无比顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940124
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940124,
					"content": "本来准备忙活半个月的事，一个多星期就办好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940125
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940125,
					"content": "我想着来都来了，就干脆在这里再玩一会吧，就给兄弟们放了个假，让他们也去放松放松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940126
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940126,
					"content": "这不，昨天刚在德波大饭店包了个场子，和兄弟们好好喝了一场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940127
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940127,
					"content": "他们现在还在旅馆里睡着呢，我一个人出来吹风醒醒酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940128
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940128,
					"content": "不过嘛，刚走几步，就被这位…呃，卦师给叫住了，请我去抽一张牌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940129
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940129,
					"content": "你已经抽好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940130
					]
				},
				{
					"id": 746940130,
					"content": "喏，就是这张「力量」牌…看着是一张好牌，因为是正着摆的，所以更是好上加好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940131
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940131,
					"content": "正位的「力量」…怎么说呢，感觉上确实很像北斗呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746940132,
					"content": "确实。那么，我接下来要说其中所蕴含的另外一层意义了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940133
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940133,
					"content": "难不成，还有什么坏消息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940134
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940134,
					"content": "谈不上好坏，和占卜…呵呵，也没有直接的关系，就当做是占卜结束后的一点「课余奇思」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940135,
					"content": "无论是从外在的力量，还是内在的心灵来说，你都的确是一位强大的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940136,
					"content": "要打比方的话，你就像是在黑夜中的一盏灯火。你会驱散黑暗，会为迷失道路的众人指引前行的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940137
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940137,
					"content": "但你要知道，会被灯火吸引的，不只有迷路的弱者，还有趋光而行的虫孑。它们会依附在灯罩上，争夺光与热。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940138
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940138,
					"content": "灯火自信能够同样温暖它们，于是便要燃烧得更彻底。只有这样，光芒才不会变得黯淡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940139
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940139,
					"content": "若是有人能将这些跗骨的虫孑驱赶走，倒还好说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940140
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940140,
					"content": "但若是没有的话，也许终有一天，灯火也会为不值得的虫孑，燃尽自己的余薪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940141
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940141,
					"content": "…但这么想来，这个倒是不成问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940142
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940142,
					"content": "我有一个朋友，她向来很擅长替人解惑，而且…哈哈哈，也经常亲手驱除那些藏在角落里的虫蝇鼠蚁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940143
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940143,
					"content": "那还真是难得。听你的语气，你应该很信任那位朋友，而她也不像是会迷失道路的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746940144,
					"content": "她？哈哈哈，要是她是迷路者，那整个璃月就没几个认路的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940145
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940145,
					"content": "就好比这一趟，就是她给我指的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940146
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940146,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940147
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940147,
					"content": "哈，怪不得。我还说呢，要是那女人真心想做笔大买卖，哪还能容我在这里优哉游哉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940148,
						746940149
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940148,
					"content": "该说不愧是天权星吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940150
					]
				},
				{
					"id": 746940150,
					"content": "嘿嘿嘿，简单来说，原来是凝光想要给北斗放假呀，可是，她为什么要绕这么大一个圈子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746940151,
					"content": "那女人肯定会这么说：「有些圈子必须要绕，只有绕了，才能抄到近路。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940152
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940152,
					"content": "她脑子里的弯弯绕，我可弄不明白。呵…反正她还指着我帮她拓宽商路呢，总不会害我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940153
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940153,
					"content": "我这张「力量」牌，就好好地在前面劈波斩浪，勇往直前就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940154
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940154,
					"content": "…哎哟！怎么都这个点了，我得回去看看那群家伙，顺便让他们醒醒酒，为出航做准备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940155
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940155,
					"content": "#{NICKNAME}，派蒙，还有这位算卦的女士，之后有机会再见啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940156
					],
					"speakerTitle": "北斗"
				},
				{
