			"dialogs": [
				{
					"id": 750320201,
					"content": "怎么样，比不比？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320202,
					"content": "在限定时间内，尽全力沿固定赛道驭龙飞行并得到尽可能高的分数，<color=#00E1FFFF>只要超过第二高的分档就算你赢了我。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320203,
					"content": "我准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "好，爽快！去起点那里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320205,
					"content": "我还要再准备一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "没关系，等你有心情再说，本来飞行就应该是一件轻松愉快的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				}
			]
		},
		{
