				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "哈哈哈哈，很好，果然得承认年轻的总是要打败年老的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320402,
					"content": "就算是星星也有坠落的时候，更何况是人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320403,
					"content": "现在已经不是我的时代了，开开心心退役才是正确的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320405,
					"content": "但还是不甘心啊，我明明不老啊，皱纹都还没有呢，怎么就该隐退了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320406,
					"content": "太短了，我的生涯怎么会这么短，还没尝出站在顶峰是什么滋味，就开始下坠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320407,
					"content": "早知道会这么遗憾的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320408,
					"content": "算了，也不能这么说，能重来一次的话，我还是会做同样的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320409,
					"content": "会拼尽全力进入飞行队，以我的能力这根本不难，然后，还是会在这个年纪退役。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320410,
					"content": "没办法，我已经尽力了，不甘心也没用啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320411,
					"content": "…可能人生就是这样吧，无奈的事太多了，想要成为英雄就得接受闪耀只有一瞬这种事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320412,
					"content": "曼尤雅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750320413,
					"content": "#没事，{M#他}{F#她}飞得很棒。你刚才一脸同情，现在怎么又是一副不安的表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320414,
					"content": "哈哈，活着就是会遇上各种各样的事，接受也好不接受也好，反正它们都会发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320415,
					"content": "就当是前驭龙师教给你的经验之谈吧，我的问题需要我自己解决，不要因为我的失态坏了你的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320416,
					"content": "你做得很好哦，如果我弟弟也和你一样沉着冷静就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320417,
					"content": "曼尤雅还有弟弟呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750320418,
					"content": "是啊，我那两个怪脾气的弟弟可不像你们这么好说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320419,
					"content": "他们也在训练自己的飞行技巧，哦不对，阿科米蒂那家伙一心逃跑，说不定只会躲起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320420,
					"content": "不管这些臭小子们了，我看得出，你很有天赋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320421,
					"content": "有空的话不妨多试着飞一飞，说不定会被主动招入飞行队哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320422,
					"content": "我会多尝试的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "那就太好了，希望以后还能看到你飞行的样子，加油吧，年轻的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				}
			]
		},
