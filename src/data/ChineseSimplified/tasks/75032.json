			},
			"dialogs": [
				{
					"id": 750320601,
					"content": "龙也要归巢了，我要不要从天空的舞台上下场呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320602,
					"content": "继续飞吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "自言自语被你听到了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320606,
					"content": "我想自己会离开这里回家一趟，退役的事情我还没和家里人说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320607,
					"content": "往后我就有一大把闲散时间了，该做些什么比较好，这些事情也还没有想好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320608,
					"content": "调整好自己的心态之后，得面对接下来的人生阶段了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320609,
					"content": "先听听家人的建议比较好，我的父亲以前也是飞行队成员，退役之后做了训练师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320610,
					"content": "我走过的路他也走过，他应该会有些特别的看法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320611,
					"content": "所以这里的飞屋我会拆下来带走，但是赛道会留在这里，毕竟像你这样的年轻勇士总会需要练习的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320612,
					"content": "曼尤雅，我们以后还会碰到你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750320613,
					"content": "我不知道，不过我猜自己不管怎么选，最后都没法放弃天空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320614,
					"content": "只要你还会飞行，大概我们就还会遇上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320615,
					"content": "下次再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "下次再见，年轻的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼尤雅"
				},
				{
					"id": 750320604,
					"content": "…曼尤雅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "哦，你过来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
