			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「木偶」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "嗯？你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180102,
					"content": "你好呀！桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180103,
					"content": "谢谢你的邀请。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "咦？你信里不是说要开茶会吗？怎么这里什么都没有，你该不会没准备好茶点吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180106,
					"content": "哈，笑话。你还真是小看我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180107,
					"content": "哇！这…这桌子是怎么突然变出来的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180108,
					"content": "哼哼，厉害吧？这是我新研制的便携式茶桌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180109,
					"content": "它不仅方便携带、易于收纳，甚至还加装了和法洁欧一样的悬浮装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180110,
					"content": "更厉害的是…呃，算了，我就不自夸了，搞得像我在推销一样。你们自己感受吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180111,
					"content": "来，这是我准备的茶和点心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180112,
					"content": "那我不客气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "唔…！真好吃！你手艺果然很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180114,
					"content": "那是当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180115,
					"content": "不过，你怎么会想到要做这么一个装置呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180116,
					"content": "当然是为了和朋友们在任何地方都能度过一段愉快的茶会时光啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180117,
					"content": "之前我也说过。留住珍贵之物的方法并不只有坚守你已有的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180118,
					"content": "现在的我，变得想多出去走，多去见见朋友们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180119,
					"content": "但让收到邀请的人准备茶点收拾茶桌，未免太不符合淑女的礼仪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180120,
					"content": "嘿嘿，我倒是觉得朋友们不会在意啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180121,
					"content": "我在意。而且这种简单的发明对我来说也不费力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180122,
					"content": "看你们这么喜欢，干脆就送你们一个好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180123,
					"content": "欸？！这怎么行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762180124,
					"content": "没什么不行的。说了我很会做这些东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180125,
					"content": "那就谢谢了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "别客气，你们千灵节的时候也帮了我不少忙，就当是淑女的回礼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 762180104,
					"content": "希望没让你等太久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}