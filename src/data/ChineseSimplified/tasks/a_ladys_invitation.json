	"talks": [
		{
			"id": 7621801,
			"completionStepIds": [
				7621802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7621802",
							"2"
						],
						"stepId": 7621802,
