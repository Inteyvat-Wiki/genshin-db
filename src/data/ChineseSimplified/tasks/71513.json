			"dialogs": [
				{
					"id": 715130101,
					"content": "#你们好啊，{NICKNAME}和派蒙，海灯节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130102
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130102,
					"content": "谢谢你哦，你也要开开心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130103,
					"content": "海灯节快乐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130104
					]
				},
				{
					"id": 715130104,
					"content": "等等，你认识我们吗？请问你是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130105,
					"content": "我叫绘星，是「南十字」船队的航海士。这次海灯节期间，也负责筹备一些船队相关的活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130106
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130106,
					"content": "我从北斗大姐头那里听说过你们的事迹，你们也是胆识过人的豪杰，令人钦佩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130107
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130107,
					"content": "如果有什么关于「死兆星」号的问题，只要是我知道的，一定为你们作出最详细的解答！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130108
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130108,
					"content": "好客气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130109,
					"content": "我们确实想要仔细了解「死兆星」号啦，如果有什么好奇的事，肯定会来问你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130110,
					"content": "说起来，这次「死兆星」号上就多了不少海货和装饰，和城里一样热闹呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7151302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
