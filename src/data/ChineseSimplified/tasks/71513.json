				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"绘星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715130201,
					"content": "#好久不见了，{NICKNAME}和派蒙，海灯节快乐呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130202
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130202,
					"content": "谢谢你哦，绘星小姐，你也要开开心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130203,
					"content": "海灯节快乐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130204
					]
				},
				{
					"id": 715130204,
					"content": "我们发现「死兆星」号上多了不少海货和装饰，和城里一样热闹呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7151303,
			"completionStepIds": [
				7151301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151301",
							"2"
						],
						"stepId": 7151301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"绘星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715130301,
					"content": "还不错吧！所有装饰都是大姐头挑选的，她想让值岗的兄弟姐妹们有种待在家里过节的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130302
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130302,
					"content": "不仅如此，这次海灯节前，大姐头还给每个船员发了一笔奖金，组织了好几次盛大的聚餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130303
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130303,
					"content": "每次聚餐的饭菜都从有口皆碑的好店订购，除了我们常去的万民堂，还有新月轩和琉璃亭这样的大饭店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130304
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130304,
					"content": "大家都吃饱喝足，心满意足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130305
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130305,
					"content": "我也想看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130306,
					"content": "呜哇，过节的奖金，还有大餐？真好啊…没想到，北斗也有这么细致的一面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130307,
					"content": "其实大姐头一直都把船队的事务打理得天衣无缝哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130308
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130308,
					"content": "不止给我们这些船员发放了超优厚的薪水，以前过节的时候，还会给我们的家人准备礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130309
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130309,
					"content": "之前，大姐头还从天权大人那里得到了一些商业情报，改进了「南十字」船队的经营策略。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130310
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130310,
					"content": "船队的收入大涨了一截，大姐头也提高了我们的待遇。如此一来，船员们就能以最佳状态迎接各种挑战了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130311
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130311,
					"content": "即将到来的新人听说「南十字」船队的工作环境这么舒服，也会更有干劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130312,
						715130313
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130312,
					"content": "挑战？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130314
					]
				},
				{
					"id": 715130314,
					"content": "咦？海灯节期间，大家不都应该在放假吗？难道你们还要…加班？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130315,
					"content": "没那种事啦，你们放心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130316
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130316,
					"content": "大姐头事先调查了所有人的意向，安排一部分船员提前放假，另一批船员则稍晚几天休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130317
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130317,
					"content": "这样一来，所有人得到了充足的假期，也不至于把「死兆星」号孤零零地晾在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130318
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130318,
					"content": "我就属于前者，精神饱满地回到了岗位，好好规划我的训练考核「烟海梭巡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130319
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130319,
					"content": "盐海…什么巡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130320,
						715130321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130320,
					"content": "是新挑战吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130322
					]
				},
				{
					"id": 715130322,
					"content": "没错，你们猜得很准！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130323
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130323,
					"content": "这两年来，璃月港的海运贸易量正在飞速上涨，不少人加入了海员的行列。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130324
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130324,
					"content": "航海是一门对耐心、勇气和洞察力都有着很高要求的技能，海员们需要接受充分的训练，才能安全地驾驭船只。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130325
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130325,
					"content": "除了考取总务司规定的「四大证」和「五小证」，共计九种航海相关的资格证书，还需要为期两年的海上训练和实习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130326
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130326,
					"content": "九种证书？还需要额外两年的训练？这也太难了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130327,
					"content": "好严格！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130328
					]
				},
				{
					"id": 715130328,
					"content": "还好啦还好啦，毕竟在工作前做好严格的准备，总归是比出海后遇见没法应付的问题要划算嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130329
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130329,
					"content": "总务司会安排绝大多数的训练科目，足以应对一般情况下的航行，这些科目也不算太难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130330
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130330,
					"content": "当然，部分商船也有着穿过凶险海域的需求，希望给予海员们更充分的锻炼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130331
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130331,
					"content": "鉴于「南十字」船队应对恶劣海况的经验丰富，总务司和我们共同组织了强化版的航海训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130332
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130332,
					"content": "通过这些训练的船员，可以在证书上获得「危险海域通行资质」的认证，和总务司准备的奖品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130333
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130333,
					"content": "考虑到我对周围海域的海况最了解，大姐头就让我来规划这场训练考核…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130334
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130334,
					"content": "等等，说起来…你们两位好像也很擅长驾驶浪船？有兴趣来试试吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130335
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130335,
					"content": "不介意的话，还请你们留意训练设计的可取之处和缺点，给我反馈，好让我及时做出改进！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130336
					],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130336,
					"content": "唔，我确实也很想看看，船员们究竟需要多高超的本领，才能在最危险的海域航行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130337,
					"content": "而且也有额外的奖励呢，怎么想都很赚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130338,
						715130339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715130338,
					"content": "让我们见识一下吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130340
					]
				},
				{
					"id": 715130340,
					"content": "真有气势！那我就为你们标记出「烟海梭巡」的航道了，请加油哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "绘星"
				},
				{
					"id": 715130339,
					"content": "船员们独特的考验！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130340
					]
				},
				{
					"id": 715130321,
					"content": "和新人有关？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130322
					]
				},
				{
					"id": 715130313,
					"content": "新人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130314
					]
				}
			]
		}
	]
}