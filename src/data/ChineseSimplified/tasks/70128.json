			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "欸，这个瓶子沉甸甸的，好像里面有什么东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280102,
					"content": "「我们的老朋友昨天来了，带来了坏消息…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280103,
					"content": "「很久以来一直没有得到回应。或许他说的对，我应该接受现实。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280104,
					"content": "「但无论如何。假如你还在东奔西走，假如你收到了这条信息，希望你能回应我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280105,
					"content": "「随信附上你的徽章，以便到时候我会借它认出你。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280106,
					"content": "「还记得『乌有亭』吗？我们会在那里相聚，酒钱也随信寄来了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280107,
					"content": "「如果收到这封信的您，并不是我所期待的人…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280108,
					"content": "「也希望您留下这枚信物，或许您能帮助我寻得它的旧主，这些摩拉权作谢意。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		}
	]
}