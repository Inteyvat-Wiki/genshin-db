			"dialogs": [
				{
					"id": 751340201,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "呃啊，外面都被深渊侵蚀了，感觉随时会掉下来的样子，绿宝指给我们的难道就是这个东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340203,
					"content": "也不知道那里面是什么东西，反正我觉得肯定不会是什么祭坛啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340204,
					"content": "「只是一板一眼地盘逻辑的话…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "啊啊，我知道啦。而且就是因为这些深渊，绿宝才会不愿意进来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340206,
					"content": "不能放着深渊不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "确实，就是因为这些深渊，绿宝才会不愿意进来的吧，不能放着不管呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340208,
					"content": "#出发了，{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "喂，你们两个怎么把我排除啦，好过分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751340211,
					"content": "总之我们就先把这些脏东西清理掉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
