							2194.696,
							230.219,
							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "你点的「烈焰焦糖长诗」完成了，请慢用…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "还真是酒如其名，色泽如火…散发着侵略性的香气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490203,
					"content": "咳…似乎有点烈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490204,
					"content": "没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "没关系，只是需要时间来适应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490207,
					"content": "印象里，上次喝酒还是去年，被娜维娅邀请去了一次品酒会，浅尝过一小口希斯嘉葡萄酒，力道远远不如这杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490208,
					"content": "这和完全不喝也没区别吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "以理性思维而言，酒精容易让人眩晕，对工作不利，自然是别碰为妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490211,
					"content": "但送我去港口时，芙宁娜小姐提到，蒙德是「美酒与诗篇的国度」。既然都来了，自然要试试这里的特色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490212,
					"content": "确实，不然有点可惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "而且，据我收集到的情报，即将与我切磋的那位游击小队队长…就有着很强的美酒鉴赏力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490215,
					"content": "那位队长允许对外公布的战报，实在是赏心悦目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490216,
					"content": "而且，之前与我好好切磋一番的优菈队长…就有着很强的美酒鉴赏力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490217,
					"content": "她还送了我一瓶枫丹本土都已停产，只有海外还有存货的海露花果实汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490218,
					"content": "出于对这位好手十二万分的尊重，我也需要加深对蒙德美酒的了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490219,
					"content": "那我好好想想，再调一杯！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "麻烦你了，十分感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490222,
					"content": "克洛琳德在蒙德城里玩过了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "嗯，刚到蒙德第一天的上午，就四处逛了逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490224,
					"content": "娜维娅曾经做过考据——不少「桌上剧团」的场景和插画都参考了蒙德城的景观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490225,
					"content": "但，剧本中的城镇与蒙德的整体气质，还是区别很大。蒙德城给我留下最深的印象，是剑与盾的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490226,
					"content": "剑与盾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "可能是因为，我主要去了铁匠铺和训练场参观？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490229,
					"content": "最近蒙德新生产的武器与铠甲，采用了与枫丹完全不同的热处理工艺，表层渗碳的含量更高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490230,
					"content": "虽说韧性略差，但抗冲击性能大大提升。散发着一种…煮过头的咖啡味，嗯，还加了三勺满满的盐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490231,
					"content": "还真没注意过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "这种气息给了我良好的第一印象。因为，枫丹特有工艺的合金，经常用一种掺有茉洁草成分的保护剂来维护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490234,
					"content": "时间一长，那种淡淡的香味就会变得过于甜腻…令人牙疼。而蒙德的剑与盾所散发的气息，不会给我带来这种烦扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490235,
					"content": "学到了新领域的学问！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "当然，这个问题也有解法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490238,
					"content": "下次在枫丹再见时，我给你推荐另一款保护剂，质感清淡如水，没有多余的香气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490239,
					"content": "如果你也不习惯长久的甜味轰炸，这款保护剂应该能让你满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490240,
					"content": "克洛琳德平常都喝什么饮品？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "平常吗？如果是工作期间，我常喝咖啡。佐餐的话，我会倾向于偏淡的泡泡桔果汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490242,
					"content": "因为我常吃肉类菜肴，微酸的果汁能够减轻油腻感，长此以往，就习惯了酸味果汁的口感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490243,
					"content": "今天的交流结束后，热情的骑士们就请我吃了蒙德特色的料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490244,
					"content": "我尝过的八道肉菜都相当不错，分量惊人，使用的肉类品质扎实，而且处理的火候绝佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490245,
					"content": "当然，也有改进空间，比如蜜酱胡萝卜煎肉和堆高高…提供给外地游客的版本，酱汁的口味可以轻一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490246,
					"content": "听起来吃了不少…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "红肉料理的话，确实如此。这顿饭的热量足以支撑三天的工作，之后的用餐邀请，我都婉拒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490249,
					"content": "当务之急是解腻…总会有办法的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490250,
					"content": "这是骑士们送你的礼物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "没错，代号「果榛03」和「果榛05」的骑士送了我这枚徽章，我认为，它设计得相当精妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490252,
					"content": "他们说，这种纪念章刚刚定型，专门用于赠送给重要的宾客。专属于你的勋章，也还在设计中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490253,
					"content": "我第一次听说这两位骑士…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "…说的有道理，我也不可能记住每个沫芒宫文员的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490256,
					"content": "不过，你以后应该还会结识他们的，他们一看就是经验丰富的老兵，作为文职，还穿着全套铠甲上班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490257,
					"content": "安排好我的事务后，他们就去酒馆聚会了，说是要继续昨晚的对局，分出个酒量的高下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490258,
					"content": "前一天晚上喝下成桶的啤酒，第二天居然能清醒地上班，并且不露破绽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490259,
					"content": "蒙德的风格就是这么随意嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "也就是说，蒙德人有着看似随性，实则能够准确把握喝酒「分寸」的习惯，值得敬佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490262,
					"content": "说起来，艾梅莉埃小姐也来过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "哦？看来她已经忙完了委托，效率真高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490264,
					"content": "回到枫丹后，我大概可以告诉希格雯，准备购入她的新香水了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490265,
					"content": "咦，你好像还挺了解她的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "或许称不上了解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490267,
					"content": "来蒙德的途中，我碰巧和艾梅莉埃小姐乘坐了同一艘船，闲聊了几句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490268,
					"content": "之前常听希格雯夸赞她的杰作，这次交流一番后，我发现…她是一位难能可贵的，淡雅的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490269,
					"content": "淡雅？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "温柔、从容，但不会与他人走得太近…可能是职业原因吧。这样的感觉，我觉得很理想，能让内心长期维持宁静…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490272,
					"content": "不太明白…以后邀请你们再聚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "感谢，不过也不用特意为我们创造互相熟悉的机会。我们的工作没什么交集，人际关系圈也没多少重叠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490275,
					"content": "顺其自然就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490276,
					"content": "艾梅莉埃偏好茶类，克洛琳德呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "难道，你已经开始考虑之后招待我们的细节了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490278,
					"content": "经过之前的尝试，我猜测，我能接受的烈度应该和艾梅莉埃相近，最多就到果味利口酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490279,
					"content": "到时，你给我们准备类似的饮品，总归是妥当的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490280,
					"content": "我找到改进配方的思路了，请稍等。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "好的，我也做好了心理准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490282,
					"content": "就算这杯依然有点烈，也尽量试着喝完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490273,
					"content": "回枫丹后，请你们一起来玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "这个形容有点高深。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "蒙德人习惯了下班喝酒放松！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "骑士团真是个好多好多人的组织…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "蒙德特色的肉类料理都尝过了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "原来剑的材料还有这么多门道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "克洛琳德的比喻真厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "为什么来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "我改改配方，争取让你满意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "只要控制住量，应该还好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "没有喝酒的习惯就别勉强哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "来杯水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
