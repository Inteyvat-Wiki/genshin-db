			},
			"dialogs": [
				{
					"id": 705490301,
					"content": "这杯新作品…就叫「悠闲雷光」好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "决斗代理人专享特调，请用！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490303
					]
				},
				{
					"id": 705490303,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490304
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490304,
					"content": "嗯？是用了果味的淡酒吗？这种口感非常不错，对我来说恰到好处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490305
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490305,
					"content": "盐雕的淡淡咸味，和入口时的果酸，柔和的焦糖甜味混合在一起，每种都处于最佳的边界线上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490306
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490306,
					"content": "名字和酒的颜色很搭，雷光这个词的意象，也对上了「烈焰焦糖长诗」的火元素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490307
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490307,
					"content": "不过，「悠闲」是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490308,
						705490309
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490308,
					"content": "不觉得蒙德很悠闲吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				},
				{
					"id": 705490310,
					"content": "原来如此…确实很契合这杯酒给我的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490311
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490311,
					"content": "它独特的香气和口感，会在我对蒙德的记忆中，占据最关键的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490312,
						705490313
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490312,
					"content": "克洛琳德喜欢就好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490314,
					"content": "你觉得，如果时机得当，你有兴趣在咖啡馆，或德波大饭店，再扮演一回调饮师吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490315
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490315,
					"content": "咦，为什么这么问？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490316
					]
				},
				{
					"id": 705490316,
					"content": "就我个人的层面，自然还想喝到你的杰作，但我主要是为娜维娅还有芙宁娜小姐这么问的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490317,
						705490318
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490317,
					"content": "当然没问题，让大家都尝尝看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490319,
					"content": "明白了，我不会强求…总之，感谢招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490320
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490320,
					"content": "现在，无论是面对那位强大的游击小队队长，还是与骑士们交流系统性的战法，我都处于最佳状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490321
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490321,
					"content": "现在，无论是总结和优菈小姐比试的要点，还是与骑士们交流系统性的战法，我都处于最佳状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				},
				{
