				]
			},
			"dialogs": [
				{
					"id": 705490101,
					"content": "嗯，确认了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490102,
					"content": "在附近徘徊时，我就察觉到熟悉的气息，走近一看，果然是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490103,
					"content": "你好啊，克洛琳德！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "要是夏洛蒂小姐看见了这一幕，肯定会为你连拍数百张画片，并写下如下报道——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490106,
					"content": "#《辉煌执剑者{NICKNAME}的兼职生活，每杯调饮都千金难求》…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490107,
					"content": "第二天，你就会登上各大报纸的头条，可能还会有大量枫丹游客慕名而来，将这里挤得水泄不通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490108,
					"content": "想象了一下，场面有点夸张…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "幸好这次，我婉拒了夏洛蒂小姐随行的请求，上述情景不会发生，让我们默默庆祝此刻的清闲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490111,
					"content": "言归正传，请给我一杯「烈焰焦糖长诗」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490112,
					"content": "…看你的表情，似乎还有很多事想问我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490113,
					"content": "先给你调酒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "从容不迫，游刃有余，原来你对这门工作颇有心得啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 705490114,
					"content": "你边喝，我们边聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "真要这样，我会招架不过来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "请坐，我的客人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
		{
			"id": 7054902,
			"completionStepIds": [
				7054906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
