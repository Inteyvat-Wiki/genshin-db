			"dialogs": [
				{
					"id": 721380401,
					"content": "#辛苦你了，{NICKNAME}。如果造成了困扰的话十分抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380402,
					"content": "不会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "我用你采到的药材调配了新的药方，只是没有试验药效的对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380405,
					"content": "#所以能否请{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380406,
					"content": "请直说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#能否请{NICKNAME}见证我服药的效果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380408,
					"content": "新的药方性质还很不稳定，目前还没办法预测最坏的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380409,
					"content": "所以我希望至少有人能够见证我的成功…或者替我处理失败的后果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380410,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "哪里的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
