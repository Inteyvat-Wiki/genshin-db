	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"保本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "哇啊！我…我不是什么可疑人士，只是本地的医师而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380102,
					"content": "不信的话，我可以带你们去我的住处，你们缺什么直接拿走就好，请放过我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380103,
					"content": "或者带我去找你们的总大将九条大人！他认得我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380104,
					"content": "可能你误会了什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "欸…？你们看起来不像是幕府军的人…也不像是珊瑚宫来的那群家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380107,
					"content": "你们是…外国人？为什么会出现在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380108,
					"content": "这个嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "唉…不管怎样，你们还是快点离开这里为妙。现在的八酝岛很危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380111,
					"content": "到今天为止，「祟神」还没有消散的迹象，天领奉行也没有撤军的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380112,
					"content": "这座岛已经不再适宜居住了，更遑论观光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380113,
					"content": "如果你是为了逃避奉行方追捕而逃来的外国人，就再往西去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380144,
					"content": "天领奉行不欢迎来历不明的逃亡者，但海贼说不定会收留你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380114,
					"content": "岛上发生了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "哼…你自己看看吧。城里人和珊瑚宫的家伙们给我们带来了什么好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380117,
					"content": "先是踏鞴砂的爆炸，那天的夜空都被染上了奇怪的色彩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380140,
					"content": "很多亲友没了工作、衣食无着，很多人回家时伤得很重、模样很悲惨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380141,
					"content": "也有很多朋友…没能逃出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380118,
					"content": "然后，珊瑚宫的家伙破坏了镇压大蛇遗骨的镇物，「祟神」暴起，岛上人人死走逃亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380119,
					"content": "「祟神」带来的怪病也在不断蔓延，这里的居民大多病入膏肓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380142,
					"content": "恐怕传入两军营地，也只不过是时间问题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380143,
					"content": "这里是什么地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "这里原本是稻妻炼制「玉钢」所需的晶石的首要产地。只要矿石不枯竭，我们不必受城里的大人们太多制约，就能过得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380121,
					"content": "现在呢？现在岛上已经没有几个活人了…我是说，像我这样，还能好好说话的「人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380122,
					"content": "为什么不离开？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "谁不愿意离开呢？天领奉行大人的公子也曾延请过我…他现在应该还在军中督战吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380124,
					"content": "「你有医术，与寻常百姓不同。留在岛上实是危险，不如来做我的军医。我可以直接将你保举给父亲大人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380145,
					"content": "他是这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380125,
					"content": "没打仗之前，给鸣神岛的奉行大人治病，是我这种乡村小医生想也不敢想的殊荣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380126,
					"content": "但现在…你想想，奉行大人身边名医不会少，可八酝岛呢？这里的病人只有我一个医生可以依靠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380127,
					"content": "所以我不会离开，也不会专门给某一方的军士看病。我的敌人只有「祟神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380128,
					"content": "有什么可帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "没什么…唔，算了，我确实需要帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380130,
					"content": "我需要一些特殊的草药来调配药方，尝试治疗「祟神」引起的怪病。虽然不知道效果会如何…但试试总是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380131,
					"content": "只不过…那些草药被「祟神」所沾染，又大多分布在危险的环境里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380146,
					"content": "要么被天堑相隔、要么有怪物盘踞，而且这些地带「祟神」肆虐最严重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380132,
					"content": "以我的胆量和能力，怕是很难应付得来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380133,
					"content": "而且我作为医生，不敢冒着这么大的风险采集药材，便只能使用慢效的保守疗法…久久实验不出新的药方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380134,
					"content": "外国人，我看你随身携带着「风之翼」，想必是经验丰富的旅行者了。这种程度的危险，应该很容易便能克服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380135,
					"content": "所以，希望能辛苦你在这些地点帮我采到合适的药材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380136,
					"content": "等采到之后，来这里与我会合。请不必担心报酬，我还有些积蓄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380137,
					"content": "虽然只是素不相识之人的委托，希望您务必考虑一下。多谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380138,
					"content": "顺便，希望你一路小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				},
				{
					"id": 721380115,
					"content": "你看起来很沮丧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "说来话长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "确实可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
			"completionStepIds": [],
