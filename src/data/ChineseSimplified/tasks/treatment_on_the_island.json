			"dialogs": [
				{
					"id": 721380201,
					"content": "啊，你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380202,
					"content": "请问你采到我所说的药材了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				}
			]
		},
		{
			"id": 7213803,
			"completionStepIds": [
				7213807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213807",
							"2"
						],
						"stepId": 7213807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213802",
							"3"
						],
						"stepId": 7213802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"保本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380301,
					"content": "没错，没错，茎叶没有损坏，而且还很新鲜…谢谢，非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380302,
					"content": "就是这些吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "很好，这些足够了。新药方的研究可以开始进行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380304,
					"content": "再次感谢你的努力，这里是之前答应你的报酬。希望不要嫌弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380305,
					"content": "顺便，外国人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380306,
					"content": "啊，抱歉。麻烦了你这么多事，还不知怎么称呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380307,
					"content": "#叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}，如果你还有意帮忙的话，就请过一阵子再回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380309,
					"content": "当然，报酬是不会少的，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				}
