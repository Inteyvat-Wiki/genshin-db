			"dialogs": [
				{
					"id": 756710101,
					"content": "啾啾，咕咕，啾啾啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710102,
					"content": "这是在…干什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710103,
					"content": "密，密文？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "是哦！是和可爱团雀沟通的技巧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710106,
					"content": "哦，我好像忘了和你们打招呼了，还有那句必不可少的开场白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710107,
					"content": "两位路过的好心人，生论派的学者、新星商人和可爱动物专家拜希麦五世向你们问好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710108,
					"content": "请放松身体，放空思绪，听我说一件重要的事————",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710109,
					"content": "团雀最可爱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710110,
					"content": "完全正确！恭喜你被团雀的可爱感染，开始了抢答！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710111,
					"content": "奇怪，不知道为什么，好像看见桌上的游戏，脑袋里就冒出了这句话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710112,
					"content": "#你有印象吗，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710113,
					"content": "我们和这位女士以前见过吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "没错！还不止一面之缘哦，看见你们还是如此活力满满，我感觉心里很温暖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710117,
					"content": "总之，要不要来试试我身边这个游戏？第十七版，也就是第三世代的「哐哐当当雀雀球」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710118,
					"content": "在轻松休闲的游玩之间，还可以了解大大的朱羽古团雀战胜贼鸥的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710119,
					"content": "好哦好哦，轻松休闲的游戏，我们一直都很喜欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756710120,
					"content": "现在就玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "嗯！希望你们能找到最适合自己的玩法，发现独一无二的乐趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710121,
					"content": "开局开局！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "现在开始「团雀最可爱」也行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "对的！就算暂时想不起以前的事，也没关系，重要的是享受现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "拜希麦·五世"
				},
				{
					"id": 756710104,
					"content": "暗，暗号？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
