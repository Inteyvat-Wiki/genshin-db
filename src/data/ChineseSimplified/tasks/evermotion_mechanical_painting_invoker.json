				"points": []
			},
			"dialogs": [
				{
					"id": 705330101,
					"content": "没想到，我的发明居然还有这种用处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330102,
					"content": "喔！你好，旅行者，没想到咱们又见面了…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330103,
					"content": "我还以为你离开蒙德了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "我是有这个计划，不过嘛…万事万物总是变化无穷啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330108,
					"content": "咳，这些暂时不提了，咱们说正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330109,
					"content": "这次，我是接受了蒙德城冒险家协会的邀请，专门以一种卡牌的牌面为原型，用齿轮和机关创作了好几幅可以拆解再拼接的「械画」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330110,
					"content": "那个卡牌叫什么来着…对！「七圣召唤」，没错，就是这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330111,
					"content": "据他们说，这几幅「械画」会分别送去这次「召唤王大奖赛」的举办区域，再做个什么小活动，让大奖赛的氛围更热闹一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330112,
					"content": "唉，这些事对我来说实在是太复杂了。我还是专注于我的发明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330113,
					"content": "对了，蒙德的「械画」就在我身边，如果您想要试试拼接它的话，就请来体验一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330105,
					"content": "你的发明又出问题了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "没有！这次没有，呃…不如说一开始就没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "菲利斯·尤格"
				},
				{
					"id": 705330107,
					"content": "之前我请您帮忙那次，纯粹是因为魔物的问题，和我的发明没有关系嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "菲利斯·尤格"
				}
			]
		}
	]
}