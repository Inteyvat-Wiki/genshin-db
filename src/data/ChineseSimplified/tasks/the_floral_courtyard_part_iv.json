			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柴染"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "两位，这一天终于来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900102,
					"content": "对于「花影瑶庭」的构图之道，你们已经领会到了精髓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900103,
					"content": "是时候来一场花艺的真剑试炼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900104,
					"content": "等等？原来我们已经领会到精髓了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900105,
					"content": "真剑试炼的意思是最难的题目吧！我突然有点害怕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900106,
					"content": "明明接触插花的时间还不长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "制作花材的手法的确需要长期的磨练，而规划「花庭」的图景与结构，更侧重意会和灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900108,
					"content": "只论后者，两位的确表现出了惊人的天赋，不再需要「花题」的锤炼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900109,
					"content": "或许是因为，两位经历过迷人的旅程，见证过我无法想象的景致，才有了不同于平凡之人的心境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900110,
					"content": "是，是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900111,
					"content": "#说起来，{NICKNAME}，我们的确去过不少地方了呢，原来一起旅行的过程中，我们也会获得更多灵感啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900112,
					"content": "那这段时间，我们一直在学习花艺，又消耗掉了多少灵感呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900113,
					"content": "旅程还会继续下去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "嗯，有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900116,
					"content": "谢谢你，柴染小姐！要不是有你点拨，我们还没发现我们居然有这方面的才能呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726900117,
					"content": "不必客气。请用至美的「花庭」为这次的花艺体验之旅划上句点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900118,
					"content": "请出题吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "那么，今天的花题是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900120,
					"content": "「斜枝宛虹，绘染斑彩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900121,
					"content": "期待着你们技艺大成的「花影瑶庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900122,
					"content": "还有别的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "没关系。「插花」需要安神定气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900124,
					"content": "等到二位忙完手头的事，摆脱了喧扰，必定能将题中的「花庭」构筑得更加完满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柴染"
				},
				{
					"id": 726900114,
					"content": "灵感会越来越多的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
