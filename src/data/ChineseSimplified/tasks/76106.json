			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "堂堂愚人众就只有这种程度的本领？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "现在的新人说话怎么都这么呛人呢…等一下，仔细看你好像不是这次招进来的新人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "沃莉斯菈娃"
				},
				{
					"id": 761060403,
					"content": "还企图撒谎混入我们的队伍，被我看穿了吧？给我拿下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沃莉斯菈娃"
				}
			]
		},
		{
