					"马塔伽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "很好，非常好！你超过了我，可喜可贺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290202,
					"content": "我在这里独自特训也是希望有一天能超过这个由我自己创造的成绩，可惜直到今天我也没有做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290203,
					"content": "但你做到了，这证明是时候出去看看了，外面还有很多远比我优秀的勇士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290204,
					"content": "和他们切磋、交流的话，我的水平也会得到提高，有一天，我绝对能得到父亲和姐姐的认可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290205,
					"content": "阿科米蒂就算了，那家伙一点志气都没有，居然跟我是亲兄弟，真是耻辱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290206,
					"content": "阿科米蒂…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "不，没什么，闲话到此为止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290208,
					"content": "勇士，以后也要坚持磨砺自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290209,
					"content": "既然想要成为传奇，就要奋力向前冲！冲！冲！这就是我留给你的临别赠言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塔伽"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
