			"dialogs": [
				{
					"id": 750290101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290102,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "哈哈哈哈哈哈！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290105,
					"content": "呜哇，吓人一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290106,
					"content": "会来到这里，你们也是想要参与特训吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290107,
					"content": "果然，人也好，龙也好，拥有进取心的勇士会互相吸引！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290108,
					"content": "不要浪费时间了，我们现在就来进行特训吧！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290109,
					"content": "果然这里也有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "我们还什么都没说呢，怎么突然就变成来参与特训的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290112,
					"content": "不过这个口气，难道你是训练大师之类的人物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290113,
					"content": "训练大师也不是谁都可以做，我倒不是那么厉害的角色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290114,
					"content": "但你们从下面一口气飞到这里，原来不是为了参加我马塔伽的勇士特训吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "马塔伽",
					"speakerSubtitle": "花羽会勇士预备役"
				},
				{
					"id": 750290115,
					"content": "只是路过看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "明明有驭龙飞行的基本水平，却没有进取心，浪费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290118,
					"content": "本来以为是志同道合的勇士…可惜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290119,
					"content": "我竟然误判了…可耻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290120,
					"content": "该说纳塔不愧是英雄的国度，还是说纳塔人均热血含量超标呢，连小朋友都这么积极。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290121,
					"content": "小朋友，不至于不至于。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "大错特错，决定了要成为勇士不能放任自己懒散！没气魄、没胆量、没志向的人绝对不可能成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290124,
					"content": "而且我已经十二岁了，从年龄突破一位数的那天起我就告别了「小朋友」这个称呼，不过我原谅你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290125,
					"content": "怎么喝牛奶也不松动的不过是我的身高，不会折断不会弯曲、能斩断一切阻碍的是我的意志！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290126,
					"content": "况且，我的个子还会再长，你们俩的个子不也算不上高吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290127,
					"content": "好、好热血的发言，但为什么突然拐到我们身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290128,
					"content": "哼，虽然不得不承认肉体力量受体型影响，但勇士怎么会受区区肉体限制！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290129,
					"content": "精神的高大远远胜过肉体的高大，所以要有足够的信念，必须相信怀抱着远大梦想的自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290130,
					"content": "这种浅显的道理，就算是冒险家也能理解吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290131,
					"content": "说的是没错，但我总觉得，他刚才…是不是骂了我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290132,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "我在向懒散的你们解释志气的必要性，悠闲又怠惰，怎么可能成为英雄？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290135,
					"content": "作为勇士，不…作为一个人类，没有光荣的志向，没有在训练场上挥洒过汗水，就是失败！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290136,
					"content": "不能以英勇的姿态翱翔于天空，不能被训练大师们认可，就是失败！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290137,
					"content": "所以必须努力训练！你们明白了吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290138,
					"content": "明、明白了！怎么办？他嗓门好大，听起来好有道理，我竟然无法反驳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290139,
					"content": "很好，准备好磨砺的话就来找我进行特训！目标是：尽全力沿固定赛道驭龙飞行并得到尽可能高的分数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290140,
					"content": "我会观察训练者在每个赛道节点的表现，然后打分。最终成绩按照分数高低分四档。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290141,
					"content": "使劲飞！就算达不到最高档评价，至少也要达到第二好的评价档！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290142,
					"content": "燃烧你的意志，追上我的影子，向前冲！冲！冲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290143,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290144,
					"content": "勇士，我在等你的回答！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290145,
					"content": "明、明白了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "再大声点！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290147,
					"content": "明白了！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "这里是有抱负的未来勇士们用来自我磨炼的地方，拿出魄力来，不断挑战这个世界！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290149,
					"content": "准备好了就来找我进行训练！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290150,
					"content": "明白了！但是我不想训练！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "什么？都说到这种程度了还是没办法抛弃自己的惰性吗！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290152,
					"content": "这很糟糕，但是没关系，总有一天你们会无法忍受自己的失败！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290153,
					"content": "永远逃避、永远退缩就什么都不会拥有！只有奋力前进才能站着大笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290154,
					"content": "哼，记住我的话，等到那个时候，再来这里磨砺自己，也不算晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290133,
					"content": "怎么骂人呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "你有点极端了，小朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "别小看冒险家的好奇心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "什么特训？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
