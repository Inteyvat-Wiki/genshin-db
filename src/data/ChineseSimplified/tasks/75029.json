				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马塔伽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "勇士！用这条赛道练习得怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290502,
					"content": "有进步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "懦弱！没有进步就等于退步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290506,
					"content": "该怎么说呢，马塔伽的字典里好像除了「向前」、「拼命」之类的词，没有其他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290507,
					"content": "不错，我的字典比别人的薄！因为除了奋斗和努力，其他的东西我统统不承认。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290508,
					"content": "你们需要练习，我也需要，仅仅练习与龙的合作，我还不算全能的勇士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290509,
					"content": "我必须前往更大的舞台磨砺自己！也就是说，我会离开这里一阵子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290510,
					"content": "你们放心！这里的赛道我会保留，但是这座飞屋我会拆下来带走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290511,
					"content": "打算去哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "唔…去看看我爸，还有姐姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290515,
					"content": "嗯？马塔伽的语气怎么变弱了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290516,
					"content": "有什么不对！爱护、尊重家人也是勇士理应具备的美德！狭隘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290517,
					"content": "我爸爸是花羽会最专业的训练大师，我姐姐是最厉害的驭龙师！我为他们而骄傲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290518,
					"content": "好啦，我没有拿他们开玩笑的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750290519,
					"content": "知道了，祝你顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "你也顺利！勇士！这次的临别赠言是：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290521,
					"content": "我想想…永不放弃，不计血泪，成为英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290513,
					"content": "打算怎么锻炼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "唔…可能会先问问爸爸还有姐姐的意见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "马塔伽"
				},
				{
					"id": 750290504,
					"content": "最近没空练习。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "懒惰！在无意义的闲逛中浪费人生去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "马塔伽"
				}
			]
		},
