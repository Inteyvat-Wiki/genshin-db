			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "#怎么办…这要怎么办…算算时间{M#他们}{F#她们}就快来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050102,
					"content": "我们来啦！哎哎尼可，别把我们推出去呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050103,
					"content": "咳咳…不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050104,
					"content": "是还没准备好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "该怎么解释呢…不行，说不清楚，只好从头说明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050106,
					"content": "——具体就要从魔女们第一次挑战风神时说起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050107,
					"content": "这也太早了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050108,
					"content": "唔，太过分了，要我亲口说出来真的好丢人…算了，没办法了，事实就是事实…只要艾莉丝不知道的话应该不会被取笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050109,
					"content": "她心里面想的话好像又漏出来了，而且，她也没办法亲「口」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050110,
					"content": "嘘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "我临时把羽毛藏去了书房最高的地方，想着增加难度的话，完成挑战的成就感也会变强…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050112,
					"content": "但我实在不擅长控制那些随性的风，好像到了一定高度之后，无论如何都飞不上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050113,
					"content": "不能用魔法把羽毛重新挪下来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050114,
					"content": "那就没有游玩的意义了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050115,
					"content": "好吧，也对…那还真是个死局…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050116,
					"content": "尼可，能再说一句话吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "什么话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050118,
					"content": "在希穆兰卡，语言就是魔法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "啊！我明白了——！让我们试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050121,
					"content": "唔，太过分了，要我亲口说出来真的好丢人…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "算了，没办法了，事实就是事实…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "只要艾莉丝不知道的话应该不会被取笑…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "如果能让你的语句成为阶梯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
