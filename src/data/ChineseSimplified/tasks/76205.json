			"dialogs": [
				{
					"id": 762050301,
					"content": "拿到啦！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050302,
					"content": "虽然…虽然现在脑袋还在嗡嗡响，为了搭梯子，她说话的时候好像格外用力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050303,
					"content": "嗯？揭短？你不担心我这位强大的魔女动动手指，把宝箱里的东西全变成胡萝卜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050304,
					"content": "派蒙不懂事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "哼哼，当然咯，我怎么会是把日常琐事事无巨细记在脑袋里的沉默天使呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050307,
					"content": "#——于是到了那天，{NICKNAME}和派蒙踏上七重阶梯，等待在{M#他们}{F#她们}面前的却是一个熟悉的背影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050308,
					"content": "光焰汇成了她后背的羽翼，她的身姿依旧如初见时高贵和美丽，但那双眼睛却流露出残酷的光芒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050309,
					"content": "#「为什么？」{NICKNAME}和派蒙同时发问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050310,
					"content": "「具体就要从派蒙那天抱怨我说话用力时说起了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050311,
					"content": "语言是有魔法的，不要说那么可怕的话啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050305,
					"content": "别放在心上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
		},
		{
			"id": 7620505,
