			"dialogs": [
				{
					"id": 790730101,
					"content": "欢迎！尊敬的客人，欢迎您来到「赐福森林」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730102
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730102,
					"content": "您是来森林里旅行，还是准备去参观雨歌塘的跳跃比赛？无论如何，都祝您开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "许迪"
				}
			]
		},
		{
			"id": 7907303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"许迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730301,
					"content": "您也要记得避开那只不知道何时会前来造访的巨龙！可别让他耽误了您的行程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730302
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730302,
					"content": "唉，我之前还想着送那位龙一些「纸模」呢。这样也许能让他心情好些。不要再来吹翻我的架子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730303
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730303,
					"content": "但是…那位龙明显不乐意听我叫喊，每次都自顾自飞走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "许迪"
				}
			]
		},
		{
			"id": 7907304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"许迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730401,
					"content": "如今，我们也不用担心有一只巨龙突然前来造访了。不得不说，您来得正是时候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730402
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730402,
					"content": "我听说，那位龙如今可是有了一副好脾气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730403
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730403,
					"content": "我正打算带着些「纸模」去看望他。希望那位龙能喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "许迪"
				}
			]
		},
		{
			"id": 7907305,
			"completionStepIds": [
				7907301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"许迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730501,
					"content": "喔！天哪，我居然忘了为您介绍我的杰出作品，还有这台杰出的架子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730502
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730502,
					"content": "请您看向这里！瞧瞧这台「赠礼箱」，我迄今为止制作过的所有纸模都在里面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730503
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730503,
					"content": "为了制作它们，我走…喔，应该说是「跳」遍了整个世界，也结交了无数朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730504
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730504,
					"content": "比如，总是想拉我去风场里尝试飞行的飞鼠克朗谢，和我一样喜欢做模型的德维特…当然啦，还有那位总是板着脸的埃洛夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730505
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730505,
					"content": "他们都很慷慨，愿意让我以他们为原型制作纸模，把这有趣的小玩意与大家分享！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730506
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730506,
					"content": "来，拿上这些「星游币」，就算是我对您的欢迎礼吧。把它们塞进这台「赠礼箱」里，扭动把手。看看露珠会赐予您什么礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730507
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730507,
					"content": "但是，如果您用完了这些硬币之后，还想继续扭动「赠礼箱」的话，就得自己想办法拿到硬币啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730508
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730508,
					"content": "至于怎么拿到硬币…哈哈哈，您可以去问问我的那些好朋友们，他们会有主意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730509
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730509,
					"content": "拿到礼物之后，您可以把它们摆在我身后这台好架子上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730510
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730510,
					"content": "严肃地来说，这台架子才是我制作「赠礼箱」和制作「纸模」的动力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730511
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730511,
					"content": "但这就牵涉到一个不那么简练的故事了…如果您希望的话，我之后也愿意讲给您听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730512
					],
					"speakerTitle": "许迪"
				},
				{
					"id": 790730512,
					"content": "现在，就请您扭动「赠礼箱」吧，露珠在上，祝您拿到心仪的礼物，也拿到一整天的好心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "许迪"
				}
			]
		}
	]
}