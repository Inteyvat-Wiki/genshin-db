			},
			"dialogs": [
				{
					"id": 727340101,
					"content": "不严谨，不优雅，不精彩，不奇妙，什么都不搭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "「金龟奇术番长」"
				},
				{
					"id": 727340102,
					"content": "你在神神叨叨什么，评价你那些败下阵来的同伴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727340103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "「金龟奇术番长」"
				},
				{
					"id": 727340104,
					"content": "说的是你们斗虫的风格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "「金龟奇术番长」"
				},
				{
					"id": 727340105,
					"content": "啊？你的脑袋被漂浮灵砸过吗？本大爷又不是来表演节目的！本大爷讲究的是热血、强劲和势不可当！你要来领教一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727340106,
					"content": "想起了不好的回忆…我不能和你这种大大咧咧的家伙对阵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "「金龟奇术番长」"
				},
				{
					"id": 727340107,
					"content": "#唔，这位金发的{M#先生}{F#小姐}看起来很好对付…决定了！我要挑战{M#他}{F#她}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "「金龟奇术番长」"
				},
				{
					"id": 727340108,
					"content": "噗…哈哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727340109,
					"content": "我的挚友，听见了吗？他说你好对付！你快来好好招待这家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 727340110,
					"content": "哈哈，我就不客气啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "真是让人看不懂呢，这些人根本就没有收集对手的情报嘛，一个接一个地过来送战果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727340113,
					"content": "「花角玉将」的团队简直就像是散装的！策略这方面远远不如我们三个嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727340111,
					"content": "呜呜，请不要欺负我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
