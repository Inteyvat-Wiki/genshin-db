			},
			"dialogs": [
				{
					"id": 200440101,
					"content": "伤脑筋…这里要怎么解决啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440102,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "为了下一次的骑士选拔，我正在训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440104,
					"content": "唔…不过，我可没有琴大人那样的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440105,
					"content": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440106,
					"content": "比如，一口气把这些木桩全部破坏掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440107,
					"content": "你有空的话，也和我一起来想一想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440108,
					"content": "我想一想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "没关系，好好想喔，木桩不会自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440111,
					"content": "唯一会自己跑掉的只有被消耗的时间和生命，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440114,
					"content": "要是能用更大一些的武器，或者和琴大人一样，使用元素的力量，也许就能轻松破坏掉全部木桩了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440109,
					"content": "我们两个一起上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440113,
					"content": "像我这样的，只能学习独自作战啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "艾琳"
				}
			]
		},
