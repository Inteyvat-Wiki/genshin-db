			"dialogs": [
				{
					"id": 721650101,
					"content": "你们回来了，请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650102,
					"content": "请为我占卜一下吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#我也想知道{NICKNAME}今天会有怎样的好运气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650104,
					"content": "嗯…从「灵草」叶片的纹理来看…是好运哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650105,
					"content": "两位会在海祇岛的最高处，供奉神的旧地，与好运相遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650106,
					"content": "唔…怎么我看不出来这么多信息呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650107,
					"content": "呵呵，这是本地老人的智慧哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650108,
					"content": "这种敷衍的回答…好可疑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
