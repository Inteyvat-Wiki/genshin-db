						721650203
					]
				},
				{
					"id": 721650203,
					"content": "哼哼，今天又有怎样的运势呢~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650204,
					"content": "嗯…根据「灵草」的预言…会有厄运啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650205,
					"content": "两位在海祇岛的南方的洞窟，贼匪的巢穴，会遭遇不期而至的厄运…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650206,
					"content": "欸，是厄运！那我们避开那种地方好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650207,
					"content": "呵呵，但是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650208,
					"content": "若克服厄运的话，说不定会有意外的收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650209,
					"content": "收获…？是宝藏吗？是宝藏吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650210,
					"content": "我没说是哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650211,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
