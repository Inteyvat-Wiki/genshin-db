				{
					"id": 721650505,
					"content": "不过没关系，还能再为你们占卜一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650506
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650506,
					"content": "唔…从「灵草」明灭来看…是好运哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650507
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650507,
					"content": "东北方的残迹，海上孑立的古城，哀哀伫留的旧日之灵会引导你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650508
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650508,
					"content": "但是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650509
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650509,
					"content": "你要为她打开一道大门，令她返回永久美梦的睡巢…才能获得命定的奖赏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650510
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650510,
					"content": "唔…什么古城，什么鸟巢的…好乱呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650511,
					"content": "呵呵，没关系，我一直在这里的。脑子转不过来的话可以随时找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650512
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650512,
					"content": "哇啊，她是在说我笨吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
