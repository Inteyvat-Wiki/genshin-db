			"dialogs": [
				{
					"id": 751501301,
					"content": "请问，有什么需要询问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501302,
					"content": "如何进入圣山之心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "进入圣山之心的入口就在新开掘的入口…深入火山之底的裂隙之处，由秘源龙像看守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501304,
					"content": "此外，任何进入圣山之心的访问者，都需要获得「许可」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501305,
					"content": "如此才能获得，守卫…圣山之心，亦即「维奇洛波奇特利」…那位秘源龙像的认可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501306,
					"content": "在什么地方能够获得许可…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "根据协议和修库特尔大人制订的谕令，想要进入…圣山之心亦即「维奇洛波奇特利」…的族裔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501308,
					"content": "请前往「审议之庭」进行申请，并等待许可的下达。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501309,
					"content": "秘源龙像所需的能源？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "正在，检索…没有可响应的数据条目类型…或许由于深渊侵蚀城市所致，数据有许多佚失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501311,
					"content": "如果能够清除深渊的影响，回收数据，或许能够找到您所需的资料条目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501312,
					"content": "为您标记可回收数据的可能存放地点，请清除该处深渊的侵蚀以恢复数据承载的区块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501313,
					"content": "请问，有什么需要询问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751501314,
					"content": "没什么要问的了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源龙仆"
				}
			]
