			"dialogs": [
				{
					"id": 751500901,
					"content": "你好，检测到新的数据回收类目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500902,
					"content": "…关于「秘源机关」的能源核心，条目已更新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500903,
					"content": "驱动秘源机关的核心能源，即是「燃素」，只不过会是浓缩过，更接近光形态的「燃素」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500904,
					"content": "在「数据佚失」的可控反应下，可以产生稳定的「单位燃素量」，更精准控制能源的投放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500905,
					"content": "秘源机关所需的能源根据运行逻辑的复杂和机体大小都有关系，秘源龙仆所需的「单位燃素量」为「数据佚失」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500906,
					"content": "而体型更大的秘源龙像所需的「单位燃素量」相较之下却更少，需求为三。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500907,
					"content": "「信息即是能量，能量即是信息」，你所回收的数据载体即为「单位燃素」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500908,
					"content": "所以「单位燃素」就是火球…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "是的，可以这么视为，原本被深渊侵蚀的「单位燃素」被你们恢复，才能被我提取…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751500910,
					"content": "也可作为被深渊侵蚀的秘源机关的替代能源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源龙仆"
				}
			]
		},
