					"nextDialogs": [
						401890806
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890806,
					"content": "经营乐园是个长期的过程，心急赚不了大笔摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890807,
					"content": "这次的工作布置已经差不多了，我们就小小休息一会儿，等待着这个周期的营收财报出炉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890803,
					"content": "我会好好考勤的哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
