						401891107
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891107,
					"content": "德波大饭店的前主厨才和「奢华」这个词关联最紧密吧？不管你走到哪，都会带来一股精致料理的香气哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401891108,
					"content": "咳咳…正事要紧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891109,
					"content": "#看来，娜维娅是想让{NICKNAME}决定各个时期的「主题料理」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891110,
					"content": "「主题料理」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "这就是我之前提到的经营策略——用顶级厨师的料理，为「海薇玛映影欢乐城」吸引额外的客源！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401891112,
					"content": "不…不止吸引客源，爱可菲的杰作肯定还能发挥其他惊喜的效果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401891113,
					"content": "你想想，派蒙，假如只需要一张乐园的门票，不仅能玩个痛快，还能吃到传说中的美食，你不心动吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401891114,
					"content": "那那那！那我一定天天来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401891115,
					"content": "有没有年卡？年卡救一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "不过，要是公开菜单，吸引客人的效果就会减半了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891118,
					"content": "根据一位美食品牌顾问的调查，许多餐馆采用了「主厨随机料理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891119,
					"content": "所以，每过几个经营周期，就由你来给我灵感，决定我应当制作什么「主题料理」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891120,
					"content": "把手给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891121,
					"content": "手…手吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "嗯，温暖而饱含活力的触感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891124,
					"content": "长期接触剑柄的肌肤结有一层坚韧的茧，但很细腻，你持剑时，就像执掌提琴的弓弦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891125,
					"content": "剑…我明白了，这次的主题是「力量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891126
					],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891126,
					"content": "来吧，看看你所带来的「力量」灵感，最终会凝聚成怎样的料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱可菲"
				},
				{
					"id": 401891122,
					"content": "原来是物理传递灵感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "我直接想个法子在这里住下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				}
			]
		},
