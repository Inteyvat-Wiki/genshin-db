			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "接下来，我的好搭档和派蒙，我们要进入「海薇玛映影欢乐城」的正题了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890402,
					"content": "之前说过，这次的「海薇玛映影欢乐城」由爱好者们发起，刺玫会负责统筹、建造和运营。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890403,
					"content": "不过，爱好者毕竟不是全能的专业人士，通常只负责活动展位的设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890404,
					"content": "我们的任务，就是进行「长期经营规划」，定制「标准玩法攻略」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890405,
					"content": "长期、经营、规划…听起来好高深！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890406,
					"content": "我们两个平时都在冒险，甚至都没怎么摆摊卖过东西，能搞懂吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890407,
					"content": "不是每个老板都读过商业学校喔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "没错，就是这种气势！我的好搭档什么风浪都见过，影响过不少提瓦特的商业大事件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890410,
					"content": "总之，我们先来看看欢乐城的基本情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890411,
					"content": "#好像大概明白了，{NICKNAME}，你感觉怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890412,
					"content": "哈哈，这是我的拿手好戏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "嗯！我们一起加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890415,
					"content": "刚才，娜维娅好像还提到了「标准玩法攻略」…难道说，还有不标准的玩法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890416,
					"content": "当然啦，毕竟每个人对映影和游乐项目的理解都不同，欢乐城里也不乏惊险刺激的活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890417,
					"content": "没准，有的游客认不清路，咕噜两下就跑出了游玩范围…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890418,
					"content": "有的游客或许会认错道具的用途，把危险的道具捏在手里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890419,
					"content": "要避免游客们游玩时陷入困惑，我们就要给每个活动列出一个「标准玩法」，或者说，「流程攻略」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890420,
					"content": "我明白了，就由我来先玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "这么一说，我也能想象各种意外情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890423,
					"content": "如果碰见太难的关卡，也只有凭我们的实力才能轻松应付！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890424,
					"content": "当然啦，我绝不希望我的好搭档遇见危险，在你们来之前，我已经把现有项目统统仔细检查过了，绝对不会有安全因素的缺陷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890425,
					"content": "我也希望你能成为最早体验到游乐项目的人，然后说说你对这些游乐项目的感受，提提建议！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890426,
					"content": "嘿嘿，不愧是娜维娅，总能让我们安安心心开开心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401890427,
					"content": "我很期待哦！你们的意见非常关键！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890428,
					"content": "总之，我们就先将「缤纷蹈险奇行」投入运营，制定第一份攻略好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401890421,
					"content": "我懂了，我来当参考标准。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "哇啊…一边工作一边学吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "我们也干过许多赚大钱的生意嘛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
