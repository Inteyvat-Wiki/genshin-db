					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401891002,
					"content": "趁着这个势头，我们要在新一个周期里考虑更特别的经营策略了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401891003,
					"content": "为了欢乐城的人气，我专门请来了枫丹知名的厨师，我的好朋友爱可菲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 401891004,
					"content": "乐园里的餐厅就是她表演的舞台，我们这就去找她聊聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "娜维娅"
				},
