					"content": "呼…万事俱备！运营「海薇玛映影欢乐城」的要点，已经全都被你们掌握了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "娜维娅"
				},
