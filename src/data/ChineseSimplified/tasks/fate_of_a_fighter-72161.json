			"dialogs": [
				{
					"id": 721610505,
					"content": "把草药捣成药糊还要很长时间，你可以走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610506,
					"content": "…不，我不是在赶你走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610507,
					"content": "过一段时间再回来吧，能有个人聊聊天…也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "稻叶久藏"
				},
