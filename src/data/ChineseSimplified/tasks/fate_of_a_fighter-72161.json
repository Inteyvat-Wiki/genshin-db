			"dialogs": [
				{
					"id": 721610601,
					"content": "外国人，最近如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610602,
					"content": "抱歉，这里不是待客的好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610603,
					"content": "不过…我很高兴你能来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610604,
					"content": "你看起来好多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "嗯，又欠你一个人情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610606,
					"content": "哈哈，真可惜我又撑下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610607,
					"content": "这不是好事吗。有什么可惜的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610608,
					"content": "接下来有什么打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "我还没想好接下来怎么做，不过我想我不会回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610611,
					"content": "虽然九条政仁公子人还不错，但是他家的老头子正叫唤着抓逃兵立威呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610612,
					"content": "我可不能撞到他的刀口上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610613,
					"content": "或许我会脱下这身甲胄吧，就这样一个人过日子也不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610614,
					"content": "直到平静的日子没办法让我自欺欺人，记忆告诉我自己依然是那个染血的伤兵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610615,
					"content": "唉…总之，以后的事，谁知道呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610616,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "话说回来，我从未质疑过大御所大人的一切决定，所以我想，即使离去也不会有什么悔恨吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610619,
					"content": "唔…话题突然变沉重了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610620,
					"content": "啊，说到这里…我也该去拜访一下老战友了，他们还一直在这座岛上陪着我呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610621,
					"content": "稻妻的传统是献上「血斛」，一种娇贵妖艳的花朵…是武人宿命的象征。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610622,
					"content": "顺便，如果你接下来在旅途中遇到了我的老战友们，也请劳烦停留一下，认识认识他们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610617,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "有想过回去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
