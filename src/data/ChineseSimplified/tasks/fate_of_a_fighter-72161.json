					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610705,
					"content": "他们不是我的对手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
