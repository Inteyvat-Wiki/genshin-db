					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610707,
					"content": "等你把他们都驱逐干净，再跟我说这种话吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610708,
					"content": "一言为定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
				},
				{
					"id": 721610709,
					"content": "嗯，一言为定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻叶久藏"
				}
