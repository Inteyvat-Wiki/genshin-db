			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"稻叶久藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610301,
					"content": "你回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610302,
					"content": "都解决了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "哇…突然气氛好奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610305,
					"content": "拜托你这个局外人做这种脏活，实在抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610306,
					"content": "你不像这么客气的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610309,
					"content": "药草已经用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610310,
					"content": "之前用来外敷的已经见底了，但伤口还没有消肿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610311,
					"content": "不过…没必要担心我，我还撑得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610312,
					"content": "去关心你自己的事情吧，走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610313,
					"content": "像个小孩子一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610315,
					"content": "你说什么…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610316,
					"content": "在说你呀，就像个小孩子一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610317,
					"content": "明明情况很糟糕，就差哭着鼻子喊救命了，可还是强撑着装硬汉…一点也不坦诚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610318,
					"content": "只有小孩子才会这样做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610319,
					"content": "而且久藏先生，你可不要忘了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610320,
					"content": "你还欠着我们人情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "哼…真拿你们没办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610323,
					"content": "那就请帮我弄来些鸣草吧，在这座岛上随处可见。叶片饱满的最好，方便榨出浆液外敷消炎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610324,
					"content": "就这样吧。让我小睡一会，别再烦我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610321,
					"content": "我们是来帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "伤口好些了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "足够安生一阵子了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
