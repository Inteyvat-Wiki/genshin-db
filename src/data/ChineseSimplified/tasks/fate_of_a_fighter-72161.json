			"trigger": {
				"objectNames": [
					"稻叶久藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "哼，真是丢人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610102,
					"content": "明明救了你一命，你还骂我们丢人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610103,
					"content": "他在说他自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "想不到我会落到被外国人搭救，又任之评头论足的境地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610106,
					"content": "唔…话说回来，武士先生，你还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721610107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610108,
					"content": "看起来挺有精神的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "我欠你们一个人情，外国人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610111,
					"content": "还有，刚才打得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610112,
					"content": "#{NICKNAME}，有幸相识。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "少蹬鼻子上脸了，外国人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610114,
					"content": "…稻叶藤三郎久藏，叫我久藏就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610115,
					"content": "那些是什么人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "是海贼，名椎滩一带有不少他们的据点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610118,
					"content": "流窜的贼人、失去主业的矿工和渔民、「眼狩令」逃犯，或者战争两方的逃兵，有时就会扎堆啸聚，堕落成贼匪…妄图逃脱大御所大人的制御。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610119,
					"content": "「浮浪人」也好，「海乱鬼」也好，一群无法无天之徒…我们前阵子一直在清剿他们，直到叛军毁掉了岛上的镇物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610120,
					"content": "踏鞴砂与矿场的难民纷纷逃离，其中一些鼠辈投奔此间，充实了海贼的队伍，他们就更加肆无忌惮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610121,
					"content": "刚刚那群海贼是从南边营地来的，他们盯上了这艘船上的货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610122,
					"content": "只可惜我碍了他们的事，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610123,
					"content": "这不是你的船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "这艘？原本是珊瑚宫叛军的船。我也不太清楚…总之我来到这里的时候，船上就已经没有人影了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610125,
					"content": "于是，我就住下来了，像寄居蟹一样活到现在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610126,
					"content": "这么长时间以来，这还是我头一次说这么多话。真是累人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610127,
					"content": "对了，如果你不介意的话，顺便帮我一个忙吧…等我养好伤，欠下的人情总会还你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610128,
					"content": "我刚刚提过，周围的海贼营地，帮我清理掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610129,
					"content": "只有这样，野狗一样的海贼才不会继续来骚扰我。或许还能威慑其他海贼营寨，令他们不敢轻易打这艘破船的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610130,
					"content": "那就让我再看看你的本事，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610131,
					"content": "小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "哼，净是大话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610134,
					"content": "对了，外国人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610135,
					"content": "别太得意了，下去时小心别摔坏了腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721610132,
					"content": "去去就回。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "你为什么会被围攻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "很明显自尊受了伤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "是武士特有的矫揉造作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
