			},
			"dialogs": [
				{
					"id": 721611401,
					"content": "怎么又是你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611402,
					"content": "我不是跟你说过——唉，算了。随你高兴吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611403,
					"content": "别弄乱了我的东西，船上补给还够分你一点。满意了就快点离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611404,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "不需要。你没看到我过得很好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611406,
					"content": "但你的伤口…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "那是我的伤口，不是你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611408,
					"content": "喂，我们是出于好心才问的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721611409,
					"content": "那我也出于好心回答你们：别烦我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611410,
					"content": "我可以帮你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "怎么帮我，把我交给幕府军吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611412,
					"content": "哈哈，我劝你别犯傻了…我会被当成逃兵的。九条大人对逃兵从不留情面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611413,
					"content": "你要是真想帮我，就让我一个人好好静静吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "稻叶久藏"
				},
				{
					"id": 721611414,
					"content": "哇，这个油盐不进的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
