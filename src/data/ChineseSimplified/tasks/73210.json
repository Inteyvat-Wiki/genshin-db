			"dialogs": [
				{
					"id": 732100501,
					"content": "嗯…不知道这里会有什么宝藏呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100502,
					"content": "柜子中放满了簿册，你们翻了翻，似乎是病历卡和账务记录之类的医院文件。\\n失望地关上了柜子。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "哼，我还以为里头有什么特别的宝藏呢…还不如我们平时冒险的时候，见到的木桶木箱呢！里面起码还有卷心菜和禽肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100504,
					"content": "欸，这是什么？好像从里头掉出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100505,
					"content": "我看看…说不定有宝藏的线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100507,
					"content": "呜哇，「魔鳞病」看起来好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100508,
					"content": "另一份文件上写了什么呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100510,
					"content": "嗯…完全没看懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100511,
					"content": "我也没看懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100512,
					"content": "我只看懂了什么「神的声音引导」…难道这里真的会出现奇特的声音，引导人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100515,
					"content": "可能是「地下水脉或生物活动」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "嗯！确实，说不定地下有什么遗迹呢！如果注意到什么声音，我们就去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732100513,
					"content": "看不懂可能比较好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "咦？你看懂了吗？我只看懂了什么「神的声音引导」…难道这里真的会出现奇特的声音，引导人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "派蒙"
				}
			]
