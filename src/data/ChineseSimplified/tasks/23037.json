			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马鲁夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230370101,
					"content": "唉，这种病可不好治啊，看来还是得请扎卡里亚医生帮帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370102
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370102,
					"content": "遇到什么重病患者了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370103
					]
				},
				{
					"id": 230370103,
					"content": "欸？是旅行者啊…倒也不是什么重病患者，就是有个病人头疼的有些厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370104
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370104,
					"content": "虽然我也给他开过药了，但药效却不怎么明显。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370105
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370105,
					"content": "不能开其他的药吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370106
					]
				},
				{
					"id": 230370106,
					"content": "咳…我哪会啊。现在我手头的药方，基本上都是我自己摸索出来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370107
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370107,
					"content": "这些药方治疗一些小病小痛还可以，一遇见症状稍微重点的病症就很难起效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370108
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370108,
					"content": "还好城里「健康之家」的扎卡里亚医生答应过我，可以帮我置办药方和药物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370109
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370109,
					"content": "旅行者，你能帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370110
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370110,
					"content": "我现在还有一些患者要治疗，实在是走不开，你能帮我去城里找一下扎卡里亚医生，请他帮我开一个药方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370111,
						230370113
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370111,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370112
					]
				},
				{
					"id": 230370112,
					"content": "那就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370113,
					"content": "扎卡里亚会来村里吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370114
					]
				},
				{
					"id": 230370114,
					"content": "扎卡里亚医生偶尔会托人送点药过来，但他太忙了，实在是没什么空来村里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370115
					],
					"speakerTitle": "马鲁夫"
				},
				{
					"id": 230370115,
					"content": "总之药方的事就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马鲁夫"
				}
			]
		},
