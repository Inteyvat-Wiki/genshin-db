			"trigger": {
				"objectNames": [
					"扎卡里亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230370501,
					"content": "最近的病人怎么越来越多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370502
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370502,
					"content": "关于马鲁夫的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370503
					]
				},
				{
					"id": 230370503,
					"content": "马鲁夫？他又遇见什么疑难杂症了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370504
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370504,
					"content": "叙述了马鲁夫所面对的病症…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230370505
					]
				},
				{
					"id": 230370505,
					"content": "唉，我说了多少次了，这种小病以他的水平完全可以独立治疗，没必要来找我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370506
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370506,
					"content": "估计又是那些病患觉得自己的病很重，不相信他这位「赤脚医生」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370507
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370507,
					"content": "为了让病患安心，才来请我给他开个药方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370508
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370508,
					"content": "这么多年一直待在那里治病，也是辛苦他了…我这就给他写个药方，请你记录一下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370509
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370509,
					"content": "唔，我记得马鲁夫这次要治的病是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370510
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370510,
					"content": "是个头疼的病患。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370511
					]
				},
				{
					"id": 230370511,
					"content": "嗯，治疗头疼…就用我之前给他开的那种方子就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370512
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370512,
					"content": "把那个方子里的药物煮成药汤，然后再加入三株<color=#00E1FFFF>薄荷</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370513
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370513,
					"content": "最后把加入了薄荷的药汤用<color=#00E1FFFF>大火</color>继续煮，煮大概…算了…<color=#00E1FFFF>煮到药材都浮起来</color>就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370514
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370514,
					"content": "唔…我还是写下来给你吧，免得你忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370520
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370520,
					"content": "扎卡里亚将方子写在了纸上…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230370515
					]
				},
				{
					"id": 230370515,
					"content": "那就麻烦你把这方子给马鲁夫送回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370516
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370516,
					"content": "说实话，这药方名义上说是「药」，其实更接近一种…呃，怎么形容呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370517
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370517,
					"content": "一种…药效不怎么猛烈，以补充营养为主的补充剂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370518
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370518,
					"content": "就算制作时没完全按照药方上来，也不会有什么严重后果，顶多就是喝下去没效果罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370519
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230370519,
					"content": "唉，所以说，马鲁夫自己调整一下药方就行了，他就不能自信点吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亚"
				}
			]
		},
