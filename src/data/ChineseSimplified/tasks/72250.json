			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"贺摩",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722500101,
					"content": "啊！救、救命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500102
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500102,
					"content": "小人听说最近大人们疲于应付须婆达之彦领导的反叛，大日御舆防卫空虚，才动了不该动的歪念头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500103
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500103,
					"content": "看在小人上有重疾老母需要赡养，下有十二个出于爱心拉扯大的孤儿的份上！还请守备大人高抬一手，把小人当个屁，就放了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500104
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500104,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722500105
					]
				},
				{
					"id": 722500105,
					"content": "咦，嗐，什么呀，原来不是大日御舆的守卫啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500106
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500106,
					"content": "看你这奇装异服的…不会是从什么奇怪地方来的同行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500107
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500107,
					"content": "什么同行不同行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500108,
					"content": "都到这儿了还装什么呀，唉，真是出师不利，好不容易进入大日御舆，大肆搜刮了一把，却被机关困住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500109
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500109,
					"content": "看来今日不宜…不宜行劫富济贫的义举之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500110
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500110,
					"content": "哼，小偷就小偷，还说成是劫富济贫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500111,
					"content": "你懂什么，大人们每日听着靡靡之音，饮酒作乐，我们这些底层人就得累死累活，给他们倒尿盆子，热草鞋，哪有这种道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500112
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500112,
					"content": "哎对了，我跟你说个秘密，就当你们救我的回报。我之前收买了维修大日御舆的工匠，像这样藏有财宝的房间，还有两个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500113
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500113,
					"content": "还有两个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500114,
					"content": "#{NICKNAME}，我觉得我们也有必要，行、行一些劫富济贫的义举之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500115,
					"content": "不过这两个房间的位置我也不是很清楚了，毕竟那工匠也不敢再说其他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500116
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500116,
					"content": "这情报就当是贺礼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500117
					],
					"speakerTitle": "贺摩"
				},
				{
					"id": 722500117,
					"content": "反正现在的渊下宫也没有人在，说不定那里有很多以前的古董呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500118,
					"content": "#{NICKNAME}，待会儿我们就悄悄在周围找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}