			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"步云"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "（按照刻晴教的，现在应该这样说…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210302,
					"content": "你好，这里卖月亮吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210303,
					"content": "是的，要几个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "步云"
				},
				{
					"id": 10210304,
					"content": "数量不方便透露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210305,
					"content": "答得好，二位请由此登阁。对了，二位就是凝光大人今天安排的客人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "步云"
				},
				{
					"id": 10210306,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210307,
					"content": "（但这不是「客人」的暗号，而是「玉衡特许」的暗号。这又是怎么回事呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "步云"
				}
			]
		}
	]
}