			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "呼…呼…赶路赶得好累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240202,
					"content": "要不是出「黄金屋」的时候刚好看到「群玉阁」在天上飞，现在还根本不知道该往哪跑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240203,
					"content": "我们赶上了吗？「漩涡之魔神」还在海里、还没登陆璃月港吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240204,
					"content": "你们…怎么来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10240205,
					"content": "咦？…啊！是仙人们！为什么你们会在「群玉阁」上？之前听说你们在和七星吵架…已经吵完了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240206,
					"content": "诸位仙家的意思是，当此危难之时，仙人与七星也该暂时放下不和，共同对敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240207,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "削月筑阳真君"
				},
				{
					"id": 10240208,
					"content": "原来是这样。那么，现在大家的防御方案是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240209,
					"content": "呜…那个「漩涡之魔神」，只是从这么远的距离稍微看一眼，就觉得呼吸都有点不顺畅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240210,
					"content": "千岩军里有些新兵，已经连站都站不稳了。远古魔神的威压，看来对普通人的身体非常有害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10240211,
					"content": "——但正因如此，更不能让那怪物接近璃月港的平民！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10240212,
					"content": "好可怕…两千年前的魔神战争，就是在与这样的敌人战斗吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240213,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10240214,
					"content": "所以，靠现在在场的七星、千岩军，加上几位仙人的战力，能解决海里的那个魔神吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240215,
					"content": "众仙家已经讨论过了，答案是…未必。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240216,
					"content": "不会吧？！可…可你们是守护璃月的仙人，和守护璃月的七星啊！不能想想办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240217,
					"content": "那倒是可以的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10240218,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240219,
					"content": "此前「归终机」一事，让七星动了心思、前去探究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10240220,
					"content": "而今身为「归终机」制造者的本仙，又恰好在此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10240221,
					"content": "仙家机关，你们凡人能研究出什么？但只要本仙对这老旧弩炮稍加改进，那就是你们难以想象的进化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 10240222,
					"content": "呵呵…也算是一种「仙缘」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240223,
					"content": "如此一来，我们就能用「新归终机」对抗魔神。在场的诸位仙家，也都能够为它注入仙力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240224,
					"content": "事不宜迟，决战就在此时——开！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 102408,
