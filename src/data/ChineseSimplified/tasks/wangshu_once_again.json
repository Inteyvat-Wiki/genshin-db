			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲尔戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "果然每年过节的时候都格外忙啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718200202,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "还是客栈里的事，很多人都回去过海灯节了，客栈里的人手实在不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718200204,
					"content": "又要招呼客人，又要打扮客栈，还得准备点东西过节…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718200205,
					"content": "还有平常的一些事也不能搁置了…言笑都要忙不过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718200206,
					"content": "旅行者，如果你愿意的话，能去帮他一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718200207,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "那就拜托你了，言笑就在厨房里，你直接去找他就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718200209,
					"content": "我还得在这处理一点事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "谁啊！不要随便…哦，是你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200302,
					"content": "有什么事吗？要点菜的话估计得等会了，我这正忙着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200303,
					"content": "我是来帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "你是来帮忙的？哦…那敢情好，我正好有一堆事要做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200306,
					"content": "你先去客栈下面，帮我把刚送过来的那些烹饪用材料拿上来，我急着要用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200307,
					"content": "然后，再顺便把这些霄灯挂到客栈门口的那两棵树上去…掌柜的念叨这事好久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200304,
					"content": "有什么需要我帮的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "怎么样，事情都弄好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718201502,
					"content": "都搞定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "谢了，真是帮大忙了，我得赶紧把这几道菜给弄完，免得客人们等急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲尔戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "你回来了，言笑那边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718201602,
					"content": "现在应该轻松一些了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "那就好，那就好，谢谢你帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718201604,
					"content": "这里也没有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201605,
					"content": "咦，望雅小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "旅行者？真是巧了，没想到能在这里遇见你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201608,
					"content": "送霄灯…算是吧，你知道轻策庄吗？那边离城里很远，里面住的居民也大多是老人和孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201609,
					"content": "所以每年海灯节的时候，总务司也会特别派人过去，给他们带一些节日用品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201610,
					"content": "第一批物资已经送过去了，但我还想再做点什么，让轻策庄里更有节日的氛围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201611,
					"content": "所以，我去请了那位诗人清昼，他答应我会准备一些灯谜去轻策庄里陪孩子们玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201612,
					"content": "清昼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "那位大诗人应该没问题。然后我又想去找伯桓子，他的字写得很不错，要是能帮轻策庄里的老人们写写霄灯就最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201615,
					"content": "但是，我却怎么样都找不到伯桓子，有人说他来荻花洲取材，我就来这里想找找他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201616,
					"content": "说不定老板知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "伯桓子？我想想…他最近确实来过客栈一趟，说是要去附近采风什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718201619,
					"content": "不过那一带有很多魔物，我也不确定他是不是还在那里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718201620,
					"content": "这样吗…可我和清昼约好了，等会要在望舒客栈这里见面来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201621,
					"content": "旅行者，能请你再帮我去找一下伯桓子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201622,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "那就拜托你了，我在这里等清昼过来，还有一些事情要和他交代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201624,
					"content": "呜…事情完全排不过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201617,
					"content": "老板，关于伯桓子的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "（咦，他不是和梵米尔约好…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "你是来这里「送霄灯」的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
