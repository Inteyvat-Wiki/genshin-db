			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯桓子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "谢谢，谢谢你，唉…都怪我太不小心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201902,
					"content": "你在这做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "我来这里取材啊，这不是海灯节了吗？我就想写几幅好字，送给周围的朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201904,
					"content": "我本来就是想到这里来逛一逛找点材料，然后做几份特别的墨水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201905,
					"content": "没想到却撞上了一堆魔物，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201906,
					"content": "关于望雅的请求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "去轻策庄帮人写字…好，没问题，这事就包在我身上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201908,
					"content": "轻策庄…我记得那里的老人很多对吧，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201909,
					"content": "这样，你先帮我去搜集一块石珀，一朵清心过来吧，我先拿回去做点墨水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201910,
					"content": "这些东西…能做墨水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "哈哈哈，你这就有所不知了吧。石珀粉掺进墨水里，写出来的墨字里带着隐隐的金色，吉利得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201912,
					"content": "清心的汁水掺进墨水里，墨水会带着一股清香，只要墨好，这两种味道就会相得益彰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201913,
					"content": "这、这也太讲究了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "呵，这算什么，要是真让讲究的人来备墨，那才是真的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201916,
					"content": "我们这次就尽量从简吧，你搜集好了之后就拿来给我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201917,
					"content": "哎哟…我得休息休息，刚才真是太折腾了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯桓子"
				},
				{
					"id": 718201914,
					"content": "这么麻烦吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
