				]
			},
			"dialogs": [
				{
					"id": 140310101,
					"content": "…还是不行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310102
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310102,
					"content": "不行，我整个枫丹廷都跑过一遍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310103
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310103,
					"content": "琳妮特听到要连续几天在外面跑，耳朵都耷下来了。菲米尼好像觉得生人太多，直接把头缩进了头盔里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310104
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310104,
					"content": "千织和夏洛蒂呢？感觉她们能够胜任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310105
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310105,
					"content": "我问过了，但她们最近都挺忙，没有空闲。另外我刚给刺玫会成员放了几天假，不想因为这事打扰大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310106
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310106,
					"content": "…难办了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310107
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310107,
					"content": "娜维娅！克洛琳德！你们好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310108,
					"content": "天哪！是我的好搭档和派蒙！你们好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310109
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310109,
					"content": "…娜维娅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310110
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310110,
					"content": "…哦！你的意思是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310111
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310111,
					"content": "嗯，机会来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310112,
						140310113
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310112,
					"content": "…你，你们要干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				},
				{
					"id": 140310114,
					"content": "你们这是遇到什么难事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310115,
					"content": "没错！我的好搭档，有个天大的难事，眼下只有你们能帮我们解决！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310116
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310116,
					"content": "这么夸张？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310117,
					"content": "毫不夸张。已经走投无路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310118,
						140310119
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310118,
					"content": "到底是多大的难事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310120,
					"content": "#{NICKNAME}，派蒙…你们愿意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310121
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310121,
					"content": "——来玩《逐影猎人：审判之时》吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310122
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310122,
					"content": "什么东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310123,
					"content": "一个由枫丹「桌上剧团」俱乐部推出的游戏剧本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310124
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310124,
					"content": "你们听过「桌上剧团」吧？就是和好朋友围在桌前，扮演剧中角色，参与剧本故事的游戏。我小时候就爱玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310125
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310125,
					"content": "好像挺有趣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310126,
					"content": "我和克洛琳德都是俱乐部里的老会员了。最近，有人找到我，说他们出了一个新剧本，想请人免费试玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310127
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310127,
					"content": "这可是一个全新的剧本欸！我们是第一批体验者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310128
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310128,
					"content": "试玩阶段的剧本一般来说会有很多瑕疵，但这次的我觉得不错，完成度比较高，作者的考据也很到位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310129
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310129,
					"content": "欸停停停！剧本我一个字没看就直接拿给你了，千万别在这里剧透！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310130
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310130,
					"content": "…总之，这个剧本要求四位扮演者，现在三缺一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310131
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310131,
					"content": "…那还真是天大的麻烦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310132
					]
				},
				{
					"id": 140310132,
					"content": "你果然也这么觉得吧？我的好搭档。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310133
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310133,
					"content": "#但我和{NICKNAME}是两个人欸，这没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310134,
					"content": "没问题，我会根据实际参与人数进行节奏的把控，保证你们的游玩体验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310135
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310135,
					"content": "嘿嘿，你怎么看？想玩吗？我听你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310136,
						140310137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310136,
					"content": "朋友有难怎能不帮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310138,
					"content": "好。那现在问题就解决了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310139
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310139,
					"content": "太棒了！我这就去俱乐部叫剧本管理人过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310140
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310140,
					"content": "剧本管理人？剧本不就在克洛琳德手里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310141,
					"content": "配合这个剧本，俱乐部推出了全新的游玩方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310142
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310142,
					"content": "一开始主持人手中的剧本并不完整，需要跑完当前阶段的剧情，才能从剧本管理人那边接到下一阶段的剧本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310143
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310143,
					"content": "而且，俱乐部还会在现实中搭建剧中场景，让参与者身临其境，实景参与。第一天的游玩地点，得等剧本管理人告诉我们才知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310144
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310144,
					"content": "哇，听起来写这个剧本的人真的很用心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310145,
					"content": "嘿嘿，而且还很有悬念对吧？就连主持人都不知道故事的结局呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310146
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310146,
					"content": "我很期待和你们共同见证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310147
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310147,
					"content": "你们先去和其他人会合吧，他们还在千织屋等着呢，我待会儿就和剧本管理人一起过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310148
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310148,
					"content": "好，不要着急，小心看路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310149
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310149,
					"content": "你怎么把我说得像个小孩子一样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310150
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310150,
					"content": "唔…让我想想，这次该扮演一个什么样的角色呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310151
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310151,
					"content": "…希望这次你能学一些正常的技能。另外，别再试图对每一只见到的动物都使用「说服」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310137,
					"content": "好的剧本怎能不玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310119,
					"content": "先听听看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310113,
					"content": "…我，我只是路过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				}
			]
		},
