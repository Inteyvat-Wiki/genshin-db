			"dialogs": [
				{
					"id": 140310201,
					"content": "久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310202
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310202,
					"content": "#哦，你们回来了。咦？是{NICKNAME}和派蒙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310203
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310203,
					"content": "真惊喜，原来最后找到了你们一起来玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310204
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140310204,
					"content": "林尼！还有芙宁娜！另外两位玩家居然是你们呀！你们也是「桌上剧团」俱乐部的会员吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310205,
					"content": "二位好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310206
					]
				},
				{
					"id": 140310206,
					"content": "我只能算个「挂名成员」吧，没参加过几次活动。在布法蒂公馆，倒是经常由我担任主持人，陪琳妮特和菲米尼玩类似的游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310207
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140310207,
					"content": "不过，自己作为玩家体验剧本还是头一次呢，希望能和大家玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310208
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140310208,
					"content": "我不是俱乐部的会员。只是一大早被克洛琳德敲门叫醒，说有个不错的剧本可以体验，这才决定加入的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310209
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310209,
					"content": "如果你感兴趣，我可以当你的介绍人，入会费打六折。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310210
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310210,
					"content": "我还是先看这次的剧本质量再考虑啦，体验好的话我就加入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310211
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310211,
					"content": "克洛琳德是经常玩「桌上剧团」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310212,
					"content": "她可是俱乐部数一数二的「资深主持人」哟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310213
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140310213,
					"content": "嗯，以前跟我还是上下级关系的时候，我就知道这一点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310214
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310214,
					"content": "…一点业余爱好而已，不必那么惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310215
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310215,
					"content": "天哪，平时看你都是身为决斗代理人威严的一面，完全想象不到你带人玩桌上剧团的样子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310216,
						140310217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310216,
					"content": "如果对规则有意见的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				},
				{
					"id": 140310218,
					"content": "你说笑了。我不会这样为难玩家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310219
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310219,
					"content": "工作是工作，生活是生活。审判庭上的我，代表枫丹的律法与规则，赐予想要维护自身荣誉的人一场公正的决斗。不掺任何私情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310220
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310220,
					"content": "但生活中，我和大家一样，是个普普通通的人，生气难过之类的情绪，也是会有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310221
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310221,
					"content": "骗人的吧，你在我旁边这么久，我从没看你掉过眼泪，生气倒是有过不少…还是说你只是看起来像生气了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310222
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310222,
					"content": "那时的我也是工作状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310223
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310223,
					"content": "是这样吗？但总觉得你在生活中情绪波动也不大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310224
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310224,
					"content": "你想看我哭吗？那可能有些困难。生气或许会更容易些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310225
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310225,
					"content": "啊不不不，我不是这个意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310226
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310226,
					"content": "我回来啦！向大家介绍一下，这位就是此次剧本的负责人，弗洛莱恩先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310227
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140310227,
					"content": "各位好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310228
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310228,
					"content": "你好你好。咦？难道弗洛莱恩先生也是决斗代理人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310229,
					"content": "哦，不是的，这是俱乐部提供的演出服。我偶尔还会扮演剧本中的其他角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310230
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310230,
					"content": "还真是辛苦的工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310231
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140310231,
					"content": "这没什么。为了能让扮演者更为沉浸地体验故事，这是我们该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310232
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310232,
					"content": "那么我为各位简单介绍一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310233
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310233,
					"content": "此次的剧本，是参考逐影猎人的历史改编而成。诸位将亲自扮演那个时代的逐影猎人，解决在王城发生的一系列事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310234
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310234,
					"content": "呃…我对逐影猎人的历史不是那么熟悉，应该没什么影响吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310235,
					"content": "哦，这完全没问题。简单介绍的话，「逐影猎人」指的是那些继承了特殊的剑技，猎杀魔物、守护城市的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310236
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310236,
					"content": "关于他们的故事，最早能追溯到很久以前的雷穆利亚王朝，以及第一位猎人「卡西奥多」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310237
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310237,
					"content": "但更加详细的，就留给各位之后去寻找和发现吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310238
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310238,
					"content": "嗯，我也会在此过程中为你们进一步解说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310239
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310239,
					"content": "那么…咳咳！各位勇敢的猎人啊，你们准备好踏入一场未知的冒险之旅了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310240
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310240,
					"content": "哦！气氛一下子就上来了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310241,
					"content": "很好，我已经看到了你们坚毅的眼神。就请前往此处，开启你们的旅途吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310242
					],
					"speakerTitle": "弗洛莱恩"
				},
				{
					"id": 140310242,
					"content": "根据故事走向，前往特定情景吗？听起来挺新颖。所以信封里写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310243
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 140310243,
					"content": "是第一阶段剧本情景的具体位置，还有场地使用许可。准备得挺周全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310244
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310244,
					"content": "请各位检查随身物品，防止遗漏。准备好后，就随我前往指定的地点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310245
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 140310245,
					"content": "好欸！逐影猎人小队，出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140310217,
					"content": "需要向你发出决斗申请吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				}
			]
		}
	]
}