							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔德菈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "（她局促地别开目光。然后紧张地低下了头。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822802,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "抱歉，狩猎已经结束了。我是父亲的「猎鹰」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822804,
					"content": "不过…我很好，请您不要担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822808,
					"content": "这么极端吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "极端…？我不知道，我从懂事起就是这样活着的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822814,
					"content": "啊…不过…你和派蒙的故事，你们的旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822815,
					"content": "有机会的话，我想多听你讲讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822816,
					"content": "好呀，我们有好多好多故事呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732822817,
					"content": "嗯，我会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "噗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822820,
					"content": "咳咳，没什么，我只是很高兴…谢谢你…呃，您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822818,
					"content": "你想听的话，我随时可以给你讲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "你没想过为自己而活吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822812,
					"content": "…不，没有。没想过，没期待过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822813,
					"content": "沙漠很冷酷，没有闲暇考虑自己。没有我，还有很多人能活，但没有部族…我没办法一个人活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822805,
					"content": "关于你和马塞拉的关系…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "我说过，他是我的父亲，我是他的「猎鹰」。我跟随他的指令，为他而猎，为他而死…因为他代表了塔尼特的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732822807,
					"content": "假如我什么时候无法贯彻父亲的指令了，那么作为「猎鹰」的生命就这样结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "塔德菈"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"马塞拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822901,
					"content": "啊，您来了，尊贵的「镇灵主人」。请问您有何要事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
