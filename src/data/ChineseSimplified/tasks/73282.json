		},
		{
			"id": 7328204,
			"completionStepIds": [
				7328204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328204",
							"2"
						],
						"stepId": 7328204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔德菈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "你果然会来，我很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820402,
					"content": "我听说你在找我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "我一直觉得这个时刻的沙漠，很好看。我很喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820405,
					"content": "但是可惜…一直没有机会和朋友一起，在这里，就这样看太阳慢慢落下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820406,
					"content": "是啊，整个沙漠都被染成红色了…很漂亮，好安静…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820407,
					"content": "不过，塔德菈，你专门叫我们来就是为了这个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820409,
					"content": "对于塔尼特，你是客人，对「猎鹰」来说，也是潜在的「猎物」…但我希望，活下来的是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820410,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "所以，对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732820403,
					"content": "最近过得如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328206",
							"2"
						],
						"stepId": 7328206,
						"stateName": "QUEST_STATE_UNFINISHED"
