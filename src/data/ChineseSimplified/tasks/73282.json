			"trigger": {
				"objectNames": [
					"马塞拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "啊，您来了！请您留步，这恐怕是我最后一次拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732820102,
					"content": "请说吧，有什么需要帮忙的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "是塔德菈，她想要找您谈谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732820106,
					"content": "欸…什么事呀，这么正式的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820107,
					"content": "北方的遗迹，你们最初遇见的地方附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732820108,
					"content": "你说什么…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "北方的遗迹，你们最初遇见的地方附近…别忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732820110,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "嗯，请您好好待她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732820104,
					"content": "我还有别的事情要忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "请您务必听我说…塔德菈想要找您谈谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "马塞拉"
				}
			]
		},
		{
			"id": 7328202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
