			},
			"dialogs": [
				{
					"id": 732820201,
					"content": "北方的遗迹，你们最初遇见的地方附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820202
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732820202,
					"content": "这是她的选择…希望您能够加以尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塞拉"
