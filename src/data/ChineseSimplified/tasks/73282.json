				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "可恶…马塞拉那家伙不见了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820602,
					"content": "他留下了这张字条…哼，老狐狸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732820603,
					"content": "若您看到这张字条，那么我已经深入峡谷之中的避难所了。\\n若您的首级还在两肩中间，请不要为塔德菈的选择悲伤。\\n\\n这场狩猎并非结束，而是风暴的开始。\\n塔尼特长老，猎人马塞拉，特为您发出警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "调查"
				},
				{
					"id": 732820604,
					"content": "他说的这些…看不明白是什么意思呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732820605,
					"content": "看来出于某种压力，这家伙离开了部落…并且给您留下了警告。哼，塔尼特…暗潮汹涌呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕尔"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
