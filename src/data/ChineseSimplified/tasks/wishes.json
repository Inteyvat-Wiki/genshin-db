	"talks": [
		{
			"id": 202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
							"2"
						],
						"stepId": 202102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20210201,
					"content": "这不是凯旋的旅行者吗，到神社可是来还愿的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210202,
					"content": "不是你叫我们来的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210203,
					"content": "哈哈…开个玩笑，我正在等你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210204,
					"content": "神子的心情好像很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210205,
					"content": "是啊，难得和多年未见的老友叙叙旧，怎么说都是件值得开心的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210206,
					"content": "话说…我后来才听说，你居然和愚人众的执行官来了场御前决斗，这胆识实在值得赞许。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210207,
						20210208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210207,
					"content": "只是突发奇想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				},
				{
					"id": 20210209,
					"content": "能正面挫败那个「女士」，你的实力也已经超过我的预测了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210210,
					"content": "但总之，能赢就好，可喜可贺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210211,
					"content": "终于让愚人众的计划好好受挫了一次，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210212,
					"content": "至少这次，没让他们成功带走「神之心」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210213,
					"content": "等等，你们提到了「神之心」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210214,
					"content": "是那个像棋子一样的东西么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210215,
					"content": "对呀对呀，神子也见过吗？归七神所有，与天空岛相连的「神之心」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210216,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210217
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210217,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210218,
					"content": "那个东西，被我交出去了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210219,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210220
					]
				},
				{
					"id": 20210220,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210221,
					"content": "不然的话…你以为我用什么从「散兵」的手里换回了你的命呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210222,
						20210223
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210222,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210224,
					"content": "「散兵」如今可是愚人众执行官的第六席，论实力，还在「女士」之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210225,
					"content": "我可不是那种动不动就拼上自己性命的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210226
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210226,
					"content": "我竟然，一时间不知道该说什么好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210227,
					"content": "可是，「神之心」为何会在你手里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210228
					]
				},
				{
					"id": 20210228,
					"content": "影自从创造了人偶的形体以后，「神之心」便无处安放了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210229
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210229,
					"content": "作为曾经与影关系最密切的朋友…影将「神之心」交到我手上，并保管在鸣神大社。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210230
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210230,
					"content": "她本身就已经不再需要「神之心」的力量，据她说，她也已经与天空岛断绝了联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210231
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210231,
					"content": "既然如此，「神之心」便是无用又只会招致纷争之物罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210232
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210232,
					"content": "所以，用它换回「计划」的核心人物，不是一件非常划算的买卖吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210233,
					"content": "而且从结果来看，我确实赚到了啊，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210234
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210234,
					"content": "这么说，也是…在我心里，旅行者好像也是比一颗神之心要值钱的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210235,
						20210236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210235,
					"content": "怪不得后来没见过「散兵」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210237,
					"content": "唉，算了算了，事已至此应该也追不回来了吧，过去的就先让它过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210238,
					"content": "所以，神子还没说，这次叫我们过来究竟是要做什么呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210239,
					"content": "呵呵，是答谢哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210240
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210240,
					"content": "真的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210241,
					"content": "既然你们一直在全提瓦特旅行，如今稻妻之旅也该告一段落了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210242
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210242,
					"content": "作为酬谢，不论是今后的路还是过往的疑惑，就由我来给二位一并解答吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210243
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210243,
					"content": "有什么想问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210301,
					"content": "关于「人偶」将军…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "「人偶」将军的技术源自于某些现今已然失落的知识，或许只有身为神明的她才能知会其中源头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210303,
					"content": "不过…倒是有件事你们应该会感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210304,
					"content": "在影开始对自己的神明之躯进行自我改造之前，还凭空创造过一个「原型人偶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210305,
					"content": "那、那难道有三个雷电将军！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210306,
					"content": "不，那个原型只是为了验证可行性，外貌和智能都没有依托影的自身去设计，可以说算是试做品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210307,
					"content": "按照最初设想，影应当将他直接废弃，但也许影认为这样做过于残酷，便选择只将他体内的力量封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210308,
					"content": "后来，他便像个普通人一样，凭借自我意识流浪在稻妻的土地上，直到…愚人众看中了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210309,
					"content": "愚人众！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210310,
					"content": "而那个原型人偶经过愚人众里某些奇人异士的调整，解除了力量的封印，甚至比封印之前更强大也说不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210311,
					"content": "莫非…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "嗯，神之造物亲手夺去了神之心…那个原型人偶便是如今的「散兵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210313,
					"content": "居、居然还有这样的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210314,
					"content": "是啊，究竟是机缘巧合，还是天命注定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210401,
					"content": "关于前任雷电将军…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "你这个异乡人居然知道雷神曾经更易过的事…这在稻妻的国民之中也是鲜有人知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210403,
					"content": "是摩拉克斯曾经提及过，雷神巴尔也已经逝去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210404,
					"content": "嗯，事实是这样的，「巴尔」与「巴尔泽布」其实是一对双生魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210405,
					"content": "双生…魔神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210406,
					"content": "她们共同赢下魔神战争，而后来巴尔建立幕府后，巴尔泽布则以御侧「影武者」的身份，成为巴尔的替身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210407,
					"content": "巴尔泽布便是你我熟悉的影，而巴尔，其名则为「真」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210408,
					"content": "在世人眼中，她们二者从来都是统一的存在，她们两人也一直相互补足，共同治理稻妻，因而民众也没有知晓真相的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210409,
					"content": "不论是「巴尔」这个魔神名讳，还是雷电将军这个称谓，其实一直都可以看做是同时指代她们两人的，直到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210410,
					"content": "直到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210411,
					"content": "直到真死于数百年前的一场我未能亲身经历的战争，自那以后影才来到了幕前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210412,
					"content": "一定对影的打击很大吧，是姐妹的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210413,
					"content": "数百年前的…战争…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "所以影的转变也是从那时开始的，对她来说这是最大的「失去」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210416,
					"content": "原来还有这样的往事，好像更加理解影一些了…那么「真」是一个什么样的神呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210417,
					"content": "我与她相处的时间并不算长，印象里…是个温柔的神吧，总是珍惜着眼前的一切美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210418,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210501,
					"content": "#关于我的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "抱歉，这个我没什么头绪，我对你们所说的那位神明也并不了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210503,
					"content": "但如果你们还在怀疑影的话，我觉得就有些多虑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210504,
					"content": "影不仅不符合你们之前的描述，而且很久以前便主动放弃神之心，断绝了与天空岛的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210505,
					"content": "见过以后，感觉确实不是她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "那就好，不然的话，作为雷神眷属，好像我们的关系就会一下子微妙起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210507,
					"content": "放心吧，我们不会想和你打架的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210508,
					"content": "呵呵呵…祝你们早日达成目的，知晓一切真相吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210509,
					"content": "#至于你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的踪迹，我会尽我所能利用一切资源去调查的，包括从绫人那里借用一些终末番的手下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210510,
					"content": "有消息我会通知你，就算是酬谢的一部分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210601,
					"content": "关于旅途的下一站…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "离开稻妻以后的话，我想…去往须弥应该会比较便利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210603,
					"content": "须弥呀，我们一路上见过很多来自须弥的学者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210604,
					"content": "嗯，须弥是智慧之神的国度，他们对智慧与知识的探求是永无止境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210605,
					"content": "但这份执着往往也会衍生出一些令人费解的事，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210606,
					"content": "…在须弥，知识是作为一种「资源」而被统一管理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210607,
					"content": "知识…也是资源？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210608,
					"content": "嗯，只是不知道做出这种决定的究竟是那些「贤者」，还是「小吉祥草王」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210609,
					"content": "「小吉祥草王」？有些可爱的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210610,
					"content": "欸，原来你们还不清楚吗，「小吉祥草王」便是须弥所信仰的神明，是须弥人对她的爱称。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210611,
					"content": "想必你们也有些事情想要找她确认吧？祝你们顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210701,
					"content": "没什么想问的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "这样啊，那好吧。哦对了旅行者，我送给你的御守，你还留着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210703,
					"content": "当然，我会好好保管的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "好好保管，仅此而已吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210705,
					"content": "我还以为你会将它挂在胸前最显眼的位置，以后逢人便说，这可是兼具智慧与美貌的八重神子大人赠予我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210706,
					"content": "谁会那样做呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210707,
					"content": "呵呵…好了好了。说起来，旅行者，你的愿望又是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210708,
					"content": "#嗯…与{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}再次团聚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "这样吗…但我觉得，那或许只是你眼下的一个小小目标而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210710,
					"content": "对你来说，「愿望」应当是可以跨越尘世和星海，与命运一同闪耀之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210711,
					"content": "你没有神之眼，或许是因为那个愿望尚未诞生…也说不定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210712,
					"content": "就在你接下来的旅途中，去见证那一刻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210414,
					"content": "难道说…是坎瑞亚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210236,
					"content": "原来我这么值钱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210223,
					"content": "原来那个时候就已经…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210208,
					"content": "当时有点上头。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				}
			]
		},
		{
			"id": 202103,
			"completionStepIds": [
				202102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
							"2"
						],
						"stepId": 202102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20210243,
					"content": "有什么想问的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210301,
					"content": "关于「人偶」将军…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "「人偶」将军的技术源自于某些现今已然失落的知识，或许只有身为神明的她才能知会其中源头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210303,
					"content": "不过…倒是有件事你们应该会感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210304,
					"content": "在影开始对自己的神明之躯进行自我改造之前，还凭空创造过一个「原型人偶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210305,
					"content": "那、那难道有三个雷电将军！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210306,
					"content": "不，那个原型只是为了验证可行性，外貌和智能都没有依托影的自身去设计，可以说算是试做品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210307,
					"content": "按照最初设想，影应当将他直接废弃，但也许影认为这样做过于残酷，便选择只将他体内的力量封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210308,
					"content": "后来，他便像个普通人一样，凭借自我意识流浪在稻妻的土地上，直到…愚人众看中了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210309,
					"content": "愚人众！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210310,
					"content": "而那个原型人偶经过愚人众里某些奇人异士的调整，解除了力量的封印，甚至比封印之前更强大也说不定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210311,
					"content": "莫非…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "嗯，神之造物亲手夺去了神之心…那个原型人偶便是如今的「散兵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210313,
					"content": "居、居然还有这样的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210314,
					"content": "是啊，究竟是机缘巧合，还是天命注定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210401,
					"content": "关于前任雷电将军…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "你这个异乡人居然知道雷神曾经更易过的事…这在稻妻的国民之中也是鲜有人知的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210403,
					"content": "是摩拉克斯曾经提及过，雷神巴尔也已经逝去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210404,
					"content": "嗯，事实是这样的，「巴尔」与「巴尔泽布」其实是一对双生魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210405,
					"content": "双生…魔神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210406,
					"content": "她们共同赢下魔神战争，而后来巴尔建立幕府后，巴尔泽布则以御侧「影武者」的身份，成为巴尔的替身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210407,
					"content": "巴尔泽布便是你我熟悉的影，而巴尔，其名则为「真」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210408,
					"content": "在世人眼中，她们二者从来都是统一的存在，她们两人也一直相互补足，共同治理稻妻，因而民众也没有知晓真相的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210409,
					"content": "不论是「巴尔」这个魔神名讳，还是雷电将军这个称谓，其实一直都可以看做是同时指代她们两人的，直到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210410,
					"content": "直到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210411,
					"content": "直到真死于数百年前的一场我未能亲身经历的战争，自那以后影才来到了幕前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210412,
					"content": "一定对影的打击很大吧，是姐妹的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210413,
					"content": "数百年前的…战争…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "所以影的转变也是从那时开始的，对她来说这是最大的「失去」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210416,
					"content": "原来还有这样的往事，好像更加理解影一些了…那么「真」是一个什么样的神呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210417,
					"content": "我与她相处的时间并不算长，印象里…是个温柔的神吧，总是珍惜着眼前的一切美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210418,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210501,
					"content": "#关于我的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "抱歉，这个我没什么头绪，我对你们所说的那位神明也并不了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210503,
					"content": "但如果你们还在怀疑影的话，我觉得就有些多虑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210504,
					"content": "影不仅不符合你们之前的描述，而且很久以前便主动放弃神之心，断绝了与天空岛的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210505,
					"content": "见过以后，感觉确实不是她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "那就好，不然的话，作为雷神眷属，好像我们的关系就会一下子微妙起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210507,
					"content": "放心吧，我们不会想和你打架的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210508,
					"content": "呵呵呵…祝你们早日达成目的，知晓一切真相吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210509,
					"content": "#至于你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的踪迹，我会尽我所能利用一切资源去调查的，包括从绫人那里借用一些终末番的手下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210510,
					"content": "有消息我会通知你，就算是酬谢的一部分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210601,
					"content": "关于旅途的下一站…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "离开稻妻以后的话，我想…去往须弥应该会比较便利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210603,
					"content": "须弥呀，我们一路上见过很多来自须弥的学者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210604,
					"content": "嗯，须弥是智慧之神的国度，他们对智慧与知识的探求是永无止境的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210605,
					"content": "但这份执着往往也会衍生出一些令人费解的事，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210606,
					"content": "…在须弥，知识是作为一种「资源」而被统一管理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210607,
					"content": "知识…也是资源？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210608,
					"content": "嗯，只是不知道做出这种决定的究竟是那些「贤者」，还是「小吉祥草王」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210609,
					"content": "「小吉祥草王」？有些可爱的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210610,
					"content": "欸，原来你们还不清楚吗，「小吉祥草王」便是须弥所信仰的神明，是须弥人对她的爱称。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210611,
					"content": "想必你们也有些事情想要找她确认吧？祝你们顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210701,
					"content": "没什么想问的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "这样啊，那好吧。哦对了旅行者，我送给你的御守，你还留着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210703,
					"content": "当然，我会好好保管的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "好好保管，仅此而已吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210705,
					"content": "我还以为你会将它挂在胸前最显眼的位置，以后逢人便说，这可是兼具智慧与美貌的八重神子大人赠予我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210706,
					"content": "谁会那样做呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210707,
					"content": "呵呵…好了好了。说起来，旅行者，你的愿望又是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210708,
					"content": "#嗯…与{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}再次团聚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "这样吗…但我觉得，那或许只是你眼下的一个小小目标而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210710,
					"content": "对你来说，「愿望」应当是可以跨越尘世和星海，与命运一同闪耀之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210711,
					"content": "你没有神之眼，或许是因为那个愿望尚未诞生…也说不定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210712,
					"content": "就在你接下来的旅途中，去见证那一刻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20210414,
					"content": "难道说…是坎瑞亚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				}
			]
		}
	]
}