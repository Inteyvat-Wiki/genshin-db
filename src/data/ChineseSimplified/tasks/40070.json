			},
			"dialogs": [
				{
					"id": 400701901,
					"content": "我们把花瓣种下去了，你能感觉到什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701902,
					"content": "嗯…有了。阳光不错，海上有宝石般绚烂的光芒，浪拍打着乳白色的沙滩，那些沙粒流入海中，又被推回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400701903,
					"content": "…有海鸟落在岩石上，轻轻啄着，发出有节奏的乐曲。咚咚，咚咚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400701904,
					"content": "是音乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701905,
					"content": "是音乐啊。说起来，这座岛本就是一件庞大的乐器。既然你是音乐人，应该能理解其中的深意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400701906,
					"content": "用海风、浪花与潮汐演奏音乐，是这个世界上最浪漫的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701907,
					"content": "走吧各位，是时候请你们听听我的演出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		}
