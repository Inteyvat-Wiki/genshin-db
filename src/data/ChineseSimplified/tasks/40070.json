				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701601,
					"content": "奇怪，一路过来只有岛上的本土怪物，没有愚人众了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701602,
					"content": "驻扎的痕迹和装置都还在，但人都不见了，好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701603
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701603,
					"content": "（我一直认为，这些幻境的诞生与这台愚人众装置关系很大。它看起来已经坏了，也许这就是问题的根源。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701604
					]
				},
				{
					"id": 400701604,
					"content": "（…假如装置能让人产生幻觉，那他们自己为什么消失了？还是说，另有隐情？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701605
					]
				},
				{
					"id": 400701605,
					"content": "（找不到人，是因为他们消失了，还是他们在躲避我们？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701606
					]
				},
				{
					"id": 400701606,
					"content": "算了，占卜一下看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701607
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701608
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701608,
					"content": "嗯？这是…力量在流动？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701609
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701609,
					"content": "各位，似乎没能占出愚人众的踪迹，水占盘又变得浑浊了，但这次我能感知到某种力量正在汇聚成型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701610
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701610,
					"content": "目的地是…那边的小岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701611
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701611,
					"content": "这次会是跟谁有关的幻境呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701612
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701612,
					"content": "唔…过去看看吧，说不定会有线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
