			},
			"dialogs": [
				{
					"id": 400701701,
					"content": "到了各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701702,
					"content": "咦？菲谢尔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701703,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400701704,
					"content": "真的是她！菲谢尔——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701705,
					"content": "…哼，来了吗，诸位愚笨的家臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400701706,
					"content": "哦、哦呀，好久不见了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400701707,
					"content": "也没那么久吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701708,
					"content": "啊…小姐和我察觉到某种气息，特意提前赶往此处，等待与诸位会合。没想到，诸位…诸位来得比想象中更快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400701709,
					"content": "奥兹看起来有点紧张？是我的错觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701710,
					"content": "幽夜净土降临在即，本皇女还需要筹备祝圣仪典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400701711,
					"content": "小姐，您又要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400701712,
					"content": "我一人也可行动，奥兹，你若是厌烦了夤夜的侵袭，就退回到白日炽光中去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400701713,
					"content": "小姐，如此话语可不像您该对我说的。我是您的扈从，您的眼睛，不可能丢下您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400701714,
					"content": "…少在那里用打量的眼神看着我了！总、总之，现在还没到解释的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400701715,
					"content": "哎呀，小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400701716,
					"content": "诸位，万分抱歉，小姐心情不好，还请不要放在心上。也恕我先失陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400701717,
					"content": "…哈，离队这么久，心情也没好起来嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701718,
					"content": "看到菲谢尔，我就觉得这一带即将成型的幻境应该跟她有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701719,
					"content": "嗯。靠近与我有关的幻境时，我隐约能感觉到某种熟悉的气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701720,
					"content": "我也是。虽然并无道理，只是觉得有什么有意思的东西要出现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701721,
					"content": "嗯。菲谢尔和奥兹能有所感知，说明这份预感也会成真…菲谢尔应该就是不想面对她的幻境，才这么焦躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701722,
					"content": "怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701723,
					"content": "或许，她的幻境中隐藏着某些不希望被人知道的秘密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701724,
					"content": "各位，我们先在这里休息吧。等幻境出现，谜底自然就会揭开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
