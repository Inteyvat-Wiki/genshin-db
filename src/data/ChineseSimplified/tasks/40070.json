			"dialogs": [
				{
					"id": 400701801,
					"content": "能做的都做了，剩下那两座山怎么也解决不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701802,
					"content": "再想想，会有办法的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701803,
					"content": "刚才我仔细看过，岛上几座山内部多半都有水脉和植物，这种体系将它们串联在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701804,
					"content": "但现在山体坍塌，植物和水脉无法连通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701805,
					"content": "如果所有脉络都被打通，它们就会连接起来，形成阿贝多笔记中所说的「巨型乐器」，以岛屿为单位演奏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701806,
					"content": "嗯，为了我想做的事，必须做到这一点…我想去问问那朵花，它应该知道办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
