			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"火炽之心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "岛上有些山体失去了植物和水脉，请问你有办法疏通它们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400700402,
					"content": "这件事，我知道一个人能帮忙。楼上住着我的同伴冰封之心，去问问它吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "火炽之心"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"冰封之心",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "你们是什么人？竟然会到我这里来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700502,
					"content": "你好，我们想借助你的力量疏通岛上那几座山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400700503,
					"content": "山？噢，我知道了…你们也想成为大音乐家，是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700504,
					"content": "欸？是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400700505,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400700506,
					"content": "既然如此，我们就是志同道合的伙伴了。即使我很柔弱，也要为你们献上一份力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700507,
					"content": "拿着我的花瓣，把它种在音律交汇的终点，沉入地下的山脉将为这乐声升起。只要我们还有音乐，生命就会流淌在每一寸土地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700508,
					"content": "…谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"莫娜",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701002,
					"content": "终于，到这个时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701003,
					"content": "各位，我曾许下一个愿望，要跟谁都想不到的人一起办演唱会。而今天，我在海岛上找到了答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701004,
					"content": "许多年前将这座岛制成巨型乐器的人，没人知道他的名字和长相，但他绝对是提瓦特最伟大的音乐家之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701005,
					"content": "我从没想过能见到这样一件乐器。更想不到，我们能趁着潮汐奏响它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701006,
					"content": "要演奏摇滚乐了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "不。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701008,
					"content": "音乐是献给知己的礼物，所以…我会选择更适合这位原住民的方式与他合奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701009,
					"content": "今天就不玩摇滚乐了，给大家看点新花样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701010,
					"content": "…呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701011,
					"content": "怎么样？我的演奏还不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701012,
					"content": "非常不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701013,
					"content": "从未听过这样的合奏，很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701014,
					"content": "而且很高雅！我不知道该怎么说…反正很不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701015,
					"content": "很有性格的演出。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "嘿嘿，谢谢大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701018,
					"content": "这样一来，我的愿望也算是完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701019,
					"content": "还有什么想做的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701020,
					"content": "没有了。今晚应该能睡个好觉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701021,
					"content": "接下来大家都闲着对吧？那我有个提议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701022,
					"content": "我想再去一趟愚人众营地，确认那里的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701023,
					"content": "嗯？原来你们也发现愚人众营地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701024,
					"content": "等等，你也知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701025,
					"content": "我可是天才占星术士，而且我不是说过？水占盘恢复一点了。我能通过占卜感觉到这里的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701026,
					"content": "咦，这里都有愚人众？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701027,
					"content": "对。今天跟菲谢尔分开时，我也把这件事告诉她了。假如遇到愚人众，她会隐藏起来，不会有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701028,
					"content": "原来如此，那我们也坦白吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701029,
					"content": "将登岛那天遇到愚人众营地和奇怪装置的事仔细说给其他人听…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "奇怪的装置，神志不清的愚人众…你们的意思是，这些跟最近的幻境有关？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701031,
					"content": "不能保证。但我觉得，两者之间不应该完全没有关联。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400701032,
					"content": "有道理，那赶快去营地看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701016,
					"content": "很有韵味的演出。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
		{
			"id": 4007016,
			"completionStepIds": [
