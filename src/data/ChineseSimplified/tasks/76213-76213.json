			"dialogs": [
				{
					"id": 762130201,
					"content": "梦幻空花，何劳把捉？便是究理千年，一心不生，只是不会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130202,
					"content": "所以…你是在找书吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "你曾到过此地么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130204,
					"content": "啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "那你便会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130208,
					"content": "会…会什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "要眠即眠，要会即会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130211,
					"content": "你且归，世界坏时，归去就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130209,
					"content": "如何是会？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "到过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "没到过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "完全听不懂，告辞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "直走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丛沈"
				}
			]
		}
