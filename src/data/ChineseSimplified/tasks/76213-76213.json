			"dialogs": [
				{
					"id": 762130101,
					"content": "咦？这边的房间好像被书给堵住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762130102,
					"content": "寻书么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130103,
					"content": "嗯…倒也不是要找书啦，只是稍微有点好奇这里面是什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762130104,
					"content": "好像可以从旁边绕进去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "那便进不去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130106,
					"content": "且移书，且移书。若不如是，则不曾到也。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130107,
					"content": "听不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "且移书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130109,
					"content": "如何是移书？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "书不在便是移书。老僧只管看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "丛沈"
				},
				{
					"id": 762130111,
					"content": "那我用小右试试看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "直去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丛沈"
				}
			]
		},
