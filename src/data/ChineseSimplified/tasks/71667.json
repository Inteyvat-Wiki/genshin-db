			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "两位，等你们好久啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670102,
					"content": "和爆炎树交上朋友了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "唉，别提了。经过你那一番「交涉」，它安分是安分了，但也就那么一小会儿而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670104,
					"content": "一恢复过来，马上又是要置我于死地的架势，真是吓人。看来你们是对的，要和爆炎树交朋友还是太勉强了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670105,
					"content": "啊，不过爆炎树的果实味道还是不错的，有火元素的味道。纳塔朋友应该会喜欢吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670106,
					"content": "好难想象是什么味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670107,
					"content": "你要尝尝看吗？如果要的话我现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670108,
					"content": "还、还是不用了！话说回来，你是准备继续去挑战古岩龙蜥吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670109,
					"content": "是啊。我觉得这次赢面很大，毕竟古岩龙蜥和嵴锋龙挺像的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670110,
					"content": "如果你们像我一样从须弥去纳塔的话，多半第一个碰见的就是它们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670111,
					"content": "好吧，不过我还是有种这次也不会成功的感觉…为什么不考虑一下幼岩龙蜥呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670112,
					"content": "…没有圆滚滚的肚皮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670113,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716670114,
					"content": "幼岩龙蜥没有圆滚滚的肚皮。一定是因为它们经常以匪夷所思的速度转圈，所以几乎没有囤积脂肪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670115,
					"content": "唉，不过最主要的理由还是缺乏冲击力吧。对那些和龙一起生活的纳塔朋友来说，幼岩龙蜥有什么稀奇的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670116,
					"content": "古岩龙蜥就不一样了，哪怕在故事里也算得上是够格的对手了。对手强才能显得主角强嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670117,
					"content": "好啦，咱们也别耽搁了，古岩龙蜥就在前面等着我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "兰吉特"
				},
				{
					"id": 716670118,
					"content": "那就走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "还有别的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "没问题，我就在这儿等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰吉特"
				}
			]
		}
	]
}