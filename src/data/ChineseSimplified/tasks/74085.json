			"dialogs": [
				{
					"id": 740850201,
					"content": "钥匙，雕像，钥匙，雕像，钥匙，雕像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850202,
					"content": "嗯…你是说把钥匙放进雕像？这样倒是刚刚好，三把钥匙对三座雕像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850203,
					"content": "我们先试试吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850204,
					"content": "放好钥匙后会发生什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "门开，开门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850206,
					"content": "门？哪儿呢？门后面有什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850207,
					"content": "根，伊黎耶，十分很深…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850208,
					"content": "门通往伊黎耶岛的根？！珀西芙，你你…你知道的东西好多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850209,
					"content": "珀西芙，守护！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850210,
					"content": "还有什么需要我们知道的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850212,
					"content": "就是情报啦，信息啦，越多越好，知道的越多，我们就越有把握！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850213,
					"content": "信…息？信…息…珀西芙！信息，十分很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850214,
					"content": "太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850215,
					"content": "伊黎耶，信息，十分很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850216,
					"content": "嗯…信息很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850217,
					"content": "信息，水脉，十分很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850218,
					"content": "嗯…水脉很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850219,
					"content": "水脉，那位来客，十分很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850220,
					"content": "嗯…嗯？！那位来客很多？！等等，我没懂…哪来的那么多位来客啊？那位来客会分身魔法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850221,
					"content": "美露莘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850222,
					"content": "水脉，那位来客，品尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850223,
					"content": "邪恶，那位来客，感知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850224,
					"content": "品尝水脉里的邪恶？这是什么奇怪的口味啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850225,
					"content": "那位来客能感知水脉里的信息？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850227,
					"content": "垂柳，收集。雾道，处理。泉眼，发送。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850228,
					"content": "根，水脉，中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850229,
					"content": "伊黎耶岛是信息中心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "你是说整个伊黎耶岛是那位来客的一个信息系统？他可以通过这个感知一些不好的东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850231,
					"content": "#聪明派蒙！聪明{NICKNAME}！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850232,
					"content": "天呢，这个叫做那位来客的来客究竟是什么人物啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850233,
					"content": "枫丹，那位来客，守护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850234
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850234,
					"content": "但是，那位来客，十分很忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850235
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850235,
					"content": "紫东西，偷偷往根去。紫东西，偷偷破坏根。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850236,
					"content": "珀西芙，偷偷偷看。珀西芙，偷偷磨石碑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850237
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850237,
					"content": "啊，原来是你把石碑上的字抹掉的！是为了阻止那个家伙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850238,
					"content": "珀西芙！但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850239
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850239,
					"content": "紫东西，还往根去。紫东西，十分很厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850240,
					"content": "他找到了别的路？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850241
					]
				},
				{
					"id": 740850241,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850242
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850242,
					"content": "看来这家伙真的有点难对付啊…破坏了根，信息系统就会失灵，那位来客的感知能力就会受到影响…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850243,
					"content": "珀西芙，责任！珀西芙，守护！",
