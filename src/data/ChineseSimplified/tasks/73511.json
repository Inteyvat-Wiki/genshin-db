			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"维纳亚克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110301,
					"content": "从这个角度潜入，利用地形进行遮蔽…只要太阳高度角不高于…我的速度不低于…嗯，果然还是无解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110302
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110302,
					"content": "你在算什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110303
					]
				},
				{
					"id": 735110303,
					"content": "「在不正面接触魔物的情况下回收零件的可行路线」…拜沙虫所赐，我的宝贝零件全被卷进附近的魔物堆里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110304
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110304,
					"content": "——呜哇！你们是谁？是什么时候来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110305
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110305,
					"content": "都在边上听你嘀咕好久了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110306
					]
				},
				{
					"id": 735110306,
					"content": "放心吧，我们不是坏人。是你的同伴让我们来的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110307,
					"content": "同伴？难道是施芮娅？不对啊，她明明说，就算我被魔物抓走也不管我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110308
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110308,
					"content": "啊——我明白了，她是让你们俩来回收零件的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110309
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110309,
					"content": "我有没有被抓走无所谓，零件没人回收了可是大事…嗯，像是她会说的话，合情合理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110310
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110310,
					"content": "…你就当是这样吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110311
					]
				},
				{
					"id": 735110311,
					"content": "不过还是得多谢你们啦，刚才我怎么算都求不出解，都想直接冲出去，走一步再算一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110312
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110312,
					"content": "…搞不好一步算错，就真要被魔物逮着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110313
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110313,
					"content": "唉，要是没我在，施芮娅又那么笨手笨脚的…还有谁能照料好这些机械啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110314
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735110314,
					"content": "我算是理解施芮娅为什么那么担心了…这个人脑子里真的全是机械零件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110315,
					"content": "#{NICKNAME}，我们快把零件给收集起来吧！免得他又想冒险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
