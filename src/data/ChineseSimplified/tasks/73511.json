	"talks": [
		{
			"id": 7351101,
			"completionStepIds": [
				7351101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351101",
							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"施芮娅",
					"福迪尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110101,
					"content": "那个笨蛋…居然就这么冲进沙漠了！福迪尔大哥，求求你们，快去救救他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110102
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110102,
					"content": "很抱歉，村子里的守备力量有限，还要防着「它们」乱来，暂时没有那么多余力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110103
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 735110103,
					"content": "可那个笨蛋那么拼命，也是为了对付「它们」啊！至少看在利害一致的份上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110104
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110104,
					"content": "唉，也不是我们不想去找。但是守卫们现在分散在沙漠各处，提防「它们」的动向，召集人手也需要时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110105
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 735110105,
					"content": "怎么会这样…现在回喀万驿找人帮忙，肯定也来不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110106,
						735110107
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110106,
					"content": "有谁有危险吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				},
				{
					"id": 735110108,
					"content": "嗯？你们是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110109
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110109,
					"content": "一名路过的冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110110
					]
				},
				{
					"id": 735110110,
					"content": "#——以及{M#他}{F#她}最要好的伙伴派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110111,
					"content": "冒险家？真的吗！谢天谢地，维纳亚克那家伙，终于有救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110112
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110112,
					"content": "#冒险家{M#先生}{F#小姐}！请您救救维纳亚克吧，报酬绝对不成问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110113
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110113,
					"content": "先说说是什么情况？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110114
					]
				},
				{
					"id": 735110114,
					"content": "嗯，沙漠里现在有「它们」作乱，比平时要危险不少，最好先听完情况说明再作打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110115
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 735110115,
					"content": "呃…你们说得对，抱歉，我有点儿心急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110116
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110116,
					"content": "从刚才起就一直听你们在说了，「它们」究竟是什么东西啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110117,
					"content": "——是一群沙虫。也不知道为什么，它们的性情最近变得异常凶暴，还会潜藏在沙暴里袭击过往的猎物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110118,
						735110119
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 735110118,
					"content": "不过是些虫子而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110120,
					"content": "…话是这么说，但这次的数量实在太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110121
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 735110121,
					"content": "有沙暴作掩护，也很难对它们造成多大的伤害。一觉得有危险，那些家伙就会立刻逃走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110122
					],
					"speakerTitle": "福迪尔"
				},
				{
					"id": 735110122,
					"content": "唔，那确实还挺棘手的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110123,
					"content": "不止是阿如村，还有一些过往行商也受到了影响。所以，教令院派了我和维纳亚克来处理这些作乱的沙虫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110124
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110124,
					"content": "可我们托商队送来的一部分「零件」在半路上被沙虫袭击，还被沙暴卷得到处都是，现在…恐怕已经变成魔物们的玩具了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110125
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110125,
					"content": "我原本想先回喀万驿求援，谁知道维纳亚克那家伙，过了那么多年还是跟机械一样呆板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110126
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110126,
					"content": "他说着什么要救回他的宝贝零件，一个人就冲进沙漠里了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110127
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110127,
					"content": "啊啊——干脆让魔物抓走他算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110128
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110128,
					"content": "#呜哇…怎么办，{NICKNAME}？要是放着不管的话，不仅那位学者有危险，沙虫的问题也不好解决…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110129,
						735110130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735110129,
					"content": "不能对沙漠的危机置之不理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110131,
					"content": "唉…谢谢，谢谢！抱歉，刚刚被气得有点失言了…我这就在地图上标出遇袭的地点，咳，请您尽快找到他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110132
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110132,
					"content": "希望他的脑袋，还没生锈到直接冲进魔物堆里捡零件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735110130,
					"content": "救援的工作就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110119,
					"content": "我对付过更大只的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110107,
					"content": "你们需要帮助吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				}
			]
		},
		{
			"id": 7351103,
			"completionStepIds": [
				7351103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
