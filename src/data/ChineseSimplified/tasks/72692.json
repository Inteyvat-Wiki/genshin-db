					"content": "朋友，画片已经准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726920202,
					"content": "在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "让我看看…嗯，很好，我已经有些想法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726920204,
					"content": "朋友，这次我也根据你带来的画片，写了不同版本的诗句，就由你来选选看用哪一句吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱内"
				}
			]
		},
