			"dialogs": [
				{
					"id": 726920601,
					"content": "哈哈，我听说像风一样自由地飞行是所有蒙德人的梦想，这句诗可说是极有莱内先生的风格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920602
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920602,
					"content": "只可惜我小时候并不喜欢出门。如果那时候能有大伴先生作陪的话，可能我现在就有飞行执照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱内"
