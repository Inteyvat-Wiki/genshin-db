			"dialogs": [
				{
					"id": 726920501,
					"content": "朋友，既然大伴先生和你都很喜欢这一句，那就这么决定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726920502,
					"content": "莱内先生的诗，与画片相得益彰，伴着画片读诗，诗也越发生动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920503,
					"content": "#{M#小哥}{F#姑娘}，其实最近我也正在写一首诗，明天也要劳你相助了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920504,
					"content": "大伴先生也需要画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "呵呵，我们明天再详谈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
