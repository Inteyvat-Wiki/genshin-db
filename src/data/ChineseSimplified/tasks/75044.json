				{
					"id": 750444701,
					"content": "（用幼稚而潦草的字写着：）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "小孩的笔记"
				},
				{
					"id": 750444702,
					"content": "这个游戏叫做「咚咚冻冻龙咚咚」，规则是这样的：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "小孩的笔记"
				},
				{
					"id": 750444703,
					"content": "1、咚咚幻写灵不咚咚的时候，骑在龙雕像的背上，龙雕像就会往前走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "小孩的笔记"
				},
				{
					"id": 750444704,
					"content": "2、咚咚幻写灵倒计时到「咚！」的时候，必须从龙雕像身上下来，不然就会输。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "小孩的笔记"
				},
				{
					"id": 750444705,
					"content": "3、最先跑到咚咚幻写灵身边，就能赢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "小孩的笔记"
				},
				{
					"id": 750444706,
					"content": "不许说「写那么多，不就是三二一木头人嘛！」，规则是很重要的，而且，就是因为不尊重规则，大家才赢不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小孩的笔记"
				}
			]
		}
	]
