			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "上层召龙平台全天开放，有意加入马塔伽特训场的人与龙请至上层召龙起飞。谨记：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "醒目的标语"
				},
				{
					"id": 750440702,
					"content": "以认真积极训练为荣，以怠惰消极偷懒为耻！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "醒目的标语"
				},
				{
					"id": 750440703,
					"content": "今天你我不努力，明天只能吃垃圾！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "醒目的标语"
				},
				{
					"id": 750440704,
					"content": "努力奋勇向前，拥抱卓越龙生！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "醒目的标语"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "口令是先吹左边的号角，然后是右边的，接着是左边的，最后是右边的，不要乱吹，后果自负！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "马塔伽！记得！！"
				},
				{
					"id": 750440802,
					"content": "最好喂一点禽肉，防止龙心情不好导致自己被啄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "马塔伽！记得！！"
				},
				{
					"id": 750440803,
					"content": "（似乎是一个叫马塔伽的人写给自己看的备忘，即使透过文字也能感受到激烈的情绪。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "马塔伽！记得！！"
				},
				{
					"id": 750440804,
					"content": "（不过给备忘的每一条都加上感叹号，不就等于没有加？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塔伽！记得！！"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
