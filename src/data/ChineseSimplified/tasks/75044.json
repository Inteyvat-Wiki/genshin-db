				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "「…北边的石壁后，有一条通往瀑布上方的小径。似乎可以被用作<color=#00E1FFFF>储藏室</color>…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "「…稍稍做了一些标记，以免自己之后也忘了怎么走…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "「…萨雅妮的伤情又恶化了，环境过于潮湿…劝说她休息，笑着拒绝了…说是会拖慢小队进度，害大家拿不到额外配给…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "「…夜里要趁着别人不注意，去上面给她带一支火炬，用来燎烧伤口，否则她的四肢也会一起腐烂…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
