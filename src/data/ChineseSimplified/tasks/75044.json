					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "「…奉圣火的{RUBY#[D]雅豪卡阿胡克}看护者、至仁至耀的圣{RUBY#[D]蒂沙库恩}王奥奇坎陛{RUBY#[D]卡洛穆特}下之命，为兴修水利设施，现于诸部族征募劳工…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "「…不计定额，全凭自觉自愿…建设联盟…望各部族积极响应为要…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "「奉圣火的{RUBY#[D]雅豪卡阿胡克}看护者、至仁至耀的圣{RUBY#[D]蒂沙库恩}王奥奇坎陛{RUBY#[D]卡洛穆特}下之命，即日起封锁受诅之地，全联盟成员一律禁止入内。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "「擅自闯入者将被正式认定为联盟的敌人，这是（…）、纳茨卡延、梅兹特利、维茨特兰与特特奥坎共同的宣言。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "「愿荣耀永远属于圣火的{RUBY#[D]雅豪卡阿胡克}看护者，伟大的和{RUBY#[D]卡塔兹杰}平缔造者，至仁的圣{RUBY#[D]蒂沙库恩}王奥奇坎。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "「鉴于本区域排水工程整体进展较为缓慢，为保障联盟不可阻挡的胜利，现对轮换制度做出合理微调。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "「将劳工划分为三队，每队工作十六小时，两日循环一次。表现卓越的小队将获得额外的谷物配给。」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "「<color=#00E1FFFF>排空积水</color>的胜利曙光近在咫尺，待沟渠完工，<color=#00E1FFFF>抽水机</color>便可以正常运作。再加把劲！」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "「…同胞们，亲人们，为联盟不可阻挡的胜利而奉献的兄弟姐妹们…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "「…至仁的…自（…）调拨一批新式机关，以支援运输、（…）与<color=#00E1FFFF>水下打捞</color>…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "「…前进，再前进，不惜代价前进…为了联盟辉煌的未来，为了我们每个人的自由与荣耀，为了不再被恶龙凌压的家园…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "「…未经许可…禁止擅自触动<color=#00E1FFFF>操作杆</color>…跌落事故…已致使三名劳工…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
