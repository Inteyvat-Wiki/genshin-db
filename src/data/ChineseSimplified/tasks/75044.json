			"dialogs": [
				{
					"id": 750442401,
					"content": "「…愿荣耀永远…和平缔造者…至仁的…奥奇坎…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "「…工匠马胡钦特利、特拉南库，并…负责建设抽水…消极怠工，以致延误…仁慈…不施以刑罚…暂停配给三周…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "「…启动<color=#00E1FFFF>抽水机关</color>的<color=#00E1FFFF>石造钥匙</color>…置于…不得擅自…直至另行调配工匠…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
