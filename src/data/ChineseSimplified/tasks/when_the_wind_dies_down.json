			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宁禄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "谢谢你们！这一切终于真正地结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 3980302,
					"content": "受龙灾的影响，好多商路都不通了。粮食水果也就算了…酒要是断了货，那可真就要命咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 3980303,
					"content": "我没法想象没有酒喝的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 3980304,
					"content": "唉，希望商道的修复可以快一些完成吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
