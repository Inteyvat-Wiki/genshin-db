				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "啊，是你们！荣誉骑士凯旋归来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980102,
					"content": "#嘿嘿，{NICKNAME}陪特瓦林好好折腾了一番呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980103,
					"content": "嗯，你们是昨天回来的吧？琴团长比你们先回蒙德，你们的事迹，她都已经告诉大家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980104,
					"content": "呼…我什么时候也能有这样的机会呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980105,
					"content": "多亏了安柏的引荐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "不对不对，事情能这样和平解决，是多亏了你们才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980107,
					"content": "那时我把你们带来蒙德，也只是普通地尽了侦察骑士的职责而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980111,
					"content": "哼哼，不用客气——对了，安柏是在这里等我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980112,
					"content": "呃，虽然我这次的任务不是出征，但也没那么闲啦…你看，正在忙着做善后工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980113,
					"content": "「善后工作」？蒙德城这边发生什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980114,
					"content": "嗯…趁我们没有琴团长指挥的时候，附近的魔物向蒙德城发动了「总攻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980115,
					"content": "好在很早之前我就侦察到了动向，丘丘人的聚落不自然地向蒙德城附近迁移。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980116,
					"content": "啊，我还记得。我们第一次见面的时候，你正在清理其中一个营地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980117,
					"content": "对，如果不是我们之前早有准备，蒙德城就会陷入危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980118,
					"content": "成功击退了就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "嗯，可是事情依旧蹊跷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980120,
					"content": "丘丘人应该没有发动总攻的组织能力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980123,
					"content": "所以我们猜测，这背后也是深渊教团在捣鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980124,
					"content": "他们操纵了那些丘丘人吗？嗯…如果我们不去解救特瓦林，那特瓦林也会像这样被操纵吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980125,
					"content": "没错。身为侦察骑士，看来今后要想办法多多监视深渊教团的家伙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980126,
					"content": "啊，真是不好意思。明明你们才刚经历大战归来，我就又说起这些严肃的话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980127,
					"content": "对了！我记得之前有过约定，要请你们吃「蜜酱胡萝卜煎肉」的，可后来一直在忙龙灾的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980128,
					"content": "不如这次就当作庆功，我来请你们吃吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980129,
					"content": "好耶！就算安柏忘了，派蒙也不会忘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980130,
					"content": "嘿嘿，我也好久没吃「蜜酱胡萝卜煎肉」了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980131,
					"content": "你们先去<color=#00E1FFFF>「猎鹿人」</color>等我吧，等战场打扫完了，我就过去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980121,
					"content": "可是为什么丘丘人会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "是很奇怪，丘丘人应该没有发动总攻的组织能力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980108,
					"content": "希望这样的「机会」不要太多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "啊…说得也对，毕竟和平来之不易嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980110,
					"content": "这次也是多亏了你们，事情才能这样和平解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "安柏"
				}
			]
		},
