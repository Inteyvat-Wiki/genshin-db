			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "既然龙灾已经告一段落，你们接下来有什么安排呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980902,
					"content": "#大概会离开蒙德，继续以走遍七国为目标，寻找{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}亲人的线索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980903,
					"content": "这样啊…那也就是说要暂时分别了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980904,
					"content": "我也舍不得离开蒙德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "没关系！不管去了哪里，只要是风能够吹到的地方，你永远都是西风骑士团的战友，是荣誉骑士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980907,
					"content": "听凭风引！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "嗯！蒙德随时欢迎你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980910,
					"content": "嘿嘿，我们快点吃吧，再多聊一会儿，肉就要凉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980911,
					"content": "嗯——好吃。不愧是安柏的推荐菜，没让我白白期待呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980912,
					"content": "那当然啦，虽然我对厨艺没什么自信，但我的品味还是很不错的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
