			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莎拉",
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "啊，客人今天要点些什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 3980702,
					"content": "唉…真是无情啊，就这样无视了我这个「挚友」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980703,
					"content": "不小心把你看漏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "哈哈哈…看来大战之后，你不仅是实力成长了，还具备了骑士「幽默」的美德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980707,
					"content": "蒙德的新晋英雄站在我的面前，身为骑士，感觉真是士气大振啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980708,
					"content": "凯亚又在花言巧语了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980709,
					"content": "哈哈，我说的可都是真心话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980710,
					"content": "你在这边做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "我正准备找个清静些的地方，好好整理一下思绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980712,
					"content": "明明其他骑士都在辛苦地打扫战场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980713,
					"content": "思考也是一件辛苦的差事啊，我倒觉得清理那些垃圾更轻松一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980717,
					"content": "嗯？那你在思考些什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980718,
					"content": "是关于…深渊教团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980719,
					"content": "龙灾肆虐，骑士团长身在远方、讨伐巨龙，这对深渊教团来说，是非常好的战略机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980720,
					"content": "如果你是深渊教团的怪物，你会只派丘丘人来「抓住这个好机会」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980721,
					"content": "只有丘丘人进攻，确实奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "为了看清真相，我的决定是等待——等着观察他们的进一步行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980724,
					"content": "直到你们把风龙废墟搞得天昏地暗，丘丘人的喊声在城门响起的那天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980725,
					"content": "我终于在蒙德城里，发现了可疑的身影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980726,
					"content": "城里？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980727,
					"content": "嗯，其他骑士在城外御敌的时候，不就是城内防御最空虚的时候吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980728,
					"content": "所以，留守城中的我，就与深渊教团的潜入者…周旋了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980729,
					"content": "通过一些小手段，我获得了新的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980730,
					"content": "情报是：这些集结起来的深渊教团怪物，在它们背后，还有一位统领者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980731,
					"content": "深渊教团的…统领者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980732,
					"content": "将特瓦林改造成战争兵器的计划，也是那位统领者所谋划的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980733,
					"content": "用什么样的「小手段」，才能打听出这些啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980734,
					"content": "呵呵呵…你们可以认为是我在「语言」方面的天然才华吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980735,
					"content": "#那位统领者，被深渊教团的怪物称为…「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}殿下」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980736,
					"content": "#「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "好了，情报共享就先到这里，我好像看到安柏正在向这边过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980738,
					"content": "没去城门陪她一起御敌，她好像还在生我的气…请容我先离开一下，避避风头吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980739,
					"content": "凯亚那个家伙居然跑掉了！做贼心虚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980740,
					"content": "其实他也在暗地里努力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "是这样吗？唔…该不会你被他的什么花言巧语骗了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980744,
					"content": "算了，先不提他啦。累了这么久，我已经肚子咕咕叫了，还是先点菜吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980745,
					"content": "莎拉小姐，我要「蜜酱胡萝卜煎肉」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980742,
					"content": "对！真是个坏家伙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "是呀，骑兵队长居然这么不以身作则，哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980722,
					"content": "那么，真相是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "你又在打什么主意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "我吗？不不，恰恰相反，我在思考「别人」正在打什么主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980716,
					"content": "我正准备找个清静些的地方，好好整理一下思绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3980705,
					"content": "是你啊，我的挚友凯亚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "哦~我的热情得到回应了，这就是真诚的魅力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "凯亚"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39809",
							"2"
						],
						"stepId": 39809,
						"stateName": "QUEST_STATE_UNFINISHED"
