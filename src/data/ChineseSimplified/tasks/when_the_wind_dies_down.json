			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞丝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "原来是「四风守护」之一的特瓦林大人啊…蒙德人不该忘记他旧日的自我牺牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 3980202,
					"content": "不幸中的万幸，我们与「东风之龙」特瓦林大人的关系，还没有走到不可挽回的地步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 3980203,
					"content": "这多亏了你们，还有骑士团的琴团长，真是个虔诚的人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 3980204,
					"content": "有西风骑士团在的话，今后的蒙德也会一如既往地安宁自由下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
