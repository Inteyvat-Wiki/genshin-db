			"dialogs": [
				{
					"id": 3980401,
					"content": "来了来了，热闹起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 3980402,
					"content": "危机啊，灾难啊！冒险啊，热血啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 3980403,
					"content": "冒险家协会！终于！要脱离那些抓猫抓狗的琐碎委托了！新的冒险时代就要来临了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 3980404,
					"content": "年轻人啊，快来加入冒险家协会吧！在这动荡的时期，共赴龙灾，拯救蒙德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 3980405,
					"content": "这个嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "…啊，你说什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 3980407,
					"content": "龙灾的问题解决了？我错过了代理团长的演讲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 3980408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 3980409,
					"content": "风魔龙为什么不能再坚持一下啊！我们还没出场呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				}
			]
		},
		{
