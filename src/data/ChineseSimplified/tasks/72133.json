	"talks": [
		{
			"id": 7213301,
			"completionStepIds": [
				7213301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213301",
							"2"
						],
						"stepId": 7213301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"梶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721330101,
					"content": "你好！抱歉打扰，外国人。希望你能听我一言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330102
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330103
					]
				},
				{
					"id": 721330103,
					"content": "请不要在这座岛上久留，近来「祟神」弥漫的范围越来越广了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330104
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330104,
					"content": "「祟神」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330105
					]
				},
				{
					"id": 721330105,
					"content": "是啊，自从珊瑚宫来的人毁掉了岛上的镇压蛇神残魂的镇物，「祟神」就散布了全岛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330106
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330106,
					"content": "如你所见，阴云遮天蔽日，雨也下个不停，这都是「祟神」所为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330107
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330107,
					"content": "这段时间里，矿工们一个接一个病倒、失去理智，流亡他岛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330108
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330108,
					"content": "大家都走了，本岛已经剩不下几个居民了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330109
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330109,
					"content": "不过讽刺的是，多亏了「祟神」作乱，幕府和叛军打仗也没以前那么拼命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330110
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330110,
					"content": "哼，话说回来，要不是他们打仗破坏了大御所殿下的镇物，岛上哪会这样一团糟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330111
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330111,
					"content": "奉行呀、龙呀蛇的，跟我又有什么关系！他们打仗又没问过我的意见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330112
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330112,
					"content": "你还留在这里做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330113
					]
				},
				{
					"id": 721330113,
					"content": "做什么？这里是我的家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330114
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330114,
					"content": "你的家人呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330115
					]
				},
				{
					"id": 721330115,
					"content": "在安全的地方，谢谢你的关心。他们也在等我接他们回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330116
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330116,
					"content": "岛上没人是自愿离开的。我们在这里是一家人，去了别处，就只能做别人的雇工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330117
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330117,
					"content": "所以总得有人留下，想办法把这里打扫干净，让他们有家可回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330118
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330118,
					"content": "唉，真是头疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330119
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330119,
					"content": "我能帮上忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330120
					]
				},
				{
					"id": 721330120,
					"content": "如果是别的小毛头这样唐突地要求帮忙，我恐怕要笑出声了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330121
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330121,
					"content": "不过你身为外国旅人，能深入稻妻国境如此之远，也不像是没本事的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330122
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330122,
					"content": "我就直说吧，那边的镇物困扰我很久了，希望你能找到办法将它修复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330123
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330123,
					"content": "这里的气氛如此糟糕，一定是因为这些镇物遭到破坏的缘故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330124
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330124,
					"content": "不过在接近镇物时一定要小心，如果注视它的话，它会向你释放一股能量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330125
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330125,
					"content": "虽然无害，但让人感觉很不舒服，就像…它在将你拒之身外一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330126
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330126,
					"content": "镇物似乎少了什么部件，或许把它缺少的东西放回去就能修好它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330127
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330127,
					"content": "当然，这只是我的猜测，到现在我也没搞清楚它到底是哪里失灵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330128
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330128,
					"content": "所以，如果你想帮忙的话，这座镇物就先拜托你来修复了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330129
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330129,
					"content": "不过我还是那句话，如果你也没办法的话，还请不要在这里久留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				}
			]
		}
	]
}