			"dialogs": [
				{
					"id": 730560601,
					"content": "谢谢你们，两位「杰万」。辛苦你们陪一个糟老头子跑了一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560602,
