			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海亚姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "哈！你瞧！看看这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560402,
					"content": "欸？是新植物吗？怎么突然这么兴奋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560403,
					"content": "不是，不是新植物，但更让人开心！…瞧瞧呀，我们的「秘密城堡」！哈！破败成什么样子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560404,
					"content": "欸…？「秘密城堡」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560405,
					"content": "哈哈！学士奥马尔回来了！他带着群星的秘密回来了！伊尔凡，熙蔓，你们在哪里！还不出来欢迎我吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560407,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "呃…咳咳，抱歉，孩子们。我…我有点太兴奋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560409,
					"content": "岁数大了总是这样，越是现在的事，就越糊涂；越是小时候的事，就越怀念，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560410,
					"content": "伊尔凡，熙蔓，他们是我的朋友，我们一起搭建了这座「城堡」，我们三个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560411,
					"content": "那时候，伊尔凡是大乐师，熙蔓是元帅，我是占星学士。我们偶尔也会轮换，小孩子嘛…玩腻了就会换着来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560412,
					"content": "伊尔凡弹得一手好琴；熙蔓她个子高，胳膊壮，没人打得过；而我呢？哈哈，读书多一点，家里多点摩拉而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560413,
					"content": "这里是你儿时玩耍的地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "不，这里是我们的秘密国度，我很严肃的。我们和他们约好了切莫相忘，长大后举「复国军」回来光复城堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560418,
					"content": "呵呵，二十年过去，他们或许都已经忘记了…这里就被我当做了研究森林的小小据点，一直运作到三十年前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560419,
					"content": "再后来，「无留陀」来了，「复国军」却还是没影儿。呵呵，也对…小孩子的约定，怎么能抵挡死亡的到来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560420,
					"content": "可是…既然你还记得他们，他们一定也还记得你的吧！请不要灰心呀，海亚姆先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560421,
					"content": "灰心？不会的。儿时的记忆，共同的「幻想朋友」，不属于大人的世界。可能会有点遗憾，但…时光不复回呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560422,
					"content": "「幻想朋友」…你是说兰那罗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560423,
					"content": "派蒙…！嘘！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560426,
					"content": "哈哈…我差点忘记了，我是请你们来帮我为新生植物采样的，不是来闲聊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560427,
					"content": "请原谅我这糟老头子话太多，我们继续吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560424,
					"content": "就你话多，派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "这些都是你和玩伴留下来的吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "不，不全是。最初我们还约定了，等长大以后，举「复国军」回来光复这里…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560417,
					"content": "我后来在教令院做植物学研究，正巧回来把这里改造了一番，一波一波搬来又搬走了不少垃圾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "海亚姆"
				}
			]
		},
