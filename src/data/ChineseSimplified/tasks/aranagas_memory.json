						],
						"stepId": 7305601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海亚姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "哈哈，真是有趣…真是有意思。好起来了，这片森林…好起来了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560102,
					"content": "你好！老爷爷，你是迷路了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560103,
					"content": "嗯…嗯？麋鹿…？啊，你们是在叫我吗？哈哈，迷路，是吧？没有的事，没有的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560104,
					"content": "你们好呀，孩子们。我是生论派的陀裟多，吉亚斯·海亚姆，哈哈…叫我海亚姆就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560105,
					"content": "唔…你好呀，海亚姆先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560106,
					"content": "不…像这样，压下舌尖，拱起舌中…海——然后双唇呈圆形…亚——最后，自然而然地抿起嘴唇…姆——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560107,
					"content": "呃…海——亚——姆——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560108,
					"content": "对啦！真不错！好，金发的孩子，你再来一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560109,
					"content": "海——亚——姆——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "哈哈，不错！比白色的小东西强多了！你看，我早说过我也能去教语音学的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560113,
					"content": "所以，海亚姆先生…既然你没有迷路，那来这种地方做什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560114,
					"content": "为什么？呵呵…我是森林学者呀。对我们森林学者来说，森林就像家一样。我怎么会在久违的家里迷路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560115,
					"content": "哦……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560116,
					"content": "这片森林深受「死域」的困扰。过去三十年里植物无论种类还是数量都在迅速减少，而有害的蕈类却越来越多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560117,
					"content": "但最近这段时间里，「死域」却消失了。很多曾经消失的植物如今重新生长了出来，蕈类的繁殖也有所收敛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560118,
					"content": "这种情况，我只在六十年前见到过一次…所以为了验证我的一点不成熟的想法，我就来到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560119,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560120,
					"content": "关于验证想法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "哈哈，六十年前的事情了…可不要期待我这老家伙记得多清楚。但我相信，「死域」的清除，和那件事情有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560122,
					"content": "所以，接下来，我要进入这个洞穴里面采集一些样本，验证我的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560126,
					"content": "这样呀…洞里的「无留陀」虽然没有了，可还是很危险呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560127,
					"content": "哈哈，对我来说没什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560128,
					"content": "唔，等等…你刚刚说什么？洞里的…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560129,
					"content": "「无留陀」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "嗯…再想想，我可能确实需要你们帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560132,
					"content": "哼哼，你看我说什么来着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560133,
					"content": "嘿嘿，请恕我冒昧…但还没有问过两位朋友的名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560134,
					"content": "#叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "而我是派蒙！派——蒙——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560136,
					"content": "派蒙？派蒙…哈哈，很有趣的名字…我还是头一次听说有人…或者小精灵，叫这个名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560137,
					"content": "啊，抱歉，抱歉。没有冒犯的意思…我是说这个小东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560138,
					"content": "什么小东西！已经很冒犯了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560139,
					"content": "好了，闲话不多说，请两位「杰万」随我一同来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560140,
					"content": "「杰万」…？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560141,
					"content": "是我们家乡古老的语言，意思是「勇敢的年轻人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560142,
					"content": "准确来说，是…「面对庞大的邪恶而不熟视无睹，直面无垠的不公而不退避求和的年轻人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560143,
					"content": "哼哼，那不就是我们么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560144,
					"content": "哦？这么有自觉吗？哈哈，那就跟我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560145,
					"content": "欸？海亚姆老爷爷，你的腿脚真的能跟上我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560146,
					"content": "哈哈…我可有二三十年的森林考察经验，不要小瞧老年人的体能呀！你们尽管走便是，我很快就能跟上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560130,
					"content": "「死域」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "需要我们帮助吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "哈哈…谢谢你们，热情的孩子。我这把老骨头虽然不灵活了，但脑子还好使，可不要小看我呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560125,
					"content": "毕竟，我知道怎样让森林高兴，森林就不会让我受伤害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560111,
					"content": "海亚姆先生，你在这里做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "嗯…你发音太快了，太急促了。不过没关系…慢下来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "海亚姆"
				}
			]
		},
		{
