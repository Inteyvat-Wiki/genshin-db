			"dialogs": [
				{
					"id": 730560301,
					"content": "有意思…这里的植物看起来…重新焕发生机了啊。「无郁夷摩」重新发挥作用了…真是神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560302,
					"content": "欸…海亚姆先生也知道「无郁夷摩」吗？我还以为只有兰那罗知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560303,
					"content": "派蒙，嘘！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "「兰那罗」，是吗？你们也看到过他们啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560306,
					"content": "欸…？嗯…是、是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730560307,
					"content": "怎么了，海亚姆先生？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "「伊兰杳随蔷薇没，夷王神杯何所终…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560310,
					"content": "我们继续吧，去下一个地点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730560308,
					"content": "你也见过兰那罗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "派蒙…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
