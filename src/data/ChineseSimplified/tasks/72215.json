			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "都挂上去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150302,
					"content": "都挂好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "喵喵，太好了，这样子神社就会热闹一些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150305,
					"content": "咦？怎么还没有好多好多人类来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150306,
					"content": "应该不会这么快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "哎，人类好难懂啊。当然，汝不一样，汝很有悟性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150309,
					"content": "虽然暂时还没人…但有了铁球的叮当声，至少那些小家伙就不会迷路了，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150310,
					"content": "那个石头人类说，石头奴家很快就能好，一定要来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150311,
					"content": "啊，对了。还有件怪事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150312,
					"content": "奴家去问了那两个绿绿的人类，阿响和百目鬼的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150313,
					"content": "但那两个绿绿的人类，都说不认识阿响，也不记得和阿响有关的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150314,
					"content": "但高高的绿绿的人类说，他读到过「赤穗百目鬼」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150315,
					"content": "不过他说什么…「贼」、什么「讨伐」来着…意思好像说，百目鬼是个坏人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150316,
					"content": "肯定是弄错了。阿响和他经常在一起玩。所以，百目鬼也是很好的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150317,
					"content": "一定是那个人类悟性不行。归根到底，还是汝比较可靠哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150318,
					"content": "阿响…到底什么时候才会回来呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150307,
					"content": "应该没有这么简单…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}