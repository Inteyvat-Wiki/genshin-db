			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "唔喵，这块石头，什么时候能变得和奴家一样呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150102,
					"content": "雕像怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "那个石头人类说，再过段时间，石头就可以完全敲好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150104,
					"content": "等阿响回来的时候，她一定会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150105,
					"content": "对了，可不能只是把那块石头敲好，还得再把神社周围打扮打扮才行呐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150106,
					"content": "请你们帮奴家去把这些圆圆的，会响的铁球挂在神社周围吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150107,
					"content": "这些东西是阿响之前准备的，记得是说百目鬼看她喜欢奴家和别的孩子们，特地送给她的。奴家好不容易才找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150108,
					"content": "这是…铃铛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "「铃铛」？奴家不清楚…但阿响之前，经常和奴家一起玩这种铁球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150110,
					"content": "阿响把铁球放在地上，然后打到远处。铁球动的时候，会叮叮当当地响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150111,
					"content": "不知道这些铁球有什么力量，奴家和别的猫一听到，就忍不住想要过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150112,
					"content": "所以，奴家想明白了。现在来神社的人这么少，一定是因为没有铁球。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150113,
					"content": "所以奴家要汝帮忙，把这些铁球挂在高处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150114,
					"content": "这样的话，人类听到铁球的声音，就会来神社，也不会走错路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150115,
					"content": "那就会给「塞钱箱」塞很多钱，神社会变得很热闹。阿响回来就会很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150116,
					"content": "所以，去帮奴家把这些铁球挂在神社周围吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150117,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "那就拜托你了，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7221502,
