			"dialogs": [
				{
					"id": 200710101,
					"content": "之前存在雪山上的花怎么样啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710102,
					"content": "只拿到一份…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "其他的花是没能取回来吗？唔…好吧，毕竟雪山里的情况，确实很难预料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710104,
					"content": "但只有这一份的话，就没法对比着看了，只能以后再找机会了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710105,
					"content": "这次辛苦你帮忙，这是给你准备的报酬哦，以后说不定还要麻烦你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				}
			]
		},
