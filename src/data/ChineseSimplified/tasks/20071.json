			"dialogs": [
				{
					"id": 200710401,
					"content": "这边这边，来这边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710402
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710402,
					"content": "你还记得上次我拜托你放进雪山的那些花吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710403
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710403,
					"content": "现在已经过了一天了，我想要看看冷藏的效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710404
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710404,
					"content": "你愿意帮我去雪山上，把那些花拿回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710405,
						200710407
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710405,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710406
					]
				},
				{
					"id": 200710406,
					"content": "那就拜托你啦，我就在这里等你，请快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710407,
					"content": "我放哪了来着…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710408
					]
				},
				{
					"id": 200710408,
					"content": "你不记得了吗？是<color=#00E1FFFF>七天神像旁边</color>，<color=#00E1FFFF>山里的水边</color>，还有一个<color=#00E1FFFF>洞窟附近</color>哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710409
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710409,
					"content": "我再帮你在地图上标记一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				}
			]
