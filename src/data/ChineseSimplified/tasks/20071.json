			"dialogs": [
				{
					"id": 200710301,
					"content": "之前存在雪山上的花怎么样啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710302
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710302,
					"content": "加上这次的都在这里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710303
					]
				},
				{
					"id": 200710303,
					"content": "都拿到了吗 ？太好了，快给我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710304
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710304,
					"content": "呼呼，看起来不错呀，嗯…看来这个方法确实可行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710305
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710305,
					"content": "不过，雪山距离蒙德城有些太远了，总不能每次都麻烦你，以后得想个方便的办法才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710306
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200710306,
					"content": "总之，谢谢你来帮忙呀，这些是给你的谢礼，请拿着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				}
			]
		},
