	"talks": [
		{
			"id": 7265001,
			"completionStepIds": [
				7265001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265001",
							"2"
						],
						"stepId": 7265001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"涉川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726500101,
					"content": "你好。我叫涉川，是武道流派「心流」的宗主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500102
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500102,
					"content": "看你的样子应该是外国的旅行者吧。如何，对「心流」，有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500103,
						726500104
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500103,
					"content": "「心流」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500106
					]
				},
				{
					"id": 726500106,
					"content": "总之，这是老身独创的技术。与岩藏流、喜多院流，还有外国的「西风剑术」这些用武器战斗的流派不同，我的技术的精髓在于磨练「心流」，再利用「心流」磨练战斗技巧的流派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500107
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500107,
					"content": "早年流浪海外，四处钻研武道时，我曾观察过纳塔人的「拳斗术」。这种武道流派在练习时，会与假想敌战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500108
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500108,
					"content": "「假想敌」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726500109,
					"content": "会打你的「幻想朋友」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500110
					]
				},
				{
					"id": 726500110,
					"content": "没错。幻想敌人的行动，再针对幻想做出反应。这种在当地被称为「影子拳斗」的练习技巧，在老身看来是相当孤高的修行法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500111
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500111,
					"content": "而「心流」就是将这种修行发挥到极致的无限制格斗流派。在老身的指导下，什么样的假想敌都能得到再现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500112
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500112,
					"content": "从史莱姆到落武者，甚至是那些至冬国来的异人战士。只要精通心流的心得，就轻易能再现出与其战斗的情境，从而磨练自己的战斗技术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500113
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500113,
					"content": "顺带一提，世界上最强的生物恐怕是「雷晶蝶」了。岩藏流前代的永胤曾经借由老身的「心流」，尝试挑战有人类体型的雷晶蝶，但就连十秒也没能撑下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500114
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500114,
					"content": "不仅仅是对手，就连风向、天候、机关、乃至「地脉异常」，老身都可以通过心流模拟。可以说得上是最实用的技术了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500115
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500115,
					"content": "既然心流这么厉害，为什么涉川先生要亲自挖角呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726500116,
					"content": "老身心流实在是太过…真实了，以至于弟子与假想敌战斗时，有时真的会受伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500128
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500128,
					"content": "即使是心流幻想的「剑」，也会砍伤手脚。而心流幻想的「火铳」，甚至真的能射穿身体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500117
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500117,
					"content": "久而久之，不完全倾心于武道的，就因为害怕离开了心流；而不顾一切的武痴，又不应该掌握心流，被我撵走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500118,
						726500119
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500118,
					"content": "这么厉害？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500120,
					"content": "是啊。但我看你与心流也有缘，不如试试老身的「心流」，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500121,
						726500122
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500121,
					"content": "有意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500124
					]
				},
				{
					"id": 726500124,
					"content": "总之，如果有兴趣的话，就将眼前的平台视为心流的「土俵」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500125
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500125,
					"content": "而老身，会为你量身定做最适合你的「心流战场」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500126
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500126,
					"content": "只不过，小心别受伤了。毕竟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500127
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500127,
					"content": "「心流」可是很无情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500122,
					"content": "没有兴趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500123
					]
				},
				{
					"id": 726500123,
					"content": "这样啊。那还真是可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500124
					],
					"speakerTitle": "涉川"
				},
				{
					"id": 726500119,
					"content": "这么可怕？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500104,
					"content": "没有兴趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500105
					]
				},
				{
					"id": 726500105,
					"content": "#别这么说嘛。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}，你步伐稳健，站姿挺拔，呼吸更是毫无破绽，想必常年走在「武」的道路上吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500106
					],
					"speakerTitle": "涉川"
				}
			]
		}
	]
}