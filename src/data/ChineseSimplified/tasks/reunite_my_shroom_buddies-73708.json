			"dialogs": [
				{
					"id": 737080101,
					"content": "咦，那边有只蕈兽飘过去了欸，没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080102,
					"content": "一般来说，蕈兽在城区活动，还是有点危险的吧！除非是特别听话，受过训练的特例…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080103,
					"content": "不对呀，怎么好像有点熟悉，以前我们是不是经历过类似的情景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080104,
						737080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080104,
					"content": "等等，是「咚咚小圆帽」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080105
					]
				},
				{
					"id": 737080105,
					"content": "对！「咚咚小圆帽」！我们在须弥结识的蕈兽伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080106,
					"content": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080107,
					"content": "是什么特例来着？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080108
					]
				},
				{
					"id": 737080108,
					"content": "好像是…「咚咚小圆帽」？我们在须弥结识的蕈兽伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080109,
					"content": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
