					"nextDialogs": [
						737080309
					]
				},
				{
					"id": 737080309,
					"content": "嘿嘿，我闲下来没事的时候，也会翻看导览图册，观察一些游览胜地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080310,
					"content": "这可是好向导的必修课！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080311,
					"content": "好啦，让蕈兽伙伴也试试看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
