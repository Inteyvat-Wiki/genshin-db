			"dialogs": [
				{
					"id": 737080201,
					"content": "看来留言转达得很顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080202,
					"content": "终于又见面了，「黄金流星」和「白银伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080203,
					"content": "你们容光焕发的模样，让我有种时间停滞的美好感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080204,
					"content": "久违了，海妮耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "真的是你们啊，海妮耶和「咚咚小圆帽」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080206,
					"content": "难怪看过留言，我就有种奇妙的熟悉感…说明我和「咚咚小圆帽」的默契还在！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "咚咚小圆帽"
				},
				{
					"id": 737080212,
					"content": "我设想过许多重逢的情景，比如举办丰盛的宴会，或是富有创意的欢迎仪式，给你们个巨大的惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080213,
					"content": "但感觉都有些见外，考虑到你们一直很忙，说不定占用太长时间，反而会让你们觉得麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080214,
					"content": "而且，现在的蕈兽伙伴们也喜欢宁静的环境，所以，就让我们以松弛自然的方式重逢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080215,
					"content": "没错没错，海妮耶读的散文派上用场啦，平静的心态对生活有益！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080216,
					"content": "还是像这样，轻轻松松聊天最开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "欢腾之火"
				},
				{
					"id": 737080218,
					"content": "左右加小姐也在，还有「欢腾之火」和…这位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080219,
					"content": "是我自己的蕈兽伙伴「信风舞姬」哦，当时在三十二强赛上，被你们和「咚咚小圆帽」一下就打败了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080220,
					"content": "哎呀，还是你记得清楚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080221,
					"content": "熟悉的感觉逐渐回来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "总之，两位大老板，就像你看到的这样，我们再也不用约定什么下次见面的时间和地点啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080224,
					"content": "海妮耶和我已经买下了这片商区，将它改造成一直开设的「小小灵蕈乐园」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080225,
					"content": "等等，你的意思是，现在这里的设施，不是为了新的桌上游戏租用的，而是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080226,
					"content": "没错，以后我们就会一直生活在拜达港，向人们推广蕈兽的桌上游戏，以及和动物们交流的理论。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080227,
					"content": "只要你们有空，随时可以来这里找蕈兽伙伴们玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "咚咚小圆帽"
				},
				{
					"id": 737080229,
					"content": "好耶！蕈兽伙伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "这这这，这是我今天听过最好的消息之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080232,
					"content": "第一次蕈兽大赛后，我就想过好多好多…和「咚咚小圆帽」一起玩的点子，这下可以慢慢做到啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080233,
					"content": "说起来，这里的花销不低吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "放心啦，摩拉目前不是问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080235,
					"content": "这段时间，除了在贝尔福先生的帮助下运营「灵蕈棋阵」和「小小灵蕈大幻戏」这款桌上游戏，挣取资金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080236,
					"content": "我们还总结了以往的经验，将驯兽和蕈兽的许多知识总结成系统的理论，试着刊印了一些书籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080237,
					"content": "甚至，有些学者也因此给了我资金资助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080238,
					"content": "用我积累的学问为更多人提供便捷，换取摩拉，让蕈兽伙伴们过得更好，一切都进入了正向的循环。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080239,
					"content": "有，有点厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080240,
					"content": "感觉海妮耶已经变成了稳重的…「驯兽理论专家」，能把一切问题统统搞定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080241,
					"content": "多亏左右加引导得好，她让我按学生们的方法，挑战了自己应该学会的技能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080242,
					"content": "喂喂！这种谦虚倒是别学啊，我可不是什么超级老师，夸你就好好接着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080243,
					"content": "说得轻松，其实有过困难吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "确实也遇上过许多难题，但过去的、不好的事情，就让它们随时间走远吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080246,
					"content": "我最大的遗憾是——这一年来，没怎么带蕈兽伙伴们好好在外游玩，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080247,
					"content": "从我开始归纳自己的驯兽理论开始，大多时间，我们都在洞窟和树屋里，过着昼夜混乱的写稿生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080248,
					"content": "商务生活太累人，赶稿的日子也真是难熬，我更理解左右加的一些想法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080249,
					"content": "倒也不全是负面反馈嘛！写完稿子的一瞬间，还是非常有满足感的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080250,
					"content": "嗯，我同意，每次完稿都值得吃一顿放纵餐来庆祝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080251,
					"content": "可是，蕈兽伙伴们也享受不了我们的食物，或许在它们看来，生活变得越来越枯燥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080252,
					"content": "长期如此，伙伴们的精神状况也会变差，很不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080253,
					"content": "那，既然现在你们的状况稳定下来了，也有了固定的住所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080254,
					"content": "其实可以由我们两个带着蕈兽伙伴们出去玩玩，玩到尽兴就送它们回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080255,
					"content": "这样，你们就可以忙手头的工作，蕈兽伙伴们也能好好玩乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080256,
					"content": "派蒙这个主意好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "我支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080259,
					"content": "谈到赏玩的地点，我是纯粹的理论派，只能从书上找去处。第一次到枫丹的时候，其实还闹过迷路的笑话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080260,
					"content": "海妮耶更是个呆瓜，连须弥有哪些好玩的地方都不知道，以前光顾着工作去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080261,
					"content": "上次在枫丹待了那么久，行程规划也不到位，最后连想去的甜品店都没去成，错过了好奇好久的马卡龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080262,
					"content": "咳咳…换成「黄金流星」和「白银伴星」的话，肯定可以找到各种好地方，让蕈兽伙伴们大开眼界，畅玩一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080263,
					"content": "那我确实要好好物色地点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "稍等啊，请带上这个小留影机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080266,
					"content": "海妮耶取出一部平平无奇的留影机，将其放在了「咚咚小圆帽」的头上，「咚咚小圆帽」居然能稳稳顶着留影机，似乎已经习惯了托举这种东西飞行…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "虽然外观很普通，但这是一件特别的纪念品——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080268,
					"content": "「咚咚小圆帽」曾在水天丛林南部救下一位迷路商人的孩子，商人送了「咚咚小圆帽」许多谢礼，其中一件就是这部留影机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080269,
					"content": "「咚咚小圆帽」很喜欢这个留影机拍摄的画片，这次去玩时，也可以用它来留念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080270,
					"content": "我找到了器材专家伊莲小姐，密封了留影机的外壳，使得它能在「咚咚小圆帽」喜欢的潮湿环境…甚至是水下工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080271,
					"content": "也就是说，这个留影机也是「咚咚小圆帽」的荣誉象征之一了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080272,
					"content": "咚咚小圆帽，棒！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "咚咚小圆帽"
				},
				{
					"id": 737080275,
					"content": "#至于留影的问题，放心放心，我和{NICKNAME}也是专家！设备的外观不要紧，拍得好就行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}，我们准备准备，然后就出发吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080277,
					"content": "除了行李，还有蕈兽伙伴们特别的食物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080278,
					"content": "没错，这一点派蒙也记得很清楚，请带上足够的「妙妙琼脂」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080279,
					"content": "最新改良版的版本有着更美味的口感，还很耐储存，无论在多炎热的环境下，都不用担心变质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 737080280,
					"content": "小心，不要一次给伙伴们吃太多哦，暴饮暴食可不好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 737080281,
					"content": "嘿嘿，都记住啦，琼脂要收进小背包…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080282,
					"content": "就等我们开开心心带着游玩的纪念品回来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080273,
					"content": "干得漂亮，小圆帽！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "我会选出好玩又好看的地方！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "我也想带蕈兽伙伴去玩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "感觉略过了很多吃苦的部分…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "以后可以经常见面啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "亲切的氛围让我放松下来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "虽然不太记得了，但你们好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "确实是海妮耶和「咚咚小圆帽」！我们好久之前在「月莲杯驯兽师大赛」认识的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080210,
					"content": "印象里，之后我们还在奥摩斯港附近，还有枫丹廷见过面！不知不觉，已经过去这么长时间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737080211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "咚咚小圆帽"
				}
			]
