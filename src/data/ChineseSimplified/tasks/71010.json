			"dialogs": [
				{
					"id": 710100101,
					"content": "我与师兄自幼习武，励志除魔卫道。但想要卫道世间，没有『神之眼』相助，又谈何容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "遗迹宝藏"
				},
				{
					"id": 710100102,
					"content": "我和师兄潜修于此，欲求『神之眼』，立此碑为证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
