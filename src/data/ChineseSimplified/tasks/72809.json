				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈里森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "谢谢，谢谢，太谢谢你了，旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090205,
					"content": "要是没你帮忙，我今天非折在这里不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090206,
					"content": "这营地是你建的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "呃…算是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090210,
					"content": "你们也知道，在离岛做生意可不容易，这个营地…算是我做生意的一点小诀窍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090211,
					"content": "前些日子，我托一位…朋友，从蒙德那边给我带一批酿酒材料过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090212,
					"content": "他前不久拜托一个朋友从「晨曦酒庄」那里拿到了一批试做的新货，这几天刚运过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090213,
					"content": "可是那家伙手脚没轻没重，把箱子碰坏了，里面装着的一瓶酿酒材料的盖子也松了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090214,
					"content": "我就想去把盖子先拧下来，然后再重新装上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090215,
					"content": "没想到，我刚拧开盖子，一堆史莱姆就冲了过来，真是莫名其妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090216,
					"content": "「晨曦酒庄」的酿酒材料吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "算了，先不管了，酿酒材料的事，等那家伙下次过来的时候，我再和他算账。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090218,
					"content": "你们救了我，我得给你们点谢礼才行…这些东西你们先收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090219,
					"content": "除了这些之外，你们看见旁边的那艘小船了吗？那是我的另外一个…小诀窍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090220,
					"content": "用那艘船，你们就可以从这里悄悄地前往鸣神岛了，嘿嘿，是不是非常方便？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090221,
					"content": "我为什么要「悄悄的」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "哎呀，总之…以备不时之需嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090223,
					"content": "好了，我还得回去清点货物，就先不在这里多待了，再次谢谢你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090224,
					"content": "看来我得再换个接货的地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090208,
					"content": "你在这做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "我…在这搬货呢，哈哈哈，搬货呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "哈里森"
				}
			]
		}
	]
}