			},
			"dialogs": [
				{
					"id": 728090108,
					"content": "这些东西总算是送到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090109,
					"content": "拖了这么长时间，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090110,
					"content": "这箱怎么还破了个角，哎哟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090111,
					"content": "叫他小心点！不会把里面的东西给碰碎了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090112,
					"content": "还好，没有瓶子碰碎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090113,
					"content": "咦？这瓶的盖子怎么松了…得先拧下来，再装上去才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090114,
					"content": "咳！咳…这调酒材料的味道可真是…太激烈了，还是快点搬走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "哈里森"
				},
				{
					"id": 728090115,
					"content": "欸，什么，怎么这么多史莱姆？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈里森"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280907",
							"2"
						],
						"stepId": 7280907,
						"stateName": "QUEST_STATE_UNFINISHED"
