			"dialogs": [
				{
					"id": 730580401,
					"content": "去看看坏蛋那菈的营地吧！一定能知道他们是来做什么的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580402,
					"content": "你是怎么分辨坏蛋的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#唔…不知道，说不清楚！但是我知道，那菈{NICKNAME}和白飞飞一定不是坏人！兰迦鲁相信！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰迦鲁"
				}
			]
