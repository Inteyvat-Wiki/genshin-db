					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "怎么样，有发现什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580202,
					"content": "唔…只发现了语焉不详的命令，还有这个！一朵风干的花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580203,
					"content": "欸…！这个，可以给我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580204,
					"content": "这个是坏人留下的，你就不怕有毒…什么的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580205,
					"content": "不需要担心，我见过这朵花…那个人，我应该见过…请你交给我，好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580206,
					"content": "请你拿去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#谢谢你！那菈{NICKNAME}和白飞飞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580208,
					"content": "兰迦鲁将风干的小花带去了无郁稠林…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
