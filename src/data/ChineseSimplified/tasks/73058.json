			"trigger": {
				"objectNames": [
					"兰迦鲁",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "金色的那菈，白色的飞飞！又见到你们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580102,
					"content": "呜哇，下次突然出现请打声招呼啦！又吓我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580103,
					"content": "我们不是坏人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "哼…你们说的有道理啦…所以，看起来不像坏蛋的金色那菈和白飞飞，可以再帮我一个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580106,
					"content": "#乐意效劳，我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "我是派蒙，这次可别忘啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580108,
					"content": "这次…？呃…咳咳，我是兰迦鲁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580109,
					"content": "#我们和你一起来过这里哦，但是你忘记啦…唔，好难解释！{NICKNAME}，我们一起给他讲讲吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730580110,
					"content": "你们具言了与兰迦鲁冒险的所见所闻。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "这样吗…虽然我不记得了，但不知为什么，我愿意相信你们…而且你们有我送的花，我能感知到她在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580112,
					"content": "啊，对了！坏蛋那菈留下了营地，我们去找找看他们留下了什么东西，说不定能知道他们在盘算什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730580104,
					"content": "我们帮你打跑了坏人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
