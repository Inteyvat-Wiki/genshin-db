			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990101,
					"content": "哎呀，兰那罗的世界可真奇妙…看看图画就能找到宝藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990102,
					"content": "这么一来，就找到了所有图画的地点了呢！不知道画这些藏宝图的兰那罗在什么地方呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990103,
						730990104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990103,
					"content": "并不是所有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				},
				{
					"id": 730990105,
					"content": "对喔，这么说来，还有那副有好几个兰那罗一起的画，我们在那边没有找到宝藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990106,
					"content": "（行囊中似乎有什么东西发出了轻微的震颤。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990107,
					"content": "（找到震颤的物品。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990108
					]
				},
				{
					"id": 730990108,
					"content": "咦？这是…之前我们在层岩巨渊地下，找到的种子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990109,
						730990111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990109,
					"content": "好像在指引我们去什么地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990110
					]
				},
				{
					"id": 730990110,
					"content": "嗯…说不定真是这样呢！之后如果种子再发出震动的话，我们就留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990113,
					"content": "说不定真的有「受困的兰那罗」呢！或者是什么，「兰那罗宝库」之类的…而种子就是钥匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990111,
					"content": "真是莫名其妙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990112
					]
				},
				{
					"id": 730990112,
					"content": "唔…我觉得可能这个种子是想要去什么地方！之后如果种子再发出震动的话，我们就留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990104,
					"content": "还有一个地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				}
			]
		},
