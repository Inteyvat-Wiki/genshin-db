			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰弥那离",
					"派蒙",
					"兰宁巴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990301,
					"content": "咿！是金色的那菈！而且，有风的味道，土的味道，还有兰那罗的味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990302
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990302,
					"content": "金色的那菈，也破解了兰雅玛的兰迦拉梨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990303
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990303,
					"content": "可怕，可怕！阻碍，没了用处，任谁都能闯进来，兰弥那离的「快乐小窝」，要被「踏破」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990304
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990304,
					"content": "哇，你不要着急嘛，我们没有恶意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990305,
					"content": "没有「恶意」是什么意思？是说不「贪婪」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990306
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990306,
					"content": "#唔…算是吧！我和{NICKNAME}可是站在兰那罗那边的，我们想当兰那罗的好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990307,
					"content": "派蒙虽然贪吃，但本质不坏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990308
					]
				},
				{
					"id": 730990308,
					"content": "喂！虽然是这样没错啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990309,
					"content": "兰那罗的好朋友…金色的那菈身上，有兰那罗的味道，熟悉的味道，但是很久没有闻到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990310
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990310,
					"content": "#啊，对了，那颗怪怪的种子！{NICKNAME}，把种子给兰弥那离看看吧，说不定他知道些什么呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990311,
					"content": "唔！好渴！他要喝很多水，才能变回原来的样子…快，这边有很多水，让他喝饱，才能恢复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990312
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990312,
					"content": "将种子放进了水里…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730990313
					]
				},
				{
					"id": 730990313,
					"content": "…噗！回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990314
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990314,
					"content": "#哇！种子变成兰那罗了！真的找到了，「受困的兰那罗」！你看，我说的没错吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990315,
						730990316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990315,
					"content": "居然真的存在「受困的兰那罗」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				},
				{
					"id": 730990317,
					"content": "是兰宁巴！和兰弥那离不一样，兰宁巴喜欢四处周游，之前，会把在远方看到的景色画下来，送回桓那兰那，但是后来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990318
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990318,
					"content": "后来到了很硬、很暗的地方，很少泥土，但是很多石头…泥土之下，很少草，很少树，不过有很多蘑菇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990319
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990319,
					"content": "唔…说的应该就是层岩巨渊吧？不过，兰宁巴一个兰那罗居然跑到那么远的地方去啦，甚至离开了须弥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990320,
					"content": "嗯！路途很远，而且危险，遇到黑色的那菈，好险！不过，兰宁巴有兰穆护昆达看顾，变成种子，「逃过一劫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990321
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990321,
					"content": "现在兰宁巴又安全回来，多亏了金色的那菈，还有白色飞飞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990322
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990322,
					"content": "#是{NICKNAME}和派蒙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990323,
					"content": "#对，那菈{NICKNAME}还有派蒙，是兰那罗的好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990324
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990324,
					"content": "#兰弥那离是兰宁巴的「好朋友」，所以，那菈{NICKNAME}和派蒙也是兰宁巴的「好朋友」，唔，懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990325
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990325,
					"content": "兰宁巴要出发了，这次，不光是画，兰宁巴会送回「礼物」，给兰弥那离，装进「宝箱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990326
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990326,
					"content": "这里的「宝箱」，都是兰弥那离的，兰弥那离是「宝箱」的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990327
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990327,
					"content": "如果真的是兰那罗的好朋友，帮助过很多兰那罗的话…兰那罗「知恩图报」，会把「宝」放进「箱」里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990328
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990328,
					"content": "原来箱子原本是空的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990329,
					"content": "兰那罗诞生之时就知道有关桓那的一切，但「箱」诞生之时，却是肚里空空的！兰弥那离也不懂为什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990330
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990330,
					"content": "派蒙也搞不懂欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990331,
					"content": "#…等兰弥那离放好了，那菈{NICKNAME}可以打开「宝箱」，然后像绿绿的那菈那样，有时「好呀！」有时「唉…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990332
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990332,
					"content": "为什么要多此一举呢？兰弥那离和兰宁巴也可以直接把要放进宝箱里的东西当作报酬交给我们嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990333,
					"content": "#兰弥那离知道，绿绿的那菈，都喜欢进到洞里，或者屋子里，打开「宝箱」。那菈{NICKNAME}，还有派蒙，不喜欢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990334
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990334,
					"content": "哦…很难说不喜欢呢…感觉有种…莫名的吸引力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990335,
					"content": "嗯，那菈喜欢「宝箱」，兰弥那离也喜欢，所以允许帮助过兰那罗的好那菈打开「宝箱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990336
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990336,
					"content": "桓那有很多兰那罗，有的需要帮助，有的想和那菈玩耍，实现他们愿望的那菈，才是兰那罗的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990337
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990337,
					"content": "这样的那菈，可以打开兰弥那离准备好的「宝箱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990338
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990338,
					"content": "所以兰宁巴应该现在就出发，为了把「宝箱」填满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990339
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990339,
					"content": "欸？可是兰宁巴不是刚回来没多久吗？这么快就要离开了吗？真是风风火火呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990340,
					"content": "咿！有风很好，但不要火，离火太近，兰宁巴就又会很渴很渴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990341
					],
					"speakerTitle": "兰宁巴"
				},
				{
					"id": 730990341,
					"content": "啊，我的意思是说，兰宁巴怎么走得这么急，明明可以多留一下，和兰弥那离叙叙旧嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990342,
					"content": "兰弥那离也是，很久不见兰宁巴，不会有很多话想说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990343,
					"content": "兰宁巴是停不下来的兰那罗，所以当不了「宝箱」的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990344
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990344,
					"content": "兰宁巴四处周游的消息，只要桓那知道，风知道，花跟草知道，兰弥那离就知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990345
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990345,
					"content": "所以，没关系，不需要太多话。兰宁巴想说，兰弥那离就听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990346
					],
					"speakerTitle": "兰弥那离"
				},
				{
					"id": 730990346,
					"content": "#唔…这就是兰那罗的友谊吗？如果是我的话，肯定有说不完的话要和{NICKNAME}分享呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990316,
					"content": "你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				}
			]
		},
