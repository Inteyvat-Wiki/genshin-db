			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲俩阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "完美，准备工作全都搞定了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460102,
					"content": "加把劲，哲俩阿，争取几天之内把它们全抓起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460103,
					"content": "抓，抓什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "噫！怎么枫丹也冒出盗猎者了…最近倒卖动物很赚钱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460106,
					"content": "不行不行，我们要先把你抓起来，押送执律庭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460107,
					"content": "…是你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460108,
					"content": "好啊好啊，我刚从执律庭过来，要不要我给你们带路？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460109,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460110,
					"content": "棒欸，我喜欢爽快人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "等等，有点不对劲…听说要被抓起来还一副完全不怕的模样，要么是惯犯，要么就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460114,
					"content": "就是站在正义这边的好人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460115,
					"content": "准确地说，是为了环境去战斗的执律庭特聘顾问——「放生徒追猎者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460116,
					"content": "因为我要抓的，可是入侵枫丹水域的外来物种鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460117,
					"content": "外来…物种？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460118,
					"content": "好像有点耳熟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "啊，确实有印象，以前在蒙德听说过类似的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460122,
					"content": "过去的事先不提啦，现在的情况更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460123,
					"content": "这些外来物种鱼啊，是被奇怪信仰的商人们特意放生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460124,
					"content": "它们有的特别凶猛，有的繁殖能力特别强，有的还被特殊的饲料喂养过，对于本地水生生物来说，全都是大麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460125,
					"content": "要是被它们鸠占鹊巢，改变了水下生物的结构，枫丹的水质有可能受到影响…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460126,
					"content": "不说枫丹人的健康这种长远问题，枫达这类饮料的口感第一时间就会变样吧，到时候枫丹的经济也会受到牵连，事情就大条了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460127,
					"content": "枫达，你还不能倒下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "越是轻描淡写，越觉得问题很严重，我们不能坐视不理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460130,
					"content": "抓鱼这种事，我们也挺在行的，不如就让我们来帮你一把？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460131,
					"content": "太对了，我就等着这句话呢，这才是你们的作风！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460132,
					"content": "我已经搭好了一个围捕区，其中的诱饵会将入侵鱼类统统吸引过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460133,
					"content": "拿出你们执行正义的气势吧，荣誉骑士和白色小帮手，我会尽全力支持你们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "哲俩阿"
				},
				{
					"id": 700460134,
					"content": "不知为什么，感觉这位小姐很了解我们…是我的错觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460128,
					"content": "虽然不怎么喝，但枫达很重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "什么东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "好像有点印象，应该是很久以前，我们在蒙德听说过类似的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460112,
					"content": "等等…我们好像误会了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "确实，听说要被抓起来还一副完全不怕的模样，要么是惯犯，要么就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460104,
					"content": "盗，盗猎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}