			},
			"dialogs": [
				{
					"id": 740390101,
					"content": "唔…风干汐藻糊糊，幽光星星的腌制内脏，再加上…嗯，「少许」…啊啊，「少许」是多少嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390102,
					"content": "欸，这是在熬什么汤吗…？唔！气味好奇怪…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390103,
					"content": "嗯？奇怪？不应该呀…明明是按照卡莉珀丝大人的药方调配的，气味应该很正常才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390104,
					"content": "好像用死青蛙发酵了三年的鲈鱼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "呜哇，我眼前已经有画面了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390108,
					"content": "总、总之，你在做什么啦？呃…需要我们帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390109,
					"content": "药剂哦，薇蕾娜妲在配制药剂…能帮助很多很多人的药剂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390110,
					"content": "哦…所以…所以你是个药剂师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390111,
					"content": "薇蕾娜妲还不是药剂师大人哦，药剂师大人的助手才对。药剂师大人是了不起的卡莉珀丝，薇蕾娜妲还有很多要学的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390112,
					"content": "嘿嘿，给了不起的医师做助手，也是了不起的助手嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390113,
					"content": "嘿嘿…嗯…呃，不是、不是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390114,
					"content": "没有啦…薇蕾娜妲还有很多不知道的事，只是在努力为药剂师大人配药而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390115,
					"content": "那个，那个…薇蕾娜妲告诉了你们名字，但还不知道你们叫什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390116,
					"content": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390117,
					"content": "「派蒙」，好听的名字，像白色的小水母一样，吵吵闹闹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME}，有点奇怪的名字，金灿灿的，但很友好。很高兴见到你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390119,
					"content": "那个…你们问需不需要帮忙，薇蕾娜妲需要帮忙，但不知道你们愿不愿意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390120,
					"content": "请尽管说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "嗯，需要我们帮什么忙，直接说出来就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390122,
					"content": "薇蕾娜妲想要你们试一试…新调配出来的药剂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390123,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390124,
					"content": "薇蕾娜妲知道药不好闻，不好喝…但能帮助很多很多人，能治好很多很多病，所以很有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390125,
					"content": "但我们不会得病，也不喜欢喝怪东西…时间长了，就没人帮薇蕾娜妲试药了，所以很苦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390126,
					"content": "唔…你自己都说是怪东西了，不会很危险吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390127,
					"content": "没关系的，我们不会中毒。呃…所以，理论上，你们也不会中毒吧…嗯，理论上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390128,
					"content": "需要测试的药…嗯，一共有三种。一种能让人变得很厉害，很能打！一种能让人很温暖。还有一种…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390129,
					"content": "薇蕾娜妲也说不太清楚…卡莉珀丝大人说，能让人洞悉「真实」。她是这么说的啦，可是薇蕾娜妲不太懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390130,
					"content": "听起来还是很危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390131,
					"content": "不危险的，不危险的…那个，你们愿意帮忙吗？如果愿意帮忙的话，薇蕾娜妲这就带你们去那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390106,
					"content": "静下心的话，有一点甜甜花的清香…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "喂，那也太不对劲啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "派蒙"
				}
			]
		},
