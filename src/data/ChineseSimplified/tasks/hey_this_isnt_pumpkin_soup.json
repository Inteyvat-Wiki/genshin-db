				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇蕾娜妲",
					"派蒙"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2515.692,
							415.747,
							4528.094
						],
						"pointId": 4515
					},
					{
						"sceneId": 3,
						"position": [
							2515.588,
							415.68,
							4525.956
						],
						"pointId": 4563
					}
				]
			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "这里，这里就是实验工棚啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390802,
					"content": "嗯，那么接下来要试验的是「真视药剂」，准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390803,
					"content": "我准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "唔…一定要小心呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390805,
					"content": "你从薇蕾娜妲手中接过药剂，闻起来就像阳光下腐烂许久的已死海草，令人不禁喉头作呕…\\n你犹豫了半刻，将之一饮而尽。药液却并不难喝，准确来说，缺少任何可以分辨的口味…\\n除此之外，你的身体再无其他反应。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "然后，在薇蕾娜妲指示下，你休憩了一段时间，并没有发生什么变化。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "但是，不久后…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "看样子还是没什么变化呢…呼，幸好不用操心啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390809,
					"content": "#嗯，不过…{NICKNAME}刚刚愣了一下？怎么了？看到什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390810,
					"content": "我看到了…半截半透明的船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "嗯？有意思！但是…唔…还有更详细的描述吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390812,
					"content": "它的距离很远，我没看清楚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#很有趣，嗯！…但不能作为药效的具体证明…因为{NICKNAME}无法证明是不是把远处的礁石或者船骸看成了「幽灵船」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390814,
					"content": "所以…唉，这次试验还是没有成果呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390818,
					"content": "谢谢你们，这次收集到了不得了的笔记！一定可以用在下一次配药中的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390819,
					"content": "唔嗯…「虽然听到了很熟悉的说法…」嗯，「但仍旧需要多加考察，调查是否有其他人目睹该种迹象」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390820,
					"content": "欸…也就是说，你还要找别人试药呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390821,
					"content": "嗯，没错。因为…唔…只有找到两个以上可靠的目击者，我们才能确认药剂真的能让人看到「真实的东西」呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390822,
					"content": "因为「真实」的东西不会受到目光与思绪的束缚，不会因一个人的心而扭曲变形…而是一直一直存在在那里，就那样存在着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390823,
					"content": "嗯…就像…能活好几千岁的神那样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390824,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390825,
					"content": "不，就像白色的细砂，海星的尸骸，摇呀摇的波浪那样…这些才是「真实」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390826,
					"content": "但药剂师大人也说过…经由梦和回忆，也能创造出新的「真实」。这个，自相矛盾的说法，薇蕾娜妲不懂…但正在努力弄懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390827,
					"content": "呜哇…话题突然变得好深奥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740390828,
					"content": "哈哈，那就不聊深奥的话题啦！总之，薇蕾娜妲谢谢你们帮忙！请收下这些！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390829,
					"content": "嗯…还有，下次调配出新药剂时，也请你们一定要来呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390815,
					"content": "看起来像被某种巨大的东西切断的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "薇蕾娜妲"
				},
				{
					"id": 740390817,
					"content": "啊，对不起！刚刚…有点走神了。但…但薇蕾娜妲把刚刚的信息记下来了，谢谢你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "薇蕾娜妲"
				}
			]
