					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090301,
					"content": "怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090302,
					"content": "这是文物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090303
					]
				},
				{
					"id": 220090303,
					"content": "呼…没错，和我想的一样，他们果然是在循着我考察的路线挖掘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090304,
					"content": "虽然没什么技术含量，但是这群乌合之众有着「人数」的优势，浩浩荡荡一拥而上，总能从边角里摸出点东西来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090305,
					"content": "幸好有你，不然这些文物就要遭殃了，实在是太感谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		}
	]
