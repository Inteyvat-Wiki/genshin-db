	"talks": [
		{
			"id": 2200901,
			"completionStepIds": [
				2200901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200901",
							"2"
						],
						"stepId": 2200901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090101,
					"content": "盗宝团真是越来越猖獗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090102
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090102,
					"content": "你找我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090103
					]
				},
				{
					"id": 220090103,
					"content": "对，我有事要拜托你。上次你说的「宝儿」，详细调查之后，我确定她就是盗宝团的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090104
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090104,
					"content": "单独行动的原因…也许是想要独吞宝物，或者是给后面的盗宝团大部队做先遣队吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090105
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090105,
					"content": "她一个人也很好伪装自己，毕竟，连你这个经验丰富的旅行者都被她骗过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090106
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090106,
					"content": "如果再放任她，还有另外的盗宝团这样到处刮地三尺，周围的文物一定都会遭殃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090107
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090107,
					"content": "所以，我想请你去阻止他们，就算不能完全遏制，抢救一些文物回来也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090108,
						220090110,
						220090117
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090109
					]
				},
				{
					"id": 220090109,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090110,
					"content": "你怎么知道他们的位置？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090111
					]
				},
				{
					"id": 220090111,
					"content": "哼，如果我没猜错，这群盗宝团一直都在跟踪我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090112
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090112,
					"content": "除了直接从我这里「捡现成」之外，这些贪心不足的家伙肯定还不满足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090113
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090113,
					"content": "只要是我驻足过的地方，他们一定也会掘地三尺，想从里面挖出点东西来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090114
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090114,
					"content": "稍微想一想，我就知道他们会在哪里。但我只是个学者，推理判断之类的工作不在话下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090115
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090115,
					"content": "但要论起战斗，就只能拜托你这位经验丰富的旅行者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090116
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090116,
					"content": "拜托你了，快去把那些文物拿回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090117,
					"content": "我马上去打垮他们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090118
					]
				},
				{
					"id": 220090118,
					"content": "请等一下，虽然说是「阻止」，但我并不想你马上和那个宝儿摊牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090119
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090119,
					"content": "盗宝团组织松散，同时也很难抓住踪迹，现在你和他们挂上了钩，是千载难逢的好机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090120
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090120,
					"content": "我觉得，他们在这片「归离原」上出现，一定是有所图谋。你留在宝儿身边，说不定能打探到他们的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090121
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090121,
					"content": "所以，你暂时还不能暴露，我相信你的实力，挑一个隐蔽的攻击点，然后…速战速决吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090122
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090122,
					"content": "记住，拿到文物后马上离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
