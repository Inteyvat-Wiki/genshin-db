			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746920101,
					"content": "…也就是说，你也不能帮我解决这个麻烦的体质？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920102
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920102,
					"content": "是的。这份扰动已经和你的命运牵连太深，打比方的话，它就像是从你的命运之树上生出的新芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920103
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920103,
					"content": "它一直帮助着你吸收阳光雨露，也早已开始协助「塑造」你的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920104
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920104,
					"content": "如果贸然把它剪除，留下的伤口说不定会被什么脏东西侵入，从而让整棵树都生病呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920105
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920105,
					"content": "嘁…说的好像这个体质是什么好东西似的。明明就是它妨碍我，让我始终调不出想要的酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920106
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920106,
					"content": "比起幼苗，我觉得它反而像是那种缠绕在大树上，从一开始就打算勒死大树的藤蔓嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920107
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920107,
					"content": "唔，如果是那样的话，只要顺着命运的排斥反应，就可以轻松剪除掉了…但很可惜，它并不是这种东西啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920108
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920108,
					"content": "好了，闲话就说到这里。现在你应该相信我是一个正派占卜师了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920109
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920109,
					"content": "喏，就和之前说的一样，过来随便抽一张牌吧，让我对你的未来做一些小建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920110
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920110,
					"content": "唔…呃，那就随便抽一张？这一张…不对不对，这一张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920111
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920111,
					"content": "安心吧，无论你怎么选，都只能抽到命中注定的那一张，呵呵呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920112
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920112,
					"content": "（呜…这个占卜师笑得好可怕！就像是童话书里说的老巫婆一样！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920113
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920113,
					"content": "（但她既然是这么厉害的占卜师，那她的建议，说不定真能帮上我…必须认真选才行！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920114,
						746920115
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920114,
					"content": "别吓小孩了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920116
					]
				},
				{
					"id": 746920116,
					"content": "#咦？{NICKNAME}，小派蒙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920117
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920117,
					"content": "不愧是你，每次都出现得恰到好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920118,
						746920119,
						746920120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920118,
					"content": "谢谢夸奖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920121,
					"content": "呵呵呵呵呵，确实如此，比起捉摸不透的「命运」，还是实打实的委托更能直观地塑造人的言行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920122
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920122,
					"content": "好了，既然你来了，就和这位小朋友聊聊吧，她似乎不太信任我这位魔女啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920123
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920123,
					"content": "在这种偏僻地方摆摊的奇怪占卜师，怎么想都很难信任得起来吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920124,
					"content": "#（{NICKNAME}好像和这个占卜师很熟悉的样子？太好了，总算可以找个可靠的人打听了…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920125
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920125,
					"content": "#…{NICKNAME}，小派蒙，过来过来，我悄悄问你们点事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920126,
						746920127
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920126,
					"content": "我正好也想问问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920128
					]
				},
				{
					"id": 746920128,
					"content": "当然是为了寻找新的调酒材料啦。哼，我之前的调酒思路还是太狭窄了，总是找食材用来调酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920129
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920129,
					"content": "哈哈…哈…迪奥娜找的那些调酒材料，也不能全都算是「食材」啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920130,
					"content": "总、总之，都是一些能入口的东西嘛！只要咬着牙闭着眼，怎么样都能吃下肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920131,
						746920132
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920131,
					"content": "所以，你打算找一些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920133
					]
				},
				{
					"id": 746920133,
					"content": "是啊，比如…我已经拿到了好多锈蚀的螺丝、废弃的线缆、凝结的油污块，还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920134
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920134,
					"content": "还是多亏了枫丹科学院那个做枫达的大叔帮忙，我才能顺利找到这么多好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920135,
						746920136
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920135,
					"content": "安里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920137
					]
				},
				{
					"id": 746920137,
					"content": "嗯…我之前就听说，那种很好喝的气泡饮料是枫丹科学院做的，所以一开始就打算过去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920138
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920138,
					"content": "我去了之后，安里大叔很爽快地请我喝了好几瓶新口味的枫达呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920139
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920139,
					"content": "安里大叔身上都没有酒味喔，只有甜甜酸酸的枫达味，一闻就感觉他是一个可靠的大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920140
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920140,
					"content": "而且，就是安里大叔建议我来这里看看的。他说，我这种「特殊体质」恐怕不能用科学院的技术解析。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920141
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920141,
					"content": "但他听说最近枫丹廷附近有一个奇怪的占卜摊，去占卜过的人都说非常灵验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920142
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920142,
					"content": "「去占卜的话，说不定就能弄清原理。只要弄清了原理，也许就能找到解决方法。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920143
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920143,
					"content": "听着还挺有道理的，思路也很清晰，该说不愧是枫丹科学院的研究员吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920144,
					"content": "之后，我就来了这个占卜摊…我一过来，她就叫住了我，说我身上有着奇异的扰动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920145
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920145,
					"content": "我还没来得及接话呢，她就把我的体质问题全都说了出来，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920146
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920146,
					"content": "但是，枫丹科学院的研究逻辑，并不能直接用在占卜上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920147,
					"content": "即便是知道了「原理」，之后的事情也并不好办…就像是之前我说的那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920148
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920148,
					"content": "神秘学可不是实在的轴承与螺丝，我也无法为你直接「检修」命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920149
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920149,
					"content": "那不就是，什么都改变不了的意思吗？那我抽牌也没用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920150
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920150,
					"content": "那可不一定啊。说不定你抽了牌，就能找到你命运中缺失的某一片小小齿轮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920151
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920151,
					"content": "虽然看起来微不足道，但只要安装进机关里，反而能驱动某一个巨大的系统呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920152
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920152,
					"content": "#你…你不会骗我吧？{NICKNAME}，你说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920153,
						746920154
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920153,
					"content": "芭比洛斯女士很可靠的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920155
					]
				},
				{
					"id": 746920155,
					"content": "#…好吧，既然{NICKNAME}都这么说了，那我就抽一张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920156
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920156,
					"content": "在芭比洛斯的注视下，迪奥娜伸出手，缓缓抽出了一张「月谕圣牌」…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746920157
					]
				},
				{
					"id": 746920157,
					"content": "我、我抽好了。这张牌是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920158
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920158,
					"content": "…哦呀，真是奇了…没想到你身上的那团「扰动」居然成长地如此茁壮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920159
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920159,
					"content": "它已经不再是「新苗」，而是一根健壮的枝干了。真是奇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920160
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920160,
					"content": "啊？什么意思，是…是我以后调酒会越来越好喝的意思吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920161,
						746920162
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920161,
					"content": "听着不像是坏事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920163
					]
				},
				{
					"id": 746920163,
					"content": "如果单从你的体质上来说，确实会如此。而且，你抽到的牌是逆位的「女祭司」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920164
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920164,
					"content": "这意味着你曾经过于在意帷幕前的表象，也正是因为如此，才久久无法穿过帷幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920165
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920165,
					"content": "听起来和调酒没什么关系嘛…我还以为这张牌会告诉我，需要去找什么食材呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920166
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920166,
					"content": "呵…「月谕圣牌」确实做不到这件事，至少目前不能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920167
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920167,
					"content": "但是，你也不一定非要用「调酒」这个行为，来寻找你人生中那个真正的答案啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920168
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920168,
					"content": "我人生的真正答案，就是把所有酒鬼大叔都教训一遍，让他们再也不能醉醺醺地发酒疯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920169
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920169,
					"content": "很有行动力。不过，虽然你的身体在行动，但你的「内心」却一直停滞不前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920170
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920170,
					"content": "才不是呢！我…我发自内心最讨厌喝酒的怪大叔了！特别是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920171
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920171,
					"content": "原来如此，那么…你和你心里所想着的那个人谈过么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920172
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920172,
					"content": "我…唔，你、你怎么知道我想的是谁？我都没…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920173
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920173,
					"content": "当然是占卜啊。呵呵呵，或许你可以抛去那些焦躁的行动，混乱的情绪，用你真正的内心和他对话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920174
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920174,
					"content": "这样做的效果，说不定会比调出一瓶世界上最难喝的酒更有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920175
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920175,
					"content": "…他肯定不会听的。只要喝了酒，他就什么都不会听的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920176
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920176,
					"content": "或许之前是这样。但现在，你已经找到了一枚小小的齿轮。在它的推动下，事情或许会发生一些…微妙的变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920177
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920177,
					"content": "你是说这张牌？但它只是一张牌而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920178
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920178,
					"content": "当然不是。我说的是，你已经开始产生变化的「内心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920179
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920179,
					"content": "我、我的内心一点变化都没有！现在…现在我要去找调酒材料了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920180
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920180,
					"content": "…那个，占卜费是多少，我会如数照付的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920181
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920181,
					"content": "哦呀，真是个礼貌的孩子，比那丫头讨喜多了。但占卜费就不必了。就当做是魔女赠予你的小礼物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920182
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920182,
					"content": "谢…谢谢你。要是你来蒙德…我可以请你喝饮料的，保证好喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920183
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920183,
					"content": "我去蒙德？嗯…如果有机会的话，去一趟倒也未尝不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920184
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920184,
					"content": "#也谢谢你们陪我，{NICKNAME}，还有小派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920185,
						746920186
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920185,
					"content": "没事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920187
					]
				},
				{
					"id": 746920187,
					"content": "#没错。无论是什么麻烦事，我和{NICKNAME}都会马上赶过去帮你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920188
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920188,
					"content": "不过嘛…嘿嘿嘿，帮完忙之后，迪奥娜要请我们喝好喝的才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920189
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920189,
					"content": "…嗯！等你们来蒙德城玩，我一定请你们喝最好喝的饮料，一点酒都不含的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920190
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920190,
					"content": "对了，要是你之后对卡牌还有什么疑问，可以去找一个叫莫娜的小丫头。你应该认识她吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920191
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920191,
					"content": "莫娜姐姐？我认识呀，她经常来店里点那种最便宜的饮料喝，她也是很厉害的占卜师吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920192
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920192,
					"content": "哈，比我差远了。不过，要是连解读「月谕圣牌」都做不到，那干脆也别自称占卜师了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920193
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920193,
					"content": "你只要和她说，替伟大的亚斯妥曼瑟·芭比洛斯·崔斯梅姬斯图斯带来了预言，作为给她的考验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920194
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920194,
					"content": "放心，只要这么说了，她肯定会拼尽全力为你解读的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920195
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920195,
					"content": "嗯，我记住了！亚斯妥…妥曼瑟·芭比洛斯·崔斯梅姬斯图斯…好长的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920196
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920196,
					"content": "这么说来，莫娜姐姐的名字是不是也很长，好像是叫阿斯托洛吉…什么来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 746920186,
					"content": "之后要帮忙的话，随时叫我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920187
					]
				},
				{
					"id": 746920162,
					"content": "但从气势上来说也不算好事呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920163
					]
				},
				{
					"id": 746920154,
					"content": "放轻松抽一张牌吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920155
					]
				},
				{
					"id": 746920136,
					"content": "你怎么遇见他了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920137
					]
				},
				{
					"id": 746920132,
					"content": "压根不能入口的东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920133
					]
				},
				{
					"id": 746920127,
					"content": "迪奥娜怎么来枫丹了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920128
					]
				},
				{
					"id": 746920119,
					"content": "我很擅长及时出现。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920120,
					"content": "不然怎么处理那么多委托。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920115,
					"content": "好久不见，迪奥娜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920116
					]
				}
			]
		},
