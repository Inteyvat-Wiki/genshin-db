				]
			},
			"dialogs": [
				{
					"id": 740590101,
					"content": "啊，是你们，之前卖我宝石的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590102,
					"content": "嗯嗯，我记得你上次说，要用我们卖给你的宝石制作成好看的首饰，不知道做出来没有啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590103,
					"content": "我们一直很期待呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590104,
					"content": "这个嘛…那恐怕要让你们失望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590105,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590106,
					"content": "虽然我是想要把那个做成镶嵌在首饰上的宝石啦。但是这种矿石的硬度实在太高，要进行精细的手工打磨也很困难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590107,
					"content": "而且最要命的是，没想到在切割打磨后，矿石就失去了一开始的光泽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590108,
					"content": "总的来说，就是完全不适合制作成什么工艺品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590109,
					"content": "唔，没想到会这样，我们还以为这种石头真的能有什么用处呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590110,
					"content": "用处嘛，倒也不能说完全没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590126,
					"content": "一边说着，切瑟尔一边将一台机械钟表摆到了柜台上。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "你们看这次新做的机械钟表，可就用到了那种矿石呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590112,
					"content": "本来我都觉得是自己看走了眼，准备把这些石头处理掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590113,
					"content": "结果有些钟表匠看到了那些加工失败的矿石，由于矿石的硬度很高的缘故，他们就拿来做了钟表里面的机芯零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590114,
					"content": "没想到因为硬度高抗磨损，作为机芯零件，这种矿石与之前用的材料相比，使用效果要好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590115,
					"content": "但是如果用来制作钟表的话，对货源稳定的要求就更高了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590116,
					"content": "这个倒是好说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "你们将芙佳和矿脉的事情告诉了切瑟尔。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "原来如此，那还真是巧了！这款试作型的钟表采用了新发明的防水蚌式结构，原本就有打算让美露莘也能方便使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590120,
					"content": "既然这样的话，能拜托你们把这个钟表带给那位芙佳小姐，顺便帮我提前说明一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590121,
					"content": "毕竟我也没有和美露莘做生意的经验…如果芙佳小姐能够提供稳定的货源的话，就能建立一条新的生产线了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590122,
					"content": "后面我也会亲自上门联络的！在以后的钟表的设计上，也可以加入美露莘的风格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590123,
					"content": "嘿嘿，听起来如果能成功的话，对芙佳也很有好处呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590124,
					"content": "说不定借此机会，芙佳也能拥有自己的宝石工坊了，我们就回去找芙佳说说看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590125,
					"content": "那就拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "切瑟尔"
				},
				{
					"id": 740590117,
					"content": "直接和芙佳联系的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
