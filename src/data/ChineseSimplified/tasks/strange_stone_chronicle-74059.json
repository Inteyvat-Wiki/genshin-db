			"dialogs": [
				{
					"id": 740590201,
					"content": "#是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙，好久不见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590202,
					"content": "你们是还想要收集上次那种奇怪的石头吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590203,
					"content": "唔，虽然也没错啦，不过这个说来话长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590204,
					"content": "你们将从切瑟尔那里得来的钟表交给了芙佳，并且把切瑟尔想要利用奇异矿石制作钟表的事情告诉了她。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "好、好厉害，原来这样的石头还能用来做成这种东西吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590206,
					"content": "欸？不过只有机芯里的宝石是用那个石头做的啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590207,
					"content": "竟然在水下也能滴滴答答地响，这样的钟表还是第一次见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590208,
					"content": "唔，我记得切瑟尔是说采用了什么蚝式结构？还是蚌式结构来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590209,
					"content": "嘿嘿，光是听到钟表里面的声音就开心起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590210,
					"content": "没想到就算是这种普通的石头，也会有适合它自己的用途…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590211,
					"content": "以前我一直觉得只有像姐姐那样，用稀有的宝石才能做出了不起的作品，没想到普通的石头也能做成这么厉害的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590212,
					"content": "无论是什么都有其用处。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "嗯嗯，芙佳对自己也突然有自信起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590214,
					"content": "芙佳小心翼翼地把钟表摆在了好看的地方。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "既然如此，芙佳就准备好矿石，到时候卖给切瑟尔就好了啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590216,
					"content": "这样的话，芙佳也能像姐姐一样，拥有一个自己的宝石工坊了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590217,
					"content": "芙佳这里有这么多各种各样的石头，说不定也都能找到各自的用处呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590218,
					"content": "嗯嗯，我会好好准备的，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590219,
					"content": "之后如果你们想要找什么石头的话，也请随时来找我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590220,
					"content": "嘿嘿，不用谢啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
