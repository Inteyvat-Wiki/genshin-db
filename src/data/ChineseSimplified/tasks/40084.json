			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"铁骨双刀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840401,
					"content": "是你们，见识浅薄的鼠辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840402
					],
					"speakerTitle": "铁骨双刀"
				},
				{
					"id": 400840402,
					"content": "好大的口气！凭什么这么说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840403,
					"content": "对蕈兽投入多余的情感，何其软弱，何其可笑！这有悖于最强的驯兽师，海妮耶大人的理念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840404
					],
					"speakerTitle": "铁骨双刀"
				},
				{
					"id": 400840404,
					"content": "最强的驯兽师…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840405,
					"content": "我们会纠正海妮耶的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840406
					]
				},
				{
					"id": 400840406,
					"content": "别妄想了！软弱之人没有资格和海妮耶大人对阵，你们会止步于此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁骨双刀"
				}
			]
		},
		{
			"id": 4008406,
			"completionStepIds": [
				4008406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008406",
							"2"
						],
						"stepId": 4008406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱依拉",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840601,
					"content": "#{NICKNAME}，派蒙，我成功晋级了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840602
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840602,
					"content": "太好了，莱依拉！你顺利完成了参赛的目标！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840603,
					"content": "可喜可贺！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840604
					]
				},
				{
					"id": 400840604,
					"content": "我听说你们打败了那个一路过关斩将的「铁骨双刀」…为什么我感觉，你们好像有点不开心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840605
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840605,
					"content": "怎么说呢…这个对手不太友善，说了很多奇怪的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840606,
					"content": "向莱依拉讲述了对决中的细节…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400840607
					]
				},
				{
					"id": 400840607,
					"content": "原来是这样…总觉得这样的驯兽师有点…悲哀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840608
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840608,
					"content": "悲哀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840609
					]
				},
				{
					"id": 400840609,
					"content": "嗯，那个人明明不了解海妮耶，只凭一个朦胧的印象去揣测她，甚至效仿她。海妮耶要是知道了这种事，大概也会苦恼的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840610
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840610,
					"content": "而且，那个驯兽师对原本可以成为好朋友的蘑菇伙伴这么严苛，不止自己受到了损失，还会影响其他选手的心态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840611
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840611,
					"content": "对啊，我觉得莱依拉的心态就很好！大家都和你一样的话，比赛的气氛也会更和谐，更欢乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840612,
					"content": "只是因为我的目标不高吧…只要能把「转转悠悠兽」带回去一起生活，我就很满足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840613
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840613,
					"content": "接下来就轮到我们较量了。我们要友好、开心地比试一场，输赢不重要，当成朋友间的切磋就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840614
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840614,
					"content": "一言为定！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840615
					]
				},
				{
					"id": 400840615,
					"content": "好哦！让我们看看「转转悠悠兽」和「咚咚小圆帽」谁更厉害！赢了的一边要请输了的吃饭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840616,
					"content": "看你们开开心心地作出约定，难道我错过了什么关键的讨论吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840617
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840617,
					"content": "神子，你总算出现了！上次你不声不响就走了，我们还有些线索…呃咳，还有些事想要和你商量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840618,
					"content": "我也很苦恼呢，我抱着随便玩玩的想法参赛，结果反而进入了半决赛，只能挤出时间陪着左右加他们取材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840619
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840619,
					"content": "你们两个倒是不必担心，想必会进行一场非常和谐的比赛。我倒是要稍微认真一点了，毕竟对手是那个无比偏执的家伙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840620
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840620,
					"content": "确实，没想到情况会变成这样，八重小姐居然要和海妮耶对阵了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840621
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840621,
					"content": "乐观一点，说不定神子就帮我们把海妮耶打败了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840622,
					"content": "虽然那样就不能亲自说服海妮耶了，但我还是不希望神子输掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008408,
