				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841501,
					"content": "结果还是失败了，只有在赛场上打败海妮耶这一个选择了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841502,
						400841503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841502,
					"content": "至少听到了她的真实想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				},
				{
					"id": 400841504,
					"content": "海妮耶好像说过，以前也有学者尝试遏制蕈兽造成的灾害？这本笔记还有不少内容，我们再好好读一读吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841506,
					"content": "这是海妮耶的祖辈收集的…学者们的研究记录？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841507,
					"content": "唔，这部分的内容好复杂，字迹潦草，还有很多术语，怎么想都看不懂吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841508,
					"content": "不过，有很多眼熟的词语欸…好像在之前多莉给我们的文件上见过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841509,
						400841510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841509,
					"content": "笔记和文件有关联。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841511,
					"content": "嗯，我们仔细一点，对照着文件残卷，试着解读笔记的内容吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841512,
					"content": "捕获装置？枯化药剂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841513,
						400841514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841513,
					"content": "捕获装置使蕈兽温和。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841515,
					"content": "原来是这样…当年袭击海妮耶祖辈的蕈兽，是被药剂影响后才失控的…学者们造出捕获装置，是为了抓住那些发狂的蕈兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841516,
					"content": "而且，现在的「花花琼脂」就是「枯化药剂」的改进版，「意智宝珠」也根本不是考特里亚的发明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841517,
					"content": "考特里亚只不过是在捕获装置的基础上给自己搞了两个新包装，大骗子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841518,
						400841519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841518,
					"content": "大骗子！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841520,
					"content": "但考特里亚这么想推广「意智宝珠」，到底有什么目的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841521,
						400841522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841521,
					"content": "也许是想完成前人的试验…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841523,
					"content": "那我们必须早点警告埃尔欣根，不能再资助考特里亚那家伙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841524,
					"content": "至于海妮耶…当时袭击她祖辈的蕈兽全都受到了刺激，这件事她完全不知情，难怪会觉得蕈兽不可饶恕呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841525,
					"content": "别担心，「咚咚小圆帽」，我相信你不会因为「花花琼脂」变得暴躁！毕竟关闭了「意智宝珠」后，你也是个好孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841526,
					"content": "啊呀，你好像完全能听懂我的话了？越来越聪明了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841527,
						400841528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841527,
					"content": "等等，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841529,
					"content": "咦？什么时候的事！完全没有注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841530,
					"content": "也就是说，现在的「咚咚小圆帽」，正在凭自己本来的心性和我们共处吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841531,
						400841532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841531,
					"content": "共处的经历影响了它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841533,
					"content": "所以说嘛！我绝不同意海妮耶关于蕈兽还会失控的推测！蕈兽里也有好蕈兽，就像「咚咚小圆帽」一样通人性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841534,
					"content": "可是有一点，海妮耶说得有道理呢…「意智宝珠」不是万能的，只要那个缺点还在，蕈兽伙伴就不能一直待在普通人身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841535,
					"content": "我还以为可以和「咚咚小圆帽」一起继续旅行下去呢…就不能想想办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841536,
						400841537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841536,
					"content": "先和伙伴们保持适当的距离…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841538,
					"content": "虽然有点可惜，但目前看来，也只能这样了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841539,
					"content": "现在距离决赛还有一段时间，我们要向教令院报告考特里亚的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841540,
						400841541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841540,
					"content": "我们不清楚考特里亚的势力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841542,
					"content": "确实呢…考特里亚能干出这种大事，肯定谋划了很久。如果我们打算戳穿他的事被他提前知道了，他应该也会提防我们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841543,
					"content": "不管怎么样，决赛的那天，我们一定要拿出全力！先打败海妮耶，让她别再固执，然后说服埃尔欣根，一起揭露考特里亚的阴谋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841541,
					"content": "不能贸然打草惊蛇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841537,
					"content": "一边寻找改进宝珠的方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841532,
					"content": "我们正在达成默契。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841528,
					"content": "「意智宝珠」并没有运转。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841522,
					"content": "以此证明自己的能力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841519,
					"content": "好啦，其实也不太意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841514,
					"content": "枯化药剂使蕈兽暴躁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841510,
					"content": "我们结合两边的信息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841503,
					"content": "至少拿到了她的记事簿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				}
			]
		}
	]
