				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840801,
					"content": "我有点紧张，但也很期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840802
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840802,
					"content": "请你们不要太拘束，「转转悠悠兽」带领的队伍经历过不少考验，实力也是不错的！让你们的伙伴拿出全力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840803
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400840803,
					"content": "那就接招吧，莱依拉，还有「转转悠悠兽」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
