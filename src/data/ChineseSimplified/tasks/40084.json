			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841201,
					"content": "嗯？你们是怎么找到这里的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841202
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841202,
					"content": "我们是追着「火一」的痕迹找过来的，看见你刚才的状态，我们很不安！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841203,
					"content": "等等…你这是在安慰「火一」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841204,
					"content": "还真是讽刺…如果「火一」不是蕈兽，而是普通的动物，我大概会为此感到高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841205
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841205,
					"content": "下次见面就是决赛了，有什么想说的，就等到打败我以后再唠叨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841206,
						400841207
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841206,
					"content": "我们想了解你的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				},
				{
					"id": 400841208,
					"content": "你们的说辞和那个狐狸女人预测的完全一样…你们确实很单纯，很善良，把一些事情想得太过美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841209
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841209,
					"content": "只凭我简单的转述，是不能让你们理解的。看看这个吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841210
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841210,
					"content": "这是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841212,
					"content": "这是我的祖辈们的记事簿，当年，他们在雨林中遭到了蕈兽的攻击，许多人身受重伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841213
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841213,
					"content": "这件事在当时不值一提，甚至没有被任何文献记载。但我的家族成员自我小时候起，就反复把它念给我听，教导我蕈兽的威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841214
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841214,
					"content": "原来以前发生过这样的事，难怪你这么仇视蕈兽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841215,
						400841216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841215,
					"content": "我们的确不清楚你的身世。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841217,
					"content": "确实，如果你有这样的过去，应该更能理解这场比赛的可取之处，毕竟「意智宝珠」能让人们和蕈兽和谐相处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841218,
					"content": "事情没有那么简单，你们认为「意智宝珠」能让蕈兽变得温顺。以前也有学者来到村子里，用相似的道具做过实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841219
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841219,
					"content": "但他们都失败了，丢盔弃甲逃走了。如今的「意智宝珠」也只能暂时压制蕈兽的凶恶本性，脱离了这种道具，蕈兽依然万分危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841220
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841220,
					"content": "而且，宝珠的「理智增幅」会让蕈兽的元素力异常活跃，影响周围的环境，身体不够强健的人使用宝珠后，很快就会出现不适症状。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841221
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841221,
					"content": "元素力的异常…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841222
					]
				},
				{
					"id": 400841222,
					"content": "难道说莱依拉最近老是咳嗽，就是因为「意智宝珠」的这个缺点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841223,
					"content": "不用我多说，你们应该也明白，考特里亚是个学术疯子，他只想着扩大自己的影响力，推广驯兽活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841224
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841224,
					"content": "那个埃尔欣根也是个见风使舵的家伙，看中了考特里亚的研究成果，用雄厚的资金宣传这场比赛，从而使人们对蕈兽放下戒心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841225
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841225,
					"content": "不管怎么样，我不相信他们，不相信凶恶的蕈兽可以和人们共处。但作为一个小小的退役佣兵，我的声音无法被任何人听见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841226
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841226,
					"content": "我只能在他们的规则里赢得胜利，争取我想要的结局，不让他们得逞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841227
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841227,
					"content": "原本我还有一丝希望，期待你们能帮我，结果是我太天真了。不管你们怎么想，怎么看待我，我都会打败你们，从你们身上踏过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841228
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841228,
					"content": "海妮耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841229
					]
				},
				{
					"id": 400841229,
					"content": "这本笔记就像是我的过去，你们想要怎么处置它都无所谓了。反正等到决赛那天，我会宣布处死所有蕈兽…包括「火一」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841230
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841230,
					"content": "和我的过去永别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841216,
					"content": "但如今的情况不同了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841207,
					"content": "我们想消除你的偏见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				}
			]
		},
