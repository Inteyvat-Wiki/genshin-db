			"dialogs": [
				{
					"id": 140000401,
					"content": "…好慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000402
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140000402,
					"content": "#抱歉，路上遇到了{NICKNAME}和夏洛蒂，一起聊了会儿天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000403
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000403,
					"content": "琳妮特，好久不见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000404,
					"content": "我们现在是林尼的临时助手，来帮你们一起调查怪盗貂的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000405,
					"content": "谢谢，你们人真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000406
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140000406,
					"content": "怎么样，见到嘉玛了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000407
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000407,
					"content": "我一直在这里等着，并没有人来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000408
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140000408,
					"content": "奇怪，难道说情报有问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000409
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000409,
					"content": "#光在这里等着也不是办法。{NICKNAME}、派蒙，我们先去附近打听一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
