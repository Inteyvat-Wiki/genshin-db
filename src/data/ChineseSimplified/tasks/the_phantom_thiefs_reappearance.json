			"dialogs": [
				{
					"id": 140001001,
					"content": "你好，那个…请问你就是嘉玛吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140001002,
					"content": "…你们是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001003
					],
					"speakerTitle": "嘉玛"
				},
				{
					"id": 140001003,
					"content": "别紧张，我们没有恶意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001004
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001004,
					"content": "你好像受伤了，不要紧吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001005
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001005,
					"content": "谢谢关心。你们到底是谁，找我有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001006
					],
					"speakerTitle": "嘉玛"
				},
				{
					"id": 140001006,
					"content": "我叫林尼，这是我妹妹琳妮特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001007
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001007,
					"content": "#我是派蒙，这位是{NICKNAME}。我们是来调查怪盗貂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140001008,
					"content": "今天早上，怪盗貂又发布了预告函。如果怪盗貂还活着，说明塞萨尔是被冤枉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001009
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001009,
					"content": "你是最了解塞萨尔的人，我们想听听你的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001010
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001010,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001011
					],
					"speakerTitle": "嘉玛"
				},
				{
					"id": 140001011,
					"content": "请你相信我们。我们不会伤害你，相反，我们会尽可能保护你的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001012
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001012,
					"content": "我…从来就不相信塞萨尔会是怪盗貂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001013
					],
					"speakerTitle": "嘉玛"
				},
				{
					"id": 140001013,
					"content": "果然。那十年前，你有察觉到什么异样吗？比如有没有人和他发生过冲突？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001014
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001014,
					"content": "…没有。我什么也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001015
					],
					"speakerTitle": "嘉玛"
				},
				{
					"id": 140001015,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001016
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140001016,
					"content": "这样啊。抱歉，打扰到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001017
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001017,
					"content": "没什么事就请离开吧，我想和他单独待一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001018
					],
					"speakerTitle": "嘉玛"
				},
				{
					"id": 140001018,
					"content": "总觉得她刚刚的表情好像不太自然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140001019,
					"content": "她在说谎，她肯定知道什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001020
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140001020,
					"content": "也许是不太信任我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140001021
					]
				},
				{
					"id": 140001021,
					"content": "嗯，毕竟我们突然出现，冷不防地要查十年前的事，她会提防我们也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001022
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001022,
					"content": "看来暂时很难问出什么消息了。今天先到此为止吧，明天我们在德波大饭店门口碰头，再开始下一步的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
