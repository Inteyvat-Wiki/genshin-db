						],
						"pointId": 5447
					}
				]
			},
			"dialogs": [
				{
					"id": 140000201,
					"content": "魔术师哥哥，刚才你怎么知道我选的是哪张卡牌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000202
					],
					"speakerTitle": "大卫"
				},
				{
					"id": 140000202,
					"content": "很简单。嘘…悄悄告诉你，其实魔术师都会「读心术」，可以轻松看穿一个人内心藏着的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000203
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000203,
					"content": "真的假的？那你猜猜我在想什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000204
					],
					"speakerTitle": "大卫"
				},
				{
					"id": 140000204,
					"content": "放轻松，我看到你内心紧闭，似乎在说「绝对不能被猜到」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000205
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000205,
					"content": "唔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000206
					],
					"speakerTitle": "大卫"
				},
				{
					"id": 140000206,
					"content": "现在你变得有点慌张。你开始想办法放空大脑，强迫自己什么也不去想。不过越是想要隐藏，秘密也就暴露得越快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000207
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000207,
					"content": "你是瞒着家人偷偷跑出来的吧？为了出来玩，你对他们说谎了，这可不是个好习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000208
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000208,
					"content": "这你都能看出来吗？好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000209
					],
					"speakerTitle": "大卫"
				},
				{
					"id": 140000209,
					"content": "那当然。好了，魔术演出结束，你也该回去了。记得要好好向担心你的家人道歉，明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000210
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000210,
					"content": "嗯，我知道了…再见，魔术师哥哥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000211
					],
					"speakerTitle": "大卫"
				},
				{
					"id": 140000211,
					"content": "林尼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000212,
					"content": "你们好，又见面了。你们是来找我的吗，发生什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000213
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000213,
					"content": "你不是会「读心术」吗，猜猜看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000214,
					"content": "别难为我了，你们不会也相信我有读心术吧？我可没有那么大的本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000215
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000215,
					"content": "刚刚我们可是看到了，林尼先生准确地看穿了那孩子内心的秘密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000216
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000216,
					"content": "那只是魔术手法而已，我会通过他脸上的微表情来做出判断…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000217
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000217,
					"content": "魔术散场后，只有他的身边没有家长陪同，而他的视线也有些躲闪，猜中他的心事并不难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000218
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000218,
					"content": "至于你们的来意…这让我怎么猜呢？总不会是为了怪盗貂的事情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000219
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000219,
					"content": "你怎么知道！这也是「魔术手法」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000220,
					"content": "啊，我猜对了？哈哈…不是什么手法，这次只是纯粹的运气好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000221
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000221,
					"content": "今天早上预告函的事闹得沸沸扬扬，我想说不定你们也在打听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000222
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000222,
					"content": "没错，我打算做一期专栏，报导怪盗貂的最新情报！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000223
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000223,
					"content": "林尼先生，请问你对怪盗貂重现人间的事情怎么看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000224
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000224,
					"content": "这个嘛…说实话，我很生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000225
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000225,
					"content": "生气？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000226,
					"content": "你们应该看过那封预告函了吧？怪盗貂说，他会在三天后的晚上在歌剧院作案，而我恰好在那天有一场魔术表演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000227
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000227,
					"content": "这么巧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000228,
					"content": "等等，该不会怪盗貂这次盯上的人…是你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000229,
					"content": "如果真是这样，那这封预告函就是对我的挑衅了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000230
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000230,
					"content": "就算不是冲我来的，我也很头疼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000231
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000231,
					"content": "怪盗貂的名声很差，大家对他避之不及，等预告函的内容流传开，估计没多少人敢来看我的表演了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000232
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000232,
					"content": "我为这场表演准备了很久，不能眼睁睁地看着它被怪盗貂毁掉。所以…我打算在表演开始前，戳穿怪盗貂的真实身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000233
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000233,
					"content": "真的吗！也就是说…我们能看到魔术师与怪盗的对决了？这可真是了不得的独家新闻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000234
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000234,
					"content": "我也不确定能不能成功，毕竟十年前怪盗貂就是出名的窃贼，有着让人捉摸不透的手法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000235
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000235,
					"content": "林尼先生太谦虚啦，我倒是觉得你平时变魔术的「手法」比怪盗还要神秘呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000236
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000236,
					"content": "多谢称赞，不过这个对比稍微有些不妥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000237
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000237,
					"content": "世人常常将魔术师和怪盗联系在一起，因为他们都能神不知鬼不觉地把东西变消失。但其实，这两种手法是不一样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000238
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000238,
					"content": "让我用一个小小的魔术来举例吧，这是一朵刚摘不久的花。请你们盯紧它，千万不要眨眼。三，二，一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000239
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000239,
					"content": "消失了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000240,
					"content": "花去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000241
					]
				},
				{
					"id": 140000241,
					"content": "是啊，去哪儿了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000242
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000242,
					"content": "——你看，这就是魔术师与怪盗不同的地方。怪盗只会让宝物消失，但魔术师可以把它再变出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000243
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000243,
					"content": "现在，请各位检查一下自己的衣装，看看有没有多出什么「惊喜」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000244
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000244,
					"content": "惊喜？我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000245,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000246
					]
				},
				{
					"id": 140000246,
					"content": "在这里！！这是怎么做到的？你明明就站在那没有动——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000247,
					"content": "真是精彩的魔术！抱歉林尼先生，刚刚我的称赞不是很恰当，魔术和偷窃肯定不能混为一谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000248
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000248,
					"content": "没事没事，我并不介意，只是想借机改变一下大家对魔术师的固有印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000249
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000249,
					"content": "塞萨尔死后，民众常常会把魔术师和怪盗关联在一起，让我很苦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000250
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000250,
					"content": "原来是这样。说回刚刚的魔术，我其实有个疑问，林尼先生懂「花语」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000251
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000251,
					"content": "我看别的魔术师在表演有关花的魔术时，一般都会选用「虹彩蔷薇」，因为虹彩蔷薇象征着「热情」与「美好的相遇」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000252
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000252,
					"content": "但林尼先生用的却是「柔灯铃」。在我的印象中，柔灯铃通常意味着「分别」，林尼先生选用它是有什么特别的深意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000253
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000253,
					"content": "不愧是知名记者，真敏锐。我对花语没什么研究，用柔灯铃来变魔术只是一种习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000254
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000254,
					"content": "改天我去买一本《枫丹花语大全》，好好研究一下。现在暂时没有时间，我要开始调查怪盗貂的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000255
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000255,
					"content": "好的，那采访就到此结束，期待林尼先生与传闻中怪盗的终极对决！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000256
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000256,
					"content": "如果有什么进展的话，可以随时联系我。三天后我也会到现场去看林尼先生的魔术秀，希望那时候怪盗貂已经顺利落网。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000257
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000257,
					"content": "我先走啦！刚刚的采访已经足够我写一篇独家新闻了，时间不等人，越快发表越好。回头见各位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000258
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000258,
					"content": "林尼，你还没告诉我们呢，刚刚的魔术到底是怎么变的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000259,
					"content": "这个嘛…保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000260
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000260,
					"content": "唔…我也知道魔术的秘密很重要，不过搞不清楚的话，总觉得心里好像有猫在抓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000261,
					"content": "#{NICKNAME}，你也这么想吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000262,
						140000263
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000262,
					"content": "怪盗貂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000264
					]
				},
				{
					"id": 140000264,
					"content": "看来你更在意怪盗貂的事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000265
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000265,
					"content": "既然这样，要不要当我的「临时魔术助手」，和我一起调查？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000266
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000266,
					"content": "「临时魔术助手」？听起来还不错，好像我们也变成魔术师啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000267,
					"content": "而且这也是一个从他身上挖出秘密的好机会，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000268,
						140000270
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000268,
					"content": "一起调查吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000269
					]
				},
				{
					"id": 140000269,
					"content": "太好了，感谢你们的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000271
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000271,
					"content": "目前最重要的是搞清楚塞萨尔的真实身份。如果他是怪盗貂的话，那怪盗貂已死，这次发预告函的就只是模仿犯而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000272
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000272,
					"content": "如果他不是怪盗貂的话…那就有意思了，说明真正的怪盗貂还活着，这十年来他一直销声匿迹，潜伏在枫丹的某个角落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000273
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000273,
					"content": "想要调查塞萨尔，可以从他的未婚妻嘉玛入手。我听说嘉玛经常去墓园，所以提前让琳妮特在那里等她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000274
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000274,
					"content": "差不多到时间了，我们去墓园找琳妮特会合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000270,
					"content": "林尼有什么计划吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000271
					]
				},
				{
					"id": 140000263,
					"content": "真的没问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000264
					]
				}
			]
		},
