			"dialogs": [
				{
					"id": 140000501,
					"content": "打扰一下，请问你认识嘉玛吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000502
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000502,
					"content": "嘉玛？你是指塞萨尔的未婚妻吗？你们打听她做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000503
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000503,
					"content": "我们想找她问点事。听说她经常来墓园？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000504
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000504,
					"content": "是啊。唉…说到嘉玛，她可是个出了名的痴情姑娘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000505
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000505,
					"content": "塞萨尔去世后，她每个礼拜都会来扫墓，有时是呆坐在墓碑前，有时是对着空气自言自语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000506
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000506,
					"content": "有一次我问她在做什么，她说…想和塞萨尔再说说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000507
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000507,
					"content": "哪怕长眠在地下的未婚夫已经听不到她的声音，她也想在这里多待一会儿，为他讲讲最近发生的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000508
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000508,
					"content": "从塞萨尔去世开始…那到现在已经十年了？他们的感情真好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000509,
					"content": "塞萨尔的身份败露后，名声一落千丈，平时根本没什么人愿意来悼念他，只有嘉玛不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000510
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000510,
					"content": "若是塞萨尔泉下有知，应该也会高兴吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000511
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000511,
					"content": "说实话，有时候我会替嘉玛感到不值，毕竟她的未婚夫可是卑劣的怪盗，不值得她这样付出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000512
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000512,
					"content": "话说回来，今天她好像确实来得晚了些。平时这个时候她已经坐在墓前了，是遇到什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000513
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000513,
					"content": "抱歉啦，具体的情况我也不太清楚，你们再去向别人打听下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000514
					],
					"speakerTitle": "巴尔塔萨"
				},
				{
					"id": 140000514,
					"content": "好的，谢谢您和我们说这么多，我们再去找别人问问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000515
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000515,
					"content": "不客气。唉…希望她能早点解开心结。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴尔塔萨"
				}
			]
		},
