			"dialogs": [
				{
					"id": 401990101,
					"content": "欸，那边在喝茶的人…不是夜兰吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990102,
					"content": "她好像在和朋友聚会？我们来得正巧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990103,
						401990104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990103,
					"content": "（不对，这个气氛…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990105
					]
				},
				{
					"id": 401990105,
					"content": "欸，不上去打招呼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990106,
					"content": "前前后后忙了这么久，应该没有漏网之鱼了吧，埃德勒警官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990107
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990107,
					"content": "外勤办案的时间应当还有几天，正好用来犒赏自己，适当度个假？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990108
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990108,
					"content": "多谢您热情招待，夜兰小姐，这阵子简直忙掉了我半条命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990109
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「执律庭」探员"
				},
				{
					"id": 401990109,
					"content": "唔哎…十三个据点啊…那些家伙简直都是盗宝鼬成精！乌泱泱抓出那么一大批人的时候，我都怀疑冤枉了谁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990110
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「执律庭」探员"
				},
				{
					"id": 401990110,
					"content": "好在，终于把这帮经济犯一锅端掉了！现在，我就要去翘英庄，找我那位工程师同学安心叙叙旧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990111
					],
					"speakerTitle": "埃德勒",
					"speakerSubtitle": "「执律庭」探员"
				},
				{
					"id": 401990111,
					"content": "别忘了带些茶叶和点心，给执律庭的朋友们当礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990112
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990113
					],
					"speakerTitle": "科德"
				},
				{
					"id": 401990113,
					"content": "啊，夜兰的朋友走掉了，我还以为能认识一下呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990114,
						401990115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990114,
					"content": "（旁听的两人问题很大啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990116
					]
				},
				{
					"id": 401990116,
					"content": "又是令人惊喜的偶遇啊，请坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990117
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990117,
					"content": "店家，请沏一壶品相最好的「云来白毫」，再补两套茶具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990118
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990118,
					"content": "看你的眼神，应该对刚刚窥伺我们的那两人，很感兴趣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990119
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990119,
					"content": "咦！什么叫窥伺？刚刚有其他人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990120,
						401990121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990120,
					"content": "那两人显然不怀好意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990122
					]
				},
				{
					"id": 401990122,
					"content": "可不止被窃听哦，他们可能已经派人跟上了埃德勒警官，针对我们的行动路线，开始采取对应措施了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990123
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990123,
					"content": "我，我有点明白了！夜兰你是不是在对付什么奇怪的罪犯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990124,
					"content": "那些家伙居然敢反过来跟踪你？未免也太胆大包天了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990125,
					"content": "如果不是习惯了铤而走险的家伙，又怎么轮得到我来对付呢？我还想把功绩留给其他同行，好好休假呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990126,
						401990127
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990126,
					"content": "能让你亲自出手，事情很严重？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990128
					]
				},
				{
					"id": 401990128,
					"content": "涉案金额或达十位数的…「摩拉除痕」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990129
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990129,
					"content": "摩拉厨…厨什么？不对，十位数…十位数是多少来着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990130,
					"content": "简单来说，某位枫丹商人持有大量来路不正的摩拉，枫丹的执法机构可能根据种种痕迹锁定这笔钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990131
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990131,
					"content": "为了避免这笔钱被追查，牵连自己，就需要将其置换成合法的摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990132
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990132,
					"content": "于是，这名商人想到了一个点子——高价值艺术品的拍卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990133
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990133,
					"content": "他四处购买收藏品，运回枫丹后，将其包装成艺术价值极高的珍品，炒出高价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990134
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990134,
					"content": "等到拍卖时，他用赃款买下自己炒上高价的收藏品。经过中间周转，除去差价后到手的摩拉就「干净」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990135
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990135,
					"content": "利用这一手段，这名商人不仅洗清了自己手中的赃款，甚至开始帮其他罪犯除痕，并因此得到了「黑钱领主」的称号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990136,
						401990137
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990136,
					"content": "这收藏品与璃月有关吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990138
					]
				},
				{
					"id": 401990138,
					"content": "没办法，谁让沉玉谷的商品精美实惠，又历史悠久呢？茶具，瓷器，玉玦和石雕，都可以被包装成价值连城的艺术品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990139
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990139,
					"content": "以璃月的商品为媒介，从事如此见不得人的勾当，长此以往，会对璃月的贸易造成难以估量的恶劣影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990140
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990140,
					"content": "为此，正好又在枫丹度假的我，就只能立刻回到工作状态了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990141
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990141,
					"content": "唔…夜兰的解释还比较好懂？简直像…把钱从左手换到右手…只是经过了一个骗人的幌子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990142,
					"content": "不过，既然你们已经明白了对方犯罪的方法，顺着这个线索，不就能揪出他了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990143,
					"content": "比如在拍卖会上埋伏好，等到那个坏家伙出现，买下自己炒高价的璃月商品时，就冲上去把他铐起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990144,
					"content": "很敏锐嘛，派蒙，可惜还是不够谨慎哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990145
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990145,
					"content": "如果你是这一切的幕后黑手，你会轻易亲自现身，在别人眼皮底下东奔西走，忙活这一切吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990146
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990146,
					"content": "#这么说来，好像确实不能轻易暴露呢…如果我是坏人，就让{NICKNAME}跑腿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990147,
					"content": "#不对不对，就算我成了坏人，{NICKNAME}也不会变坏，那我就…收下一大群小弟，帮我买货，干脏活！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990148,
					"content": "哦…哦哦哦哦哦…这下连我都理解了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990149,
					"content": "就算追查到了那些有问题的收藏品，只要那个幕后黑手「黑钱领主」不亲自现身参加拍卖会，还是很难办！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990150,
					"content": "不止最后参加拍卖的人哦，来境外买收藏品、中转回国内，作为卖家与拍卖会沟通…这些事，他都有部下掩护。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990151
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990151,
					"content": "追查用来交易的收藏品，本身也是件复杂的任务，因为他采取了大量中转的措施，交易痕迹相当混乱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990152
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990152,
					"content": "放长线，钓大鱼，才是眼下最理智的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990153
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990153,
					"content": "最终目的是用轨迹清晰的鱼饵，避开所有障眼法，揪出隐藏在幕后的「黑钱领主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990154,
						401990155
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990154,
					"content": "所以，你们有意让对方旁听。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990156
					]
				},
				{
					"id": 401990156,
					"content": "我，我还以为你们真的是结束工作了，在放松呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990157,
					"content": "看来你完全上道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990158
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990158,
					"content": "在此之前，我已和千岩军沟通，协助埃德勒警官突袭了「黑钱领主」的众多据点，抓获了这个团体几乎所有的成员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990159
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990159,
					"content": "而刚才那两位则是「黑钱领主」最重要的代理人，直接与他沟通的心腹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990160
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990160,
					"content": "一位是枫丹古董协会的高级成员科德，负责拍卖事务，一位则是须弥船东多达马尼，从事货运行业多年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990161
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990161,
					"content": "我们以相当自然的方式「漏掉」了谨慎的他们，会让他们以为自己走运幸存，采取紧急措施，处理钱款与货品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990162
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990162,
					"content": "为此，那两人立刻追踪埃德勒警官，应当是想确认她的行踪，协助他们在璃月最后的部下安全地转移物资。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990163
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990163,
					"content": "现在，我要趁着他们的视线集中在埃德勒警官身上，打他们个出其不意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990164
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990164,
					"content": "怎么样，有兴趣跟我同行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990165
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990165,
					"content": "我很期待哦，你会在探案这一领域展现出怎样的才华呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990166,
						401990167
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990166,
					"content": "我也不能容忍罪犯们胡来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990168
					]
				},
				{
					"id": 401990168,
					"content": "嗯！既然都遇上了这么重要的案件，我们肯定不能装作没看见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990169,
					"content": "既是帮夜兰你，也是帮沉玉谷的大家，还有…唔…璃月的商界！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990170
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990170,
					"content": "#令人欣赏的责任感啊，{NICKNAME}和派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990171
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990171,
					"content": "但也别忘了自己的利益。按枫丹流行的说法，最后给你们的酬劳，会对标「顶级探员」执行最危险外勤任务的薪资。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990172
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990172,
					"content": "万事开头难，好在，开头的线索已经有了眉目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990173
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990173,
					"content": "「黑钱领主」的团体异常谨慎，所以，我们要从「反侦察」切入正轨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990174
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990174,
					"content": "我有一种猜想…现在，我们先去东北方位转转，验证他们是否如我所料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990167,
					"content": "我也想和你一起工作试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990168
					]
				},
				{
					"id": 401990155,
					"content": "你们刚才在假装放松警惕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990156
					]
				},
				{
					"id": 401990137,
					"content": "否则也不会惊动到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990138
					]
				},
				{
					"id": 401990127,
					"content": "如此特殊的团体，犯了什么罪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990128
					]
				},
				{
					"id": 401990121,
					"content": "你和你的枫丹朋友被窃听了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990122
					]
				},
				{
					"id": 401990115,
					"content": "（夜兰不应该忽略了他们？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990116
					]
				},
				{
					"id": 401990104,
					"content": "（周围有不怀好意的视线…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990105
					]
				}
			]
		},
