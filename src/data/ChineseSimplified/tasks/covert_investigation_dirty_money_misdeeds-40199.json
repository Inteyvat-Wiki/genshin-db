						],
						"pointId": 311500202
					}
				]
			},
			"dialogs": [
				{
					"id": 401990401,
					"content": "嗯，就从这里开始调查好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990402
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990402,
					"content": "跟随夜兰在沉玉谷东北荒无人烟的区域穿行…\\n在夜兰的引导下，从隐秘的位置对海滩进行了一番侦察，成为了「暗中观察的眼哨」。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990403
					]
				},
				{
					"id": 401990403,
					"content": "并没有直接发现「黑钱领主」团伙的成员。周围的环境似乎也没有什么异常之处。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990404
					]
				},
				{
					"id": 401990404,
					"content": "结果…这里好像是普普通通的野外？根本没有坏家伙的痕迹嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990405,
						401990406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990405,
					"content": "别心急嘛，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990407
					]
				},
				{
					"id": 401990407,
					"content": "#嗯，{NICKNAME}已经明白自己要扮演怎样的角色了，进入状态的速度确实不比顶级探员逊色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990408
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990408,
					"content": "现阶段，我们需要「布饵」，这鱼饵就是「黑钱领主」的赃物。所以「找到关键的物品」，比找人更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990409
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990409,
					"content": "要找到赃物，锁定对方藏匿的据点，就是重中之重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990410
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990410,
					"content": "你难道没有觉得，这里的视野很棒吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990411
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990411,
					"content": "这么一说…好像可以看到遗珑埠的港口，远处水面的船，还有一座塔…那座塔是干什么的来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990412,
					"content": "是千岩军的灯塔，平时负责守望水域。必要时，则会打出频闪灯语，承担一定的通信作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990413,
						401990419
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990413,
					"content": "好像明白了这里的优势…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990414
					]
				},
				{
					"id": 401990414,
					"content": "哦？说说看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990415,
						401990416,
						401990417
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990415,
					"content": "窥伺千岩军有利于他们行动…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990418,
					"content": "八九不离十了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990425,
					"content": "千岩军百年如一日，不断派遣巡逻部队，将沉玉谷重点地区的治安维持得无可挑剔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990426
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990426,
					"content": "利用这里的视野优势，观察千岩军的灯语，尽力推测千岩军的行动规律，能最大程度帮助「黑钱领主」转运赃物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990427
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990427,
					"content": "那么，附近应当会有「黑钱领主」的眼哨留下的痕迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990428
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990428,
					"content": "太…太复杂了，完全跟不上你们的思路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990429,
					"content": "总之，拿着这部<color=#00E1FFFF>「综像勘录仪」</color>，调查并记录附近的情况吧，细心寻找线索，必定不会空手而归。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990416,
					"content": "这里十分适合反侦察？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990417,
					"content": "要避开危险的路线运输赃物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990419,
					"content": "其实不太明白这里的特别之处…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990420
					]
				},
				{
					"id": 401990420,
					"content": "可以大胆猜猜看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990421,
						401990422,
						401990423
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990421,
					"content": "观察千岩军，自己躲起来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990424,
					"content": "你看，你的直觉非常准嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990422,
					"content": "在这里放哨，取得主动权?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990423,
