			"dialogs": [
				{
					"id": 401990601,
					"content": "收获还不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990602
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990602,
					"content": "一柄钥匙，应当可以打开某扇关键的门；鸽子传信筒中，则有着许多暗语写成的短讯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990603
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990603,
					"content": "噫…真的在这里藏着一些作案工具…那帮家伙未免也太大胆了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990604,
					"content": "不怕观察千岩军的时候，被千岩军发现，抓起来好好调查吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990605,
					"content": "这些器物表明，「黑钱领主」的眼哨有很大概率伪装成了渔民，他们的心理素质足够死硬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990606
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990606,
					"content": "如果眼哨坚持宣称，自己只是找了个清静的地方歇脚，没有关键证据，千岩军也不可能扣押一个平民，对其深入调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990607
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990607,
					"content": "呃…我都能想象出那人死皮赖脸的模样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990608,
						401990609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990608,
					"content": "好在，我们找到了这些东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				},
				{
					"id": 401990610,
					"content": "藏匿器物的痕迹还很新，说明部署在这里的眼哨另有一人并未被埃德勒抓捕，还在活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990611
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990611,
					"content": "我们需要警惕，不能让对方意识到，我们还在追踪调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990612
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990612,
					"content": "夜兰显然有备而来，取出一套精巧的工具组，首先原样复刻了那柄钥匙，随后针对性记录了传信筒中的暗语片段…\\n随后，夜兰将现场恢复成了原状，完全看不出有过调查的痕迹。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990613
					]
				},
				{
					"id": 401990613,
					"content": "好了，既然我的猜想得到了验证，黑钱领主确实在这里安插了眼哨，那么，藏匿货物的据点会在哪呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990614
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990614,
					"content": "#你怎么看，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990615,
						401990618
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990615,
					"content": "好像有点思路了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990616,
						401990617
					]
				},
				{
					"id": 401990616,
					"content": "监视行动的时间很敏感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990621,
					"content": "完美的直觉，之后似乎不用对你进行过多的暗示了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990622
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990622,
					"content": "以信鸽的速度，在较短时间内能够飞行的距离，画一个敏感圈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990623
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990623,
					"content": "再避开灯塔的视野，与人多眼杂的道路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990624
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990624,
					"content": "推算出来的位置是…暝垣山北边的浅滩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401990625,
					"content": "这样看来，是一片相当可疑的区域，充分利用了山体的掩护，还有着俗语中「灯下黑」的便捷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990626
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990626,
					"content": "下一站的目的地很明确了，我们动身吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜兰"
				},
				{
					"id": 401990617,
					"content": "传信要快捷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990618,
					"content": "没什么头绪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990619,
						401990620
					]
				},
				{
					"id": 401990619,
					"content": "但既然要传递紧要信息…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990620,
					"content": "总要考虑信鸽的飞行时间？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990609,
					"content": "利用这些线索，能推进调查。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				}
			]
