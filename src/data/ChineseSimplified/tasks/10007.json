			"dialogs": [
				{
					"id": 100070701,
					"content": "#好了，到此为止。真是一场优美的合奏，多谢啦，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070702,
					"content": "你刚才使出的力量…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "不用担心，刚才你所看见的力量，纯粹出自我自身，并非来自外人，也没有借助任何外物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070704,
					"content": "要打个比方的话，就像是…给一架乐器调了调音，让它能够演奏出更动听的乐曲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070705,
					"content": "哇，你果然藏着一手！等一下，你不会还藏着更多手吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070706,
					"content": "唉，小派蒙，我真的只有两只手，不信你看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070707,
					"content": "卖！唱！的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070708,
					"content": "哈哈哈哈哈，今天的风也许会很大，我们还是赶紧回蒙德城，提醒大家收收衣服吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 1000710,
