			"dialogs": [
				{
					"id": 100070401,
					"content": "这座岛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "有什么特别的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "这座岛屿本身并无特殊之处，它和大部分岛屿一样，都只是普通砂石的聚合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070404,
					"content": "直到，风带来了故事的种子，时间使它在这座岛上生根发芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070405,
					"content": "尔后，风带来了新的故事，时间使它在这座岛外成为神话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070406,
					"content": "#{NICKNAME}，欢迎你「真正」登上这座被「时间」所青睐的小岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070407,
					"content": "在久远的过去，时与风曾在此交汇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070408,
					"content": "等一下等一下，卖唱的…你突然好严肃，说的话也好难懂喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070409,
					"content": "哎呀，别急嘛小派蒙，一篇好故事的开头总是要起点高调，留点悬念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
