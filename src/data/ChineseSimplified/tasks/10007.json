				]
			},
			"dialogs": [
				{
					"id": 100070101,
					"content": "…那么我就当做您默认了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070102,
					"content": "温迪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "#哎呀，{NICKNAME}，你终于来了，是有人捎给我口信么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070104,
					"content": "口信？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "「并没有从那本辞典里看见任何有关于你的预言。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070107,
					"content": "对么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070108,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "#哎呀？{NICKNAME}，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070111,
					"content": "嗯…看来芭比洛斯女士的求知欲还是这么强。可惜，我的「未来」恐怕无法记载进她的辞典里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070112,
					"content": "毕竟，风虽然乐意被蒲公英描出形状，再任由诗人颂唱，但却并不愿真正地居留于某人之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070113,
					"content": "所以，尊敬的芭比洛斯女士，请你放下手中的笔吧。风中所传诵的那些辞藻，并不适合直接落笔成文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070114,
					"content": "如果您真的对这一则神话感兴趣，那容我对这篇诗文做些润色，待到下次茶会时，再为各位女士吟诵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070115,
					"content": "芭比洛斯？她…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "哈哈哈，芭比洛斯女士向来通情达理，看来她已经听到了我的请求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070117,
					"content": "现在，不会有人打扰我们的谈话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070118,
					"content": "刚才芭比洛斯小姐在偷听？可，可我们什么也没发现呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070119,
					"content": "毕竟是魔女会的一员嘛，芭比洛斯小姐可是很厉害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070120,
					"content": "可是你一下子就发现了，还把她请走了。卖唱的，那你不是比芭比洛斯小姐还厉害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070121,
					"content": "嗯…考虑到各种现实因素，我应该也只能算是厉害得有限吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070122,
					"content": "又是这副神神秘秘的样子。先说好喔，我们在魔女的那本辞典里，根本没发现和你有关的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070123,
					"content": "她只是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "这就足够了。不得不说，芭比洛斯女士对我的「预言」虽然并不完整，但也谈不上「错误」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070126,
					"content": "#我所要做的那件事，确实需要{NICKNAME}的协助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070127,
					"content": "有什么事尽管说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "喔，真是可靠，那么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070130,
					"content": "#{NICKNAME}，稍后可以和我一起弹奏一首曲子么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070131,
					"content": "欸？可以是可以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "是的，仅此而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070134,
					"content": "放心，这次的共奏邀请并不是出于命运的重压，或者是什么遥远的因果…而纯粹是出于我们之间的友谊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070135,
					"content": "上次我亲手弹这首曲子时，唯一的听众是呼啸的狂风，它们把曲声席卷而去，只留下了零星的尾声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070136,
					"content": "如今，既然我已经有了你这位友人，那又何必只让风独坐观众席呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070137,
					"content": "再说了，有你这位朋友在身边，我弹奏乐器的手，或许会更平稳一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070138,
					"content": "我会认真弹的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "好，那么我们先去演奏场吧。我们跟着风走，马上就能到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 100070132,
					"content": "但你只需要我做这件事么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "让我来这里等待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "但魔女依然要我来找你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "但我其实…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
