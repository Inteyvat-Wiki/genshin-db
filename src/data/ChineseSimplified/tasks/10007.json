			"dialogs": [
				{
					"id": 100071001,
					"content": "在之前，我曾为蒙德鼓起了最初的自由之风。在那股风的协力下，所有应得自由之人，都重获自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 1000711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
