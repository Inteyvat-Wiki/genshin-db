					"content": "准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071302
					]
				},
				{
					"id": 100071302,
					"content": "嗯。那我们就开始合奏吧。",
					"roleType": "TALK_ROLE_NPC",
