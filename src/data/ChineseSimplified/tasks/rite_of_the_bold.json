			"dialogs": [
				{
					"id": 750190701,
					"content": "赢了，好耶！了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190702,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "哈…即使是现在部族里最强的战士，恐怕也打不赢你吧…这次还真是输得心服口服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190704,
					"content": "被一只小家伙打败的感觉怎么样，老兄，看来我们还要多多锻炼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190705,
					"content": "呼呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "乌丘"
				},
				{
					"id": 750190706,
					"content": "真是见证了一场精彩的决斗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190707,
					"content": "曼科老兄啊，你这家伙总是在旁边说这种漂亮话，很没意思的。怎么样，要不要你也下来打一场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190708,
					"content": "不，我就对此敬谢不敏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190709,
					"content": "#嗐。无聊的家伙。啊，真是一场爽快的战斗，你…{NICKNAME}，你的实力不是盖的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190710,
					"content": "我还没热身呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "哈哈哈，真是嚣张的家伙，不过，我很欣赏这种态度。强者就应该飞扬跋扈一点，不然变强又有什么意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190714,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#哈哈，{REALNAME[ID(2)|SHOWHOST(true)]}，看得出来你有被他们好好照顾着呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190716,
					"content": "#那是当然了，{REALNAME[ID(2)|SHOWHOST(true)]}可是我们的了不起的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190717,
					"content": "既然如此，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190718,
					"content": "好了，说好的，部族首领的证明你们就拿去吧，就是这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190719,
					"content": "学名叫什么来着，曼科老兄，这可是你该发言的时候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190720,
					"content": "瓦萨克拉胡巴肯的护符…「盗火贤者」的护符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190721,
					"content": "嗯，这个名字我始终记不住，不过我记得，是在火龙王死去，而最初的火之神从烈焰中苏生之后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190722,
					"content": "「盗火贤者」与最初的火神，各自从火山中带走了一枚信物。取得两枚信物之人，就能进入火山内的净火，除却一切诅咒与灾厄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190723,
					"content": "不过，这个「盗火贤者」到底活了多久啊，曼科老兄，感觉从「部落」时代到奥奇卡纳塔那会儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190724,
					"content": "就连「缝影针」那里都有他的传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190725,
					"content": "毕竟是第一个会使用燃素的人类…出现在传说中的人物，不管变成什么样都有可能吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190726,
					"content": "有人说他已经把身体与灵魂都燃素化了，和纳塔的风、大地与花融为了一体，能够倾听部族人向他祈求帮助的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190727,
					"content": "也有人说，其实每个时代都有不同的人继承「盗火贤者」之名，一代一代，甚至传言今日也依然有「盗火贤者」的传承者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190728,
					"content": "不过，恕我直言…其中大部分都是叙事人的臆测罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190729,
					"content": "哈哈，听到你这么说，蒂图兄弟又得生气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190730,
					"content": "好了，我该做的已经做完了…哦不对，按照传统和惯例还得有这样的一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190731,
					"content": "那就是为踏上旅程的勇者，和他的伙伴献上祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190732,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "哦哦，居然还有这样的仪式吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190734,
					"content": "其实就是一些便宜讨彩头的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190735,
					"content": "#那么，{NICKNAME}和{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190736,
					"content": "嗯，我在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "祝你们能够像翎翅最硬的鸟儿那样飞过一切山巅；\\n祝你们能够像最坚强的顽石那样抵挡恶浪的奔流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190739,
					"content": "祝你们不畏艰险，因为世上注定有诸多艰险。\\n祝你们不忘彼此，因为命运之中终有离别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190740,
					"content": "祝你们能到达想要到达之处，能够得偿所愿…然后，最重要的一点，也是我最希望的一点，祝你们能够平安归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190741,
					"content": "我会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "啊，那我呢，我就没有祝福吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190744,
					"content": "对哦，小派蒙…那就祝小派蒙吃好喝好，睡觉饱饱，健康长大吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190745,
					"content": "也不错呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "哼，那我就勉强接受这份祝福吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190749,
					"content": "好，那见证人的仪式就结束了，在你们出发之前，我还是得说：一定要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190750,
					"content": "嗯，我们知道啦，再见，帕加尔…还有乌丘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190751,
					"content": "呜嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "乌丘"
				},
				{
					"id": 750190753,
					"content": "再见，祝你们一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕加尔"
				},
				{
					"id": 750190746,
					"content": "派蒙还能长大吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "当然能，等到以后，我一定要长成「三座山大小」的派蒙给你看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750190712,
					"content": "你也不赖！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "这种可怜人的夸奖就免了吧，不过要是我再年轻一点…谁胜谁负还不知道呢，真可惜，如果年轻时能和你打一场就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "帕加尔"
				}
			]
		},
