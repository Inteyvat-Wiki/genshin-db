			"dialogs": [
				{
					"id": 750190601,
					"content": "#恕我直言…虽然我明白{NICKNAME}的实力，但是还请注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190602,
					"content": "虽然没能够获得「古名」，不过帕加尔的实力也是不容小觑的…如果他这几年没有荒废锻炼的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750190603,
					"content": "如果准备好与他的战斗的话，那就开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曼科"
				}
			]
