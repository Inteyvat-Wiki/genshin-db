			"dialogs": [
				{
					"id": 710970101,
					"content": "请问两位找到「老石」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970102,
					"content": "在这里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐宁",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "算上这次的，一共是九枚「老石」，这下应该够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970202,
					"content": "这么快就满足了辉山厅的需求…真不愧是你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970203,
					"content": "只不过是巨兽之劳啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970204,
					"content": "是「举手之劳」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "哇！我是说…嗯…这种东西和打倒巨兽一样，都是小意思而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970206,
					"content": "派蒙学会强词夺理了，可喜可贺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "哈哈…派蒙说的没错啦，两位力搏海魔的功绩，我们都看在眼里的。相信此等壮举对你们来说确实并不困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970208,
					"content": "确实如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "说来，没想到进了总务司，还要负责「在层岩巨渊找老石」这种工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970211,
					"content": "对哦，你那个时候不是还天天和自己父亲吵架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970212,
					"content": "怎么后来去了总务司的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970213,
					"content": "之前我不是欠了一大笔钱，走投无路，更不愿回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970214,
					"content": "结果讨债的人直接去盛露厅找上了我爸…我听到这件事时心想，我爸非得把我腿打断不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970215,
					"content": "可是你的腿看上去还挺完整的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970216,
					"content": "是…说来惭愧，我爸帮我把钱还了，在街上找到了落魄的我，说，「你所有欠条都在我手里，所以现在你欠我钱了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970217,
					"content": "以此要挟我找工作…以偿还欠款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970218,
					"content": "原来你现在欠的是你爸的钱啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970219,
					"content": "是这样没错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970220,
					"content": "当然，那个时候我每日逃债，惶惶不可终日，早就决定，如果有机会就一定洗心革面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970221,
					"content": "但是我没想到这个机会竟然是那个时常跟我吵架的老爸给我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970222,
					"content": "我爸也破天荒没有和我吵架，反而开诚布公地谈了谈，这种谈话要是能早些开始就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970223,
					"content": "不过就算之前他有心跟我谈，那个时候我也没心情听吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970224,
					"content": "看来你家老爷子对你还蛮好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970225,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970226,
					"content": "所以无论如何，都得做好手上的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970227,
					"content": "无论是这次层岩巨渊的事，还是帮辉山厅打杂找「老石」的活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970228,
					"content": "这次活明明是我帮你做的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "找人帮忙完成工作，也是完成工作的一种方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970230,
					"content": "不过这次也真是多亏了二位，能这么快完成这件工作，出乎了我的意料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710970231,
					"content": "知道就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970209,
					"content": "要说困难还是有一点啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}