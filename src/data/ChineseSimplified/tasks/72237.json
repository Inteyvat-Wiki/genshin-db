			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安贞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "你们是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370302,
					"content": "你就是安贞吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722370303,
					"content": "没错，是我。我感觉…有点奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370304,
					"content": "我记得我一直在追那群家伙，然后拔下来了一个核心丢在营地里。之后我因为自己也受伤挺重的，有点发困。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370305,
					"content": "现在醒来看到你们，我觉得还挺精神的。我是不是快死了回光返照了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370306,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "先不说这些了。你们是来捉拿我回去的吗？我已经证明了自己的清白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370308,
					"content": "是坎瑞亚的家伙，他们偷走了图书馆的书。我虽然是接待他们的保镖卫士，但我绝无可能和他们沆瀣一气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370309,
					"content": "我在这边追查到了使团的踪迹，打倒了他们所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370310,
					"content": "我为了停下他们的机关巨物，和它周旋了很久。最后我扯下了它的核心。但是我也因此受了重伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370311,
					"content": "失去动力的机器压在了丢失的书上面。我已经没办法把它取出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370312,
					"content": "白夜国的地走官可真厉害啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722370313,
					"content": "你们不是地走官或者候补吗？唉，无所谓了。最早地走官都是对抗深海龙蜥的勇士，后来才变成执法人员、幽冥判官的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "安贞"
				},
				{
					"id": 722370314,
					"content": "核心就在营地里。你们不信我的话，可以拿着核心去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安贞"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
