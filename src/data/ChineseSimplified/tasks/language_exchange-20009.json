			"dialogs": [
				{
					"id": 200090301,
					"content": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090302
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200090302,
					"content": "Dala beru yo?! Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090303
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200090303,
					"content": "Kundala gusha! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090304
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200090304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090305
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200090305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090306
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200090306,
					"content": "看来他听懂我说的话了，正在准备拿礼物给我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090307
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200090307,
					"content": "是，是武器！呜呜呜呜呜，旅行者！救救我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
