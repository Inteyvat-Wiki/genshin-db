			"dialogs": [
				{
					"id": 200090701,
					"content": "怎么样？我的丘丘人口语很不错吧？只要语言能够相通，那么互相理解也只是时间问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090702
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200090702,
					"content": "我是这么希望的…我的梦想，是和丘丘人们做朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
