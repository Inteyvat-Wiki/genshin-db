				},
				{
					"id": 200090402,
					"content": "我觉得我没说错什么地方呀，到底是哪里的发音出问题了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090403
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200090403,
					"content": "我回去得再好好研究一下…",
