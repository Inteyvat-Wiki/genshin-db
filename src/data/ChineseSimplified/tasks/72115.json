			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "您放好信标了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150302,
					"content": "已经放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "多谢您了，就让它们慢慢地搜集数据吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150304,
					"content": "你为什么会知道那些地点？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "这个「御影炉心」我也参与了设计，在那几个点上放置信标，基本上就可以搜集「御影炉心」内大部分区域的数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150306,
					"content": "唉，要是能直接在那几个点上设置净化仪器的话，睡一觉这事就基本上结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150307,
					"content": "现在这个情况…要是弗洛瓦先生知道的话，他非疯了不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150311,
					"content": "好了，谢谢您帮忙，这些东西请先收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150312,
					"content": "咳，那个…过段时间，说不定还得麻烦您把那些信标拿回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150313,
					"content": "毕竟我泽维尔没有「神之眼」，没办法自由进出「祟神」能量如此浓厚的区域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150314,
