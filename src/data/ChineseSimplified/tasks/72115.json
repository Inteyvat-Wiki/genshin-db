			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"泽维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}，真是幸会！关于「御影炉心」，我有一个好消息和一个坏消息，您想先听哪一个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150102,
					"content": "好消息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "好消息是，炉心的损毁似乎并不严重，还在我可以处理的范围内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150104,
					"content": "但坏消息是，正在里面折腾的那群愚人众并不太乐意接受这个好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150105,
					"content": "他们似乎还在不断寻找染指「祟神」核心的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150111,
					"content": "再让他们这么折腾下去，「祟神」的力量迟早会真的失去控制，然后把这座岛，还有岛上的我们一起炸上天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150112,
					"content": "但如果我们只把注意力放在愚人众这边，那护罩中积累的「祟神」，迟早也会抵达临界点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150113,
					"content": "所以，我们要同时对付两边？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "嗯…通俗地来说，从学术的观点，客观地来讲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150115,
					"content": "现在的情况就是，我们面前摆着愚人众和「祟神」两个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150116,
					"content": "但鉴于「御影炉心」里的现状，假如我们想要解决其中某一个问题，那在实践过程中，我们大概率也必须面对另一个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150117,
					"content": "所以，我们面对的现实情况就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150118,
					"content": "你是说「没错」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "呃，是的，没错。我们就是要同时对付两边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150120,
					"content": "但我们还是一步步来吧，璃月人不是常说「心急吃不了热豆腐」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150121,
					"content": "你还知道璃月谚语？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "之前我们也去过璃月，这是一点旅途的小纪念品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150123,
					"content": "这样的纪念品我还有很多，但蒙德的纪念品我已经喝干净了…味道非常不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150124,
					"content": "好了，我们还是说正事吧。为了搞定这个「御影炉心」，我有一个小计划，想要请您帮帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150125,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "啊哈！我就是喜欢您这样…直爽的性格，太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150131,
					"content": "咳，我们说回正题。这些「侦测信标」请拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150132,
					"content": "我想拜托您，把这些「侦测信标」放在几个位置上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150133,
					"content": "这些信标能搜集「御影炉心」内「祟神」力量的浓度与分布数据，只要有这些数据，我就能制订更详细的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150134,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "那就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150141,
					"content": "我把那些放置点给您标记在地图上，就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150136,
					"content": "这信标到底是什么原理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "简单来说…就是一种基于元素力原理，对于各类能量进行量化测算的仪器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150138,
					"content": "「简单来说」…虽然我想这么说，但它的运作也没办法简单地讲明白。对了，就从七大元素说起吧！是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150139,
					"content": "不、不用说了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "好吧，如您所愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150127,
					"content": "我能得到什么好处？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "好处嘛…当然是这座岛上那些还没被发现的宝藏，和「御影炉心」里的一些「边角料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150129,
					"content": "您瞧，作为稻妻最大的冶炼设施，「御影炉心」里肯定还有些…嗯…值得一看的好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150130,
					"content": "当然！作为一个没有「神之眼」的人，我现在可没办法进入「御影炉心」，那里面的情况，我也无从知晓啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150106,
					"content": "坏消息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "坏消息是，那群愚人众还在「御影炉心」内部折腾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150108,
					"content": "他们似乎还在不断寻找染指「祟神」核心的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150109,
					"content": "虽然好消息是，现在炉心的损毁似乎并不严重，还在我可以处理的范围内…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721150110,
					"content": "但很明显，愚人众并不太乐意接受这个好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "泽维尔"
				}
			]
		},
