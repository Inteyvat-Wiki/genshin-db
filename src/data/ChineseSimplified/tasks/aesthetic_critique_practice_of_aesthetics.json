				"objectNames": [
					"布希柯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "你好，想要买什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 240100202,
					"content": "关于德皮耶里的颜料…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "噢，你是替他来拿颜料的吗？我已经准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 240100204,
					"content": "这家伙的颜料也用得太快了，简直就像是把颜料买了之后直接倒进水里似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 240100205,
					"content": "好了，他买的颜料都在这里了，你带给他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布希柯"
				}
			]
		},
