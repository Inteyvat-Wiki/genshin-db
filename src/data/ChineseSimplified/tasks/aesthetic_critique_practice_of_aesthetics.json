			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "这个想法倒是不错，但是…真能这么做吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100102,
					"content": "你画得怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "哎呀，是您啊。多谢您之前帮我留影，那些画片上的景物给了我很大启发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100104,
					"content": "我已经有了一个大概的构想，也画了一些草稿，但…怎么说呢，都不尽人意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100105,
					"content": "您别误会，我也不是说自己画出了几幅毫无美感的垃圾，就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100106,
					"content": "那些画都少了一些能让它们区别于普通绘画的「特别之处」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100107,
					"content": "而且我构思的画面都太过具象，如果就这么画出来，我想要传达出的美感一定会受到折损。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100108,
					"content": "唉，但这是每一个画家都在烦恼的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100109,
					"content": "试试画点别的东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "感谢您的建议。但这问题并不是换个题材就能解决的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100111,
					"content": "无论是画山水景物，鸟兽鱼虫，还是坊间人世，这个问题都始终存在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100112,
					"content": "为了解决这个问题，我一些同行将这些具象的景物按照自己内心的情绪进行拆解和变形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100113,
					"content": "这样的绘画最想强调的是自己内心的感情，在他们的画布上…怎么和您说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100114,
					"content": "对！在他们的画布上，无论是人物还是景物，甚至连光线都带着一股怪诞感，并不带有任何传统的美感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100115,
					"content": "如果只是粗看画面，大部分人要么认为绘出这幅画的人是个根本不懂绘画的粗野之人，要么认为这画家疯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100116,
					"content": "但只要您沉下心，用心和灵性去倾听画面，一定能听见那幅画在替画家发出咆哮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100117,
					"content": "那咆哮发自画家心灵，倾诉着他的各种情感…而且这些情感大部分都比较激烈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100118,
					"content": "这声音并不能用耳朵听到，必须得用心灵来探求才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100124,
					"content": "而我嘛…我还是不想放弃具象的景物，所以我想出了另外一种方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100125,
					"content": "我决定把重点放在色彩上，我要找到更浓烈的色彩感，更简练有力的笔触。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100126,
					"content": "同时必须得弱化光影和传统意义上的景物塑型…这些东西会影响我的表达，我得请它们暂时从画面上离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100127,
					"content": "但问题是…为了做出浓烈的色彩感，我就需要用很多颜料，必要的时候，我还得把颜料直接挤在画布上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100128,
					"content": "于是…我的颜料…现在已经全用光了。但我现在又绝不能搬着画架离开，这样一定会影响我的创作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100129,
					"content": "旅行者，能请您帮我去城里找一趟布希柯吗？我求他帮忙买了一批好颜料，现在应该已经准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100130,
					"content": "或者…您也可以帮我去找点骗骗花的花蜜来，这样我就可以自己调制一批颜料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100131,
					"content": "花蜜也能做颜料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "哈哈哈，当然能。我的一些同行还用鸟蛋来做颜料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100133,
					"content": "据说这样做出来的颜料色彩细腻，有着丰富的层次感，用来画辉煌盛大的场景再合适不过啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100136,
					"content": "您是个好心肠的人，应该不会拒绝一位艺术家的请求吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100137,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "好！那就拜托您了，我就在这里等着，您拿到东西之后，直接拿回来给我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100138,
					"content": "受不了你…交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "你自己还会做颜料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "哈哈哈，当然了。做画家的第一门学问，就是要自己学会调制颜料，这样才能更好地掌控画面啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100119,
					"content": "试试换个别的画法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "您说得很不错。我的一些同行也这么想，所以他们正在尝试在画布上用一些「非具象」手段表达一些「抽象化」的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100121,
					"content": "其中最激进的一些甚至想要放弃描述具体的某物，而是用单纯的色块来表达画面…他们把自己叫做「新描述主义」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100122,
					"content": "但我不得不说，就连我也看不太懂他们的作品，最多也就是能感受到那些色块和线条之中所蕴含的节奏美感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100123,
					"content": "至于这幅画到底想要表达什么…我也只能请那位画家为我讲讲啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "德皮耶里"
				}
			]
		},
		{
