			"dialogs": [
				{
					"id": 240100301,
					"content": "不能被具象的形体影响…必须得把美感抽离出来，再用象征性的手法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100302,
					"content": "不对，不对…还是不对，这里的塑型太刻意了…",
