			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"「吉法师」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "拍得真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610202,
					"content": "呶哈哈，吉法师帅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610203,
					"content": "这孩子，一点也不谦虚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610204,
					"content": "对了，派蒙。仙人有什么法术？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610205,
					"content": "仙人的力量很强的！不过要具体举例的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610206,
					"content": "这周边的琥珀吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "琥珀，那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610208,
					"content": "嗯！我记得是说，理水叠山真君有能生出琥珀的花，把入侵的坏东西都困在里面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610209,
					"content": "理理真好厉害。守护璃月，所以把坏东西困住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610210,
					"content": "好久好久以前，有很坏很坏的绪方四鬼，闯到森林里到处打打。欺负狸子。五百藏变成公家大人的样子，给他们吃妖狸饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610211,
					"content": "后来，和御伽大王一起，把他们丢到画纸里，封印了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610212,
					"content": "还有这样的故事啊。难怪五百藏看到吉法师相片的时候，吓得不轻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610213,
					"content": "五百藏不是仙人，不保护璃月。但五百藏保护森林，保护狸子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610214,
					"content": "不同的人，要保护不同的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610216,
					"content": "吉法师长大以后就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "所以，吉法师要努力修行，变成了不起的大妖狸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610218,
					"content": "呶！当然了。名震天下的妖狸吉法师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610219,
					"content": "很好奇五百藏没被封印的时候的样子呢！感觉应该很好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610220,
					"content": "啊，突然想起，之前也有盗宝团的人被琥珀定身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610221,
					"content": "我们还被当成了「仙使」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "感觉是好久以前发生的事情了呢…但好像，也没有过多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610223,
					"content": "呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610224,
					"content": "咳咳。我们来到璃月之后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610225,
					"content": "#「是一年一度的请仙典仪耶。哇哈哈，我{NICKNAME}应该可以吃好多好多好吃的。派蒙，我们走！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610226,
					"content": "「还有贡品！我派蒙马上飞过去！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610228,
					"content": "别乱说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "好啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610230,
					"content": "以比较简单的语言讲述了一些在璃月的冒险经历，\\n一直讲到在珉林绝云地方寻访众仙为止。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#…接下来的事情，就是我和{NICKNAME}，一起去之前那个「琉璃亭」吃饭啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610232,
					"content": "理理真好厉害，留留真也好厉害！还能做出会动的房子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610233,
					"content": "留留真…呸，留云借风真君好像也很喜欢美食呢！当时，做了好多菜才见到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610234,
					"content": "好贪吃哦，像派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610235,
					"content": "这点确实像派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610238,
					"content": "派蒙是仙人？派蒙好厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610239,
					"content": "呜哇，心情好复杂。虽然被吉法师夸了，但感觉又很不是滋味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610240,
					"content": "不过，派蒙不是仙人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610241,
					"content": "想和仙人玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
