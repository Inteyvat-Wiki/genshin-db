			"dialogs": [
				{
					"id": 722610101,
					"content": "喂——理水叠山真君——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610102,
					"content": "喂——理理真——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610104,
					"content": "伤脑筋，仙人好像不在哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610105,
					"content": "对仙人不能无礼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "派蒙，仙人是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610107,
					"content": "嗯…应该说是很特别的人，或者是动物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610108,
					"content": "就像吉法师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610109,
					"content": "不对不对！应该说，有神奇的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610110,
					"content": "也会砰砰？那，吉法师也是仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610111,
					"content": "唔…仙人，是更加古老、更有威严的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610112,
					"content": "知道了，吉法师不是仙人。五百藏是仙人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610113,
					"content": "呜哇，要怎么解释…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610114,
					"content": "仙人是守护璃月的古老存在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "吉法师知道了。五百藏守护的是镇守之森，所以不是仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610116,
					"content": "虽然道理不是这么一回事，不过能撇清误会就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610117,
					"content": "不过难得眼前有仙府，就在这里给吉法师拍照吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722610118,
					"content": "呶！吉法师乖乖站好拍照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610119,
					"content": "吉法师乖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
