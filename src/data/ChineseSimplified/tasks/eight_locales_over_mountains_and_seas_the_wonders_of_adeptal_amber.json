					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722610417,
					"content": "吉法师想帮助五百藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
