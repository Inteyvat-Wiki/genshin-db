			"dialogs": [
				{
					"id": 726680101,
					"content": "真好啊，曾经追寻「海中月」的大家，也都算是完成了自己的心愿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680102,
					"content": "都完成了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "你看你看，嘉玮是不是找到了一个十分富有的妻子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680104,
					"content": "楠塔克也因为那本揭秘「海中月」的书成了小有名气的作家了呢，虽然内容是错的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680105,
					"content": "鲸井椛更是稻妻最厉害的渔王了，而且今天还捕捉到了父亲都没有成功的「海中月」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680106,
					"content": "#所以我觉得啊，{NICKNAME}的愿望，也一定会实现！嘿嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680107,
					"content": "小派蒙刚刚许下的愿望是什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "不能说不能说，说出来就不灵了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680109,
					"content": "「海中月」不会这么小气的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "嗯——那好吧，听清楚哦，我就说一遍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680111,
					"content": "我的愿望就是实现你的愿望哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726680112,
					"content": "声音太小了，你说什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "哼哼，就说一遍，没听清就算了！我要买糖果去啰~啦啦啦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
