			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "有什么事吗？这位年轻人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110102,
					"content": "我们找到证据了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "「证据」？什么证据，属实不知所谓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110104,
					"content": "关于村里的怪事，爷爷不要狡辩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110105,
					"content": "笑话，我们村哪能有什么怪事。好啊，有什么证据就拿出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110106,
					"content": "#（喂，{NICKNAME}，就从井边找到的东西开始吧。交给你啦！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110107,
					"content": "这是从后院枯井捡到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
