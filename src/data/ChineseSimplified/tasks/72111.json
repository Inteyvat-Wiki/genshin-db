			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"绀田传助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "这是…这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110702,
					"content": "居然疏忽了，破坏货车的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110703,
					"content": "哇，承认了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110704,
					"content": "没办法了，你都调查到这个份上了，我再瞒也瞒不下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110705,
					"content": "事情你差不多也清楚了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110706,
					"content": "非常清楚了！传助爷爷，你竟然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110707,
					"content": "抢劫了官府的镖车。在争抢中，你一拳把货车打碎，结果货物袋飞走了，掉进了水渠里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110708,
					"content": "幕府的人为了保住性命，把钱袋往水井里丢，吸引你的注意力！为了防止钱被人捡走，你把井口锁起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110709,
					"content": "是这样对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110710,
					"content": "啊？不对，不是这样的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110711,
					"content": "居然不是吗！我还想跟你拿来钥匙，去把井底的摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110712,
					"content": "…交还给幕府的大人们！没错！当然是还给官府！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110713,
					"content": "唉，事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110714,
					"content": "村里本来有一群年轻人，酒后胆子大，竟然劫了幕府的运车。这货物和袋子，都是幕府的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110715,
					"content": "我想着村丑不可外扬，才出力帮他们隐瞒下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110716,
					"content": "那承认自己私吞钱袋的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110717,
					"content": "是为了隐瞒事情的真相吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "没错。本来我寻思，只要我这么做，你们就会不追究下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110719,
					"content": "如果只有我一个人的话…只要不波及别人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110720,
					"content": "拜托了，请你不要向幕府告发。这不是我面子的问题。我是怕我们整个村子，都会因此受到牵连。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110721,
					"content": "我没有告发的兴趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "是呀，我们不是为了这件事来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110723,
					"content": "那就好，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110727,
					"content": "因为做这样的事情，让我良心实在不安，所以我把事情记下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110728,
					"content": "笔记我扔房顶上了。如果你真想读，就自己去找吧，年轻人。不过，可别把我最近才新修的房顶踩坏喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110729,
					"content": "关于井口的锁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "是的，是我把井口锁上了。藏钥匙的地方，我也记在笔记里了，自己去看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110731,
					"content": "关于绀田村的「结界」，传助爷爷知道什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110732,
					"content": "「结界」？哎呀，这么久远的传说，现在还有人知道吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110733,
					"content": "据说在古时，我们脚下的地底有雷樱的根，是守护鸣神岛平安的五段树根之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110734,
					"content": "而守护它与它的结界，就是「狐斋宫大人」交给我们绀田一族的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110735,
					"content": "但这事已经太久远了，详情我已经不清楚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110724,
					"content": "我只是想调查真相…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "是呀，我们不是为了这件事来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110726,
					"content": "调查真相？呵呵…现在的年轻人，倒也挺有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "绀田传助"
				}
			]
		},
