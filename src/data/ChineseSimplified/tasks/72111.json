					"绀田传助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "装摩拉的袋子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110202,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110203,
					"content": "…这就是我们家的东西。没有什么可疑的。没错，很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110204,
					"content": "好可疑！绝对有问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110205,
					"content": "请你画出上面的标记。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110211,
					"content": "好吧。这的确不是我的钱袋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110212,
					"content": "我家后院人来人往的，有谁落下了什么东西也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110213,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110214,
					"content": "这是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "唉！还是你们机灵，本来我鬼迷心窍，想私吞你们手里的钱袋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110216,
					"content": "一把年纪了，传助啊传助，怎么能动这种歪脑筋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110217,
					"content": "不对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "我、我都承认自己想私吞这笔钱了，还能有什么问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110220,
					"content": "我这就把钱袋交给官府。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110221,
					"content": "感觉不太对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110222,
					"content": "钱袋是被人刻意遗弃的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "你、你这样说，可有什么证据吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110228,
					"content": "钱袋只是其中的一部分。我们还找到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110229,
					"content": "#…找到了什么来着？唔嗯，交给你了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110230,
					"content": "#（{NICKNAME}，我们之前在水渠里发现了什么来着…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110231,
					"content": "这就是想趁着雨夜丢掉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "没什么，是派蒙想多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#（不对吧！{NICKNAME}，传助爷爷真的只是想要这笔摩拉吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110225,
					"content": "（他是在隐瞒什么别的事情吧？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721110226,
					"content": "钱袋是被人刻意遗弃的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "你在隐瞒别的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "请你说出里面的摩拉数量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "哈哈哈，你这叫什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110208,
					"content": "不打开行囊确认，你也不知道现在自己的包里有多少摩拉吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110209,
					"content": "请你画出上面的标记。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
