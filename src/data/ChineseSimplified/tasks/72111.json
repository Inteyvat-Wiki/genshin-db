			"dialogs": [
				{
					"id": 721110501,
					"content": "这是什么？我可看不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110502
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110502,
					"content": "年轻人，不要随便拿些东西，就来糊弄我这个老头子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110503
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 721110503,
					"content": "这就是想趁着雨夜丢掉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
