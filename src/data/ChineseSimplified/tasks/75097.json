			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "哦哦，这样才正常嘛…那种和七天神像建立稳固联系的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970302,
					"content": "所以之前七天神像不正常，果然是因为夜神之国里有那个坏家伙！看来七天神像之前也很辛苦呢…你很努力了，七天神像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970303,
					"content": "虽然和火元素共鸣的力量也不是你给的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970304,
					"content": "嗯，是和火神共同战斗时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "#是呀，那个时候我可担心了…不过果然还是{NICKNAME}更强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970306,
					"content": "解决了深渊的怪物，七天神像也恢复了正常，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
