					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "嗯？总觉得纳塔的七天神像有些怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970102,
					"content": "摸到第一次摸到的神像，不是应该更强烈一点吗…有「嗡」地一下的那种感觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970103,
					"content": "我觉得还好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "可是真的有点奇怪啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970108,
					"content": "唔，我想想该怎么说，总觉得以前在摸其他神像的时候，能建立更稳固的联系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970109,
					"content": "这次感觉就像是碰到了什么开关一样，你碰一下它才亮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970110,
					"content": "对了，对了，你之前摸到神像，就能感受到元素的力量，这次呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970111,
					"content": "有没有火元素那种，很活泼，很热烈的感觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970112,
					"content": "（仔细感受了身躯之内…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "咦，一点也没有吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970115,
					"content": "总觉得有点奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970113,
					"content": "（没有预想的炽热感…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "其实之前都是我「嗡」的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "原来是这样，是这次忘了「嗡」呀，下次一定得注意了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970107,
					"content": "才不是啦！你最好每次摸七天神像的时候自己都会配声音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
