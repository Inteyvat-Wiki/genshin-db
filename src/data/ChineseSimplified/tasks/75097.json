					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "…嗯，感觉还是很不习惯，你现在还是没有办法从七天神像获得元素力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970202,
					"content": "哎呀，七天神像到底出了什么问题呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970203,
					"content": "可能是年久失修。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "明明摸上去的时候有好好发光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970205,
					"content": "唔，七天神像…你有在好好干活吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970208,
					"content": "感觉一点头绪都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970206,
					"content": "可能是纳塔比较特殊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "这么说来，纳塔好像一直在受到深渊的影响，难道是因为这个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "派蒙"
				}
			]
		},
