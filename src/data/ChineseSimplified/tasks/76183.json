			"dialogs": [
				{
					"id": 761830201,
					"content": "这样偶尔的放松很有必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 761830202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761830204,
					"content": "好，我们至冬见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 761830203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "「木偶」"
				}
