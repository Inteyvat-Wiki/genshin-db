			"dialogs": [
				{
					"id": 200190101,
					"content": "旅行者，你，你来的正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190102
					],
					"speakerTitle": "怀尔德"
				},
				{
					"id": 200190102,
					"content": "我本来是要把这车货送去蒙德城。昨天晚上走到这里的时候，看见了几团亮亮的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190103
					],
					"speakerTitle": "怀尔德"
				},
				{
					"id": 200190103,
					"content": "因为喝的太多，我…我突然很想去看看那是什么，过去了之后，却发现是一大堆史莱姆，我还被狠狠撞了几下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190104
					],
					"speakerTitle": "怀尔德"
				},
				{
					"id": 200190104,
					"content": "我很害怕，但是又找不到方向，跑了半天才回到了车旁边。今天早上，我发现我的<color=#00E1FFFF>钥匙</color>不见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190105
					],
					"speakerTitle": "怀尔德"
				},
				{
					"id": 200190105,
					"content": "你能帮我找找吗？肯定就在这周围，我觉得…肯定就在旁边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190106,
						200190108
					],
					"speakerTitle": "怀尔德"
				},
				{
					"id": 200190106,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190107
					]
				},
				{
					"id": 200190107,
					"content": "太好了，这么大片地方，我都不知道从何下手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "怀尔德"
				},
				{
					"id": 200190108,
					"content": "还有别的急事",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190109
					]
				},
				{
					"id": 200190109,
					"content": "这么大片地方，我可从哪下手啊，这件事只有你能办到，拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "怀尔德"
				}
			]
		},
