			"dialogs": [
				{
					"id": 745260401,
					"content": "#啊，是{NICKNAME}，你来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260402,
					"content": "妮露，你在练习吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "没有没有。我正在构思一支新的舞蹈，灵感来源于雨后初晴的帕蒂沙兰，花瓣上还挂着露珠的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260405,
					"content": "不过现在还只有雏形，很多动作都还不够优美，总觉得还差了点什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260406,
					"content": "听描述就已经很美了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "为我留影吗？可是，就像我刚才说的，这个舞步我还不是很熟练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260409,
					"content": "舞蹈成型前的练习…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "嗯，我明白了！那我就将心意融入舞步中…请用你的镜头，捕捉花朵绽放的刹那吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260410,
					"content": "也是艺术的一部分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "能让我为你拍张画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "我没有打扰到你吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
