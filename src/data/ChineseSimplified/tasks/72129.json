					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "哦哦，没关系的，请慢慢来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				},
				{
					"id": 721290603,
					"content": "还正在努力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "实在不行的话也请不要勉强，请别在这个危险的地方逗留太久。",
