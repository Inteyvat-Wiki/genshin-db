			"dialogs": [
				{
					"id": 721290201,
					"content": "你注视着镇物，忽然，一股奇特的能量似乎涌向了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "接触镇物"
				},
				{
					"id": 721290202,
					"content": "你意识到它并非抗拒着你，而是向你要求着什么……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "接触镇物"
				},
				{
					"id": 721290203,
					"content": "唔…这座镇物好像少了些什么东西，我们去附近找找看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721290204,
					"content": "使用元素视野调查一下附近弥散的元素痕迹，说不定能发现什么呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
