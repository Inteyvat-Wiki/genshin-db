			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "形状奇特的石灯，似乎放射着令人不安的能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721290102,
					"content": "这个石灯笼好奇怪…让人感觉怪不舒服的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721290103,
					"content": "欸，好像灯柱上写着什么字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721290104,
					"content": "「路过的旅人，关于此镇物如有疑问，请至无想刃狭间，与梶先生商谈。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721290105,
					"content": "字看起来很新，似乎是不久前写下的。下面还有几列被雨水洗濯模糊的小字：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721290106,
					"content": "「…请转告梶先生，我们试过…但可惜…或许在附近能找到…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721290107,
					"content": "「…请梶先生尽快一同来避难地点，他的家人很想他。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721290108,
					"content": "这个梶先生似乎对石灯笼很在意的样子，我们不如去无想刃狭间问问他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
