						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玛达赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000500,
					"content": "以前在璃月…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000501
					]
				},
				{
					"id": 230000501,
					"content": "嗯？璃月吗…我听商队的人说，那里的诸方势力在神明陨落之际明争暗斗，应该会是个不错的题材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000502
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000502,
					"content": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000503
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000503,
					"content": "比如说…「一名旅行者着手操办了送仙典仪，成为各方势力争相拉拢的对象」什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000504,
						230000505
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000504,
					"content": "确实是参与了送仙典仪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				},
				{
					"id": 230000506,
					"content": "#唔，再比如说…「{M#他}{F#她}与漩涡之魔神在海上鏖战，就连那座群玉阁都被凌厉的剑气波及，生生坠入海中！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000507,
						230000508
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000507,
					"content": "确实是跟魔神对峙过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000509,
					"content": "#欸！那这条呢？「最后{M#他}{F#她}凭一己之力调停了仙凡间的矛盾，璃月港就此迎来了新的时代。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000510,
						230000511
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000510,
					"content": "确实是平息了矛盾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000511,
					"content": "是靠璃月人的共同努力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000508,
					"content": "击退魔神的关键是群玉阁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000505,
					"content": "其实都是在和某人跑腿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				}
			]
		},
		{
			"id": 2300006,
			"completionStepIds": [
				2300001
			],
