					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001403
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230001403,
					"content": "…勇士伴风而行，诗人抚琴低吟：何故千年守护一朝弃，只因深渊毒血乱龙心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001404
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230001404,
					"content": "…魔风息，毒血净。后世之子孙，勿忘其名姓，此诗献予东风之龙特瓦林！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001405
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230001405,
					"content": "嘿！这回的故事可算有点意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001406
					],
					"speakerTitle": "乃亚卜"
				},
				{
					"id": 230001406,
					"content": "被视作反派的角色其实有着无可奈何的背景…不管在什么故事里都让人动容啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001407
					],
					"speakerTitle": "伊泽姆"
				},
				{
					"id": 230001407,
					"content": "今天的故事就到这里，欢迎各位下次再来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛达赫"
				}
