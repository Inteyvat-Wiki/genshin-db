			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玛达赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000400,
					"content": "以前在蒙德…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000401
					]
				},
				{
					"id": 230000401,
					"content": "嗯？风神眷顾的蒙德吗…我听商队的人说，那里出现了一头掀起狂风的巨龙，应该会是个不错的题材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000402
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000402,
					"content": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000403
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000403,
					"content": "比如说…「一名背生双翼的旅行者破空而来，在万米高空之上与巨龙展开追逐！」什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000404,
						230000405
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000404,
					"content": "确实是在空中追击过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				},
				{
					"id": 230000406,
					"content": "#唔，再比如说…「{M#他}{F#她}只身潜入教会，盗取了寄宿着风神伟力的强大武器！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000407,
						230000408
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000407,
					"content": "确实是潜入过教会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000409,
					"content": "#欸！那这条呢？「最后{M#他}{F#她}看破巨龙弱点，击碎旧日创口。沐浴着龙血成为不死之身！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000410,
						230000411
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000410,
					"content": "确实是要瞄准某处…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000411,
					"content": "只是在净化影响心智的毒血。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000408,
					"content": "「天空之琴」不是什么武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000405,
					"content": "其实是靠风之翼啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				}
			]
		},
		{
			"id": 2300005,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"10006",
