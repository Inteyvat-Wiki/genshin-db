			"trigger": {
				"objectNames": [
					"玛达赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000301,
					"content": "欸，这故事都还没开始说，客人怎么就全走光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000302
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000302,
					"content": "完了，这回是真的连咖啡也要喝不起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000303
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000303,
					"content": "你遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000304
					]
				},
				{
					"id": 230000304,
					"content": "呃，您是…旅行者？唉…就跟您见着的一样，我平时会在这咖啡馆里讲讲故事，换点咖啡钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000305
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000305,
					"content": "不过最近愿意捧场的听众越来越少，再这么下去，我怕是连咖啡沫都喝不起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000306,
						230000307
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000306,
					"content": "像是蒙德的吟游诗人吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				},
				{
					"id": 230000308,
					"content": "呃…虽然我没亲眼见过，不过听起来，应该差不太多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000309
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000309,
					"content": "不过，这古代英雄的传说再怎么精彩，也架不住每天都讲…果然还是得找点新的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000310
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000310,
					"content": "唉，最好还得是发生在须弥之外的事情，一来足够新鲜好玩，二来嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000311
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000311,
					"content": "我也好再加工处理，也不担心被人说不对…反正大家都没听过…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000312
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000312,
					"content": "不过在那之前，我自己还是得先明白要讲的那些故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000313
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000313,
					"content": "您看，我其实也搜集了不少世界各地的故事，比如风龙啦，送仙典仪啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000314
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000314,
					"content": "但这些故事都是我从人家那边打听来的，故事内容肯定被添油加醋过，不太可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000315
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000315,
					"content": "旅行者，我从冒险家协会那边听说过，您是在到处旅行，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000316
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000316,
					"content": "能不能请您和我说说，您在世界各地的见闻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000317
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000317,
					"content": "这样的话，我也能修正一下我搜集来的这些故事，不至于讲得太离谱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000318
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000318,
					"content": "当然！我讲故事拿到的报酬，也会分给您一份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000319,
						230000321
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000319,
					"content": "这倒是没问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000320
					]
				},
				{
					"id": 230000320,
					"content": "那就拜托您了！您准备讲哪段见闻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000325
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000325,
					"content": "故事到处都能打听吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000326
					]
				},
				{
					"id": 230000326,
					"content": "这个么，我其实也搜集了不少世界各地的故事，比如风龙啦，送仙典仪啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000327
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000327,
					"content": "但这些故事传到我耳朵里，都不知道被转了多少道，内容肯定被添油加醋过，不太可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000328
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000328,
					"content": "还是得听您这样游历过四方的旅行者讲讲，我才能修正好这些故事，不至于讲得太离谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000321
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000321,
					"content": "添油加醋到什么程度？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000322
					]
				},
				{
					"id": 230000322,
					"content": "咳…就是那种，听起来就知道是胡说八道的程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000323
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000323,
					"content": "哈哈哈…比如什么背生双翼的骑士，一人一剑镇压魔神的剑客…我等会给您详细讲讲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000324
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000324,
					"content": "那我们就开始吧，您准备讲哪段见闻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000307,
					"content": "像是璃月的说书人吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				}
			]
		},
		{
			"id": 2300004,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
