					"玛达赫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000600,
					"content": "以前在稻妻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000601
					]
				},
				{
					"id": 230000601,
					"content": "嗯？雷神庇佑的稻妻吗…我听商队的人说，那里有人忤逆了神明颁布的「眼狩令」，应该会是个不错的题材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000602
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000602,
					"content": "但从商队那边能打听到的，都是一些断断续续，听起来还不太靠谱的传言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000603
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000603,
					"content": "比如说，「一位异乡人向愚人众执行官发起决斗，一刀就将对手化为灰烬！」什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000604,
						230000605
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000604,
					"content": "确实是赢下了决斗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				},
				{
					"id": 230000606,
					"content": "#唔，再比如说，「{M#他}{F#她}直面将军的威压，毫发无伤地从『无想的一刀』下逃出生天！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000607,
						230000608
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000607,
					"content": "确实是从刀下逃生了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000609,
					"content": "#欸！那这条呢？「最后{M#他}{F#她}从千手百眼神像中汲取力量，扭转了神明的意志…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000610,
						230000611
					],
					"speakerTitle": "玛达赫"
				},
				{
					"id": 230000610,
					"content": "确实改变了将军的心意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000611,
					"content": "制胜关键是大家的「愿望」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000608,
					"content": "挡下那一刀的是别人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000605,
					"content": "降下制裁的是将军啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				}
			]
		},
