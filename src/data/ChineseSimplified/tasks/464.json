			"dialogs": [
				{
					"id": 4640301,
					"content": "你们也对「他」感兴趣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640302
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640302,
					"content": "嘿嘿，不瞒你们说，我可是「暗夜英雄」的目击者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640303
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640303,
					"content": "呜哇，这下找对人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640304,
					"content": "那么「暗夜英雄」到底是谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640305,
					"content": "欸~别急，等我慢慢讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640306
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640306,
					"content": "那晚我正在巡逻，被一点响动吸引，我赶忙过去查看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640307
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640307,
					"content": "只见一伙儿人鬼鬼祟祟像是在密谋些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640308
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640308,
					"content": "于是我赶忙躲了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640309
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640309,
					"content": "喂，你不是守卫吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640310,
					"content": "而就在此时，「那个人」出现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640311
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640311,
					"content": "他一身黑袍，完美地隐藏在夜色里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640312
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640312,
					"content": "对那些恶人来说，就像悄悄袭来的噩梦一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640313
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640313,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640314,
					"content": "你们猜我这时候做了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640315,
						4640318
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640315,
					"content": "赶快逃跑？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640316
					]
				},
				{
					"id": 4640316,
					"content": "我又没做什么坏事，为什么要逃跑啊喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640317
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640317,
					"content": "不过…我确实从现场离开了，毕竟在「暗夜英雄」面前，我可能只是个累赘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640320
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640320,
					"content": "于是…我去了骑士团宿舍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640321
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640321,
					"content": "你认为「暗夜英雄」会是骑士团的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640322
					]
				},
				{
					"id": 4640322,
					"content": "没错，像他这样有正义感，自愿守护蒙德的人，加入骑士团是理所应当的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640323
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640323,
					"content": "可事实上…好像是我自作聪明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640324
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640324,
					"content": "在宿舍检查一番以后，并没发现有人出门的迹象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640325
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640325,
					"content": "那就是骑士团成员以外的人咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640326,
					"content": "是的。可我想不通…这样的人为何没有加入骑士团呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640327
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640327,
					"content": "以他的实力，应该很容易在骑士团有所作为的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640328
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640328,
					"content": "到头来你还是不知道「暗夜英雄」的身份呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640329,
					"content": "别那么失望，至少缩小了范围嘛，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640330
					],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640330,
					"content": "不如你再去<color=#00E1FFFF>花店</color>问问看，听说有位姑娘曾经受过他的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "劳伦斯"
				},
				{
					"id": 4640318,
					"content": "上去帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640319
					]
				},
				{
					"id": 4640319,
					"content": "嗯…在「暗夜英雄」面前，我可能只是个累赘，这点我还是有自知之明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640320
					],
					"speakerTitle": "劳伦斯"
				}
			]
