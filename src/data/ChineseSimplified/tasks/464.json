			"dialogs": [
				{
					"id": 4640101,
					"content": "原来你也是那种爱凑热闹的性格啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640102
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640102,
					"content": "不得不说，最近来光顾的客人确实都在谈论…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640103
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640103,
					"content": "与其说是「热门话题」，不如说是「都市传说」一类的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640104
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640104,
					"content": "即使我没有刻意去听，耳朵也快听出茧来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640105
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640105,
					"content": "不会…不会是什么可怕的传说吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640106,
					"content": "先、先给我一点心理准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640107,
					"content": "可怕倒没什么可怕的，至少对绝大部分的人来说是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640108
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640108,
					"content": "…是被称为「暗夜英雄」的人的传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640109
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640109,
					"content": "哇！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640110,
						4640113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640110,
					"content": "派蒙，这好像并不可怕吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640111
					]
				},
				{
					"id": 4640111,
					"content": "唔嗯，刚才酒保先生说的什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640112,
					"content": "原来你根本没在听啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640116
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640116,
					"content": "我在说「暗夜英雄」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640117
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640117,
					"content": "传闻中只有在午夜时分才会出现，惩恶扬善的神秘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640118
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640118,
					"content": "不过老实说，这种传说我没什么兴趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640119
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640119,
					"content": "除非他能帮忙治理一下半夜醉酒闹事的酒客…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640120
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640120,
					"content": "那我还是很愿意承认他存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640121,
						4640125
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640121,
					"content": "有人见过「暗夜英雄」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640122
					]
				},
				{
					"id": 4640122,
					"content": "据说是有过几个目击者的，可在夜里没法看清他的样貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640123
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640123,
					"content": "可能这就是他只在夜里现身的理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640124
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640124,
					"content": "但至少证明「暗夜英雄」的传说不是空穴来风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640129
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640129,
					"content": "和酒馆里常见的一些伎俩差不多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640130
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640130,
					"content": "总而言之，我知道的大概就是这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640131
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640131,
					"content": "感兴趣的话不如去广场上再打听打听，别耽误了其他客人点单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640132
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640132,
					"content": "「暗夜英雄」呀，像是每个城市都会流传的那种故事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640133,
					"content": "只是他稍微显得有些…阴暗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640134,
					"content": "到底会是个怎么样的人呢，有空去<color=#00E1FFFF>广场</color>上再问问看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640125,
					"content": "为什么他要隐藏身份呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640126
					]
				},
				{
					"id": 4640126,
					"content": "这个问题可能只有他自己知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640127
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640127,
					"content": "或许单纯只是喜欢保持这份神秘感也说不定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640128
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640128,
					"content": "毕竟那样的人比较讨女人欢心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640129
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640113,
					"content": "哇哇！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640114
					]
				},
				{
					"id": 4640114,
					"content": "喂，你们啊，到底有没有在听我说什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640115
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 4640115,
					"content": "唔嗯，刚才酒保先生说的什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640116
					],
					"speakerTitle": "派蒙"
				}
			]
		},
