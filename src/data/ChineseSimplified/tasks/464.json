			"dialogs": [
				{
					"id": 4640201,
					"content": "哦~你是来问「暗夜英雄」的事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640202
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640202,
					"content": "「暗夜英雄」就是我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640203,
						4640205
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640203,
					"content": "您是在开玩笑吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640204
					]
				},
				{
					"id": 4640204,
					"content": "是的，我是在开玩笑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640207
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640207,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640208
					]
				},
				{
					"id": 4640208,
					"content": "嗯……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640209,
					"content": "呵呵，其实我想说的是，在他身上我感觉到一种和我相似的气息哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640210
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640210,
					"content": "相似的气息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640211,
					"content": "在数之不尽的夜晚里守护着蒙德，贯彻自己的正义，坚守自己的信念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640212
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640212,
					"content": "原来玛格丽特女士也是这样了不起的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640213,
					"content": "不不，我的意思是，他一定很有钱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640214
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640214,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640215,
					"content": "往往在物质富裕的基础上才会追求精神的富有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640216
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640216,
					"content": "很多英雄故事也都是这样写的，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640217
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640217,
					"content": "…原来你只是在炫富而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640218
					]
				},
				{
					"id": 4640218,
					"content": "呵呵，没有的事，我只是每天都很闲罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640219
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640219,
					"content": "都差不多啦，毕竟是「猫尾酒馆」的老板娘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640220,
					"content": "不如你们再去<color=#00E1FFFF>城门</color>的守卫那边问问看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640221
					],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640221,
					"content": "经常值夜班的他们很可能见过些什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛格丽特"
				},
				{
					"id": 4640205,
					"content": "果然，我早就猜到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640206
					]
				},
				{
					"id": 4640206,
					"content": "嗯…抱歉我是在开玩笑的，请不要这么认真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640207
					],
					"speakerTitle": "玛格丽特"
				}
			]
		},
