					"nextDialogs": [
						730490515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730490515,
					"content": "就把他们一锅端了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730490516
					]
				},
				{
					"id": 730490516,
					"content": "嗯！现在就按照图上标注的营地顺序走一趟吧，一定能在那边抓住愚人众！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
