			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奥列格",
					"卡西姆",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730490317,
					"content": "#嘘，{NICKNAME}，你看那边！有一个镀金旅团的和…一个愚人众！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490301
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730490301,
					"content": "卡西姆…这些桑格吉拉光机运作情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490302
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490302,
					"content": "情况良好，奥列格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490303
					],
					"speakerTitle": "卡西姆"
				},
				{
					"id": 730490303,
					"content": "这就是这次的结果报告，按现在的情况进行下去…不用多长时间就能提取到你们愚人众想要的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490304
					],
					"speakerTitle": "卡西姆"
				},
				{
					"id": 730490304,
					"content": "好啊，哈哈哈，有你的帮助，一定能够在最短的时间内完成执行官大人的命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490305
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490305,
					"content": "不过，如果你胆敢骗我…你自己知道后果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490306
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490306,
					"content": "骗你对我有什么好处？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490307
					],
					"speakerTitle": "卡西姆"
				},
				{
					"id": 730490307,
					"content": "你清楚就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490308
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490308,
					"content": "嘿，那个特洛芬·雪奈茨维奇…办事不力，在这里好几年都毫无建树，我这么快就拿出成果，到时候，看他还有什么狡辩的话说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490309
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490309,
					"content": "特洛芬·雪奈茨维奇…我在须弥可没听过这个名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490310
					],
					"speakerTitle": "卡西姆"
				},
				{
					"id": 730490310,
					"content": "哈哈那是当然，他怎么可能用这个名字，岂不是一下就暴露了…执行官大人交给他的任务，几年了，一点进展也没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490311
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490311,
					"content": "…不对，谁，谁在那里？你是怎么到这儿来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490312
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490312,
					"content": "#呜哇，{NICKNAME}，被发现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730490313,
					"content": "…我也该走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490314
					],
					"speakerTitle": "卡西姆"
				},
				{
					"id": 730490314,
					"content": "呵，愚人众，不会被区区一个误入此地的冒险家击败吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490315
					],
					"speakerTitle": "卡西姆"
				},
				{
					"id": 730490315,
					"content": "这还用不着镀金旅团的人操心…哼，等我先把这个偷跑进来的老鼠消灭了，再去说好的实验营地找你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490316
					],
					"speakerTitle": "奥列格"
				},
				{
					"id": 730490316,
					"content": "卡西姆离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
