					"nextDialogs": [
						730492713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730492713,
					"content": "来，试一次，「不要带着自己的规则手册…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492714
					],
					"speakerTitle": "卡西姆"
				},
				{
