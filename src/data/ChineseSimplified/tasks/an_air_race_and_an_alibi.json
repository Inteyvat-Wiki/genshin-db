			"dialogs": [
				{
					"id": 750860301,
					"content": "你来了！塔卢加一直说你很厉害，让我在飞行竞赛时不要跟丢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860302
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860302,
					"content": "这孩子，话里话外没一点觉得我能赢的意思，让我做姐姐的面子往哪里摆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860303
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860303,
					"content": "所以待会儿的比试我是不会放水的，你也不要有所保留，让我们各自全力以赴，分个高下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860304,
						750860306
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860304,
					"content": "你会后悔让我动真格的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860305
					]
				},
				{
					"id": 750860305,
					"content": "就是这份气势！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860308,
					"content": "话不多说，你准备好了的话，我们这就开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750860306,
					"content": "我的目标是参与奖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860307
					]
				},
				{
					"id": 750860307,
					"content": "你这么说难道是想让我放松警惕？哼哼，我可不会上当！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "莉瓦"
