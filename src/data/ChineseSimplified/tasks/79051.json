			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "这里有一本日记，看起来保存得还不错？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510102,
					"content": "呼…真是松了口气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510103,
					"content": "这个画家的心结完全解开了，画技也得到了提升，肯定能干出一番大事业来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510104,
					"content": "不过，他最后还是离开了，没有一直陪着这些「小水珠」朋友，我倒是觉得有点遗憾呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510105,
					"content": "也许艺术家不太能接受摹刻品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "嗯，不是不能理解啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510108,
					"content": "还有一点我没想通，他提到了，自己留下的这幅壁画可能变形错位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510109,
					"content": "结果之前的事故那么猛烈…壁画错位的问题，好像并不是特别严重？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510110,
					"content": "关键在于这些「小水珠」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "原来如此！难怪「小水珠」们对「聚流映灯」和修复壁画那么熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510113,
					"content": "呜…我有点感动，「小水珠」虽然看起来不怎么聪明，但真的很体贴，很忠心，好适合当成重要的朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阅读"
				},
				{
					"id": 790510111,
					"content": "它们保护了朋友的壁画。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "坚守自己的独一无二也有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
