			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宝儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060601,
					"content": "怎么去了这么久，你有什么发现？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060602,
					"content": "找到了这个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "哈…虽然看着品相不错，但和我要找的那个东西，差别还是有点大啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060605,
					"content": "不过，这个也是文物，就交给我保管吧。放心，我一定会让它充分发挥价值的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060609,
					"content": "辛苦你了，这些东西是给你的，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060610,
					"content": "唉，可是那个文物还流落在外，真让人担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				},
				{
