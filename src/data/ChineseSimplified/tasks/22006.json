					"nextDialogs": [
						220060703
					]
				},
				{
					"id": 220060703,
					"content": "一件文物，可以让学者研究，可以供艺术家取材，可以展览给人们观看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060704
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060704,
					"content": "但是，绝对不能让小偷们拿去换钱，因为这样不仅是在侮辱文物，更是在践踏历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060705
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060705,
					"content": "侮辱文物和践踏历史的人，我绝不会退让一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060706,
					"content": "这枚玉盘…",
