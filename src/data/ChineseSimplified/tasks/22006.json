			"dialogs": [
				{
					"id": 220060101,
					"content": "到底在哪呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060102,
					"content": "你又丢了什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "这次没有「丢」，是刚开始找啦！但是——无论如何都找不到啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060104,
					"content": "到底在哪里，好不容易锁定了位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060105,
					"content": "你也来和我一起找找吧，这种贵重的文物，绝不能流落在外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060106,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "那你去那边，我继续搜索这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060109,
					"content": "一定要把它找出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060107,
					"content": "这次又是什么文物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "是一件…一件…呃，年代很久远！可以追溯到…一千，啊不，魔神战争时期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220060111,
					"content": "总之，是件很贵重的文物，绝不能让它流落在外！你也帮我找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				}
			]
		},
