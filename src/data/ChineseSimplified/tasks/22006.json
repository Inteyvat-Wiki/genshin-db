			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "谢谢你，旅行者，呼…刚才吓死我了，盗宝团真是越来越猖狂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060302,
					"content": "你是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "我叫索拉雅，是一名游学者，正在这里做研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060304,
					"content": "几天前，我循着线索找到了一处遗迹，在里面找到了一枚记载着魔神战争时期历史的玉盘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060305,
					"content": "但是我取出玉盘之后，刚刚走出遗迹，就被盗宝团袭击了，我跑了一段，还是被他们追上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060306,
					"content": "要是没有你们，我和玉盘可能都会有危险，再次感谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060307,
					"content": "你也是学者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "…也？还有学者在这里研究吗，那这位的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060309,
					"content": "宝儿…等一下，在刚才袭击我的盗宝团里，我听见有人说「怎么能让宝儿独吞宝物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060310,
					"content": "居然有这么巧的事情…抱歉，能详细和我说说你遇见的那个「宝儿」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060311,
					"content": "事情是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "…那位「宝儿」给你指定的地点，恰好都是我选定过的。这样的「巧合」，实在是太巧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060313,
					"content": "如果她真是盗宝团的成员，那么按照我的推测，也许我早就被盗宝团跟踪了，他们想跟着我…「捡现成的」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060314,
					"content": "那个「宝儿」想要独吞财物，于是自己一个人抢先行事，但凭她一个人，实在是搜索不了这么大的范围，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060315,
					"content": "看来…你也许被利用了呢，旅行者。恐怕这次的位置，也是她早就瞄好的，只不过她的同伙和我，都比你早来了一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060316,
					"content": "不用紧张，这些暂时只是猜测，但是「宝儿」这个名字…听着就十分可疑，像是个假名，或者代号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060317,
					"content": "旅行者，你能帮我敷衍一下她吗？无论怎样，也不能把这枚玉盘交给可疑的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060318,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "谢谢你，不过你这么空手回去，她说不定会起疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060321,
					"content": "这样，我这里有一个不那么贵重的小玩意，你带回去给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060322,
					"content": "虽然只是蝇头小利，但也足够让她消停一会的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060325,
					"content": "好了，你快点回去吧，虽然你刚才把她的同伙打跑了，但是她既然一个人单独行动，那她的同伙肯定也没法把你的事马上告诉她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060326,
					"content": "对了，如果下次她再支使你去找什么，而且你真有发现的话，可以带来给我。我平时一般会待在望舒客栈里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060327,
					"content": "呼，虽然我能做的事也很有限…但是能保护一件文物是一件吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060319,
					"content": "空手回去会让她怀疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "嗯…有道理，那这样，我这里有一个不那么贵重的小玩意，你带回去给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220060324,
					"content": "虽然只是点蝇头小利，但也足够让她消停一会的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "索拉雅"
				}
			]
		},
