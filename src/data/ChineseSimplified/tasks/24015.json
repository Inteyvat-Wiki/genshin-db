	"talks": [
		{
			"id": 2401504,
			"completionStepIds": [
				2401504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401504",
							"2"
						],
						"stepId": 2401504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "不对，不对…要是剔除了光影，那画面的层次怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150402,
					"content": "颜料的笔触表现力不够…画面的色彩也没有区分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150403,
					"content": "见鬼，只不过剔除了几个要素…整个画面都变得一团糟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150404,
					"content": "你在这做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "是您啊，见到您真好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150407,
					"content": "抱歉让您误会了，我刚刚只是在思考画面的问题，不由自主地到处闲逛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150408,
					"content": "您可能不能理解，但我在思考问题的时候，绝不能坐着不动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150409,
					"content": "如果我一直待在一个地方思考问题，那我会变得越来越烦躁…所以我习惯一边散步一边思考问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150410,
					"content": "在用头脑思考的同时，让我的双腿自由行动，随它们带我去哪，只要别让我待在原地就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150411,
					"content": "所以…我经常会这样，让您担心了，非常抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150412,
					"content": "那你思考出结果了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "毫无进展，就是…没有一点头绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150415,
					"content": "剔除了光影，画面就变得毫无层次，减弱形体的塑型，物体就支撑不起画面的结构。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150416,
					"content": "只是剔除了几个要素，整个画面就开始坍塌，最后变成一团糟糕的垃圾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150417,
					"content": "这都是我的自言自语，您不要在意，我要继续想想怎么解决这个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150418,
					"content": "我必须先回去找找我的画架…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150413,
					"content": "那你思考的问题怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "我们还以为你遇见危险了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "呼…呼…谢谢您，太谢谢您了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150602,
					"content": "真是见鬼了，我只是好好地在这里画画，突然就被这群家伙围住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150603,
					"content": "它们就像是要吃了我这幅画一样，不停地攻击画架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150604,
					"content": "我当然不能让它们破坏我的画，于是就抱着画拔腿就跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150605,
					"content": "但我…我没跑多远，就被它们追上了。还好有您来救我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150606,
					"content": "这画有问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "我，我不知道啊！我一直在用骗骗花蜜做颜料，您上次不是还帮我找来了一些吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150609,
					"content": "等等，难道…这些家伙是被含有骗骗花蜜的颜料吸引了？但这花蜜被我搅合进颜料里之后，根本没什么味道啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150610,
					"content": "这颜料的配方我也不敢随便更改，只能想想其他办法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150611,
					"content": "咳，我还以为连骗骗花都感受到了这幅画里蕴含的美感，想要过来欣赏一番呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150607,
					"content": "你做了什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}