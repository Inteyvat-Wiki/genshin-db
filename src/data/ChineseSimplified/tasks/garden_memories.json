	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "…总之，污染区其实就是森林深处的地脉发生了泄漏，现在已经恢复正常了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030102,
					"content": "原来是这样，真是辛苦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 130030103,
					"content": "等空气中残留的地脉能量散去，应该就可以对外张贴公告，让居民可以像以前一样自由出入了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 130030104,
					"content": "这是说好的奖励，两位请收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 130030105,
					"content": "从冒险家协会出来后，被派蒙带到了一个安静的地方…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "卡卡塔…要被送回教令院了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030107,
					"content": "虽然它已经损坏了，可一想到它要被拆掉，我还是觉得有点难过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030108,
					"content": "我也有一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "那！要不明天我们一起去找提纳里求求情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030110,
					"content": "虽然很想现在就去，但提纳里说了「有什么事明天再说」，我们现在去找他反而会惹他生气吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030111,
					"content": "好像确实是这样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "那就说好啦！明天我们一起去找提纳里，让他不要拆掉卡卡塔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提纳里",
					"卡卡塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "提纳里——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030302,
					"content": "嘘，小声点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030303,
					"content": "芫花，瑞香科瑞香属，有明显抗惊厥作用，可做麻醉粉使用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030304,
					"content": "从两组实验数据来看，对鱼类的毒性尤其大…认真记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030305,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030306,
					"content": "卡卡塔？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030307,
					"content": "咕噜！咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030308,
					"content": "不是说了要你们小声点，虽然植物不怕吵，但声音震得我耳朵嗡嗡响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030309,
					"content": "你，你没有拆掉卡卡塔吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030310,
					"content": "我拆它干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030311,
					"content": "可是你不是说，「按照教令院的规矩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030312,
					"content": "原来你们一大早过来搅得我不得安生，是为了这个啊。好吧，也怪我昨天没说清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030313,
					"content": "我的意思是，按照教令院的规矩，所有研究成果都要被销毁，所以不能让教令院发现那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030314,
					"content": "提纳里留在那里其实是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "总之先把卡卡塔修好了。以前在教令院的时候选修过素论派的课，没想到有朝一日还能派上用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030316,
					"content": "然后我跟它一起安葬了阿巴图伊。至于那些实验资料我整理了一下，一部分带出来留作纪念，大部分焚烧后深埋，清理掉证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030317,
					"content": "我又不在教令院，那些规矩关我什么事？恰恰相反，现在我是道成林的巡林官，我有义务保护好林中的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030318,
					"content": "任何生命诞生在世上都有意义，它也不例外。既然存在，就不该被随意抛弃或销毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030319,
					"content": "嘿嘿！太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030320,
					"content": "咕噜噜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030321,
					"content": "不过，提纳里刚刚说「任何生命」，难道你已经认可卡卡塔是「真正的生命」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030322,
					"content": "只是有这个可能性而已，毕竟它尝试「修复」阿巴图伊的事很难解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030323,
					"content": "但阿巴图伊留下的实验记录也只是一小部分，谁也不知道他到底设置了多少指令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030324,
					"content": "也许只是指令之间的冲突，导致卡卡塔做出了这样的举动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030325,
					"content": "从严谨的角度，无法得出「卡卡塔是真正的生命」这个结论。但既然存在这样的可能性，我就愿意去相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030326,
					"content": "咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030327,
					"content": "顺带一提，我对继续研究这个课题没什么兴趣，让它呆在这里，只是因为这里比较隐蔽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030328,
					"content": "不过目前来看，把它当做实验助手似乎也不错，至少实验记录可以让它来完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030329,
					"content": "你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130030330,
					"content": "咕噜！咕噜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡卡塔"
				}
			]
		},
