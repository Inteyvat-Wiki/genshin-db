			"dialogs": [
				{
					"id": 706960101,
					"content": "好久不见了，小家伙。最近去哪儿旅行了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960102,
					"content": "将雪山的见闻告知了神子。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "嗯，真是群可爱的孩子呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960104,
					"content": "为了共同的爱好，不管相隔多远也要相聚……啊呀，青春的气息真是扑面而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960105,
					"content": "看来《炽魂斗士战记》的魅力不小呢，是时候把再版计划提上日程了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960106,
					"content": "读者们这么真诚，我也必须表示一下心意才行呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960107,
					"content": "给你们赠送一些漫画如何？嗯…人不少，得多送几本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960108,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "都是初版印刷品，外面可买不到，好好珍惜哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960109,
					"content": "会和大家分享的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
