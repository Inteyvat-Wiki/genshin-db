			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦雷莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME}和派蒙？真是巧呀！我之前听说你们出发去挪德卡莱了，没想到这么快就能在这里碰上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050102,
					"content": "对啊对啊，我还以为我看错了呢！瓦雷莎，你怎么也跑到这么远的地方来啦？难道也是来旅行的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765050103,
					"content": "嘿嘿，差不多吧！我这次是来帮家里的果园采购一批农用机械的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050104,
					"content": "爸爸说挪德卡莱这边有些好东西，能让果子长得更好，也能让我省点力气，这样我就有更多的时间睡觉…和健身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050105,
					"content": "来了之后发现，这里有好多纳塔没有的好吃的！这几天除了办正事以外，我几乎所有时间都花在吃吃喝喝上面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050106,
					"content": "不知不觉，马上就要到回程的时间，都有点不舍得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050107,
					"content": "所以呀，我要抓紧最后的机会，再好好逛逛，把没吃过的都尝一遍，没看过的都看个够！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050108,
					"content": "#你们呢？让我猜猜…我们无敌的大英雄{NICKNAME}，是不是又在这片新的土地上，忙着维护正义呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050109,
					"content": "我们正在四处参观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "嘿嘿，我懂我懂！到了新的国家，看什么都新鲜得不得了，简直想把每个有趣的角落，都用留影机「咔擦」一下保存下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050112,
					"content": "这么说来…哎呀！我应该也把在这里吃过的所有美食都仔仔细细地拍下来才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050113,
					"content": "这样的话，等我回纳塔，说不定能让阿托力大叔照着画片，尝试把这些美味都给还原出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050114,
					"content": "瓦雷莎说不定能当美食摄影师呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "嘿嘿，真的吗？美食摄影师啊…听起来就很棒！每天都能和好吃的打交道，还能把它们拍得让人看了就流口水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050116,
					"content": "在拍摄美食之前…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "欸，要拍我吗？真的可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050119,
					"content": "我、我的头发有没有乱？嘴角没沾到酱汁吧？哎呀，早知道今天会遇到你们，我就把昨天在集市买到的配饰戴上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050120,
					"content": "你现在这样就很好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "好！那…那就拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050121,
					"content": "我想拍下你开心的样子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "可以为你拍摄画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "顺便寻找拍摄素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
