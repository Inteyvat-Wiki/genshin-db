				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "怎么？专门来打扰我休息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591102,
					"content": "没有啦，我们就是看你一个人在这里怪孤单的，想跟你聊聊天而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591103,
					"content": "一个人喝酒很无聊吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "…这样吗？谢谢你们。你们这副样子呀…让我想起柳达希卡那家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591106,
					"content": "她也是个热心人…那时候总是缠在我身边，什么话都愿意和我说…很多时候只愿意和我说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591107,
					"content": "唉，如果柳达希卡也在就好咯…她是个很有趣的人，你一定会喜欢她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591108,
					"content": "柳达希卡？那是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "她呀…我的一个朋友，看起来很严肃的样子，其实是个有趣的笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591110,
					"content": "曾经在「壁炉之家」的时候我们就像姐妹一样要好…可能更胜姐妹吧。她很喜欢我的捉弄…我也很受她照顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591111,
					"content": "哈哈，总之，我预感她在外面过得还不错。每每想到这点，我在这个鬼地方受的伤就都不算什么啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591112,
					"content": "希望她也有在好好执行任务吧…希望她不要想起我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591113,
					"content": "柳达希卡…你是说稻妻的那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591115,
					"content": "这么说，她暴露了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591116,
					"content": "欸…你怎么知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591117,
					"content": "她…设法逃出生天了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591120,
					"content": "哈哈…那就好，希望她也在好好执行任务吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591121,
					"content": "但假如她为了苟且偷生，违背了女皇陛下的意志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591122,
					"content": "…希望她不要想起我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591118,
					"content": "她还活着，过得很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "我们特地来陪你说说话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
