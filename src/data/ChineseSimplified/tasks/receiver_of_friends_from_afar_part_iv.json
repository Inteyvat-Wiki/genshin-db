						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "…好香，咸味跟鲜味都恰到好处，每一粒米都有味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490202,
					"content": "刚出锅时恰到好处的热气，也很让人怀念呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490203,
					"content": "哼哼，能让「骑士团最好的军粮」都相形见绌…报上名吧，这道菜叫什么名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401490204,
					"content": "叫…叫——总不能真叫「随便做点」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490205,
					"content": "…连名字都没有，用料跟做法也很普通，根本不知道从哪开始介绍啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490206,
					"content": "用料和做法都很普通吗？我还以为一定是用了什么特别的食材，或者特别的手法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490207,
					"content": "这不是「最美味」的菜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "而是我认为「最合适」的菜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "不是「最美味」，而是「最合适」…是、是什么意思啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490210,
					"content": "你们赶了很久的路…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "又吃了很久的口粮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "是因为饿了，所以觉得特别好吃吗？好像也不全是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490213,
					"content": "…也是因为一直在吃冷掉的口粮，所以难免会怀念大火烹饪出的香味吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401490214,
					"content": "啊，这是叫「锅气」吗？我好像听说过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490215,
					"content": "是啊，闻着香气，就像回到「猎鹿人」餐馆一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490216,
					"content": "欸？像回「猎鹿人」餐馆的话，不就没有来吃璃月菜的意义了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490217,
					"content": "不是说味道啦，是说…这种安心的感觉？就像回到老家一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490218,
					"content": "安心…老家…难道这就是言笑说的，「宾至如归」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490219,
					"content": "世上没有绝对的「美味」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "每个人都有各自的偏好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "但厨师为了每个客人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "设身处地着想的心意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "…却都是相似的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "所以这道菜的秘密调料，就是「心意」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490224,
					"content": "虽然听着像是什么老掉牙的论调…不过吃完这顿饭，确实像这么回事。不错，这个配方，我记下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401490225,
					"content": "记了配方，也得记一下名字吧？现在这道菜有名字了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490226,
					"content": "还没有想过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
