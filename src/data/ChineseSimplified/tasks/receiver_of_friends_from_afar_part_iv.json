							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "…时间过得可真快啊。我这手也好得差不多了，明天开始，应该就能重新掌勺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401490102,
					"content": "#这阵子真是辛苦你了，{NICKNAME}。但愿这最后一天，也能安安稳稳地度过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401490103,
					"content": "呃，你这话一说，我就感觉又有事要发生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490104,
					"content": "一日无事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "呼——普普通通地到晚上了呢，结果真没出什么岔子…嗯，肯定是因为我们已经完全熟练了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490106,
					"content": "记得第一天上工的时候，连加盐加辣都要记上半天…现在不管发生什么，都只是「小菜一碟」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490107,
					"content": "话不要说那么满…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "都这个时候了，不会再来人了吧？呃…不对，第一天林尼他们来的时候，好像也是这个点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}？派蒙？好久不见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490111,
					"content": "安柏？还有优菈和米卡！你们是来吃饭的吗，怎么这么晚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490112,
					"content": "我们刚完成了护卫商队的任务，还在返回石门的路上。虽然原计划是想直接吃些便携口粮就继续赶路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490113,
					"content": "不过优菈队长说，很久没吃璃月菜了，不如顺道来这间客栈，看看还能不能点餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490114,
					"content": "欸，居然是优菈的提议吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490115,
					"content": "…咳！这一路过来吃的都是便携口粮…偶尔也得换下口味吧！怎么了，不行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401490116,
					"content": "欢迎来到望舒客栈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "来点什么呢…嗯？等等，为什么是你在招待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME}现在可是这家客栈的大厨哦！你们来得也刚巧，正好能赶上{M#他}{F#她}在这儿掌勺的最后一顿饭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490120,
					"content": "欸！是吗？幸好优菈路上提了一句，不然就要错过这一餐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490121,
					"content": "那要点什么菜呢…我对璃月菜的印象也有些淡了…米卡，优菈，你们有什么想吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490122,
					"content": "能尝到「荣誉骑士」前辈的手艺，对我来说已经是个学习的好机会了，随便吃什么都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490123,
					"content": "…我也随便吃点就好，吃完还得继续赶路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401490124,
					"content": "不是你提议要来的吗？怎么连你也随便了…那就看你了，安柏，随便来点什么条件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490125,
					"content": "欸，那…我也「随便」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490126,
					"content": "喂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490117,
					"content": "请问要来点什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "今天还没结束呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
			"id": 4014902,
