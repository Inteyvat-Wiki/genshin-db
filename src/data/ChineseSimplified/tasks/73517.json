			"trigger": {
				"objectNames": [
					"维纳亚克",
					"施芮娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735170101,
					"content": "…所以就结论来说，还是要靠「对沙虫用杀虫炮」来消灭它们对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170102
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735170102,
					"content": "这根本就不能同日而语！不要摆出那副「早听我的不就得了」的表情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170103,
						735170104
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170103,
					"content": "你们怎么又开始了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170105
					]
				},
				{
					"id": 735170105,
					"content": "#啊，冒险家{M#先生}{F#小姐}！您听我说，我已经找出这起事件的原因了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170106
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170106,
					"content": "——是沙虫在地下的活动频繁，导致了这片区域内元素能量的紊乱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170107
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170107,
					"content": "而庞杂的能量又反过来影响了沙虫的习性，使得它们开始在地表上四处作乱，进一步加剧了环境的失衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170108
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170108,
					"content": "「对沙虫用杀虫炮」充能装置的效率异常，也是环境中元素能量紊乱导致的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170109
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170109,
					"content": "我就知道，我设计的机械，绝对不会这么轻易就出故障！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170110
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735170110,
					"content": "没考虑到使用环境的问题，难道就不算设计问题吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170111,
						735170112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735170111,
					"content": "既然原因是沙虫过度活跃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170113
					]
				},
				{
					"id": 735170113,
					"content": "所以，我们绕了那么多圈子，最后还是得出了一开始的结论？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170114
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735170114,
					"content": "知道要做什么和知道为什么要做可是两码事，身为一名学者，你不会连这都不懂吧？而且我的推论可还没结束呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170115
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170115,
					"content": "正常来说，大自然会自行限制种群的生态及行为，来维持周遭环境的稳定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170116
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170116,
					"content": "但这次紊乱的元素能量打破了这种平衡机制，也使得沙虫们异常活跃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170117
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170117,
					"content": "只要想办法让元素环境回归到正常状态，就可以减弱沙虫的活动。一段时间以后，这种平衡也就能自行恢复了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170118
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170118,
					"content": "调理元素能量？这要怎么做啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735170119,
					"content": "唔，只要推算出元素能量淤积最严重的「节点」，在那里用一些可以引导能量流动的装置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170120
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170120,
					"content": "…把淤塞的能量给激发出来，剩下的就可以交给大自然去自我调节了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170121
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170121,
					"content": "「节点」的位置我已经计算出来了，就在这附近。可以引导能量流动的装置，我们也已经有了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170122
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170122,
					"content": "难道是…「对沙虫用杀虫炮」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170123
					]
				},
				{
					"id": 735170123,
					"content": "没错，「对沙虫用杀虫炮」可以抽调周遭的元素能量，然后一口气迸发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170124
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170124,
					"content": "接下来我们只要在那里架设「对沙虫用杀虫炮」，像昨天一样进行一遍流程就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170125
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170125,
					"content": "这期间可能也会有魔物和沙虫被吸引来…嗯，适当削减一下它们的数量，也能加快自然调节的进程吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170126
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170126,
					"content": "——所以就结论来说，还是要靠「对沙虫用杀虫炮」给它们来一发对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170127
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735170127,
					"content": "你…！不要摆出那副「早听我的不就得了」的表情！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735170112,
					"content": "解决方案就还是多打沙虫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170113
					]
				},
				{
					"id": 735170104,
					"content": "这次是为什么吵起来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170105
					]
				}
			]
		}
	]
}