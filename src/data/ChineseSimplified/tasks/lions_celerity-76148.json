			"dialogs": [
				{
					"id": 761480101,
					"content": "呜啊，你们刚才去哪里了！吓死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761480102,
					"content": "我一直在喊你的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761480103,
					"content": "为什么派蒙这个小家伙没有被拉入无想之间？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480104,
					"content": "可能她除了吃和睡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "…本身就什么也不想吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480107,
					"content": "看来梅兰塔真的生气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480108,
					"content": "#送{NICKNAME}上去直面梅兰塔之事已是迫在眉睫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480109,
					"content": "换个地方说话吧。这里也不是很安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480110,
					"content": "那个，虽然没有人在意。但是大家好，我叫阿罗逻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿罗逻"
				}
			]
		},
