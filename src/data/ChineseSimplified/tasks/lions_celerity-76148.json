				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "又回到这里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480702,
					"content": "上次来这里，按照人的寿命来算都是前前前前前前…世时候的事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480703,
					"content": "看来我们都被重新投入无想之间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480704,
					"content": "所以我们应该怎么出去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "常规办法就是学习冥想，控制心和思绪。然后抛弃所有渴望的念头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480706,
					"content": "保持什么都不想的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480707,
					"content": "说着挺简单的。但是根据人的素质和渴望程度之不同，办到这一点从几年到几百年的都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480708,
					"content": "像你这种背负世界命运的人，渴望恐怕无法被自己割舍吧。何况也不应该被舍弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480709,
					"content": "那怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "先找到彩特琳德再想办法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480711,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761480712,
					"content": "你捡来了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "等等，小右也一起被拉进来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480714,
					"content": "那么这一切或许还有转机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480715,
					"content": "同为守望者，或许小右可以利用这些碎片里的力量。强行开辟一条出路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480716,
					"content": "这个碎片总归是需要个名字方便称呼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480717,
					"content": "这些过于夸张的棺材我略有耳闻，是神殿主人某个姐妹的布置。好像是叫做「死随念棺」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761480718,
					"content": "那这些碎片就叫做「念亡碎片」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亚"
				}
			]
		}
	]
}