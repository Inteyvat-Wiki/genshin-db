			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME}和派蒙，你们好呀！有什么可以帮到你们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "芙里达"
				},
				{
					"id": 401450202,
					"content": "嗯，我们最近有点人手不足呢，丽莎建议我们提升一下经营效率…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450203,
					"content": "哦，这件事呀，丽莎已经跟我详细地探讨过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "芙里达"
				},
				{
					"id": 401450204,
					"content": "目前可以提升的方向有炼金工艺、培育技术和销售规模。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "芙里达"
				},
				{
					"id": 401450205,
					"content": "效率提升之后，你们经营起来也会更轻松哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "芙里达"
				},
				{
					"id": 401450206,
					"content": "哇，听起来好厉害…我们赶快试试看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450207,
					"content": "提升经营效率。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "升级所需的准备已经做好了，请多多尝试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙里达"
				},
				{
					"id": 401450209,
					"content": "物资采购。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "最近新到了一批物资，请看看有什么需要哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙里达"
				},
				{
					"id": 401450211,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "祝你们经营顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙里达"
				}
