			"dialogs": [
				{
					"id": 401450101,
					"content": "经过一段时间的试营业，炼金店铺红红火火地开起来了……",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "呼，这段时间客人越来越多，我都要忙得头晕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450103,
					"content": "生意好起来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "现在这个订单量，光靠我俩果然还是有点勉强吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450106,
					"content": "是不是该找点新的帮手了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450107,
					"content": "小可爱，你们现在在休息吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450108,
					"content": "我刚刚看了最近的营收数据，你们果然很有经营天赋，这段时间卖出了不少药剂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450109,
					"content": "丽莎你来了！我们正好在商量找帮手的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450110,
					"content": "哦？是不是现在订单多起来了，你们逐渐忙不过来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450111,
					"content": "是啊，一开始没想到会有这么多客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450112,
					"content": "呵呵，我对此倒是有所预料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450113,
					"content": "其实在你们忙着开店的同时，我和芙里达讨论了一下提升经营效率的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450114,
					"content": "我观察了你们的经营情况，发现不管是炼金工艺，还是培育药材和售卖环节，都有不少的提升空间呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450115,
					"content": "哇，丽莎居然在悄悄关注这些事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450116,
					"content": "我还以为你一直在偷懒呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450117,
					"content": "说什么呢，姐姐在关键时候也是很可靠的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450118,
					"content": "那你说的提升效率，具体要怎么做呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401450119,
					"content": "这个嘛，具体的升级方案，我已经跟芙里达讨论过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450120,
					"content": "详细的情况，你们直接去找她聊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				},
				{
					"id": 401450104,
					"content": "打响名号了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
