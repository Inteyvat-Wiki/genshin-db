			"dialogs": [
				{
					"id": 708101101,
					"content": "好了，用苹果酿做基底，辅以蒲公英、薄荷和树莓调味，能再冰镇一下最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101102
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 708101102,
					"content": "喝完这种清凉的饮料，呼吸的时候，喉咙和口腔应该都能清晰地感受到「风」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101103
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 708101103,
					"content": "我先用酒瓶给你装好，不然味道很快就会散掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101104
					],
					"speakerTitle": "查尔斯"
				},
				{
					"id": 708101104,
					"content": "记住了，要喝的时候，最好冰镇一会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "查尔斯"
				}
			]
