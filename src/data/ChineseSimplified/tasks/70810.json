					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708101601,
					"content": "（拿出「芙萝拉的书签」）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101602
					]
				},
				{
					"id": 708101602,
					"content": "这个是，书签…哼，也行吧，当个装饰也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101603
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101603,
					"content": "果然让你帮忙没错，有什么想问的，赶紧问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101604
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101604,
					"content": "你要回去了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101605
					]
				},
				{
					"id": 708101605,
					"content": "我？我想啊，我早就想回去了，这蒙德城里太无聊了，也没人给我派活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101606
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101606,
					"content": "我就只能整天坐在这里，被修女们成天瞪来瞪去的，好像我做了什么伤天害理的事一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101607
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101607,
					"content": "可是歌德大酒店里的那些先生们，最近又闭门不出，一点消息都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101608
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101608,
					"content": "要我说，如果「女士」大人把事办完了，那就赶紧走呗。反正蒙德人也不喜欢我们，还留在这不是自己找罪受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101609
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101609,
					"content": "但是，上面一直没命令回去，我也就只能想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
