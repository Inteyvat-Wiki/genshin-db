			"trigger": {
				"objectNames": [
					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "关于蒙德城的特产…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "蒙德城的特产？虽然我们的菜品都能说有蒙德特色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100203,
					"content": "但是，我们店里一般的菜都不能放很久，也不方便长途携带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100204,
					"content": "虽然我们也可以把一般的菜加工得方便携带和储存…但这样做的话，口感和味道都会差不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100205,
					"content": "没关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "好吧，如果您坚持的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100207,
					"content": "不过，店里的货放的时间都有些久了，如果您是用来送人的话，最好还是新做一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100208,
					"content": "请问，您的朋友是哪里人？我来想想送什么菜比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100209,
					"content": "来自至冬国。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "至冬国？是很远的地方啊，那可要好好想想用什么菜最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100213,
					"content": "唔，虽然不知道至冬国人口味如何，但是有一道菜肯定不会错啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100214,
					"content": "请您帮我做一份「满足沙拉」来吧，然后我来帮您处理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100215,
					"content": "好久没有做过这种加工了，我得去找找工具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 708100211,
					"content": "来自愚人众。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "愚，愚人众？您是说来自至冬国的那些…您的交际可真广泛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "莎拉"
				}
			]
		},
