			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708101501,
					"content": "（拿出「猎鹿人的餐品」）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101502
					]
				},
				{
					"id": 708101502,
					"content": "这个是食物吧，还特意晒干了，确实是容易拿，但是味道估计不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101503
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101503,
					"content": "哈哈哈，不过好歹是蒙德城的特产，这个我就带回去，送给别人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101504
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101504,
					"content": "你办事还挺不错的，有什么想问的，赶紧问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101505
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101505,
					"content": "关于「女士」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101506
					]
				},
				{
					"id": 708101506,
					"content": "我就知道你要问这个，不过，这个我真不知道，我自己都还在奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101507
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101507,
					"content": "上头派我来蒙德城给「女士」大人办事，但是到今天「女士」大人都没让我干活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101508
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101508,
					"content": "听人家说，「女士」大人就来了一趟，然后就离开蒙德城了，据说她心情还不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101509
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101509,
					"content": "唉，也不知道「女士」大人是不是把事情给办完了，如果事情办完了，我是不是也可以回去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101510
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708101510,
					"content": "成天在这里莫名其妙地被修女和西风骑士瞪着，我自己也不自在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
		{
			"id": 7081018,
			"completionStepIds": [
				7081018,
				7081020
			],
			"beginWay": "TALK_BEGIN_NONE",
