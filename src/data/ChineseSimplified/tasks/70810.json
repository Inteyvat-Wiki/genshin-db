			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"维克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100121,
					"content": "你还有什么事情？要问就快点问，别磨磨蹭蹭的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100122,
						708100127
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708100122,
					"content": "你为什么找我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100123
					]
				},
				{
					"id": 708100123,
					"content": "哈，这个问题挺不错，我为什么找你…因为我这个愚人众，在蒙德城里就快要人人喊打了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100124
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708100124,
					"content": "之前就是修女看我的眼神怪怪的，现在，西风骑士看我的眼神，就像是想把我当街给逮捕了一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100125
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708100125,
					"content": "除了能和你这位旅行者说上点话，我难道还真敢去拜托其他的蒙德人帮忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100126
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708100126,
					"content": "我就奇了怪了，我到底做了什么事，这么招人厌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 708100127,
					"content": "还有多少愚人众在城里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100128
					]
				},
				{
					"id": 708100128,
					"content": "详细数量我不知道，不过歌德大酒店里的那些先生们是已经闭门不出了，也不知道发生了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100129
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 708100129,
					"content": "我想，说不定是那些大人物又在做什么事。不过嘛…哼，这些事和我这个小角色一点关系都没有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
		{
			"id": 7081003,
