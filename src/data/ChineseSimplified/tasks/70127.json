			"dialogs": [
				{
					"id": 701270101,
					"content": "「如果您读到这条信息的话，希望您是我所期待的那个人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270102,
					"content": "「这是第几封信了呢？这封信漂流了多远，又在哪里搁浅了呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270103,
					"content": "「等有机会再见面，再为我讲讲岩港的山、北国的风雪，或者蒲公英与酒，如何？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270104,
					"content": "「我会等着你的回信，像往常一样。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		},
		{
