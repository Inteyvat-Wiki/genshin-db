			"dialogs": [
				{
					"id": 701270201,
					"content": "「如果您读到这条信息的话，希望您是我所期待的那个人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270202,
					"content": "「我们曾以为战争只是童话和传说里才会发生的事，但如今，我们每个人都在大御所大人的雷霆震怒之下战栗。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270203,
					"content": "「我们常去的那片海滩被封闭了，但我还是想办法投出了这封信。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270204,
					"content": "「请不要为此担心责备。对于曾和你一同冒险的我来说，这种小事轻而易举。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270205,
					"content": "「我等待着你的回信，哪怕只有一句话也好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		}
	]
