				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卯师傅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "咦？旅行者，你怎么来了，是又想吃点好菜了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140202,
					"content": "是想要请教一件事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "旭东居然为了做菜去稻妻了啊，他还真是有毅力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140204,
					"content": "你认识他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "算是吧，之前我们俩也切磋过厨艺，勉强算是…不相上下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140206,
					"content": "他之前就一直说，自己想要寻求突破，想要去世界各地旅行…没想到他还真这么做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140207,
					"content": "不过，看样子他也遇到瓶颈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140208,
					"content": "你知道怎么解决他的问题吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "我也不能保证，但我会尽力试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140214,
					"content": "海草…海灵芝…还有这个什么…绯樱绣球？这都是什么奇怪的食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140215,
					"content": "不过，如果单看海草和海灵芝…的话，我想也许可以做一道菜…但还需要些另外的辅料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140216,
					"content": "旅行者，能请你帮我去找一些绝云椒椒和禽肉来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140217,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "那就拜托了，找到绝云椒椒和禽肉之后，就带回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140219,
					"content": "果然是经典食材啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "哈哈哈，那是当然了，这些食材可都是最可靠的，你拿到之后，就带回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140221,
					"content": "不过，这个什么绯樱绣球我是真不知道怎么入菜…不知道稻妻那边的厨师会怎么处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140210,
					"content": "也许香菱知道怎么解决他的问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "香菱啊，嗯…这孩子做菜一向很有创意，说不定真能找到解决方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140212,
					"content": "但她现在去轻策庄那边采竹笋去了，暂时不在店里，你们想找她，估计要花点时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140213,
					"content": "旭东应该急着等回复呢，还是我来看看能不能解决他的问题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "卯师傅"
				}
			]
		},
		{
