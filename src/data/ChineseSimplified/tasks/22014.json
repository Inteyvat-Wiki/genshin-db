				"objectNames": [
					"卯师傅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "这些应该就足够了，你们稍等一下，我看看怎么处理这些食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140402,
					"content": "做好了。唔…但我感觉，好像和平常我做的那些菜没什么太大的区别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 220140403,
					"content": "你们拿回去给旭东吧，希望这份菜能解决他的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯师傅"
				}
			]
