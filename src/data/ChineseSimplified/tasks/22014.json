					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "这里的竹笋应该还不错，挖一点带回去好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140602,
					"content": "咦？是你啊，你怎么在这？是又想吃点好菜了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140603,
					"content": "有事情想请教你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "用璃月的手法，处理稻妻的食材吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140608,
					"content": "嘿嘿，你们问我算是问对人啦。我之前听说过稻妻那边，有一种用面粉裹住食材下锅油炸的做菜手法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140609,
					"content": "用这种手法做出来的食物，似乎是被称为「天妇罗」，还要搭配特别的蘸汁来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140610,
					"content": "我之前试做「天妇罗」的时候，对这种蘸汁特别感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140615,
					"content": "而且还试过好多材料呢，比如骗骗花蜜啦、烈焰花啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140611,
					"content": "还有史莱姆凝液是吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "没有没有，这道菜用史莱姆凝液不太合适啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140616,
					"content": "我还是更倾向于加入雷萤翅膀上的粉末，让口感更加有层次感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140613,
					"content": "这么说你肯定也记不住，我给你抄一份下来，你拿过去给旭东吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140614,
					"content": "唉，要是我也能去稻妻就好了，那里肯定有很多我没试过的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140604,
					"content": "和卯师傅的反应一模一样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "你还去店里了啊，不过，看你也不是特意去吃饭的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140606,
					"content": "难道，你是遇见了什么和做菜有关的问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "香菱"
				}
			]
