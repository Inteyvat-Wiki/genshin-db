			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭东"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "旅行者，嘿嘿，又见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140102,
					"content": "有什么事要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "你还记得我上次承诺你的那顿饭吧？我正在为这顿饭做准备呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140106,
					"content": "为了做一顿好菜，我们可是四处搜集各种新鲜的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140107,
					"content": "现在食材搜集得差不多了，我正在想做菜方法呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140108,
					"content": "朱莉和芭尔瓦涅去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "她们啊，芭尔瓦涅说还想要继续寻找其他的食材，去做她想要的那种「万能调料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140110,
					"content": "然后她就拉着朱莉去野外寻找食材去了…她们说不会离城太远，不用担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140111,
					"content": "不过，我倒是需要你帮帮忙。虽然搜集到了很多稻妻的新鲜食材，但我却没有什么…突破性的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140112,
					"content": "你看，海草…海灵芝，还有这个…呃，绯樱绣球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140113,
					"content": "虽然都是些新鲜的食材，我却完全不知道如何下手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140114,
					"content": "我本来是想请教一下稻妻本地的厨师。但如果这样做，那我做出来的菜肯定又是寻常的「稻妻菜」，没有任何新意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140115,
					"content": "所以，我想要以璃月厨师的思维，来处理这些稻妻的食材。这样的话，说不定就能做出新奇的好菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140116,
					"content": "旅行者，能请你帮我回璃月一趟，请教一下「万民堂」的卯师傅吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140117,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "那就拜托你了，我就在这等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140124,
					"content": "希望卯师傅能有些好主意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140119,
					"content": "你是想要那种「噼咔」的感觉对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "「噼咔」是、是什么感觉？你是说那种…美食给人的震惊感吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140121,
					"content": "如果能找到有那种感觉的食谱，那当然最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140122,
					"content": "不过，能想出这种食谱的人，我可不认识啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140123,
					"content": "总之，拜托你先去帮我请教一下卯师傅吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 220140104,
					"content": "你是准备请我吃那顿饭吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "哈哈哈，我这不正是在为这顿饭做准备吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "旭东"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
