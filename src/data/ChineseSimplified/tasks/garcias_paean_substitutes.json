				"objectNames": [
					"路通",
					"加尔恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "先生，这次我真的诚心建议，我们还是选择想办法付钱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140102,
					"content": "那群卖货的简直是在抢劫！为什么几个徽印要卖那么贵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140103,
					"content": "也许是因为他们发现，您看见那些徽印的时候两眼都在放光吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140104,
					"content": "你要那些徽印做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "旅行者！您每次都来得这么及时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140106,
					"content": "上次多亏了您帮忙，我基本上已经制造出一种能用的润滑剂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140107,
					"content": "但我马上又遇到了一个问题，在我重制某些部件的时候，我发现…如果用太过坚硬的材料制造它们，反而容易将其它组件碰伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140108,
					"content": "而且，那些太过坚硬的部件只要稍微受到冲击，就会出现不同程度的坏裂情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140109,
					"content": "所以，我就开始寻找某种既有一定的硬度，又有着一定柔性的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140110,
					"content": "在我不懈的研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140111,
					"content": "…和对阿汉格尔先生的持续骚扰后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140112,
					"content": "我觉得盗宝团所携带的那种…徽记，也许就用到了某些我所要找的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140113,
					"content": "但是…那些商人简直和盗宝团一样在抢劫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140114,
					"content": "又到了我出马的时候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "我简直想把您的名字刻在「推数机」的主轴承里了！太谢谢您了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140115,
					"content": "我去帮你找找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
