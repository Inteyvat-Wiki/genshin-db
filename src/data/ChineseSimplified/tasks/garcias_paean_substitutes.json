			},
			"dialogs": [
				{
					"id": 230140301,
					"content": "非常感谢您，旅行者，这些徽印就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140302,
					"content": "我得先去把齿轮重制…呃，不对，也许先要研究一下轴承问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230140303,
					"content": "这是您的报酬，旅行者，请您收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140304,
					"content": "就现在的情况来看，咱们估计真的要长期合作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140305,
					"content": "唉，加尔恰先生的账目，梳理起来可真是难啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
