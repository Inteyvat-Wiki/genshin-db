				"points": []
			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "唔…路通，你得扶着我点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230145502,
					"content": "先生，您还是回去再睡一会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145503,
					"content": "旅行者，您来得正好！请过来一下吧，我想请您帮一个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145504,
					"content": "他这是怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "简单来说…加尔恰先生喝了太多咖啡，睡觉的时间又太少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145506,
					"content": "不过值得庆幸的是，先生至少只是喝咖啡，没有喝酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145507,
					"content": "路通，呃…我，我们得再找几枚那种徽印才行…就盗宝团带着的那种…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230145508,
					"content": "旅行者！你怎么在这里，抱歉，我刚才没有注意到你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230145509,
					"content": "你愿意帮我去拿点那种徽印来吗？只要几枚就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230145510,
					"content": "你就回去休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "没事，没事，我很好，思维很清晰…就是手有点不听使唤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230145514,
					"content": "总之，就请您拿几枚徽印来吧，我会准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145515,
					"content": "拿来之后直接…直接给我就行，我要仔细看看，这次一定要把那根轴承做好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230145512,
					"content": "喝咖啡能喝成这样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "这倒是不能怪罪咖啡，只能怪罪不想睡觉的加尔恰先生自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "路通"
				}
			]
		},
