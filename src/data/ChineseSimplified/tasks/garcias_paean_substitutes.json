					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145001,
					"content": "我们必须得想点办法赚钱了，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145002,
					"content": "我听说须弥城里有一个剧院，里面不少剧团需要做一些计算工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145003,
					"content": "而且那些剧团演出成员…您懂得，他们赚得很多，却不知道如何管理自己的账目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145004,
					"content": "这就是我们的机会，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145005,
					"content": "你在算账和做生意这两个方面的天赋真让人震惊，亲爱的路通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230145006,
					"content": "再等我想想，再等我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				}
			]
		},
