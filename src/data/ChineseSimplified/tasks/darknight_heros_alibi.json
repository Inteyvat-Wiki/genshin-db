			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪卢克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4660901,
					"content": "哦，回来了吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660902
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660902,
					"content": "介绍一下，他是酒庄的酿造师…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660903
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660903,
					"content": "这么多冰雾花！我已经开始期待「它」的效果了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660904
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 4660904,
					"content": "提纯设备可以承受这样的纯度么，会不会出什么问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660905
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660905,
					"content": "喔…喔喔喔——大老板亲自对我说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660906
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 4660906,
					"content": "放心好了，老爷！只要是您的意思，我就算搭上这条命都十分甘心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660907
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 4660907,
					"content": "这不是可以拼上性命的事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660908,
					"content": "你们先聊，我这就开工！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660909
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 4660909,
					"content": "他拿那些冰雾花去干什么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660910,
					"content": "事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660911
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660911,
					"content": "前些日子酒庄在研发新口味的时候，试着加了些冰雾花来让口感清凉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660912
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660912,
					"content": "经过提纯后的冰雾花确实有很强的吸引力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660913
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660913,
					"content": "所以卖的很好嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660914,
					"content": "不，我指的不是吸引酒客，而是…吸引史莱姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660915
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660915,
					"content": "这类依靠汲取元素力量维生的生物，完全抵抗不了它的诱惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660916
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660916,
					"content": "于是我想，干脆利用这一点做些文章…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660917
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660917,
					"content": "咚！咔啦咔啦…哐哐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660918
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 4660918,
					"content": "呜哇！刚刚那是什么声音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660919,
					"content": "好冷…好冷！迪、迪卢克…老爷，提、提纯…已经…完成了，只是设、设备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660920
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 4660920,
					"content": "辛苦你了，设备你不用在乎，我会让管家重新订购。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660921
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660921,
					"content": "真是阔气的发言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660922,
					"content": "刚才说的就是这东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660923
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660923,
					"content": "提纯后的冰雾花——可以叫它「元素诱饵」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660924
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660924,
					"content": "好厉害，这扑面而来的元素气息！要怎么试效果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660925,
					"content": "洒一点在那边的地上吧，当心…就一点点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪卢克"
				}
			]
		},
