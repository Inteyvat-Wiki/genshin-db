			"dialogs": [
				{
					"id": 4660101,
					"content": "迪卢克老爷！听我说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660102,
					"content": "哼，凯亚那家伙吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660103
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660103,
					"content": "我早该意识到了。对他来说，现在就是从我这里扳回一城的最好时机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660104
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660104,
					"content": "你们好像有什么恩怨的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660105,
					"content": "先不说这个，骑士团的想法倒是跟我预料的差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660106
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660106,
					"content": "现在将计就计就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660107,
						4660111
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660107,
					"content": "干脆先别去酒馆代班了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660108
					]
				},
				{
					"id": 4660108,
					"content": "不行。既然骑士团已经知道我代班的事，不去的话反而招致怀疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660109
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660109,
					"content": "这也是凯亚的算计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660110
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660110,
					"content": "那该怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660112,
					"content": "安静一点，让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660113
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660114
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660114,
					"content": "…既然要监视我，那就如他所愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660115
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660115,
					"content": "我们来创造一个完美的「不在场证明」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660116
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660116,
					"content": "「不在场证明」？那是什么意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660117,
					"content": "想知道的话，就先帮我个小忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660118
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660118,
					"content": "怎么还要卖关子呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660119,
					"content": "<color=#00E1FFFF>酒庄西北</color>方向，有蒙德最好的冰雾花产地。周边地方也零零散散长了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660120
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660120,
					"content": "请你们帮我收集几株回来吧，我在这里做些其它准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 4660111,
					"content": "你有什么想法了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660112
					]
				}
			]
		},
