			"trigger": {
				"objectNames": [
					"梶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "感谢你的努力，虽然岛上依然危险重重，但多亏了你，那些背井离乡的人们才多少恢复了一点回家的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320102,
					"content": "虽说现在大雨停了，交战的双方可能会更积极地进军争夺这座岛吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320103,
					"content": "不过岛上的境况，既然他们无暇改变，我们所做的一切至少比就这样放着恶化好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320104,
					"content": "那么，之前说好的谢礼就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320105,
					"content": "这是几百年前八酝守大人使用的名枪…我不清楚这幅画对你来说有没有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320107,
					"content": "不过把它拿给手艺足够精湛的工匠的话，或许能够重现喜多院大人的英姿吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320108,
					"content": "唉，当今不再是英雄的时代了，曾扑灭无数邪魔的喜多院大人也不复归来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320109,
					"content": "不过幸好有你相助，喜多院大人的功业…现在我们也追上了一点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721320110,
					"content": "接下来我会去幕府军的朋友那边，看看能帮上什么忙，希望来日有缘再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				}
			]
		},
