			"dialogs": [
				{
					"id": 761500101,
					"content": "咳咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500102,
					"content": "你没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "我…没事。我做了一个很长很长的噩梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500104,
					"content": "算了。上一句话当我没说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500105,
					"content": "我忍不了了。为什么我要遇到这种事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500106,
					"content": "为什么我总要遇到这些事情。爸爸妈妈，然后是姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500107,
					"content": "没事的，我在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "嗯。我没有生你们的气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761500110,
					"content": "小右捡了个什么东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500111,
					"content": "我把这个叫做「念亡碎片」，或许是向死而生的出路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761500112,
					"content": "一起走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500114,
					"content": "既然找到琳德了。我们就去找找出去的办法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761500115,
					"content": "这里真的可以靠实力出去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "阿罗逻"
				},
				{
					"id": 761500116,
					"content": "既然梅兰塔和尼西里塔可以自由往来，通常都还会带人出入。那小右应该也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761500118,
					"content": "现在收集到了三枚「念亡碎片」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761500119,
					"content": "哦，这个是暂定名。因为我也不知道小右收集这个要做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761500120,
					"content": "小右，接下来怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "伊斯托利亚"
				},
				{
					"id": 761500121,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761500122,
					"content": "跟着它指示的方向走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亚"
				}
			]
		},
