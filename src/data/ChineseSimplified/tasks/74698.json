	"talks": [
		{
			"id": 7469801,
			"completionStepIds": [
				7469801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7469801",
							"2"
						],
						"stepId": 7469801,
