			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#下午好，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510102,
					"content": "…没想到，我会有幸在蒙德见识到你的「调和」才华。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510103,
					"content": "艾梅莉埃小姐来旅行吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "两者兼有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510106,
					"content": "一位自称魔女的小姐，邀请我来经营她的小花铺。另外，我还接到了猫尾酒馆的委托，为该店调制了新的香氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510107,
					"content": "#以{NICKNAME}亲手调制的饮品为今天的忙碌划上句号，更是绝妙的收获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510108,
					"content": "那我可要使出拿手好戏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "相信你的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510111,
					"content": "（艾梅莉埃对香味的敏感性强于常人，如果产生了控制不当的复合香气，或许会让她觉得不妥？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "（总之，使用香气包容性较强的材料，适当加上枫丹风味吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "（那就先来一杯蒙德改进版的「七时柔灯」好了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "我会为你调一杯惊喜特饮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "艾梅莉埃小姐来出差吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
