							-779.316
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "先试试看，艾梅莉埃小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "你的动作真是赏心悦目…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510203,
					"content": "嗯…这是一杯「七时柔灯」的本地版吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510204,
					"content": "非常准确。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "柔和淡雅，层次分明的口感，结合了几分蒙德特色的香气，风味相当亲切，也避开了可能让我感到不谐的味觉成分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510207,
					"content": "其实，不用这么谨慎，对于跳出常理框架的风味物质，我也有着不错的接受能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510208,
					"content": "看来现在这杯有点太传统了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "这杯非常不错，当然，如果能有一杯更「深刻」，加入了你个人独特理解，也能加深我对蒙德印象的特调，就完美无瑕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510211,
					"content": "我们可以放慢节奏，从闲谈中寻找灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510212,
					"content": "这是你刚买的花卉吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "是经营花铺的酬劳之一，重要的香水材料，帮我完成了猫尾酒馆的委托——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510214,
					"content": "许多年前，我研究过蒙德的塞西莉亚花，塞西莉亚花的香气，在一些领域内，直接成为了「蒙德」的代名词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510215,
					"content": "不过，这次情况特殊，有些猫儿不太习惯塞西莉亚花的气味，需要特别考虑它们的感受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510216,
					"content": "这次换用了什么植物香气呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "是风车菊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510219,
					"content": "将风车菊的植株分部位研磨萃取后，适当混合花冠与叶片的香气。有蜜酒般的酣甜，但也强调了花卉枝叶中的清新气息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510220,
					"content": "刚刚在猫尾酒馆小小试验了一番，猫儿们的反应还不错。客人们也觉得，新的香氛既温馨，又让他们精神飒爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510221,
					"content": "从外表平凡，未被重视的材料中，提取出卓越的香气…真是件令人欣喜的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510222,
					"content": "今天的天气很棒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "（原来用经典话题展开聊天是这种感觉…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "的确，早些时候，低空中徘徊着轻纱般的淡积云…大气的湿度适中，风速也相当柔和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510225,
					"content": "这种条件下，人的嗅觉会处于一种…活跃，而不过度敏感的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510226,
					"content": "混合得当的香味成分，能够自然而然地融入环境，深刻地浸润至人们的记忆之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510227,
					"content": "居然还有这种理论…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "调饮似乎也有着相通之处——选择烈度适中的基酒，让各种香味成分和谐地融入酒体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510230,
					"content": "要是处理得当，一切成分都能共同发挥功用，给味觉带来最美妙的交响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510231,
					"content": "好像懂了，口感融合很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "嗯…说得对。仔细一想，层次分明的口感，确实不太符合我个人的习惯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510234,
					"content": "平时艾梅莉埃都喝些什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "平常啊…工作结束后，执律庭的朋友们偶尔会请我喝上两杯。通常，我会选择果茶，以便在聚餐后快速回到工作状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510236,
					"content": "如果第二天是假期，警员们兴高采烈，我也会点一小杯水果气泡酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510237,
					"content": "有位名叫蒂蕾娜的警官，还经常请我共饮陈年木桶的歌妲酒。不过她调去特巡队后，我就没再喝过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510238,
					"content": "原来你能接受酒类吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "从科学的角度考虑，酒精是一种使用率极高的溶剂，我许多年前就习惯了高纯度酒精的气味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510241,
					"content": "而在微醺状态下，我的心境会有所不同，进而影响到调香的思路…无论结果是好是坏，都属于新的尝试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510242,
					"content": "所以，我并不抗拒烈度较低的酒饮，在饮品中加入一点点酒类就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510243,
					"content": "最近的调香工作都还顺利吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "嗯，多谢关心，一切都好，只有这次蒙德之行，遭遇了意料外的挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510245,
					"content": "一开始，我就根据《芳香物质与人体感官概论》这本经典，选择了蒙德地区最传统的几种香味物质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510246,
					"content": "没想到，落落莓为主调的香氛在酒馆中显得过于香甜，让人昏昏沉沉…有着漂亮耳朵的调饮师小姐直接倒下睡着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510247,
					"content": "原来落落莓有这种功效？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "只能说，甜度并非越高越好。对于摄入的甜味物质，适当把控总量，对身体和思维总归是有益的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510250,
					"content": "日常生活中，我也不会经常吃甜食，并尽量避免食用浆果一类糖分过高的水果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510251,
					"content": "最后，我在调香中完全划掉了落落莓的相关成分，转而向风车菊的方向探索出了一番成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510252,
					"content": "我已经有主意了，请稍等，我这就调整配方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "嗯？只是简单聊了两句，你就找到了思路吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510254,
					"content": "或许，你本来就有着很强的研发天赋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510248,
					"content": "听起来落落莓香氛不太妙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "还以为你会觉得酒比较呛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "你倾向于浑然一体的口味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "第一次听说，长见识了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "用哪种花卉取代了塞西莉亚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "艾梅莉埃想要更特别的饮品？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "一下就被你品出来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
