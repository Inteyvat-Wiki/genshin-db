			"dialogs": [
				{
					"id": 705510301,
					"content": "请品尝，这杯专为艾梅莉埃改进的「七时柔灯」。不过，暂时还没想好它的名字…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510302
					]
				},
				{
					"id": 705510302,
					"content": "色彩更加清爽，散发而出的香气，也十分淡雅，符合青色的印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510303
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510303,
					"content": "表面这层斑斓的细末，来自风车菊的花瓣和叶片吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510304,
						705510305
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510304,
					"content": "是的，一眼就看准了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				},
				{
					"id": 705510306,
					"content": "味道肯定很不错…我试试哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510307
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510307,
					"content": "嗯…风车菊的花语是「看得见的风」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510308
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510308,
					"content": "你不仅捕捉到了它们的形态，还将它们捎来的香气融入了这杯特调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510309
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510309,
					"content": "我提议，这杯特调，就命名为「云风芳迹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510310
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510310,
					"content": "蒙德的云与风，在杯中旋绕，留下芬芳之痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510311,
						705510312
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510311,
					"content": "不愧是香水专家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510313,
					"content": "是吗？可能是职业的习惯使然，你满意就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510314
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510314,
					"content": "接下来，容我慢慢品尝这杯特调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510315
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510315,
					"content": "#十分感谢，{NICKNAME}。这次蒙德之行，还真是收获满满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510316
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510316,
					"content": "这是迄今为止，我印象最深的一杯特调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510317
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510317,
					"content": "返回枫丹后，我会尝试，根据记忆中此刻的印象，以香水和香氛的两种形式，分别再现你的这杯杰作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510318,
						705510319
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510318,
					"content": "我的荣幸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510320,
					"content": "调制完毕后，还请你赏光，来当这两种新品的首位客户。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510321
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510321,
					"content": "到时，枫丹廷见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 705510319,
					"content": "好耶好耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510312,
					"content": "命名很有格调！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510305,
					"content": "正是蒙德特色的花卉！",
					"roleType": "TALK_ROLE_PLAYER",
