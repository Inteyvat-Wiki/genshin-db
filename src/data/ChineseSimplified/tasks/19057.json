				"objectNames": [
					"伊庭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "这平藏小子真是不好惹啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570902,
					"content": "欸？二位想知道老头子当初的事？其实没什么好说的，很简单的过程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570903,
					"content": "那时听说是平藏小子在调查，老头子就知道已经完了，没费什么功夫就全交代了，毕竟遇见的可是「风暴」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570904,
					"content": "「风暴」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "是平藏小子的别称，你们没听过吗？牢里的犯人都这样叫他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570906,
					"content": "逃跑是不可能的，藏也藏不住，对罪犯来说，平藏小子就是像风暴一样的天灾啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "伊庭"
				},
				{
					"id": 190570907,
					"content": "唉，早知如此，何必当初…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊庭"
				}
			]
		}
	]
