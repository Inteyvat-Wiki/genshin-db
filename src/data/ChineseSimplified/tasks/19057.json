				"objectNames": [
					"鹿野奈奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "旅行者，您好啊，舍弟给您添了不少麻烦吧？那孩子就是太有个性了些，其实没有坏心思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "鹿野奈奈"
				},
				{
					"id": 190570802,
					"content": "如果有不小心之处冒犯到您，请不要顾忌，狠狠地教训他吧，他敢反抗您就说是我同意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹿野奈奈"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
