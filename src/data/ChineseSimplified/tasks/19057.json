				"objectNames": [
					"悦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "非常抱歉，刚才我对您失言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570702,
					"content": "啊，您问平藏先生吗？他应该很痛恨我这种人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570703,
					"content": "虽然他很克制，言语也能保持礼貌友好，但其实我能看得出来，他对骗子和其他犯人的态度还是不一样的…他好像非常痛恨骗子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "悦"
				},
				{
					"id": 190570704,
					"content": "难道他也曾被骗过吗？真不可思议，什么人能骗到平藏先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
