				"objectNames": [
					"塞琉斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "你好，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 701080402,
					"content": "这封信是给你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "信？哦…是她的啊，我知道了，肯定又是来问我有关探险队的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 701080404,
					"content": "唉，这事我也没办法，现在没几支探险队会去雪山里探险，那地方实在是太危险了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 701080405,
					"content": "我等一下会自己写封信给她，把情况和她说明一下，谢谢你专门送信过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 701080406,
					"content": "哦对了，这是她之前写信过来让我给你准备的报酬，你就收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 701080407,
					"content": "还有…我多说一句，虽然你看起来身手不错，但在雪山里活动，还是要格外小心才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 701080410,
					"content": "唉，雪山…要是有机会的话，我一定要亲自领队进山看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				}
			]
		},
