			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戈尔珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "唉，现在怎么可能找得到人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "啊！您，您好，旅行者，请问您是需要治疗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060104,
					"content": "只是路过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "哈哈…看起来有那么明显吗？不过，我确实也很发愁啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060107,
					"content": "不知道为什么，最近来我们「健康之家」请求治疗的人越来越多，我们的全部人手几乎都投入在照顾病患里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060108,
					"content": "但扎卡里亚医生还是坚持让我想办法去打扫周围…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060109,
					"content": "他说，为了让大家更容易接受草神大人的福佑，必须时刻保持病人身心和医院内外的洁净。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060110,
					"content": "唉，但现在压根找不到人，我总不能拜托那些症状轻微的病人起来帮忙吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060111,
					"content": "不如就交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "你愿意帮忙吗？那真是太感谢了！我会准备好报酬的，虽然，虽然不会太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060123,
					"content": "唉，愿草神大人保佑大家远离病恙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060113,
					"content": "不能雇人来帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "我们这里毕竟都是病患，没多少人会愿意来义务帮忙，我们的资金也有限，没办法雇很多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060115,
					"content": "平时我们都是轮换值班，但现在这么忙，已经没人有空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060116,
					"content": "旅行者，如果…如果你愿意的话，能不能来帮帮忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060117,
					"content": "我们会付报酬的！虽然，虽然不会太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060118,
					"content": "这里的病症…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "这里病人的病情其实都是一些头疼之类的轻微病症。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060120,
					"content": "扎卡里亚医生也对外宣传了很多次，这些病症并不危险，但没人听得进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060121,
					"content": "我想，也许大家害怕的不是病症本身，而是得病这件事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060122,
					"content": "那清扫工作就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060105,
					"content": "只是看你很发愁的样子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
		{
