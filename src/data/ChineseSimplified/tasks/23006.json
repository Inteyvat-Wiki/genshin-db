			"dialogs": [
				{
					"id": 230060301,
					"content": "旅行者，你有什么想问我的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060302,
					"content": "关于扎卡里亚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "扎卡里亚医生是一位很厉害的医生，也是一位很虔诚的草神信徒呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060304,
					"content": "他经常不眠不休地治疗病人，就连吃饭都顾不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060305,
					"content": "扎卡里亚医生还说，让草神大人的福佑能恩泽到更多人，是他义不容辞的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060306,
					"content": "你们的治疗真是靠草神的福佑？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "准确地来说，「治疗病症」这件事，就是草神的恩泽喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060308,
					"content": "草神护佑着我们，让我们能找到治疗病患的方法，培育治疗病症的药草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060309,
					"content": "感谢草神大人的恩泽，愿大家都能够远离病恙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈尔珊"
				}
			]
		},
