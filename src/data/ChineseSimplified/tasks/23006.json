						230060403
					]
				},
				{
					"id": 230060403,
					"content": "真是太感谢您了，旅行者，这些酬劳请务必收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060404,
					"content": "话说回来，古尔根先生最近又在勉强自己干活了，我是不是要多花些时间劝劝他呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "戈尔珊"
				},
				{
					"id": 230060405,
					"content": "近期还有不少要花精力的事，下次清理可能还要麻烦您了。",
