			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "欢迎光临，这里的宝物保证独一无二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040102,
					"content": "好多都是没见过的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205040103,
					"content": "哈哈，当然了，这些都是冒险家从世界各地找到的稀奇宝贝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040104,
					"content": "怎么样，有一眼就相中的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040105,
					"content": "感觉都很奢侈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "不会不会，忘记和你介绍了，我这里都是以物易物，不收取摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040108,
					"content": "我最近想做一个特殊的工艺品，需要大量的<color=#00E1FFFF>「风之印」</color>来装饰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040109,
					"content": "你们身上有<color=#00E1FFFF>「风之印」</color>吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040110,
					"content": "找到了几个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "哈哈，那看起来你的冒险已经得到风神的认可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040114,
					"content": "总之，只要你有<color=#00E1FFFF>「风之印」</color>，就可以和我交换商店里所有的商品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040115,
					"content": "挑选商品",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "那是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "那是一种印记，风神会将它送给受到认可的冒险者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040106,
					"content": "我根本不敢看价格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
			"completionStepIds": [
				2050403
