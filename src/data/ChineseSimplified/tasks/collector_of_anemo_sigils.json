			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "<color=#00E1FFFF>「风之印」</color>有可能出现在蒙德的任何地方，如果不够用的话就去多找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040302,
					"content": "真的只是用来装饰吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "是啊，怎么说都是风神的赠礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205040304,
					"content": "哈哈，你们还挺敏锐的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040305,
					"content": "解释起来挺复杂，用装饰品的说法大家都容易理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040306,
					"content": "我会选择用<color=#00E1FFFF>「风之印」</color>，自然是有非它不可的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040307,
					"content": "做好了记得让我看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "哈哈，肯定的，保证让你大吃一惊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040312,
					"content": "欢迎再来哦，希望你下次能带来很多很多的<color=#00E1FFFF>「风之印」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040313,
					"content": "找到什么稀奇宝物的话也记得要带到我这里来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 205040309,
					"content": "故弄玄虚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "但我真的有点好奇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 205040311,
					"content": "哈哈，就是要保持未知才会有惊喜啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "玛乔丽"
				}
			]
		}
	]
