							230.089,
							-803.291
						],
						"pointId": 300401900
					},
					{
						"sceneId": 3,
						"position": [
							2208.9,
							230.089,
							-802.525
						],
						"pointId": 9305
					},
					{
						"sceneId": 3,
						"position": [
							2209.107,
							230.089,
							-801.605
						],
						"pointId": 9306
					}
				]
			},
			"dialogs": [
				{
					"id": 705460101,
					"content": "方妮雅，我的好姐姐！你难道不想成为「嘟嘟可砰砰历险记」的第一位玩家吗？试试这款新作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460102
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460102,
					"content": "灵活机动的作战方式，点对点的精准爆破，和狡猾游走的敌人斗智斗勇，怎么看都特别好玩吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460103
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460103,
					"content": "不要。我又不像你，整天只想着和炸弹过日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460104
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460104,
					"content": "帮你折腾测试样机和桌上游戏，已经属于高强度加班了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460105
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460105,
					"content": "我现在只想叫一份「猎鹿人」的外送订单，然后回家。等到门被敲响时，我刚好洗完最后一件衣服，心情愉快地接过我的餐品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460106
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460106,
					"content": "至于这个噼噼砰砰的新游戏，就等到下次和你一起值班，闲得无聊时再玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460107
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460107,
					"content": "什么新游戏，听得我都好奇了…可以让我们也看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460108,
					"content": "等等，是荣誉骑士和白色小帮手？居然真的能遇见你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460109,
						705460114
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460109,
					"content": "我想起来了，你是「炸弹怪人」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460110
					]
				},
				{
					"id": 705460110,
					"content": "荣誉骑士认识我？看来上次我在「入侵角鲀歼灭战」的表现很出色…连您都听说了我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460111
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460111,
					"content": "我我我…我一定继续加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460112
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460112,
					"content": "最近我正在持续改良炸弹配方和设计，努力让我和火花骑士大人的差距再缩小一点点，一点点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460113
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460113,
					"content": "总之，上次行动过后，艾玛托认为，只靠远距离投放炸弹，还是存在不小的作战死角，而且面对一些屏蔽物和掩体时不够有效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460119
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460119,
					"content": "所以她开始折腾新的装备，为了验证这种装备，还特地改进了火花骑士爱玩的桌上游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460120
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460120,
					"content": "没错！这些天来我一直在分析火花骑士的战斗思路，想出了炸弹的另一种使用方式！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460121
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460121,
					"content": "火花骑士的习惯大概是「一份装药的威力不够，就用三份；一枚蹦蹦炸弹解决不了，就丢三枚」，增大威力肯定能解决问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460122
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460122,
					"content": "但这对我们普通骑士来说太困难了，不能在威力上和火花骑士大人的蹦蹦炸弹匹敌，就只能用灵活性和准确度弥补缺点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460123
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460123,
					"content": "如果开发出一种能够追踪目标，接近布置炸弹的装备，既可以实现对危险目标的精准打击，又可以最大程度利用负重！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460124
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460124,
					"content": "追…追着敌人放炸弹的装备？听起来很厉害，又有点吓人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460125,
					"content": "假如我是个丘丘人，正和朋友追着野林猪呢，突然蹦出来个小东西，二话不说就把炸弹扔在我们脸上…我应该会吓得昏过去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460126,
						705460128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460126,
					"content": "好像还挺酷的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460127
					]
				},
				{
					"id": 705460127,
					"content": "也对哦…对魔物和敌人恐怖，就说明对我们、对西风骑士和冒险家有用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460130,
					"content": "不过，目前这种新装备还处于早期验证阶段，正式生产和投入使用还需要一段时间，我会加把劲的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460131
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460131,
					"content": "考虑到在野外进行试验会影响到蒙德的自然生态，这种小事也不到惊动阿贝多队长的程度，没必要特意申请一块试验区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460132
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460132,
					"content": "艾玛托咨询我后，决定先建造一个小型样机，进行模拟操纵和爆炸试验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460133
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460133,
					"content": "正好，之前有种桌上游戏，很适合进行缩比测试，艾玛托就拉着我找到了丽莎前辈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460134
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460134,
					"content": "然后获得了丽莎姐姐的支援和建议，甚至是故事情节的支援，就有了超棒的收获——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460135
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460135,
					"content": "锵锵！请看这边的游戏桌，「嘟嘟可轰轰奇遇记」第二部，「嘟嘟可砰砰历险记」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460136
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460136,
					"content": "这回，学会了近距离爆破的嘟嘟可，带着特别蹦蹦炸弹强势回归，顺着我们的指挥，迎战卷土重来的敌人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460137
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460137,
					"content": "在嘟嘟可和角角鱼大王的斗智斗勇中，我们能充分享受火花的炙烈和爆炸的快乐…顺便为新式装备记录宝贵的测试数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460138
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460138,
					"content": "喔！艾玛托改进的游戏，嘟嘟可大战角角鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460139,
					"content": "#看起来，荣誉骑士长官和白色小帮手还挺有兴趣的，{M#他}{F#她}们也能提出极具参考价值的建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460140
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460140,
					"content": "没错没错，如果荣誉骑士和白色小帮手愿意花费宝贵的时间来玩，我真是感激不尽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460141,
						705460142
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460141,
					"content": "这下我们成第一个试玩的了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460143
					]
				},
				{
					"id": 705460143,
					"content": "既然是嘟嘟可勇斗角角鱼的续作，是不是最应该邀请火花骑士来玩呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460144,
					"content": "呜！考虑到新游戏借用了嘟嘟可的形象，我就无比荣幸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460145
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460145,
					"content": "所以我想让「嘟嘟可砰砰历险记」更精彩、有趣，尽量在火花骑士大人玩到它之前，改进更多不足之处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460146
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460146,
					"content": "哼哼，我明白了！这次我们身兼多职，要帮你测试新装备，要担任游戏的捉虫玩家，也要负责之后让可莉开开心心玩玩它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460147,
						705460148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705460147,
					"content": "正合我意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460149
					]
				},
				{
					"id": 705460149,
					"content": "一拍即合，我和荣誉骑士，还有白色小帮手的默契增进了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460150
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460150,
					"content": "只是看着你们玩游戏，我的热情也会涌上来！那事不宜迟，我们现在就开始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460148,
					"content": "为了可莉和好玩的游戏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460149
					]
				},
				{
					"id": 705460142,
					"content": "唔，是不是还忘了一个人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460143
					]
				},
				{
					"id": 705460128,
					"content": "给我也来一台？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460129
					]
				},
				{
					"id": 705460129,
					"content": "我的预感果然没错，荣誉骑士也是个爆炸物爱好者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460130
					],
					"speakerTitle": "艾玛托"
				},
				{
					"id": 705460114,
					"content": "你们是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460115
					]
				},
				{
					"id": 705460115,
					"content": "嗯…作为西风骑士团里不起眼的部件，荣誉骑士没听说过，或是不记得我们，都没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460116
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460116,
					"content": "我是调查小队的信号官方妮雅，负责试验炼金探测设备。她是我的同僚，武器官艾玛托，对爆炸物有着…独特的嗜好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460117
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460117,
					"content": "上次我们负责应对须弥「角鲀」入侵果酒湖事件，行动还算顺利，距今有些年月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460118
					],
					"speakerTitle": "方妮雅"
				},
				{
					"id": 705460118,
					"content": "在那之后，艾玛托认为，只靠远距离投放炸弹，还是存在不小的作战死角，而且面对一些屏蔽物和掩体时不够有效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460119
					],
					"speakerTitle": "方妮雅"
				}
			]
		}
	]
}