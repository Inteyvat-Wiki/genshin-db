			"dialogs": [
				{
					"id": 700890101,
					"content": "咦，这里怎么有个人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890102,
					"content": "也不是这个风神像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890103,
					"content": "喂，你在干什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890104,
					"content": "我在找回去的路。我只记得要找风神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890105,
					"content": "其他的我也什么都不记得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890106,
					"content": "回去的路？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890107,
					"content": "隐隐约约的一种乡愁，但是我什么都不记得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890108,
					"content": "我醒来的时候，手里只有一张写了「你是『莫基』」的纸条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890109,
					"content": "所以我想我名字应该就是「莫基」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890110,
					"content": "不打扰你们了。再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "「莫基」"
				},
				{
					"id": 700890111,
					"content": "好奇怪的人。不过应该不是坏人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890112,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700890113,
					"content": "看到了奇怪的景象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "奇怪的景象？难道是因为刚才那个人碰了神像吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
