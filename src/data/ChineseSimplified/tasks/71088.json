			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710880201,
					"content": "你好！啊，原来是你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880221
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880221,
					"content": "哈，他们还真把你给找来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880202,
						710880203
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880202,
					"content": "没错，是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880204
					]
				},
				{
					"id": 710880204,
					"content": "哎哟，失礼失礼！我叫海迪夫，海迪夫·普尔希纳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880205
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880205,
					"content": "哈哈，如果你了解学院历史的话，我们的祖师们在星相学上曾是普尔比鲁尼一系的宿敌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880206,
						710880208
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880206,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880207
					]
				},
				{
					"id": 710880207,
					"content": "不必特意自我介绍啦，你的大名我早已有所耳闻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880211
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880211,
					"content": "你在这里做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880212
					]
				},
				{
					"id": 710880212,
					"content": "我是总务司特约的调查学者，负责在层岩巨渊重新开放之前进入矿井调查生物群落变化情况，以及考察古生物种群…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880213
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880213,
					"content": "当然，作为交换条件，我需要将研究成果与璃月本地的历史学会共享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880214
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880214,
					"content": "唉，我知道你想说什么…原则上这是违反教令院规则的，但璃月方面表态强硬，没人能让他们有所动摇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880215
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880215,
					"content": "另外呢，由于勘探队名义上是由我牵头的，我还要负责营地所有矿工的开销…唉，要是得不偿失可就太亏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880216,
						710880217
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880216,
					"content": "是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880218
					]
				},
				{
					"id": 710880218,
					"content": "不过没关系的，不需要安慰我。我很有钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880219
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880219,
					"content": "好吧，告辞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880220
					]
				},
				{
					"id": 710880220,
					"content": "再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880217,
					"content": "真是不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880218
					]
				},
				{
					"id": 710880208,
					"content": "自报师门是须弥传统吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880209
					]
				},
				{
					"id": 710880209,
					"content": "哈哈，不是这样的。怎么说…算是身为学者的自矜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880210
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880210,
					"content": "说起来还都怪阿妮萨学姐那家伙…把普尔比鲁尼一门的坏毛病传染给我咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880211
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710880203,
					"content": "我认识你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880204
					]
				}
			]
		},
		{
			"id": 7108803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108802",
							"2"
						],
						"stepId": 7108802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710880301,
					"content": "哟，是新面孔，你好，年轻人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880302
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880302,
					"content": "新面孔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880303
					]
				},
				{
					"id": 710880303,
					"content": "哈哈…矿上的每一个人不好说认识吧，至少都能叫得出名字。不过你嘛…是第一次来矿上，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880304
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880304,
					"content": "#{NICKNAME}，幸会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880305
					]
				},
				{
					"id": 710880305,
					"content": "瑾武，管设备的。在矿上干了二十来年，算是这帮小伙子的大姐。有什么不懂的可以来找我，设备出毛病了找我也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880306
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880306,
					"content": "或者，单纯听大姐闲扯两句历史故事什么的，我也欢迎。闲着也是闲着嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880307,
						710880316,
						710880323,
						710880326
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880307,
					"content": "关于层岩巨渊的历史…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880308
					]
				},
				{
					"id": 710880308,
					"content": "那可就说来话长了…我就给你简短介绍一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880309
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880309,
					"content": "层岩巨渊是璃月最大的矿产基地，也是天衡山矿区之后第二古老的矿区。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880310
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880310,
					"content": "传说在岩王爷到来之前，这里就居住着以开采琉璃晶砂、交易陶瓷制成品为生的部族…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880311
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880311,
					"content": "后来这些部族与岩王爷的夜叉信使歃血为盟，自成一支，于是便成为了今日八门之一——盛露厅的前身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880312
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880312,
					"content": "他们也参加了镇压若陀龙王与击退漆黑灾祸的大战…可谓劳苦功高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880313
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880313,
					"content": "你看，西北面的那座谷地…传说就是当年岩王爷将若陀龙王拖离层岩巨渊，活生生拖出来的痕迹呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880314
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880314,
					"content": "后来呀，待到褪尽蛮荒，习惯了城市生活的部民便随岩王爷迁入城中，专以制造和贩卖瓷器为业，不再顾兵戈之事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880315
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880315,
					"content": "哈哈…所以别看盛露厅如今都是些斤斤计较的瓷器商人，祖上也是同岩王爷并肩打过硬仗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880316,
					"content": "关于层岩巨渊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880317
					]
				},
				{
					"id": 710880317,
					"content": "几年前矿区封锁时我也在场，听说下层的小伙子们挖到了不得了的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880318
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880318,
					"content": "我光记得那时候伤员被接连不断地运上地面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880319
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880319,
					"content": "更邪门的是，小伙子们受的伤并不是矿下面常见的工伤，而是…呃，有点像精神上的打击，你懂吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880320
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880320,
					"content": "把小伙子们送到地面之后，他们过几天就慢慢恢复正常了…虽然没造成什么严重损失，但还是引起了七星的震动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880321
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880321,
					"content": "不管他们挖到了什么，一定不是什么好东西就对了。玉京台的大人们可能也是这样想的…就全面封锁了层岩巨渊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880322
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880322,
					"content": "结果呢，盛露厅可不高兴了…哈哈，那就是另一个话题咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880323,
					"content": "关于你的工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880324
					]
				},
				{
					"id": 710880324,
					"content": "我？管设备的。二十来年了，别人家孩子上学的年纪我就在鼓捣晶石矿灯和滤水器了，没什么好说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880325
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880325,
					"content": "#{M#认识了一拨又一拨矿工，初次下矿时也比你大不了多少。}{F#女孩子可不要做这种工作，像我一样把大好时光浪费在矿上，整天一身臭汗忙来忙去，不值得的。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880326,
					"content": "关于「七星阵法」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710880327
					]
				},
				{
					"id": 710880327,
					"content": "那是「七星」专门设立的阵法，为的就是防君子不防…哈哈，不开玩笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880328
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880328,
					"content": "总之，这阵法在行政上是最高级别的封印，任何人看到它就会自然想到，擅自解封的话，要面临什么样的问责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880329
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880329,
					"content": "所以呢，「七星」专门以过于显眼的「磐键」作为固定阵法的节点，也是为了显示权威…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880330
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880330,
					"content": "让小贼们即使有贼心，也没有贼胆大张旗鼓地解除封印，引得大人物震怒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710880331
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710880331,
					"content": "咳咳…换句话说，如果有人真的解除了封印，而没有受到有效干涉…就证明那家伙至少得到了「七星」的默许。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		}
	]
}