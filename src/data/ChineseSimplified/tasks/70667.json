				"objectNames": [
					"「小王子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是专家牌手了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670202,
					"content": "「这样就有资格挑战更多的牌手了…对了，虽然之前你就已经可以了，但我再提醒一下，你可以在邀请板悬挂战书…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670203,
					"content": "喵…「这样，想要挑战你的牌手都能撕下你的战书。哼，不知道对手是谁的对局，有的时候也是挺有趣的事…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670204,
					"content": "「毕竟，相约进行牌局，也是一种相遇的方式。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680204,
					"content": "#喵！「啊！扯远了，那么作为专家牌手的特权，现在的{NICKNAME}有资格购买一些牌面好看的不得了的卡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670205,
					"content": "#「嗯嗯…{NICKNAME}，勿忘游乐之心，希望你能感受到『七圣召唤』的乐趣！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「小王子」"
				}
			]
		},
