				"objectNames": [
					"小千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "欢迎试玩「玲珑霄灯图」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580102,
					"content": "咦？这些灯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "是你啊，来得正好，你上次解开了那盏灯之后，我特意又换了几盏灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580104,
					"content": "怎么样，要不要再试试解读一下？这次可没上次那么简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580105,
					"content": "是映出来的图案更复杂了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "不不，图案还是很好理解，也只分成三份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580107,
					"content": "这次的难度，是在「转灯的方式」上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580112,
					"content": "哦！对了，这次要拼出来的图案是<color=#00E1FFFF>「摩拉」</color>，记住了啊，拼好了正确的图案之后，才能去找宝藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				},
				{
					"id": 413580108,
					"content": "是转灯的方式更难了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "嘿嘿，这次的三盏灯可是<color=#00E1FFFF>「连轴」</color>的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580110,
					"content": "简单来说，就是当你转一盏的时候，说不定另外一盏也会跟着转。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580111,
					"content": "好了，你就自己去体会一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "小千"
				}
			]
		},
