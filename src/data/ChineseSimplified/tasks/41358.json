					"content": "已经找到全部宝藏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "全部都找到了？你寻宝的功夫真还挺…出色的，好多人过来，转了一下灯就走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413580204,
					"content": "既然你找到了全部的宝藏…那这些奖励给你，收下吧，祝你在海灯节玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
