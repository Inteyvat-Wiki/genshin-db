				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "真不错…这「猫尾酒馆」的酒真不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010102,
					"content": "什么酒馆？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "咦？呃…是旅行者啊，你…你不知道「猫尾酒馆」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010104,
					"content": "看你样子，肯定没怎么听说过，也没怎么光顾过…欸，你可是亏大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010105,
					"content": "「猫尾酒馆」里面可是有不少奇妙特调，这些特调的味道你绝对从未尝试过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010106,
					"content": "而且，「猫尾酒馆」就和它的名字一样，里面还有很多，很多的可爱小猫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010107,
					"content": "在那么多可爱小猫的围绕下，喝着美味的特调酒…总是会让人不由自主地忘记时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010108,
					"content": "现在「猫尾酒馆」在营业中吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "呃…可你看上去，好像还没到可以喝酒的年纪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010111,
					"content": "不过没关系，没关系！那位叫做迪奥娜的调酒师，可是蒙德城最棒的调酒师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010112,
					"content": "给你调制一杯不含酒的饮品…对她来说应该也不在话下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010113,
					"content": "而且，那位叫做迪奥娜的调酒师也很可爱，就像是只小猫一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010114,
					"content": "嗝…嗝！说出来了，不行不行，你、你可别告诉迪奥娜，我说过这个词啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010115,
					"content": "不啰嗦了，你要是想去「猫尾酒馆」的话，酒馆的门就在后面，你直接过去就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010116,
					"content": "我…呃！我去旁边醒醒酒，之前喝了太多，看来喝不动第五轮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "宁禄"
				},
				{
					"id": 191010109,
					"content": "我也想去试试…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}