			"dialogs": [
				{
					"id": 730390101,
					"content": "哥哥们已经好好反省过了，无忧节是快乐的日子，兰帕卡提不应该再生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730390102,
					"content": "对，兰帕卡提不要再生气了，快乐的日子，应该拿出「快乐的味道」来庆祝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730390103,
					"content": "是时候展示「烹饪修行」的成果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730390104,
					"content": "早就准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730390105,
					"content": "嗯嗯！是无忧节大餐！我期待好久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730390106,
					"content": "好耶！无忧节大餐！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "有桓那兰那的水，最好的水，能做出最好的汤，那菈喝了一定满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730390109,
					"content": "#要把「快乐的味道」送给那菈{NICKNAME}和派蒙，应该让那菈{NICKNAME}和派蒙来「指导」哥哥们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730390110,
					"content": "只有这样，才能做出让那菈满意的菜肴，这才是招待「客人」的「礼节」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730390111,
					"content": "#那菈{NICKNAME}，愿意「指导」哥哥们的烹饪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730390107,
					"content": "最好不要太过期待…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
