			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰帕卡提",
					"兰茶荼",
					"兰萨卡",
					"兰阿帕斯",
					"兰非拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#嗯，还是得{NICKNAME}帮帮忙才行，不然又会做出和之前一样的菜肴呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730391201,
					"content": "依照之前派蒙想到的改善方式，指导兰那罗将菜肴完成了。\\n随后，和兰那罗一起享用…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "怎么样？正宗的那菈美食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730391203,
					"content": "#唔…虽然是兰帕卡提提议，让那菈{NICKNAME}来指导哥哥们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391204,
					"content": "那菈的菜…这、这就是那菈的「快乐的味道」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730391205,
					"content": "快乐都要逃走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "兰萨卡"
				},
				{
					"id": 730391206,
					"content": "桓那兰那的水…明明是「最好喝的水」…怎么会煮出这种东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "兰阿帕斯"
				},
				{
					"id": 730391207,
					"content": "但是「鲜嫩无朋之果」还是一样好吃…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "兰非拉"
				},
				{
					"id": 730391208,
					"content": "欸？怎么会这样？兰那罗都觉得难吃吗？我觉得很美味啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730391209,
					"content": "虽然不知道什么是「难吃」…唔…很有「冲击力」的味道，像跑得太快撞到树干上一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391210,
					"content": "哇…这…这一定是那菈文化和兰那罗文化的碰撞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730391211,
					"content": "#不过，哥哥们，真不好。你们要谢谢那菈{NICKNAME}才对，怎么能说这些话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391212,
					"content": "呜呜…对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730391213,
					"content": "不是啦！要说谢谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391214,
					"content": "#谢谢那菈{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "兰茶荼"
				},
				{
					"id": 730391215,
					"content": "#不过…那菈{NICKNAME}和派蒙吃得开心，就好！不管那些笨蛋哥哥。只要那菈朋友开心，我们就很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391216,
					"content": "#不过，那菈{NICKNAME}和那菈法留纳，一点也不一样。那菈法留纳，那时候说了好多「{M#哥哥}{F#妹妹}」的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391217,
					"content": "#但是，那菈{NICKNAME}说话很少。不舒服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391218,
					"content": "#唔…{NICKNAME}，说点什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730391219,
					"content": "谢谢关心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#是这样吗？既然那菈{NICKNAME}没事就好。嗯，谢谢你们。这些小花，是兰帕卡提和哥哥们，送给那菈{NICKNAME}还有派蒙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391223,
					"content": "#希望那菈{NICKNAME}和派蒙，在桓那兰那得到更多「快乐的味道」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰帕卡提"
				},
				{
					"id": 730391220,
					"content": "（保持沉默）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#…总之，兰帕卡提不用担心！{NICKNAME}没问题的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "派蒙"
				}
			]
