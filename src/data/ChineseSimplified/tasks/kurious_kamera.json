			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "奇了怪了，这架「留影机」是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010102,
					"content": "这架「留影机」怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "好像是坏了…还是什么，总之就是不灵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010104,
					"content": "我之前在枫丹那边订了一批「留影机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010105,
					"content": "卖「留影机」的人说，这批「留影机」是他们枫丹的最新技术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010106,
					"content": "说是可以让印出来的画有特殊的色调，带有特殊的效果什么的，我就买了一台过来想要试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010107,
					"content": "结果不知道是我操作有问题，还是这台「留影机」本身就有问题，怎么弄都印不出来正常的画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010108,
					"content": "难道，真是我用这机器的方法有问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010109,
					"content": "对了，你了解「留影机」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010110,
					"content": "还算是了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "那太好了，能请你帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010114,
					"content": "看你的样子，是旅行者对吧？一定去过很地方，见识也很广。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010115,
					"content": "我想请你帮我用这台「留影机」去拍点「颜色」很强烈的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010116,
					"content": "拍好了之后，请再把印出来的画拿给我，我想看看，这「留影机」到底是哪里出了问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010117,
					"content": "实在不行，我就拿着这些画去找那个人问问去。有这些画做证据，我也不怕他不认账。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010118,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414010120,
					"content": "什么叫做「颜色」很强烈的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "唔，就是那种…色调特别明显的，比如红色的绝云椒椒啦，蓝色的冰雾花啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010122,
					"content": "拍好了之后，就请把印出来的画拿来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414010112,
					"content": "没接触过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "唔…倒也没关系，这东西的操作还算简单…能请你帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "季同"
				}
			]
		}
	]
}