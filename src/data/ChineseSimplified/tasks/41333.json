					"铁块儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "「铁块紫微一相逢」…不行不行，这也太直接了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330202,
					"content": "嗯？你们什么时候来的，地点都找过了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330203,
					"content": "都找过了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "这么快？我来看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330205,
					"content": "嗯…让我看看…一个重重叠叠别具一格，一个鳞次栉比错落有致…真是「横看成岭侧成峰」…下一句是什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330206,
					"content": "…算了不管了，还是从正面看过去亮亮堂堂的比较气派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330207,
					"content": "嗯，好！我知道选哪里了…旅行者，我还想请你再帮我一个小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330208,
					"content": "我兄弟说，和人家说话的时候，最好还得备点吃食，你觉得，我和紫微说话的时候，准备什么好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330209,
					"content": "烤吃虎鱼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "烤吃虎鱼…哎呀，会不会太油了点，有点不太讲究，不然还是杏仁豆腐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330212,
					"content": "对，杏仁豆腐，这个合适！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330213,
					"content": "旅行者，拜托你帮我去准备一份杏仁豆腐吧，我接着琢磨一下，这诗该咋整…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330214,
					"content": "「撞出火花无数」…这句不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330211,
					"content": "杏仁豆腐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
