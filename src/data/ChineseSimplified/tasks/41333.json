		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紫微"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "这个角度…这个星座…好像一条狗啊…起什么名字好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330702,
					"content": "哦，是铁块儿啊？你们找我有什么事么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330703,
					"content": "呃…那个…就是…我在璃月港外面随便走了走，偶然发现了一个好地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330704,
					"content": "好地方？是观星的好地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330705,
					"content": "是，是观星的好地方，也是放霄灯的好地方。我霄灯都准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330706,
					"content": "你看，我在上面还写了…写了一首诗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330707,
					"content": "「铁锹陨星一相逢，便撞出火花无数」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330708,
					"content": "嗯…虽然我不知道你要许什么愿，但这诗是很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330709,
					"content": "不过霄灯上的愿望可不能提前让人家看到，不然会不灵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330710,
					"content": "然后，你今天来找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330711,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330712,
					"content": "他找了个很合适放霄灯的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "放霄灯？哦…抱歉，其实我正想找个霄灯少点的地方呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330715,
					"content": "因为霄灯的光照有点影响观星，我打算再走远点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330716,
					"content": "谢谢你们的好意，我要再往那边走一走了，希望你们海灯节玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330717,
					"content": "啊…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330718,
					"content": "走掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "我…我没事，一定是我写得太隐晦了，紫微没有看懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330721,
					"content": "放心，我不会气馁的，总有一天…她会明白我的心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330722,
					"content": "旅行者，谢谢你帮我的忙，这些东西请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330723,
					"content": "唉，我至少要把这盏霄灯给放了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330719,
					"content": "不要气馁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "你要放霄灯的话，不如和他一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
