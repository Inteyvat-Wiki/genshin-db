					"id": 413330401,
					"content": "嗯…怎么感觉…闻起来就怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330402
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330402,
					"content": "这怎么能端给紫微，你再帮我换份好的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁块儿"
				}
			]
		},
		{
