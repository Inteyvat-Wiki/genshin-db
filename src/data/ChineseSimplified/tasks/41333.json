			"trigger": {
				"objectNames": [
					"铁块儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "「九天玄罗仙人漫天飞座」…真美啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330102,
					"content": "你是在看星星吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "是…也不是，这不是海灯节吗？看点这种文雅的东西，应景嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330104,
					"content": "我还学着写了点诗咧，听其他兄弟说，现在的女孩子都喜欢这种调调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330105,
					"content": "嗨，紫微也一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330106,
					"content": "写诗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "咳咳…我可是从紫微那听说了不少星座的名字，哎呀…那些名字可好听了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330109,
					"content": "你看，我总得感谢一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330110,
					"content": "我就想，我自己作首诗写在霄灯上，和紫微一起找个好地方放了…吃着零食唱着歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330111,
					"content": "——这好事不就成了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330112,
					"content": "成了…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "咳！我是说…这个节日的氛围，不就成了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330114,
					"content": "总之，我想找个气氛好点，路人少一点，景色漂亮点的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330115,
					"content": "我还特意找人问过了，找到了两个好地方…你看看，就这俩地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330116,
					"content": "我听其他兄弟说，他们以前都是在这俩地方放霄灯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330117,
					"content": "不过我还得作诗呢…随便乱跑连灵感都要跑丢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330118,
					"content": "你看能不能帮我跑一趟考察考察？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330119,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "多谢你愿意帮忙，那就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330107,
					"content": "紫微？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
