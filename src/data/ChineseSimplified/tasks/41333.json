				{
					"id": 413330301,
					"content": "嗯？你们什么时候来的，杏仁豆腐准备的怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "铁块儿"
				},
				{
					"id": 413330302,
					"content": "准备好了",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "还需要一点时间…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "哎呀没事，我也得再想想这诗该咋写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "铁块儿"
				}
