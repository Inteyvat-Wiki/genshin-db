				]
			},
			"dialogs": [
				{
					"id": 748000401,
					"content": "你怎么又躲起来了，这周围什么也没有啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000402,
					"content": "你没看见那台警卫机关吗？就在我们面前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000403,
					"content": "它…怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "嘘，快点离开那边，这警卫机关要是失控了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000406,
					"content": "或者它…它的能源核心突然发生爆炸，或者是被人遥控着攻击我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000407,
					"content": "但它一切正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "这正是我害怕的。一个原本正常的机关突然失控，让某个倒霉蛋丢了命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000409,
					"content": "这件事不会有任何人为其负责，说不定连作案主使都找不到…实在是太危险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000410,
					"content": "它已经走了喔，你可以出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000411,
					"content": "喔，它真的没有失控，真是出乎预料。我们又捡了一条命啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000412,
					"content": "根本就不可能出现这种意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "我所想要构想的，就是一场「人为营造的纯粹意外」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000415,
					"content": "等等。没有主使…不会由任何人单独为其负责的案件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000416,
					"content": "对！我有灵感了，快，快，我们去咖啡馆，我必须得快点写下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000417,
					"content": "喂！跑慢点啊，你不怕有人突然丢块石头绊倒你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000413,
					"content": "它从一开始就不可能失控好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "呃…然后呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
