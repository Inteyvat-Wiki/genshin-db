			},
			"dialogs": [
				{
					"id": 748000501,
					"content": "对，没错…就是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000502,
					"content": "咖啡要凉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "我都已经喝完了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#好的，谢谢你，{NICKNAME}。多谢一路护送我过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000505,
					"content": "说是护送…其实我们只是跟着你走了一路而已，什么也没做啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000506,
					"content": "什么坏事也没发生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "你也没遇见什么危险。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "是的。看来我的确是想太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000509,
					"content": "这咖啡味道真不错，哈哈…哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000510,
					"content": "…你说，会不会有人在里面下毒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000511,
					"content": "…咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "你、你少说两句！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "胡说，我们都喝完了，一点事也没有啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000514,
					"content": "不不不，也许是一种…特别的下毒方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000515,
					"content": "首先，下毒的人在我们喝的咖啡里倒入了第一种药物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000516,
					"content": "单独服用这种药物，不会对服用者造成任何影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000517,
					"content": "当我们全部服下了这种药，离开这里回家的时候，下毒者就会偷偷尾随我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000518,
					"content": "等我们睡着，他们就潜入房里，在我们的水壶里倒入第二种药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000519,
					"content": "这样，等我们第二天带着水壶出行，并且喝下水壶里的水时，两种药物就会起反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000520,
					"content": "我们就会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "吉雅罗"
				},
				{
					"id": 748000599,
					"content": "一阵急促的脚步声突然靠近…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "这位客人，你到底在说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 748000522,
					"content": "咖啡？下毒？请不要在我的店里开这种玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 748000523,
					"content": "如果影响到其他客人，我就要请你出去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 748000524,
					"content": "店长，我来解释…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "她是我的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "向阿鲁埃讲述了吉雅罗的事。听完后，阿鲁埃无奈地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "为了道歉，吉雅罗又买了三杯咖啡…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
