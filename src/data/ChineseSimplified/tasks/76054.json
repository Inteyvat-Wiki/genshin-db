			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "咦？哥伦比娅呢？怎么没见到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540102,
					"content": "我在这边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540103,
					"content": "哇！你在这么高的地方做什么啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540104,
					"content": "上来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540105,
					"content": "嗯？这次又是要干什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540106,
					"content": "还记得我们上次出去收集的石头吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540107,
					"content": "上次？哦，是说吸收了月矩力后会发光的那种矿石对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540108,
					"content": "对。那之后月灵们又收集了一些，我将这些石头处理了一下，大致分为了深色和浅色的两类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540109,
					"content": "深色和浅色？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540110,
					"content": "当然是用来玩「月亮棋」呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540111,
					"content": "欸？什…什么是「月亮棋」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540112,
					"content": "你们没玩过吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540113,
					"content": "没有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "这样吗…以前看「霜月之子」的孩子们在地上画格子的时候，我就想试试了。但没人能陪我玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540115,
					"content": "具体规则是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540116,
					"content": "唔…这样说明容易些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540117,
					"content": "哦！好…好厉害…你怎么做到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540118,
					"content": "嗯？就很简单地运用月矩力而已，你们做不到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540119,
					"content": "不要以神明的标准来要求我们啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540120,
					"content": "好吧。这就是棋盘，或者说是游戏中的「夜空」。然后两个人手中的棋子代表了你所拥有的「月亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540121,
					"content": "两人交替将「月亮」放到「夜空」上，谁的三个月亮最先连成一条线，谁就获胜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540122,
					"content": "哦！总之就是三颗棋子连成一条线的游戏对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540123,
					"content": "这游戏在挪德卡莱居然叫「月亮棋」…还真是有本地特色呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540124,
					"content": "不过，「月亮」是会轮替的，天空中无法存在三个以上的「月亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540125,
					"content": "所以当「夜空」中的「月亮」达到一定数量之后，最开始升上的「月亮」就会消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540126,
					"content": "还…还挺有道理…也给这游戏加了不少难度呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540127,
					"content": "嗯，要试试吗？我也是第一次玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540128,
					"content": "（她看起来很期待的样子呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "嘿嘿，那我来给你们当裁判吧。这家伙脑子不错，你可要小心哟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760540130,
					"content": "好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
