			"dialogs": [
				{
					"id": 760540301,
					"content": "这样对吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540302,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540303,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540304,
					"content": "月亮…月亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540305,
					"content": "这里怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540306,
					"content": "这次是我赢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540307,
					"content": "我的三个月亮连起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540308,
					"content": "嗯，这样就赢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540309,
					"content": "嗯…月升月落，真是漫长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540310,
					"content": "我们的月亮谁都不让谁呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540311,
					"content": "是不是…快平手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540312,
					"content": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540313,
					"content": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540314,
					"content": "不喜欢这个游戏吗？我觉得还挺有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540315,
					"content": "嗯？你是在盯着我看吗？我感觉得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540316,
					"content": "我的脸上…有关于「月亮」的答案吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540317,
					"content": "棋盘在那边哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540318,
					"content": "嗯，是你的「月亮」获胜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540319,
					"content": "这片夜空属于你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540320,
					"content": "啊…一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540321,
					"content": "与哥伦比娅在游戏中度过了一段愉快的时光…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "谢谢你，我玩得很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540323,
					"content": "如果可以的话，下次也来陪我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540324,
					"content": "把这个，当做「约定」的证明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		}
	]
}