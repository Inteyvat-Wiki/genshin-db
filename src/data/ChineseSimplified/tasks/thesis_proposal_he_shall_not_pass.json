	"talks": [
		{
			"id": 7365001,
			"completionStepIds": [
				7365001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365001",
							"2"
						],
						"stepId": 7365001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"贾米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736500101,
					"content": "完蛋啦，唉…我的学术生涯还没开始，就已经夭折了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500102
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500102,
					"content": "当什么学者！当什么学者！早知道在教令院偷偷自学画画当个会画彩图的绘图师，也比现在有前途，呵呵…呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500103
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500103,
					"content": "之前就听说奥摩斯港有个教令院学者每天唉声叹气的…我还以为是什么奇怪的传说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500104,
					"content": "原来真的有，「唉声叹气教令院学者」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500105,
					"content": "嗯，什么？什么「唉声叹气教令院学者」…是说我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500106
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500106,
					"content": "唉…要是以前我非得就这个外号和你理论一番，现在就算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500107
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500107,
					"content": "小家伙，哪来的回哪去吧，别打扰一个前途渺茫的失志青年。像我这样的人就应该缩回森林最阴暗的角落当个蘑菇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500108
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500108,
					"content": "这样至少不会浪费教令院的学术资源…啊，说不定还有可能被当作什么特殊的蘑菇样品，被采集回来供真正有才能的学者解剖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500109
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500109,
					"content": "「作为实验样本的蘑菇贾米」，呵呵，说不定还能通过这样的方式留名研究史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500110
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500110,
					"content": "贾米…你的名字叫贾米吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500111,
					"content": "是啊，怎么了，小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500112
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500112,
					"content": "我才不是什么小家伙呢，我的名字叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500113,
					"content": "#我的名字是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500114
					]
				},
				{
					"id": 736500114,
					"content": "#{NICKNAME}和派蒙，行吧，我记住了，两位有什么事吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500115
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500115,
					"content": "我们只是听说了最近奥摩斯港有「唉声叹气教令院学者」的传言，所以想知道发生了什么事而已啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500116,
					"content": "唉…你们知道，对于须弥的众学者而言，有一件美妙的事，其名曰：「发表研究」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500117
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500117,
					"content": "只要可以独立「发表研究」，就能被证明是独当一面的学者，从导师那里毕业，正经进入学术界，赢得声望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500118
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500118,
					"content": "这样就可以以外出取材为由到提瓦特各地旅行，还可以用下拨的课题经费吃香喝辣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500119
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500119,
					"content": "吃香喝辣，那个，吃香喝辣的部分说得更详细一些嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500120,
						736500121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500120,
					"content": "噫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500122
					]
				},
				{
					"id": 736500122,
					"content": "只、只是口头说一说啦，我内心其实充满了想要在须弥学术界有所作为的宏大理想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500123
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500123,
					"content": "吃香喝辣啦，四处去旅行啦，变得有名啦，诸如此类的，只是我不怎么排斥的附带的部分…咳咳，说远了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500124
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500124,
					"content": "总之就是，我现在就卡在「发表研究」这一环，教令院各种课程本来时间就紧，还要在规定的时间内通过开题报告…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500125
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500125,
					"content": "结果光开题报告就被否了两次，第一次我说我想做「蕈猪背部蘑菇的食用价值」，唉，这多好的题目啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500126
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500126,
					"content": "听上去是需要反复进行实验的好课题呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500127,
					"content": "对吧，结果我的导师说什么「这有什么好研究的！」就给否了…真是莫名其妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500128
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500128,
					"content": "第二次我说我想研究「浮游水蕈兽的生态环境与养殖」，结果又被导师否了，说我胸无大志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500129
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500129,
					"content": "眼看开题报告的时间就要过去了，我就赌气写了个大的…当时就觉得「啊，该死的老头子，居然敢说我胸无大志！」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500130
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500130,
					"content": "本来只是赌气，结果课题提上去当天就被导师通过，还在学院内获得一致好评，呵呵…骑虎难下，我的课题正式变成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500131
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500131,
					"content": "变成了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500132,
					"content": "呵呵…变成了「生物结构在对敌应激时的防御缺陷研究」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500133,
						736500134
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500133,
					"content": "对敌应激，什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500135
					]
				},
				{
					"id": 736500135,
					"content": "听不懂，但是听上去是又不好吃又不好玩的研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500136,
					"content": "研究课题就是要稍微故弄玄虚一点啦，实际上就是在战斗中的生物，多多少少都会露出一些防御上的「破绽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500137
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500137,
					"content": "比如原本保护得很好的弱点部位，在进行一些动作的时候就会暴露出来…类似这样的，就是我需要收集的「破绽」的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500138
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500138,
					"content": "虽然不是很明白，不过听上去好像是个很厉害的课题呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500139,
					"content": "厉害有什么用，又要战斗，又要拍摄下素材作为研究论据，唉，我只是个柔弱的学者…也太强人所难了一点吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500140
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500140,
					"content": "我要怎么完成这个课题啊…唉，完不成课题，就没法毕业，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500141
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500141,
					"content": "算了，不就是去找那些魔物搏斗吗，呵呵…干脆我受个重伤，说不定导师看在我可怜的份上也会让我通过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500142
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500142,
					"content": "这可不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500143,
					"content": "唉…开题报告也提交了，根本没有换课题的时间，还能怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500144
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500144,
					"content": "身为学者，居然被一时冲动左右，不如喂长鬓虎算了…啊，不过那样有点痛，不如去维摩庄附近跳河吧，那里河水清凉干净…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500145
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500145,
					"content": "呜哇，好可怜…虽然有自作自受的成分，但是还是好可怜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500146,
					"content": "#{NICKNAME}，我们就帮帮他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500147,
					"content": "话都说到这份上了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500148
					]
				},
				{
					"id": 736500148,
					"content": "欸，真、真的吗，这可是很危险的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500149
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500149,
					"content": "没问题的！而且说起战斗，我们可是老手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500150,
					"content": "…真的，我的课题有救了，呜呜，如果能够成功完成报告，把我自己卖给你都行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500151
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500151,
					"content": "没必要那么夸张！而、而且我们也不想要你啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500152,
					"content": "不好意思有些激动了，那这样，我们这就去之前准备的试验场地吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500134,
					"content": "什么…防御…缺陷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500135
					]
				},
				{
					"id": 736500121,
					"content": "动机不纯呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500122
					]
				}
			]
		},
		{
			"id": 7365002,
			"completionStepIds": [
				7365002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365002",
							"2"
						],
						"stepId": 7365002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"贾米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736500201,
					"content": "没想到居然走到这么远的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500202,
					"content": "这也没有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500203
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500203,
					"content": "离奥摩斯港的距离也太远了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500204,
					"content": "毕竟也跟实验对象有关，虽然我的导师很希望我把全提瓦特所有生物都观察一遍，但是那怎么可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500205
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500205,
					"content": "所以就从须弥和璃月分布的开始研究起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500206
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500206,
					"content": "哦，对了，请拿好这个…这是我为了研究弄来的特殊药剂，能够在实验场地里生效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500207
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500207,
					"content": "其名为「溢神剂」！是阿弥利多学院的前辈做出来的药剂，造价高，工序复杂，我好不容易才做了这么一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500208
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500208,
					"content": "嗯？这个药剂和你的实验有什么关系呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500209,
					"content": "其实是这样，服用了「溢神剂」之后，服用者就会主观地觉得时间变得非常非常…非常非常慢，几乎和停了一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500210
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500210,
					"content": "这样就能进行更细致的拍摄和观察啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500211
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500211,
					"content": "咦，有了这样的药剂，你自己也可以做这个实验嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500212,
					"content": "唉…我本来也是这么以为的，但是事情哪有那么简单…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500213
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500213,
					"content": "我已经说了，是「主观上」变得非常慢…你的身体的反应其实还是跟不过来的，身体如果不够灵敏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500214
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500214,
					"content": "比如你在棘冠鳄飞扑过来的时候喝下「溢神剂」，但是你又没有反应能力躲避它的飞扑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500215
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500215,
					"content": "你就会看到它的爪子离你的脸始终有那么近，像是停在那里…可身体就是没法躲开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500216
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500216,
					"content": "「为什么身子不动呀！」你这么想，但是没有用，爪子还是离那么近，你甚至可以看清爪子上的污水与淤泥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500217
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500217,
					"content": "噫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736500218,
					"content": "所以，不要因为主观上觉得时间过得慢就轻敌了，这点请注意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736500219
					],
					"speakerTitle": "贾米"
				},
				{
					"id": 736500219,
					"content": "我会小心的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736500220
					]
				},
				{
					"id": 736500220,
					"content": "唉…我的研究，就交给两位了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贾米"
				}
			]
		}
	]
