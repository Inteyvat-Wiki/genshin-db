			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂玛乌斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "哎，旅行者，旅行者，请稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110103,
					"content": "呃，说起来，有点不好意思…有件事我想请你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110104,
					"content": "你也知道，我一直在研究炼金术，但一直没有什么新突破…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110105,
					"content": "如果一直这么循规蹈矩地研究下去，我的炼金术水平肯定也不会再有提升。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110107,
					"content": "你要研究生物炼金？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "你要研究古代炼金？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "所以，我找了个与众不同的切入点，想要开始一场新研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110108,
					"content": "那个啊，那个已经有人研究了，算不上什么与众不同的切入点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110110,
					"content": "古代炼金？呃，那个还不是我能够涉足的领域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110111,
					"content": "嗯…你知道炼金术里最重要的是什么吗？是「元素」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110112,
					"content": "在一般的炼金过程中，因为各种原因，所用的材料一般都是某种有元素附着的材料，而不是纯粹的元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110113,
					"content": "使用这种材料，会在炼金的过程中产生杂质。这种杂质会影响元素反应的效率…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110114,
					"content": "不仅元素材料要加大剂量，还要时刻观察，防止那些杂质直接影响到炼金过程，导致炼金失败…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110115,
					"content": "但对于没有「神之眼」的人来说，想要进行炼金，这也是不得不接受的额外成本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110116,
					"content": "而且最大的问题是，购置那些元素材料的费用，实在是太高了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110117,
					"content": "一场炼金术结束，账单比炼金成果更令人在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110119,
					"content": "我也没有「神之眼」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "那你找我做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "唉，也许就是因为这样，我的炼金术才始终没有突破吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110120,
					"content": "对…不过我听说了，你还是能操纵元素力，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110122,
					"content": "虽然你没有「神之眼」，但我听说了，你能操纵元素力，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110123,
					"content": "是这样，我研究出了一种新的炼金炉，我叫它<color=#00E1FFFF>「原素烘炉」</color>，它的原理是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110124,
					"content": "呃，简单来说，就是一个能容纳纯粹的元素，并且能让它们互相反应的器皿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110125,
					"content": "用这个「原素烘炉」炼金出来的成果，说不定能让我的炼金水平有所突破…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110126,
					"content": "现在万事俱备，只缺一个能够自由操纵元素力的人，来帮我「运输」一下那些纯粹的元素了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110127,
					"content": "如果你愿意的话，请到<color=#00E1FFFF>千风神殿</color>来找我吧，我已经拜托人把设备安装好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110128,
					"content": "希望这次，我的炼金术能有所突破…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂玛乌斯"
				}
			]
		},
