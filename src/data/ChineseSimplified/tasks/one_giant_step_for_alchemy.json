			"dialogs": [
				{
					"id": 409110301,
					"content": "你来了，这就是我的<color=#00E1FFFF>「原素烘炉」</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110302,
					"content": "多余的话也不说了，我们赶快开始试验吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂玛乌斯"
				}
