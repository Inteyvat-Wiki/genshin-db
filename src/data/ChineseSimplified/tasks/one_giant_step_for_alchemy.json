					"蒂玛乌斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "只要再多启动几次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110402,
					"content": "旅行者！你来得正好，还记得那座「原素烘炉」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110403,
					"content": "在你启动「原素烘炉」之后，我在旁边也搜集了不少数据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110404,
					"content": "而且最重要的是，我已经确定了它的可靠性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110405,
					"content": "有了这么一座可靠的器材，接下来就可以进行更多的实验了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110406,
					"content": "旅行者，如果你愿意的话，能帮我再去启动一下「原素烘炉」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110407,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110409,
					"content": "要实验多少次？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "当然是越多越好，像我这种没有「神之眼」的炼金术师，只能用这种笨办法来研究了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 409110411,
					"content": "所以就拜托你了，旅行者，帮我再去启动一下「原素烘炉」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂玛乌斯"
				}
			]
		}
	]
