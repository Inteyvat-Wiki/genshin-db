					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "…那么，就拜托两位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190102,
					"content": "就交给我们了，放心吧，珊瑚小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190103,
					"content": "居然在我们眼皮底下藏了这么久，真是胆大包天的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190104,
					"content": "而且，还用…那种身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190105,
					"content": "不管怎么样，他犯案的日子今天就要到头了。龙二，我交代你的事你记住了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190106,
					"content": "是，社长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190107,
					"content": "那就好…旅行者，你也来了啊，那太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190108,
					"content": "是要去抓犯人了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "证据已经搜集充足，犯人的行为我也已经摸清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190112,
					"content": "旅行者，你就和龙二，还有安藤先生和天野先生同行，让那个犯人伏法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190113,
					"content": "那家伙应该有不少同伙，有你在的话，行动成功的把握就更大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190114,
					"content": "我要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "用你那无敌的气势震慑住犯人就好，免得他做出什么…不太明智的举动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190116,
					"content": "不过，我想这种只会偷偷摸摸的盗贼，应该也没有做出什么激烈举动的气魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190121,
					"content": "如果我估计得没错，现在那家伙应该已经去了野外，准备把新一批的赃物埋在地里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190122,
					"content": "你们现在过去，应该刚好可以人赃并获。快出发吧，我在这里等你们的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190117,
					"content": "你不一起去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "对我来说，这桩案子已经结束了，剩下的事我就不参与了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190119,
					"content": "旅行者，你就去用你那无敌的气势震慑住犯人吧。免得他做出什么…不太明智的举动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190120,
					"content": "不过，我想这种只会偷偷摸摸的盗贼，应该也没有做出什么激烈举动的气魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190109,
					"content": "是要结案了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "嗯，只要一切顺利，今天就可以结案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201902,
