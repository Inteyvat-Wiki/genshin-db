				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "…安藤和天野应该已经带着犯人回奉行所了。事情就是这样，社长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190402,
					"content": "嗯，知道了，这样解决了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190403,
					"content": "旅行者，你也回来了啊，这次辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190404,
					"content": "就…这么完了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "毕竟人是天野和安藤带走的，有这种感觉也正常。拿着这些报酬吧，这样你多少会有点「实感」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190407,
					"content": "那你的报酬呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "我？能够帮助奉行所的大人们侦破案件，让这条街恢复平静，对我来说就是最大的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190412,
					"content": "但老实说，这次我确实能算是「一无所获」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190413,
					"content": "既没有见识到新奇的犯罪手法，也没有听见新奇的犯罪理念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190414,
					"content": "只不过是毫无趣味的一般犯罪而已，还好没有费太大的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190415,
					"content": "珊瑚社长…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "怎么？你第一次见到我这种对「犯罪」感兴趣的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190419,
					"content": "这种对于「犯罪」的兴趣，也是我成为侦探的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190420,
					"content": "…你也想「犯罪」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "对啊。我可是很想「犯罪」的。我想进行一场完美的，毫无破绽的「犯罪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190422,
					"content": "但可惜的是…人在犯下罪案的时候，几乎都会留下痕迹。只要留下了痕迹，这桩罪案被侦破也是早晚的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190423,
					"content": "如果不是人犯的罪呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "你瞧，你也不由自主地开始思考起「犯罪」了，对不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190427,
					"content": "没什么好不安的，你也只不过是思考一下而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190428,
					"content": "我也经常对「犯罪」进行思考，比如犯罪的手法啦，犯罪的理由啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190429,
					"content": "你思考这些做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "当然是为了能更好地侦办案件啦。最近我接手的案件越来越复杂，不思考可不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190431,
					"content": "不过，那些案件里倒是也没有一桩能称得上是「完美犯罪」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190432,
					"content": "那你见过「完美犯罪」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "见过喔。那桩「完美犯罪」…我到现在也没能找出真正的犯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190434,
					"content": "不过，我还是相信，只要是人犯下的案件，就一定会留下痕迹，我只不过是…还没有发现那些痕迹而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190435,
					"content": "好了，这些报酬给你，谢谢你帮我的忙，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190436,
					"content": "以后有空了记得多来转转，没空的话…嗯…也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190437,
					"content": "我的直觉告诉我，我们还会有机会再一起联手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190424,
					"content": "如果犯人不存在呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "怎么清除全部痕迹呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "这就是「侦探」吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "也不能这么一概而论。但就我个人而言，是对「犯罪」很感兴趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190409,
					"content": "你什么都不要吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "我已经收获了「正义」，除此之外，我也不需要什么了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190411,
					"content": "…我是不是应该这么说比较好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190405,
					"content": "没什么结束的实感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
