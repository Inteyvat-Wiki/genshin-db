			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190601,
					"content": "你们现在过去，应该刚好可以人赃并获。快出发吧，我在这里等你们的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190602,
					"content": "怎么，还有什么事吗？旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190603,
					"content": "你看上去情绪好像不高。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "一桩没什么意思的案子，一个没什么意思的犯罪者，犯罪的手法也称不上精致，只不过是一些小机灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190605,
					"content": "如果要我评价这桩案子的话…应该只能称得上「无聊」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190606,
					"content": "不过，再怎么说这也是一桩罪案，能了结掉也是好事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190607,
					"content": "你不一起去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "对我来说，这桩案子已经结束了，剩下的事我就不参与了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190609,
					"content": "再说了，以我的身手和体格，要是被犯人反过来制服住，然后用来要挟你们就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190610,
					"content": "我对自己可是有着很清醒的认知。所以，对付犯人的事就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		}
	]
}