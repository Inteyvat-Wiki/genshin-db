				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "这下子可算是人赃并获了，多谢了龙二，还有旅行者，你也辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190302,
					"content": "我和天野现在就把这些盗宝团带回奉行所，剩下的事就交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190303,
					"content": "不过，珊瑚还真是神了，居然能这么准确地找到犯人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190304,
					"content": "毕竟是珊瑚嘛，这种案件，怎么想也难不住她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190305,
					"content": "龙二，那我们就先回奉行所了。等处理好了这家伙，我们会再登门拜谢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190306,
					"content": "客气了，请慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190307,
					"content": "好了，旅行者，我们也回去向社长报告一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
