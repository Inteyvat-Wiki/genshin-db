			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "发现那家伙了，果然正在埋自己的赃物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190202,
					"content": "我们上！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "等一下，旅行者，现在…还不是我们该上的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190206,
					"content": "再等一下…嗯…应该差不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190207,
					"content": "你这家伙，在做什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190208,
					"content": "放下手里的东西，别动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190209,
					"content": "你、你们是怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "石川八郎"
				},
				{
					"id": 220190210,
					"content": "可恶…别看着了！一起上！解决掉这两个家伙，我们就远走高飞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "石川八郎"
				},
				{
					"id": 220190211,
					"content": "几个盗宝团，居然敢这么嚣张…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190212,
					"content": "安藤先生，天野先生，我们来帮你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190213,
					"content": "哦！就拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190214,
					"content": "旅行者，现在我们可以上场了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190215,
					"content": "搞这么麻烦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "这都是社长的嘱咐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190217,
					"content": "好了，我们上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 220190204,
					"content": "要上吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "稍等一下，现在还不是我们该上的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "龙二"
				}
			]
		},
		{
			"id": 2201903,
