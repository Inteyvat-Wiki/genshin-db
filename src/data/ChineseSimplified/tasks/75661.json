			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"恰斯卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756610101,
					"content": "难怪总有种预感让我过来看看…原来是能遇上你，了不起的「杜{RUBY#[D]希望}麦尼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610102
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610102,
					"content": "那么——你是为了「花羽会」的战士试炼而来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610103,
						756610106
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610103,
					"content": "没错，我来检验关卡的难度！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610104
					]
				},
				{
					"id": 756610104,
					"content": "那你一定不会失望，我对绒翼龙骑士们的要求非常严格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610105
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610105,
					"content": "因为我不擅长教导别人，在受邀设计这些关卡时，只能回忆「相当棘手」的难题，再把它们一个接一个加进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610109,
					"content": "结果九成九的「花羽会」战士都过不了第一关…没办法，只能接受伊拉德的建议，降低点难度了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610110
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610110,
					"content": "但对你来说，简化前的试炼可能都不够让你尽兴，应当选用…连我都束手无策的难关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610111,
						756610112
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610111,
					"content": "说得好！但我不用特殊对待！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610113,
					"content": "这是对你应有的重视。虽然我不擅教导，但评估起实力却从没看走眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610114
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610114,
					"content": "而以你的实力…唯有难度最高的挑战，才能与你相称。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610115,
						756610116
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610115,
					"content": "但我得考虑普通战士的能力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610117,
					"content": "…也对，这次你有委托在身，以后还有机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610118
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610118,
					"content": "我会专门为你量身定制…「超越」绒翼龙骑士巅峰的斗争盛宴！期待并等待吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610116,
					"content": "评估关卡的普适性也很重要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610112,
					"content": "太看得起我了，没必要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610106,
					"content": "也可以是为了你而来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610107
					]
				},
				{
					"id": 756610107,
					"content": "哦？原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610108
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 756610108,
					"content": "——你是想要「超越」我的记录吧？正合我意。这些关卡在设计之初，就塞满了我曾遇见过的「相当棘手」的难题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "恰斯卡"
				}
			]
		}
	]
}