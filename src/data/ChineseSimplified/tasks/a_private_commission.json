			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "唔，接下来做什么好呢…快想想我们还有什么计划吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040102,
					"content": "旅行者，派蒙，请留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040103,
					"content": "哎？绫华？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040104,
					"content": "有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "有件事想请你出手相助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040106,
					"content": "话虽如此，也请不要太过担心。这次不是来自社奉行或神里家的委托，而是以我个人名义发起的请求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040107,
					"content": "个人名义，也就是说，是私事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040108,
					"content": "是的。一些与我母亲有关的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040109,
					"content": "或许有些突然…但这件事在我看来，只能委托你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040110,
					"content": "能详细说说吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "前几天，我从旧物堆里找到一本母亲留下的笔记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040112,
					"content": "里面有她记录的许多琐事，其中出现了一个我从未听说过的人名，而且频率之高，实在令人在意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040113,
					"content": "应该是你母亲的朋友吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040114,
					"content": "连你都没听说过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "是的。虽然父母都已过世多年，但与他们有过往来的人物，我和兄长大人大抵还是知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040116,
					"content": "因此…我对这位陌生人十分好奇，很想见见对方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040117,
					"content": "笔记上写，对方名叫「椿」，似乎是一个很受我母亲重视，也相当有个性、爱玩乐的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040118,
					"content": "听起来像是女性的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040119,
					"content": "嗯。我想去见她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040120,
					"content": "那你需要我们做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040121,
					"content": "是要帮你找人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040122,
					"content": "不不，笔记上写了她的住所，我们直接就能过去。我想请旅行者与我一起，是因为还要准备几件见面礼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040123,
					"content": "刚才说的所有事情还请二位替我保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040124,
					"content": "原本这样的事应该委托兄长与我一同处理，但现阶段兄长非常忙碌…我又有些私心，不想让其他本地人士参与到这件事中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040125,
					"content": "所以需要我这个异乡人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "没错。你是一个懂得礼节、体恤他人的良善之人，又很可靠，与你一起，我才好放心些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040127,
					"content": "嗯嗯！准备见面礼什么的，我们应该能帮上忙哦。报酬的话，请我们吃好吃的东西就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040128,
					"content": "那太好了，我本就想趁这次机会请二位到处走走。若你们不嫌弃，就请跟我一起行动吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040129,
					"content": "#不嫌弃不嫌弃！{NICKNAME}，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120040130,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "太感谢了！那么我们现在就出发好吗？第一站先去小仓屋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 120040132,
					"content": "好呀好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}