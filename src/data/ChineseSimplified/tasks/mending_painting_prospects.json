	"talks": [
		{
			"id": 7152101,
			"completionStepIds": [
				7152101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7152101",
							"2"
						],
						"stepId": 7152101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"巴特洛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715210101,
					"content": "下一幅画是…嗯，是这一幅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210102
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210103
					]
				},
				{
					"id": 715210103,
					"content": "#您是…{NICKNAME}，久仰大名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210104
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210104,
					"content": "我听许多同事提起过您，还心想着您会不会来参加这场盛会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210105
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210105,
					"content": "结果，我还真在这里遇见您了，真是太荣幸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210106
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210106,
					"content": "我有很多东西想为您介绍，但在那之前，容我先做个自我介绍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210107
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210107,
					"content": "我叫巴特洛，是一个画家…您对画家这职业应该不陌生，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210108
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210108,
					"content": "但我除了画家的这个身份之外，还是一名「画作修复师」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210109
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210109,
					"content": "无论一幅画作遭到了何种创伤…比如被火烧啦，被老鼠咬啦，或者是发霉腐烂之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210110
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210110,
					"content": "只要到了我手里！这幅画都会被复原为它原本最完美的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210111
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210111,
					"content": "修复画作…是按原样画一遍吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210112
					]
				},
				{
					"id": 715210112,
					"content": "哈哈哈，那可不是。如果只是按照原画重新画一遍，那只能叫做「临摹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210113
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210113,
					"content": "我们要做的，是将画作修复成它最原本的模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210114
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210114,
					"content": "无论是颜色、笔触…甚至是画布的材料。任何细节，都必须和这幅画原有的一模一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210115,
						715210116
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210115,
					"content": "真复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210117
					]
				},
				{
					"id": 715210117,
					"content": "可不是？修复画作需要高超的绘画技巧，还有极其精细的画面认知力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210118
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210118,
					"content": "这也是…我根本就招不到多少帮手的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210119
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210119,
					"content": "如果一个画家同时具有高超的绘画技巧，和极其精细的画面认知力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210120
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210120,
					"content": "那他为什么不直接自己画画，而是跑来帮助人家修复画作呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210121
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210121,
					"content": "更别提修复画作这项工作既不赚钱，又容易被外人觉得我们只是一群只会照葫芦画瓢的粗劣画师…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210122
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210122,
					"content": "不过，每一种工作都需要有人来承担，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210123
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210123,
					"content": "画是一种很珍贵的事物。一幅优秀的画作可以承载历史、故事、情感…还有市场的商业价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210124
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210124,
					"content": "无论外人怎么看，作为一名画家，我绝不能看着那些画白白损毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210125
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210125,
					"content": "…但就像我之前说的那样，这工作既不赚钱，又遭人误解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210126
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210126,
					"content": "虽然我一直在努力招募人手，但是到现在还是只有我一个人在做这项工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210127
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210127,
					"content": "我这次之所以来这里，也是想要将我的工作宣传给大家，也许这样就能招到更多的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210128
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210128,
					"content": "但是…人手还没招募到，我又接到了许多请我修复的古画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210129
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210129,
					"content": "这些画作来自蒙德和璃月，画面内容有山水、人物、走兽…甚至…儿童蜡笔画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210130
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210130,
					"content": "蜡笔画你也修复？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210131
					]
				},
				{
					"id": 715210131,
					"content": "呃…原则上来说，只要是画作，就可以委托我来修复。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210132
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210132,
					"content": "况且那几幅儿童蜡笔画也包含着那几位小朋友的心血，说不定这就是他们迈向艺术道路的第一步呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210133
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210133,
					"content": "所以，他们的父母来委托我修复…也无可厚非吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210134,
						715210136
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210134,
					"content": "你这一脸的无奈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210135
					]
				},
				{
					"id": 715210135,
					"content": "什么？不！我才没有无奈，我只是…只是…需要去学习一下蜡笔绘画的知识…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210138
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210138,
					"content": "#{NICKNAME}，如果您愿意的话，能帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210139
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210139,
					"content": "你也看到了，这里就我一个人…但为了修复画作，我必须得去周围取景才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210140,
						715210141
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210140,
					"content": "还要取景？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210142
					]
				},
				{
					"id": 715210142,
					"content": "唉，是啊。除了取景之外，我还要去找各种和这幅画作有关的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210143
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210143,
					"content": "比如这幅画中的景物在成画年代的模样，画中的动物形态究竟是如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210144
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210144,
					"content": "还好，目前我手头急需修复的画作的成画时间距今不长，景物应该没有什么变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210145
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210145,
					"content": "我正准备去外面取景，但您也知道…野外十分危险，并不适合我这种只会拿画笔的人前去冒险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210146
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210146,
					"content": "所以…我想请您帮我去野外取景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210147
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210147,
					"content": "我不擅长画画…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210148
					]
				},
				{
					"id": 715210148,
					"content": "不用担心！我都帮您准备好了…之前我请人帮我去外面取景的时候，也是这么做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210149
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210149,
					"content": "您瞧，这是一幅待修画作的留影画片，里面有几个关键的景物…我已经给您标出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210150
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210150,
					"content": "您只需要去往这个景物的所在地，用留影机给这些景物留个影，一切就完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210151
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210151,
					"content": "所以，我要做的只是留影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210152
					]
				},
				{
					"id": 715210152,
					"content": "没错，但在留影之前，您可得好好看看这些画作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210153
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210153,
					"content": "感受这些画作中所包含的美学和艺术感…让这些画作停留在您的脑海里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210154
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210154,
					"content": "只要完全理解了这些画作，您在留影的时候，说不定就能感受到这幅画成画的全过程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210155
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210155,
					"content": "草稿、线稿、上色、细化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210156,
						715210157
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210156,
					"content": "这不就是幻觉吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210158
					]
				},
				{
					"id": 715210158,
					"content": "您这句话说得没错，在我看来艺术就是一种…幻觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210159
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210159,
					"content": "而艺术家要做的，正是要精准地抓住这种幻觉，并将它客观呈现出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210160
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210160,
					"content": "相信我，只要您仔细观察我给您的画片，一定能感觉到这幅画里蕴含的「艺术幻觉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210161
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210161,
					"content": "#总而言之，这件事就拜托你了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210162
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210162,
					"content": "而我嘛…要接着修复这些画作了，嗯…下一幅是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210157,
					"content": "幻觉也太夸张了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210158
					]
				},
				{
					"id": 715210141,
					"content": "好复杂的准备工作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210142
					]
				},
				{
					"id": 715210136,
					"content": "那你会画蜡笔画吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210137
					]
				},
				{
					"id": 715210137,
					"content": "我…会！但是会得不多，只是知道一点皮毛。我必须得补习一下蜡笔绘画的知识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210138
					],
					"speakerTitle": "巴特洛"
				},
				{
					"id": 715210116,
					"content": "听上去很厉害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210117
					]
				}
			]
		}
	]
}