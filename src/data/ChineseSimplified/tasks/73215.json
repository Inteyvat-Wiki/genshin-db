			"dialogs": [
				{
					"id": 732150401,
					"content": "你好呀，金色的那菈和白飞飞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 732150402,
					"content": "你好！最近怎么样呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150403,
					"content": "很好，不过为什么来这里，你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 732150404,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150405,
					"content": "唔…很困扰，我们。虽然一定有理由，但你们为什么来，不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 732150406,
					"content": "毕竟我们对这里很熟悉嘛，和你们一起经历了那么多冒险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150407,
					"content": "…？唔…是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 732150408,
					"content": "我们之前的经历，他不记得了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
