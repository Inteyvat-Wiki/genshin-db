				"points": []
			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "你好呀，朋友那菈！唔…好像要对你说什么，想不起了，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 732150102,
					"content": "没关系的，又看见你们就让我们很开心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150103,
					"content": "嗯，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 732150104,
					"content": "关于「无郁夷摩」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "她不再说话了，但是她很好。也正在恢复，森林…谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 732150106,
					"content": "关于遗忘…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "遗忘…？嗯，因为力量耗尽了，「苦舍桓」。所以也会流走，记忆。一点一点，就像露珠一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰纳迦"
				}
			]
		},
