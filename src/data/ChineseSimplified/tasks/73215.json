			"dialogs": [
				{
					"id": 732150601,
					"content": "金色的那菈，白飞飞，你们来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 732150602,
					"content": "嗯！我们来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150603,
					"content": "嘿嘿…我可能忘记了很多事情，所以还要你们多提醒啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 732150604,
					"content": "是因为「苦舍桓」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "嗯…兰纳迦应该和你们说过，力量在记忆里，没有记忆，没有力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
