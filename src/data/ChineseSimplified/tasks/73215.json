			"dialogs": [
				{
					"id": 732150501,
					"content": "你好！金色的那菈！还有你，小小白飞飞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 732150502,
					"content": "哼，我不小！也不看看你自己啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150503,
					"content": "哼哼，我也不小！唔…对了，你们来做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 732150504,
					"content": "只是回来看看你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "对呀，毕竟我们之前打败了好多坏东西，一起唱歌，一起救了「呜咿呀」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150506,
					"content": "「无郁夷摩」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 732150507,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150508,
					"content": "唔…对不起…你们说的应该是真的。但我不记得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 732150509,
					"content": "唔…！没事，没事啦！请你不要伤心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150510,
					"content": "（他真的不记得了呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
