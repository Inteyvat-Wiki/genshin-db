			"dialogs": [
				{
					"id": 732150301,
					"content": "你好，谢谢你们！金色的那菈和白飞飞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 732150302,
					"content": "你们来做什么呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 732150303,
					"content": "你说要记得回来一起玩呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150304,
					"content": "唔，我这么说过吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 732150305,
					"content": "你说过的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "这样呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 732150309,
					"content": "不管怎样，谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 732150307,
					"content": "怎么，不开心吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "唔…没有哦。",
					"roleType": "TALK_ROLE_NPC",
