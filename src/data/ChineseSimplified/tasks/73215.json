			"dialogs": [
				{
					"id": 732150201,
					"content": "你好，你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 732150202,
					"content": "你好呀，小不点！还记得我们吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150203,
					"content": "可恶的白飞飞，我不是小不点！你们还记得我教的歌吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 732150204,
					"content": "当然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "好哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 732150206,
					"content": "那你们要答应我，即使我忘记了自己的歌…你们也要记得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰纳真"
				}
			]
		},
