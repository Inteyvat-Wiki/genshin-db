				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "「出售沙漠冒险大礼包，为往来商旅提供最贴心的沙漠冒险解决方案。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181002,
					"content": "「凡是购买大礼包的顾客，本店保您冒险路上有去有回，如若不然，假一赔十。现在订购还有折扣哦。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "「听说在沙漠那边有个魔鳞病医院，是以前教令院设立的专门用来收治魔鳞病的医院，但是后来不知道因为什么原因废弃了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181102,
					"content": "「听阿如村的人说，曾经还有被治愈的魔鳞病患者从那里逃出来。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181103,
					"content": "「要是那里留下了什么资料的话，说不定就能找到治疗这种疾病的方法了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "「听说有我们阿如村的人在教令院当了大官，这下我们沙漠的人说不定要翻身了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181202,
					"content": "「天天搬这些破石头又赚不到钱，要是能让我贩运点什么知识罐头之类的东西出去，只要干成一单就能回老家结婚了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181203,
					"content": "「但是我听说那位大人当的就是缉私的官，而且怎么看也不会偏袒我们。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181204,
					"content": "「嘁，我们沙漠人就是不团结才会变成现在这样的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "前往沙漠的冒险家请注意，根据教令院规定前往大赤沙海的冒险活动皆需在教令院备案方可进行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181302,
					"content": "在沙漠遗迹中发现的文物原则上皆归属教令院所有，任何人不得占为己有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181303,
					"content": "由于安全问题，教令院已对大赤沙海外的其他沙漠地区发布了禁令，严禁前往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181304,
					"content": "如若不听劝告，在这些地区发生任何意外，教令院不承担任何责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321814",
							"2"
