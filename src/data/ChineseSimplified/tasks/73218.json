			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181701,
					"content": "「以魔瓶君王的名义，我已赦免你们的罪，但我们的罪又当由谁来赦免？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
