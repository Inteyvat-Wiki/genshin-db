				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181601,
					"content": "长期招募工人负责防沙壁的维护工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181602,
					"content": "食宿免费，工资优厚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181603,
					"content": "工作认真突出者还能由本官推荐获得进入教令院进修的资格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321817,
			"completionStepIds": [
				7321817
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
