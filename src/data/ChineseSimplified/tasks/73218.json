			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "「听说有人光靠往城里贩运沙蛹脂就发了财，现在不仅在城里买了豪宅，还自称是什么什么家族，和那些教令院的家伙称兄道弟的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181402,
					"content": "「为什么我都在这搬了半辈子石头了，现在还是穷光蛋一个。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181403,
					"content": "「你懂什么，沙蛹脂那都是教令院点头才能做的特许生意，你碰都不要想碰一下。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181404,
					"content": "「你要想发财就跟我一起偷偷贩点书籍出去，要是成了至少我们就再也不用在这里搬石头了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321815",
							"2"
						],
						"stepId": 7321815,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "「现在的年轻人就是喜欢想太多。我们阿如村的人要不是有树王她老人家的庇护，早就在那些神殿废墟下面当骷髅了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181502,
					"content": "「听说最近还有人传说什么赤王要复活的消息。我寻思树王大人这么多年也没看活过来，更别说那个虚无缥缈的赤王了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181503,
					"content": "「我看还是老老实实打工要紧，光靠每个月往阿如村运的那点物资，可不够我们这些人活的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
