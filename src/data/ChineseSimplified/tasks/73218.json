			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181801,
					"content": "「希望教令官能考虑一下收紧喀万驿的通关限制。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181802,
					"content": "「现在只要是沙漠民就能随随便便通关，不仅导致很多盗匪借此机会逃进丛林里藏匿，而且还抢占了我们须弥人的工作机会。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181803
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181803,
					"content": "「虽说现在还没有放开沙漠民的虚空权限，不过聚砂厅发放的那些委托，早就不限于佣兵的活儿了。这样下去就算都去考教令院，也得有人要当无业游民了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181804
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181804,
					"content": "「你这是什么话，沙漠民本来也是草神大人的子民，他们也是须弥人，让他们进城是理所当然的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181805
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732181805,
					"content": "「你在这里说这种话可小心挨揍。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
