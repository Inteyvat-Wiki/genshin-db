				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200100201,
					"content": "这里刚好有个丘丘人醒着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100202
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200100202,
					"content": "就这位了，我们快点过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100203
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200100203,
					"content": "小心点，过去的时候别吵醒其他丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100204
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200100204,
					"content": "不然他们肯定会误会，以为我们是准备来攻击他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100205
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200100205,
					"content": "要是这样，肯定不能顺利地对话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
		},
