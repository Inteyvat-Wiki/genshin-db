			"dialogs": [
				{
					"id": 200100301,
					"content": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100302
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200100302,
					"content": "Dala beru yo?! Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100303
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200100303,
					"content": "Kundala gusha! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100304
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200100304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100305
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200100305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100306
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 200100306,
					"content": "看来他听懂我说的话了，正在准备拿礼物给我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100307
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 200100307,
					"content": "是，是武器！呜呜呜呜呜，旅行者！救救我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				}
			]
