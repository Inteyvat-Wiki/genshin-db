			"dialogs": [
				{
					"id": 130120201,
					"content": "说起来，这几天还发生了一件怪事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120202
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130120202,
					"content": "有个商人来找我讨要什么沙漠旅行包的钱，开口就是一百二十五万摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120203
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130120203,
					"content": "我对欠钱的事情毫无印象，这个数字又远超市场价，于是我就以「寻衅滋事」为由把对方关起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120204
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130120204,
					"content": "这事你们有什么头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120205
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130120205,
					"content": "没，没有。派蒙不知道哦。",
