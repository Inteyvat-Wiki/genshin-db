			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "「睡过头了！要在明天前赶回去才行，否则香莙就没人管了…俺真蠢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "谁人的笔记"
				},
				{
					"id": 711050202,
					"content": "「俺记得从药蝶谷去悬练山中间有条小路…走小路，然后穿过一座山洞就能到了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "谁人的笔记"
				},
				{
					"id": 711050203,
					"content": "「听说那附近有魔物，但现在也只能抄近道试试了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "谁人的笔记"
				},
				{
					"id": 711050204,
					"content": "看起来这就是那个爷爷留下的吧？他走小路去了！我们也去找一找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
