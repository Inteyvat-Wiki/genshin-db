				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "咦？应该就是这里了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050602,
					"content": "怎么没有人呢？附近好像也没有什么痕迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050603,
					"content": "是不是已经回去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "感觉不太可能啊，香莙的爷爷受了伤，他能走那么远吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050605,
					"content": "但他也不在附近。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "会不会有人路上遇见了他，把他救回去了？我觉得很有可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050607,
					"content": "我们要不回翘英庄问问吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050608,
					"content": "先取一点「仙水」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "取仙水？嗯…你说的对，如果那个爷爷真的被救走了，他肯定还需要这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050610,
					"content": "#我们就当顺便帮忙了。嘿嘿，{NICKNAME}，还是你想的周到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"罗叔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "哦…是旅行者啊，看你们匆匆忙忙的样子，遇到什么麻烦了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050802,
					"content": "我们…罗叔知道香莙和他的爷爷家在哪吗？我们来找他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050803,
					"content": "香莙？没听过这个人，是我们这的吗？庄里的人，老头子我应该都认识…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050804,
					"content": "没听过？不会吧…我们在外面遇到了一个小女孩，她说她叫香莙，家就在翘英庄，她请我们帮她找爷爷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050805,
					"content": "她还有一个大大的竹筏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050806,
					"content": "唔…竹筏倒是容易见，但香莙这个名字…老头子我确认，庄子里没有叫这个名字的人。她爷爷叫什么你们知道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050807,
					"content": "她爷爷是个采药人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "采药人？让老头子想一想，庄子里以前确实有个采药人…但他已经走了三年了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050809,
					"content": "走了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050810,
					"content": "在外面遭遇了魔物…唉…不过他应该不是你们要找的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050811,
					"content": "因为这位采药人有点疯疯癫癫，一直没有成家，所以更别提子孙后代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050812,
					"content": "这…这到底是怎么回事啊？那我们遇见的那个香莙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050813,
					"content": "不会她才是妖怪吧！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050814,
					"content": "庄里的采药人采的什么药？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "都是一些没见过的花草。老头子只懂点茶，哪懂那些啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050816,
					"content": "不过老头子记得，他出事的时候，大家是在悬练山附近发现他的，那时候他手里还攥着一瓶水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050817,
					"content": "他说他家院里有株仙草，一定要浇那种仙水才能成活。老头子看他真是糊涂啊，都是河里的水，有什么特别的？为了这个搭上了性命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050818,
					"content": "唉…死者为大，我们把他安葬之后，还是把他取来的水，洒在了他家宅院里，希望他走好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050819,
					"content": "悬练山的仙水？我们也去了那里，还取了仙水了呢…这个采药人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050820,
					"content": "感觉就是一个人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "那还真是怪事了。不如…你们跟老头子来一趟吧，老头子带你们去他的院里看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711050822,
					"content": "你们要是也取了水，就洒在他的院里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗叔"
				}
			]
		},
