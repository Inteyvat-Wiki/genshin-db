			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "「…虽然早就担心有魔物…但…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "谁人的笔记"
				},
				{
					"id": 711050502,
					"content": "「…流了好多…大腿止不住…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "谁人的笔记"
				},
				{
					"id": 711050503,
					"content": "「…俺好困…但悬练山就在前面了…香莙…俺一定会取到仙水的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "谁人的笔记"
				},
				{
					"id": 711050504,
					"content": "「…香莙…俺一定会取到仙水的…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "谁人的笔记"
				},
				{
					"id": 711050505,
					"content": "糟糕了…他被魔物袭击了，好像受伤很重的样子…就这样还要去悬练山取水吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050506,
					"content": "我们赶紧过去吧，希望能帮上他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
