			"dialogs": [
				{
					"id": 711051101,
					"content": "没事的话，老头子就先走了，你们还想的话就随便看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711051102,
					"content": "所以真的没有香莙这个人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711051103,
					"content": "老头子会帮你们去打听打听，没准是其它地方的小糊涂，搞错了家在哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "罗叔"
				},
				{
					"id": 711051104,
					"content": "也多谢你们跑了一趟，还替「仙人」浇了他的草药，他知道了也会感谢你们，替你们避灾的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗叔"
				}
			]
		}
	]
