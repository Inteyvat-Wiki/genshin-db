			"dialogs": [
				{
					"id": 711050101,
					"content": "爷爷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050102,
					"content": "咦？小朋友，你怎么大晚上的一个人在这？你叫什么名字啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050103,
					"content": "我是香莙…我来找爷爷…爷爷被妖怪抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050104,
					"content": "妖…妖怪？这里有妖怪？什么妖怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050105,
					"content": "我…我也不知道…是爷爷说的，他总说山里有妖怪，所以让我不要乱跑…但他已经进山三天没回家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050106,
					"content": "那是吓唬你的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "我也觉得…他有说他进山做什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050108,
					"content": "爷爷是庄里的采药人，最近采回来了一棵仙草，据说要用悬练山附近的仙水浇灌才能长大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050109,
					"content": "所以…他是不是遇到了什么看守仙水的妖怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050110,
					"content": "小香莙，你不要担心，现在很晚了，你爷爷可能只是遇到了什么麻烦，我们先送你回家好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050111,
					"content": "可我要去救爷爷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050112,
					"content": "我们可以帮你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050114,
					"content": "嗯！如果你不回家的话，说不定会让你爷爷更麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050115,
					"content": "啊…我不能给爷爷添麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050116,
					"content": "所以我们去找他就好啦，你家在哪里呢？我们先送你回家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050117,
					"content": "#不用不用，{M#哥哥姐姐}{F#两位姐姐}，我家就在翘英庄，我可以自己回去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050118,
					"content": "你们能立刻去找爷爷吗？我担心他有危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050119,
					"content": "我们倒是没问题啦。那…你知道你爷爷具体去了什么地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711050120,
					"content": "我只知道他是往那边走的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 711050121,
					"content": "那我们就先去那边找找看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "#谢谢{M#哥哥姐姐}{F#两位姐姐}！那我现在就回去，不能给大家添麻烦…我会安安静静在庄里等着好消息的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
