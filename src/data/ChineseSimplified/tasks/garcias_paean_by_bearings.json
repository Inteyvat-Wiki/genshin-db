			"trigger": {
				"objectNames": [
					"加尔恰",
					"阿汉格尔",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "这一根轴承的尺寸太大了，没法和其他轴承适配…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230150102,
					"content": "上一根太小，这一根太大，我的铁块都要被你用光了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230150103,
					"content": "事实上，我们的钱也快不够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150104,
					"content": "你们在吵什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "这个人，要我给他打造很多铁管和齿轮，而且每个铁管和齿轮还有不同的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230150106,
					"content": "为了给他打造这些东西，我已经要把铁块都用完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230150107,
					"content": "但他还说不够用，还要更多的齿轮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230150108,
					"content": "请您再听我解释一下我的工作，您听完之后，肯定能理解我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230150109,
					"content": "这是在折腾什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "就让加尔恰先生给阿汉格尔先生讲解去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150111,
					"content": "旅行者，我…呃，加尔恰先生想请您帮忙去搜集一些铁块，请问您愿意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150112,
					"content": "我倒是有空，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "在制造机器这件事上…我们遇见了一些早已预料到的阻碍，加尔恰先生目前正在思索如何突破这个阻碍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150115,
					"content": "如果以后您有兴趣，就请自己去问问加尔恰先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150116,
					"content": "我想…除了他自己，谁也无法解释清楚那台机器的原理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150117,
					"content": "但在那之前，请您先拿些铁块回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 230150113,
					"content": "他的机器改造得怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
		{
			"id": 2301502,
