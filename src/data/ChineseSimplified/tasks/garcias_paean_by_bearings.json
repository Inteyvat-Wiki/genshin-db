						"stepId": 2301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿汉格尔",
					"加尔恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "你要那么多齿轮和管子做什么？是想要搭个铁皮屋子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230155002,
					"content": "没错，先生！我就是要搭一个屋子，一个塞满了齿轮的屋子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230155003,
					"content": "我把容纳一部分齿轮的地方称为「容室」，而轴承和另外一部分齿轮，则会组成「算库」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230155004,
					"content": "「容室」里的齿轮用来存储和记录数字，而「算库」里的齿轮则用来计算它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230155005,
					"content": "我画张图您就能理解了，有纸吗？没有？没关系，我在衣服上画，这样比较容易看清…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230155006,
					"content": "能把那块炭给我吗？非常感谢，您瞧这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				}
			]
		}
	]
}