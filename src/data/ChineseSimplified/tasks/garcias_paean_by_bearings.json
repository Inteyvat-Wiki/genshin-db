			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加尔恰",
					"路通",
					"阿汉格尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "好了！好了！不要再说了，我要接着给你做齿轮去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230150302,
					"content": "但我还没有完全讲清楚我的机器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230150303,
					"content": "铁块已经有了吧，那我马上就开工了，你离远点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 230150304,
					"content": "阿汉格尔猛烈挥舞着铁锤，加尔恰不得不躲到了一边…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "就让阿汉格尔先生继续工作吧，这是您的报酬，请您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150306,
					"content": "希望你们能成功。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "我对您的祝福表示感谢，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150308,
					"content": "我对这件事…则谨慎地抱着悲观态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150309,
					"content": "加尔恰先生是一个机械方面的天才，这一点不容置疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230150310,
					"content": "但我认为，对于加尔恰先生所想完成的那台机器而言…他仅仅是一个「天才」，也许还远远不够…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
