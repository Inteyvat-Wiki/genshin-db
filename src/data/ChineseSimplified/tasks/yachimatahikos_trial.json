			"dialogs": [
				{
					"id": 722680101,
					"content": "我乃末代地走官·宇陀。珊瑚宫之勇者，我认可你挑战的荣誉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "宇陀"
				},
				{
					"id": 722680102,
					"content": "我将主持「智慧」之试炼。请你动身去解开所有的谜题，让「高门之火」归位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "宇陀"
				},
				{
					"id": 722680103,
					"content": "如果没有足够的智慧，勇往直前并不能称为勇敢，只是鲁莽罢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "宇陀"
				},
				{
					"id": 722680104,
					"content": "我将在上方三界塔处等候你完成挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇陀"
				}
