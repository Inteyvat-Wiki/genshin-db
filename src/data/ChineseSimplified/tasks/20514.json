					"安东尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "这叫什么事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "是你啊，来得正好…自从吃了那位神医的药，安娜的病逐渐好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140104,
					"content": "她之前身体不好，必须要静养，在家里憋了太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140105,
					"content": "现在她身体好起来了，每天都和我闹着要出去玩，我拗不过她，就答应了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140106,
					"content": "但是…现在我压根就找不到她了。这丫头到底跑到哪去玩了，你快点帮我找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140107,
					"content": "我，我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "我在这里等着，你快点去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140109,
					"content": "这丫头，身体刚有点起色就瞎折腾，要是再出什么事怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140116,
					"content": "我已经在城里找了很久…就差冒险家协会那一片没找过，但是我实在是没力气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140117,
					"content": "你就先去冒险家协会那一片找找看吧。还有，说不定塞琉斯先生会注意到什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140118,
					"content": "希望能找到，不然我还得接着去找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140110,
					"content": "你好像挺高兴的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "高兴？别，别开玩笑了，这丫头身体刚好一点，就开始这么闹腾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140112,
					"content": "等她回来了，有她好看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140113,
					"content": "肚子饿了就会回来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "你当我妹妹是猫吗…再说她病刚好，怎么能饿肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140115,
					"content": "好了好了，你快帮我找找吧，我就在这等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "安东尼"
				}
			]
		},
