					"nextDialogs": [
						205140506
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205140506,
					"content": "他之前很照顾我和哥哥，我路过的时候就和他打了个招呼，他还一副很惊讶的样子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205140507,
					"content": "嗯…我要不要去冒险家协会试试呢，成为一个冒险家，说不定也不错呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "安娜"
				},
				{
