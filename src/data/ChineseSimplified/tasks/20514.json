				{
					"id": 205140401,
					"content": "唔？真是稀奇，你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 205140402,
					"content": "你有没有见过一个女孩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "女孩？哦，你是说安娜吗？我看见了，她刚才往那边的风车跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 205140404,
					"content": "我还在奇怪呢，那孩子不是身体不好吗，怎么突然这么有活力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 205140405,
					"content": "给我打了声招呼之后，就跑过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 205140406,
					"content": "这孩子，病是什么时候好的…你有头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
