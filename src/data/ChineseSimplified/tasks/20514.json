						205140302
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140302,
					"content": "安娜在一架风车上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "风车？！这丫头是怎么上去的！我马上就去找西风骑士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140304,
					"content": "她说她等会就回来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "是，是这样吗，没事就好，吓死我了，我还以为她被困在风车上下不来了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140306,
					"content": "谢谢你，我马上就去找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205140307,
					"content": "病刚好就开始折腾，我非要好好训训她不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				}
			]
