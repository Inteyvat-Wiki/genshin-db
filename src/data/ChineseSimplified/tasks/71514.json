	"talks": [
		{
			"id": 7151401,
			"completionStepIds": [
				7151401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151401",
							"2"
						],
						"stepId": 7151401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715140101,
					"content": "嗨嗨嗨！两位前辈，海灯节好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140102
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140102,
					"content": "最近玩得开心吗？有兴趣跟我来一场特别冒险吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140103
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140103,
					"content": "呜哇，居然叫我们前辈？态度真不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140104,
					"content": "不说最近，我们一直挺开心的啦！不过…我怎么觉得你有点眼熟呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140105,
					"content": "你们可是冒险家协会的超级全勤王，肯定见过我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140106
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140106,
					"content": "我叫甜甜，平常总在绯云坡附近转悠，为协会招揽新人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140107
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140107,
					"content": "路过绯云坡的人里，十个有十个听过我的声音，还要加上他们抱的猫、遛的狗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140108,
						715140110
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140108,
					"content": "好像有一点印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140109
					]
				},
				{
					"id": 715140109,
					"content": "对对对，说明我的努力被前辈们注意到了！那更要让前辈们体验一下我的杰作了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140112
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140112,
					"content": "话都说到这份上了，我们两位前辈肯定要给你面子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140113,
					"content": "请简单介绍一下你说的特别冒险吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140114,
					"content": "好！那我就进入正题了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140115
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140115,
					"content": "最近我在万文集舍看到了新的小说…不对，应该说是找到了新的情报！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140116
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140116,
					"content": "我发现人们对于冒险的期望正在变高，登山和风之翼滑翔这类活动的吸引力都不如以前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140117
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140117,
					"content": "为了让更多人加入冒险家协会，新奇而刺激的体验是必需品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140118
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140118,
					"content": "所以，我联合外地的几位宣传员，一起花费重金，请教了几位登山高手和烟花工匠，设计了一种全新的竞速挑战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140119
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140119,
					"content": "挑战中布置了很多机关，只要踩上去，就可以利用烟花和火药爆炸的推力，一下子飞到天上，完成超厉害的加速！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140120
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140120,
					"content": "烟花？火药？竞速挑战的过程中…把人炸到天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140121,
						715140122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140121,
					"content": "是烟花助飞的派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140123
					]
				},
				{
					"id": 715140123,
					"content": "你干嘛这么兴奋啦？你也会被轰飞的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140124,
					"content": "虽然以你的实力，连面前爆开的炸药桶都不怕啦…但说不定会被炸得晕乎乎呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140125,
					"content": "放心放心，爆炸是在坚韧的装置内部发生的，我为安全措施做了重重保障，绝对没有受伤的风险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140126
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140126,
					"content": "而且，我有和总务司正式报备，宣传的时候多次强调，请勿擅自模仿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140127
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140127,
					"content": "还有这么多门道？你考虑得还挺周到嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140128,
					"content": "按照我的预期，只要玩了这个竞速挑战，哪怕是一般人，心中的冒险之魂也会被点燃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140129
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140129,
					"content": "两位前辈，你们盛名在外，如果你们带头参加这个竞速挑战，肯定能吸引很多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140130
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140130,
					"content": "我还为挑战准备了丰厚的奖励，肯定能把慕名而来的人们转化成冒险家协会的新成员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140131,
						715140133
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140131,
					"content": "好啊好啊，烟花火药大竞速！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140132
					]
				},
				{
					"id": 715140132,
					"content": "嗯！既然还能拿到奖励，那我们就没有错过它的理由！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140135,
					"content": "那就这么说定了！事不宜迟，两位前辈请快试试看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140136
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140136,
					"content": "嘿嘿，这次竞速挑战的赛道还挺多的，肯定能让你们玩个痛快！我也能一举拿到好几个月的业绩，双赢双赢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140133,
					"content": "好怕好怕，我和派蒙被炸飞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140134
					]
				},
				{
					"id": 715140134,
					"content": "噫，你明明在笑啦！反正甜甜小姐说过了，安全措施很完善，你也很想试试看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140122,
					"content": "是火药推进的派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140123
					]
				},
				{
					"id": 715140110,
					"content": "完全没印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140111
					]
				},
				{
					"id": 715140111,
					"content": "居然没印象？那我要用这次的杰作让更多人记住我…不对，是招揽更多人加入协会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140112
					],
					"speakerTitle": "甜甜"
				}
			]
		}
	]
}