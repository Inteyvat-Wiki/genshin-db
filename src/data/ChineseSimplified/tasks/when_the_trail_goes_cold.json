			"dialogs": [
				{
					"id": 701430201,
					"content": "你好，旅行者，最近的冒险行动还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430202,
					"content": "还算是顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "嗯，你的那些冒险事迹我都听说了，以这个势头继续冒险的话，你肯定能成为一名优秀的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430204,
					"content": "然后…关于冒险行动，我这里有一份「冒险情报」，不知道你有没有兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430205,
					"content": "又有什么新委托吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "看来你对于协会里的这些事务已经很熟练了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430207,
					"content": "不过，这次不是委托，而是一份「冒险情报」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430208,
					"content": "这份「冒险情报」，是关于蒙德旁边那座「龙脊雪山」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430209,
					"content": "在那里，协会已经设置好了营地，还驻扎了不少冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430210,
					"content": "地点我给你标注在地图上了，到达那片营地之后，你可以先去找一位叫做「玉霞」的冒险家了解一下周围的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 701430211,
					"content": "那么，继续冒险吧，向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				}
			]
		}
