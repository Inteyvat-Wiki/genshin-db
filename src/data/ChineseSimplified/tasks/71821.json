			"trigger": {
				"objectNames": [
					"快拳阿凌"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "怎么会这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210202,
					"content": "你怎么在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "我…唉，是这样，师父说，他最近领悟出了一套新的腿法，非常厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210204,
					"content": "他说我的心不够诚，基本功也不到家，不愿意将腿法传授于我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210205,
					"content": "不过我想正好现在赶上海灯节，我诚心献一盏霄灯给师父，说不定他心情一好就愿意传授我了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210206,
					"content": "但我实在找不到浮生石了，看见了有一盏霄灯卡在那，就想去把那盏霄灯的浮生石拿过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210207,
					"content": "结果就是这样了…唉，霄灯我还是别要了，给你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "快拳阿凌"
				},
				{
					"id": 718210208,
					"content": "居然被魔物逼成这样，我的基本功果然还是不到家啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "快拳阿凌"
				}
			]
		},
		{
