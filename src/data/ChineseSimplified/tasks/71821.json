					"宏宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "怎么被派到这种活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "旅行者你可能不了解，每年海灯节的霄灯都是要回收的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210104,
					"content": "但霄灯放飞的时候是好看，飞出去之后，总是问题多多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210105,
					"content": "有的灯罩没做好，飞到一半灯罩坏了，就只剩一块浮生石到处乱飞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210106,
					"content": "有霄灯被风一吹，卡在了什么犄角旮旯里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210107,
					"content": "这样子一是有安全隐患，二是影响了市容，所以总务司一般都派了专人负责回收这些霄灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210108,
					"content": "这不，今年就轮到我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210109,
					"content": "但海灯节放的霄灯数量太大了…如果全堆到节日结束的那一天，我肯定忙不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210110,
					"content": "所以只能大家一边放，我一边回收那些落到犄角旮旯，已经坏掉的霄灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210111,
					"content": "但就这样，我一个人也已经忙不过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210112,
					"content": "旅行者，如果你愿意帮忙的话，就帮我去看看这几处有没有需要回收的霄灯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210113,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "我把那几个地点给你标在地图上，那么就拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏宇"
				}
			]
		},
		{
			"id": 7182102,
