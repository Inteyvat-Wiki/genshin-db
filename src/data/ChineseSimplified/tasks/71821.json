				"points": []
			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "怎么样，那些地方有需要回收的霄灯吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210302,
					"content": "回收了三盏霄灯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "多谢了，要回收那些地方的霄灯真是太费事了，我每次过去都累得要命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210304,
					"content": "有你帮忙，我总算能轻松点了。对了，这是给你的报酬，辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏宇"
				}
			]
		},
