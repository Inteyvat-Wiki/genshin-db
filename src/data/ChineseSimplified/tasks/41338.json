			"dialogs": [
				{
					"id": 413380501,
					"content": "两条赛道体验下来的感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380502,
					"content": "还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "那就太好了， 这下我就可以正式去跟千岩军申报了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380504,
					"content": "这么有趣的冒险活动，肯定会有很多人想要加入冒险家协会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380505,
					"content": "对了，这是你帮我评估赛道的报酬，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
