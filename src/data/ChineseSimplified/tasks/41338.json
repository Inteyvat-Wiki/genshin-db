					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "这里就是终点啦。你飞得很熟练嘛…这条路给你的感觉怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380302,
					"content": "很有节日的氛围…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "嘿嘿，那当然了，这些可都是我特意布置的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380305,
					"content": "那我们接着去下一条赛道吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380303,
					"content": "霄灯挺好看的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
