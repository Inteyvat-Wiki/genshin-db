			},
			"dialogs": [
				{
					"id": 413380201,
					"content": "这里就是这条赛道的起点了，你看，我还布置好了霄灯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380202,
					"content": "好嘞，那你准备好了就开始吧，一边搜集霄灯，一边飞到终点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				}
			]
		},
		{
