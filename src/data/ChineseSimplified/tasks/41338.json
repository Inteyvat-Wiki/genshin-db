				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "呃…怎么都没有人来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "旅行者！请、请听我说…最近不是海灯节吗？协会想要借着节日的氛围宣传一下，然后试着招募冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380104,
					"content": "我听说小千想出了一个什么…什么图的新玩法，我也不能落后！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380105,
					"content": "所以我也构想了一套活动方案，叫…「冒险行动初体验」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380106,
					"content": "简单来说，就是我想要以霄灯做标识，标记出一条空中的飞行道路来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380107,
					"content": "然后，想要体验这个活动的人，就可以展开「风之翼」，顺着霄灯一路飞过去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380108,
					"content": "既能体验冒险的刺激感，又能俯瞰璃月的美景，还有霄灯在旁边，是不是感觉很不错？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380109,
					"content": "我本来设计了两条赛道，但我跟千岩军报备的时候，他们却要求我事先找人评估安全性，就是先找人试飞一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380110,
					"content": "你应该很有冒险经验吧？如、如果你愿意的话，能帮我去「评估」一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380111,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "谢谢你愿意帮忙，那我们快去天衡山吧，我布置的第一条赛道是从那里开始的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				}
			]
		},
		{
			"id": 4133802,
