				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "旅行者！快看快看，我这身衣服怎么样？好不好看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330102,
					"content": "这身衣服…难道？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "没错！我已经通过冒险家协会的考试了，正式成为一名冒险家啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330104,
					"content": "很帅气！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "嘿嘿，谢谢你。我还想让哥哥也试试看呢，结果他怎么样都不肯去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330107,
					"content": "我对冒险没什么兴趣…再说了，我们俩都做了冒险家，谁来照顾爸妈啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200330108,
					"content": "那我们就把爸妈都带上，一起去世界各地旅行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330109,
					"content": "你啊…行了，既然当上了冒险家，那就好好干，家里的事我来打理就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200330110,
					"content": "但是！一定要注意安全，不要把自己弄伤了，也不要太累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200330111,
					"content": "知道啦知道啦！我要出去执行委托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330112,
					"content": "旅行者，你要和我一起去吗？我还想请教你许多有关冒险家的问题呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330113,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "好，我看看啊…这次的委托是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330116,
					"content": "护送货运热气球！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330114,
					"content": "出发吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "恭喜你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
