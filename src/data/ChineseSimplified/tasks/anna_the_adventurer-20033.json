			"dialogs": [
				{
					"id": 200330201,
					"content": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330202,
					"content": "不过，冒险家平时去执行的委托，都是这种事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330203,
					"content": "会有其他委托的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "你的语气也太无奈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200330207,
					"content": "是这样吗…好嘞！那我要继续努力了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330208,
					"content": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330209,
					"content": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330210,
					"content": "现在我的病已经好了，也成为了冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330211,
					"content": "嘿嘿，是时候帮我哥哥完成一些梦想啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330205,
					"content": "你慢慢就会知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "喂，你的表情不要这么疲惫啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "安娜"
				}
			]
		},
