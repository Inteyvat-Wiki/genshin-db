			},
			"dialogs": [
				{
					"id": 751790901,
					"content": "伊、伊察霍，清、清单上还差好多东西，你、你来帮忙找找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "马索瑟"
				},
				{
					"id": 751790902,
					"content": "唉…别费那个劲了，我都看过了。基本都是一些易损的东西，就之前又是火山又是翻车的，你觉得还能有得剩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790903,
					"content": "省点力气，好好歇一会。等大姐她们回来，还有好长的路要走呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790904,
					"content": "不、不行！算、算了，你不去我去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马索瑟"
				}
			]
