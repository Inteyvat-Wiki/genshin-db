					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "那边的，住、住手！这些都是我们的！不许动！告诉你，我、我可是能参加「巡夜者战争」的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "马索瑟"
				},
				{
					"id": 751790102,
					"content": "你、你要是敢抢我们的东西，我一定让你吃不了兜着走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "马索瑟"
				},
				{
					"id": 751790103,
					"content": "唉…今天怎么回事儿啊？又是火山喷发，又是紫色嵴锋龙的…现在又冒出一堆劫道的来，真是倒霉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790104,
					"content": "#马索瑟，{M#他}{F#她}看起来蛮厉害的，打不过的，还是算了吧…而且，我们只是看比赛的，应该不算是参加了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790105,
					"content": "#伊察霍，你、你这家伙！你怎么能这样，这可是大家的东西！再、再说了，我、我们两个打{M#他}{F#她}一个，未必打不过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "马索瑟"
				},
				{
					"id": 751790106,
					"content": "谁说是两个人？要挨打你上，可别算上我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790107,
					"content": "#这位{M#大哥}{F#大姐}，东西我们不要了，你想要你就拿去。只要别动手就行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790108,
					"content": "这肯定是有点误会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "你们都误会啦！我们可是乐于助人的好冒险家，才不是那种不明不白的坏人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751790112,
					"content": "我、我凭什么相信你们！啊！好痛，伊察霍你为什么打我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "马索瑟"
				},
				{
					"id": 751790113,
					"content": "人家要不怀好意，早就揍你了，还用得着跟你在这里浪费口舌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790114,
					"content": "两位，实不相瞒，我们商队刚刚被打散了，既然你们是冒险家的话，不知道能不能帮我们通知一下老大，就说我们在这里等她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790115,
					"content": "箱子里的东西，就当是我们给的谢礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790116,
					"content": "这个简单，就交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751790109,
					"content": "你倒是挺上道的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "喂！你这说法！别搞得我们像是那种坏人一样啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
