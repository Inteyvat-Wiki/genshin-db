			"dialogs": [
				{
					"id": 751790201,
					"content": "吁吁——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "扎什"
				},
				{
					"id": 751790202,
					"content": "还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "还、还好，就是刚刚跑得有点急，心、心慌得厉害，缓一缓就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎什"
				},
				{
					"id": 751790204,
					"content": "好好休息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "嗯，谢、谢谢关心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎什"
				}
			]
		},
