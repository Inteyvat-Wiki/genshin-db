			"dialogs": [
				{
					"id": 751790401,
					"content": "喂！你，对就是你，外面危险，快进来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "蒂兹洛"
				},
				{
					"id": 751790402,
					"content": "哎呀，你没看见这一路的惨相吗？这又是火山喷发，又是有怪物拦路的，可不敢再往前走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "蒂兹洛"
				},
				{
					"id": 751790403,
					"content": "你呀，听我一句劝。先在这里等等，等一下跟我们商队的人一起走，这样也有个照应。要不然一个人走多危险啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "蒂兹洛"
				},
				{
					"id": 751790404,
					"content": "怪物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "是一群紫色的嵴锋龙！一看就是被深渊污染了！破坏力特别强，说实话我从来没见过这么吓人的嵴锋龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "蒂兹洛"
				},
				{
					"id": 751790406,
					"content": "我跟你说，那几个家伙随便扫了一下尾巴就把我们的大车给打坏了，力气比突角龙还大，这肯定不是一般人能处理的对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "蒂兹洛"
				},
				{
					"id": 751790407,
					"content": "你听我一句，你可千万不要头脑一热跑去跟它们打架啊，见到它们还是绕开一点为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂兹洛"
				},
				{
					"id": 751790408,
					"content": "没事，我能行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "你，唉…好吧，那你路上小心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂兹洛"
				}
			]
		},
