			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萨博兰",
					"苏法什",
					"西梅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "阁下。我代表铃风王国欢迎您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700102,
					"content": "接下来你们准备怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "唔…首先，我会向整个王国公告，圣物已经做出了判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700104,
					"content": "守护者嘛…则是那位远道而来的福罗贝尔先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700105,
					"content": "欸？！为什么要这么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700106,
					"content": "想要向大家解释我们所经历的那件事，实在是太过复杂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700107,
					"content": "而且，大家一时半会应该也没法理解，为什么我既是公主，又是守护者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700108,
					"content": "等到时机合适的时候，我会将所有的事详细地记录下来，以书面的形式告诉所有国民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700109,
					"content": "在那之前，我还是会以公主的身份主持王国的各项事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700110,
					"content": "等到将那些「试炼场所」正式改造成了「锻炼场所」后，我就会启程了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700111,
					"content": "启程？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "公主殿下，你还记得…在洞窟的时候，那个圣物究竟是为谁亮起的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700114,
					"content": "欸？为谁…亮起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700115,
					"content": "对啊，当时我们都在圣物旁边。公主殿下当然值得被认可，但是我、我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700116,
					"content": "你可是被冠军认可的冠军。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "对呀。那个冠军可都是专门来拜托你了，这还有什么不值得认可的说法呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700118,
					"content": "也许是因为公主殿下的光芒太耀眼，大家都搞错了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700119,
					"content": "噗…那么冠军先生，你愿意再接受一次试炼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700120,
					"content": "由我，铃风王国的西梅公主，亲自用圣物为你见证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700121,
					"content": "当然！我愿意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700122,
					"content": "你别激动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "一说起公主殿下就这么激动。嘿嘿，福罗贝尔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700125,
					"content": "你们别误会啊！我是、我是为了雨歌塘的使命！我经历了那么多训练，就是为了拯救…那个，保护公主殿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700126,
					"content": "这么重要的任务，我当然要确保万无一失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700127,
					"content": "你愿意和公主殿下同行吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "愿、愿意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700129,
					"content": "呵呵，那样最好。那么福罗贝尔，冠军先生，准备好接受我的试炼了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700130,
					"content": "是的，公主殿下！随时都行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700131,
					"content": "呜哇！圣物又亮起来了！亮、亮过头了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790700123,
					"content": "耳朵，耳朵好痛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "你要去做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
