						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福罗贝尔",
					"奥雷卢",
					"埃斯唐普"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "埃斯唐普！你之前都去哪了！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700202,
					"content": "呃，我去周围逛了逛，尝试了一下那个试炼，还挺有趣的，就是得用点别的方法通过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700203,
					"content": "你们的事我都听奥雷卢先生说了，不错啊，「守护者先生」。你这不是挺有本事的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700204,
					"content": "你、你、你…你要是在我旁边！我准把你推出去！有十次，我就推十次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700205,
					"content": "所以我才去试炼了。福罗贝尔，好朋友，我相信你搞得定。瞧，你果然搞定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700206,
					"content": "哈哈哈哈哈，你们这两位好先生啊，今天可是咱们雨歌塘的吉利日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "奥雷卢"
				},
				{
					"id": 790700207,
					"content": "咱们终于拥有了一位真正的冠军，虽然福罗贝尔先生还没有机会拯救公主，但我相信他会有显示身手的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "奥雷卢"
				},
				{
					"id": 790700208,
					"content": "唉！我什么也没做，奥雷卢先生，我光是待在旁边看着，全是公主殿下在忙前忙后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700209,
					"content": "那不更好？难不成您想公主殿下遇见危险？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "奥雷卢"
				},
				{
					"id": 790700210,
					"content": "我…这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700211,
					"content": "哎哟，好了。福罗贝尔先生，您可是接过了那位西布雷吕的使命啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "奥雷卢"
				},
				{
					"id": 790700212,
					"content": "胡说！我都不知道他究竟是不是西布雷吕！我只听说过他，没听过他说话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700213,
					"content": "而且，你还接受了那位公主的试炼。真不愧是冠军啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700214,
					"content": "咱们能先别谈这件事吗？拜托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "福罗贝尔"
				},
				{
					"id": 790700215,
					"content": "总之，咱们雨歌塘的未来，可都交给你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "奥雷卢"
				},
				{
					"id": 790700216,
					"content": "这下，我们总算可以没有任何压力的跳跃了，我回去就向组委会建议，在跳远比赛里加入更多趣味性的内容！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "奥雷卢"
				},
				{
					"id": 790700217,
					"content": "这是个好主意，我愿意主持，咱们这就回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "埃斯唐普"
				},
				{
					"id": 790700218,
					"content": "你们别把我甩在这里啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福罗贝尔"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"西梅",
					"萨博兰",
					"苏法什"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "您和那位纸蛙，全都被认可为了守护者？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "萨博兰"
				},
				{
					"id": 790700302,
					"content": "不可思议，从未听说！这之前也没有过记录啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "苏法什"
				},
				{
					"id": 790700303,
					"content": "而且您还要改造试炼…不行！不行啊！公主殿下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "萨博兰"
				},
				{
					"id": 790700304,
					"content": "您不能把这么古老的传承随便改造啊！公主殿下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "苏法什"
				},
				{
					"id": 790700305,
					"content": "好了好了，你们小点声，我的耳朵都被震痛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700306,
					"content": "事情已经这么定下来了。我现在可既是公主，又是被圣物认可的守护者，你们更拦不住我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700307,
					"content": "但是，公主殿下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "萨博兰"
				},
				{
					"id": 790700308,
					"content": "你们就放心吧。我会主持锻炼仪式，训练出许多可靠的飞鼠来保护王国的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700309,
					"content": "在那之后，我才会离开王国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "西梅"
				},
				{
					"id": 790700310,
					"content": "殿下，我们…唉，您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "苏法什"
				},
				{
					"id": 790700311,
