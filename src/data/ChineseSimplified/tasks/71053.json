			"dialogs": [
				{
					"id": 710501401,
					"content": "先不说其他的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501402,
					"content": "在层岩巨渊的这几天，你做了很多，我都不知道应该怎么感谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501403,
					"content": "如果再给你钱，也实在是太过生分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501404,
					"content": "其实你一定要给的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "别开玩笑了，我怎么能做出给你一笔钱了事，这种不解风情的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501406,
					"content": "那不是在污辱你吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501407,
					"content": "来，收好这封信吧，如果你以后有机会去须弥，遇到了什么麻烦，或有什么需要帮助的，那就拿着这封信找普尔比鲁尼一门的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501408,
					"content": "我们一定会尽全力帮助你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501409,
					"content": "「往来的人情，比黄金还宝贵。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501410,
					"content": "这句须弥谚语，说的就是这样的情形吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				}
