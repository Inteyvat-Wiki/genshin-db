				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "从实验数据来看，这次的发明也圆满完成了。谢谢两位帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120102,
					"content": "多谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120103,
					"content": "你看，我就说会顺利吧。毕竟弗雷瑞斯前辈是这方面的天才，区区一个远距离操控炮台，做起来肯定是轻轻松松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120104,
					"content": "是，是啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120105,
					"content": "那抓紧时间，开始做下一个发明吧！正好我有个很感兴趣的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120106,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120107,
					"content": "可以探索天空的浮空艇怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120108,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120109,
					"content": "或者能挖掘地底深处的超级钻头？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120110,
					"content": "哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120111,
					"content": "感觉她在刁难弗雷瑞斯呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745120112,
					"content": "很难做到吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "拒绝了枫丹科学院三次的弗雷瑞斯前辈，肯定能做出这些科学院做不出来的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120114,
					"content": "那当然了。只能说…稍微有点棘手，不过问题不大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120115,
					"content": "唉，不过我突然又不想要这些了。飞到天上或者钻到地里，想想也很无聊。天上很冷，地下很闷，没什么好玩的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120116,
					"content": "嗯，我也赞同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120117,
					"content": "那弗雷瑞斯前辈可以做一个平时能用到的发明吗？对了，我早上喜欢睡懒觉，可以请前辈帮我做个早餐自动烘焙机吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120118,
					"content": "这个听起来倒是能做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745120119,
					"content": "她之前是故意的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "好，我先想想怎么设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745120121,
					"content": "好耶，那我就当你答应啦。做不到的话，以后我的早餐就由弗雷瑞斯前辈本人来做好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 745120122,
					"content": "这是什么要求…总之放心吧，这种小发明我肯定能做出来。我可是这方面的「天才」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗雷瑞斯"
				}
			]
		},
