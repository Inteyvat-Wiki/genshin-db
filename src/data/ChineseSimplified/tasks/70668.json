			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「小王子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是大师牌手了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680202,
					"content": "喵。「成为大师牌手的意思就是…你的牌技已经超过很多钻研此道的人了，不付出努力的人是达不到这样的境界的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680203,
					"content": "「当然，不愿意付出努力的人，一定也无法理解为何我们会孜孜不倦地在他们看来只是玩乐的游戏上付出时间吧…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680205,
					"content": "喵！「被你邀请过来的牌手，如果听闻你已经获得了大师的头衔，想必也会更认真地对待与你的对局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680206,
					"content": "「说不定也有听闻你成为大师牌手后，才愿意让你去挑战他设下的牌局的牌手呢…酒馆里也有这种乖僻的家伙。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680207,
					"content": "#喵…「那么，{NICKNAME}…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680208,
					"content": "「希望你能感受到『七圣召唤』的乐趣！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「小王子」"
				}
			]
		},
