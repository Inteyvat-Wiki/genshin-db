			"dialogs": [
				{
					"id": 222000301,
					"content": "你找到那道最容易填饱肚子的菜了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000302,
						222000304
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000302,
					"content": "做好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000303
					]
				},
				{
					"id": 222000303,
					"content": "那太好了，让我尝尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				},
				{
					"id": 222000304,
					"content": "还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000305
					]
				},
				{
					"id": 222000305,
					"content": "好吧，渔人吐司的话，「万民堂」平时就有卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000307,
					"content": "唔，我听从蒙德来的商人说，「猎鹿人」餐馆有一道嘟嘟莲海鲜羹，感觉味道应该很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000308,
					"content": "还有蒙德烤鱼和甜甜花酿鸡，这两道菜做起来应该很简单吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000309,
					"content": "咕噜…啊…一报菜名肚子更饿了咕噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				}
			]
		},
