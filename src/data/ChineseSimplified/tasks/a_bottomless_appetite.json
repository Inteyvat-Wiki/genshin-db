			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"一成"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "你好，有什么咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000102,
					"content": "唔，肚子又发出声音了。我是说，有什么可以帮你的咕噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000103,
					"content": "呃，你说什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "唉，每次我肚子饿的时候都会这样，咕噜咕噜的，声音特别大，连我说话的声音都盖过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000105,
					"content": "虽然…咕噜…也去「不卜庐」看过了，但医生说我只是单纯肚子饿了，不是病，所以没法治咕噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000106,
					"content": "医生说只要我吃饱了就好，但是我…我食量比人家都大啊咕噜，要是一直吃到吃饱的话，我的钱包也撑不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000107,
					"content": "嘉义和我说，如果正餐没吃饱，那就饭后再吃点东西垫一垫，至少别影响到工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000108,
					"content": "但是这「垫一垫」…我有很多想吃的菜，但也不知道哪个最容易填饱肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000109,
					"content": "旅行者，你经常在野外跑，肯定知道吃什么最容易填饱肚子，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000110,
					"content": "不如你来帮我，在我想吃的菜里面选出好吃又能填饱肚子的菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000111,
					"content": "你这次想吃什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "我想吃的东西可多了…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
