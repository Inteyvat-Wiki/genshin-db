					"一成"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "唔，我听说，有些蒙德菜味道不错，比方说甜甜花酿鸡、蒙德烤鱼、渔人吐司还有嘟嘟莲海鲜羹咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000202,
					"content": "拜托你了，把你觉得最容易填饱肚子的菜带给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000203,
					"content": "吃完的话，至少今天肚子就不会叫了吧咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				}
			]
		},
