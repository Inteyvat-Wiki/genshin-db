			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "是会飞的妖精！我的笔记…重要的笔记被愚人众扣下来了，你能帮我找回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910102,
					"content": "虽然我不是妖精…但这点小忙也不是不能帮啦。话说回来，愚人众为什么会扣留小孩子的笔记呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760910103,
					"content": "说不定是害怕我将笔记上的内容公之于众…你们要是能帮我把笔记找回来，我就把这个秘密也告诉你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910105,
					"content": "这些待会儿再说，拜托你们先帮我<color=#00E1FFFF>找回笔记</color>吧，说不定还有些从笔记本里<color=#00E1FFFF>散落的纸页</color>，就在那边，有愚人众的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
