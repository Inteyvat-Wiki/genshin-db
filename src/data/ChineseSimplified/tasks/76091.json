			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "将之前捡到的笔记本和纸页交给了他…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "我看看…没错！就是这些，太感谢了。这里面可是记录了不少愚人众的罪证呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910205,
					"content": "…罪证？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760910206,
					"content": "你瞧他们在帕哈岛上建的那些设施，还有他们带来的机械装置…那里原本也是很多动物的家呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910207,
					"content": "我刚从绯沙盐沼回来，一定是因为愚人众的机器，那边的水母都奄奄一息了…我得让大家都知道这件事才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910208,
					"content": "欸？是说落落莓果冻它们吗，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760910209,
					"content": "讲述了在绯沙盐沼的经历…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "果然还是太晚了吗…但是不管怎么说，都应该留下记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910211,
					"content": "这份笔记就交给你们了。我得快点回去把其他的笔记的内容整理好，写成文章才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910213,
					"content": "对了，如果你们要和别人说，一定要说是谢苗，也就是我告诉你们的。毕竟回去写成文章在报纸上刊登还需要时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910214,
					"content": "总之多谢你们，再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
