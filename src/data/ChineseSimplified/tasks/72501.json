	"talks": [
		{
			"id": 7250102,
			"completionStepIds": [
				7250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7250102",
							"2"
						],
						"stepId": 7250102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝雾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "森子小姐怎么总是分给我这种奇怪的稿件啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010202,
					"content": "你还在画插画吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "你又没灵感了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "呀！旅行者，你怎么来了，好久没看到你，我还以为你已经去别的地方旅行了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010205,
					"content": "唉…要是我身体能好点，我也想和你一样出去旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010206,
					"content": "这样的话，就不用每天都被森子小姐当面催稿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010207,
					"content": "上次我画的那些稿件似乎很受好评，好多老师都专门要我给他们画插画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010230,
					"content": "虽然森子小姐已经帮我推掉了很多约稿，但留下来的那一部分也还是太多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010208,
					"content": "而且，「八重堂」里的老师们所写小说的题材越来越…越来越夸张了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010209,
					"content": "我最开始以为他们除了稻妻之外，最多就写一写蒙德啦，璃月啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010210,
					"content": "但老师们笔下小说的题材…已经立足须弥，放眼枫丹啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010216,
					"content": "嗯…说回正事，旅行者啊，你手上的那台「留影机」还好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010217,
					"content": "我觉得它应该还挺好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "你又要我帮你拍画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "你看，上次我给你开的报酬还不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010220,
					"content": "旅行者，就请你再帮我去世界各地拍一拍画片吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010221,
					"content": "唉，交给我吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "你去冒险家协会挂个委托吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "那就拜托你了！嘿嘿，我早就把笔记本准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010223,
					"content": "要是你不来找我呀，我可都要拜托森子小姐去找你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010225,
					"content": "呜哇！别呀！拜托你了，拜托你了嘛！我去冒险家协会挂过委托，但就是找不到会熟练使用留影机的冒险家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010226,
					"content": "你就帮帮我吧旅行者，我要是交不出稿，森子小姐又要跑来和我一起住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010227,
					"content": "我可受不了她做的那种绯樱泡饭啊，旅行者！你就帮帮我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "朝雾"
				},
				{
					"id": 725010228,
					"content": "我知道了，我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "呼…那就好，稍等一下啊，我找一下笔记本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝雾"
				}
			]
		}
	]
}