				]
			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "令人仰止。晚生叹服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100202,
					"content": "#既是如此…在下还有一个不情之请。不知{M#郎君}{F#女侠}可曾听说过<color=#00E1FFFF>纵云之法</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100203,
					"content": "传闻我等先师古华，曾在华光紫气中登临高天，踏空而行，如履平地，正是靠这传说中的秘法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100204,
					"content": "听着有点离谱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "是啊，听着就像是假的…不过这么说来，要是能用风之翼的话，说不定也可以做到类似的效果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762100207,
					"content": "#哦？那便请{M#郎君}{F#女侠}示范一二了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100206,
					"content": "如果能用风之翼的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
