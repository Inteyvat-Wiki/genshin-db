			},
			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#郎君}{F#女侠}果然好身法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100102,
					"content": "#嘿嘿，那是当然！{NICKNAME}可是很强的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762100103,
					"content": "#接下来，不知{M#郎君}{F#女侠}可否向在下展现<color=#00E1FFFF>纵跃法</color>的精髓？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100104,
					"content": "据书中记载，我古华先师跳墙越城，如登平地，真有飞檐走壁之能，是为纵跃之法——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100105,
					"content": "好厉害！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#嗯…要不然试试看？毕竟{NICKNAME}平时到处翻宝箱，也爬过很多地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762100106,
					"content": "听着像飞贼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#呵呵，{M#郎君}{F#女侠}请想，若是飞贼能逾墙而走，我等锄恶扶正之人却不能，岂不是要被那奸邪之徒轻易走脱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "长孙继璟"
				}
			]
		},
		{
			"id": 7621002,
