			"dialogs": [
				{
					"id": 762100301,
					"content": "二位请看。这便是我古华堂的「望梅之阵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100302,
					"content": "#可否请{M#郎君}{F#女侠}在规定时间内依次踏过由在下指出的石桩，向在下展示身法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100303,
					"content": "小事一桩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "虽然其实有好多好多桩就是了…呃，没什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762100307,
					"content": "#那么，便请{M#郎君}{F#女侠}一展身手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "长孙继璟"
				},
				{
					"id": 762100305,
					"content": "其实派蒙派掌门派蒙也能做到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "做不到！不管怎么想都——咦？仔细想想好像还真能做到…不过，用飞的应该算犯规吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "派蒙"
				}
			]
