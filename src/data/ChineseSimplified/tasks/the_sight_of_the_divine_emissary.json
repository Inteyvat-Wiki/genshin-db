			"dialogs": [
				{
					"id": 736870301,
					"content": "《拜托了我的狐仙宫司》巫女主题得票情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870302
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870302,
					"content": "《奥西兹小姐事件簿》奥西兹小姐主题得票情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870303
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870304
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870304,
					"content": "投票流程公开透明，结果公平公正，特此公示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "由宇"
				}
			]
		}
	]
