	"talks": [
		{
			"id": 7368701,
			"completionStepIds": [
				7368701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368701",
							"2"
						],
						"stepId": 7368701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"由宇",
					"铁也"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870101,
					"content": "已经有不少人围在公告板前了呢，让我看看让我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870102,
					"content": "啊，没想到票数差了这么多，我还以为像「演武传心」这样有稻妻特色的赛事，肯定是政子小姐获胜呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870103
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870103,
					"content": "意料之中，毕竟「奥西兹小姐事件簿」可是新锐人气作品。不仅故事有趣，插画页里的枫丹服饰也很有特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870104
					],
					"speakerTitle": "铁也"
				},
				{
					"id": 736870104,
					"content": "而且你不觉得，奥西兹小姐的身份也和神里小姐很相称吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870105
					],
					"speakerTitle": "铁也"
				},
				{
					"id": 736870105,
					"content": "嗯…虽说奥西兹小姐争强好胜，又喜欢恶作剧，和神里小姐一点都不一样，但能看到穿枫丹服饰的神里小姐倒也是一桩惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870106
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736870106,
					"content": "咦，他们到底在说什么呀，我都有点糊涂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870107,
					"content": "欸，你看！公告板上演武传心服装投票的几个选项，「拜托了我的狐仙宫司」、「奥西兹小姐事件簿」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870108,
					"content": "等一下等一下，之前我们听说的投票，不是选择稻妻的四季风物吗？什么时候变成了轻小说主角的服装了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870109,
						736870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870109,
					"content": "难道最后修改了方案？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				},
				{
					"id": 736870111,
					"content": "我觉得有必要去问问这件事。走，我们赶快到社奉行去找绫华吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870110,
					"content": "难道投票出了什么差错？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				}
			]
		},
		{
			"id": 7368702,
			"completionStepIds": [
				7368702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368702",
							"2"
						],
						"stepId": 7368702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"水田",
					"小野寺",
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870201,
					"content": "真是万分抱歉，是我把两个装着选票的箱子弄混了！等到小野寺先生出差回来发现这件事，就已经是公布结果之后了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870202
					],
					"speakerTitle": "水田"
				},
				{
					"id": 736870202,
					"content": "唉，之前为了防止泄密，特意没有在选票上标记投票的标题，没想到最后竟然会弄巧成拙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870203
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870203,
					"content": "啊，不会吧…演武传心的服装投票，原来真是出了差错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870204,
					"content": "旅行者，派蒙，看来你们也得知投票结果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870205
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870205,
					"content": "是啊，不只是我们知道了，我们来的一路上，感觉大家都在讨论这件事呢。这可怎么办啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870206,
					"content": "神里小姐，造成这样严重的事故是我们的责任，我现在就去重新组织投票，一定会把这件事说明清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870207
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870207,
					"content": "不，小野寺先生，请先等一下，事情或许还有其他解决方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870208
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870208,
					"content": "选票弄错的事，目前只有我们这些筹备赛事的工作人员知道，普通民众并没有察觉到选票有什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870209
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870209,
					"content": "而且，当大家得知表演赛上会出现流行作品中的服饰，却并没有什么不满和怨言。相反，大家似乎都认为这是意外惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870210
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870210,
					"content": "既然我们的目的之一，是让更多人对这场比赛产生兴趣，那么这个差错造成的后果，不应该称作「事故」才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870211
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870211,
					"content": "绫华，你的意思难道是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870212,
					"content": "嗯，我觉得不如将错就错。最后的表演赛上，我穿着现在投票结果选中的服饰上场即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870213
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870213,
					"content": "可是这…也太为难神里小姐了，毕竟小说人物的衣服，并不像演武华服那样是为了战斗而设计的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870214
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870214,
					"content": "没关系，小说里那件枫丹风格的裙装，造型并不算繁冗，对我来说应该不会有太大影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870215
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870215,
					"content": "即使和平日里的装束不同，我也会努力适应它的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870216
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870216,
					"content": "哇，绫华说是说得很平静，但好有魄力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870217,
					"content": "好，我明白了…既然这样，那就按照神里小姐的办法来办。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870218
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870218,
					"content": "我们为读者见面会准备的服装，这两天会根据神里小姐的身材进行裁剪调整，保证在表演赛上达到最佳效果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870219
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736870219,
					"content": "嗯，那就辛苦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870220
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870220,
					"content": "绫华，要穿着小说角色的服装参加表演赛，真的没关系吗？你没有在我们面前勉强自己吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870221,
					"content": "放心吧。我此刻很轻松，还有些欣喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870222
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870222,
					"content": "之前，一想到要身着华服登上表演赛的舞台，我就难免担心，自己在场上的举止是否足够得体美观，配得上观众们的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870223
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870223,
					"content": "不过，如果穿着小说角色的衣服，应该就不用考虑这么多了。因为书中那位侦探小姐，可是出了名的我行我素、又酷爱恶作剧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870224
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870224,
					"content": "这样一来，观看表演赛的大家，应该也能从传统形式中品味出新的乐趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870225
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870225,
					"content": "（原来绫华是这样想的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870226
					]
				},
				{
					"id": 736870226,
					"content": "不，还不只是这样。不如说在我内心深处，也一直期待着有朝一日，能打扮成与平常不同的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870227
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870227,
					"content": "旅行者，我还记得刚认识你不久的时候，曾听你说过，璃月、蒙德…各个国家的服饰都各有特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870228
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870228,
					"content": "那时候的我，完全无法想象未来某天，自己也能切身体会这些异国风情。不过现在，所有曾经不可能的愿望，都不再遥远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870229
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870229,
					"content": "而且，母亲生前也一直很向往其他国家的服饰。这一次，我又帮助母亲完成了一个心愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870230
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870230,
					"content": "这样想的话，这件特别的衣服，的确可以被称作惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870231
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870231,
					"content": "嘻嘻，这么看来，虽然弄错了投票，但结果却是一件好事呢。好，既然这件事已经圆满解决了，那我们就准备去赛场吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736870232,
					"content": "嗯，我相信旅行者的实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870233
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736870233,
					"content": "等我和小野寺先生确认了服装尺寸后，也会前往赛场观看你们的对决的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				}
			]
		},
		{
