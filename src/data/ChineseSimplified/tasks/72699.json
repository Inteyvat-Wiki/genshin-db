			"dialogs": [
				{
					"id": 726990101,
					"content": "不知阁下的剑技到底水平如何，这一战我非常期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990102,
					"content": "你怎么也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "其实，我之前说有四位武者，是把自己也算在其中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990104,
					"content": "虽说我是这场决斗的主办人，但无奈参与者实在太少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990105,
					"content": "更何况，此身为战斗而生，既然遇到了强大的对手，就没有不与对方一战的道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990106,
					"content": "哈哈，我想说这句台词很久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990107,
					"content": "喂，这人到底行不行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726990108,
					"content": "不能轻敌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "说得好！阁下这种对所有对手一视同仁的态度，让我肃然起敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990110,
					"content": "之前，如果不是因为我以貌取人，看轻了第四位武者，那场战斗也不会输得那么惨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990111,
					"content": "#不过现在，我已经不是当时的我了！那么，{NICKNAME}，开始比试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990114,
					"content": "来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990112,
					"content": "等等，让我准备一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "我明白了，阁下先准备就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彦太郎"
				}
			]
		}
	]
