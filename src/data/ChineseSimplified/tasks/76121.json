			"dialogs": [
				{
					"id": 760540301,
					"content": "这样对吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540302,
					"content": "我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540303,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540304,
					"content": "月亮…月亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540305,
					"content": "这里怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540306,
					"content": "这次是我赢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540307,
					"content": "我的三个月亮连起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540308,
					"content": "嗯，这样就赢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540309,
					"content": "嗯…月升月落，真是漫长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540310,
					"content": "我们的月亮谁都不让谁呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540311,
					"content": "是不是…快平手了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540312,
					"content": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540313,
					"content": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540314,
					"content": "不喜欢这个游戏吗？我觉得还挺有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540315,
					"content": "嗯？你是在盯着我看吗？我感觉得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540316,
					"content": "我的脸上…有关于「月亮」的答案吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540317,
					"content": "棋盘在那边哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540318,
					"content": "嗯，是你的「月亮」获胜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540319,
					"content": "这片夜空属于你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540320,
					"content": "啊…一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540321,
					"content": "与哥伦比娅在游戏中度过了一段愉快的时光…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "三个月亮连成一条线…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210203,
					"content": "怎么了？还在想刚刚那盘棋的输赢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210204,
					"content": "哦，没有。只是…如今回看这游戏，会有些不可思议的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210205,
					"content": "对哦，你获得了三个月亮的力量，那已经不只是能主宰夜空这种级别的东西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210206,
					"content": "嗯，我也会想，若是当初三位月之女神没有产生分歧的话，世界的命运说不定就变得不一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210207,
					"content": "她们看起来如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "唔…我最先见到的是虹月女神，桑娜妲。她比我想象中活泼一些，像个贪玩的妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210209,
					"content": "恒月女神艾莉亚是三位女神中最稳重的一位，富有领导力，对他人也很温柔。啊，就像菈乌玛一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210210,
					"content": "霜月女神卡侬…看起来是位既智慧，又有远见的女神。也就是她，把自己的月亮让给了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210211,
					"content": "听起来都是善良的神明…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "没错，尽管有所分歧，但她们都爱着提瓦特这个世界，爱着这个家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210213,
					"content": "当我说起未来的事情，她们看起来都很欣慰。一种为这个世界仍有如此丰富的未来感到高兴的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210214,
					"content": "也正因如此，她们才给予我力量，帮我回到了这个「家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210215,
					"content": "唔…真想见她们一面，对她们好好道一声谢呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210216,
					"content": "我也这么想，不过…那大概是不可能的事了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210217,
					"content": "好在这个世界仍在前行，她们所保护的人类也活了下来，传唱着她们的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210218,
					"content": "没错！只要好好地过日子，不让坏蛋毁了这个世界，就是对三位女神最好的感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210219,
					"content": "你还真会说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "那派蒙每天都在感谢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "那当然！我绝对每天都会把日子过得开开心心的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210222,
					"content": "哥伦比娅也是哦！每天都应该吃饱睡好，想玩游戏了就来找我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210223,
					"content": "哈哈，好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210224,
					"content": "以后玩「月亮棋」的时候，我或许都会想起那三位善良的女神吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
