			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210102,
					"content": "哥伦比娅，你好呀，你今天心情很好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210103,
					"content": "哈…上来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210104,
					"content": "噢！你是又想玩「月亮棋」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210105,
					"content": "嗯，很久没玩了，有点想念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210106,
					"content": "规则还和以前一样吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "不会因为你变成了三月女神，每次你都能多动几颗棋子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210108,
					"content": "那就变成作弊了，我不会用这种方式赢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210109,
					"content": "嘿嘿，我知道的啦，开个小玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761210110,
					"content": "那么，我们开始吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
