			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280301,
					"content": "怎么样？光钉有没有正常运行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280302,
					"content": "一切正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "嗯，一切正常是最好的情况，希望以后也不要出故障。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280304,
					"content": "这样一来，只要在特异体出现在光钉附近时启动光钉，特异体的能量供应就会被切断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280305,
					"content": "这次，你应该能够击败它了，放开手去干吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700280306,
					"content": "我相信你的实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
}