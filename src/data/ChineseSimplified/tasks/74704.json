				]
			},
			"dialogs": [
				{
					"id": 747040101,
					"content": "嗨！哥伦比娅。在欣赏水族箱里的鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747040102,
					"content": "嗯，你们把这里装点得很漂亮。有很多我以前没见过的鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040103,
					"content": "哥伦比娅以前去过水族馆吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747040104,
					"content": "没有，水族箱倒是在至冬见过几个。但我以前没睁眼，也不算是真正的「欣赏」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040105,
					"content": "现在感觉怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747040106
					]
				},
				{
					"id": 747040106,
					"content": "很美。水下的风景原来这么艳丽多彩，就好像大家永远生活在繁花盛开的春天一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040107,
					"content": "啊，你看那条鱼。上次就觉得它和桑多涅真像。还有那两条，一直互相跟随着对方行动，就像你们一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040108,
					"content": "真的欸！你这么一说还真是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747040109,
					"content": "那条一直很忙的像菈乌玛。那边在珊瑚间很警觉的又像奈芙尔小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040110,
					"content": "呃…难道说哥伦比娅看鱼的时候，喜欢去找它们和哪个朋友相似？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747040111,
					"content": "有些不太准确。更多是我喜欢朋友们，所以总是会在生活中不知不觉想起大家。看鱼的时候也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040112,
					"content": "哇！真高兴听你这么说。那还有什么鱼和大家比较像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747040113,
					"content": "唔…最近交到的新朋友很多。不是每个都能找到对应的鱼儿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040114,
					"content": "也是。不过我们也会不断丰富这些水族箱，哥伦比娅有时间可以多来看看，说不定就在里面找到其他朋友了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747040115,
					"content": "朋友们会到水族箱里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040116,
					"content": "是和朋友们相像的鱼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}