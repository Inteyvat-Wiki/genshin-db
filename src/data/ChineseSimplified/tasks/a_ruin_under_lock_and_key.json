			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宛烟",
					"克列门特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210801,
					"content": "你啊！简直掉进钱眼里了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210802
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110210802,
					"content": "你才是，天天挖文物，脑子里进灰了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210803
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110210803,
					"content": "还、还在吵…我们别打扰了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1102202,
			"completionStepIds": [
				1102202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102202",
							"2"
						],
						"stepId": 1102202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110220201,
					"content": "我听说，「地中之盐」曾经是「盐之魔神」的子民生活的地方，所以，嘿嘿…有价值的文物应该遍地都是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220202
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220202,
					"content": "传说中，在「盐之魔神」赫乌莉亚的庇护下，她的子民的确享受过一段时间的富庶生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220203
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220203,
					"content": "不过这个传说流传了很长时间，光顾此处的拾荒者与盗宝团不计其数，野外应该不会剩下多少有价值的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220204
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220204,
					"content": "啧，真扫兴…早知道这么穷酸就不来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220205
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220205,
					"content": "关于这个，我知道在这洞穴深处有一处遗迹，和「盐之魔神」有关。其实那也是「地中之盐」这个名字最初的由来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220206
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220206,
					"content": "只不过，这个遗迹的入口，被神秘的力量封印了，一直都没有人能够解开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220223
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220223,
					"content": "虽然我找到了一个可能和解封有关的机关，但即便解开了那个，封印还是纹丝不动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220207
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220207,
					"content": "所以目前，封印的由来和解除方法，都是「盐之魔神」的研究中，非常重要的课题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220208,
						110220209
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220208,
					"content": "和子民有关？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110220210
					]
				},
				{
					"id": 110220210,
					"content": "不知道，没有切实的证据。但封印存在的意义，多半是为了隐藏某种事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220211
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220211,
					"content": "「盐之魔神」善良仁慈，被众人爱戴，也有很强的权能，不会留下什么见不得人的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220212
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220212,
					"content": "那…想要藏匿事实的，很可能就是凶手，摩拉克斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220213
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220213,
					"content": "这不像是岩王爷会干出来的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110220214,
					"content": "这种事无所谓了，这么听起来，遗迹里面一定还放着「盐之魔神」的各种宝物？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220215
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220215,
					"content": "你究竟有没有听人说话，唉…里面就算有「盐之魔神」的遗物，解不开封印又有谁进得去呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220216
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220216,
					"content": "哎呀，我们不是有钟离先生在嘛！他看起来什么都懂，一个封印而已，难不倒他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220217
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220217,
					"content": "这个封印已经存在很长时间了，关于它的一切都是谜，就算是钟离先生也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220218
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220218,
					"content": "——略懂门道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220219
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220219,
					"content": "…欸？欸欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220220
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220220,
					"content": "坊间传闻中，流传着诸多与封印有关的碎片，看似杂乱无章，但其实暗含解印之法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220221
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220221,
					"content": "宛烟女士方才提到有一个可能和解封有关的机关，我们不妨就先去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220222
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220222,
					"content": "那…既然钟离先生这么说，好吧，那我来带路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220209,
					"content": "和帝君有关？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110220210
					]
				}
			]
		},
		{
			"id": 1102206,
			"completionStepIds": [
				1102206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102206",
							"2"
						],
						"stepId": 1102206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110220601,
					"content": "在进入遗迹之前，我有个提议，可以避免在孤云阁那样无谓的争吵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220602
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220602,
					"content": "嗯，先生请讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220603
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220603,
					"content": "请你们二位签订契约。契约的内容是：「顺次取物，每次一件」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220604
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220604,
					"content": "为示诚意，你们选取即可，不用把我列入序列。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220605
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220605,
					"content": "我也不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110220606
					]
				},
				{
					"id": 110220606,
					"content": "喂喂喂，这么好的机会，不要放弃得这么快嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110220607,
					"content": "我不同意！这意思是…我要和这个半吊子考古学家，平分收获？不可能！绝对不可能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220608
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220608,
					"content": "我不同意！哼！他就只会糟蹋「盐之魔神」留下的文物吧！我，我也不能接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220609
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220609,
					"content": "那么…若「契约」不能成立，我就不能继续担当顾问了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220610
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220610,
					"content": "这遗迹中藏着什么宝物和陷阱，就全凭两位的阅历去鉴别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220611
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220611,
					"content": "这、这…唉，这家伙我真的信不过。行吧，既然是被封印的「盐之魔神」的遗迹，就算只能拿一半，也够赚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220612
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220612,
					"content": "要我答应契约…也行。我只有一个要求，钟离先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220613
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220613,
					"content": "如果发现了「盐之魔神」的真相，请你一定要公正地判断，就算那真相是对摩拉克斯不利的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220614
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220614,
					"content": "交换条件如此，我可以接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220615
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220615,
					"content": "那么，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		},
		{
			"id": 1102207,
			"completionStepIds": [
				1102207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102207",
							"2"
						],
						"stepId": 1102207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110220701,
					"content": "这个地方…啊，我想起来了，好像是有几个奇怪的元素方碑。原来是有联系的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220702
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220702,
					"content": "怪不得，以前为了调查这个封印，我还专门请来了持有「神之眼」的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220703
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220703,
					"content": "结果方碑被点亮之后什么都没发生，然后就熄灭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220704
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220704,
					"content": "实际上，不仅是需要同时启动，这里的石碑如果不按照正确的顺序点亮，依旧无法解开封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220705
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220705,
					"content": "此处的玄机，藏于一句讲述魔神战争的话中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220706
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220706,
					"content": "「<color=#00E1FFFF>南</color>出天衡，<color=#00E1FFFF>东</color>入瑶光，<color=#00E1FFFF>西</color>登绝云，<color=#00E1FFFF>北</color>访轻策，诸地萧条，生灵涂炭。璃月广袤，竟难容一处安宁。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220707
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220707,
					"content": "南出…东什么？璃月人说话怎么这么难懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220708
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220708,
					"content": "我、我好像对这句话有印象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220709
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220709,
					"content": "没错，这句话讲述的内容，也和「盐之魔神」有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220710
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220710,
					"content": "这位善良仁慈的神，为了给饱受战乱之苦的人类，提供一个安全的去处，冒着危险走遍了璃月各地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220711
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220711,
					"content": "那个年代，诸神交战，战火纷飞，哪怕只是片刻的和平，都是一种奢侈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220712
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220712,
					"content": "而她最终寻到的——就是现在被我们称为「地中之盐」的这块土地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220713
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220713,
					"content": "可惜…这份安宁，最后还是被摩拉克斯打破了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220714
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110220714,
					"content": "别再说这些古时候的故事了，既然有了线索，赶快打开封印吧，快点快点！只要能打开封印，怎么都行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220715
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110220715,
					"content": "#{NICKNAME}，<color=#00E1FFFF>天衡在南，瑶光在东，绝云在西，轻策在北。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220716
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110220716,
					"content": "有了这些提示，你一定有眉目了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		}
	]
}