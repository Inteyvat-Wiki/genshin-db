			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"皮特",
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "太好了，你们也醒过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "皮特"
				},
				{
					"id": 130150102,
					"content": "大家都陆续醒来，城里也好消息不断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "皮特"
				},
				{
					"id": 130150103,
					"content": "看来事情已经顺利解决了对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "皮特"
				},
				{
					"id": 130150104,
					"content": "嗯，虽然费了一些周折。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150105,
					"content": "应该等会儿会有很多人聚过来，麻烦你组织一下现场的秩序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150106,
					"content": "#我和{M#他}{F#她}们去一趟教令院，马上就回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳西妲"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"希忒",
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "是草神大人，请问有什么事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150202,
					"content": "我想查询一下学籍资料，是否有一位刹诃伐罗学院的学者，现在处于昏迷不醒的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150203,
					"content": "好的，请稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150204,
					"content": "过了一段时间。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "久等了，草神大人，的确是有这样一位学者，名叫贝诺尼，因为违规操作虚空而陷入昏迷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150206,
					"content": "直到现在他还没有恢复意识，仍在接受「健康之家」的治疗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150207,
					"content": "欸？他不是叫莫塞伊思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150208,
					"content": "估计是不想被认出来吧，他不愿意被任何人打扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150209,
					"content": "这里面储存的知识，麻烦转交给风纪官，请他们导入到贝诺尼的大脑中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150210,
					"content": "好的，不过出于安全性考虑，我还需要了解一下理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150211,
					"content": "很简单，这里面是他的意识，之前被困在某个梦境里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150212,
					"content": "他在梦境中做了一些影响须弥治安的事，在他醒来之后，我会和大风纪官概述情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150213,
					"content": "明白了，我这就去做，感谢草神大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150214,
					"content": "嗯，没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150215,
					"content": "估计「品梦一刻」那边的人也聚集起来了，我们回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳西妲"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "我们就安静当听众就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150302,
					"content": "不知道她打算说什么呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150303,
					"content": "各位刚刚苏醒的人们，你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150304,
					"content": "打扰到你们的美梦，我非常抱歉，在梦境中的处理或许有些冰冷，我也表达我的歉意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150305,
					"content": "梦境拥有非常奇妙的力量，对心志坚定之人，它能鼓舞人心，为理想插上翅膀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150306,
					"content": "但它也有可能乘虚而入，混淆认知，颠倒是非——很不幸，你们被选作了猎物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150307,
					"content": "就像我之前所说，我还在不断学习，不敢说能感同身受那些离别之苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150308,
					"content": "但看看四周就知道，有过类似遭遇的人并不少见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150309,
					"content": "你们能相聚并站在这里，一同望向远方，你们应该为此自豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150310,
					"content": "生命的道路非常漫长，我们都很难看到终点。由此我们可能会产生很多问题——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150311,
					"content": "「我活着的意义是什么？我的目标是什么？我为什么要不断经历痛苦？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150312,
					"content": "诚然，停下脚步，放弃思考，重复熟悉的做法，这是最轻松的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150313,
					"content": "每当产生这样的念头的时候，就看看身边存在的人和事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150314,
					"content": "有人终日辛勤劳作，为的是一家人能在夜晚吃上热腾腾的饭菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150315,
					"content": "有人走遍大江南北，为的是创作出让整个提瓦特都能产生共鸣的艺术品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150316,
					"content": "有人探寻世界的秘密，为的是预防逐渐逼近而又不可名状的灾难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150317,
					"content": "——自我并非生命意义的全部，每一次行动都是对自我与世界的塑造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150318,
					"content": "亲朋好友会铭记你们的所作所为，陌生人也可能因为你们的行动而受惠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150319,
					"content": "为此，有许多人哪怕承受痛苦，也要开拓全新道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150320,
					"content": "而当你们走上同样的道路，那些终极问题的答案就会慢慢浮现，也变得不再重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150321,
					"content": "但如果你们觉得生命就是虚无，那它就会逐渐走向虚无。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150322,
					"content": "你们有选择生存方式的自由，但作为神，我需要先叫醒你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150323,
					"content": "还要不要以放弃现实为代价拥抱美梦，取决于你们自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳西妲"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "你好厉害，在梦境里，我都觉得有点说不过那个学者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150402,
					"content": "他利用人性弱点的方式确实很巧妙，或许他自己也早就深陷其中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150403,
					"content": "那个梦境有难以言喻的诱惑力，甜蜜得让人上瘾，而普通人很难有清晰的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150404,
					"content": "但只要能醒过来，什么时候都不算晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150405,
					"content": "你也长进了很多啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "欸？怎么突然这么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150407,
					"content": "你其实挺能共情的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "就是，虽然你说你不太懂人类的感情，但你的犹豫我们都看在眼里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150409,
					"content": "刚刚那段演讲，也是站在他们的立场上说的，这不是做得很好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150410,
					"content": "谢谢你们，这一路上我听到了很多悲伤的故事，内心不止一次受到触动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150411,
					"content": "受害者们的行为并不算错，他们想要的东西也不过分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150412,
					"content": "所以在他们试图对抗我们，保护梦境的时候，我可以理解他们的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150413,
					"content": "但我的理解与触动，和他们真实经历的痛苦相比，可能连百分之一都不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150414,
					"content": "这「百分之一」，我不敢认为它是所谓的共情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150415,
					"content": "你要求真高，当然是啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150416,
					"content": "做不到绝对的共情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "嘿嘿，好的，果然出来转转才会成长呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150419,
					"content": "感情和知识完全不同，我很难用清晰的言语描述它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150420,
					"content": "贝诺尼…或者「莫塞伊思」说我没有经历过生离死别，可我有种特别模糊的感觉，告诉我并不是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150421,
					"content": "我刚进入梦境，就感觉我被一股特别温暖的热流包裹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150422,
					"content": "温暖到感觉自己回到了生命的原初状态，再也不愿意醒来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150423,
					"content": "（难道说她也看到了什么？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "可是我睁开眼睛之后，那种感觉就消失了，一点痕迹都没留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150425,
					"content": "打比方的话，就像是一张白纸擦除了上面的笔迹，我看不见文字，但是能看到浅浅的凹痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150426,
					"content": "但经历了这场梦境之后，我想得很清楚了，无论那股暖流意味着什么，都不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150427,
					"content": "我能确定的是，我曾经被那股很温暖的力量支撑，才能一路走到今天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150428,
					"content": "要是过分在意温暖来自于哪里，那就本末倒置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150429,
					"content": "刚刚和人民讲了那么多理想的话，到头来自己却做不到，那是不是太丢人了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150430,
					"content": "（大慈树王已经用她的行动塑造了纳西妲。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "（哪怕世界遗忘了她，纳西妲的思想与意志也是她「存在过」的证明。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "（比起诉说真相，我更应该尊重她们的想法。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "怎么了？突然一脸沉重的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150434,
					"content": "看你好几次欲言又止了，是有什么话想告诉我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150435,
					"content": "我忘了要说什么了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "呵呵，这样啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150438,
					"content": "那么睡醒之后，不如伸个懒腰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150439,
					"content": "新的一天要开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳西妲"
				},
				{
					"id": 130150436,
					"content": "不重要吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "你大可自信一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
