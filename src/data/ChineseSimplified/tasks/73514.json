				"points": []
			},
			"dialogs": [
				{
					"id": 735140101,
					"content": "好险…居然连沙虫也来搅局了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735140102,
					"content": "唉！要是刚才没有拆除点火装置，我们就可以直接干掉它了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140103,
					"content": "现在放跑了它，少说也得再等上一天，才能让它重新放松警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140104,
					"content": "你不会想说，等到明天，我们还要为一点细枝末节而纠结，然后再放跑它一次吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140105,
					"content": "唔…可是，参数问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735140106,
					"content": "我都已经测过了，虽然充能速度比设计值是低了一点，但还不影响使用，也没有什么安全隐患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140107,
					"content": "施芮娅…我明白，你是希望把一切分析完毕才开始动手，可是你也知道，实际情况又不可能总是跟着计划走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140108,
					"content": "为求万无一失，反而错过了时机的话，就会就跟那次中期答辩一样悲惨延期…回头也只会闹出更多麻烦来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140109,
					"content": "唉…行吧。拿去吧，点火模块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735140110,
					"content": "——好欸！明天总算能让「对沙虫用杀虫炮」威风一把了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140111,
					"content": "我先把它们拉回阿如村再调试调试，「对沙虫用杀虫炮」的第一次正式登台…可得好好准备呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735140112,
					"content": "…可是环境参数，究竟为什么会出现偏差呢？说到底，沙虫又为什么会突然作乱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735140113,
					"content": "#果然不能放着这些问题不管…冒险家{M#先生}{F#小姐}，烦请您明天再来一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735140114,
					"content": "到时候我们应该会直接面对沙虫，希望能多少研究出一点端倪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮娅"
				}
			]
		}
	]
}