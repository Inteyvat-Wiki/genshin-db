				"points": []
			},
			"dialogs": [
				{
					"id": 741042802,
					"content": "还是你们…技高一筹。是我见过的所有素材里最好的！但也远非我能驾驭的…是我输了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042803
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741042803,
					"content": "这人真是莫名其妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042804,
					"content": "莫名其妙就对了，他之前就是因为做了一些…呃，做了一些「莫名其妙」的研究，才被枫丹科学院除名的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042805
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042805,
					"content": "那不是什么莫名其妙的研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042806
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741042806,
					"content": "是啊，当初你和伦理委员会的人也是这么说的，你看有人信你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042807
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042807,
					"content": "所以到底是什么研究？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741042808
					]
				},
				{
					"id": 741042808,
					"content": "咳，如果您希望获取这方面的信息，可以自行前往新枫丹科学院办理相关的合规手续。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042809
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042809,
					"content": "听起来就好麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042810,
					"content": "这事真难办啊，虽然他已经被除名了，可我调查的资材失窃案又和他有关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042811
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042811,
					"content": "哈，这次要把我送去梅洛彼得堡吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042812
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741042812,
					"content": "这不由我决定，而是由法律决定。很遗憾，这次可不会像上次那样只是简单的除名就能了事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042813
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042813,
