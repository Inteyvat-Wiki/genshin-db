			"trigger": {
				"objectNames": [
					"库特罗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741040401,
					"content": "两、两位是来应募研究助手的吗？抱、抱歉，我现在有些脱不开身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040402,
						741040403
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040402,
					"content": "看出来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040405
					]
				},
				{
					"id": 741040405,
					"content": "先别管这些了，你怎么被关在笼子里了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040406,
					"content": "和研究伙伴有些意见分歧…库特罗…他让我在这里冷静一下。对、对了，还没有自我介绍，两位就叫我…叫我奎瑟尔好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040407
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040407,
					"content": "呃，就是…就是奎瑟尔的发条工坊，那个奎瑟尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040408
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040408,
					"content": "#我是派蒙，{M#他}{F#她}是{NICKNAME}…说起来刚才的确听到吵架的声音，原来那个听起来很凶的家伙是你的研究伙伴啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040409,
						741040411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040409,
					"content": "要不换个伙伴吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040410
					]
				},
				{
					"id": 741040410,
					"content": "#就是！好的伙伴应该像我一样…{NICKNAME}能有我这样的伙伴，真是个走运的家伙呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040413,
					"content": "能、能不能麻烦两位，放我出来。如果能激活旁边的储能装置，应、应该就能把门打开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040414
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040414,
					"content": "拜、拜托了！之前来应募研究助手的人也因为受不了他的暴脾气，很快就离开了，这里现在只有我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040415
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040415,
					"content": "#唔，既然是这样，{NICKNAME}，我们就帮帮他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040411,
					"content": "那你继续冷静吧，不打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040412
					]
				},
				{
					"id": 741040412,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040403,
					"content": "只是随便进来看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040404
					]
				},
				{
					"id": 741040404,
					"content": "参、参观吗？当、当然也是很欢迎的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040405
					],
					"speakerTitle": "库特罗"
				}
			]
		},
		{
			"id": 7410405,
			"completionStepIds": [
				7410406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410406",
							"2"
						],
						"stepId": 7410406,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7410401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库特罗"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4944.755,
							367.04,
							4455.18
						],
						"pointId": 6729
					}
				]
			},
			"dialogs": [
				{
					"id": 741040501,
					"content": "门已经打开了，你不出来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040502,
					"content": "其、其实还有件难以启齿的事…如果我现在走出牢笼，恐、恐怕这里会爆炸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040503
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040503,
					"content": "爆炸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040504,
					"content": "是、是的…之前也说了，研究伙伴他是个…暴脾气，所以在牢笼下加装了特殊的触发装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040505
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040505,
					"content": "欸？！那现在该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040506,
						741040508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040506,
					"content": "用其他重物替代一下行吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040507
					]
				},
				{
					"id": 741040507,
					"content": "普、普通的重物恐怕不行…中间的原理很复杂，呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040510
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040510,
					"content": "#好心的{NICKNAME}{M#先生}{F#小姐}，如果能暂时代替我…在笼中稍候。我、我可以去解除这个特殊的触发装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040511
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040511,
					"content": "毕、毕竟是多年共同研究的伙伴，他的心里想些什么，我一清二楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040512,
						741040515
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040512,
					"content": "我的重量应该不够，要不派蒙也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040513
					]
				},
				{
					"id": 741040513,
					"content": "可、可是你看我都是浮在空中的，肯定根本没有重量！嗯，没有重量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040514,
					"content": "呃…这个触发装置非常特殊，并不单纯是通过重量判断的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040516
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040516,
					"content": "请相信我，只要替我一小会儿，我会很快解除触发装置回来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040517
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040517,
					"content": "…或许你知道枫丹科学院，或者听过雷蒙多先生和博絮埃先生的名字？我、我也曾经受到他们的指导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040518
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040518,
					"content": "这、这类技术问题，不难，不会花费很多时间的。只要一小会儿就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040519
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040519,
					"content": "唔…那好吧。不过你要快点哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040520,
					"content": "小心翼翼地和奎瑟尔交换了位置…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040521
					]
				},
				{
					"id": 741040521,
					"content": "欸？门怎么又关上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040522,
					"content": "呃，可、可能是出了什么故障。我、我去排查一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040523
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040523,
					"content": "不祥的预感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040524
					]
				},
				{
					"id": 741040524,
					"content": "别、别担心，我会尽快处理的。解除触发装置的终端不在这里，我暂时离开一下，稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040525
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040525,
					"content": "看来我们只好耐心等待了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040526,
					"content": "等待了一段时间…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040527
					]
				},
				{
					"id": 741040527,
					"content": "他怎么去这么久…该不会是出了什么意外吧？不过他之前说了，这里现在只有他和研究伙伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040528,
						741040530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040528,
					"content": "说不定他又被关进别的笼子里了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040529
					]
				},
				{
					"id": 741040529,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040532,
					"content": "我过去常想，「善良」真的能被称为美好的品质吗？徒有善良的人…善良对他的人生又有什么益处呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040533
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040533,
					"content": "…欸？是谁在说话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040534,
					"content": "这里根本没有什么会引发爆炸的触发装置，但牢笼的门的确被锁上了。两位，你们会怎么选？是继续等待，还是行动起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040535
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741040535,
					"content": "这人在说些什么呀！而且总觉得他的声音听起来…有点像奎瑟尔，又有点像之前跟他吵架的人，怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040536,
					"content": "先想办法让我出去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040537
					]
				},
				{
					"id": 741040537,
					"content": "对哦！可是…可是你被关在笼子里，该怎么打开被锁上的门呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040538,
					"content": "全靠你了，派蒙，救救我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040539
					]
				},
				{
					"id": 741040539,
					"content": "呜哇，怎么会这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040540,
					"content": "不过幸好我没有和你一起被关进笼子…唔，按照和刚才一样的方法应该可以把门打开吧？就让我试一试好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040530,
					"content": "我们应该是上当了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040531
					]
				},
				{
					"id": 741040531,
					"content": "你是说他骗了我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741040515,
					"content": "感觉有点可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040516
					]
				},
				{
					"id": 741040508,
					"content": "没辙了，我们去枫丹廷找人帮你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040509
					]
				},
				{
					"id": 741040509,
					"content": "倒、倒不用这么麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040510
					],
					"speakerTitle": "库特罗"
				}
			]
		},
