			},
			"dialogs": [
				{
					"id": 741042501,
					"content": "奎瑟尔！找到你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042502,
					"content": "那旁边的…肯定就是奎瑟尔说的坏蛋研究伙伴库特罗了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042503,
					"content": "…什么？我叫布里科勒，他才是库特罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042504
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042504,
					"content": "欸？他不是奎瑟尔吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042505,
					"content": "奎瑟尔…只是一个方便的角色。两位突破了重重考验，我想现在没有必要对两位隐瞒了，我叫库特罗，是这座工坊真正的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042506
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741042506,
					"content": "哈，两位真是…作为素材来说再好不过了，如果两位愿意协助我的研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042507
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741042507,
					"content": "什么研究，说来听听。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741042508
					]
				},
				{
					"id": 741042508,
					"content": "不会吧？！难道你真要协助这种可疑的家伙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042510,
					"content": "这里看起来一点也不像什么正规的工坊呀！而且你又是骗人又是让发条机关攻击我们…根本就是危险分子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042511,
					"content": "对！你们可千万别上当了！他…他是个穷凶极恶的歹徒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042512
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042512,
					"content": "我在调查时顺着线索找到了这里，没想到你在被除名之后仍在继续危险的研究，甚至还为此盗窃了枫丹科学院的资产…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042513
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042513,
					"content": "你已经犯罪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042514
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741042514,
					"content": "真多嘴啊，布里科勒，明明只是个不堪一用的庸才…等我评估完两位贵宾的真正价值之后再来料理你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042515
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741042515,
					"content": "两位贵宾…该不会是指我们吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741042516,
					"content": "当然。距离两位证明自己真正的价值，还差最后一场考验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042517
					],
					"speakerTitle": "库特罗"
				},
				{
					"id": 741042517,
					"content": "让我亲眼见识一下两位的本领吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库特罗"
				}
			]
		},
		{
			"id": 7410428,
