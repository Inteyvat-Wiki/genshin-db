				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}？！是你…是你吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270102,
					"content": "还有派蒙！真没想到在这里遇到你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270103,
					"content": "婕德！！真的是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270104,
					"content": "哈哈，你小点声啦！把我的鱼都吵走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270105,
					"content": "哔哔——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270106,
					"content": "欸…你们在钓鱼吗？可是怎么没有看到鱼竿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270107,
					"content": "哔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270108,
					"content": "#奔奔，不要乱说！好啦…{NICKNAME}，我们聊聊别的话题吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270109,
					"content": "你的鱼竿呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270111,
					"content": "它…自己坏掉了…嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270112,
					"content": "唉…我也没想到钓鱼和打猎一点也不一样…太难了，太难了！我是没耐心枯坐在这里半天等鱼…还不如自己下河抓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270113,
					"content": "结果鱼也没抓到，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270114,
					"content": "哼，当然抓到了，好大一条，比你还长…嗯，比你还长半个奔奔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270115,
					"content": "哔哔！哔哔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270116,
					"content": "我全都烤来吃掉了，没你的份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270117,
					"content": "哔哔…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270118,
					"content": "嗯，还有奔奔也吃了呢，只有你没份哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270119,
					"content": "我才不信咧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270120,
					"content": "哈哈哈哈！你不信是你的损失啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270125,
					"content": "你最近过得怎样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "嗯？挺好的，不必担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270127,
					"content": "反正也不是第一次孤身一人旅行啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270128,
					"content": "哔哔！哔哔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270129,
					"content": "哈哈哈，别急！我知道还有你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270130,
					"content": "自从塔尼特的事情之后，沙漠各部族都不再为我提供帐篷和食物…我没有部族的保护了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270131,
					"content": "后来嘛…虽说「三十人团」的鲁克沙大哥愿意接纳我，但是…城里让我很不自在，让我想起母亲…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270132,
					"content": "所以我告别了须弥城，想着…还是去另一个国家吧，看看此前没见过的景色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270133,
					"content": "于是，我登上商船，不知不觉就来到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270134,
					"content": "再然后嘛…哈哈，没什么好讲的啦！不管哪里都需要保镖嘛，尤其这种商队来来往往的大城市！所以我的日子过得还不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270135,
					"content": "嘿嘿，就这样吧…就这样过四海为家的日子也挺好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270136,
					"content": "我和奔奔，就像你和派蒙，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270137,
					"content": "哼，奔奔可不如我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270138,
					"content": "哔哔！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "奔奔"
				},
				{
					"id": 733270139,
					"content": "#哈哈哈，好啦好啦…{NICKNAME}，我就不多留你们啦。本来还想请你们一起大吃一顿的，但镖局的规定…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270140,
					"content": "咳咳！不说不开心的事情了！给你一千个拥抱，祝你接下来的旅途一路平安！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270141,
					"content": "#{M#别忘啦，我们的旅途，总有一天会再次相交呢！}{F#…先前在塔尼特那边，我和你说的话，你也不要忘记呀。等你什么时候累了，想要歇息了…我们也许会再次相遇。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270121,
					"content": "没想到会在这里遇到你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "嗯…我、我也没想到会在这里遇到你们，真的很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 733270123,
					"content": "嘿嘿，我们没打扰你钓…抓鱼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733270124,
					"content": "闭嘴啦，小派蒙！就你话多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "婕德"
				}
			]
		},
