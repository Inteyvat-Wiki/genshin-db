			"trigger": {
				"objectNames": [
					"安东尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "这药方，真会管用吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "旅行者！你来得正好，我正发愁呢，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110104,
					"content": "是这样，你还记得我妹妹安娜吧，她一直生着病，之前怎么治也没起色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110105,
					"content": "但是我听说璃月港里有一位神医，很擅长解决疑难杂症，就托人去求他开药方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110106,
					"content": "虽然药方里的材料都很奇怪…但也只有试一试了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110107,
					"content": "呃，我看看…你能帮我去找一份「被草史莱姆吞下去过的树莓」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110108,
					"content": "真的有这种东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "我也不知道啊！草史莱姆真的会吃树莓吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110110,
					"content": "就，就拜托你了！我知道一个地方有草史莱姆出没，也长着树莓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110111,
					"content": "拜托你去看看吧，希望能找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110112,
					"content": "庸医误事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "果然你也这么觉得吗？但是，我也是真的没办法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110114,
					"content": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110115,
					"content": "然后，做出来的药我会先吃下去试试。无论如何，不能让安娜的身体再坏下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110116,
					"content": "找不到的话，我就抓个草史莱姆给你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "咦…咦？你是要我亲手把树莓塞给草史莱姆吃吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110118,
					"content": "你就饶了我吧，我上次给安娜采药的时候，被一群草史莱姆一直追到了清泉镇里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110119,
					"content": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧，希望会有发现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110120,
					"content": "但是…如，如果实在不行，为了安娜…你，你就抓个草史莱姆回来吧！我能行！我一定能行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				}
			]
		},
