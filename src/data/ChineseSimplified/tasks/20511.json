				},
				{
					"id": 205110402,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "这就是吗？怎么看起来，没什么不一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110404,
					"content": "无论怎么看，这都是普通的树莓啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110405,
					"content": "算了，既然人家医生都这么开方子了，我就按照药方上面写的来做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110406,
					"content": "谢谢你，这些是给你的辛苦费。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 205110407,
					"content": "以后说不定还会麻烦你，你可千万别推辞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				}
