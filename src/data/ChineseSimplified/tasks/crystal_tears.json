			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3830401,
					"content": "成功啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830402,
					"content": "和原先的感觉完全不一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830403,
					"content": "风元素…满溢到了活泼的程度呢。这样的话应该没问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830404,
					"content": "#多亏了你呀，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830405,
					"content": "那么，我们该在哪里呼唤风魔龙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830406,
					"content": "在蒙德城内肯定不行，如果失败，就会造成难以弥补的损失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830407,
					"content": "就在这酒庄的话，显然也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830408,
					"content": "哦。酒庄没了倒也不是什么难以弥补的损失，但最好不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3830409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830410,
					"content": "海风或者高处的风，都可以让诗人的歌声传颂得更远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830411,
					"content": "如果空气干燥、沉闷又压抑，那不仅诗人，就连龙都会生气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830412,
					"content": "原来如此。海风或者高处的风，是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830413,
					"content": "所以，最适合弹奏的地方应该就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830414,
					"content": "悬崖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "从星落湖向东一段距离，在海滩的南方有一片山地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3830419,
					"content": "…啊！是在说你上次睡懒觉的那片海滩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830420,
					"content": "沿着山地延伸的方向攀登，可以抵达一个叫做<color=#00E1FFFF>摘星崖</color>的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3830421,
					"content": "歌手，你想要的海风与高处的风，在那里都能找到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3830422,
					"content": "嗯，我想想，摘星崖是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830423,
					"content": "…确实是很不错的位置呢，是个很衬我歌声的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830424,
					"content": "很好。那我们就做好准备，在摘星崖集合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830425,
					"content": "还请大家认真对待，不要迟到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830426,
					"content": "遵命，团长大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830427,
					"content": "啊…抱歉，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 3830415,
					"content": "海边？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "在天上一边滑翔一边弹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "那种事连安柏都做不到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "琴"
				}
			]
		}
	]
}