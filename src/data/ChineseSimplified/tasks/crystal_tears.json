			"dialogs": [
				{
					"id": 3830201,
					"content": "唔吼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830202,
					"content": "「特瓦林保护协会」！再次集结！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830203,
					"content": "那么，快把收集到的结晶拿出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830204,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830205,
					"content": "结晶的色泽似乎更加浑浊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830206,
					"content": "特瓦林…究竟在忍受怎样的折磨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830207,
					"content": "总之，先把这些结晶净化吧。异邦的旅行者，拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830208,
					"content": "若不是亲眼所见，还真是难以置信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830209,
					"content": "很有意思。就像滤酒一样，令人神清气爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3830210,
					"content": "有这么多泪滴就够了。那么接下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 38303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3830211,
					"content": "像上次一样，把它们滴在天空之琴上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830302
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3830302,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 38304,
			"completionStepIds": [
				38304
