			"dialogs": [
				{
					"id": 710960101,
					"content": "请问两位找到「老石」了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960102,
					"content": "在这里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐宁",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "又是三枚「老石」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960202,
					"content": "这两位「热心群众」上交的「老石」，我就好好收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960203,
					"content": "没想到这么快就找到了三枚，而且品相比我之前见过的都好上不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960204,
					"content": "唉…这让我想起以前我有的那枚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960205,
					"content": "你的那枚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710960206,
					"content": "你自己有还让我们找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "是「以前」我有的那枚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960209,
					"content": "我爸在盛露厅，那枚「老石」是一小块过他手的边角料，品相也不是很好，他就把那枚石头当玩具丢给了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960210,
					"content": "我那时天天和他吵架，游手好闲，还流连那个时候的岩上茶室，欠了一大笔钱，走投无路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960211,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710960212,
					"content": "有点差劲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "这个，谁都有年轻的时候嘛，反正就是我走投无路之时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960214,
					"content": "正好有认出「老石」的人愿意花钱买，一块石头罢了，卖就卖了，得了摩拉解了一时之忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960215,
					"content": "结果前几日我爸聊起这件事时，说，「沐宁啊，你以前玩的那块石头怎么不见了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960216,
					"content": "我只好说，「一块石头而已，还能留到现在？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960217,
					"content": "嘴上那么说，心里却想着，要是当初没卖那石头，他聊起的时候掏出来给他看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960218,
					"content": "…算了算了，想这些也没用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960219,
					"content": "现在改正了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710960220,
					"content": "你说的是…只不过以前欠的钱还是要慢慢偿还。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960221,
					"content": "不说了，如果还发现老石，记得带给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960222,
					"content": "还不够吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "三枚吧，再给我三枚应该够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960225,
					"content": "老石本来就是稀有矿材，辉山厅如果还要，层岩巨渊这边估计也找不到更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐宁"
				},
				{
					"id": 710960223,
					"content": "到底需要多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "来，把你自己的先缴了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}