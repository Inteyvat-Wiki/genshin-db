			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕胜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "这样应该就可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "我正在敬拜岩王爷呢。唔，看起来你不是本地人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000104,
					"content": "这里是倚岩殿，是给岩王爷上香的地方，璃月港的人会经常来上柱香，讨个吉利彩头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000105,
					"content": "但我住得很远，不能经常来上香，所以每次都要多待点时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000106,
					"content": "不过，我也看了许多和岩王爷相关的典籍，越是看，越是能了解岩王爷的了不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000107,
					"content": "比起岩王爷为璃月港做的事，我只是多走了些路来上香，倒也没什么所谓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000108,
					"content": "对了，你应该不太了解岩王爷吧，我倒是可以给你好好讲讲岩王爷的事迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000109,
					"content": "但是，光是说你肯定也印象不深。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000110,
					"content": "嗯…不如这样，你去<color=#00E1FFFF>璃月港附近</color>找点东西来吧，我搭配着实物，来给你讲一讲岩王爷的事迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000111,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "那么，请你快去快回吧，我就在这等着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000113,
					"content": "具体是什么东西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "只要是和<color=#00E1FFFF>璃月港</color>，或者你觉得和<color=#00E1FFFF>岩王爷有关</color>的东西就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000115,
					"content": "不过，我知道的故事有限…也不能什么都讲出点由头来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223000116,
					"content": "等你找到了之后，我们再具体看看，快点去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕胜"
				}
			]
		},
