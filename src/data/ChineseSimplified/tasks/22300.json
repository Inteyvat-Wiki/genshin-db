			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕胜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "哦，这是你去野外采的吗？一定花了不少功夫吧，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001102,
					"content": "嗯…你看到了吧，现在的璃月港规模很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001103,
					"content": "但是再大的城市，也是由微小的一砖一瓦建立起来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001104,
					"content": "在我们的祖先刚刚到达这片土地时，还没有什么「璃月港」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001105,
					"content": "是他们用汗水和勇气，一点点向外开垦，将这座庞大的城市兴建了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001106,
					"content": "你也知道，璃月港附近多是凹凸不平的山岩，十分难以开垦。但是这些植物，依然顽强地在这些山岩中生长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001107,
					"content": "而这些各有用处的植物，则为那些向外开拓的先人们提供了极大的助力，人们认为，这是岩王爷给予人们的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001108,
					"content": "先人们的奋斗事迹一直在璃月港内流传着。到现在，一部分从璃月港走出来的冒险家们，依然被这些事迹所感染。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001109,
					"content": "除了继承下先人们顽强的开拓精神外，他们还将岩王爷敬为「开拓之神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001110,
					"content": "如同岩石一般坚强不屈的冒险家，这就是他们对于自己的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕胜"
				}
			]
		},
		{
