		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕胜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "哈哈，是矿石啊，看来你还是很了解「岩」的意义嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001002,
					"content": "对于璃月港的先民们来说，除了冶炼用外，这些矿石在最开始，还有着更重要的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001003,
					"content": "在第一批先人们到达这里，开始垦荒的时候，他们用石头垒起了炉灶，又用石头互相碰撞，点起了火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001004,
					"content": "有了火，就能做饭了，有了热菜热饭，人们才有力气干活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001005,
					"content": "这些都是来源于「石头」，也就是岩王爷的恩赐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001006,
					"content": "于是，岩王爷在一部分典籍里，就有了「炉灶之神」的名号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001007,
					"content": "那些刚刚开张的饭店酒肆，都会给岩王爷上香，祈祷他们的炉灶不熄，生意兴隆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "慕胜"
				},
				{
					"id": 223001008,
					"content": "下次你去璃月港的饭店吃饭的时候，也不要忘记在心里对岩王爷默念几句啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕胜"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
