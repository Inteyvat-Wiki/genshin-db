			"dialogs": [
				{
					"id": 100030101,
					"content": "#向着星辰与深渊。你好，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 100030102,
					"content": "你好啊，凯瑟琳。奥兹、菲谢尔，你们也在，真巧啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030103,
					"content": "宇宙万物都会落入幽夜，追求光的人自会在黎明的境界上相聚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030104
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030104,
					"content": "#小姐的意思是，确实是巧遇，你们好。而我个人想说的也是：你们好，派蒙和{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030105
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030105,
					"content": "#{NICKNAME}，最近正好有一个八重堂点名希望你接受的委托。他们派了一个编辑过来接洽委托的详细情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 100030106,
					"content": "好像因为涉及商业隐秘，所以委托的很多细节无法全权交待给协会。只说是关于《神霄折戟录》作者的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 100030107,
					"content": "什么？那岂不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030108
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030108,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030109
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030109,
					"content": "这个作者这么重要吗？万一我们最近不在或者听了觉得任务很麻烦，编辑不就白来一趟了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030110,
					"content": "把它当作只需要带一句话的公费采风的话，我觉得大家可能争这个机会能争得头破血流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030111
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 100030111,
					"content": "如果你愿意接下这个委托的话，可以在猎鹿人找到那位编辑先生。稻妻人应该还挺显眼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030112
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 100030112,
					"content": "等…我是说，旅人哦，切勿焦急。命运把你推向世界的潮流，并非是为了让你孤身面对荒芜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030113
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030113,
					"content": "而是为了把你推向幽夜净土的轨迹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030114
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030114,
					"content": "小姐的意思是：请让她也一起帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030115
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030115,
					"content": "菲谢尔突然好积极！感觉有什么内情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030116,
					"content": "不也挺好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030117
					]
				},
				{
					"id": 100030117,
					"content": "那么就趁着大家都在，一起先去猎鹿人看看能不能找到那位编辑先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥兹"
				}
			]
		},
