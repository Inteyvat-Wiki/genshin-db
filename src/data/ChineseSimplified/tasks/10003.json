			"dialogs": [
				{
					"id": 100030501,
					"content": "看起来也是平平无奇的东西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030502,
					"content": "并非如此。本皇女已然看破尘埃之中的宇宙奥秘。它所展现的，正是涌向真实的智慧泉流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030503
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030503,
					"content": "小姐的意思是：她觉得这个是线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥兹"
				}
			]
		},
