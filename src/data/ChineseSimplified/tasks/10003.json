			"dialogs": [
				{
					"id": 100030401,
					"content": "常九爷似乎不在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030402,
					"content": "看来一下子是找不到人问话了。是要在这里等一等他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030403
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030403,
					"content": "好像只能这样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030404,
					"content": "不过，他不在的话，是不是说明…他确实有可能是被绑架到挪德卡莱的九老师呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030405
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030405,
					"content": "要不要搜查一下他的住处？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030406
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030406,
					"content": "总觉得私自搜别人的家有点不好。不过哦，万一常九爷真的是九老师的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
