			},
			"dialogs": [
				{
					"id": 100031201,
					"content": "怎么是你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031202
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031202,
					"content": "这个声音，是尼可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031203,
					"content": "我们还想问呢。为了找九老师，我们从璃月找到这里，结果最后遇到了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031204,
					"content": "和尼可以及仙灵说了八重堂的委托和之前的调查…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100031205
					]
				},
				{
					"id": 100031205,
					"content": "原来是这样。九老师，就是它啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031206,
					"content": "你们好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031207
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031207,
					"content": "这、这是何等异常之「黄昏」，亿万幽夜也未曾听说过这样的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031208
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100031208,
					"content": "就是那个嘛，我其实也挺想当小说家来着，但是能够直接沟通思想比说话都方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031209,
					"content": "所以写字对我来说就更麻烦了。这个你们可以理解的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031210
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031210,
					"content": "找人把想写的设定和情节畅快地说一通，就相当于自己写了。但是真这么做了我又觉得可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031211,
					"content": "所以我就找了一个仙灵故交，把我的设定和点子全给她说了。让她去找想成为小说家的人替我写书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031212
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031212,
					"content": "为了真实性九老师还编了很多很有真实感的人设呢。比如脱发什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031213
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031213,
					"content": "我就是那个受害者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031214
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031214,
					"content": "也不能这么说嘛。通过调动那些作家预备役的语言系统，你说话的知性不都锻炼到恢复了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031215
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031215,
					"content": "天使嘛，就是人脑子灵光乍现跑出来的灵感。也是重操旧业了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031216
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031216,
					"content": "这真的没问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031217,
					"content": "没关系。稿子都是趁着人睡着了被九老师上身写的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031218
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031218,
					"content": "只要是存在着创造世界的梦想，就会浮现的作家人格。自动式的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031219
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031219,
					"content": "「自动式的哦。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100031220
					]
				},
				{
					"id": 100031220,
					"content": "等等，那求救信和奥兹的奇妙感觉是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031221,
					"content": "我被尼可抓过来当挪德卡莱的监视员了。很危险好不好，我现在可没有天空的知识库和力量了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031222
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031222,
					"content": "至于那边那位的诞生之缘，你看，小说为了真实感，会加入很多半真半假的细节嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031223
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031223,
					"content": "确实，稻妻的轻小说就有过写真实咒语的先例…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031224,
					"content": "九老师故事的设定都是一些隐喻，里面创造生命的办法也不能说完全是假的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031225
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031225,
					"content": "但是没想到真的有小姑娘能够成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031226
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031226,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031227
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100031227,
					"content": "小姐已经完全呆住了。不过，容我僭越地理解一下：小姐通过小说里半真半假的方法，把我创造了出来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031228
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100031228,
					"content": "七成假三成真吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031229
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031229,
					"content": "九成假一成真。太危险了，所以我自己改了。我写的书你果然没看过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031230
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031230,
					"content": "奥兹好像不怎么惊讶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031231,
					"content": "怎么说呢？或许诞生之初就隐约察觉到了。能为小姐服务，我很荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031232
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100031232,
					"content": "总之挪德卡莱的事情结束，九老师就可以光荣回归了。你们就这么回去说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031233
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031233,
					"content": "我不要在这里当你眼睛！太危险啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031234
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031234,
					"content": "不过这么说来，要麻烦你和轻策庄那位大叔带个话。稿费版税我们九一开了，这么多年的都埋他院里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031235
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031235,
					"content": "你要钱做什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100031236,
					"content": "我要把它藏起来当财宝，然后指引人跟着我去取啊。我们天性就喜欢引导人，就喜欢这一口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031237
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031237,
					"content": "以后有机会欢迎来找我的宝藏，我把它埋在幽夜净土的尽头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031238
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031238,
					"content": "我一定会去的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031239
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100031239,
					"content": "小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031240
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100031240,
					"content": "那个，九老师，我很喜欢你的小说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031241
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100031241,
					"content": "小姐的意思是：纵使宇宙的漆黑无边无际，万事万物终将投下发着光的影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031242
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100031242,
					"content": "我很高兴哦。看来你已经找到我最大的宝藏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031243
					],
					"speakerTitle": "九老师"
				},
				{
					"id": 100031243,
					"content": "那么这件事就先这样吧。现在我要和九老师吵一架，来争夺第一作者究竟是谁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031244
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 100031244,
					"content": "不是常九爷吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100031245
					]
				},
				{
					"id": 100031245,
					"content": "绝对不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031246
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100031246,
					"content": "告别之后，一行人走上了归途。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}