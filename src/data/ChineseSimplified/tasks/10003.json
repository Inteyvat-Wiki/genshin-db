			"dialogs": [
				{
					"id": 100030301,
					"content": "九老师还有什么特征吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030302,
					"content": "根据读者来信问答和卷尾「作者的话」来看，他应该发际线后退、轻微啤酒肚、不喜欢吃甜的、心脏在右边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030303
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030303,
					"content": "左边还是右边？嗯，右边。然后他左手有五个手指，失眠很严重、每只眼睛各有一个瞳孔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030304
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030304,
					"content": "好没特色！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
