			"dialogs": [
				{
					"id": 100030801,
					"content": "这里居然真的有翻土的痕迹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030802,
					"content": "呜啊，常九爷该不会被热情的粉丝埋在下面了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030803,
					"content": "旅行者，要不我们还是喊千岩军过来检查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030804,
					"content": "诸位完全可以放心，最热情的粉丝就在眼前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030805
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030805,
					"content": "既然小姐不会去伤害任何人，其他没这么热情的粉丝应该也不会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030806
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030806,
					"content": "那动手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030807
					]
				},
				{
					"id": 100030807,
					"content": "挖开了松动的地面。\\n找到了一大袋摩拉和北国银行的支票…\\n\\n突然一声呵斥在背后响起，你下意识把东西塞进了兜里。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						100030808
					]
				},
				{
					"id": 100030808,
					"content": "你们在干什么！我要喊千岩军了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030809
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030809,
					"content": "哇！常九爷，你没死啊！也没被绑架！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030810,
					"content": "你能不能说几句好话。仔细一看，这不是上次跟着古华派小哥来这里的那谁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030811
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030811,
					"content": "嗨，看来是个误会。你们来我家翻土是干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030812
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030812,
					"content": "其实，我们想问你…该不会用过「九老师」这个笔名吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030813,
					"content": "就算吃蘑菇发幻觉了我也不可能是九老师啊。我要是九老师，我投稿这么多年小说大赛图什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030814
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030814,
					"content": "图个扮猪吃老虎吗？那我还真是自取其辱，投稿落选了这么多年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030815
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030815,
					"content": "我可经常被批评说「古典的少年英雄主角已经落后时代了。甚至开篇反转、扮猪吃虎都快过时了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030816
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030816,
					"content": "「…现在的读者喜欢九老师那种天马行空、标新立异的世界观和设定。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030817
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030817,
					"content": "也是哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030818,
					"content": "我要真是九老师本人，《古华派的大师兄》获奖那一年，我就该立刻宣布其实我是九老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030819
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030819,
					"content": "「什么？居然是九老师。是不是弄错了，老常就是个落魄户啊。」啧啧，这么来一出，一定畅快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030820
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030820,
					"content": "你家还收藏着《神霄折戟录》来着。回想一下当初你在行秋和我们面前夸这个作品的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030821,
					"content": "你要真是九老师，岂不也是一种「琴团长在夸自己欸」。这么想想确实不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030822,
					"content": "各位，虽然常先生并不是九老师。但是对我来说，他身上也有奇特的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030823
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030823,
					"content": "那是一种奇特的感应，和小姐以及原稿一样的「缘」。我觉得我似乎有能力追踪和九老师有关的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030824
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030824,
					"content": "既然这样就好办了！到了挪德卡莱，让奥兹领着我们寻找就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030825,
					"content": "说来，常九爷你刚才是去干什么了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030826,
					"content": "我稿纸用完了，去买稿纸了呗。我可是讲究人，当作事业的文学创作自然要用上档次的纸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030827
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030827,
					"content": "确实和那份原稿的纸一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030828
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030828,
					"content": "那我们没问题了！谢谢你啦，常九爷。事不宜迟，我们赶快出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030829,
					"content": "虽然我也不知道帮了什么忙，但是不客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030830
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 100030830,
					"content": "别了，他世界的造物者哟。虽然汝所安立之法则与叙事，自无法比拟幽夜净土下积淀的梦之尘泥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030831
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030831,
					"content": "小姐的意思是：您写得不如…算了，小姐的意思是：谢谢您，常九爷，再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥兹"
				}
			]
		},
