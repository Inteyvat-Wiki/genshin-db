				},
				{
					"id": 100030903,
					"content": "而且在这位仙灵身上也能感受到那种神秘的引力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030904
					],
					"speakerTitle": "奥兹"
				},
				{
