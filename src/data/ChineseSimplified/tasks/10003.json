				]
			},
			"dialogs": [
				{
					"id": 100030201,
					"content": "那个可以来蒙德公费旅游的幸运之人是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030202,
					"content": "行——不对，枕玉老师的负责编辑小野寺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030203,
					"content": "#{NICKNAME}，之前承蒙照顾了。希望这次你听完八重大人的委托之后还能再照顾我一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030204
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030204,
					"content": "旁边这位菲谢尔皇女打扮的是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030205
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030205,
					"content": "吾乃断罪之皇女菲谢尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030206
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030206,
					"content": "小姐的意思是：她是菲谢尔，很高兴认识你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030207
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030207,
					"content": "呃，她是菲谢尔小姐。是个来协助的朋友。她可是很可靠的冒险家哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030208,
					"content": "没错，她是菲谢尔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030209
					]
				},
				{
					"id": 100030209,
					"content": "原、原来是菲谢尔啊。就算如此，也不用说四次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030210
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030210,
					"content": "即已知晓吾之名讳，自然应该了解：称吾之名，即为赎罪。因故，称赞吾名，即是救祓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030211
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030211,
					"content": "小姐的意思是：她——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030212
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030212,
					"content": "原来是这样啊。记住名字确实是基本礼节。只要能解决问题，让我喊一万次也没问题。谢谢你来帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030213
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030213,
					"content": "居、居然比奥兹的翻译还要更早明白菲谢尔的意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030214,
					"content": "可不要小看编辑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030215
					]
				},
				{
					"id": 100030215,
					"content": "那么事不宜迟，让我来详细说说这次的委托吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030216
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030216,
					"content": "你们应该知道，《神霄折戟录》的作者九老师吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030217
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030217,
					"content": "菲谢尔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030218
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030218,
					"content": "小姐，您说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030219
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030219,
					"content": "九老师代表作明明是《菲谢尔皇女夜谭》！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030220
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030220,
					"content": "咳咳，小姐的意思是：倘若造物主的常态只有冷酷，那幽夜净土与皇女也应是足以让它垂泪的造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030221
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030221,
					"content": "那好的。《菲谢尔皇女夜谭》的作者九老师，最近从挪德卡莱发来一封求救信，看起来他状态很不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030222
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030222,
					"content": "那这不是一个很简单的事情吗？委托那边的协会或者佣兵找到他就好了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030223,
					"content": "所以最大的问题来了。我们其实也不知道九老师长什么样，年纪多大，是胖是瘦，是哪国人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030224
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030224,
					"content": "他从来只写信和八重堂联系，发信地址遍布全大陆。作者年会和线下活动也请不来真人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030225
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030225,
					"content": "这种委托怎么做啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030226,
					"content": "所以调查九老师究竟是谁是委托的一个重要部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030227
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030227,
					"content": "我们也自己努力调查过。结果发现，九老师自从《神霄》完结之后，字迹都开始不一样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030228
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030228,
					"content": "最早给九老师负责的编辑也已经辞职，想要自己写小说来着。他对于九老师也没有额外信息可以补充。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030229
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030229,
					"content": "凡存在过的事物都会被断罪皇女记住，在幽夜净土中永存。原初神圣言语自会涌流出一切因果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030230
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030230,
					"content": "小姐的意思是：最——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030231
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030231,
					"content": "没错，我们想到一块去了。所以我们找出来了最早的《神霄折戟录》原稿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030232
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030232,
					"content": "呜啊！这个行——枕玉老师看到会激动到晕过去的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030233,
					"content": "不对！比起这个，小野寺居然又先于奥兹理解了菲谢尔的话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030234,
					"content": "编辑，很神奇吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030235
					]
				},
				{
					"id": 100030235,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030236
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030236,
					"content": "奥兹华尔多·亨利·赫芙那梵茵斯哟，你发现了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030251
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030251,
					"content": "没有那个「亨利」，小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030237
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030237,
					"content": "确实能感觉到一丝若有若无的感应。和小姐您身上的…磁场、引力、因果丝线，这样的东西近似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030238
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030238,
					"content": "我们最后只确定了一件事。投稿的稿纸底纹和工艺来自璃月，大概就在轻策庄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030239
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030239,
					"content": "九老师难道是个璃月人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030240,
					"content": "不对，说到轻策庄写小说的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030241,
					"content": "常…九爷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030242
					]
				},
				{
					"id": 100030242,
					"content": "这不太可能吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030243,
					"content": "常九爷是吗？《古华派的大师兄》也是新人奖获奖作品，我听说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030244
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030244,
					"content": "无妨。「垂泪的圣徒」与「赎罪的圣徒」纵使所行之道义不同，力量却是同源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030245
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 100030245,
					"content": "小野寺先生，您请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030246
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 100030246,
					"content": "奥兹我知道你信任小野寺，但是考虑一下我们啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030247,
					"content": "说的也没错。既然同为作家，就算不是一人，说不定总会有些交流吧？把他当切入点或许不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030248
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 100030248,
					"content": "编辑，很强大吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100030249
					]
				},
				{
					"id": 100030249,
					"content": "呃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100030250,
					"content": "那就麻烦你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030251
					],
					"speakerTitle": "小野寺"
				}
			]
		},
