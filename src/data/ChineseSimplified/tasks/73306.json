			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "怎么没有看到奥米德和米尔萨德？难道说他们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "博尼法兹"
				},
				{
					"id": 730552702,
					"content": "他们没事，只是…都各自有了打算，不跟着我们做驮兽生意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "纳赫蒂加尔"
				},
				{
					"id": 730552703,
					"content": "啊？那怎么办，光凭我们俩，人手不够吧，还得再招人…可是又没几个人愿意到阿如村来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "博尼法兹"
				},
				{
					"id": 730552704,
					"content": "算了，这些事情以后再说，塞琉斯平安回来了就行。下次可不能让它再去这么危险的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "博尼法兹"
				},
				{
					"id": 730552705,
					"content": "你这是说的什么话？我们可是驮兽商人，不让驮兽出去干活，我们吃什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "纳赫蒂加尔"
				},
				{
					"id": 730552706,
					"content": "光喝风可填不饱肚子，再说了，这种地方你张嘴试试，保准一嘴沙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "纳赫蒂加尔"
				},
				{
					"id": 730552707,
					"content": "那也不能让塞琉斯去冒险啊，我看你身体也挺强健的，不如你来驮货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "博尼法兹"
				},
				{
					"id": 730552708,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
