			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "抱歉…还不能很好地控制自己的情绪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 730552602,
					"content": "不要道歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "对啊…婕德很难过，我们都知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730552604,
					"content": "谢谢你们…祝你们今后的旅途一切顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 730552605,
					"content": "唔…也希望婕德今后可以一切顺利…一定会的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
