			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "…是你们啊，还有什么话要说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552502,
					"content": "关于哲伯莱勒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "…我居然到最后还怀疑了他。我真是个混蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552504,
					"content": "现在我对他只有感谢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552505,
					"content": "之前我一直摇摆不定，无论是学术上还是生活上…但从今往后我不会再动摇了。我会走自己坚信的那条路，无论有多么艰难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552506,
					"content": "就算是为了告慰哲伯莱勒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552507,
					"content": "关于赤王。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "我开始怀疑自己之前读到的那些文献究竟有多少可信度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552509,
					"content": "那首「祷文」…有种说不上来的怪异的感觉，还有萨梅尔…说的那些话…有必要回去之后重新深入研究一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552510,
					"content": "当然，首要任务还是按原计划写完论文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552511,
					"content": "关于婕德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "唉…我也希望自己能为她做些什么，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552513,
					"content": "我什么都做不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "提尔扎德"
				},
				{
					"id": 730552514,
					"content": "她又什么都不肯说，但凡她能说出一个愿望，只要是我力所能及的，我都愿意为她办到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提尔扎德"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
