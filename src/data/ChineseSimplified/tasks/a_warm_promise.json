			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#哇，{NICKNAME}，你看你看！不知不觉，这本留影册已经被我们拍得满满当当的啦！每一张都好好看哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070102,
					"content": "是啊，时间过得真快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "嘿嘿，想不到这次能找到这么多漂亮的地方，还给这么多朋友拍了画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070105,
					"content": "你看这张，当时为了找到这个绝佳的拍摄角度，可是费了好大一番功夫呢。不过拍出来的效果真是太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070106,
					"content": "多亏了派蒙的找路天赋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "嘿嘿，那当然啦，我可是你最贴心称职的向导嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070109,
					"content": "能换来这么多开心的回忆，也算是物超所值啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}，你用这台留影机拍照，感觉怎么样？有没有觉得自己的摄影技术突飞猛进，快要赶上勒布朗大师啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070111,
					"content": "技术嘛…还有很长的路要走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "#嗯，说得没错，最重要的就是开心！而且呀，我觉得{NICKNAME}拍的画片，一点也不比那些摄影大师差哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070114,
					"content": "因为每一张里面，都有我们一起经历的故事，这对我来说，就是无可替代的作品哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070115,
					"content": "等我们以后…嗯，去别的地方冒险了，回想起来这些美好的时光，一定会特别有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070116,
					"content": "以后也一起拍下更多的画片吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "好！那我们就约定好了，下一本留影册，要比这本更精彩！去创造更多独一无二的回忆吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765070112,
					"content": "重要的是享受过程。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "也多亏了「应急储备金」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "每一张画片背后，都是一段回忆呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
}