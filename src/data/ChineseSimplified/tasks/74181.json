			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅洛·郎勃罗梭",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "梅洛夫人！你在这里干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810102,
					"content": "咦？是你们啊…我听说我那不成器的丈夫，在这里有个小窝，就想来看看他过得怎么样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810103,
					"content": "没想到，我找到了这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810104,
					"content": "他居然还把这张画片带在了身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810105,
					"content": "嘿嘿，罗谢大叔还是很在意夫人的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810106,
					"content": "之前我们怀疑夫人的时候，只有罗谢大叔非常坚定地说，夫人绝不会是犯人！虽然也不知道他那时候哪里来的底气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810107,
					"content": "可能是他全部的男子气吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "哦？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810109,
					"content": "真的真的！还有哦，之前他是不是说，因为赌钱输掉了夫人的吊坠？其实他在骗人哦！他只是不好意思说实话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810110,
					"content": "那个啊，其实那个我早就知道了，我从来没有相信过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810111,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810112,
					"content": "我的丈夫有很多缺点，有点胆小，有点懦弱，又有点别扭，但我知道他是踏实的人，也许会被人骗，但他绝不会是个赌徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810113,
					"content": "我没有当面戳破，只是想等着他主动跟我坦白呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810114,
					"content": "哇…真好…可惜他现在不知道去哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810115,
					"content": "（嘘…你们看那边，我有十成的把握，他就躲在那边的箱子里呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810116,
					"content": "（欸？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810117,
					"content": "（咳咳…跟以前一样，我们争吵的时候，他也会悄悄藏进衣柜，还以为我不知道呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810118,
					"content": "（需要帮忙叫他出来吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "（不用麻烦了，我今天一定要看看，他想藏到什么时候。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810120,
					"content": "对了，倒是另有件事，确实想麻烦两位，如果你们遇见曲线和托萝莎探员，请帮我转告他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810121,
					"content": "我收拾好了几间房间，随时欢迎他们过来小住。当然，郎勃罗梭家也欢迎你们两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "梅洛·郎勃罗梭"
				},
				{
					"id": 741810122,
					"content": "#{NICKNAME}，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810123,
					"content": "好的夫人，我们知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "嗯…好吧，那我们就不打扰夫人啦！希望罗谢大叔能早点出来面对自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810125,
					"content": "谢谢，也祝你们今后无论遇到什么问题，都能顺利找到答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅洛·郎勃罗梭"
				}
			]
		},
