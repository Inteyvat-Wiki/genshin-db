			"dialogs": [
				{
					"id": 206020501,
					"content": "你回来了，情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020502
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206020502,
					"content": "魔物似乎还在活跃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206020503
					]
				},
				{
					"id": 206020503,
					"content": "居然还有魔物在周围活跃吗？看来那场风暴的影响还远没有消散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020504
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206020504,
					"content": "哈哈哈，还有机会！还有机会让人们感受到冒险家协会的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020505
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206020505,
					"content": "西风骑士团依旧在专注于防守城内和蒙德城附近，看来野外的这些魔物，还是得我们冒险家协会出手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020506
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 206020506,
					"content": "我知道了，谢谢你帮忙调查，我会重新考虑发布的委托，这些东西请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塞琉斯"
				}
			]
		},
