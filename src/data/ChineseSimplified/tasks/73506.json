			"dialogs": [
				{
					"id": 735060401,
					"content": "我记得，刚才你们和加福尔师兄约定好了，要去无郁稠林和他接洽地脉调研工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060402
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060402,
					"content": "你们要是这就打算去找他可以先离开哦。至于我，应该还会在普斯帕咖啡馆里坐一会儿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				}
			]
		},
