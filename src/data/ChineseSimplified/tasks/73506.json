	"talks": [
		{
			"id": 7350601,
			"completionStepIds": [
				7350601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350601",
							"2"
						],
						"stepId": 7350601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芬迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060101,
					"content": "你好，欢迎来到聚砂厅，有兴趣接一些委托工作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060102
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060102,
					"content": "有没有那种毫不费力，站着就能拿摩拉拿到手软的工作？我们很有兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060103,
					"content": "这…这样的委托确实还没有，不过我这里有一些比较简单的居民请求，报酬分别在几万摩拉不等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060104
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060104,
					"content": "唔…几万摩拉吗？感觉有点不够花呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060105,
						735060106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060105,
					"content": "摩拉越多越好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				},
				{
					"id": 735060107,
					"content": "对啊。阿芬迪先生，有没有报酬更高些的委托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060108,
					"content": "啊这样吗？我想想…最近悉般多摩学院开设了一个地脉调研项目，正在有偿招募志愿者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060109
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060109,
					"content": "悉般多摩学院里有不少学者专攻地脉研究，对地脉数据的需求很大，时常需要进入秘境调查地脉异常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060110
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060110,
					"content": "这段时间里他们有些人手不足，找了不少本院学生帮忙还不够，不得不大量招募志愿者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060111
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060111,
					"content": "他们的报酬开得很高，相应的，对志愿者本身的素质要求也很严格。你们有兴趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060112
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060112,
					"content": "有什么要求？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060113
					]
				},
				{
					"id": 735060113,
					"content": "好，我来按招募流程确认下吧，首先：「你是否能够熟练使用一种以上的武器？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060114,
						735060115
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060114,
					"content": "我在单手剑领域颇有心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060116,
					"content": "很好，那么「你对元素的了解如何？是否能够使用元素力？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060117,
						735060118
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060117,
					"content": "我非常了解元素反应。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060119,
					"content": "#嗯，{NICKNAME}是吧，我这里登记上了。志愿者需要的物资和报酬我之后会协调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060120
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060120,
					"content": "不过具体的工作接洽还得找加福尔先生，但他今天有位重要访客需要接待，应该不在教令院内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060121
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060121,
					"content": "按照院内访客接待标准流程，他今天应该会带访客去普斯帕咖啡馆。等访客接待时间结束，你们可以去和他谈谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060122
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060122,
					"content": "真是的，跟我联络的时候还说是急着招募志愿者，怎么还中途去接待访客了，到底什么人这么重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 735060118,
					"content": "我使用元素力战斗的经验很丰富。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060115,
					"content": "其实我诸武精通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060106,
					"content": "想要亮晶晶的石头。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				}
			]
		},
		{
			"id": 7350602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350602",
							"2"
						],
						"stepId": 7350602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加福尔",
					"丽莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060201,
					"content": "这里的咖啡，你还熟悉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060202
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060202,
					"content": "当然，这是我以前最常喝的饮品，怎么会不熟悉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060203
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060203,
					"content": "加福尔师兄，嗯…现在应该是加福尔老师了吧，我们明明是老熟人，何必一个劲地兜圈子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060204
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060204,
					"content": "又是叙旧，又是咖啡的，你有什么想说的就直说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060205
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060205,
					"content": "那个人就是我们要找的加福尔吧，不过他好像正忙着和别人说话，要不我们先等一等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060206,
					"content": "其实也没有什么特别的事情，自从你离开教令院之后，我们当初的项目和计划就没了主心骨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060207
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060207,
					"content": "居勒什老师也很失望，他一直很看重你这个得意弟子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060208
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060208,
					"content": "丽莎，你离开教令院，实在是件非常可惜的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060209
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060209,
					"content": "以你的聪明才智，如果当初留在教令院的话，现在都能拿下诃般荼的位置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060210,
						735060211
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060210,
					"content": "（是丽莎！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				},
				{
					"id": 735060212,
					"content": "我没听错吧，那不是西风骑士团的图书管理员丽莎小姐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060213,
					"content": "我听说，丽莎好像曾经在须弥教令院学习过，不过那都是过去的事了，现在丽莎到这里是要做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060214,
					"content": "我猜得没错的话，你是想旧话重提，拉我回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060215
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060215,
					"content": "呵呵，我听说你现在是在蒙德的西风骑士团里担任图书管理员？要我说，真的是屈才了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060216
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060216,
					"content": "何必浪费自己的时间，去为保管图书这种小事劳心费神呢，你的时间明明是最宝贵的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060217
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060217,
					"content": "只要你肯回到学院来，立刻就能有大把项目供你主持，现在正是学院需要用人的时候，有些重要项目…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060218
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060218,
					"content": "哈…所以说来说去，还是想拉我回去咯，居勒什老师应该不知道你这么做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060219
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060219,
					"content": "实际上，恩师他早就有心叫你回来参与院内的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060220
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060220,
					"content": "…哦是吗？加福尔老师，欺骗他人可不是好做法哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060221
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060221,
					"content": "我为什么只在学院里待了两年就离开了，老师他是最清楚的，所以他绝对不会提出这种要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060222
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060222,
					"content": "放弃蒙德的生活，以素论派学者的身份重回教令院么…求取智慧所需要的代价我自己已经再也支付不起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060223
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060223,
					"content": "所以啊，就别再挖空心思拉我回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060224
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060224,
					"content": "呜哇，原来丽莎曾经是素论派的学者吗？从来都没听她本人提过啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060225,
						735060226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060225,
					"content": "小点声。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060227,
					"content": "而且保管图书可是很重要的工作，我从不觉得那是浪费时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060228
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060228,
					"content": "「智慧蕴藏在世界的每个角落，绝不可轻视点滴中的智慧」，这可是老师常挂在嘴边的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060229
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060229,
					"content": "优秀的学者是不会忽视细节的，加福尔师兄，果然还是叫你师兄更习惯，你刚才的说辞在细节上犯了错误。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060230
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060230,
					"content": "而且还有个细节你也没有注意到，此刻，有两个人正在偷听我们说话，已经半天了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060231
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060231,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060232
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060232,
					"content": "两位，找我们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060233
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060233,
					"content": "嘿嘿，你好丽莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060234,
					"content": "好久不见，丽莎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060235
					]
				},
				{
					"id": 735060235,
					"content": "我就说嘛，果然是你们两个呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060236
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060236,
					"content": "好久不见哟，小可爱，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060237
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060237,
					"content": "…两位有什么事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060238
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060238,
					"content": "啊那个，其实我们是来应征参与悉多…呃…悉般多摩学院的地脉调研项目的，刚在阿芬迪先生那里登记过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060239,
						735060240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060239,
					"content": "正巧遇到了丽莎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060241,
					"content": "地脉调研项目？难道小可爱你们进入了教令院？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060242
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060242,
					"content": "只是担任项目志愿者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060243
					]
				},
				{
					"id": 735060243,
					"content": "对，听联络员阿芬迪先生说，有个学术项目正在有偿招募志愿者，我们这才过来找加福尔先生了解情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060244,
					"content": "有偿招募志愿者？加福尔师兄，学院内部这么缺人吗？还是你们有什么非要外人来做不可的计划…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060245
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060245,
					"content": "没有没有，这只是出于常规地脉监测需求才有的项目，一切操作都符合安全标准。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060246
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060246,
					"content": "投入大量人力去收集地脉数据，我们也是不得已…要是你肯回来帮忙主持一些事务，就不用搞这么麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060247
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060247,
					"content": "我没记错的话，收集地脉数据是需要调查人员深入秘境的，危险性不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060248
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060248,
					"content": "#在离开蒙德之后，{NICKNAME}和我经历了不少战斗，探索秘境这种小事不算什么啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060249,
					"content": "这么久不见，你们好像又经历了不少有趣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060250
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060250,
					"content": "是呀，所以丽莎不用担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060251,
					"content": "既然两位是来应征参与项目的，那就请稍等一下，等到我和丽莎谈完事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060252
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060252,
					"content": "加福尔师兄，抱歉，我是不会答应你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060253
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060253,
					"content": "真的一点转圜余地都没有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060254
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060254,
					"content": "当初执意告别教令院，这个决定我至今没有后悔，将来的话…想必也不会后悔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060255
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060255,
					"content": "本来以为过了这么久再和你聊，会得到不一样的答复，唉，丽莎你还是跟以前一样固执。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060256
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060256,
					"content": "你都说到这份上了，再强行游说就是我自讨没趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060257
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060257,
					"content": "既然这样，我也有不少没处理完的事务，就不再打扰了，几天之后的学院聚会再见吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060258
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060258,
					"content": "嗯，放心吧师兄，学院聚会我会准时到场的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060259
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060259,
					"content": "至于两位志愿者，稍后你们有空的时候，请来无郁稠林找我，还有志愿者的工作需要你们协助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060260
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060260,
					"content": "对了还有最后一件事，丽莎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060261
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060261,
					"content": "怎么了，师兄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060262
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060262,
					"content": "祝你在蒙德顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060263
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060263,
					"content": "…我会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060264
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060264,
					"content": "好了，小可爱，派蒙，说客已经离开了，我们可以好好坐下来聊聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060265,
						735060266
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060265,
					"content": "说客？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060267,
					"content": "呵呵，教令院内部似乎发生了什么不得了的事，我的这位师兄啊，正在为他自己的前程奔走呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060268
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060268,
					"content": "对了，丽莎怎么会来到须弥呢？骑士团那里没关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060269
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060269,
					"content": "当然是因为琴给我放了一个带薪长假，既然是难得的假期，为什么不去旅行一番，放松心情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060270
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060270,
					"content": "不知道你们听说过没有，我曾经在须弥教令院的悉般多摩学院进修过两年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060271
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060271,
					"content": "不过毕业之后我没有留在教令院，而是直接回到了蒙德，成为了骑士团的图书管理员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060272
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060272,
					"content": "所以丽莎才会到须弥来吧，这样既可以四处游玩，又能看望以前的朋友和老师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060273,
					"content": "丽莎为什么会离开教令院呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060274
					]
				},
				{
					"id": 735060274,
					"content": "你们很好奇吗？嗯…告诉你们应该也没关系吧，毕竟那都是很久之前的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060275
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060275,
					"content": "非要说的话，只能归结为理念不合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060276
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060276,
					"content": "当初在教令院的时候，居勒什老师非常赏识我，邀我参与了许多教令院的核心项目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060277
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060277,
					"content": "不过后来，其中的大部分项目都失败了。说实话，为了获得超人的智慧，他们走得太远了，失败也是自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060278
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060278,
					"content": "我不想再参与这种疯狂的事情，就选择了离开。好了，现在你们都知道了，要记得为我保密哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060279
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060279,
					"content": "唔…听起来发生过不少事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060280
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060280,
					"content": "所以就算是居勒什老师亲自来游说，我也是不会再回教令院去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060281
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060281,
					"content": "比起没日没夜地做实验，还是早晨十点之后再工作，每天有固定下午茶的生活更适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060282
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060282,
					"content": "我就知道，其实丽莎是讨厌麻烦才选择做图书管理员的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060283
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735060283,
					"content": "是丽莎的风格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060284
					]
				},
				{
					"id": 735060284,
					"content": "工作那么麻烦的事，还是要悠哉一点才好，而且定期休假可是很重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060285
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060285,
					"content": "唉，可惜刚到须弥没多久，还没来得及到化城郭去看望那个孩子，就被加福尔师兄找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060286
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060286,
					"content": "说了这么半天，你们呢？小可爱和派蒙又是为什么来到须弥的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060287
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 735060287,
					"content": "和丽莎讲述了来到须弥后的见闻。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 735060266,
					"content": "是指加福尔吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060240,
					"content": "不想打扰你们说话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060226,
					"content": "嘘，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060211,
					"content": "（丽莎怎么会出现在这里？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				}
			]
		},
		{
			"id": 7350603,
			"completionStepIds": [
				7350603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
