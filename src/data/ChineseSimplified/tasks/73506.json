			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加福尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060301,
					"content": "你们来了啊，看样子是已经做好准备了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060302
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060302,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060303
					]
				},
				{
					"id": 735060303,
					"content": "很好，那么我先来说明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060304
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060304,
					"content": "我们悉般多摩学院长期与地脉打交道，需要时刻监测地脉涌流情况，这次的调研项目也是出于这个需求设立的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060305
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060305,
					"content": "由于须弥境内的秘境中时常出现地脉的异常涌流，所以我们不得不定期派人深入各处秘境记录地脉情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060306
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060306,
					"content": "因为秘境内部的情况往往比较危险，所以我们设立的原则是「只派遣具有战斗能力的人员」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060307
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060307,
					"content": "你们需要做的就是进入秘境深处，记录地脉的异常情况。注意，如果遇到危险情况，请优先保护好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060308
					],
					"speakerTitle": "加福尔"
				},
				{
					"id": 735060308,
					"content": "好，我的说明就是这些了。准备好的话，你们就可以进入秘境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加福尔"
				}
			]
		},
		{
			"id": 7350604,
