			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "感觉还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "总是不自觉飞太高。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#{NICKNAME}！找你好久了，上次给你的风之翼，用起来怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810104,
					"content": "看来你用风之翼玩得很开心的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810105,
					"content": "不过话说回来，你现在肯定还没有飞行执照吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810106,
					"content": "飞行执照？那是什么东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810107,
					"content": "从名字看也已经很明显了吧？只有拿到飞行执照，才能在蒙德城合法飞行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810108,
					"content": "#唔…{NICKNAME}都飞了这么久了，之前都没有听说这种东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810109,
					"content": "就是因为你们成天在城里飞来飞去，弄得大家都注意到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810110,
					"content": "欸嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810111,
					"content": "所以，你今天是特意来把飞行执照送来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810112,
					"content": "怎么可能！骑士是很有原则的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810113,
					"content": "飞行执照先要考试合格，然后再由骑士团统一签发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810114,
					"content": "#我今天是专门来做你的考官，监督{NICKNAME}进行飞行执照考试的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810115,
					"content": "毕竟是我把风之翼给你的嘛，要负起责任来——琴团长一定会这么说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810117,
					"content": "能不能稍微通融…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "我靠自己考就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "考试…听起来就很麻烦。但既然是安柏监考，那么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810118,
					"content": "别这么看着人家，绝·对·不·行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810120,
					"content": "#{NICKNAME}肯定能顺利通过啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810121,
					"content": "只是一点小小的测验，你击退风魔龙时的飞行能力全蒙德有目共睹，肯定没问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810122,
					"content": "不过，规章制度和飞行标准还是需要遵守的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810123,
					"content": "这本飞行指南给你，虽然不用背下来，但还是要熟悉一遍才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810124,
					"content": "比如不允许双人共用一架风之翼，不允许携带超规格重物起飞，不允许使用风史莱姆起飞什么什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810125,
					"content": "总之，你就好好读一下吧，丽莎姐姐教我魔法的时候，也是要我先看很多厚厚的书的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810126,
					"content": "看起来好厚…没办法了，总之先读读看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810127,
					"content": "嗯！读完以后就来风起地找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810401,
					"content": "西风骑士团的飞行指南，听起来就很难读…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810402,
					"content": "总之先读读看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "完全是一本寓言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "蒙德人学习飞行的方式真浪漫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "是个很好的故事呢…但是骑士团的飞行指南…是这种风格的么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810604,
					"content": "不管了，我们还是快去找安柏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}