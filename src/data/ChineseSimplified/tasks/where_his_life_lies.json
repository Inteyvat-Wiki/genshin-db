							3535.805,
							430.426,
							4553.841
						],
						"pointId": 5693
					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "…先生，也许我们应该先去佩特莉可镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180102,
					"content": "虽然泽维尔先生和菲利斯先生都不在，但梅康顿和巴比斯先生应该还在镇里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180103,
					"content": "也许他们能给您一些建议或启发，就算是最坏的情况下，您也有了两位可以倒苦水的对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180104,
					"content": "不，亲爱的路通，不…梅康顿和巴比斯的研究现在正如火如荼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180105,
					"content": "他们上次写信告诉我，佩特莉可镇里来了一位从枫丹科学院来的聪明人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180106,
					"content": "这位叫博絮埃的先生颇有学识和见解，帮他们解决了很多问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180107,
					"content": "而我…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180108,
					"content": "加尔恰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#{NICKNAME}，真是幸会。没想到能在枫丹遇见你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180111,
					"content": "虽然…您来的时机实在太凑巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180112,
					"content": "#没错，非常凑巧…但还是很高兴能遇见你，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180113,
					"content": "呜哇，他看上去好像很疲惫，黑眼圈也好重…整个人都无精打采的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180114,
					"content": "加尔恰怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "我们…呃，先生的研究遇见了一些，前所未有的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180116,
					"content": "但此事说来话长…我们现在正打算去欧庇克莱歌剧院为他们清算账目呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180117,
					"content": "在结束工作之后，我们可以找个安静的地方好好聊一聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180118,
					"content": "你们有其他工作了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "谈不上工作。只是到处被人雇去帮忙运算罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180120,
					"content": "最近欧庇克莱歌剧院里接待了不少剧团，急需进行一次整体的账目清算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180121,
					"content": "所以，为了筹集回佩特莉可镇的费用，我们…我，代加尔恰先生接下了这份委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180122,
					"content": "真是大材小用！那些运算简单至极，我就算不用推数机，一个下午也全都能算清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180123,
					"content": "所以这也正是我们筹集经费的好方法，咱们快点出发吧，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180124,
					"content": "#对了，{NICKNAME}，我能请您和我们同行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180125,
					"content": "有您这位名声不凡的朋友同行，我们也许就不用遭遇一些不必要的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180126,
					"content": "相应的报酬我们也会付给您的，请放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180127,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "这我可不好说…呵呵，总之，咱们快点出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180128,
					"content": "城里应该不会出什么事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "你回枫丹了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
			"completionStepIds": [
				7411802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7411802",
							"2"
						],
						"stepId": 7411802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路通",
					"加尔恰",
					"迦雅"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3490.198,
							461.138,
							3643.4
						],
						"pointId": 5696
					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "不得不说。这剧院的确气派，赚的钱也一定不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180202,
					"content": "剧院…唉，咱们还是快点去工作吧，等了结了这份工作，我们就回佩特莉可镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180203,
					"content": "然后，我就会在镇子里开一家面包房，从此不再搭理什么推数机了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180204,
					"content": "呃…先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180205,
					"content": "路通，你怎么了？你这副表情…难不成见鬼了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180206,
					"content": "真是…见鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180207,
					"content": "加尔恰…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180208,
					"content": "迦雅小姐？！她为什么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180209,
					"content": "这可真是太巧了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "先生，您刚才的发言可真是不太得体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180211,
					"content": "哦，闭嘴，路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180212,
					"content": "#加尔恰，真高兴能在这遇见你，还有{NICKNAME}。我猜，你是来帮歌剧院清算账目的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180213,
					"content": "难道他要清算的账目就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "那可不是。我们剧团可没有在这个歌剧院里演出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180215,
					"content": "只不过，以我对加尔恰的了解，他从来不是那种会在闲暇时间看歌剧的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180216,
					"content": "之所以会来歌剧院…也只可能是被人雇来工作，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180217,
					"content": "我发自内心地觉得，您更适合代替我待在先生身边，迦雅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180218,
					"content": "我们每个人都是无可取代的，亲爱的路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180219,
					"content": "我…呃…迦雅，很高兴见到你，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180220,
					"content": "…但你看起来可不太高兴，你的研究似乎不太顺利？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180221,
					"content": "这你也猜出来了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "唔，至少他不会因为看见我而感到不高兴，也不会因为你或者路通而感到不愉快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180223,
					"content": "在加尔恰的生活里，能让他这么不开心的，也只有那台「推数机」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180224,
					"content": "迦雅小姐为什么这么了解加尔恰呀？明明分开了那么久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180225,
					"content": "也许是她的直觉吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "您也许应该去咖啡馆，坐下来慢慢谈，这可不是三言两语就能说清的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180228,
					"content": "我还要…呃，不，我很高兴…但我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 741180229,
					"content": "放心吧，先生。那些运算简单至极，我一个人就能搞定所有工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180230,
					"content": "…您总不能把迦雅小姐晾在一边，直到我们的工作结束吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180231,
					"content": "你真贴心，路通。我们会带一杯咖啡回来给你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 741180232,
					"content": "谢谢您，小姐。祝您和先生喝得愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180233,
					"content": "加尔恰和迦雅一起离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "他们就这么去喝咖啡了…好像从头到尾都没我们什么事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180235,
					"content": "完全无关。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#不，{NICKNAME}。接下来才是正式的委托内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180238,
					"content": "要找什么食材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "您真幽默。但我绝没有任何浪费您时间的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180242,
					"content": "加尔恰先生和我，现在的确处于危险之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180243,
					"content": "欸…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180244,
					"content": "我们去旁边说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180239,
					"content": "要找什么零件？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "不然我去给他们留个影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "我在这里干什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "也许是加尔恰比较好懂吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
