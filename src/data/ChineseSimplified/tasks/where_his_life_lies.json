			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "…这里应该没问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180302,
					"content": "让我从头说起吧。自从您在须弥帮我们改造了推数机后，这台机器的性能产生了一个飞跃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180303,
					"content": "先生十分振奋，想要继续改进。但就像他说的，传统的机关传动结构有所局限…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180304,
					"content": "这台推数机的性能已经无法突破，所以，我们就想要回到枫丹，寻求其他的研究思路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180305,
					"content": "但是，当我们回到枫丹。有一个奇怪的人突然找到了加尔恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180306,
					"content": "这个人表示，自己可以为加尔恰先生提供研究的资金，甚至是帮他寻找其他合作者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180307,
					"content": "但与之相对的，加尔恰先生必须将推数机的所有设计思路和数据，都与他共享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180308,
					"content": "加尔恰一定不会接受。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "对啊！开口就想要人家的研究成果，这是在抢劫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180311,
					"content": "没错。所以加尔恰先生果断地拒绝了这个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180312,
					"content": "但在那之后，似乎有人一直在尾随着我和加尔恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180313,
					"content": "而且，也有人趁我们离开时进入了我们的房间，并且翻找过什么东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180314,
					"content": "虽然那个人将所有东西都复原了，但还是被加尔恰先生发现了痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180315,
					"content": "好、好可怕…人家不愿意把东西给他，他就直接过来抢吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741180316,
					"content": "事实上，在发现房间被翻过之后，我们就决定尽快筹钱离开这里，回到佩特莉可镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180317,
					"content": "等到了那里之后，我们会联系空想俱乐部的其他几位先生，一同解决这个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180318,
					"content": "而且佩特莉可镇算是…呵呵，算是加尔恰先生的大本营。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180319,
					"content": "对他来说，没有任何地方比佩特莉可镇更安全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180320,
					"content": "本来今天就是出发日，我们正准备出发去佩特莉可镇，所以才想请您为我们做护卫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180321,
					"content": "没想到，居然在这里遇见了迦雅小姐…为了安全起见，我只能让加尔恰先生带着迦雅小姐先回城里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180322,
					"content": "我能做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "看来，我们的出发日期必须要延迟了。现在请您快赶去加尔恰先生身边。就像我之前说的一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180325,
					"content": "有您这位名声不凡的朋友同行，我们也许就不用遭遇一些不必要的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180326,
					"content": "我会马上赶过去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "加尔恰先生会把事情全部告诉迦雅小姐的。至于后面的事…就让迦雅小姐自己决定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180331,
					"content": "总之，我们快点赶回城里去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 741180327,
					"content": "他们不会真遇见什么危险吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "不会的。加尔恰先生目前还在枫丹廷的城内，那里有不少警卫机关巡逻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180329,
					"content": "如果他们想要使用暴力手段，那么执律庭会代替我们解决大部分问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "路通"
				},
				{
					"id": 741180323,
					"content": "我能帮上什么忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "听起来这个人就不像好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
