					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "嗯，你们来了。不必点单，我都已经点好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10160102,
					"content": "这家「三碗不过港」，可不像蒙德的那些酒馆。在这里，酒肆主人是会拒绝果汁这种「不上道」的东西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10160103,
					"content": "所以这次，终于能被请一杯酒了？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "所以这次，我给你点了一碗酒酿圆子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10160105,
					"content": "哈。我也不是猜不到这种结局…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "…各位客官要是愿意听，我就继续讲讲凝光大人的「群玉阁」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 10160107,
					"content": "哇，这里还有说书人！氛围真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160108,
					"content": "所谓市井盛赞，除了酒好，当然环境也要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10160109,
					"content": "但这里所说的「环境」，与「提瓦特游览指南」里评判大酒楼的「环境」，就是两种意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10160110,
					"content": "列位都知道，在咱们这港口上边呀，有那云上仙府、烟霞行宫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 10160111,
					"content": "什么叫手眼通天？您瞧瞧，这就叫手眼通天，这就是凝光大人置办下的通天产业。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 10160112,
					"content": "在那天朗气清之时，您从那宫门外的甲板上往下一望——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 10160113,
					"content": "好厉害！那就是大半个璃月港的天地风光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 10160201,
					"content": "您且想想，这玩意虽是纸屑，但凝光大人用来决策的「思路」，那得多珍贵呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 10160202,
					"content": "您要能多抢一两张，这凝光大人指缝里漏出的好处，就能比同行多得一两分喽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 10160203,
					"content": "「天权」凝光…最近一直听到这个名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160204,
					"content": "璃月人在谈她，「愚人众」讨厌她，藏「仙祖法蜕」的好像也是她，「请仙典仪」上我们还见过她一面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160205,
					"content": "不知道她究竟是个怎样的人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160207,
					"content": "终于找到你了，「绝云间归来之人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160208,
					"content": "谁？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160209,
					"content": "派蒙，我们走…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "请等一下。我不是千岩军，也不是前来缉拿你们的捕快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160211,
					"content": "但我的确是「璃月七星」的使者——我是甘雨，月海亭的秘书，为见你们而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160212,
					"content": "使者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "确切地说，本职工作是对「七星」全体负责的秘书，而这次的临时身份，是凝光小姐的特别使者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160215,
					"content": "哇，说凝光，凝光…的使者到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160216,
					"content": "绝云间归来之人…恕我身处坊间，礼数不周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160217,
					"content": "但我带来的这封信，是凝光小姐以「天权」身份，正式拟定的邀请函。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160218,
					"content": "邀请您前往那座「天上的宫殿」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160219,
					"content": "你说…邀请函？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10160220,
					"content": "是的。凝光小姐是这样说的：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160221,
					"content": "#「请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}来。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160222,
					"content": "#「我要见{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160223,
					"content": "#「在群玉阁，我会陪{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}一根一根地…剪断繁杂的暗流之线。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160213,
					"content": "秘书？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
		{
			"id": 101603,
