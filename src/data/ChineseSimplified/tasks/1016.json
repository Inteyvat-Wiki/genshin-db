			},
			"dialogs": [
				{
					"id": 10160301,
					"content": "凝光…甘雨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10160302,
					"content": "暗流涌动的这些天里，她们所处的位置，究竟是在第几层呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "那个自称甘雨的使者，丢下这几句话，就消失了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161002,
					"content": "不过，我们居然收到了「璃月七星」的邀请函，真是不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}！跟有钱人见面，一定要注意礼仪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161004,
					"content": "我本来就很讲礼貌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "呵呵…有幸受邀前往「群玉阁」作客的人，确实很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10161007,
					"content": "你们去吧，不过别忘了「送仙典仪」的事。你们从群玉阁回来以后，我们下一步汇合的地点，是荻花洲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10161008,
					"content": "嗯，我们不会忘的。约好时间，荻花洲，不见不散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10161005,
					"content": "派蒙又在盘算什么主意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}