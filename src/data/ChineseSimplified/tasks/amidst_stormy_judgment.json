				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "奇怪，今天怎么这么安静，和平时完全不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080302,
					"content": "汪汪…汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080303,
					"content": "难道说，又是这种双簧演出吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080304,
					"content": "托马——托马——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080305,
					"content": "汪！汪！…汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080306,
					"content": "喂——不要再躲了，我已经看见你啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080307,
					"content": "嗯？完全没有人回应，托马跑到哪里去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080308,
					"content": "汪汪汪！汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080309,
					"content": "咦？平时一直那么老实的太郎丸，今天好像很急躁的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080310,
					"content": "两位，有看到托马吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080311,
					"content": "我们还以为他跟你在一起呢，发生什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080312,
					"content": "糟糕…我在来这里的路上，听说托马被天领奉行的人抓走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080313,
					"content": "我没办法判断消息是真是假，就立刻跑过来确认。如果托马没有按照约定出现在这里，意味着传闻大概率是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080314,
					"content": "雷电将军会在千手百眼神像前，举办第一百颗神之眼的「狩眼仪式」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080315,
					"content": "而那第一百颗神之眼的持有者…也就是即将被公开狩眼的对象，恐怕…就是托马。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080316,
					"content": "难道托马之前听说的，天领奉行正在筹备的「仪式」，刚好就是为他准备的「狩眼仪式」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080317,
					"content": "应该…是的，将军和天领奉行的人准备以第一百颗神之眼的「狩眼仪式」，来证明眼狩令的阶段性成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080318,
					"content": "…不行，我必须去救他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080319,
					"content": "汪汪！汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "太郎丸"
				},
				{
					"id": 20080320,
					"content": "冷静。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "但「白鹭公主」也代表了社奉行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "是呀，如果你亲自过去的话，不就代表社奉行要和雷电将军为敌了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080323,
					"content": "公然反抗雷电将军的话，社奉行那些普通人也会被牵连进来吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20080324,
					"content": "这也是没办法的事…时间已经不多了，仪式就要开始，我不能就这样放弃托马。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080325,
					"content": "他是我的朋友，明明不久之前，我们大家还一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080326,
					"content": "他也是我的朋友，我去救他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080328,
					"content": "你刚才说过吧？——时间不多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080330,
					"content": "…嗯，我会…等你们平安回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20080331,
					"content": "放心吧，绫华，事关朋友的性命，我们绝对不会失手的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
