		{
			"id": 200803,
			"completionStepIds": [
				200806
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200806",
							"2"
						],
						"stepId": 200806,
						"stateName": "QUEST_STATE_UNFINISHED"
