						"stepId": 7054806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽莎"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "这杯是「雪韵晨晖」，请慢用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "真不错，小可爱~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480203,
					"content": "酸度适中，甜而不腻，入口温润，回甘轻快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480204,
					"content": "不过，我感觉，喝完这杯特调后，好像更有精神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480205,
					"content": "说不定，你在冥冥之中破解了格兰菲狄的秘密，调出了比她更厉害的提神饮品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480206,
					"content": "还是调整一下饮品里的成分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "没事，不着急~你的眼神里充满好奇，好像还有许多想问我的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480209,
					"content": "我们聊聊天，你慢慢想想，很快就有灵感啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480210,
					"content": "今天丽莎追回了哪些书？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "让我有点烦恼，又有些哭笑不得的问题呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480212,
					"content": "一位刚刚出师，从枫丹来到歌德大饭店任职的厨师，借走了最贵重的那本《千年蒙德甜品全书》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480213,
					"content": "她居然想用制作甜品的思路，来改良各种肉菜，减轻油腻感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480214,
					"content": "纯甜口的肉类吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "是啊，从结果上看，她有些滥用焦糖酱，反而让本该香气扑鼻的肉片甜得发慌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480217,
					"content": "焦糖酱明明是个好孩子，加入各种饮品，都不可能让人反感的。有时，我也会在下午茶里加上一小勺呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480218,
					"content": "这么看来，改进料理，不是越有创意就越好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480219,
					"content": "丽莎好像还带来了一个笔记本？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "哦，这是今天另一项工作的见证者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480221,
					"content": "——再过不久，远征队的许多成员就要陆续返回蒙德了，他们长期在外活动，口味可能发生变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480222,
					"content": "为了进口一批新食材，满足这些骑士变化后的习惯，琴拜托我走访了十来户代表性的家庭，做了几项调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480223,
					"content": "好细致的计划…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "嗯，他们都为蒙德付出了劳苦、时间和血汗，值得大家用尊重和关照回报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480226,
					"content": "调查结果中，被提及次数最多的食材，就是纳塔的苦种，以及用这种奇特植物制作出来的可可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480227,
					"content": "许多骑士在信件中提到，他们习惯用可可让自己保持精力充沛。我也试过可可热饮，感觉，提神的效果不输咖啡呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480228,
					"content": "最近还去了什么别的地方嘛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "是说借机在外逛逛吗？被你猜到啦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480230,
					"content": "为了调查蒙德现有的冷门饮品，我去了一趟晨曦酒庄，和爱德琳女仆长聊了会儿天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480231,
					"content": "返程的路上，还遇到了一位巡逻的小骑士艾玛托，她遇见了不知怎么对付的魔物，慌慌张张向我求援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480232,
					"content": "我就陪她绕道奔狼领，好好教训了那几只暴躁的猎犬…难得这样活动筋骨，很畅快哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480233,
					"content": "丽莎最近喜欢什么植物呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "哦？小可爱的用词很谨慎嘛，加上了「最近」这个限定词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480235,
					"content": "是考虑到一段时间没见，我也会有变化…还是对以前的事记不太清了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480236,
					"content": "毕竟丽莎见多识广，博学多闻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "不错嘛，回答得滴水不漏~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480239,
					"content": "在学生时期，我可能会被书本上的新奇植物吸引，不断开拓见闻，跳出舒适圈。但现在，我已经习惯了安稳和规律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480240,
					"content": "借用一位璃月律法专家的比喻，我的生活快要接近「颐养天年」的状态啦，不再是个善变的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480241,
					"content": "所以，你肯定还记得——几年前一起冒险的时候，你就为我找来了一种清甜的炼金材料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480242,
					"content": "我的喜好一直没变过哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480243,
					"content": "好，我已经拿定主意了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "让我为你准备一款改良的特调吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "果然，小可爱的聪颖才智又进步了，只需要稍微提醒一下，就能抓住灵感~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480237,
					"content": "偶尔有些新兴趣，很合理吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480224,
					"content": "真是体贴的安排。",
