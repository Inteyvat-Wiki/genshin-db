					"nextDialogs": [
						705480304
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480304,
					"content": "单论外观，的确是我喜欢的类型，就让我尝尝它的风味吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
