							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "啊呀，看样子，赫塔回去忙了，格兰菲狄也不在…饮品小站完全由小可爱接管了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480102,
					"content": "没错，正是在下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "好呀~我可以放心点单啦，而不用担心…喝到后勤小队的神奇特调，整夜翻来覆去，完全没有睡意，只好熬夜工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480105,
					"content": "熬夜工作都是过去式了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "没错哦，现在的我只是一个清闲的图书管理员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480108,
					"content": "要是借阅逾期的人再少一点，不用我费心费力去上门追回，我就能早点来和小可爱闲聊，多试试你的杰作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480109,
					"content": "那，今天想喝点什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "我想想哦…我没有特别偏爱的配方，请给我一杯恢复元气，改善心情的特调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480112,
					"content": "能让我以松弛、闲适的状态入睡，就再好不过啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480113,
					"content": "（饮品小站已经有很多经典配方了，先从这些里边选一种吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "（丽莎想要恢复元气，「雪韵晨晖」似乎是个不错的选择…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "有什么特别的口味要求吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "丽莎现在应该不会这么忙了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "荣誉调饮师为您效劳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
			"completionStepIds": [
				7054806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
