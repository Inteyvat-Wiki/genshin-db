					"nextDialogs": [
						705480306
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480306,
					"content": "就像是…享用了贵重的甜品后，沿着果酒湖畔散步，吹着轻柔的湖风，松弛而悠闲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480307
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480307,
					"content": "真真切切驱离了疲惫感，又不至于太过亢奋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480308
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705480308,
					"content": "呵~困意已经上来了，作为睡前的饮品，效果实在太棒…",
