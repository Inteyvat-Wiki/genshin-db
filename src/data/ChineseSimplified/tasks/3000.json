	"talks": [
		{
			"id": 300001,
			"completionStepIds": [
				300001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300001",
							"2"
						],
						"stepId": 300001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海芭夏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000101,
					"content": "既然我们已经到了须弥，接下来的目标就是前往须弥城，想办法见到「小吉祥草王」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000102,
					"content": "#说起「小吉祥草王」，我们之前虽然打听到的消息不多，但她不太像是当年带走你{M#妹妹}{F#哥哥}的那位神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000103,
					"content": "不过，须弥也被称为「智慧的国度」，如果能见到这位智慧之神，应该能从她那里获得一些有价值的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000104,
					"content": "我也这么觉得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000105
					]
				},
				{
					"id": 30000105,
					"content": "不知道须弥城在什么方向，我们要不爬到七天神像所在的那块大岩石上看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000106,
					"content": "就算看不见须弥城，至少也能找找附近有没有村子什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000107,
					"content": "等等，你看，前面有行人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000108,
					"content": "太好啦，这下就省了我们到处找路的功夫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000109,
					"content": "你好——我们是外国来的旅行者，想向你问个路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000110,
					"content": "难道是没听见…喂——前面的行人，不好意思能向你问个路吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000112
					],
					"speakerTitle": "海芭夏"
				},
				{
					"id": 30000112,
					"content": "这到底是怎么回事啊？她明明听见我们在叫她，却对我们不理不睬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000113,
						30000114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000113,
					"content": "别生气，应该只是个例…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				},
				{
					"id": 30000115,
					"content": "哼！不过…虽说她不肯理睬我们，但只要我们远远跟着她的话，应该就能走到有人烟的地方吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000116,
					"content": "到时候，我们再向其他人问路好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000114,
					"content": "或许是有什么原因？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				}
			]
		},
		{
			"id": 300003,
			"completionStepIds": [
				300003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300003",
							"2"
						],
						"stepId": 300003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海芭夏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000301,
					"content": "咦，她走到那个小瀑布旁边不见了，我们也过去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000302,
					"content": "还以为这个山洞会是通往村子的入口什么的，看来是我猜错了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000303,
					"content": "你看，她在那边坐下了，该不会她就住在这儿吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000304,
					"content": "我们现在怎么办，要试着再向她问问路吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000305,
						30000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000305,
					"content": "努力和她沟通一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000306
					]
				},
				{
					"id": 30000306,
					"content": "嗯，好吧。好不容易才碰到一个行人，哪怕她不太欢迎我们，只要能说服她给我们指个方向就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000309,
					"content": "嗯…好清新的香味啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000310,
					"content": "是从那个香炉里传来的吧。虽说住在这么简陋的地方，但能沐浴在芬芳中冥想，似乎也是种不错的生活呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000311,
					"content": "——！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000312
					]
				},
				{
					"id": 30000312,
					"content": "你怎么了？突然脸色变得这么难看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000313,
						30000314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000313,
					"content": "这种香味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000315,
					"content": "什么，香味让你感觉不舒服吗？可为什么我什么感觉也没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000316,
					"content": "（我必须离开这里！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000317
					]
				},
				{
					"id": 30000317,
					"content": "（不好，我的意识…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000318
					]
				},
				{
					"id": 30000318,
					"content": "#{NICKNAME}，你怎么了？振作一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30000314,
					"content": "我感觉有点奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000307,
					"content": "还是不要打扰她了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000308
					]
				},
				{
					"id": 30000308,
					"content": "唔，她那种状态应该是叫做「冥想」吧。如果我们打断了她，可能就不是像刚才瞪我们一眼那么简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 300010,
			"completionStepIds": [
				300010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300010",
							"2"
						],
						"stepId": 300010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30001001,
					"content": "…真的不要紧吗？可都已经过了这么长时间了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001002,
					"content": "#你别着急…师父的知识很渊博的，既然说了{M#他}{F#她}没事，那就肯定不会有什么问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001003
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001003,
					"content": "啊，你醒了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001004
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001004,
					"content": "#{NICKNAME}，太好了，你总算醒过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001005,
					"content": "这里是什么地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001006
					]
				},
				{
					"id": 30001006,
					"content": "这里是…啊，对哦，之前你昏迷的时候我太紧张，都忘了问这里究竟是哪里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001007,
					"content": "这里叫「化城郭」，最早是须弥的学者们在雨林中搭建的临时休息处，现在这里主要由巡林员驻扎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001008
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001008,
					"content": "你好，那个…我叫柯莱，是个见习巡林员。今天我和师父在巡视时刚好发现你晕倒，于是就把你带到这里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001009
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001009,
					"content": "谢谢你的帮助。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001010
					]
				},
				{
					"id": 30001010,
					"content": "不不，不用谢我，我其实没做什么。对了，你现在感觉怎么样，有没有哪里不舒服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001011,
						30001012
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001011,
					"content": "身体没有不舒服。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				},
				{
					"id": 30001013,
					"content": "哈哈…那是师父调配的汤药，刚才他在你昏迷的时候给你灌了一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001014
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001014,
					"content": "啊对了，师父说等你醒来之后，还要再喝一次才行，我拿药给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001015
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001015,
					"content": "呜哇…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001016
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001016,
					"content": "柯莱，怎么了？是想拿药吗？都说过了，这些你别乱碰…等下我来处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001017
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001017,
					"content": "对不起师父…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001018
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001018,
					"content": "唉，「道成林食用蕈图谱」就在公告板上，如果法伯德再记不住，就只能换个地方——贴在他脑门上，让其他人去提醒他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001019
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001019,
					"content": "就是，他这个月都吃坏两次了，我去好好说说他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001020
					],
					"speakerTitle": "娜丝琳"
				},
				{
					"id": 30001020,
					"content": "但如果他就是喜欢眼前有彩色小人跳舞，刚才的话就算我没说。不过下次再给他抓药，就得找他要钱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001021
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001021,
					"content": "怎么样，你好些了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001022
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001022,
					"content": "这位就是我师父，巡林官提纳里先生，也是化城郭所有巡林员的上司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001023
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001023,
					"content": "你失去意识的原因我之前对派蒙解释过，既然你醒了，我就再向你说明一遍：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001024
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001024,
					"content": "须弥有些学派的学者需要在林中修行，他们会借助一种叫做「灵酚香」的植物熏香稳定心神，进入沉思状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001025
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001025,
					"content": "你们两个为了问路，靠近了学者海芭夏隐居的山洞，那时候洞里就正燃烧着这种熏香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001026
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001026,
					"content": "熏香对大多数人没有影响，但它的确会刺激极少数人的精神，你就是这种情况。我解释明白了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001027
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001027,
					"content": "解释得很清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001028
					]
				},
				{
					"id": 30001028,
					"content": "嗯，那就好。接下来回答个问题：在倒下之后你有没有什么其他的感觉？比如你还有自我意识吗，看到了什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001029
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001029,
					"content": "描述了在黑暗中见到的景象…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30001030
					]
				},
				{
					"id": 30001030,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001031
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001031,
					"content": "柯莱，你去通知一下其他人，让他们先不要把巡查日志拿到这里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001032
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001032,
					"content": "啊，什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001033
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001033,
					"content": "#因为这些天{M#他们}{F#她们}会暂时住在我的房间，我去阿米尔家挤一挤。照我说的做，快去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001034
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001034,
					"content": "啊、是，我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001035
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 30001035,
					"content": "等一下等一下，现在是什么情况？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001036
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001036,
					"content": "情况是这样的：原本我以为你醒后再喝一碗药就可以走了，但现在我觉得，你有必要待在化城郭疗养观察一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001037
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001037,
					"content": "「疗养观察」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001038
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001038,
					"content": "可我还要去须弥城…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001039
					]
				},
				{
					"id": 30001039,
					"content": "你先别急，你只要是个明辨是非的人，听我说完就能明白情况的严重性了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001040
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001040,
					"content": "从你刚才的描述看，熏香让你产生了非常强烈的「幻觉」，你的精神状况很不乐观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001041
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001041,
					"content": "如果你还是没办法相信的话，可以闻一闻这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001042
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001042,
					"content": "唔——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001043
					]
				},
				{
					"id": 30001043,
					"content": "哇，你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001044,
					"content": "是不是和你倒下那时的感觉很像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001045
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001045,
					"content": "虽说你目前神志清醒，可如果贸然让你离开，你很可能又会突然在什么地方失去知觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001046
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001046,
					"content": "雨林里有不少猛兽，也存在十分危险的区域，到时候可能就不会像这次一样好运了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001047
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001047,
					"content": "这些天你需要每天按时吃药，尽量不要独自行动，直到你闻到这种气味不再感到不适，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001048
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001048,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001049
					]
				},
				{
					"id": 30001049,
					"content": "你再休息一下吧，我去重新熬一碗药汤给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001050
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 30001050,
					"content": "唉，怎么会这样…我们才刚到须弥，你就碰上了这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001051
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001051,
					"content": "#{NICKNAME}，我知道你想早点见到小吉祥草王，不过你现在的情况确实有点严重，还是先恢复身体吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001052
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001052,
					"content": "喂，你到底有没有在听我说话？我很担心你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001053
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001053,
					"content": "我觉得有点奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001054
					]
				},
				{
					"id": 30001054,
					"content": "奇怪？你是说你的身体状况吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001055,
						30001056
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001055,
					"content": "身体的确不太对劲，不过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001057,
					"content": "你是说你看到的那些树根和红色的天空？可如果不是幻觉的话，那些究竟是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001058
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001058,
					"content": "我不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001059
					]
				},
				{
					"id": 30001059,
					"content": "（那个时候我有种感觉，我正站在很深的地底。那片红色的天空，难道是…「坎瑞亚」？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001060
					]
				},
				{
					"id": 30001060,
					"content": "唔…好吧。你的体质特殊，我相信你的判断。可你刚才为什么不把这件事告诉提纳里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001061
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001061,
					"content": "现在他误判了你的病情，你的情况不会越变越糟吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001062,
						30001063
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001062,
					"content": "我觉得他没有误判。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001064,
					"content": "欸，你的意思是…提纳里知道你看见的不是幻觉，却故意这么说来搪塞我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001065
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001065,
					"content": "对。所以我想弄清真相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001066
					]
				},
				{
					"id": 30001066,
					"content": "好吧，我明白你刚才保持沉默的原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001067
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001067,
					"content": "那这段时间我们就安心留在这里，一边恢复身体，一边想办法搞清你究竟看到了什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001068
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001068,
					"content": "不过，直接向提纳里打探看来不太行，你有什么想法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001069
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001069,
					"content": "和柯莱聊聊吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001070
					]
				},
				{
					"id": 30001070,
					"content": "有道理，柯莱对我们还是挺亲切的，明天我们也可以先向她打听一下草神和须弥的风土人情什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001071
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30001071,
					"content": "在房间里休息了一夜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30001063,
					"content": "只是没有说实话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001056,
					"content": "那些应该不是「幻觉」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001012,
					"content": "只有嘴里…好苦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				}
			]
		}
	]
}