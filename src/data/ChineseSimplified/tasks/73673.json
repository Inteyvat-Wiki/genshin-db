			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芬迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730101,
					"content": "你好，欢迎来到聚砂厅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730102
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730102,
					"content": "这里是「三十人团」彼此联络、协调事务的地方，看装束，你并不是他们的成员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730103
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730103,
					"content": "我明白了，你是听到招募消息，来应募的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730106,
						736730104
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730106,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730107
					]
				},
				{
					"id": 736730107,
					"content": "果然如此，很好。以防万一，我再次说明一下工作的情况与内容吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730108,
					"content": "我名叫阿芬迪，受教令院委派担任联络员一职，负责疏通协调教令院和「三十人团」之间的合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730109
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730109,
					"content": "你可能知道，「三十人团」受教令院雇佣，负有护卫整个须弥城的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730110
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730110,
					"content": "除此之外，他们还负责处理居民们在生活中遇到的部分困难，这样一来，整体的工作量就很大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730111
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730111,
					"content": "为了分担压力，我和掌旗官商量之后，决定招募一位协助人员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730112
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730112,
					"content": "当然，城内的关键防务工作并不需要你劳心，只要协助解决居民们的生活委托就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730113
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730113,
					"content": "至于生活委托的具体内容，大都比较细琐，为了理解方便我还是举几个例子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730104,
					"content": "应募？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730105
					]
				},
				{
					"id": 736730105,
					"content": "你还没细看招募内容就来了吗？算了，这也没关系，我来说明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "阿芬迪"
				}
			]
		},
		{
			"id": 7367302,
			"completionStepIds": [
				7367302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367302",
							"2"
						],
						"stepId": 7367302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芬迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730201,
					"content": "大体就是这样的委托工作，如果你有意愿也有空闲接手的话，那就太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730202
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730202,
					"content": "我和后勤官已经协商好，你接手后，每完成一项工作，都能获得充足的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730203
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730203,
					"content": "虽然这些委托里小事居多，但我希望你不要小看这份工作的尊严。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730204
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730204,
					"content": "能帮助大家解决生活中遇到的困难，所有人都会衷心感激你、尊重你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730205
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730205,
					"content": "只要坚持下去，你在居民中的声望想必也会提高，大家也会更愿意接纳你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730206
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730206,
					"content": "到那时，我也会把更复杂更重要的工作交给你处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730207
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730207,
					"content": "好了，这份工作的大致情况就是这样，希望你能好好考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730208
					],
					"speakerTitle": "阿芬迪"
				},
				{
					"id": 736730208,
					"content": "如果你决定接手的话，随时欢迎前来登记领取委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芬迪"
				}
			]
		}
	]
}