			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"坦吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "你好！陌生的朋友！你是路过这里的旅人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380102,
					"content": "抱歉半途拦下你…但…呃，这里发生过什么事…你能告诉我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380103,
					"content": "#我叫{NICKNAME}，幸会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "因论派陀裟多，坦吉。我是来…嗯，对，塔尼特部族…支援教育工作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380105,
					"content": "真是奇怪，按说就是这里才对…但为什么会变成这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380106,
					"content": "这个…说来话长…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "部落争斗或者内讧，嗯？有意思，沙漠里几百年没有发生过能毁灭一整个部落的冲突了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380110,
					"content": "而且…我也发现了不祥的痕迹…咳咳，我建议你还是不要去看比较好。呃…对肠胃不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380111,
					"content": "或许是他们中有的幸存者回来，归拢了大部分…遗留下来的东西。我不确定…太让人不安了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380112,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "唉…怎么会撞上这种事。感觉就像…见证了一次历史事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380114,
					"content": "啊，对了，顺便…呃，你要打牌吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380115,
					"content": "我从那些帐篷里找到了几幅牌组，稍加清理还是挺干净的。如果你有兴趣的话，我们或许可以…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380108,
					"content": "也许他们…已经迁徙离开了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "迁徙？不…你看，货物和帐篷都还在原处。柴灰和居所还有生活过的痕迹…哼，更像是一场突然的大灾难，中断了所有人的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "坦吉"
				}
			]
		},
