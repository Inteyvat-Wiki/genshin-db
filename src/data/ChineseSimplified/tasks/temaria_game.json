			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鲸井小弟",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "欸，太难了吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760203,
					"content": "刚刚只是状态不好而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760204,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你们要再试一次吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760205,
					"content": "#当然了！{NICKNAME}，我们要让鲸井小弟见识一下我们的厉害才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760206,
					"content": "再来一次！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "好耶！目标是在限制时间内，找到手鞠哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井小弟"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鲸井小弟",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}好厉害，一下就找到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760703,
					"content": "#哼哼，{NICKNAME}可是身经百战，去过很多国度的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760704,
					"content": "哇！难道，「蒙德」也去过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760705,
					"content": "当然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "好厉害！听那个大姐姐说，蒙德有很多很漂亮的地方，像是有好高好高的塔的「风龙遗迹」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760707,
					"content": "是风龙废墟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "嗯，不知道是那座塔比较高，还是将军大人的天守比较高呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760710,
					"content": "鲸井小弟，你为什么一个人在野外呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760711,
					"content": "因为姐姐钓鱼的时候，嫌我会把鱼吓跑，就让我自己出去玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760712,
					"content": "有一次，遇到了那个冒险家大姐姐。她看我无聊，就送了好多手鞠，让我「找贪心的旅行者一起玩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760713,
					"content": "贪心的旅行者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "才不是贪心！是担心！担心鲸井小弟一个人很无聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760715,
					"content": "#是呀，我也觉得{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}你们好好心，我很开心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760716,
					"content": "一个人呆在野外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "你一个小孩子呆在野外，不怕遇到危险吗？而且身上还带着好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760718,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}真好心。不过不用担心，那个冒险家大姐姐教我，只要特别操作一下，手鞠就可以变成炸弹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760719,
					"content": "好危险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760720,
					"content": "不危险哦！丘丘人呀，史莱姆呀，坏蛋呀，我都炸跑好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760721,
					"content": "危险的是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760722,
					"content": "#对了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}如果想要跟别的朋友玩手鞠的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760723,
					"content": "我留个手鞠放在这里！它的规则是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760724,
					"content": "藏手鞠的时候，要在一首手鞠歌的时间内藏好。找的人呢，也在一首歌的时间内找到。这样才公平嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760725,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "一想到我们玩的居然是炸弹，就觉得好害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760727,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}不用怕，她还跟我说过「只会炸坏人。大概」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760728,
					"content": "「大概」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760729,
					"content": "#那么，我去别的地方玩喽！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760708,
					"content": "是吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}