				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"鲸井小弟",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#嗨！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我这有好东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760102,
					"content": "谢谢，没有兴趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "好可怜，年纪这么小就被人逼着干可疑的行当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760104,
					"content": "#不是啦！我是想和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}玩手鞠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760105,
					"content": "「手鞠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760106,
					"content": "#简单来说，我会把手鞠藏在附近的某个地方。在一首手鞠歌的时间内，如果{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}能找到，那{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}就赢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760107,
					"content": "手鞠是这样玩的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "咦？是一个很厉害的大姐姐冒险家教我的。她还说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760109,
					"content": "「鲸井，好好记住。你一定要说，『如果你赢了，就可以得到好东西』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760110,
					"content": "#所以，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，如果你赢了，就可以得到好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760111,
					"content": "#是好东西！{NICKNAME}，我觉得陪小孩子玩是天经地义的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760112,
					"content": "可我还是觉得手鞠不是这么玩的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "可能是只有当地人才知道的玩法，不要在意这种细节嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760114,
					"content": "是鲸井小弟对吧？我们陪你玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721760116,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井小弟"
				},
				{
					"id": 721760115,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
