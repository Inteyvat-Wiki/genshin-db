			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "这次一定能成功…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020102,
					"content": "成功什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "你知道稻妻城里，经常会举办一个小说大赛吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020104,
					"content": "好像是叫…「这本小说真厉害！」，还是由稻妻城著名的「八重堂」主办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020105,
					"content": "为了这个比赛，我已经准备了很久，还看了许多稻妻人喜欢的小说做参考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020106,
					"content": "再加上我那一屋子通读已久的藏书…把璃月和稻妻的文化融合在一起，我写就的这本小说，一定能拔得头筹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020107,
					"content": "我已经和飞云商会约好了，他们帮我把我的小说送过去参赛，但是拿书的人一直没来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020108,
					"content": "你有空的话，能帮我把这份手稿送给<color=#00E1FFFF>飞云商会</color>吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "那就拜托你了，这次一定能行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020111,
					"content": "小说的题材是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "这不能透露，这可是我重要的参赛作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020113,
					"content": "只要这次能成功，那一切都能好起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				}
			]
		},
