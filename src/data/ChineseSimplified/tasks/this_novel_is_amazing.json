					"nextDialogs": [
						223020402
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020402,
					"content": "只要成功了，这本书就能卖遍全世界，她也一定能看见这本书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 223020403,
					"content": "你，你怎么还在这？快点把书送去<color=#00E1FFFF>飞云商会</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
