					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "嗯，嗯！就看一眼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020503,
					"content": "说起来，这个少年…不会就是常九爷自己吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020504,
					"content": "他的心态，还挺年轻的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020505,
					"content": "唔，我们还是快点把这本书送给<color=#00E1FFFF>飞云商会</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
