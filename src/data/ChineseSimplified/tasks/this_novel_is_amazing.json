			"dialogs": [
				{
					"id": 223020201,
					"content": "前面应该就是<color=#00E1FFFF>飞云商会</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020202,
					"content": "把书交给<color=#00E1FFFF>门口的那个人</color>，应该就可以了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020203,
					"content": "不过…还是好在意呀，这本小说到底写了什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 223020204,
					"content": "怎么样？要悄悄看一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
