			"dialogs": [
				{
					"id": 223020301,
					"content": "少爷到底去哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020302,
					"content": "关于常九爷的书…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "啊？他…他还在写吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020304,
					"content": "哦对，他上次说，又写了本小说去稻妻城参赛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020305,
					"content": "这次又是讲什么的？上次他写了本关于七星的书，一个劲要我们帮他出版。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020306,
					"content": "这书没出版，还差点把千岩军给招来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020307,
					"content": "不过，这次既然是去稻妻城参赛，想来也追不到我们头上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020308,
					"content": "你把书给我吧，我让商会里走船的人顺路带过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020309,
					"content": "不过，常九爷估计这次也没戏，我听人说，稻妻城那边正流行一本叫《沉秋拾剑录》的书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020310,
					"content": "也是咱璃月人写的，就是不知道具体是谁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 223020311,
					"content": "对了，辛苦你把书带过来，本来常九爷是要我们去拿的，还付了钱。既然你把书拿来了，这些就给你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				}
			]
		},
