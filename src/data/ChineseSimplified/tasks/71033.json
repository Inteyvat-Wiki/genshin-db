					"阿佐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "清昼叔叔回来啦！清昼叔叔，你已经写好新的灯谜了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710331002,
					"content": "这次我大概…肯定能猜对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331003,
					"content": "我这次要好好想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710331004,
					"content": "哈哈哈，我已经把这次的灯谜写好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331005,
					"content": "旅行者，请你帮我个忙吧，把这霄灯挂起来，挂高点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
		{
			"id": 7103311,
			"completionStepIds": [
				7103311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103311",
							"2"
						],
						"stepId": 7103311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "你总算是来了，你做好诗了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331102,
					"content": "我没有写出一首合适的诗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331103,
					"content": "你、你也…咳，你怎么没写出来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331104,
					"content": "璃月大地，万家霄灯，我想来想去，都没能用一首诗概括，你画好了画吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331105,
					"content": "我…我也没有…璃月那么大！怎么画得下，我要是想画下来，就得用天来做画纸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331106,
					"content": "如此说来，我们两个倒是都没有创作出能概括璃月港和海灯节的诗和画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331107,
					"content": "那么，就该算是「平局」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331108,
					"content": "嗯…好吧，那就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331109,
					"content": "清昼叔叔！清昼叔叔！你给我们出的灯谜，我们猜出来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331110,
					"content": "灯、灯谜？什么灯谜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331111,
					"content": "不须在意，是我陪着这群孩子们玩，给他们出的灯谜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331112,
					"content": "噢？是什么灯谜，能说给我听听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331113,
					"content": "「万千扁舟拂波去，烛映孤云峭岩间。身负流光浮沧海，终与龙宫彩鱼眠。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331114,
					"content": "这是你给这群孩子们写的灯谜？这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331115,
					"content": "清昼叔叔，这个叔叔又是谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331116,
					"content": "他就是那位画家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "你这诗人，要真不想与我比试，那和我约定个什么劲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331119,
					"content": "你误会了，我最开始确实抱着和你…一决胜负的心思，四处取材，殚精竭力…想要写出一首好诗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331120,
					"content": "但你应该也感到了吧，只凭只言片语，是无法概括璃月港和海灯节的。所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331121,
					"content": "所以，你就跑到这里来陪孩子们玩？给他们出灯谜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331122,
					"content": "正是这样，所以我来这里陪孩子们，给他们出灯谜，想再找到写那首诗的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331123,
					"content": "呵呵，但是灵感没找到，灯谜倒是出了不少，孩子们也很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331124,
					"content": "或许…这就是我在找的那首「诗」了。可惜，我没办法把它写下来，也无法和你分出胜负来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331125,
					"content": "你…你们璃月人，真是怪得很！那你我之间的比试，到底怎么算？谁输谁赢？我可不接受平局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331126,
					"content": "这个叔叔怎么这么啰嗦…肯定是清昼叔叔赢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331127,
					"content": "他可厉害了，出了好多好多灯谜，你肯定都猜不到谜底！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331128,
					"content": "你这诗人…嗯？等等，我有个主意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331129,
					"content": "那，这样！你我之间，重新比过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331130,
					"content": "哦？那你想要怎么重新比过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331131,
					"content": "你不是给这群孩子们出灯谜吗？我在取材的时候，也看到了许多霄灯的纹样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331132,
					"content": "我们俩，一个出灯谜，一个画霄灯，让这群孩子们做评委，看他们更喜欢谁，你看怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331133,
					"content": "好！正合我意，也合了这海灯节之意，如此再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331134,
					"content": "那就这样，等我收拾收拾画具，我们就在这里，重新比过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331135,
					"content": "你们俩可真来劲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "来，孩子们，把这个诗人写的灯谜给我看看，我给你们画个漂漂亮亮的霄灯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710331138,
					"content": "呵呵，只怕你画霄灯的速度，跟不上我出灯谜的速度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331136,
					"content": "你们俩继续加油…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "和清昼做比试的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
