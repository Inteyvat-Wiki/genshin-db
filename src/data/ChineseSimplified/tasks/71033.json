			"dialogs": [
				{
					"id": 710331201,
					"content": "嗯？你们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331202,
					"content": "关于清昼和梵米尔的比试…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "你说那两位啊，没事，没事，他们愿意陪孩子们玩就最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331204,
					"content": "这大过节的，还是要热热闹闹的才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331205,
					"content": "倒是你，孩子，一直为我们这轻策庄东奔西跑的，辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331206,
					"content": "没关系的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "你这孩子倒是热心…这些东西请你收下吧，谢谢你啦，你也要过个好节啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331209,
					"content": "希望之后的海灯节，这里也能这么热闹啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 710331207,
					"content": "您客气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
