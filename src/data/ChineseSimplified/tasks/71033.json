					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "孩子们，看这霄灯，这是打一这海灯节里的「事物」，你们猜一猜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331402,
					"content": "#我要和这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}去办件事，办完了再回来陪你们接着玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331403,
					"content": "咦，清昼叔叔，你要去办什么事呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710331404,
					"content": "我和一位画家定下了个…比试，要写一首最好的诗，和他画的画做比试，看看谁最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331405,
					"content": "哎呀，那肯定是清昼叔叔赢啦，那么多灯谜，哪一首都是很好很好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331406,
					"content": "是吗，谢谢你们的夸奖。你们先拿着这盏霄灯回轻策庄去慢慢猜吧，野外可不太安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331407,
					"content": "放心吧叔叔，这里我们可熟了，我们自己就能回去，你快去把那个画家打败吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331408,
					"content": "那…叔叔，你和那个画家比试完了之后，要快点过来呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710331409,
					"content": "那是当然，等事情结束了，我就去找你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331410,
					"content": "这确实是一首好诗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "这首诗是可以胜的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "呵呵，什么诗，这只是一首灯谜而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331413,
					"content": "好了，我们去找那个画家吧，他肯定等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
