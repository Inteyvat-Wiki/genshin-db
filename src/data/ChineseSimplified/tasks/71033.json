			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "哎呀，你好啊旅行者，多谢你，现在这轻策庄里总算有了些过节的氛围啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330402,
					"content": "咦？你身边的这位看着面生，这位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330403,
					"content": "这是位画家，来找清昼的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "来找清昼先生的？唔，那正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330405,
					"content": "望雅小姐前几天离开的时候，清昼先生说还要在这里待一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330406,
					"content": "他现在应该还在和孩子们玩猜灯谜呢，我想想，他带着孩子们去外面了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330407,
					"content": "要是想要找他的话，估计得去外面找找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330408,
					"content": "他还真的在玩灯谜…旅行者，那就麻烦你帮我跑一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330409,
					"content": "你去告诉那个诗人我过来了，我在这里再准备准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330410,
					"content": "无论如何，今天一定要和他分出个胜负…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "哈哈哈，你们也逐渐摸到窍门了，猜得越来越快了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330502,
					"content": "梵米尔来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "梵米尔…啊，那个画家，我算算日子，也确实该是履行约定的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330505,
					"content": "可惜了，我的诗最后还是没有写好，这群孩子们的灯谜也还没玩尽兴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330506,
					"content": "呵呵，也许真是我诗材有限吧…这样，你再陪我去找找灵感吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330507,
					"content": "嗯…也不能说是找灵感，再陪我去散散步吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330508,
					"content": "清昼叔叔！不猜灯谜了吗？？我还想猜猜看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710330509,
					"content": "我也想猜灯谜，清昼叔叔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710330510,
					"content": "唔，我也想再猜几个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710330511,
					"content": "#哈哈哈，莫急，等我和这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}去旁边转一圈，回来就有新灯谜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330512,
					"content": "你们先回轻策庄里去吧，到时候我再找你们，这样可好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330513,
					"content": "好哎！清昼叔叔真厉害，能想出这么多灯谜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710330514,
					"content": "清昼叔叔肯定读了好多好多书吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710330515,
					"content": "我要是以后也能像清昼叔叔这么厉害就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330516
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710330516,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330517
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330517,
					"content": "旅行者，我们快出发吧，快把那些琐事解决了，别让这群孩子们等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330503,
					"content": "你还记得和梵米尔的约定吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				}
			]
		},
