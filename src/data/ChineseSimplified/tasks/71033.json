				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "旅行者，旅行者，这里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330102,
					"content": "你是上次和清昼定了约定的画家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "就是我，我和那个诗人约定好，要各自创作一份艺术品概括海灯节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330104,
					"content": "你上次还帮我去拿了材料呢，你应该还记得吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330105,
					"content": "还记得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "我的画…咳，这个嘛…我其实已经画了很多了，场景、人物，甚至是动物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330108,
					"content": "我自信这些画都精确表达了应该表达的内容，但是…这些画里没有一幅能称得上可以概括海灯节的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330109,
					"content": "唉，我这几天吃不下睡不着，画材也都要用完了，还是没有画出那幅画。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330110,
					"content": "所以，我就想去找找那诗人，看看他的诗写得怎么样了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330111,
					"content": "旅行者，你知道那个诗人去哪了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330112,
					"content": "他去轻策庄了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "轻策庄？他去那干嘛…难道，是他找到取材点了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330114,
					"content": "快，旅行者，我们快去轻策庄找他去！要是那个地方合适，说不定我也能找到点灵感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330115,
					"content": "咳！总之，我们快出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330106,
					"content": "那你的画…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "这就是轻策庄了吧…那个诗人呢？跑去哪取材了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330302,
					"content": "上次他正在和孩子们玩猜灯谜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "猜、猜灯谜？这都什么…事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330304,
					"content": "他是不是因为找不到灵感，准备自己认输了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330305,
					"content": "算了，不管他是在干什么，这海灯节眼看着没剩几天了，可不能再拖下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "梵米尔"
				},
				{
					"id": 710330306,
					"content": "我们去找这里管事的问问吧，今天我非要和他分出个高下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米尔"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
