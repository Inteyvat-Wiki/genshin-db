	"talks": [
		{
			"id": 7380301,
			"completionStepIds": [
				7380301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380301",
							"2"
						],
						"stepId": 7380301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_HIDE",
			"trigger": {
				"objectNames": [
					"加尔恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030101,
					"content": "先生，恕我直言。您的这一份「乐谱」，我连哼唱它的方法都想象不出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030102,
					"content": "我真诚地建议，如果您真的想写出一篇足够…呃…正常的乐谱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030103,
					"content": "我们可以花一点钱，拜托剧院里某位演员帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030104,
					"content": "不！不不不，不行，绝对不行，那样就失去意义了，我再修改一下算式，等会回去再输出一份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030105
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030105,
					"content": "而且那么做的话…肯定要花更多的时间，我要再想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030106
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030106,
					"content": "你们在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030107
					]
				},
				{
					"id": 738030107,
					"content": "旅行者，您来得正好，我和加尔恰先生正试图把那台「推数机」训练成一位作曲家呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030108
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030108,
					"content": "这么说您可能不太明白。简单来说，加尔恰先生试图让「推数机」按照某种算式输出乐谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030109,
						738030110
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030109,
					"content": "「推数机」真的能做到吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				},
				{
					"id": 738030111,
					"content": "「推数机」本质上只是一台算数的机器，当然不可能直接输出乐谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030112,
					"content": "所以当「推数机」算出结果后，还需要加尔恰先生自己按照另外一种算式，将数字手动转写为乐谱上的那些符号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030113,
						738030114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030113,
					"content": "头，头开始痛了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030115,
					"content": "没错！路通，你概括得非常好，我差不多就是这个意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030116
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030116,
					"content": "解说就暂时到这里，旅行者！我需要你帮我个忙…拜托你，务必帮我这个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030117
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030117,
					"content": "摩拉和其他报酬都好说，我现在急需人手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030118,
						738030119
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030118,
					"content": "你是惹到什么人了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030120,
					"content": "都不是，比这些问题可严重多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030121
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030121,
					"content": "你还记得迦雅…呃，迦雅小姐吗？她今天就要随剧团离开须弥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030122
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030122,
					"content": "我答应过她，要送她一件临别礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030123
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030123,
					"content": "而这份纯粹由算式推算出来的「算式乐谱」，就是我想要送给迦雅的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030124
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030124,
					"content": "但是…但是这乐谱，连唱都没法唱…根本就没法作为礼物送出去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030125,
						738030126
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030125,
					"content": "不然，换一种礼物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030127,
					"content": "不行，要是礼物太普通了，迦雅小姐说不定就会…抱歉，我心有点乱，我要冷静一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030128
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030128,
					"content": "总，总之，我需要再改进一下「推数机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030129
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030129,
					"content": "旅行者，请你和我一起去找阿汉格尔先生吧，你一定能帮上我的忙，拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030126,
					"content": "不然，去买份礼物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030119,
					"content": "是枫丹那边有人要抓你回去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030114,
					"content": "我觉得我完全理解了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030110,
					"content": "「推数机」有这么厉害吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				}
			]
		},
		{
			"id": 7380302,
			"completionStepIds": [
				7380302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380302",
							"2"
						],
						"stepId": 7380302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿汉格尔",
					"加尔恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030201,
					"content": "你之前给我画的那几张零件设计图我看过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030202
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030202,
					"content": "这些零件倒是不难做，不过要达到你想要的精度，还要花点时间来打磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030203
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030203,
					"content": "大概需要多长时间？今天能拿到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030204
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030204,
					"content": "那当然不可能了！你当锻造零件是写字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030205
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030205,
					"content": "如果今天拿不到的话，那我肯定来不及改造「推数机」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030206
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030206,
					"content": "唉，你怎么急成这样，你的那台机器不是已经做好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030207
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030207,
					"content": "这件事就由我来说明吧。我们遇见了一些…呃…意料之外的麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030208
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030208,
					"content": "路通叙述了事情的经过…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030209
					]
				},
				{
					"id": 738030209,
					"content": "也就是说，你对这位迦雅小姐一见钟情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030210
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030210,
					"content": "什么？！不！我们是合作关系，生意伙伴！天哪！我简直…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030211
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030211,
					"content": "你对那位迦雅小姐表露过心意吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030212
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030212,
					"content": "心意？什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030213
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030213,
					"content": "你就没对她提起过你对她的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030214
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030214,
					"content": "我证明，加尔恰先生一定是提起过的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030215
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030215,
					"content": "什么？！你…路通！你是怎么知道的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030216
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030216,
					"content": "先生，你那次支开我的借口实在是太简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030217
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030217,
					"content": "而且那天在咖啡馆里，你和迦雅小姐聊了半天，连一句有关「推数机」的话都没说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030218
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030218,
					"content": "以我对您的了解，这可不会是一次寻常的聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030219
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030219,
					"content": "谢谢！路通，我恳求你，把你的好记性用在正确的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030220,
						738030221
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030220,
					"content": "迦雅小姐怎么说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030222
					]
				},
				{
					"id": 738030222,
					"content": "她…她说第二天的咖啡她来请…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030223
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030223,
					"content": "啊哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030224
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030224,
					"content": "喔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030225
					]
				},
				{
					"id": 738030225,
					"content": "咱们能不能别在这个问题上纠结了，现在的问题是零件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030226
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030226,
					"content": "咳…既然你已经付钱了。那我也会尽快帮你制作这批零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030227
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030227,
					"content": "但是说真的，如果你想送一份能讨那位迦雅小姐欢心的礼物，为什么不直接去问问专业人士呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030228
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030228,
					"content": "比如管剧场的谢赫祖拜尔，他很了解那些演出人员们的喜好，说不定会知道送迦雅什么礼物合适呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030229
					],
					"speakerTitle": "阿汉格尔"
				},
				{
					"id": 738030229,
					"content": "这个主意不错，加尔恰先生，请您在这里继续和阿汉格尔先生讨论零件的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030230
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030230,
					"content": "而我和这位旅行者，则去剧场那边问问谢赫祖拜尔先生关于礼物的意见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030231
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030231,
					"content": "就像您常和我说的，无论做什么事都要有一个后备方案，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030232
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030232,
					"content": "谢谢你，路通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030233
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 738030233,
					"content": "不客气，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030234
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030234,
					"content": "那咱们就出发吧，旅行者。希望我们能找到…合适的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 738030221,
					"content": "她的态度是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030222
					]
				}
			]
		},
		{
			"id": 7380303,
