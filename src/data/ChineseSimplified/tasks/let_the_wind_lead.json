	"talks": [
		{
			"id": 37302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37302",
							"2"
						],
						"stepId": 37302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "欸？你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730202,
					"content": "虽然我刚才还在想，你是不是会跟来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730203,
					"content": "我想知道更多风神的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "风神巴巴托斯？那家伙已经从蒙德消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730205,
					"content": "邻国璃月的岩神、稻妻的雷神都还在，但蒙德人已经很久没见过他们的神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730206,
					"content": "为什么要打听风神的事？是因为特瓦林吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730207,
					"content": "啊，这个嘛…是因为「神」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730208,
					"content": "嗯，有人告诉我龙的过往。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "哦？大家现在是怎么看待「风魔龙」的？我很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730210,
					"content": "不过，也不用那么急着说给我听——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730211,
					"content": "很久没回这里了，好像有些东西对我的到来很不满呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "呼…风向的变化，影响的不止是龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730402,
					"content": "对了，刚才你说，有人告诉你龙的过往？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730405,
					"content": "…是吗？那位叫做丽莎的蒙德学者，是这样看待这件事的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730406,
					"content": "没错，冲突到了这一步，当然是因为双方都已经开始动用武力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730407,
					"content": "但它最初的憎恨，绝对不是因为人们不再祭祀「四风守护」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730408,
					"content": "…那不是自然诞生的恨，而是腐蚀之后的产物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730409,
					"content": "腐……腐蚀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730410,
					"content": "是流入心脏的黑血折磨着它，令它多年的沉睡不得安宁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730412,
					"content": "深渊法师？没听过的名字…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "我好像在蒙德听过这个词…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "所以这一次醒来，它的精神才会被「深渊法师」的诅咒腐蚀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730413,
					"content": "非人之物组成的深渊教团，是与人类为敌的组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730415,
					"content": "没错，非人之物组成的深渊教团，是与人类为敌的组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730416,
					"content": "我不知道它们的来历，只知道它们对人类世界怀有极深的恶意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730417,
					"content": "荒野上的那些丘丘人，也会听从它们的指挥、成为它们的武器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730418,
					"content": "来这里前，我也和特瓦林一样，被诅咒腐蚀着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730419,
					"content": "不过现在我们所在的位置，正是「英雄的象征」、今日蒙德一切的源流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730420,
					"content": "树间的风很好，有我喜欢的气味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730421,
					"content": "与你一起待在树荫下，就能像刚才净化龙泪一样，驱除我身体里的毒素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730423,
					"content": "啊…感觉好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730424,
					"content": "所以，你当初又是怎么中毒的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730425,
					"content": "这个嘛，是因为我之前试图与特瓦林交流，但却被…嗯…打断了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730427,
					"content": "呃，那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "所以是我…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "结果不仅没能为特瓦林驱除诅咒，自己反而被「深渊」的毒性侵蚀啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730429,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730431,
					"content": "#所以作为赔罪——{NICKNAME}，就跟我一起去蒙德大教堂吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3730432,
					"content": "蒙德大教堂？要去那里做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730433,
					"content": "去取一把…叫做「天空」的竖琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		}
	]
}