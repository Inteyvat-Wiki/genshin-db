				"points": []
			},
			"dialogs": [
				{
					"id": 760090101,
					"content": "#谢谢你们，好心的{M#哥哥姐姐}{F#姐姐们}！要是附近能找到<color=#00E1FFFF>漂亮的石头</color>就好啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡夏"
				}
			]
		},
		{
