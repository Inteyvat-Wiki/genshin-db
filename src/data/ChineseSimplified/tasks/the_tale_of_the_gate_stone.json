				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡夏"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1758.865,
							223.864,
							10442.06
						],
						"pointId": 11130
					},
					{
						"sceneId": 3,
						"position": [
							1759.742,
							223.758,
							10440.77
						],
						"pointId": 12560
					},
					{
						"sceneId": 3,
						"position": [
							1760.837,
							223.823,
							10442.14
						],
						"pointId": 12561
					}
				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "嗯…好像也不是这一块…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090202,
					"content": "#啊，你们好呀，没见过的{M#大哥哥}{F#大姐姐}，还有…嗯，白白的精灵小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090203,
					"content": "#欢迎{M#哥哥姐姐}{F#姐姐们}来到霜月之坊！有什么需要帮助的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090204,
					"content": "#没有没有，只是看你一个人在这里，稍微有点好奇而已啦。顺带一提，我是派蒙，{M#他}{F#她}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090205,
					"content": "#嗯嗯，那就是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐！看样子，你们好像不是那夏镇那边的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090206,
					"content": "我们是冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "#是的，{NICKNAME}和我可是超厉害的冒险家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090211,
					"content": "真好呀。能和好朋友一起去各种各样的地方探险，见到不同的风景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090212,
					"content": "没错没错，我们已经去过好多好多地方啦。所以你刚才一个人在这边做什么呢？是在找什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090213,
					"content": "嗯，我在找漂亮的石头呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090214,
					"content": "啊，我明白了，是用来收藏的吧！不只是小孩子，有些大人也有这样的爱好呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090215,
					"content": "欸，不是喔？我是要用漂亮的石头收买小梅，让她拐走我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090216,
					"content": "哦哦，原来如此，是为了让她拐…等等，你在说什么东西？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090217,
					"content": "听起来有点离谱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "#欸？{NICKNAME}{M#哥哥}{F#姐姐}没听过大盗雷德·米勒与妖精公主的故事吗？小梅和我说，外面人人都听过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090221,
					"content": "「来吧，月色明瞳的小姐，就让我用这与你眼眸相称的宝钻收买下你的心，将你拐离这镀金的囚笼…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090222,
					"content": "虽然我也不太懂这个故事到底是什么意思，但只要送出别人喜欢的东西，就可以和对方一起去冒险了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090223,
					"content": "那句话应该不是这个意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "是、是呀，那句话的意思其实是…呃啊，总之不是给小孩子看的东西啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090227,
					"content": "说起来，你说的这个小梅是什么人啊？会给小孩子讲这种奇怪的东西，总觉得是什么居心不良的坏家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090228,
					"content": "小梅不是什么坏家伙啦，年龄也和我差不多来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090229,
					"content": "#和{M#哥哥姐姐}{F#姐姐们}一样，是从外面来的冒险家哦！她之前一个人在营地附近鬼鬼祟祟的，被我抓到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090230,
					"content": "不知道为什么，她好像觉得我们是什么可怕的怪人团伙，会把抓到的小孩子献祭给月神大人，一边假装冷静，一边劝我别杀她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090231,
					"content": "好、好奇怪的误解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090232,
					"content": "对吧？我也不知道小梅是从哪里听来了这种传言，好奇怪哦。不过因为看上去很有趣，所以我也没有反驳她就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090233,
					"content": "这种时候你倒是反驳一下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090234,
					"content": "总之呢，作为交换，小梅答应做我最好的朋友啦，还给我讲了好多好多外面的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090235,
					"content": "爸爸妈妈平时都不让我看外面的故事，说是只有无信者才会喜欢那样的糟粕…可是，小梅讲的故事就是很有趣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090236,
					"content": "比方说，爱上了精灵的渔夫呀，三度死去却又三度从冥府的女主人手中逃脱的大盗呀，渴望成为人类的换生灵呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090237,
					"content": "善良的人，没有那么善良的人，很坏很坏的坏人，无论富有还是贫穷，正义还是邪恶，最后大家都一样，在苦难中死掉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090238,
					"content": "我觉得你父母说得对，确实是糟粕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "是啊，这种故事确实不适合讲给小孩子听…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090243,
					"content": "可是，我已经不是小孩子了呀。小梅之前也说，外面的世界太乱，不适合像我这样的小孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090244,
					"content": "明明她连月神大人{RUBY#[S]月矩力}的祝福都没法用，年龄也和我差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090245,
					"content": "不过没关系，我可是超聪明的。小梅被我抓到之前，一直在念叨「石头」什么的，说明她的目的就是收集漂亮的石头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090246,
					"content": "只要找到<color=#00E1FFFF>漂亮的石头</color>，她就一定会被我收买，然后像雷德·米勒拐走妖精小姐那样，把我从这里带走了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090247,
					"content": "不要再用「收买」这种词啦！其实就是要找到漂亮的石头送给好朋友，没必要用这种奇怪的说法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090248,
					"content": "嗯…反正我们接下来应该也会在附近转转，要是看到了什么漂亮的碎片，就拿回来给你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090249,
					"content": "#哇，真的吗？那就谢谢你们啦，好心的{M#哥哥姐姐}{F#姐姐们}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090240,
					"content": "好想听，能不能细讲一下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "嗯？好哦。就比如说，雷德·米勒的同伴，发誓永远不会再踏入月光的「影鼬」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090242,
					"content": "喂，现在不是聊这种事情的时候吧！而且这种故事也不适合讲给小孩子听吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090225,
					"content": "没错，派蒙就是这样被我拐上了路…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "#喂，不要乱教小孩子啦！虽然我最喜欢的也确实是{NICKNAME}做的料理…但、但是不能叫拐走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090218,
					"content": "在挪德卡莱倒也正常…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "就算在挪德卡莱也不正常吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760090208,
					"content": "我其实是那夏镇幕后真正的操纵者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090209
					]
				},
				{
					"id": 760090209,
					"content": "#哇啊，听起来好帅气！那我也可以成为{NICKNAME}{M#哥哥}{F#姐姐}的随从吗？就像故事里一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090210
					],
					"speakerTitle": "卡夏"
				},
				{
					"id": 760090210,
					"content": "你在胡说什么啦，我们只是经过这里的冒险家吧！才没有什么在幕后操纵那夏镇各方势力的打算…应该没有吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "派蒙"
				}
			]
		},
