			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯坦利"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "斯坦利…告诉我，我该怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130302,
					"content": "咦？他怎么在喊自己的名字啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130303,
					"content": "莫非有什么隐情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "该不会，还有其他叫斯坦利的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130307,
					"content": "呜呜！呜呃…斯坦利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130308,
					"content": "当年在烬寂海死的…为什么不是我啊！为什么我冒用你的名字，你的灵魂都不来阻止我？斯坦利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130309,
					"content": "要不是为了保护我这个新人，你也不会死在那个无风的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130310,
					"content": "你已经有了大冒险家的名号，可，可就为了我这种废物，你再也不能变成传奇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130311,
					"content": "这…究竟是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130312,
					"content": "…我想，当年他确实找到了烬寂海。在那里遇到的危机，也是真的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130313,
					"content": "只不过，那个和他一起探险的同伴，才是真正的「大冒险家斯坦利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130314,
					"content": "真正的斯坦利，是为了救我们认识的这个「斯坦利」而死的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130315,
					"content": "啊…那这个「斯坦利」之所以叫斯坦利，是因为他「偷」了别人的名字咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130316,
					"content": "恐怕就是这么回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130317,
					"content": "斯坦利…我害怕了这么多年，我怕蒙德城里的人把你忘得一干二净，所以到处说你的冒险故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130318,
					"content": "我要让蒙德人都记住，斯坦利抵达过烬寂海的中心…他是最伟大的冒险家，他还活着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130319,
					"content": "斯坦利不会死，因为我就是！…因为我就是…斯坦利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130320,
					"content": "对不起，斯坦利…连我也老了，我也老了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130321,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130322,
					"content": "你们几个，还想偷听到什么时候？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130323,
					"content": "糟了！他发现了…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130305,
					"content": "还有别人叫斯坦利吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "不会吧，连我都没听说过第二个斯坦利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯坦利"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "走吧，什么都别问，让我一个人安静一会儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130402,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130403,
					"content": "走！别让我说第二次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130404,
					"content": "荣誉骑士、温迪，还有派蒙！太好了，你们都在这儿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101130405,
					"content": "我到处找你们！我是来道谢的，多亏你帮我找的剑和盾，我父母同意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101130406,
					"content": "哦？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130407,
					"content": "真的！他们还说要出钱找人把「辉煌勇气之剑」和「光耀意志之盾」修好，让我带着上路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101130408,
					"content": "那真好。杰克，你要离开蒙德、启程巡游提瓦特大陆了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130409,
					"content": "不，暂时还不走。以我现在的能力，恐怕走不了太远的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101130410,
					"content": "而且，我还想再听听斯坦利先生的故事。嘿嘿…毕竟，他是我梦想的起点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101130411,
					"content": "斯坦利先…啊，他又喝醉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101130412,
					"content": "明天见，先生。等你酒醒了，再给我讲点故事好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 101130413,
					"content": "我认为斯坦利挺喜欢这孩子，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130414,
					"content": "杰克？杰克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130415,
					"content": "杰克已经回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130416,
					"content": "是吗…那，谢谢你们没把我的秘密说出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130417,
					"content": "欸？突然直视现实了吗？这可不像之前的你哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130418,
					"content": "我…刚才我都不敢看他一眼。他对冒险的真心不带一点杂质…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130419,
					"content": "我是个疲惫没用的骗子，但那孩子还是个闪闪发亮的新人，可不能毁灭了他的梦想啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130420,
					"content": "也不能说是骗子吧？因为，「斯坦利」的冒险故事和经历，都是真的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130421,
					"content": "故事…经历…呵，算了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130422,
					"content": "其实，事到如今，我对冒险、对斯坦利的记忆…都已经模糊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130423,
					"content": "这才是我最大的秘密、最大的恐惧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130424,
					"content": "这些年，我为他的故事而活。但他的性格、他的生活，我都已经记不清了。哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130426,
					"content": "他的人生被负罪感淹没了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "已经只剩下「幻想朋友」了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "我唯一不能忘记的，是他死在了无风的烬寂海，风带不走他的灵魂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130428,
					"content": "嗯，没错…真正的斯坦利，在他的记忆里，甚至已经不再是那个鲜活的友人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130429,
					"content": "而是永远定格在伤痕累累的战士模样，束缚着他所有的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130430,
					"content": "我老了…再怎么不愿放下，也留不住多少东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130431,
					"content": "我真没用！没用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130432,
					"content": "但冒险家不能以那种方式死去…不能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130433,
					"content": "真…真是不可思议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130434,
					"content": "谢谢你们…谢谢你，巴巴托斯大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130435,
					"content": "对不起，我还需要一些时间，调整心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130436,
					"content": "但我想，我会没事的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 101130437,
					"content": "嗯，真不错！斯坦利找到了真正的自己，杰克也成功自立了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130438,
					"content": "这么多好事加在一起，值得喝一杯庆祝庆祝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130439,
					"content": "你要在这个酒馆就地不醉不归吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130440,
					"content": "哈哈，这里的酒太贵了。杰克欠我的报酬还没给，他许诺我的报酬是珍贵名酒，还记得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130441,
					"content": "我先去找他要那瓶酒，一会儿就在<color=#00E1FFFF>「老地方」</color>集合吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130443,
					"content": "只能猜猜看了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "我想我可能知道…也许吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "嗯，<color=#00E1FFFF>「老地方」</color>，不见不散！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "哎？什么老地方，我怎么不知道？喂！喂，卖唱的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130446,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "可算来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130502,
					"content": "真难找！下次别打这种哑谜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130503,
					"content": "对了，卖唱的，你拿到酒了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130504,
					"content": "拿到了。杰克这家伙，说是什么「珍藏又珍贵的好酒」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130505,
					"content": "结果只不过是半瓶苹果酿而已嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130506,
					"content": "真怀念啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130507,
					"content": "第一次在这儿看风景的时候，我还不是「这副模样」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130508,
					"content": "不是…这副模样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "大约两千六百年前，尘世尚未划归七神所有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130510,
					"content": "那时，「旧蒙德」被暴君吹起的飓风包围，连飞鸟也不得通行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130511,
					"content": "「旧蒙德」？啊，我想起来了，就是现在的风龙废墟吧？你以前提过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130512,
					"content": "是的。曾经统治那座高塔的风之暴君，是「龙卷的魔神」迭卡拉庇安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130513,
					"content": "而那时的我，只是千风中的一缕。并无神灵之格，也不成人形…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130514,
					"content": "只是风中细微的元素精灵，是一缕「能够带来细小的转机与希望之风」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130515,
					"content": "只是元素精灵？不是人形？咦？温迪，你以前不长现在这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130516,
					"content": "嗯。我现在的样子，其实也和那位假斯坦利先生一样，是借用「朋友」的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130517,
					"content": "后来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130518,
					"content": "你说的那个朋友，他后来怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130519,
					"content": "（温迪的朋友，和斯坦利一样…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "派蒙，你想知道后面的故事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130521,
					"content": "当然当然！别吊我胃口，快说吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130522,
					"content": "派蒙，去采两个苹果来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "为什么现在突然想吃这个啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130526,
					"content": "哈哈哈，你肚子饿了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130527,
					"content": "是啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "呜…真是拿你没办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130529,
					"content": "啊——有时我会觉得，你有些过于聪明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130530,
					"content": "不过，朋友之间，也许就是要心知肚明才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130531,
					"content": "美酒，微风…这样的时刻，总会让我忍不住想起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130532,
					"content": "想起那首，从他那里听来的歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 101130533,
					"content": "我会好好听着的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "派蒙，能帮我找些鱼肉吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "咦？不是在听故事吗？怎么突然要吃这种东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}