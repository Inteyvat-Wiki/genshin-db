							-1146.261
						],
						"pointId": 300300750
					}
				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "你们好呀，我是来自须弥的旅行商人阿泰菲，很高兴认识你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460102,
					"content": "哇，居然从这么远的地方过来吗，不知不觉，我们的店铺名气已经这么大了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460103,
					"content": "多亏了派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "哼哼，现在在你面前的，正是冉冉升起的销售之星，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460106,
					"content": "啊哈哈，最近确实有不少消息灵通的商人听说了你们在售卖的炼金药剂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460107,
					"content": "这种不太常见的商品，大部分人还是不太敢冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460108,
					"content": "但在我看来，要想赚大钱，就得抢占商机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460109,
					"content": "虽然现在普通人对炼金药剂的了解程度还不是很高，但只要配合销售手段，一旦打开了市场，那可就是赚不完的摩拉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460110,
					"content": "如果能打响名号，说不定售价能翻十倍…嘿嘿，干完这一票，就能休息到年底了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460111,
					"content": "十倍！你是认真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460112,
					"content": "哼哼，只要有人愿意买，不管价格卖多高都是合理的。所谓你情我愿嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460113,
					"content": "这个说辞，让我想起了某个满脑子都是摩拉的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460114,
					"content": "我说，既然你来自须弥，该不会凑巧认识多莉吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460115,
					"content": "多莉？难道你说的是多莉·桑歌马哈巴依老爷？你们居然认识这位大人物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460116,
					"content": "她是我的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "好厉害！桑歌马哈巴依老爷是我的偶像，她的商业嗅觉和对摩拉的执着一直激励着我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460119,
					"content": "我曾经有幸拜访过卡萨扎莱宫，真是气派又美丽的宅邸啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460120,
					"content": "总有一天，我也想像她一样，拥有数都数不完的摩拉，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460121,
					"content": "呃…她已经彻底沉浸在梦里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401460122,
					"content": "祝你成功。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "谢谢你的祝福！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460126,
					"content": "那么，我们来聊聊一起赚大钱的方法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460127,
					"content": "其实很简单，我定期来向你进货，你生产出需要的药剂，然后我就能帮你卖到其他地方啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460128,
					"content": "如果决定合作的话，就来具体谈谈这批要出售的药剂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460129,
					"content": "查看药剂需求。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "根据我敏锐的市场嗅觉，这次需要的药剂是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460131,
					"content": "以后再说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "赚钱的机会可是稍纵即逝的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460124,
					"content": "还是聊正事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "咳咳，一下子扯远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "阿泰菲"
				},
				{
					"id": 401460117,
					"content": "以前打过交道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "这段时间的努力有成果了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
