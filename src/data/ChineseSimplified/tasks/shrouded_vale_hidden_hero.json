			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"文四爷",
					"黄三爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "唉，不想我古华派千年传承，到头来竟落到了门长带头骗吃骗喝的境地…奈何，奈何啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "文四爷"
				},
				{
					"id": 711092502,
					"content": "嗨…行了行了，我这不是舍不得师弟守着这师门饿死嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "黄三爷"
				},
				{
					"id": 711092503,
					"content": "#你也别露出那种表情了。你一天到晚郁郁寡欢的…看到刚才那个{M#小伙子}{F#小姑娘}活跃的表现，你也挺欣慰的不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "黄三爷"
				},
				{
					"id": 711092504,
					"content": "#就那{M#傻小子}{F#傻姑娘}？进去转一圈给你做个腊肉饭？我还欣慰？我要年轻几岁先一掌拍死你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "文四爷"
				},
				{
					"id": 711092505,
					"content": "嘿，年轻几岁你掌法还不如我呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "黄三爷"
				},
				{
					"id": 711092506,
					"content": "行了，你听我说…就剩下咱们几个老家伙了，若不像这样试探有缘人的底细，总不能真让那些藏书陪着咱们进棺材吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "黄三爷"
				},
				{
					"id": 711092507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "文四爷"
				},
				{
					"id": 711092508,
					"content": "哈哈，罢了，罢了，这等让人难受的丧气话，不说也罢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "黄三爷"
				},
				{
					"id": 711092509,
					"content": "对了，那两个孩子刚才做给我的美食，你也尝尝看吧？嘿嘿，我觉得比万民堂做得还美味呢！来，尝一口，尝一口嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黄三爷"
				}
			]
		}
	]
}