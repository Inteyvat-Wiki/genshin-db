				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "「…天其难谌，臻而见眷者罕。命其靡常，盛而未衰者鲜…获目于天，犹有径路所穷之时，况复天目未及者…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "碑铭"
				},
				{
					"id": 711090502,
					"content": "「…遗此碑宇，且问来许。行至绝处，自当何如？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "碑铭"
				},
				{
					"id": 711090503,
					"content": "（触碰石碑。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "（离开。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
