				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "欸？这把剑上好像写了什么？让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090602,
					"content": "「…抚剑长歌去，斫龙歃血还。神光似游电，寒浪欲摧山…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "古剑铭文"
				},
				{
					"id": 711090603,
					"content": "「…斩虎天衡下，刺蛟云海间。功成拂衣后，永同烟水闲…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "古剑铭文"
				},
				{
					"id": 711090604,
					"content": "旁边好像还有一块石碑…咦，这下面的字迹好像不太一样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090605,
					"content": "「…本欲遗鱼羊丰肴于此，奈何日久必腐。且留食谱于此，足下可自烹之。甚美。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "古老的摹刻"
				},
				{
					"id": 711090606,
					"content": "「…此外别无他物，唯此剑与此景。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "古老的摹刻"
				},
				{
					"id": 711090607,
					"content": "「…行至绝处，当何如？足下已知。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "古老的摹刻"
				},
				{
					"id": 711090608,
					"content": "「…不取…遗宝，仅留一…自此…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "歪歪扭扭的摹刻"
				},
				{
					"id": 711090609,
					"content": "「请从绝处…读我…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "歪歪扭扭的摹刻"
				},
				{
					"id": 711090610,
					"content": "呜哇…下面这几行字儿歪歪扭扭的，根本看不懂写了什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090611,
					"content": "大概就是他什么都没拿的意思吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "呜呜，到头来都没找到什么价值连城的宝藏，白期待一场了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090614,
					"content": "就是啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "不过，没想到在这种绝境，还能看到这样的风景…至少算是物有所值了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090615,
					"content": "没事没事，我做料理给你吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#欸？！真的吗！{NICKNAME}，一言为定喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090612,
					"content": "我也看不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
