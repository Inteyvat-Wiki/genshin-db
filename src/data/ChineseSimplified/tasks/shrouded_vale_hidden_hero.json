						],
						"pointId": 5063
					}
				]
			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "哇啊，没想到这破破烂烂的王山厅里，居然还真的藏了这么深的秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090202,
					"content": "我也没想到！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "而且，黄三爷好像也不知道有这种地方…等等，难道这里就是传说中的「古华藏宝室」吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090205,
					"content": "#而且…{NICKNAME}你看，那边的台子上好像有什么东西在发光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090206,
					"content": "是宝藏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "总之，我们快点过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711090207,
					"content": "是机关？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "可能这就叫「人不可貌相」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
