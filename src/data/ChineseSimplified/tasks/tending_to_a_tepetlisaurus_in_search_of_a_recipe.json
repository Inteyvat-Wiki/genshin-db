			"dialogs": [
				{
					"id": 250220501,
					"content": "唔，这花闻着倒是不错，有一股清香…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220504,
					"content": "霍莱？你…呜哇！已经吃下去了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220505,
					"content": "（霍莱一口气吞下了清心，对着你们眨了眨眼…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250220506,
					"content": "霍莱突然转过了身子，一口气吃完了旁边的半盆水果…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "霍莱的食欲怎么突然这么好了？这种叫清心的东西，效果有这么好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "卡兹加"
				},
				{
