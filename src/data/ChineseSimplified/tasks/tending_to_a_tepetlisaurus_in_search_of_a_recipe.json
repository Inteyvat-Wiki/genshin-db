					"nextDialogs": [
						250220405
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250220405,
					"content": "（霍莱大口地嚼着堇瓜，一会就全吃光了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250220406,
					"content": "呜呜，呜呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250220407,
					"content": "哈哈哈，一下子就吃光了，你很喜欢这个吗？霍莱？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220408,
					"content": "呜呜，呜！呜呜——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250220409,
					"content": "好！那我过会就去找人问问，哪里有稻妻来的商人，得多买点堇瓜才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡兹加"
				}
			]
		},
