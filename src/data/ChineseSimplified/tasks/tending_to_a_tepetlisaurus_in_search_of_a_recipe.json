			"dialogs": [
				{
					"id": 250220101,
					"content": "嗯…看来是得换一个食谱了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220102,
					"content": "呜呜，呜呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250220103,
					"content": "你又有什么主意了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "呜，呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220107,
					"content": "平时霍莱都能吃完一整盆果子，吃完之后能疯玩一整天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220108,
					"content": "现在它一盆水果只能吃一半多，而且吃完之后，就坐在旁边一动也不动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220109,
					"content": "我还以为它生病了，吓得连夜去找医生帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220110,
					"content": "我们俩折腾了一整夜，终于确定霍莱什么病也没有，它就是…挑食了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220111,
					"content": "医生说，最好的解决方法就是给霍莱换一道新菜谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220112,
					"content": "他还说，我也可以试试在霍莱吃饭的时候放点音乐。也许这样可以有助于霍莱提起食欲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220113,
					"content": "听起来还不错啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "哈哈哈…是啊，我当时确实找到了一张唱片，里面的音乐霍莱也很喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220116,
					"content": "不过，当霍莱跳起来，一口咬掉了一半唱片之后…我就被迫放弃了这个计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220117,
					"content": "毕竟对于嵴锋龙霍莱来说，用黑曜石和燃素做的唱片，本身就足够好吃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220118,
					"content": "我现在也只能去「悬木人」那边找人帮忙，看能不能拿到一些新奇的食材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220119,
					"content": "我去帮你找些食材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "你愿意帮忙？那再好不过了！「悬木人」的老兄也只能在纳塔找食材，你肯定能去纳塔外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220124,
					"content": "等会啊，我看看医生给我列的食材建议表，这位医生真是见多识广，对纳塔外的事都有些了解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220125,
					"content": "唔…上面写着，可以尝试<color=#00E1FFFF>「虹彩蔷薇」，「堇瓜」</color>和<color=#00E1FFFF>「清心」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220122,
					"content": "那就拜托你了，找到新奇的食材之后，就直接拿过来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "卡兹加"
				},
				{
					"id": 250220123,
					"content": "呜呜，呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍莱"
				},
				{
					"id": 250220120,
					"content": "我可太擅长找食材了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "还有这种唱片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "（摸摸霍莱。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "呜，呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
