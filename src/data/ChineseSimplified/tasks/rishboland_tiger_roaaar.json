			"dialogs": [
				{
					"id": 730420601,
					"content": "玩得真开心！和金色的那菈玩游戏，兰犍多太高兴了！而且，那菈好快、好厉害，就和真正的长鬓虎一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "兰犍多"
				},
				{
					"id": 730420602,
					"content": "和其他兰那罗、真正的长鬓虎一起玩也开心，但是和新朋友，那菈朋友一起玩，有更多开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "兰犍多"
				},
				{
					"id": 730420603,
					"content": "为什么长鬓虎要追兰那罗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "长鬓虎和兰那罗都是朋友，朋友就会一起玩。不过，兰犍多发现，那菈会害怕长鬓虎。所以，为了无忧节，想了新的游戏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "兰犍多"
				},
				{
					"id": 730420605,
					"content": "谢谢你，那菈。兰那罗的花花，送给金色的那菈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
