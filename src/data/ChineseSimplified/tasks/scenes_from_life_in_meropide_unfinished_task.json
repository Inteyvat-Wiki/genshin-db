					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "嗯？这里怎么会有留影机？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630202,
					"content": "「有新闻的地方就有留影机」，你们没听过这句话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630203,
					"content": "好像听过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "可是这句话是我刚编的欸，你是在哪里听过的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630205,
					"content": "唉，果然这世上根本没有什么新鲜东西。不管说什么、写什么，都只能是对他者的戏仿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630208,
					"content": "留影机有了，新闻在哪儿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "新闻…就像钓鱼一样。需要耐心的等待，在准确的时机做出正确的判断，这样才能钓上大鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630210,
					"content": "哦，不，我是说，这样才能钓到大新闻。嗯？好像也不对，算了，不管了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630211,
					"content": "听起来好业余啊，你不是记者吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "那你就看走眼了，哼哼，我是业余记者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630222,
					"content": "话说回来，业余记者为什么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630223,
					"content": "为了完成前辈交给我的课题呀，也就是用留影机捕捉梅洛彼得堡看守在工作中的生动瞬间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630224,
					"content": "可是之前为了办理相关的合规文件耗费了太多时间…你们看看就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630225,
					"content": "奈莉拿出一大摞文件，密密麻麻写着各项条款和各种署名，看了感觉头昏眼花…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "这一套流程全跑完，都错过看守当班的时间啦。用钓鱼来类比的话，现在根本没鱼可钓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630227,
					"content": "欸？可是这里明明还有看守在当班吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630228,
					"content": "可我想钓白金典藏型嘛，如果是初始能力型或者水域清理者，总觉得少了点冲击力…就算完成了课题，前辈也一定不会称赞我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630229,
					"content": "不想空手而归的话就别挑挑拣拣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "说得对，我应该正视自己的能力，不要妄想去钓超出自己能力范围的鱼…呜呜，我是个没用的钓师…哦不，是没用的业余记者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630234,
					"content": "好，丧气话说完了，该振作起来了！两位如果方便的话…能帮我一个小忙吗？拜托了！我会支付报酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630235,
					"content": "变脸可真快呀…帮忙也得看是什么内容呀，不如你先说说需要我们做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630236,
					"content": "那边的看守，格兰维尔，根据我的判断，他的新闻价值等价于态势控制者在维护机关里的价值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630237,
					"content": "给他留影的话，应该能写出一篇不错的报道吧。这样前辈一定也无话可说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630238,
					"content": "但是他根本不过来这边！两位能不能把他带到这边适合留影的地方来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630239,
					"content": "你自己说明情况让他过来不就好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "那样的话他肯定会因为太过在意镜头而摆出僵硬的姿势的，那不就成摆拍了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630243,
					"content": "我想想，最好是这样，先把扩音机关掉，然后向格兰维尔报告，说这边的扩音机故障了，请他来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630244,
					"content": "这样一定就能拍到了，梅洛彼得堡看守在工作中的生动瞬间！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630245,
					"content": "课题能否完成就在此一举了！拜托你们了，帮帮我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630246,
					"content": "#听起来倒是不难，{NICKNAME}，要不我们就帮帮她好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630241,
					"content": "带留影机去他那边不就好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "欸——可是这边更适合取景嘛。而且如果让他看到留影机，一定会在意得不得了，最后拍出一些姿势僵硬的画片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630230,
					"content": "那你继续等吧，再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "你们这就走吗？真的走？不帮帮我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630232,
					"content": "呃…我们也不可能变出你想要的白金典藏型吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630213,
					"content": "别管新闻了，我也喜欢钓鱼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "当真？那太好了，其实我只是钓鱼新手，正愁有些问题没处讨教，比如说钓到维护机关但它咬人…是你的话会怎么应对呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630215,
					"content": "放生就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "原来如此，这就是你的选择啊。嗯嗯，很有参考价值，我记下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630220,
					"content": "…欸！怎么突然聊起钓鱼了？你们好擅长引导话题！看来我作为业余记者还有很多要学的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "奈莉"
				},
				{
					"id": 740630221,
					"content": "钓鱼的话题根本就是你自己先提起的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630216,
					"content": "那当然是揍它一顿让它知道厉害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "做成料理请派蒙品尝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#呜哇，虽然我很信任{NICKNAME}的厨艺，但是那东西怎么看都不像可食用的类型吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630206,
					"content": "没听过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "哦哦！那你们现在听过了。请记住，如果要在别处引用，一定要注明来源！也就是我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "奈莉"
				}
			]
		},
		{
