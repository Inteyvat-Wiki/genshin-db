			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"格兰维尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "你好，我们发现扩音机好像出了点小问题…就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740630402,
					"content": "又故障了？真是怪事…明明之前找克兰茨修过。看来他这水平还不如我呢，明明过去都是锤两下就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
