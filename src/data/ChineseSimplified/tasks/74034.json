						],
						"pointId": 26
					}
				]
			},
			"dialogs": [
				{
					"id": 740340501,
					"content": "艾尤恩，真是巧遇。今天下班你总有时间和我喝杯咖啡了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340502
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340502,
					"content": "感谢您的好意，但我有一件「秘密事务」来请您处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340503
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340503,
					"content": "「秘密事务」？是我知道的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340504
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340504,
					"content": "我想您应该不知道。今天早上我才接到这文件呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340505
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340505,
					"content": "这倒是稀奇，也许是我今天还没来得及看《蒸汽鸟报》的原因，获取消息的速度慢了你一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340506
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340506,
					"content": "明明是秘密事务，为什么你会在《蒸汽鸟报》上看到呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340507,
					"content": "哈哈哈，那些记者传递消息的速度，可比我们复律庭内部传递消息的速度快多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340508
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340508,
					"content": "但也可以理解，毕竟他们传递消息可是会拿到报酬的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340509
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340509,
					"content": "完，完全无法理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340510,
					"content": "先不谈这些。先生，事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340511
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340511,
					"content": "艾尤恩详细叙述了相关事宜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340512
					]
				},
				{
					"id": 740340512,
					"content": "没错，的确有必要下发这样的文件，之前确实出过这样的事。一个白痴为了显摆自己的桌面摆设，拿留影机给自己的桌子留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340513
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340513,
					"content": "他是「留影机爱好协会」的一员，还把那张画片拿去给会员们看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340534
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340534,
					"content": "但会员中的一名记者很快发现，在画片中有一份疑似复律庭内部通讯稿的文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340514
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340514,
					"content": "然后，那份抱怨复律庭的内部晚餐除了鱼就是鱼的通讯，第二天就出现在了《蒸汽鸟报》上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340515
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340515,
					"content": "这也算是需要保守的秘密吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340516,
					"content": "听起来好像不是很严重…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340517
					]
				},
				{
					"id": 740340517,
					"content": "无论如何，这也算得上是内部通讯，于情于理都不该对外泄露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340518
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340518,
					"content": "枫丹廷的人们可不会放过任何一个嘲笑复律庭的机会，我们必须得谨慎行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340519
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340519,
					"content": "即使他们其实根本不关心我们在做什么。他们只是想…呃，笑两声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340520
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340520,
					"content": "呃，总之…那这份文件就由您的办公室来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340521
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340521,
					"content": "但有关人员事务规章…迪福尔所在的办公室显然更适合签发这份文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340522
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340522,
					"content": "毕竟，在这份文件里，虽然告知所有人保密原则十分重要，但更重要的是，如何告知所有人保密原则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340523
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340523,
					"content": "要我说，必须得迪福尔来领办，我们办公室可以协办。这样既有效率，又能保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340524
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340524,
					"content": "加特尼奥飞快地在文件上的协办方位置上签上了名字…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340525
					]
				},
				{
					"id": 740340525,
					"content": "但是，加特尼奥先生！这事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340526
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340526,
					"content": "好啦小伙子，办这种急事可不能拖拖拉拉的。快去找迪福尔吧，不然他的耐心马上就要被日常工作给耗尽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340527
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340527,
					"content": "我也得去帮你们找找可用的保密原则了，等到文件正式下发，我们办公室一定全力支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340535
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340535,
					"content": "快去找他吧，小伙子！我还得去…呃，处理别的事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340536
					],
					"speakerTitle": "加特尼奥"
				},
				{
					"id": 740340536,
					"content": "加特尼奥大踏步地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340528
					]
				},
				{
					"id": 740340528,
					"content": "什么？加特尼奥先生，等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340529,
						740340530
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340529,
					"content": "走掉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340531
					]
				},
				{
					"id": 740340531,
					"content": "您见识到加特尼奥先生的能力了吧？他能把所有事都办理妥当的诀窍，就是从来不办有风险的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340532
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340532,
					"content": "原来是这种推卸责任的能力啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340533,
					"content": "没办法…只能去找迪福尔先生了。咱们这边走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340530,
					"content": "走得真快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340535
					]
				}
			]
		},
