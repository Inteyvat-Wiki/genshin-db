							4.838
						],
						"pointId": 29
					}
				]
			},
			"dialogs": [
				{
					"id": 740340701,
					"content": "艾尤恩，我猜你今天没有带什么好消息给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340702
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340702,
					"content": "先生，这确实不是个好消息。准确来说，这是一个「秘密」消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340703
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340703,
					"content": "确实如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340704
					]
				},
				{
					"id": 740340704,
					"content": "非常幽默，艾尤恩。那么这个「秘密」消息到底是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340705
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340705,
					"content": "艾尤恩详细叙述了相关事宜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340706
					]
				},
				{
					"id": 740340706,
					"content": "这种情况的确有可能出现，毕竟复律庭里的职员对一份文件的密级程度并不敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340707,
						740340708
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340707,
					"content": "这种问题也会忽视吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340709
					]
				},
				{
					"id": 740340709,
					"content": "这都是拜加特尼奥那群人所赐。所有复律庭里来往的文件，都会交由他们审定密级，再做上标记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340710
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340710,
					"content": "这制度听起来还算不错。但那群审定密级的人为了省事，无论什么文件，都至少会给一个「秘密」的定级。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340711
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340711,
					"content": "上周卡尔西去欧庇克莱歌剧院发表了一次演说，谈了谈新歌剧演出的话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340712
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340712,
					"content": "我记得这件事，演讲过程不长，但有很多人听，而且演讲稿还登上了报纸呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340713
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340713,
					"content": "既然已经在大家面前讲过了，那大家也都该知道了呀。大家都知道的事，怎么能算是秘密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340714,
					"content": "没错，但就算这样，加特尼奥也非要给它定一个「秘密」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340715,
						740340716
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340715,
					"content": "也许里面真有重要内容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340717,
					"content": "才怪呢。他把这篇早就在公众面前演讲过的稿件定成了「秘密」，但却没管那些那份之前的原稿啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340718
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340718,
					"content": "卡尔西自己才不会写演讲稿，整篇稿件都是别人代写的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340742
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340742,
					"content": "他做的唯一一处修改，就是把自己的名字签在上面，再改几个无关紧要的形容词。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340719
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340719,
					"content": "但那些修改前的原稿，就堆在卡尔西的办公室桌子上，没有一个人去管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340720
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340720,
					"content": "如果这就是加特尼奥想要保守的秘密，他怎么不把这些文件也定个密级呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340721,
						740340722
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340721,
					"content": "这也是一种保密方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340723,
					"content": "得了吧！他们只是想要省点事而已。在加特尼奥看来，保守秘密的最佳方式，就是把所有事都变成秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340724
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340724,
					"content": "这样，就没人知道到底哪一份才是真正需要保守的秘密了。就连他们自己也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340725
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340725,
					"content": "想要把一杯水藏起来，那最好的方法的确是将它倒入一个湖泊。这样做也没错呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340726
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340726,
					"content": "如果你要藏起来的是一杯枫达呢？你准备把整片湖泊都变成枫达湖吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340727
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340727,
					"content": "#一片枫达湖…嘿嘿嘿，想要去里面游泳。枫达可好喝了，对吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340728,
						740340729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340728,
					"content": "派蒙，重点不在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340731
					]
				},
				{
					"id": 740340731,
					"content": "那么…这份文件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340732
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340732,
					"content": "艾尤恩先生，这件事有关人员事宜，你来找我的确没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340733
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340733,
					"content": "但在那之前，你必须得让加特尼奥来审定这件事的密级。就像是之前说的那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340743
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340743,
					"content": "在正式工作之前，我们首先得知道要藏起来的究竟是一杯水还是一杯枫达啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340734
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340734,
					"content": "咱们是同事，我不会为难你。我们办公室绝对会倾力协助办理这件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340735
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340735,
					"content": "迪福尔拖过文件，慢吞吞地在协办方位置上签上了名字…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340736
					]
				},
				{
					"id": 740340736,
					"content": "好了，快去找加特尼奥吧！这么大的人员事宜，我要去提前知会几个人才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340737
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340737,
					"content": "迪福尔先生，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340744
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340744,
					"content": "迪福尔头也不回地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340738,
						740340739
					]
				},
				{
					"id": 740340738,
					"content": "走掉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340740,
					"content": "唉，这就是迪福尔先生，暴躁又精明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340741
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340741,
					"content": "没办法了，我们去找加特尼奥吧，咱们这边走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340739,
					"content": "走得真快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340729,
					"content": "等下我们去喝一杯啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340730
					]
				},
				{
					"id": 740340730,
					"content": "真的？那说好了，不许反悔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340722,
					"content": "说不定是…谨慎起见？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340716,
					"content": "呃…也许他有这么做的理由…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340708,
					"content": "没有人告诉他们这个…「密级」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340744
					]
				}
			]
		},
