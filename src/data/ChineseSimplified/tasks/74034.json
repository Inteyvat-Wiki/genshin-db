			},
			"dialogs": [
				{
					"id": 740340601,
					"content": "艾尤恩。你找我有什么事吗？气喘吁吁的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340602
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340602,
					"content": "事情是这样的，迪福尔先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340603
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340603,
					"content": "艾尤恩详细叙述了相关事宜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340604
					]
				},
				{
					"id": 740340604,
					"content": "你找错人了，艾尤恩。你难道没意识到这份文件的重点是「保密」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340605
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340605,
					"content": "我还以为主语是「这份文件」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340606
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340606,
					"content": "语法确实如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340607
					]
				},
				{
					"id": 740340607,
					"content": "喂，现在的重点不是这个吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340608,
					"content": "我真欣赏你们的严谨。但这份文件我是不会签的，无论怎么考虑，都应该是加特尼奥来领头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340609
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340609,
					"content": "加特尼奥先生说，应该由您来领头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340610
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340610,
					"content": "哈！我来？该怎么做，我要拿着喇叭，朝每一位进来上班的人大喊吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340611
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340611,
					"content": "「嘿！先生女士们，不要把留影机带进办公室，这样会导致泄密！绝对不要做这样的事！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340612
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340612,
					"content": "还是我要去印几百份文件，放在每一位复律庭职员的桌上，让他们拿着去喝咖啡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340613
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340613,
					"content": "我们可不像加特尼奥，能把泄密的人逮住，然后教训他们。我们唯一能做的就是发通知，没人会搭理这些文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340614
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340614,
					"content": "但他已经在文件上签了字，您瞧这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340615
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340615,
					"content": "年轻人，你知道「协办方」是什么意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340616
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340616,
					"content": "呃…听从调遣的一方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340617
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340617,
					"content": "意思是「至少主要责任不在我」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340618
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340618,
					"content": "我绝不会在这份文件上签字。如果非要我们办公室来领办，那就让马内瓦尔亲自来说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340619
					],
					"speakerTitle": "迪福尔"
				},
				{
					"id": 740340619,
					"content": "迪福尔怒气冲冲地离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340620
					]
				},
				{
					"id": 740340620,
					"content": "他、他说话的声音好大，根本不敢插话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340621,
					"content": "您看，这位先生的脾气就是这么暴躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340622
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340622,
					"content": "那现在怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340623
					]
				},
				{
					"id": 740340623,
					"content": "别担心…咱们回去找洛耶茨先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
		{
