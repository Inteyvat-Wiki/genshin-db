						4610809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610809,
					"content": "别急，按照交易所的规矩，他们会安排线人来和我们接头，防止情报泄露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610810
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610810,
					"content": "那个线人，我已经约她在低语森林见面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610811
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610811,
					"content": "那我们还在等什么呀，不去找她吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610812,
						4610815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610812,
					"content": "这件事凯亚自己不方便出面吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610813
					]
				},
				{
					"id": 4610813,
					"content": "没错！真不愧是阁下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610814
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610814,
					"content": "毕竟我是骑士嘛，理论上是完全不了解这些地下活动的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610816
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610816,
					"content": "那就有劳二位替我跑一趟了，不胜感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610817
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610817,
					"content": "情报费用方面，当然，我也会替你们报销的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610818
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610818,
					"content": "嘿嘿。包在我身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610815,
					"content": "我和派蒙会把情报带回来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610816
					]
				}
