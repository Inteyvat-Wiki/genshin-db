					"nextDialogs": [
						4610507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610507,
					"content": "当初，我在烬寂海，那可是一片死亡之地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610508
					],
