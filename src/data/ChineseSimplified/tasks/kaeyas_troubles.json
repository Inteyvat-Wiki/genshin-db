			"trigger": {
				"objectNames": [
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "啊啊糟了…伤脑筋…这可怎么办呢……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610102,
					"content": "怎么了，凯亚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#哦，感谢千风。{NICKNAME}，你的出现一定是神对我的恩赐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610105,
					"content": "风神派来拯救凡人的使者哟，请问你现在有空吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610106,
					"content": "唔哇，好肉麻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610107,
					"content": "也不能说没空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "那可太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610110,
					"content": "其实有件事不方便让骑士团的同事知道，非你帮忙不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610111,
					"content": "我想借一步说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610112,
					"content": "不如咱们就到骑士团旁边的庭院去吧，随我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610113,
					"content": "怎么搞得这么神神秘秘的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610109,
					"content": "先说说究竟发生了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "你好像不是会这么慌张的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "好了，就在这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610202,
					"content": "别吊胃口啦，到底有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610203,
					"content": "该从何说起呢…对了。先告诉你们一个秘密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610204,
					"content": "那是有关我个人过往的秘密，请千万不要对别人提起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610205,
					"content": "放心，我的口风可是很紧的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610206,
					"content": "其实啊…我的爷爷…是个海盗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610207,
					"content": "哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610208,
					"content": "…不不。这反应也太冷淡了。难道你不相信我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610209,
					"content": "看！我的眼罩就是海盗爷爷的遗传，这就是血亲的证明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610210,
					"content": "眼罩原来还能遗传的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#啊哈哈，{NICKNAME}，你还真是没有常识呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610212,
					"content": "这就像许多孩子头上的辫子也遗传自妈妈，是一样的道理啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610214,
					"content": "昨晚我翻阅爷爷留下来的手记，偶然发现了爷爷留下的<color=#00E1FFFF>宝藏</color>信息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610215,
					"content": "…宝藏？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610216,
					"content": "根据手记上的情报，似乎宝藏被埋藏在「失落的阿卡狄亚遗迹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610217,
					"content": "宝藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610218,
					"content": "但这遗迹的位置具体在哪里，目前还没有线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610219,
					"content": "宝藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610220,
					"content": "凯亚！那究竟是什么宝藏！黄金吗？还是宝石？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610221,
					"content": "哼哼，只有财宝的宝藏，不过都是三流货色而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610222,
					"content": "我爷爷的宝藏，是「剑」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610223,
					"content": "据说是一柄只要握住，就可以获得无敌力量的神剑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610224,
					"content": "哇——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610225,
					"content": "那剑是天空岛上的神明失手落入海中的，被爷爷他们碰巧打捞起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610226,
					"content": "他握住剑柄的瞬间，电闪雷鸣，巨浪翻腾，原本晴空万里的海上忽然卷起风暴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610227,
					"content": "依靠神剑的力量，爷爷一路击败了八头海蛇、银发女妖、深渊邪龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610228,
					"content": "但这力量过于强大，令其他海盗觊觎不已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610229,
					"content": "为了避免争端，爷爷只能把神剑藏了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610230,
					"content": "八头海蛇、银发女妖…真的存在吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "这世界就是因为充满了未知，所以才会有趣的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610233,
					"content": "精彩到令人难以置信的冒险，只属于海盗的浪漫，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610234,
					"content": "呜~~~~~~哇！！简直太厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610235,
					"content": "最近有一伙<color=#00E1FFFF>盗宝团</color>非常活跃，好几处遗迹已经发生文物失窃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610236,
					"content": "我担心「阿卡狄亚遗迹」也很快会被他们发现，那柄神剑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610237,
					"content": "那可不行！与其落在坏人手里，还不如我们来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610238,
					"content": "#…总之，你放心吧！我和{NICKNAME}会帮忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610239,
					"content": "哦~？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610240,
					"content": "那可真是太棒了，还请记得保守秘密，我会等你们的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610241,
					"content": "#喂，怎么样，{NICKNAME}？不觉得很激动吗？那可是超——级厉害的神剑呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610242,
					"content": "那是真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "嗯…不如先去<color=#00E1FFFF>冒险家协会</color>附近打探一下情报？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610245,
					"content": "关于遗迹的情报，冒险家们会比较清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610243,
					"content": "那真的是真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
