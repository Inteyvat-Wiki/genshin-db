						4610805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610805,
					"content": "没什么。我是说，不经历一些挫折，又怎么会有得到宝藏时的喜悦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610806,
					"content": "对了，正巧我这边倒是有一些消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610807
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4610807,
					"content": "我刚托人去了趟地下情报交易所…似乎有人知道「阿卡狄亚遗迹」的相关情报。",
