	"talks": [
		{
			"id": 46101,
			"completionStepIds": [
				46101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
