			"dialogs": [
				{
					"id": 4610404,
					"content": "哼，我们才不是为了那么无聊的事来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610405,
					"content": "我们是在找一柄从天空岛上掉下来的，斩杀过八头女妖，银发海蛇的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610407,
					"content": "是八头海蛇，银发女妖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610408
					]
				},
				{
					"id": 4610410,
					"content": "你透露太多情报了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610411
					]
				},
				{
					"id": 4610406,
					"content": "超级超级厉害的神剑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610407,
						4610410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610408,
					"content": "欸，都差不多啦，反正就是…很厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610409,
					"content": "总而言之，只要不把藏宝地点说出去就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610411,
					"content": "没关系啦，只要不把藏宝地点说出去就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610413,
					"content": "（就这么说出去了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610414
					]
				},
				{
					"id": 4610412,
					"content": "那么，塞琉斯先生，你知道「失落的阿卡狄亚遗迹」在哪里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610414,
					"content": "「阿卡狄亚遗迹」…没听说过这名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610415
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 4610415,
					"content": "不过还是谢谢你们分享的情报。如果找到的话，记得拿来让我见识见识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610416
					],
					"speakerTitle": "塞琉斯"
				},
				{
					"id": 4610416,
					"content": "嗯？分享…情报…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
