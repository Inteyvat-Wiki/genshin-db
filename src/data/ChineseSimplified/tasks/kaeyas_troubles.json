						4610502
					]
				},
				{
					"id": 4610502,
					"content": "抱歉哦，我们只是想问你知不知道「阿卡狄亚遗迹」在哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610503,
					"content": "…「阿卡狄亚遗迹」？居然还有我斯坦利没去过的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610504
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 4610504,
					"content": "斯坦利先生也不知道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4610505,
					"content": "唔…先别管什么阿卡狄亚了，不如听我讲讲我在烬寂海、泉之境发生的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610506
					],
					"speakerTitle": "斯坦利"
				},
				{
					"id": 4610506,
					"content": "我们没时间听故事啦，再帮忙好好想想有没有什么线索嘛。",
