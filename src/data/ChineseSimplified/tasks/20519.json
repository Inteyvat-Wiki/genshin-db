				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190101,
					"content": "又见面了，怎么样，最近过得还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190102
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190102,
					"content": "哦，顺便说一句，吉丽安娜小姐到目前为止，过得不好不坏。不那么坏的是，她暂时没有离开蒙德城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190103
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190103,
					"content": "但不那么好的是，她已经向维多利亚修女坦白了自己的事，而维多利亚修女到现在也没动静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190104
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190104,
					"content": "这件事到底会怎么收场，我们也只能拭目以待喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190105
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190105,
					"content": "…你又想要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190106
					]
				},
				{
					"id": 205190106,
					"content": "别用这么可怕的目光盯着我啦，我又不是什么坏心眼的人，我可是好心给你指过帮助吉丽安娜小姐的路呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190107
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190107,
					"content": "好了，说正事。这次找你来，还是因为之前那件事遗留下来的「小问题」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190108
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190108,
					"content": "简单来说，你击退了盗宝团，但同时也把「吉丽安娜就在蒙德城」这件事给挑明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190109
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190109,
					"content": "盗宝团对于叛徒可从来不会心慈手软，据我所知，蒙德城周围已经出现了好几股盗宝团的踪迹，而且都是没有见过的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190110
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190110,
					"content": "恐怕是想要来找吉丽安娜小姐的麻烦，顺便为自己人报仇呢。这么危险的家伙们，就只能拜托你去击退啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190111,
						205190113,
						205190115
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190111,
					"content": "这都是你干的好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190112
					]
				},
				{
					"id": 205190112,
					"content": "哎呀，我也是奉命行事啦，要不是那位先生这么坚持，一定要你来做这件事，我也不会继续找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190113,
					"content": "你给我自己去处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190114
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190114,
					"content": "别说这种无情的话嘛，我可没有你这种实力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190115,
					"content": "这是西风骑士团的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190116
					]
				},
				{
					"id": 205190116,
					"content": "话是这么说没错，不过那位先生判断，在现在的情况下，吉丽安娜小姐的事越少人知道越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190117
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190117,
					"content": "另外，那位先生也不太希望西风骑士团参与这件事。毕竟…西风骑士们行事已经习惯了大开大合，总会把事情做得太过头",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190118
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190118,
					"content": "比如那位可靠的霍夫曼先生，如果他听说有盗宝团在蒙德城附近出没，一定会第一时间报告骑士团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190119
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190119,
					"content": "如果骑士团真的浩浩荡荡地出动了，盗宝团大概也马上会化整为零跑掉，将盗宝团完全击退的计划又会再次打水漂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190120
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190120,
					"content": "所以，这次就只能拜托你去「单兵作战」，高效地解决掉他们啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190121
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190121,
					"content": "不过…那群盗宝团居然敢靠蒙德城这么近，也许西风骑士团早就察觉到了，已经准备开始行动了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190122
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190122,
					"content": "但是，这些就不在我们的考虑范围之内啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190123
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190123,
					"content": "哎呀，你就放心啦，这次我还给你准备好了扎实的报酬呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190124
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190124,
					"content": "毕竟那位先生这次给我拨了不少摩拉，不像上次，还要我自己掏钱垫上…对了，我把那些盗宝团的位置也给你标上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190125
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 205190125,
					"content": "那么，不管怎么说，看在摩拉的面子上，保护吉丽安娜小姐、鲁道夫先生，莉莉和蒙德城的任务，就交给你了，要加油啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇尔"
				}
			]
		},
		{
			"id": 2051902,
