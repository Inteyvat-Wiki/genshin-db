			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "…盗宝团…哦！不好意思，您有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205190302,
					"content": "有盗宝团在蒙德城周围活动。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "盗宝团？我们正准备去追踪一支盗宝团。那群家伙居然敢靠近蒙德城，也不知道想要做什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205190304,
					"content": "不过，无论原因是什么，他们肯定没打什么好主意。这次我们投入了很多人手来对付他们…恐怕暂时没办法顾及您的报告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205190305,
					"content": "但您的报告我已经记下了，等我们处理完那批盗宝团之后，我就会如实向上汇报的。再次感谢您的报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
