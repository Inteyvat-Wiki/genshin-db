			},
			"dialogs": [
				{
					"id": 205190501,
					"content": "…您，您有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 205190502,
					"content": "我还在等着维多利亚修女给我回答呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190503
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 205190503,
