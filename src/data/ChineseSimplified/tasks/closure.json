			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夏沃蕾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191871901,
					"content": "在警备队赶来之前，这里就由我们看管吧。放心，他们不会再有机会溜走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871902,
						191871903
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871902,
					"content": "还有一些好奇的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191871904
					]
				},
				{
					"id": 191871904,
					"content": "嗯…涉案原料还有很多正规用途，不只是能用来制备「仿制乐斯」，所以不会直接违禁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871905
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871905,
					"content": "港口一般会暂时扣留，等通过各种申报再允许过关，否则就退回原船。艾洛迪应该就是在退回之前，偷换了原料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871906
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871906,
					"content": "载着原料来的海外船只，多半也是她事先联系好的，所以收到了调换过的货品后，依旧心照不宣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871907
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871907,
					"content": "这些罪行我们还会继续追查。既然抓住了艾洛迪，剩下的也只是时间问题了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871903,
					"content": "艾洛迪是怎么偷换原料的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191871904
					]
				}
			]
		},
		{
			"id": 1918720,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1918705",
							"2"
						],
						"stepId": 1918705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"林尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191872001,
					"content": "今天「认真模式」的运行时长算是破纪录了吧…还真少见，是因为谁呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872002,
						191872003
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872002,
					"content": "还有一些好奇的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191872004
					]
				},
				{
					"id": 191872004,
					"content": "唔…按之前查到的线索，「仿制乐斯」先是在枫丹小规模流通，后来才从小买卖变成大走私。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872005
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872005,
					"content": "一开始流通的，应该是皮埃尔早期制备的存货。但他粗劣的犯罪，很快就被身为巡警的艾洛迪发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872006
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872006,
					"content": "艾洛迪从中看到了能大量牟利，甚至改头换面、重新生活的机会，所以一边暗中掩饰他的早期罪行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872007
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872007,
					"content": "一边以贝努瓦的名义写信，用搜集的罪证和巨额的利润，威逼利诱皮埃尔配合她的后续计划吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872008
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872008,
					"content": "可惜，遇到了琳妮特。别看她平时不喜欢想太多，「认真模式」下的她可比谁都敏锐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872009
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872009,
					"content": "…不过这个模式的「耗能」也很快。我们一会儿还要做笔录，陪她「充能」的事，可就交给你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872003,
					"content": "皮埃尔是怎么入伙的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191872004
					]
				}
			]
		}
	]
}