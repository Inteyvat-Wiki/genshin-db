						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "祖尔宛，我们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570202,
					"content": "#啊呀，是{NICKNAME}、斯露莎还有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570203,
					"content": "看你们的样子，应该是已经成功拿到所有的「灵光绝唱」了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570204,
					"content": "虽然经过了一些曲折。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "不管怎么样，最终的结果是好的，拜托你们果然没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570207,
					"content": "若不是有你们在，恐怕「灵光绝唱」早就被那些心怀叵测的家伙夺走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570208,
					"content": "欸，祖尔宛的话，怎么听起来像是早就知道些什么的样子啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570209,
					"content": "欸嘿，还真的被我说中了啊，你们该不会真的遇到了那些侍奉黑渊的家伙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570210,
					"content": "你怎么知道的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "这个嘛…与其深究于此，不如先跟我说说到底发生了什么吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570214,
					"content": "同祖尔宛讲述了在地下遗迹中的冒险，以及那先朱那背叛的事情。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "呵呵，没想到竟然连矫论团的「识主」都投向了黑渊，虽说原本就没对他们抱有什么期待，但这样听来也有些骇人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570216,
					"content": "而且如果我猜的没错的话，他之所以会盯上「灵光绝唱」，也是受与你们战斗的黑渊之人的蛊惑，毕竟此人也算是我的旧相识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570217,
					"content": "欸？祖尔宛竟然还认识深渊教团的家伙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570218,
					"content": "哼，那家伙原本也曾是矫论团的一员。数百年前，曾有自森林而来的调查团为了探寻荼诃人的秘密而造访此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570219,
					"content": "他们不顾矫论团的劝阻，执意要进入荼诃人留下的遗迹。为了防止意外发生，当时的识主便命他一同前去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570220,
					"content": "然而不知是在遗迹中遭遇了什么，当我们再次见到他时，他已经接受了污秽的「赐福」，而调查团的人也不知所踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570221,
					"content": "黑渊的信徒随之聚集而来，他们盯上了「灵光绝唱」，为此还唤来了众多的迪弗魔兽进攻花海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570222,
					"content": "虽然依靠众多的花灵与人类勇士，花海最终得以保全。但我们却没能彻底消灭那些黑渊的信徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570223,
					"content": "为了不让他们趁虚而入，我用「灵光绝唱」的力量封禁了花海与各处遗迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570224,
					"content": "而矫论团也因为这次背叛而元气大伤，传承的典籍焚失一空。在那之后便慢慢变成了现在这幅样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570225,
					"content": "之前听你们说，我便怀疑背后有他们的影子，但没想到这次就连矫论团的首领也成了被他们利用的工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570226,
					"content": "不过那先朱那说的话还是有些令人在意，关于矫论团先辈的事情，祖尔宛应该知道些什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570227,
					"content": "毕竟祖尔宛曾同他们并肩作战。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "呵呵，历史化为传说，传说变为故事，所谓传承究其本质也不过是这样，遗忘原本也是故事的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570229,
					"content": "越是执着于传承的人，便越会去选择记住那些自己想要的故事，最终迷失在故事的迷宫当中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570230,
					"content": "在这不断遗忘的世界中，比起轻飘飘的颂歌，我们在大地上所镌刻下的痕迹，才是更加可靠的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570231,
					"content": "因此我才会相信你们，毕竟你们看起来就像是不会在意什么评价的直率之人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570232,
					"content": "虽然好像是在夸我们，不过不知道为什么听上去感觉怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570233,
					"content": "感觉阴阳怪气的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "前辈根本就是在暗示我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570235,
					"content": "至于五百年前的事情，你们与其再从我这里听到另一个故事，还不如亲身去见证吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570236,
					"content": "恰好如今也正有这样的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570237,
					"content": "说来斯露莎你看上去也可靠了不少嘛，经历了这些也差不多该从那些人类的呓语中清醒过来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570238,
					"content": "前辈！过去的事情就别再提了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570239,
					"content": "#看来拜托{NICKNAME}和派蒙果然有用。这样的话，我也能放心地把完成「祭水之仪」的工作交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570240,
					"content": "「祭水之仪」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "好像之前也听祖尔宛说过吧！我记得是清除什么污秽之类的来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570242,
					"content": "「祭水之仪」是为「万种母树」祓除污秽的仪式，一般情况下只要在镇压黑渊的巨木下举行就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570243,
					"content": "但现在黑渊的封印松动，天空中的异象也再次出现，已经不是光靠普通的仪式就能解决的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570244,
					"content": "本来这个异象之所以会出现在母树之上，便是由于母树吸收了大量污秽的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570245,
					"content": "「万种母树」中积累了太多的污秽，又受到异象的侵蚀，已经无法维持灵光的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570246,
					"content": "现在唯一的办法就是进入到「万种母树」当中，清除掉其中的污秽，唤醒神明大人的神识了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570247,
					"content": "原来可以进到树的里面吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570248,
					"content": "不然难道你们该不会以为「离渡之仪」是要进到那个黑渊里面吗？就算是花灵也没办法承受那样的污秽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570249,
					"content": "寄宿着神识的巨莲「伽乌迦那」就在万种母树当中，只要祓除了污秽，便会重新开出圣洁之花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570250,
					"content": "然后甘露便会洁净整个大地。虽然有些复杂，不过既然是你们的话，应该能够轻松解决吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570251,
					"content": "那么，我已让拉沙鲁和米希尔提前去到「荼泥黑渊」那边了，只要把「灵光绝唱」带过去，便能聚集起灵光的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570252,
					"content": "灵光将会唤醒镇压黑渊的巨木，洁净渊底的污泥。然后就可以举行「离渡之仪」，打开进入「万种母树」的道路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570253,
					"content": "至于古时那些英雄们的伟业，只要进到母树当中，花冠便会向斯露莎显现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570254,
					"content": "毕竟所有与灵光相关的记忆，最后都回归了「万种母树」。无论世间流传的民话如何变迁，这些记忆也不会随之褪色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570255,
					"content": "这种事情我还是第一次听说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570256,
					"content": "呵呵，花冠原本便是母树的一部分，等到时候你就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 732570257,
					"content": "那么，请去熄灭那个「焚真之天象」吧。等到天空降下甘露之时，我们还会见面的。",
