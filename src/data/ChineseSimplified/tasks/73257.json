			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "说来，从遗迹工场出来之后，斯露莎好像一直都没说过话的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570102,
					"content": "明明之前一路上都没停下来过，现在这么安静，都有点不习惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570103,
					"content": "该不会是吓傻了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "打起精神来呀，斯露莎，我们还有很多事情要做呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570107,
					"content": "比如完成那个…就是那个什么很难记的仪式，然后赶紧解决掉那个大窟窿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570108,
					"content": "等所有事情都完成之后，我们去吃好吃的吧，毕竟大家都辛苦了一番呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570109,
					"content": "比如说…唔，不过我也不知道花灵会喜欢吃什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570111,
					"content": "…花灵是不用吃东西的啦，笨飘飘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570112,
					"content": "哎，没想到我竟然有一天会沦落到被白飘飘安慰，这也实在太丢人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570113,
					"content": "简直恨不得现在就被封印到「灰余晶」里面，要不然就找个可以一睡不醒的山洞躲起来，直到认识我的家伙都消失好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570114,
					"content": "说了不许叫我白飘飘，不过真的有这种山洞吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570115,
					"content": "逃避不是解决问题的办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "我已经什么都不想管啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570119,
					"content": "一想到被那先朱那那个家伙耍得团团转的滑稽模样，我就羞耻到受不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570120,
					"content": "反正「灵光绝唱」都已经到手了，你们要想解决那个什么天象的话，就去花海那边找米希尔或者拉沙鲁好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570121,
					"content": "总之不管怎么样还是拜托你们放过我吧，你们之前听到的那些话就当我从来没说过好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570122,
					"content": "唔，虽然你是说过很多奇怪的话啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570123,
					"content": "「我的谒颂主」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "呜啊，求求你不要再说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}，这个时候就别逗斯露莎了啦。毕竟我们一起冒险了这么久，要是半途而废了可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570128,
					"content": "而且，斯露莎也有很厉害的地方吧，比如…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570129,
					"content": "你刚才犹豫了对吧！呜呜呜…别再哄我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570130,
					"content": "比如行动力很强。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "嗯嗯，没错，而且我们不是一直都在为了解决那个天象而努力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570133,
					"content": "能走到这里也都是多亏了斯露莎呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570134,
					"content": "那句话怎么说的来着？啊对，「只要不停下脚步继续前进，成为一名卓越的冒险家也只是时间问题。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570135,
					"content": "真的吗？你们是在真心诚意地夸我的对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570136,
					"content": "这是朋友的夸赞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "嘿嘿，哎呀，该说果然不愧是我嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570138,
					"content": "突然就有动力起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570139,
					"content": "既然斯露莎也有干劲了，那么我们就赶紧去找祖尔宛吧，快点解决掉那个大窟窿拿到报酬，我都迫不及待要大吃一顿了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570131,
					"content": "比如很有责任感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "「英武的身姿」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "「命定的牺牲」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "你还有必须要做的事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "虽然好像是有这么回事啦，不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570104,
					"content": "毕竟经历了这种事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "也许她只是累了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
