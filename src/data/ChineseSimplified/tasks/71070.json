	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "啊，你来了。多谢你帮我们打通了道路，志琼为了给我们开路，也帮了很多忙。我们都很感谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700102,
					"content": "关于营地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "怎么样，还不错吧？老本行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700104,
					"content": "我从十几岁开始，就跟着老爹学习这些了…如何搭建营地，如何制作晶石灯，如何维护矿具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700105,
					"content": "学着学着，他就老了…后来老爹眼睛不行了，矿上的安全设备就都由我来维护了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700106,
					"content": "再然后，你看…我岁数也不小了。剩下的日子没什么好说啦…有了男人，男人没了，生了闺女，闺女去须弥上学了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700107,
					"content": "有时候，矿上的男人去得早，留下的小孩子们也都由我揽下来照顾…身上就总是带着些小甜食什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700108,
					"content": "所以呀…在我的印象里，小孩子总是带着甜甜的气味，眼巴巴地等在地面上，等着我们的糖瓜，或者好看的小石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700109,
					"content": "哇…所以瑾武姐现在也带着糖果吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710700110,
					"content": "糖果呀？嗯…城里那种花里胡哨的糖果没有咯。不过你也不要嫌弃砂糖块呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700111,
					"content": "原来是这种糖呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710700112,
					"content": "身边的人来来去去，留下的只有挂念，在这里陪着我。哈哈，还有你们这些下矿的冒险家们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700113,
					"content": "关于志琼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "志琼是矿上的新生代，明蕴镇出生的。其实层岩巨渊里有经验的矿工都是明蕴镇来的…志琼没赶上好时候吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700115,
					"content": "啊…不要误会，我不是说现在日子过得不好。我的意思是，明蕴镇好些年前因为矿产枯竭，已经停产了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700116,
					"content": "志琼后来来了层岩巨渊，层岩巨渊也出事停产了…这孩子可能天生不适合做矿工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700117,
					"content": "这…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "后来嘛，大家各寻生路，我继续留在矿坑——撤离后留下的设备还要维护嘛。她就去做了冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700119,
					"content": "这孩子总是长不大，一点也不爱惜自己。还是在矿下做工的日子太少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700120,
					"content": "如果她能够习惯矿工的生活，如果她也以自己的双手拯救过那些身陷危险的人…恐怕会对生命有更深的认识吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700121,
					"content": "虽然不是什么像样的请求…我希望你能多盯着她一点，可别让她把自己害死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700122,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "嗯，保重安全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
							"2"
						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克里托夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "你好！旅途如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701702,
					"content": "还好，你过得如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "感谢你给的机会，自从调配炮弹引信成功以后，大家都愿意接受我留在这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701704,
					"content": "至于上到地面之后的打算嘛…哈哈，还没想好！反正大概是不会做盗宝团啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701705,
					"content": "大概…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "肯定不会，肯定不会啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701708,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "保重！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701706,
					"content": "真的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "这家伙…唉…啊？啊，你好。抱歉，你打扰到我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701802,
					"content": "那我们算是扯平了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "好了，不要和我逗闷子了。现在我们的情况很不妙，你知道吗？很不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701805,
					"content": "你也看到那块发光的晶石碎片了，对吧？据我猜测，在更深处应该还有一块更大的…我猜你也早就预料到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701806,
					"content": "理论上说，当上面那块碎片「回归」之后，能量读数应该是趋于稳定的…嗯，事实也是这样。但…波形完全不对…完全不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701807,
					"content": "你在说什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "没怎么上过学，嗯？好吧…简单来说。我们正在面临着两种强大力量的斗争，就像石磨上的豆子一样，明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701810,
					"content": "在更大的时间尺度上，我们正在被来自上面和下面的两种力量，急速磨成豆浆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701811,
					"content": "不信的话就等着瞧吧，那个叫志琼的冒险家…我见过近距离接触过那种东西之后人的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701812,
					"content": "今天她咳血，明天她就有可能把自己的肺组织也一并咳出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701813,
					"content": "我有什么能帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "你？嗯…让我想想，让我想想…给我时间，一定有办法的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701815,
					"content": "不过现在，我们最要紧是需要你继续探索，看看下面究竟发生了什么事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701816,
					"content": "放心吧，我不会放着这么严重的事情不管的…我可得对勘探队员的安全负责，不能让自己的钱白花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701817,
					"content": "你也会对我的安全负责吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "唔…不得不承认，你的能力已经超出了我的预估，所以…既然你完全有能力为自己负责…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701819,
					"content": "唉，算了，不要提那些不知所谓的话了…一旦你出了意外，我也会付出补偿的，好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
