			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔耶芙尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "这个是…嗯，果然是《漂泊的异乡人》的曲谱没错，你们竟然真的找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240902,
					"content": "一定费了一番工夫吧，不愧是了不起的冒险家，相信你们果然没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240903,
					"content": "嘿嘿，不过塔耶芙尔姐姐要拿这个曲谱做什么呢，该不会是想要在欧庇克莱歌剧院演出然后大赚一笔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240904,
					"content": "这个嘛，虽然赚钱也很重要啦，不过我可没打算把这个曲谱私藏起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240905,
					"content": "这些古老的艺术应该是全人类的财富，在完成整部《漂泊的异乡人》的研究后我就会把它们公之于众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240906,
					"content": "复原了失传的剧目，填补艺术史上缺失的一页，难道不是更加了不起的事情吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240907,
					"content": "加油！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "那么，我也该赶紧回去研究这张曲谱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240911,
					"content": "这些是给你们的报酬，我们就有缘再见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240908,
					"content": "别忘了我的贡献。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "那是当然，我会在出版后的扉页上写上你们的名字的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "塔耶芙尔"
				}
			]
		},
