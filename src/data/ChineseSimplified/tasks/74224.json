					"塔耶芙尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "这里的风景还真不错。虽然我们每年要从镇上订购很多乐器，不过以旅客的身份过来还是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240802,
					"content": "关于曲谱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "没事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "就拜托你们咯，在你们回来之前，我会在镇子上静候佳音的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔耶芙尔"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
