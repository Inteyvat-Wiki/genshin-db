			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔耶芙尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "欸？这不是塔耶芙尔姐姐吗？没想到又见面啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240202,
					"content": "啊呀，是你们，冒险家和他的小助手，上次忘记问你们的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240203,
					"content": "#我是派蒙，{M#他}{F#她}是{NICKNAME}。上次多亏了你，我们才成功用「海螺琴」演奏了古代的乐谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240204,
					"content": "不过塔耶芙尔姐姐怎么到佩特莉可镇来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240205,
					"content": "这个问题我也想问你们呢，我可是一听到风声就赶过来了。不过既然你们是冒险家，会捷足先登也是理所当然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240206,
					"content": "风声，你说什么风声啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240207,
					"content": "说到佩特莉可镇，最近最大的新闻不就是那个吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240208,
					"content": "我们一不小心拯救了世界？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "嗯？你在说什么啦，当然是传说中的褪色城堡被再度发现的事情啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240211,
					"content": "上一次有关于褪色城堡的记载还是几百年前的事情，我还以为你们是为了这个才来的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240212,
					"content": "这个嘛，虽然和我们好像是有一些关系啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240213,
					"content": "你们应该知道的吧？褪色城堡曾经属于枫丹历史上最重要的音乐家波爱修斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240214,
					"content": "无论是波爱修斯所创作的歌剧，还是他整理的古雷穆利亚的乐谱，在音乐史上都有着特殊的地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240215,
					"content": "既然是他曾经居住过的城堡，一定保存了大量的资料。这对于我们音乐家协会来说可是重要的文献。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240216,
					"content": "因此一听到这个消息，我就赶紧跑过来了。想着能赶在其它冒险者之前，把重要的文献保存起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240217,
					"content": "没想到还是让你们先了一步呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240218,
					"content": "（怎么办？要不要告诉她，那个波爱修斯其实是个大坏蛋，还利用那些音乐做了一大堆坏事…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240219,
					"content": "（她要是知道了真相，该不会伤心吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240220,
					"content": "「乐章」已经做不了坏事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "嗯？你们在偷偷说些什么呢，该不会你们已经发现什么古代的乐谱了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240223,
					"content": "那个，假如…我是说假如哦，假如波爱修斯是个很坏很坏的人，你们还会想要他留下的什么乐谱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240224,
					"content": "嗯…虽然不知道你说的很坏很坏是什么意思，不过波爱修斯除了音乐外，在历史上也没留下过什么好名声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240225,
					"content": "从他留下的浪漫主义歌剧《漂泊的异乡人》也能看出来吧，直到去世前他都没有放弃重建雷穆利亚，并因此敌视着新生的枫丹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240226,
					"content": "而且根据历史学家的说法，枫丹刚建立时的战乱也与他有关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240227,
					"content": "不过音乐上的成就就是另一回事了，就算他创作的那些音乐有着错误的历史，也无法否定它们在艺术上的价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240228,
					"content": "而且在我看来，这本来也是历史的一部分吧。就算是纯粹的艺术也有可能被用来做坏事，作为音乐家也必须要牢记这一点才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240229,
					"content": "如果是你的话肯定不会用来做坏事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "哈哈，我只是个研究者罢了，能够聆听这些古老的曲调就是我最大的愿望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240233,
					"content": "话说回来，既然这么巧遇上了你们，能不能让你们帮我个忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240234,
					"content": "也算是作为上一次我帮助你们的回报，礼尚往来嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240235,
					"content": "上一次你不是说不用报酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "嘿嘿，那就当是帮帮我咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240240,
					"content": "总之呢，就像刚才说的，我到这里来是为了寻找著名歌剧《漂泊的异乡人》遗失的曲谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240241,
					"content": "根据几百年前一个叫鲁杰罗的人留下的记录，它应该就藏在褪色城堡的某处，如果你们能帮忙找的话那就再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240242,
					"content": "毕竟探索遗迹这种事应该还是你们更专业一些呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME}，既然她都这样说了，我们就帮帮她吧。反正那些乐谱应该都已经没有「那种力量」了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 742240244,
					"content": "嗯嗯，那我就当你们答应了咯，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240245,
					"content": "就拜托你们了，在你们回来之前，我会在镇子上静候佳音的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240237,
					"content": "我可是要收报酬的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "当然会给你们报酬的，我们音乐家协会可不是什么穷酸的组织啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240239,
					"content": "我已经猜到会这样了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "真是了不起的正论。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "嘿嘿，只是我个人的见解啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "塔耶芙尔"
				},
				{
					"id": 742240221,
					"content": "这件事想说清楚也有点困难…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "难道是佩特莉可镇大催眠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
		{
			"id": 7422404,
