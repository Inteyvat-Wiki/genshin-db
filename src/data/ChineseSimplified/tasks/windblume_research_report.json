			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萨义德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "你们已经拍好画片了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000602,
					"content": "全都拍好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "嗯，你拍得很不错，我的研究肯定能用得上这些画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000604,
					"content": "看到这么美的景色…我想起了家乡须弥的节日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000605,
					"content": "须弥有什么节日？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "噢，你应该不知道吧，我们每年都会举办「花神诞日」，用来纪念「小吉祥草王」的诞生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000607,
					"content": "但如果就气氛而言的话，还是和蒙德城的风花节略有差别的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000608,
					"content": "说起来…今年的花神诞日我也没能参加。唉，这么长时间了，也不知道教令院现在是什么情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000609,
					"content": "话说远了，总之感谢你的帮忙，这些报酬请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨义德"
				}
			]
		}
	]
