			"trigger": {
				"objectNames": [
					"萨义德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "多么浪漫的风俗，这才是真正值得研究的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000102,
					"content": "在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "哦，是旅行者啊，你也是对蒙德浪漫的歌谣产生了兴趣，才来到图书馆的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000104,
					"content": "不过，一切文字记录我们随时都能阅读，发生在身边的历史稍不留神就会错过啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000105,
					"content": "在风花节这样浪漫惬意的节日里，蒙德人有许多特别的风俗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000106,
					"content": "这些风俗的形式是怎样的、它们背后的历史如何？诸如此类，都是绝佳的研究方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000107,
					"content": "我正在就此撰写研究报告，只有文字描述当然不行，能请你帮忙给风花节的景观留个影吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000108,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "感谢你协助我的学术研究，旅行者，我会在报告中署上你的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000113,
					"content": "<color=#00E1FFFF>喷泉广场上空的花饰</color>、<color=#00E1FFFF>教堂前用花朵装扮的神像</color>还有<color=#00E1FFFF>忙着售卖花朵的花店店主</color>，这些都值得记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000115,
					"content": "那就麻烦你帮我记录这些景观吧，回头把拍好的画片带给我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000110,
					"content": "你自己去比较好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "不不不，现在我不能走开。我刚刚拟好报告的大纲，如果现在走开，思绪就乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "萨义德"
				},
				{
					"id": 700000112,
					"content": "还是得拜托你，旅行者，虽然不多，但是我会为你准备报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "萨义德"
				}
			]
		},
