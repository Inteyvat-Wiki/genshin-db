			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "欢迎光临「花语」，呼呼，有什么需要了解的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700000402,
					"content": "关于萨义德的画片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "确实，风花节是蒙德特有的节日呢，须弥人的话，应该不会过风花节吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 700000404,
					"content": "要给我和我的花留影？没问题呀，萨义德先生的想法可真特别，学者就是这样吧，呼呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				}
			]
		},
