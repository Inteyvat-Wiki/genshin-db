			"dialogs": [
				{
					"id": 190361601,
					"content": "阁下还没有出发吗？莫非是改变主意了，这样最好哦，和那家伙扯上关系是不明智的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361602,
					"content": "我想知道你和他有什么过节？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "他如果真的永远消失，对我来说就是过节了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361604,
					"content": "（微微一笑，以示礼貌。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "别这样看着我，哈哈，总得允许人有几个看不顺眼的家伙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361606,
					"content": "总之，你还是快点出发比较好，趁鹿野院还没有制造出什么大麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361607,
					"content": "对了，如果真不小心找到了他的遗物什么的，别忘了告诉我，让我开心开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
