			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二",
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "要是那位旅行者也没空，该怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361402,
					"content": "那是你的问题哦，谁让你擅自接下这种麻烦事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361403,
					"content": "哎呀，你真走运，你的救星来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361404,
					"content": "欸？太好了！旅行者你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361405,
					"content": "别担心，我很空。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "这就是说闲人闲人到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361407,
					"content": "社长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361408,
					"content": "跟旅行者比，社长才是闲人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361409,
					"content": "不呀，我很忙的呀。忙着站在这里…要站一整天呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361410,
					"content": "就算是不想接的委托，社长这个借口也太敷衍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361411,
					"content": "不想接的委托？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "对对…这就是麻烦你过来的原因，让我来详细说明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361413,
					"content": "最近，天领奉行的一位重要人士失踪了，既不见人，也没有办法联系上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361414,
					"content": "因为各种原因，天领奉行不方便大张旗鼓地搜寻，所以私下委托了我们寻找这个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361415,
					"content": "他的名字叫作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361416,
					"content": "叫作九条裟罗，这位大将失踪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361417,
					"content": "…要真是那位大将失踪了，还不把稻妻城翻个底朝天，可能会仅仅委托我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361418,
					"content": "旅行者，你别听社长乱说。其实这个失踪者名叫鹿野院平藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361419,
					"content": "他是奉行所的特别侦探，虽然职级只是同心，但本领不小，很受奉行所重视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361420,
					"content": "嗯？本领比我还大吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361421,
					"content": "社长，你不肯帮忙就算了，至少不要添乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361422,
					"content": "不好意思旅行者，虽然我接下这个委托…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361423,
					"content": "但是你也看见了，社长…她不太乐意插手这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361424,
					"content": "因为报酬太少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "脱靶！零分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361427,
					"content": "要问原因的话，那就是我绝不会管那个臭小子的事哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361428,
					"content": "如果有什么是比「鹿野院失踪了」更让人开心的…那只能是「鹿野院失踪了一百年」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361429,
					"content": "咳咳…总之，珊瑚社长和平藏先生，有那么一点点过节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361430,
					"content": "我懂了…同行相轻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "咳咳…你误会了，可能比这还严重一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361432,
					"content": "社长说，平藏先生是她通往真相圣殿的绊脚石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361433,
					"content": "是拦路狗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190361434,
					"content": "唉…虽然平藏先生的个性确实比较…嗯…别致？但他绝对是个好人，他曾经教会了我很多东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361435,
					"content": "所以就算社长不允许，我也不能置之不理。至少可以把委托转交给信任的人，比如说神通广大的旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361436,
					"content": "明白，我是外包。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "啊…不、不是的！那个…天领奉行承诺的报酬当然会全数奉上，另外我个人也再额外补贴一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361439,
					"content": "所以希望旅行者你能够接下这个委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361440,
					"content": "如果平藏先生真的遇险了，我想有你在，他会更安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361441,
					"content": "你跟他很熟吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "其实我们关系很好的，只是珊瑚社长一直要求我跟他保持距离，也不让我公开表现得跟他很熟的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361443,
					"content": "所以一般别人问起，我通常只是说我稍微与鹿野院先生见过几面，今天要不是出了这事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361444,
					"content": "咳咳…还是先不说这个了，能请你帮忙去找找他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361449,
					"content": "了解了，我现在出发。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "嗯，差不多就这些了。请收好奉行所的委托书，如果找到了平藏先生，直接回奉行所回报就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361445,
					"content": "没问题，但我需要更多信息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "太好了！我们得知平藏先生在失踪前对海祇岛很有兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361447,
					"content": "战争期间，他似乎在海祇岛执行过任务。战争结束后，他也曾频繁往返海祇岛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361448,
					"content": "我听说旅行者你跟珊瑚宫关系匪浅，我想，或许可以把那里当作调查的起点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361437,
					"content": "明白，你是二道贩子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "因为线索太少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "旅行者，请你快些出发吧，希望平藏先生不要遇到危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361502,
					"content": "再跟我说说这个鹿野院平藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "平藏先生吗？他是个充满生命力的人！话很多，人也活泼，精力旺盛，从来没见过他停滞不前的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361504,
					"content": "社长总说他就像只嗡嗡飞的苍蝇，一定是因为他能够准确找到每一只裂了缝的蛋吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361505,
					"content": "这样说的话，我想平藏先生可能还不仅是普通苍蝇，他应该是只高级苍蝇呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361506,
					"content": "就算把他的鼻子堵住，眼睛蒙住，耳朵遮住，他依然能准确找到蛋壳上的裂缝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361507,
					"content": "很神奇吧，好像他依靠的是一种五感之外的东西，第六感？直觉？神明的援手？还是别的什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361508,
					"content": "这个比喻很清新，下次不要再比了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "啊，社长总说我不会说话，看来果然是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 190361510,
					"content": "这个比喻烂透了，我还想再听一些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "咳咳…要不改天再聊吧…社长在盯着我们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				}
			]
		},
