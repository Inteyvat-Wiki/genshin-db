			"dialogs": [
				{
					"id": 111130801,
					"content": "哇，这上面居然有我们五个人的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130802
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130802,
					"content": "嘿嘿，真好。对了，刚刚听你说每一年都会放灯，那以后上面的名字会不会越来越多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130803
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130803,
					"content": "比如，小五的孩子，木木的妻子之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130804
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130804,
					"content": "其实确实有个好消息，木木他马上就要当爸爸了，最近总是在说这件事，好像既开心又紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130805,
					"content": "哈哈哈，他这么木讷的人，能当好爸爸吗？",
