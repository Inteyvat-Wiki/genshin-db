				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130701,
					"content": "狼哥，现在你应该很满足了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130702
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130702,
					"content": "如果以后再动了什么歪念头，真的变成恶鬼，我可是会不念旧情直接消灭你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130703
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130703,
					"content": "不会的，不会的，你们为我做了这么多，我已经心满意足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130704
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130704,
					"content": "知道大家过得都很好，我也不想打扰他们的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130705
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130705,
					"content": "我也要谢谢你们，这也算是圆了我的一场梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130706
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130706,
					"content": "那刚刚的话也送给你，老孟，要是在这之后还念念不舍，我就提前一点送你们团聚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130707
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130707,
					"content": "不、不会的…不要笑着说这么可怕的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130708
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130708,
					"content": "哈哈哈。那么，最后的最后，每人都给狼哥送上一句告别吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130709
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130709,
					"content": "再见啦，狼哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130710,
					"content": "不对不对，不能再见，最多是「慢走」之类的说法，可不能「再见」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130711
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130711,
					"content": "哈哈哈，没关系，我安静离开就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130712
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130712,
					"content": "抱歉啊，只有我们当时喊出来的梦想，没办法实现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130713
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130713,
					"content": "没关系，总会有遗憾的，你就安心上路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130714
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130714,
					"content": "嗯，我会记住大家的，各位再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130715
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111130715,
					"content": "走掉了，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130716
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130716,
					"content": "就像是了结了人生中的一件大事，还是觉得心里空荡荡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130717
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130717,
					"content": "所以，之前没有听到，你们两个人的愿望是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130718,
					"content": "「成家立业之后，两家人一起过海灯节。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130719
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130719,
					"content": "所以我很羡慕我的朋友们，小五他们都还有机会实现梦想，但是我的梦想，终究是没有机会了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130720,
						111130721
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130720,
					"content": "想开一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				},
				{
					"id": 111130722,
					"content": "对嘛对嘛，而且你这么想，谁都会有被烧掉的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130723
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130723,
					"content": "活着的时候好好活着，当活着的职责履行完了，你还能见到你想见的人，不也是一件好事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130724
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130724,
					"content": "呃…谢、谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130725
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130725,
					"content": "总之，我以后应该再也不会回无妄坡了，我也需要好好收拾收拾我的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130726
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111130726,
					"content": "没关系，那就趁这个机会出去玩玩吧，我准假了。啊，当然和现在一样，是没有工钱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130727
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130727,
					"content": "不过，好像是不是忘了一件什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130728,
					"content": "说好的「找人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130729
					]
				},
				{
					"id": 111130729,
					"content": "嗯？带你们去了「边界」，也是想让你们找找看啊。不过，看你们的反应，应该是没找到，可惜可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130730
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130730,
					"content": "才不可惜呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130731,
					"content": "哈哈哈，我也帮你们找了找，用了些你们不用知道的办法。可惜我也没找到什么值得追查的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130732
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130732,
					"content": "之后我会帮你留意这方面的线索的，一旦有什么消息会直接来找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130733
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130733,
					"content": "感觉你只是随便说说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130734,
					"content": "嘿嘿，毕竟找活人不是我擅长的事嘛，如果让我找的是「边界」另一边的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130735
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130735,
					"content": "不要再说可怕的话了——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130736,
					"content": "放心放心，会帮你们好好找那个活人的。真是的，什么时候才能听得懂我的玩笑话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130737,
						111130738
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130737,
					"content": "感觉你很享受这份工作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130739,
					"content": "哈哈…我也有我的理由啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130740
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130740,
					"content": "理由？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130741,
					"content": "今天我们去的地方，能见到的，都是对生者世界尚有执念的死者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130742
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130742,
					"content": "可是在那里，我从来没见过历代「堂主」…一次都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130743
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130743,
					"content": "那就说明，成为往生堂的堂主，一定是非常正确，而且绝对不会留下遗憾的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130738,
					"content": "感觉你很适合当堂主。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130721,
					"content": "人生还长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				}
			]
		},
