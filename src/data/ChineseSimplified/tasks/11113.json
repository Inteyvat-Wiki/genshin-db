			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130601,
					"content": "终于过来了，我还以为我们被困在了诡异的空间里面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130602,
					"content": "就是要给人这样的感觉，才能把擅闯者吓跑嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130603
					]
				},
				{
					"id": 111130603,
					"content": "之后应该不会再有什么古怪的东西了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111130604,
					"content": "嗯，只需要从前面跳下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130605
					]
				},
				{
					"id": 111130605,
					"content": "欸欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1111307,
			"completionStepIds": [
				1111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111307",
