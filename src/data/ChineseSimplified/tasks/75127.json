				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "哎呀，您也是来这里留影的吧。之前就有外国的旅客过来，想要在这里留影，毕竟海面上的浮岛是很好的景色呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 751270102,
					"content": "可惜之前没有留影机，我可是特地托认识的外国商人弄来了一台嘞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 751270103,
					"content": "怎么样，客人，要不要试试拍张画片？不过得您自己动手，我拍照的技术可不怎么样呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 751270104,
					"content": "奇怪，海面上的雾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "海面上的雾？客人你在说什么呀，这里海风可大咧，哪会有雾啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 751270106,
					"content": "从我出生到现在，可还没看到过海上有雾嘞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 751270107,
					"content": "客人不会是把这里和镜璧山下那些全是雾的地方搞混了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 751270108,
					"content": "大概吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "嘿嘿，要我说呀，客人你就是太紧张了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "萨卡乌"
				},
				{
					"id": 751270110,
					"content": "来纳塔旅游，还是要放松一些才行呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萨卡乌"
				}
			]
		}
	]
