				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900101,
					"content": "芭芭拉小姐，我们回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900102,
					"content": "欢迎回来，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900103
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900103,
					"content": "琴好些了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900104
					]
				},
				{
					"id": 4900104,
					"content": "芭芭拉小姐也辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900105
					]
				},
				{
					"id": 4900105,
					"content": "没关系，照看病患本来就是我的日常工作之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900106
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900106,
					"content": "琴已经恢复意识了哦，只是身体还稍微有些虚弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900107
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900107,
					"content": "真的吗！那可真是好消息，让我们去看看她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900108,
					"content": "不过她刚刚已经离开教堂了呢，明明都和她说了还要再休息一段时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900109
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900109,
					"content": "…可琴还是硬撑起一副没关系的样子，执意要出去走走。估计又去<color=#00E1FFFF>温妮莎大人那里</color>了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900110
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900110,
					"content": "「温妮莎大人那里」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900111,
					"content": "啊，我是说大英雄温妮莎的象征，<color=#00E1FFFF>风起地的那棵大树</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900112
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900112,
					"content": "每当琴感觉迷茫的时候，都会去那里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900113
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900113,
					"content": "芭芭拉小姐对琴团长的事真是了解，连这样的事都能猜到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900114,
					"content": "…只是、只是琴离开前自己说的而已啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900115
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900115,
					"content": "琴的身体还很虚弱吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900116
					]
				},
				{
					"id": 4900116,
					"content": "她自己这样出城去没关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900117
					]
				},
				{
					"id": 4900117,
					"content": "我也很担心她。可我在这边还有工作要做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900118
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4900118,
					"content": "明白啦，就由我们两个去护卫病患的安全吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900119,
					"content": "嗯！那样我也就能放心了，愿风神护佑你们…和琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
		{
			"id": 49003,
			"completionStepIds": [
				49003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"49003",
							"2"
						],
						"stepId": 49003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900301,
					"content": "琴小姐，你的身体没关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900302,
					"content": "嗯，我已经没事了。真没想到你们会到这里来，谢谢你们的关心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900303
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900303,
					"content": "真的吗？可是刚才看见琴的背影…感觉还是很疲惫的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900305,
					"content": "可以多依靠一下骑士团的大家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900306
					]
				},
				{
					"id": 4900306,
					"content": "可以多依靠一下我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900307
					]
				},
				{
					"id": 4900304,
					"content": "是不是有些太过勉强自己了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900307,
					"content": "啊…你们的这份心意，就足够让我恢复精神了，非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900308
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900308,
					"content": "可是如果连这点程度都无法独自应付的话，又怎么能像温妮莎大人那样守护整个蒙德呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900309
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900309,
					"content": "琴真的很憧憬温妮莎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900310,
					"content": "嗯，最初的骑士团长，温妮莎大人，是位温柔而又坚强的人，我一直在追寻着她的脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900311
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900311,
					"content": "以「狮牙骑士」的勇武推翻旧贵族，又作为「蒲公英骑士」建立西风骑士团，将恩泽遍及蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900312
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900312,
					"content": "「蒲公英骑士」…那不是说琴的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900313,
					"content": "不论「蒲公英骑士」还是「狮牙骑士」，都是历代骑士团长沿袭下来的称谓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900314
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900314,
					"content": "原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900315,
					"content": "那么现在的琴既是听起来很温柔的「蒲公英骑士」，又是听起来很威风的「狮牙骑士」咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900316,
					"content": "是的，继承温妮莎大人的名号虽然十分荣幸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900317
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900317,
					"content": "但对我来说，可能更多是意味着责任吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900318
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900319,
					"content": "「狮牙骑士」也很适合琴呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900320
					]
				},
				{
					"id": 4900320,
					"content": "还是「蒲公英骑士」更适合琴一些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900321
					]
				},
				{
					"id": 4900318,
					"content": "毕竟，要有配得上它们的「坚强」才行呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900319
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900321,
					"content": "说得没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900323
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900323,
					"content": "琴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4900324,
					"content": "谁在那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900325
					],
					"speakerTitle": "琴"
				},
				{
					"id": 4900326,
					"content": "哼哼哼…还是被发现了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
