			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "没想到我们竟然会遇上作战计划泄露这种事，真是晦气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740202,
					"content": "是啊，老师突然接到命令回至冬国了，可海祇岛的计划却还要继续进行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740203,
					"content": "老师会不会太独断专行了？这个任务他没向「仆人」大人汇报过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740204,
					"content": "这确实是老师一个人的主意。啧，我有种不好的预感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740205,
					"content": "你是说，如果我们失败，老师就会把责任都甩在我们头上吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人众先遣队"
				}
			]
		}
	]
