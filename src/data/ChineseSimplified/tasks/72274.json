				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "看来这个地方果然不简单…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722740111,
					"content": "嘘——你听，那边好像有人说话的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722740101,
					"content": "啧，没想到那个女人嘴可真够紧的，竟然一个字都不说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740102,
					"content": "大人别担心，拷问什么的咱可是最擅长了！您先歇歇，等会咱们再到地下的牢房去收拾她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740103,
					"content": "时间不多了，老师要我们赶快问出她到底对计划知道多少。要是问不出来，我们也要跟着遭殃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740104,
					"content": "哎呀，那位大人的脾气可真是可怕。这个女人到底干了什么，害他这么光火？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740105,
					"content": "老师最近的计划里，有个重要的棋子叫柳达希卡，可这个终末番的女人，竟然把柳达希卡给干掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740106,
					"content": "幸好我们冲进去的时候，火还没熄灭。不愧是老师，一下子就从服装上认出了柳达希卡，意识到计划可能存在风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740107,
					"content": "那真是不幸中的万幸哩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740108,
					"content": "但谁知道这个女人对计划了解到什么程度，又会不会已经把事情告诉了终末番的其他人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "愚人众先遣队"
				},
				{
					"id": 722740109,
					"content": "看来百代小姐就被关在地下的牢房里，我们快去救她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
