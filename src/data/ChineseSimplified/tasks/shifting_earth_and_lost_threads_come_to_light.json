			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "呀，脚印！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220202,
					"content": "看来他们穿过了灵矩关，继续向前步行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220203,
					"content": "跟着脚印就能找到他们的去处了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小玲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "请问你在这附近见过矿工打扮的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220402,
					"content": "大约是四五天前吧，有几个人从这里走过，背着篓子，提着铁镐什么的…和你说的差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220403,
					"content": "对对，就是他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220404,
					"content": "四五天前？看来他们走得远不如我们想象中快，恐怕是被灵矩关的地形耗去了不少时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220405,
					"content": "哎呀，那些人可奇怪了，四个大男人，个个面色呆滞，都像没睡醒一样！前面还有个小孩，晃晃悠悠的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220406,
					"content": "你看清那个小孩的模样了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220407,
					"content": "只扫了一眼，蓝色头发，个子很矮，好像…好像是个女孩儿！还有，她表情也很严肃，一点笑意都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220408,
					"content": "他们走的是这条路吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220409,
					"content": "是啊，从这儿一直往前走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220410,
					"content": "我们追吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琬玉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "这些怪物太暴躁了，只是走过都会被它们发现，二话不说就往人身上扑…多亏各位救了我，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220702,
					"content": "我叫琬玉，隶属于璃月盛露厅，负责人文古迹的研究工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220703,
					"content": "哎呀？不是矿工…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220704,
					"content": "矿工？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220705,
					"content": "嗯，我们在找矿工，一共四个！都是个子高高大大的男性，带着采矿工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220706,
					"content": "你说的人，我好像见过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220707,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220708,
					"content": "对，我是前天从南天门出发的，要往灵矩关方向去。半路上遇到一队人，是一个小孩和几个大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220709,
					"content": "能说得详细一点吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "我走得比较急，没能细看。面貌特征什么的都记不清了…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220711,
					"content": "这些就足够了，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220712,
					"content": "能帮上忙就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220713,
					"content": "那我就先走一步了，还有学术会议要参加，再次感谢几位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220714,
					"content": "根据那位学者的说法，这些人应该是往南天门方向去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220715,
					"content": "不过，能确定是同一批人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220716,
					"content": "小孩跟大人的组合，没那么常见吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220717,
					"content": "还是挺常见的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "呃…那、那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220719,
					"content": "喂，你们看那边那块石头！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220720,
					"content": "哦哦，还有这一招呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220721,
					"content": "应该能用，我来试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220722,
					"content": "唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220723,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220724,
					"content": "没错，是同一批人。他们沿着这条路走过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220725,
					"content": "昆兄读取石块回忆的场面，无论看几次都觉得有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220726,
					"content": "这所谓的本事，平时还真用不上。能让钟离先生消遣，也算有些意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220727,
					"content": "小昆简直是我们的指南针！有你在，才好确定方向呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220728,
					"content": "哈哈哈哈，是吗？那我也就不枉来此一遭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220729,
					"content": "嗯，这感觉…像在办案一样，好有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220730,
					"content": "有趣之余，别忘了保持警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220731,
					"content": "四名成年人面容呆滞地跟着一个孩童日夜赶路，翻山越岭…此事绝不简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220732,
					"content": "噢噢！说得也是，钟离先生当真谨慎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220733,
					"content": "另外，刚才那位学者是被幼岩龙蜥袭击了，但这种怪物不该有这么强的攻击性才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220734,
					"content": "一路走来诸多线索，冥冥之中似乎都有联系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220735,
					"content": "工人们是前天往南天门方向去的。从这里过去，要经过一段艰险的山路。假如他们的目的地就是南天门，我们应该还能赶上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220736,
					"content": "嗯，马上出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220737,
					"content": "方才我在附近做了记号，万一老戴追来，也能循着记号找到我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220738,
					"content": "不愧是钟离！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
