			"dialogs": [
				{
					"id": 111229901,
					"content": "等等，地上有线索！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111229902,
					"content": "一定是那些矿工留下的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111229903,
					"content": "我们到灵矩关出口去。如果那里没有脚印，就说明他们还在灵矩关内，如果有新线索，就继续追查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
