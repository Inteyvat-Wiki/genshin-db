			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"矿工"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "旁边还落着背篓…他确实是矿工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220803,
					"content": "喂，喂，能听见我说话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220804,
					"content": "看他的样子，应该是筋疲力尽才昏倒在此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220805,
					"content": "要叫醒他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220806,
					"content": "我还能…能挖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "矿工"
				},
				{
					"id": 111220807,
					"content": "嗯？嘴里嘀咕着什么东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220808,
					"content": "一直在挣扎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "如此执着，实在反常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220811,
					"content": "附近有个营地，先带他到那里安顿下来，再做打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220809,
					"content": "很想站起来的样子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220902,
					"content": "怎么样？他不会死吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220903,
					"content": "他是劳累过度，陷入了昏迷。幸好，没有性命之忧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220904,
					"content": "他怎么会累成这样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "我刚才听见他在念叨，说要挖什么东西，所以他是挖累了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220906,
					"content": "不无可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220907,
					"content": "好奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "嗯？他口袋里好像有什么东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220910,
					"content": "这是…矿石的碎片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220911,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220912,
					"content": "各位，我看了他口袋中矿石碎片的记忆。这些碎片是这个人从矿区带出来的，可见此人确实是我们要找的四名矿工之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220913,
					"content": "那他会倒在这里，就更有意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220914,
					"content": "被人带走，然后…被丢弃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220915,
					"content": "可既然要丢掉他，又为什么要把他一路带到这里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220916,
					"content": "除非发生了什么事，让他不得不掉队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220917,
					"content": "唔…唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220918,
					"content": "不行，太神秘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220919,
					"content": "啊，对了！看到这些碎片才想起来，我也有些东西要送给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220920,
					"content": "什么什么，有礼物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220921,
					"content": "送给我们？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220922,
					"content": "不瞒你们说，与老戴会合之前我总是犯迷糊，和你们一起查案，思路才变得清晰起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220923,
					"content": "我一直在偷偷庆幸老戴还找了你们几位帮忙。要是没有你们，只凭我一人，恐怕没办法查到这么多线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220924,
					"content": "这些是我从集市淘来的水晶，别看它只是水晶，成色可是极其罕见的！一人一块，就当留个纪念吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220925,
					"content": "好漂亮的水晶啊，颜色还会变！这样看，那样看…感觉都不一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220926,
					"content": "看起来非常贵重…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "别客气，拿着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220929,
					"content": "这块给钟离先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220930,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220931,
					"content": "咦？怎、怎么了，不喜欢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220932,
					"content": "不，怎么会。只是没想到，会在这样的时刻收到礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220933,
					"content": "多谢，我会好好保管的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220934,
					"content": "谢谢你们愿意收下。好的礼物送给识货的朋友才有意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220935,
					"content": "我看这一带也有不少石块，你们先休息吧，我去周围逛逛，顺便摸摸石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220936,
					"content": "小昆还真是喜欢石头啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220937,
					"content": "矿石是大地的结晶，时间的沉淀。和它们在一起，我会觉得安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220938,
					"content": "你们慢慢休息，出发前叫我一声。我就在附近，不会走远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "昆钧"
				},
				{
					"id": 111220939,
					"content": "他一个人不要紧吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "不用担心，我刚才看过周围，没有其他危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220941,
					"content": "对了，我有话要跟你说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220942,
					"content": "唔？神情有些严肃哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220943,
					"content": "旅行者，关于「镇龙石」，你有什么印象吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220944,
					"content": "没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "是他找的那种矿石对吧，有什么特别之处吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220946,
					"content": "镇龙石是一种罕见的锻造用矿石。常见的水晶多数是在高温环境下自然形成，镇龙石却是元素反应引发的结晶成品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220947,
					"content": "元素反应能产生实物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220948,
					"content": "可以。不过，只有很少一部分能被长久保存下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220949,
					"content": "镇龙石诞生于千百年前的一场大战。强烈的元素力碰撞导致元素结晶，战斗结束后，这些石头奇迹般留存了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220950,
					"content": "居然是这样啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220951,
					"content": "但它毕竟是结晶造物，数量很少，知名度也不高。再者，早在几百年前它就被开采殆尽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220952,
					"content": "现代的璃月人，为什么要找早已不存在的矿石？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220953,
					"content": "对哦！如果他能知道这种石头的存在，不就更应该知道它被人采光了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220954,
					"content": "好奇怪…完全说不通…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220955,
					"content": "矿业相关的工作者里，也有一些对镇龙石感兴趣的人。但像昆兄这样说不出缘由却要找石头的…十分少见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220956,
					"content": "或许他是另有来意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "另有来意…是坏人吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111220958,
					"content": "现在很难定论，不如先静观其变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220959,
					"content": "别忘了，眼下最主要的目的是救回那些矿工。至于其他，早晚也会水落石出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220960,
					"content": "与目标的距离正在缩短。我想，我们应该沿这条路继续走，能找到其中一个，就能找到剩下的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220961,
					"content": "等你休息完毕，请你叫上昆兄，我们继续追查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220962,
					"content": "至于这位工人，可以先安置在营地内，等解决了事件，再回来照看他。给老戴留张字条，万一他找来也能及时处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 111220927,
					"content": "真的可以给我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "他不是被带走了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
