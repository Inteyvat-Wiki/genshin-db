			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "你们看，是神里小姐和旅行者来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "由宇"
				},
				{
					"id": 736880302,
					"content": "虽然之前在小说的插图里见过这套服装，但穿在神里小姐身上，却有种很独特的风采。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "纱江"
				},
				{
					"id": 736880303,
					"content": "不枉我一大早就来排队，抢到了表演赛第一排的位置，今天的比赛一定会很精彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "松前"
				},
				{
					"id": 736880304,
					"content": "哇，果然绫华一出现，就成为大家的注目焦点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880305,
					"content": "各位观众，请大家安静，「演武传心」表演赛马上就要开始了，请各位有序进入赛场入座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880306,
					"content": "神里小姐，旅行者，你们二位也请跟我一起进去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880307,
					"content": "旅行者，你准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880308,
					"content": "没问题，我们走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "好，接下来的战斗，就请你多关照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880310,
					"content": "我还需要再准备一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "别着急，现在还有些时间，等你一切处理妥当，我们再一起进入赛场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#{NICKNAME}，绫华，我们在这里呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880402,
					"content": "真是一场精彩的比赛，即使我不怎么懂剑术，也完全被赛场上紧张的气氛感染了，都过了这么久，心脏还在扑通扑通直跳呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880403,
					"content": "是呀，好几次敌人的出招都吓了我一大跳，但你们两个却像是早有防备似的，一下子就轻松化解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880404,
					"content": "旅行者，神里小姐，祝贺你们获得了表演赛的胜利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 736880405,
					"content": "哇，是裟罗，原来你也来看比赛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880406,
					"content": "我奉将军大人之命，前来见证这场赛事。二位剑术精湛，配合默契，不仅向观众们展现了剑道之美，也让我受教良多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 736880407,
					"content": "您过奖了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880408,
					"content": "几位从赛事筹备之初就在不停奔忙，今天又为演武传心划上了完美的句号，这些付出将军大人都看在眼里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 736880409,
					"content": "接下来，我会回天守阁，向将军大人如实禀报这次表演赛的情况。诸位，我就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "九条裟罗"
				},
				{
					"id": 736880411,
					"content": "对了，大家接下来有什么打算，不如到乌有亭去开庆功宴怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880412,
					"content": "太好啦！这些天每天都在想比赛的事，好久没有好好吃顿饭了！我们快走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880413,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880414,
					"content": "怎么了，绫华？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "没什么，只是现在我才渐渐有了一些赢得比赛的实感。九条裟罗小姐刚才说，这场比赛让她受教良多，其实我也是一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880416,
					"content": "虽然旁人在台下可能没有察觉，但我知道，刚才很多次我能够化险为夷，都是因为有你在旁边，适时引开了对手的攻击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880417,
					"content": "如果没有你在身边，仅凭我一个人，肯定是无法取得胜利的。果然在剑术的造诣上，我还远远比不上你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880418,
					"content": "绫华也帮了我很多次。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "真的吗？听你这么说，现在突然很想和你比一场了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880421,
					"content": "不瞒你说，自从我认识你以来，就一直希望能有机会和你好好切磋武艺。今天在表演赛上，这个愿望大概算是实现了一半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880422,
					"content": "下次找个时间，让我们一决胜负。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "好。但…在此之前，你要好好保管好自己的佩剑哦？如果哪天被我偷走了，你的性命，也就交到我的手上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880424,
					"content": "嘿嘿…我一直很想说说看这种句子，应该不会很奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880425,
					"content": "很像奥西兹小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "喂，你们两个人走得那么慢，又凑在一起说什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880428,
					"content": "我们刚才说，要找个时间来比赛一场，看看我们谁的剑术更胜一筹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880429,
					"content": "#哇，绫华对剑术的事好认真啊。不过你和{NICKNAME}不是朋友吗，竟然还要比啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880430,
					"content": "正因为是朋友，才应经常切磋，互相勉励才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880431,
					"content": "喔，这么一说还挺有道理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880432,
					"content": "旅行者，刚刚的话，替我保密哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880433,
					"content": "嗯？绫华你刚刚说了什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880434,
					"content": "没什么，我们赶快走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880426,
					"content": "很可爱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "绫华过分谦虚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
