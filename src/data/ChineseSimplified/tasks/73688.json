			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "阁下武艺精湛，这场较量在下输得心服口服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "晓月左卫门十藏"
				},
				{
					"id": 736880102,
					"content": "承让了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#各位观众，经过刚才令人热血沸腾的一战，本届「演武传心剑道大赛」的冠军已经产生，那就是——{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880104,
					"content": "#明天，我们将迎来最后的表演赛环节：由{NICKNAME}与神里小姐一起，迎战将军大人的特使，人形机关剑士「魔偶剑豪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880105,
					"content": "各位，我们届时不见不散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "玲菜"
				},
				{
					"id": 736880106,
					"content": "旅行者，真是一场精彩的比赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880107,
					"content": "恭喜你旅行者，这个冠军颁给你的确是实至名归。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880108,
					"content": "只是没想到明天的对手竟然是「魔偶剑豪」，这个名字听起来和我们在八酝岛野外遇到的那个家伙很像，总感觉不太好对付呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880109,
					"content": "派蒙不用担心，虽然特使的实力强劲，但明天的比赛并不限制使用神之眼，我们还是拿回了一些主动权。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880110,
					"content": "而且，只要我们见招拆招，总能找到还击的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880111,
					"content": "绫华这么说我就放心多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880112,
					"content": "最终能不能取胜，我其实也并无把握。但只有尽全力战斗，才能为观众们呈现出最精彩的表演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880113,
					"content": "我们一定能获胜的，绫华。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "你们两个可真有干劲呢，那今天晚上可要好好休息，养精蓄锐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880116,
					"content": "嗯，明天一觉醒来就能看到绫华的新衣服了。穿着枫丹服饰的绫华…哎呀，好期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880117,
					"content": "唔，这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880118,
					"content": "我也是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "怎么旅行者你也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880121,
					"content": "#好啦绫华小姐，你就满足{M#他们}{F#她们}的期待吧，如果不是因为明天我有事在身，我都想一起来看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736880122,
					"content": "嗯，那就这样说好了。明天早上，我在神里屋敷等你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880120,
					"content": "需要我来接你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "我们一定能奉献一场精彩的比赛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏达",
					"神里绫华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "二位，你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880202,
					"content": "呃啊，竟然是宏达！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880203,
					"content": "#前几天的比赛{NICKNAME}已经赢了你，而且还拿了冠军，你现在还有什么话说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880204,
					"content": "请放心，我并非是来挑剔二位的，而是来道歉的。旅行者，几天前与你的一战，我输得心服口服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880205,
					"content": "阁下剑术精湛，出招犀利却不咄咄逼人，足见品性。之前我错判了阁下的为人，言行对你多有冒犯，还请你见谅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880206,
					"content": "没关系，我并不在意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "二位今天是来接神里小姐的吧？小姐现在正在室内整理着装，应该很快就会出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880209,
					"content": "旅行者，趁小姐来之前，我有个不情之请，希望您能答应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880210,
					"content": "好的，请讲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "小姐她虽然从没有对我们这些家臣提过今天的表演赛，但最近小姐每天无论多忙，晚上一定会抽出几个时辰练习剑术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880212,
					"content": "小姐向来勤勉认真，虽说今天是表演赛，不取胜也无妨，但按照小姐的心性，一定会全力以赴，忘我奋战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880213,
					"content": "身为家臣，我当然相信小姐的实力，只不过…还是希望你能在赛场上支援小姐，保护小姐的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880214,
					"content": "请放心吧，我一定会的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "旅行者，那小姐就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880217,
					"content": "喔，应该是绫华出来了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880218,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880219,
					"content": "咦，怎么了，你们两个都这样一言不发…是这身装扮有哪里不妥吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880220,
					"content": "不是的！绫华，你这样真好看…有种眼前一亮的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880221,
					"content": "这个造型很适合你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "对呀对呀，看起来就像是枫丹的大小姐，气质也活泼了不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880223,
					"content": "真的吗？我还担心会不会有点过于俏皮…我不一定能驾驭住这种风格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880224,
					"content": "不过既然你们都觉得还不错，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880229,
					"content": "嘻嘻，待会儿大家看到绫华的时候，一定也会觉得很惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880230,
					"content": "谢谢你的夸奖，派蒙。旅行者，既然已经准备妥当，我们就出发去赛场吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880231,
					"content": "小姐，旅行者，请慢走。祝你们表演赛一切顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏达"
				},
				{
					"id": 736880225,
					"content": "很漂亮的服装，非常合身。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "对呀对呀，仔细看的话，在裙摆上还绣上了你们神里家的椿纹呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736880227,
					"content": "嗯，这是小野寺先生他们在这几天里找人赶制出来的，听说是根据观众们写在投票上的建议加上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880228,
					"content": "这套衣服裁剪得非常合身，活动起来也比想象中要自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 736880207,
					"content": "和你那场战斗我也很尽兴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
