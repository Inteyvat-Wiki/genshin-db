			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库蕾玛娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "一十、二十…卖了这么多钱，最近的经费应该是足够了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940502,
					"content": "不再多挣点了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "哈哈，不挣啦，见好就收！要不是你不计较我的小心思，帮了我一把，我恐怕早就因为那几块玉惹上大麻烦啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940504,
					"content": "再说了，每天只盯着钱很没意思的，对我而言挣钱只是爱好，观察火山才是生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940505,
					"content": "钱没了可以再挣，可万一因为我们这帮人的疏忽，导致对火山喷发没有预警，那可就得不偿失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940506,
					"content": "「话事处」不给你们经费吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "我们没去申请。毕竟，平时的各种事务已经足够让「话事处」和首领们焦头烂额了，怎么能这个时候再去给他们增添负担呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940508,
					"content": "而我和我的旅伴就不一样了。平时，我们这群人也是一边各处旅行一边赚旅费的，早就习惯了这种生活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940509,
					"content": "在旅行中顺便观察一下火山也不是什么难事，就像你们经常顺手帮助一些有困难的人一样，轻轻松松啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940510,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "慢走慢走，嘿嘿，有缘再见啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库蕾玛娜"
				}
			]
		},
