			"trigger": {
				"objectNames": [
					"库蕾玛娜",
					"派蒙"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "等一下，等一下，这是商品，不买别碰啊！欸…你，对黄头发那位，就是你，别着急走，让我再看看你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940102,
					"content": "唔——果然如此，有如太阳般耀眼的头发，有如夜神之国般深邃的双目…我估计，不，我笃定，你将来会成为不得了的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940103,
					"content": "来来来，我这里有一组奇妙的玉饰，里面蕴含着各种各样不同的旋律，正巧配得上你这样的大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940104,
					"content": "不过，这可是无价之宝。一般人来买，我起码开价一千多万摩拉。但我看你与这些玉饰有缘，就给你打个一折，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940105,
					"content": "哇，一折！那岂不是大甩卖嘛！等等…那不还要一百多万摩拉嘛！这也太贵了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940106,
					"content": "哎呀，没办法。这已经是成本价了，毕竟我们这种小商小贩也不容易嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940107,
					"content": "经费可不应该这么挣哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "原来您都听到了啊。啊哈哈，你看我这喜欢自言自语的毛病啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940110,
					"content": "唉——既然都被发现了，我就实话实说了。这玉帛是我捡来的，也确实不值这个价格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940111,
					"content": "但我也没办法，如您所听到的，我们很缺经费，缺到连雇佣人回收水上浮标数据的辛苦费都凑不出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940112,
					"content": "那就不回收了嘛，总比骗人好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940113,
					"content": "不行啊…对于别的组织来说，缺经费无非就是不活动了，但我们的组织还肩负着观察火山的志愿任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940114,
					"content": "我们投放浮标也是为了通过收集水温等数据，来检测火山的活动情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940115,
					"content": "眼下火山的活动越来越活跃，浮标的回收也必须加紧，不然可能会出大问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940116,
					"content": "要不是我受过伤，根本破坏不了浮标，更不要提回收里面的数据…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940117,
					"content": "#{NICKNAME}，你说我们要不帮帮她吧？毕竟火山的事情，跟大家的安危有关，我们总不能视而不见吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940118,
					"content": "真、真的？如果你们愿意帮我的话，这些玉帛我就免费送你们了！就当成你们的报酬，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940119,
					"content": "不是说有一百万吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "你放心，虽然没有特别多，但除了玉帛之外，一定还会有额外的报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940122,
					"content": "嘿嘿，只要玉帛也足够啦！毕竟这次是为了在火山旁边的大家嘛！总而言之，你就放心交给我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940123,
					"content": "现在就开始吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "需要准备一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "嗯嗯，我这边随时都可以开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940120,
					"content": "啊…原来只有玉帛呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "什么帮工值一百万摩拉啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"2"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"库蕾玛娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "呼…太好了，从结果上来看，火山的情况并没有预想中的那么糟，这下大家能睡个好觉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940402,
					"content": "这还得多谢你们，要不是你们不计前嫌出手相助，想来这件事也不会这么顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940403,
					"content": "请你们务必收下这份报酬，这算是我个人的赔罪和感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940404,
					"content": "嘿嘿，既然你这么说，那我们就恭敬不如从命啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "你接下来准备怎么办…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "我手里还有一些积压的货物，只要运作一番经费自然就有啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "库蕾玛娜"
				},
				{
					"id": 751940407,
					"content": "哈哈，当然啦，这次没有什么紧急情况，所以会诚信经商的，你们放心好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库蕾玛娜"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
