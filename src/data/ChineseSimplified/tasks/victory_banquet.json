			"trigger": {
				"objectNames": [
					"珊瑚宫心海",
					"传次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "看来庆功宴准备得差不多了，不过在酒宴开始之前，我还得简单地演讲一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230102,
					"content": "唔…心海的能量还够用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230103,
					"content": "放心，完全够用。有你们的帮助，我的能量回复得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230104,
					"content": "太好了。我们也会帮你加油助威的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230105,
					"content": "大家辛苦了，今天是属于我们的庆功会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230106,
					"content": "在过去的一段时间里，我们与幕府军的战争告一段落，也见证了眼狩令的废除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230107,
					"content": "稻妻的未来会变成什么样，我也无法预料。但明天我将与天领奉行展开和谈，为海祇岛争取和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230108,
					"content": "感谢各位一直以来的努力，正因为你们的努力，我们才能打赢这一场艰难的战役。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230109,
					"content": "这场庆功会是为在场的每个人准备的，希望大家好好享受这来之不易的胜利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230110,
					"content": "喔——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "传次郎"
				},
				{
					"id": 120230111,
					"content": "看来晚会进行的很顺利，没出什么问题真的太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230112,
					"content": "#人在开心的时候，往往倾诉欲也会提高。{NICKNAME}，可以拜托你再帮我收集一些情报吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230113,
					"content": "关于「天领奉行勾结愚人众」这件事，到现在还没有进一步的线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230114,
					"content": "我很担心明天的和谈，会不会出什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230115,
					"content": "好吧，那我们再去问问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
