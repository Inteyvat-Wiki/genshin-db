			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "…总之，就是这个样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230402,
					"content": "天领奉行勾结愚人众这件事，其实是他们编造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230403,
					"content": "他们的目标是破坏和谈，让战争继续下去。他们还说，不管我们想做什么，都已经来不及了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230404,
					"content": "原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230405,
					"content": "心海…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "没事，让你担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230408,
					"content": "是我的错。如果我能更早地察觉到他们的心情，就不会发生这样的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230409,
					"content": "高善所说的「来不及了」，我大概知道指的是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230410,
					"content": "和谈虽然明天才开始，但双方的侍卫已经提前抵达了谈判地点，负责确认附近的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230411,
					"content": "像高善这样的主战派，很可能已经混进了侍卫队伍，准备在明天的谈判中暴起发难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230412,
					"content": "这可怎么办呀。要不我们现在出发，去把他们换掉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230413,
					"content": "不妥。首先我们带着新的卫队前往中立地带，势必会引起各方警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230414,
					"content": "主战派的士兵们很可能也会提前发动计划，进攻天领奉行的侍卫，一样有可能引发战争。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230415,
					"content": "更何况，我们不知道有多少海祇岛的士兵参与其中，临阵换人，难免会出现无人可信的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230416,
					"content": "听上去好复杂…难道真的没有什么办法了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230417,
					"content": "不必担心。此事既然已经发生，就由我来思考对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230418,
					"content": "那些士兵们固然有错，但过错不全在他们。无论如何，我会想办法保住他们的命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230419,
					"content": "明天，我们再在这里会合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 120230406,
					"content": "没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
