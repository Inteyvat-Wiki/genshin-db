			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高善"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "好强…不愧是珊瑚宫大人选中的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230302,
					"content": "你的身上还有战斗的意志…也许，你可以理解我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230303,
					"content": "剑鱼二番队的队长…你会成为我们的同伴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230304,
					"content": "先告诉我发生了什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230306,
					"content": "「天领奉行勾结愚人众」这件事，其实是我们编造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230307,
					"content": "怎、怎么这样！心海一直在担心的问题，居然是你们编的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230308,
					"content": "你们为什么要这么做呢？这可能会导致你们和天领奉行继续打下去呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230309,
					"content": "我们要的，就是这样的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230310,
					"content": "和谈？哼，就是因为每个人都这么想，海祇岛才没有未来可言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230311,
					"content": "谁能保证天领奉行不会半路变卦？谁能保证雷电将军不会颁布下一次眼狩令？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230312,
					"content": "我们反抗军，最重要的就是战斗的意志！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230313,
					"content": "天领奉行和雷电将军都不可信，能够相信的只有我们自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230314,
					"content": "你也是这么认为的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230315,
					"content": "他说的好像很有道理，但我总觉得哪里怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230316,
					"content": "只是你们想打而已吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "对哦。你说了半天，都是自己的猜测不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230318,
					"content": "为了这个猜测，你们就编造了这样的传闻，打算毁掉很多人辛苦盼来的和平吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230319,
					"content": "别一副事不关己的样子对我说教！你们又明白什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230320,
					"content": "为了赢下来，我们将战斗的意志贯彻到了极致，但现在你们突然告诉我，这些都没用了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230321,
					"content": "要我们放下武器，像普通人一样地生活，怎么可能呢？我闭上眼睛，总会想起那些在战场上牺牲的同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230322,
					"content": "每当他们的身影出现在我的脑海，我就绝对无法原谅天领奉行，无法原谅眼狩令！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230323,
					"content": "看来你和我们不是一路人…你可以把这些话告诉珊瑚宫大人。但是，现在想阻止我们已经来不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230324,
					"content": "来不及了？那是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230326,
					"content": "唔…他似乎不打算回答了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230327,
					"content": "#怎么办{NICKNAME}，事情紧急，我们还是先去告诉心海吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
