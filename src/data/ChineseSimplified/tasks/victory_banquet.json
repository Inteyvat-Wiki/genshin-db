			"dialogs": [
				{
					"id": 120230501,
					"content": "多亏了珊瑚宫大人，海祇岛才有现在的和平…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230502,
					"content": "最近有发生什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "最近？我想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230504,
					"content": "对我们来说，最近的大事就是终于可以出海捕鱼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230505,
					"content": "之前打仗的时候，海上有好多战船，我们只能在附近捞捞小鱼小虾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230506,
					"content": "有的时候收获不佳，大家都吃不饱。小孩子没日没夜地哭闹，我却一点办法都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230507,
					"content": "每天晚上肚子咕噜噜地叫个不停，翻来覆去睡不着觉，好不容易才能熬到天亮。现在终于好一些了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230508,
					"content": "我听说了，你是剑鱼二番队的队长吧，谢谢你帮我们打赢了这场仗。这条鱼给你，刚捞上来的，别嫌弃哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230509,
					"content": "不不不，这怎么好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230510,
					"content": "哈哈，收着吧。没有你，说不定我们现在还在饿肚子呢。珊瑚宫大人教导我们，人要知恩图报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230511,
					"content": "#好吧，谢谢你。{NICKNAME}，我们再去问问别人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
