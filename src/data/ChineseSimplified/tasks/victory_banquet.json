			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高善"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "呜哇…这个人身上好重的酒气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230202,
					"content": "嗯？我记得你是…「剑鱼二番队」的队长！没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230203,
					"content": "你回海祇岛了啊，我还以为你抛下小队不管，一个人跑路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230204,
					"content": "我们才不会跑路呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230205,
					"content": "哼，那可难说。和平啊，安定啊…每个人都在讨论着相似的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230206,
					"content": "反抗军最重要的是什么，你还记得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230207,
					"content": "是「战斗的意志」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "没错。就让我测试一下，你到底还是不是一个合格的反抗军战士吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230209,
					"content": "不管你想问什么，打赢了我再告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230210,
					"content": "唔…感觉和这个人的沟通好困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230211,
					"content": "#怎么办，{NICKNAME}，要上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120230212,
					"content": "嗯，我们不会输。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "哼…等你们赢了再说吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "高善"
				},
				{
					"id": 120230213,
					"content": "让他把知道的消息吐出来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
