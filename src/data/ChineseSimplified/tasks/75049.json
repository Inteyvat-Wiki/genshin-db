			"dialogs": [
				{
					"id": 750490401,
					"content": "嗯…没有想到你居然能找到这里的入口，这里已，许久未有人来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "夜魂之灵"
				},
				{
					"id": 750490402,
					"content": "此处，嗯，此处是夜魂们游荡之处…呵呵，不过，太阳所照的大地之上，恐怕就连夜魂的名讳业已无人记得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "夜魂之灵"
				},
				{
					"id": 750490403,
					"content": "夜魂啊…在我们的主人睡着时，我们就是她的梦。在我们的神偶尔醒来时，我们就是她思绪的一缕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "夜魂之灵"
				},
				{
					"id": 750490404,
					"content": "竟然有能来到此处的生人，呵呵，那些渴求战斗的家伙们已按捺不住…异邦的勇者，受宠爱之人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "夜魂之灵"
				},
				{
					"id": 750490405,
					"content": "用炽烈的战斗安抚这些躁动不安的魂灵吧，取得胜利，而深眠此处的灵必有嘉奖…如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜魂之灵"
				}
			]
		},
