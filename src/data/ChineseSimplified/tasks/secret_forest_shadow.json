			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃德蒙德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736770101,
					"content": "猎人先生，求你了，你就带上我吧，我一定能帮上忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770102
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770102,
					"content": "喂，你先冷静一点！虽说我们正在招募捕猎野林猪的人手，可你之前根本没有狩猎的经验，我们没办法录用你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770103
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770103,
					"content": "唉，这可怎么办啊，难道说我的论文…我的论文就要和野林猪一起消失在林子里了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770104
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770104,
					"content": "咦，你们两个愁眉苦脸的，发生什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736770105,
					"content": "哎呀，这不是传说中的旅行者吗？学生小哥，打起精神来，遇到这个人说不定就有办法了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770106,
						736770108
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770106,
					"content": "可我感觉我要有麻烦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770107
					]
				},
				{
					"id": 736770107,
					"content": "哈哈，别这么说嘛，大家都知道蒙德的荣誉骑士不仅身手了得，而且十分乐于助人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770110
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770110,
					"content": "所以有什么事需要我们帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736770111,
					"content": "事情是这样的，最近因为野林猪出没频繁，我们猎人的人手又不太够用，所以正在招募捕捉野林猪的志愿者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770112
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770112,
					"content": "这位从须弥来的学生小哥虽然也想加入，可你看他细胳膊细腿的，身体条件实在不符合我们的招募要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770113
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770113,
					"content": "是啊，你不是学生吗，为什么也想参加捕猎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736770133,
					"content": "#别看野林猪圆滚滚的，它们横冲直撞起来可是很凶的，如果没有{NICKNAME}这样的身手，还是不要贸然尝试为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736770114,
					"content": "道理我当然也知道，可这附近毕竟出现传说中的生物了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770115
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770115,
					"content": "等等，「传说中的生物」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736770116,
					"content": "唔，应该是指前几天我发现的一种有白鬃的野林猪吧，我刚才跟他闲聊的时候偶然提起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770117
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770117,
					"content": "不过，虽说那种野林猪我之前的确没见过，可它们真有那么特殊吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770118
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770118,
					"content": "那当然了！据我所知，你目击到的那种野林猪，可是一百年前就已经绝迹的「雪猪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770119
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770119,
					"content": "虽然最近有冒险家声称，在龙脊雪山又发现了它们的踪迹，但因为目击报告语焉不详，学界并未采信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770120
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770120,
					"content": "不瞒你们说，我其实是须弥教令院生论派的学生，因为最近毕业论文的方向一直定不下来，所以就来过佳酿节散散心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770121
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770121,
					"content": "如果我能找到雪猪存活的确凿证据，那可是了不得的学术大发现，我的毕业论文也能顺利进行下去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770122
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770122,
					"content": "#原来是这样。{NICKNAME}，你有没有觉得，我们遇到的教令院的人，好多都有类似的烦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736770123,
					"content": "学业固然重要，但身体可是本钱。考虑到学生小哥的人身安全，我们确实不能带他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770134
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770134,
					"content": "旅行者，不知道你愿不愿意代替他，加入捕猎队？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770124
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770124,
					"content": "如果能有你这样的好手加入，捕捉野林猪的效率一定能大大提高。而且大家也能腾出手来，帮他搜寻一下雪猪的踪迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770125
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770125,
					"content": "真、真的吗？请你们放心，我的研究经费还是很充足的，绝对能提供令大家满意的报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770126,
						736770127
					],
					"speakerTitle": "法拉比"
				},
				{
					"id": 736770126,
					"content": "好吧，为了科学研究。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770128
					]
				},
				{
					"id": 736770128,
					"content": "嗯，那就这么定了！旅行者，我马上就要出发去捉野林猪了，之前我也是在那里目击到雪猪的，你也一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770129
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770129,
					"content": "我在林子里布置了一些常用的捕猎工具，待会儿我也会顺便教教你那些工具怎么用。如果你准备好了的话，我们就可以出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770130,
						736770131
					],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770130,
					"content": "我准备好了，走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736770131,
					"content": "我还要再准备一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770132
					]
				},
				{
					"id": 736770132,
					"content": "没问题，你收拾妥当之后再来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德蒙德"
				},
				{
					"id": 736770127,
					"content": "好吧，为了研究经费。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770128
					]
				},
				{
					"id": 736770108,
					"content": "看来是需要我出马的时候了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770109
					]
				},
				{
					"id": 736770109,
					"content": "哈哈，不愧是蒙德的荣誉骑士，不仅身手了得，而且十分乐于助人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770110
					],
					"speakerTitle": "埃德蒙德"
				}
			]
		}
	]
}