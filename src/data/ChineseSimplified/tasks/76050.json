					"nextDialogs": [
						760500303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500303,
					"content": "哥伦比娅，你刚刚真的答对了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500304,
					"content": "好像错的时候更多一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500305
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500305,
					"content": "#我放弃了。{NICKNAME}，你猜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500306,
						760500310,
						760500315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500306,
					"content": "凛角鹿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500307
					]
				},
				{
					"id": 760500307,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500308
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 760500308,
					"content": "噢！看这反应是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500309,
					"content": "恭喜，猜对了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500310,
					"content": "长颈角犀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "好担心啊！它的脖子是不是出了点问题啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500312,
					"content": "嗯…是没有见过的生物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500313,
					"content": "正确答案是凛角鹿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500314,
					"content": "月灵们，回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500315,
					"content": "翻折了一根叉刺的渔叉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500316
					]
				},
				{
					"id": 760500316,
					"content": "好丰富的想象力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500317,
					"content": "哈…很有趣的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500318
					],
					"speakerTitle": "「少女」"
				},
				{
