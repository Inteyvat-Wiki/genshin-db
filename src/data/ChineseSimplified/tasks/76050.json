					"nextDialogs": [
						760500905
					]
				},
				{
					"id": 760500905,
					"content": "怎么猜错了的人也有奖励啦，难道是参与奖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500906
