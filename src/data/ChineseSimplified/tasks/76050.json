				},
				{
					"id": 760500906,
					"content": "好乖好乖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500907
					]
				},
				{
					"id": 760500907,
					"content": "它们喜欢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500908
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500908,
					"content": "我能感觉到，当这些孩子靠近你的时候，它们本身也放松了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500909
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500909,
					"content": "就像凛角鹿喜欢沐浴着月光生长，月灵们也喜欢你心中散发出的什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500910
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500910,
					"content": "嗯？那是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500911,
					"content": "温柔与善良吧。",
