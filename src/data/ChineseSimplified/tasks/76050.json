			"dialogs": [
				{
					"id": 760500101,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 760500102,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 760500103,
					"content": "哇，今天这里好热闹啊，有好多月灵都在哥伦比娅身边起舞呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500104,
					"content": "呃，等等…好像不是跳舞！月灵们是想朝她撒娇吗？哥伦比娅快要被淹没了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500105,
					"content": "救…救救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500106,
					"content": "把手给我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "呼…谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500108,
					"content": "刚才那是发生什么了？月灵们平时不会那么激动吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500109,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 760500110,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500111,
					"content": "我陪这些孩子玩了点游戏，它们似乎很享受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500112,
					"content": "享受完游戏时间之后围到你身边转…怎么感觉像狗狗一样呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500113,
					"content": "这就是它们表达感谢的方式吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "只不过这次一不留神，谢意就像雪堆一样积起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500115,
					"content": "说是这么说，你不还是很宠它们嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500116,
					"content": "你们也想试试看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500117,
					"content": "被围在中间的感觉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "嗯…这个也行。只要你答得上来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500121,
					"content": "行啊，我倒要看看是什么游戏，那么受月灵欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760500122,
					"content": "去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760500123,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 760500124,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "月灵"
				},
				{
					"id": 760500119,
					"content": "和月灵玩游戏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
					"content": "嗯。",
