			"dialogs": [
				{
					"id": 730091001,
					"content": "关于「恒素果」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "那是充满了力量的果实。它汲取大地中的记忆与梦生长，再经兰那罗与那菈的努力才能结出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730091003,
					"content": "以恒素果的力量供养「觉王之树」，就能结出惟耶之实。那是树王亲自种下的伟大之树，也是兰那罗一族的原点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉迦"
				}
			]
		},
		{
