			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰拉迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090901,
					"content": "关于「无留陀」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090902
					]
				},
				{
					"id": 730090902,
					"content": "那是很久以前的故事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090903
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090903,
					"content": "在过去，兰那罗行走在大地上，和那菈及万物为友，而林中也没有无留陀。直到在很多很多个月亮以前的一次灾难…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090904
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090904,
					"content": "树王归还了沙恒，无留陀开始在地上肆虐。而丛林终于恢复生机后，兰那罗为了保护自己，将真正的桓那兰那藏在了梦中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090905
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090905,
					"content": "森林本不知死为何物。直到有一天，树想起大地中充满了凋败的花、死去的兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090906
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090906,
					"content": "正如在同一天，大地想起自己曾经或将要吞食漆黑的毒血。河流想到太阳降下，蒸发了所有水的红色的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090907
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090907,
					"content": "他们明白了，万物都将无可避免地死去。这时，「无留陀」就诞生了。此乃「死」之名，知晓它存在的，终究会死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090908
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090908,
					"content": "无留陀的力量就是令一切走向死。而高大、阴暗、扭曲的东西就是无留陀选中的化身，带来死的使徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090909
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090909,
					"content": "当然了，在老身的故事中，无留陀的化身形态是不定的。也许是走兽。也许是飞鸟。也许是那菈。也许是疫病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090910
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730090910,
					"content": "但故事究竟是故事，那已经不是老身的记忆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉迦"
				}
			]
		},
