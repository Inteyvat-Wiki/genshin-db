				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091101,
					"content": "关于「森林书」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#那是那菈法留纳留下的东西。{M#她}{F#他}是一个金灿灿的那菈，与你一样善良、勇敢、正直。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730091103,
					"content": "#还记得那个时期的兰那罗，都十分想念{M#她}{F#他}，也热爱{M#她}{F#他}的故事。但老身相信，既然如今有了那菈{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉迦"
				}
			]
		},
		{
			"id": 7300912,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7300902",
							"2"
						],
						"stepId": 7300902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰拉迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091201,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091202
					]
				},
				{
					"id": 730091202,
					"content": "嗯。老身很期待和你们一起度过无忧节哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉迦"
				}
			]
		},
		{
			"id": 7300913,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7300906",
							"2"
						],
						"stepId": 7300906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰拉迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "#老身能过上无忧节，都是托了那菈{NICKNAME}和派蒙的福。谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730091302,
					"content": "老身很遗憾，无法像兰罗摩他们那样，和你一起在外面冒险，也不能帮助你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "兰拉迦"
				},
				{
					"id": 730091303,
					"content": "但是，这个梦永远欢迎你们。如果对外面的世界感觉累了，就到桓那兰那来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉迦"
				}
			]
		},
		{
			"id": 7300914,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
