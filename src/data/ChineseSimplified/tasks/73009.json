				"points": []
			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "兰拉娜会照顾她。因为她是最重要的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730090102,
					"content": "#那菈{NICKNAME}，请你去「桓那兰那」，唱响「大梦的曲调」。然后，请他们帮忙准备「惟耶之实」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730090103,
					"content": "听不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "就像云朵会明白要降下雨滴，雨水会明白要落入土地。种子会明白要茁壮成长，变成大树，结出饱满的果实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰拉娜"
				},
				{
					"id": 730090104,
					"content": "我、我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#那菈{NICKNAME}，看起来没有明白，但是没有关系。在正确的时候，那菈{NICKNAME}会明白应该做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "兰拉娜"
				}
			]
		},
		{
			"id": 7300902,
