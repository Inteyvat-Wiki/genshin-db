						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "欢迎欢迎，我已恭候多时了。希望各位能喜欢我这间小研究所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030902,
					"content": "喜欢？一路上都是怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030903,
					"content": "你竟敢以如此悠闲的姿态等候在此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030904,
					"content": "当然。我有什么可着急的？一切都那么顺利，你们也如期到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030905,
					"content": "先是桑多涅和阿蕾奇诺，然后是你们。今天客人还真多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030906,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030907,
					"content": "假如是在找那两位女士，那我得告诉你，阿蕾奇诺进入研究所后立刻消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030908,
					"content": "而桑多涅刚刚就站在这里，大声质问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030909,
					"content": "她总是这样，没什么礼貌。不过至少有一点令我意外，我实在没想到，连桑多涅都在意起他人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030910,
					"content": "和你们走得近的人难道都会变成这样吗？可那对研究人员来说不是好事。不够客观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030911,
					"content": "桑多涅在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "关于这一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030913,
					"content": "你的梦做得还真远，多托雷。难道你认为有了月髓就能在这世界称神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030914,
					"content": "称神这个说法我不喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030915,
					"content": "不是自称，而是事实如此。身为研究员的你，不会不能理解二者之间的差距吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030916,
					"content": "哈？就凭你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030917,
					"content": "噢，淑女偶尔也有出言不逊的时刻，请别介意。毕竟同事一场，你什么做派我们都清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030918,
					"content": "同事一场，我也猜到你会这么说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030919,
					"content": "你我都明白，事实胜于雄辩，所以，我派人给你送了点小礼物，帮助你直观理解我如今的位格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030920,
					"content": "礼物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030922,
					"content": "你手下那些人，都去哪儿了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030923,
					"content": "谁知道呢。也许他们已追随着未知之神的脚步去往新世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030924,
					"content": "虽然你缺乏教养又眼高于顶，但亲爱的桑多涅，我并不会因此迁怒你的下属。他们也享有同等权利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030925,
					"content": "你胆敢派人去月矩力试验设计局？那可是女皇陛下的试验场所！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030926,
					"content": "是啊，陛下的吩咐我们自当谨记在心。但你也知道，那跟我现在的目标并不冲突。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030927,
					"content": "既然如此，我只是做些想做的实验，有问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030928,
					"content": "你可以赌一把，是我在撒谎，其实只想调虎离山，还是我的话句句属实，你的下属正身处危险之中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030929,
					"content": "连愚人众自己的士兵都要下手，你丧心病狂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030930,
					"content": "如今我为自己定了一条新的规矩，要给每个人一次机会。我自然也会这样对你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030931,
					"content": "你若想离开，我不会阻拦。毕竟，我们大家都是好同事嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030932,
					"content": "该死的东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030933,
					"content": "不过我确实没想到，连桑多涅都关心起这世界的人来了。真可惜啊，还以为自我中心是她身上仅存的优点呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030934,
					"content": "连一个试验设计局都要保护，这种心性又能干成什么大事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030935,
					"content": "挟持人质可不是什么上得了台面的做法。还是说对如今的您而言，脸面已经不再重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030936,
					"content": "脸面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030937,
					"content": "我手里有两枚月髓，缺失的那一枚也即将制造完成。对即将成为新世界神明的我谈论脸面？未免风趣过头了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030938,
					"content": "你根本就不配握有那等圣物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030939,
					"content": "而依我看，世上还有许多人不配活着呢，我不也仁慈地允许他们存在了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030940,
					"content": "你会为你的所作所为后悔的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "那就得看你们有没有让人后悔的本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「博士」"
				}
			]
		},
