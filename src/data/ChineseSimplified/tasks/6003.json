			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"捷塔纳什"
				],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							309.422,
							310.76,
							540.634
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 60030501,
					"content": "你们…你们竟然敢到这里来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030502
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030502,
					"content": "据我们所知，「博士」现在可能在这间研究所里，而你正在向外逃离。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030503
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030503,
					"content": "哈，如果是来找「博士」大人的麻烦…我不敢说你们还有多少机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030504
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030504,
					"content": "您还能活多久，很可能取决于您发言的价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030505
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030505,
					"content": "已经有两个执行官在这里了。可是那又怎么样？「博士」大人敢做这些，就绝不会毫无准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030506
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030506,
					"content": "是吗？依我看你好像并不乐意做他的部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030507
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030507,
					"content": "而且，这附近有怪物的痕迹和气息，你难道喜欢与这些东西在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030508
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030508,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030509
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030509,
					"content": "我们需要知道「博士」究竟在谋划什么，如果你知道任何信息，请务必告诉我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030510
					]
				},
				{
					"id": 60030510,
					"content": "并不是只为我们的利益，他的行为很可能关乎整个挪德卡莱，甚至还有你们自己的至冬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030511
					]
				},
				{
					"id": 60030511,
					"content": "…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030512
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030512,
					"content": "大人他…正在制造某件不得了的东西。我认为，大人的计划并非一朝一夕，而是进行很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030513
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030513,
					"content": "不久前，「博士」大人说要回至冬一趟，可没想到那么快就回来了，还带着两颗发光的宝石一样的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030514
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030514,
					"content": "…是月髓。「博士」从哥伦比娅那里，夺走了本属于她的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030515
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030515,
					"content": "你说「少女」大人么？她早就脱离我们了，临走前她说，女皇陛下的嘱托她已办到，现在要去完成自己的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030516
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030516,
					"content": "我一直认为，脱离组织未必就是好事。我最敬仰的「队长」大人就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030517
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030517,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030518
					]
				},
				{
					"id": 60030518,
					"content": "为了完成计划，上头派遣了三支部队，分别隶属于「博士」、「木偶」和「少女」三位执行官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030519
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030519,
					"content": "当时，我是跟着「少女」大人的队伍过来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030520
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030520,
					"content": "她很少跟我们交流。她…并不关心周围，但并非心不在焉，而是给我一种感觉，这世界变成怎样她都不在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030521
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030521,
					"content": "那种感觉就像是，她没能找到为之而活的事物，才不得不遥望很远的地方…是的，她总是仰头看天空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030522
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030522,
					"content": "「博士」大人常站在不远处看着。据说他和「少女」大人一度关系不错，后来「少女」大人却忌惮他，不怎么与他接触了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030523
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030523,
					"content": "「少女」大人离开后，我被合并到「博士」大人手下。他…也同样不关心周围，唯独对月亮充满期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030524
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030524,
					"content": "对现在的「博士」大人而言，三月是他最想得到的东西。他还说，少一个月亮的话，自己造就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030525
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030525,
					"content": "人造月髓？难道是靠那些「亥珀波瑞亚」的虚影提供的知识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030526
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030526,
					"content": "很详细，感谢您的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030527
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030527,
					"content": "我能感觉到，您其实更愿意做哥伦比娅的部下，是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030528
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030528,
					"content": "…不，她已经不是执行官了。何况我们愚人众最应效忠的，永远只有女皇陛下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030529
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030529,
					"content": "说这些是因为我无法完全相信「博士」大人。他的行为，并不符合我们来到挪德卡莱的初衷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030530
					],
					"speakerTitle": "捷塔纳什",
					"speakerSubtitle": "「博士」下属"
				},
				{
					"id": 60030530,
					"content": "我明白了。我们会尽力阻止他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030531
					]
				},
				{
					"id": 60030531,
					"content": "「仆人」的部下在月矩力试验设计局，你可以去那里与他们会合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030532
					]
				},
				{
					"id": 60030532,
					"content": "都听到了吧。人造月髓，而且快完工了…多托雷的技术竟然到了这个地步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030533
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030533,
					"content": "接下来想必是场恶战，还请做好心理准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
