			"dialogs": [
				{
					"id": 60030101,
					"content": "看起来人都到齐了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030102,
					"content": "#是的，我们都已经准备好了。{NICKNAME}，派蒙，你们呢？状态如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030103,
					"content": "我准备好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030104,
					"content": "我也准备好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "那太好了，马上进入正题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030113,
					"content": "那么，首先…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030114,
					"content": "等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 60030115,
					"content": "有声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030116,
					"content": "我们听见你的脚步声了，不过嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030117,
					"content": "#您来这里有一会儿了，也许是跟着{NICKNAME}过来的？但您的气息，似乎不带有恶意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030118,
					"content": "进来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030119,
					"content": "各位果然如我所想，反应快得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030120,
					"content": "我奉「仆人」大人命令，前来传达她的口信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030121,
					"content": "多托雷佯装返回至冬，那显然是借口。但他并没回到月矩力试验设计局，也并未出现在那夏镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 60030122,
					"content": "所以他只可能在最北面的那个实验室。哈，我说为什么他要申请自己的场地…原来是早有计划！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030123,
					"content": "告诉他们，我和桑多涅先行一步。假如他们也关心此事的后续，那我们就在挪德卡莱最北方的研究所见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "「仆人」"
				},
				{
					"id": 60030124,
					"content": "那两位都是哥伦比娅小姐的至交，但她们行动前仍不忘与我们分享信息…诚挚感谢愚人众的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030125,
					"content": "虽说「少女」大人已经脱离组织…但大人们对她的关心绝非虚假。何况，目前看来「博士」大人的行为充满谜团，我们必须关注。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030126,
					"content": "我们常与人为敌，可那仅仅基于立场。人情与道义，我们向来都明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030127,
					"content": "各位是「少女」大人的朋友，有权知情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030128,
					"content": "到底是最懂得审时度势的阿蕾奇诺，替我们省去了许多功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030129,
					"content": "地图我放在这里了。如果你们决定前往最北部的研究所，请务必注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030130,
					"content": "务必记得，至少在挪德卡莱，「仆人」大人的下属可以是你们的同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030131,
					"content": "感谢您的周到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030132,
					"content": "分内之事罢了。那我就先告辞了，如有需要，可以到月矩力试验设计局找我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "格迪米纳什",
					"speakerSubtitle": "「仆人」下属"
				},
				{
					"id": 60030133,
					"content": "「博士」离开了月矩力试验设计局，去了最北方的研究所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030134,
					"content": "「木偶」说「博士」早有准备，难道他在来挪德卡莱之前就有这个计划了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030135,
					"content": "为女皇办事多半只是他的谎言。又或者，更简单一些——阳奉阴违。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030136,
					"content": "「博士」行事果断，作风狠辣歹毒，很不好对付。我们得做好准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030137,
					"content": "现阶段，「博士」的行动难以预测。我建议兵分两路，留一些人守住那夏镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030138,
					"content": "唔…虽然很想帮忙啦，但我确实不是潜入研究所的最佳人选…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60030152,
					"content": "但至少把「冷静一下鸭」带上吧！它应该能在战斗中帮到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 60030139,
					"content": "伊涅芙小姐是否和往常一样，决定留下保护爱诺小姐呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030140,
					"content": "检测到行动逻辑：保护爱诺，优先级：高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60030141,
					"content": "以防万一，法尔伽先生也留下比较好，研究所那边交给我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030142,
					"content": "身为北风骑士，我不应在这种时候留守，但…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030143,
					"content": "那夏镇交给我。几位也请务必注意安全，如果情况不可控，一定要及时撤退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030144,
					"content": "雅珂达也会帮各位的。我不在的时候，情报工作就交给她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030145,
					"content": "明白了老板。你们要安全回来哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 60030146,
					"content": "我们会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030147,
					"content": "夜长梦多，早点出发比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030148,
					"content": "这次情况可能很凶险…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "潜入任务，还是研究所的话…好吧，既然你们打算狠狠打一场恶战，那我就帮其他人忙好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030151,
					"content": "我们都得尽全力了。在那之前，你有没有没做完的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030401,
					"content": "还有一些事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "那等你准备完毕，我们再一起出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030601,
					"content": "我随时可以行动！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "那我们现在就行动吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030603,
					"content": "好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 60030149,
					"content": "派蒙留下帮大家吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "好，再确认一下议题如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "哈哈，是不是有点紧张？那也不怪你，我们大家都是第一次碰到这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030108,
					"content": "哥伦比娅小姐不久前刚遭到「博士」袭击…而在那短暂的瞬间，你看到她消失在了那个「月亮倒影」内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030109,
					"content": "嗯。事件发生时，我们所有人都只看到「博士」出现并使用了某种力量。随后哥伦比娅就消失了，你也从空中坠入大海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030110,
					"content": "必须救回哥伦比娅小姐，此外，愚人众执行官「博士」夺取三月的权柄一定有其目的。我们必须阻止他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 60030111,
					"content": "寻回「月神」原本是我们霜月之子的职责，没想到大家都愿意帮忙…我谨代表霜月之子，向诸位送上谢意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 60030112,
					"content": "（删除）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
