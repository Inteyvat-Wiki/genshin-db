			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法斯宾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705300201,
					"content": "旅行者！旅行者，请留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300202
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300202,
					"content": "你这里在举办什么活动？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300203
					]
				},
				{
					"id": 705300203,
					"content": "举办活动？不不不，我可没那个精力，也没那个能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300204
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300204,
					"content": "我就是对「留影」这件事很有兴趣，前段时间还托人弄了一台「留影机」回来，拍了好多画片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300205
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300205,
					"content": "但协会里的人似乎还挺喜欢这种画片…塞琉斯先生说，可以把这些画片整理成册，以后当做纪念品送出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300206
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300206,
					"content": "最近正好是风花节，塞琉斯先生就让我去蒙德各处拍一些和风花节有关的画片回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300207
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300207,
					"content": "他想要整理一本风花节纪念画片集，送给协会里的各位冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300208
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300208,
					"content": "但是…蒙德虽然有很多可以拍的地方，但我只有一个人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300209
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300209,
					"content": "协会里的冒险家们也都去忙自己的事了，没有空帮我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300210
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300210,
					"content": "虽然在风花节期间拜托人帮忙很不应该啦…但是旅行者！我听说你很擅长摆弄「留影机」，请你帮帮我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300211,
						705300213
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300211,
					"content": "我确实略懂，略懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300212
					]
				},
				{
					"id": 705300212,
					"content": "呼…那就好那就好，还好我打听得没错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300216,
					"content": "咳，说正事…旅行者，那我就正式拜托你，帮我去蒙德各处用「留影机」拍画片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300217
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300217,
					"content": "对了，你就用我的这台「留影机」去拍画片吧，我平时一直在维护它，用起来很顺手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300218
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300218,
					"content": "想要拍出好画片，那首先就要有一台好「留影机」，你说对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300219
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300219,
					"content": "那就辛苦你了啊，只要和风花节有关，无论什么画片都行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300220
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300220,
					"content": "报酬什么的你也不用担心，我会按照协会里的规矩算给你，保证不让你白跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300221
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300221,
					"content": "我得先在这里整理一下画片，先分个类…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300213,
					"content": "你是从哪听说的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300214
					]
				},
				{
					"id": 705300214,
					"content": "我是听协会里的冒险家们说的。他们之中也有不少「留影机」爱好者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300215
					],
					"speakerTitle": "法斯宾"
				},
				{
					"id": 705300215,
					"content": "我们还准备搞个「留影机」爱好协会呢，也不知道塞琉斯先生同不同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "法斯宾"
				}
			]
		}
	]
}