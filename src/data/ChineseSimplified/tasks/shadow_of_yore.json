	"talks": [
		{
			"id": 1102002,
			"completionStepIds": [
				1102002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102002",
							"2"
						],
						"stepId": 1102002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110200201,
					"content": "哦？没想到会在这里遇见你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200202
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200202,
					"content": "这两位是你的朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200203
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200203,
					"content": "#嗯，前段时间有幸识得，{NICKNAME}，见多识广，博学多才。与之相处，倍感投缘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200204
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200204,
					"content": "刚刚我们聊到「历史上的岩王帝君」这个话题，你有兴趣听一听吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200205
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200205,
					"content": "这位先生，好像轻看了岩王爷的神力。作为专业的考古学家，我想纠正他的一些观点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200206,
						110200207
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200206,
					"content": "他、他其实…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200208
					]
				},
				{
					"id": 110200208,
					"content": "我们正在讨论，「历史上第一枚摩拉」的下落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200209
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200209,
					"content": "历史上的第一枚摩拉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200210,
					"content": "众所周知，在岩王爷的指引下，璃月先民冶炼矿石，用最初的货物与世间诸国展开贸易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200211
					],
					"speakerTitle": "逸轩"
				},
				{
					"id": 110200211,
					"content": "如今的璃月，掌握了全大陆摩拉的唯一铸造之权。而世上第一枚摩拉，应该就是在数千年前，岩王爷亲手铸造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200212
					],
					"speakerTitle": "逸轩"
				},
				{
					"id": 110200212,
					"content": "根据我的考证…再加上一点猜测，我认为这枚具有历史意义的摩拉，可能是作为一种「信物」，秘密传承了下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200213
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200213,
					"content": "比如…掌管璃月的「七星」，会不会在每一代上任之前，都有什么不为外人所知的仪式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200214
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200214,
					"content": "不不不，按照我的研究，这「第一枚摩拉」的地位，可没这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200215
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200215,
					"content": "众所周知，摩拉是一种触媒。直到今天，也流传着利用摩拉在神秘学中的功效，来强化武器的奇术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200216
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200216,
					"content": "世上第一枚摩拉，一定蕴含着最强的力量。所以我的下一本历史著作，就是要大胆论证我十年来潜心研究的最新成果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200217
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200217,
					"content": "那就是——岩王爷用这枚摩拉作为触媒，强化了一刀一剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200218
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200218,
					"content": "一刀一剑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200219,
					"content": "哼哼哼，到时就请购买著作阅读全文了。现在我只揭秘一小部分：得到刀就可以成为璃月至尊，拔出剑就可以加冕璃月之王——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200220
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200220,
					"content": "…不敢苟同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200221
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200221,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200222
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200222,
					"content": "且不提这刀剑考据的真实性…所谓摩拉，所谓金钱，诞生的初衷，只是一种方便「契约」签立的筹码而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200223
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200223,
					"content": "引导人类利用摩拉进行交易，才是帝君本意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200224
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200224,
					"content": "想必「世上第一枚摩拉」，也只是被帝君当作普通的钱币，简简单单地花掉了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200225
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200225,
					"content": "唔…我觉得翰学先生的假说很有道理，倒是这位钟离先生，无凭无据的，就这么看轻岩王爷的深远谋划？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200226
					],
					"speakerTitle": "逸轩"
				},
				{
					"id": 110200226,
					"content": "不…我的说法不含褒贬，只是在陈述一种事实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200227
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200227,
					"content": "得了吧，是你懂岩王爷还是我懂岩王爷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200228,
						110200229
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200228,
					"content": "他、他其实…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200230
					]
				},
				{
					"id": 110200230,
					"content": "历史之事，我只略通一二，岂敢自诩。但如果观念没有分歧，研讨也就失去了意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200231
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200231,
					"content": "那我问你，千百年前，璃月港大兴土木，岩王爷传授人民建筑技艺。他使用的示范模型，全是用摩拉熔铸的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200232
					],
					"speakerTitle": "逸轩"
				},
				{
					"id": 110200232,
					"content": "确有此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200233
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200233,
					"content": "好，你说，如果不是因为看重摩拉的神力特质，岩王爷又为何要做出如此奢侈的行为？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200234
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200234,
					"content": "这很容易解释。因为对帝君来说，摩拉是最容易获得的，成本最低的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200235
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200235,
					"content": "唔、唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200236
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200236,
					"content": "就像在说别人的故事一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200237
					]
				},
				{
					"id": 110200237,
					"content": "呵呵，本来就是岩王帝君的故事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200238
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200238,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200239
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200239,
					"content": "这位先生！那个…我有些考古学方面的问题，想换一个安静的地方，向你请教。不知会不会打扰先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200240
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200240,
					"content": "#哦，这倒无妨。不过，不知我的这位朋友方便一起来吗？说不定{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}能提供更多帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200241,
						110200242
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200241,
					"content": "我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200243
					]
				},
				{
					"id": 110200243,
					"content": "先生都这么说了，那当然欢迎！我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200242,
					"content": "就当作来听听故事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200243
					]
				},
				{
					"id": 110200229,
					"content": "也许没人比他更懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200230
					]
				},
				{
					"id": 110200207,
					"content": "也许没人比他更懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200208
					]
				}
			]
		},
		{
			"id": 1102003,
			"completionStepIds": [
				1102003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102003",
							"2"
						],
						"stepId": 1102003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宛烟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110200301,
					"content": "接下来说的话，对岩神有些不敬，会招来很多白眼，所以…还是安静的地方比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200302
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200302,
					"content": "方才见先生谈吐不凡，思维清晰，最关键的是不轻信吹嘘与演绎，非常客观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200303
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200303,
					"content": "所以我想问先生一个问题，或许能得到与普通学者不同的答案…先生觉得，被岩神杀死的魔神，全都是邪恶的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200304
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200304,
					"content": "…善与恶，暂且不论。岩王帝君尊重「契约」，所以死于他手的魔神，一定是打破了某种「契约」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200305
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200305,
					"content": "嗯，至少滥杀无辜这种事，岩王爷是不会做的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200306,
					"content": "可是，我在考古的时候，了解到一些关于「盐之魔神」的传说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200307
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200307,
					"content": "「盐之魔神」赫乌莉亚…她是一位善良的魔神，却还是在战争中被摩拉克斯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200308
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200308,
					"content": "被摩拉克斯，用不光彩的手段…暗杀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200309
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200309,
					"content": "啊？不会吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200310,
					"content": "这…确实是说来话长的一段历史。但故事的真相，可能并不是你想知道的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200311
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200311,
					"content": "没关系，请把你知道的历史都告诉我吧！这件事…这件事，我已经调查很久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200312,
						110200314
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200312,
					"content": "钟离看起来有点为难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200313
					]
				},
				{
					"id": 110200313,
					"content": "不…只是，该从哪里说起呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200316
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200316,
					"content": "哦，在这在这！钟离先生！哎呀，找了好久，没想到你在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200317,
						110200318
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200317,
					"content": "愚人众？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200319
					]
				},
				{
					"id": 110200319,
					"content": "放下武器！保持距离！不然…不然我要报告千岩军了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200320,
					"content": "首先我就没有拿武器啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200321
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200321,
					"content": "呃…反应不用这么激烈，我是至冬国来的考古研究员，不是来找麻烦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200322
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200322,
					"content": "愚人众每次都这么说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200323,
					"content": "这次，已经和璃月总务司报备过了。你们想看的话，我这里有官方的许可文书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200324
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200324,
					"content": "我会在璃月进行一段时间的考古勘探，所有的勘探结果，都会和官方共享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200325
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200325,
					"content": "而我听说，往生堂有位客卿，名叫钟离，博古通今，知识渊博。我就向往生堂支付了重金，聘请他当我的顾问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200326
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200326,
					"content": "也就是说，是往生堂的工作，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200327,
						110200328
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200327,
					"content": "怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200329
					]
				},
				{
					"id": 110200329,
					"content": "既然是工作，那就没办法了。身为往生堂的客卿，就要尊重这个身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200330
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200330,
					"content": "果然是通情达理之人！那我们现在就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200331
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200331,
					"content": "稍等，如果是考古的话，我也可以一起去吗？我也是考古学家，可以提供很多帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200332
					],
					"speakerTitle": "宛烟"
				},
				{
					"id": 110200332,
					"content": "#那刚刚的话题，路上有机会再继续讲吧。对了，{NICKNAME}，你也一起来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200333,
						110200334
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200333,
					"content": "为什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200335
					]
				},
				{
					"id": 110200335,
					"content": "接下来的经历，或许会对你未来的旅途有所帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200336
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200336,
					"content": "那是七神体系建立之前的故事…虽然魔神已逝，不可能是你的寻访目标，但至少，也能为你的旅行见闻增添一些意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200337
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200337,
					"content": "等等，这是考古小队，不是观光团！人太多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200338
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200338,
					"content": "可是，我这位朋友，有一项无人能及的寻宝天赋，对我们的考古之行大有裨益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200339
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200339,
					"content": "哦？什么天赋呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200340
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200340,
					"content": "——绝不会漏过任何一个视线之内的宝箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200341
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110200341,
					"content": "我也擅长这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200342,
					"content": "…确实有点吸引力，行吧行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200343
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200343,
					"content": "事不宜迟，我们先去看看，不久前那位「漩涡之魔神」被群玉阁镇压时，会不会有什么东西冲刷上岸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200344
					],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200344,
					"content": "古物也好，痕迹也好，要是有一点点魔神肢体的碎片就更好了…总之，说不定能有大收获呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克列门特"
				},
				{
					"id": 110200334,
					"content": "其实我不太懂考古。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200335
					]
				},
				{
					"id": 110200328,
					"content": "我觉得谨慎一点比较好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200329
					]
				},
				{
					"id": 110200318,
					"content": "老实点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200319
					]
				},
				{
					"id": 110200314,
					"content": "是这么复杂的故事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200315
					]
				},
				{
					"id": 110200315,
					"content": "嗯，不知该从哪里说起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200316
					],
					"speakerTitle": "钟离"
				}
			]
		},
