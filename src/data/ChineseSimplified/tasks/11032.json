						],
						"stepId": 1103203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心",
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "甘雨前辈，感谢您的赏光。还有这二位，也感谢你们能来捧场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320202,
					"content": "小事小事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320203,
					"content": "辛苦慧心安排了，明明不用如此费周折的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320204,
					"content": "呵呵，其实…甘雨前辈，除了感谢您之前的帮助，还有些事情想要跟您讲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320205,
					"content": "哦？有什么需要帮忙的，你都可以跟我直说，不需要避讳什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320206,
					"content": "啊…不不，其实也不算是需要帮忙…嗯…您可以慢慢听我说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320207,
					"content": "我非常愿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320208,
					"content": "呵呵…我从很小很小的时候，就曾听父亲讲过很多有关甘雨前辈的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320209,
					"content": "虽然我对父亲也一直非常敬佩，但每次都还是会被甘雨前辈的温柔可靠所吸引…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320210,
					"content": "我那时是如此向往着您的身影，也正是因此才决定来到月海亭工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320211,
					"content": "原来在你眼里的我，是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320212,
					"content": "不过事实上，作为月海亭秘书的工作还是非常辛苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320213,
					"content": "我没有您那样优秀的工作能力，因而时不时总是会怀疑自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320214,
					"content": "没有的事，慧心已经做得很好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320215,
					"content": "呵呵，谢谢前辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320216,
					"content": "这些年，我也有了自己的女儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320217,
					"content": "欸！原来天叔已经当爷爷了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320218,
					"content": "我的女儿在我的熏陶下，如今也继承了我当年的理想——成为月海亭的秘书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320219,
					"content": "起初我会有些担心，毕竟这份工作并不容易，目前也还看不出她是否有这样的资质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320220,
					"content": "但经过这次的事之后…我现在很坚定，会选择支持她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320221,
					"content": "欸，是什么会让你觉得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320222,
					"content": "因为她以后也会遇上一位叫做甘雨的前辈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320223,
					"content": "甘雨前辈会温柔地帮助她，并且跟她说，你妈妈当年是这样做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320224,
					"content": "想到那副画面，可真是美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320225,
					"content": "所以——二十年后的事也拜托前辈您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320226,
					"content": "慧心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320227,
					"content": "…我、我从没想过，我的存在对你来说还有这样的意义…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320228,
					"content": "呵呵，就像前辈您之前向我展示我父亲的做法一样，有您在「见证」，就会让人感觉很安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320229,
					"content": "「见证」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320230,
					"content": "…我确实，在见证着璃月港这几千年的时光。不论发展变迁，还是人情世故…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320231,
					"content": "但我曾以为，这除了带给我孤独之外，并没有什么其他的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320232,
					"content": "慧心，你刚才的话对我来说，非常重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320233,
					"content": "让我真正感觉到，除了岩王帝君与我订下的「契约」外，我与璃月港的这片人海之间的联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320234,
					"content": "体会到被依赖，被认可，被渴望见证的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320235,
					"content": "当然了，您可是我们独一无二的甘雨前辈呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320236,
					"content": "呵呵…是啊，所以要好好回应大家才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320237,
					"content": "这才对嘛！甘雨小姐终于振作起来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320238,
					"content": "哪怕我真的被排挤了，我也希望还能争取一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320239,
					"content": "为了不辜负你对我的托付，我也还想继续履行「契约」，继续作为「七星」的秘书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320240,
					"content": "唉…我从一开始就说过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "总之，我现在要回去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320243,
					"content": "没有我在的话，那些事务的处理恐怕正乱作一团吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320244,
					"content": "工作，工作，没时间可以这样浪费了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320245,
					"content": "请加油！甘雨前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320246,
					"content": "欸欸！就这样要走了吗，我还没吃饱呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320241,
					"content": "你被排挤的事是场误会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百晓",
					"百识",
					"百闻"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "百识"
				},
				{
					"id": 110320302,
					"content": "阿识，你还好吗…难道说站着睡着了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110320303,
					"content": "你们看…你们看看是谁来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110320304,
					"content": "居然还有闲情雅致在这里偷懒，看来你们确实有接替我的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320305,
					"content": "没有没有！我们只是…真的连续工作了太久，如果不出来稍微歇歇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110320306,
					"content": "恐怕就熬不到见到甘雨小姐的这天了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110320307,
					"content": "甘雨小姐，我们好想你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "百识"
				},
				{
					"id": 110320308,
					"content": "唔，我好像和各位只有过一面之缘而已，竟然说得这么亲昵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320309,
					"content": "因为我们最近日日夜夜都在盼着您回来，把工作重新接手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "百闻"
				},
				{
					"id": 110320310,
					"content": "您的出现对我们来说，就像仙人下凡拯救苍生一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "百识"
				},
				{
					"id": 110320311,
					"content": "以往那些不服输的心情都已经不重要了，只想快点从这繁重的工作解脱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "百晓"
				},
				{
					"id": 110320312,
					"content": "好了好了，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320313,
					"content": "请把手上的工作按照政务、商务、民事来分开归类，标记好哪些未开始，哪些已经在进行中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320314,
					"content": "剩下的交给我就好。",
