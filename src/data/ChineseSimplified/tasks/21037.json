			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "璃月啊…璃月，不知我何时才能再回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "旅行者，是你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370104,
					"content": "是这样。我去枫丹的行程终于定下来了，过几天我就随着那位客商一起启程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370105,
					"content": "现在他还得处理一些商贸事务，我也趁着这个时间，最后再收拾收拾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370106,
					"content": "你不回绝云间看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "呵呵，我要是再去周围看看，只怕我就狠不下心离开璃月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370109,
					"content": "我就在这里多看几眼城里就行。在这里生活了这么久，这次离开，也不知道什么时候才能再回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370110,
					"content": "哦对了，师妹她…最后还是没答应和我一起走，但我已经拜托芷若照顾她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370111,
					"content": "我也把一些钱财留给了她，师妹比我聪明，她会照顾好自己的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370112,
					"content": "…也许未来有一天，她也会理解我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370113,
					"content": "对了旅行者，我还想再拜托你一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370114,
					"content": "能不能请你帮我去拿一些「土」回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370115,
					"content": "倒是没问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "游子离乡，多少得带点纪念走不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370118,
					"content": "带一撮璃月的土在身边，我也勉强能算是没有和这片土地断了联系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370119,
					"content": "你怎么不自己去取？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "哈哈哈…之前不是说了吗？要是我真去周围看一圈，再触景生情一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370121,
					"content": "只怕我好不容易鼓起的这么一点离乡的勇气，就要烟消云散了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370122,
					"content": "所以这件取土的事，就拜托你了，旅行者。我把取土的位置给你标在地图上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370123,
					"content": "这个地方有什么特别的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "咳…我…我之前经常带着师妹在那里练剑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370125,
					"content": "总之！所以这件取土的事，就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370116,
					"content": "你要土做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "你不再去周围看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
