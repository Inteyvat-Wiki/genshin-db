			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小雀儿",
					"芷若"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "芷若姐姐，你…你说师兄他是不是故意的！他就是…就是不想和我呆在一块！呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 210370402,
					"content": "师妹，你们朝夕相处，他又怎么可能不明白你的心意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 210370403,
					"content": "他之所以要离开璃月外出游历，也是有自己的考量，你就是随他一起出行又有何妨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 210370404,
					"content": "我就是不想离开璃月！我们俩就在这里呆着不好吗？古华派…管他古华派做什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 210370405,
					"content": "那你为什么不把这些话告诉他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 210370406,
					"content": "我…我…我…师兄一心都是古华派…我要是对师兄说了这话，师兄讨厌我怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 210370407,
					"content": "唉，师妹啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芷若"
				}
			]
		},
