			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "多谢，这些就足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370302,
					"content": "你…看起来情绪不高。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "啊？没事没事，哈哈哈…让你见笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370304,
					"content": "只不过，突然要离开生活了这么久的璃月，我多少还是会有些不舍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370305,
					"content": "你们什么时候出发？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "等物资准备齐全之后，我们就会出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370307,
					"content": "哦对了，之前和我一起去层岩巨渊的那位冒险家也会和我们同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370308,
					"content": "这位冒险家听说我要去枫丹，说自己也很有兴趣，于是就和我们一起走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370309,
					"content": "那位客商倒是很高兴多了个冒险家来保护他…但老实说，我真的不擅长和这种太过热情的人交流啊，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370310,
					"content": "真没想到，我也会有离乡远行的一天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
			"id": 2103704,
