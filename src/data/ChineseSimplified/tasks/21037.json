			"dialogs": [
				{
					"id": 210370201,
					"content": "旅行者，你帮我把土取回来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370202
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210370202,
					"content": "取回来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2103703,
			"completionStepIds": [
				2103705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
