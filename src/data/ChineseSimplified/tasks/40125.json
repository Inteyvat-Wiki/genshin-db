			"dialogs": [
				{
					"id": 401251101,
					"content": "珊瑚宫小姐不打算把那个贝壳带回去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 401251102,
					"content": "我反倒觉得，保存在伊迪娅小姐这里会更合适一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 401251103,
					"content": "如今的海祇岛已经有了新的「宝物」，人们的愿望也正慢慢被实现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 401251104,
					"content": "不如就让它守护着这瓶中的蜃境，陪伴着路过旅人们的梦想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宫心海"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
