			"trigger": {
				"objectNames": [
					"柯莱",
					"优菈",
					"莱斯格",
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "如果从阿如村走的话…就能够途经喀万驿，禅那园…绕道去须弥城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401251202,
					"content": "原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401251203,
					"content": "要顺路买什么东西吗？你们只管选礼物，我来负责提！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "莱斯格"
				},
				{
					"id": 401251204,
					"content": "只要手里拿得下，多重都没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "莱斯格"
				},
				{
					"id": 401251205,
					"content": "哪有那么多人要送…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401251206,
					"content": "妈妈，阿贝多哥哥，琴团长，雷泽…还有迪奥娜姐姐，莫娜姐姐，菲谢尔姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251207,
					"content": "看我干嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401251208,
					"content": "没什么，没什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401251209,
					"content": "可莉想给大家选什么样的礼物呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401251210,
					"content": "要…要日落果味道的糖！还有蕈兽那样的大帽子，还有还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251211,
					"content": "可莉要买很多很多故事书送给大家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251212,
					"content": "但送给妈妈的礼物，可莉还没想好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401251213,
					"content": "没关系，边走边看，姐姐们也会帮忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401251214,
					"content": "嗯！谢谢姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
		}
	]
