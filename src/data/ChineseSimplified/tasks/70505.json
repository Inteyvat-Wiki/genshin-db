			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪卢克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705050201,
					"content": "味道很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050202,
					"content": "主要还是原材料好！只要水果新鲜，就算什么也不加都会很甜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050203,
					"content": "那就感谢蒙德的土地吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050204,
					"content": "…苍谷落日，是我第一次调出的饮品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050205,
					"content": "那时还小，父亲摆出了几种材料，让我自己动手尝试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050206,
					"content": "没有要求，也没有提示，多半是为了看我的灵性吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050207,
					"content": "最后我做出的，就是这样一杯果汁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050208,
					"content": "欸，为、为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050209,
					"content": "父亲也很诧异。但当时的我并未考虑其他因素，只知道果汁很甜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050210,
					"content": "现在想来，那是多么幼稚又短浅的认知啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050211,
					"content": "我不这么认为。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050213,
					"content": "对他来说一定也是好饮品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "我没有那样想过…毕竟，当时父亲什么都没说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050216,
					"content": "不过，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050217,
					"content": "另外，有件东西想给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050218,
					"content": "…等你对酒保工作有更多体验之后，再交给你比较好。以你的能力，一定能出色地完成这份工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050219,
					"content": "我也会…帮忙打气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050220,
					"content": "嗯，期待你们的成果。那我就先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050221,
					"content": "有空再来哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050214,
					"content": "他一定也觉得很美味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
	]
}