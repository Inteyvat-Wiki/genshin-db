				"points": []
			},
			"dialogs": [
				{
					"id": 705050101,
					"content": "迪卢克老爷！真难得！是今天刚好闲着没事干吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050102,
					"content": "什么叫闲着没事干。我收到了你们兼任酒保的消息，过来看看而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050103,
					"content": "哇，情报太灵通了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050104,
					"content": "#所以，{NICKNAME}，当酒保的体验如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050105,
					"content": "才刚开始…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "是啊，迪卢克老爷问得太早啦，我们开张还没多久呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050107,
					"content": "只是想问问第一感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050108,
					"content": "兴奋吗？还是困扰？有什么感受，直说就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050109,
					"content": "还挺新奇的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050112,
					"content": "不、不问问我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050113,
					"content": "我的第一感觉是…好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705050114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050115,
					"content": "那就好，为你高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050116,
					"content": "能请你帮我调一杯苍谷落日吗？杯量随意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050117,
					"content": "明白了，请稍等片刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "嗯，不用着急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 705050110,
					"content": "有点手忙脚乱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
		{
			"id": 7050502,
			"completionStepIds": [
				7050503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
