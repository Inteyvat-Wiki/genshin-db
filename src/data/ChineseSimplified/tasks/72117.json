			"dialogs": [
				{
					"id": 721170101,
					"content": "旅行者，您来得正好。数据应该搜集得差不多了，是去回收那些信标的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721170102,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "那就交给您了，快去快回吧，别让那些愚人众发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721170104,
					"content": "你怎么知道的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "这种信标在制作的时候，一般会附带详细的使用说明手册。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721170106,
					"content": "针对不同的情况，说明书上也标明了不同的推荐搜集数据时长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "泽维尔"
				},
				{
					"id": 721170107,
					"content": "「祟神」这种属于「未知能量」的东西，我就直接按照最长的时间来算了…总之，回收信标的事就拜托您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "泽维尔"
				}
