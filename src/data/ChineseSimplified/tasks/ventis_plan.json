			"dialogs": [
				{
					"id": 3740301,
					"content": "欸嘿，修女她头也不回地走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740302,
					"content": "不过呢，其实我也已经达到了预定的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740303,
					"content": "至少她没有否认——大教堂里收藏着天空之琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740304,
					"content": "#那么，{NICKNAME}。既然你是骑士团正当红的新人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740305,
					"content": "要不然，你也来试试？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
