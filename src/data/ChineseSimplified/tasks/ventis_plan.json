			"dialogs": [
				{
					"id": 3740401,
					"content": "风神祝福你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740402,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "啊，你是…骑士团的那位新成员吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740406,
					"content": "为什么来这里？是代理团长大人交待的公务吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740411,
					"content": "嗯，骑士团，要借用天空之琴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "真的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740413,
					"content": "倒不是怀疑你。但早些时候有个可疑的诗人也来借琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740414,
					"content": "他满口胡言，竟敢自称巴巴托斯，一定没安好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740415,
					"content": "天空之琴的使用是有规定的。目前只有羽球节期间才会用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740416,
					"content": "出借时需要团长、主教，还有民众代表协商同意，签署文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740417,
					"content": "那么，骑士团的文件呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740418,
					"content": "好像没听团长提起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "总而言之文件是必须的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740423,
					"content": "没其他事的话，恕我失陪了。最近真的很忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740419,
					"content": "对不起，我忘了拿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "在路上被派蒙吃掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3740404,
					"content": "#我是荣誉骑士{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "嗯，我认识你。那天你跟安柏一起拯救了蒙德呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "歌特琳德"
				}
			]
		},
