					"nextDialogs": [
						3740705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3740705,
					"content": "当然，因为我可是天下最好的诗人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740706,
					"content": "过去、未来与现在，没有我不知道的歌谣。",
