				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "看我的吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740202,
					"content": "你好，修女姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740203,
					"content": "风神祝福你，年轻的诗人。有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740204,
					"content": "其实，我掌握了一个秘密，能够解救蒙德城遇到的危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740205,
					"content": "哦？那可真是风神保佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740206,
					"content": "但这件事你应该对骑士团报告。我这样一个无关的修女能帮到你什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740207,
					"content": "啊哈哈，姐姐你当然是有能帮忙的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740208,
					"content": "比如说…天空之琴。借助它的力量，我可以让风魔龙——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740209,
					"content": "请回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740210,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740211,
					"content": "虽然那条龙非常凶恶，但只要代理团长下定决心，就没有不能讨伐的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740212,
					"content": "那可不行，那样的话风魔龙不就会死掉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740213,
					"content": "背离东风的愚兽，即便是风神本尊降临，也不会轻易原谅它！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740214,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740215,
					"content": "呃…那个，大姐姐~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740216,
					"content": "不行就是不行哟，小诗人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740217,
					"content": "（嘶…被这孩子叫大姐姐，心里怎么会泛起一种不可思议的高兴…真荒谬…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740218,
					"content": "呼…真没办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740219,
					"content": "我已经不能再隐瞒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740220,
					"content": "我虔诚的信徒啊，喜悦吧！在你面前的，正是<color=#00E1FFFF>风神巴巴托斯</color>本人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740221,
					"content": "是不是很震惊？是不是震惊得想哭？终于见到了侍奉的神明，怎样？很感动吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3740222,
					"content": "没别的事情的话，我回去继续处理教堂的文件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740223,
					"content": "呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
