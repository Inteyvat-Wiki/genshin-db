				"points": []
			},
			"dialogs": [
				{
					"id": 735160101,
					"content": "——施芮娅，你刚刚看到了吗！我们的「对沙虫用杀虫炮」，果然是划时代的设计！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160102
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735160102,
					"content": "真希望当年听我们答辩的导师都过来看看，治治他们陈腐守旧的眼界！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160103
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735160103,
					"content": "居然真的没出什么问题…我还以为八成会落到三号机的下场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160104
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735160104,
					"content": "咳…吃一堑长一智嘛，我也不是当初那个我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160105
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735160105,
					"content": "当年究竟出了多少事故啊…无、无论如何，实验成功了就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735160106,
					"content": "嗯，趁着现在势头不错，我们换个地方再来一次吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160107
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735160107,
					"content": "——目击情报说，这附近至少还有两位数的沙虫呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160108
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735160108,
					"content": "等等——两位数？！你不会打算就这么一只一只干掉吧？这得干到什么时候啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735160109,
					"content": "嗯？有什么问题吗？如果是「对沙虫用杀虫炮」的保养情况，应该不用担心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160110
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735160110,
					"content": "慢着慢着！要重复那么久望不到头的工作，机械没垮我们也要累垮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735160111,
					"content": "维纳亚克，可不是每个人都像你一样，只要闻着机油味就能恢复精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160112
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735160112,
					"content": "是吗？看来下次得把湿件性能也纳入考量了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160113
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735160113,
					"content": "总之，今天就先到这里吧。有了这次完整运行的数据和战斗后采集到的样本，我离解开谜题也更近了一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160114
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735160114,
					"content": "什么谜题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735160115
					]
				},
				{
					"id": 735160115,
					"content": "沙虫作乱的原因、环境参数的异常…只要能搞清楚这些，说不定就能从根本上解决这次动乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160116
					],
					"speakerTitle": "施芮娅"
				},
				{
					"id": 735160116,
					"content": "请再给我一天时间做点调查吧，等到明天这个时候，应该就会有结果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮娅"
				}
			]
		}
	]
}