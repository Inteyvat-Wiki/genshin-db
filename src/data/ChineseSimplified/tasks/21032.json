				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210320101,
					"content": "旅行者，我们又见面了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320102,
						210320104
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320102,
					"content": "你还在锻炼吗？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320103
					]
				},
				{
					"id": 210320103,
					"content": "是的，只不过…实在是有些辛苦。也不知道我是真的实力不济，还是用错了锻炼方法…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320108
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320108,
					"content": "先不说这些了。上次和你同行时，你的招式和动作都给了我很大启发。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320109
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320109,
					"content": "旅行者，请你今天再陪我出去锻炼一次吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320110,
						210320111
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320110,
					"content": "没问题。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320113
					]
				},
				{
					"id": 210320113,
					"content": "是这样，我初步给自己拟定了一个训练的计划，其中包括了「对抗魔物」和「越野训练」两项。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320114
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320114,
					"content": "旅行者，你看你方便陪我进行哪一项训练？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320111,
					"content": "你还要和我对打吗？行啊，我准备一下…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320112
					]
				},
				{
					"id": 210320112,
					"content": "欸？！等等，等等！我可打不过你啊！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320113
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320104,
					"content": "你师妹还不理你？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320105
					]
				},
				{
					"id": 210320105,
					"content": "咳…师妹她…最近总是说城里有事要处理，一直也没回来过…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320106
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320106,
					"content": "我去找她说过几次，但她都只是让芷若出来挡住我，始终也不肯见我。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320107
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320107,
					"content": "唉，我也不知道怎么劝好她…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320108
					],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
			"id": 2103202,
			"completionStepIds": [
				2103201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210320201,
					"content": "对抗魔物。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320202
					]
				},
				{
					"id": 210320202,
					"content": "好！我早就想要把我学习的剑术用在实处了…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320203
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320203,
					"content": "只怕你看不清我的动作。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320204
					]
				},
				{
					"id": 210320204,
					"content": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320205
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320205,
					"content": "我看看…上次我已经看准了一处魔物的聚集地，咱们就先去那里好了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
			"id": 2103203,
			"completionStepIds": [
				2103201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210320301,
					"content": "越野训练。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320302
					]
				},
				{
					"id": 210320302,
					"content": "那就太好了，我还请一位冒险家帮我规划了一条越野路线。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320303
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320303,
					"content": "她说我只要尽快到达终点就好…但我每次用的时间都实在太长…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320304
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320304,
					"content": "所以，我想拜托你为我示范一下如何快速「越野」，我会在后面努力跟上的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320305,
						210320306
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320305,
					"content": "没问题。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320308
					]
				},
				{
					"id": 210320308,
					"content": "那就拜托你了，我们先去训练地点吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320306,
					"content": "你可别被我甩远了。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320307
					]
				},
				{
					"id": 210320307,
					"content": "咳…我…我努力跟上，但说实话，我的脚力实在是有限啊…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320308
					],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
			"id": 2103204,
			"completionStepIds": [
				2103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210320401,
					"content": "呼…呼…真是难以对付…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320402
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320402,
					"content": "抱歉，让你见笑了。没想到正式对敌时，我会这么紧张…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320403
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320403,
					"content": "总之我…我还是需要多多锻炼。多谢了旅行者，这些报酬给你，请收下吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320404
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320404,
					"content": "你真的要离开璃月？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320405
					]
				},
				{
					"id": 210320405,
					"content": "我还没有完全想好，我还得再想想，顺便…再尝试说服一下师妹。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
			"id": 2103205,
			"completionStepIds": [
				2103205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210320501,
					"content": "呼…呼…呼…你怎么…怎么能跑得这么快…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320502,
						210320504
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320502,
					"content": "是你跑得太慢了。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320503
					]
				},
				{
					"id": 210320503,
					"content": "甘拜下风…甘拜下风…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320506
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320506,
					"content": "呼…总算是把气喘匀了。没想到「越野」居然这么累人…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320507
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320507,
					"content": "谢谢你给我做示范，旅行者，这些报酬请你收下吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320508,
						210320512
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320508,
					"content": "关于小雀儿…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320509
					]
				},
				{
					"id": 210320509,
					"content": "师妹她还是不愿意和我走，反倒是想要说服我留在璃月。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320510
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320510,
					"content": "我又…我又何尝不明白师妹的心思。但留在璃月，我又怎能找出复兴古华派的方法。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320511
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320511,
					"content": "唉…我看此事，是难以两全啊…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320512,
					"content": "你之前在这里锻炼过？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320513
					]
				},
				{
					"id": 210320513,
					"content": "我…呃…我听说此处地势颇险，魔物众多，觉得很适合作为锻炼的场所，所以…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320514
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320514,
					"content": "你之前是偷偷进来的？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320515
					]
				},
				{
					"id": 210320515,
					"content": "是…我是偷偷进来的…但我又怎么知道进层岩巨渊这么麻烦。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320516
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320516,
					"content": "我每次进来还都要和一位冒险家同行，以「一同执行协会委托」为理由进入层岩巨渊。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320517
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320517,
					"content": "咳，别提了，等会我还要去和她会合，帮她搜集花草呢…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 210320504,
					"content": "你还得多多锻炼啊。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210320505
					]
				},
				{
					"id": 210320505,
					"content": "你说得…说得对…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210320506
					],
					"speakerTitle": "孙宇"
				}
			]
		}
	]
}