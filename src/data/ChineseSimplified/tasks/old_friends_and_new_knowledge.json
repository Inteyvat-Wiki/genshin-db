			"dialogs": [
				{
					"id": 100050201,
					"content": "阿贝多，你果然在这里呀。嗯…你是在画画么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050202,
					"content": "嗯，之前太忙没空画画，最近正好闲下来，想着重新捡起画笔，练习一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050203,
					"content": "之前确实经历好多事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "是啊。但好在有你们和骑士团的大家协助，算是有惊无险地解决了那件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050205,
					"content": "而且，我还完成了老师留给我的最后一个课题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050206,
					"content": "要论结果，可以说是再完美不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050207,
					"content": "砂糖最近也学习得很快，已经能独立处理很多和炼金相关的事务了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050208,
					"content": "骑士团暂时也没什么需要我出面解决的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050209,
					"content": "没有课题，没有事务，没有麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050210,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "没什么。我想，或许是习惯了每天都高频用脑的日子吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050213,
					"content": "就这样完全地闲下来，老实说，我还真的有点不适应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050214,
					"content": "总是不由自主地思考，还有什么问题等待着我去解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050215,
					"content": "但是很遗憾，在目前的蒙德城，似乎所有问题都已经有了「完美的解」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050216,
					"content": "休息一下也没什么不好啊，要是每天都忙忙碌碌的，那身体不就累坏了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050217,
					"content": "实在不行，就和我们一起出去玩吧，我可是很懂怎么偷懒的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050218,
					"content": "呵呵，那就要请派蒙好好教教我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100050219,
					"content": "要是你真想找点麻烦解决…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "呸呸呸，不许说！每次你说这种话的时候，麻烦就会——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100050220,
					"content": "那也好办，只要有我在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "是遇见新麻烦了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
