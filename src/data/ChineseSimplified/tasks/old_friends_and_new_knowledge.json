							-801.068
						],
						"pointId": 13934
					}
				]
			},
			"dialogs": [
				{
					"id": 100051301,
					"content": "阿贝多，难得见到你这么闲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051302
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051302,
					"content": "不过，既然完成了莱茵多特主人留下的「课题」，你确实也应该放松放松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051303
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051303,
					"content": "你看！你话都没说完，麻烦就找上门了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051304,
					"content": "赛巴斯，你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051305
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051305,
					"content": "阿贝多认识它？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051306
					]
				},
				{
					"id": 100051306,
					"content": "是，它也是我老师莱茵多特的造物，勉强算是我的「家庭成员」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051307
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051307,
					"content": "不愧是你的家庭关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051308
					]
				},
				{
					"id": 100051308,
					"content": "勉强？你这是什么口气，那么大一个屋子，就我一个管家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051309
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051309,
					"content": "你和莱茵多特主人用过的瓶瓶罐罐，可都是我一只猫来清理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051310
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051310,
					"content": "你…不是一只猫吗？猫要怎么做管家啊，还要收拾瓶瓶罐罐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051311,
					"content": "你怎么会飞在天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051312
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051312,
					"content": "欸？我一直都会啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051313,
					"content": "我也一直都会。请不要把事实当做问题，这种问题找不到答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051314
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051314,
					"content": "你，你你你…好生气！我要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051315,
						100051316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051315,
					"content": "它的主人是莱茵多特…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				},
				{
					"id": 100051317,
					"content": "我…我要拒绝听它讲话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051318,
					"content": "闲话就到此为止。阿贝多，我此次前来，是受莱茵多特主人所命，向你递送口信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051319
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051319,
					"content": "咳咳…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051320
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051320,
					"content": "「亲爱的阿贝多，很高兴你为那个课题找到了『自己认可的解』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051321
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051321,
					"content": "「不过，被解答后的问题，就失去了为之思考的意义。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051322
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051322,
					"content": "「你脑子里那枚闲不下来的钟摆，现在应该已经快要摆向『无聊』那一端了吧？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051323
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051323,
					"content": "「那么，你不如尝试一下，自己向自己提问吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051324
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051324,
					"content": "「丢开『已知的答案』，寻找『未知的问题』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051325
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051325,
					"content": "「问题总是比答案更有趣的，也更能打发时间。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051326
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051326,
					"content": "「我很期待，下次见面时，你会给我带来什么样的『问题』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051327
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051327,
					"content": "「如果你能找到连我都未曾设想过的问题，那就最好了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051328
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051328,
					"content": "「虽然这种可能性不太大，但你还是先努努力吧，如果你运气够好，说不定真能吓我一跳。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051329
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051329,
					"content": "「对了，别想着造一个专门用来思考或者回答问题的『自己』。师父我已经试过了，压根没用。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051330
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051330,
					"content": "「最后说一句，我让赛巴斯顺便给你带了一份礼物，注意收起来，也别喂它吃东西，它根本不会饿。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051331
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051331,
					"content": "谨遵老师教诲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051332
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051332,
					"content": "咳，咳咳咳，莱茵多特主人就说了这么多…真是费劲，咳咳…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051333
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051333,
					"content": "你已经听到口信了，我就不在这个冷得要命的地方陪你玩了。我接下来还得去蒙德城里送口信呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051334
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051334,
					"content": "蒙德城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051335
					]
				},
				{
					"id": 100051335,
					"content": "蒙德城里还有和莱茵多特有关的人…啊！难道说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051336,
					"content": "虽然他刚刚「诞生不久」，但莱茵多特主人早已预见了他所需要解决的「课题」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051337
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051337,
					"content": "好了好了，我真的要走了，这地方太冷，冻得我尾巴痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051338
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051338,
					"content": "莱茵多特主人给你的「礼物」我放桌上了，记得收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051339
					],
					"speakerTitle": "赛巴斯"
				},
				{
					"id": 100051339,
					"content": "阿贝多…你的家庭关系，好像越来越复杂了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051340,
					"content": "又突然冒出来这么一只猫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051341
					]
				},
				{
					"id": 100051341,
					"content": "但话又说回来，这只猫真的能算成你的「家庭成员」吗？虽然它自称是管家什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051342,
					"content": "赛巴斯确实很早就被老师创造出来了。如果按照一般人的理论，赛巴斯应该算是我的「长辈」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051343
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051343,
					"content": "不过，鉴于我们并不是一般的「家庭」，所以这一层关系也没有意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051344
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051344,
					"content": "但我当时的确受了赛巴斯不少照顾，它除了帮我收拾瓶瓶罐罐外，有时候甚至会当我的素描模特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051345
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051345,
					"content": "等一下，你今天画的这只猫，难道就是赛巴斯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051346,
					"content": "没错。这是我的一个习惯，在思考某些问题时，我会让我的手进行一些无意识的工作，以此来辅助思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051347
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051347,
					"content": "这个时候，我一般就会选择默画赛巴斯的画像…毕竟画了不知道多少遍，已经很熟练了，基本不用动脑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051348,
						100051349
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051348,
					"content": "这么一说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051350,
					"content": "我还以为那就是普普通通的一只小猫呢！怎么来头也这么大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100051351,
					"content": "现在，你知道这只猫的真名了。之后要是有空，我可以为你们多讲一些它和我的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051352
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051352,
					"content": "但现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051353
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051353,
					"content": "「树为最完美的果实骄傲，它是如此圆满而无瑕疵。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051354
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051354,
					"content": "「但是寄宿了梦的种子啊，不要止当果壳中的宇宙之王。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051355
					],
					"speakerTitle": "「莱茵多特」"
				},
				{
					"id": 100051355,
					"content": "…我要继续思考了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 100051349,
					"content": "之前确实见过阿贝多画猫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051316,
					"content": "派蒙，不然还是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				}
			]
		},
