					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "差不多要到时候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150102,
					"content": "哦呀，欢迎光临，阁下是遇见什么难题了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150103,
					"content": "唔，原来如此，你…没遇见什么难题，只是想要「随便逛逛」而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150104,
					"content": "这里是「万端珊瑚侦探社」，是一个很寻常的地方，而我嘛…是一个侦探。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150105,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "我叫珊瑚，是这家侦探社的社长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150107,
					"content": "不过，虽然说是社长，但这家侦探社也只有两个员工罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150113,
					"content": "怎么，你是第一次看见这种侦探社吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150108,
					"content": "侦探是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "喔，这是个好问题。从一般人的视角来看，侦探这种职业也许特殊又神秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150110,
					"content": "但要我来说，侦探也只是一种「拿钱办事」的普通职业罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150111,
					"content": "虽然办的事有时候会不太寻常，委托人偶尔也有些特别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150112,
					"content": "但无论如何，都脱不开「拿钱办事」这个行事主旨就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201504",
