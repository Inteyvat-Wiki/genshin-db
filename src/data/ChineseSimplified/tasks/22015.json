			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "原来如此，你就是社长说的「帮手」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150206,
					"content": "你知道我要来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "唔…倒也不是。只是社长说，会有人来帮忙，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150208,
					"content": "喂，你们在做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150209,
					"content": "那些是盗宝团吗？为什么会离城里这么近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150210,
					"content": "龙二，你怎么也在这，还有这个可疑的外国人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150211,
					"content": "你说我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "对啊，这里的外国人也就你一个啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150215,
					"content": "好了，你也别太敏感了。龙二，你在这里做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150216,
					"content": "我只是根据社长的指示，跟踪可疑的人来到这里，但是却遇见了盗宝团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150217,
					"content": "这位旅行者确实是社长请来的帮手，刚才和我一起击退了那些盗宝团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150218,
					"content": "这样吗…但是，这附近为什么会出现盗宝团？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150219,
					"content": "龙二，你刚才还说什么，跟踪可疑的人…喂！难不成，你是从城里跟踪盗宝团过来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150220,
					"content": "正是如此。社长之前正在处理一桩连续盗窃案，根据社长的推理，我在城里四处搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150221,
					"content": "随后，我在花见坂附近发现了可疑的人。但只是略微盘问了几句，他就慌张地离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150222,
					"content": "我追着他出了城，之后的事，你们都了解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150223,
					"content": "喔…龙二，你小子怎么突然这么会说话了，之前你不是都不怎么说话的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150224,
					"content": "跟着珊瑚做事，把口才也锻炼得不错了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150225,
					"content": "你们是来做什么的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "是安藤这家伙，说有个可疑的金发外国人在城里乱转，想要跟过来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150227,
					"content": "所以我俩才跟着你到了这里，没想到你居然是珊瑚的助手，误会了你，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150232,
					"content": "啊…不过龙二，你刚才说，你是在城内发现的那个可疑人士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150233,
					"content": "正是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150234,
					"content": "这群家伙居然还真的敢把手伸进城里来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150235,
					"content": "正是如此。只凭我们…只凭我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150236,
					"content": "（他怎么突然说话卡壳了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "喔…只凭我们，也只能赶走一两个盗宝团。想要彻底赶走盗宝团，还是得拜托你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150239,
					"content": "二位…如果还想看看证据的话，可以去城里找社长，她会再详细地和二位解释。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150240,
					"content": "是吗…天野，那我们就去找珊瑚吧，要是城里真的有盗宝团作乱，那可不能放着不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150241,
					"content": "喔…喔！那我们去找珊瑚了，龙二，你们也快点回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150242,
					"content": "…呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150243,
					"content": "我们回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150244,
					"content": "你刚才说的那些话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "是社长的交代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150246,
					"content": "事情已经办好了，我们回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150237,
					"content": "（他怎么像是忘词了一样…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "你们也是追着可疑人士来的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "这么说也没错，但我俩追着的可疑人士其实是你，咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150230,
					"content": "是安藤这家伙，说有个可疑的金发外国人在城里乱转，想要跟过来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150231,
					"content": "所以我俩才跟着你到了这里，没想到你居然是珊瑚的助手，误会了你，抱歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150213,
					"content": "我是珊瑚的帮手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "珊瑚的帮手？听起来反倒更可疑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "安藤"
				}
			]
		},
		{
