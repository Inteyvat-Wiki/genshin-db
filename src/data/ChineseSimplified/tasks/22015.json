				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201505",
							"2"
						],
						"stepId": 2201505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "珊瑚小姐，你刚才说的都是真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150302,
					"content": "城里的连环盗窃案，真的是那些混账盗宝团干的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150303,
					"content": "那是当然。刚才我也给你看过那些证据了，凭二位的「职业直觉」…心里应该也已经有了判断吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150304,
					"content": "这群盗宝团…真是胆大包天！这是不把我们放在眼里吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150305,
					"content": "天野！我们快回去，把这件事往上报告吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150306,
					"content": "一定要再加强巡逻，不能给这群混账一点可乘之机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150307,
					"content": "珊瑚小姐，这些证据可以先借给我们一下吗？我们要用来说服大人们采取措施。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150308,
					"content": "没问题，尽管拿走吧。毕竟盗宝团作乱这种大事，可不是我们侦探社能够处理的，只能拜托奉行所的大人们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150309,
					"content": "放心吧！这群盗宝团…我们绝对一个都不放过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150310,
					"content": "辛苦你们了。现在…应该已经准备得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150311,
					"content": "准备？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "是，这两位奉行所的同心大人，可是结掉我手里这个案子的重要「帮助」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150316,
					"content": "在这两位同心大人加强巡逻后，城里的盗宝团一定也会提起警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150317,
					"content": "龙二，在我让你去的那个地方，你应该和那些盗宝团交过手了，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150318,
					"content": "是的，社长，那些盗宝团都被我和这位旅行者击退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220150319,
					"content": "嗯…这样就好，你们折腾出的动静应该已经够大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150320,
					"content": "接下来我们要做的，就是再等一个机会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150321,
					"content": "辛苦你了旅行者，这些是报酬，请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150322,
					"content": "我好像也没帮什么忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "可不能这么说。以外国人的身份吸引住安藤，让他带着天野追着你和龙二汇合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150324,
					"content": "然后，让他们亲眼发现盗宝团的威胁，然后顺理成章地在城里加强巡逻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150325,
					"content": "这些，可都是只有你才能做到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150326,
					"content": "毕竟，比起我去告诉他们，让这两位同心「亲自发现」盗宝团的事，效果才更好嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150327,
					"content": "总之，收下这些东西吧，说不定…我之后还会再找你帮忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150313,
					"content": "你要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "我是侦探，要做的事，当然是要断案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150315,
					"content": "这两位奉行所的同心大人，可是结掉我手里这个案子的重要「帮助」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "珊瑚"
				}
			]
