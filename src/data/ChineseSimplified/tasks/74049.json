			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#是带来异国花朵的{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490102,
					"content": "你好啊柯莎。我们带来的花，成长得怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490103,
					"content": "这个…柯莎已经一天没去看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490104,
					"content": "欸，不是很喜欢我们带来的花吗，为什么不去看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490105,
					"content": "异国的花，那么难得，柯莎想要赶紧去照料它。可是一想到它可能会在眼前枯萎，就不敢去看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490106,
					"content": "#不会吧，都在意成这个样子了？…不如我们一起去看看吧！如果遇到什么问题，派蒙和{NICKNAME}会帮助你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490107,
					"content": "光提心吊胆也不是办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "#…说得对，我们一起去吧！有派蒙和{NICKNAME}帮助，柯莎就有信心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
