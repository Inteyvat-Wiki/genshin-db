					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "呜呜呜…宝贵的花朵，被弄坏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490202,
					"content": "真是好可惜…原来花儿无法成活，是因为隙境原体在搞破坏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490203,
					"content": "…柯莎，柯莎从此要守在花朵旁边，一步也不离开了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490204,
					"content": "冷静一点啊，柯莎，我们一起来想想办法吧！话说回来，隙境原体为什么会破坏花圃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490205,
					"content": "柯莎之前带别的花回来时…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "从没有过！哼，这些坏家伙，只敢躲着我做坏事！柯莎好生气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490208,
					"content": "哇啊…没想到柯莎也会有这么气愤的时候。看来是真的非常在意这些花朵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490209,
					"content": "但是，回忆一下的话，刚才柯莎靠近的时候，隙境原体也没有主动躲开啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490210,
					"content": "或许吸引隙境原体的不是花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "对呀，也有这种可能，我们调查一下花圃周围的情况吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490206,
					"content": "…被隙境原体找过麻烦吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
