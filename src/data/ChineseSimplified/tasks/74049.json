						],
						"stepId": 7404908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莎"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#{NICKNAME}真厉害，把丑丑的机关，「咚」地一下变成了美丽的零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490302,
					"content": "这样一来花圃应该不会被打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "虽然已经被糟蹋了一些，但剩下的花好像状态还不错。隙境原体也不会再来捣乱了，柯莎的花可以茁壮生长啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490304,
					"content": "太好了…不过，柯莎已经吸取了教训，对宝贵的花朵要小心看护，小心照顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}和派蒙…送来了异国的花，还帮柯莎保护花圃。柯莎要怎么报答…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490306,
					"content": "不必那么客气啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490307,
					"content": "#对了，还有柯莎亲手采到的花朵，最珍贵的花朵！就把这个送给{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490308,
					"content": "#哦！既然是这么珍贵的花朵，不如{NICKNAME}也开辟一片花圃把它种下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490309,
					"content": "话说这不是汐藻吗？汐藻也算是花吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490310,
					"content": "汐藻是植物，汐藻又很美丽，当然属于花朵啦。这是人类的「生物学」，为了成为厉害的花匠，柯莎学了一点，哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490311,
					"content": "总觉得哪里不对，可我也不太懂那些分类理论啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490312,
					"content": "柯莎以后要继续努力，成为更厉害的花匠。听人类说，厉害的花匠会培育出新品种的花，拿去参加「园艺会」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490313,
					"content": "柯莎也要培育出新品种，在「园艺会」上赢得「奖项」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490314,
					"content": "柯莎的劲头倒是很不错，不过好像还有很多难以解释的误会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490315,
					"content": "参加园艺会，就是说要把自己培育的新品种拿去给人类鉴赏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490316,
					"content": "柯莎的感官和审美，跟人类差别太大了…她培育的新品种花朵，在人类看来会不会很奇怪啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490317,
					"content": "派蒙真关心柯莎的园艺事业啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "那当然了！我可是柯莎的园艺教师。要是柯莎能参赛获奖，我脸上也有光彩嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490319,
					"content": "不必太在意奖项，最重要的是开心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "…也对哦！柯莎认为自己培育的花美丽就够啦！旁人的评价也没有那么重要吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490321,
					"content": "柯莎要照顾好花圃，看着美丽的花，每天都开开心心的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490322,
					"content": "嗯！柯莎会让异国的花茁壮成长的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				},
				{
					"id": 740490323,
					"content": "至少已经成功地迈出了第一步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "对哦，柯莎培育出的品种可能会有些不寻常，但有些人就是喜欢独树一帜的东西嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490325,
					"content": "#柯莎！培育出了新品种之后，要第一个告诉派蒙和{NICKNAME}哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740490326,
					"content": "#没问题，派蒙和{NICKNAME}帮了柯莎那么多!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莎"
				}
			]
		},
