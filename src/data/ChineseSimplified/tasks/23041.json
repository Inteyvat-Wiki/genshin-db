					"nextDialogs": [
						230410314
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410314,
					"content": "我就是想请你去帮我采三枚「墩墩桃」回来，里夫很喜欢吃这种水果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410315,
					"content": "我想把它们加入「薄荷豆汤」里，然后送去给里夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410316,
					"content": "现在「薄荷豆汤」我已经会做了，就等人帮我去拿「墩墩桃」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410317,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "谢谢你啦，等你回来之后，我再请你喝一碗「薄荷豆汤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410321,
					"content": "那就拜托你了，旅行者。采到「墩墩桃」后就带回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内尔敏"
				},
