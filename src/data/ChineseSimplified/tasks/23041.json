			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"内尔敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "呼…这样松土应该就可以了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410102,
					"content": "你还在照顾这盆花吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "嗯，库尔苏姆奶奶教了我很多照顾花的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410104,
					"content": "比如要给它松土啦，定时修剪叶片啦，用各种方法除虫啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410105,
					"content": "还有浇水不能浇得太多，不然花的根部就会被水泡烂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410106,
					"content": "哎呀，我还以为要每天浇花，时刻让土壤保持湿润呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410107,
					"content": "不过这样也好，我就不用每天都去打水了，取水的地方离这里可远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410108,
					"content": "我得接着修剪枝叶，旅行者，你能帮我去打一小壶水过来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410109,
					"content": "我已经和卡桑说过了，他答应我可以去取水浇花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410110,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "水壶就在那边，你打水的时候可要注意喔，可不要打上来太多泥沙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410111,
					"content": "这都是库尔苏姆奶奶告诉你的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "唔…差不多吧，库尔苏姆奶奶知道的事可多了，我经常去找她请教呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410113,
					"content": "那就拜托你了，旅行者，只要打一小壶水过来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "内尔敏"
				}
			]
		},
		{
			"id": 2304102,
			"completionStepIds": [
				2304101,
