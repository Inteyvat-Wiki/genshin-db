			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"内尔敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "旅行者，你来得正好，快来尝尝我做的薄荷豆汤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410303,
					"content": "这些材料是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "有些是我托人买回来的，但是薄荷嘛…是我自己种的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410305,
					"content": "里夫不是送了我一套园艺工具，还有一堆肥料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410306,
					"content": "如果仅仅是种一盆花，我觉得实在是太浪费了…所以，我就拜托阿扎莱帮我买了一些薄荷种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410307,
					"content": "把薄荷种子种下去之后，我就和照顾那盆花一样照顾着它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410308,
					"content": "照顾着照顾着，薄荷就顺利地成长…成熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410309,
					"content": "我就采了一些下来，做成了「薄荷豆汤」，怎么样，味道还不错吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410310,
					"content": "那…你既然喝了我做的「薄荷豆汤」，就得帮我个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410311,
					"content": "那个，我没喝完…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "别呀！我开玩笑的，会好好付给你报酬的啦！",
