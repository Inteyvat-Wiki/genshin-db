			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"内尔敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "呜…又有几片叶子被咬破了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410202,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "旅行者，你看呀！又有小猫过来咬花了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410204,
					"content": "你看这片叶子，这片…还有这片！都被咬下去了一大块！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410205,
					"content": "小猫饿了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "里夫也这么说，他还专门带着吃的到处去喂猫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410207,
					"content": "但是第二天，还是有小猫过来咬花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410210,
					"content": "现在小猫只是咬叶子，但我就怕小猫有一天开始咬花茎…那可就糟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410211,
					"content": "不过，我也狠不下心去把它赶得很远，毕竟外面就是沙漠，它除了这个村子之外，也无处可去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410212,
					"content": "旅行者，你能帮我再去喂喂它吗？希望小猫吃饱了之后，别再来咬花了，花叶也不是什么好吃的东西呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410213,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "那就拜托你了，旅行者，我把那只小猫经常待的地方给你标在地图上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410217,
					"content": "我要在这盆花旁边守着，免得又有其他的小猫过来咬花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410214,
					"content": "我很擅长和猫打交道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "那样就最好了！我每次看见小猫的爪子，都担心它会突然扑上来给我一爪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "内尔敏"
				},
				{
					"id": 230410208,
					"content": "小猫是…咬着玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "我是弄不清小猫喜欢玩什么啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "内尔敏"
				}
			]
		},
		{
			"id": 2304103,
