					"nextDialogs": [
						722640635
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640635,
					"content": "唔…有什么好地方…有什么好去处呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640636,
						722640637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640636,
					"content": "慢慢想吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640638
					]
				},
				{
					"id": 722640638,
					"content": "…嗯，等想到了再说吧！现在肚子好饿，脑子转不动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640639,
					"content": "吉法师就放心交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640640,
					"content": "就交给你们了呶。",
