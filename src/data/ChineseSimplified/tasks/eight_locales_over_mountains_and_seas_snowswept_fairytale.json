					"nextDialogs": [
						722640632
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640632,
					"content": "所以，就由你们决定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640633
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640633,
					"content": "喔，说得很好嘛！放心交给我们吧！我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640634,
					"content": "加油！加油！",
