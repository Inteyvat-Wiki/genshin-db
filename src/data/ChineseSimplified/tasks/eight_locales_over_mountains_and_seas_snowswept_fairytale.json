						722640213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640213,
					"content": "呶！是雪！好冷好冷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640214
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640214,
					"content": "吉法师看起来好高兴。",
