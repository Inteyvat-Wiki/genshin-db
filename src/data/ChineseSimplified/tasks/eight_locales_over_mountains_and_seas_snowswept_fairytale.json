					"nextDialogs": [
						722640518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640518,
					"content": "不笑了。一起笑才是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640519
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640519,
					"content": "可恶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640520
					],
					"speakerTitle": "派蒙"
