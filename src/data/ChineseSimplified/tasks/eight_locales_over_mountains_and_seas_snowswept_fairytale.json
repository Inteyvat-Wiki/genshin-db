					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640217,
					"content": "#欸，这个问题问得好。{NICKNAME}，你觉得雪是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640218,
						722640221,
						722640224
