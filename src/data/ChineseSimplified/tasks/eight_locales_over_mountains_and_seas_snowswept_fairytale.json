					"nextDialogs": [
						722640605
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640605,
					"content": "啊，对了！还有纪念品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640606,
					"content": "向五百藏展示吉法师在雪山的相片。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722640607
					]
				},
				{
					"id": 722640607,
					"content": "咿——吉法师！吉法师怎么被封印在纸里面了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640608
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640608,
					"content": "这是、这是「地狱绘」？怎么会在你的手里？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640609,
						722640612
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640609,
					"content": "人类的法术很厉害吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640610
					]
				},
				{
					"id": 722640610,
					"content": "呜呶呶，怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640611
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640611,
					"content": "好啦好啦，别欺负五百藏啦。那是「相片」，是一种画。你看，吉法师不是好好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640614,
					"content": "耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640615
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640615,
					"content": "咦？两个吉法师…？欸？欸？这是什么法术？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640616
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640616,
					"content": "…哦，原来如此，是法术嘛！哈哈哈，吉法师，进步很快嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640617
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640617,
					"content": "呶哈哈。笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640618
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640618,
					"content": "真是的，好好听人说话啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640619,
					"content": "多花费了一番口舌，向五百藏解释。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722640620
					]
				},
				{
					"id": 722640620,
					"content": "…呶，吾辈可是大名鼎鼎的妖狸大王！怎么会不知道「楼影鸡」是什么。吾辈只是考考吉法师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640621
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640621,
					"content": "好不知所谓喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640622,
					"content": "强词夺理。呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640623
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640623,
					"content": "咳咳。不管怎么说，看来吉法师的修行很顺利。",
