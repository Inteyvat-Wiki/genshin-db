			},
			"dialogs": [
				{
					"id": 722640101,
					"content": "呜呜…虽然之前把山顶那个「大柱子」升起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640102,
					"content": "不过，不管来多少次，龙脊雪山都这么冷…好难受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640103,
					"content": "呶哈哈，白毛弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640104
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640104,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640105,
					"content": "吉法师不怕冷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640106
					]
				},
				{
					"id": 722640106,
					"content": "呶呜呜，好冷好冷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640107
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640107,
					"content": "什么嘛！气死我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640108,
					"content": "不过，好好玩。白色的到处都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640109
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640109,
					"content": "白色的…啊，那些是「雪」喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640110,
					"content": "「雪」…「樱吹雪」的雪？神樱树？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640111
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640111,
					"content": "不是啦，雪就是龙脊雪山这些很冷很冷的白色东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640112,
					"content": "不过，吉法师竟然知道樱吹雪这样的词，应该说不愧是稻妻的妖狸吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640113,
					"content": "呶！是雪！好冷好冷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640114
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640114,
					"content": "吉法师看起来好高兴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640115
					]
				},
				{
					"id": 722640115,
					"content": "山有雪所以冷，还是山很冷所以雪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640116
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640117,
					"content": "#欸，这个问题问得好。{NICKNAME}，你觉得雪是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640118,
						722640121,
						722640124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640118,
					"content": "是水元素吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640119
					]
				},
				{
					"id": 722640119,
					"content": "唔…如果是这样的话，那就是因为这里很冷，所以水元素结冰了，变成了雪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640120,
					"content": "好冷好冷。好多雪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640128,
					"content": "不管怎么说，这种事情，以后有机会问问丽莎这样知识渊博的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640129,
					"content": "龙脊雪山真的好冷。之前，向山顶前进的时候，感觉有几次都冷得意识模糊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640130,
					"content": "不过，风景也很不错！既然从影向山上能看到这里，那从山顶上也能看到影向山吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640131,
					"content": "而且星荧洞窟很深，里面可能还有什么没发现的宝藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640132,
					"content": "宝藏！宝藏好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640133
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640133,
					"content": "吉法师和派蒙说不定很合得来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640134
					]
				},
				{
					"id": 722640134,
					"content": "哼哼，没有宝藏，怎么过好日子、吃好东西。吉法师挺懂的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640135,
					"content": "吉法师想在雪里玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640136
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640136,
					"content": "嗯，别着凉哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640137,
					"content": "如果遇到危险的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640138
					]
				},
				{
					"id": 722640138,
					"content": "大喊「有宝藏」就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640139
					]
				},
				{
					"id": 722640139,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640121,
					"content": "是冰元素吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640122
					]
				},
				{
					"id": 722640122,
					"content": "欸？是这样吗？这样的话，就是因为雪是冰元素，所以让这里变得很冷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640123,
					"content": "好冷好冷。好多雪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722640124,
					"content": "是凯亚干的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640125
					]
				},
				{
					"id": 722640125,
					"content": "「小心着凉！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640126,
					"content": "不对！再怎么说，凯亚也没这么厉害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640127,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法师」"
				}
			]
		},
