			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"叶名山薰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "糟糕了…这下怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260102,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "您…太好了，您来了…是这样，您给了我花种之后，我就开始种花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260104,
					"content": "但我还没种多少，就突然出现了一群魔物，一直在我准备种花的地方待着，我已经不敢过去种花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260105,
					"content": "再放任它们这样折腾下去，说不定原本种了花的地方也会被它们糟蹋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260106,
					"content": "如果您愿意的话，能帮我赶走那群魔物吗？我、我只是想要种花而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260107,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "您答应了？太谢谢您了！那就拜托您了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260109,
					"content": "为什么这么执着种花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "我是想，大家之所以不愿意回踏鞴砂，应该也是担心经历了「御影炉心」这种事之后，这里已经不太适合居住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260111,
					"content": "我没办法一个一个地说服所有人，但是，如果我能在这里重新种出很多好看的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260112,
					"content": "也许就能说服大家，让大家相信踏鞴砂已经安全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260113,
					"content": "而且…嘿嘿，除了种花之外，我也没有什么能说服大家的手段了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721260114,
					"content": "所以，拜托了，请您帮我去赶走那群魔物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶名山薰"
				}
			]
		},
