			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "重逢…比我想象的来得更早些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010102,
					"content": "呀，是戴因！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010103,
					"content": "看你们的表情，好像刚经历过什么怪异的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010104,
					"content": "难道是在那座遗迹里，和「深渊使徒」打过照面了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010105,
					"content": "欸，戴因怎么会知道？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010106,
					"content": "我仍在继续追猎「深渊使徒」，也没料到会在这里遇上你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010107,
					"content": "其实，我们经历的不止是使徒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "倒挂的神像…手中的深渊能量？不，我在与深渊对抗时，也没见过类似的事物。但…我有所猜测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010110,
					"content": "先把你们的经历说完吧。你们逃离了深渊能量弥漫的遗迹底层，然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010111,
					"content": "然后我们在接近遗迹出口的时候，被突然出现的「深渊使徒」拦截了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010112,
					"content": "我们和那家伙大战了一番，说不定它现在还没走远？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010113,
					"content": "嗯，机会难得，随我一起追上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010114,
					"content": "好的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "走吧！机会难得，还有戴因帮忙，说不定这次能解开很多谜题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010115,
					"content": "不，我记得好像我才是雇主…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "遗迹里还有更深层的怪异。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800103",
							"2"
						],
						"stepId": 800103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "刚才那些深渊法师…是准备埋伏我们的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010202,
					"content": "不，他们只是在那些遗迹守卫的遗骸里，翻找着什么东西而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010203,
					"content": "是这样吗…旅行者好像也经常这么做呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010204,
					"content": "什么「混沌装置」、「混沌回路」之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010205,
					"content": "对，那都是很重要的素材！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "不会是这么普通的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010208,
					"content": "我之所以在附近调查，就是因为从那座遗迹里，时不时会有深渊法师外出探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010209,
					"content": "它们似乎是想要从遗迹守卫的遗骸中，找到一件「特定的珍贵之物」，带回遗迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010210,
					"content": "不过，看它们失望的样子，至少目前应该还没找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010211,
					"content": "那么刚才怎么不抓住它们好好问问呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010212,
					"content": "迪卢克老爷好像这么做过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "我当然没准备对这些家伙仁慈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010215,
					"content": "只是冥冥中感觉到，这件事对整个深渊教团来说，意义非凡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010216,
					"content": "它的真相，不是通过拷问就能得到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010217,
					"content": "或者说，这些深渊法师，原本就面对着比任何拷问都更深的恐惧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010218,
					"content": "恐惧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "欸…欸…这种汗毛直立的感觉是怎么回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010221,
					"content": "好了，别在这里耽搁太久，我们继续追迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010219,
					"content": "会与遗迹里的事物有关吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "对它们可以残酷一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "深渊法师应该不是在找那些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "呼…除了深渊教团，遗迹守卫在这一带也很活跃呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010302,
					"content": "感觉深渊法师蛰伏的地方，也经常会有遗迹守卫游荡，这是什么巧合吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010303,
					"content": "世上没有什么巧合，一切都是在久远的过去埋下的种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010304,
					"content": "就像那间酒馆里你的出现一样…时间只是等它发芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010305,
					"content": "可我只是偶然听说了你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "没事，一些不必要的感慨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010308,
					"content": "深渊教团和遗迹守卫的联系，当然不是巧合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010309,
					"content": "应该说，是同一根系延展而出的枝杈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010310,
					"content": "根系？枝杈？你的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010311,
					"content": "它们都源自五百年前覆灭的古国——「坎瑞亚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010312,
					"content": "欸？坎瑞亚？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010313,
					"content": "居然是这样…深渊教团和遗迹守卫，居然是坎瑞亚灭国之后的残余吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010314,
					"content": "说到坎瑞亚，那真是一个非常久远的名字了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010315,
					"content": "哦，对了。作为向导，我还是跟旅行者解释一下吧。「坎瑞亚」这个国度，是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010316,
					"content": "我知道「坎瑞亚」这个名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010318,
					"content": "因为，我有在坎瑞亚的记忆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "你有记忆？可那是五百年前就已经覆灭的国度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010320,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010321,
					"content": "是吗，人皆有秘密，你没有追问过我时间的事，我也不会追问你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010322,
					"content": "但若你愿意对我说，我也会听。那么——你所见到的坎瑞亚，是怎样的一副景象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010323,
					"content": "（已经不是能继续隐瞒的时候了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "原来那时发生的事，完整顺序是这样的呀…我还以为，你一开始就遇见了那位陌生的神灵呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010327,
					"content": "#嗯…降临此世之后，你最初的复苏，就是被{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}从陨星中唤醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010328,
					"content": "#看来你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}比你先醒呢，就是不知道比你早了多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010329,
					"content": "#然后，你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}告诉你，坎瑞亚的灭亡导致天变地异，要你一起离开这个名为提瓦特的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010330,
					"content": "#「坎瑞亚的灭亡」？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_FEMALE_PRONOUN_HE]}是这样说的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010331,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "你们经历了那次灾变，那是…五百年前的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010334,
					"content": "看来你在这个世界的第一次苏醒，也是在那个时期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010335,
					"content": "#嗯…这样说来，你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}，因为先醒的关系，当时比你更了解这个世界吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010336,
					"content": "而此事的后续，就是你们很快就遇到了一位拦住去路的陌生神灵，未能逃离…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010337,
					"content": "唔，这件事是我听得最熟的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010338,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010339,
					"content": "当时你刚苏醒，又匆忙想要离开这个世界，完全不知道「坎瑞亚」这个地名的任何背景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010340,
					"content": "但现在对提瓦特有了一些了解以后，就猜想当年经历的那一战，正是「坎瑞亚覆灭之战」，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010341,
					"content": "啊，这么说来，我们一起旅行的这几个月里，你好像查过不少古籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010342,
					"content": "去蒙德前，只看过一些模糊的资料，后来又在蒙德、璃月各地收集过一些旧书，你都说「用处不大」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010343,
					"content": "#原来你其实是想知道更多关于坎瑞亚的事，而且是为了寻找{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010344,
					"content": "那是仅次于「七神」的线索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "嗯，也是。要寻找七神，可以踏遍七国。但五百年前毁灭的坎瑞亚，现在已经找不到了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010347,
					"content": "关于坎瑞亚的事，我知道的应该比你们多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010348,
					"content": "坎瑞亚是没有神明的国度——神明并非死亡或离开，而是从一开始就不存在于坎瑞亚的历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010349,
					"content": "这是单纯由人类建起的强大国度，人类以它空前的繁荣与辉煌文明而自傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010350,
					"content": "神…不存在的…国度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010351,
					"content": "而之后的事，也正如你留下的记忆——所有一切，都毁于神灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010352,
					"content": "你的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010353,
					"content": "五百年前，是众神一同降临，覆灭了坎瑞亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010354,
					"content": "将所谓「人类的骄傲」，如同杂草一般，从神明的花园中铲除…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010355,
					"content": "怎么会这样…历史书上都没有提过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010356,
					"content": "非常过分…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "嗯，继续在这里谈论旧事，会消磨人的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010359,
					"content": "（但，下次见到温迪和钟离的时候…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "先继续前进吧。关于你想知道的那些事，我就在这一路上继续告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010360,
					"content": "（恐怕有必要听听他们作何解释。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#危险的世界…更想尽快找到{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "虽然是只有「一个地名」的线索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "当时听到的，就是这句话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "（戴因与坎瑞亚…就当作赌一次吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "（叫醒我的人…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "（还有，我刚醒来就看见的那片火海…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "有点…听不明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
							"2"
						],
						"stepId": 800107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "欸，从这个深渊法师身上冒出的这段符咒是…难道会是「信」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010402,
					"content": "嗯，这股气息，无疑与「深渊使徒」有关。既然带在深渊法师身上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010403,
					"content": "或许，真的会有关于它们行动的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010404,
					"content": "可是，上面的文字好像读不懂欸，是坎瑞亚的文字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010405,
					"content": "#「…将敌人的信仰作为薪柴，为高贵的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_GIRLD|INFO_FEMALE_PRONOUN_BOYD]}殿下献上荣光…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010406,
					"content": "啊，这是…信里的内容？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010407,
					"content": "「——『命运的织机』，原动计划。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010408,
					"content": "它们…「深渊」，似乎正在执行一个计划。计划的关键词是…「命运的织机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010409,
					"content": "目前似乎还在启动阶段，或者说，还在进行最初的试验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010410,
					"content": "「命运的织机」？那是什么？字面意思感觉是…「纺织命运的机器」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010411,
					"content": "深渊法师是从那座遗迹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "欸，这么一说，从气氛上讲，那座诡异的遗迹，和这个计划有关联的可能性很大呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010414,
					"content": "所以戴因，信里面究竟是怎么讲的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010415,
					"content": "我正在读…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010416,
					"content": "嗯…天马行空的计划，也有些难以理解的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010417,
					"content": "怎么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010418,
					"content": "一言以概之，初步的计划，与「漩涡之魔神」奥赛尔有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010419,
					"content": "「漩涡之魔神」！是海里的那个魔神吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010420,
					"content": "上次，没能消灭它…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "不过说起来，他们想要对奥赛尔做什么？唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010423,
					"content": "难道，和特瓦林一样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "嗯，我了解过你们的事迹，也很清楚深渊教团对「龙灾」的涉足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010425,
					"content": "虽然并非有意为之，但你们确实已经阻止过一次深渊教团的类似计划了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010426,
					"content": "之前是「神的眷属」，现在是「旧日魔神」吗…目标越来越大了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010427,
					"content": "这一次，「深渊」也和对特瓦林一样，想要用谎言和咒术来腐蚀奥赛尔吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010428,
					"content": "不…从「信」的内容来看，这一次的计划，是更进一步的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010429,
					"content": "不仅是意志层面的改造——它们准备用制造「耕地机」的技术，彻底改造奥赛尔的肉体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010430,
					"content": "这…这种事也做得到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010431,
					"content": "难道深渊教团想要制造…「终极杀人机器，机械魔神乌贼」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010432,
					"content": "听起来大致是这个意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "如今这世上，已经很少有人真正了解坎瑞亚的文明程度，当然也难以去做评判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010435,
					"content": "只有深渊教团一直在追寻坎瑞亚遗落的文明——虽然他们已经连人类都不是了，但执念仍存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010436,
					"content": "信中说，它们要用那座「污秽逆位神像」作为基底，接合奥赛尔的肢体，制造机械魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010437,
					"content": "而用来替换神像手中宝珠的「新的核心」，是…「世上第一座耕地机的眼睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010438,
					"content": "世上第一座耕地机的眼睛？…哦！我明白了，那些深渊法师一直在搜索的，就是这个吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010439,
					"content": "想必如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010440,
					"content": "它们还没找到，我们还有时间。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "越说越复杂了啊。不过果然还是和那座…诡异的七天神像有关吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010443,
					"content": "是的。根据信上所说，将「眼」置于「污秽逆位神像」之手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010444,
					"content": "就能为新诞生的污秽魔神，赋予「动摇天空岛上神座」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010445,
					"content": "（天空岛…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "呜…这个计划想要对抗的东西，真是巨大到不可思议呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010448,
					"content": "说起来，既然现在没人知道「世上第一座耕地机」在哪里，那不如…先从「神像」这个信息入手调查？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010449,
					"content": "那座神像，是风神像的模样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "嗯，那个到处卖唱的诗人太难找了，不如先去<color=#00E1FFFF>西风大教堂</color>了解一下情况吧，说不定会有什么眉目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010452,
					"content": "教堂…哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010453,
					"content": "嗯？戴因，怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010454,
					"content": "没什么，先过去再说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010450,
					"content": "去问问西风教会的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "（动摇神座…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "抢先一步，找到它吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "绰号的长度增加了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "只是被群玉阁再次镇压…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "会与逆位的神像有关吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "看那边，又是遗迹守卫和深渊法师。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010502,
					"content": "戴因刚才说，这些古代机器也是源于坎瑞亚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010503,
					"content": "莫非，坎瑞亚有很多遗迹需要保护？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010504,
					"content": "不。「遗迹守卫」这个名字，是现代人根据现代的「印象」取的。五百年前没有人这样称呼它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010505,
					"content": "现在被称作遗迹守卫的这些机器，当年在坎瑞亚的代号是，「耕地机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010506,
					"content": "耕地机？好奇怪的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010507,
					"content": "原来是农具吗？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "并不是你们想的那样。所谓「耕地机」，其实是一种代号。当年的坎瑞亚人会为兵器创造代号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010510,
					"content": "「土地不是用农具去犁的，而是用铁与血去争夺的。」——基于这样的理念，「耕地机」诞生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010511,
					"content": "用铁与血去争夺土地？坎瑞亚人居然这样理解「耕地」…感觉不是什么好的含义呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010513,
					"content": "在坎瑞亚覆灭以后，这些失去主人的「耕地机」便纷纷脱离了控制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010514,
					"content": "在漫长的时光中不断游荡，逐渐散落在了提瓦特大陆的各个角落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010515,
					"content": "可能是与同样覆灭了的其它古文明，同病相怜的缘故，它们才常常驻留在各类遗迹中，休眠假寐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010516,
					"content": "听上去…感觉很可怜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010517,
					"content": "五百年漫无目的的游荡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "好了，再深入了解下去，那些细节对你们就没有什么意义了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010521,
					"content": "但不论过去如何，至少现在它们只余下「威胁」的部分了。把它们全都解决了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010518,
					"content": "看来…要多多终结它们的痛苦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "嗯…怎么说呢？你做得一直都不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010508,
					"content": "可那些杀伤性的武器是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
}