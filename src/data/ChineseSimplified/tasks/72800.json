						"rawParams": [
							"7280010",
							"2"
						],
						"stepId": 7280010,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280011",
							"2"
						],
						"stepId": 7280011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭东",
					"朱莉",
					"芭尔瓦涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "本来想要找点新鲜食材…算了，这些应该也能用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000302,
					"content": "抱歉啦，本来是想给你做点好吃的，现在看来，只能凑合做点了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000303,
					"content": "没关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "你这么辛苦护送我们，可不能一句「没关系」就略过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000305,
					"content": "这顿饭我先记下，下次一定请你吃顿好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000308,
					"content": "朱莉，炖的汤应该好了吧？记得别让芭尔瓦涅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000309,
					"content": "唔唔，不、不要啦，只要让汤安安静静地炖着就好了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000310,
					"content": "没关系，我可是按照我改良过的食谱在给这份汤调味，只不过是放一点调料而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000311,
					"content": "那份你改良过的食谱我都看不懂啦，快点住手！旭东，旭东快来呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000312,
					"content": "芭尔瓦涅！喂！你又在往里面放什么奇怪的调料！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000313,
					"content": "奇怪的调料？那是我研制的特别调料！这可是我用论文论述过的研究成果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000314,
					"content": "不用了！我们今天就吃一点普通的东西就好了！朱莉，拉住她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000315,
					"content": "哼，真是不识货…算了，等我再完善完善吧，我一定能做出那种只要放进菜里，无论什么菜都能变美味的万能调料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000316,
					"content": "万能调料…这种东西真的能做出来吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000317,
					"content": "就是因为没人做出来，我才要做出来。然后，我就能让教令院里那帮死脑筋的家伙好好地震惊一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000318,
					"content": "哈哈…好吧，我会好好期待的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000319,
					"content": "对了，旅行者，谢谢你陪我们在外面跑了这么久，这次辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000320,
					"content": "我再给你打包一份带走吧，在外面冒险，可一定要吃饱喝足才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000321,
					"content": "下次我们见面的时候，我一定会请你吃一顿好菜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000306,
					"content": "下次再找你请这一顿饭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "哈哈哈，好，那这顿饭我先记下了，下次请你吃顿好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "旭东"
				}
			]
		}
	]
}