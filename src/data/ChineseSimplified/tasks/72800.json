	"talks": [
		{
			"id": 7280002,
			"completionStepIds": [
				7280004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280004",
							"2"
						],
						"stepId": 7280004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"朱莉",
					"芭尔瓦涅",
					"旭东"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "…你们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000202,
					"content": "请问你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "我是龟井宗久，只是个路过的人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000204,
					"content": "呜哇…这个大叔的穿着，感觉就像「武士」一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000205,
					"content": "武、武士吗？难道是幕府的那个「武士」…我听说，幕府对外国人的态度很…微妙来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000207,
					"content": "不用担心。我已经离开幕府，不再是个武士了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000208,
					"content": "我经常来这里找可以吃的东西，但今天过来的时候，发现有魔物在这附近游荡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000209,
					"content": "而且周围的食材似乎也被它们搜刮干净了，我就不得不把它们全部打倒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000210,
					"content": "你经常来这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "这里平时并没有什么魔物，我经常来这取一些水果，或者猎一些动物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000217,
					"content": "话就说到这吧，我打倒这些魔物之后，周围的魔物应该也暂时不敢过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000218,
					"content": "如果你们也是来找食物的话，可以去周围找找，我只拿了我一个人的份，应该还有不少食材留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000219,
					"content": "那么，在下先告辞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000220,
					"content": "就、就这么走了。感觉这个大叔的作风，和我之前听说的武士作风也一模一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 728000221,
					"content": "但是，他说自己离开了幕府是什么意思？而且离开了幕府的武士，不就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000222,
					"content": "就像是之前遇见过的敌人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "对，之前我也听说，有一些脱离幕府四处流浪的武士，为了生计到处劫掠行人什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000225,
					"content": "虽然那位大叔看起来不像是那些恶徒，但我们还是提高警惕比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 728000226,
					"content": "好了，好了。我们来这里不是寻找食材的吗？不过看周围这个情况，我们还是别再继续深入了，免得再遇见什么危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000227,
					"content": "这位旅行者护送了我们这么久，应该也累了，我们就在这里做点吃的，迅速休整一下，然后回城去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000228,
					"content": "那位大叔说，周围还有剩下的食材对吧？我们去周围找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭东"
				},
				{
					"id": 728000223,
					"content": "就像是「海乱鬼」一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "这些魔物都是你打倒的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "是的，都只是一些普通的魔物而已，对付起来很容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000214,
					"content": "你为什么要在野外找食物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000216,
					"content": "我有我自己的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7280003,
