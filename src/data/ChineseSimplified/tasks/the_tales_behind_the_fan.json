				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"钟离",
					"田铁嘴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711010101,
					"content": "你看，真的在那里！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010102,
					"content": "喂——！钟离！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010103,
					"content": "哦？二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010104
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010104,
					"content": "我们有话要问你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010105,
					"content": "可否稍待片刻？我正忙着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010106
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010106,
					"content": "你在干嘛呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010107,
					"content": "话说回来，你居然这么快就回到城里了，可怕的速度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010108,
					"content": "钟离兄，这两位是你朋友？好像常来我这里找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010109
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010109,
					"content": "都是相熟的朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010110
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010110,
					"content": "甚好甚好，既然二位有空，也一起帮我看看，怎么才能说服钟离兄把他那块老石拿出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010111
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010111,
					"content": "老石？你要那个做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010112,
					"content": "二位有所不知，老石现在是炙手可热的珍稀矿石，有市无价！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010113
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010113,
					"content": "今天我照常在此说书，钟离兄也照常溜达过来，坐下听书。聊着聊着，便聊到了我的拿手好戏「创龙点睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010114,
						711010115
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010114,
					"content": "原来是那个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010116
					]
				},
				{
					"id": 711010116,
					"content": "不错的说书吧？呵呵，钟离兄也说，我说书有一手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010117
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010117,
					"content": "我只知道钟离兄见多识广，深谙民俗，却没想到，他对历史、神话也颇有研究。这不，有问题总是问他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010118
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010118,
					"content": "能帮上小忙便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010119
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010119,
					"content": "哪里哪里，可帮了我不少！不过啊，聊天本就要跟有趣的人聊。比如钟离兄，想法奇巧，牛自然也没少吹，啊哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010120
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010120,
					"content": "好比有一回我同他说：你瞧我这故事里，岩王帝君以灵石为本，雕刻出若陀龙王，日后又接那金戈铁马的桥段，过瘾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010121
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010121,
					"content": "他却说，故事万般皆好，就是有些细节不对，例如有人考据过，岩王帝君或许手艺不佳，雕不出这么精美的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010122
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010122,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010123
					]
				},
				{
					"id": 711010123,
					"content": "煞风景，是吧？上回我给他讲轻策庄的螭化身为山水，铸就一方美景。他也不认同，觉得天下哪有这种好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010124
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010124,
					"content": "唉你们说，人是不是见识多了就会缺乏诗意？瞧钟离兄，仪表堂堂，骨子里竟如此没有情调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010125
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010125,
					"content": "田兄批评得句句在理，我定当牢记于心，好好反思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010126
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010126,
					"content": "不过田兄编故事向来天马行空，我只是提出一些常人容易想到的意见，方便田兄参考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010127
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010127,
					"content": "说书的都是聪明人，以田兄眼力，不可能看不出我这般衷心的听众是为何而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010128
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010128,
					"content": "当然当然！钟离兄一番好意，我都明白。钟离兄一定是希望我成为璃月港最好的说书先生，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010129,
						711010130
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010129,
					"content": "（我倒觉得你不是很明白…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010131
					]
				},
				{
					"id": 711010131,
					"content": "你说了这么多，老石呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010132,
					"content": "哎呀，言归正传言归正传。你们是不晓得，前几天我又给人说了一出《创龙点睛》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010133
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010133,
					"content": "你这是炒冷饭，翻来覆去地炒呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010134,
					"content": "经典永流传，懂吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010135
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010135,
					"content": "田兄的戏，总是要炒一遍冷饭的。说书是创作，编也要时间啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010136
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010136,
					"content": "还是钟离兄明白。正巧那天有个外出打工的矿工头子，路过我这儿，听见这段说书，就跟我说啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010137
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010137,
					"content": "层岩巨渊你们知道吗？那边有种石头，模样漂亮，色泽幽雅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010138
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010138,
					"content": "而这种石头，就长在层岩巨渊里一条长长的过道上…欸，他是这么说的吗？过道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010139
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010139,
					"content": "应该是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010140
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010140,
					"content": "嗨，层岩巨渊那般神秘，纵然是钟离兄这么有见识的人都没机会去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010141
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010141,
					"content": "也就是最近那边矿业恢复了些，才陆陆续续有人员流动。我们都是听人说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010142
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010142,
					"content": "对，对。确有此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010143
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010143,
					"content": "人说，石头长在过道上，过道又是怎么来的呢？没人清楚。只能看见那过道蜿蜒曲折，如同巨物拖行所留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010144
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010144,
					"content": "阵仗惊人，见者无不为之震撼！有人说，那里恐怕是什么上古战场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010145
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010145,
					"content": "可究竟是谁和谁打出来的，我们无从考证。我便想着，说不定，岩王帝君和若陀龙王也在那里打过架？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010146
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010146,
					"content": "不瞒各位说，我正在琢磨一段新说书，要是能把这个编进去，岂不是厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010147
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010147,
					"content": "所以啊，就叫来钟离兄，请他赐教。没想到，他手头刚巧有一块老石，是从集市的商人那儿淘来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010148
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010148,
					"content": "眼光好，自然会挑。我想着，这老石真能说是我故事的象征了，钟离兄要是愿意，我也想将这石头买来，做个纪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010149
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010149,
					"content": "钟离，你、你要把石头给他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010150,
					"content": "嗯…田兄本就是说书人里的佼佼者，我又是他的忠实听众。若能为田兄的创作尽一份绵力，我自当支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010151
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010151,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010152,
					"content": "可若我将石头让出去，倒显得田兄的故事有纰漏。几位还请想想，岩王帝君不是将那若陀龙王封入地下了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010153
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010153,
					"content": "据专家称，层岩巨渊地下满是洞穴与矿道，若陀龙王封在那处，定会三天两头遭人打扰。如此场面，莫非，也是岩王帝君的考量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010154
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010154,
					"content": "好有道理啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010155,
					"content": "倒也是…岩王帝君可不会做这般不周全的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010156
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010156,
					"content": "嗯嗯对对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010157
					]
				},
				{
					"id": 711010157,
					"content": "唉，其实啊，我本想拿我最喜欢的这把扇子与钟离兄交换…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010158
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010158,
					"content": "嗯？上面画的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010159,
					"content": "正是本人说《创龙点睛》时最爱拿的扇子。游龙入云，纵横天下，志远心高，浩瀚无垠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010160
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010160,
					"content": "哇…很少看到这样的扇子呢，说得我都想要了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010161,
					"content": "对了，老石我们也有哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010162,
					"content": "什么？！那、那二位是否愿意将老石让给我？我愿以此扇交换！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010163
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010163,
					"content": "哎，田兄此言差矣。老石珍贵，你的扇子也绝非俗物。如此交换，倒是折了双方仙气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010164
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010164,
					"content": "这…这也行吗？我这扇子，倒是不止一把…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010165
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010165,
					"content": "田兄亲手绘制，原是妙物。任何一个爱听你说书的人，都会为收到如此厚礼而欢喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010166
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010166,
					"content": "当真？…也是，高山流水遇知音，比起其他，我更想让人认可我说的故事。画这些扇子，也是盼着有朝一日能送给有缘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010167
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010167,
					"content": "既然如此，几位也与我有缘，这扇子理应送给你们！稍等片刻，我这就去取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010168
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010168,
					"content": "田铁嘴来去如风，飞快地取来两把扇子赠予听众…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711010169
					]
				},
				{
					"id": 711010169,
					"content": "真的可以给我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010170
					]
				},
				{
					"id": 711010170,
					"content": "当然，您听过我说书，自是缘分。再说我也画了不止一把扇子，不给你们，还能给谁呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010171
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010171,
					"content": "钟离兄也不要客气！自家制品，还请你别嫌弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010172
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010172,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010173
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010173,
					"content": "田兄一番心意，我就不客气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010174
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010174,
					"content": "…当真好扇，值得珍藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010175
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010175,
					"content": "啊对！我们是来找钟离的，还想跟他聊些别的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010176,
					"content": "那我岂不是耽搁你们了？哎呀，快请快请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010177
					],
					"speakerTitle": "田铁嘴"
				},
				{
					"id": 711010177,
					"content": "何来耽搁一说。田兄，多谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010178
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010178,
					"content": "钟离，你是不是去过层岩巨渊了？还救了我们大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010179,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010180
					]
				},
				{
					"id": 711010180,
					"content": "魈也说，要不是你特意出手相助，他恐怕无法逃生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010181
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010181,
					"content": "他竟这么说？有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010182
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010182,
					"content": "时光荏苒，他也变得直白些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010183
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010183,
					"content": "所以，你又为什么会去层岩巨渊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010184
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010184,
					"content": "唔？竟有此事？我也是第一次听说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010185
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010185,
					"content": "欸？！你、你不要装傻啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010186
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010186,
					"content": "哈哈，装傻又是什么说法。嗯，刚才那扇子，属实不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010187
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010187,
					"content": "钟离！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010188
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711010188,
					"content": "…我是个闲人，四处逛逛本是应当。途中遇见什么，那也是缘分所致，何须言谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010189
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010189,
					"content": "倒不如说，天下如此之大，到处逛逛，多走多看，才能常感怀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010190
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010190,
					"content": "你很想念过去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010191
					]
				},
				{
					"id": 711010191,
					"content": "怎么会。我现在是人，人总是活在当下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010192
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010192,
					"content": "游龙入云，纵横天下，志远心高，浩瀚无垠。…不无道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010193
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010193,
					"content": "东西南北，何方不得意。天地山海，尽是玲珑处。以后有时间，还得多出去走走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 711010130,
					"content": "（他只是想说细节不对…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010131
					]
				},
				{
					"id": 711010115,
					"content": "我也有事没事常回味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010116
					]
				}
			]
		}
	]
}