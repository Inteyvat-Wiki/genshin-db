				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "唔啊，居然掉下来了一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210502,
					"content": "嫣朵拉，没有水，快死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210503,
					"content": "嫣朵拉，是你的名字吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210504,
					"content": "苦味，是敌意。会杀掉嫣朵拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210505,
					"content": "虽然不知道怎么办。要怎么样才能拯救你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210506,
					"content": "要去，有甜甜水的地方。要去，清泉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210507,
					"content": "嫣朵拉，寄宿水团子，代步。没水。嫣朵拉，无处栖身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210508,
					"content": "我们要怎么把它带去有清泉的地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210509,
					"content": "这里倒是有一瓶水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "可是这瓶水也是苦味的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210511,
					"content": "嫣朵拉，可以忍耐。但是，不能很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210512,
					"content": "哦哦，那事不宜迟。赶紧出发前往有清泉的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210513,
					"content": "不过这个家伙靠着水史莱姆旅行了这么远，和我们的关系很像呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4142106,
			"completionStepIds": [
				4142106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142106",
							"2"
						],
						"stepId": 4142106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "这里，水是甜的。嫣朵拉发现了，是同类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210602,
					"content": "嫣朵拉，同类，把水变好喝。也变苦，是洛蒂娅干的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210603,
					"content": "这么说来，清泉镇似乎的确有泉水精灵的传说来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210604,
					"content": "不过我们还是赶紧先去泉水边把瓶子里苦味的水换掉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老芬奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "…你是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210702,
					"content": "哇啊啊，嫣朵拉你怎么自己跑出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210703,
					"content": "我是嫣朵拉。纯水的精灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210704,
					"content": "这么说来，这位老爷爷似乎就是深信着清泉精灵存在的人来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210705,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210706,
					"content": "你和她简直一模一样。不过你要小多了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210707,
					"content": "嫣朵拉，还小！嫣朵拉，在学习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210708,
					"content": "不过，你出现在我的面前，至少证明了那场相识不是我的白日梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210709,
					"content": "她还在。名字，不知道。不知道，也不回答嫣朵拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210710,
					"content": "嫣朵拉，要联系她。嫣朵拉，能带话。你要说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210711,
					"content": "你是说，她一直都在吗？你可以帮我向她带话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210712,
					"content": "是的，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210713,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210714,
					"content": "我已经很老了。我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "老芬奇"
				},
				{
					"id": 414210715,
					"content": "帮我向她问声好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老芬奇"
				}
			]
		},
