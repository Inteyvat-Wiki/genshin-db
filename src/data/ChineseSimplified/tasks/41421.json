			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "旅行者，你好啊。最近可别来无恙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 414210102,
					"content": "又发生了什么奇怪的事情了吗，凯瑟琳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210103,
					"content": "和之前那些大事件相比，这件事有些不足为奇。不过因为它事关蒙德的经济，还是挺头疼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 414210104,
					"content": "是什么事情呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "最近啊，酒庄附近的水源毫无征兆的变苦了。这样下去，未来几年的酿酒业会遭受灭顶之灾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 414210107,
					"content": "具体的事情，就请你和酒庄的康纳谈一谈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 414210105,
					"content": "蒙德的经济？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"康纳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "协会派来协助的人员就是你们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414210202,
					"content": "是我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210203,
					"content": "那我就放心了。关于这件事，比起让我来说，你们还是自己体验一下比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414210204,
					"content": "这瓶水是就近取用的。它已经经过了所有的净水工序，绝对卫生。你可以放心尝尝看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414210205,
					"content": "我也要我也要！我也想试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210206,
					"content": "（尝一口…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "呜啊，呸呸呸。这个苦味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210208,
					"content": "这个苦味用传统的净水手段根本去不掉，不是成分上的问题。应该又是神奇元素力引发的现象吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414210209,
					"content": "这样的水可根本无法酿酒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414210210,
					"content": "那附近的鱼最近生活也很艰难吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210211,
					"content": "我们试过了，那些被苦得翻肚皮的鱼，做成菜都是苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "康纳"
				},
				{
					"id": 414210212,
					"content": "…我都没想这么远！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210213,
					"content": "总之，事情就是这样。如果你问我有什么头绪没有的话，我直觉认为应该向北去调查。不知璃月碧水河和轻策庄的水现在味道如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "康纳"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142105",
							"2"
						],
						"stepId": 4142105,
