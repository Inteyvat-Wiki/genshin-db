			"dialogs": [
				{
					"id": 414210801,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210802,
					"content": "她说了一些奇怪的话，不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210803,
					"content": "馋…缠…什么的，看不懂。问也不回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210804,
					"content": "识字数和词汇量不足啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "大概是有不能和大家见面的理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210806,
					"content": "不明白。纯水精灵，我们，喜欢融合在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210807,
					"content": "她，一个意识，孤独。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210808,
					"content": "我想大概是因为其他生物和你们没办法融合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210809,
					"content": "诶，没办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210810,
					"content": "会在你们的身体里淹死的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210811,
					"content": "你们真孤独。我们，所有人，爱所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210812,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210813,
					"content": "突然怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210814,
					"content": "石门附近，洛蒂娅的眼线！水的小动物。是，侦察兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210815,
					"content": "这么说来似乎的确在附近看到过纯水小动物来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210816,
					"content": "好像是见过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "强大的水，幻化，小动物。很危险。但是，和它们融合，可以学到东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210819,
					"content": "带我去。那边那边。洛蒂娅很不安。洛蒂娅把水变苦了。嫣朵拉学习说话，和洛蒂娅说清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210820,
					"content": "你是说你能帮助我们？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "是的，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}，我觉得还是值得一试的，毕竟我们目前也没有别的线索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414210817,
					"content": "是吗，没注意到诶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
