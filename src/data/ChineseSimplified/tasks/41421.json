					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "嫣朵拉我还需要学习。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "嫣朵拉"
				},
				{
					"id": 414211007,
