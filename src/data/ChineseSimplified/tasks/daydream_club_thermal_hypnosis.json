					"nextDialogs": [
						250190706
					]
				},
				{
					"id": 250190706,
					"content": "您看着倒也像是个外乡人呐。向您问好，我是格里斯潘，枫丹空想俱乐部的会员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190707
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190707,
					"content": "这位则是咱们俱乐部的会长…部长？呃，总之是领头的，格罗贝尔女士。",
					"roleType": "TALK_ROLE_NPC",
