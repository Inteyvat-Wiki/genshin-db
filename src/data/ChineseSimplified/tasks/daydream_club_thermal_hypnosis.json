					"nextDialogs": [
						250190704
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190704,
					"content": "见鬼…镇子到底出了什么事…现在也没办法马上赶回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190705
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190705,
					"content": "你看着不像纳塔人。",
