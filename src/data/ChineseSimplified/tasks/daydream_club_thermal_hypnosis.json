						250191102
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191102,
					"content": "#{NICKNAME}{M#先生}{F#小姐}，您来了，快来帮我一把，把它的根茎给…",
					"roleType": "TALK_ROLE_NPC",
