			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"格里斯潘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190403,
					"content": "嗬！您可是鼎鼎大名啊，实在幸会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190404
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190404,
					"content": "喵，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190405
					],
					"speakerTitle": "格罗贝尔"
				},
				{
					"id": 250190405,
					"content": "会长也向您问好。要是咱们在佩特莉可镇，我必然会请您喝一杯好茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190406
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190406,
					"content": "但现在…哈哈哈，我既找不到茶，也谈不上好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190407
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190407,
					"content": "唔？你们遇见什么事情了吗？看你满头大汗的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 250190408,
					"content": "纳塔很热，可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190409
					]
				},
				{
					"id": 250190409,
					"content": "#哈！让人愉快的{M#先生}{F#小姐}。从我到纳塔开始，您是唯一一个和我对上幽默感的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190410
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190410,
					"content": "但纳塔的热度也比不上我内心的焦急。唉，怎么事情全都凑到一块了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190411
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190411,
					"content": "不仅没有搜集到足够多的燃素，就连镇子也失去了消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190412
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190412,
					"content": "#亲爱的{NICKNAME}，我知道初次见面就委人任务，实在不算礼貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190413
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190413,
					"content": "但我真的很需要一个靠谱的人…您无疑是最佳人选了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
		},
