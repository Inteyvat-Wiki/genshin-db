			"dialogs": [
				{
					"id": 250191201,
					"content": "你是空想俱乐部的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191202
					]
				},
				{
					"id": 250191202,
					"content": "咦？等一下，我们之前就听埃斯特先生他们提起过格里斯潘这个名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 250191203,
					"content": "您去过俱乐部？露景泉在上，我总算撞上了好运！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191204
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191204,
					"content": "您知道俱乐部出了什么事吗？我已经连着寄去了好几封信，但就是没人回我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191216
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191216,
					"content": "关于佩特莉可镇的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191206
					]
				},
				{
					"id": 250191206,
					"content": "向格里斯潘讲述佩特莉可镇所发生的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250191207
					]
				},
				{
					"id": 250191207,
					"content": "喔，噢，嗬…真是让人，震惊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191208
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191208,
					"content": "喵…喵喵。喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191209
					],
					"speakerTitle": "格罗贝尔"
				},
				{
					"id": 250191209,
					"content": "没错，会长。我真的被震惊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191215
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191215,
					"content": "我真不敢相信，我居然错过了这么一场超级大催眠。天哪！看在露景泉的份上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191211
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191211,
					"content": "我要是在镇子上，肯定能搜集到一大堆可用的实验记录！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191212
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191212,
					"content": "会长，看来咱们得尽快结束研究，回去俱乐部看看情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191213
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191213,
					"content": "#咳，抱歉，{NICKNAME}。我知道初次见面就委人任务，实在不算礼貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191214
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250191214,
					"content": "但我真的很需要一个靠谱的人…您无疑是最佳人选了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191216
					],
					"speakerTitle": "格里斯潘"
				}
			]
