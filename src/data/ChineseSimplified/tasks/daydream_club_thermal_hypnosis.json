			"dialogs": [
				{
					"id": 250190901,
					"content": "#多谢您搭救，{NICKNAME}{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190902
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190902,
					"content": "您瞧瞧，这可真是一场惊心动魄的冒险啊。还好我说服会长，让它留在了部族里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190903
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190903,
					"content": "会长最不喜欢的就是这种不可控的突发事件，我可不想被它教训半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190904
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190904,
					"content": "不过，从结果上来说，我还是采到了足够的材料，一切皆大欢喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190905
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190905,
					"content": "#这些东西给你，{NICKNAME}{M#先生}{F#小姐}，再次感谢您的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190906
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190906,
					"content": "等研究成功后，我愿意请您第一个来体验「热能催眠术」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
