				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"格里斯潘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190301,
					"content": "咱们一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190302
					]
				},
				{
					"id": 250190302,
					"content": "一起？那就更好了！我早就想要实地考察了，有您在旁边，我就没什么好怕的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190303
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190303,
					"content": "#来吧，咱们这就出发。亲爱的{NICKNAME}{M#先生}{F#小姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190304
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190304,
					"content": "#至于会长您…就留在这里吧。请您放心，有亲爱的{NICKNAME}{M#先生}{F#小姐}在，我的人身安全绝对有保障！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190305
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190305,
					"content": "喵…喵喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190306
					],
					"speakerTitle": "格罗贝尔"
				},
				{
					"id": 250190306,
					"content": "呃…差点忘了，我把考察地点先给您标在地图上，那边的烛伞蘑菇可好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
		},
