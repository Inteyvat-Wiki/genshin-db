			"dialogs": [
				{
					"id": 250190101,
					"content": "这是…烬芯花啊。不错，不错，一定能派上大用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190102
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190102,
					"content": "喵喵？喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190103
					],
					"speakerTitle": "格罗贝尔"
				},
				{
					"id": 250190103,
					"content": "会长，这朵花恐怕没法在枫丹养活啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190104
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190104,
					"content": "如果您坚持的话…唔，做成书签怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格里斯潘"
				}
			]
		},
		{
			"id": 2501902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2501904",
							"2"
						],
						"stepId": 2501904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"格里斯潘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190201,
					"content": "喵，喵喵喵，喵喵喵，喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190202
					],
					"speakerTitle": "格罗贝尔"
				},
				{
					"id": 250190202,
					"content": "没问题，会长，我会简短介绍的…您就原谅我这张嘴吧，它总是停不下来，我也没有另一张嘴训斥它啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190203
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190203,
					"content": "#简单来说，{NICKNAME}，我想要请您去搜集带有「燃素」的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190204
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190204,
					"content": "让我想想…呃，我一直在用「烛伞蘑菇」来提取燃素，就请您帮我找些「烛伞蘑菇」来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190206,
					"content": "不过，我听说「烬芯花」里也有不少燃素…如果您能把它拿来给我的话，也不错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190205
					],
					"speakerTitle": "格里斯潘"
				},
				{
					"id": 250190205,
					"content": "只要提取到足够的燃素，我就可以在此开始研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "格里斯潘"
				}
			]
		},
		{
			"id": 2501903,
			"completionStepIds": [
				2501903,
				2501904,
				2501911
			],
			"beginWay": "TALK_BEGIN_NONE",
