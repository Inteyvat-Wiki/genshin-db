			"dialogs": [
				{
					"id": 766520801,
					"content": "#做得很漂亮嘛！{NICKNAME}也很有当机械师的天赋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520802
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520802,
					"content": "谢谢你们，这下我有了一个更厉害的「淘金小弟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520803
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520803,
					"content": "阿莎莎，你以后要认真干活噢，我会给你发工资的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520804
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520804,
					"content": "谁稀罕啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520805
					],
					"speakerTitle": "奇怪的淘金小弟"
				},
				{
					"id": 766520805,
					"content": "你的脾气真是不太好，给你戴一朵花花。希望你能温柔一点，呐~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520807
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520807,
					"content": "嗯，这下子看起来可爱多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520808
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520808,
					"content": "#对了，{NICKNAME}，派蒙，要是以后你们也捡到了没用的材料，比如螺丝螺母什么的，可以送来我这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520809
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520809,
					"content": "我能把它们都变成花花，或者用来升级我的操作台，嘿嘿。当然不会让你们白干活，报酬一定会让你们愿意天天来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520810
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520810,
					"content": "成交吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520811
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520811,
					"content": "当然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520812
					]
				},
				{
					"id": 766520812,
					"content": "太好咯！果然还是伊涅芙说的对呀。「不顺利」中也藏着「顺利」。等你度过了「不」，之后就是「顺利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520813
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766520813,
					"content": "你们的旅途一定也会是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱诺"
				}
			]
