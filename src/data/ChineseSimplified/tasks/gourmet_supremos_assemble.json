						721680404
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721680404,
					"content": "能再说一次那个方法吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "我来说吧。具体的方法就是，在周围找到一种叫做「雷樱枝条」的东西，然后触摸它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 721680406,
					"content": "之后，应该就会有一种叫做「雷种子」的东西附着在你身上，让你能够进入那个屏障之中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
