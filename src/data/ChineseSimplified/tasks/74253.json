			"dialogs": [
				{
					"id": 742530201,
					"content": "平静的日子，真好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "玛丽安"
				},
				{
					"id": 742530202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742530204,
					"content": "已经这个点了吗？哈哈，那我们以后也多聚聚吧，桑多涅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛丽安"
				},
				{
					"id": 742530203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
