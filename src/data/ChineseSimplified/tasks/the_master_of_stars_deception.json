			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"掇星攫辰天君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "如何？信众们可能有些言过其实，但都是肺腑之言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000802,
					"content": "感觉都是心理作用…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "哈哈哈…阁下说笑了。有位仙家高人，薛无量，人称「量子」，他曾经说过——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000804,
					"content": "「万物本是纠缠在一起，『心理作用』亦是一种『魂魄』与『事物结局』相连接的因缘…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000805,
					"content": "也就是说他们的愿望都已经走上了通往实现的正轨，这样讲明白了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000806,
					"content": "完全听不明白…但总之他们的愿望都能实现是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000807,
					"content": "没错，这位小友悟性很高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000808,
					"content": "说起来…还有一个问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000809,
					"content": "嗯？但说无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000810,
					"content": "你为什么戴着面具？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "本仙…游历民间，济世行善。不露真容，只为少生事端而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000815,
					"content": "原来如此，原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000816,
					"content": "那么二位的愿望是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000817,
					"content": "想获知亲人的行踪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "嗯…这背后一定有段悲伤的往事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000824,
					"content": "…好吧，想要实现这个愿望也不是不可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000825,
					"content": "只是…还差了那么点意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000826,
					"content": "差了点…意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000827,
					"content": "仙道但凭「悟性」，若二位参不透我话中之意，那就恕本仙难以相助了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000828,
					"content": "怎么办，我还是不明白他说的意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000829,
					"content": "看来是需要给一些好处…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "哦！刚才那些信众们好像也提起过，请仙人帮忙要付出不小的代价…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000832,
					"content": "可我们两个身上，也没什么值钱的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000833,
					"content": "甚至，你连「神之眼」都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000834,
					"content": "应该不会有人把神之眼卖掉吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "欸！不如我们做些好吃的给他？没人能抵挡美食的诱惑吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000837,
					"content": "在派蒙的价值观里确实是这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "嗯，好吃的！这个办法肯定能成功的，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000840,
					"content": "不如我们赶快出发，去「万文集舍」看看有没有什么最新最好的流行菜谱吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000838,
					"content": "好吃的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "是啊，真可惜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "看来是要给他摩拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "想得到匹敌神明的力量。",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "拥有力量，很多问题便能迎刃而解。不过我倒是很好奇，你难道与神明有什么过节？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000821,
					"content": "想要一夜暴富！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#欸欸！你不管你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000823,
					"content": "嗯，人之常情。你看上去并非璃月人，却好像沾染了不少璃月的铜臭气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000811,
					"content": "可以把面具摘下来看看吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "喂！是不是太不礼貌啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000813,
					"content": "呵呵，确实有所不便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "掇星攫辰天君"
				}
			]
