			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#是我的幻觉吗，{NICKNAME}…那些丘丘人是不是看起来有些古怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000102,
					"content": "身体上散发着…邪气？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "是呀，以前见过的丘丘人，虽然是魔物，但从来没有这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000106,
					"content": "啊！「望舒客栈」就在附近，会威胁到来往的客人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000107,
					"content": "#见到了又不管的话，总觉得会良心不安…试试看对付它们吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000104,
					"content": "有些躁动的样子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "是呀，难道和它们身上那种奇怪的黑气有关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
