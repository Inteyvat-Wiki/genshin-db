			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "有「星辰天君」在，千岩军都可以下岗了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "商人信众"
				},
				{
					"id": 111000602,
					"content": "关于「星辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "我是个商人，上一批货物实在太值钱了，便冒昧拜托「星辰天君」同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "商人信众"
				},
				{
					"id": 111000604,
					"content": "只见天君祭出符咒，魔物全都退避三舍，一路上连个影儿都没见着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "商人信众"
				},
				{
					"id": 111000605,
					"content": "虽说费用方面确实贵了点…但毕竟「请仙」是件大事嘛，也不知道你们外国人能不能负担得起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "商人信众"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
