				"objectNames": [
					"女性信众"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "总觉得现在每天过得充满了希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "女性信众"
				},
				{
					"id": 111000502,
					"content": "关于「星辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "你们也是「星辰天君」的「信众」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "女性信众"
				},
				{
					"id": 111000504,
					"content": "自从我的未婚夫不告而别，我每天以泪洗面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "女性信众"
				},
				{
					"id": 111000505,
					"content": "后来尝试了「星辰天君」的仙法——把他的画像烧掉，再把灰烬在日出时刻吹向大海…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "女性信众"
				},
				{
					"id": 111000506,
					"content": "冥冥之中，我真的感觉到他要回来了，是真的！绝对不是什么心理作用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "女性信众"
				},
				{
					"id": 111000507,
					"content": "于是我开开心心地把嫁妆献给了「星辰天君」。毕竟若不是他帮我找回夫君，这嫁妆可能一辈子也用不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "女性信众"
				}
			]
		},
