			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "这些满身邪气的家伙，确实比一般的丘丘人要难对付一些呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000302,
					"content": "咦，你看那边，聚集了一些人的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000303,
					"content": "呜哇…你看到那个戴着面具的人了吗？他那边的丘丘人都害怕得跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000304,
					"content": "莫非他是「仙人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "你是说像魈那样的仙人吗？这么说确实…魈也戴过差不多的面具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000307,
					"content": "看他刚才「作法」，好像比魈更有仙人的样子呢。不如去跟他聊聊吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111000305,
					"content": "看起来像是「仙家法术」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
