					"男性信众"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "看到「星辰天君」作法了吗？真是神通广大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "男性信众"
				},
				{
					"id": 111000402,
					"content": "家父的病想必也有指望了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "男性信众"
				},
				{
					"id": 111000403,
					"content": "关于「星辰天君」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "见到那样的法术还有什么好怀疑的，当然是真真正正的仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "男性信众"
				},
				{
					"id": 111000405,
					"content": "我之前替卧床的老父求了个药方，跟「不卜庐」的方子天差地别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "男性信众"
				},
				{
					"id": 111000406,
					"content": "药熬出来还飘着一股淡淡的雾气，仙得很！虽然也可能是加了冰雾花的缘故…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "男性信众"
				},
				{
					"id": 111000407,
					"content": "仙家药方实在了得，家父的病一定会好起来的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "男性信众"
				},
				{
					"id": 111000408,
					"content": "至于那些献给「星辰天君」作为贡品的古董，跟家父的性命比起来根本不值一提…对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "男性信众"
				}
			]
		},
		{
			"id": 1110005,
