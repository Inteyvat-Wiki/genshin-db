					"乔瓦尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "你好，公民，有什么发现吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "乔瓦尼"
				},
				{
					"id": 742220702,
					"content": "我找到了一些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "没事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "注意安全，如果有什么情况随时向我汇报！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乔瓦尼"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乔瓦尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "竟然…没错，这就是蛮族用来传递信息的信号杆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "乔瓦尼"
				},
				{
					"id": 742220802,
					"content": "真的假的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "哎，没想到真的有蛮族奸细混进来了，看来墨提乌斯长官的担忧果然没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "乔瓦尼"
				},
				{
					"id": 742220805,
					"content": "只要把这些情况汇报给他，我也终于能交差了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "乔瓦尼"
				},
				{
					"id": 742220806,
					"content": "不管怎么说，多谢你了，公民。要是没有你的帮助，说不定在蛮族的大军到来前，我们的防御就从内部被瓦解了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "乔瓦尼"
				},
				{
					"id": 742220807,
					"content": "在给墨提乌斯长官的报告上，我一定会提到你的贡献的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乔瓦尼"
				},
				{
					"id": 742220803,
					"content": "你刚才还说是木头剑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}