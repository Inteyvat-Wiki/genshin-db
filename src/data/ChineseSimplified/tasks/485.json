			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "前面看起来没路走了…那家伙到底会躲在哪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850302,
					"content": "安柏，看对面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850303,
					"content": "你果然还是追上来了，没办法…咦？怎么是个小姑娘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "「怪鸟」"
				},
				{
					"id": 4850304,
					"content": "你就是「怪鸟」吧！现在你已经逃不掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850305,
					"content": "哈哈哈，我也不用逃，因为你压根过不来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "「怪鸟」"
				},
				{
					"id": 4850306,
					"content": "唔——这断崖，确实很高…也很远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850307,
					"content": "小姑娘，不如你现在回去，把团长叫来，说不定我就会马上投降呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "「怪鸟」"
				},
				{
					"id": 4850308,
					"content": "你这是在挑衅西风骑士团的侦察骑士吗？看我现在就飞过去抓住你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850309,
					"content": "先冷静一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "唔…你说得对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850312,
					"content": "可恶，明明就在对面了，要是可以直接飞过去就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850313,
					"content": "但这个怪鸟是怎么过去的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850314,
					"content": "难道有可以来回的机关？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "以我的眼力，也看不出这种机关的痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850316,
					"content": "而且周围也没有能建机关的岩壁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850322,
					"content": "再见了，小姑娘——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "「怪鸟」"
				},
				{
					"id": 4850323,
					"content": "呀，这家伙要逃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850324,
					"content": "不能再犹豫下去了，除了「飞行」以外，没有第二种越过断崖的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850325,
					"content": "但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850326,
					"content": "别担心，我可是蒙德城的飞行冠军，如果怪鸟可以飞过去，我也肯定可以做到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850327,
					"content": "喂，侦察骑士，想要送死的话，不带风之翼从蒙德城的风神像上跳下去才更适合你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "「怪鸟」"
				},
				{
					"id": 4850328,
					"content": "我明白安柏的意思了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#说得没错…除了「飞行」以外的答案，{NICKNAME}也认为都已经排除了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}，还记得我拿错的那本…不是指南的指南吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850332,
					"content": "「最初的鸟儿是不会飞翔的，飞翔是它们勇敢跃入峡谷的奖励」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850333,
					"content": "接下来，请你见证我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850334,
					"content": "加油！侦察骑士！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "收到！就让那家伙见识一下侦察骑士的勇气吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850336,
					"content": "别，别开玩笑了，这里是飞不过来的！快点乖乖回去吧，小姑娘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "「怪鸟」"
				},
				{
					"id": 4850337,
					"content": "怪鸟，你是这么觉得的吗？可是你仔细听听，周围微小的声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850338,
					"content": "风说——可以飞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850329,
					"content": "虽然需要勇气，但这不是自杀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "活用了某种元素魔法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#在{NICKNAME}的元素视野里有痕迹吗？…唔，果然也没有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850319,
					"content": "用了抓钩或者刺钉之类的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "连飞都飞不过去，这种东西也不可能丢过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850321,
					"content": "地面上也没有钉桩的痕迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850310,
					"content": "观察一下周围…这是你教我的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "成功抓住怪鸟了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850602,
					"content": "其实，只有在空中才能发现，那就是唯一的风场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850603,
					"content": "怪鸟所要逃跑的方向，尽头根本是彻彻底底的死路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850604,
					"content": "换句话说，如果怪鸟想要逃出去，就必须从我们这边经过才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850605,
					"content": "喔——所以他才一直这么装模作样，原来是想骗我们放弃，然后自己再飞回来逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850606,
					"content": "不过，我们这边也不是那么好骗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850607,
					"content": "#幸亏有{NICKNAME}的分析，这就是所谓的「排除了所有错误答案以后，剩下的那个，无论多反常都是正确的」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850608,
					"content": "总之，想要掌握飞行这种事情，七分靠技术，三分靠直觉，剩下的九十分全都是靠勇气来补足啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850609,
					"content": "我看你刚才是九十九分都是勇气了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850610,
					"content": "哎呀，这就和我第一次考飞行执照的时候一样吧…虽然很紧张，但还是有惊无险地把执照考到手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850611,
					"content": "可惜之后的几次考试我都再没有这种紧张感了，总觉得少了点什么呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850612,
					"content": "你…等一下，飞行执照都考到手了，之后的考试是考什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850613,
					"content": "这个啊…因为蒙德城里这里不准飞那里也不准飞，这里不准降落那里也不准降落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850614,
					"content": "我考到手的飞行执照总是被吊销，零零碎碎重新考过十五次飞行执照吧。",
					"roleType": "TALK_ROLE_NPC",
