			"dialogs": [
				{
					"id": 111240101,
					"content": "此碑由理水叠山真君所立。碑文中称若陀为恶龙，是为提醒后人远离这处封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111240102,
					"content": "可惜…善与恶只隔一线。若他的善恶是可以简单说清的事，倒也罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111240103,
					"content": "（静静注视立在树下的钟离…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "（寂静中，惟闻风声飒飒。时间仿佛化作无形的河流，自身旁静静淌过…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 111240105,
					"content": "（浮光一瞬，人间千年。岩石有心，大地与神明亦然。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
