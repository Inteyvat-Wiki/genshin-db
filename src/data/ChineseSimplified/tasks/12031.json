						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"派蒙",
					"冈崎陆斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "小家伙，你们来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310402,
					"content": "神子，我们都还没到，你竟然就已经开始吃了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310403,
					"content": "嗯，对啊，因为你们请客嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310404,
					"content": "一想到能免费吃最贵的菜，喝最好的酒，我就赶快过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310405,
					"content": "啊，老板，看见这两个人没有？这桌等会是他们买单哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310406,
					"content": "好嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "冈崎陆斗"
				},
				{
					"id": 120310407,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310408,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "怎么啦你们两个，快过来坐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310410,
					"content": "来尝尝这个，这可是清籁岛附近才有的鱼，连夜运到稻妻城的，刚才还是活的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310411,
					"content": "或者来杯这个？像这样名贵的酒，我平时也不舍得喝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310412,
					"content": "不能喝酒也没关系，果汁也很多的，各种价位都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310413,
					"content": "呜——神子，你太过分了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310414,
					"content": "上次在这里赶稿的时候，你给我们吃的只是最大众的炸串啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310415,
					"content": "咦，有这回事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310416,
					"content": "就是这么回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "哦，那又怎样呢？之前说要请客的，不是你们自己吗？再说了，你们忍心亏待我这个贵客吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310419,
					"content": "神子，这顿饭要好多好多钱呀，你就不怕我们付不起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310420,
					"content": "呵呵，不用怕，付得起。咱们之前一起写的那本小说，最近又再版了，你们的稿费还不少呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310421,
					"content": "你、你说什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310422,
					"content": "#啊啊啊啊，可恶！{NICKNAME}，我们被气氛给骗了！神子打从一开始就在打我们稿费的主意哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310423,
					"content": "大意了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "哈哈哈哈，你们现在这副样子，真是太有趣了，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310426,
					"content": "哦对了，因为上次无月之夜许愿后什么都没有发生，现在咒语之类的小说，已经完全不流行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310427,
					"content": "所以《旅行者的奇妙冒险》的最新章，你们得想点新的套路才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310428,
					"content": "截稿期马上就到了，那就拜托你了哦，「老师」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310424,
					"content": "被算计了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "只有炸串，和油豆腐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
