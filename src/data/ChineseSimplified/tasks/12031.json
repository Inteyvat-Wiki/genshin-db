			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "嗨，小家伙们，你们来了呀。不错，很准时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310102,
					"content": "哼，为了稿费，不来也不行嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310103,
					"content": "神子，要帮大家进行「百鬼夜行」，具体要怎么做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310104,
					"content": "其实我们连百鬼夜行是什么都不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310105,
					"content": "「百鬼夜行」听起来挺吓人的，但简单来说，就是妖怪们的聚会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310106,
					"content": "当年妖怪们在一起聚会，酒酣之时，纷纷使出妖力腾空而起，翻飞的身影能把月亮都遮住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310107,
					"content": "不过现在，地脉中溢出的妖怪记忆，力量很微弱，他们已经做不到腾空而起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310108,
					"content": "所以，我会为他们进行一场聚灵仪式，让逸散的记忆能够汇聚在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310109,
					"content": "到时候，他们就会在这鸣神大社的上空相会。然后，力量耗尽的他们，就会心满意足地重新回到属于他们的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310110,
					"content": "原来如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "仪式的铺垫其实早就已经做好了。还记得我在小说中加入的咒语和「无月之夜」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310112,
					"content": "好像是要在「无月之夜」念诵「狐狸小姐秘传术法」来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310113,
					"content": "对，那里写着的可不是什么实现愿望的咒语，而是能安抚地脉记忆的术式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310114,
					"content": "到时候，就让大家一起帮忙送他们一程吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310115,
					"content": "那么我该做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "等下我会开始筹备仪式，希望你们帮我做两件事：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310117,
					"content": "首先是通知神社巫女们下山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310118,
					"content": "百鬼夜行之时，大量妖怪的记忆盘踞在鸣神大社上空，万一有谁不小心被附了身，还是会有点麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310119,
					"content": "之后，我会启动仪式让记忆汇聚。这个过程会花一定时间，你们就去影向山下观察附近魔物的动向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310120,
					"content": "虽说平常分散的记忆没有什么危险，可把力量聚拢，魔物们还是难免会受到影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310121,
					"content": "它们可能会凭借本能想要上山，你们就负责把它们都打倒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310122,
					"content": "明白啦。那之后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310123,
					"content": "嗯，那之后啊…如果你们想到神社这里帮忙，顺便近距离看看那些妖怪，也不是不可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310124,
					"content": "#好，{NICKNAME}，我们出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
