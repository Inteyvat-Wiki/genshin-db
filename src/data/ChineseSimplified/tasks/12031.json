			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麻纪",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "下山？这是宫司大人的命令吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 120310202,
					"content": "是的，神子说接下来要举行的仪式，对你们的身体可能会有影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310203,
					"content": "原来如此…我会立刻安排。你们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 120310204,
					"content": "我们会帮她做些事情，然后回到这里来，和她一起进行仪式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310205,
					"content": "因为还是有点担心她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "看来宫司大人对你们很信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 120310208,
					"content": "之前遇到这种重要的仪式，宫司大人身边是一个人都不会留的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 120310209,
					"content": "那仪式就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 120310210,
					"content": "放心吧，我们可是很强的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310206,
					"content": "因为有点想看看妖怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
