					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "卖唱的，你还是那么会挑地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450702,
					"content": "很高兴你能喜欢。有些故事不适合飞鸟，只能说给高处的星辰听呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450703,
					"content": "要讲睡前故事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "哈哈，这篇故事，要从「时间」开始说起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450705,
					"content": "很久很久以前，「时{RUBY#[D]伊斯塔露}间」开始记录这个世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450706,
					"content": "她对栖息在尘世的生灵一视同仁，与此同时，这些生灵在她心中也是同等的无足轻重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450707,
					"content": "她就好像一张古老的卷轴，将所有人、所有事、所有的相遇与别离都刻印在自己的记忆中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450708,
					"content": "那时还是风精灵的我，在千风神殿与「时间」偶遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450709,
					"content": "她聆听我的愿望，将部分力量与权能的碎片出让给了我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450710,
					"content": "风带来了种子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "看来这不是你第一次听说「时间与风」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450713,
					"content": "这不是很有韵味吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450714,
					"content": "靠着铭刻在祭礼、诗歌、遗迹和古籍中的记忆，被视作微不足道的生灵们一次次「见」到了时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450715,
					"content": "这就是你要说的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450716,
					"content": "嗯…只能算是故事的「序章」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450717,
					"content": "烬寂海的污染是具有时间特性的，换句话说，它的灾害存在于时间的每一处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450718,
					"content": "不同于「时间」本身，我的心中，一直存在诸多愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450719,
					"content": "五百年前，为了防止烬寂海的污染继续扩散，影响特诺奇兹托克以外的更多区域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450720,
					"content": "我将烬寂海从时间轴上吹了出去，让它成为了「无风之地」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450721,
					"content": "这就是烬寂海消失之谜的真相吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "哎呀，好像让你弄混了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450723,
					"content": "如果你问的是二三十年前，烬寂海从特诺奇兹托克消失的事，或许存在比我更适合的讲述人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450724,
					"content": "烬寂海承载了太多不应属于它的故事…我仅参与了其中一个篇章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450725,
					"content": "而我在五百年前做出的选择，也有代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450726,
					"content": "有些灵魂因此无法返回蒙德…另有些灵魂沉淀在这块土地上，和幻写灵结合，成为了你我所见的阿夏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450727,
					"content": "所以，你这次来特诺奇兹托克是为了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450728,
					"content": "没错，我需要和现任火神玛薇卡合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450729,
					"content": "是在点燃蜡烛的时候吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "猜对咯，火光是我们的暗号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450731,
					"content": "由玛薇卡从那片空间中开启通往真正烬寂海的裂隙，我才能悄悄钻进去，把所有愿意回家的灵魂都接送回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450732,
					"content": "至于带回记忆这种小把戏…欸嘿，也不是第一次了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450733,
					"content": "玛薇卡还和我提到了你想帮忙引荐的事…没想到还是被我抢先了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450734,
					"content": "很高兴看到她也热爱着美酒与自由…我们很聊得来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450735,
					"content": "真有你的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "我可是累了好几天，差点就要再度沉睡过去啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "温迪"
				},
				{
