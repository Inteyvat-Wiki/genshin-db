			"dialogs": [
				{
					"id": 150450601,
					"content": "噢，真好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450602,
					"content": "各位，来我这里集合！要拍照啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450603,
					"content": "嗯…不错嘛！所有人的精神状态都很饱满，没有黏答答的刘海或者熬夜的黑眼圈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450604,
					"content": "你拍照前还会帮忙检查这些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450605,
					"content": "拍照不够细心还怎么声称自己是好向导？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450606,
					"content": "爱喝酒的吟游诗人才能成为好旅伴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450607,
					"content": "这话到底是怎么接上的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450608,
					"content": "哈哈，但气氛很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450609,
					"content": "大家变成一起说胡话的朋友了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "这真的是个好方向吗？你也跟班尼特一样在惯着卖唱的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450611,
					"content": "至少不坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450612,
					"content": "#来，{NICKNAME}，把这个阿夏头箍带上。这是大家一起为你买的纪念礼物噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450613,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "嗯，很适合你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450615,
					"content": "那么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450616,
					"content": "三、二、一——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450617,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450618,
					"content": "派蒙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450619,
					"content": "…不好意思，胡话听多了之后脑袋突然卡壳了，没想出要说什么词…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450620,
					"content": "再加上还有点舍不得大家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450621,
					"content": "觉得当自己这么说出来的时候，仿佛就是在给假期画上句号了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450622,
					"content": "你…！你还说「调停人」不会读心术！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450623,
					"content": "哈哈，派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450624,
					"content": "没事的，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450625,
					"content": "夏天一定还会到来，就像你和火神大人许愿的那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450626,
					"content": "大家的旅程都在继续。但只要我们都珍惜着彼此，总有一天还会相聚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450627,
					"content": "班尼特是不是变得相当能说啊，温迪老师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450628,
					"content": "啊呀，不是我教的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450629,
					"content": "不是你教的你语气那么得意干嘛呀！真是的，我好不容易有点感动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450630,
					"content": "那我们重新来一次？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450631,
					"content": "大家一起吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450632,
					"content": "喊什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450633,
					"content": "幸运之星？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450635,
					"content": "三、二、一——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450636,
					"content": "幸运之星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450641,
					"content": "和朋友们共度了一段愉快的时光…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "…班尼特之后有什么打算？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450643,
					"content": "对啊，如果现在不好做决定的话，可以来我们「流泉之众」坐坐，想待多久都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450644,
					"content": "…嗯，谢谢你的好意，玛拉妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450645,
					"content": "在这之前，我去见了火神大人，向她郑重表达了我的感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450646,
					"content": "她告诉我，那片空间是由深渊拟态而成的烬寂海，空间本身极不稳定，现在已经彻底消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450647,
					"content": "后面聊到我的事之后，火神大人欢迎我留在纳塔，但也说会尊重我的决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450648,
					"content": "我思考再三…还是决定回蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450649,
					"content": "放心不下老爹们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450650,
					"content": "这也是原因之一。我答应要把收获的故事讲给老爹们听，不能失约。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450651,
					"content": "其余的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450652,
					"content": "告别的时候，我对爸妈说了，我一定会成为提瓦特最伟大的传奇冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450653,
					"content": "冒险家，可不能只待在一个地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450654,
					"content": "班尼特…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450655,
					"content": "要是你在离开纳塔之后，又变得不幸起来…那要怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450656,
					"content": "哈哈，这也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450657,
					"content": "在这次旅程中获得的温暖，足以让我面对未来的所有挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450658,
					"content": "我想把握自己的命运。我想将这份家人和朋友带给我的温暖，继续传递下去。这个想法一直没变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450659,
					"content": "敬我们的团长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450660,
					"content": "敬班尼特团长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450661,
					"content": "干杯干杯——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450662,
					"content": "呃…竟然快要通宵了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450663,
					"content": "玩得尽兴嘛！接下去轮到谁表演？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450664,
					"content": "我看班尼特好几次要睡着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450665,
					"content": "没有，没有…我还可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150450666,
					"content": "大家都回去休息吧，玛拉妮，这么有力气就交给你收拾场地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150450667,
					"content": "欸？为什么是我——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}，再陪我散散步？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 150450669,
					"content": "我知道一个风景不错的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 1504507,
			"completionStepIds": [
				1504507
			],
