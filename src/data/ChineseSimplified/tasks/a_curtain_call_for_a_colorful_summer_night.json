			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#{NICKNAME}，派蒙！我带着豚豚球来跟你们问早哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450402,
					"content": "早啊，玛拉妮，你怎么那么有精神？昨晚玩得最疯的不就是你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450403,
					"content": "那已经是昨晚的事啦！睡一觉，疲劳就统统扫清！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450404,
					"content": "喏，收下这个。是纪念册的奖励，我帮你一起领回来了，免得你多跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450405,
					"content": "噢噢！真贴心啊玛拉妮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450406,
					"content": "急人所急，想人所想，才算是个好向导，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450407,
					"content": "说到工作，算算时间，假期差不多要结束了。再不回家，我怕我家小狗都要认不出我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450408,
					"content": "我问了问其他人，大家也有各自的牵挂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450409,
					"content": "想念家人的，想念蒲公英酒味道的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450410,
					"content": "就连恰斯卡嘴上没说什么，一到傍晚，她就翘着腿坐在树梢上，往「花羽会」的方向望了又望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450411,
					"content": "能够理解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "所以呀，在这个美妙的夏天结束之前，让我们再做一些有纪念意义的事情吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450413,
					"content": "比如…再拍一张合照！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150450414,
					"content": "要在这里拍吗？住了那么久，还挺有感情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150450415,
					"content": "采纳！再把墙面装饰一番吧，我喊大家过来集合…广场见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛拉妮"
				}
			]
		},
