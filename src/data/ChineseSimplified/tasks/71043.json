			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "「…安东上士在东南方发现了一口大钟…岩壁上写着『它们』的文字…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "愚人众的日志本"
				},
				{
					"id": 710430102,
					"content": "「…和大尉之前在西北方的遗迹里看到的大钟相近，或许…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "愚人众的日志本"
				},
				{
					"id": 710430103,
					"content": "「…派遣雪奈茨芙娜与法迭卡两人，分别敲响两侧遗迹中的大钟…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "愚人众的日志本"
				},
				{
					"id": 710430104,
					"content": "「…可怖的呼啸声回荡在岩壁间，黑雾消散了。难以解释的奇特现象…似乎在昭告着谁的登场…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "愚人众的日志本"
				},
				{
					"id": 710430105,
					"content": "「…十人牺牲，两支先锋小队皆蒙受严重损失，大尉下令立即撤离…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "愚人众的日志本"
				},
				{
					"id": 710430106,
					"content": "（一张简易的地图从日志本中滑落，地图上标出了西北方与东南方的两处大钟，并画了两个醒目的骷髅头。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人众的日志本"
				}
			]
		},
