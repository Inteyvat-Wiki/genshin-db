			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"翠儿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710141101,
					"content": "潮先生今天会来吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141102
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141102,
					"content": "关于邀请函…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710141103
					]
				},
				{
					"id": 710141103,
					"content": "邀请函？抱歉，您找错人啦，我只是这艘船上的接待啦，没办法给您发邀请函。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141104
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141104,
					"content": "不过，你没邀请函还能待在船上可真稀奇啊，一般来说，没拿邀请函上船的人，直接就会被送走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141105
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141105,
					"content": "你是想要从船上的人手里拿到邀请函吗？那可是很难的啊，没人会轻易对陌生人发出邀请呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141106
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141106,
					"content": "唔，这样吧，我帮你留意一下船上的客人，但作为交换，你要帮我个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141107
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141107,
					"content": "我的恋人叫做潮汐，我们俩约好，下次见面的时候他就会接我离开这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141108
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141108,
					"content": "但我已经等了很久了，他却一直没有消息，我又一直在船上工作，没法上岸去找他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141109
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141109,
					"content": "你能帮我去送封信给他，问问他的情况吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141110,
						710141112
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141110,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710141111
					]
				},
				{
					"id": 710141111,
					"content": "太好了，那就拜托你啦，我在船上等着你的消息，要快点回来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141112,
					"content": "这名字有点熟悉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710141113
					]
				},
				{
					"id": 710141113,
					"content": "他是一位很厉害的水手，听说过他的名字很正常啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141114
					],
					"speakerTitle": "翠儿"
				},
				{
					"id": 710141114,
					"content": "请你帮我把这封信送给他吧，我在船上等着你的消息，要快点回来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翠儿"
				}
			]
		},
		{
			"id": 7101412,
			"completionStepIds": [
				7101409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101409",
							"2"
						],
						"stepId": 7101409,
						"stateName": "QUEST_STATE_UNFINISHED"
