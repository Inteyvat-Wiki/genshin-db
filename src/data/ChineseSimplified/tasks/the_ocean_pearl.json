						710146110
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146110,
					"content": "这么说可能有点不客气，但毕竟事关自己，不想担风险也正常啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146111
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146111,
					"content": "您也是来这里玩的吗？虽然看起来装束有点不太像会来这里的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146112
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146112,
					"content": "但我也能理解啦，想要开开眼界啦，想要结交些人啦之类的想法，毕竟这种机会可不常有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146113
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146113,
					"content": "唔，虽然我不能给您找到邀请函，但我有个能让您合理待在船上的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146114
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146114,
					"content": "不过作为交换，您得帮我个忙。我的嗓子很痛…想要找三份清心泡水喝，但一直没下船的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146115
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146115,
					"content": "您能帮我拿三份清心回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146116,
						710146118
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146116,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146117
					]
				},
				{
					"id": 710146117,
					"content": "那就拜托您啦，等您回来，我会把那个办法告诉您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146118,
					"content": "只要这些？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146119
					]
				},
				{
					"id": 710146119,
					"content": "不是什么大事，这些就足够了。等您回来，我会把那个办法告诉您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋歌"
				}
			]
		},
		{
