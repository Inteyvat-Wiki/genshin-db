					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710140302
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710140302,
					"content": "不过想要在这长留，您还是得拿到一份邀请函才行。",
