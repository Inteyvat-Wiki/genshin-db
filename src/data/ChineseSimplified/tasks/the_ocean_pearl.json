			},
			"dialogs": [
				{
					"id": 710149701,
					"content": "怎么样，落霞小姐答应让你在船上呆着了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149702
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149702,
					"content": "我拿到邀请函了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710149703
					]
				},
				{
					"id": 710149703,
					"content": "咦？邀请函…是落霞小姐给你的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149704
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149704,
					"content": "你到底…是什么来历呀，居然能让落霞小姐亲自给你发邀请函。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149705
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149705,
					"content": "总之还是恭喜你啦，这份邀请函可是很珍贵的，我师父都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149706
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149706,
					"content": "哎呀，但是你的名字我刚写进戏班的名册里，也已经报上去了，一时半会还划不掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149707,
						710149709
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149707,
					"content": "这样挺好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710149708
					]
				},
				{
					"id": 710149708,
					"content": "你不介意的话就最好了，那以后记得多来戏班里玩啊，我嗓子好了之后，就可以唱戏啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149712
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149712,
					"content": "邀请函…什么时候我也能有一份呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149709,
					"content": "以后可以找我帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710149710
					]
				},
				{
					"id": 710149710,
					"content": "不会的，不会的！我只是帮你挂个名，不会有什么事情麻烦你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149711
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710149711,
					"content": "可以的话，以后你就多来戏班里玩玩吧，我嗓子好了之后，就可以唱戏啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710149712
