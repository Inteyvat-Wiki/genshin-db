				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"潮汐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710141201,
					"content": "思妹妹，我刚从海上回来，想要先休息一下，我们先别谈这件事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141202
					],
					"speakerTitle": "潮汐"
				},
				{
					"id": 710141202,
					"content": "可我前几天就看见你在港口里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141203
					],
					"speakerTitle": "思思"
				},
				{
					"id": 710141203,
					"content": "那是船上的人临时派我回来港口购置物资。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710141204
					],
