				"objectNames": [
					"落霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710146301,
					"content": "看来，您没有拿到邀请函呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146302,
						710146305
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146302,
					"content": "我会拿到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146303
					]
				},
				{
					"id": 710146303,
					"content": "就和我们老板说得一样…您似乎永远不会气馁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146304
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146304,
					"content": "但现在您做的事，已经足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146308
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146308,
					"content": "您在船上其他的客人那里碰壁的事，我已经听说了。不过，除了这些事，我还听说了别的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146309
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146309,
					"content": "翠儿正在船上到处悄悄地问侍者，哪些客人比较好说话，哪些客人比较容易亲近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146310
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146310,
					"content": "秋歌刚刚把您的名字写进了她们戏班里，还和我说，您是她刚刚请来的人，让我别忙着把您赶下船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146311
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146311,
					"content": "您不觉得有意思吗？那些贵客轻易地将您拒之门外，反而是普通的人更愿意向您伸出援手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146312
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146312,
					"content": "呵呵，这些事您就自己想一想吧，至于邀请函的事，您就不用担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146313
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146313,
					"content": "让您去讨邀请函的事，只是我们老板给您安排的一点小事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146314
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146314,
					"content": "至于您的邀请函，他其实早就亲自写给我了，他让我在您办完这些事后，再把邀请函的事告诉您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146315
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146315,
					"content": "从此之后，您可以在「珠钿舫」上自由来去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146316,
						710146318
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146316,
					"content": "你们老板是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146317
					]
				},
				{
					"id": 710146317,
					"content": "我们老板名叫柔然，说不定…您在哪里已经见过他了，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146320
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146320,
					"content": "好了，奴家能告诉您的事，已经全部告诉您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146321
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146321,
					"content": "如果您以后再想来这「珠钿舫」上玩一玩，就不用费力飞过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146322
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146322,
					"content": "我们在港口派有一位名叫平海的摆渡人，负责客人在船上的来去，您想来的话，和他打个招呼就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146323
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146323,
					"content": "我已经把他招到了船上，您想要回港的话，就和他说一声吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146318,
					"content": "为什么要给我安排这些？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146319
					]
				},
				{
					"id": 710146319,
					"content": "这是老板的意思，奴家可不敢妄自揣测。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146320
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146305,
					"content": "还要一段时间。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146306
					]
				},
				{
					"id": 710146306,
					"content": "呵呵，我不怀疑您的能力，只要给您足够的时间，无论是什么事您都能办好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146307
					],
					"speakerTitle": "落霞"
				},
				{
					"id": 710146307,
					"content": "但现在您做的事，已经足够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146308
					],
					"speakerTitle": "落霞"
				}
			]
		},
