			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秋歌"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710146201,
					"content": "您拿到清心了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146202
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146202,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146203
					]
				},
				{
					"id": 710146203,
					"content": "我看看…这些就足够了。希望师父的这个方子能让我的嗓子轻松点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146204
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146204,
					"content": "好啦，按照我们说好的。我已经把您的名字排在戏班的名单上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146205
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146205,
					"content": "这样，在我们离船之前，您都可以留在船上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146206
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146206,
					"content": "您就趁着这个时间，去把那个邀请函拿到手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146207
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146207,
					"content": "你为什么帮我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710146208
					]
				},
				{
					"id": 710146208,
					"content": "为什么帮您…怎么说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146209
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146209,
					"content": "我在做学徒的时候也曾经和您一样啦，想要抓住各种机会，出人头地证明自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146210
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146210,
					"content": "一个人努力的滋味可不太好受，我也是因为有师父帮了一把，才有了现在的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146211
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146211,
					"content": "现在我有了一点点能力，就轮到我来帮助别人啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146212
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146212,
					"content": "哎呀，说太多了。我把您加入名单之后，也已经和落霞小姐说过了，她让您去见她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710146213
					],
					"speakerTitle": "秋歌"
				},
				{
					"id": 710146213,
					"content": "别担心，我已经和她说好了，不会有问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋歌"
				}
			]
		},
		{
			"id": 7101463,
			"completionStepIds": [
				7101413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
