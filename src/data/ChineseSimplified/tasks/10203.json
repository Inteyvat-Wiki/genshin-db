					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102030101,
					"content": "呼…可莉这孩子，其实是我们西风骑士团的「火花骑士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030102,
					"content": "什么？竟然连可莉都是骑士吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030103,
					"content": "那么，可不可以给派蒙也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "没错，派蒙不甘心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030106,
					"content": "话说回来，称号是「火花骑士」，也难怪可莉的宝物会是那种东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030107,
					"content": "嗯，虽然平时没有少给骑士团添麻烦，但骑士们还是很关心她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030108,
					"content": "说起她的来历，其实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030109,
					"content": "总之，以后你会对她有更多了解的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102030110,
					"content": "#到时也请你对她多关照些了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 102030104,
					"content": "而且听上去比「荣誉骑士」还强？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
