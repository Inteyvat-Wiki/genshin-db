			"dialogs": [
				{
					"id": 102030201,
					"content": "呜…下次我会更小心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030202
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102030202,
					"content": "下一次，我会安全地完成一场伟大的冒险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030203
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102030203,
					"content": "我听说「冒险家协会」也有一套冒险的守则，是不是应该去拜托他们呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030204
					],
					"speakerTitle": "禁闭室"
				},
				{
					"id": 102030204,
					"content": "唉，要是这段话被塞琉斯会长听见了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102030205,
					"content": "他一定会去拜托琴团长，继续加长可莉的禁闭时间吧…",
