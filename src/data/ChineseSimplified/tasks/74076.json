			"dialogs": [
				{
					"id": 740760501,
					"content": "前方就是「人格」之块吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760502,
					"content": "无法从密度分析眼前的物质。似乎重量为…零。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760503,
					"content": "看来我们拿下了最后一分。这样至少就可以和对面斡旋一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760504,
					"content": "往好处想的话，至少我们就可以阻止水仙十字结社最后锻造出圣剑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760505,
					"content": "并不是，派蒙。我们的最终目的是铸造出圣剑，并且用圣剑去阻止他们的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760506,
					"content": "当然，安，我并没有忘记这柄剑对于你的意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760507,
					"content": "能够切割意志的圣剑，对于你是解开谜题的钥匙。其实它对我来说也一样重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760508,
					"content": "只不过我们有更重要、更紧迫的事情。我们之后再解答关于自身的谜，你可以接受吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760509,
					"content": "我没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760510,
					"content": "#那么{NICKNAME}，请你去收下「人格」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		}
