			"dialogs": [
				{
					"id": 740760101,
					"content": "最后只剩下这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760102,
					"content": "好在入口还是封住的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760103,
					"content": "看来那个雅各布并没有解答这里的谜题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760104,
					"content": "或者他解答出来了，却无法奉上谜底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760105,
					"content": "我想想，之前的答案分别是「影子」、「生命」和「爱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760106,
					"content": "然后根据之前的规律，我的逻辑模块推测碑文如下：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760107,
					"content": "「从不分离」…「生于一瞬，常与相违，伴你长眠」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760108,
					"content": "然后最后一句写的是——「原初一滴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760109,
					"content": "卡特皮拉、西摩尔，你们知不知道这个答案的谜底啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
