			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "我对「原初一滴」这个词有些想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760402,
					"content": "听起来像是说世界创造之后的第一场雨。这种意象应该是古枫丹和水仙十字结社都很喜欢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760403,
					"content": "那这怎么可能找得到嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760404,
					"content": "所以这一滴水已经融在所有水之中了。每一滴水都是原初的一滴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760405,
					"content": "就像是原初的神把伟大的潜力散布了开来。我们每个人身体里也都有神圣的成分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760406,
					"content": "但是答案这么简单的话，前面那人应该可以很简单就供奉出答案啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760407,
					"content": "确实如此。应该是我错了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760408,
					"content": "虽然它不是正确答案，但它仍然是个好答案。我只能觉得设置谜题的人不懂浪漫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760409,
					"content": "他还笑你不懂安保呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760410,
					"content": "我无法作答。关于原初一滴的搜索结果有一千二百条。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760411,
					"content": "「世界上第一滴酒传说是风神…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760412,
					"content": "好了，不用继续了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760416,
					"content": "这个，我似乎有些东西可以分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760417,
					"content": "有一个传说，纯水精灵是前代水神的第一滴泪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760418,
					"content": "而大地上的第一滴泪，正是最早纯水精灵理解了人类之后流下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760419,
					"content": "世界上最早的眼泪不应该是第一个人类的婴儿哭出来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760420,
					"content": "动物的流泪其实是排出盐分，而人类在那个平稳的年代，就连出生时都是欢笑着呼吸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760421,
					"content": "——传说是这么说的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760422,
					"content": "其实我认为婴儿的哭泣和动物的排盐可以视作类似的非感性行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760423,
					"content": "婴儿哭泣有外界刺激和为了尽快填充肺部的双重原因。须弥的生论派教材是这么写的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760424,
					"content": "所以答案是，纯水精灵吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760425,
					"content": "那确实前面那人可能供奉不出正确答案呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760426,
					"content": "死马当活马医吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "我觉得这个方向还是很靠谱的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760430,
					"content": "这个以我对水仙十字结社的理解来说，似乎也很合理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760431,
					"content": "不知在何处做梦的「红女皇」，永远口是心非的「梦中人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760432,
					"content": "你说的这些话比谜语本身还难懂欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760433,
					"content": "有什么关系嘛。已经是最后的关头了。不论怎么样，在这件事最后，谜底就会揭晓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760434,
					"content": "安，那就麻烦你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "嗯，让我试试吧。万一我失败了，你们赶紧想想别的答案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "安"
				},
				{
					"id": 740760436,
					"content": "打开了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760437,
					"content": "一定要拿到最后这块，不然圣剑就会落到水仙十字结社的手里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760428,
					"content": "我觉得这个方向还是很靠谱的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "比起找风神之酒的死马当活马医行为好多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760414,
					"content": "试试吧，咱们去蒙德…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "你要死马当活马医的话可以换个靠谱的方向吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "派蒙"
				}
			]
		},
