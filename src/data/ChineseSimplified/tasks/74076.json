						740760205
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760205,
					"content": "此处的碑文写着：「从不分离」…「生于一瞬，常与相违，伴你长眠」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740760206,
					"content": "然后最后一句写的是——「原初一滴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760207,
					"content": "之前几处地方应该也有这种谜题吧。那些谜底，你们还记得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740760208,
					"content": "「影子」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760209
					]
				},
				{
					"id": 740760209,
					"content": "「生命」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760210
					]
				},
				{
					"id": 740760210,
					"content": "「爱」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760211
					]
				},
				{
					"id": 740760211,
					"content": "唔，答案逐步抽象了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740760212,
					"content": "卡特皮拉、西摩尔，你们知不知道这个谜题的答案呀？",
