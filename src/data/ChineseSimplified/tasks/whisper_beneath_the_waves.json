			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊尔玛里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "今天也是空手而归啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200102,
					"content": "你在这里干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "钓鱼。不过到目前为止只钓到些不是鱼的玩意儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200104,
					"content": "要是沉船里的小物件之类的倒好，游商会收。之前钓起过靴子上还连着半截…唉，不说了，说多了鱼都给吓跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200105,
					"content": "附近有什么值得注意的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "你也是来寻宝的？什么只有在月之东，日之西才能找到的「伟大财宝」之类的…听也知道不会是这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200107,
					"content": "哦，说起来过去这里的确发生过不少船难，沉船里或许的确有值钱的东西，不过那可不容易找啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200108,
					"content": "在酒馆也听幸存的水手说起过，那天晚上没有月亮，在滔天的巨浪中却能看到发光的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200109,
					"content": "他们说那一定就是独眼的刻拉蒂了，是连月亮都能吞食的怪兽在同海中的巨蛇争夺地盘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200110,
					"content": "那之后很长一段时间，这块儿都像账房的墨水瓶似的黑黢黢一片，没有船敢冒险从这里经过，都怕被水下的亡魂缠上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200111,
					"content": "听说那些亡魂现在还在附近徘徊，不过这些说法也就能哄哄孩子吧。我是不相信这类无稽之谈的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200112,
					"content": "关于这棵树…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "这玩意儿是真的有点邪乎。这儿原本有个漩涡，水手们管它叫刻拉蒂之眼，但突然有那么一天这树就这么长出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200114,
					"content": "不过那阵子发生的怪事也不止这么一件，想想看，都是在那些石头从天上掉下来之后…搞不好这树也跟石头一样来自天外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200115,
					"content": "还有那些偶尔能见到的亮晶晶的小东西，稀罕得很。想着说不定也会有新品种的鱼吧，我就是为了这个才来碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200116,
					"content": "原本有个钓友和我一起，但他老说听到奇怪的歌声，吓得不敢再来了。哼，虽然他只算半个霜月之子，但臭毛病是一点不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200117,
					"content": "打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "不打紧。现在是一点鱼的影子都看不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				}
			]
		},
