						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "真是怪事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200702,
					"content": "你们看到了吗？刚才这棵树唰啦一下就亮起来了，还有这些小东西…可惜不是鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200703,
					"content": "这么说来，中间那个东西就是它的根吗？虽然不知道是什么原理，但它现在看起来亮晶晶的，比之前黯淡的样子好看多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760200704,
					"content": "讲述了此前的经历…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "难以置信…但你们也没必要编些胡话来诓骗我，看来我那只有一半是霜月之子的钓友说的都是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200706,
					"content": "不过那又怎样，只是些过去的残影罢了。管他们唱什么歌，说什么话，也不妨碍我们活人钓活鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200707,
					"content": "话说回来，你们也是宝藏猎人吧。你们刚才捡到的玩意儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200708,
					"content": "这个就是<color=#00E1FFFF>「识者之证」</color>了吧？看起来只是普通的鸟羽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760200709,
					"content": "听相熟的游商说，集齐五个<color=#00E1FFFF>「识者之证」</color>，就能找到埋藏在月之东，日之西的什么「伟大财宝」，也不知道是真是假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200710,
					"content": "反正不少宝藏猎人是真的信了，一个个都趋之若鹜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "伊尔玛里"
				},
				{
					"id": 760200711,
					"content": "毕、毕竟是宝藏嘛！要说的话，我也是很感兴趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760200712,
					"content": "要是我再年轻个二十岁…不，就算年轻个二十岁，也还是钓鱼最重要。不过话说回来，今天也是空手而归啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊尔玛里"
				}
			]
		}
	]
}