			"dialogs": [
				{
					"id": 230090201,
					"content": "还得再去买些材料回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090202,
					"content": "你的「凝成泥土」怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "非常好！不如说，这种泥土的应用范围简直超乎我的想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090204,
					"content": "它可以用来做瓶瓶罐罐，也能修补房屋的漏洞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090205,
					"content": "只要调整一下各种泥土的混合比例，直接用来搭建房屋也没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090206,
					"content": "不过…因为大家都来找我订购这种泥土，我的材料又不够用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090207,
					"content": "而且最关键的史莱姆凝液也用光了，旅行者，能请你再去帮我拿三份史莱姆凝液回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090208,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "拜托你了，旅行者，请你帮我拿三份史莱姆凝液回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090209,
					"content": "其他材料呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "其他的材料我都已经从各种渠道订购，或者托人去找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230090211,
					"content": "但史莱姆凝液消耗得实在太快，出乎我的预料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "阿金"
				}
			]
		},
