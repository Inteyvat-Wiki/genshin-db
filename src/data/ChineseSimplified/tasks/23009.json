						230091703
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091703,
					"content": "阿金开始调配泥土…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "这样就可以了，旅行者，请你帮我把这份泥土带给尼姆吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091705,
					"content": "他可是等着这泥土好久了，想必都等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091706,
					"content": "这孩子可是有着…嗯…非比寻常的想象力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091707,
					"content": "尼姆和我说，他想要做一群「泥罐战士」，这群战士们都是一个个会说话的泥罐，能够滚动着身子打倒敌人，还有各种神奇的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091708,
					"content": "而这群「泥罐战士」的能力，则根据他们塞进自己「罐体」里的材料而各不相同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091709,
					"content": "他还给「泥罐战士」取了名字呢，好像叫亚什么来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091710,
					"content": "哈哈哈，虽然实现不了，但他的想法真的很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091711,
					"content": "我就想，既然他有这么新奇的点子，不如就把这泥土当做玩具送给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091712,
					"content": "这样，他就可以亲手铸造出他的「泥罐战士」们，正式当上「泥罐将军」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091713,
					"content": "咳，先不说了，总之请你把这罐泥土送给尼姆吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091714,
					"content": "等到他的「泥罐战士」正式出炉，说不定他也会封你和我一个「泥罐大将」的称号呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				}
			]
		},
