					]
				},
				{
					"id": 230091403,
					"content": "啊！是，是你啊，旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091404,
					"content": "别提了，我的「凝成泥土」出问题了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091405,
					"content": "不知道是我的配方出了问题，还是我没考虑到实际的使用情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091406,
					"content": "不少用我的「凝成泥土」搭建厨房的人说，在用了一段时间后，泥土出现了不同程度的开裂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091407,
					"content": "也许是温度太高，导致泥土内部的什么成分失效了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091408,
					"content": "唉，总之我先去帮他们重新整修了坏掉的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091409,
					"content": "因为要修的人太多了，刮下来的「凝成泥土」我来不及带走，就让他们把泥土放在罐子里留着。唉…装了好几大罐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091410,
					"content": "旅行者，请你帮我去这一家回收一下废弃的「凝成泥土」吧，我去其他家回收。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "阿金"
				},
				{
					"id": 230091411,
					"content": "唉，到底是哪里出了问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿金"
				}
			]
