					{
						"sceneId": 3,
						"position": [
							3459.075,
							446.463,
							4717.811
						],
						"pointId": 340100825
					}
				]
			},
			"dialogs": [
				{
					"id": 746910101,
					"content": "#…咦？{NICKNAME}，我、我是看错了吗？那边…是不是有一个嘟嘟可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910102,
						746910103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910102,
					"content": "这里是枫丹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				},
				{
					"id": 746910104,
					"content": "不…不对！那边就是有一个嘟嘟可，看起来还是…那个…芭比洛斯女士的嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910105,
						746910106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910105,
					"content": "太好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910107,
					"content": "#哎呀，这可真是巧遇。{NICKNAME}，还有小派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910108
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910108,
					"content": "从芭比洛斯女士这么厉害的占卜师嘴里听到「巧遇」两个字，总觉得有点微妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910109,
					"content": "真的是「巧遇」，我可没有开玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910110
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910110,
					"content": "#{NICKNAME}作为从世界之外而来的「降临者」，命运没有被锚定在提瓦特之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910111
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910111,
					"content": "#呵呵呵，包括我在内的许多占卜师，应该都无法预测{NICKNAME}的未来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910112
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910112,
					"content": "不过，这次的「巧遇」还真是恰到好处。前不久，我偶然窥见了一缕奇异的预兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910113
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910113,
					"content": "因为正好闲来无事，所以我就对着这一缕预兆稍做占卜，又对着占卜的轨迹外出追寻…算是找点乐子，小小休一个假吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910114
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910114,
					"content": "哦对了，在追逐预兆的过程中，我也捉到了几根缥缈的命运之丝，也窥见了它们主人的样貌，就是这几位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910115
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910115,
					"content": "全都是…熟人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910116
					]
				},
				{
					"id": 746910116,
					"content": "#你瞧，我就说嘛，{NICKNAME}的朋友可多了，一定认识他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910117,
						746910118
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910117,
					"content": "这声音是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910119,
					"content": "嗨，你们好呀，我们是不是好久没见了？这次芭比进行占卜的时候，我也有参与喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910120,
					"content": "是的。要不是艾莉丝坚持，我就会将这些名字作为可忽略的变量，从占卜算式中去除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910121
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910121,
					"content": "那样的话，你不就没办法休假了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910122
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910122,
					"content": "而且！既然魔女得出了预言，那就绝对不能让和预言有关的小朋友们失望啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910123
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910123,
					"content": "每一位小朋友都渴望着新奇的礼物，伟大的使命，还有神秘的预言…总之，绝对不能省略！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910124
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910124,
					"content": "…真是服了你了。但是，如果能将这些微小的变量聚拢起来，应该也能稍微修正一下我的占卜算式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910125
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910125,
					"content": "所以我来了这里，打算见一见他们，如果可能的话，也为他们送上一次简单的占卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910126
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910126,
					"content": "呃…那他们什么时候会来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910127
					]
				},
				{
					"id": 746910127,
					"content": "我没有空详细占卜这些事，但总而言之——他们迟早会来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910128
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910128,
					"content": "所以才在这里摆了个摊子，打算就这么一直等下去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910129,
					"content": "没关系，这个嘟嘟可只是一个替身，我本人还在继续做正经的研究呢，不算浪费时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910130
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910130,
					"content": "没错！我还给芭比的嘟嘟可上装了自动感应系统，只要对应的人来到了摊位前，她就会得到提醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910131
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910131,
					"content": "而且，嘟嘟可也会扭动得更加开心，保证来的人移不开目光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910132
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910132,
					"content": "你怎么又回来了？挪挪你的胳膊，你快把我的水占盘推到地上了。还有，拿稳杯子，别把热巧克力洒在我的稿纸上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910133
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910133,
					"content": "好嘛好嘛，你们稍等一下…这样就可以了，对了芭比，这杯是你的，真的只是微甜，我保证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910134
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910134,
					"content": "你所接受的微甜，和我所接受的微甜，绝对不是一个甜度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910135,
					"content": "咳，说正事！总之呢，在芭比占卜出结果后，我本来打算跑一趟，把那群人聚在一起，好好地办一个超棒的聚会呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910136,
					"content": "我连送信的方式都想好了，还特意去找了好多帅气的鸟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910137
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910137,
					"content": "想想看，在寂静的深夜，纯白的巨鸟咬着一封神秘的信件来访，只要打开这封信，你就会面对一个全新的世界——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910138
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910138,
					"content": "可是，艾莉丝这么做，只会扰乱命运的轨迹。而且，要处理一个这么小的预言非常麻烦，所以我阻止了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910139
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910139,
					"content": "真遗憾，但聚会还是可以办的，等到了合适的时机，我会来邀请所有人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910140
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910140,
					"content": "#为了让聚会快点举办，{NICKNAME}，小派蒙！把这些人带过来的任务，就交给你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910141
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910141,
					"content": "可、可以吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910142
					]
				},
				{
					"id": 746910142,
					"content": "哈哈…这样应该也算是扰乱命运的轨迹吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746910143,
					"content": "#嗯…这群人本就和{NICKNAME}有所关联，从理论上来说，命运也已经纠缠在了一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910144,
					"content": "#由{NICKNAME}出面，将他们请过来，倒是对占卜影响不大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910145
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910145,
					"content": "#不愧是{NICKNAME}，果然可靠，为了聚会，这件事就拜托你们啦，我保证给你们留两个离蛋糕最近的好位置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910146
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910146,
					"content": "…芭比，你怎么开始撕纸了，要做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910147,
					"content": "我要塞住我的耳朵，你和尼可两个人一个吵耳朵，一个吵脑子。天哪，我真想念欧科塔维亚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746910118,
					"content": "艾莉丝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910106,
					"content": "世界终于被嘟嘟可占领了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910103,
					"content": "应该是之前看了太多的嘟嘟可吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				}
			]
		}
	]
}