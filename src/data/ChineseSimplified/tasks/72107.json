			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721070101,
					"content": "狐狸神像…没错，跟绀田村那时一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070102,
					"content": "但是，好像没见到神像里有镇物…还是说，被什么东西藏起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070103,
					"content": "该不会又有什么麻烦的<color=#00E1FFFF>秘密</color>吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070104,
						721070106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070104,
					"content": "我们的配合…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070105
					]
				},
				{
					"id": 721070105,
					"content": "嘿嘿，我们真是好搭档。村长爷爷什么都说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070107,
					"content": "等等！这里有一行小字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070108,
					"content": "<color=#00E1FFFF>「镇物以言灵封印至此。」</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070109,
					"content": "咦？这是什么意思？边上还写了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070110,
					"content": "「虽然我希望封印不要有解开的一天，虽然你也已经多年不曾有音讯。但如果一定要解开封印，实行大祓的话，那希望解开封印的人是你。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070111,
					"content": "「第三句言灵是以前你常说的话。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070112,
						721070113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070112,
					"content": "好难懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070114
					]
				},
				{
					"id": 721070114,
					"content": "我看看…「如果是小生的继任者的话，要解开言灵之前，还有这么一个步骤。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070115,
					"content": "「御灵有四魂，巴有三重。据此我留下了<color=#00E1FFFF>三名式神</color>看守。<color=#00E1FFFF>当它们汇聚在一起时</color>，才能继续。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070116,
					"content": "「虽然这重锁没什么用，但要挡住没什么能耐的贼人大抵是绰绰有余」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070117,
					"content": "…欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070118,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070119
					]
				},
				{
					"id": 721070119,
					"content": "那我们一定得想办法解决才行了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070120,
					"content": "不然我们就是「没什么能耐的贼人」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070113,
					"content": "还有吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070114
					]
				},
				{
					"id": 721070106,
					"content": "希望不要有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070107
					]
				}
			]
		},
