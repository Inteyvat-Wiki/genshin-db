			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721070201,
					"content": "这样就可以了！好累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070202,
					"content": "明明累的是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070203
					]
				},
				{
					"id": 721070203,
					"content": "不要在意这种细节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070204,
					"content": "嗯，里面好像有本书…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070205,
					"content": "哇，好难读…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070206,
					"content": "大概看过一遍了，但又好像完全没有看懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070207,
					"content": "算了，我们还是去找专业人士问问看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070208,
					"content": "既然是神神鬼鬼的东西…那去鸣神大社吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7210703,
			"completionStepIds": [
				7210707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210705",
							"3"
						],
						"stepId": 7210705,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210707",
							"2"
						],
						"stepId": 7210707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"稻城萤美"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721070301,
					"content": "你好，远道而来的旅者，欢迎来到「鸣神大社」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070302
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070302,
					"content": "如果有烦恼或者心愿，可以找玄冬小姐求签，雷神会保佑你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070303
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070303,
					"content": "原来如此，情况我已大致了解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070304
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070304,
					"content": "「神樱大祓」之事，是很重要的仪式。确实有相关的记载…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070305
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070305,
					"content": "不过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070306
					]
				},
				{
					"id": 721070306,
					"content": "不过，如今具体的行事方法已经失传了。你手中的《要略》，是很宝贵的史料呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070307
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070307,
					"content": "失传了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070308
					]
				},
				{
					"id": 721070308,
					"content": "难道是愚人众干的？既然稻城小姐说是重要的事情，就很难不觉得他们在背后搞鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070309,
					"content": "啊，不是的。是因为保存不当。受潮、虫蛀等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070310
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070310,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070311,
					"content": "哎呀，真是相当遗憾。有很多史料都丢失了呢。之前八重大人和神里大人也为此很苦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070312
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070312,
					"content": "至于「言灵」之事，我也并非一无所知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070313
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070313,
					"content": "嗯嗯，那就请把破解的方法告诉我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070314,
					"content": "很抱歉，将镇物封印的「言灵咒法」并非特定咒语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070315
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070315,
					"content": "…而是施咒者释术时亲自拟定的单语，也即言灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070316
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070316,
					"content": "啊？你的意思是说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070317,
					"content": "咒语…是那个施咒者随随便便拍脑袋想的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070318,
					"content": "也并非如此。此类言灵一般都有其规律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070319
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070319,
					"content": "能否详细说说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070320
					]
				},
				{
					"id": 721070320,
					"content": "嗯…我记得书中是这么记载的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070321
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070321,
					"content": "第一句表示自身在稻妻的威名。是什么什么加上「敕使」二字来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070322
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070322,
					"content": "第二句则是解释自己自身力量的来源。打个比方，就像「团子」、「拉面」、「轻小说」之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070323
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070323,
					"content": "嗯嗯我懂。确实是很了不起的力量来源呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070324,
					"content": "只是打个比方啦。记载里，有类似「阴阳博晓」之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070325
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070325,
					"content": "至于这第三句…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070326,
						721070327
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070326,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070328
					]
				},
				{
					"id": 721070328,
					"content": "嗯…如你所料。第三句的内容可以自由发挥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070329
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070329,
					"content": "时隔久远，恐怕这世上已经没有了解第三句话的知情人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070330
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070330,
					"content": "那要怎么办！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070331,
					"content": "面具巫女姐姐的托付…还有这片大地…都要完蛋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070332,
						721070333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070332,
					"content": "别紧张…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070334
					]
				},
				{
					"id": 721070334,
					"content": "嗯，这个小东西，或许能够帮上二位的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070335
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070335,
					"content": "这是<color=#00E1FFFF>「留念镜」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070336
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070336,
					"content": "「留念」？是纪念品的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070337,
					"content": "二位博见广识，想必对「留影机」有所了解吧。那是异国枫丹生产的，可以记录影像的器物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070338
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070338,
					"content": "在遥远的过去，离岛方才建设不久时，当时的柊家家主弘嗣大人曾经从异国引进诸多新奇产品，以此证明他力推建设通商港能带来的裨益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070339
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070339,
					"content": "譬如说，利用从至冬国购进的「高炉」，将毗邻天守的柊家旧宅改造成「温泉」，以此作为对大御所大人恩准的感念，赠给大御所大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070340
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070340,
					"content": "又以那位「狐斋宫大人」曾赠予柊家的退邪之镜为「透镜」，从枫丹国定制了一台特殊的留影机，能够记录思念与记忆，作为珍重情谊的表现，回赠大社。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070341
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070341,
					"content": "随着年月，留影机本身失去了功能。唯独狐斋宫大人祝福过的透镜，在特殊的地方仍然能看见如今已经不在的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070342
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070342,
					"content": "我们将透镜取出，名之为「留念镜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070343
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070343,
					"content": "听二位是为「樱」之事奔走，交谈中也能感觉出你们值得信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070344
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070344,
					"content": "将它托付给二位，也算能够物尽其用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070345
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070345,
					"content": "这么重要的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070346
					]
				},
				{
					"id": 721070346,
					"content": "二位来自异乡吧。你们知道，稻妻人相信万物有灵，石头与树也有记忆。而器物闲置百年，也会产生不甘的情感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070347
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070347,
					"content": "与其任由它沉睡在大社当中，不如交由有缘之人，让它见识一下这么数百年间变化的世界吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070348
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070348,
					"content": "没问题！包在我们身上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721070349,
					"content": "传说当年狐斋宫大人消失后，她在鸣神岛的眷属<color=#00E1FFFF>「地狐」</color>在各处化为假寐的雕像，等待她的归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070350
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070350,
					"content": "如果看见造型奇异的、小小的狐狸雕像的话…透过<color=#00E1FFFF>「留念镜」</color>观察它们，或许就能发现平时看不见的事物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070351,
						721070352
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070351,
					"content": "多谢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070353
					]
				},
				{
					"id": 721070353,
					"content": "雷神保佑，就有劳两位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070352,
					"content": "包在我们身上！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070353
					]
				},
				{
					"id": 721070333,
					"content": "她还有话没说完…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070334
					]
				},
				{
					"id": 721070327,
					"content": "是随随便便拍脑袋想的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070328
					]
				}
			]
		},
		{
			"id": 7210704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
