			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"稻城萤美"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721070401,
					"content": "言灵的用法，随着「惟神」的血脉消失，理应已经失传了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070402
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 721070402,
					"content": "…呀，不好意思，没注意到你们。「留念镜」就交给你了。带着它一起，看看世界吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻城萤美"
				}
			]
		},
		{
			"id": 7210705,
			"completionStepIds": [
				7210716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
