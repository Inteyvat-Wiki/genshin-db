			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "这绘马架修得还真不错…你手艺可真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090502,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "不过这上面的绘马…已经完全看不清楚了，到底是过了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090505,
					"content": "悦子小姐！你看，我从旁边找到了几块木板，削了几块…呃…绘马。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090506,
					"content": "既然这绘马架已经修好了，当然要往上面挂绘马啦，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090507,
					"content": "悦子小姐，你有什么愿望吗？我可以帮你画的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090508,
					"content": "在这个神社里挂绘马啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090509,
					"content": "呵呵，感觉还真奇妙…把绘马给我，我来画吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090510,
					"content": "他们似乎已经在准备挂绘马了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090511,
					"content": "我们回去告诉寝子吧，它一定会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090503,
