			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "喵喵喵，那个木头架子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090302,
					"content": "已经修好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "喔！真是不错，这样子神社也更像样了，喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090304,
					"content": "汝再去和那两个绿色的人类说一声吧，告诉他们，那个架子已经修好了，他们可以去挂小木块了。然后，也可以让其他人类来神社，然后塞钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090305,
					"content": "你为什么不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "那、那个绿色的，高高的人类很可怕，他很了解猫的心思…可以轻而易举地看穿奴家，喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090307,
					"content": "而且奴家每次和他说话的时候，他都很激动…喵喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
