			"dialogs": [
				{
					"id": 722090201,
					"content": "那个绘马架看起来已经坏了很久了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090202,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "喔，旅行者。我和悦子小姐正在这神社周围做调查呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090204,
					"content": "虽然这神社里的各个设施都破落得不成样子了…但这些设施还真是齐全啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090205,
					"content": "附近村里的人都会来这里参拜吧。看来神社的荒废，或许和越石村废村也有关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
