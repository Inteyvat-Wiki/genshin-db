				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "喔，你好，旅行者，找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090402,
					"content": "绘马架已经修好了喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "欸？是你修好的吗？你还真是热心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090404,
					"content": "是代宫司大人的委托。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "是、是寝子大人亲自委托你的吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090406,
					"content": "难道是寝子大人注意到了我们的行动了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090407,
					"content": "也不完全是啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "悦子小姐！我们去绘马架那边看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090410,
					"content": "先是塞钱箱，然后是绘马架…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090411,
					"content": "这位代宫司大人，是认真想要整修这个神社吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090412,
					"content": "但是，这周围的居民已经在很久之前都全部迁移走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090413,
					"content": "换句话说，现在这座岛上除了我们之外，已经没有人会来神社参拜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090414,
					"content": "悦子小姐，你想说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090415,
					"content": "那位代宫司大人，到底有没有意识到这件事呢？它整修这座神社的目的又到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090416,
					"content": "…抱歉，也许是我多疑了。去绘马架那边看看应该也没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090417,
					"content": "但总之，提高警惕总没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722090418,
					"content": "悦子小姐，寝子大人只是一只猫啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				},
				{
					"id": 722090408,
					"content": "这么说也没错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
