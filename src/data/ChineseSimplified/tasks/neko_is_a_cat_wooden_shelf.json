					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "今天又是清净的一天啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090102,
					"content": "唔喵，汝等来了啊，昨天汝等打扫好屋子之后，奴家睡得很舒服…喵喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090103,
					"content": "那两个绿绿的人类，昨天也在神社里悠闲地散步呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090104,
					"content": "虽然，除了那两个绿绿的人类之外，还是没有人类来神社参拜…真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090105,
					"content": "不过那两个绿绿的人类散步的时候，似乎对那边的木架子很感兴趣，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090106,
					"content": "奴家记得阿响说…那种小木块叫做「绘马」，那个架子叫做「绘马架」，很多来神社的人，都是为了它来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090107,
					"content": "唔…人类很喜欢木头吗？来神社的人，往箱子塞钱之后，经常去木头架子摆弄，挂小木头块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090108,
					"content": "应该不是喜欢木头…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "是这样吗？那是人类因为喜欢马吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090110,
					"content": "为什么是马…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "…无论如何，木头架子已经坏掉了，木头片也很少很少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090113,
					"content": "虽然不知道汝等人类和木头、和马有什么关系，总之神社应该要有这个才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090114,
					"content": "所以说，一定是因为那个架子出了问题，上面的木头也都没了，所以才没人来神社的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090115,
					"content": "所以，奴家要拜托汝，去修好一下那个木头架子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090116,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "这么说来…上次我们修理「塞钱箱」用的材料，应该还有多余的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090118,
					"content": "这种事情奴家可不清楚…汝等人类，怎么这么喜欢木头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090119,
					"content": "呃…算了…我记得那些材料还有剩下的，我们去周围找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090120,
					"content": "总之，维修架子的事就拜托汝等了，奴家继续留在这里打理神社，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090129,
					"content": "箱子和架子都修好了之后，来神社的人应该会更多吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090121,
					"content": "这绘马架多久没修了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "好久以前坏的，它比箱子先坏。箱子好久好久好久以前坏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090123,
					"content": "根本不知道是什么时候坏的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090124,
					"content": "毕竟，奴家才不会特意去数太阳升起了多少次，又落下了多少次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090125,
					"content": "无论如何，上次我们修理「塞钱箱」用的材料，应该还有多余的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090126,
					"content": "这种事情奴家可不清楚…汝等人类，怎么这么喜欢木头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090127,
					"content": "呃…算了…我记得那些材料还有剩下的，我们去周围找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722090128,
					"content": "总之，维修架子的事就拜托汝等了，奴家继续留在这里打理神社，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722090111,
					"content": "和马也没关系…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
		{
