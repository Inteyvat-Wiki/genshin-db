			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"齐里亚布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260201,
					"content": "咳咳…您可能已经知道，教令院中各学派的研究各有所长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260202,
					"content": "那么请问，教令院中学者数量最多，也就是生论派学者为主的学院，它的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260203,
					"content": "阿弥利多学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "很好，完全正确。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260205,
					"content": "阿利弥多学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "唔，跟正确答案背道而驰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260207,
					"content": "阿多弥利学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "哈哈，很遗憾。不是这个答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齐里亚布"
				}
			]
		},
		{
