				"objectNames": [
					"齐里亚布",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "这些问题会不会太难了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260102,
					"content": "欸？旅行者！还请留步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260103,
					"content": "你叫我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "正是！哈哈哈，我之所以冒昧地请您留步，是想要请您帮一点小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260105,
					"content": "你丢东西了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "啊？您这是…听起来怎么这么熟练啊？哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260109,
					"content": "都不是，都不是，我既没有丢东西，也不缺研究的材料，至于取材嘛…我自己都取得够多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260110,
					"content": "咳咳，实际上，为了帮助一些新生迅速理解流传在须弥内的各种名词，我正在编纂一本「问答集」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260111,
					"content": "简单来说，就是以一问一答的形式，将各种复杂的名词解释给人听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260112,
					"content": "这样学习起来效率又高，学习的过程也不会很乏味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260113,
					"content": "不过，我不太确定这些问题的难易程度…所以想要请您来帮我判断一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260114,
					"content": "我不太了解教令院…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "哈哈哈，没事，等您回答完我的问题，就能对教令院稍微有些了解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260119,
					"content": "不用担心，这些问题不会太过艰深，只是一些…日常的小问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260120,
					"content": "那我们就开始吧，请听题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260116,
					"content": "怎么感觉我做过这种事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "你是说蒙德的斯万先生问你的那些问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230260118,
					"content": "斯万先生那个时候可是给过我们参考答案啊。这位学者…看起来就不会提前给我们参考答案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230260106,
					"content": "你缺材料了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "你要取材了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
		{
