			"dialogs": [
				{
					"id": 230260401,
					"content": "您仰头看看，可以看到那棵托举着教令院的大树吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260402,
					"content": "我接下来的问题很简单，但不少人都会忽视。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260403,
					"content": "那么请听题，这棵托举着教令院的大树，它的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "齐里亚布"
				},
				{
					"id": 230260404,
					"content": "大树。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
					"content": "哈哈哈，这名字很简洁，但很遗憾您答错了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齐里亚布"
				},
				{
