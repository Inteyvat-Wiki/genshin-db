			"dialogs": [
				{
					"id": 741560401,
					"content": "#我好紧张，{NICKNAME}，按照纸条上说的，我们只要在这里等他就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560402,
					"content": "耐心等待吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "好，我听你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560405,
					"content": "安静地等待了一会儿，随着一声「吱呀」，窗户被一张你们熟悉的面孔打开了。伯努瓦向外探了探头，看见你们后，他小心地从窗户口爬了出来。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "伯努瓦，这到底是怎么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560407,
					"content": "快走快走，被他们发现就糟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741560403,
					"content": "我有些问题想问他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
