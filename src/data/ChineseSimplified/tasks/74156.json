			"dialogs": [
				{
					"id": 741560801,
					"content": "你好呀，爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560802,
					"content": "…完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741560803,
					"content": "秋告诉我你要逃跑的时候我还挺惊讶的，我们已经关了你这么久，你居然还没有崩溃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560804,
					"content": "并且还能抓住机会，教唆这两位「正义使者」帮你逃跑，你的求生意志令我动容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560805,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560806,
					"content": "你明明有那么多地方可以跑，怎么最后偏偏选了你经常带秋来郊游的这地方？真是昏招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560807,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741560808,
					"content": "不用解释，人在危急关头慌不择路我能理解，习惯性地选了自己最熟悉的那条路对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560809,
					"content": "还好秋在你们后面出发，她还没有赶到这里，我不想在她面前聊这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560810,
					"content": "所以你到底是怎么想的呢？我实在搞不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560811,
					"content": "你以婚姻的名义，把她当商品卖给了别人，卖了两次，第一次你用她换来了枫丹廷的大房子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560812,
					"content": "第二次你胡乱选了一个人，只为了把她送走，房产和其他财物都归你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560813,
					"content": "你甚至在她受到欺凌的时候选择视而不见，她把第二次婚姻中生下的孩子都交给你抚养了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560814,
					"content": "她的孩子被你送走了，我估计是换了一大笔赡养费之类的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560815,
					"content": "今天你到底为什么还能心安理得地送小孩子点心，邀请他们去你家里做客呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560816,
					"content": "你都没有一刻会觉得良心不安吗？我百思不得其解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560817,
					"content": "说实话，我是在秋流浪的时候才遇到了她，她是一个很温柔的母亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560818,
					"content": "她对我朋友的女儿佩妮非常温柔，一天不见，小佩妮就嚷嚷着要见秋姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560819,
					"content": "哦，以防你觉得自己还有翻盘的可能，除了我之外，秋现在还有很多朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560820,
					"content": "你跑到哪里都没有用，我们会追你到天涯海角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560821,
					"content": "为什么是她这样的人在受折磨，一无所有，你这样的家伙富得流油？我觉得这事儿不太对劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560822,
					"content": "收起你多余的好奇心，他不值得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741560823,
					"content": "哎呀，被你听到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741560824,
					"content": "原来你就是秋，我总算知道怎么回事了。勒鲁瓦这一家子真复杂，唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}，我们一路跟伯努瓦走到这里，结果发现好多事都和我们之前以为的不太一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741560826,
					"content": "到这个地步，你觉得我们还应该管这件事吗？我听你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
