						741561214
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561214,
					"content": "你、你们别以为自己可以为所欲为，这里还有别人看着呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561215
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741561215,
					"content": "你以为我们不敢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561216
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561216,
					"content": "…小秋，放弃吧。她现在过得很好，她的父母很有财力，你找到她又能做什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561217
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741561217,
					"content": "总不能让她跟着你流浪吧，你是从梅洛彼得堡逃出来的，你要让她也过这种日子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561218
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741561218,
					"content": "她被收养了…为什么不告诉我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561219
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561219,
					"content": "她…她过得很好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561220
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561220,
					"content": "让我走吧，秋，对你来说我死还是活也都没有意义了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561221
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741561221,
					"content": "她有妈妈照顾，是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561222
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561222,
					"content": "是啊，她的养母对她很好。比你、比我能做到的都要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561223
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741561223,
					"content": "我找到她又能做什么…又有什么意义…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561224
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561224,
					"content": "是啊，这一切都没有意义了。我在枫丹廷的一切都归你，我不要了，让我走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561225
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741561225,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561226
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561226,
					"content": "你发什么呆啊，秋！你要放他走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561227
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561227,
					"content": "啧，伯努瓦，你真的以为你能跑掉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561228
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561228,
					"content": "我不会看着你们伤害伯努瓦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561229
					]
				},
				{
					"id": 741561229,
					"content": "你们非要作梗到底是吗？明明是不相干的人，非要卷进这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561230
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561230,
					"content": "滥好人，这就是我对你们的评价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561231
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561231,
					"content": "秋，你要放他走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561232
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561232,
					"content": "我…我不知道…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561233
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561233,
					"content": "唉，你还是心软。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561234
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561234,
					"content": "伯努瓦，你赌对了，孩子是母亲最大的软肋。秋…你又有帮手，这种情况下我会放你一马。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561235
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561235,
					"content": "但这没有关系，你可以试试看自己能跑多远，看看是我们先找到你，还是你先跑到我们找不到的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561236
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561236,
					"content": "顺带一提，我希望你没有误以为只有我会追你到天涯海角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561237
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561237,
					"content": "我们还有一些在梅洛彼得堡结识的朋友，这次到枫丹廷来之前，他们都说很想见见你本人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561238
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561238,
					"content": "我所有的财产你们都可以拿走…拿走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561239
					],
					"speakerTitle": "伯努瓦·勒鲁瓦"
				},
				{
					"id": 741561239,
					"content": "看来今天不是你的最后一天，在我的朋友们找到你之前，衷心祝愿你可以多活几天。滚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561240
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561240,
					"content": "伯努瓦向着枫丹廷的反方向，头也不回地走山路离开了你们的视线。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561241
					]
				},
				{
					"id": 741561241,
					"content": "至于你们…我们之后会离开枫丹廷，我想以后我们都不会再见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561242
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561242,
					"content": "秋，我们离开吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561243
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561243,
					"content": "…对不起，阿托斯，我的孩子她…对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561244,
					"content": "没关系，这是你的事情，你自己决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741561245,
					"content": "我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561246
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741561246,
					"content": "所以…一切原来是这么回事，真是复杂的一家子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741561247,
					"content": "该怎么说呢？我也不知道能评价些什么了。我有点可怜秋，她的孩子到最后也没有找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741561248,
					"content": "无论如何，至少我们阻止了一场流血事件，这样就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}