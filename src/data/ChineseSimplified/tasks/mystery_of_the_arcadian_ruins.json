			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "「她根本不爱他。清泉的热情奔放只是虚浮表象，冰冷寂寞之时，她的心才显露真实」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620702,
					"content": "想到什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620703,
					"content": "这该不会是你们碰巧捡到的恋爱小说的残页吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620704,
					"content": "原来搞错了呀，怪不得我这么聪明都猜不出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620705,
					"content": "哈哈哈…我开玩笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620706,
					"content": "唔嗯…你认真点啦，凯亚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620707,
					"content": "哈哈，这个谜题确实更难猜一点。清泉…是说清泉镇吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620717,
					"content": "有人在泉水里洗澡的时候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "遇到高低落差的时候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "「清泉的热情奔放」…什么情况下清泉会显得热情奔放呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620718,
					"content": "…这种有伤风化的事，感觉蒙德已经很少见了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620719,
					"content": "难道…这是你的兴趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620720,
					"content": "哦哦，真是抱歉，我本不该对他人的兴趣评头论足的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620721,
					"content": "#喂，你把{NICKNAME}想象成什么人了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620723,
					"content": "嗯…难道说是清泉遇到高低落差的时候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "呵呵。关键是如果那样，热情奔放的就不是清泉，而是在洗澡的人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620725,
					"content": "不错的想法！比如…遇到瀑布之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620726,
					"content": "这样看来，我想它指的应该是清泉镇后山的瀑布。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620727,
					"content": "只有在那里，恩泽蒙德的清泉才会显露热情奔放的一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620709,
					"content": "至于「瀑布的心」，应该就是瀑布左侧的山崖之上吧，我巡逻的时候从瀑布下面眺望过那里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620710,
					"content": "最后「冰冷寂寞之时」，大概和神之眼所能操控的冰元素脱不了关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620712,
					"content": "多亏了凯亚帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "你最好<color=#00E1FFFF>带上一位能够掌控冰元素的朋友一起去</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620713,
					"content": "不足挂齿，作为西风骑士如果连猜谜都不擅长的话，还怎么看穿罪犯的阴谋诡计呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620714,
					"content": "那我们去清泉镇看看了，就不打扰你的阴谋诡计啦~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620715,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620716,
					"content": "哦不对…是不打扰你看穿罪犯的阴谋诡计！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
