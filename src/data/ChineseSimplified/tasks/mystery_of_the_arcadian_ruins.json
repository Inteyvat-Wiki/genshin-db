				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "快让我看看~！藏起来的是什么东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620402,
					"content": "「她根本不爱他。清泉的热情奔放只是虚浮表象，冰冷寂寞之时，她的心才显露真实」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620407,
					"content": "这次同样也附了一张图呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620403,
					"content": "什么嘛，还要猜谜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620404,
					"content": "不行了，派蒙觉得好累，头晕晕的，大概是用脑过度了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620405,
					"content": "你明明就没动过脑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "总之这次也靠你了，嘻嘻。没有想法的话，就再去找凯亚帮忙吧~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
