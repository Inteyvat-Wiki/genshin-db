			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}！你们回来了，看上去线索你们已经拿到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620502,
					"content": "拿到了是没错，但好像比想象中复杂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620503,
					"content": "「在那湖中之城里，住着三只六臂巨人。两位守护着神像，一位守护着众神的财宝」，这是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620504,
					"content": "居然是用猜谜的方式…真是传统呢。让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620505,
					"content": "湖中之城应该指的是蒙德城没错…六臂巨人？六…什么东西与六相关来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620506,
					"content": "难道是螃蟹脚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "所以六臂巨人是巨大的螃蟹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620508,
					"content": "…先不说哪里有巨大螃蟹的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620509,
					"content": "螃蟹是有八只蟹脚的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620516,
					"content": "…那应该是指风车？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "应该是指…风车？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "哦~！不愧是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620519,
					"content": "风车上的扇叶刚好有六个，称它为「六臂巨人」似乎很形象呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620510,
					"content": "呜哇！你这么一说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620511,
					"content": "剩下的问题就简单了，三座风车中，有两座离神像很近，是守护神像的「巨人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620512,
					"content": "而除此之外的那一座所守护的东西，应该就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620513,
					"content": "宝藏！这里可难不倒我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620514,
					"content": "呵呵呵…希望真的能那样顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 4620515,
					"content": "#走吧走吧，{NICKNAME}我们快去那座风车下看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 46207,
			"completionStepIds": [
				46207
			],
