			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "唉…怎么会遇到这种事，早知道就不该帮<color=#00E1FFFF>他</color>这个忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620302,
					"content": "「他」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620303,
					"content": "真是谢谢你们！差点就要有大麻烦了，你们可比那些西风骑士靠谱多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620304,
					"content": "#小意思小意思，毕竟{NICKNAME}作为旅行者，每天都要面对很多麻烦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620305,
					"content": "旅行者？我好像听过你的情报，没想到被<color=#00E1FFFF>接头人</color>救了一命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620306,
					"content": "哇！原来你就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620307,
					"content": "呵呵呵…本来还不知道该如何报答你们。既然这样，就把情报免费送给你们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620308,
					"content": "做情报生意的，都知道多交朋友的重要性呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620309,
					"content": "真的可以吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "当然，毕竟是救命恩人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620312,
					"content": "嘿，真是好运！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620313,
					"content": "可是…怎么感觉便宜了凯亚那家伙，说好情报费由他来出的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620314,
					"content": "那听好咯，有关「阿卡狄亚遗迹」的情报…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620315,
					"content": "「在那湖中之城里，住着三只六臂巨人。两位守护着神像，一位守护着众神的财宝」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620316,
					"content": "…嗯？这就完啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620325,
					"content": "记录着情报的纸上还附了这样一张图…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620317,
					"content": "唔…这图上画的难道就是藏宝地？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620318,
					"content": "唔…好不容易拿到了线索，原来还要猜谜呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620319,
					"content": "#不过以{NICKNAME}的聪明才智应该不是问题吧~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620320,
					"content": "那是当然！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "唔嗯，就算解不出来，至少还可以去问问凯亚，他好像脑袋也很好用的样子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620326,
					"content": "那这份情报就先放在你们这边吧，如果忘记了可以随时拿出来看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "薇尔"
				},
				{
					"id": 4620327,
					"content": "嘿嘿，谢谢薇尔小姐啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620323,
					"content": "「湖中之城里住着三只六臂巨人，两位守护着神像，一位守护着众神的财宝」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620324,
					"content": "…究竟是指什么呢？如果不想麻烦凯亚，就自己好好想想吧~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620321,
					"content": "…应该…没问题吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "谢谢你，朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
		{
