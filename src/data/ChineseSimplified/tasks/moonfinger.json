				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110401,
					"content": "哇…里面还有汤呢，丘丘人的胃口可真大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110402,
						10110403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110402,
					"content": "现在是我们的实验台了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				},
				{
					"id": 10110404,
					"content": "这锅汤刚好可以作为「水」元素力的保护，那就开始点火，进行试验吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110405,
					"content": "【表现备注，伸手放置的动作or投石的视觉表现】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110406,
					"content": "这样应该就可以了吧？派蒙也会帮忙记着三块样品的编号和位置的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110407,
					"content": "那么现在开始！用<color=#00E1FFFF>「火」的元素力</color>不断加热大锅，直到结果出现为止——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110408,
					"content": "钟离先生说，<color=#00E1FFFF>光泽越亮越蓝</color>的矿石品质越好，要注意观察哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110403,
					"content": "可惜了这锅汤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				}
			]
		},
		{
			"id": 101109,
			"completionStepIds": [
				101109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101109",
							"2"
						],
						"stepId": 101109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110901,
					"content": "「夜泊石」放在这里就行了。我已经派人去喊珠宝匠了，之后就会把它们打造成仪式所需的器物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110902
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110902,
					"content": "对了，这么短的时间里，我还没来得及去见「公子」，珠宝匠的报酬，也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110903,
						10110904
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110903,
					"content": "如果他回来的话我就先垫付吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				},
				{
					"id": 10110905,
					"content": "那也只能这样了。话说回来，这里就是…「送仙典仪」的会场？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110906,
					"content": "嗯，这片场地我已经租借下来，开始进行仪式的筹备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110907,
						10110909
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110907,
					"content": "与「请仙典仪」同一个地点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110908
					]
				},
				{
					"id": 10110908,
					"content": "是的，用了相同的场地。这也是「璃月七星」默许的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110911,
					"content": "可这里刚发生过那么大的案件…啊，这么说来，我们作为嫌犯回到现场，要小心别被千岩军抓走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110940,
					"content": "不过总觉得，从绝云间回来以后，就再没遇到过找麻烦的千岩军了，这是怎么回事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110912,
					"content": "还有，之前留在这里的，岩王帝君的…呃，仙体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110913,
					"content": "以传统而言，可称之为「仙祖法蜕」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110914
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110914,
					"content": "啊对，是这个名字，钟离怎么什么都知道。所以「仙祖法蜕」是被七星藏起来了吗？可凶手不是还没有调查清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110915,
					"content": "只能说明七星已经心里有数…或者已经确定，现场的线索都找齐了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110916,
						10110917
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110916,
					"content": "还是觉得很奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110918,
					"content": "那些事，自会有玉京台的大人物考虑。想替他们分忧，也只是徒增烦恼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110919
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110919,
					"content": "在仪式举办前，「仙祖法蜕」会被暂时安放在「黄金屋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110920
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110920,
					"content": "「黄金屋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110921,
					"content": "璃月唯一的铸币厂…也是全提瓦特唯一的铸币厂。人类七国所流通的摩拉，全都是在那里铸造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110922
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110922,
					"content": "呜哇——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110923,
					"content": "不，我没在想不好的事。我是说，很符合「摩拉克斯」的身份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110924,
					"content": "但是，钟离为什么知道这件事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110925,
					"content": "因为「送仙典仪」得到了七星的默许，也算是半官方活动了，所以我能得到一些内部消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110926,
						10110927
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110926,
					"content": "七星提供场地、公子提供资金…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110928,
					"content": "或许他们各有目的吧…不过，在这商业之都，偶尔被人利用，也不是什么不可接受的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110929
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110929,
					"content": "在「契约」之神治下的璃月，唯有契约不可违背。至于契约之外的小动作，我倒是无所谓的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110930
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110930,
					"content": "好了，我们该去准备仪式所用的<color=#00E1FFFF>香膏</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110931
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110931,
					"content": "香膏？要去哪里弄呢？直接去买吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110932
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110932,
					"content": "不，这种敬神的香膏，若要熬制，所需的<color=#00E1FFFF>「霓裳花」</color>品质，同样也是很特殊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110933
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110933,
					"content": "名为「霓裳」的花，其花瓣是上好的纤维材料，多用于制作锦缎。但它的芳香又十分清雅，尤其适合供奉仙神的严肃场合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110934
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110934,
					"content": "又到了钟离普及上流社会知识的时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110935,
					"content": "更具体的细节，目前也不需要多言了。还是先随我一道去商人那里，收购材料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110927,
					"content": "他们究竟想利用这场仪式做什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110917,
					"content": "会不会太轻率了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110909,
					"content": "就这么把「现场」给…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110910
					]
				},
				{
					"id": 10110910,
					"content": "这也是「璃月七星」默许的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110904,
					"content": "之后去找公子报销吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				}
			]
		},
