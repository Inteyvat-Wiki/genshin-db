	"talks": [
		{
			"id": 101101,
			"completionStepIds": [
				101101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101101",
							"2"
						],
						"stepId": 101101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"石头"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110101,
					"content": "哟，客官，欢迎光临「解翠行」。今天要不要来开两块「璞石」试试手气？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110102
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110102,
					"content": "便宜又好玩，也许一不留神就发家致富了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110103
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110103,
					"content": "「璞石」？不要不要，我们是来挑…什么石头来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110104,
					"content": "夜泊石，品相至少要「烛照」级。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110105
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110105,
					"content": "「烛照」级的夜泊石…？嗯，原来不是游客。失礼了，我这就拿货，请看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110106
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110106,
					"content": "（黑屏，拿来了货）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110107
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110107,
					"content": "您看这怎么样？我们「解翠行」可是玉石老字号。瞧瞧这品相！绝对上佳，简直是岩王爷也难得降下的恩赐。您就放心随便选吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110108
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110108,
					"content": "这三块「夜泊石」看上去确实都很漂亮，不像是平时挖出来的那种…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110109,
					"content": "但，到底该怎么选啊，要不我们就随便选一种回去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110110,
						10110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110110,
					"content": "做赌石生意的老板，不能轻信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110111
					]
				},
				{
					"id": 10110111,
					"content": "很好。贸易之都的生存法则，看来你已经悟到了几分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110112
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110112,
					"content": "那钟离先生的意见呢？这些「夜泊石」该怎么选？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110114,
					"content": "哦？想要我来决定么。也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110115
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110115,
					"content": "要我说的话，答案其实很简单…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110116
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110116,
					"content": "嗯？答案是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110117,
					"content": "老板，我全要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110118
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110118,
					"content": "好！这位老爷，我早看出您气宇不凡，出手果真阔气——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110119
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110119,
					"content": "等等！等一下，老板，刚才他说的不算，我们再商量下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110120,
					"content": "（黑屏遮盖，和石头稍微拉开距离，变成钟离主角派蒙三人对话）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110121,
					"content": "喂！如果仪式只需要一种的话，全买下来不就白白浪费三倍的摩拉了吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110122,
						10110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110122,
					"content": "对，派蒙说得没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110124,
					"content": "摩拉…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110125
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110125,
					"content": "确实如此。刚才没想到这方面的问题，是我考虑不周了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110126
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110126,
					"content": "啊？买东西怎么能不考虑摩拉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110127,
					"content": "若凡事都要先考虑摩拉，也就等同于凡事都被摩拉束缚了手脚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110128
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110128,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110129,
					"content": "摩拉天然是货币，但货币天然不是摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110130
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110130,
					"content": "？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110131,
						10110134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110131,
					"content": "他说的是经济学。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110132
					]
				},
				{
					"id": 10110132,
					"content": "这就是有钱人的世界吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110133,
					"content": "虽然很懂宏观经济，但不懂得省一些「小钱」呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110136,
					"content": "不必动摇。即使摩拉束缚了手脚，我也有在束手束脚的情况下，依然能解决问题的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110137
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110137,
					"content": "「夜泊石」品相的鉴别，确实令人棘手。一块原矿不论好坏，它的质地、色泽，以及内部的岩纹，都不会有太大差别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110138
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110138,
					"content": "只有当夜泊石制造的器物成型以后，才会发现其中一些成品根本上不了台面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110139
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110139,
					"content": "这时再去找那些奸商理论的话，他们又会以「你的合成台不好」、「火候不对」之类理由来搪塞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110140
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110140,
					"content": "好险好险！原来这东西是这么容易上当受骗的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110141,
					"content": "不过，真正的鉴别方式还是存在的——真正的内行人，还是能鉴别的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110142
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110142,
					"content": "「如愚见指月，观指不观月。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110143
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110143,
					"content": "那是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110144,
					"content": "你用手指指向月亮，聪明人能明白你在指月，但不聪明的人只能看到眼前的手指，看不到月亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110145
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110145,
					"content": "纹路、外壳…这些都是手指。夜泊石是夜间照明用的奇石，「亮度」的重要性，才等同于天上之月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110146
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110146,
					"content": "优质的「夜泊石」会有更佳的火元素亲和力。也就是说，在高温之下，光泽越亮越蓝的矿石，品相就越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110147,
						10110148
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110147,
					"content": "原来钟离先生这么内行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110149,
					"content": "我已将玉石界价值千金的秘密告诉了你们，剩下就是实践了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110150
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110150,
					"content": "价值千金…唔，可惜派蒙觉得，以后应该再也用不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110151,
					"content": "（黑屏遮盖，回到石头摊前对话）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110152,
					"content": "老板，我们回来选石头了，麻烦把石头都借给我们烧一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110153,
					"content": "烧、烧一下？！烧不得啊几位老爷，你们烧完我还卖什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110154,
						10110156
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110154,
					"content": "那我们只要一点点样品可以吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110155
					]
				},
				{
					"id": 10110155,
					"content": "这…唉，罢了，还是听老爷们的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110158,
					"content": "这样，我从三块石头上都取些样品来，我老石亏一点就亏一点，就当交朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110159
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110159,
					"content": "放心，商界的规矩我明白。只要证明是好矿，自然不会让阁下吃亏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110160
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110160,
					"content": "（黑屏取样品）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110161
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110161,
					"content": "好了，就拿这些做样品吧，我用刻刀切下来的，还标上了号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110162,
						10110163
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110162,
					"content": "这些样品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110164,
					"content": "…也太薄了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110165,
					"content": "比纸还要薄…不对，比虫子的翅膀还要薄，薄得都快透明了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110166,
						10110168
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110166,
					"content": "老板真小气…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110167
					]
				},
				{
					"id": 10110167,
					"content": "小气？已经很大方了，再多取一点都是要我的命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110171,
					"content": "可是，薄成这样的话，一遇到火，就会马上灰飞烟灭了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110172,
					"content": "想让生意人让出利润，就如同要饿狼吐出刚下肚的肉一样，这也是没有办法的事。但其实在特殊条件下，这些薄片也够用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110173
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110173,
					"content": "什么样的特殊条件？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110174
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110174,
					"content": "在施加「火」之高温的同时，用「水」的元素力从中保护，就可以让样品不至于瞬间烧毁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110175
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110175,
					"content": "哦？这位老爷居然如此有见识。感谢体谅，感谢体谅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110176
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110176,
					"content": "平心而论，我们没有给出一定会买的承诺，便这样索要样品…本身就是有失公平的。璃月的「契约」之道，还需处处基于公平才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110177
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110177,
					"content": "那么，剩下的就是要找一个可以实验的地方了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110178,
						10110179
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110178,
					"content": "我记得达达乌帕谷里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110182
					]
				},
				{
					"id": 10110182,
					"content": "哦！我想起来了，在蒙德的时候见过…<color=#00E1FFFF>达达乌帕谷里</color>，「好肉族」的丘丘人有一口<color=#00E1FFFF>超大的锅</color>！很结实，应该能顶住元素反应！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110183
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110183,
					"content": "#{NICKNAME}，我们带好样品，然后出发吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110179,
					"content": "香菱家的厨房…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110180
					]
				},
				{
					"id": 10110180,
					"content": "你是说「万民堂」吗？也好，趁香菱不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110181
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110181,
					"content": "不妥，那里人来人往，万一元素反应失控，波及民众…我们不能冒这样的风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110182
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110168,
					"content": "老板的手艺令人佩服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110169
					]
				},
				{
					"id": 10110169,
					"content": "哈哈哈…过奖过奖，这些石头都是我的心肝宝贝，不这样温柔可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110170
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110170,
					"content": "万一不小心割了太多，可就真要了我的命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110163,
					"content": "好薄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110156,
					"content": "不然我们就不买了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110157
					]
				},
				{
					"id": 10110157,
					"content": "不买了…？欸，别，别这样，老爷…还可以商量，买卖就是商量的艺术，您说是不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110148,
					"content": "这就是高雅人士的精致生活吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110134,
					"content": "感觉他很有钱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110135
					]
				},
				{
					"id": 10110135,
					"content": "是有钱到了从来不用省一些「小钱」的地步吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110123,
					"content": "不，其实是浪费两倍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110113,
					"content": "我想问问钟离先生的意见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110114
					]
				}
			]
		},
		{
			"id": 101104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
