		},
		{
			"id": 10110731,
			"completionStepIds": [
				101107
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101107",
							"2"
						],
						"stepId": 101107,
						"stateName": "QUEST_STATE_UNFINISHED"
