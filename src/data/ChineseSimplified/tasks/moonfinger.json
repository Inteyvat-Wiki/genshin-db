				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110731,
					"content": "我要「三号夜泊石」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110732
					]
				},
				{
					"id": 10110732,
					"content": "没错！我也记得是这块！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110733,
					"content": "没问题，既然看中了，老爷们就拿去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110771
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110771,
					"content": "嗯。「三号夜泊石」这个种类的，来一箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110772
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110772,
					"content": "好嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110734
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110734,
					"content": "话说…别怪我多嘴，纯粹是好奇，各位老爷要这么多极品「夜泊石」，是有何贵干呐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110735
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110735,
					"content": "嗯…说也无妨。是制作「送仙典仪」的器具所用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110736
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110736,
					"content": "「送仙」…？！呃，最近我也听过不少小道消息，可一直没敢太多过问。那，那就是，岩王爷他，确实…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110737
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110737,
					"content": "…唉，难以置信。虽然如今「解翠行」有些没落，但祖祖辈辈一直多亏岩王爷护佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110738
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110738,
					"content": "据说两百年前岩王爷微服下城南，迷路时品尝民间小吃，就是用「解翠行」的玉勺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110739
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110739,
					"content": "俱往矣…俱往矣…唉，既然是跟岩王爷道别所用，那这箱「夜泊石」就只收半价吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110740
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110740,
					"content": "啊，这真的可以吗…明明老板之前还是一毛不拔的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110741,
					"content": "没有岩王爷的保佑，就没有这「贸易之都」如今的模样。作为一个生意人，怎么能去赚这种钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110742
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110742,
					"content": "呜…老板，你的心意一定会传达给岩王爷的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110743,
					"content": "在「璃月七星」与各位脚踏实地的商人共同努力之下，想必璃月也会一如既往地繁荣下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110744
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110744,
					"content": "所以，打起精神来吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110745
					]
				},
				{
					"id": 10110745,
					"content": "好…好，谢谢几位老爷了。嗯，我这是怎么了，哭哭啼啼的，财运都要溜走了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110746
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110746,
					"content": "既然挑选完毕，我们就带着「夜泊石」去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110747
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110747,
					"content": "喂！等等，虽说是半价，但也不代表可以不付钱呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110748
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110748,
					"content": "哦，不好意思，我又把付钱的事给忘了。让我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110749
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110749,
					"content": "…嗯…果然没带。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110750
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110750,
					"content": "没带什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110751
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110751,
					"content": "没带摩拉。真是惭愧，又疏漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110752,
						10110753
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110752,
					"content": "奇怪的金钱观念…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110754
					]
				},
				{
					"id": 10110754,
					"content": "那可怎么办，这不是一笔小数目…啊，对了，「公子」似乎给过我们一笔垫付资金来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110755
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110755,
					"content": "在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110756
					]
				},
				{
					"id": 10110756,
					"content": "好在有这些钱，老板看看，够不够？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110757
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110757,
					"content": "【表现备注：主角递给老板钱】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110758
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10110758,
					"content": "够了够了，半价的话，差不多正好…其实就算不够也没关系的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110759
					],
					"speakerTitle": "石头"
				},
				{
					"id": 10110759,
					"content": "不错，摩拉的事解决了就好。我们先把夜泊石送去玉京台吧，那里是我预定的场地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110760
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 10110760,
					"content": "一个摩拉都没出，钟离先生居然好意思说得这么轻描淡写！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110761,
						10110763
					],
					"speakerTitle": "派蒙"
				},
