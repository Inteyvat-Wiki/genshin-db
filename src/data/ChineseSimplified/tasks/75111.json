			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "这封信…像是夏安卡的笔迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 751110302,
					"content": "…肯定又是寄出去订货的货单。外面的包装已经破了，这封信可不能继续送，必须原件退回才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 751110303,
					"content": "我还要整理店里的快件，能请你帮我把这封信送回给夏安卡吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 751110304,
					"content": "她是圣火竞技场里「倦意之屋」的店主，她的商店很好找的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齐卡"
				}
			]
		},
