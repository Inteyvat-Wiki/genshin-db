				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "这看起来…像是寄给爱雅的快件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 751110202,
					"content": "…外包装都破了，再寄出去的话，说不定整个快件都会坏掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 751110203,
					"content": "我还要整理店里的快件，可以请你帮我把这份快件送给爱雅吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "米齐卡"
				},
				{
					"id": 751110204,
					"content": "她是圣火竞技场里「弗里达的色盘」的店主。她的店牌可显眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齐卡"
				}
			]
		},
		{
			"id": 7511103,
