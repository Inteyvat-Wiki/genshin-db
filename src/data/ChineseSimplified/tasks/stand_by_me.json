			"dialogs": [
				{
					"id": 750711001,
					"content": "#哈哈，亲爱的{NICKNAME}和派蒙，我的缪斯和…呃，小缪斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711002,
					"content": "#啊，还有{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711003,
					"content": "哪个才是小的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711004,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "哈哈，请别在意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711006,
					"content": "哼，我很在意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711007,
					"content": "又有什么新灵感了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "当然，不过…呃，嘿嘿，新的灵感就意味着…我又要找你们求助了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711009,
					"content": "没问题啦！反正你每次都会给钱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711010,
					"content": "哈哈，好呀，我的小小雇佣兵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711017,
					"content": "你看，我这次打算拍摄的是嵴锋龙…嘘，我们小心点。不要吵到它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711018,
					"content": "我还是第一次接触这种龙类，但我已经观察了它们一段时间了…真是迷人的动物…在坚硬的甲壳下面，它们也有自己的个性呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711019,
					"content": "嘿嘿，喂过它几次之后，它现在已经能听懂基本的指令了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711020,
					"content": "不过我需要驯龙大师做的事呢，就是和那头离群的嵴锋龙互动，让我拍一张它与其他同类在一起的照片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711021,
					"content": "嘿嘿，很简单，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711022,
					"content": "嗯，太简单啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711023,
					"content": "（反正不是你在忙…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "哈哈，就是这个劲头！来吧，帮我带来那头离群的嵴锋龙，我们就可以开始啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711024,
					"content": "（也没那么简单啦…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "又需要你的慕斯们帮忙了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "慕斯…我也想吃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711013,
					"content": "咕噜…咕噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "呃…是「缪斯」…不是吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750711015,
					"content": "嘿嘿，只要你给钱，我们就能换成吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750711016,
					"content": "随便你怎么说啦…不过我确实有钱，两位不用担心白忙活！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "马尼菲科"
				}
			]
		},
