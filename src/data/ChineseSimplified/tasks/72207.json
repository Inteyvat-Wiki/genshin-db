			"dialogs": [
				{
					"id": 722070101,
					"content": "还不够呢…还不够哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070102,
					"content": "哥哥留给我的宝藏，都在海螺里哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070103,
					"content": "海螺呀海螺，散落得到处都是呢…到处都是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070104,
					"content": "是哥哥的宝藏哟…我还不能离开呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070105,
					"content": "宝藏…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "哥哥去了雾海以外的地方，祭司大人很生气…他说哥哥的灵再也回不来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070108,
					"content": "但哥哥说：「那里有好看的花，有珍珠的海…爸爸也在那里划着船，带着小妹妹招手呢…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070109,
					"content": "哥哥留下了他的宝藏，就没有再回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岻伽"
				},
				{
					"id": 722070106,
					"content": "关于你的哥哥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
