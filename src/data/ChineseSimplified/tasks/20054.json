					"nextDialogs": [
						2005410111
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 2005410111,
					"content": "客人，您在这等等，休息一下，我去给您拿点吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005410112,
						2005410113
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 2005410112,
					"content": "不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005410114
					]
				},
				{
					"id": 2005410114,
					"content": "您还有事要办吗？真是麻烦您了，还顺路给我老头子送信来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005410116
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 2005410116,
					"content": "这些您拿着，留着路上用。还有那些战利品，老头子我也用不上，您也留着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005410117
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 2005410117,
					"content": "我们家，总算是要好起来了…",
