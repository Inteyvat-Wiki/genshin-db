			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"盖伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005401101,
					"content": "唉，天天守门，哪里有什么工作细节能写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401102
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401102,
					"content": "不，不如说是连工作内容都没有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401103
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401103,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401104
					]
				},
				{
					"id": 2005401104,
					"content": "哦，这个啊…是我老爹的事，他叫特纳，在晨曦酒庄工作。我当了西风骑士之后，他一直很高兴，来信也尽是问我工作情况啦什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401105
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401105,
					"content": "但我就在这守门啊！还守的是个压根没多少人走的侧门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401106
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401106,
					"content": "老爹还一直盼着我成就个什么伟业…守个门怎么能成就伟业嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401107
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401107,
					"content": "但是他身子一直不好，要是知道我在这守门，说不定就气出个好歹来，所以我在信里说，我一直随着骑士团的精锐在野外战斗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401108
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401108,
					"content": "但是一个劲地写信，一点证据没有，老爹肯定要疑心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401109
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401109,
					"content": "你是准备出去冒险吧，能帮我去找点战利品吗？给我的信增添一点可信度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401110,
						2005401111
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401110,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401112
					]
				},
				{
					"id": 2005401112,
					"content": "太感谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401111,
					"content": "你不如自己去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005401113
					]
				},
				{
					"id": 2005401113,
					"content": "虽然守门没什么前途，但是这也是骑士团分配给我的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005401114
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005401114,
					"content": "我可不敢擅离职守…要是丢了这份工作，老爹非气昏过去不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盖伊"
				}
			]
		},
		{
			"id": 20054021,
