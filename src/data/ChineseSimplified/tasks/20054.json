				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005402101,
					"content": "我想想…这次你就帮我找一个「牢固的箭簇」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402102
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005402102,
					"content": "我听骑士团的同事说，可以在丘丘人的身上找到。但也只是听说啦，哈哈，我也没有实战的机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402103
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005402103,
					"content": "骑士团的同事说，这东西很好拿到，但是我连这么简单的事都做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402104
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005402104,
					"content": "还亏我老爹总是说什么「家族的未来就指望你了」这种话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402105
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005402105,
					"content": "找到之后，就和信一起送给我老爹吧，拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005402106
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 2005402106,
					"content": "对了，信可别拆开了，我老爹还挺敏感的…说不定就觉得这封信是伪造的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盖伊"
				}
			]
		},
