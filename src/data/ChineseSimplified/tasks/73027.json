					"兰利遮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270201,
					"content": "咦，兰利遮，你怎么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270202,
					"content": "兰利遮种完花花之后就一直待在这边等你们啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270203,
					"content": "结果不知道为什么刚才大铁山突然有东西掉下来，差点砸到兰利遮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270204,
					"content": "呜啊，兰利遮对不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270205,
					"content": "派蒙为什么要道歉，兰利遮没关系的，兰利遮跑得快，所以不会被砸到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270206,
					"content": "总之你没事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "看来大机器人断掉的手臂真的把通往地下遗迹的入口砸开了。总算还是发挥了一点作用嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270208,
					"content": "既然这样我们就下去看看吧，不知道会有什么坏东西在等着我们呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270209,
					"content": "兰利遮和你们一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰利遮"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
