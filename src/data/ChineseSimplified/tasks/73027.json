			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "那里面那个发光的东西应该就是加扎里先生说的上面那个大家伙的混沌炉心了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270302,
					"content": "虽然看上去是被树枝和藤蔓封印住了，但好像有什么东西一直从里面流出来的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270303,
					"content": "呜呜，是脏东西，兰利遮能感觉到，就是这个让森林生病的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270304,
					"content": "唔，有好多深渊法师在那几根大树枝旁边不知道在做些什么，总感觉没有什么好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270305,
					"content": "我记得加扎里先生说过，炉心的封印受到了破坏，该不会就是这些深渊法师搞的鬼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270306,
					"content": "总之兰利遮先去外面找地方躲起来吧，我们去阻止他们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
