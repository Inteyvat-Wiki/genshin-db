			"dialogs": [
				{
					"id": 730270401,
					"content": "这下事情总算是告一段落了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270402,
					"content": "说起来，还真是一段漫长的冒险呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270403,
					"content": "说给加扎里先生听的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "对哦，他要是知道了炉心的事情，还可以帮我们申请经费什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270405,
					"content": "#不过，我可不想进入什么教令院。{NICKNAME}，你也不想的，对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270409,
					"content": "总之，虽然不知道「无留陀的化身」到底和这些深渊教团有什么关系，不过治好了森林的「病」，也是件好事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270410,
					"content": "呜呜呜，兰利遮谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270411,
					"content": "不用谢，兰利遮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "不过接下来，兰利遮打算怎么办呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270413,
					"content": "兰利遮要去参加无忧节，不过兰利遮很担心森林的「病」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270414,
					"content": "可能还会有希望森林生病的坏东西回来，兰利遮要保护森林。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270415,
					"content": "所以无忧节之后，兰利遮还要回来这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270416,
					"content": "兰那罗也很辛苦啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "如果兰利遮需要什么帮助的话，一定要过来找我们哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270418,
					"content": "嗯嗯，兰利遮知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "兰利遮"
				},
				{
					"id": 730270419,
					"content": "嘿嘿，要照顾好自己，我们一定还会再见面的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270406,
					"content": "说给罗因贾爷爷的话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "对哦，罗因贾爷爷一定会说「真是有趣的故事啊。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730270408,
					"content": "谁知道我们真的拯救了森林呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
