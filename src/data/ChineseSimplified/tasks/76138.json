				]
			},
			"dialogs": [
				{
					"id": 761380201,
					"content": "奈芙尔老板？还有…祖潘科先生，请问您有什么事么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761380202,
					"content": "我们的这位纳塔客人，似乎想要拜访「霜月之子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380203,
					"content": "但出于某些…礼节性的考虑，他还是希望找一个人，为他引荐一下。请吧，祖潘科先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380204,
					"content": "您好，莉莉希小姐！很高兴见到您，呃…这是我从纳塔带来的…化石标本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380205,
					"content": "谢谢您，可…祖潘科先生，我早就认识您了呀，您真的不用这么客气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761380206,
					"content": "啊？您又是怎么发现我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380207,
					"content": "我之前发放餐食的时候，您不是在旁边看吗？转悠来，转悠去，但就是不站进队里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761380208,
					"content": "我还以为您也想拿，但又不好意思上前，所以还特意悄悄留了一份给您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761380209,
					"content": "但…您从来也没来拿过餐。要是您今天不来，我也要拜托人去问问您，有什么需要帮助的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761380210,
					"content": "这…这…真是抱歉，我是在犹豫，到底怎么打招呼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380211,
					"content": "所以，莉莉希小姐，我能去「霜月之子」看看么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380212,
					"content": "可以呀，我们「霜月之子」里本来也有几位外来的客人。但您要去做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761380213,
					"content": "留个影，查查资料，如果可能的话…再找人询问一下传说故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380214,
					"content": "我是纳塔「龙遗物研究协会」的成员，如果能搜集到一些和我的研究方向有关的资料，那就最好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380215,
					"content": "喔…那你就是要去看书喽？我想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761380216,
					"content": "既然二位已经顺利地结识，那这次的委托，就算是完成了，我也该离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380217,
					"content": "谢谢你，奈芙尔老板！那个…费用我还是会付给您的，怎么能让您白跑一趟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380218,
					"content": "随您的方便，祖潘科先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380219,
					"content": "那么，我就先告辞了，祝二位聊得愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙尔"
				}
			]
		}
	]
}