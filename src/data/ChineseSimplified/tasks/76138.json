					}
				]
			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "啊…奈芙尔老板！天哪，您来得正巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380102,
					"content": "下定决心了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380103,
					"content": "欸？下定…您、您说什么，难道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380104,
					"content": "我知道，你一直想要去「霜月之子」那边拜访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380105,
					"content": "所以，你希望先结识莉莉希，想要用这段友谊作为拜访「霜月之子」的敲门砖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380106,
					"content": "您…您都知道了，哎呀，我明明都把这事憋在心里，没怎么和人说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380107,
					"content": "祖潘科先生，人在保守秘密时，也要学会隐瞒「正在保守秘密」这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380108,
					"content": "不然的话，你在心里竖起的那道墙，迟早会开始漏风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380109,
					"content": "唉，我在家乡的时候，就不怎么会隐瞒心思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380110,
					"content": "算了，既然您都知道了，那您能帮我引荐一下吗？我是外乡人，贸然去打扰莉莉希小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380111,
					"content": "她们「霜月之子」的人都好心得很，别说来访者是外乡人，就算不是人，也会温柔地接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380112,
					"content": "啊？真的假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380113,
					"content": "但无论如何，贸然打搅总是不太礼貌，还是请奈芙尔老板代为引荐一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761380114,
					"content": "好，现在她们应该刚好发放完了餐食，是一个不错的聊天时机，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380115,
					"content": "啊…这一次就不用收费了，我只是恰巧路过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761380116,
					"content": "谢谢您，奈芙尔老板！我这就去收拾东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖潘科"
				}
			]
		},
