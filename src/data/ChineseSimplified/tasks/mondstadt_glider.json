						4270202
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270202,
					"content": "我已经布置好了，我们继续考试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "安柏"
				},
				{
