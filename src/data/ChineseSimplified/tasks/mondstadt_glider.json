			"trigger": {
				"objectNames": [
					"奥特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "您好，我是西风骑士团的骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270802,
					"content": "哇，发生什么了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4270803,
					"content": "请出示一下您的飞行执照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270804,
					"content": "飞，飞行执照…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "无证非法飞行，依据蒙德城治安管理法第七条第十二款，请跟我走一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270807,
					"content": "你有权保持沉默，但是风会牢记你所说的每一句话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270808,
					"content": "等等！我们正在进行飞行执照考试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270809,
					"content": "啊，是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270810,
					"content": "但在这个时候进行飞行执照考试，真是不巧啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270811,
					"content": "发生什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270812,
					"content": "骑士团刚收到教堂修女的报案，「怪鸟」又用风之翼逃走了，所以刚才我还以为你的考生是那家伙的同伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270813,
					"content": "怪鸟？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4270814,
					"content": "是蒙德城里的一个惯犯。他总是用风之翼作案，所以得到了「怪鸟」这种外号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270815,
					"content": "唔，那家伙飞得很快吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270816,
					"content": "目前…我们一次都没能追上过他，这一次本来是想用教堂里的文物做诱饵，把这家伙抓住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270817,
					"content": "可是还是让他带着文物跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270818,
					"content": "不过，这次修女们已经提前用元素魔法在文物上做好标记了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270819,
					"content": "但那家伙飞行的速度太快了，跟着元素痕迹也追不上他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270820,
					"content": "居然是个飞行高手，那就摆明了非我安柏出马不可了——嗯，那家伙往哪边逃了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270821,
					"content": "据我所知，他最后出现的地点是清泉镇附近，但现在已经过去了这么长时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "奥特"
				},
				{
					"id": 4270822,
					"content": "#就放心交给我吧，正好{NICKNAME}也在，我们一起追上去，把这只怪鸟抓捕归案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270823,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "别担心啦，等抓到怪鸟之后，我就直接…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270826,
					"content": "…去帮你向琴团长说明情况，咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270824,
					"content": "那飞行执照的考试是不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "被，被兔兔伯爵吃掉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
