					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "看来你已经掌握了用风之翼飞行的诀窍，那么我们就开始最后一环吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270402,
					"content": "毕竟这条路已经飞过一次了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4270403,
					"content": "那么，这是最后一项测试，通过了之后就可以等着飞行执照签发啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270404,
					"content": "朝着飞行执照，预备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270405,
					"content": "…开始！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
