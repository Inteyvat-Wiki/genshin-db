			"dialogs": [
				{
					"id": 740120501,
					"content": "呜哇，好严格！我可绝对不想在这家伙手下工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120502,
					"content": "还说什么「集体荣誉感」…连饭都不让人吃，还有什么荣誉感嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120503,
					"content": "他说的也不是没有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "真是莫名其妙的规定啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "唔，纪律确实很重要啦…不过也没必要做到这种地步吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120506,
					"content": "就是啊！越是不知道怎么才能做实事的家伙，就越喜欢搞这种奇怪的纪律和规定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120507,
					"content": "咦？仔细想想的话，要是我们也敲锅的话，说不定就能把那个叫舒米洛夫的小队长给引下来了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740120508,
					"content": "#这样一来，我们说不定就能上去了…{NICKNAME}，我们快去试试看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
