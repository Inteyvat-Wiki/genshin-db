			"trigger": {
				"objectNames": [
					"麻纪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "你已经收拾好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110202,
					"content": "已经收拾好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "多谢你。这些签文就交给我吧，我会把它挂在合适的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110204,
					"content": "这些东西请你收下，谢谢你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110205,
					"content": "大家迫切想要化解厄运，或者是交上好运的心情，我也不是不能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110206,
					"content": "但是我想…如果真的想要解决某些眼前的问题，比起一味地求签祈福，还是自己行动起来更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110207,
					"content": "如果自己都不行动的话，就算神明想要给予帮助，也完全没有途径吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻纪"
				}
			]
		},
