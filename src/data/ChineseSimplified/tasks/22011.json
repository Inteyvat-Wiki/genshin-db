			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麻纪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "真是的…到底是谁传的这个谣言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110102,
					"content": "什么谣言？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "是关于神社里求签的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110104,
					"content": "你知道「求签」是什么意思吧？简单来说，就是用抽签的方式进行的一种占卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110105,
					"content": "根据抽到签上的签文，人们也能得知一些对于未来的简单预言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110106,
					"content": "抽到了好签自然没问题，如果抽到不太好的签，人们一般就会把签留在神社这边，以此来祈祷化解可能到来的厄运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110107,
					"content": "但是…不知道到底是谁开始传一个谣言，说什么抽到坏签就快丢到树顶上，神灵会优先为你消灾驱祸之类的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110108,
					"content": "还说什么，丢得越高，好运就越快会实现，而厄运就越快被化解。真是无稽之谈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110109,
					"content": "然后，这个谣言越传越离谱，现在不仅是抽到的签，还有人往树上丢摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110110,
					"content": "还有模有样地说，只要丢上去的摩拉能停在树梢上，那就是神明接受了祈祷，不仅心中的愿望能实现，还能带来一整年的好运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110111,
					"content": "真的有这种事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "怎么可能！先不说到底神明能不能听到祈祷…但丢摩拉这种事也太离谱了，摩拉不都长得一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110113,
					"content": "难道他们是想让神明把摩拉一枚枚捡起来看不成？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110116,
					"content": "虽然我理解大家都想要祈福，但…但这么往上丢东西，压根就祈不了福啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110117,
					"content": "而且，那些丢上去的签文和其他东西被风一吹，掉得到处都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110118,
					"content": "我之前也试着自己去收拾过，但我实在不擅长运动，不仅东西没收拾干净，反而因为不知道怎么下来而折腾了好一阵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110119,
					"content": "但放着那些东西不管的话也绝对不行…旅行者，你能帮我去屋顶收拾一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110120,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "那这件事就拜托你了，旅行者，请去屋顶收拾一下吧，如果拿到签的话，请拿来给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110122,
					"content": "那些签会怎么处理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "那些签…按照萤美小姐的意思，无论怎么说，那些都是大家求到的「运道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110124,
					"content": "如果随便丢掉的话，未免有点不合适，所以收拾下来之后，我也会把那些签按规矩放在它们应该在的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110125,
					"content": "唉，如果大家从一开始就按规矩做的话，哪还会这么麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110126,
					"content": "那这件事就拜托你了，旅行者，请去屋顶收拾一下吧，如果拿到签的话，请拿来给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻纪"
				},
				{
					"id": 220110114,
					"content": "只要说清楚就可以了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "这么做的人实在是太多了，我已经快要说不过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "麻纪"
				}
			]
		},
		{
			"id": 2201102,
			"completionStepIds": [
				2201105
			],
