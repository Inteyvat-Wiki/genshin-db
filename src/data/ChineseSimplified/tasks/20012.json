					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "谢谢您，希望我的两个孩子能和您一样，有个好品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "惊慌的米拉娜"
				},
				{
					"id": 200120205,
					"content": "还有别的事。",
