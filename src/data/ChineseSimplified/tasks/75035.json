					"nextDialogs": [
						750351233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351233,
					"content": "#铛铛！是亮晶晶的宝石，{REALNAME[ID(2)|SHOWHOST(true)]}喜欢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "派蒙"
				},
				{
