					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351227,
					"content": "#唔，既然{REALNAME[ID(2)|SHOWHOST(true)]}送给了我们东西，我们也送{REALNAME[ID(2)|SHOWHOST(true)]}点什么当作回礼吧。",
