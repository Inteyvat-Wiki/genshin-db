					"nextDialogs": [
						750351225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351225,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "哼哼，我们就不客气地全都收下了！嘿嘿，就放在我小金库的背包夹层里吧，说不定什么时候就能用上呢！",
