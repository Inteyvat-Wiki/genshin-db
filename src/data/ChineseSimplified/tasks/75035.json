					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#唔，回到这里以后，{REALNAME[ID(2)|SHOWHOST(true)]}就看起来就有点激动呢，是不是有什么话要跟我和{NICKNAME}说呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750351209,
					"content": "唔嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "欸？是让我们转过身去的意思吗？",
