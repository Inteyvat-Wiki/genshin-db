					}
				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "你们来啦，库拉霍师傅已经把加工好的宝石留在铺子里了，嘱咐我说要亲手交给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 750350302,
					"content": "欸？库拉霍大师今天也不在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350303,
					"content": "是啊，他又出去采风了。顺便，他还打了一套可以背在身上的锁，说是为了防止工具被偷，好奇怪…会有人想偷我们的雕刻工具拿去卖吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 750350304,
					"content": "当然不是啦！是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350305,
					"content": "（…原来伊蜜还不知道是被鸟抢走的…还是给大师留点面子吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350306,
					"content": "是…是有人觉得这个方法可以偷师吧，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350307,
					"content": "不管了…那，宝石我们就收下啦！这个形状好漂亮，真不愧是大师呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350308,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#看上去{REALNAME[ID(2)|SHOWHOST(true)]}也很喜欢呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350310,
					"content": "#替{REALNAME[ID(2)|SHOWHOST(true)]}谢谢你们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "嘿嘿，只要你们的小龙喜欢就好，谢意我会转达给库拉霍师傅的，记得常来哟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蜜"
				}
			]
		},
