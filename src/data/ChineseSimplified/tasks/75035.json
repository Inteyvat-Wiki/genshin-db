			"dialogs": [
				{
					"id": 750350101,
					"content": "请问…唔，你是库拉霍大师吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350102,
					"content": "这倒确实是我的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "库拉霍"
				},
				{
					"id": 750350103,
					"content": "嘿嘿，原来你就是在采风的珠宝大师，我们是伊蜜推荐过来的！刚才看到你在盯着树看，难道这也是采风吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350104,
					"content": "呃，其实…算了，现在已经不重要了，唉，你们是有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "库拉霍"
				},
				{
					"id": 750350105,
					"content": "#我们带来了一颗漂亮的宝石，想请你为我们的{REALNAME[ID(2)|SHOWHOST(true)]}加工一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350106,
					"content": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}，快把宝石拿出来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350107,
					"content": "呀！呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350109,
					"content": "#耳边传来鸟类的羽翅扑腾的声音…\\n等反应过来时一看，{REALNAME[ID(2)|SHOWHOST(true)]}的爪子里，已经失去了宝石的踪影。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "唔、唔嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "哇，等等，宝石呢？那么大的一颗宝石去哪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350112,
					"content": "好像被鸟衔走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "怎么会这样，这里的鸟还抢东西的？太没有礼貌了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350114,
					"content": "唔呀！唔呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "其实，我刚才要说的就是这件事，就算宝石没被抢走，我也没办法帮你们雕刻了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "库拉霍"
				},
				{
					"id": 750350116,
					"content": "因为我的工具，也被这群该死的鸟抢走了啊！我刚才正是在仔仔细细挨个看，工具到底在哪只鸟的爪子里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "库拉霍"
				},
				{
					"id": 750350117,
					"content": "#还…还有这种事？好坏的坏鸟，{NICKNAME}，我们赶快去把宝石追回来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750350118,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "别忘了还有我的工具——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "库拉霍"
				}
			]
		},
