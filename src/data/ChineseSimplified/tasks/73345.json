			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"毕洛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733450101,
					"content": "你们怎么又来了，该不会是被我们的识主大人拒之门外了吧！和我不同，那位大人可不会对花灵随意妥协。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450102
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450102,
					"content": "我奉劝你们还是赶紧离开这里，不要想着再从我这里套出什么话来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450103
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450103,
					"content": "明明每次都是你自己说的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450104,
						733450105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450104,
					"content": "关于那位「识主」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450106
					]
				},
				{
					"id": 733450106,
					"content": "将「灵光绝唱」与那先朱那背叛的事情告诉了毕洛。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733450107
					]
				},
				{
					"id": 733450107,
					"content": "真是胡说八道，识主大人是我见过的最为渊博的学者，怎么会与那些污秽之人为伍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450108
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450108,
					"content": "我看你是蒙混过关不成，想要挑拨离间我等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450109
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450109,
					"content": "不过你实在编造的太离奇，我可不会上你们的当！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450110
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450110,
					"content": "唔…让我想想，我们手上不是有那先朱那交给我们的笔记吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450111,
					"content": "上面还有那先朱那留下的批注，把那个拿给毕洛看他应该就能相信我们了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450112,
					"content": "什么笔记？你们怎么总喜欢耍这种小花招…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450113
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450113,
					"content": "将「雷内的调查笔记」交给了毕洛查看。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733450114
					]
				},
				{
					"id": 733450114,
					"content": "不错，这确实是识主大人的笔迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450115
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450115,
					"content": "好不容易矫论团才出了一位这样渊博的识主，没想到他竟然背弃了矫论团的使命，投靠了那些追随黑渊的污秽之人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450116
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450116,
					"content": "唉，你们或许有所不知，我们与这些追随黑渊的家伙已经缠斗了几百年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450117
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450117,
					"content": "可以说，他们就如同矫论团的影子一般，一直在试图玷污我们的传承。矫论团变成现在这副模样，可以说与他们也脱不了干系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450118
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450118,
					"content": "没想到这次就连我们的首领也…实在是家门不幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450119
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450119,
					"content": "如今那先朱那那家伙恐怕已经与那些污秽之人同流合污，潜藏进阴影之中了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450120
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450120,
					"content": "过去他曾跟随阿亚德瓦前辈前往教令院学习，回来之后便沉迷于那些古代的文献。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450121
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450121,
					"content": "矫论团原本大多是重视笃行之人，已经很久没有过像这样的学者了。本以为他会带领矫论团走向复兴，结果却…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450122,
						733450123
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450122,
					"content": "我们也没想到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450124
					]
				},
				{
					"id": 733450124,
					"content": "不过既然事情已经变成了这样，剩下的事情就交由我来处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450125
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450125,
					"content": "当务之急是要选出新的识主，不然若是被人乘虚而入可就糟糕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450126
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450126,
					"content": "唔，虽然感觉你们也没什么虚可以入了啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450127,
					"content": "实在惭愧…作为赔罪，这是那先朱那交由我所保管的，记录了矫论团传承之事的文献。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450128
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450128,
					"content": "虽然我是看不懂，不过你们应该会感兴趣吧，不如就交给你们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450129
					],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450129,
					"content": "要是再遇到什么事情的话，也可以来找我帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "毕洛"
				},
				{
					"id": 733450123,
					"content": "不是你的错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450124
					]
				},
				{
					"id": 733450105,
					"content": "虽然和你说的不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450106
					]
				}
			]
		}
	]
}