			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7334501",
							"2"
						],
						"stepId": 7334501,
						"stateName": "QUEST_STATE_UNFINISHED"
