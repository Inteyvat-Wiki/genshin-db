			"dialogs": [
				{
					"id": 221170401,
					"content": "你这孩子，怎么还不去多穿点衣服！要是着凉了就要遭大罪啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170402,
					"content": "那些琥珀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "那些琥珀啊，都是我那位老朋友弄出来的，他和我说，这是为了防一些侵扰山上的怪物和毛贼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170404,
					"content": "经年日久…到现在，有些山上的琥珀里面还关着些莫名其妙的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170405,
					"content": "唉，这些琥珀啊，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170406,
					"content": "您的那个壶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "喔，可要谢谢你们啦，我老婆子的那个壶，总算是又干净了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170408,
					"content": "这不，我过来取东西，就是要再把那个壶给好好打理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170409,
					"content": "打扫干净，打理好了之后，才好再用来请客啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		}
