				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "你这孩子，怎么还不去多穿点衣服！要是着凉了就要遭大罪啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170302,
					"content": "婆婆，这是您落下的东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "我看看…对，对，就是这个东西，还真落在山上了，我这个记性啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170304,
					"content": "别看啦，孩子们，这盒子里装的都是些无聊的老物件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170305,
					"content": "喏，这些是给你们的，收好了，谢谢你们帮我跑这么一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 221170306,
					"content": "唉，得赶紧把这盒子放进壶里了，别再忘记了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				}
			]
		},
