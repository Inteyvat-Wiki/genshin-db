						],
						"pointId": 10046
					}
				]
			},
			"dialogs": [
				{
					"id": 750620501,
					"content": "你们还是快点走吧，再不走就来不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620502
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750620502,
					"content": "为什么来不及…对，因为，因为冒险团已经全军覆没了，所有人都被…都被那只漆黑的巨兽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620503
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750620503,
					"content": "他们让我保护那些撤离的人，至少要让他们离开这座城，「花羽会」的救援就在路上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620504
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750620504,
					"content": "我要清除掉这些邪恶的魔物，这样，那些剩下的人才能回到光明照耀的土地…咦，可是，为什么我在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620505
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750620505,
					"content": "耳边的声音…唔，耳边的声音变得越来越重，我…得回到瀑布那才行，我得…回到瀑布那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620506
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750620506,
					"content": "勇士，你们也要，早点离开为妙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因"
				}
			]
		}
	]
