			},
			"dialogs": [
				{
					"id": 721310101,
					"content": "形状奇特的石灯，似乎放射着令人不安的能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721310102,
					"content": "这是…石灯笼？为什么这里会有石灯笼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721310103,
					"content": "欸，灯柱上被人写了字，我们看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721310104,
					"content": "「诸位工友，关于此镇物如有疑问，请至无想刃狭间，与梶先生商谈。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721310105,
					"content": "字迹看起来很新。下面还有几列粗犷的小字：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721310106,
					"content": "「十分抱歉我们也帮不上什么忙，昨日刚刚接到天领奉行大人的紧急疏散令。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721310107,
					"content": "「希望有缘来日再见，共同商讨解决『祟神』作乱之事。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "观察"
				},
				{
					"id": 721310108,
					"content": "这个梶先生似乎对石灯笼很在意的样子，我们不如去无想刃狭间问问他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7213102,
