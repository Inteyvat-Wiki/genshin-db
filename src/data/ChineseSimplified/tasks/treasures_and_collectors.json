			"dialogs": [
				{
					"id": 750090201,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090202,
					"content": "这个小球…看起来像是零件之类的东西。你喜欢这个吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090203,
					"content": "唔…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "虽然不是挖出来的东西，但毕竟还是在这里发现的…说不定也有很高的价值呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090205,
					"content": "离开的时候去问问吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
