			"dialogs": [
				{
					"id": 750090101,
					"content": "…进场三百摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "奎皮亚"
				},
				{
					"id": 750090102,
					"content": "能便宜点吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "这是龙遗物研究协会规定的价格，没有商量的余地。据我所知，这里已经是定价最低的一处挖掘场了，毕竟开发得早。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "奎皮亚"
				},
				{
					"id": 750090106,
					"content": "不过现在也偶尔会有像你们这样的梦想家来碰碰运气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "奎皮亚"
				},
				{
					"id": 750090107,
					"content": "说不定是之前的一百甚至一千人都没眼光，遗漏了那看似平平无奇实则价值连城的珍贵龙遗物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "奎皮亚"
				},
				{
					"id": 750090108,
					"content": "愿意花三百摩拉做个美梦的可是大有人在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "奎皮亚"
				},
				{
					"id": 750090109,
					"content": "那么，你也相信自己才是独一无二的那个幸运儿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "奎皮亚"
				},
				{
					"id": 750090110,
					"content": "呜…呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "我对自己的运气有信心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也想去碰碰运气吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090114,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "看样子是很感兴趣呢。哼哼，区区三百摩拉，就由我来出好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090116,
					"content": "只用三百摩拉就可以买到三份希望，还是很划算的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090117,
					"content": "那就祝几位旗开得胜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奎皮亚"
				},
				{
					"id": 750090112,
					"content": "无所谓，我有幸运小龙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "只要打败你就是免费对吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "通常来说都不会这么想啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "派蒙"
				}
			]
		},
