			"trigger": {
				"objectNames": [
					"「寝子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "哎呀…喵喵，跑到哪里去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "是汝等啊。有些小家伙不知道跑到哪里玩了，真是令人担心哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100104,
					"content": "外面可是很危险的。虽然奴家教过它们很多次了。外面又有拿棒子的毛茸茸人，又有…圆形的水和火的东西，可是相当危险哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100105,
					"content": "如果跑到酥酥麻麻里面去，还会弄得全身的毛都竖起来。这种滋味，奴家可不希望小家伙们也体会到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100106,
					"content": "但总有几个不听话的小家伙到处乱跑，奴家每次都要费很大劲把它们找回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100107,
					"content": "今天又有几个不知道跑到哪去了。好担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100108,
					"content": "汝也帮奴家。找到「昆布丸」和「八宝」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100109,
					"content": "「昆布丸」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "是个好孩子。这一代昆布丸很聪明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100111,
					"content": "「这一代」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "阿响有时候会说到的东西。奴家也不知道是什么，但看她说的时候的表情，那应该是好东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100113,
					"content": "奴家会用好东西给小家伙取名字。等小家伙长大了、走了以后，奴家就会用这些名字，给更小更小的小家伙取名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100114,
					"content": "「昆布丸」喜欢在高的地方睡觉。去好高好高的地方找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100115,
					"content": "那，「八宝」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "非常机灵的小家伙。很喜欢吃鱼。所以，有时候会在海边找被冲到岸上的鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100117,
					"content": "但是，很危险。水可是可怕的东西。好久好久以前，有个叫「吾辈」的小家伙就掉到水里去，差点就回不来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100118,
					"content": "「八宝」应该在海边看，有没有小鱼和螃蟹。去有咸水的地方找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100119,
					"content": "太宽泛了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "总之，就是，好高好高，还有咸水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100121,
					"content": "总、总之，把地图拿出来让寝子看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100122,
					"content": "汝啊，悟性不行哪。你看，这里就是好高好高。这里就是咸水。它们一定在这两个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100123,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "那就拜托汝等了，喵喵，这些孩子可真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100125,
					"content": "我不擅长抓猫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "喵喵，没关系，那些孩子都不怕人的…不如说，正是因为没人陪它们玩，它们才会到处乱跑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100127,
					"content": "那就拜托汝等了，喵喵，这些孩子可真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
