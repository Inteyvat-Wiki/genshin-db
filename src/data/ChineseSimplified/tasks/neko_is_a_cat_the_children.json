					"「八宝」",
					"「昆布丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "汝等找到他们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100402,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "汝等，为什么总是不听奴家的话呢？为什么不能像「阿饭」那样听话呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100404,
					"content": "「阿饭」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "确实是用好东西当名字呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100406,
					"content": "喵，喵喵喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "「八宝」"
				},
				{
					"id": 722100407,
					"content": "喵！喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100408,
					"content": "不许和奴家顶嘴！不然以后奴家可不去找汝等了，就给奴家从…从太阳还在天上，饿到月亮到天上，再饿到太阳跑到天上，然后再自己想办法回来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100409,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100410,
					"content": "呵呵，这才是好孩子，好了，回来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100411,
					"content": "多亏汝等了，要是没有汝等帮忙，这小家伙们又要在野外挨饿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722100412,
					"content": "它们应该能自己回来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "总之，奴家很感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "「寝子」"
				},
				{
