			"dialogs": [
				{
					"id": 722100301,
					"content": "喵！喵喵，喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100302,
					"content": "呜啊！好、好凶的小猫，小心点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100303,
					"content": "喵，喵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "喵喵？喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "「昆布丸」"
				},
				{
					"id": 722100307,
					"content": "嘿嘿，虽然很凶，但还是乖乖让你抱着了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722100305,
					"content": "我是带你回家的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
					"content": "喵！喵…喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "「昆布丸」"
				}
