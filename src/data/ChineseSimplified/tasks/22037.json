			"dialogs": [
				{
					"id": 220370201,
					"content": "这些蘑菇到底是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370202,
					"content": "我来清理蘑菇了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "你这次是从瓦希德先生那边过来，帮我清理蘑菇的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370206,
					"content": "唔，那就拜托你了，那些田里的蘑菇实在是太多了，我这把老骨头可摘不完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370207,
					"content": "这些蘑菇，怎么长得这么快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370203,
					"content": "对不起，给您添蘑菇了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "添蘑菇？呃，我家的餐桌上可不太缺蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "绀田传助"
				}
			]
		},
