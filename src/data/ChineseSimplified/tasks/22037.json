			"trigger": {
				"objectNames": [
					"瓦希德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "糟了…怎么会这样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "旅行者，我正在找你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370104,
					"content": "你还记得绀田传助这个顾客吗？他前几天过来店里，问了问关于肥料的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370105,
					"content": "他对肥料还满意吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "满意不满意的…倒也不能这么说，严格来说，我觉得绀田传助先生应该是「迷茫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370107,
					"content": "迷茫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "呃是这样的，你上次去宣传了之后，绀田先生确实也按照你说的方法施用了我们的肥料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370109,
					"content": "但是，虽然这之后庄稼确实长了起来，但同时…地里还莫名其妙地冒了大量的蘑菇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370110,
					"content": "绀田先生来说了之后，说实话，我也有点茫然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370111,
					"content": "但不管怎么样，这种情况应该和施用在地里的肥料脱不开关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370112,
					"content": "旅行者，能拜托你再去绀田村一趟，帮绀田先生清理一下田里的那些蘑菇吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370113,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "那就拜托你了，我要在店里再查一下资料，看看到底是什么原因导致了这个情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370115,
					"content": "唉，要是爱拉尼在这里就好了，她肯定能很快找出原因来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370116,
					"content": "不如让爱拉尼研究一下这问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "如果她在的话，肯定能很快找出原因来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370118,
					"content": "但是她到现在还没回来，不知道到底去了哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370119,
					"content": "只能拜托你了，旅行者，我要在店里再查一下资料，看看到底是什么原因导致了这个情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				}
			]
		},
