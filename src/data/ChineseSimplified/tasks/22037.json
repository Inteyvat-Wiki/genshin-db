			"dialogs": [
				{
					"id": 220370301,
					"content": "你都摘干净了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370302,
					"content": "摘来的蘑菇都在这里了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "只有这些吗？我印象里，地里长出的蘑菇不止这些啊，是不是没摘干净啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370304,
					"content": "但无论如何我都要谢谢你，年轻人。这些东西给你，就当做是报酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370305,
					"content": "不过，这肥料还真是厉害啊，居然能让蘑菇长这么快，要是庄稼也能长这么快就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "绀田传助"
				},
				{
					"id": 220370306,
					"content": "等我有空了之后，一定要再买点回来试试…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "绀田传助"
				}
			]
