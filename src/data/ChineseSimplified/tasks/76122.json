			"dialogs": [
				{
					"id": 761220101,
					"content": "哥伦比娅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220102,
					"content": "咦？奇怪，刚刚好像听到了哥伦比娅的声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220103,
					"content": "…嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220104,
					"content": "噫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220105,
					"content": "你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220106,
					"content": "不好不好，又被你吓了一大跳，你在的话怎么不早说嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220107,
					"content": "我想你们已经熟悉这种游戏了，所以这次适当增加了一点难度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220108,
					"content": "可恶，下次我也要找机会吓你一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220109,
					"content": "好呀，那我期待着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220110,
					"content": "哥伦比娅你的眼罩呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "哦，似乎是刚才和月灵们玩耍的时候，被它们蹭掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220112,
					"content": "我平时也不用睁眼，这样没什么区别，它们喜欢的话，就让它们拿着玩玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220113,
					"content": "话说回来，哥伦比娅不打算多去外面走走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220114,
					"content": "你不需要再躲着谁了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "嗯…现在时间很多，想什么时候动身都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220116,
					"content": "但想到你们或许会来找我，不告而别的话，可能会让你们担心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220117,
					"content": "这种时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "是呀是呀，只要让我们知道你没事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220120,
					"content": "好的，那我会考虑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220121,
					"content": "只是考虑而已啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220122,
					"content": "说不定哥伦比娅就是喜欢这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "在这里发生的事，对我来说都是愉快的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220124,
					"content": "不过，我在这等你们还有另外一个原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220125,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220126,
					"content": "我想给你们一个惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220118,
					"content": "留张纸条就行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
