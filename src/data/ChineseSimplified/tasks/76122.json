			"dialogs": [
				{
					"id": 761220201,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761220202,
					"content": "努昂诺塔！真的是水灵灵的努昂诺塔！我还以为再也见不到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220203,
					"content": "刚才的画作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "我们用月光为这孩子勾勒出了形体，我在其中注入了新的力量与赐福，让它再度诞生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220205,
					"content": "现在的它无须承载我的灵魂，它拥有独属于它自己的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220206,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761220207,
					"content": "啊，它飞过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220208,
					"content": "嗯，我唤醒了它与你们共度时光里的所有记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220210,
					"content": "……！……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761220211,
					"content": "呜，太好了努昂诺塔，今后我一定会对你更加好一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220212,
					"content": "没想到是这个惊喜…我好喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761220213,
					"content": "谢谢你，哥伦比娅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "没什么。能再次见到努昂诺塔，我也很高兴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220216,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761220217,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220218,
					"content": "（她还是那么中意努昂诺塔，但她的神情和从前相比又有不同。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "（好像它之于她不仅是被创造的眷属，更是熟悉的朋友。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "#去吧，你一定很想{M#他}{F#她}们了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761220221,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761220222,
					"content": "随时欢迎你们再来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
