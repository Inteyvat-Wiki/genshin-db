			"dialogs": [
				{
					"id": 230050601,
					"content": "这就是那位富翁的苹果酿吗？嗯，里面有一股不凡的香气，令人头脑清醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050602,
					"content": "好啊！这一定是能给市场带来转变的好东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050603,
					"content": "我不会忘记你们的帮助的！二位，咱们回头见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
