			"dialogs": [
				{
					"id": 230050901,
					"content": "这份料理看起来有点奇怪啊…不管了，我要开工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050902
					],
					"speakerTitle": "哈特姆"
				},
				{
