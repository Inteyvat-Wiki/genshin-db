					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050402,
					"content": "嗨！哈特姆，最近怎么样呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050403,
					"content": "嗯…是你们啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050404,
					"content": "唉，看见我这幅愁眉苦脸的样子，你们应该多少也猜到些了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050405,
					"content": "我坦白了，到现在为止，我的荷包已经瘪了一半了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050406,
					"content": "真奇怪…不应该这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050407,
					"content": "不过话说回来…我有一个猜想，也许这正是市场要腾飞的征兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050408,
					"content": "就像人们必须要先弯曲腿部，然后才能高高跃起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050409,
					"content": "换作期货交易市场也是一样，现在整个市场都来到了底部。接下来一定就是触底反弹的时刻了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050410,
					"content": "也就是说，现在就是抄底的最好时机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050411,
					"content": "也许只是在山腰上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "不，我很肯定，这是一个难得的机会，我绝不会错过任何获取财富的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050414,
					"content": "这样才能对得起我卡里米的不凡富翁哈特姆这个名头！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050415,
					"content": "再帮我一把吧？朋友，再帮我挑选一份「吞金料理」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050416,
					"content": "那还是在原来的三样里选嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050417,
					"content": "唔…不！既然是要抄底，我需要一份更加特别的料理，它能为市场带来好的转变！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050418,
					"content": "我听说蒙德也有一位富翁，他的酒业生意兴隆无比…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050419,
					"content": "你是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "迪卢克老爷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050421,
					"content": "但你怎么知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050422,
					"content": "哈哈哈，我连「堆高高」都知道，又怎么可能不知道他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050423,
					"content": "他的名下有一家酒馆，出售一种名叫「苹果酿」的好东西，如果能喝下它，也许我就能借来一丝那位富翁的好财运！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050424,
					"content": "拜托了，请为我准备一份苹果酿吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050412,
					"content": "弯曲腿部也有可能是腿疼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
