			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "上次小赚，这次一定能大赚，<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>，怎么样？选好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
