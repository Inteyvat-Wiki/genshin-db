			"dialogs": [
				{
					"id": 230050201,
					"content": "唔…还算不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050202,
					"content": "看来你赚了不少啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "哎哟，旅行者！托你的福，我这次小赚了几笔，看来「吞金料理」果然有点效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050204,
					"content": "只不过，比起平时正常交易赚来的也没差多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050205,
					"content": "这不应该是「吞金料理」该有的表现，难道是我吃的菜不对吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050206,
					"content": "旅行者，那我们就再来一次，请你再帮我挑选一次「吞金料理」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050207,
					"content": "还是老规矩，就在<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>中选一样就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
