			"dialogs": [
				{
					"id": 20030401,
					"content": "这就是稻妻大户人家的宅子吗？没有想象中那么…夸张？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030402,
					"content": "毕竟见识过群玉阁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "欢迎来到神里府，二位贵客，小姐也已经等候二位多时了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030405,
					"content": "是你一直提到的那位「白鹭公主」吧，她在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030406,
					"content": "咳…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030407,
					"content": "屏风后面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030408,
					"content": "呵呵，作为社奉行的大小姐，神里小姐一般都是这样待客的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030409,
					"content": "可以说也算是社奉行百年来的习俗，请谅解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030410,
					"content": "似乎可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "毕竟是高贵的「白鹭公主」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030413,
					"content": "二位漂洋过海，旅途劳顿，到府上却又只能这般相见，请恕礼数不周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030414,
					"content": "我一直很期待二位的到来，从托马的转述中，也确信了二位所拥有的「改变时局」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030415,
					"content": "如今的稻妻，在眼狩令的推行下，民众的愿望正在被肆意蹂躏践踏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030416,
					"content": "社奉行虽服务于将军，但因职责的缘故，又是与民生最贴近的一方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030417,
					"content": "奉行的权力本就源自于民众的信任，如果对这样的情况坐视不理，又怎能够安寝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030418,
					"content": "旅行者，请将你的力量借给我，我们一定能够…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030419,
					"content": "我只是来见雷电将军的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030422,
					"content": "我说了吧，小姐…那样行不通的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030423,
					"content": "我准备走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "啊、啊…等一下！请先…先别走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030425,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030426,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "我会帮你引荐雷电将军，但前提是…你要帮我完成三个小心愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030428,
					"content": "什么心愿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030429,
					"content": "是关于，三个失去神之眼的人…等你见过他们，或许就能明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030430,
					"content": "守护着村庄的武人，过去的眼狩令执行武士，还有曾以天下第一为目标的剑道家是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030431,
					"content": "没错，请尽可能地帮助他们，我会在这里等你们回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "神里绫华"
				},
				{
					"id": 20030432,
					"content": "我答应你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "呵呵，那就拜托了。",
