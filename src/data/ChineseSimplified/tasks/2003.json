				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"托马"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "可算到了，托马呢？托马在哪里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030102,
					"content": "欸…托马那个家伙难道没有守约吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030103,
					"content": "谁说没有守约，我还要为你们忘记我的事而伤心呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030104,
					"content": "怎、怎么回事！是狗说话了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030105,
					"content": "哈哈哈…没什么好惊讶的，你们还是第一次见到这样的我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030106,
					"content": "托马是…狗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "唔…你们在璃月，没见过类似的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030109,
					"content": "这样啊，我好像一下子就理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030110,
					"content": "哪里不对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "哈哈哈哈哈…好了好了，不开这种玩笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030113,
					"content": "喂！你这个家伙怎么这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030114,
					"content": "在离岛的时候也是，在茶室也是，等待你们的时间都有点过于漫长了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030115,
					"content": "所以想了这个特殊的接待方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030116,
					"content": "不过…还是请允许我郑重地向二位道个歉，关于之前的种种「考验」，是必要的形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030117,
					"content": "这决定着我能否将你们带到神里小姐的面前，决定着我们能否成为…敢于一同直面雷光的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030118,
					"content": "别以为你突然严肃认真起来，我就会原谅你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030119,
					"content": "啊哈…做得太过火了吗，抱歉抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030120,
					"content": "那么…考验的结果呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "你一开始便将自己凌驾于那些「规则」之上，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030123,
					"content": "因为你的「意志」从未动摇，也不曾屈服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030124,
					"content": "在很久以前，我们也认识过这样一位伙伴，只是雷光闪过之后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030125,
					"content": "你是说万叶的那个朋友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "哦~居然连你们也听说过他的故事，看来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030128,
					"content": "…他的光芒一点也不微弱啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030129,
					"content": "于是我们可以去见「白鹭公主」了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "当然没问题，我会带你们去社奉行所的神里府上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030131,
					"content": "不过…在这之前，还有个地方希望二位可以随我一同去看下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030132,
					"content": "嗯？什么地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030133,
					"content": "只要居住在鸣神岛便没法无视的，正在建设中的那个庞然大物——「千手百眼神像」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托马"
				},
				{
					"id": 20030126,
					"content": "你指的是在御前决斗中丧命的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "直面雷光的伙伴指的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "可这完完全全是一只狗啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "那个人型托马在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托马"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "这神像周围有种肃杀的气氛…一般人是不会到这里来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030202,
					"content": "欸，仔细看的话…这上面嵌着的都是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030203,
					"content": "神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030204,
					"content": "神之眼！所以眼狩令收缴来的神之眼，都会砌在这座神像上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030206,
					"content": "将军为何要颁布眼狩令呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "你们果然已经听说过眼狩令的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030207,
					"content": "在解释这件事之前，你们应该知道的吧，正如蒙德是「自由」城邦，璃月是「契约」之都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030208,
					"content": "而稻妻…则是「永恒」的国度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030209,
					"content": "雷电将军既是稻妻的最高统治者，同时又是稻妻的神明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030210,
					"content": "千世万代不变不移的永恒，便是执掌这个国家的「她」的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030211,
					"content": "为此，凭借三奉行来稳固国政，依靠锁国令来断绝人员的流动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030212,
					"content": "将军想让稻妻维持一种静态，便可以任由时间的长河从两旁流过，唯稻妻岿然不动，直至「永恒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030213,
					"content": "每个神明都有自己的想法呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030214,
					"content": "当然，这也是我自己的理解。至于最近眼狩令的颁布，究其原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030215,
					"content": "或许是将军认为神之眼能够提供给人民「变革」的力量，而将军眼中的「永恒」无法准许这样的「不稳定」存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030216,
					"content": "于是雷电将军便派遣「天领奉行」的手下四处收缴，并一颗又一颗地，将神之眼嵌入这尊神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030217,
					"content": "所以这尊「千手百眼神像」，便可以视作稻妻「永恒」的象征。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030218,
					"content": "这样说的话…其实那位雷电将军也算有些自私吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030219,
					"content": "哈哈，也只有你们这样的异乡人敢于这么直言不讳地批评雷电将军的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030220,
					"content": "不过…我也认同。眼狩令的确是不该存在的东西，神里小姐从眼狩令颁布的第一天起，就下定了抗争的决心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托马"
				},
				{
					"id": 20030223,
					"content": "刚才那是…什么声音？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#欸？{NICKNAME}你怎么了？看你的表情有些不对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030222,
					"content": "嗯？声音？我没听到啊，刚才发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030225,
					"content": "我似乎听到了…他人的「愿望」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "是呀，你摸了一下神像，然后呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030226,
					"content": "「愿望」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030227,
					"content": "嗯…这倒是好像印证了一种说法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030228,
					"content": "你们有听说过吗？当一个人的愿望强烈到一定程度时，神明的视线就会投射在他的身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030229,
					"content": "那就是神之眼的由来…也可以说，神之眼便代表着那个人的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030230,
					"content": "如果你刚才说的是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030232,
					"content": "神之眼象征的不是力量，而是「愿望」吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "那看来…这些民众的愿望比我想象的还要执着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030233,
					"content": "好了，鸣神岛的游客们，是时候跟我前往下一站——神里府了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "托马"
				},
				{
					"id": 20030234,
					"content": "可终于要去了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
