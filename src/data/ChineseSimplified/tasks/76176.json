			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "…艾莉亚姐姐，卡侬姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760302,
					"content": "这已经不是第一次了。这已经…远超「惩罚」的范围了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760303,
					"content": "无论是王托付给我们的、属于龙的城市，还是那些小小的人类建立起的、脆弱却又美丽的家园…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760304,
					"content": "你们还要看着多少无辜的生灵死去，才能不再袖手旁观？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760305,
					"content": "要是我们的王还在——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760306,
					"content": "——我们的王不在，桑娜妲妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 761760307,
					"content": "如果那位远非全能的主宰将苍白可怖的命运视为「秩序」，如果这是让这个注定毁灭的世界免遭吞噬的唯一可能，那么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 761760308,
					"content": "不管它索取的代价多么沉重…也不管这代价多么让我悲伤，它都远比漆黑的死寂要好得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 761760309,
					"content": "既然世界注定要迎来毁灭…那对抗漆黑又有什么意义呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760310,
					"content": "…桑娜妲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 761760311,
					"content": "没、没什么，艾莉亚姐姐！我什么都没说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760312,
					"content": "我只是觉得，我们不该坐视那位暴君屠戮信任着我们的生灵…无论是龙，还是那些小小的人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760313,
					"content": "我们…难道不该救他们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760314,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760315,
					"content": "…我能理解桑娜妲的愤怒，艾莉亚。在我看来，那位主宰的所作所为，也未免过于残忍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760316,
					"content": "哪怕只有一丝可能…我也希望竭尽全力，救下那些能得救的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760317,
					"content": "可是…那些没有得救的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760318,
					"content": "那些没有被救下的人，没有被救下的生命…他们的血泪与哀泣，难道就理应消失得无影无踪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760319,
					"content": "不…不应该是这样的。我希望人人都能得救，没有一人沉沦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760320,
					"content": "只要它的「秩序」与它一同死去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760321,
					"content": "…桑娜妲。请你不要忘记，我们最初诞生的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 761760322,
					"content": "我们的使命只有维系这个世界，直到赐予我们生命的王从远方归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 761760323,
					"content": "从一开始，我们就清楚这种秩序的代价…因为我们无法放任这个世界行往毁灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "艾莉亚"
				},
				{
					"id": 761760324,
					"content": "…不，这甚至与秩序无关，艾莉亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760325,
					"content": "桑娜妲，对我们来说…对我来说，你是最重要的妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760326,
					"content": "所以…请不要做出会让艾莉亚和我痛苦的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760327,
					"content": "不要直接与高天的秩序相抗。至少…不是世界依然脆弱不堪的现在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760328,
					"content": "卡侬姐姐…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 761760329,
					"content": "伊斯塔露和我说过一个只属于人类的词语…「希望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "卡侬"
				},
				{
					"id": 761760330,
					"content": "只要有生命，就会有希望…总会有希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡侬"
				}
			]
		}
	]
}