			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朱莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "好嘞，这些就够了，谢谢你。要是没有你帮忙，我就真的要一个人冲进去解决那些魔物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260302,
					"content": "要是这样的话，我就不知道什么时候才会想起搜集「绯樱绣球」这件事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260303,
					"content": "对了，谢谢你帮忙，这些「野菇鸡肉串」给你，这可是琳小姐教给我的经典冒险家美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260304,
					"content": "我等会就把这些「绯樱绣球」带回去给旭东啦。不知道他会做什么好吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				}
			]
		}
	]
