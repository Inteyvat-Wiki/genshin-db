			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朱莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "唔…明明是在这附近的来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260102,
					"content": "朱莉？你怎么在这？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "咦？是旅行者呀，嘿嘿，居然能在这里遇见你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260104,
					"content": "我是来这里找食材的啦，旭东又要研究新的食物了，芭尔瓦涅也在旁边出主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260105,
					"content": "旭东说，他想要结合稻妻的「三彩团子」，做一道甜甜的软软的甜品，但是需要几种特别的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260106,
					"content": "宗久大叔去城里收购堇瓜了，我来这里搜集那种「绯樱绣球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260107,
					"content": "虽然我搜集到了一点，但还是有点不够，我本来想再去前面找找看，但那边都是魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260108,
					"content": "旅行者，拜托你啦，能不能帮我去找三份「绯樱绣球」回来呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "谢谢你啦！等你回来了，请你吃好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260111,
					"content": "这些魔物应该难不倒你吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "哎呀，一般来说，是这样呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260113,
					"content": "但是怎么说呢，要是我真的和那些魔物交手的话，肯定就会完全把搜集食材这件事给忘记掉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260114,
					"content": "在蒙德的时候就是这样，无论是处理什么委托，只要和魔物交手，我就会把一切都忘掉，只顾着打倒魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260115,
					"content": "直到把魔物彻底打倒的时候，我才会想起我还有委托要处理…就这样把好多委托都弄失败了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260116,
					"content": "你还真是讨厌魔物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "讨厌魔物？那也不是主要原因啦，其实…其实是我觉得，和魔物交手的时候很有趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260118,
					"content": "那种除了打倒魔物之外，什么也不用想的全身心投入感，你有体会过吗？那可是很爽快的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260119,
					"content": "哎呀，先不说这些了。所以，搜集「绯樱绣球」的事就拜托你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260120,
					"content": "等你回来了，请你吃好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				}
			]
		},
