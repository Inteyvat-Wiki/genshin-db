						741411107
					]
				},
				{
					"id": 741411107,
					"content": "是喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741411108,
					"content": "这么说来，夏诺蒂拉怎么还没回来呀？该不会到枫丹廷里当警卫去了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741411109,
					"content": "…下次再来吧。我头有点晕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "是喔。那一起去找点东西吃吧？你害得我都担心得饿了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741411111,
					"content": "不是才过了一眨眼的时间？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "我可是很用力很用力地担心你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
