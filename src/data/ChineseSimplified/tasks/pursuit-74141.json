			"dialogs": [
				{
					"id": 741411001,
					"content": "…是吗，那就好说了。你叫什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411002,
					"content": "卡特皮拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}，没想到会在这里遇到你。派蒙没在你身边吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411004,
					"content": "等等，你该不会也是什么怪物，变成我认识的人的样子来戏弄我的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411005,
					"content": "我们不久前才见过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "…是这样吗？自从和你告别，感觉已经过了很久了。算了，可能是年纪大了吧，我能记得的事情越来越少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411007,
					"content": "…你真的不是什么怪物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411008,
					"content": "你还记得吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "关于巨人的花园的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "我记得。我记得。你真的是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411012,
					"content": "抱歉，我在这里遇到了太多不可思议的事情，也经过了许多无法取胜的战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411013,
					"content": "但这里终于发生了变化。金色的光芒已经升起，向日葵已经开放。也许就算是古人臆想的宇宙也会发生变化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411014,
					"content": "也许一切都会变好。也许我也能够理解，然后放下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411015,
					"content": "卡特皮拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "跟我一起走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "哈哈哈，看来真的是你。我想起来了，我曾经认识的你，就算到现在也没有变。你总是多管闲事，这是因为你正直而善良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411018,
					"content": "但你不用担心我。我不需要帮助。你也见识过我的身手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411019,
					"content": "况且，对于这里的事情，或许我比你懂的还多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411020,
					"content": "#丘丘人，帮我告诉那位{M#少年}{F#少女}，请{M#他}{F#她}赶紧离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "你有话对我说吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "…你能听懂我说的话？嗯，那我问你。在你眼里，我是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "这样啊…那还来得及。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "#这也是为了你好。离开这里吧，{M#少年}{F#少女}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#我同意。{NICKNAME}，你属于更光明的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 741411027,
					"content": "我还有问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "你不应该有。再见。不要再回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "关于学徒与小鱼的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
