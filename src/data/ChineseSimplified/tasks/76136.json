			"dialogs": [
				{
					"id": 761360301,
					"content": "（或许<color=#FFCC33FF>雅珂达</color>想看看箱子的情况…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "嘿嘿…让我看看最近赚了多少钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360303,
					"content": "上次老板说要给我加奖金呢，不如我现在就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360304,
					"content": "里面怎么没钱啊？只有一张纸条…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360305,
					"content": "「亲爱的雅珂达，把盒子关好。你的奖金不从这里面出。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360306,
					"content": "嘁，老板又在吓人了，是不是有夹层…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360307,
					"content": "没有夹层，你的奖金在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761360308,
					"content": "喔，谢谢老板，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360309,
					"content": "呜啊啊啊啊啊啊啊——老老老老板，我就是清点一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360310,
					"content": "我这就去工作，马上去——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360311,
					"content": "站住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761360312,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360313,
					"content": "锁好盒子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761360314,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761360315,
					"content": "去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761360316,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
