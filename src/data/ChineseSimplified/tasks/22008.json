						220080403
					]
				},
				{
					"id": 220080403,
					"content": "杏仁豆腐…可我还是要吃药呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080404
					],
					"speakerTitle": "红豆"
				},
				{
					"id": 220080404,
					"content": "豆豆乖，吃了药你的病才能好，而且，这不是有杏仁豆腐了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080405
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080405,
					"content": "呜…白术哥哥那么厉害的人，为什么不能把药做成杏仁豆腐味呢…",
