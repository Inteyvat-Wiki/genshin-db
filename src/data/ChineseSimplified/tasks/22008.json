			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沉香"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "豆豆乖，吃了药病才能好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080102,
					"content": "不嘛不嘛！药太苦了，我不想吃嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "红豆"
				},
				{
					"id": 220080103,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "是旅行者吗…是这样，我家豆豆身子一直不太好，之前求着白先生给开了个方子治病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080105,
					"content": "可豆豆总说不卜庐的药太苦，怎么都不肯吃，唉，这世上的药哪有不苦的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080106,
					"content": "为了让这孩子吃药，我答应她，每次喝完药之后就能吃一份「杏仁豆腐」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080107,
					"content": "旅行者，如果您有空的话，能帮我去找份「杏仁豆腐」来吗？我还得再哄哄豆豆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "那就拜托您了，一份给豆豆吃就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080110,
					"content": "她得了什么病？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "唉，我也说不好，但是据白先生说，这病极难治根，但就算只治表，也要一直吃药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080112,
					"content": "说不定，豆豆将来要吃一辈子的药，她才这么小…我真是想都不敢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080113,
					"content": "我真是恨不得是我自己得病。但是…现在我也只能盼着豆豆能少遭点罪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080114,
					"content": "旅行者，拜托您了，帮我去找份杏仁豆腐回来吧，一份就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080115,
					"content": "豆豆，你为什么不肯吃药？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "那药太苦了！璐璐她们的药都没这么难吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "红豆"
				},
				{
					"id": 220080117,
					"content": "豆豆，璐璐她们是在做游戏呀，那些都是杏仁豆腐的糖水，不是药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080118,
					"content": "那…那我吃杏仁豆腐不能治好病吗？非得吃那么苦的药…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "红豆"
				},
				{
					"id": 220080119,
					"content": "豆豆乖，只要病好了，以后吃什么都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "沉香"
				},
				{
					"id": 220080120,
					"content": "为什么药不能和杏仁豆腐一样，都是甜的呢，真讨厌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "红豆"
				},
				{
					"id": 220080121,
					"content": "这孩子真是，唉…旅行者，麻烦您了，请帮我找份杏仁豆腐来吧，一份就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沉香"
				}
			]
		},
