			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "欢迎来到<color=#00E1FFFF>冒险家协会</color>，我已经观察你很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300102,
					"content": "#观察{NICKNAME}？难道我的伙伴做了什么奇怪的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300103,
					"content": "没有没有，发现优秀的冒险者，这也是我的工作之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300104,
					"content": "从你的身上，我能看到与那些传说中的冒险家比肩的资质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300105,
					"content": "嘿嘿，这个我也看得出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300106,
					"content": "#跟着{NICKNAME}冒险，总感觉很安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300107,
					"content": "嗯嗯，不过对冒险家来说，阅历比资质更加重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300108,
					"content": "只有不断积累<color=#00E1FFFF>「冒险阅历」</color>，才能提高<color=#00E1FFFF>「冒险等阶」</color>的评定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300109,
					"content": "事不宜迟，就由我为刚入籍的冒险家介绍一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300110,
					"content": "等一下！我们已经成为正式冒险家了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300111,
					"content": "放心，冒险家协会无需会费，也更不会强制冒险家履行什么义务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300112,
					"content": "换句话说，加入协会是只有好处，没有坏处的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300113,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "总之，每当「冒险等阶」提升，冒险家协会都会提供奖励。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300117,
					"content": "这就当做协会的新人礼了，请你亲自确认一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300118,
					"content": "冒险等阶奖励",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "我现在就要好处！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "哈哈…现在的新人怎么变得这么直接了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
							"2"
						],
						"stepId": 2003003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "那么容我正式欢迎你的加入，冒险家新星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300202,
					"content": "这是你的<color=#00E1FFFF>「冒险之证」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300203,
					"content": "还有证书？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "新人加入这么重要的事，当然要有仪式感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300207,
					"content": "这上面记载了很多关于协会的委托和奖励的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300208,
					"content": "同时这也是会员的证明，记得多多查看并妥善保管哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300209,
					"content": "对了，还有一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300210,
					"content": "「冒险等阶」的提升是会有瓶颈存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300211,
					"content": "到那时就需要完成一些「令人印象深刻的任务」来得到协会的进一步认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300212,
					"content": "令人印象深刻…的任务？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200300213,
					"content": "可以说是用来突破「冒险等阶」上限的「突破任务」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300214,
					"content": "现在还不是时候，当你的「阅历」足够丰富，自然就会有博得大家认可的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300215,
					"content": "那么今天就先这样吧，以后我们应该还会经常见面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300216,
					"content": "努力吧冒险家，向着星辰与深渊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 200300205,
					"content": "这是…宣传手册？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "这么说也可以，但它的功能性更强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "凯瑟琳"
				}
			]
		}
	]
}