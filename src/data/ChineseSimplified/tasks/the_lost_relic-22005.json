			"dialogs": [
				{
					"id": 220050101,
					"content": "到底在哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050102,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "呜哇！你是从哪冒出来的？怎么无声无息的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050104,
					"content": "我？我…是一个学者，正在研究归离原的古代建筑和遗物。你…就叫我宝儿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050105,
					"content": "不过，我研究太入神，把一个随身的包裹给弄丢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050106,
					"content": "那里面是我好不容易找到的宝…文物，你愿意帮我找找吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "太好了，应该就掉在附近了…或者再远点，总之，请你仔细找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050108,
					"content": "是什么样的包裹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "就是…平常大家用的包裹啦，一个四四方方的盒子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050112,
					"content": "为什么用这个装文物？呃，因为…这样的盒子方便啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050113,
					"content": "而且，我也在盒子里面垫了好几层衣服，绝对不会损坏文物的，请你快去帮我找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050109,
					"content": "是什么样的文物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "是…总之是很贵重的文物，哎呀！说了你也不明白啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "宝儿"
				},
				{
					"id": 220050115,
					"content": "只有我这种专业人士，才能判断出它的价值，拜托你了，快帮我找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝儿"
				}
			]
		},
