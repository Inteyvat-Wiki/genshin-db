				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旁白",
					"辛焱",
					"枫原万叶",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "「然而，幽夜净土迎来连续如噩梦的阴霾。邪龙塔斯拉克潜入地下，越过海底，游走至王城之上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "旁白"
				},
				{
					"id": 400720402,
					"content": "欸？有龙吗？我觉得只有天气变阴了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400720403,
					"content": "龙…会不会是种比喻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400720404,
					"content": "是吗…不认可她、反驳她幻想的一切，共同构筑成了她的宿敌，「邪龙塔斯拉克」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007210",
							"2"
						],
						"stepId": 4007210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱昂",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "太好了，有人…欸？又是你们几位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721002,
					"content": "这话应该我们说吧，怎么又是你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶",
					"辛焱",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "又回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400721302,
					"content": "刚才，我们似乎不小心窥见了邪龙的真面目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400721303,
					"content": "唉，这种事我可太有体会了，总有人觉得我们的爱好是浪费时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400721304,
					"content": "嗯？你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721305,
					"content": "我是「渴望被问路的阿诺德」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "阿诺德"
				},
				{
					"id": 400721306,
					"content": "我的意思是，你怎么又来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721307,
					"content": "噢，噢，我猜，你们应该会找《圣国的咏唱》第三卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "阿诺德"
				},
				{
					"id": 400721308,
					"content": "还真是让你猜对了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721309,
					"content": "亲爱的女士，您不必为我做任何事。您的美丽，就是对我最大的褒奖。我将在此献上您所追寻的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "阿诺德"
				},
				{
					"id": 400721310,
					"content": "圣典第三卷，位于王城顶楼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "阿诺德"
				},
				{
					"id": 400721311,
					"content": "有什么安保措施吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400721312,
					"content": "噢，噢当然了先生，您在说什么傻话？任何国家都不会将最重要的书暴露在荒野上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "阿诺德"
				},
				{
					"id": 400721313,
					"content": "也就是说，那边依然会有夜鸦护卫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400721314,
					"content": "看守圣典是臣民无上的荣耀。但没关系，相信这位女士只是想阅读圣典而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "阿诺德"
				},
				{
					"id": 400721315,
					"content": "您的面容如此迷人，且富有智慧。您的同伴也像是英雄，如果是诸位，应该能读懂我们圣典中的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "阿诺德"
				},
				{
					"id": 400721316,
					"content": "殿下的事迹经大书记官奥兹大人转述，成为了幽夜净土的珍宝。每一次我读这本书，都盼望殿下能感到幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿诺德"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱昂",
					"枫原万叶",
					"辛焱",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "让几位反复看见我狼狈的模样，实在抱歉。果然，以我现在的实力，要扮演合格的夜鸦骑士还太早了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721802,
					"content": "扮演？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400721803,
					"content": "说来惭愧，我并非真正的骑士，而是最近刚找到新工作，预备在戏团中扮演骑士一角的新人演员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721804,
					"content": "这种事有什么好骄傲的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400721805,
					"content": "不不，各位有所不知。在幽夜净土，戏剧是非常重要的文化。好的演出，是对皇女殿下最大的报答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721806,
					"content": "哦哦，就是说，这是你们的本土文化了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400721807,
					"content": "正是！因此，我很高兴自己能出演骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721808,
					"content": "你们的皇女殿下为什么喜欢戏剧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721809,
					"content": "皇女殿下曾说过，「为本皇女献上庆典，到旷野中演出戏剧。向我叩拜，向我献上纯净之幻梦以换取永夜荣光。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721810,
					"content": "我想，一定是因为皇女殿下懂得真正的艺术，又能分辨人性最深处暗藏的喜怒哀乐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721811,
					"content": "戏剧的灵魂，在于感情的凝聚与升华。读懂戏剧的人，都有一颗敏感又情绪丰富的美丽之心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721812,
					"content": "…原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721813,
					"content": "感谢你的回答，骑士先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400721814,
					"content": "噢、噢噢！您…您竟然愿意称我为骑士，万分感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721815,
					"content": "那么，带着这份荣光，我将奔赴我的战场了。各位，有缘再会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400721816,
					"content": "别再会了，下次注意安全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400721817,
					"content": "啊对，请记住开门的口令：「听我命令，振翅起航」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱昂"
				}
			]
		}
	]
}