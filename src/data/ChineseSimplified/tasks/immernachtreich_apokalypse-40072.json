			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神情严肃的夜鸦",
					"眼神凛冽的夜鸦",
					"莫娜",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "站住，什么人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "神情严肃的夜鸦"
				},
				{
					"id": 400720202,
					"content": "看你们的样子，不是幽夜净土臣民吧？说！来这里做什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "眼神凛冽的夜鸦"
				},
				{
					"id": 400720203,
					"content": "竟然有守卫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720204,
					"content": "不必慌张。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "欸？你干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720206,
					"content": "我们是皇女殿下的家臣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "穿越星海而来之人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "你如何证明自己是殿下的家臣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "神情严肃的夜鸦"
				},
				{
					"id": 400720209,
					"content": "哼，问出如此狂妄的问题，正说明你们眼光浅薄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400720210,
					"content": "「令我的子民自由，不囿于古老法则。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400720211,
					"content": "是、是幽夜净土的口令！他们真的是殿下的臣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "眼神凛冽的夜鸦"
				},
				{
					"id": 400720212,
					"content": "天哪，我、我僭越了！各位，请原谅我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "神情严肃的夜鸦"
				},
				{
					"id": 400720213,
					"content": "知错了还不快退下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720214,
					"content": "是是，属下这就离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "神情严肃的夜鸦"
				},
				{
					"id": 400720215,
					"content": "他们走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720216,
					"content": "这就是《圣国的咏唱》第二卷。各位，准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400720217,
					"content": "出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007204,
			"completionStepIds": [
				4007204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
