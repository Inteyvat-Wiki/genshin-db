			},
			"dialogs": [
				{
					"id": 742490201,
					"content": "嗯！这种悠闲的下午茶时光怎么都过不腻呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 742490202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742490204,
					"content": "嗯，欢乐的时光过得可真快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙宁娜"
				},
				{
					"id": 742490203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
