			"dialogs": [
				{
					"id": 761140301,
					"content": "（咦？这是…看起来像是没烧完的…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140302,
					"content": "（以前就听说德文特先生会收留受伤的冒险家之类的…这好像是最近发生的事。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140303,
					"content": "（为什么要把这些烧掉呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
