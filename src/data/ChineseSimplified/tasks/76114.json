			"dialogs": [
				{
					"id": 761140201,
					"content": "您好——有人在吗——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140202,
					"content": "德文特先生——您在家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140203,
					"content": "…是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140204,
					"content": "是「秘闻馆」的雅珂达，有些事想要问问您，所以特意来拜访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140205,
					"content": "…你就这么问吧。我病了，起不来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140206,
					"content": "（奇怪，之前听海螺帮的孩子们说，德文特先生教他们认字，说话温声细语…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140207,
					"content": "（现在听着声音沙哑，不过不像是病了，而像是原本就是这副嗓音…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140208,
					"content": "您没事吧？如果病得厉害，我可以去请医生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140209,
					"content": "…不用。过阵子就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140210,
					"content": "好吧，那等您恢复了再去那夏镇吧，您的朋友也很牵挂您呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140212,
					"content": "（…他怎么不说话了？能听到屋里有人走动的声音，不过步子很沉…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140213,
					"content": "您最近好像都没怎么出门吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140214,
					"content": "…是为了专心修行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140215,
					"content": "听说您近来的装扮也和过去不太一样，有人说完全没想到原来您那么健硕，之前穿隐者长袍的时候都没看出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140216,
					"content": "呃，还有隔绝月矩力的面罩…是新的流行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140217,
					"content": "…是为了隔绝外界的杂音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140218,
					"content": "也是为了修行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140220,
					"content": "那前阵子拜访过您的游商，您知道他在那之后去哪儿了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140221,
					"content": "…不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761140222,
					"content": "好、好吧…那我就先不打扰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140223,
					"content": "（不知道为什么，有种继续问下去会很危险的感觉…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140224,
					"content": "（唔，他们说的没错，简直就像是换了个人…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 761140225,
					"content": "（收获太少了，也不能就这么回去面对奈姐啊，在附近再小心地调查一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
