			"dialogs": [
				{
					"id": 200390401,
					"content": "你先试试制作一份「惊雷精油」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 200390402,
					"content": "它是最基础的炼金产物。最适合入门练手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 200390403,
					"content": "想要炼成「惊雷精油」，需要的原料是电气水晶和青蛙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 200390404,
					"content": "这两种材料都能在城外找到…什么？「水晶」听起来和「精油」没关系？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 200390405,
					"content": "哈哈哈，当然，因为电气水晶负责「惊雷」，「精油」的关键是青蛙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 200390406,
					"content": "找齐材料之后，你就开始尝试炼制「惊雷精油」吧。大胆地尝试，我会在旁边看着你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "蒂玛乌斯"
				},
				{
					"id": 200390407,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
