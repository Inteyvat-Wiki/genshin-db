			"dialogs": [
				{
					"id": 401171501,
					"content": "才大言不惭地答应了艾莉丝女士，结果蜃境就出了这样的乱子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 401171502,
					"content": "不过，就、就和「军师」小姐说的那样，要是能够让蜃境恢复成原样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪娅"
				}
			]
		},
