			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柯莱",
					"优菈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "我听可莉说，他们那边的区域有很神奇的轨道，还有「很有趣很有趣的呼呼飞车」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401171402,
					"content": "哦，就是那个沿着「惊险刺激」的轨道，速度「毫无节制」的飞车吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401171403,
					"content": "嗯，就是那个，据说车头有时会完全朝下俯冲，身体会像失去重量一样飘起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401171404,
					"content": "是吗？为什么我听说的是，行车中途可莉的背包差点被甩开，如果不是凯亚手快，蹦蹦炸弹就会飞得漫天都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401171405,
					"content": "欸？！这么一说，好像…也挺危险的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401171406,
					"content": "唉…如果你真的想坐，有空了我陪你一起去好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401171407,
					"content": "咦？优菈，为什么突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "柯莱"
				},
				{
					"id": 401171408,
					"content": "你的心思也很好懂…但事先说好，我可不帮你捡东西，记得把随身物品拿出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "优菈"
				},
				{
					"id": 401171409,
					"content": "嗯，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柯莱"
				}
			]
		},
		{
			"id": 4011715,
