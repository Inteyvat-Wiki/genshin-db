			"dialogs": [
				{
					"id": 761870401,
					"content": "点心，真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761870402,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761870404,
					"content": "欸？！这么快吗？好吧，谢谢桑多涅小姐！我们下次见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛梅赫"
				},
				{
					"id": 761870403,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "「木偶」"
				}
