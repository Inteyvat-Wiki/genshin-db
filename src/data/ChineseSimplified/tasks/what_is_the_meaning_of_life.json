			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "这样就差不多喂好了。希望它们都能吃饱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190102,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "我正在喂这些紫金渔鸥呢。你瞧，它们差不多都要吃饱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190104,
					"content": "呜哇…你和这些紫金渔鸥的关系怎么一下子这么好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240190105,
					"content": "它们没抢你薯条吃吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "没有。这里经常有人专门过来喂食，这群紫金渔鸥对我的薯条没有兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190107,
					"content": "但你上次不是说，如果离太远的话会错过工作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240190108,
					"content": "哈哈哈，没关系，今天是我难得的休息日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190109,
					"content": "这里既没有同事来拉着我聊工作，也没有人或者动物试图抢走我的薯条…真的非常适合休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190110,
					"content": "而且这里的紫金渔鸥真的非常友好，不会抢走我的薯条，也不会冲到我的怀里扑腾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190111,
					"content": "自从我亲手喂了几次食之后，这群紫金渔鸥好像都认识我了。就算我去摸它们的羽毛，它们也不会发出什么抗议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190112,
					"content": "和沫芒宫旁边的那群紫金渔鸥相比，它们简直可以称得上是一群绅士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190113,
					"content": "如果它们学会用爪子在打字机上敲字，那几乎都可以取代我们的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190114,
					"content": "紫金渔鸥可不会帮人办事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "紫金渔鸥至少不会让一件事更糟啊。而且每个人都知道，有些事对紫金渔鸥来说太过艰难，它们就是办不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190118,
					"content": "先不说这些。你想试试和这些绅士们交朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190119,
					"content": "已经把它们称为绅士们了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240190120,
					"content": "我直接过去是不是太冒犯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "不，这群绅士们都很宽容，只要你不直接上去摸羽毛就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190124,
					"content": "来吧，这是我特别处理过的鱼肉，你直接拿过去放在盆里就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190125,
					"content": "放轻松。紫金渔鸥都十分宽容，只要你喂食，它们就会对你有好感。绝不会反问你这鱼肉的来历和制作方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190122,
					"content": "和紫金渔鸥交朋友需要注意什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "也没有什么特别的。只要别直接去摸它们的羽毛就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190116,
					"content": "紫金渔鸥可听不懂人说话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "那可说不准。也许它们只是装作听不懂人说话，以此来让自己的生活更安逸一些呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "艾尤恩"
				}
			]
		},
