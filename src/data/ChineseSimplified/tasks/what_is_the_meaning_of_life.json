			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "你…你怎么能这么做，它们又不是沫芒宫前那群讨厌的家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190802,
					"content": "一不小心就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "唉，我都来不及阻止你。我不知道你为什么要这么做…也许是哪只紫金渔鸥攻击你了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190804,
					"content": "无论如何，这群紫金渔鸥现在都已经惊走了。没办法，等过几天我再带点东西来，向它们赔礼道歉吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
