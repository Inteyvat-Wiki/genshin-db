			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克里托夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "你好，最近发生什么事情了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660802,
					"content": "关于盗宝鼬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "哦哦，你是说层岩巨渊的盗宝鼬吧？哈哈…原本是归我管的，结果被我搞砸了…没什么好说的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660804,
					"content": "嗯…哦，让我把它们再抓起来是不太可能啦…毕竟这些小家伙神出鬼没，实在难以追踪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660805,
					"content": "不过呀，如果有谁的东西被那些坏家伙偷掉的话，我能提供一点小小的提示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660806,
					"content": "盗宝团训练饲养盗宝鼬，都会在固定的时间进行喂食。其中有三种不同的盗宝鼬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660807,
					"content": "最厉害的「大黄金盗宝鼬」…然后呢，是比较常见的「藏金盗宝鼬」，还有笨笨的「新手盗宝鼬」，不过出现的时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710660808,
					"content": "哎…应该是有一本训练手册的，时间上面都写了，谁还特意去记那些东西，应该就在盗宝鼬出没地附近的营地里吧。",
