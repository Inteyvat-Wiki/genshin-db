			"dialogs": [
				{
					"id": 710660201,
					"content": "你回来了！怎么样，收获如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660202,
					"content": "你看看，是不是这枚戒指？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106603,
			"completionStepIds": [
