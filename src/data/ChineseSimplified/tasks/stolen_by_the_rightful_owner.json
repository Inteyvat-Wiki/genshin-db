			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔列辛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "没错，就是这枚！太感谢你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660302,
					"content": "请收下这些报酬吧，虽然不是很多…不过请你不必介意，我也一定会把这件事写进诗里传扬四方的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔列辛"
				}
			]
		},
