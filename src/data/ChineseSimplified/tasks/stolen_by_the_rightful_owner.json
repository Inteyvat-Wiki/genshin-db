					"塔列辛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660101,
					"content": "唉…奇怪，奇怪，真是奇哉怪也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660102,
					"content": "应该还在的才对…可是怎么也找不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660103,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "我的戒指…不见了。那枚戒指对我来说很重要，如果丢在这里可不行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660105,
					"content": "你的戒指是什么样子的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "戒圈是黄铜的，上面镶嵌了一枚漂亮的红色宝石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660107,
					"content": "我是在传说中魔龙杜林陨落之地旁边的熔岩池拾到它的，这应当能解释为何它会有阴燃的黑暗火焰光泽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660108,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660109,
					"content": "传说它的主人一旦戴上它，就会受到「深渊之大君」的凝视，被它的黑暗大军追杀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660110,
					"content": "哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
