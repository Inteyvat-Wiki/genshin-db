			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔列辛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "咳咳…抱歉，抱歉，身为诗人总会尝试更为戏剧化的表达，试验更新颖的故事嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660702,
					"content": "嘿嘿，其实那枚戒指是几年前，我从盗宝鼬的窝里掏来的…看起来保存状况还不错，也挺好看的，就留在身上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660703,
					"content": "哼，原来是偷了小偷的赃物呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660704,
					"content": "不要说得那么难听嘛…是拾取，拾取才对！我还是很珍惜这件宝物的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660705,
					"content": "关于戒指，有什么线索吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "嗯…听说附近经常有盗宝鼬出没，说不定是这些小东西趁我睡下，把我的戒指偷走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660707,
					"content": "原来还有人睡觉会摘戒指的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660708,
					"content": "没听说过呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "反正我是不会啦！摘下戒指还要考虑放在哪里，就浪费了好好睡觉的时间啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660710,
					"content": "真的有给派蒙戴的小戒指吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "哼，当然有啦。世界之大，你不知道的东西还多得是呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660712,
					"content": "好了，请两位不要再随意评论别人的生活习惯，然后自顾自扯闲天了！很不礼貌的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660713,
					"content": "总之，如果要帮忙找戒指的话…嗯，请找一找有没有盗宝鼬的巢穴吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660714,
					"content": "我听说在地图的这个地方…盗宝团设立了可疑的营地。来，我为你标出来好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660715,
					"content": "据说在这一带常有盗宝鼬出没，很可能与那些鬼鬼祟祟的盗宝团有关…总之，还是请先去这里察看一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710660716,
					"content": "哼…从盗宝鼬窝里偷来的戒指，又被盗宝鼬偷回去，也算是物归原主了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710660717,
					"content": "请不要再挖苦我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔列辛"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
