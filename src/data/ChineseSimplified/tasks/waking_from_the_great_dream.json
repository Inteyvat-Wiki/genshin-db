				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"纳齐森科鲁兹",
					"安"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "不可能…我明明已经登达了「不退还」之位阶。为什么，跌落到了如此境界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650202,
					"content": "对原始胎海的掌控也彻底丧失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650203,
					"content": "为什么，为什么会这样？为什么，为什么你们要这么做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650204,
					"content": "新世界无法诞生，所有人都要在蛋壳之梦里死去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650205,
					"content": "你才是早点从自己的梦里醒过来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650206,
					"content": "世界末日这种事，当然是全世界的人一起想办法解决的事情啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650207,
					"content": "我明白了，是圣剑。它没有站在我这边。它每一次挥动都切削了围聚在我周身的众生意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650208,
					"content": "直到最后，我懦弱的凡人性——我的人格也回到了我的体内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650209,
					"content": "胎海泛滥并没有那么快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "我已经有所察觉，最早填入「世界式」的输入值出现了变动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650211,
					"content": "有谁掌控了生命之力，又有什么人开辟了兽之国度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650212,
					"content": "还有一个「变量」，那就是你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650213,
					"content": "注定见证吞食一切之鲸败走的人，一切的见证者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650214,
					"content": "原来是这样，原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650221,
					"content": "我也做过这样的梦，想要成为你这样的事物。不过这个梦，刚刚破碎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650222,
					"content": "我所做的一切都毫无意义，就像是一个空虚的梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650223,
					"content": "不，甚至不如一个梦。至少梦是无害的。而我……不，你们，还有他们却为这件事付出了那么多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650224,
					"content": "纳齐森科鲁兹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650225,
					"content": "啊，是你。我都没有发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650226,
					"content": "你能知道我究竟是谁吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650227,
					"content": "名字只是一个称呼。混在你灵魂里的两种颜色，我都是再熟悉不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650228,
					"content": "莉利丝院长不知道发生了什么，她只是抱住了一息尚存的玛丽安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650229,
					"content": "她理解不了过于复杂的当下与未来，只是想要留住过去。于是她做了她唯一会做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650230,
					"content": "我叫做安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650231,
					"content": "那么，你好，安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650232,
					"content": "我愿意原谅你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650233,
					"content": "你在说什么奇怪的话。从一开始我的规划就有着崇高与神圣的目的。这中间没有私心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650234,
					"content": "没有人能评价我，没有人能审判我，没有人能原谅我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650235,
					"content": "你的目的或许是崇高的，但是你的疯狂伤害了很多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650236,
					"content": "你连算式的输入都没填对。犯错然后被原谅，有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650237,
					"content": "…你说得对。我很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650238,
					"content": "然后纳齐森科鲁兹，你和我们回去吧。你需要见一见其他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650239,
					"content": "虽然这家伙好像变得很好说话了，但是这种要求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650240,
					"content": "没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650241,
					"content": "欸！一般不是要做点心理斗争然后让我们劝个半天的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650242,
					"content": "正如我之前所说，我并未觉得自己有任何负罪。如今伟业惜溃，但是世界已然得救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650243,
					"content": "任由他人责骂与嘲笑我吧。我的内心已经空落，徒余一种渴望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650244,
					"content": "是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650245,
					"content": "我也想回到最开始的时候。水仙的勇者还没有踏上旅程的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650246,
					"content": "不过这已经办不到了。决定人命运的终究不是人自己，如今我连让自己做什么梦的力量也丢失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650247,
					"content": "#那，{NICKNAME}骑士，准备好之后我们就去重新封印胎海然后离开这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 741650215,
					"content": "那条鲸已经被打败了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "我本该有所察觉，最早填入「世界式」的输入值出现了变动。有「变量」降临此间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650217,
					"content": "并非是所有宇宙外到来的事物都能被叫做「降临」或者「变量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650218,
					"content": "原来我少算了一个「变量」，那就是你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650219,
					"content": "一切的见证者，一切的记录者，一切的设计者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650220,
					"content": "唯有自身等价一个世界的人才能担此头衔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "纳齐森科鲁兹"
				}
			]
		},
