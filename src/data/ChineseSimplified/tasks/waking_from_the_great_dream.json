							3381.435
						],
						"pointId": 6766
					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "我…感受到了「理性」。到来之人，汝等是水仙十字的后继者，还是齿轮的鹰犬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650102,
					"content": "对我拔剑相向了。看来答案不言自明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650103,
					"content": "纳齐森科鲁兹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "安"
				},
				{
					"id": 741650104,
					"content": "欸？这个东西就是纳齐森科鲁兹吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650105,
					"content": "既然已听闻我名，那汝等自当理解我救世之道义。既已听闻我名，尔等意识之内便有得救的种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650106,
					"content": "想来尔等对我兵锋相向，应该是被谎言所欺骗。如此时机，我也不想浪费太多力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650107,
					"content": "欣喜吧，喝彩吧。在一切结束之后我来解答，我来展现。现在把圣剑归还到我的手中，然后离开避难吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650108,
					"content": "才不能把圣剑给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741650109,
					"content": "愚蠢啊愚蠢。但是我原谅尔等，就算如此我也会拯救尔等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650110,
					"content": "我感觉到了，四象限虽然得以逆转，但是涌流之树的全图并没有完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650111,
					"content": "已经没有办法拯救所有人了。我将最大程度延展我的慈悲，透支我的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650112,
					"content": "如果只能救五成的人，我就尽力去救下六成的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "纳齐森科鲁兹"
				},
				{
					"id": 741650113,
					"content": "现在，我要来取圣剑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纳齐森科鲁兹"
				}
			]
		},
		{
			"id": 7416502,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
