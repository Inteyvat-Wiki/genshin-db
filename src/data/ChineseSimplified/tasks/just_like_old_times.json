			"dialogs": [
				{
					"id": 761840301,
					"content": "不错的茶会。早知道我以前就该多参加几次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840302,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "好啊，我们下次再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840303,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_PLAYER",
