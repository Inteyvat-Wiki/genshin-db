			},
			"dialogs": [
				{
					"id": 760770201,
					"content": "…哎呀，雅珂达看样子还没回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770202
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770202,
					"content": "你们在这稍等，我去泡茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770203
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770203,
					"content": "喵——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770204
					],
					"speakerTitle": "阿舍鲁"
				},
				{
					"id": 760770204,
					"content": "阿舍鲁，摸摸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770205
					]
				},
				{
					"id": 760770205,
					"content": "喵，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770206
					],
					"speakerTitle": "阿舍鲁"
				},
				{
					"id": 760770206,
					"content": "嘿嘿，阿舍鲁乖乖喔，来，握手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770207,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770208
					],
					"speakerTitle": "阿舍鲁"
				},
				{
					"id": 760770208,
					"content": "来吧，茶泡好了。奶和糖在那边，需要的话自己去加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770209
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770209,
					"content": "看来阿舍鲁很亲近你们。想当初，我刚把阿舍鲁带回来的时候，它就像狮子一样凶狠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770210
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770210,
					"content": "除了我之外，几乎没有人能碰它。那些擅自靠近它的人，基本上都被它用爪子和牙齿赶走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770211
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770211,
					"content": "阿舍鲁原来这么凶吗？看不出来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770212,
					"content": "喵，喵喵？喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770213
					],
					"speakerTitle": "阿舍鲁"
				},
				{
					"id": 760770213,
					"content": "那是很久之前的事了，那时候我和它刚刚到挪德卡莱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770214
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770214,
					"content": "我们无依无靠，想要在彼时的挪德卡莱拼杀出一片容身之所，就不得不露出爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770215
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770215,
					"content": "…现在，已经没那个必要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770216
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770216,
					"content": "好了，现在是满足你们好奇心的时间。我猜，你们应该是对我和冒险家协会的那项「长期合作」有兴趣，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770217,
						760770218
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770217,
					"content": "奈芙尔居然会去委托冒险家协会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770219
					]
				},
				{
					"id": 760770219,
					"content": "难道是连奈芙尔也没办法一个人找到并且带走的宝贝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770220,
					"content": "重要的确是很重要。但是不是宝贝，那就要看个人的判断了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770221
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770221,
					"content": "喏，我要冒险家协会帮我找的就是这本书，看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770222
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770222,
					"content": "读起来是一篇很有须弥风格的童话呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770223,
						760770224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770223,
					"content": "难道是宝藏的线索？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770225
					]
				},
				{
					"id": 760770225,
					"content": "#啊？又要解谜寻宝了？{NICKNAME}你加油喔！我、我有点看不太懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770226,
					"content": "放心吧，这只是一篇流传在须弥沙漠人中的普通故事。既没有暗指藏宝地，也没有隐藏密语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770227
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770227,
					"content": "我之所以费力寻找，只因为它和我的父亲有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770228
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770228,
					"content": "你的父亲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770229
					]
				},
				{
					"id": 760770229,
					"content": "没错。我之前应该为你「引见」过他了。你们应该还记得他和我的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770230
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770230,
					"content": "在带回那一桶裹挟着灾祸的「战利品」，让村子被黄沙吞没之前…他经常给我讲故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770231
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770231,
					"content": "当然了，你们也知道当时须弥的情况，那些温情脉脉又富有智慧的故事，只有雨林里的幸运儿才有特权聆听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770232
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770232,
					"content": "而对于那些被防沙壁隔绝在外的沙漠人来说，智慧和温情是奢侈品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770233
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770233,
					"content": "由他们口口相传的故事，唯一且最重要的作用，就是教会孩子们如何活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770234
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770234,
					"content": "比如，浪费粮食的人会变成蝎子，不珍爱水源的人会失去舌头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770235
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770235,
					"content": "再比如，善良是美德，但轻信别人只会招致灾祸，欺骗是可行的，但前提是别被发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770236
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770236,
					"content": "不过，我父亲似乎并不想让我被这些故事「感化」成「典型的沙漠人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770237
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770237,
					"content": "在搜集到故事之后，他会自己进行改编，把故事变得…更温情一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770238
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770238,
					"content": "在他说的那些故事里，骗子变成了骡子，杀人者跌下了悬崖，挑食的孩子最多只是牙痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770239
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770239,
					"content": "能够稍微理解一点他的想法，毕竟谁都想让自己的孩子好好长大啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770240,
					"content": "奈芙尔喜欢那些故事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770241
					]
				},
				{
					"id": 760770241,
					"content": "我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770242
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770242,
					"content": "当时的我喜欢的不得了。每天都期待着夜晚到来，父亲用故事哄我入睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770243
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770243,
					"content": "到了白天，我就会拿着父亲的故事本出去，把故事再讲给其他孩子听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770244
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770244,
					"content": "他们可羡慕我了，无论我到哪，身后都跟着一堆小孩，只要能听故事，我让他们做什么就做什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770245
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770245,
					"content": "直到一切都迎来终结，我的父亲，朋友和部族，还有那些故事，都被掩盖在了黄沙之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770246
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770246,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770247
					]
				},
				{
					"id": 760770247,
					"content": "之后，我去了教令院。在那里，我才发现了一部分故事的「原版」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770248
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770248,
					"content": "骗子们从未被惩罚，因为蠢人就活该被骗；杀人者总是得胜后扬长而去，因为只有他的手里有刀剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770249
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770249,
					"content": "至于挑食的孩子…则和那些浪费水的孩子一样，被变成了蜥蜴，永世蜷缩在岩石底下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770250
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770250,
					"content": "直到那个时候，我才知道父亲一直在「欺骗」我，他用自己的笔，为我编织出了一个虚假的温情世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770251
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770251,
					"content": "但我的父亲离开了，那个虚假的世界也宣告毁灭，我不得不面对那些真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770252
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770252,
					"content": "幸运的是，我学得很好，很快就成了一个他努力不让我成为的「沙漠人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770253
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770253,
					"content": "之后，就是谎言、欺骗、复仇和毁灭，这些都是在沙漠中重复了一万遍的主题，你们应该很熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770254,
						760770255
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770254,
					"content": "那你搜集这些故事的原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770256
					]
				},
				{
					"id": 760770256,
					"content": "算是吧。我只是想看看，他究竟对自己的女儿撒了多少谎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770257
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770257,
					"content": "作为世界上唯一一个被他如此欺骗的人，我想我有义务把他的骗术记录下来，否则，他作为一个骗子也太过籍籍无名了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770258
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770258,
					"content": "再说了，哼…「鹮之王」图特一定也对我的行动乐见其成吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770259
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770259,
					"content": "毕竟，是他让我去寻觅能够「厘定真伪」之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770260
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770260,
					"content": "在我年幼时，我父亲所编撰的那些故事，为我塑造了对于这个世界的认知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770261
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770261,
					"content": "而那些故事的真实结局…呵，也让我更深地认识了这个真实的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770262
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770262,
					"content": "对我来说，这些故事确确实实地帮助过我「厘定真伪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770263
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770263,
					"content": "将它们搜集起来，或许能帮助我寻找「鹮之王」所需要的那个答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770264
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770264,
					"content": "所以，在挪德卡莱扎下脚跟之后，我就开始用各种渠道打听起了父亲曾经讲述的那些故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770265
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770265,
					"content": "但这些故事大部分在沙漠人之中口口相传，几乎没有书面记录。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770266
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770266,
					"content": "我远在挪德卡莱，自然不可能自己跑去沙漠里到处寻访遗民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770267
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770267,
					"content": "至于雅珂达…我这里本来就缺人手，想想还是算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770268
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770268,
					"content": "所以，我就和坐拥无数冒险家的冒险家协会达成了长期合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770269
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770269,
					"content": "只要为我带回沙漠人的故事，我就会付出相应的报酬，甚至…帮他们一点小忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770270
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770270,
					"content": "萨林先生很愿意接受我的条件，很快和我达成了共识。从结果上来说，我们合作得也很愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770271
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770271,
					"content": "那…关于你刚刚搜集到的这篇故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770272
					]
				},
				{
					"id": 760770272,
					"content": "啊，这一篇啊。这是我父亲给我讲的最后一个故事。也是他唯一一篇没有修改结局的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770274
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770274,
					"content": "说了一辈子谎的人，在唯一一次诚实地讲述故事后，就被黄沙掩埋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770288
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770288,
					"content": "哈，这故事里居然还写着：「他是打心眼里善良的，这是无上的智慧。」…真是够讽刺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770275
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770275,
					"content": "你们对这份故事感兴趣的话，我抄一份给你们就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770276
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770276,
					"content": "#顺便一提，{NICKNAME}，你也是冒险家对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770277,
						760770278
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770277,
					"content": "呃…欸？对，对啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770279
					]
				},
				{
					"id": 760770279,
					"content": "我知道你常年在世界各地旅行，见多识广。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770280
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770280,
					"content": "有意向的话，我们也可以签署一个长期合作的…框架协议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770281
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770281,
					"content": "如果你在旅途中取得了有关须弥沙漠人的故事，可以拿来给我，我会付给你一笔丰富的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770282
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770282,
					"content": "原、原来你让我们来，是为了最后这句话啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770283,
						760770284
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760770283,
					"content": "奈芙尔果然是发委托的人啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770285
					]
				},
				{
					"id": 760770285,
					"content": "很好，那预祝我们合作愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770286
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770286,
					"content": "…不过，雅珂达为什么还没回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760770287
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770287,
					"content": "她接的那项委托，有这么困难么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760770284,
					"content": "好吧，我果然是做委托的命啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770285
					]
				},
				{
					"id": 760770278,
					"content": "怎么突然提起这个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770279
					]
				},
				{
					"id": 760770255,
					"content": "是为了看看原版故事究竟是怎样吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770256
					]
				},
				{
					"id": 760770224,
					"content": "里面难道有什么谜语？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770225
					]
				},
				{
					"id": 760770218,
					"content": "一定是要寻找很重要的东西吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760770219
					]
				}
			]
		}
	]
}