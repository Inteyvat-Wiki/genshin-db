	"talks": [
		{
			"id": 4000202,
			"completionStepIds": [
				4000202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000202",
							"2"
						],
						"stepId": 4000202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "喔，是你们啊，感谢你们来为海灯节捐赠物资。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020202,
					"content": "说起来，今天其实有一件「捐赠」以外的事…嗯，具体来说是「收购」，你们感兴趣吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020203,
					"content": "欸？这次不是无偿的吗？那我很感兴趣！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400020204,
					"content": "哈哈，那就拜托你们了，事情是这样的…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020205,
					"content": "我们为了操办节日事宜，需要两种特殊的「浮生石」。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020206,
					"content": "一种叫做「岚生石」，在天衡山北部偶尔会有发现记录。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020207,
					"content": "根系下埋藏着岚生石的普通灌木，有时会变异成「蓬蓬果」，让种子浮空。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020208,
					"content": "另一种叫做「霞生石」，它对一般人来说非常危险…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020209,
					"content": "在归离原，失去飞行动力的老旧「遗迹猎者」，会靠「霞生石」维持自己的飞行能力。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020210,
					"content": "了解！「岚生石」和「霞生石」是吧？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400020211,
					"content": "（其实就是红色和蓝色的浮生石啦…好听的名字都是宝石商人故意起的…）$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020212,
					"content": "没错，就拜托你们把它们带回来了。要加油喔。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慧心"
				}
			]
		},
		{
			"id": 4000205,
			"completionStepIds": [
				4000205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000205",
							"2"
						],
						"stepId": 4000205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "啊，这是…「岚生石」和「霞生石」，品质都很不错！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020502,
					"content": "谢谢你们！这是报酬。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020503,
					"content": "你们的每一次努力所得，都会为海灯节增光添彩。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020504,
					"content": "对了，既然在海灯节期间来璃月旅行，不如多关注一下「明霄灯」的变化吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020505,
					"content": "随着进度推进，码头上的建设工地，会有越来越值得一看的风景。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020506,
					"content": "#听起来很有趣，{NICKNAME}，我们现在就过去看看吗？$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000214,
			"completionStepIds": [
				4000214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
