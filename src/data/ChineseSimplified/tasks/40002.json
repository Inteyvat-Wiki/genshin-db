			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021001,
					"content": "在海灯节的最后一天，会有很多很多人来看「明霄灯」放飞。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021002,
					"content": "在这么危险的地方出现可疑人物，我觉得一定没有好事。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021003,
					"content": "如果他在堆放的易燃材料里，做了什么手脚…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021401,
					"content": "看来必须得依靠官家的力量了！赶紧去璃月的「总务司」，汇报这件事情吧。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021406,
					"content": "为什么感觉派蒙对这件事这么上心？$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "那，那是…璃月大家一起努力的成果啊！绝对不允许捣乱行为！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021408,
					"content": "说实话。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "码头附近的「中原杂碎」是真的好，吃过一次忘不了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021410,
					"content": "你在复读摊主的吆喝吗…$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "欸嘿嘿。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000215,
			"completionStepIds": [
				4000215
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000215",
							"2"
						],
						"stepId": 4000215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉义"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021501,
					"content": "请留步，前方是璃月总务司。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400021502,
					"content": "我们是来举报可疑人士形迹的。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "我们在明霄灯的易燃材料堆放现场，看到了鬼鬼祟祟的人！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021504,
					"content": "绝对不能让做出「中原杂碎」的小摊就这么没了！$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021505,
					"content": "啊，这可是件大事。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400021506,
					"content": "对吧对吧。璃月港的美食可是城市的神髓——$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021507,
					"content": "呃，我们说的应该不是同一件「大事」。不过小家伙你说得也没错。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400021508,
					"content": "具体情况我知道了，我会向上峰如实转达的。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "嘉义"
				},
				{
					"id": 400021509,
					"content": "谢谢你们的消息。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
