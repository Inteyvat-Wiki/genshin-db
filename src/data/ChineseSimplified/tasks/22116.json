			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "富有张力的热血战斗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "热血战斗…热血战斗，嗯…有点道理，这东西最能吸引眼球了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160303,
					"content": "不过，别说「富有张力的热血战斗」了，这轻策庄里连「战斗」都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160304,
					"content": "看来我得出去取点材。对了！我听说…在野外有很多冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160305,
					"content": "为了寻宝，他们会到处跑，还经常和野外的那些怪物打起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160306,
					"content": "我刚好知道一个地方有很多怪物，而且那地方看起来嘛…也像模像样的，咱们就去那里等着！等着那些冒险家过来，和那些怪物好好打上一场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160307,
					"content": "然后嘛，嘿嘿，这材料不就到手了。好了，那地方还有点远…我先过去了啊，你赶紧过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211608",
							"2"
						],
						"stepId": 2211608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "嘿…这回，哎哟，这回我算是亲身体验了一把「富有张力的热血战斗」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160502,
					"content": "你不只是想旁观战斗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "那是啊，我开始是这么想，但是谁叫冒险家迟迟就不出现呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160504,
					"content": "那些怪物慢慢悠悠，眼看着就要离开了，要是它们真走了，我不就白等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160505,
					"content": "然后我就…丢了块小石头过去，小说里不都这么写，丢块石头吸引住注意力什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160506,
					"content": "谁，谁知道，我把石头给直接丢到那怪物头顶上去了，然后…就这样了嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160507,
					"content": "哎呀，得了得了，虽然是吃了点皮肉苦，但是这材还是取到了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160508,
					"content": "我现在是才思泉涌！对了，这是给你的，多亏了你帮我，这些就算是谢礼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160509,
					"content": "我感觉，一回去我就能马上动笔了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				}
			]
		},
