					"nextDialogs": [
						221161203
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 221161203,
					"content": "可我觉得小蒙扮船长的时候，我们玩得最开心呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 221161204,
					"content": "璐璐，你不能这么说，阿飞也演得不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 221161205,
					"content": "对呀，没错，你扮船长的时候，我扮富商，阿飞扮服务生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 221161206,
					"content": "这个时候，我们玩得是最开心的呀，对吧阿飞？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 221161207,
					"content": "璐璐，你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 221161208,
					"content": "璐璐都这么说了，那…那也行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 221161209,
					"content": "阿飞，你这又是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 221161210,
					"content": "没事啦！没事了，璐璐开心就好了，我们继续来玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "阿飞"
				},
				{
					"id": 221161211,
					"content": "不就是个船长吗，我才不稀罕呢。",
