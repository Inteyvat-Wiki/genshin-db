			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "到底怎么开头好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160102,
					"content": "你又在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "哦，是你啊。我准备新写一本小说，但无论怎么开头，都觉得缺了点什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160104,
					"content": "我想了很久，还是一点头绪都没有，这么下去什么时候才能开始写啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221160105,
					"content": "对了，我知道你是见多识广了。你觉得，一本成功的小说最需要的是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "常九爷"
				}
			]
		},
