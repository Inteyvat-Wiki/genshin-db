			"dialogs": [
				{
					"id": 755080101,
					"content": "哟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080102
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080102,
					"content": "我们最最重要的客人来啦，说明气氛即将达到最热点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080103
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080103,
					"content": "玛拉妮，你好呀！希诺宁也在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080104,
					"content": "还有瑞希？你从稻妻过来啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080105,
					"content": "没错哦，纳塔的朋友们待我就像家人，「流泉之众」就像是我异乡的家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080106
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080106,
					"content": "我也需要用心打理分店，才能为纳塔的大家提供力所能及的帮助嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080107
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080107,
					"content": "说得不错，瑞希小姐的工作态度实在无可挑剔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080108
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080108,
					"content": "和她一对比，传说中的乙方模板都会显得怠惰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080109,
						755080110
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080109,
					"content": "原来希诺宁也是瑞希的客户？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080111
					]
				},
				{
					"id": 755080111,
					"content": "最近做了几个奇怪的梦，比如…委托人把原本四周的订单工期缩短到一周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080112
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080112,
					"content": "或者接到的需求是「外形圆润又带着危险感的挂饰」，同样是四倍加急…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080113,
						755080114
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080113,
					"content": "这题我会，史莱姆和蕈兽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
					"id": 755080115,
					"content": "反应这么快，该不会是你托梦给希诺宁下单的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080116,
					"content": "这两种生物…危险吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080117
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080117,
					"content": "唔，工期倒是次要的，圆形图案处理起来比较费事，一旦加急，成品效果就未必完美了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080118
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080118,
					"content": "梦里这类的麻烦订单还不少，我感觉有些不对劲，就把手头的单子都结了，来瑞希小姐的店里试了试…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080119
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080119,
					"content": "结果还真灵验，当天午睡时，我就没再做过奇怪的梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080120
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080120,
					"content": "能为希诺宁女士排遣烦扰，我深感荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080121
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080121,
					"content": "不过我觉得，希诺宁女士的古怪梦境会消散，主要的功劳应该还在于您自己啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080122
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080122,
					"content": "总而言之，现在大家的精神状态都很不错，正是放松的好时机——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080123
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080123,
					"content": "「流泉之众」要重启水上派对的传统，让大家玩个痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080124,
						755080125
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080124,
					"content": "水上派对~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080126,
					"content": "好耶，玩个痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080127,
					"content": "…不过，我以前还没参加过这种活动，只知道有好吃的东西和好喝的饮料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080128,
					"content": "一般纳塔人会在派对上玩些什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080129,
						755080130,
						755080131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080129,
					"content": "鳍游龙拉着客人高速冲浪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080132,
					"content": "我…我能玩这个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080133,
					"content": "哎呀，你们已经是成熟的极限运动爱好者了！我第一时间也想让客人们玩这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080134
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080134,
					"content": "不过阿米娜很认真地说…咳咳…「对于一般人来说，这样的活动还是刺激过头了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080135
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080135,
					"content": "「就算是普普通通的沙滩排球，一些客人都可能把握不住力道，导致同伴受伤哦！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080136
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080136,
					"content": "「要是参加了派对，一个不注意，没能玩个痛快，反而留下了心理阴影，到时候增加的就是瑞希小姐的工作量了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080137
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080137,
					"content": "我倒是不介意帮更多人排忧解难啦，但可不包括自己制造出的病患哦，还是别让客人受伤为妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080138
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080138,
					"content": "嘿嘿，所以我才好好找你咨询了一番嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080139
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080139,
					"content": "看来你们已经商量出了不错的方案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080140,
					"content": "没错，我们达成了共识，希望更多没有极限运动基础的客人参加派对，而不是看着刺激的活动望而却步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080141
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080141,
					"content": "在和我聊天时，玛拉妮小姐听说了稻妻的「三川花祭」，对历年祭典上的轻松游戏很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080142
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080142,
					"content": "就萌生了一个念头——将「秋津羽戏」与纳塔的氛围相结合，打造出既能休闲放松，又能玩个爽快的游戏「节拍撞球」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080143
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080143,
					"content": "稻妻的游戏…纳塔的氛围…还真是以前从没想过的组合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080144,
						755080145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080144,
					"content": "我看到了「回声之子」的「热舞乐台」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080146,
					"content": "啊呀，「热舞乐台」明明还没调高音量，看来你对低音和鼓点还挺敏感的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080147
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080147,
					"content": "这次的主力游戏「节拍撞球」，就是跟着热情的音乐，畅玩弹球，打碎所有方块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080148
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080148,
					"content": "顺从本能，释放自我，不必考虑复杂的技巧，不用担心安全问题，任何人都能玩个痛快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080149
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080149,
					"content": "#当然，对于{NICKNAME}这种天赋异禀的选手，应该能打出…具有特别「节拍」和「层次」的效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080150
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080150,
					"content": "在不同的控碟乐师手中，一首曲子有可能展现出截然不同的风格，带有打击感的游戏也是同理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080151
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080151,
					"content": "没准…「驰放」风格的基底音乐，经过你的处理，都会展现出类似「出神」或「艺核」的有趣律动呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080152
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080152,
					"content": "我有点期待哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080153
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755080153,
					"content": "#听…听不太明白！不过感觉，应该是{NICKNAME}能做到的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080154,
						755080155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080154,
					"content": "那我就来扮演音乐和游戏天才！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080156,
					"content": "太对了，就是这种劲头！在我们的期待中，无论如何都要保证玩得最开心的客人，就是你和派蒙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080157
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080157,
					"content": "待会儿我要拿一堆零食和饮料，在一边开开心心地看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080158
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 755080158,
					"content": "当然，也请注意，别兴奋过头呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080159
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080159,
					"content": "说不定晚上睡觉前，脑子里还在反复播放「热舞乐台」的音乐，停不下来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080160
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 755080160,
					"content": "谢谢大家！我们一定玩个开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080161,
					"content": "话说回来，我记得希诺宁很会挑歌，就算梦里还在重播…应该也没问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755080155,
					"content": "不至于这么强，我会尽力的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080145,
					"content": "我的身体感受到了音乐的律动…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080130,
