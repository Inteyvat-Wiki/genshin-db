				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾拉·马斯克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "又见面啦，你还记得我吗？忘了的话…你总记得上次我们和丘丘人进行的那些「友好交流」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030102,
					"content": "唔，别这么看着我嘛，语言学习这种事情，就是要不断的练习才行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030103,
					"content": "你放心，我可没有让你的努力白费，上次回来之后，我的丘丘人语口语水平已经有了很大的提升…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030104,
					"content": "但是口语水平是提升了，书写水平也不能落下呀。所以，在经过严谨研究之后…我用丘丘人语完全原创了几首诗歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030105,
					"content": "不过…这些诗歌里面，还有几句我没办法确定意义，你能帮我去「查证」一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030106,
					"content": "…「查证」的意思是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "当，当然就是去念给丘丘人听，看看它做什么反应啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030108,
					"content": "不过，别担心！那些具体意义存疑的单句，我都<color=#00E1FFFF>做了标注</color>，意义应该偏差不了太远…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030109,
					"content": "我已经挑好了目标，那几位丘丘人看上去脾气很好，你就把那几句单句念给它们听吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030110,
					"content": "那就拜托你了！把我写的诗念给丘丘人听之后，再回来告诉我详细情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030111,
					"content": "…又要去念给丘丘人听？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "对啊，你看你已经很熟练了嘛。别担心啦，那些具体意义存疑的单句，我都<color=#00E1FFFF>做了标注</color>，意义应该差不了太远…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030113,
					"content": "我已经挑好了目标，那几位丘丘人看上去脾气很好，你就把那几句单句念给它们听吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030114,
					"content": "那就拜托你了！把我写的诗念给丘丘人听之后，再回来告诉我详细情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "艾拉·马斯克"
				},
				{
					"id": 201030115,
					"content": "如，如果有什么意外的话，我相信你们应该处理得好…",
					"roleType": "TALK_ROLE_NPC",
