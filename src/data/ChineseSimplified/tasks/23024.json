			"dialogs": [
				{
					"id": 230240101,
					"content": "二位，你们终于来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230240102,
					"content": "时间正好，万事齐全了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "古尔根"
				},
				{
					"id": 230240103,
					"content": "为什么这么兴奋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "难道说，之前的蔷薇要开花了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230240105,
					"content": "没错，哈哈哈！这都是多亏了你帮忙啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230240106,
					"content": "虽然这株蔷薇还没有盛开，但根据整个植株的形态可以判断，它的生命力极其旺盛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "古尔根"
				},
				{
					"id": 230240107,
					"content": "旅行者，如果你有兴趣的话，就来近距离观察一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230240108,
					"content": "哈哈哈，说不定，它会在你们面前盛开呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "瓦尔坦"
				},
				{
					"id": 230240109,
					"content": "那我可要好好看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "真，真的吗？在这么短的时间里开花？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230240111,
					"content": "好期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
