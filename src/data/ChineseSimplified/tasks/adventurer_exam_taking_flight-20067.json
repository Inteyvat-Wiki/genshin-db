					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "旅行者…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670104,
					"content": "自从上次你给我辅导之后，我又很认真地学习了很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670105,
					"content": "然后，我就请杰克来帮我做了一次模拟考试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670106,
					"content": "结果…结果考下来，我不及格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670107,
					"content": "真不知道是哪里出了问题…旅行者，你能再辅导我一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670108,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "那就拜托你了，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670111,
					"content": "唔…第一个问题是，在飞行时，最多可以同时几人共用一架风之翼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200670109,
					"content": "（难道上次有答案错了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
		},
