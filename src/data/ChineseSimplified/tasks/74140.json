			"dialogs": [
				{
					"id": 741401101,
					"content": "哎呀，又见面了。咦，这次把派蒙也带来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401102,
					"content": "咦，上次我们一起「冥想」到这里来的时候，我也在呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401103,
					"content": "有这回事？那可能是我忘了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401104,
					"content": "不管怎么说，多亏你帮忙，我才找到了「谜镜」的位置、找到将要盛开花朵的地方，对这里的了解也加深了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401105,
					"content": "唔…夏诺蒂拉说话的风格还是这么令人摸不着头脑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401106,
					"content": "汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "嗯？不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401108,
					"content": "呜汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "好啦好啦，我知道啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401110,
					"content": "（唔…她和小狗在说什么呀？难道说，美露莘一般都会狗语吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401111,
					"content": "（真不可思议。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "真没办法，那下次再见喽。哼，就算你这么说了，我也还是会回来找你玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401113,
					"content": "#那我们走吧，{NICKNAME}{M#哥哥}{F#姐姐}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏诺蒂拉"
				}
			]
		},
		{
			"id": 7414013,
			"completionStepIds": [
				7414013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
