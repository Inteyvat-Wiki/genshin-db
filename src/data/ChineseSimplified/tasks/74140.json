							2560.522,
							232.133,
							4711.404
						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "唉。又到这里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401302,
					"content": "怎么啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401303,
					"content": "其实我也觉得这么说太任性了，毕竟大家都对我很好，你们也对我很好。但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401304,
					"content": "不觉得现实世界无趣得可怕吗？不觉得书里的世界更美丽吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401305,
					"content": "我也觉得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "欸？你居然这么觉得吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401311,
					"content": "我觉得，还是「揭示之书」里的世界更美丽。到处都是沾着露水的花瓣，而且好不容易才跟小狗交上了朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401312,
					"content": "小狗…说起来，夏诺蒂拉，你能听懂狗狗说的话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401313,
					"content": "嗯？当然不能啦。只是，「揭示之书」里的小狗是特别的。也可能，我是特别的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401314,
					"content": "但我一直冥想，到书里的世界去玩。有一天，突然间，原本的汪汪叫，就变成了语言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401315,
					"content": "至于我们说的话…他在劝我走，让我不要再来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401316,
					"content": "唉，我还是想看到向日葵盛开的景象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401317,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "是、是喔…夏诺蒂拉要多保重喔！那我们先走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741401307,
					"content": "我不这么觉得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "是喔…可能这样才是对的，我这样是不正常的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "夏诺蒂拉"
				},
				{
					"id": 741401309,
					"content": "对我来说没有区别。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#看来{NICKNAME}{M#哥哥}{F#姐姐}是最坚强的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "夏诺蒂拉"
				}
			]
		}
	]
}