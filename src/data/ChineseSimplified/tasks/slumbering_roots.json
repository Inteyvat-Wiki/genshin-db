					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "大树的根，很好，可以听到潮湿的呼吸，是昏昏欲睡的曲调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170402,
					"content": "哦…还是没听懂兰贡迪在说什么，不过算了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170403,
					"content": "说起来，里面居然有这么大的空间，这就叫「盘根错节」吗？而且，总觉得这里的氛围和其他地方很不一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170404,
					"content": "要在这种地方找到给法留纳神机输送能量的「叶」吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170405,
					"content": "在这里，但是又不在。听得到它的声音，闻得到它的气息，看得到它的脉络，但是派蒙找不到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170406,
					"content": "啊？那是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170407,
					"content": "派蒙找不到，那我呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "金色的那菈，看得到旋律，像夜晚的凉风，倏忽而至的雨，破碎湖面一千片的梦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170409,
					"content": "听起来很厉害的样子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#不愧是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170411,
					"content": "嘿嘿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#嘿嘿…不对啦！{NICKNAME}这不是在抢我的词吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170413,
					"content": "#那菈{NICKNAME}变成派蒙…比在无留陀和蘑菇一起跳舞更可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170414,
					"content": "无法想象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "所以说这种事情是不会发生的啦！最好是不要发生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170416,
					"content": "兰贡迪也是，就不能说得明白点吗？我们到底要去哪里找法留纳神机的「叶」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170417,
					"content": "在梦里找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170418,
					"content": "哦…等等，那你为什么不一开始就这么说呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170419,
					"content": "因为派蒙问为什么，没有问在哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170420,
					"content": "欸…我好像突然明白兰那罗的交流方式了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170421,
					"content": "兰贡迪可不可以告诉我们要找的三个「叶」分别具体在哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170422,
					"content": "可以呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170423,
					"content": "哇，兰贡迪是真的只会回答被直接问到的问题…好吧，那这三个地方具体在哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170424,
					"content": "在这边、那边和另一边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170425,
					"content": "嗯嗯…不是，你这不是什么也没说吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170426,
					"content": "派蒙大失败。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#派蒙大失败和{NICKNAME}大失败是一回事啦！兰贡迪的话根本没法参考嘛…我们该怎么找到那三个地方呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170428,
					"content": "法留纳神机是最了不起的兰那罗造的，「枝」和「叶」的联系，看不见，又看得见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170429,
					"content": "#那菈{NICKNAME}看得见兰那罗，看得见兰那罗的痕迹，就能找到方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170430,
					"content": "我、我居然听懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170431,
					"content": "跟着兰那罗的痕迹就能找到，对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "呜呜…至少把这次回答的机会让给我嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
