				{
					"id": 730171001,
					"content": "潮湿的梦，干燥的梦…叮咚，嘀嗒，沙沙，是桓那的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171002,
					"content": "#那菈{NICKNAME}？「叶」在梦里，「枝」在这里。",
					"roleType": "TALK_ROLE_NPC",
