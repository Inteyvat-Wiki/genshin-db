			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "我们回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171202,
					"content": "听到了，呜咽变成了婉转的曲调，但是要汇入声音的大流还需要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171203,
					"content": "还需要兰贡迪帮忙！嘿嘿，接下来就拜托你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171204,
					"content": "兰贡迪知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171205,
					"content": "哦！这样应该没问题了吧！希望能快点治好法留纳神机，不然水天丛林那边全是孢子…光是想想就…阿嚏——呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171206,
					"content": "真不敢相信兰那罗居然对孢子没什么反应…难道兰那罗都不会受影响吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171207,
					"content": "兰那罗会煮蘑菇，不是没事。「孢子」，太小太多，抓不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171208,
					"content": "法留纳神机没有坏的时候，桓那没有这么多蘑菇，所以治好法留纳神机，都会变好。除了无留陀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171209,
					"content": "一定会变好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#对呀，我和{NICKNAME}也会帮忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171211,
					"content": "无留陀也会有办法解决的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#那菈{NICKNAME}是那菈法留纳吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171213,
					"content": "欸？为什么突然这样问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171214,
					"content": "兰般度说，那菈法留纳是金色的、勇敢的那菈，和兰那罗一起治好了法留纳神机，赶走了黑色的雨和泥，带回了月亮和太阳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171215,
					"content": "#那菈{NICKNAME}也帮兰那罗治法留纳神机，也是金色的、勇敢的那菈，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171216,
					"content": "可是，那菈法留纳不是很早以前的人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171217,
					"content": "#那菈法留纳没有又回到桓那吗？那菈{NICKNAME}是完全不一样的那菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171218,
					"content": "不一样的那菈，也会有相似的旋律吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171219,
					"content": "也许吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "兰贡迪没有见过那菈法留纳，但是兰般度讲了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171222,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的旋律，一定和那菈{NICKNAME}一样，听到就会开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171223,
					"content": "#是哦，我只要和{NICKNAME}在一起，总是很开心！如果哪天就像那菈法留纳离开森林一样，{NICKNAME}也要离开我的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171224,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171225,
					"content": "#兰般度一定在「歇脚处」等我们了，那菈{NICKNAME}，和兰贡迪一起回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171226,
					"content": "我们走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "嗯，我们一起回去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730171228,
					"content": "可是还有其他事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "没关系，兰贡迪独自回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730171220,
					"content": "我不知道…",
