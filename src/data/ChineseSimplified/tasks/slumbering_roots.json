			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"兰贡迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "哦！可算找到你啦！你就是兰贡迪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170202,
					"content": "我可以不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170203,
					"content": "嗯？这是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170204,
					"content": "因为我可以是树，可以是雨，可以是桓那的梦，也可以是乐器的弦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170205,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170206,
					"content": "#完全没听懂他在说什么呢！{NICKNAME}，你知道他在说什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170207,
					"content": "我也没听懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "感觉每个字都知道是什么意思，但是连成句子就听不懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170213,
					"content": "金色的那菈，和会飞的小东西，为什么要找兰贡迪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170214,
					"content": "我不是什么「会飞的小东西」啦！等等，我好像确实是…？哎！总之，我叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170215,
					"content": "#「金色的那菈」也有自己的名字，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}叫{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170216,
					"content": "是兰般度告诉我们的，说兰贡迪在梦景林莽，让我们来看看情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170217,
					"content": "派蒙可以告诉兰般度，兰贡迪很好，梦景林莽很好，潮湿的梦也很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170218,
					"content": "#好哦…{NICKNAME}，那我们回去找兰般度吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170219,
					"content": "…才不是啦！我们是来治好法留纳神机的！好险，差点被牵着鼻子走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170220,
					"content": "派蒙可以告诉兰般度，兰贡迪不想牵派蒙的鼻子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170221,
					"content": "兰般度可能不想知道这个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "我也不想知道啦！这个兰那罗到底是怎么回事嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170223,
					"content": "记得兰般度说过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "兰般度提到兰贡迪的时候说，「他和那菈更疏远」…意思是，他不知道怎么和人交流吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170225,
					"content": "是我们不知道怎么和兰那罗交流。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "啊！说的也是，「入乡随俗」，应该是我们学习他们的交流方式才对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170227,
					"content": "不过，事到如今仔细想想，兰那罗的交流方式到底是什么样的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170228,
					"content": "会飞的小东西觉得呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "金色的那菈都不知道，会飞的小东西怎么会知道呢？不如我们来问问神奇的兰贡迪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170233,
					"content": "兰贡迪可不可以告诉我们，兰那罗之间到底是怎么交流的呢？我们也想认真学习一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170234,
					"content": "为什么要学？那菈是那菈，派蒙是派蒙，兰那罗是兰那罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170235,
					"content": "…啊，知道了，派蒙也想变成种子埋进土里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170236,
					"content": "不想！一点也不想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170237,
					"content": "那金色的那菈想要变成种子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170238,
					"content": "谢谢，不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "种子很好，可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170242,
					"content": "扯了半天都快忘记我们来这儿的目的了，是无忧节！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170243,
					"content": "为了无忧节，我们得把法留纳神机治好，这样天气就会恢复正常了，也不会有那些讨人厌的孢子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170244,
					"content": "派蒙说得对，为了无忧节，为了蔚蓝大地的中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170245,
					"content": "湿气氤氲的梦景林莽很好，但是「孢子」不好，会跑的蘑菇也不好，雨太多了，蘑菇也变得难煮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170246,
					"content": "哦！你这不是很明白嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170247,
					"content": "#我们去治好法留纳神机，那菈{NICKNAME}和派蒙跟兰贡迪走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730170240,
					"content": "如果可以的话，好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "别信口胡说呀，他会当真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170230,
					"content": "总之先试试比喻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "那我试试！金色的那菈，就像…就像…唔…就像提瓦特煎蛋一样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170232,
					"content": "…我们还是问问兰贡迪吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170209,
					"content": "大概能猜到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "太厉害了！那么他的话到底是什么意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730170211,
					"content": "他说他可以变形成很多其他的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#真的吗？{NICKNAME}可不要骗我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
