				"points": []
			},
			"dialogs": [
				{
					"id": 1903203101,
					"content": "唔…唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203102,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，芊芊有件事，需要你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203103,
					"content": "找我帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "那个蓝色头发的方士，很可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203106,
					"content": "芊芊害怕，能不能把他带走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203107,
					"content": "你也会受到纯阳之体的影响？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "芊芊根本不敢靠近他，他的体内放出的那种力量，太可怕了，会让我消失的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203110,
					"content": "芊芊还不想消失，所以，求求你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203111,
					"content": "不知道你在他眼里算不算妖邪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "那这样吧，芊芊有个主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203114,
					"content": "我刚刚在远处，看到蓝色头发的方士正在和人争吵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203115,
					"content": "芊芊能把找麻烦的人都吓跑，但你要让他放过芊芊，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203116,
					"content": "你说的是真的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "千真万确，芊芊说的都是实话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203120,
					"content": "怎么样，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203121,
					"content": "我不能替他做主，只能说明情况。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "好吧，芊芊就当你答应了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203123,
					"content": "希望那个蓝色头发的方士，是个好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203124,
					"content": "芊芊去帮他，你也要去帮他，然后…你再帮帮芊芊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203118,
					"content": "我也能帮他摆脱麻烦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "唔，但是会很麻烦，芊芊已经有好办法了，你要相信芊芊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203112,
					"content": "我不能替他做主啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "怪不得今天没有看见你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "为什么是我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}