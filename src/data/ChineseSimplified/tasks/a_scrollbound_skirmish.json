				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "要我说，虽然「面具斗士」不能像「调停人」那样自由地飞来飞去，但只要找准机会，埋头冲刺，肯定能赢下对局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "「小松果」"
				},
				{
					"id": 755100102,
					"content": "呆子，不能太依赖直线行动的速度啊，转不过弯，撞不中，不就没有意义了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "「燃爆木头人」"
				},
				{
					"id": 755100103,
					"content": "好啦好啦，孩子们，可以认真讨论，但不能动气吵架哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "维热"
				},
				{
					"id": 755100104,
					"content": "没有啦，没有啦，我们只是…聊到强大的战士，都非常兴奋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "「燃爆木头人」"
				},
				{
					"id": 755100105,
					"content": "你可以放心的，维热姐姐！就算要比出个高低，我们也会讲道理，摆证据！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "「小松果」"
				},
				{
					"id": 755100106,
					"content": "还有个方法，再来一局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "「燃爆木头人」"
				},
				{
					"id": 755100107,
					"content": "那就再来一局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "「小松果」"
				},
				{
					"id": 755100108,
					"content": "真热闹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "新的客人，你好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "维热"
				},
				{
					"id": 755100111,
					"content": "看你的装束，应该是一位旅者吧？那我们是同行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "维热"
				},
				{
					"id": 755100112,
					"content": "要不要和孩子们一起，来试试我最近创作的这个「互动织卷」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "维热"
				},
				{
					"id": 755100113,
					"content": "「互动织卷」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "简单来说，就是结合了璃月剪纸戏、稻妻漫画和枫丹映影三种技术的幕布游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "维热"
				},
				{
					"id": 755100116,
					"content": "以本地著名的战士为原型，加入一些「跨界挑战」的设想，组合成新奇的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "维热"
				},
				{
					"id": 755100117,
					"content": "说不定能给你带来非常新奇的体验呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "维热"
				},
				{
					"id": 755100118,
					"content": "那我来试试看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "好呀好呀，祝你玩得开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维热"
				},
				{
					"id": 755100114,
					"content": "会动的画卷？",
