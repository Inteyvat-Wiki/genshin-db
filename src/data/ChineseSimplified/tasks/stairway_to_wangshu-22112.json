			"dialogs": [
				{
					"id": 221120501,
					"content": "行了，这样就可以走人了，应该也不会有人摔下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120502,
					"content": "和楼梯看着不太搭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "不太搭？这也没办法，我也不是专业的木匠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120504,
					"content": "呼…不过，这还只是第一个，还有一个断口得修。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120505,
					"content": "不过，今天就到这吧，客栈还开着，我还得去接待客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120506,
					"content": "楼梯得修，生意也得做啊…辛苦您了，这些您拿着吧。",
					"roleType": "TALK_ROLE_NPC",
