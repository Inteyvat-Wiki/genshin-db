					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "看来还是不修不行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "哦，是您啊。瞧瞧，这上客栈的楼梯断了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120104,
					"content": "这么大的一截断口，路过的人太容易摔下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120105,
					"content": "怎么断的？哦，之前有一群怪物想要冲进客栈，我就出去处理了一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120106,
					"content": "结果没收住手，把一个大块头怪物打了过来，一下子就把楼梯给砸烂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120107,
					"content": "说要修，结果一直没空出时间来，现在客人越来越多，这楼梯实在是不修不行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120108,
					"content": "这里还算好修，我一个人就能修好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120109,
					"content": "如果有空的话，您能帮我去拿点木板来吗？我在这守着，免得又有人失足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "那就麻烦您了，我专门买了一批木板来修这里，就放在客栈底下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120112,
					"content": "您去看看，然后拿几块给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120113,
					"content": "要是再被砸烂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "那不能，我又不是年轻的时候了…再来一次，我绝对能收住手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120115,
					"content": "不过，还是先得修好再说。为了这，我还专门买了一批木板，就放在客栈底下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120116,
					"content": "劳烦您，帮我下去拿点上来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
