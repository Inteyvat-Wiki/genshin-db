					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "木板我都放在客栈底下了，应该挺好找的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120204,
					"content": "您去找找吧，我在这守着，免得又有人急匆匆地过来，一个不小心就下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
