				"objectNames": [
					"重云"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190250501,
					"content": "没想到这么容易就被找到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250502,
					"content": "经验不足吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "我还觉得我选的地方，应该能把我藏得很好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250505,
					"content": "我平时追寻的妖邪，都是隐藏踪迹的大师。它们会藏在什么地方，我粗略地总结了一些经验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250506,
					"content": "就像这里，周围都是方正的东西，不少都积了灰，而光线也不能照得很通透，妖邪很喜欢停留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250507,
					"content": "还是把捉迷藏和方术联系在一起了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "嗯，果然不该借鉴这样的经验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250511,
					"content": "既然被找到了，我就痛快认输吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250512,
					"content": "不过投入进去以后，我觉得这种简单的游戏，也很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250513,
					"content": "那下次再一起玩吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "好啊，我们都多叫些朋友来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250517,
					"content": "那我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "重云"
				},
				{
					"id": 190250515,
					"content": "幸好没让你当鬼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "呵呵，说得没错，我来找的话，恐怕一个时辰都找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250509,
					"content": "可是，一眼就被看到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "唔，确实，太紧张了，忽略了最应该注意的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "重云"
				},
				{
					"id": 190250503,
					"content": "…为什么会选在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
