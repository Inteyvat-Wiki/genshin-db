			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "旅者啊，你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440402,
					"content": "此处是引魂之处，也是妾身最后的执念所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440403,
					"content": "太阳之子每到了一定岁数，就会按典仪，于生辰之日进入大日御舆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440404,
					"content": "进入大日御舆？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "是啊，所谓的进入大日御舆，即是「归日之祭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440407,
					"content": "太阳之子从大日御舆而出，在被凡尘浊世侵染之前，回归太阳御座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440408,
					"content": "…大日御舆温度之高可炽照白夜之国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440409,
					"content": "太阳之子中，最后回到引魂之处的，都已经是残缺魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440410,
					"content": "但是妾身还是觉得，或许…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440411,
					"content": "或许？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "或许妾身打开引魂之地，就能够靠自己的记忆补足他们的残魂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440426,
					"content": "就让妾身一试吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440427,
					"content": "比螺梦门…御琉部栖…妾身在这里，你们还不归来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440428,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440429,
					"content": "怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "唉，七任太阳之子中，比螺梦门与御琉部栖由妾身养大，若连他们都不愿回应…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440413,
					"content": "看来只有妾身一人的记忆，还是不足够啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440414,
					"content": "如果有什么作为媒介，若有象征太阳之子正身的御辔就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440415,
					"content": "只可惜那枚御辔早就佚失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440416,
					"content": "唉…这个国家，白夜之国，仍然在恨着这些孩子们啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440417,
					"content": "看来，想要解放他们的残魂，终究只是妾身的痴心妄想罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440418,
					"content": "…旅者，算是妾身最后拜托你，能帮忙找寻「神舆之辔」所在吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440419,
					"content": "虽然，找到的可能也并不大。你已经帮妾身许多，再提出要求也显得有些厚颜无耻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440420,
					"content": "不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440421,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "那真是…那真是感谢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440424,
					"content": "不过，御辔丢失已久，也不急于一时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440425,
					"content": "若是有消息，便来妾身这儿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440422,
					"content": "我会尽力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "那不就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
