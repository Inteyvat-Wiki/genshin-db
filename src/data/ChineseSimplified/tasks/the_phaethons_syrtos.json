			"dialogs": [
				{
					"id": 722440301,
					"content": "如是，七盏魂灯既已亮起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440302,
					"content": "看来你们已经完成凭吊了。你们的帮助，妾身铭感于心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440303,
					"content": "那么，现在就由妾身为你们来打开…通往引魂之地的道路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440304,
					"content": "异乡的旅者啊，因妾身私念为你造成了许多麻烦…不过妾身仍希望你能见证安魂之仪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440305,
					"content": "请随着这条道路前进吧，妾身会在那里等你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由卖"
				}
			]
