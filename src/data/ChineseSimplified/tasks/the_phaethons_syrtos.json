						],
						"stepId": 7224401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"久利由卖",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "嗯？真是古怪，妾身已很久未见你们这样穿着之人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440102,
					"content": "言行举止，看上去也并非白夜国民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440103,
					"content": "难不成，是自异邦落入此处的旅客么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440104,
					"content": "是的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "没想到，白夜国竟然也有来自世外的通途吗…真是令人惊讶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440106,
					"content": "说来，妾身从出生起就在白夜国，从未见过世外之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440107,
					"content": "从前，有人向妾身提及此事，说想要一窥天外风景，妾身都以为是他的玩笑话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440108,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440109,
					"content": "旅者啊，其实妾身有一事相求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440110,
					"content": "在白夜之国各处，有七座压着「太阳{RUBY#[D]法厄同}之子」遗服的御陵墓石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440111,
					"content": "太阳之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440112,
					"content": "嗯，白夜国崇尚大日御舆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440113,
					"content": "每隔数年，便有出世孩童被擢选为太阳之子，执掌国家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440114,
					"content": "太阳之子…一共有七位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440115,
					"content": "在白夜国很难遇到异乡的旅客，拜托了，请去他们墓冢之前凭吊一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440116,
					"content": "咦，可是，为什么要让我们这些外来者去凭吊呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440117,
					"content": "一般来说，不是熟人去凭吊比较好吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440118,
					"content": "按常理而言，确是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440119,
					"content": "唉，只是，白夜之国的居民应该无人会想要凭吊他们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440120,
					"content": "甚至，那些墓上的御陵墓石也久未祭拜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440121,
					"content": "可是…这是为什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440122,
					"content": "难道这个国家的国民，都不喜欢那些太阳之子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440123,
					"content": "与其说是不喜欢…不如说是痛恨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440124,
					"content": "刚才说过，太阳之子是刚出生就成为太阳之子的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440125,
					"content": "这样的孩子又怎么会治理国家，真正把持国度的是太阳之子背后的大人们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440126,
					"content": "太阳之子只是听凭他们摆布的傀儡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440127,
					"content": "只不过…那些大人们贪得无厌，收刮民脂，操纵太阳之子做过许多残忍之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440128,
					"content": "由是，民怨愤起，将许多过错归咎于太阳之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440129,
					"content": "怎么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440130,
					"content": "明明太阳之子是无辜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722440131,
					"content": "…不，他们并不无辜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440132,
					"content": "对于白夜国民而言，他们、太阳之子的无知就是最大的过错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440133,
					"content": "人因无知而犯下的罪，确实伤害到了他人，这人真的能被称为是无辜的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440134,
					"content": "恐怕很难吧，皆因造成的伤害已无法挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440135,
					"content": "既然这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "这算是…妾身的私情之托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440138,
					"content": "妾身名为久利由卖，是大日御舆内，负责照顾太阳之子起居的女官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440139,
					"content": "虽然知道他们所行是错误的，知道他们处处被人操控…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440140,
					"content": "可毕竟是妾身看着长大的孩子，妾身对他们，可怜有之，悲哀有之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440141,
					"content": "却唯独…无法恨他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440142,
					"content": "况且，虽然由于妾身的职务，能日日与太阳之子接触，却囿于周围严苛的监视…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440143,
					"content": "在他们身边时，不被允许开口说出任何一句言辞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440144,
					"content": "那些孩子，在四下无人，彷徨无助之时。他们向妾身说了那么多、那么多话语……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440145,
					"content": "妾身却无法作出任何回应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440146,
					"content": "如果，如果妾身那时能够提起舍生的勇气，对他们说些什么的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440147,
					"content": "或许…一切都会有所不同吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440148,
					"content": "拜托了，时至今日，妾身已无颜面对他们，只得在此作些祭拜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440149,
					"content": "凭吊之事，还请旅者大人帮妾身一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440150,
					"content": "只需要，在他们的墓前…放下一枚「珊瑚真珠」即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440153,
					"content": "这样，就能点燃此处石龛上的魂灯，打开前往引魂之处的道路，为他们祈求安魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440151,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "多谢，那就…麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722440136,
					"content": "为什么还要凭吊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
