			"dialogs": [
				{
					"id": 722441101,
					"content": "#一二三……唔，{NICKNAME}，好像已经完成七座墓石的凭吊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722441102,
					"content": "我们回到石头神龛那边，告诉等待在石龛边上的那个残魂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久利由卖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "啊啊…比螺梦门，你喜欢读书，常言有天外之地，那时妾身并不相信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441202,
					"content": "对你的绮言狂想，每每都只是笑着摇头。妾身该相信你的呀，该相信你的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441203,
					"content": "你说，如有机会，一定要逃出大日御舆，去天外之地冒险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441204,
					"content": "比螺梦门，现在已不再有人会束缚你了，去吧，去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441205,
					"content": "还有，御琉部栖，御琉部栖，妾身好想再听你歌上一曲啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441206,
					"content": "听到你唱歌，听到你那样纯净清澈的歌喉，有谁不悄悄在内心里跟你一起唱呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441207,
					"content": "归日之祭前夜，你突然想听妾身的声音，无论如何都想让妾身开口唱给你听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441208,
					"content": "说没有关系，不管唱多难听，你都不会笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441209,
					"content": "你那个时候是不是已经知道…已经知道归日之祭其实正是自己的终期？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441210,
					"content": "呜…可是妾身到最后也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441211,
					"content": "久利由卖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "啊啊，不好意思，旅者，妾身失态了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441213,
					"content": "侍奉太阳之子的女官，为保自身的洁净无瑕…终生不可嫁予他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441214,
					"content": "所以妾身一生都没有自己的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441215,
					"content": "这些孩子，这些由妾身侍奉，看着长大的孩子，不知何时已变得比血脉还要亲近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441216,
					"content": "多谢你，旅者，多谢你找回了御辔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441217,
					"content": "这御辔经由每位太阳之子之手，其上承载的记忆足以补全残缺魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441218,
					"content": "即使，这些记忆也是双面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441219,
					"content": "双面的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "自然，记忆分为两类，一类是自身之记忆，一类是他人对自身的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441222,
					"content": "补全他们存在的，既有御辔之上，太阳之子自身的记忆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441223,
					"content": "也有御辔作为被白夜国怪罪的孩童们的象征，承载的身为罪孽之子的记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441224,
					"content": "妾身的记忆，并不足以补全他们的魂魄，便只能靠白夜之国诸民的记忆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441225,
					"content": "这些孩童们，应这些归咎于他们身上的罪孽，才重新被白夜国记起，留下残影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441226,
					"content": "多谢你了，旅者…妾身大愿已了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441227,
					"content": "也终于能…稍微…安心一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441228,
					"content": "终于能…再和那些孩子们一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "久利由卖"
				},
				{
					"id": 722441220,
					"content": "记忆也有面向吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
