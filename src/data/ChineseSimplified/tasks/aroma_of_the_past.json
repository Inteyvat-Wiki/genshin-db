			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"诺艾尔",
					"砂糖",
					"雷泽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800201,
					"content": "也不知道雷泽那边，「补课」的进展是不是顺利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800202,
					"content": "砂糖小姐，请等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800203
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800203,
					"content": "#{NICKNAME}前辈，派蒙，请帮我拦住她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800204
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800204,
					"content": "哇，吓我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800205,
					"content": "你们两个，怎么慌慌张张的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800206,
					"content": "是这样的，我和砂糖小姐说好要一起把酿酒材料交给你们，可她一听说雷泽也要来，说什么都不肯留在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800207
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800207,
					"content": "我…我不擅长和陌生人打交道，只要材料能平安送到就可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800208
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800208,
					"content": "这怎么行呢！既然是我们两人合作完成的，就应该一起出面。我不能抢了砂糖小姐的功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800209
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800209,
					"content": "不是…功劳什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800210
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800210,
					"content": "这么看来，骑士团准备的材料是「生物炼金」的产物咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800211,
					"content": "对，是「四倍甜日落果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800212
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800212,
					"content": "四倍甜？普通的甜度还不够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800213,
					"content": "而且…为什么是日落果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800214,
					"content": "嗯，这就要从头说起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800215
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800215,
					"content": "我很喜欢闻酒的味道，对酿酒这件事情，也学习和总结过一些经验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800216
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800216,
					"content": "从结论来说，原材料的甜味是必不可少的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800217
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800217,
					"content": "为了选出最合适的那一种，我找来了蒙德周边所有含有甜味的植物和果实，逐一试吃并记录了一份完整的清单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800218
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800218,
					"content": "不同地点的同种素材也纳入了考量，比如清泉镇附近的甜甜花会比誓言岬的更甜一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800219
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800219,
					"content": "哇，听上去工作量好大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800220,
					"content": "没关系，这就是我身为「骑士团女仆」应该做的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800221
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800221,
					"content": "能够代表骑士团，找到「守护的执着」，对我来说也是无上的荣幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800222
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800222,
					"content": "诺艾尔的眼睛，在发光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800223,
					"content": "但我觉得，她是被丽莎小姐给…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800224,
					"content": "派蒙，嘘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800225
					]
				},
				{
					"id": 400800225,
					"content": "啊，说回正题。只有我独自进行评测的话，我会担心陷入主观。那天正好遇到了从实验室里出来的砂糖小姐，就问了问她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800226
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800226,
					"content": "啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800227
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800227,
					"content": "怎么了，砂糖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800228
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800228,
					"content": "我突然想起来…我出门是为了去领最近进口的一批实验器材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800229
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800229,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800230
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800230,
					"content": "看你们的脸色…该不会是把这事情忘记了，一直在实验室里待到今天吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800231,
					"content": "嗯，是的…对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800232
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800232,
					"content": "唉，别在意，我也有责任。器材我晚些再去找玛乔丽小姐吧。诺艾尔，你先继续说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800233
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800233,
					"content": "是，是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800234
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800234,
					"content": "砂糖小姐不愧是专业的研究员！对我的清单提出了宝贵的建议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800235
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800235,
					"content": "就不用特意夸我了啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800236
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800236,
					"content": "在那之后，诺艾尔也告诉了我事情的经过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800237
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800237,
					"content": "她明明不认识那位名叫雷泽的少年，却做得那么认真…让我很感动。但在我看来，现有材料都不足以达到「完美」这一要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800238
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800238,
					"content": "我们需要的是一种含糖量高又便于发酵的水果，最后，我从清单里选择了果酒湖周围采集的日落果样本作为基础，将它改良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800239
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800239,
					"content": "通过「生物炼金」放大甜味的特征，再加以实验对照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800240
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800240,
					"content": "一旦开始做实验，砂糖小姐的毅力就令我自愧不如！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800241
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800241,
					"content": "啊，都说了请不要夸奖我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800242
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800242,
					"content": "总之…「伍式日落果改陆叁号四倍甜度版」，终于研发成功了，甜度经过严格测量，色泽和饱满度也是一流的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800243
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800243,
					"content": "诺艾尔把它简称为「四倍甜日落果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800244
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800244,
					"content": "可惜现在的条件还不支持大规模量产…这次能帮上雷泽就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800245,
						400800246
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800245,
					"content": "一定可以的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800248
					]
				},
				{
					"id": 400800248,
					"content": "#{NICKNAME}，我还有一些话想说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800249
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800249,
					"content": "从小到大…我都生活得很幸福。虽然一直不太擅长跟人打交道，但父母从没对我提过要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800250
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800250,
					"content": "他们从没对我说过「你应该表现得更开朗一点」，只是告诉我「做自己喜欢的事就好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800251
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800251,
					"content": "我知道…我是幸运的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800252
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800252,
					"content": "雷泽的生活，我从未经历过，也无从想象。贸然说这些话只会是冒犯。但我真心希望他能过得快乐，能去做自己想做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800253
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 400800253,
					"content": "砂糖小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800254
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800254,
					"content": "「咔嗒——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800255
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800255,
					"content": "对不起，我又来晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800256
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800256,
					"content": "师父，忘记看时间，一直，在说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800257
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800257,
					"content": "没事哦，我们刚好也在聊天呢。欸，总感觉这两天说过一模一样的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800258,
					"content": "（咦，等等，砂糖怎么不见了？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800259,
					"content": "（竟然趁他推门出来的时机跑掉了？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800260
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800260,
					"content": "你好！我是西风骑士团的女仆诺艾尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800261
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800261,
					"content": "你好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800262
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800262,
					"content": "这份材料请你收下。这并不是我一个人准备的！另一位炼金术士，她现在…那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800263
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800263,
					"content": "她工作有点忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800264
					]
				},
				{
					"id": 400800264,
					"content": "啊，对…很遗憾，不能亲手交给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800265
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800265,
					"content": "药剂，花蜜，还有风晶蝶一样的味道…对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800266
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800266,
					"content": "哇，果然瞒不过雷泽的嗅觉呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800267,
					"content": "日落果，比之前闻到过的，都甜。可莉说过，炼金术，超级厉害，能让东西变好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800268
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800268,
					"content": "嗯！希望这种甜蜜的果子，能为你们酿出最甜最好的酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800269,
						400800270
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800269,
					"content": "那位女孩子还想说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800271
					]
				},
				{
					"id": 400800271,
					"content": "…谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800272
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800272,
					"content": "下次，等她，有空，想当面说谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800273
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800273,
					"content": "交给我吧！我来想办法说服她…说服她不要每天都这么忙，然后就把她介绍给你认识！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800274
					],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800274,
					"content": "好，我会等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800275
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800275,
					"content": "嗯，这下材料也收齐了，终于可以酿酒啦。酒桶的话，我记得放在「天使的馈赠」摊位那边了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800276
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800276,
					"content": "诺艾尔，那我们就先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800277
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800277,
					"content": "再见，祝你们一切顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诺艾尔"
				},
				{
					"id": 400800270,
					"content": "「做自己喜欢的事就好。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800271
					]
				},
				{
					"id": 400800246,
					"content": "我能先尝一口吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800247
					]
				},
				{
					"id": 400800247,
					"content": "喂！你怎么回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800248
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008003,
			"completionStepIds": [
				4008003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008003",
							"2"
						],
						"stepId": 4008003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可莉",
					"迪奥娜",
					"雷泽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800301,
					"content": "#荣誉骑士{M#哥哥}{F#姐姐}，雷泽，这里这里！你们看看谁来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800302
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800302,
					"content": "哇，这不是迪奥娜吗？我还以为你会来猫尾酒馆的摊位，结果好几天都没看见你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800303,
					"content": "呜…不可原谅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800304
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800304,
					"content": "欸？欸——你怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800305,
					"content": "唔呃呃呃呃呃——气死我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800306
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800306,
					"content": "可莉都告诉我了，都是你们两个干的好事，竟然让雷泽…让爸爸的朋友，可靠的好人！也对酒产生了兴趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800307
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800307,
					"content": "雷泽，你绝对不可以变成趴在酒桌上哇哇大哭的臭大叔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800308
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800308,
					"content": "我，呃…不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800309
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800309,
					"content": "听起来像是有什么误会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800310,
					"content": "小可莉，你到底是怎么说的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800311,
					"content": "#唔…我和迪奥娜姐姐说，雷泽要找妈妈，荣誉骑士{M#哥哥}{F#姐姐}在帮他，他们很难过，他们需要酒，所以想要你帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800312
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800312,
					"content": "还没说完，迪奥娜姐姐就回答：「可莉，你不用再说了，这件事我一定要管。」然后，我们就一起过来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800313
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800313,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800314
					]
				},
				{
					"id": 400800314,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800315
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800315,
					"content": "好…好吧，我都不知道该怎么接话了。迪奥娜，关于这件事，传达环节出现了一点问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800316,
					"content": "向迪奥娜讲述了来龙去脉…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800317
					]
				},
				{
					"id": 400800317,
					"content": "你们的意思是说，雷泽是想通过制作父母从前酿造的酒，来了解他们的过去…不是刚编了一个说辞在骗我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800318,
						400800319
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800318,
					"content": "没有没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800320
					]
				},
				{
					"id": 400800320,
					"content": "迪奥娜姐姐对不起，是可莉不好，没有说清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800321
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800321,
					"content": "你可不可以不要生气，帮帮雷泽做酒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800322
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800322,
					"content": "我抓好多鱼跟你一起吃，喏，嘟嘟可也给你摸摸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800323
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800323,
					"content": "我…我才没有多生气呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800324
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800324,
					"content": "可莉是想帮忙做好事，我明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800325
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800325,
					"content": "我刚才是因为不想雷泽被带坏，才不小心把声音抬高了一点点…既然不是要自己喝，那就勉为其难地帮你们一下好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800326
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800326,
					"content": "但有些事先说好，我平时调制的都是酿好的酒。现在突然要从混合原料开始制作，我也不知道会变成怎么样哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800327
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800327,
					"content": "太好啦！迪奥娜姐姐是大好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800328
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800328,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800329,
						400800330
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800329,
					"content": "有迪奥娜出手，事半功倍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800331
					]
				},
				{
					"id": 400800331,
					"content": "哼，你们就会说好听的。看我的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800332
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800332,
					"content": "迪奥娜亮出她享誉蒙德的招牌调酒师手势，往酒桶里捣鼓了几下…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800333
					]
				},
				{
					"id": 400800333,
					"content": "搞定了，真不费力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800334,
					"content": "接下来，就得把它找个地方储存起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800335,
					"content": "「等啊，等啊，等着风起涌。」…唔，是要放在有风的地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800336,
					"content": "风起地，可以吗？风很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800337
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800337,
					"content": "嗯！在蒙德只要说起风，第一时间想到的就是那里呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800338,
					"content": "好呀好呀，可莉也要一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800339
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800339,
					"content": "我还要监督我那个笨蛋老爹，就不跟过去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800340
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800340,
					"content": "可莉，下次再一起玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800341
					],
					"speakerTitle": "迪奥娜"
				},
				{
					"id": 400800341,
					"content": "好哦，约好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800330,
					"content": "加油啊，迪奥娜！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800331
					]
				},
				{
					"id": 400800319,
					"content": "绝对没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800320
					]
				}
			]
		},
		{
