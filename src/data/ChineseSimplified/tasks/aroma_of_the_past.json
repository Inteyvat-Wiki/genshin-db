	"talks": [
		{
			"id": 4008002,
			"completionStepIds": [
				4008002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
