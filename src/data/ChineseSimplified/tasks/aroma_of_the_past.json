			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800401,
					"content": "好巧好巧，你们也来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800402
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800402,
					"content": "卖唱的，你怎么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800403,
					"content": "我一觉醒来，空中飘来一阵特别好闻的味道。顺着果子的甜味一路走，就到这里了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800404
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800404,
					"content": "对的，果子好甜，可莉也闻得到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800405
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800405,
					"content": "还有别的原因吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800406
					]
				},
				{
					"id": 400800406,
					"content": "嗯，因为我想起了一件重要的事。在你们封上木桶、把酒埋进泥土之前，还需要再做一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800407,
					"content": "欸！还缺什么东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800408
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800408,
					"content": "雷泽，还记得那半瓶「千风佳酿」的味道吧？里面是不是有一点苦味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800409
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800409,
					"content": "嗯，有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800410
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800410,
					"content": "啊哈哈，那种苦味大有来头，就是…这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800411
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800411,
					"content": "蒲公英籽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800412,
					"content": "你们知道蒲公英酒吧。在蒙德人心中，风能够带回灵魂，也可以保存记忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800413
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800413,
					"content": "蒲公英籽就像自然的宝石，汇聚着每年第一缕风。人们把它放进酒桶，就是把当下的风放了进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800414
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800414,
					"content": "美酒因而保留下此刻的记忆，直到永远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800415
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800415,
					"content": "所以，「千风佳酿」就是最初的「蒲公英酒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800416
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800416,
					"content": "喔——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800417,
					"content": "好厉害——我们的事情被酒记下来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800418
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800418,
					"content": "至于为什么没有固定的味道嘛，因为放进去的材料完全自由，欸嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800419
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800419,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800420
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800420,
					"content": "怎么了，雷泽，你在想什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800421
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800421,
					"content": "爸爸妈妈的酒里，蒲公英籽以外，不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800422
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800422,
					"content": "我的酒里，有很多，朋友的情感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800423
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800423,
					"content": "爸爸妈妈，还是不明白。但…有大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800424
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800424,
					"content": "大家，很努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800425
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800425,
					"content": "法尔伽，师父，可莉，班尼特，棕色猫叔叔，冷冷的姐姐，装笑的大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800426
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800426,
					"content": "灰灰硬硬的女孩子，风晶蝶味道的人，猫叔叔的女儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800427
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800427,
					"content": "#绿诗人，派蒙，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800428
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800428,
					"content": "每个人，都记着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800429
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800429,
					"content": "酒，做起来，很难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800430
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800430,
					"content": "没有大家…不会有，今天的酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800431
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800431,
					"content": "和朋友一起，困难，不是困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800432
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800432,
					"content": "我…很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800433,
						400800434
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800433,
					"content": "能够帮上雷泽…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800435
					]
				},
				{
					"id": 400800435,
					"content": "嗯，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800436
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800436,
					"content": "朋友…也是「卢皮卡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800437
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800437,
					"content": "未来，大家一起。我是人，我是狼…都没有关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800438
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800438,
					"content": "长大…再一起来开，这桶酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800439
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800439,
					"content": "精彩的发言。我这个吟游诗人，已经没有什么想补充的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800440
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800440,
					"content": "接下来就把酒埋好，慢慢等待它变得甘醇吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800441
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800441,
					"content": "大家一起把酒桶埋进了土里…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800442
					]
				},
				{
					"id": 400800442,
					"content": "终于完工啦，我也想好好庆祝一下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800443,
					"content": "没记错的话，明天就是「归风日」对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800444,
					"content": "哇！风神大人要回来啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800445
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800445,
					"content": "啊哈哈，提醒我了。歌谣还没有背完，我得回去准备举杯仪式。各位朋友，明天再见喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800446
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800446,
					"content": "今晚好好睡一觉，明天早晨记得迎着清风叫醒你们的耳朵，然后，来听最好的吟游诗人演出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800434,
					"content": "所有人都很开心哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800435
					]
				}
			]
		},
		{
			"id": 4008006,
			"completionStepIds": [
				4008006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008006",
							"2"
						],
						"stepId": 4008006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽莎",
					"温迪",
					"琴",
					"雷泽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800601,
					"content": "好多人啊，大家都来迎接风神了呢。咦，怎么都围在「天使的馈赠」摊位前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800602,
					"content": "按照惯例，佳酿节上品质最好的酒，要等到举杯仪式献给风神大人品尝过之后才能开售，大家都在排队等着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800603
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 400800603,
					"content": "哼，对这些家伙来说，迎接风神只是个过场吧。丽莎小姐，你是来看雷泽的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800604,
					"content": "嗯，之前还有些不放心，刚才和雷泽聊过几句，听说你们的酿酒之旅还算顺利。今天我也能安心喝一杯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800605
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 400800605,
					"content": "哇…你也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800606,
					"content": "呵呵，雷泽他们已经在那边了，赶快过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800607
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 400800607,
					"content": "呦，你们来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800608
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800608,
					"content": "哇，这么多酒瓶是怎么回事？如果不知道，还以为你们也摆了个卖酒的摊位呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800609,
					"content": "哈哈哈，这些都是我们帮雷泽准备的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800610
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800610,
					"content": "妈妈说过，今天大家要迎接风神大人，要请他喝酒。如果风神大人高兴，就会变成风来祝福大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800611
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800611,
					"content": "#我们想让风神大人高兴，让他帮帮雷泽。荣誉骑士{M#哥哥}{F#姐姐}你看，这是阿贝多哥哥借给我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800612
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800612,
					"content": "这瓶是我的老爹们给的，还好没在路上摔了…也就装装样子，用完得给他们带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800613
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800613,
					"content": "妈妈说，风神大人的酒量特别大，只要他想，一口气能把果酒湖喝干！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800614
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800614,
					"content": "这些，再加上雷泽爸爸妈妈留下的酒…够不够呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800615
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800615,
					"content": "啊，绿诗人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800616
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800616,
					"content": "咳咳，各位，非常荣幸来到这里。今天我受西风骑士团代理团长琴小姐邀请，为大家弹奏一曲——「千风佳酿」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800617
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800617,
					"content": "我会把最好的歌谣献给风，也献给在场的你们——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800618
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800618,
					"content": "「我们把这些东西封进桶，\\n等啊，等啊，等着风起涌。\\n把佳酿的瓶口先蜡上，\\n南风和煦，北风猛。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800619
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800619,
					"content": "「佳酿味道像什么？\\n蒙德的名字，自由的梦。\\n究竟是什么发酵成佳酿？\\n探索的勇气，慈爱的温柔。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800620
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800620,
					"content": "「守护的执着一如初，\\n伴着千风起祝颂，\\n酸汁变甜，糙桶润透，\\n等啊，等啊，等着风起涌。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800621
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800621,
					"content": "「酒桶里面放了啥？\\n小麦的金黄，潜荟葱茏。\\n佳酿出桶，飘来了什么？\\n风铃的声音，万古的长空。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800622
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800622,
					"content": "「我们伴着这些美酒唱起歌，\\n等啊，等啊，等着风起咏。\\n千风带走了什么下酒？\\n琴弦上的故事，今夜的美梦。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800623
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 400800623,
					"content": "朋友们，让我们共同开启美酒——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800624
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400800624,
					"content": "敬献风神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800628
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800628,
					"content": "敬献风神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800629
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800629,
					"content": "敬献风神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800630
					]
				},
				{
					"id": 400800630,
					"content": "欸…没有风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800631
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800631,
					"content": "可莉，别难过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800632
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800632,
					"content": "怎么会这样，雷泽，风神大人没有回来，是不是他不喜欢我们准备的酒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800633
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800633,
					"content": "应该不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800634
					]
				},
				{
					"id": 400800634,
					"content": "才不会呢！小可莉知道吗？风神大人不仅会变成风，也会变成其他样子，所以今年他一定是变成其他样子回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800635,
					"content": "唔？是吗？变成…变成蹦蹦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800636
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800636,
					"content": "好，就变成蹦蹦！听见了吗风神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800637,
					"content": "嘿嘿…雷泽，风神大人给你带来祝福了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800638
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800638,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800639
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800639,
					"content": "跟你们一起，说很多，学会了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800640
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800640,
					"content": "现在，不会害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800641
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800641,
					"content": "这个…就是祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800642
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800642,
					"content": "别忘了，将来等你的酒酿成之后，我也要来喝一口哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800643,
						400800644
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800643,
					"content": "也有我的份吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				},
				{
					"id": 400800645,
					"content": "嗯，一起分享，一起，回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800646
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800646,
					"content": "嗯嗯！不过…可莉口渴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800647
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800647,
					"content": "光顾着说话了，我们去喝饮料吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800648
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400800648,
					"content": "我听说「天使的馈赠」摊位上新开卖的「假日果酿」，可好喝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800649
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400800649,
					"content": "我要喝我要喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800650
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400800650,
					"content": "嗯，大家，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷泽"
				},
				{
					"id": 400800644,
					"content": "会回忆起现在吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				}
			]
