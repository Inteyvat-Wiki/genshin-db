			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲娅",
					"扎哈尔",
					"叶夫卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790240101,
					"content": "雅科夫，雅科夫，刚才的就是你平时最喜欢听的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240102
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240102,
					"content": "怎么样，雅科夫醒过来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240103
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240103,
					"content": "不行，阿加霞，还是什么反应都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240104
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790240104,
					"content": "每次我唱这首歌的时候，尤其是唱到「仲夏已逝，万花凋谢。你必将远行，而我却习惯等待。」这句的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240105
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240105,
					"content": "每次我唱到这里，他总是会眼睛变得湿润地看着我呀…怎么会一点反应都没有呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240106
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240106,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240107
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240107,
					"content": "我给他做了他最喜欢喝的汤，味道香得我自己口水都要流出来了，可是他还是没醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240108
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790240108,
					"content": "阿加霞，我明白了！其实雅科夫最想要的就是他父亲能够回来，要不我就假扮成他的父亲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240109
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790240109,
					"content": "闭嘴，我现在不想跟你说话！我当时就不该让雅科夫和你一队的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240110
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240110,
					"content": "阿加霞，这不是因为我，你知道的，都是因为那个实验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240111
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790240111,
					"content": "雅科夫，可怜的雅科夫啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240112
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240112,
					"content": "怎么了，雅科夫还是什么反应都没有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240113,
					"content": "是你们啊…唉，正如你们所见，雅科夫还是一点反应都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240114
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240114,
					"content": "这该如何是好啊，如果他这样浑浑噩噩的，就算回到了至冬，恐怕也会被愚人众除名…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240115,
						790240116
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240115,
					"content": "被愚人众除名不好吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240117
					]
				},
				{
					"id": 790240117,
					"content": "可是，可是雅科夫现在孤身一人…我们都时常外出执行任务，没人能够照顾他…如果被愚人众除名，他这样还怎么活下去呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240118
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240118,
					"content": "#对了，{NICKNAME}，你…你肯定解决过很多这样的事了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240119
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240119,
					"content": "拜托了，拜托了，找到让雅科夫恢复的办法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240120
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240120,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240121,
					"content": "你们不是想要情报吗，我们会拿机密的情报跟你们交换的，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240122
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240122,
					"content": "对，比如「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240123
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790240123,
					"content": "扎哈尔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240124
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240124,
					"content": "对不起…我只记得这个了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240125
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790240125,
					"content": "我们只是些负责跑腿的，哪有什么机密情报…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240126
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790240126,
					"content": "叶夫卡，你不说话没人把你当哑巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240127
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240127,
					"content": "#唉…{NICKNAME}，你怎么看呢，「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」这条情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240128,
						790240129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240128,
					"content": "多少也是情报…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240130
					]
				},
				{
					"id": 790240130,
					"content": "好吧，就看在这条情报的价值上，就帮你们这个忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240131,
					"content": "那真是感激不尽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240132
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240132,
					"content": "不过说是这么说…到底怎么样才能唤醒雅科夫呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240133,
					"content": "#他们之前好像一直在这个营地里…{NICKNAME}，不如我们先一起去营地里找找线索吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240129,
					"content": "勉勉强强吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240130
					]
				},
				{
					"id": 790240116,
					"content": "听上去倒是件好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240117
					]
				}
			]
		},
		{
			"id": 7902402,
