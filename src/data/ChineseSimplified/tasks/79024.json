				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿加菲娅",
					"叶夫卡",
					"扎哈尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790240201,
					"content": "怎么样，有什么发现了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240202
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240202,
					"content": "虽然也说不上是有线索，不过也是一种可能呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240203,
					"content": "向三位愚人众小队成员说明了海螺的作用…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790240204
					]
				},
				{
					"id": 790240204,
					"content": "啊，没想到被那个奇怪装置影响到的海螺还会有这样的效果啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240205
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240205,
					"content": "你说的那个画面，应该是我带着害怕被训斥的雅科夫，找叶夫卡的画面吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240206
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240206,
					"content": "对，你这么一说，我也有点印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240207
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790240207,
					"content": "不过，那也是很长一段时间之前，更何况，受到了那台巨大装置的影响，呜…在营地里时的记忆也变得很模糊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240208
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240208,
					"content": "但是，这里的海螺本来应该有四个，应该<color=#00E1FFFF>还有其他三个</color>的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240209
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240209,
					"content": "其他的记忆很模糊，但是海螺有四个却记得很清楚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240210,
					"content": "在营地休整的时候，我们发现忘带盛汤的容器了，所以就临时用了那个海螺装做好的汤。所以，那个海螺是我们一人一个的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240211
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240211,
					"content": "嗯，不过出发之前，雅科夫就把汤喝完，留在箱子上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240212
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790240212,
					"content": "其他的我们一人一个，全都带走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240213,
						790240214
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790240213,
					"content": "那，海螺呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240215
					]
				},
				{
					"id": 790240215,
					"content": "唔…当时只觉得是一些普通的海螺，所以喝完汤之后就扔掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240216
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240216,
					"content": "我想想，那个时候才刚上<color=#00E1FFFF>西北方向的大岛</color>，就把汤喝完，海螺，海螺被我顺手丢在岛上一个全是水的山洞里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240217
					],
					"speakerTitle": "阿加菲娅"
				},
				{
					"id": 790240217,
					"content": "我，我好像扔在<color=#00E1FFFF>南方的大岛</color>遗迹边的山上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240218
					],
					"speakerTitle": "叶夫卡"
				},
				{
					"id": 790240218,
					"content": "嘿嘿，我的扔进了<color=#00E1FFFF>东北方向大岛</color>的井里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240219
					],
					"speakerTitle": "扎哈尔"
				},
				{
					"id": 790240219,
					"content": "哇，根本就丢得到处都是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240220,
					"content": "西北方向的岛，应该是辛焱的幻境所在的岛，也就是破破岛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240221,
					"content": "南方向的大岛，就应该是危危岛…东北方向的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240222,
					"content": "就是双双岛吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240223
					]
				},
				{
					"id": 790240223,
					"content": "丢在了这三个岛上呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240224,
					"content": "看来得找到这三个海螺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240225
					]
				},
				{
					"id": 790240225,
					"content": "嗯，如果找到了这三个海螺，说不定就能找到能让雅科夫醒过来的线索了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790240214,
					"content": "海螺现在在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240215
					]
				}
			]
		},
