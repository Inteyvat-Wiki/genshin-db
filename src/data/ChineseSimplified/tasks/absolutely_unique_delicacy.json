				"objectNames": [
					"秋月"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250301,
					"content": "什么事？欸…汤雯小姐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250307,
					"content": "满嘴怪味，没有食欲，吃不下饭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250302,
					"content": "真的是吃了不好的奇怪食物吗？没搞错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250303,
					"content": "怎么听起来感觉更像是吃撑了不消化呢。唔，让我想想...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250304,
					"content": "算了，既然没法判断的话，就只有一道菜可以推荐了，那就是——腌笃鲜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250305,
					"content": "口味咸鲜，肉质酥嫩，爽口开胃，最后还有一锅老汤帮助消食。嗯！真想现在就来一点啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250306,
					"content": "相信我，汤雯现在需要的就是腌笃鲜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋月"
				}
			]
		},
		{
			"id": 2202504,
			"completionStepIds": [
