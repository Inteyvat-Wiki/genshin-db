			},
			"dialogs": [
				{
					"id": 220250401,
					"content": "呜哇，得到了不同的答案呢，绝云锅巴和腌笃鲜，都是很特别的美味呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250402,
					"content": "到底该做什么才好呢？好纠结！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250403,
					"content": "派蒙觉得应该做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "欸？我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250405,
					"content": "这样的话...让我选的话…让我选的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250406,
					"content": "我选烤吃虎鱼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250407,
					"content": "烤吃虎鱼一听很有勇气的样子，如果汤雯小姐吃掉这种勇气，一定能顺利解决现在的麻烦吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250408,
					"content": "派蒙对吃还是很精通啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "哎呀，所以说还是你来决定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250411,
					"content": "那就…美味的绝云锅巴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "好嘞，那我们就赶紧做好这份美食，给汤雯小姐送去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250412,
					"content": "那就…美味的腌笃鲜！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
					"content": "那就…美味的烤吃虎鱼！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250409,
					"content": "吃虎鱼不是这么个说法吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				}
			]
		},
