				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李晓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "什么事？啊…你说汤雯小姐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "李晓"
				},
				{
					"id": 220250207,
					"content": "食欲不振...满嘴都是怪味...需要特别的美食才能拯救？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "李晓"
				},
				{
					"id": 220250202,
					"content": "居然遇到了这样的困难…确实有些棘手啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "李晓"
				},
				{
					"id": 220250203,
					"content": "不过依我看，倒不一定要特别名贵的菜，只要口感和风味独树一帜，再加上一些些的冲击力就足够了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "李晓"
				},
				{
					"id": 220250204,
					"content": "所以我的建议是——绝云锅巴！既有独特的劲脆口感，又有猛烈的香辣力道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "李晓"
				},
				{
					"id": 220250205,
					"content": "从当年在轻策庄第一次尝到绝云锅巴，已经过去十几年了，到现在我还时常想起它...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "李晓"
				},
				{
					"id": 220250206,
					"content": "我想如果是绝云锅巴的话，无论什么问题都会迎刃而解的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李晓"
				}
			]
		},
		{
			"id": 2202503,
			"completionStepIds": [
				2202503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
