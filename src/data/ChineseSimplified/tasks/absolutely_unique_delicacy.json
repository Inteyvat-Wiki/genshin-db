			"trigger": {
				"objectNames": [
					"汤雯",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "啊...好饿...好难受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250102,
					"content": "发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "我、我也不太清楚…总之就是整个人都不太精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250104,
					"content": "大概就是昨天晚上，我把你做的那份美食带回家好好品尝了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250105,
					"content": "虽然那道菜的口味确实是…「另辟蹊径」了些，但多少还是能填饱肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250106,
					"content": "之后我就打算睡个好觉，今天好好工作，结果…结果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250107,
					"content": "每次我要睡着的时候，那道菜的微妙气味就突然从胃里反上来！搞得我瞬间就清醒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250108,
					"content": "然后就是这样的循环，一直半睡半醒地折腾到天亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250109,
					"content": "如果光是睡少一些，倒还不是什么大事，之前偶尔也会遇到加班加点的情况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250110,
					"content": "关键是今天！本以为起来后，吃点东西就没事了，可没想到一吃东西，居然满嘴都还是那道菜的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250111,
					"content": "那道菜有这么大威力吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "唉，不管怎么样，我现在感觉…应该只有口味独特的美食，才能冲刷掉那股奇怪的气息了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250113,
					"content": "口味独特的美食？不如我们去问问其他人，什么才是口味独特的美食吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250114,
					"content": "然后再给汤雯小姐做一份…说不定就能解决她的困扰了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220250115,
					"content": "真的吗？真是太好了，实在感谢你们！如果、如果方便的话，请去离岛问问…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "汤雯"
				},
				{
					"id": 220250116,
					"content": "我记得…离岛的商人李晓对美食就很有研究，还有楚瑜商行的秋月，她也算是半个美食家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "汤雯"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202502",
							"2"
						],
						"stepId": 2202502,
						"stateName": "QUEST_STATE_UNFINISHED"
