					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "还真是…不可思议哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140102,
					"content": "雕像雕好了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "那个石头，一开始的时候，一点也不像奴家。但是，每次看到，都变得更像了一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140104,
					"content": "汝等人类真是不可思议呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140105,
					"content": "虽然很吵，但是奴家是代宫司大人，所以不会在意这种小事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140106,
					"content": "汝等帮奴家把这些鱼带过去给那个高高的人类吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140107,
					"content": "这是好东西。就当做给他的…「抱愁」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140108,
					"content": "只有鱼吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "唔喵，奴家也让「昆布丸」带着那群孩子们试着抓抓团雀什么的，但总是抓不到太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140110,
					"content": "对那群孩子来说，还是抓鱼比较简单呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140111,
					"content": "是「报酬」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "喵喵喵，好烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140113,
					"content": "快去交给他吧。这可是好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "总算是有点样子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140202,
					"content": "哈哈，是你们啊，快看看这雕像，是不是有点代宫司大人的模样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140203,
					"content": "确实有点模样了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "对吧？哈哈哈，不枉我连续好几天熬夜工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140207,
					"content": "哎呀，肚子也饿了…我得自己再去找点吃的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140208,
					"content": "这是寝子给你的鱼肉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "唔…呃，谢谢代宫司大人的好意，但我还是…我还是自己去找吃的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140210,
					"content": "我已经连续吃了好几天鱼肉了，实在是受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140211,
					"content": "我只能每天出去自己找吃的，运气好的时候能打到点团雀或者鸽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140212,
					"content": "唉，但是我还是想吃点兽肉啊，那种紧致的，多汁的兽肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140213,
					"content": "呃…旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140214,
					"content": "如果你们愿意的话，能请你帮我去找三份…兽肉来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140215,
					"content": "我对捕猎实在是不在行，这么多天了也没弄到一份兽肉…只能拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140216,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "那就拜托你们了，只要三份兽肉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140217,
					"content": "你为什么不回鸣神岛吃一顿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "一方面是太远了，另一方面…我雕刻的手感正好，要是去鸣神岛的话…这一来一回的，手感说不定就没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140219,
					"content": "我还是就在这里迅速吃一顿，然后继续回去雕刻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140205,
					"content": "雕像比寝子大很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "那是当然啦，虽然代宫司大人比一般的猫也大很多…但是想要有气势的话，雕像的尺寸还得再进一步放大，毕竟是摆在神社里的雕像嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "大岛纯平"
				}
			]
		},
		{
			"id": 7221403,
