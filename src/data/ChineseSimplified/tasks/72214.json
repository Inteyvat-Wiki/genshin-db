			},
			"dialogs": [
				{
					"id": 722140301,
					"content": "怎么样，你们拿到兽肉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				}
			]
		},
		{
			"id": 7221404,
			"completionStepIds": [
				7221403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大岛纯平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "喔！这兽肉的品质…太感谢你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140402,
					"content": "我等会就去好好做几道好菜！吃了这些肉，我肯定能雕得更快一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140403,
					"content": "这两件事之间有关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "吃了好肉，就有力气干活了嘛！之前总是吃鱼，我都感觉提锤子的手没什么力气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140405,
					"content": "我还在担心，一直这样的话，说不定整个雕像的工期都会延长…还好你帮我找了这些肉过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140406,
					"content": "毕竟是为人…呃，为猫工作嘛，延期这种事，能避免最好还是避免吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140407,
					"content": "总之，我会尽快做好这尊雕像的，代宫司大人说，那尊雕像做好了之后，一定会有什么好事发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140408,
					"content": "虽然不知道是什么好事，不过…嘿嘿，我还是挺期待的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "大岛纯平"
				},
				{
					"id": 722140409,
					"content": "过段时间，你们也要来神社看看我的作品啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大岛纯平"
				}
			]
		}
	]
}