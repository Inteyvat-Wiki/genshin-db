			"dialogs": [
				{
					"id": 140160401,
					"content": "老实交代，你们是什么人，为什么要跟踪我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160402
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160402,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160403
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160403,
					"content": "别以为不说话就能蒙混过关！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160404,
						140160405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160404,
					"content": "现状如此，就不要心怀侥幸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				},
				{
					"id": 140160406,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160407
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160407,
					"content": "老板，怎么样，你们没受伤吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160408
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160408,
					"content": "这种程度的敌人，怎么能奈何得了我们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160409
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160409,
					"content": "好了，不要拖拖拉拉的，赶紧交代。要是执律庭介入，这件事可就没有商量的余地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160410
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160410,
					"content": "我们…是来找刺玫会寻仇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160411
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160411,
					"content": "被发现了，又打不过你们，我们认栽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160412
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160412,
					"content": "寻仇？难道…你们是那个什么，罗默夫的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160413
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160413,
					"content": "你居然知道这个名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160414
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160414,
					"content": "那你就应该知道我们的恨来自何处！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160415
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160415,
					"content": "劝你冷静。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160416
					]
				},
				{
					"id": 140160416,
					"content": "是的，你们现在毫无胜算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160417
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160417,
					"content": "嘁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160418
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160418,
					"content": "我们喝了点酒，在街上看到了娜维娅，气不打一处来，就想找机会找你们的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160419
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160419,
					"content": "结果，反倒是被你们先拎出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160420
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160420,
					"content": "你在撒谎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160421
					]
				},
				{
					"id": 140160421,
					"content": "啊…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160422,
						140160423
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160422,
					"content": "你们一路跟踪到城里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160424,
					"content": "很敏锐嘛，但那又怎么样？我们什么都没做，也没对你们做什么的本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160425
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160425,
					"content": "我们只是气血上头，看你们很不爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160426
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160426,
					"content": "听着，卡雷斯已经死了，无论刺玫会曾经做过什么，我都希望能有一个新的开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160427
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160427,
					"content": "我是刺玫会的现任会长，如果你们的老大有什么意见，我愿意和他直接对话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160428
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160428,
					"content": "我不会追究你们的责任，这也是我态度的表示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160429
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160429,
					"content": "…嗯，谢谢你。你的想法，我会传达给老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160430
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160430,
					"content": "但如果你们再敢做类似的事，哪怕是再有类似的想法，我决不轻饶，知道了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160431
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160431,
					"content": "知道了知道了，喂，我们走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160432
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160432,
					"content": "放走他们真的没问题吗，娜维娅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160433,
					"content": "我不想继承我老爹留下的矛盾，而且巡轨船的事，我也不认为他的做法就完全正确。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160434
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160434,
					"content": "如果对方愿意谈，我也是愿意上桌的，很多事情都应该翻开新的一页了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160435
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160435,
					"content": "我也支持老板的做法，以暴制暴是很原始的做法，在刺玫会的哲学中也毫无美感可言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160436
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160436,
					"content": "嗯，而且科尔特也说过，最近他们内部情况不好，掀不起什么风浪，或许也会是他们最愿意坐下来谈的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160437
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160437,
					"content": "不过我认为还是要提防罗默夫的行动，如果他对我们这边的警告视而不见…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160438
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160438,
					"content": "恐怕到最后还是会演变成一场战斗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160439
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160439,
					"content": "至少他那边的人，看起来挺讨厌刺玫会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160440,
					"content": "不要发展到那一步最好，毕竟…就算恩断义绝，两边也曾是一家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160441
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160441,
					"content": "嗯，确实是这个道理。好啦，总之算是解决了吧，不用在乎这些讨厌鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160442
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160442,
					"content": "今天有点晚了，我们去「灰河」休息一晚，明天再回白淞镇好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160443
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160443,
					"content": "我会托人给弗洛朗写封信，告诉他今天的遭遇，让他注意白淞镇周边的安全，提防可疑人士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160444
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160444,
					"content": "又要住在「灰河」吗？那里的枕头都有一股水草的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160445,
					"content": "没办法啦，很靠近水边，又没什么阳光，不过白淞镇也差不多，我早就习惯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160446
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160446,
					"content": "晚上我们还可以去店里吃烤鱼喝饮料，听人唱船歌，不也挺好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160447
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160447,
					"content": "有道理，你说服我了！我们走吧，我也要唱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160423,
					"content": "一定有所预谋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160405,
					"content": "我们上面和下面都有人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				}
			]
		},
