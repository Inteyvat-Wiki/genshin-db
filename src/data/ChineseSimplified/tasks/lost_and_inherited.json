			"dialogs": [
				{
					"id": 140160801,
					"content": "别再浪费时间了，老大耐心有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160802
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160802,
					"content": "明天就行动，你自求多福吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160803
					],
					"speakerTitle": "马蒂纳"
				},
				{
					"id": 140160803,
					"content": "发条装置不会动也是因为少装了一个零件，这么想的话，好像我们也算公平？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160804
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160804,
					"content": "只讨论数量倒是没错啦…哈啊，不行了，我实在是熬不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160805,
					"content": "哈哈哈，快去休息吧，今天我玩得很开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160806
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160806,
					"content": "明天见，娜维娅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160807
					]
				},
				{
					"id": 140160807,
					"content": "嗯，明天见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160808
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160808,
					"content": "怎么样，昨天睡了好觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160809
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160809,
					"content": "我梦见在和海星跳舞…应该算「还行」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160810,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160811
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160811,
					"content": "…你从哪里学来的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160812
					]
				},
				{
					"id": 140160812,
					"content": "哈哈，没想到你还挺幽默。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160813
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160813,
					"content": "你看，还是有人能欣赏的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160814,
					"content": "那我们走吧，回白淞镇就坐船好了，我来安排。阿黛尔应该也想和你们见一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160815
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160815,
					"content": "希望她喜欢你给她准备的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160816,
					"content": "那就最好了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				}
			]
