			"dialogs": [
				{
					"id": 140160101,
					"content": "路德温，我来了，这两天生意怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160102
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160102,
					"content": "等不到刺玫会大小姐的光顾，我这小店马上就要关门倒闭啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160103
					],
					"speakerTitle": "路德温"
				},
				{
					"id": 140160103,
					"content": "呵呵，都知道你路子广办法多，你开这种玩笑没人信的。不过现在她已经是老板了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160104
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160104,
					"content": "失敬失敬，哎呀，顺口了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160105
					],
					"speakerTitle": "路德温"
				},
				{
					"id": 140160105,
					"content": "你们是来取衣服的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160106
					],
					"speakerTitle": "路德温"
				},
				{
					"id": 140160106,
					"content": "对，之前在枫丹廷办事的时候忘记了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160107
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160107,
					"content": "这点小事，请手下来办也没问题啊，大小姐竟然亲自跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160108
					],
					"speakerTitle": "路德温"
				},
				{
					"id": 140160108,
					"content": "小题大做一直是娜维娅的风格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160109,
					"content": "可不是小题大做，散心也是行程中很重要的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160110
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160110,
					"content": "没有什么比踏上一段新的旅程更能治愈身心的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160111
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160111,
					"content": "呵呵，老板说的是，至少比一个人闷着要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160112
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160112,
					"content": "那你们稍等，我这就去取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160113
					],
					"speakerTitle": "路德温"
				},
				{
					"id": 140160113,
					"content": "对了，为什么阿黛尔想要加入刺玫会呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160114,
					"content": "嘿嘿，她还说不清具体的理由，只是说因为很喜欢我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160115
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160115,
					"content": "在那件事之后，她变得开朗了不少，估计是因为她终于知道，她的父亲并不是个让她失望的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160116
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160116,
					"content": "她说她很害怕我的老爹，所以觉得刺玫会里都是可怕的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160117
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160117,
					"content": "但现在刺玫会的氛围不一样了，她有勇气和我说话，也觉得我能理解她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160118
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160118,
					"content": "你们有相似的遭遇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160119
					]
				},
				{
					"id": 140160119,
					"content": "嗯，或许是吧，我在寻找真相的同时也帮助了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160120
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160120,
					"content": "她说也想要像我一样，去帮助别人，而不是继续等在原地，期待别人朝她伸出援手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160121
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160121,
					"content": "听上去，她会成为一个优秀的刺玫会成员。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160122
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160122,
					"content": "我也这么认为，但首先，还是要创造一个能让她健康成长的环境吧。等她长大，再把选择权交给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160123
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160123,
					"content": "（果然不是错觉…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160124
					]
				},
				{
					"id": 140160124,
					"content": "嗯，你怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160125,
						140160126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160125,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				},
				{
					"id": 140160127,
					"content": "欸？跟、跟踪？！我来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160128,
					"content": "我也去看看！科尔特，衣服你帮我拿一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160129
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160129,
					"content": "哦，好、好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160126,
					"content": "有人跟踪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				}
			]
		},
