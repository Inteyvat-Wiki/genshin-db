			"dialogs": [
				{
					"id": 140160501,
					"content": "再次来到这个地方，总觉得有点亲切感了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160502,
					"content": "如果刺玫会在枫丹廷的据点是像沫芒宫那样富丽堂皇的地方，反而会觉得很不搭调。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160503,
					"content": "哈哈哈，的确如此，我也这么觉得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160504
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160504,
					"content": "只不过在我老爹的畅想中，等刺玫会越来越好，白淞镇也会成为不输给枫丹廷的大城市。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160505
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160505,
					"content": "他是个野心很旺盛的人，很少低头去看，所以他才会有很多异于常人的特质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160506
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160506,
					"content": "也就是这一点，人们对卡雷斯先生总是又爱又恨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160507
					],
					"speakerTitle": "科尔特"
				},
				{
					"id": 140160507,
					"content": "好啦，你们去店里等我，我去里面做些准备，顺便也叫人把你们的住处整理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160508
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160508,
					"content": "房间还和上次一样，没忘记是哪一间吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160509
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160509,
					"content": "嗯，反正又没几间房！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160510,
					"content": "你这家伙，想说这地方寒酸对吧！我现在就去把你的枕头塞满水草！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160511
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160511,
					"content": "对不起，对不起，那真要睡不着了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160512,
					"content": "哈哈哈，开玩笑的，你们先过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				}
			]
		},
		{
