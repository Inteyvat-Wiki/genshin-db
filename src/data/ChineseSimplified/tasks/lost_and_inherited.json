						],
						"pointId": 340100403
					}
				]
			},
			"dialogs": [
				{
					"id": 140160701,
					"content": "用自动鱼竿钓鱼，还算钓鱼吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160702,
					"content": "嗯，怎么了？这种鱼竿在白淞镇很常见啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160703
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160703,
					"content": "钓鱼，不应该是…呃，非常投入地看着浮漂，等鱼咬钩，体会鱼出水那一瞬间的惊喜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160704,
					"content": "#那也是一种方式啦。{NICKNAME}，你怎么看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160705,
						140160707
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160705,
					"content": "手动比较有意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160706
					]
				},
				{
					"id": 140160707,
					"content": "自动省事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160708
					]
				},
				{
					"id": 140160706,
					"content": "那下次我们就用普通的鱼竿钓鱼吧，比一比谁钓得更多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160708,
					"content": "哈哈，你也这么觉得吧，不管怎么样，能钓到鱼就开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160709,
					"content": "比起这个，我更想问为什么娜维娅你这么有精神，这种时候我都…哈啊…想睡觉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160710,
					"content": "天生的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160711
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160711,
					"content": "就这样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160712,
					"content": "展开来讲的话你会更想睡觉的。我想，应该是多亏了刺玫会，还有我的母亲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160713
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160713,
					"content": "母亲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160714
					]
				},
				{
					"id": 140160714,
					"content": "我老爹从小就对我有很多不切实际的期待，他越是想要我和他一样，我就越不想听他的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160715
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160715,
					"content": "我母亲就不一样了，我听说她对我只有一个期望，就是能开开心心地长大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160716
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160716,
					"content": "刺玫会的成员都很尊重她的想法，无论我去哪里胡闹，他们都愿意惯着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160717
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160717,
					"content": "你们能想象吗？我因为闯祸挨骂的时候，所有人站成两排，迈勒斯和西尔弗也在，只有我老爹一个人大发雷霆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160718
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160718,
					"content": "大家都默不作声，渐渐地，就显得为了小事而对我发脾气的老爹很小气，他也就只好闭嘴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160719
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160719,
					"content": "还有这种事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160720,
					"content": "是啊，现在想想，他们真的都是一群很温柔的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160721
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160721,
					"content": "小时候的我一直认为，我可以想做什么就做什么，因为总会有人帮我善后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160722
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160722,
					"content": "但是有一次迈勒斯他受伤了，他不告诉我原因，但我能感觉到，是因为我的缘故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160723
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160723,
					"content": "——总会有人为错误承担责任，越是珍视周围的人，就越不要去做错事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160724
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160724,
					"content": "因为当错误的惩罚降临时，那些人真的会不顾一切地为你挺身而出，为你付出代价…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160725,
						140160726
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160725,
					"content": "娜维娅…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160726,
					"content": "你果然还是很难受吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160727,
					"content": "对不起，对不起，不该提这个，今晚不想聊难过的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160728
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160728,
					"content": "总之就是，刺玫会有今天这样的氛围，一定不是因为我老爹，而是我的母亲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160729
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160729,
					"content": "这或许是我感受来自她的爱的唯一方式，我也想要把她的温柔传递下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160730
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160730,
					"content": "所以你才会放走今天的那些人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160731,
					"content": "嗯，或许也是过往的教训吧，至少我不希望太过武断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160732
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160732,
					"content": "#欸，你看，{NICKNAME}，你那边有水花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160733
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160733,
					"content": "但是为什么鱼竿不收线啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160734,
					"content": "应该是发条装置没装好，我也是第一次组装这种鱼竿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160735
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160735,
					"content": "别让它跑了，我们抓住它！快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160736
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160736,
					"content": "我、我也要来吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160737,
					"content": "你们齐心协力，总算把这条大鱼拽了上来。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						140160738
					]
				},
				{
					"id": 140160740,
					"content": "你这不是没有装鱼钩吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
