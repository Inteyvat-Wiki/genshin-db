				]
			},
			"dialogs": [
				{
					"id": 140160601,
					"content": "享用晚餐，观看表演，热闹的夜晚渐渐过去。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160602
					]
				},
				{
					"id": 140160602,
					"content": "一切转为安宁，你和派蒙回到房中，却听见敲门声…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160603
					]
				},
				{
					"id": 140160603,
					"content": "睡了吗？还没有吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160604,
						140160605
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160604,
					"content": "娜维娅？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				},
				{
					"id": 140160606,
					"content": "没什么，只是觉得难得有这样的夜晚，不应该就这么结束，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160607
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160607,
					"content": "想去钓鱼吗？我已经准备好装备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160608
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160608,
					"content": "这就是你晚餐之前说的「准备」吧！那我们马上来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140160609,
					"content": "嘿嘿，没打扰到你们的休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160610,
						140160613
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160610,
					"content": "还好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160611
					]
				},
				{
					"id": 140160611,
					"content": "放心，我考虑到你可能没精神，已经做好准备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160612
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160612,
					"content": "就当陪我聊聊天，行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160615,
					"content": "走吧走吧，钓鱼去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160613,
					"content": "既然是你的邀请…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160614
					]
				},
				{
					"id": 140160614,
					"content": "嘿嘿，不愧是我的好搭档。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140160605,
					"content": "怎么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				}
			]
		},
		{
			"id": 1401607,
