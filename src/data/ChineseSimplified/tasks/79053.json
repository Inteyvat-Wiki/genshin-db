	"talks": [
		{
			"id": 7905301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905301",
							"2"
						],
						"stepId": 7905301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊迪娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790530101,
					"content": "「欢迎来到『琉形蜃境』，希望你们能够在这里稍微忘记旅途的疲惫，好好休息一番。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530102
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530102,
					"content": "本来应该在初次见面的时候说这种欢迎辞的，唉，没想到居然发生了那么多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530103
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530103,
					"content": "既然一切恢复了，那就为你补上这句开场…怎么样，听上去还是挺正经的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530104,
						790530109,
						790530114,
						790530117
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530104,
					"content": "关于先成图…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530105
					]
				},
				{
					"id": 790530105,
					"content": "欸，是要我解释原理吗，其实原理我也没有那么清楚啦。总之，先成图更像是一种想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530106
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530106,
					"content": "就像植物如何生长其实早就写入种子之中，就像鸟的翅膀如何展开早在卵中业已注定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530107
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530107,
					"content": "事物符合道理地变成现在目及的一切，而在最开始的开始或许已经奠定了万物的蓝图。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530108
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530108,
					"content": "先成图就是那份蓝图，然后由瓶中的折光照射，展开变成了整个琉形蜃境。啊，只不过这是只能在这支魔瓶里才能实现的伎俩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530109,
					"content": "关于纯水精灵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530110
					]
				},
				{
					"id": 790530110,
					"content": "啊，你是说为什么从枫丹逃离的事吗？回想起来就像是上辈子的事一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530111
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530111,
					"content": "要说逃出来的理由的话，是因为「水」，枫丹的水变了，对于纯水精灵来说，那里的水现在充满了…痛苦与仇恨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530112
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530112,
					"content": "对我们来说，如果要活下去，最好从故土逃离。啊，就是在那个时候慌不择路，倒在了沙漠里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530113
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530113,
					"content": "要我说，这片沙漠也太大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530114,
					"content": "关于洛蒂娅…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530115
					]
				},
				{
					"id": 790530115,
					"content": "哦，你是说洛蒂娅姐姐吗，咦，你见过她吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530116
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530116,
					"content": "看来她也找到了属于自己的栖身之所…轻策庄，在璃月吗？那还真是，离开到了很远的地方啊，洛蒂娅姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790530117,
					"content": "要好好加油哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530118
					]
				},
				{
					"id": 790530118,
					"content": "嗯，我会…我会努力的！也请你好好享受这里湿润的环境吧，在沙漠里有这样的地方还挺难得的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪娅"
				}
			]
		},
		{
			"id": 7905313,
			"completionStepIds": [
				7905302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905302",
							"2"
