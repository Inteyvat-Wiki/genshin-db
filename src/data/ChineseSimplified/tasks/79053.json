					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"120310",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊迪娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531301,
					"content": "伊迪娅小姐，紧急情况，重大事件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531302,
					"content": "我们找到了一块怀表！你快看看，这是不是传说中的摩拉怀表！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531303,
						790531304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531303,
					"content": "外表确实金灿灿的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				},
				{
					"id": 790531305,
					"content": "哦？让我来瞧一瞧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531306
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531306,
					"content": "居然，居然真被你们找到了！难道说，一切都有冥冥之中的旨意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531307
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531307,
					"content": "神奇的冒险家留下了终极的彩蛋，结果被传奇的旅行者找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531308
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531308,
					"content": "我好像在这之中感受到了某种…精神的传承！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531309
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531309,
					"content": "你这么夸奖我们，我倒是很高兴啦，不过现在我更好奇，找到怀表后会发生什么事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531310,
						790531311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531310,
					"content": "会有额外的奖励吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531312,
					"content": "都…都没有哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531313
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531313,
					"content": "其实我完全没考虑过，会有人找到这个怀表…毕竟我自己都忘了它埋在哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531314
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531314,
					"content": "但它本身就很有价值，对不对！不需要我这边再给你们额外的奖励了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531315
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531315,
					"content": "总之，我要把这件事记录下来，适当添加笔墨，描写成激动人心的故事，绘声绘色地向之后的客人描述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531316
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531316,
					"content": "接下来，你们埋藏的宝藏，就要完全取代这块摩拉怀表的地位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531317
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531317,
					"content": "倒也是哦，最开始我们就聊到过，重点在于宝藏中蕴藏的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531318,
					"content": "#总之，我们再研究一下这块怀表吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531319,
					"content": "伊迪娅小姐，拜托你把我们的故事写得精彩一点了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531320,
					"content": "放心吧放心吧，包在我身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531311,
					"content": "会触发隐藏事件吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531304,
					"content": "外壳画着摩拉花纹！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				}
			]
		},
		{
			"id": 7905314,
			"completionStepIds": [
				7905304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905304",
							"2"
						],
						"stepId": 7905304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"120462",
							"1"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"0",
							"79053"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊迪娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531401,
					"content": "啊，是你们两位呀，怎么了，看上去有什么事需要咨询的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531402
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531402,
					"content": "不过如果有什么关于「琉形蜃境」的事要问，那问我就问对人啦，对我来说，「琉形蜃境」就跟我手掌上的水纹一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531403,
						790531405
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531403,
					"content": "水、水形皱纹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531404
					]
				},
				{
					"id": 790531404,
					"content": "那只是一种比喻啦！我才不会长皱纹呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531407,
					"content": "总之，事情是这样的！我们在乐园里捡到了这样一张信纸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531408,
					"content": "伊迪娅肯定知道这是怎么来的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531409,
					"content": "那是当然，这封信一看就是…咦，还是第一次看到这样的信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531410
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531410,
					"content": "手掌上的水纹看起来很模糊的样子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531411,
					"content": "这、这显然是趁我不注意的时候，有人悄悄埋下的，第一次看到也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531412
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531412,
					"content": "而且，从内容上看，比起一封信，更像是留下的遗书和记录，到底是谁呢，信上这个说话的语调，总觉得有点熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531413
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531413,
					"content": "看上去和「蜃楼玉匣」有关？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531414
					]
				},
				{
					"id": 790531414,
					"content": "啊！这么一说我想起来了，这是把「蜃楼玉匣」带进来的那个老人留下来的…那还是，那还是我来瓶子里没有多久的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531415
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531415,
					"content": "老人是位稻妻人，一进来就问，这里是不是能够达成别人愿望的秘境，让我把他送回从前的战场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531416
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531416,
					"content": "我设法向他解释，但是…他进入秘境的时候身体状况十分糟糕，看得出来由于长途跋涉，精神也到了有些油尽灯枯的程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531417
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531417,
					"content": "一个劲地说着「求你了，把我送回那一天…」或者「把我送回那场战争中吧…」这种话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531418
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531418,
					"content": "所以我就用瓶中的蜃境…仿造了他想象中的战场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531419
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531419,
					"content": "啊，所以信里的「终于回到此处」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531420,
					"content": "大概是恍惚间醒来，发现周围的蜃境与化作记忆中战场类似的样子了吧。战场还挺可怕的，但是他却笑得很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531421
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531421,
					"content": "怎么会有人在生命的最后想看到那样可怕的场景呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531422,
						790531423
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531422,
					"content": "或许对他有别样的意义…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531424,
					"content": "这我就不是很懂啦，不过他最后看上去也挺满足的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531425
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531425,
					"content": "如果有一定要在那种场景里达成的愿望，背负那个愿望的岁月里，肯定也很辛苦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531426
					],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531426,
					"content": "在让核心轮縠重新转起来的时候，「蜃楼玉匣」也帮了不少忙，这么一说，还得谢谢这位秀家先生呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪娅"
				},
				{
					"id": 790531423,
					"content": "或许这样比较刺激吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531405,
					"content": "真的吗，让我看看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531406
					]
				},
				{
					"id": 790531406,
					"content": "只、只是一种比喻啦，就跟你的掌纹一样，没什么好看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "伊迪娅"
				}
			]
		}
	]
}