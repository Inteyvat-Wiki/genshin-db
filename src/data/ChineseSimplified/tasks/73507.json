			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"贝尔福"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#「黄金流星」{NICKNAME}和「白银伴星」派蒙，好久不见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070102,
					"content": "你们还是这么有精神呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070103,
					"content": "别来无恙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "海海海，海妮耶！还有那个超负责的…贝尔福先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070105,
					"content": "真没想到，居然又在奥摩斯港遇见你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070114,
					"content": "话说回来，海妮耶和贝尔福在这里干什么呢？我记得这里以前是「花花琼脂」的摊位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070115,
					"content": "两位大英雄，听着你们的声音，我的心里也更有底气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070116,
					"content": "接下来，就是我向两位汇报工作成果的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070117,
					"content": "之前两位作为「月莲杯驯兽师大赛」的冠军，决定让大赛暂时休赛，先让教令院改进「意智宝珠」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070118,
					"content": "两位应该还在等待通知？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070119,
					"content": "对哦！等到有进展了，莱依拉、赛诺或者负责的学者应该会想办法告诉我们的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070120,
					"content": "派蒙不博学，听不懂技术。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "道理确实是这样啦，我们主动去问也帮不上什么忙，说不定反而会干扰他们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070123,
					"content": "你们还真是沉得住气，作风谨慎！我就经常回想起上次大赛的盛况，根本按捺不住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070124,
					"content": "所以前段时间，我设法询问了教令院的相关人士，得到了详细的答复——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070125,
					"content": "目前，「意智宝珠」的改进还处于理论攻关阶段，距离投入生产，还需要不少时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070126,
					"content": "但第一届大赛的讨论度正在降低，甚至慢慢被人们遗忘。不能就这样浪费了大赛的影响力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070127,
					"content": "因此，我找到了海妮耶小姐，一起筹备了新的「话题活动」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070128,
					"content": "「话题活动」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "难道说的是，桌上摆着的这些…蕈兽模样的棋子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070130,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070131,
					"content": "贝尔福先生一直在为下次大赛准备新内容的方案，到处筹措资金，还前往璃月学习了新的商业门路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070132,
					"content": "他在璃月学习商业经营时，接触到了一种游戏，名为「机关棋谭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070133,
					"content": "贝尔福先生买下了「机关棋谭」在须弥的代理权，请我来当顾问，一起规划了全新的游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070134,
					"content": "它的名字是「灵蕈棋阵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070135,
					"content": "「灵蕈棋阵」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070136,
					"content": "让我来猜猜…难道这次是要我们指挥蕈兽，去和各种机关较量吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070137,
					"content": "不愧是「白银伴星」，一下子就猜到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070138,
					"content": "我觉得，这种游戏易于理解，便于推广，有很大的潜力可供发掘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070139,
					"content": "要是让它以「驯兽师大赛」衍生游戏的名义流行起来，就能让人们长期记住大赛，心怀期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070140,
					"content": "如此一来，下一届大赛举办时，就会有更多选手参赛，更多观众前来捧场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070141,
					"content": "当然，这一切还要你们两位点头许可。毕竟，现在大赛的一切都由你们说了算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070142,
					"content": "我觉得值得一试！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#对哦，我和{NICKNAME}不懂商业上的门道，听贝尔福先生这么一说，我觉得很有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070145,
					"content": "这是海妮耶和贝尔福先生共同努力的结果，我相信你们的才能，请尽管去干吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070146,
					"content": "虽然还没开始玩，但我能肯定，一定会有许多人喜欢的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070147,
					"content": "太好了，能得到你们两位的允许，我就可以放手推广「灵蕈棋阵」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070148,
					"content": "目前「灵蕈棋阵」还处于测试阶段，需要请人试玩、收集反馈，多次进行改良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070149,
					"content": "精通数十种提瓦特流行游戏的「黄金流星」玩过以后，肯定能给出最精准的建议！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070150,
					"content": "#那就上吧，{NICKNAME}！这可是你最擅长的领域之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070151,
					"content": "怎么有种被你指挥的感觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "不过，我还有一件事想问问海妮耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070154,
					"content": "是「咚咚小圆帽」它们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070155,
					"content": "对对对！我好想念蕈兽伙伴们，它们现在怎么样了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070156,
					"content": "放心吧，它们都健健康康，每天生活得无忧无虑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070157,
					"content": "「转转悠悠兽」和「百雷遮罗」待在我在<color=#00E1FFFF>奥摩斯港北边的临时住处</color>，由上次的一位参赛选手暂时照看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070158,
					"content": "「咚咚小圆帽」和「欢腾之火」就在附近。你可以去和它们一起玩哦，「白银伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070159,
					"content": "#就在附近！那{NICKNAME}，待会儿你试玩新游戏的时候，我要去找「咚咚小圆帽」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070160,
					"content": "去吧去吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "事不宜迟，就请「黄金流星」来体验一下早期测试版的「灵蕈棋阵」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "贝尔福"
				},
				{
					"id": 735070161,
					"content": "我稍后就来！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "好吧，「黄金流星」出击！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "真是让你费心了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "我不懂技术，不乱提建议。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "你们是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#{NICKNAME}，你在说什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070108,
					"content": "之前我们参加了「月莲杯驯兽师大赛」，和蕈兽伙伴们玩得很开心啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070109,
