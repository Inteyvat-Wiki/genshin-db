			"dialogs": [
				{
					"id": 705540101,
					"content": "荣誉骑士和白色小帮手，你们好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540102
					],
					"speakerTitle": "赫塔"
				},
				{
					"id": 705540102,
					"content": "初次见面，荣誉骑士和派蒙长官，在下格兰菲狄，听候调遣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540103
					],
					"speakerTitle": "格兰菲狄"
				},
				{
					"id": 705540103,
					"content": "心情不错嘛，赫塔！还有这位骑士小姐，很高兴认识你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705540104,
					"content": "看样子，你们正准备开张了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705540105,
					"content": "嗯！得益于「天使的馈赠」和「猫尾酒馆」的协助，饮品小站的一切都准备就绪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540106
					],
					"speakerTitle": "赫塔"
				},
				{
					"id": 705540106,
					"content": "除了经典的纯饮，我们这里也提供调制饮品，以及限时饮品外送服务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540107
					],
					"speakerTitle": "赫塔"
				},
				{
					"id": 705540107,
					"content": "调制饮品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705540108,
					"content": "很久以前，我们在「天使的馈赠」当过调饮师来着？最近你在挪德卡莱的「旗舰」也露过几手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540109,
						705540110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705540109,
					"content": "确实呢，好久好久了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540111
					]
				},
				{
					"id": 705540111,
					"content": "不过，目前的饮品都比较传统，远征开始前，所有人就习以为常了。为了给大家提供新鲜的选择，我们打算改进酒单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540112
					],
					"speakerTitle": "赫塔"
				},
				{
					"id": 705540112,
					"content": "但我还得回去管理居民请求的事宜，格兰菲狄调制饮品的经验又不足，还有外送的订单要处理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540113
					],
					"speakerTitle": "赫塔"
				},
				{
					"id": 705540113,
					"content": "如果荣誉骑士有空，能麻烦你暂时帮帮忙吗？一段时间后，我的另一组部下就会从望风山地回来顶班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540114
					],
					"speakerTitle": "赫塔"
				},
				{
					"id": 705540114,
					"content": "当然，我们会支付报酬，还有双倍的加班绩效！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540115,
						705540116
					],
					"speakerTitle": "格兰菲狄"
				},
				{
					"id": 705540115,
					"content": "我确实对调制饮品颇有心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540117
					]
				},
				{
					"id": 705540117,
					"content": "虽然听不懂绩效是什么，但我也可以帮忙处理外送订单的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705540118,
					"content": "作为提瓦特最好的向导，我也要与时俱进，多在城里转转，了解一下蒙德最近的变化！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705540119,
					"content": "哎呀，和你们两位合作起来，简直顺利得就像呼吸一样自然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540120
					],
					"speakerTitle": "赫塔"
				},
				{
					"id": 705540120,
					"content": "我就全力支援派蒙长官。分装饮品之类的工作，我非常熟练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540121
					],
					"speakerTitle": "格兰菲狄"
				},
				{
					"id": 705540121,
					"content": "那事不宜迟，开工开工！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705540116,
					"content": "整个吧台可以完全交给我哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540117
					]
				},
				{
					"id": 705540110,
					"content": "记不太清了，不过没关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540111
					]
				}
			]
		}
	]
}