			},
			"dialogs": [
				{
					"id": 210270201,
					"content": "旅行者，还有小蒙？你们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 210270202,
					"content": "#啊？呃…那个…那个…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270203,
					"content": "我们想要借用一下厨房。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "借用厨房倒是没问题，可你们为什么突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 210270205,
					"content": "原来是这样…好，你们就去用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 210270206,
					"content": "小蒙，去外面旅行的时候，你可不能挑食了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 210270207,
					"content": "我、我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270208,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，那就拜托你了，教我做一道好菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270209,
					"content": "等我和爸爸去旅行的时候，我一定要给他一个惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270210,
					"content": "交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}，我们做什么菜好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
