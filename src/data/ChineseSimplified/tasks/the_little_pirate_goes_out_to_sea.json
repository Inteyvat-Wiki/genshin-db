			},
			"dialogs": [
				{
					"id": 210270401,
					"content": "满足沙拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270402
					]
				},
				{
					"id": 210270402,
					"content": "这道菜确实很简单呢，味道也很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
