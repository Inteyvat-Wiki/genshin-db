			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你来得正好，我正想去找你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270102,
					"content": "欸？小蒙，你有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270103,
					"content": "我上次不是拜托你，陪我去放出了一个装着我烦恼的漂流瓶吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270104,
					"content": "本来我都不抱希望了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270105,
					"content": "但是，前几天我爸爸说，他的一个生意伙伴突然找到了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270106,
					"content": "那个叔叔说，他们正在筹划一桩和蘑菇有关的生意，过段时间要去须弥考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270107,
					"content": "他们问我爸爸，要不要跟他们一起去看看那边的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270108,
					"content": "还说…可以把我一起带上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270109,
					"content": "爸爸最开始还不同意，但是…有个叔叔突然拿出了一封信，说要和我爸爸出去单独谈谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270110,
					"content": "他们谈完了之后，爸爸就同意带我去须弥了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270111,
					"content": "唔，虽然不知道为什么爸爸突然改变了主意…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270112,
					"content": "#我可以去须弥旅行了！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！我可以去须弥旅行啦！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270113,
					"content": "恭喜你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#一定是那个漂流瓶起作用了，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270117,
					"content": "爸爸说，他们去了须弥之后，还要去一个叫做「翘英庄」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270118,
					"content": "翘英庄？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "嗯，爸爸说那是一个茶村，种着很多茶树，茶叶的品质也特别好。不过，这个名字可真难记…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270120,
					"content": "先不说这些了！在去那边之前，我们还是要先去须弥的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270121,
					"content": "须弥离这里也很远，过去肯定要花很长时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270122,
					"content": "不过，我听人家说外出旅行要做很多准备，因为只要旅行的时间一长，就会遇见各种情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270123,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你经常在外面旅行，能不能请你教我一些在外旅行的诀窍呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270124,
					"content": "比如…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270125,
					"content": "在外面旅行的时候，一般会吃什么东西呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270126,
					"content": "爸爸和我说，他们都是自己做东西吃。可我只会几道简单的菜，也不知道做的好不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270127,
					"content": "#嘿嘿，烹饪可是我们的拿手好戏，对吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270128,
					"content": "我来教你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "那我们得先去找个灶台…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270131,
					"content": "我想想…不如，我们再去找卯师傅借一下厨房吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270132,
					"content": "卯师傅？呜哇，那个大叔平时好吓人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270133,
					"content": "卯师傅哪里吓人啦？他人很好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270134,
					"content": "是、是吗？可我每次和爸爸在那边吃饭的时候，只要我把清心挑出去不吃，他的眉头就皱起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270129,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "我说不定也会去须弥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "真的吗？那我们就须弥见吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "小蒙"
				}
			]
		},
