					"nextDialogs": [
						200260203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260203,
					"content": "好啦，拜托你把这份特制的<color=#00E1FFFF>炸萝卜丸子</color>送给恩内斯特先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260204,
					"content": "别这么看着我嘛，我知道你肚子很饿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260205,
					"content": "回来的时候，我会用猎鹿人餐馆特制料理来答谢你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
