			"dialogs": [
				{
					"id": 200260101,
					"content": "餐品外送订单",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260102,
					"content": "旅行者，你来的正好——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260103,
					"content": "咦？你说你只是来吃东西的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260104,
					"content": "我，我知道了，但是请你帮我个忙吧，我一定会把最好吃的料理给你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260105,
					"content": "晨曦酒庄的恩内斯特先生经常在我们这里订下酒菜，而且总是会提出各种奇怪的加料要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260106,
					"content": "嗯…这次他虽然订的是<color=#00E1FFFF>炸萝卜丸子</color>，但他一定要我们多加蛋类，可我们的蛋类料理材料都用光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260107,
					"content": "所以，请你帮我们找两颗鸟蛋回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260108,
					"content": "好吧，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "在风起地，应该可以找到很多鸟蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260110,
					"content": "那么，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260111,
					"content": "太饿了，我只是来吃饭的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "在风起地，应该可以找到很多鸟蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260113,
					"content": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
