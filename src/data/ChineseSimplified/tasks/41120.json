			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "呼…谢谢您，刚才真是太危险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200602,
					"content": "所以，请您进蒙德城去避难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "抱歉，我暂时还不能回去。现在天降陨石，已经可以说是十分奇怪的天象了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200604,
					"content": "在这种天象里，海上再产生风暴的话也不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200605,
					"content": "我必须要在这里守着，如果真有风暴出现，我必须第一时间通知城里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200606,
					"content": "谢谢您来通知我，辛苦您了，我会多加小心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				}
			]
		},
		{
			"id": 4112007,
			"completionStepIds": [
				4112007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
