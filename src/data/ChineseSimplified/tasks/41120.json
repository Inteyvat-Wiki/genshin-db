					"葛瑞丝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "您回来了，都通知到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200702,
					"content": "都通知到了，但他们都暂时不肯回来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "不肯回来？到底是有什么重要的事，让他们这个时候还要呆在野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200704,
					"content": "不愧是自由的蒙德人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "哈哈…哈…是啊，他们确实是自由的蒙德人，再自由不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200706,
					"content": "但是在这个时候，我更希望他们能把这份自由给收敛起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200707,
					"content": "唉…西风骑士团想必也没空处理这件事吧。算了，我再想想其他办法，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200708,
					"content": "希望所有人都能平安无事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
