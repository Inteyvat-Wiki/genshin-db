			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200401,
					"content": "咦？旅行者，您来这里做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200402
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200402,
					"content": "您到底去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "抱歉，我一直在四处走动观察海面，确实有些难找…您找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200404,
					"content": "请去蒙德城避难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "避难？哦，您说的是那些陨石啊，我知道，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 411200406,
					"content": "小，小心！小心周围！有魔物围上来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4112006,
			"completionStepIds": [
				4112006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112006",
