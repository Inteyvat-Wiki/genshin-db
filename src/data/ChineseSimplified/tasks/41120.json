			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞丝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "希望所有人都平安无事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200102,
					"content": "您在担心什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "是旅行者啊。那些从天而降的陨石，您应该注意到了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200104,
					"content": "虽然很幸运没有陨石砸到蒙德城里面来，但是野外已经乱成了一片。我很担心那些还逗留在野外的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200105,
					"content": "旅行者，能请你帮忙去警告一下那些还逗留在野外的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200106,
					"content": "如果他们愿意的话，就请他们到蒙德城里来避难吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200112,
					"content": "您可以先去找琳小姐，问问她知不知道还有哪些人逗留在野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200113,
					"content": "然后，也请试着说服她进蒙德城避难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200114,
					"content": "现在可不是她接着挑战「野外生存」的时候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200109,
					"content": "为什么陨石没砸进蒙德城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "也许只是运气好吧。但不管怎么说，蒙德城是目前来看比较安全的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 411200111,
					"content": "至少…比呆在野外安全多了，您说对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112002",
							"2"
						],
						"stepId": 4112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "在这种情况下进行「野外生存」…好像还挺有挑战性的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200202,
					"content": "请进蒙德城避难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "避难？哎呀，不用担心我，我一直在留意着周围呢，不会有危险的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200204,
					"content": "不过，你怎么还在外面逛来逛去，还是快回蒙德城吧，要是被陨石砸到可就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200205,
					"content": "关于在野外逗留的人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "在野外逗留的人？那可有很多啊，你问这个做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200207,
					"content": "去让他们避难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "是这样啊…这么一说，协会里好像也发布过相关的委托，我也去周围通知了不少人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200209,
					"content": "离蒙德城比较近的人，应该都已经进城里避难了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200210,
					"content": "但因为人手不足，临时也召集不到多少冒险家，野外应该还有很多人没被通知到吧，你肯帮忙再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200215,
					"content": "我想想啊，还逗留在野外的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200216,
					"content": "啊！对了，帕琪小姐和杜兰先生一直呆在千风神殿那边，我和他们说过了，但他们还是坚持在那里研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200217,
					"content": "还有芬德修女，之前她一直呆在望风角附近，协会里也让我去找过她几次，但我去了好几次都没找到她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200218,
					"content": "我只记得这些了，你就先去告诉他们进蒙德城避难的事情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200219,
					"content": "至于我嘛，再准备一点食物和必需品之后，我也会去周围转一圈，尽量通知更多人进城避难的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200220,
					"content": "希望他们别跑到太偏远的地方去，不然就算找到了，回来也得大费一番周折吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳"
				},
				{
					"id": 411200211,
					"content": "葛瑞丝修女很担心他们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "葛瑞丝修女？是她啊…其实协会里也发布过相关的委托，我也去周围通知了不少人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200213,
					"content": "离蒙德城比较近的人，应该都已经进城里避难了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "琳"
				},
				{
					"id": 411200214,
					"content": "但因为人手不足，临时也召集不到多少冒险家，野外应该还有很多人没被通知到吧，你肯帮忙再好不过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "琳"
				}
			]
		},
		{
			"id": 4112003,
			"completionStepIds": [
				4112003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112003",
							"2"
						],
						"stepId": 4112003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "现在可不是研究的时候，我们得快点去避难才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200302,
					"content": "我说过好几次了，我绝不会放过这次机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 411200303,
					"content": "请进蒙德城去避难。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "怎么又来了？现在可不是避难的时候，这些天降的陨石，说不定正是我们深入千风神殿的好机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 411200305,
					"content": "深入千风神殿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "帕琪说，也许陨石会砸到千风神殿，如果底下有内殿…或者其他什么的话，我们就可以顺着陨石砸开的路深入了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200307,
					"content": "但是这也太异想天开了，如果陨石砸过来的话，我们俩逃都逃不开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200308,
					"content": "我们还是去避难吧，如果陨石真的砸进了千风神殿，还砸出了条路，那我们之后再来探索不也一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200309,
					"content": "要是被人捷足先登了怎么办？要回去你自己回去，我要在这里等着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 411200310,
					"content": "这…好吧，旅行者，不好意思，我们俩还得在这呆一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200311,
					"content": "别担心，如果真的有危险…我，我会处理好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200312,
					"content": "对了，之前有个叫舒特的人路过了这里，一副很害怕的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200313,
					"content": "他找我要了点水喝之后，就说自己要回蒙德城，飞快地跑掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200314,
					"content": "但他跑的路却又不是往蒙德城，而是往望风角的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200315,
					"content": "我想…那家伙不会是因为太害怕，连路都记错了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200316,
					"content": "旅行者，你先去望风角附近找找他吧，如果他遇到魔物就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 411200317,
					"content": "我会在这里陪着帕琪，如果真有什么事发生…呃，我会处理好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜兰"
				}
