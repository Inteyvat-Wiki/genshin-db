				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"爱拉尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "谢谢你们，我还以为我彻底完了…这帮盗宝团应该是一直在跟踪我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551002,
					"content": "我对这片遗迹的研究刚刚有了进展，想着要是能挖出埋藏在这里的宝藏带回去就再好不过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551003,
					"content": "但是还没等我做好准备，盗宝团就闯进营地，把我给绑起来带到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551004,
					"content": "他们还一直逼问我宝藏的下落，还威胁我说，如果我不把宝藏地点说出来，他们就要了我的命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551005,
					"content": "不过我知道，要是我直接把宝藏的线索告诉了他们，那我才是真不要命了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551006,
					"content": "唉，我果然该听索拉雅小姐的话，考古学家最好别太在意宝藏，只要有学术上的收获就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551007,
					"content": "但是我的经费就这么一点，光是几篇论文，连我自己掏的来往路费都填不平…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551008,
					"content": "也不知道索拉雅小姐是怎么做到一个人在璃月研究这么久的，光是看她被拒的那么多论文，我都替她觉得累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551009,
					"content": "那你接下来打算怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "还能怎么办，学术上的资料我已经搜集齐了，宝藏什么的…就算了，就让给你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551011,
					"content": "杂七杂八的推导过程我就不说啦，总之，宝藏就埋在灵矩关最中间的那棵<color=#00E1FFFF>金色大树下</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551012,
					"content": "你们要的话就去拿吧，我把地址写下来给你们，免得你们忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551013,
					"content": "我休息一会就回营地收拾东西，我要尽快离开这，免得又有盗宝团过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "爱拉尼"
				},
				{
					"id": 715551014,
