			"dialogs": [
				{
					"id": 150260601,
					"content": "格洛德克，付钱的人是我，陪同雇主等待也是你需要提供的服务吧？退下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260602
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260602,
					"content": "明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260603
					],
					"speakerTitle": "格洛德克"
				},
				{
					"id": 150260603,
					"content": "几百岁的大萨满竟然如此…非常抱歉，惊扰到您了，这临时雇佣的部下果然不好约束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260604
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260604,
					"content": "呼…没惹得茜特菈莉动手，真是万幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260605,
					"content": "既然您来了，不如我们就谈谈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260606
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260606,
					"content": "打听过黑曜石奶奶是什么人物吗？你觉得我会被你们唱的双簧骗到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260607
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260607,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260608
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260608,
					"content": "我根本没打算和你谈，刚刚要做一个很重要的决定，但你的人打扰到我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260609
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260609,
					"content": "我出来就是为了告诉你，如果还有下一次，你们的下场会惨到恐怖小说都写不出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260610
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260610,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260611,
					"content": "#{NICKNAME}，我们回去继续谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260612
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260612,
					"content": "黑曜石奶奶果然名不虚传，是我无礼了。不过，我真的很难想象，就连「七彩之战」也吸引不了您啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260613
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260613,
					"content": "你想调查的是「七彩之战」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260614
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260614,
					"content": "#原来{NICKNAME}还没有将此事向您讲明吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260615
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260615,
					"content": "#其实我当初认为能请您出山，除了{NICKNAME}愿意帮我引荐之外，还因为我觉得查清这件事对您本身也很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260616
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260616,
					"content": "我听说那位名为维奇琳的大萨满曾是您的故旧，想必您十分了解她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260617
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260617,
					"content": "如果我能厘清与「七彩之战」有关的争议，证明它的真实性，就能把它收录到出版书籍里，让全提瓦特都了解这段传奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260618
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260618,
					"content": "故友的光辉事迹借您之口重新流传于世，这也算是一段美谈，您意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260619,
						150260620
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260619,
					"content": "这对我完成使命有帮助。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260621
					]
				},
				{
					"id": 150260621,
					"content": "其实你想完成使命的话…好吧，我先帮你调查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260622
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260622,
					"content": "非常荣幸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260623
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260623,
					"content": "#少来，我可不打算接受你的雇佣。我决定帮的是{NICKNAME}，你们就顺便沾点光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260624
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260624,
					"content": "茜特菈莉总算答应下来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260625,
					"content": "（看来我和茜特菈莉的交情还是挺管用的，她终究不是那种很绝情的人。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260626
					]
				},
				{
					"id": 150260626,
					"content": "我什么时候让你觉得是个绝情的人了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260627
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260627,
					"content": "#无妨无妨，我本来就准备和{NICKNAME}合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260628
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260628,
					"content": "请问您亲身经历过「七彩之战」吗？您知道战场的遗址在哪里吗？现在还能不能找到一些可以证明那场战争发生过的遗物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260629
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260629,
					"content": "好吵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260630
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260630,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260631
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260631,
					"content": "我也想问。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260632
					]
				},
				{
					"id": 150260632,
					"content": "没有，不知道，不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260633
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260633,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260634
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260634,
					"content": "我确实曾经和她生活在同一个时代，但这不代表我经历过与她有关的所有事件。我只是活得久了一些，又不是历史书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260635
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260635,
					"content": "调查方向你们自己定，如果涉及到我比较了解的地方，我可以给你们答疑解惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260636
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260636,
					"content": "…这样也好，虽然您不是「七彩之战」的亲历者，但您毕竟曾经生活在那个时代，您的意见肯定非常有用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260637
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260637,
					"content": "艾列尔，你之前想好的调查方向是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260638
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260638,
					"content": "我的计划吗？我之前调查到烟谜主内部有专门负责记录历史的人，或许可以先向他们咨询一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260639
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260639,
					"content": "那就先按这个方向继续调查！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260640
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260640,
					"content": "#{NICKNAME}，我们正式合作吧，毕竟我只有通过你才能得到这位大萨满的帮助呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260641
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260641,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150260620,
					"content": "这对烟谜主也很有意义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260621
					]
				}
			]
		},
