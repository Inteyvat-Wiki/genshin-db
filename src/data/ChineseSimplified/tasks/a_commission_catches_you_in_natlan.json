			},
			"dialogs": [
				{
					"id": 150260401,
					"content": "呃…这就是茜特菈莉住的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260402,
					"content": "我就知道一时半会儿根本收拾不完…想要吐槽也无所谓啦。奶奶我身为烟谜主的大萨满，从来不关注这些无聊的家务活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260403
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260403,
					"content": "那种总是把房间收拾得干干净净的人，在轻小说里往往都当不上主角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260404
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260404,
					"content": "另外，我那是看透世事的不修边幅，不是宅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260405
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260405,
					"content": "她似乎很在意自己在我们眼里的形象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260406,
					"content": "对了，之前用法术将部分感官分享给你们的时候出现了一些副作用，你们摆脱那种副作用了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260407
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260407,
					"content": "出于身为大萨满的责任，我必须再确认一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260408
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260408,
					"content": "你是指能听到各自心声的事？没有没有，已经过去那么久了，不必再为这种事担心了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260409,
					"content": "#那为什么我突然能听到{NICKNAME}的心声了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260410
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260410,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260411,
					"content": "（所以是因为听到了我在心里的评价吗？茜特菈莉应该更坦然一些才对吧，毕竟是「看透世事的不修边幅」啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260412
					]
				},
				{
					"id": 150260412,
					"content": "我现在还能听到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260413
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260413,
					"content": "如果有所冒犯，我道歉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260414
					]
				},
				{
					"id": 150260414,
					"content": "少废话，我会想办法处理的。啧，之前是你能听到我的心声，现在是我能听到你的心声…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260415
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260415,
					"content": "只是一种用来分享感官的法术而已，到底是什么样的体质才能搞出这么复杂的副作用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260416
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260416,
					"content": "罢了罢了，先说说你们来找我有什么事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260417
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260417,
					"content": "哦，是这样的。有人委托我们请你出山做顾问，他们想调查一些与纳塔历史有关的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260418,
					"content": "专门委托拯救了纳塔的英雄来请我？看来这些人明白奶奶我很讨厌麻烦事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260419
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260419,
					"content": "他们给的报酬很不错呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260420,
					"content": "我拒绝，我很忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260421
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260421,
					"content": "怎么看都不像是很忙的样子啊…果然凭我们的交情也没法请她出面帮陌生人办事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260422,
					"content": "如果这也是我的请求呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260423
					]
				},
				{
					"id": 150260423,
					"content": "你的请求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260424
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260424,
					"content": "嗯，我们不久前被赋予了一项神圣的使命——帮助烟谜主制作记录历史大事件的特殊织物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260425,
					"content": "欸？这一次被选中的人是你们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260426
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260426,
					"content": "#我和{NICKNAME}当初也很惊讶，毕竟我们根本不知道如何制作那种织物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260427,
					"content": "不过在首领庇兰的帮助下，还是获得了一些进展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260428,
					"content": "虽然最后没有成功，但至少我们知道制作这种织物的关键是一种特殊的色彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260429,
					"content": "那些人想要调查的历史事件就与色彩有关，如果茜特菈莉能出山，或许也能帮到我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260430,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260431
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260431,
					"content": "茜特菈莉又摆出那种表情了，是我解释得不清楚吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260432,
					"content": "该说是超展开还是伏笔回收呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260433
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260433,
					"content": "呃…我不太懂你在想什么，所以还是不方便吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260434,
					"content": "我…我必须慎重地考虑一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260435
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260435,
					"content": "好像有戏哎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260436,
					"content": "喂！还没谈好吗？来不来倒是给个准信啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260437
					],
					"speakerTitle": "格洛德克"
				},
				{
					"id": 150260437,
					"content": "这…说好了让我们来负责沟通的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260438,
					"content": "啧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260439
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260439,
					"content": "茜特菈莉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
