			"dialogs": [
				{
					"id": 150260101,
					"content": "咳咳…你们在这里做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260102,
					"content": "哈？我们拿钱办事，有事请找雇主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260103
					],
					"speakerTitle": "格洛德克"
				},
				{
					"id": 150260103,
					"content": "什么态度…话说愚人众接受雇佣的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260104,
					"content": "咳咳！他是格洛德克，受我雇佣，负责在纳塔保护我的安全。看来他不太擅长待人接物，让两位见笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260105
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260105,
					"content": "我本来想从纳塔的原住民当中雇佣人手，但一位祭司向我推荐了格洛德克和他的小队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260106
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260106,
					"content": "说是他们最近正好闲着，战斗力也不错，很符合我的要求…听起来愚人众在纳塔的风评似乎还挺好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260107
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260107,
					"content": "原来是这样啊…另外，你是枫丹人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260108,
					"content": "#在下蒙吕松，来自枫丹，主要做一些出版生意。两位…两位莫非就是那位旅行者和{M#他}{F#她}的精灵伙伴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260109
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260109,
					"content": "你知道我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260110,
					"content": "金发的旅者，银色的飞行伙伴…不会错的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260111
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260111,
					"content": "两位在枫丹留下的事迹足以支撑起一个畅销书系列，我作为书商怎么会认不出两位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260112
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260112,
					"content": "#我们果然很有名啊，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260113,
					"content": "我的运气真不错——说起来有些唐突，其实我刚刚还在发愁要去哪里寻找两位呢，我有个不情之请…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260114
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260114,
					"content": "怎么有种委托人从枫丹追到纳塔的感觉？又开心不起来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260115,
					"content": "事成之后，必有重谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260116
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260116,
					"content": "…这位倒是干脆，先听他讲讲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260117,
						150260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260117,
					"content": "哪次躲得掉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				},
				{
					"id": 150260119,
					"content": "咳咳…请问阁下有什么请求？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260120,
					"content": "两位认识茜特菈莉吧？我想麻烦两位请那位大萨满出山助我一臂之力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260121
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260121,
					"content": "呃…让茜特菈莉帮陌生人办事，凭我们的交情也很难办到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260122,
					"content": "那种性格，很难想象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260123
					]
				},
				{
					"id": 150260123,
					"content": "说实话，她不太喜欢和陌生人打交道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260124,
					"content": "这个我已经从烟谜主的族人那里打听到了，他们还告诉我，如果非要找出一个能够请她出山的人，那就只能是「金发的旅者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260125
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260125,
					"content": "只要两位能帮忙，报酬可以加倍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260126
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260126,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260127,
					"content": "先问清楚是什么事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260128
					]
				},
				{
					"id": 150260128,
					"content": "也对…请问你要找茜特菈莉帮忙做什么？我们至少要先了解一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260129,
					"content": "这个说来话长，涉及到烟谜主的一些历史…还是让专业人士来向两位说明吧——艾列尔，有劳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260130
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260130,
					"content": "当然可以！平时很少有人愿意听我讲这些…初次见面，我是来自枫丹科学院的研究员，叫我艾列尔就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260131
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260131,
					"content": "和大部分研究员不同，我对研究古代遗迹也很感兴趣，所以才有幸受邀加入蒙吕松先生的队伍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260132
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260132,
					"content": "不知道两位是否听说过传奇萨满维奇琳的事迹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260133,
						150260134
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260133,
					"content": "有些耳熟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260135,
					"content": "按照目前能收集到的纳塔史料，她生活在两百多年前，最擅长与色彩相关的秘术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260136
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260136,
					"content": "而她的所有事迹中，最著名的就是传奇的「七彩之战」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260137
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260137,
					"content": "传说那也是一场由深渊入侵而引发的战争，其惨烈程度即便放到整个纳塔战争史中也可以位居前列。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260138
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260138,
					"content": "神奇的是，纳塔一方在形势极其不利的情况下最终扭转了战局。而取胜的关键，正是维奇琳在战场上创造出的一种「色彩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260139
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260139,
					"content": "在传说中，这种「色彩」非常神奇，它虚幻缥缈，却又仿佛有实体，维奇琳就用它构筑了一座绚丽的迷宫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260140
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260140,
					"content": "来势汹汹的敌人都被困在里面无法脱身，友军在维奇琳的引导下趁势反攻，并最终取得了胜利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260141
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260141,
					"content": "咳咳…把事情大概讲清楚就好，旅行者也不想被耽误太多时间，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260142
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260142,
					"content": "他刚刚讲的故事就是我来纳塔的原因，我喜欢收集其他国家的历史故事，编集成书，然后出版，这种书一直卖得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260143
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260143,
					"content": "最初听到这个故事，我就想把它也收录到接下来要出版的故事集里，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260144
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260144,
					"content": "纳塔的史料都不太详细，我的人甚至无法确认战场遗址的位置，也找不到其他能证明「七彩之战」发生过的证据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260145
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260145,
					"content": "甚至部分烟谜主的族人也不认可「七彩之战」的真实性，觉得它更像是一个被编撰出来的传说故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260146
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260146,
					"content": "这样的话，不好收录啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260147
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260147,
					"content": "欸？如果只是当成一个写进书里的故事，有必要寻找切实的证据吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260148,
					"content": "我这个系列最大的卖点就是「复原真实的历史」，当然要有考据啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260149
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260149,
					"content": "所以我才来到了这里，我听说烟谜主部族有记录历史的习惯，就想调查一下他们的史料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260150
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260150,
					"content": "结果那个什么「曜石祭场」根本不让进，申请了半天也只拿到一些普通的织卷，能研究出什么？明明我可以帮忙宣传他们的历史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260151
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260151,
					"content": "据我研究，烟谜主的族民用织物来记录历史，这些织物在他们看来如同圣物，自然不肯轻易给外人看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260152
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260152,
					"content": "另外，那些织卷包含的信息量其实很大，如果能让我仔细研究下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260153
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260153,
					"content": "艾列尔，我们之前不是已经谈过了吗？有更好的路子，就不必在这里浪费时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260154
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260154,
					"content": "更好的路子？难道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260155,
					"content": "嗯，两位想必也知道茜特菈莉是一位活了两百多年的大萨满，她亲身经历过「七彩之战」发生的时代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260156
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260156,
					"content": "能请她出山做顾问，还用得着研究史料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260157
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260157,
					"content": "原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260158,
					"content": "两位意下如何？报酬再翻一倍也可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260159
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260159,
					"content": "实在不是我们不想帮忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260160,
						150260161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260160,
					"content": "派蒙，我们有必要去一趟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260162,
					"content": "哦，对了！之前烟谜主的首领托付给我们的那个使命和维奇琳之间的关联很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260163,
					"content": "这个「七彩之战」背后，可能也有我们想要调查的线索？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260164,
					"content": "我们可以帮这个忙，只是请让我们全权负责和茜特菈莉沟通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260165,
					"content": "没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260161,
					"content": "我们还有一个未完成的使命。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260134,
					"content": "那位与色彩有关的萨满…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260118,
					"content": "报酬给到位也行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				}
			]
		},
