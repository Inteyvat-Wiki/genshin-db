			"dialogs": [
				{
					"id": 150260201,
					"content": "这里就是那位大萨满的住处吗？也太偏远了些，帮我们指路的族民应该没骗人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260202
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260202,
					"content": "如果是茜特菈莉的话，住在这种地方倒也不奇怪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260203,
					"content": "这墙上的涂鸦是那位大萨满的创作吗？或许和部族文化有关！如果能让我把这些涂鸦临摹下来的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260204
					],
					"speakerTitle": "艾列尔"
				},
				{
					"id": 150260204,
					"content": "艾列尔，办正事要紧。就像之前说好的那样，请两位帮忙接洽，我和其他人就在这里等候好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260205
					],
					"speakerTitle": "蒙吕松"
				},
				{
					"id": 150260205,
					"content": "#嗯，{NICKNAME}，我们去敲门吧！希望她没有宿醉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260206,
					"content": "#茜特菈莉，你在家吗？{NICKNAME}和我有些事情要找你帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260207,
					"content": "…没反应啊，难道她不在家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260208,
					"content": "试试另一个称呼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260209
					]
				},
				{
					"id": 150260209,
					"content": "哦，黑曜石奶奶，你在家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260210,
					"content": "房门突然被打开，一股酒气扑面而来。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260211
					]
				},
				{
					"id": 150260211,
					"content": "小鬼，要找我挑战得提前预约…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260212
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260212,
					"content": "（茜特菈莉平时这么宅的吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260213
					]
				},
				{
					"id": 150260213,
					"content": "#…{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260214
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260214,
					"content": "房门又被猛地关闭。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260215
					]
				},
				{
					"id": 150260215,
					"content": "…看来我们来得很不是时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260216,
					"content": "咳咳…你们还在吗？可以进来了…进来讲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260217
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260217,
					"content": "还好没有被拒绝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
