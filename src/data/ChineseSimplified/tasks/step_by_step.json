					"杜兰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "冒险不可能有完美的方案！这么拖下去，什么时候才能有进展？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200470102,
					"content": "就算没有完美的方案，也要做好万全的准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470103,
					"content": "你们在吵什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "哦，我们打算去<color=#00E1FFFF>千风神殿</color>内部探险，但帕琪小姐实在是没有冒险经验…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470105,
					"content": "现在千风神殿里魔物横行，还有那个恐怖的遗迹守卫…贸然闯进去，只会让自己的生命安全受到威胁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470106,
					"content": "为了和帕琪…不是，为了保障我们的人身安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470107,
					"content": "我正在说服她，制订一份万无一失的冒险计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470108,
					"content": "但假如我去周围调查，说不定帕琪就会直接冲进神殿里去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470109,
					"content": "我得在这看着她，请你帮我去周围调查一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "太好了，要看得仔细一些啊，任何细节都会影响冒险的成败。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470112,
					"content": "无论发现了什么，都带回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470113,
					"content": "那我来看着帕琪小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "不，不行！旧计划里有很多细节，我要和她重新讨论…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "杜兰"
				},
				{
					"id": 200470115,
					"content": "你快点去调查新线索吧，拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜兰"
				}
			]
		},
