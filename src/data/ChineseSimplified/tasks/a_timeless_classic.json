			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"吉盖克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "你好，想试试「风行迷踪」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590102,
					"content": "「风行迷踪」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590104,
					"content": "你应该知道，在之前的蒙德城里有一群「贵族」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590105,
					"content": "他们在蒙德城里暴行不断，让不少人都苦不堪言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590106,
					"content": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590107,
					"content": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590108,
					"content": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590109,
					"content": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590110,
					"content": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590111,
					"content": "曾经？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590113,
					"content": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706590114,
					"content": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉盖克斯"
				}
			]
		},
		{
