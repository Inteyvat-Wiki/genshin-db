			"dialogs": [
				{
					"id": 3090201,
					"content": "呼，可算是全部处理完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090202,
					"content": "这样蒙德的元素流动、地脉循环就会恢复正常了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090203,
					"content": "要回去看看<color=#00E1FFFF>骑士团</color>的情况吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090204,
					"content": "当然，如果有什么别的有趣的事要做，我也可以陪你先去喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090205,
					"content": "比如去蒙德购物…或者一起再去看看<color=#00E1FFFF>七天神像</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090206,
					"content": "之前我们在四风守护的庙宇里，得到了一种好像凝固的风一样的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090207,
					"content": "在蒙德，人们把它叫做「散失的风神瞳」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090208,
					"content": "这个名字代表的是：它有资格被镶嵌在神像的眼眶里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090209,
					"content": "有童话说，是燕子衔走了作为眼睛的宝石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090210,
					"content": "但其实「散失的风神瞳」本来就没有实体。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090212,
					"content": "拥有「神之眼」的人会注意收集它们，送去<color=#00E1FFFF>七天神像</color>，获取赐福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090213,
					"content": "虽然你没有「神之眼」，但你超脱这个世界的常理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090214,
					"content": "想试试的话，就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090215,
					"content": "风起地的那座七天神像，应该就是离我们最近的一座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3090216,
					"content": "我很期待…这一次，神明又会怎样回应你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
