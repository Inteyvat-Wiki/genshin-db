			"dialogs": [
				{
					"id": 750000101,
					"content": "喂，喂…大家伙，你还好吗，还站得起来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000102,
					"content": "看上去好虚弱，真是的，到底发生了什么啊…那些飘浮幽灵狗真让人讨厌，果然飘浮着的家伙都不是什么好东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000103,
					"content": "你自己不也飘着吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "我和那些家伙怎么能一样啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000105,
					"content": "#不说那些了，快，{NICKNAME}，我们看看还有什么吃的，给这个大家伙吃点，然后…然后让它好好休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000106,
					"content": "这样，它一定能恢复一点精神的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000107,
					"content": "已经太迟了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "怎么会这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000110,
					"content": "…呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "大家伙？"
				},
				{
					"id": 750000111,
					"content": "#呜，它现在肯定很难受，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000112,
					"content": "你的敌人已经被我清理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "…呼呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "大家伙？"
				},
				{
					"id": 750000115,
					"content": "是…还有什么放心不下的东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "你想要…告诉我什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "伸出…伸出手来，受龙…所选者…伸出手来…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "联结…力量，然后，去见证一切，以此，解放一切…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#{NICKNAME}，你怎么啦！快，快做些什么呀，不是发呆的时候啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000120,
					"content": "没有，刚才可能只是眼花了一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "大家伙？"
				},
				{
					"id": 750000122,
					"content": "……呜…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000123
					],
					"speakerTitle": "大家伙？"
				},
				{
					"id": 750000123,
					"content": "这是你的愿望，还是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000124
					]
				},
				{
					"id": 750000124,
					"content": "（向着濒死的兽伸出手…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000125
					]
				},
				{
					"id": 750000125,
					"content": "你这是在做什么啦…咦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000126,
					"content": "#{NICKNAME}，你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000113,
					"content": "休息一下吧，了不起的大家伙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000108,
					"content": "它已经坚持了太久…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				}
