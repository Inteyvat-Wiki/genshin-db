			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫普瓦",
					"嘉维娅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640201,
					"content": "抓一只膨膨兽来对着它吐口水会有用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640202,
					"content": "认真的吗？你最近是不是压力有点大？精神还健康吗？是不是排班排太多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640203,
					"content": "我的精神很健康啊，我只是想看膨膨兽吐口水而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640204,
					"content": "你还是休个假吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉维娅"
				}
			]
		},
		{
			"id": 7406403,
			"completionStepIds": [
				7406403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406403",
							"2"
						],
						"stepId": 7406403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克兰茨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "欸？这不是克兰茨吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640302,
					"content": "你好，克兰茨，又见面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "…嗯？克兰茨在这里的话也就说，那个标记果然是你留下的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640306,
					"content": "唉，怎么会是你们啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640307,
					"content": "你们说的是什么事？我一点头绪也没有，要不你们去问问别人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640308,
					"content": "派蒙，看来我们找错人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#原来是我们找错人了吗…不对吧！{NICKNAME}，你可不要被他骗了，这里除了他根本就没有其他人了嘛，肯定是他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640312,
					"content": "好吧，你们赢了，是我干的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640313,
					"content": "唉，我还以为能靠这个找到熟人叙叙旧呢，没想到来的是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640314,
					"content": "靠这个找到熟人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640315,
					"content": "是啊。密图函是布托尔先生开发的技术，枫丹科学院里知道解读方法的人也不多。我也是因为曾经受到他不少照顾所以知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640316,
					"content": "可惜他去世得太早了，密图函的技术也不受管理层重视。所以我想如果还有能够解读密图函的家伙，我们应该有得聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640317,
					"content": "哦，我的意思不是和你们无话可说，只是我们之间可能缺少一些共同话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640318,
					"content": "别勉强自己了，确实无话可说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "你可真是诚实啊。我曾经有一个朋友，就和你一样有话直说，也曾经因此惹出过不少麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640320,
					"content": "不过现在回想起来，那真是一段快乐的时光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640325,
					"content": "话说回来，你们就为这件事找我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640326,
					"content": "差点忘了！是嘉维娅和莫普瓦拜托我们调查乱涂乱画的罪魁祸首来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640327,
					"content": "你自首吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "自首吧！拒捕的话我们不会手下留情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640329,
					"content": "欸…真的没有商量的余地吗？莫普瓦姑且不提，我可不想又落到嘉维娅手上啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640330,
					"content": "有没有一种可能，两位就对这件事睁一只眼闭一只眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640331,
					"content": "可是莫普瓦说了，梅洛彼得堡禁止乱涂乱画。违反规定是不好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640332,
					"content": "宽容一点看，密图函和墙上的那些文字也没有什么区别嘛，都是装饰，装饰而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640333,
					"content": "#这样吧，我和你们回去，但是要不要告发我，就看{NICKNAME}的决定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640334,
					"content": "当然，如果你选择帮我一把，让我不至于落入嘉维娅的魔爪之中，我也愿意提供相应的回报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640335,
					"content": "我把我的命运托付给你们了。我们这就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640321,
					"content": "那还真是抱歉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "哈，你要这么说我可接不下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640323,
					"content": "我也知道，按照常理，这时候应该说些「听你们讲讲旅途的经历或许也很不错吧」之类的客套话，不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640324,
					"content": "唯独这件事，我决定对自己诚实一点。我不想听外面的新鲜故事了，只想找人叙旧。所以，要道歉的是我才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "克兰茨"
				},
				{
					"id": 740640310,
					"content": "你要不看看这里除了你还有谁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "就是就是！少拿这种蹩脚的演技糊弄我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640304,
					"content": "老实交代，就是你小子干的对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640305
					]
				},
				{
					"id": 740640305,
					"content": "老实交代！那个标记就是你干的好事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "派蒙"
				}
			]
		},
