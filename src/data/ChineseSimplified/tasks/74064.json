						],
						"pointId": 6250
					}
				]
			},
			"dialogs": [
				{
					"id": 740640101,
					"content": "我说，要么想办法清除掉它，要么搞清楚到底是谁干的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640102
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640102,
					"content": "你说得倒是轻巧…我试了各种清洁剂都没办法清除它，再强效的…就只能试试浊水幻灵克星了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640103
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640103,
					"content": "浊水幻灵克星？你是想给墙上开个洞，让所有人都和鱼睡觉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640104
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640104,
					"content": "那就只能找到罪魁祸首再说了。话虽如此，我们现在可是一点线索也没有啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640105
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640105,
					"content": "怎么了？有什么我们能帮上忙的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640106,
					"content": "是这样，你们瞧，墙上的标记。梅洛彼得堡是禁止乱涂乱画的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640107
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640107,
					"content": "我们试了各种办法都没办法清除掉标记，如果至少能找到是谁干的这好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640108
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640108,
					"content": "仔细想想也不是全无线索，我好像听克兰茨提起过，在枫丹科学院有一种标记，需要用特殊的方法解读。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640109
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640109,
					"content": "你是说这个标记可能是他说的那种？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640110
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640110,
					"content": "当时我完全没兴趣，所以也没有继续追问。要是他人在这里，或许就能给出答案了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640111,
						740640113
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640111,
					"content": "说不定就是他本人干的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640112
					]
				},
				{
					"id": 740640112,
					"content": "的确不能排除这种可能。但如果真是这样，呵呵…他应该知道规矩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640115,
					"content": "#{NICKNAME}和派蒙，你们是见多识广的冒险家，你们有什么好办法吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640116
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640116,
					"content": "帮我们找到乱涂乱画的罪魁祸首，或者找到克兰茨让他来看看。唔…就当是正式的工作委托好了，我们会支付特许券作为报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640117
					],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640117,
					"content": "好吧，既然是正式的工作委托，那我们就想想办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640118,
					"content": "感谢。我们也再试试有没有可以清除标记的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉维娅"
				},
				{
					"id": 740640113,
					"content": "那去找他来看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640114
					]
				},
				{
					"id": 740640114,
					"content": "不知道他人在哪里…我今天还没见过他呢。而且，真的要拜托他吗？每次拜托他做点什么，我的自尊都会死去一点点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "莫普瓦"
				}
			]
		},
		{
			"id": 7406402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
