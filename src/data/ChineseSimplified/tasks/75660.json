			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"希诺宁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "呼…天气还不错，这次散心来得挺值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600102,
					"content": "嗯？这不是我们的骄傲「杜{RUBY#[D]希望}麦尼」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600103,
					"content": "好巧啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "向希诺宁说明了伊拉德和考核关卡的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "原来是这样…差点忘了，之前我确实帮了她一把，「回声之子」的考核关卡刚好也在这附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600107,
					"content": "一开始，伊拉德只请到了「赭石之灾」恩孔加和「塞提阿德的砂刃」阿姆鲁给参考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600108,
					"content": "不过那两位对「灵活机动」没什么兴趣，只顾着强调正面对决，提出的设计建议都有些偏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600109,
					"content": "帕加尔听说了这事，就来请我出主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600110,
					"content": "那么，现在的关卡是你的作品？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "差不多吧，我和帕加尔和伊拉德讨论了之后，还是决定略微修改一下我们部族的关卡构造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600112,
					"content": "现在，这些关卡更考验战士赶往有利位置，以及不断在战线支点转移的意识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600116,
					"content": "那就让我来接受你的考验吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "你的实力整个纳塔都有目共睹，无论是什么样的关卡，应该都难不住你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600119,
					"content": "喏，关卡就在那边，有兴趣的话就去试试看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600117,
					"content": "希望希诺宁的关卡不要太难…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "你这位名匠还真是什么都造…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "只是一些简单的装置，造起来也没什么困难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600115,
					"content": "要是忙活这么一次，「回声之子」就能不断涌现出新的强者，我也能清闲点，把手头堆积的单子慢慢搞定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 756600104,
					"content": "我接了伊拉德小姐的委托。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}