			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150501,
					"content": "没想到在休息的时候迎来了神社的贵客，呵呵，你是来探望我的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150502,
						120150505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150502,
					"content": "当然了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150503
					]
				},
				{
					"id": 120150503,
					"content": "油嘴滑舌，你的双眼不擅长说谎。你是有事情才来找我的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150504,
					"content": "不过嘛，这个回答，至少让我有了好心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150508
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150508,
					"content": "那么说吧，有什么事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150509,
					"content": "我们听说将军最近在闭门休养，然后稻妻外海的雷暴就不安分起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150510,
					"content": "传闻中雷暴和将军的意志有关，所以大家都在猜测，是不是将军最近的状态很不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150511,
					"content": "天领奉行的事务也需要她决断。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150512
					]
				},
				{
					"id": 120150512,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150513,
					"content": "算了，既然是你们，我也没什么好隐瞒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150514
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150514,
					"content": "将军大人，在那场战斗之后，心结难解，性情大变。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150515
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150515,
					"content": "欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150516,
						120150517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150516,
					"content": "性情大变？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150518
					]
				},
				{
					"id": 120150518,
					"content": "将军大人的力量本就日渐衰落，你那时候又下手太重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150519,
					"content": "落败对她可是无比沉重的打击，再加上我去见她的时候，又恰好忘记了带上三彩团子和轻小说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150520,
					"content": "我的旧友啊，因为没办法边吃甜点心边看小说，气得内心崩溃，又哭又闹，呜呜呜呜，好可怜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150521,
					"content": "哪有会被这种事气得又哭又闹的神啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150522,
						120150523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150522,
					"content": "我就不该相信你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150524
					]
				},
				{
					"id": 120150524,
					"content": "呵呵，这也不能都怪我。在我听来，你们所谓的「担心」，就和我的谎言一样，都是无稽之谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150525
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150525,
					"content": "那可是追求永恒的影，凡人的生命在她看来不过须臾，又怎么需要凡人担心她的安危呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150526,
					"content": "也就是说，她没事对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150527,
					"content": "具体情况我也不知道，她说了要静养，我又没什么重要的事，没必要去自找没趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150528,
					"content": "雷暴这件事，我也有所耳闻，单说「她的意志发生了转变」，并非没有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150529,
						120150530
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150529,
					"content": "那更该看看她了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150531
					]
				},
				{
					"id": 120150531,
					"content": "在将军静养的时候还能见到她的，在稻妻也只有我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150532,
					"content": "不过，我为什么要帮你这个忙呢？对见惯了金山银山，世事浮沉的我，又有什么能让我心动呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150533,
						120150534
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150533,
					"content": "这是为了稻妻人民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150535
					]
				},
				{
					"id": 120150535,
					"content": "哈哈，我很喜欢你的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150536,
					"content": "这是通行证明，交给看门的奥诘众，他就会放你们进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150537
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150537,
					"content": "谢谢你！神子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150538,
					"content": "虽然刚刚的问题是在开玩笑，但既然你回答了，就请不要只是说说而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150539,
					"content": "对了，通行证也要还给我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150534,
					"content": "这是为了影。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150535
					]
				},
				{
					"id": 120150530,
					"content": "就是怕她憋坏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150531
					]
				},
				{
					"id": 120150523,
					"content": "说不定真的有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150524
					]
				},
				{
					"id": 120150517,
					"content": "居然会这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150518
					]
				},
				{
					"id": 120150505,
					"content": "有事想和你打听。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150506
					]
				},
				{
					"id": 120150506,
					"content": "太冷淡了吧，好歹我也是你的救命恩人，就连两句寒暄都没有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150507,
					"content": "不过嘛，这也是你的魅力所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150508
					],
					"speakerTitle": "八重神子"
				}
			]
		},
