			"dialogs": [
				{
					"id": 120150701,
					"content": "将军大人正在静养，不见任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150702
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150702,
					"content": "我们有神子给我们的通行证明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150703,
					"content": "开什么玩笑，宫司大人从来不会把通行证交给别人，即便你们是名声显赫的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150704
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150704,
					"content": "正是因为将军大人对八重宫司的信任，才会允许这个通行证明的效力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150705
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150705,
					"content": "等等，这个…居然是真的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150706,
						120150707
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150706,
					"content": "没办法造假吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150708
					]
				},
				{
					"id": 120150708,
					"content": "我明白了，那按照将军大人的意思，确实不应该阻拦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150709
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150709,
					"content": "抱歉，请进吧。面见静养中的将军，请更加谨慎，不要做出任何冒犯的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "毅"
				},
				{
					"id": 120150707,
					"content": "那去找神子大人问问？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150708
					]
				}
			]
		},
		{
			"id": 1201508,
