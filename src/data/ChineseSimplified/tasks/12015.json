			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托马",
					"九条镰治",
					"一平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150201,
					"content": "如果雷暴一事，天领奉行不能提供帮助，那可能会有很大的风险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150202
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150202,
					"content": "不是我们不愿意出面，只是现在实在腾不出手来，还希望你们能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150203
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150203,
					"content": "对啊，所以才要多讨论，多商量嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150204
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150204,
					"content": "嗨，托马！遇到什么事了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150205,
					"content": "是你们啊，我们刚好聊到你们给稻妻留下的影响呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150206,
						120150207
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150206,
					"content": "真巧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150208
					]
				},
				{
					"id": 120150208,
					"content": "你们好，之前很感谢你们将柊小姐的信件送到我手上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150209
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150209,
					"content": "是两位的朋友啊。我是二少爷的小跟班，叫我一平就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150210
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150210,
					"content": "听起来你们好像有什么困扰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150211
					]
				},
				{
					"id": 120150211,
					"content": "嗯，三奉行以往的工作都是为将军大人收集信息，并执行她指派的任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150212
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150212,
					"content": "但最近将军大人宣布闭门休养，不会见任何人…换句话说，就没有人来为我们做决定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150213
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150213,
					"content": "将军大人需要安静下来整理心情，这我们都理解。但另一个情况是，几乎在同一时间，稻妻外海的雷暴紊乱了起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150214
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150214,
					"content": "我听说那是将军锁国意志的体现。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150215
					]
				},
				{
					"id": 120150215,
					"content": "没错，在漫长的时间里，雷暴的规模和形态从来没有变化。但现在，它好像有靠近稻妻岛屿的趋势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150216
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150216,
					"content": "欸？！她现在的意志是要摧毁稻妻吗！还是要找我们报仇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150217,
						120150220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150217,
					"content": "那也太小孩子气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150218
					]
				},
				{
					"id": 120150218,
					"content": "对哦，仔细想想，要找我们报仇的话，用普通的落雷就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150219,
					"content": "——也很可怕啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150223,
					"content": "哈哈，放心吧，我们担心的是将军大人，因为我们从来没见过她的意志产生动摇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150224
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150224,
					"content": "联想到璃月的神刚刚离开，我们都不觉得这是个好兆头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150225
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150225,
					"content": "现在很多人认为，雷暴的紊乱，是因为将军大人的身体出了问题。不见任何人，也是担心影响会扩大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150226,
						120150227
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150226,
					"content": "不是完全没道理的担心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150228
					]
				},
				{
					"id": 120150228,
					"content": "所以，在流言四起之前，我受小姐之托，来和天领奉行商量对策，以免混乱出现的时候应对不及。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150229
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150229,
					"content": "但话是这么说，天领奉行内部现在非常不安稳，「九条家」对其他家族已经失去控制力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150230
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150230,
					"content": "这又是怎么回事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150231,
					"content": "九条家由于成为了愚人众的帮凶，差点毁了稻妻，现在都在听候将军大人的审判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150232
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150232,
					"content": "谁都知道天领奉行要换人了，只不过将军大人的命令还没下来而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150233
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150233,
					"content": "简单来说，就是手下已经没人听话了，工作却还要照做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150234
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150234,
					"content": "如果孝行老爷的身体还健康的话，说不定还有办法，可是现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150235
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150235,
					"content": "都怪我能力有限，当初没能提前查明真相，也未能阻止父亲，现在代替父亲做家主的工作，也无法平息内乱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150236
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150236,
					"content": "别这么说，二少爷，你要打起精神来，至少坚持到大少爷回来，现在九条家可经不住半点变故了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150237
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150237,
					"content": "嗯，说的也是。大哥他现在也焦头烂额，不能给他添更多麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150238
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150238,
					"content": "那么，托马，刚刚的事我们改日再讨论吧，现在我要去见「鹰司家」的家主鹰司进，他是现在唯一有能力主持大局的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150239
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150239,
					"content": "嗯，去吧。早点处理好天领奉行里面的事，对我们都有好处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150240
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150240,
					"content": "那我也跟你去，二少爷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150241
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150241,
					"content": "不用了，我一个人就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150242
					],
					"speakerTitle": "九条镰治"
				},
				{
					"id": 120150242,
					"content": "唔，那也好…二少爷你路上小心，早点回来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150243
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150243,
					"content": "其实，无论是雷暴还是天领奉行的事，都是因为将军突然决定静养吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150244,
					"content": "这样下去，只怕会人心惶惶的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150245,
					"content": "那如果请她出来一趟呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150246
					]
				},
				{
					"id": 120150246,
					"content": "欸？这种事你们能做到吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150247
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150247,
					"content": "不知道，但可以试试看。至于她愿不愿意出来，就要看她的心情了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150248,
					"content": "听起来你们好像想到办法了，那我可以拜托你们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150249
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150249,
					"content": "所有人都很担心将军大人，如果能见到她，一切谣言都会不攻自破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150250
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150250,
					"content": "我试试看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150251
					]
				},
				{
					"id": 120150251,
					"content": "#感激不尽，{NICKNAME}，又欠你的人情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150252
					],
					"speakerTitle": "托马"
				},
				{
					"id": 120150252,
					"content": "闭关的情况下有可能见到将军的人，只可能是她了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150253,
					"content": "那么，出发，去鸣神大社！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150227,
					"content": "雷暴的紊乱一定事出有因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150228
					]
				},
				{
					"id": 120150220,
					"content": "你是不是在害怕她啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150221
					]
				},
				{
					"id": 120150221,
					"content": "不是啊，手下败将而已，有什么好怕的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150222,
					"content": "但有点担心她会生气，嗯，稍微有点担心而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150207,
					"content": "这是调侃吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150208
					]
				}
			]
		},
