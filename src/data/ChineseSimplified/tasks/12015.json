			},
			"dialogs": [
				{
					"id": 120150802,
					"content": "你们是如何闯进来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150803
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150803,
					"content": "擅闯此地者，应立刻抹除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150804
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150804,
					"content": "等下，是我们啊！为什么又是一副看到敌人的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150805,
					"content": "我们应该已经和好了吧，进来的手段也非常正当！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150806,
					"content": "不行，使用武力，是被禁止的事项。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150807
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150807,
					"content": "总之，回去吧，休要干扰我的修养。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150808,
						120150809
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150808,
					"content": "「被禁止」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150810
					]
				},
				{
					"id": 120150810,
					"content": "不必知晓，这就是我追求静养时的状态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150811
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150811,
					"content": "#唔，{NICKNAME}，你有没有感觉怪怪的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150812,
						120150813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150812,
					"content": "人偶也需要静养吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150814
					]
				},
				{
					"id": 120150814,
					"content": "此身并不需求休憩，但我终归是「内在」的协助者，静养既是她的意志，那么随她所愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150815
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150815,
					"content": "我懂了，「静养」原来是里面的影在干涉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150816,
					"content": "可是，为什么呢？将军就算在外面行动，应该也打扰不到「一心净土」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150817,
					"content": "她有个那么大的庭院，已经是最适合休养的环境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150818,
					"content": "随她所愿，此外无可奉告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150819,
						120150820
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150819,
					"content": "大家都很担心将军。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150821
					]
				},
				{
					"id": 120150821,
					"content": "不可。现在的我，即便外出也无事可做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150822
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150822,
					"content": "不愿意处理事务，亦是因为无法处理任何事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150823
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150823,
					"content": "嗯？这又是怎么回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150824,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150825
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150825,
					"content": "都是被禁止的事项。唉，别再让我说话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150826
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 120150826,
					"content": "#怎么办，{NICKNAME}，感觉对话进行不下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150827,
						120150828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150827,
					"content": "是不是生病了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150829
					]
				},
				{
					"id": 120150829,
					"content": "原来是你们，许久不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150830
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150830,
					"content": "将军现在有诸多不便之处，直接进来见我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				},
				{
					"id": 120150828,
					"content": "是不是坏掉了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150829
					]
				},
				{
					"id": 120150820,
					"content": "大家想见你一面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150821
					]
				},
				{
					"id": 120150813,
					"content": "她以前是这种态度吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150814
					]
				},
				{
					"id": 120150809,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150810
					]
				}
			]
		},
		{
			"id": 1201509,
			"completionStepIds": [
				1201510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201510",
							"2"
						],
						"stepId": 1201510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150901,
					"content": "吓死我了，不要这么突然就把我们拉进来啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150902,
					"content": "又不是第一次了，有什么好慌张的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150903
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150903,
					"content": "外面的将军是不是坏掉了啊？你要不要找个时间修理一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150904,
					"content": "不用担心，那是我本人所为。将军的很多功能，都被我暂时禁用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150905
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150905,
					"content": "现在的将军不能处理事务，也不能作为「我」出现，于是就干脆宣布「闭门静养」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150906,
						120150907
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150906,
					"content": "怪不得将军一直在说「禁止」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150908
					]
				},
				{
					"id": 120150908,
					"content": "我说过，有关稻妻的「永恒」，我需要再好好想想，思考需要时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150909
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150909,
					"content": "但将军仍然在运行原来的规则，在我想清楚之前，不能容许将军继续犯错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150910
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150910,
					"content": "将军没有像开关一样的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150911,
					"content": "没有，创造的时候就没考虑要关闭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150912
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150912,
					"content": "而且正好相反，当时的我已经考虑到了未来的我可能会修改将军的运行规则，这也是不利于「永恒」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150913
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150913,
					"content": "对自己同样严苛啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150914
					]
				},
				{
					"id": 120150914,
					"content": "所以将军对于法则的修改有非常完备的防御机制，这也是应对突发情况的保险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150915
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150915,
					"content": "对我来说，在我想清「永恒」的形态之前，暂时禁用某些功能，比直接修改人偶的法则更加有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150916
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150916,
					"content": "那我大概明白了，稻妻外海的雷暴紊乱，也是因为将军的某些功能被停掉了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150917,
					"content": "雷暴紊乱？这我是第一次听说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150918
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150918,
					"content": "欸？事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150919,
					"content": "嗯，你们说的雷暴，原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150920
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150920,
					"content": "不会是很棘手的状况吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150921,
					"content": "操作失误啦，这种事难免的，之后我调整一下将军就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150922,
						120150923
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150922,
					"content": "…虚惊一场。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150924
					]
				},
				{
					"id": 120150924,
					"content": "别这么看着我，这种操作我以前也没做过，将军的构造是很复杂的，只要调整就难免出问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150925
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150925,
					"content": "对，我可不是找借口，事实就是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150926
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150926,
					"content": "没关系，不用在意啦，能解决就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150927,
					"content": "那你对「永恒」的思考有进展吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150928
					]
				},
				{
					"id": 120150928,
					"content": "还是老样子。虽然看到了前进的方向，但矛盾依旧存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150929
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150929,
					"content": "不过，也不用太着急。若是不够认真谨慎，只是为了得出结论而得出结论，那就本末倒置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150930,
						120150931
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150930,
					"content": "跟我去换个心情吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150932
					]
				},
				{
					"id": 120150932,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150933
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150933,
					"content": "大家只要见到将军还健康，外面的猜测和谣言就都会不攻自破的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150934,
					"content": "而你如果换个地方，换个心情，也可能会有新的思路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150935,
					"content": "是让我，离开「一心净土」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150936,
						120150938
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150936,
					"content": "或许对大家都是有利的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150937
					]
				},
				{
					"id": 120150937,
					"content": "嗯，也对，毕竟现在的将军无法代我处理事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150940
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150940,
					"content": "那好吧，出去转一转好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150941
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150941,
					"content": "既然是转换心情，你们称呼我为「影」就好。我不喜欢太死板的称呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150942
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150942,
					"content": "欸？不过现在在我们眼前的，是影的意识对吧？意识可以离开这个地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150943
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150943,
					"content": "这个我自有办法，我可不会主动将自己囚禁起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150944
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150944,
					"content": "好的，那我就不担心啦！接下来我们就是你的导游！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150945
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150945,
					"content": "导游？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150946
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150946,
					"content": "就是帮你介绍现在的稻妻，告诉你什么好吃什么好玩的人！好啦好啦，出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150938,
					"content": "你有很长时间没有出去过了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150939
					]
				},
				{
					"id": 120150939,
					"content": "对我来说这并非必要之事，但有你的邀请…换个心情可能也不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150940
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150931,
					"content": "出去走走怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150932
					]
				},
				{
					"id": 120150923,
					"content": "好随意的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150924
					]
				},
				{
					"id": 120150907,
					"content": "原来全是你做的啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150908
					]
				}
			]
		},
