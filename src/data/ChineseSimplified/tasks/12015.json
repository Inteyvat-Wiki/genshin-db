			},
			"dialogs": [
				{
					"id": 120150401,
					"content": "你们是来见八重大人的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150402
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 120150402,
					"content": "她刚刚还在里面，但八重大人的行踪一向神秘，随时都可能离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150403
					],
					"speakerTitle": "稻城萤美"
				},
				{
					"id": 120150403,
					"content": "总之你们进去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻城萤美"
				}
			]
		},
		{
			"id": 1201505,
			"completionStepIds": [
				1201505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201505",
							"2"
						],
						"stepId": 1201505,
						"stateName": "QUEST_STATE_UNFINISHED"
