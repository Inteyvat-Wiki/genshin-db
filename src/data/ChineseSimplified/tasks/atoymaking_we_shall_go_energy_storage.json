			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "怎么样，素材收集器的使用还顺利吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950302,
					"content": "挺顺利的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "这个「素材收集器」也是我的得意之作，不管是像之前那样收集原材，还是像现在这样储存元素力，都能巧妙地做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950304,
					"content": "其实我也有把这个「素材收集器」重新命名的想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950305,
					"content": "我觉得「素材收集器」就很不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950306,
					"content": "确实。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "是嘛，我倒是觉得这个名字的定语含量有些偏少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950309,
					"content": "好，把「素材收集器」交给我吧，这次也是一样，试作工序需要一些观察，尤其涉及到了元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950310,
					"content": "估计得等「大工机」里的元素反应稳定下来以后才能继续下一段工序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950311,
					"content": "到时候再拜托你们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950307,
					"content": "非常合适。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
