			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "伯特兰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950102,
					"content": "#是{NICKNAME}和派蒙啊，来得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950103,
					"content": "我的独一无二…我的「大工机」已经处理完你收集到的素材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950104,
					"content": "处理的结果如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "那毕竟是我制作的机器，怎么可能有问题！别看我这样，我的技术可是在枫丹磨练出来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950106,
					"content": "我好歹也是枫丹人，这世上没人比我们更懂精密仪器的制作和操作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950107,
					"content": "上次只不过是准备仓促，又没有人帮忙收集试运行的素材才会导致产出的玩具爆炸，这次就不一样了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950108,
					"content": "是嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950109,
					"content": "如果这次玩具还是爆炸了，那跟着爆炸的就会是我最后的存款和下半生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950110,
					"content": "你就算不相信我，也要相信我赌上下半生的觉悟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950111,
					"content": "我之前可没觉得玩具制造商是需要这等觉悟的职业…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950112,
					"content": "好了好了，接下来就要进行下一道工序了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950113,
					"content": "以防万一，我就在这里问一下你们，三道工序里，我们已经完成的是「原材收集」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950114,
					"content": "那下面的工序是「核心收集」还是「充能收集」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950115,
					"content": "「核心收集」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "恭喜你…答错了。要是你真的去收集核心，那毁灭我下半生的功劳就将有你的一份了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950117,
					"content": "正确答案是「元素充能」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950121,
					"content": "总之…所谓的「元素充能」，就是带着「素材收集器」处在被元素影响的状态中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950122,
					"content": "比如我想收集水元素，就带着「素材收集器」站在河流之中一段时间，我想收集雷元素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950123,
					"content": "就得挨雷劈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950124,
					"content": "哎呀，你们可是冒险家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950125,
					"content": "我相信你们作为冒险家的体质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950126,
					"content": "相信的居然是体质吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "其实接触元素生物是最好的办法，我之前在稻妻旅游的时候就标记了三处地点，经常有元素生物出没…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950128,
					"content": "本来我想如果实在没有助手，就自己偷偷坐船去这些地方接触元素生物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950129,
					"content": "那也太危险了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726950130,
					"content": "现在不是有你们在嘛，你们去这些地方碰碰运气，看看有没有元素生物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950131,
					"content": "「元素充能」就交给你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950118,
					"content": "「充能收集」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "哈哈，虽然看上去好像对了，但其实不是「充能收集」而是「元素充能」啦，没想到我给出的两个选项都不是正确答案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950120,
					"content": "他笑得真的好让人生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "派蒙"
				}
			]
		},
