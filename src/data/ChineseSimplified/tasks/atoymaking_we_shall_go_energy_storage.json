			"dialogs": [
				{
					"id": 726950201,
					"content": "嗯…要是素材收集器每完成一次工序就要将素材导入机器，一次制造就要往返三次，收集素材就变得太麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "伯特兰"
				},
				{
					"id": 726950202,
					"content": "我得想想有什么改善的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特兰"
				}
			]
		},
