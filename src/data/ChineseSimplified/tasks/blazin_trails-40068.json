				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶",
					"莫娜",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "看起来是正常的岛屿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680302,
					"content": "…风里似乎有灼烧的气味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680303,
					"content": "呃…我的水占盘变明亮一点了，可还是看不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680304,
					"content": "喂！看我发现了什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680305,
					"content": "这东西…该说它是一面鼓，还是一株植物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680306,
					"content": "是植物构成的乐器？那看来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680307,
					"content": "辛焱，这里该不会是跟你有关的岛屿吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680308,
					"content": "唔，难道这是给我准备的乐器？那我先敲一敲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "辛焱"
