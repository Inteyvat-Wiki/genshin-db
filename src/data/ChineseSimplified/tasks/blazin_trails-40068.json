			"trigger": {
				"objectNames": [
					"枫原万叶",
					"辛焱",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "起床啦——！太阳晒到屁股上啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680202,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "派蒙，我是仰面朝上睡的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "好吧，那太阳晒到肚子上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}，昨晚睡得好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680206,
					"content": "马马虎虎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "大家好像都跟你差不多。今天我起得最早，四处逛了逛，摘了水果给大家当早餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680209,
					"content": "为了等你起床，我可是一直忍着没先吃哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680210,
					"content": "在大家的陪伴下享用了水果早餐，期间，众人闲聊起来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "咦？菲谢尔一早就跑了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680212,
					"content": "嗯，她似乎不太愿意跟我们一起行动，说是另有冒险家的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680213,
					"content": "太假了吧！明明说是来光复幽夜净土的，怎么又给冒险家协会打工去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680214,
					"content": "好了…派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "瞧她的样子，应该是有心事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680216,
					"content": "我们按原计划派出莫娜关怀她，没想到，她居然说莫娜不懂冒险家的工作，不能跟去冒险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680217,
					"content": "菲谢尔为了独处，连幽夜净土这个借口都不用了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680218,
					"content": "可见她遇到了不小的难题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680219,
					"content": "唉，我身为朋友，很想帮帮她。不过有一句话她说对了，今天我们会去其他岛屿探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680220,
					"content": "欸？是这样吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "大家全票通过的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680222,
					"content": "我都没参加，怎么能算全票！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "这个啊，刚才派蒙替你投了。她说，你和她是一伙的，你在哪儿她就在哪儿，反过来也一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680224,
					"content": "嘿嘿，你可是冒险家，肯定会去的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680225,
					"content": "（派蒙这家伙，好吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "菲谢尔建议我们一起行动，她自己还有其他想调查的事，让我们不用担心，她忙完就来跟我们会合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680227,
					"content": "别看她平时那样，怎么说都是个经验丰富的冒险家，我想，我们应该相信她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400680228,
					"content": "跟菲谢尔认识不久，我的意见只是冒昧猜测而已。不过我认为…她的矛盾在于自身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680229,
					"content": "好像还挺准的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680230,
					"content": "与他人的矛盾，不是解决就是放弃，唯独跟自己，永远不能轻易放下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680231,
					"content": "…我也有过那样的时期，很理解她。虽不知道她在苦恼什么，但现在她需要独处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400680232,
					"content": "我也同意，就是可惜了今天的冒险之旅…大家一起才有意思啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680233,
					"content": "辛焱太有进取精神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400680234,
					"content": "#啊对了，还没告诉你们呢。今天早上，北边那座岛屿出现了幻象，等{NICKNAME}吃完早餐，我们就去调查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400680207,
					"content": "不错哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
			"id": 4006803,
			"completionStepIds": [
				4006803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
