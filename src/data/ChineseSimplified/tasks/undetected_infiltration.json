			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彦博",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "真是精彩！感谢你的帮助，对了，这里是说好的奖励。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540702,
					"content": "好耶！好多摩拉！欸…你什么时候把衣服也换了…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540723,
					"content": "你们打架的时候呀…咳咳，呃，我是说，那不重要…为了防止你们打得兴起，又把我们误伤一遍，把制服换回来还是有必要的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540703,
					"content": "千岩军永远感谢你们的帮助。啊，遵照我们的约定，请四处看看有没有你需要的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540704,
					"content": "呃…我是说，除了那些我们正在查封的赃物以外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540705,
					"content": "恭喜你啦，任务圆满完成。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "哈哈，当然，幸好有你们帮忙，我们才能这么顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540709,
					"content": "嗯，我的意思是…只要别像这些小贼一样，凡事妄图走捷径，我们就不会找你的麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540710,
					"content": "哼，我们才不是那样的家伙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540711,
					"content": "哈哈，说得也是呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540712,
					"content": "唉，话说回来，像你这样会使用元素力的人，不论行善或是作恶，都是不容小觑的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540713,
					"content": "我们需要几个星期或者几个月才能完成的任务，对你们来说可能是轻而易举的事…而如果把元素力用来作恶的话，也会以很小的代价，造成恐怖的破坏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540714,
					"content": "所以呀，我也并不觉得没有「神之眼」是一件坏事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540715,
					"content": "我曾见过有些人，为强求非人的力量而不惜付出自身生命的代价，最终却只是做了别人的工具、傀儡，你说说，这值得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540716,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "这世上还是没有神之眼的无力之人占了多数，而真正能够理解他们、保护他们的也多是同样的普通人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540718,
					"content": "身为这样的普通人，能够为保护大多数人而履行职责，不得不说是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540719,
					"content": "如果哪天，不再有人获得神之眼，甚至守护璃月港的仙人也逝去了…我想我也不会放弃这份职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540720,
					"content": "啊，抱歉…自言自语扯了很多没用的话，留你太久了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540721,
					"content": "好了，我们还需要查验和登记赃物，就不多闲聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540722,
					"content": "我代表同僚再次感谢你的帮助，愿你今后的旅途一路顺利。千岩牢固，重嶂不移。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540707,
					"content": "这下我们不用受牢狱之灾了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
					"content": "当然，你们是协助千岩军…唔，受千岩军协助破获走私大案的首功英雄，我们怎敢请你进大牢呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "彦博"
				}
			]
		},
