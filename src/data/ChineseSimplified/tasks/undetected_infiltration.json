			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彦博",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "停手，停手！请听我们解释！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540102,
					"content": "你们不是盗宝团吗？乖乖去自首就好啦，有什么好解释的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540103,
					"content": "#千岩军，层岩巨渊辖区，中队长彦博。很高兴见到你们，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540104,
					"content": "呃…和…很有名的小飞侠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540105,
					"content": "喂，怎么到我这里就忘了名字啦！我是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540106,
					"content": "哈哈…失礼、失礼。实在不好意思…但我们大概产生了一点小误会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540107,
					"content": "等等…你们不是盗宝团？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "当然不是，恰恰相反。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540112,
					"content": "咳咳，这么说吧。这处作坊以前确实是盗宝团占据的据点没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540113,
					"content": "工人撤走以后，那些见缝就钻的家伙就进来了…一开始还只是盗采矿石和琉璃晶砂搞走私，和我们的巡逻队玩捉迷藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540114,
					"content": "后来他们贼胆越来越大，居然敢占据矿工留下的旧仓库，自己打造廉价的破烂首饰拿出去卖了！唉，真是…让人看了心疼呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540115,
					"content": "让人看了心疼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "这么粗糙的首饰只能骗骗第一次来璃月的游客，或者没见识的读书人吧…要想以低价打入璃月的市场？哼，恐怕是要砸牌子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540117,
					"content": "他们本来也没有牌子呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540118,
					"content": "哈哈，你说的没错。拿这些东西牟利发财，也太没品位了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540119,
					"content": "所以我们来了，收拾了原来占据这里的盗宝团，装扮成他们的样子潜伏在了这里…嗯，已经是前段时间的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540120,
					"content": "现在我们又摸清他们的头目们与「愚人众」的一支部队有联络，疑似在交易什么危险物资。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540121,
					"content": "关于愚人众与盗宝团的联络…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "尽管之前我们挫败了愚人众的图谋，但他们在璃月的野外仍存在一些残党活动…这些家伙的专业性和战斗力都不容小觑，对我们来说极其危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540123,
					"content": "假如盗宝团和他们沆瀣一气，勾结起来对抗我们的话…会是一个很让人头疼的安全问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540126,
					"content": "总之，我们万事俱备，只欠总攻。只需要把他们一锅端，就能搞清楚他们在捣什么鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540127,
					"content": "结果没想到我们来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540128,
					"content": "唉…我们知道你们很厉害，但没想到这么能打…现在可好，你们把我的队伍打趴下了一大半…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540129,
					"content": "当然啦，我们驻扎在这里另有一个原因是…此处恰好坐落了一座「七星阵法」的「磐键」。我们可不能让它落在盗宝团这群心术不正的家伙手里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540130,
					"content": "唔…抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "哈哈哈，没关系！我们没看出是你们，是我们的过错…此前就有命令下来要我为你们让路，结果谁能想到你们这么快就来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540134,
					"content": "哇…千岩军的大哥原来这么好说话的！那我们可以走了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540135,
					"content": "我不怪你们，不代表璃月的律法会放过你们。嘿嘿，实在抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540136,
					"content": "欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540137,
					"content": "下次请把话说完！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "嗯…让我看看：寻衅滋事；干扰千岩军公务；蓄意破坏「七星阵法」；再加上一个…破坏既有现场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540140,
					"content": "再减去千岩军当事人的谅解…如果一切顺利的话呢，恭喜二位客人，可以在璃月港多住五到十年了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540141,
					"content": "欸？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540142,
					"content": "我可以请律师吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "唔…请给我们律师名单！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540146,
					"content": "咳咳…但是…！请听我把话说完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540147,
					"content": "但是，合法市民或国外旅客可以运用任何合法手段协助千岩军办案，并且获得应得的奖励或补偿…这也是璃月律法的规定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540148,
					"content": "所以两位英雄，刚才那一架可不是白打的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540149,
					"content": "帮助你们的话，我们会获得什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "查封的赃物是不能随便动的，但如果两位愿意帮忙的话，抓捕过程中偶遇的财物…唔，比如「盗宝团的秘密宝藏！」之类的，由你们处理就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540151,
					"content": "另外呢，我和同僚们也凑了些摩拉，希望两位不会嫌弃…唉，毕竟这种意外而来的「帮助」，事先并没有算进预算里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540152,
					"content": "唔…也就是说，我们不用坐大牢，还有宝贝拿！对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540153,
					"content": "是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540154,
					"content": "好！那我们就勉为其难地答应啦！请你带路吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540155,
					"content": "等等…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "好了，就请两位英雄不必客气啦…我先去集结点待命了，还望你们一定跟上来，不然我们可要提前行动咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540158,
					"content": "对呀，我们快跟上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540159,
					"content": "喂…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "快点啦，我们这是在协助千岩军办案呢！而且不是也有好多摩拉拿嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540156,
					"content": "我还没…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "早知道不如下手更重一点…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "哼，我们只不过打了看起来很讨厌的人而已啦！谁让你们都穿着盗宝团的衣服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710540138,
					"content": "分明是故意的吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "这么说，我们真的打错人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "嗯，不过我不怪你们的。我们有错在先啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540124,
					"content": "关于危险物资…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "我的线人说那些愚人众在用大批摩拉和军用物资，向盗宝团购买什么东西…但他只发现了食物和生活物品，或许是障眼法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540109,
					"content": "你们是…千岩军？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "哈哈，抱歉事先没来得及解释…我们还以为你是来搞破坏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540111,
					"content": "唔…某种意义上也没错吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
