			"dialogs": [
				{
					"id": 715350401,
					"content": "喔？你果然心灵手巧啊，这张「祝柬」真好看，谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350402,
					"content": "这封「祝柬」就算是你送我的，现在我手头没带宝贝，等回了须弥之后，给你寄回礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350403,
					"content": "我还要再做一封。等坎蒂丝来了，再把项链和「祝柬」一起送出去，她一定会很高兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350404,
					"content": "不过说起来，都过这么长时间了，坎蒂丝怎么还没来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				}
			]
		}
