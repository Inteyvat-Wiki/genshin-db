				]
			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#{NICKNAME}，真巧，你也来海灯节玩么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350202,
					"content": "你正在做「祝柬」么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "是啊，我想要做一张「祝柬」送给坎蒂丝，可是一直没做出满意的，正打算再做一张新的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350204,
					"content": "坎蒂丝没来么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "她要来，不过…还要过一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350206,
					"content": "本来她都没答应和我一起来璃月，说自己还要守着村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350207,
					"content": "我和她说，一年到头了，就让自己轻松一下，我正好要护送一支商队来璃月，干脆就和我一起来璃月过海灯节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350208,
					"content": "要是她不放心村子，我就让团里的弟兄们帮她守着村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350209,
					"content": "可坎蒂丝就是不答应，最后还是村里的人劝了她好久，她才答应给自己放放假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350210,
					"content": "不过，她还要亲自安排一些事情，等一切安排妥当后，她才会过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350211,
					"content": "没办法，商队也不会等我们…所以我就先行来了璃月，在这里等着她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350212,
					"content": "这不，我想着先给她买点礼物，可是璃月的好东西太多，我都快挑花眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350213,
					"content": "最后，我挑了一条项链，又听说璃月人在海灯节的时候，送礼都要附上一张特别的「祝柬」，所以我就打算给自己设计一张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350214,
					"content": "结果…就和之前说的一样，做来做去都不满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350215,
					"content": "#正好你来了，{NICKNAME}，你懂得多，能给我点做「祝柬」的建议么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350216,
					"content": "没问题，让我研究一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
