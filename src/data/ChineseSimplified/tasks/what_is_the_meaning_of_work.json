			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "紫金渔鸥啊，紫金渔鸥。我理解你们肚子很饿，但我也没有吃饱啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110102,
					"content": "算了。如果这样能让你们开心，也挺好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110103,
					"content": "你在干什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "旅行者？真高兴见到你。如果是来找我办事的话，那你得再等等了，我的薯条还没吃完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110105,
					"content": "我不是来办事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "这样啊。那就好，我得抓紧时间赶紧吃完薯条了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110108,
					"content": "这就是我的正餐。今天还要和洛耶茨先生外出办事，只能快速吃点这个凑合了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110109,
					"content": "我不太习惯在沫芒宫里吃东西，所以一般都会去外面，找个安静点的地方快速吃完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110110,
					"content": "但今天…不知道这群紫金渔鸥发什么疯，一个劲地冲过来抢我的薯条，无论吃多少都不满足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110111,
					"content": "因为还有很多紫金渔鸥想要吃嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "好吧，这么说也有道理。但我总不能真让每一只紫金渔鸥都吃到薯条吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110114,
					"content": "这不是你的薯条吗？就别这么理所当然地让给紫金渔鸥吃掉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110115,
					"content": "不然，你不就要饿肚子了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110116,
					"content": "怎么感觉你有点丧气？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "什么？我才不…好吧，确实有一点。什么都没法逃过你的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110119,
					"content": "我只是不知道，我工作的意义到底是什么。虽然成天在复律庭忙个不停，但也没有做成什么实质成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110120,
					"content": "既没有帮助到某个人，也没有让谁获得便利。虽然洛耶茨先生反复说，我们的工作很重要，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110121,
					"content": "我只是每天坐在打字机前，敲啊，敲啊，敲个不停。但这又有什么用呢？我还不如再弄丢一次键帽，这样伊丝黛莱还能赚一笔小钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110122,
					"content": "抱歉，我不该说这么多的。我只是有点找不到方向，任何事的方向都找不到，也许…也许我还需要更多时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110123,
					"content": "总之，先吃饱再说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "你说得对。但以现在的时间…我肯定来不及去新买一份薯条了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110126,
					"content": "算了，薯条就分给紫金渔鸥们吧。等我和洛耶茨先生办完事，再去买点东西吃好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110127,
					"content": "也就…呃…半天左右就能把事情办完，要不了太多时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110128,
					"content": "这么长时间不吃东西，身体真的撑得住吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110129,
					"content": "这些紫金渔鸥交给我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "这…这是不是太麻烦你了？就这么一份薯条，不用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240110132,
					"content": "好好吃东西啦。无论怎么说，都不能饿着肚子工作呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240110130,
					"content": "我去解决这些紫金渔鸥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "总之，先解决那些紫金渔鸥的问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "你的状态…有点不太好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "毕竟…并不是所有紫金渔鸥都吃到薯条了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "你怎么在这里吃薯条？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
