					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "紫金渔鸥啊，紫金渔鸥。你们吃完这些薯条之后，就快点走吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111302,
					"content": "现在情况怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "不，一点用也没有。当紫金渔鸥朝着我的薯条扑来的时候，它毫不犹豫地冲到了我的身后，躲起来瑟瑟发抖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111305,
					"content": "唉，这也不能怪它们。这种小狗从生下来就只有一种责任，那就是爱别人和被别人爱…它从来没学习过如何发起攻击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111306,
					"content": "我们也有这种责任啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "也许吧。但在某些情况下，爱会被认为是一种权力。只要沾上权力这两个字，事情总是会朝着糟糕的方向一路狂奔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111308,
					"content": "抱歉，我说得太多了。这几天我处理了好多件和情感纠纷有关的事情，思维暂时还没有缓过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111309,
					"content": "唉，现在我的当务之急，是如何安全地吃完这一份薯条…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111303,
					"content": "小狗派上用场了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
