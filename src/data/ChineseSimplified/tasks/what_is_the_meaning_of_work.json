			},
			"dialogs": [
				{
					"id": 240111401,
					"content": "我会把它们全部赶走的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "行，但你能…尽量只是把紫金渔鸥们赶走吗？它们就是想吃点薯条，没什么其他的恶意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111403,
					"content": "好吧，这对我来说还挺有恶意的，但也并不是什么大事，所以…拜托你了，只把它们赶走就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
