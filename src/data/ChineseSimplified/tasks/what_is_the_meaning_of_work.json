			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "呃…换个地方吃？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "我暂时也找不到什么好地方吃东西了。要是离沫芒宫太近，说不定就会被同事撞见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111203,
					"content": "然后，他们就会拉着我，一边吃饭一边谈工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111204,
					"content": "要是离沫芒宫太远，我又不能准时回到办公室里，说不定会错过什么重要事务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111205,
					"content": "同时考虑到这两点，也只有这里能让我一个人安安静静地吃一顿饭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
		{
			"id": 2401113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
