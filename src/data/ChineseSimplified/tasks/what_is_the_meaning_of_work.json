				"points": []
			},
			"dialogs": [
				{
					"id": 240111101,
					"content": "你养一只狗试试？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "你的意思是…让我用狗来驱散那群紫金渔鸥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240111103,
					"content": "这想法倒是不错，我也许能找人借一只…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
		{
			"id": 2401112,
			"completionStepIds": [
				2401104,
				2401108
			],
