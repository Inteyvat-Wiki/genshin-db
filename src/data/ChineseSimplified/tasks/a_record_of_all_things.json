			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110240101,
					"content": "之前对你提过，孤云阁之下，镇压了很多旧日的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240102
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240102,
					"content": "如今仙众已将璃月交给凡人，而赫乌莉亚的时代，是更久远的过去。她留下的「盐盏」与「盐尺」，不应该回到璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240103
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240103,
					"content": "让它们留在这里，既是沉眠，也是返乡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240104
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240104,
					"content": "所以钟离要我做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240105
					]
				},
				{
					"id": 110240105,
					"content": "我亲手终结了一个时代。我一直在想，如何记录那些…被我终结的历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240106
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240106,
					"content": "历史可以记录，但历史并不可靠，这次的事也证明了这点。时间拥有强大的力量，历史会在岁月中扭曲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240107
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240107,
					"content": "我需要找到更好的「记录」，才能铭刻真实的历史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240108
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240108,
					"content": "刻石曾是一种久远的「记录」。但看似不变的磐石、看似不变的世界与我…或许也都会在某一天消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240109
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240109,
					"content": "钟离…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110240110,
					"content": "所以，旅行者，我想到了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240111
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240111,
					"content": "你是远渡重天、跨越星海之人。把历史刻在你的记忆里，就可以在未来某日，随你一同前往别的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240112
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240112,
					"content": "身为旅行者的你，只要能够「记录」，那么，提瓦特的时代与历史，就获得了一种「存在的备份」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240113,
						110240115
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240113,
					"content": "原来这才是找我同行的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240114
					]
				},
				{
					"id": 110240114,
					"content": "任重而道远啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110240118,
					"content": "那么，接下来，就是将「盐盏」与「盐尺」投入海中的时刻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240119
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240119,
					"content": "啊？为什么要扔进海里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110240120,
					"content": "刚才我说过吧？这里镇压了很多旧日的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240121
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240121,
					"content": "也包括被「群玉阁」重锁深海的「漩涡之魔神」，奥赛尔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240115,
					"content": "原来不是为了让我找宝箱啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240116
					]
				},
				{
					"id": 110240116,
					"content": "哈哈哈…祝你离开提瓦特以后，在星海之间也能捡到宝箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240117
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240117,
					"content": "我有「财富之神」的别号，所以这句话是有效力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "钟离"
				}
			]
		}
	]
}