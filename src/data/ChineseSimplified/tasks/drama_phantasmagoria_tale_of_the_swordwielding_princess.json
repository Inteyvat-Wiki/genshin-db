			"dialogs": [
				{
					"id": 790260101,
					"content": "欢迎！欢迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260102,
					"content": "欢迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260104,
					"content": "#您就是大名鼎鼎的{NICKNAME}！还有最好的伙伴——派蒙阁下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260105,
					"content": "哇！你怎么知道我们的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790260106,
					"content": "岛上的贵客，我当然知道，因为我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260107,
					"content": "你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790260108,
					"content": "我就是大名鼎鼎的暮夜剧团团长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260109,
					"content": "原来真的有人自称大名鼎鼎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "虽然你说自己大名鼎鼎，可是我们没听说过你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790260111,
					"content": "没关系！现在两位已经听说了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260112,
					"content": "经过紧锣密鼓的筹备，我们的舞台剧「王女执剑记」就要首演了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260113,
					"content": "演出一共五幕，每幕分为上下两场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260114,
					"content": "贵宾们来得正是时候！马上序幕就要开演！请您就坐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260115,
					"content": "后台还有些事情需要处理，且容我先行告退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "暮夜剧团团长"
				},
				{
					"id": 790260116,
					"content": "暮夜剧团，倾力打造的舞台剧，马上开幕，请您欣赏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "暮夜剧团团长"
				}
			]
		}
	]
