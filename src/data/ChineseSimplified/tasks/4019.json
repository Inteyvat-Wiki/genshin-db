			"dialogs": [
				{
					"id": 40190101,
					"content": "护士长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME}，派蒙，你们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190103,
					"content": "还好吗？没有伤到哪里吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190104,
					"content": "请放心，我们很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "没事哦！你们呢？发生那么大的事，乱成一团，没出太大问题吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190106,
					"content": "少数人受了点外伤，整体还好。那维莱特先生过来了一趟，多亏他我们才能暂时压制住危机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190107,
					"content": "也要谢谢你们帮的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190108,
					"content": "那维莱特怎么知道这里需要他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190109,
					"content": "那维莱特先生与水元素的呼应很强，涨水时海洋产生了巨大的波动，他能感受到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190110,
					"content": "我给犯人包扎时还遇到那对炸弹兄弟念叨你们俩头也不回的跑去楼下了呢，看见你们没事我才能放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190111,
					"content": "不赶时间的话，请在这里多留几天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190112,
					"content": "有什么想吃的随时跟我说，我让韦尔塞先生去安排，累了也可以到医务室休息一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 40190113,
					"content": "我刚好也想多观察观察你们的面部肌肉。你们开心的笑容非常有感染力，很不错哟，让我念念不忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				}
			]
		},
