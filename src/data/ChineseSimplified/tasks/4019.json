			"dialogs": [
				{
					"id": 40190301,
					"content": "出狱的犯人居然又回来了？吹的什么风啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190302,
					"content": "来看看梅洛彼得堡的情况嘛！应该还好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190303,
					"content": "问题不大，那维莱特过来摆平了一些棘手问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190304,
					"content": "既然这样，你们直接请他留在这里不就好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190305,
					"content": "噢，好办法。我们可以一起说服最高审判官为了一片水抛弃整个法庭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190306,
					"content": "行不通吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "他匆匆下来一趟，茶都不喝一口就回去了。不过带走了护士长给他的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190308,
					"content": "听起来是个大忙人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190309,
					"content": "克洛琳德小姐也回去了，同样带走了护士长的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190310,
					"content": "礼物是奶昔吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190311,
					"content": "给那维莱特的是奶昔，给克洛琳德的是唇膏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190312,
					"content": "欸？差好多啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190313,
					"content": "谁让克洛琳德没有那维莱特那么忙，而且足够健康呢。护士长又喜欢给女士挑选美容用的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190314,
					"content": "对了，也有给你们的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190315,
					"content": "护士长送的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190316,
					"content": "我送的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190317,
					"content": "你们在梅洛彼得堡的事已经办完，随时可以返回水上，只是刑期还没结束。期满之前，原先那间牢房可供你们随便使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190318,
					"content": "真的可以吗？那岂不是还能住好久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190319,
					"content": "包伙食吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "食堂将对你们免费开放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 40190321,
					"content": "好欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190322,
					"content": "记得刑满释放那天来我这里办手续。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				}
