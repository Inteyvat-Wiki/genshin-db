			"dialogs": [
				{
					"id": 40190201,
					"content": "猜猜下一张是什么花色？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190202,
					"content": "唔…呲牙咧嘴猫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190203,
					"content": "啊，是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190205,
					"content": "你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190206,
					"content": "菲米尼看起来恢复得差不多了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190207,
					"content": "嗯，托大家的福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190208,
					"content": "对了！我…我鼓足勇气跟克洛琳德小姐道过谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190209,
					"content": "哇，她什么反应？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190210,
					"content": "她说没关系…她好像完全不觉得救人是件大事，还让我别放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190211,
					"content": "是不想给你压力。确实别太在意比较好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190212,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190213,
					"content": "听我说！我们回了一趟歌剧院，在那里遇到了「仆人」哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190214,
					"content": "「父亲」？她有对你们说什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190215,
					"content": "说了一些比较玄的话，还说期待未来某日跟我们合作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190216,
					"content": "有点意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "「父亲」对你们的态度比我们想的还要好一些…太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190218,
					"content": "#{NICKNAME}，你得相信「父亲」，她有她的职责，必要时她会联合一切可动用的力量，其中也包含你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190219,
					"content": "嗯，「父亲」非常优秀，值得信赖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190220,
					"content": "噢，说到这个，她还说林尼太要强了，偶尔也要学着依赖别人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190221,
					"content": "呃…我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190222,
					"content": "果然是「父亲」会说的话呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 40190223,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 40190224,
					"content": "你们会暂时留在这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190225,
					"content": "应该是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190226,
					"content": "好，我们可以开茶会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190227,
					"content": "真的？那我还想吃蛋糕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 40190228,
					"content": "「还」的意思是，你们在上面吃了好吃的蛋糕。嗯，真好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 40190229,
					"content": "下次也跟我们一起喝茶吃点心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳妮特"
				}
			]
		},
