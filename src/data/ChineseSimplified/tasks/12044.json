			"dialogs": [
				{
					"id": 120440201,
					"content": "嗯…我又想起了之前在这边追狸猫的日子，有些怀念呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440202,
					"content": "欸？那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440203,
					"content": "狸猫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "怎么看都不像吧？难道稻妻又有新的妖怪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440206,
					"content": "嗯…难道它想让我们跟过去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440204,
					"content": "小猪仔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
