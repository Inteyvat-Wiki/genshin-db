				]
			},
			"dialogs": [
				{
					"id": 120440301,
					"content": "那里怎么有个小姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440302,
					"content": "她好像很难受…我们快过去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440801
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440801,
					"content": "刚刚是怎么了？明明只是和那个小姐姐对视了一眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440802,
					"content": "等一下，这里什么时候来了这么多人？这些人到这里来干嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440803,
					"content": "这些人好像在排队？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "是哦…那个姐姐还在那里！嗯…我觉得她可能知道发生了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440805,
					"content": "现在出发的话，我剩下的时间还足够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "手岛"
				},
				{
					"id": 120440806,
					"content": "怎么就聊不明白呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 120440807,
					"content": "举报了肯定混不下去，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "真田"
				},
				{
					"id": 120440808,
					"content": "唔…因为缺乏灵感而产生的焦虑…灵感往往不会光顾过于焦虑的大脑，希望这次治疗能让你更放松一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440809,
					"content": "…谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 120440810,
					"content": "…对于过往恶行的悔恨，还有对于困顿现状的哀愁…我可以让你更开朗地面对这一切，但还请你也努力一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440811,
					"content": "…多谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "西口"
				},
				{
					"id": 120440812,
					"content": "下一位…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440813,
					"content": "这是怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440814,
					"content": "你没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "我还行，下一位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440816,
					"content": "这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440817,
					"content": "…唔！真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440818,
					"content": "哇，好突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440819,
					"content": "欸？这是…嗝！真的很抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440820,
					"content": "抱歉？说实话，我们两个都不清楚刚刚到底发生了什么事，能麻烦说明一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440821,
					"content": "两位应该是误入了我的梦境，容我先让两位醒来再进行说明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440822,
					"content": "梦境？什么时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440901,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440902,
					"content": "#嗨，是不是有种「如梦方醒」的感觉？真没想到那位{NICKNAME}会出现在我的梦里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440903,
					"content": "你认识我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "有人经常向我提起你，嗯…我根据传闻做的人物侧写还算准确。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440905,
					"content": "那你是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440906,
					"content": "#说起来这是我和{NICKNAME}的第一次见面呢，那么正式自我介绍一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440907,
					"content": "我是梦见月瑞希，叫我瑞希就好。我来自食梦貘一族，也是稻妻的妖怪之一哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440908,
					"content": "食梦貘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440909,
					"content": "啾啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "小食梦貘"
				},
				{
					"id": 120440910,
					"content": "是之前的那个小家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440911,
					"content": "这就是我们一族原本的样子，两位刚刚应该就是被它吸引才误入了我的梦境吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440912,
					"content": "食梦貘拥有吞食人类噩梦的能力，而噩梦需要我们在自己的梦境里进行消化，你们刚刚看到的就是我消化噩梦的场景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440913,
					"content": "我一口气吃了太多噩梦，它们堵在一起，让我有些消化不良…幸好它带你们闯了进来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440914,
					"content": "也算是歪打正着，帮了我一个大忙，现在我可以好好消化这些噩梦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440915,
					"content": "我们就是发现你有些难受才凑过去的，虽然不知道具体发生了什么，但能帮到你就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440916,
					"content": "我最讨厌噩梦了，能吞食噩梦的妖怪，确实要好好帮助一下呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440917,
					"content": "不过，非常抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440918,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "你在梦境里凑过来的时候，我从你身上分离出来的不是噩梦，而是美梦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440920,
					"content": "之前吃了那么多噩梦，我的动作都变得机械了，没留意就一口咬了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440921,
					"content": "原来食梦貘也可以吃美梦啊…话说回来，这是很过分的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440922,
					"content": "当然了，美梦对于人类来说十分珍贵，怎么能像噩梦那样随意吞食呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440923,
					"content": "我们食梦貘一族有个不成文的规定，未经允许绝对不能吞食他人的美梦，我真是太不小心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440924,
					"content": "不必这么自责。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "难道你没有觉得十分低落，又或者忽然想起很多伤心往事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440927,
					"content": "没有啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "自己的美梦被吞食一部分后还能维持如此稳定的心理状态，真是难得一见的案例…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440929,
					"content": "#嗯…肯定是{NICKNAME}的美梦太多了，被吃掉一点也没关系嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440930,
					"content": "但我还是应该向你提供补偿…这样吧，请收下这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440931,
					"content": "秋沙钱汤贵宾邀请函…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440932,
					"content": "本店有多位心理诊疗师坐镇，并附带温泉和美食服务。带着烦恼前来，带着快乐离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440933,
					"content": "邀请函上标注了地址，我就在那里工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440934,
					"content": "使用这张邀请函，你们可以在那里免费享受最高级别的服务…啊，说起来我也得赶快回去，店里的事务不能搁置太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440935,
					"content": "那么，期待你们的正式光临哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "梦见月瑞希"
				},
				{
					"id": 120440936,
					"content": "这么说，那位食梦貘姐姐还是一位心理诊疗师？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440937,
					"content": "不意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "心理诊疗服务…除了思考下一顿该吃什么，很少有能让我发愁的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440940,
					"content": "对了，那个什么汤好像也提供美食服务，有这张卡的话就可以去那里免费吃大餐吧？我们可不能浪费这次机会哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120440938,
					"content": "有意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "我感觉还好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
