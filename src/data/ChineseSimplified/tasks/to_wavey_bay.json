			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "哟，眼神不错，我站在这么高的地方居然都被你发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421302,
					"content": "看样子，你也对这里的设施感兴趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421303,
					"content": "它好玩吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "我觉得挺不错。但好玩与否是个主观的判断，我说了也不算，你得亲自上手试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421307,
					"content": "看到那条轨道了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421308,
					"content": "用颜料子弹给轨道上的球体染色吧。只要涂上相同的颜色，那些球就会被「消除」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421309,
					"content": "至于是如何「消除」的…呵呵，也许另一个人也端着枪，等着把那些球打飞呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421310,
					"content": "好厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "那你就来一局试试？用那个就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421313,
					"content": "这回我看你玩，加油。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421311,
					"content": "说得我快信了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "它复杂吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "放轻松，这里可是悠悠度假村，是与「复杂」、「困难」这些词汇距离最远的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "恰斯卡"
				}
			]
		},
