				{
					"id": 150421401,
					"content": "现在感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421402,
					"content": "有点轻松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "口气还挺大，不过我看你确实表现得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421408,
					"content": "说不定我也可以跟工作人员提提建议，让他们日后做些改进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421409,
					"content": "再怎么说…至少也该让两位选手一决高下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421404,
					"content": "眼睛看花了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "哈哈，保持专注的确是一件需要耗费体力的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421406,
					"content": "挺好玩的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "是吗？看来我们做出了相同的判断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "恰斯卡"
				}
			]
		},
