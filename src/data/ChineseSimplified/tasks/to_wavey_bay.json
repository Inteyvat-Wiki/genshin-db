			"dialogs": [
				{
					"id": 150421501,
					"content": "很好，清点人数…一二三四…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421502,
					"content": "还多了一个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421503,
					"content": "各位是想要参与浪浪湾的主要挑战项目吗？但我们这边出了些状况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421504,
					"content": "如果需要完成纪念册任务，在景点拍摄合照的话，我现在可以直接帮大家拍摄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421505,
					"content": "不…这不对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421506,
					"content": "画片不过是留念的手段，以后翻看时还能回想起温暖的片段…但我们在意的还是整个游玩的体验啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421507,
					"content": "你忘说画片可以兑奖的事了…好吧，但我也赞同，拍一张就走太敷衍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421508,
					"content": "我明白了，真是抱歉…那可能需要大家保持耐心等待了，我们会尽快解决的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421509,
					"content": "要等多久呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421510,
					"content": "这个不太好说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421511,
					"content": "欸？不太好说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421512,
					"content": "有我们来帮忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421513,
					"content": "这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421514,
					"content": "我看浪浪湾其他项目工作人员很少，龙员工的状态明显有些疲惫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421515,
					"content": "恐怕就是因为「主要挑战项目」遇到了难关，所有人手都被临时调度过来，共同参与起了修复工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421516,
					"content": "别紧张，我理解有不便透露的内部情况，并不是要为难你的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421517,
					"content": "相反，我的同伴个个身手不凡，而且助人为乐，就在不久前完成了「暝导游船」和「阿夏快跑」两场测试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421518,
					"content": "要是你愿意把难题和我们分享，事态就很有可能得到更快解决。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421519,
					"content": "哇，她说话有进有退的，这就是平日里深藏不露的「调停人」实力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421520,
					"content": "恰斯卡，提醒我一下，你是怎么观察的来着？你不会暗中坐在树梢上偷看我们吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421521,
					"content": "这是重点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421522,
					"content": "噢，重点是…我们真的很擅长支援和协助！有问题当然要大家一起出力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150421523,
					"content": "没想到这位客人连龙的状态都能说得那么准确…不好意思，是我不该隐瞒各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421524,
					"content": "情况是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421525,
					"content": "测试发现，「闪闪大滑行」仍有许多地方缺少正确涂色。由于需要在游隙灵道上进行喷绘，施工难度很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421526,
					"content": "为了不影响度假村的正式开业时间，我们只能临时关停挑战项目，争分夺秒进行抢修…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421527,
					"content": "哈哈…那好说啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421528,
					"content": "告诉我颜料放在哪里？我来跑一次，一口气全都涂完！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421529,
					"content": "啊？…她在说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421530,
					"content": "我猜你可能没和她见过面，这位是「沃摩{RUBY#[S]团结}延」的玛拉妮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421531,
					"content": "玛拉妮…等等，玛拉妮…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421532,
					"content": "你是说…六英杰之一的那位玛拉妮？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "图西娜"
				}
			]
		},
