			"dialogs": [
				{
					"id": 150421701,
					"content": "辛苦啦，玛拉妮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150421702,
					"content": "呼，这回总算玩爽啦…怎么样？各位，我做得很棒吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421703,
					"content": "太漂亮了，不愧是纳塔的六英杰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150421704,
					"content": "在冲浪板滑出去之后，派蒙和我说起了你的事迹，听得我叹为观止！全身都像燃烧起来一样激动！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150421705,
					"content": "哈哈，谢谢，听你夸的，我都想原地加开一场温泉派对了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421706,
					"content": "哇！你们看，浪浪湾工作人员都来了！努力了那么久，大家肯定都在等着音乐、派对和犒劳呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421707,
					"content": "我觉得你理解错了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150421708,
					"content": "哪里错了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421709,
					"content": "英雄玛拉妮小姐，能不能请您为我签个名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "图西娜"
				},
				{
					"id": 150421710,
					"content": "我也想要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "高恩"
				},
				{
					"id": 150421711,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "幼暝视龙"
				},
				{
					"id": 150421712,
					"content": "明星已经藏不住了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "快快，趁现在其他人还没拥上来，我们抓紧时间把合照拍了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421714,
					"content": "要明亮的笑容，自信的表情！想想旁边的海景，还有自己的幸运色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421715,
					"content": "三、二、一——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150421716,
					"content": "鳍游龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
