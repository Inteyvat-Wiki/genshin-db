			"dialogs": [
				{
					"id": 150420101,
					"content": "呜呼——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420102,
					"content": "阳光！海浪！鳍游龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420103,
					"content": "她激动得好像忘了自己的古名是「沃摩{RUBY#[S]团结}延」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420104,
					"content": "快来呀，这边这边！哎呀，快一点嘛，用跑的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420105,
					"content": "我们来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420106,
					"content": "看！这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420107,
					"content": "木板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420108,
					"content": "看字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420109,
					"content": "噢噢噢是游览地图啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420110,
					"content": "游览地图！其价值不亚于锁着巨大宝库的钥匙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420111,
					"content": "我明白，都象征着冒险的开始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420112,
					"content": "或者也能比喻成熊熊燃烧的燃素种？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420113,
					"content": "燃素？呃…好像是一种能量对吧？你是想说…只要看一眼就会有…源源不断的动力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420114,
					"content": "没错！而且它也很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420115,
					"content": "拥有地图，时刻按需查看，每个人都能走出属于自己的自由冒险之路！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420116,
					"content": "哇噢，自由！冒险！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "阿夏"
				},
				{
					"id": 150420118,
					"content": "等等…别急着附和。我怎么听着玛拉妮话里有话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420119,
					"content": "现在，解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420120,
					"content": "哪有你这种一到景点就原地解散的向导啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420121,
					"content": "玛拉妮是不是自己想玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "不愧是我的好伙伴，我会把你帮我说话这件事记在心上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420124,
					"content": "大家仔细看，这两个大型游乐项目旁都写着「待测试」的字样，估计是遇到了什么麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420125,
					"content": "我们不如分头去找自己感兴趣的项目，一边体验，一边帮忙测试，说不定还能让浪浪湾尽早投入运营。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420126,
					"content": "我还以为一接触到你心爱的水上项目，就不管我们了，原来你还是挺热心的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150420127,
					"content": "嘿嘿，最后大家就在那个巨大的鳍游龙建筑附近集合吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420128,
					"content": "凭我多年向导经验，区域主要挑战的入口，肯定在那附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420129,
					"content": "行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150420130,
					"content": "那就解散啦，记得多看地图哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150420122,
					"content": "懂了，今天「向导」也在度假…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
