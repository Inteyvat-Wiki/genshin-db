				"points": []
			},
			"dialogs": [
				{
					"id": 735190101,
					"content": "真是难懂啊…明明是她说要去咖啡馆写报告的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190102,
					"content": "你怎么一个人在这？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "嗨，别提了，她一个人写报告去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190105,
					"content": "昨天我们俩约在咖啡馆见面，可她花了好长时间才出现，甚至连写报告用的材料跟纸笔都没带！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190106,
					"content": "我批评了她不该浪费写报告的时间，结果她突然就又生气了！说什么报告她一个人写就完事，还把我给赶了出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190107,
					"content": "——真是岂有此理！你说对不对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190108,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "唉，不过她这反反复复生气的性子，我也早就已经习惯啦，过几天就会正常的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190110,
					"content": "——要是她的心情，也像机关那么简单就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190111,
					"content": "祝你好运。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "嗯？怎么连你说话也怪怪的…算啦，话说回来，这附近还有一些受影响的沙虫，虽然放着不管也会慢慢消停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190114,
					"content": "不过为了防止它们威胁到过往的行人，你要是有空就帮忙解决一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190115,
					"content": "——顺便一提，现在的元素环境和充能装置都已经恢复正常了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190116,
					"content": "要想体验「对沙虫用杀虫炮」的全功率输出，现在就是最好的机会啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维纳亚克"
				},
				{
					"id": 735190112,
					"content": "自求多福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "施芮娅上哪去了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
}