				"points": []
			},
			"dialogs": [
				{
					"id": 400010901,
					"content": "畅畅呀，刚才把布娃娃捐了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010902
					],
					"speakerTitle": "畅畅"
				},
				{
					"id": 400010902,
					"content": "昨晚我梦到她说想要飞到天上去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010903
					],
					"speakerTitle": "畅畅"
				},
				{
					"id": 400010903,
					"content": "我就把她捐给大鹿灯那边的姐姐了，马上她就会实现愿望了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010904
					],
					"speakerTitle": "畅畅"
				},
				{
					"id": 400010904,
					"content": "畅畅是做了件好事吗？海灯节是实现大家愿望的日子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "畅畅"
				}
			]
		},
