			},
			"dialogs": [
				{
					"id": 413111201,
					"content": "按这个速度…应该差不多够了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111202
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111202,
					"content": "请问，「霄灯」的编制方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413111203
					]
				},
				{
					"id": 413111203,
					"content": "「霄灯」的编制方法？哦…看你们的样子，应该不是本地人吧，是想要亲手编个「霄灯」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111204
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111204,
					"content": "倒也没问题，「霄灯」的式样有很多种，唔…我就先挑最简单的那种教你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111205
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111205,
					"content": "我这里正好还有一些制作材料…等等啊，这些材料还得先处理一下，你们就用这些来试试手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111401
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111401,
					"content": "头…头好晕，怎么这么复杂…你，你记住了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111402,
					"content": "勉强记住了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413111403
					]
				},
				{
					"id": 413111403,
					"content": "哈哈哈，最开始的时候是挺复杂，但只要做得多了就会很顺手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111404
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111404,
					"content": "像你们这样想要学习编「霄灯」的人，现在也是不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111405
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111405,
					"content": "那个超大的「明霄灯」，也是这么编制出来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111406,
					"content": "那个？那个…也可以说是「编制」来的吧，但并不是某一个人编制，而是璃月的所有人一起编制的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111407
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111407,
					"content": "全璃月的人一起编制的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111408,
					"content": "你应该也听说了，「霄市」里的各个商摊，就是为了筹建这个「明霄灯」而开设的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111409
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111409,
					"content": "哇…「明霄灯」原来都是这么造的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111410,
					"content": "这也是海灯节的传统了，虽然资费的大头还是总务司的拨款，但材料和其他的东西，都还是来自于居民们的捐赠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111411
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111411,
					"content": "哦…之前的那个小女孩，她好像是把自己的布娃娃也捐了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111412,
					"content": "布娃娃也能用来建设「明霄灯」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111413,
					"content": "这个…毕竟海灯节是个大节日，要是居民们想要参与一下「明霄灯」建设的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111414
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111414,
					"content": "不管捐的是什么，总归是一份心意，我们一般都会接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111415
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111415,
					"content": "毕竟这么隆重的节日，参与进来也有点「祈福」的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111416
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111416,
					"content": "好了好了，你们是来海灯节玩的吧？我就不耽误你们时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111417
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111417,
					"content": "如果以后还想要编「霄灯」的话，尽管来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111418
					],
					"speakerTitle": "景明"
				},
				{
					"id": 413111418,
					"content": "祝你们在海灯节玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "景明"
				}
			]
