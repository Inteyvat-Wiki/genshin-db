			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博来"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010203,
					"content": "多少钱也不卖！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010205,
					"content": "你出不起我心中的价位。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010202,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_GIRLA]}，冒昧问一下。你身边飘着的这个小东西，多少钱可以卖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010204,
					"content": "多少钱也不卖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010206,
					"content": "这话听着怪怪的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010207,
					"content": "说实话还有点在意…究竟这个价位是多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010208,
					"content": "算了，我就当你是在说「多少钱也不卖」好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010209,
					"content": "哈哈哈哈，最近手头周转不开，的确出不起价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010210,
					"content": "毕竟我只是个普通商人，也不倒腾奇珍异宝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010211,
					"content": "…听语气感觉很可疑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010212,
					"content": "别这么说嘛。小家伙，你要吃糖吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010220,
					"content": "真不愧是派蒙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}，我认为这个人可以信任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010214,
					"content": "对了，你们来璃月，也应该是冲着「海灯节」来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010215,
					"content": "今年的「明霄灯」壮景可期啊。用来让巨灯浮空的那块「浮生石」，是二十年来最大的一块。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010216,
					"content": "大到让人不禁要想，神话中云间的浮城要是真的存在的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010217,
					"content": "也只是下面装了一块差不多大的浮生石吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010218,
					"content": "听起来好厉害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400010219,
					"content": "哈哈哈哈，有缘再见吧。欢迎你们来璃月——这话代表不了<color=#00E1FFFF>璃月港</color>，但我的小店永远欢迎你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
