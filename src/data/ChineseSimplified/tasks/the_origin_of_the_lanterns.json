			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江舟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110601,
					"content": "#{NICKNAME}，快看！那块石头浮在空中欸，而且连链子都拉直了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110602,
					"content": "如果没有锁链拴住，不知道它会飞去哪里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110603,
					"content": "这就是用来制作「明霄灯」的浮生石。整个「霄市」就是围绕着它布设的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110604
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110604,
					"content": "啊，请问你是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110605,
					"content": "我是江舟，最近负责明霄灯的建设进度统计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110606
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110606,
					"content": "看样子你们是第一次来璃月见识海灯节吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110607
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110607,
					"content": "没错…你怎么知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110608,
					"content": "去年我可不记得有带着奇怪吉祥物的旅行者来过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110609
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110609,
					"content": "所以你说的「明霄灯」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110610
					]
				},
				{
					"id": 413110610,
					"content": "节日里，人们手中放飞的小灯叫做「霄灯」。而全璃月人共同建造的巨灯，就是「明霄灯」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110611
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110611,
					"content": "「霄市」上的摊位，是璃月各路商行一年一度、难得不为赚钱，只为筹集「明霄灯」的建设资材而开设的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110612
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110612,
					"content": "那「霄市」里面，会有好吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110613,
					"content": "那当然不少，而且要我说，海灯节正是最适合品尝璃月美食的节日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110614
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110614,
					"content": "这可是璃月一年里最盛大的节日，要是能在海灯节上向大家展现出自家的手艺，必然能博得不少的口碑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110615
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110615,
					"content": "所以，虽然不为赚钱，但各个商家暗地里都铆足了劲，在海灯节上一拼手艺的高低呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110616
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110616,
					"content": "从各个方面来说，璃月人都很厉害啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110617,
					"content": "如果你们还有什么问题的话，可以去找海灯节的负责人<color=#00E1FFFF>望雅</color>小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110618
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110618,
					"content": "她一般会在「霄市」附近待着，你们有什么问题都可以去问她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110619
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110619,
					"content": "她会知道什么店卖的东西最好吃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110620,
					"content": "那当然，海灯节的一切事情，望雅小姐都再清楚不过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110621
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 413110621,
					"content": "#知道啦，{NICKNAME}，我们赶紧去「霄市」上找那位<color=#00E1FFFF>望雅</color>小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110622,
					"content": "然后…去东西最好吃的那个小摊上吃个饱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4131107,
			"completionStepIds": [
				4131107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131107",
							"2"
						],
						"stepId": 4131107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"望雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110701,
					"content": "你好，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110702
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110702,
					"content": "看你的样子…应该不是璃月人吧，是旅行者吗？欢迎你来「霄市」玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110703
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110703,
					"content": "请问，你是海灯节的负责人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110704
					]
				},
				{
					"id": 413110704,
					"content": "负责人…倒也谈不上，海灯节是全璃月的节日，不是哪个人能够负责的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110705
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110705,
					"content": "我也只是负责管理一些琐事，努力让海灯节更热闹罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110706
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110706,
					"content": "我有些事情想问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110707
					]
				},
				{
					"id": 413110707,
					"content": "我们想问问，「霄市」里哪个摊子上卖的东西最好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110708,
					"content": "最好吃？各有各的特色吧，我也不能下结论。但是，我能告诉你们目前人气最高的小吃摊位，是<color=#00E1FFFF>宜年</color>的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110709
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110709,
					"content": "如果那边的人再多点，我就要去申请千岩军维持秩序了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110710
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110710,
					"content": "你们要去的话就赶紧去吧，趁现在人还没把路占满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110711
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110711,
					"content": "对了，你们要去找宜年的话，就顺便帮我把这份文件带给他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110712
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110712,
					"content": "这是我们总务司根据去年海灯节数据总览，给各位商家的营业建议。你们既然要去，就顺便帮我个忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110713
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413110713,
					"content": "回来之后，我会送你们个小礼物，作为报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				}
			]
		},
		{
			"id": 4131108,
			"completionStepIds": [
				4131108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131108",
							"2"
						],
						"stepId": 4131108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宜年"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110801,
					"content": "这人手真是不够了，早知道就再带点人出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110802
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110802,
					"content": "这里有什么好吃的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110803,
					"content": "是客人吗？这边看，菜单上写的能做，你们想吃什么直接说，我也能做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110804
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110804,
					"content": "哇！那我要吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110805,
					"content": "不过，虽然说是小吃摊…但看起来什么都有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110806,
					"content": "那当然，什么菜我不会做，赶紧点菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110807
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110807,
					"content": "这是望雅给你的文件。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110808
					]
				},
				{
					"id": 413110808,
					"content": "又来了，年年都来，什么营业建议——除了菜品的味道之外，我不需要其它的什么手段！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110809
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110809,
					"content": "算了，把这文件给我吧，我等会就把它给喂炉子去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110810
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110810,
					"content": "快点菜吧，你们不是来吃东西的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110811
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110811,
					"content": "这么多好吃的，这个看着不错，这个我也想吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110812,
					"content": "咦，「烤吃虎鱼」？我记得，那好像是那位「铜雀」很喜欢吃的菜来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110813,
					"content": "唔…既然海灯节是纪念英雄的节日，那我们就点这道菜吃，也用这种方式来纪念一下他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110814,
						413110815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110814,
					"content": "我看你就是自己想吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				},
				{
					"id": 413110816,
					"content": "你这小家伙还挺会吃的，一点就点到了我们最有特色的菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110817
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110817,
					"content": "那你们在这等一会，菜一会就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110819
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110819,
					"content": "好了，这是你们点的「烤吃虎鱼」，吃吃看味道怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110820
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110820,
					"content": "好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110821,
					"content": "派蒙对于吃真是很在行啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110822
					]
				},
				{
					"id": 413110822,
					"content": "那当然，我可是你最好的向导。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413110823,
					"content": "哈哈哈，那你们慢慢吃吧，我要接着去招呼客人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110824
					],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110824,
					"content": "如果还想再吃的话，过来点就是了，我随时欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宜年"
				},
				{
					"id": 413110815,
					"content": "真是派蒙的作风…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				}
			]
		},
