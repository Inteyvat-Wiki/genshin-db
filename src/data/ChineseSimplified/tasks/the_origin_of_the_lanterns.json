			"dialogs": [
				{
					"id": 413111101,
					"content": "你们回来了，怎么样，宜年做的菜味道还不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111102
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111102,
					"content": "很好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111103,
					"content": "他说不会参考那份文件…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413111104
					]
				},
				{
					"id": 413111104,
					"content": "是吗？他去年也是这么说的…要是他愿意根据我们的建议打广告的话，营收应该会更多才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111105
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111105,
					"content": "算了，不用在意这些。来，之前说好的礼物，这个「霄灯」给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111106
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111106,
					"content": "哇，好漂亮的灯，这是怎么做的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111107,
					"content": "唔…编制的方法我一时半会也讲不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111108
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111108,
					"content": "如果你们对「霄灯」感兴趣的话，可以去旁边问问<color=#00E1FFFF>景明</color>，他是负责「霄灯」和「明霄灯」的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111109
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111109,
					"content": "那个好大好大的灯，也是他在负责吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111110,
					"content": "对，他应该就在旁边不远，应该很容易就能找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111111
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 413111111,
					"content": "要是能亲手编个「霄灯」带给魈的话，他也许会变得开心一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413111112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 413111112,
					"content": "我们快去找那位<color=#00E1FFFF>景明</color>问问看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
