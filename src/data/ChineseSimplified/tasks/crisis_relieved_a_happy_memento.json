						],
						"pointId": 5742
					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "嘿嘿！嘟嘟可战胜了一大群坏坏的角角鱼士兵！角角鱼的大王也不是对手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360102,
					"content": "嘟嘟可，蹦蹦炸弹和轰轰火花的组合，是最厉害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360103,
					"content": "是无敌的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "玩这个游戏的时候，我经常想到果酒湖的那件事呢…难道丽莎直接把那件事改编成了游戏的主题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360106,
					"content": "不过话说回来，如果真的找不到那些外来的鱼…让小可莉去把可疑的礁石统统炸一遍，不就万事大吉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360107,
					"content": "实在不行，给我们几个炸弹，我们也能把这件事包办了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360108,
					"content": "派蒙，你和可莉更合拍了啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "嗯，看你们的表情，似乎还挺享受这个游戏的嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360111,
					"content": "丽莎姐姐，你来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360112,
					"content": "丽莎，你终于露面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360113,
					"content": "你设计的「嘟嘟可轰轰奇遇记」很有趣，我们和小可莉都玩得很尽兴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360114,
					"content": "谢谢你们的喜欢。难道说，我还要设计这部作品的续作了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360115,
					"content": "好耶！我还想看…嘟嘟可去其他地方冒险的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360116,
					"content": "不，不对，我记得，丽莎姐姐做这个游戏花了好多时间，肯定很累，不能总是让丽莎姐姐这么累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360117,
					"content": "啊呀，小可莉这么关心姐姐，姐姐很高兴哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360118,
					"content": "如果你喜欢这样的游戏，愿意安安心心待在城里玩，我花再多时间都值得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360119,
					"content": "当然，我明白，自由自在地到处冒险，才是你的最爱，这个游戏只是一种新奇的消遣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360120,
					"content": "所以，我给你们带来了一条好消息，还有给小可爱们的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360121,
					"content": "礼物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360122,
					"content": "#我，我也有礼物要给荣誉骑士{M#哥哥}{F#姐姐}和小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360123,
					"content": "礼物放在最后，先说好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360124,
					"content": "我猜，果酒湖的问题解决了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "没错，调查小队的两位骑士找到了外来鱼类的老巢，将它轻松捣毁啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360127,
					"content": "至于外来鱼类突然出现的原因，骑士团也查清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360128,
					"content": "这次的事故起源于一位商人的无心之举，念在她没有恶意，骑士团只让她缴纳了相应的罚金，好好教育了她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360129,
					"content": "呼…还好还好，没有造成很大的影响。不过，那个商人未免也太不小心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360130,
					"content": "果酒湖的水质安全了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "那，接下来就是——公布礼物的时间了！可莉可以先说吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360133,
					"content": "当然没问题啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360134,
					"content": "我也有些好奇呢，小可莉最近每天很早就回家了，完全都不用别人提醒呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360135,
					"content": "哼哼~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360136,
					"content": "晚上在家的时候，我一边看着阿贝多哥哥的手工画册，一边学，一边做出来了这个——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360137,
					"content": "锵锵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360138,
					"content": "这是…准备投出蹦蹦炸弹的嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360139,
					"content": "嗯！可莉照着「嘟嘟可轰轰奇遇记」的棋子，做了这个嘟嘟可的玩偶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360140,
					"content": "虽然这个嘟嘟可不能真的丢出蹦蹦炸弹，但我觉得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360141,
					"content": "#只要看到这个玩偶，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙就能想起这几天的开心时光，烦恼和无聊丢光光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360142,
					"content": "嘟嘟可的大玩偶！确实是个大惊喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360143,
					"content": "这样一来，感觉随时都能见到小可莉和嘟嘟可了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360144,
					"content": "谢谢你！细心手巧又体贴的可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "#嘿嘿！荣誉骑士{M#哥哥}{F#姐姐}和小派蒙喜欢我的礼物，可莉的努力大获成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360147,
					"content": "丽莎姐姐的礼物呢？可莉也想知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360148,
					"content": "啊呀，比起小可莉的心意，我的这件礼物就要保守得多了呢~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360149,
					"content": "来看看「嘟嘟可轰轰奇遇记」的冒险故事书吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360150,
					"content": "冒险故事书！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360151,
					"content": "一整本故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360152,
					"content": "小可爱们回到了蒙德，与小可莉一起加入了嘟嘟可的冒险旅程！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360153,
					"content": "#{M#他们}{F#她们}一起打败了坏坏的角角鱼士兵，开开心心地喝起了下午茶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360154,
					"content": "这个故事才是「嘟嘟可轰轰奇遇记」最最完美的模样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360155,
					"content": "难道说，丽莎在设计这些游戏关卡的时候，就想好了整个故事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360156,
					"content": "不是的。派蒙，这个故事是小可爱，你和小可莉合力完成的哦，你们才是决定一切的主角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360157,
					"content": "我之前特别为这本书预留出了一张插图的位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360158,
					"content": "现在我有个提议——大家难得在这么悠闲的时候相聚，不如，小可爱们一起合个影，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 705360159,
					"content": "好呀，见到了好朋友，还一起玩到了开心的游戏，这一刻确实值得纪念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705360160,
					"content": "开开心心合个影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "#那就来吧，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙，这边这边！丽莎姐姐，拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360163,
					"content": "今天也是开心的一天！三、二、一——嘟嘟可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705360161,
					"content": "平平淡淡也珍贵！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360145,
					"content": "太好啦！可莉和嘟嘟可陪着我们！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360131,
					"content": "蒙德的酒业也没事了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
