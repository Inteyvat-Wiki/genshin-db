			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "唉，这小常…怎么还不回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150102,
					"content": "小常是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "小常啊，就是你们喊的「常九爷」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150104,
					"content": "唉，我叫他小常叫习惯了，一直就这么叫了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150105,
					"content": "昨天晚上，他说要出去给自己的小说取材，我也没在意，就随口叮嘱了他两句早点回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150106,
					"content": "结果，到现在他也没回来。我真担心他是出了什么事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150107,
					"content": "但我这老身子骨，也不好出去找他，能拜托你们，帮我去找找小常吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150108,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "那就太好了，就拜托你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 221150110,
					"content": "您知道他去哪了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "唉，他还能去哪，还不是北边的「无妄坡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150112,
					"content": "请你们帮我去看看他吧，这么长时间了，可别出了什么意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
