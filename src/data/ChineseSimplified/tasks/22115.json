			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "嘿…这群怪物，真是讨人嫌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150202,
					"content": "我就是来给我的新小说取个材，材没取到，倒是撞上了这群怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150203,
					"content": "谢谢你们了啊，要不是你们，我还真不知道怎么脱身呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150204,
					"content": "若心奶奶很担心你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "担心我？我有什么可担心的，我都这么大人了，知道怎么照顾自己。呃…这么点意外，其实我自己也能处理，就是有点费劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150206,
					"content": "不过，还是谢谢你们了…我就快点回去吧，免得她老人家又唠叨个不停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
