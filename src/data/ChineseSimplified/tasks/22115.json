				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "就这么走掉了啊…我们也回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 221150302,
					"content": "咦？地上好像有什么东西…是常九爷掉的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 221150303,
					"content": "唔…先过去捡起来看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211507",
							"2"
						],
						"stepId": 2211507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "唉，到底怎么才能写出一本好小说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150502,
					"content": "这些是你掉的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "什么？哦…这确实是我的，这些都是我写的废稿，本来就是丢到河里去销毁的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150504,
					"content": "你们还把它们捡回来…这上面的字都看不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150505,
					"content": "这上面写了什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "哦，是我写给我妹子的故事，这几章都是废稿了。你是不知道啊，小时候，这丫头天天缠着我，要我给她讲故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150507,
					"content": "可惜啊，我之前没时间写，就写了个开头给她，让她自己先看，准备以后有时间再慢慢写给她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150508,
					"content": "但是那丫头突然有一天就不见了，我怎么找都找不着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150509,
					"content": "哼，准是她家里人不喜欢我，不想她和我在一起，就找了个机会，不声不响地带着她，整家从轻策庄里搬走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150510,
					"content": "他们就瞧好吧，等我发了家，一准让他们刮目相看！然后，我就把我写给我妹子的那本书，给弄到全世界去卖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150511,
					"content": "这样，无论她们现在住在哪，都能知道我老常已经混出了头！不是当年那个我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150512,
					"content": "然后…我就一定能和她再见面…不过在那之前，我还是先得把这本书给写完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "常九爷"
				},
				{
					"id": 221150513,
					"content": "…对不住，说着说着就唠叨起来了。唉，我还是再想想怎么写好我的那本书吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爷"
				}
			]
		},
		{
			"id": 2211506,
