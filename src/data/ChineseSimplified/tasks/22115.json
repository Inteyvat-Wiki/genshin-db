			"dialogs": [
				{
					"id": 221150601,
					"content": "唉，这个小常啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150602,
					"content": "常九爷已经回来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "哦，我已经看见他了，真是辛苦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150604,
					"content": "他和小时候一样，就爱到处闯祸，总是说自己长大了，其实就是长不大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150605,
					"content": "好啦，你们也别太操心了，这是小常他自己的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150606,
					"content": "谢谢你们帮我跑了一趟。这是给你们的，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150607,
					"content": "你们还有自己的事吧，赶紧去忙吧。别和小常似的，为了所谓的「出人头地」、「刮目相看」，耽误了正视自己的机会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150608,
					"content": "唉…凡人不是仙，人生在世…何苦来哉，何苦来哉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
