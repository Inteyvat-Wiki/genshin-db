						],
						"pointId": 39
					}
				]
			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "恭喜你们。让我看看…像这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040302,
					"content": "不同于现在魔女的花园，这是从前我还是天使时待过的神殿，我在那住了很长一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040303,
					"content": "有好多天使啊，而且尼可看起来好受欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040304,
					"content": "不是我炫耀，朋友们可爱听我讲故事呢，尤其是那类与人类同行、布下征兆，带领他们兴建文明的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040305,
					"content": "每次讲到关键时候，在场的天使们都会屏息凝神，连琴弦都不再震颤，画笔都不再抖动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040306,
					"content": "然后，交织的色彩绽开了。伴着乐声，金色的光芒遍及万物，那是我们的欢歌和喜悦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040307,
					"content": "听上去真美好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040308,
					"content": "谁说不是呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040309,
					"content": "虽然现在旧时的美好全然消逝了，但如今的生活随时都有新的惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040310,
					"content": "有个家伙看我在读报纸竟然想偷我的雕塑品？他完蛋了！我今天就指引他去梅洛彼得堡的路要怎么走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040311,
					"content": "有个家伙看我在读报纸竟然想偷我的雕塑品？",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "他完蛋了！",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "我今天就指引他去梅洛彼得堡的路要怎么走！",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
