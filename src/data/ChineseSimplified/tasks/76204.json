			"dialogs": [
				{
					"id": 762040201,
					"content": "尼可——奇怪，这里也没人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040202,
					"content": "你们已经到我的工作室了吗，有没有看到我从各地收集并栽培下的花草？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040203,
					"content": "唉，好巧不巧我这会儿没法赶过来，我在枫丹摆摊卖雕塑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040204,
					"content": "呃…需要我们帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "别，这可是我唯一提笔写字的机会，尽管写的多数都是数字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040206,
					"content": "难得你们来一趟，不如就先玩起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040207,
					"content": "我记得我在西边，团雀雕塑旁边留了一份卷轴，你们看见了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762040208,
					"content": "看见了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762040209,
					"content": "那就让这位沉默的向导为你们提供帮助吧，加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
			"id": 7620403,
