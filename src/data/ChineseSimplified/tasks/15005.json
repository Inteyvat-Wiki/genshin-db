			"dialogs": [
				{
					"id": 150050101,
					"content": "落败的鳍游龙四散逃走了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "你们这身打扮，难道是须弥来的学者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050103,
					"content": "嗯，我是卡嘉，这位是我的前辈维兰德。真的非常感谢你们，刚刚太危险了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050104,
					"content": "#不用谢，对我们来说只是小事一桩啦。我是派蒙，这位是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050105,
					"content": "唉…那些鳍游龙全都跑了，至少要活捉一只啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150050106,
					"content": "活捉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050107,
					"content": "对了，我看你们身手不错，要不我来做诱饵吸引那些鳍游龙，你们帮我活捉一只，我会支付报酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150050108,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050109,
					"content": "非常抱歉，维兰德只是太专注于他的研究了，还请不要见怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050110,
					"content": "没关系没关系！话说回来，你们为什么要招惹野生的鳍游龙呢？还要活捉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050111,
					"content": "难道你们也想合影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "肯定跟这个没关系啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050113,
					"content": "让两位见笑了，其实我和维兰德正在寻找传说中的神秘岛。据说有一条重要的线索就在这些鳍游龙身上，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050114,
					"content": "没有来自「流泉之众」的向导帮助，就贸然接触它们，果然很不明智啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050115,
					"content": "神秘岛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050116,
					"content": "嗯，一个来自「流泉之众」的传说提到了一座神秘的岛屿，维兰德相信他的研究目标就在这座岛上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050117,
					"content": "咳咳…你们真的不考虑一下我刚刚的提议吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150050118,
					"content": "刚刚的提议…我们才不会把一个大活人当诱饵呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050119,
					"content": "那继续谈也是浪费时间，得想想别的办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150050120,
					"content": "前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050121,
					"content": "好吧…刚刚你们确实救了我和卡嘉，于情于理，我是该向你们道谢…非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150050122,
					"content": "好别扭啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050123,
					"content": "卡嘉，我们该走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150050124,
					"content": "真的非常抱歉，维兰德确实不太擅长处理人际关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050125,
					"content": "没关系，再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050126,
					"content": "真是稀奇，这样的两个人竟然能够结伴探险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050127,
					"content": "不过话说回来，那位大姐姐提到的神秘岛真的让我很好奇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050128,
					"content": "派蒙也想去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "嗯，或许会有宝藏哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050130,
					"content": "这一路上，我们一起探索了那么多神奇的地方，找到这个神秘岛对我们来说也绝对不在话下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050131,
					"content": "但是什么情报都没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "也是…对了，那位大姐姐说这个神秘岛是「流泉之众」传说中的一座岛屿，或许我们可以到那里找人问问？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050133,
					"content": "事不宜迟，现在就开始我们的下一段冒险吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050134,
					"content": "虽说计划好了找人问问，但具体该找谁是个问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050135,
					"content": "或许可以直接找首领？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "嗯…也对，那位大姐姐提到这个神秘岛和「流泉之众」的一个传说有关，那「流泉之众」的首领肯定知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
