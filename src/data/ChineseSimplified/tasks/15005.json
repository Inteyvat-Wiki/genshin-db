			"dialogs": [
				{
					"id": 150050201,
					"content": "这里的景色很不错，还能偶尔看到鳍游龙，我们找几头野生的鳍游龙来合影吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050202,
					"content": "野生的咬人怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "这…反正我觉得鳍游龙挺可爱的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050204,
					"content": "哎？那里是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050205,
					"content": "救命！谁来帮帮我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150050206,
					"content": "哇，野生的鳍游龙真的在咬人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050207,
					"content": "见义勇为！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#对，那两个人有危险，大名鼎鼎的{NICKNAME}和{M#他}{F#她}的搭档绝不会袖手旁观！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150050209,
					"content": "只能等下再合影了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "是啊，没时间讲这个了。有人在呼救，我们不能袖手旁观吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
