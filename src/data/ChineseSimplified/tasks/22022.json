			"trigger": {
				"objectNames": [
					"芭尔瓦涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "这个食谱的搭配应该是这样才对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220102,
					"content": "你在做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "我正在整理食谱呢，呃…但有些食谱还是记不太清…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220104,
					"content": "直接问旭东就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "旭东…我之所以记不清那些食谱，大部分原因就是他成天折腾的那些「创意食物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220109,
					"content": "每次他拿到新食谱之后，顶多只会按照那些食谱记录的方法做一两天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220110,
					"content": "然后，他就会开始…用各种方法「改造」那些食谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220111,
					"content": "他为什么要这么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "据他说，是为了让那些菜的成本变便宜什么的…但我是不太清楚他为什么这么做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220118,
					"content": "但不管怎么说，从结果上来看，他也确实把那些菜改造成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220119,
					"content": "味道和原版的菜大致相同，但制作成本却低得离谱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220120,
					"content": "我之所以会愿意和他同行，也是因为他这种离谱的烹饪手法。而他之所以愿意接纳我，应该也是看中了我的技术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220121,
					"content": "所以，你想让我帮什么忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "啊…喔！对，光顾着说旭东的事了，差点忘了正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220128,
					"content": "因为旭东成天都在拉着我改造那些食谱，还直接在那些食谱上写写画画…有些食谱的配方都乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220129,
					"content": "为了能有个正经的对照物，我还是想要把那些食谱准确地复原出来，然后存档一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220130,
					"content": "旅行者，如果你记得那些食谱的话，能帮我回忆一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220131,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "那就拜托你了，我先把那些乱掉的食谱整理一下，你稍微帮我修正一下不清楚的地方就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220132,
					"content": "我是吃遍提瓦特的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "你的技术？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "我之前没和你说过吗？我在教令院的研究课题是「万能调料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220125,
					"content": "简单来说，就是一种只要加入菜里，无论什么菜都能变得美味的超级调料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220126,
					"content": "为了研究出这种调料，我才外出游学搜集各种美食的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220127,
					"content": "咳，说远了，我们还是接着说食谱的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220113,
					"content": "他具体怎么改造的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "嗯…他的改造方法还不同于其他厨师，其他厨师改造食谱，大多是让食谱变得更加丰富，让做出来的菜能卖更多钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220115,
					"content": "但旭东改造那些食谱的时候，却似乎有着另一种完全不同的改造原则…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220116,
					"content": "比如他用土豆…蘑菇…还有另外一些廉价的蔬菜食材做了一道素菜，但是吃的时候，却是香嫩椒椒鸡的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220117,
					"content": "还有用土豆、稻米、莲蓬、绝云椒椒、面团和兽肉做的简易版「仙跳墙」，口感和味道居然都和原版差不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220106,
					"content": "你们不是「全能美食队」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "拜托你不要再重复这个名字了，我的论文里绝对不会出现这五个字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220108,
					"content": "再说了，我之所以记不清那些食谱，大部分原因也就是旭东成天折腾的那些「创意食物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "芭尔瓦涅"
				}
			]
		},
