			"trigger": {
				"objectNames": [
					"芭尔瓦涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220201,
					"content": "蒙德有一道「北地苹果焖肉」，旭东这家伙又在乱写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220202,
					"content": "「黄油略贵，兽肉难储，不如揉和面团，洗出面筋，再将面筋入屉蒸熟，佐以蔬果调料，入口亦有肉感。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220203,
					"content": "这家伙，黄油有什么贵的，兽肉直接去买新鲜的不就好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220204,
					"content": "算了…旅行者，我想问你的是，这道「北地苹果焖肉」的原料，除了苹果、黄油和兽肉之外，还有一道材料是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220205,
					"content": "杏仁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "唔…是这样吗？我先记一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220206,
					"content": "胡椒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "唔…是这样吗？我先记一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭尔瓦涅"
				},
				{
					"id": 220220208,
					"content": "绝云椒椒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "火腿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
