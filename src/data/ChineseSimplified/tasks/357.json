				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "风魔龙…竟然开始直接袭击城市内部了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572302,
					"content": "#凯亚、{NICKNAME}，你们来得正好，我们赶快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572303,
					"content": "等等，安柏。这里还有人没来得及互相认识吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572304,
					"content": "啊…好的。这是凯亚，是我们的骑兵队长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572305,
					"content": "#这两位是远方来的旅者，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572306,
					"content": "（只知道是「远方」吗…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572307,
					"content": "事情是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3572308,
					"content": "原来如此，欢迎来到蒙德。但很遗憾，是在这种糟糕的时机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572309,
					"content": "我很理解血亲分离的痛苦心情，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572310,
					"content": "另外，虽然不知道你们为什么要找风神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572311,
					"content": "但每个人都有自己的秘密，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572312,
					"content": "哈哈，我是不会追问的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572313,
					"content": "总之，首先我要代骑士团向你们道谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572314,
					"content": "不能放着灾难不管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "刚才那场抵御魔龙的战斗，被守护的市民们都是亲眼目睹了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572319,
					"content": "代理团长大人对两位也很有兴趣，希望能在<color=#00E1FFFF>骑士团总部</color>一叙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572315,
					"content": "不客气，那么谢礼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "嗯…蒙德特色的蜜酱胡萝卜煎肉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 3572317,
					"content": "这句话我刚才已经听过了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}