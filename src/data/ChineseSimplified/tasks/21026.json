					"岳川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "怎么样，你把漂流瓶放出去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261002,
					"content": "小蒙真的能捡到吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "嗯…应该很难吧。一般来说都是捡不到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261004,
					"content": "那不就完全没有意义了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210261005,
					"content": "哎呀，别急嘛。我都说了，某位可靠的成年人会帮他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261006,
					"content": "你们知道「须弥」这个地方吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261007,
					"content": "我正好有几个做生意的兄弟。他们正在筹划做点蘑菇生意，最近正准备去那边考察一下呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261008,
					"content": "哈哈哈，你们也知道。说是去须弥「考察」，其实也就是去那边玩一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261009,
					"content": "既然那位叫小蒙的小朋友有外出旅行的念头，那我也正好帮他联系一下，看我的那些兄弟们能不能多带个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261010,
					"content": "你们就别操心了，这件事我来安排吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261011,
					"content": "这封信我抄了一份，还有别的用途。至于那个漂流瓶…就随它去吧。我估计也不会有人捡到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261012,
					"content": "谢谢你愿意帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "成年人帮小孩子圆梦，这不是很正常的事吗？这件事就交给我了，你们放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261015,
					"content": "对了，我还得让我那几位兄弟穿正式点，别吓着人家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261013,
					"content": "你为什么愿意帮小蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
