			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岳川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "这漂流瓶里信的字迹，看着像是个小孩子写的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260102,
					"content": "小蒙？这孩子是谁啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260103,
					"content": "咦？这个漂流瓶是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "旅行者？听你这口气，你是认识写这封信的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260105,
					"content": "算认识吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "原来是这样。这孩子想得倒挺多的。想要变得成熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260108,
					"content": "我想，他只要能去外面旅行一次，开开自己的眼界，这些烦恼说不定就能迎刃而解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260109,
					"content": "这么一说，小蒙自己也说过，想要去璃月港外面看看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210260110,
					"content": "不过，我们明明也邀请过他，为什么他不直接答应呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210260111,
					"content": "哈哈哈，也许这是那位小小男子汉的一点「倔强」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260112,
					"content": "既然是自己的烦恼，当然是要自己亲手解决，不能一味依靠别人来帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260113,
					"content": "那小蒙光是丢漂流瓶，也不能解决问题啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210260114,
					"content": "所以，这个时候就要有一位可靠的成年人来帮帮他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260115,
					"content": "来，旅行者，我们一起给这位小朋友写一封信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260116,
					"content": "用这封信来告诉他，外面的世界会有什么新奇的事物在等着他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260117,
					"content": "不过…嘿嘿，我没去过多少地方，具体要写什么地方的新奇事物，还是由你来决定吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260118,
					"content": "关于被暴风围绕的高塔废墟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "说慢点，说慢点。我还没记完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260122,
					"content": "唔，这里…要这么写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260123,
					"content": "好！完成了，不知不觉居然写了这么多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260124,
					"content": "哈哈哈，听着你说的这些，我都有点想去外面旅行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260125,
					"content": "出去旅行也不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "我都这个年纪了，有太多的事要做，已经没有随意出去旅行的权利啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260127,
					"content": "这封信我已经装在漂流瓶里了，你快去放进河里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260119,
					"content": "关于被雷暴围绕的海外群岛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "关于被雷神一刀斩开的岛屿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "是璃月港里的一个孩子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
