				]
			},
			"dialogs": [
				{
					"id": 740360201,
					"content": "塞勒，现在能盖章吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360202
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360202,
					"content": "能！当然能，你带钥匙来了吧？先在这里签个字吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360203
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360203,
					"content": "我还以为你们有了这件机器之后，就不用签字了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360204
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360204,
					"content": "这个嘛…这个机器最终还是得人来操作，那可不就得签字作保吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360205
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360205,
					"content": "但是这机器的保密性可是一流的，没有钥匙的话，就算是我也没法让它动起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360206
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360206,
					"content": "把文件放下面吧，一定要对准。再把钥匙插进这个孔里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360207
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360207,
					"content": "这就是那个「自动盖章机」吗？看起来还真…普通呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360208,
					"content": "这样是吧，然后我就扭一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360209
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360209,
					"content": "等会，保持这个姿势先别动，我还得给你留个影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360210,
						740360211
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360210,
					"content": "你不怕泄密吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				},
				{
					"id": 740360212,
					"content": "这是引进这台机器的时候，卡尔西先生给我们定下的规定，必须要用留影机给来盖章的人进行留档…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360253
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360253,
					"content": "我得挪个位置…别拍到这份文件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360213
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360213,
					"content": "最近复律庭里有人说马上就要下来一份文件，专门规制留影机泄密这件事。我可不想当那个被打的出头鸟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360214
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360214,
					"content": "#{NICKNAME}，我们也往外面站站吧，要是被拍进去的话，说不定我们也会卷入什么「秘密事件」里呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360255,
					"content": "塞勒小心翼翼地留好了影…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360215
					]
				},
				{
					"id": 740360215,
					"content": "…拍好了，你开机器吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360216
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360216,
					"content": "我扭了啊，这机器怎么没动静？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360217
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360217,
					"content": "不可能，我刚修过这台机器，总不能又坏了吧？让我检查一下，别担心，很快就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360218
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360218,
					"content": "塞勒低头检查起了机器…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360219
					]
				},
				{
					"id": 740360219,
					"content": "怪了，什么毛病也没有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360220
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360220,
					"content": "重新插拔钥匙看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360221
					]
				},
				{
					"id": 740360221,
					"content": "好吧，我来试试看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360222
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360222,
					"content": "艾尤恩拔出钥匙，又重新插了回去。机器依旧没有动静…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360223
					]
				},
				{
					"id": 740360223,
					"content": "没有动静啊，塞勒，想想办法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360224
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360224,
					"content": "也许是你没有把文件的位置对准？你得把文件卡在这些卡扣上才行，里面都有隐藏的触发机括呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360225
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360225,
					"content": "文件和机器有关系吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360226
					]
				},
				{
					"id": 740360226,
					"content": "当然，不然这台机器怎么知道有文件在下面等着盖章呢，这可是一台自动盖章机，又不是由我手动操作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360227
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360227,
					"content": "天哪…好吧，好吧！我这就把文件重新放一遍，对准所有卡扣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360228
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360228,
					"content": "艾尤恩拿出文件，重新摆放进去。机器依旧没有动静…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360229
					]
				},
				{
					"id": 740360229,
					"content": "没作用，它还是一动不动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360230
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360230,
					"content": "不对啊，上次我只是拍了一下，这机器就继续工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360231
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360231,
					"content": "那我去拍拍它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360232
					]
				},
				{
					"id": 740360232,
					"content": "我们已经不得不诉诸如此…接近于祈祷的行为来维修机器了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360233
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360233,
					"content": "至少我们还有祈祷的机会不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360234
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360234,
					"content": "（轻轻拍打这台机器。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360235
					]
				},
				{
					"id": 740360235,
					"content": "（这台机器用沉默给了你回答…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360236
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360236,
					"content": "（略微用力地拍打这台机器。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360237
					]
				},
				{
					"id": 740360237,
					"content": "（这台机器就连抗议也懒得做出…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360238
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360238,
					"content": "（狠狠地拍打这台机器！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360239
					]
				},
				{
					"id": 740360239,
					"content": "（这台机器沉默少许，烦躁地发出了一阵稀里哗啦的声音，就像是刚睡醒的人跌跌撞撞地摔下了床…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360240
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360240,
					"content": "呜哇！什么声音，这台机器里面是不是全部坏掉了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360241,
					"content": "（…然后，这台机器踉跄着找到了它的拖鞋，摸索一阵，终于打开灯，嗡嗡地运转了起来。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360242
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360242,
					"content": "居，居然运转了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740360243,
					"content": "自动盖章机疲惫，坚定却又极富耐心地工作了起来。 在几人近乎绝望的注视下，机器以仿佛玳龟爬行一般的速度降下了印章。印章迈着步子，在文件上疑惑地蹒跚，转悠了一会后，只能无奈地坐下休憩。 最后，机器颤抖着将印章收了回去…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360244
					]
				},
				{
					"id": 740360244,
					"content": "我就说它能正常工作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360245
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360245,
					"content": "我真不知道这机器究竟哪里好了，说是自动，但它盖章的速度比手动还慢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360246
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360246,
					"content": "但它的保密性十分优秀。你瞧，我们三个人就算是这样，也没能把印章拿出来私自盖戳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360247
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360247,
					"content": "别在这种地方自鸣得意，要是有一天这台机器彻底坏了，卡尔西先生也不在，那又该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360248
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360248,
					"content": "嗯…那也没关系，我还有一枚备用钥匙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360249
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360249,
					"content": "那是用来打开这台机器的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360250
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360250,
					"content": "不，那是用来打开卡尔西先生办公室里的一个箱子，里面放着一枚备用公章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360251
					],
					"speakerTitle": "塞勒"
				},
				{
					"id": 740360251,
					"content": "…旅行者，我们赶紧回去把这份文件给装订好，交给迪福尔先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360252
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360252,
					"content": "我真是等不及从这场噩梦中解脱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740360211,
					"content": "为什么还要留影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				}
			]
		},
		{
