				"objectNames": [
					"「船工」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "小河这边唉…银的柏树唉，银的艾草地哟，银的石头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740102,
					"content": "请问…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "哟…是客人来了？要登船吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740105,
					"content": "唉呀呀，仔细一看却是外人…可不行呢，可不行哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740106,
					"content": "不行…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "往月亮去的银璨璨的船呀，不是为你预备的哟…不要把脚踏上来，不要弄脏我的帆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740109,
					"content": "唉呀呀…雾散久矣，雾散久矣…谁还没有上船呀…金色屋子的女主人会生气的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740110,
					"content": "船…？在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "呵呵…银璨璨的船呀，太阳与山之子孙的船呀，大家要回家了，月亮上金灿灿大屋哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740112,
					"content": "可是呀可是…有的孩子迷了路，到现在还没有上船…女主人会生气的，可了不得哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740113,
					"content": "你需要帮助吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "快来登船呀，快来登船…不要再迷途了呀，不要再留恋哟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「船工」"
				},
				{
					"id": 721740114,
					"content": "你在听我说话吗…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "你在说什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "你是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
