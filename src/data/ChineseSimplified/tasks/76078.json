			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "这里也有誓言之灯，应该是某位前辈的遗物吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780502,
					"content": "灯上还残留着狂猎的污秽，想想也知道这里发生过什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780503,
					"content": "自提起誓言之灯那日起，我们的生命便与灯中的光焰相连，直至…应有的使命被达成的时刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780504,
					"content": "向您致敬，为了挪德卡莱的和平与安宁而战至最后一刻的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780505,
					"content": "那么您的灯就由我代为保管，请放心，将有英灵的冠冕为您留存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780506,
					"content": "我会将它带回总部，重新点燃后，交给能够继承这份意志的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780507,
					"content": "叶洛亚将灯清理干净，郑重地收了起来。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "这样一来，这里的狂猎就算清除干净了，前辈的英灵也有了归宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		}
