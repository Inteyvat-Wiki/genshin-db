				]
			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "根据以往的经验来看，在消灭了附近的魔物后，这里的裂隙本应自行消弭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780402,
					"content": "但是为何狂猎的气息依旧在此挥之不去…这也太奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 760780403,
					"content": "难道是有什么我还没有注意到的地方，也被狂猎的污秽浸染了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				}
			]
		},
