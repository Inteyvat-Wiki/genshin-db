				]
			},
			"dialogs": [
				{
					"id": 760780101,
					"content": "一般来说，一旦消灭了所有伴随狂猎而生的魔物，不净的气息就该散去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780102,
					"content": "但这道裂隙依然存在，这种状况不太寻常，但也并非没有先例。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780103,
					"content": "找一找这附近吧，应该有什么沾染了污秽的东西还在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7607804",
