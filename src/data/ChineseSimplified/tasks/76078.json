				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2423.771,
							211.958,
							9661.866
						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "哦，是灯。执灯人重要的随身之物，用来驱散狂猎的关键…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780202,
					"content": "灯还在，甚至灯罩上还残留着狂猎的气息，提灯的人却不在周围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780203,
					"content": "虽然有些令人扼腕，但这里发生的事不难想象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780204,
					"content": "执灯人的牺牲有时是悄无声息的，每次以这样意外的方式发现同僚的离去都令人遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780205,
					"content": "…无名的人，你留下的灯就由我来照管吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780206,
					"content": "它的躯体将被清理干净，它的灯火将被重新点燃，交给下一个立誓守护挪德卡莱的执灯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780207,
					"content": "菲林斯将灯清理干净，慎重地收了起来。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "这应该就是狂猎无法完全消失的缘由了，这盏灯就由我暂时保管，直至总部来人将它收回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780209,
					"content": "…灯下还有东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780210,
					"content": "是这位同僚的遗物吧，或许应该把它和灯放在一处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
