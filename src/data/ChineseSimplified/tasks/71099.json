				{
					"id": 710990401,
					"content": "范二哥真是的，怎么拖到今天才想起来造新戏台啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990402
					],
					"speakerTitle": "若心"
				},
				{
