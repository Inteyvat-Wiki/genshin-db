			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茶博士刘苏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990101,
					"content": "嘿呀，晦气！不讲了，我今天绝对不讲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990102
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990103
					]
				},
				{
					"id": 710990103,
					"content": "这个小戏台子太气人，几十年了都没修过，台上的人稍微一动弹，它就要嘎吱嘎吱响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990104
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990104,
					"content": "老早就跟我们东家范二爷说了这戏台得换新的，他总找借口说没有好木匠，不乐意换。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990105
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990105,
					"content": "今天我正在台上讲《海山履云记》呢，我这摆个架势它就要嘎吱一声。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990106
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990106,
					"content": "别提多破坏气氛了，台下观众都乐了，还有几个坏东西给我喝倒彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990107
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990107,
					"content": "我今天不忍了，一定得找个好木匠，直接带到二爷跟前，看他还有什么理由不换。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990108
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990108,
					"content": "我记得你是冒险家协会的对吧，我直接委托你也是一样的，你帮我找个木匠行不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990109,
						710990110
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990109,
					"content": "怎么找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990111
					]
				},
				{
					"id": 710990111,
					"content": "也是，一看你就不是璃月人，你哪儿认识好木匠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990112
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990112,
					"content": "这样吧，轻策庄「范木堂」路爷的手艺特别出名，请你代我问问他老人家愿不愿意来帮这个忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990113
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990113,
					"content": "要是他没有空，派个徒弟来也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990114
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990114,
					"content": "让范木堂的木匠给我们造戏台肯定是够了，要是造得好，以后云老板来登台我们也有面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990115
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990115,
					"content": "哎呀绝了，我这个理由想得可太好了，不由得二爷不答应哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990116
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990116,
					"content": "你放心，要是能把木匠带回来，酬金肯定不会拖欠你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990117
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990117,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990118
					]
				},
				{
					"id": 710990118,
					"content": "那就靠你了，我每天都在茶馆，有结果了回来找我就成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990110,
					"content": "找哪个木匠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990111
					]
				}
			]
		},
