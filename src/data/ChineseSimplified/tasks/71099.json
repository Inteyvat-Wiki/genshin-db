			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大雨",
					"茶博士刘苏",
					"范二爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990701,
					"content": "怎么意思？闹了半天，你们没商量好啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990702
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990702,
					"content": "哦我懂了，刘苏刘先生想造新戏台，但他说话不算数，得听范二爷的，范二爷又不想造，得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990703
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990703,
					"content": "你俩商量好了再给我个准话吧，我也赶了老久的路，先到边上候着去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990704
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990704,
					"content": "唉，这叫什么事儿啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990705,
						710990706
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990705,
					"content": "所以我白跑了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990707
					]
				},
				{
					"id": 710990707,
					"content": "别急别急，我再说说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990708
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990708,
					"content": "二爷啊，我们今天要是心疼造戏台这点小钱，以后就要亏大钱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990709
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990709,
					"content": "你想啊，每次云老板在我们这儿登台，人家耍花枪那么一亮相，还没等观众叫好，戏台子先响起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990710
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990710,
					"content": "你说尴尬不尴尬？本来云翰社就是挂靠在我们这儿，到时候人家一不高兴去了别处，我们就亏大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990711
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990711,
					"content": "凭云老板跟我的交情，她是不会这么干的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990712
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990712,
					"content": "您还以为我们高枕无忧呢？我可听说最近大家都爱去三碗不过港，不爱上我们这儿来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990713
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990713,
					"content": "那田铁嘴名头都比我大了，您倒是有点忧患意识啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990714
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990714,
					"content": "云老板给茶馆挣了这么多钱，我们造个戏台这点钱出不起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990715
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990715,
					"content": "谁叫我呀？哦，是刘苏先生，今天是怎么了，生这么大气？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990716
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990716,
					"content": "没有没有，说不上生气。云老板今天过来，是安排了戏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990717
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710990717,
					"content": "倒不是，只是想来茶馆喝喝茶，顺便来看望看望二爷和刘苏先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990718
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990718,
					"content": "#啊，巧得很，原来{NICKNAME}也来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990719,
						710990721
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990719,
					"content": "没想到你来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990720
					]
				},
				{
					"id": 710990720,
					"content": "有缘自然能相会，我可不觉得意外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990723
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990723,
					"content": "哈哈哈，还是云老板说话中听，来来来，我托人从翘英庄捎了新茶，我们泡它一壶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990724
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990724,
					"content": "二爷，我刚在楼下听到茶馆的戏台要修了，您终于肯动这个老物件了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990725
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990725,
					"content": "咳咳…这个不着急，我还要从长计议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990726
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990726,
					"content": "哦？从长计议…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990727
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990727,
					"content": "说起来，您知道我去轻策庄，是在哪家吃的饭吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990728
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990728,
					"content": "别卖关子了，你又去看若心了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990729
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990729,
					"content": "您一猜就准！若心前辈还问起今天的和裕茶馆什么样呢，我说一切都跟她年轻时一样，然后她说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990730
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990730,
					"content": "她说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990731
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990731,
					"content": "哎呀我忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990732
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990732,
					"content": "你这个云丫头，平时记性挺好，怎么今天这么重要的事还能忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990733
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990733,
					"content": "算了，一切保持原样，她也会开心的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990734
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990734,
					"content": "你们年轻人就喜欢新东西，一点不念旧，说多了你们也不懂，就知道催我，哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990735
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710990735,
					"content": "#别生气嘛二爷，先喝茶先喝茶，我来给大家泡。{NICKNAME}和刘苏先生来帮我取点茶叶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990721,
					"content": "刚刚想到云堇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990722
					]
				},
				{
					"id": 710990722,
					"content": "你真是的，就爱开玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990723
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710990706,
					"content": "说好的酬金呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990707
					]
				}
			]
		},
