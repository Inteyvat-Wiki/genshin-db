			"dialogs": [
				{
					"id": 710991101,
					"content": "行吧，这几块木板应该够用了，我这就开工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991102
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991102,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710991103
					]
				},
				{
					"id": 710991103,
					"content": "不错不错，果然修旧如旧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991104
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991104,
					"content": "什么都没变啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991105
					]
				},
				{
					"id": 710991105,
					"content": "这位年轻师傅，麻烦你从轻策庄走了这么远的路，工钱方面，你出个价吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991106
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991106,
					"content": "我还以为接了个大活，结果只要修补几块木板，那就简单了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991107
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991107,
					"content": "我是个新人，也不跟你多要，两顿饭钱就差不多了，你给八千吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991108
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991108,
					"content": "这个价格真是公道，很好很好，不过我只能出两千。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991109
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991109,
					"content": "什么？你不如直接叫我打白工算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991110
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991110,
					"content": "我们二爷是这样的，砍价讲究一个对截拦腰砍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991111
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710991111,
					"content": "每逢讲价都是先砍一半，再削一半，比较…嗯…「精打细算」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991112
					],
					"speakerTitle": "茶博士刘苏"
				},
				{
					"id": 710991112,
					"content": "好家伙，你这个老板真够抠门的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991113
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991113,
					"content": "就补了几块木板嘛，两千两千，多一摩拉我也给不出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991114
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991114,
					"content": "算了，这也是我第一件委托，这个哑巴亏我吃了，回头老板你给多宣传宣传我们范木堂啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991115
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991115,
					"content": "当然当然，那是一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991116
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991116,
					"content": "这位年轻朋友，你也辛苦了，酬金我不会亏你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991117
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991117,
					"content": "你觉得这份图纸怎么样，我看画得很仔细啊，应该值不少钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991118,
						710991119
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991120
					]
				},
				{
					"id": 710991120,
					"content": "啊哈哈，不精打细算怎么做生意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991121
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991121,
					"content": "还有云老板，你一上门就帮我解决了一个小麻烦，我该怎么谢你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991122
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991122,
					"content": "二爷说笑了，这有什么谢不谢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991123
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710991123,
					"content": "我今天到茶馆来，本来是想看看您家「星燕」姑娘，请她陪我一起去看摇滚演出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991124
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710991124,
					"content": "哦哦，这个云丫头，又想听那个什么摇滚演出了啊？来跟我串供了是吧，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991125
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991125,
					"content": "这怎么是串供呢，我只是好久没见「星燕」了，很想念她这个好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991126
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710991126,
					"content": "要是我们戏社的人问起来，您知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991127
					],
					"speakerTitle": "云堇"
				},
				{
					"id": 710991127,
					"content": "我知道了，「你问云老板啊？云老板来找我家『星燕』一起绣了半天的花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991128
					],
					"speakerTitle": "范二爷"
				},
				{
					"id": 710991128,
					"content": "我到时候就这么说，你满意不满意呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991129
					],
					"speakerTitle": "范二爷"
				},
