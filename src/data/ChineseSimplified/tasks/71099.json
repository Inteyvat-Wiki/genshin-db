			},
			"dialogs": [
				{
					"id": 710990601,
					"content": "您瞧好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990602
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990602,
					"content": "大雨忙活了一阵。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710990603
					]
				},
				{
					"id": 710990603,
					"content": "最后一把椅子也打好了，村长奶奶拿好，这下我该去和裕茶馆干活啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990604
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990604,
					"content": "师父您等着啊，我大概几天就回了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990605
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990605,
					"content": "嗯，去吧去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990606
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990606,
					"content": "成，那我现在出发，差不多明天晚上就能赶到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990607
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990607,
					"content": "我们和裕茶馆见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				}
			]
		},
		{
			"id": 7109907,
			"completionStepIds": [
				7109907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
