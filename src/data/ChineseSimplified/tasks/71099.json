				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990301,
					"content": "这年轻人，风尘仆仆的，急什么，坐下来喝杯茶嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990302,
						710990303
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990302,
					"content": "路爷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990304
					]
				},
				{
					"id": 710990304,
					"content": "向路爷解释了刘苏的委托…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710990305
					]
				},
				{
					"id": 710990305,
					"content": "哦哦，造新戏台不难，但找我是找错人喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990306
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990306,
					"content": "轻策庄到璃月港那么远呢，我去璃月港了谁来照看「范木堂」呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990307
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990307,
					"content": "更何况我这老胳膊老腿，哪儿走得动那么远的路，年纪大啦，经不起折腾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990308,
						710990309
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990308,
					"content": "那不麻烦范木堂了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990310
					]
				},
				{
					"id": 710990310,
					"content": "哎别急啊，你都大老远来一趟了，我给你推荐个能干又利索的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990311
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990311,
					"content": "他虽然还不是我的徒弟，但我有心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990312
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990312,
					"content": "路爷，村长要的椅子一套四只，除了最后一只木头不够，其他我都打好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990313
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990313,
					"content": "辛苦大雨帮村子里干活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990314
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990314,
					"content": "正好，说到他他就到。我刚才是想说，你找大雨也是一样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990315
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990315,
					"content": "找我？路爷还没收我当徒弟呢，我可不能代表范木堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990316
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990316,
					"content": "就你话多，人家是代璃月港的和裕茶馆来的，要请我们上门去造个新戏台。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990317
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990317,
					"content": "哦，请「我们」去造戏台？我跟路爷合起来算是「我们」，村长奶奶您听见了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990318
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990318,
					"content": "听见了，呵呵老路啊，大雨这孩子放着别的木匠师傅不跟，跑到范木堂跟着你学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990319
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990319,
					"content": "他做事又快又好心还诚，你也差不多得了，收了人家当徒弟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990320
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990320,
					"content": "知道了知道了，我都让他代我上门给人家干活了，我这什么意思你们还不明白吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990321
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990321,
					"content": "谢谢师父！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990322
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990322,
					"content": "大雨，师父给你派的第一件活就是给和裕茶馆造戏台，好好干，不要丢了我的脸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990323
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990323,
					"content": "小意思，在群玉阁上建戏台的木匠我给他打过下手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990324
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990324,
					"content": "少吹点牛吧，和裕茶馆的老戏台用了几十年都没换，你这次去也得给人家造一个结实的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990325
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 710990325,
					"content": "哦，闹了半天原来是范二哥要换戏台，他怎么拖到今天还在用那个小戏台…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990326
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990326,
					"content": "行，我把手上这最后一把椅子打完就出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990327
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990327,
					"content": "#这位{M#小哥}{F#姑娘}，不好意思你还要等等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990328
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990328,
					"content": "这最后一把椅子还缺三根松木，我去砍点松木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990329,
						710990330
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990329,
					"content": "还要等等？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990331
					]
				},
				{
					"id": 710990331,
					"content": "那要不然您原地掏三根松木出来也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990332
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990332,
					"content": "明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990333
					]
				},
				{
					"id": 710990333,
					"content": "真掏啊？那要不然您受点累，再给一份红染料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990334
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990334,
					"content": "你等着！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990335
					]
				},
				{
					"id": 710990335,
					"content": "嘿嘿，您大人有大量，别跟我计较。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990330,
					"content": "等不了了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990331
					]
				},
				{
					"id": 710990309,
					"content": "佣金只能给别人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990310
					]
				},
				{
					"id": 710990303,
					"content": "有件事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990304
					]
				}
			]
