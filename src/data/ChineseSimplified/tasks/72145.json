			"dialogs": [
				{
					"id": 721450101,
					"content": "「…有谕大御神神使目有三瞳，一曰『灵』；一曰『镜』；一曰『实』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "古老的石碑"
				},
				{
					"id": 721450102,
					"content": "「…自海渊蓁蓁而起，出于<color=#00E1FFFF>南</color>，越于<color=#00E1FFFF>北</color>，盘桓<color=#00E1FFFF>西</color>岗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "古老的石碑"
				},
				{
					"id": 721450103,
					"content": "「…三瞳灼灼而无所赦，是故龙嗣怪异等莫有敢敌…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "古老的石碑"
				},
				{
					"id": 721450104,
					"content": "唔…每个字都认得，连起来就完全不知在说什么了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721450105,
					"content": "附近看起来也没有线索…不如用<color=#00E1FFFF>「元素视野」</color>试试看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
