			"dialogs": [
				{
					"id": 746880101,
					"content": "真是远超预期的作战结果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880102
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880102,
					"content": "准领队和小助手，你们击败的魔物已经达到了整编连队的级别！目前看来，遗迹里的魔物完全不可能外逃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880103
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880103,
					"content": "感觉怎么样？辛苦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880104,
						746880107
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880104,
					"content": "还好，只是眼睛看得有点花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880105
					]
				},
				{
					"id": 746880105,
					"content": "嗯，炮口的闪光，虽然不至于特别亮，但看久了，还是有点头晕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880106,
					"content": "这个好说！有论文提到过，可以通过炮口装置抑制闪焰，改善长期射击的视觉疲劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880110
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880110,
					"content": "总之，危机解决了，收集到的资料也足够了，我肯定可以把下一代重炮改进得更完善！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880111
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880111,
					"content": "实在感谢你们的支援，准领队和小助手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880112
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880112,
					"content": "还有在准领队到来前，起了决定性作用的玛因小姐，奖金都给准领队，我这边卖出重炮后的收益就分你一半好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880113
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880113,
					"content": "啊，还有我的份吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880114
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746880114,
					"content": "摩拉什么的无所谓了，不如给我准备一些酒酿汐藻…要小麦酒基底的，不能用果酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880115
					],
					"speakerTitle": "玛因"
				},
				{
					"id": 746880115,
					"content": "还有这种小吃吗？听名字，我都有点想试试看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880116,
						746880117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880116,
					"content": "派蒙不能沾酒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880118
					]
				},
				{
					"id": 746880118,
					"content": "我懂！那就把酒酿换成枫达酿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880119,
					"content": "这…完全没听过的特色菜…要上哪去给你找？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880120
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880120,
					"content": "前辈，不如正好趁这个机会，发明「自动风味汐藻腌渍器」之类的新品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880121
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880121,
					"content": "反正前辈给我做的「早餐自动烘焙机」非常可靠，说明你在料理装置领域，也有着惊人的才华。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880122
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880122,
					"content": "而且，料理装置的市场广阔得多，不像重炮，必须做到性能最为突出，战胜强大的对手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880123
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880123,
					"content": "也就不必每次都前往危险地带，抢着和魔物作战，收集关键数据了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880124
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880124,
					"content": "咦…是这样吗？我的确可以尝试转型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880125
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880125,
					"content": "不过，如果现在转变成料理机关发明家，岂不是前功尽弃了？而且也和警备队的工作不搭边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880126
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880126,
					"content": "你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880127
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880127,
					"content": "唉…也对。随随便便就放弃的话，也不像前辈你的性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880128
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880128,
					"content": "我突然想到，除了利用警卫机关的识别模块强化重炮，还可以将一些机关正式固定成重炮单位内的「护卫机关」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880129
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880129,
					"content": "有了这些护卫机关的专职保护，就算有魔物进入射界的盲区，也不用担心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880130
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880130,
					"content": "然后，将这些机关作为重炮的「打包解决方案」，向买家推销…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880131
					],
					"speakerTitle": "谢妮"
				},
				{
					"id": 746880131,
					"content": "哎！还真的挺不错的，能一下解决买家的痛点…这个主意相当成熟，值得好好细化论证！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880132
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880132,
					"content": "感觉他们随便聊两句，灵感就呼呼涌出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880133,
					"content": "如果把这两人关在一个房间里，几个礼拜不许他们离开，说不定能积累一大堆新奇的发明方案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880117,
					"content": "派蒙不能乱吃东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880118
					]
				},
				{
					"id": 746880107,
					"content": "哎吔，炮声震得我耳朵好疼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880108
					]
				},
				{
					"id": 746880108,
					"content": "我也一样！耳朵嗡嗡的…好像有一千只渔鸥在嚷嚷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880109,
					"content": "我有办法！有个工程废案提到过，可以通过多腔体的膛口装置减速燃气，降低开火时的噪音，就是材料比较贵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880110
					],
					"speakerTitle": "弗雷瑞斯"
				}
			]
		}
	]
}