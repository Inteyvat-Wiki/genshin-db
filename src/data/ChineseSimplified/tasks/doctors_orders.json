			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"扎卡里亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "这次的药是要送给药田的古尔根。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180202,
					"content": "这位老兄前几天工作得太用力，把自己的胳膊给拉伤了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180203,
					"content": "你就把这副药送给他，顺便告诉他，今天在家里向草神大人默祷吧，不要下地干活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180204,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "送完药就回来找我吧，我会准备好报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180205,
					"content": "向草神大人默祷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "我不这么说，他怎么可能会听？好了，你就按我说的来做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "扎卡里亚"
				}
			]
		},
