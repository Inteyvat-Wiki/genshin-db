				{
					"id": 230181601,
					"content": "你回来了，一切顺利么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230181602,
					"content": "他已经有好几天没吃肉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "什么？我就是叮嘱他吃得相对清淡一点，也没让他完全不吃肉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230181604,
					"content": "为了更好地承接草神大人的恩惠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230181605,
					"content": "好吧…我回头得把说法再变一变…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230181606,
					"content": "你也辛苦了，这些报酬就请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亚"
				}
			]
