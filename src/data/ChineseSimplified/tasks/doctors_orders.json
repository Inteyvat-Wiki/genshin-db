			"trigger": {
				"objectNames": [
					"扎卡里亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "唉，真不让人省心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180102,
					"content": "有什么要帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "最近我们的人手实在是不够，我已经连续几天没休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180120,
					"content": "旅行者，你如果有空的话，可以帮我送药给附近的病人吗？也请一并看看他们的状况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180121,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "那就拜托你了，看在草神的份上，我真的很需要一个不会整天念叨草神保佑的人给我帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180123,
					"content": "哈，看在草神的份上…我念得真熟练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180124,
					"content": "你还是休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "我可休息不得，还有一些更重的病人被我安置在别处了，我还得为他们配药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180126,
					"content": "唉，那些病人肯定又要问我，他们该用什么方法承接草神的恩泽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180127,
					"content": "拜托你了，旅行者，我真的很需要一个不会整天念叨草神保佑的人给我帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180103,
					"content": "这里发生什么事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "你是旅行者吧，这里是「健康之家」，是一家为普罗大众…嗯…广布草神恩泽的医院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180105,
					"content": "无论贫富，我们都会为需要的人提供医疗帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180106,
					"content": "不过也拜此所赐…最近来就诊的病人太多，实在有些忙不过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180107,
					"content": "唉，就算草神对我们的仁慈是无限的…但医院的预算和人力却是有限的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180108,
					"content": "有一些病人压根不听医嘱，只是一个劲地问我，他该怎么样才能更好地承接草神恩泽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180109,
					"content": "哈哈，草神恩泽…看在老天的份上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180110,
					"content": "要是草神真的能直接降下恩泽，他们压根就不会得病了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180111,
					"content": "…呼，抱歉，我不该说这样的话，你可别告诉戈尔珊，不然她又要开始唠叨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180112,
					"content": "你不是一个虔诚的草神信徒吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "我确实是，这须弥城里还有谁不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180114,
					"content": "但你可以把虔诚这两个字换掉，我是一个…相对理性的草神信徒，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180118,
					"content": "呃…抱歉，我一定是太累了，这是我个人的一点情绪，你别当真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180115,
					"content": "有人说治疗本身就是草神恩泽…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "唉，这些话你听听就行了，别和那些病人一样把这件事当真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "扎卡里亚"
				},
				{
					"id": 230180117,
					"content": "如果草神真有这么全能，那我就直接给病人吃点蘑菇，他们就能痊愈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "扎卡里亚"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
			],
