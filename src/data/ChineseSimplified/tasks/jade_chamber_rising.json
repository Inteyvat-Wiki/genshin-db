			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "今天召集诸位，是想宣布一件重要的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090102,
					"content": "或许有人已听到过风声，最近我确实打算重修群玉阁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090103,
					"content": "重修群玉阁？这可是个大工程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "宏飞"
				},
				{
					"id": 110090104,
					"content": "坊间传闻确有其事啊，难怪前段时间建材价格飞涨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "昌贵"
				},
				{
					"id": 110090105,
					"content": "群玉阁对凝光大人意义非凡，如果能搭上这条线…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110090106,
					"content": "凝光大人，有什么需要我们帮忙的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "宏飞"
				},
				{
					"id": 110090107,
					"content": "不必心急。前些日子消息传开后，有不少人通过各种渠道联系我，想要加入到这个工程中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090108,
					"content": "眼下我手里确实有几件事，想委托给诸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090109,
					"content": "如今工程已经完成选址，各式建材准备妥当，但尚有三件至关重要的物品没有着落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090110,
					"content": "这三件物品，分别是「鸣霞浮生石」、「千奇核心」以及「仙家符箓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090111,
					"content": "这…恕我冒昧，除了浮生石外，后面两样我从未听说过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "昌贵"
				},
				{
					"id": 110090112,
					"content": "规格够大的浮生石，才能冠以「鸣霞」之称，这是保证群玉阁能够升空的基础。千奇核心，则是群玉阁内机械结构的核心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090113,
					"content": "至于仙家符箓，它的效用是将机械装置与仙家术法有效结合，同样不可或缺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090114,
					"content": "虽是三样罕见之物，但以诸位的人脉和能力，找齐它们应该只是时间问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090115,
					"content": "兵贵神速，一切全看效率。我会以好价收购你们找来的材料。此外，前三位找齐材料的人，将得到一次向我提问的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090116,
					"content": "无论是什么问题，我都会回答。我相信，以此为报酬，必不会令各位失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090117,
					"content": "这东西虽然难找，但如果能问到璃月港明年的规划…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "昌贵"
				},
				{
					"id": 110090118,
					"content": "那就是天价的生意了。谁从凝光大人那里问到消息，谁就掌握了先机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "志成"
				},
				{
					"id": 110090119,
					"content": "哈哈，真是巧了！不久前我刚听说过有关浮生石的传闻。各位，恕不奉陪了，我先行一步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "宏飞"
				},
				{
					"id": 110090120,
					"content": "可恶…我们也赶紧出发，不能被别人抢先了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "昌贵"
				},
				{
					"id": 110090121,
					"content": "重修群玉阁…这么重要的事情，我们也去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090122,
					"content": "方才我说的话，你们都听到了吧。如何？可有兴趣参与此事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090123,
					"content": "真的什么都可以问吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "只要是我知道的事，均可如实相告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090125,
					"content": "#（说不定可以问到关于{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "真的吗？那我要问，凝光小姐是怎么经商的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090127,
					"content": "这样以后旅行，我们就再也不缺摩拉用啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090128,
					"content": "呵呵，当然可以。不过，传授多少心得，全看二位的表现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090129,
					"content": "群玉阁重建一事占地较大，我将地址安排在黄金屋外的废弃矿场。收集到的材料，都送去那边吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090130,
					"content": "我另有要事，不能陪你们前往现场。你们到了那里，联系我的秘书就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090131,
					"content": "千万注意时间。难得的机会，可别被别人抢先了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 110090132,
					"content": "凝光小姐真是个大忙人呢…我们也快点出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090133,
					"content": "#首先得先从玉京台离开…咦？{NICKNAME}你看，那边气氛好像有些微妙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090134,
					"content": "小姐，我看你风度翩翩、气质不凡，一看就是在这次重修群玉阁中独占鳌头的料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090135,
					"content": "我们这里有关于那些材料的情报，来，咱们找个安静的地方说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090136,
					"content": "不需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090137,
					"content": "别这么说嘛。哎，别走啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090138,
					"content": "愣着干什么，还不快跟上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090139,
					"content": "是…是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿强"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鹤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "嘿嘿，小姐，这次你终于没地方跑了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090202,
					"content": "放心，我们也不是什么坏人。出点钱就能换到宝贵的情报，大家谁都不亏嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090203,
					"content": "老大，我总有种不好的感觉。你看她身上的气质明显和别人不同，头发也是白的，不像是普通人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "阿强"
				},
				{
					"id": 110090204,
					"content": "那又如何？好不容易遇见一只肥羊，不宰她一刀，咱们的赌债怎么还？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090205,
					"content": "我说了，我不需要你们的情报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090206,
					"content": "如果你们刚刚没有听到，那我再重复最后一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090207,
					"content": "唉…小姐，你说你这么大一个人，怎么一点常识也没有啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090208,
					"content": "这不是你需不需要的问题，你只要乖乖地把钱拿出来，交给我们就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090209,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090210,
					"content": "别狡辩！你有钱，我看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090211,
					"content": "你先去琉璃亭，点了满满一桌子菜，却只是稍微尝了尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090212,
					"content": "然后又去新月轩、万民堂，把招牌菜全点了一遍，又是每样只吃一口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090213,
					"content": "如果不是富家千金小姐，哪来如此奢侈的习惯？既然你这么有钱，分我们一点怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090214,
					"content": "虽然师父叮嘱过，不要在璃月港里动手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090215,
					"content": "算了。或许…这也是命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090216,
					"content": "老大，好像有点不太对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "阿强"
				},
				{
					"id": 110090217,
					"content": "怕什么，咱们卖情报又不犯法，她要是敢动手，咱们告她个倾家荡产！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090218,
					"content": "就是他们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "哦？又是你们几个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "老郑"
				},
				{
					"id": 110090221,
					"content": "千岩军？千岩军怎么来了…是你干的？哼，多管闲事，信不信我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090222,
					"content": "住口！还敢威胁别人是吧，跟我们走一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "老郑"
				},
				{
					"id": 110090223,
					"content": "呵呵…大人别生气，您听我慢慢跟您解释…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "刀疤刘"
				},
				{
					"id": 110090224,
					"content": "围住白发女子的流氓被千岩军带走了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090226,
					"content": "你没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "…申鹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090229,
					"content": "申鹤？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090230,
					"content": "我的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090231,
					"content": "#哦哦，原来你叫申鹤呀！我的名字是派蒙，这位是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090232,
					"content": "我听说过你们。刚刚，谢谢你们帮我解围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090233,
					"content": "虽然我自己也能解决。据我判断，只要抓着那个人的脑袋敲三下地面，他应该就会服软。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090234,
					"content": "呜哇！不，不可以用那么暴力的办法啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090235,
					"content": "这里可是璃月港，要遵守璃月港的律法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090236,
					"content": "律…法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090237,
					"content": "申鹤没有听说过律法吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "我确实没有听过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090239,
					"content": "真的假的，那你以前——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090241,
					"content": "好像有什么声音…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "是我的肚子在响。因为没有吃饱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090243,
					"content": "居然这么坦率地承认了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090244,
					"content": "说起来，刚刚听那些人说，你到许多餐馆点菜，每样却只尝一口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090245,
					"content": "这样肯定是吃不饱的吧！你有什么想吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090246,
					"content": "清心、琉璃百合、琉璃袋…这些是我平时吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090247,
					"content": "这些都是药材…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "药材？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090249,
					"content": "好像解释不通…不卜庐就在这附近吧，我们不如带申鹤去饱餐一顿好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090250,
					"content": "毕竟吃饱了才有力气干活嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090227,
					"content": "放心，这样就没问题了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "这几个人在强买强卖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
