			"trigger": {
				"objectNames": [
					"阿桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "两位是来抓药的吗？可还记得药方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 110090302,
					"content": "清心、琉璃百合、琉璃袋，各要半斤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090303,
					"content": "这是什么药方？简直是拿药当饭吃…给，这就是本店全部的存货了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 110090304,
					"content": "多谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090305,
					"content": "真，真的在吃欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090306,
					"content": "在众人震惊的目光中，申鹤将眼前的药材扫荡一空。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "不饿了，多谢款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090308,
					"content": "味道如何…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "不好吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090311,
					"content": "其味虽略带清香，但吃多了就只剩下苦、酸、涩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090312,
					"content": "那申鹤为什么宁愿吃这些，也不吃饭馆里的菜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090313,
					"content": "要是我有很多摩拉的话，我肯定要去最高档的餐馆，点好多好多好吃的，一口气全部吃掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090314,
					"content": "因为我也不确定，以后自己会不会留在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090315,
					"content": "人间的饭菜固然美味，但若是我将来回归山野，对美食的回味反而会成为修炼的阻碍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090316,
					"content": "所以浅尝辄止，明白个中滋味便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090317,
					"content": "#回归山野…{NICKNAME}，不会错，这个人绝对是仙人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090318,
					"content": "我的事暂且不提，两位接下来有什么打算？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090319,
					"content": "对哦！差点忘了，我们可是来参加重修群玉阁比赛的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090320,
					"content": "耽、耽误太多时间，事情可就做不完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090321,
					"content": "原来如此。那个比赛，我刚刚路过的时候也有所耳闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090322,
					"content": "嘿嘿…毕竟赢了的话，不管什么事情都可以问呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090323,
					"content": "申鹤也是来参赛的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090324,
					"content": "我确实是为重修群玉阁而来，不过此前并没有参赛的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090325,
					"content": "如今承蒙你们照顾，我也想助你们一臂之力。放心，并不需要什么回报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090326,
					"content": "哇…这怎么好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090327,
					"content": "不过有仙人帮忙的话，事情应该会好办许多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090328,
					"content": "那我们就一起行动吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "那事不宜迟，眼下我有一个作战方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090331,
					"content": "好欸！申鹤提出来的方案，一定很厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090332,
					"content": "厉不厉害我不太清楚，不过应该很有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090333,
					"content": "只要把排名比我们靠前的人全部干掉，我们就会成为第一名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090334,
					"content": "…不可以！怎么想都不可以吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090335,
					"content": "是吗？但我听说竞争本身就是相互倾轧、相互算计…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "申鹤"
				},
				{
					"id": 110090336,
					"content": "我们可是要堂堂正正地拿下第一名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090337,
					"content": "「鸣霞浮生石」、「千奇核心」，还有「仙家符箓」…我们就按顺序找好了，首先是浮生石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090338,
					"content": "我说怎么店外就能听到争论的声音，原来是你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110090339,
					"content": "白术！你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090340,
					"content": "凝光小姐要采购一批伤药，店里的药材不一定够用，所以我亲自过来筹备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110090341,
					"content": "咦，凝光小姐要这么多伤药做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090342,
					"content": "我也不清楚，听说她要重建群玉阁，可能是工地上要用吧？总之是客人的隐私，我不便多问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110090343,
					"content": "她还从我这里借走了七七，不卜庐现在非常缺人，几位要不要留下来做份兼职？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110090344,
					"content": "不了不了，我们还有别的事情…说起来，白术见多识广，有没有听说过「鸣霞浮生石」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090345,
					"content": "是说群玉阁要用的那种吗？我记得《七臧山经》里提到过，鸣霞浮生石激活后可直上云霄，非常稀有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110090346,
					"content": "有明文记载的鸣霞浮生石基本已经被开采完毕，皆是有主之物。比起我，飞云商会应该对此更为了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "白术"
				},
				{
					"id": 110090347,
					"content": "原来如此，那我们去飞云商会问问吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090348,
					"content": "谢谢你啦，白术！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110090349,
					"content": "不客气，祝你们顺利。有什么需要的话，来不卜庐找我就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "白术"
				},
				{
					"id": 110090329,
					"content": "随时欢迎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "真的好吃吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
