			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}，派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510102,
					"content": "怎么了？哥伦比娅。你看起来像是遇到了什么麻烦一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510103,
					"content": "你们身边有颜料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510104,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510105,
					"content": "呀！你是…是梅拉对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510106,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510107,
					"content": "你又想要画画了吗？怎么还把自己身上弄得到处都是颜料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510108,
					"content": "它出去一趟回来之后，就变成了这样子。这些颜料一时间也洗不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510109,
					"content": "难道是外出取材的时候遇到麻烦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510110,
					"content": "不过这样看起来也不错啦，很有艺术气息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510111,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510112,
					"content": "哦！说回颜料，只要像上次一样给它些带颜色的东西就行了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510113,
					"content": "~~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510114,
					"content": "嘿嘿，看它这么开心，一定是取材的时候找到了些不错的灵感吧！还是很欢快的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510115,
					"content": "那我们这次找些温暖、愉快的颜色给梅拉吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
