			"dialogs": [
				{
					"id": 760510301,
					"content": "这样就可以了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510302,
					"content": "~~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510303,
					"content": "哦！它已经开始画起来了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510304,
					"content": "咳咳，请各位评委拭目以待，这次天才月灵画家梅拉，又会为我们呈现出怎样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510305,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510306,
					"content": "欸！这就画好了？我好不容易为你编的热场词都还没说完呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510307,
					"content": "哦！果然这次画的也是哥伦比娅嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510308,
					"content": "看起来真美好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "这是…在挪德卡莱的森林里吗？有好多小动物欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510311,
					"content": "那恐怕…是我还没离开「霜月之子」的时候才有的景色吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510312,
					"content": "哇，好羡慕，那些小动物真的会这么聚集过来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510313,
					"content": "嗯，它们大多是喜欢我散发出的月矩力，觉得趴在我身旁睡觉会很安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510314,
					"content": "天哪！那岂不是可以随便摸它们也不会乱跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510315,
					"content": "唔…最好摸的应该是帔髦獾，它的尾巴又大又蓬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510316,
					"content": "凛角鹿脖子上的毛也很软，用来当枕头会睡得很舒服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510317,
					"content": "你们喜欢哪一种呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510318,
					"content": "为什么是以我们也体验过为前提问的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510319,
					"content": "但要说试的话…我可能会想摸摸帔髦獾的尾巴吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510320,
					"content": "有些帔髦獾很怕生，如果周围不是很安全的话，它们是不会让人摸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510321,
					"content": "啊…不过派蒙要小心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510322,
					"content": "欸？怎么了？它们会咬人吗？我…我不会把它们摸生气的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510323,
					"content": "不，是要小心天上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510324,
					"content": "天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510325,
					"content": "嗯，有的长翎鹮会捕捉小体型的动物。以前也是在我提醒之后，它们才慢慢改掉了捕捉月灵的习惯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510326,
					"content": "这种危险在我们第一次见面的时候就该说呀！我到今天都没被抓走已经是奇迹了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510327,
					"content": "唔…好吧，下次见到长翎鹮的时候，我会提醒它们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510328,
					"content": "现在就去提醒吧！不然我都不敢出这个门了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510329,
					"content": "那我应该和长翎鹮们说，派蒙是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510330,
					"content": "最好的伙伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "对对，不能把好伙伴抓走哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510336,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760510337,
					"content": "这孩子…好像对派蒙被长翎鹮抓走的样子很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510338,
					"content": "不要拿这种画面来当素材呀喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510332,
					"content": "最好的向导。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "呃…你这么记着我倒是很开心，但长翎鹮不知道什么叫「向导」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510334,
					"content": "吃了会坏肚子的东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "不要以吃进肚子为前提啦！万一长翎鹮真想试试怎么办！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760510309,
					"content": "看起来真开心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
