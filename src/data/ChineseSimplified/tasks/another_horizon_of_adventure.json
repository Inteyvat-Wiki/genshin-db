			"dialogs": [
				{
					"id": 746670201,
					"content": "向着星辰与深渊！欢迎来到冒险家协会，请问有什么可以帮您的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670202
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 746670202,
					"content": "又，又是凯瑟琳。这一位应该也是「人偶」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670203,
						746670204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746670203,
					"content": "应该是吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670205
					]
				},
				{
					"id": 746670205,
					"content": "请问我有什么可以帮您的吗？您是想要接取委托，还是发放委托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670206
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 746670206,
					"content": "我只是顺便来看一眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670207
					]
				},
				{
					"id": 746670207,
					"content": "这样啊…如果您遇见了任何和协会有关的问题，都可以来问我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670208
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 746670208,
					"content": "我会竭诚为您提供最完善的服务，解答一切能够解答的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670209
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 746670209,
					"content": "那么，感谢您对协会做出的贡献，冒险家。祝您的冒险旅途一帆风顺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 746670204,
					"content": "应该没有第二种可能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670205
					]
				}
			]
		}
	]
