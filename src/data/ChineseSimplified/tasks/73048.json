				7304801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7304801",
							"2"
						],
						"stepId": 7304801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"兰穆护昆达",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730480101,
					"content": "真怀念哪。上次见到这样的景象，距今已经有数百年了吧…能以这双眼睛，再度看见桓那兰那的梦乡，也是托你们的福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480102
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480102,
					"content": "哇！原来你的年纪这么大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480103,
						730480104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480103,
					"content": "第一次听到兰那罗说「年」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				},
				{
					"id": 730480105,
					"content": "这样吗？或许是因为我吸收了更多记忆与知识吧。在梦乡中的桓那兰那，是没有白昼与黑夜的，一切都平稳安详。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480106
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480106,
					"content": "加上我们的寿命很长。所以，我们对「时间」的概念很淡薄。我们会以树木的成长、花朵盛开、月亮升起、来衡量时间的流逝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480107
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480107,
					"content": "既然要过无忧节，那就应该要结出惟耶之实了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480108
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480108,
					"content": "嗯…这么说来，惟耶之实到底是什么东西呢？之前，兰拉迦和兰罗摩也没有怎么说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480109,
					"content": "#你们已经成为了兰那罗的朋友，那应当也听说过兰迦拉梨的原理了吧。那菈{NICKNAME}、派蒙，你们知道吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480110
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480110,
					"content": "兰拉娜提到过记忆的力量…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480111
					]
				},
				{
					"id": 730480111,
					"content": "兰拉娜吗？真是怀念，希望一切都好。虽然那家伙有点冒失，但想必是将你视为朋友，才会告诉你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480112
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480112,
					"content": "惟耶之实是将记忆与梦想抽取后，结成的果实，也就是我等兰那罗最宝贵的事物的结晶。虽说是果实，但也是希望之种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480113
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480113,
					"content": "只要是帮助他人的愿望，惟耶之实都能实现。你们和这次要准备惟耶之实的兰那罗，也有帮助他人的愿望吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480114,
						730480115
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480114,
					"content": "要拯救拉娜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480116,
					"content": "#嗯，那就没问题了。既然那菈{NICKNAME}是兰那罗的朋友，收下这个吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480117,
						730480118
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480117,
					"content": "这是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480119,
					"content": "一朵小花…之前，兰拉娜、兰纳真他们，也给我们送过花儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480120,
					"content": "这样啊。那看来尽管过去了许多年，这个习俗还是没有改变。真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480121
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480121,
					"content": "#以前，我和兰拉迦、兰拉吉…还有兰帕卡提他们一起，也为那菈法留纳送过花。{M#她}{F#他}是我们无比珍视的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480122
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480122,
					"content": "这种花即是兰那罗友情的象征，而愿意收下这朵花的人，就是许可了兰那罗的这份友情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480123
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480123,
					"content": "我们兰那罗不善言辞。是故，之于他们而言，人类朋友愿意收下他们的花，是十分值得骄傲的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480124
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480124,
					"content": "#而听说了许多那菈{NICKNAME}的故事，对我而言，你也是我所珍视的朋友。而你愿意收下我的花，于我乃是殊荣。谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480125,
						730480126
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480125,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480127,
					"content": "#我们一定会再见的。到时候，那菈{NICKNAME}、派蒙，希望你们能到我家做客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480128
					],
					"speakerTitle": "兰穆护昆达"
				},
				{
					"id": 730480128,
					"content": "啊，消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480129,
					"content": "真是个奇怪的兰那罗呢！不管了，我们去看看别的兰那罗吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480126,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480118,
					"content": "我收下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480115,
					"content": "兰拉娜希望帮助朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480104,
					"content": "你的时间概念和别的兰那罗不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				}
			]
		}
	]
}