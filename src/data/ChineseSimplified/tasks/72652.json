	"talks": [
		{
			"id": 7265201,
			"completionStepIds": [
				7265201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265201",
							"2"
						],
						"stepId": 7265201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726520101,
					"content": "旅行者，你好！最近过得怎样？有没有兴趣给南十字船队帮忙呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520102,
						726520103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 726520102,
					"content": "南十字船队…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				},
				{
					"id": 726520104,
					"content": "欸…啊哈哈哈哈，抱歉抱歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 726520105,
					"content": "我是「死兆星号」的首席技术官慕珍。以往一直呆在船舱里不怎么出来，你不认识我也正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520106,
					"content": "结果这不是被海龙大哥一脚踢出来了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520107
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520107,
					"content": "「动动你的懒骨头吧！晒晒太阳又没坏处！」这么说着就把我赶到岸上来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520108
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520108,
					"content": "可是他自己连下船都不敢，一站在陆地上就晕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520109,
						726520110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520109,
					"content": "这样啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520111,
					"content": "哦哦，真不好意思。光顾着笑话别人，把正事忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520112
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520112,
					"content": "为了给北斗大姐头的下一班航程做技术准备，我得拜托你做一些杂活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520113
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520113,
					"content": "以往这种事都是大姐头亲自来做的，因为身为「南十字」的总领，要有身先士卒探索未知险境的自觉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520114
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520114,
					"content": "这是我们「南十字」的规矩，不论我们当中谁做了老大，都要承担这份义务才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520115
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520115,
					"content": "而且大姐头她在稻妻还有更优先的订单要完成，不能为了这种小事耽误了当前的任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520116
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520116,
					"content": "所以就推给我们咯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726520117,
					"content": "嘿嘿，这不是我身为技术官不擅长打架嘛…而且船上的大家都各有各的活干。都忙得很，抽不出身来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520118
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520118,
					"content": "行了，闲话不多说啦。事情是这样的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520119
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520119,
					"content": "下一趟运单的雇主需要一批样品，就是产自此地的某种特殊遗迹机械的零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520120
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520120,
					"content": "根据雇主交给我们的目击记录分析，那些机械…或是生物，就藏匿在稻妻列岛，非常有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520121,
						726520125,
						726520130
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520121,
					"content": "雇主…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520122
					]
				},
				{
					"id": 726520122,
					"content": "怎么，想打探「南十字」的商业机密？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520123
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520123,
					"content": "哈哈，不必紧张，如果我知道的话，我也挺乐意告诉你的…不过这在行规上可是「死罪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520124
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520124,
					"content": "所以不好意思咯。雇主是谁我也不知道，对你来说也不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520134,
					"content": "它们在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520135
					]
				},
				{
					"id": 726520135,
					"content": "唉，你算是问到点子上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520136
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520136,
					"content": "苦恼的是，我也不知道它们的具体位置在何处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520137
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520137,
					"content": "不过在岛上的某些地方，出现了一些奇异的雷元素活动现象。根据我的监测，它们的频率与岛上的其他雷元素活动有很大差异…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520138
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520138,
					"content": "总之，我认为应该先调查一下那些异常区域，很可能会将结果导向我们的目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520139
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520139,
					"content": "顺便，如果它们会产生什么副产品的话，希望你能带回一些供我研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520140
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520140,
					"content": "放心，报酬我会如数付清的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520125,
					"content": "机械生物…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520126
					]
				},
				{
					"id": 726520126,
					"content": "…嗯，层岩巨渊的矿工以前也挖出过类似的东西，据说和五百年前的灾难有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520127
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520127,
					"content": "总之都是些…盘桓遗迹的不祥之物，令人生畏，却也令人兴奋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520128
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520128,
					"content": "一想到它们就在这里就受不了，真想拆一台来解解手痒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520129
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520129,
					"content": "不过你不是技术员，这种心情恐怕不懂啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520130,
					"content": "有趣…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520131
					]
				},
				{
					"id": 726520131,
					"content": "唔…你就不想亲手拆解一台来试试吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520132
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520132,
					"content": "不是很想…吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726520133,
					"content": "哼，好吧…可能只有技术员才理解我的热情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520110,
					"content": "有什么需要帮忙的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520103,
					"content": "我认识你吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				}
			]
		}
	]
}