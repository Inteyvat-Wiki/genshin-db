				{
					"id": 740732304,
					"content": "究竟是谁会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732305
					]
				},
				{
					"id": 740732305,
					"content": "是雅各布。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732306
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732306,
					"content": "我们之前在厄里那斯曾经与其发生冲突。补充订正，是最近一段时间的厄里那斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732307
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740732307,
					"content": "之前看到大门口那个悲剧的受害者我就知道是他的手笔了。他果然还在活动啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732308
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732308,
					"content": "那他拿走这里的东西是想要干什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732309,
					"content": "很简单啊。他也想要重铸水仙十字的圣剑。因为水仙十字结社的事业还未竟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732310
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732310,
					"content": "我们还是赶紧去最后一处地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
