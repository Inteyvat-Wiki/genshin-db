			"dialogs": [
				{
					"id": 740732201,
					"content": "仔细检查了机关顶部的空间，什么都没有发现。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732202
					]
				},
				{
					"id": 740732202,
					"content": "这里依旧什么都没有欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732203,
					"content": "所以卡特皮拉你能告诉我们，我们究竟要找什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732204
					],
					"speakerTitle": "安"
				},
				{
					"id": 740732204,
					"content": "我们是在寻找锻铸水仙十字圣剑的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732205
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732205,
					"content": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732206
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732206,
					"content": "无法理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732207
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740732207,
					"content": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732208
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732208,
					"content": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732209
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740732209,
					"content": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732210
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732210,
					"content": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732211
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732211,
					"content": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732212
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732212,
					"content": "为什么这些东西会用来打造圣剑啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732213,
					"content": "水仙十字结社的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732214
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732214,
					"content": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732215
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732215,
					"content": "好玄乎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732216
					]
				},
				{
					"id": 740732216,
					"content": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732217
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732217,
					"content": "总之我们赶紧去下一处地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
