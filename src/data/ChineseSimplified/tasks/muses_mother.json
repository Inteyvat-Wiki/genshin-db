			"dialogs": [
				{
					"id": 740732101,
					"content": "仔细检查了机关顶部的空间，什么都没有发现。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732102
					]
				},
				{
					"id": 740732102,
					"content": "结果最后这里什么都没有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732103,
					"content": "并不是，看起来是已经被人拿走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732104
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732104,
					"content": "那岂不是我们的计划已经失败了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732105,
					"content": "「理性」的诞生需要四个象限合一。只要我们能拿到剩下的几个，我们就还有机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732106
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732106,
					"content": "既然如此，我们就快点去接下来的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
