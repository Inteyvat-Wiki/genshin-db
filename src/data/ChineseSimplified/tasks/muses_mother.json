			"dialogs": [
				{
					"id": 740730101,
					"content": "地上的火堆还在燃烧。话说为什么这里要点火呢？明明是遗迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740730102,
					"content": "让我来看看这个石碑上面写了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "安"
				},
				{
					"id": 740730103,
					"content": "「此处乃记忆之象限，记忆之厅堂，记忆之间」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740730104,
					"content": "「生于一瞬」…「常与相违，伴你长眠，从不分离」…「烈火难及」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740730105,
					"content": "谜语啊。枫丹的古文明很喜欢，水仙十字结社也很喜欢。说不上来究竟是古制还是兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740730106,
					"content": "已经尝试所有关键词检索，并没有答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740730107,
					"content": "不过这是一个已经解开的谜题，或许答案就和火堆有关吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740730108,
					"content": "去思考已经解开的谜真的有意义吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "安"
				},
				{
					"id": 740730109,
					"content": "意义还是有的。就像是你我变成了现在的样子，但是仍然有必要追寻过去发生了什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740730110,
					"content": "确实呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "安"
				},
				{
					"id": 740730111,
					"content": "#那{NICKNAME}骑士，你觉得答案是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
