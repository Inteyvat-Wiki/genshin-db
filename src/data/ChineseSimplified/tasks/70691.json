			"dialogs": [
				{
					"id": 706910101,
					"content": "#{M#荣誉骑士哥哥}{F#荣誉骑士姐姐}！这边这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910102,
					"content": "可莉交到了新朋友！要和我们一起玩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910103,
					"content": "哥哥姐姐们教给我们一种新游戏，叫做「雪白迷踪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910104,
					"content": "规则也不难，就是很特别的捉迷藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910105,
					"content": "哇哇，可莉、瑶瑶和早柚，你们交上朋友啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910106,
					"content": "听这个游戏的名字，像是「风行迷踪」的改进版？和你们一起玩，肯定非常有意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910107,
					"content": "好呀好呀，捉迷藏！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "阿嚏…虽然在营地里就不怎么冷了，但还是有点困…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910110,
					"content": "#唔？我是不是眼花了，怎么好像看到了{NICKNAME}和派蒙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910111,
					"content": "#你没有眼花哦，{NICKNAME}和派蒙确实来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "瑶瑶"
				},
				{
					"id": 706910112,
					"content": "你们好呀，瑶瑶和早柚！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "动起来，开开心心玩游戏，就不会打瞌睡啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910115,
					"content": "那位严肃的菫葵小姐不是也说过吗，早柚在雪山多转转，也对自己的本领有好处？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "瑶瑶"
				},
				{
					"id": 706910116,
					"content": "呃，你们居然都记住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910117,
					"content": "好吧…如果输给那几位同行，甚至是超级忍犬的话…之后偷懒肯定会被抓得更严！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910118,
					"content": "看来这次出远门的修行，确实要认真起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910119,
					"content": "没事哦，我准备了新做法的蔬菜炖肉，加入了绝云椒椒和胡椒的粉末。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "瑶瑶"
				},
				{
					"id": 706910120,
					"content": "开玩之前吃几口，整场捉迷藏都不会冷哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "瑶瑶"
				},
				{
					"id": 706910121,
					"content": "太好了！待会儿，我先来一整碗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 706910122,
					"content": "我也要，我也要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910123,
					"content": "那——雪山捉迷藏，准备开始啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 706910124,
					"content": "嘿呀！雪山到处都是白色，我躲起来，肯定不容易被发现！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706910113,
					"content": "要一起来玩捉迷藏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "让我也认识一下可莉的新朋友~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}