			},
			"dialogs": [
				{
					"id": 220170201,
					"content": "旅行者，请去拿几本小说过来吧，我要好好和他谈一谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170202,
					"content": "哼，要是真的让他随心所欲地写，才会真正毁了这本小说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿茂"
				}
			]
		},
		{
			"id": 2201703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
