			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"顺吉",
					"阿茂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "不写了，不写了！这次你怎么催我都没用！我不当作家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170102,
					"content": "你这家伙…你已经用罢工威胁我七次了，哪次当真过？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170103,
					"content": "你们怎么又吵起来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "你总算来了，旅行者！你可得帮帮我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170105,
					"content": "自从你上次帮他说话之后，这家伙可找到了借口，从那以后他就越来越过分，给我定下了几十条规矩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170106,
					"content": "小到能力命名，大到情节转折，他全都要弄一套什么…什么写作标准！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170107,
					"content": "这样子我还写什么小说，他自己按流程写不就好了吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170108,
					"content": "那些可都是我从成功的小说里提炼出来的写作原则，都是前人的经验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170109,
					"content": "这样不就是把其他小说的套路强加到我的作品里吗？那到底是我在写小说，还是那些「前人」们在写小说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170110,
					"content": "我绝对不会写这种…这种死板的东西的，要写的话，你自己去写！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170111,
					"content": "而且，「八重堂」里不是就有很多这种小说滞销吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170112,
					"content": "那只是销售策略的失误，和小说本身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170113,
					"content": "这根本就和销售策略什么的没关系，纯粹是因为这些书的作者们的写作方式出了问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170114,
					"content": "你可能不会注意到每一本出版的书，我作为作者，可是把「八重堂」出版的每一本都好好读完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170115,
					"content": "旅行者，请去拿几本小说过来吧，我要好好和他谈一谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170116,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "要拿什么小说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "你就把我放在周围的那几本小说拿过来吧，我经常拿这几本小说来…警诫自己，绝对不能写成这个样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "顺吉"
				}
			]
		},
		{
			"id": 2201702,
