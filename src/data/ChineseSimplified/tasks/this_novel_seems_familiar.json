				"points": []
			},
			"dialogs": [
				{
					"id": 220170301,
					"content": "旅行者，你把那些小说带来了吧，快拿出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "顺吉"
				}
			]
		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿茂",
					"顺吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "这本悬疑小说我记得还流行了很长时间，不是很受欢迎吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170402,
					"content": "这本小说之所以成功，就是因为里面那些巧妙的谜题与剧情设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170403,
					"content": "虽然有很多读者都反馈有些剧情太过于跳脱和出乎意料，有些无法理解，但作者还是坚持自己的原则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170404,
					"content": "这样做之后，这本小说才能从其他悬疑小说里脱颖而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170405,
					"content": "但这本小说，也有着坚实的设定基础吧。只有坚实而又绝对不会轻易更改的设定，才能支持这样一部悬疑小说的剧情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170406,
					"content": "呃…这…旅行者，还有其他的书吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "顺吉"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿茂",
					"顺吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "这本小说？我记得文笔很优秀，剧情和情节也都很严谨，编辑们可都是一致称赞的，当时的销量也非常不错啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170502,
					"content": "…是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170503,
					"content": "但这本小说因为过于在意剧情和设定的严谨性，没有给故事留出任何延展的空间，到最后只能不断重复着读者已经知道的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170504,
					"content": "但是，因为再没有出现任何新鲜的故事，这本小说逐渐失去了一个又一个读者，到了最后一个读者放弃它之后，它就这样默默消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170505,
					"content": "无论是设定还是剧情，如果真的被箍在了一个框里，只会让每个故事都变成一个模样，然后逐渐变成一潭毫无活力的死水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170506,
					"content": "我不想我的小说也变成这样！一个好故事，首先应该拥有的就是与众不同的活力才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170507,
					"content": "而且，如果…如果作者自己都对自己的故事提不起兴趣的话，那又要怎么感动读者呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170508,
					"content": "阿茂先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170509,
					"content": "…我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170510,
					"content": "没想到，你这家伙还想得挺多的嘛，不愧是写出《鬼武道》的作家啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170511,
					"content": "其实，我也并不是想要限制你的创作。但我见过太多的作者，因为过度的想象力和创作欲而毁了自己的作品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170512,
					"content": "顺吉，我不知道你作为一个作家，对创作这件事怎么看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170513,
					"content": "我认为是创作欲。没有创作欲的作者，一定创作不出能感动读者的作品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170514,
					"content": "但在我看来，对一个作家来说，对于创作欲的自制力才更加重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170515,
					"content": "还是达不成共识吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "阿茂先生，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170518,
					"content": "但写这本小说的人并不是我，你才是这本小说的作者，我只是一个尽力帮助你完成这本书的编辑而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170519,
					"content": "如果你真的有自己的想法和坚持，那就按照你自己的想法来创作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170520,
					"content": "我不能说我会和你达成共识，我只能说，我会努力理解你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220170521,
					"content": "啊…谢谢你！阿茂先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "顺吉"
				},
				{
					"id": 220170522,
					"content": "没事，这只是我应该做的，当然喽，我理解你，你也要理解我，比如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
