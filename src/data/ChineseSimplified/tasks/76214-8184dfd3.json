			"dialogs": [
				{
					"id": 762140101,
					"content": "喵呜…已经是茶会的时间了喵，她们会不会迷路了喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "「灰猫先生」"
				},
				{
					"id": 762140102,
					"content": "#啊，黄金的旅人{M#先生}{F#小姐}，您一定是被选中的勇者喵！能请您帮我找找看我的两位朋友吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "「灰猫先生」"
				},
				{
					"id": 762140103,
					"content": "你的朋友是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "还没有到场的两位小姐，一位是和我一样、会说话的猫，不过是橘色的喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "「灰猫先生」"
				},
				{
					"id": 762140107,
					"content": "另一位则是很有礼貌的淑女犬，虽然是犬类，但是很温柔喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "「灰猫先生」"
				},
				{
					"id": 762140108,
					"content": "就算一方是猫，一方是狗，只要能坐在一起喝茶，大家就一定会很开心喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "「灰猫先生」"
				},
				{
					"id": 762140109,
					"content": "为了喵呜兰诺珀里斯的和平，请您帮帮我喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「灰猫先生」"
				},
				{
					"id": 762140104,
					"content": "勇者的标准好随便！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "不要在意那种细节喵。就算没有传说中的圣剑，就算没有找到传说中的纯水之杯，勇者也是勇者喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "「灰猫先生」"
				}
			]
		},
