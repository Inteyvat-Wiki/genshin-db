			"dialogs": [
				{
					"id": 762140301,
					"content": "#呜汪？怎么了，黄金的旅人{M#先生}{F#小姐}？有什么我可以帮您做的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "「淑女犬小姐」"
				},
				{
					"id": 762140302,
					"content": "向淑女犬小姐转达了灰猫先生的茶会邀请…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "欸？原来已经到这个时间了吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "「淑女犬小姐」"
				},
				{
					"id": 762140304,
					"content": "谢谢您！呜汪，要不是太忙，我就亲自去邀请橘猫小姐了…那样的话，灰猫先生说不定也不会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "「淑女犬小姐」"
				},
				{
					"id": 762140305,
					"content": "无论是猫还是狗，大家都是可以和平共处的…一定可以的。总之，我现在就去参加茶会啦，谢谢您提醒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「淑女犬小姐」"
				}
			]
