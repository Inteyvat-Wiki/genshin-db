			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "…喵。你的剑技…令猫印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "「橘猫小姐」"
				},
				{
					"id": 762140209,
					"content": "感谢你，可敬的异邦骑士。那些高傲而强大的凶恶之徒不会再侵扰我子民的家园了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "「橘猫小姐」"
				},
				{
					"id": 762140210,
					"content": "那么，请说吧。阁下为何来到我的王庭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "「橘猫小姐」"
				},
				{
					"id": 762140202,
					"content": "王庭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "呃…既然是童话，那这个应该也是设定的一部分吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762140206,
					"content": "向橘猫小姐转达了灰猫先生的茶会邀请…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "「橘猫小姐」"
				},
				{
					"id": 762140208,
					"content": "…我知道了。谢谢你，可敬的异邦骑士。那么，我便听从你的良言，动身前往吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「橘猫小姐」"
				},
				{
					"id": 762140204,
					"content": "王上啊，让我来报告您…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "入戏好快！咳咳，既然是设定的一部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "派蒙"
				}
			]
		},
