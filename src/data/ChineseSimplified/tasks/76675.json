						766750505
					]
				},
				{
					"id": 766750505,
					"content": "之前教导诺艾尔的时候，她一紧张就会把木桶打碎一地，然后说什么也要独自打扫干净。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750506,
					"content": "时间一久…她打扫清理的本领，就冠绝整个骑士团了。呵，虽然她本人也没意识到，这其实也是一种「进步」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				}
			]
