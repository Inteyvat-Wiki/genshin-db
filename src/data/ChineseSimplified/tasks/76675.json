			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法尔伽"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5921.365,
							283.763,
							9726.784
						],
						"pointId": 14164
					},
					{
						"sceneId": 3,
						"position": [
							5925.497,
							284.186,
							9722.368
						],
						"pointId": 15086
					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "为大家带回美酒的「主角」，怎么跑到这角落里来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751002,
					"content": "我倒想问你呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "嗯…其实我杯里的是「特制品」中的「特制品」，只能一个人喝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751005,
					"content": "——不过被你发现就没办法了，就分你一杯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751006,
					"content": "…我就知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "抱歉啦，开个玩笑！我身边现在是一滴酒都没有。你要是想喝的话，回头可以去找欧蜜涅，她那边管够。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751009,
					"content": "一个营地里总得留下一个没醉的人，来看住喝醉的同伴跟夜里的危险——这是我在远征之初就立下的规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751010,
					"content": "真不凑巧啊，今天刚刚好轮到我来当这个不能醉的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751011,
					"content": "…所以在他们都喝醉的夜里，我是不能醉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751012,
					"content": "真就刚刚好这么巧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "谁知道呢？没准命运就是这么喜欢捉弄人？要是晚个一天到，说不定就轮着我在下面畅饮了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751015,
					"content": "但要是晚个一天，没准你就不会凑巧来到这个营地，也不会凑巧赶上我们的酒会，更没机会像现在这样对话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751016,
					"content": "什么样的选择会引向什么样的结果，在时候到来之前，谁都说不准。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751017,
					"content": "就像我决定从蒙德出发远征的时候，也没想到会一路走到今天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751018,
					"content": "发起远征的目的…是狂猎吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "嗯…从结果来说，确实如此。但在出发的时候，我只「知道」会有一场席卷提瓦特的深渊灾厄正在北方酝酿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751020,
					"content": "我们也用了些时间来动员筹备…但敌人会在哪里、以什么形式出现？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751021,
					"content": "…这些对出发时的我们而言依旧是未知。只能一路收集情报，做好任何可能用得上的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751022,
					"content": "只有这点情报就发起远征了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "呵，学得很快嘛！但很可惜，敌人可不会乖乖等着我们准备万全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751025,
					"content": "在我们犹犹豫豫的时候，深渊也正戕害无数人的性命。早一刻出征，就能早一刻改变他们的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751026,
					"content": "——光是知道这条情报，就足够支撑我们发起这场「远征」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751027,
					"content": "不愧是「北风骑士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "别那么见外，「荣誉骑士」！你不是也一样吗？你的旅途同样改变了许多人的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751030,
					"content": "无论是从前的蒙德、特瓦林…还是如今的挪德卡莱、远征军…还有我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751031,
					"content": "#现在能围着篝火唱着诗歌，喝着美酒畅想未来…都离不开{NICKNAME}，你的出现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751032,
					"content": "…我真有那么厉害吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "…哈哈，谁又能说得清呢？毕竟命运就是这么捉摸不定的东西。但只要还活着，就总还有希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751034,
					"content": "今晚喝不上的酒，明天也能喝——他们会记得帮我留上一杯的。只要还活着，就有美酒和朋友在明天等着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751035,
					"content": "#所以，{NICKNAME}，干了这一杯！敬明天！敬希望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766751028,
					"content": "不愧是「西风骑士团」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "不是说情报是行军的基础吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "在蒲公英酒送到的这天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "果然是苹果酿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "怎么一个人喝酒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
