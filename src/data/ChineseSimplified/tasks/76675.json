			},
			"dialogs": [
				{
					"id": 766750901,
					"content": "啊！大团长！荣誉骑士！他们回来了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "温弗里德"
				},
				{
					"id": 766750902,
					"content": "回来了——他们回来了——大家！快来迎接！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "艾克贝特"
				},
				{
					"id": 766750903,
					"content": "哇呜，居然这么受欢迎…还真有点不好意思呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750904,
					"content": "——我隔着几百米就从风里闻出来了！是蒲公英酒的味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "莱夫赫姆"
				},
				{
					"id": 766750905,
					"content": "还是晨曦酒庄出产的特制品！回来了…我的回忆…全都回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "温弗里德"
				},
				{
					"id": 766750906,
					"content": "呃…所以你们迎接的对象不是我们吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750907,
					"content": "嗯…就是这个味道…跟记忆里的一模一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "艾克贝特"
				},
				{
					"id": 766750908,
					"content": "真好啊，这么多年了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "莱夫赫姆"
				},
				{
					"id": 766750909,
					"content": "我还以为，自己已经忘记晨曦酒庄的酒是什么味道的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "温弗里德"
				},
				{
					"id": 766750910,
					"content": "酒的味道没变…那清泉镇的老家，应该也什么都没变吧？应该…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "艾克贝特"
				},
				{
					"id": 766750911,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "…谢谢你，荣誉骑士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "艾克贝特"
				},
				{
					"id": 766750914,
					"content": "…好了，别那么激动，还有人没回营吧？等人齐了再开封。你们先去做酒会的准备吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750915,
					"content": "是！我们这就去准备！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "温弗里德"
				},
				{
					"id": 766750916,
					"content": "…看，我说过的吧：喝酒可是一等一的正经事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750917,
					"content": "呜呜…蜜酱胡萝卜煎肉…甜甜花酿鸡…居然能在这吃到这么正宗的蒙德菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750918,
					"content": "咦…法尔伽呢？好像没看到他？总不能是在哪个角落里喝到醉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750919,
					"content": "以他的酒量没可能吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "好…我再吃完一盘就去找你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750920,
					"content": "我去找找，你接着吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "是的，我去过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
			"completionStepIds": [
				7667510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
