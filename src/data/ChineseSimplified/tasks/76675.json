			"dialogs": [
				{
					"id": 766750401,
					"content": "——嘿，你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750402,
					"content": "没、没事…呼，还好你们来得及时，要不然就真赶不上日落了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750403
					],
					"speakerTitle": "杜纳塔斯"
				},
				{
					"id": 766750403,
					"content": "…万幸，看起来我们的「重要物资」没出什么大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750404
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750404,
					"content": "呃，是什么物资这么重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750405,
						766750406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750405,
					"content": "这就是酒吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				},
				{
					"id": 766750407,
					"content": "好眼光——这是我们从晨曦酒庄专门订购的蒲公英酒！最纯正的蒙德风味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750408
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750408,
					"content": "一路从蒙德运过来，可费了我们好大的劲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750409
					],
					"speakerTitle": "杜纳塔斯"
				},
				{
					"id": 766750409,
					"content": "哈哈，辛苦了老板！晚上的酒会，你也来喝一杯吧？我们可都盼着你来呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750410
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750410,
					"content": "…所以你之前这么着急，就只是为了赶晚上的酒会？难得看你正经一次，居然还是为了这么不正经的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750411,
					"content": "嗯？喝酒不就是一等一的正经事吗？我都想现在就来上一杯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750412
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750412,
					"content": "等、等一等——现在恐怕不太方便！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750413
					],
					"speakerTitle": "杜纳塔斯"
				},
				{
					"id": 766750413,
					"content": "是啊是啊，起码先干正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750414,
					"content": "这酒是特殊定制的，需要长时间滚动防止沉淀来保持口感！现在静置了这么久，估计口感…起码打了九折！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750415
					],
					"speakerTitle": "杜纳塔斯"
				},
				{
					"id": 766750415,
					"content": "九折？可恶！那可绝对不能现在喝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750416
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750416,
					"content": "…行吧，你们高兴就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750417,
					"content": "要怎么恢复口感？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750418
					]
				},
				{
					"id": 766750418,
					"content": "我们原本专门找人造了滚动酒桶的机关…不过刚刚像是摔坏了，现在么…估计只能靠人力让它滚起来了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750419
					],
					"speakerTitle": "杜纳塔斯"
				},
				{
					"id": 766750419,
					"content": "唔，所以是要<color=#00E1FFFF>持续打击木桶，让它滚动到目的地</color>吗…听起来很像西风骑士团的传统力量训练啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750420
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750420,
					"content": "西风骑士团还有这训练项目？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750421
					]
				},
				{
					"id": 766750421,
					"content": "嗯，这种训练既要控制出手的力度，又要控制打击的角度，提防木桶偏离路线。是许多骑士的入门训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750422,
						766750423
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750422,
					"content": "听起来还有点意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750424,
					"content": "哦？「荣誉骑士」也会对骑士团的基础训练感兴趣吗？嗯…离洛朗他们回营也还有一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750425
					],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750425,
					"content": "那就交给你了，荣誉骑士。放心，要是一不小心把酒桶滚得太远就跟我说一声，我来帮你扔回原位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法尔伽"
				},
				{
					"id": 766750423,
					"content": "荣誉骑士也想试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750406,
					"content": "怎么闻都是酒吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				}
			]
		},
