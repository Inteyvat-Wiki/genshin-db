			"dialogs": [
				{
					"id": 742250201,
					"content": "谢谢你，恩人。神王在上，我终于得救了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250202,
					"content": "你是守备这座城市的军团士兵吗，还是路过的正义之士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250203,
					"content": "总之自我介绍一下，我是法乌斯图斯，神王委任的边境商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250204,
					"content": "这次是为了运送南国的香料才来到这里的，没想到刚一上岸就被这些可恶的龙蜥所围困…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250205,
					"content": "龙蜥？哪有龙蜥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "嗯？丝毫不将刚刚打倒的敌人放在眼里吗，你果然是位了不起的勇士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "福斯卡里"
				},
				{
					"id": 742250207,
					"content": "请收下这个吧。感谢的话就不多说了，我还得赶紧把货物运进城里呢，说不定在城里我们还会再见的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福斯卡里"
				}
			]
		}
	]
