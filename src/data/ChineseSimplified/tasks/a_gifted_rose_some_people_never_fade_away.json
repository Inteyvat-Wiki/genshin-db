				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "「蔷薇啊蔷薇，实现我的愿望。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "「花从石头中绽放，金蔷薇对我歌唱。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "金色的蔷薇花果然很漂亮，看到它们开放，感觉心情也明亮起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732090402,
					"content": "这些天的辛苦没有白费，好开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732090403,
					"content": "心愿终于实现了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "到最后，我终于有一件能做好的事了。沙法卡特叔叔，你的心愿我替你达成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090406,
					"content": "遗憾的是，他看不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090407,
					"content": "赛芭，不能这样说啊。你记得蔷薇歌谣最后的那段吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090408,
					"content": "「没有土地承载我，唯有歌谣承载我。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090409,
					"content": "「歌谣战胜敌视我的命运，战胜我的结局。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090410,
					"content": "「战胜我战胜时间，战胜永不消逝的消逝。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090411,
					"content": "沙法卡特叔叔的生命和金蔷薇还有他亲自编写的歌谣一起，都留在了我们身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090412,
					"content": "嗯，说的没错，他是战胜了消逝的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090413,
					"content": "谢谢你们让我知道沙法卡特先生的事，这对我来说很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090414,
					"content": "他是在我之前的流放者，看到他的那些生活痕迹，总让我觉得自己好像跨越了时空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090415,
					"content": "我看着的不仅是沙法卡特先生，还有我自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090416,
					"content": "虽然我不能对他说些什么，但我可以带着他的遗憾生活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090417,
					"content": "如果我连带着他的份一起努力生活下去，那最终我一定能救赎自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090418,
					"content": "希望你幸福。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "感觉在这里的生活也并不糟糕了呢，能遇到你们真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090421,
					"content": "蔷薇花果然是能带给人幸福的花，阿凡老先生，以后我们得加油种上更多的蔷薇花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090422,
					"content": "哈哈哈，那我们就算约定好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090423,
					"content": "嗯，我会努力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090419,
					"content": "不要气馁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "一切都是值得的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
