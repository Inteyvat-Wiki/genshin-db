			"dialogs": [
				{
					"id": 732090301,
					"content": "「蔷薇啊蔷薇，实现我的愿望。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "「花从石头中绽放，金蔷薇对我歌唱。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
