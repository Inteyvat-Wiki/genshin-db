			"dialogs": [
				{
					"id": 732090101,
					"content": "是你们啊，蔷薇还有我们都在等着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090102,
					"content": "赛芭也早早地来了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732090103,
					"content": "我最近常来这里，沙法卡特先生留下的手记都看了个遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090104,
					"content": "以前我一直觉得呆在阿如村生活很寂寞，但现在感觉不同了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090105,
					"content": "至少我不完全是一个人，还有这些蔷薇，和你们一起的记忆，还有阿凡先生一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090106,
					"content": "我的生活里还有些美好的念想，这样一想就觉得自己没有那么寂寞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090107,
					"content": "我和阿凡老先生商量好了，以后我就帮他一起照看金蔷薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090108,
					"content": "让它们越开越多，开满整个苗圃。至于现在，先让这几株开出花来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090109,
					"content": "你还记得之前是怎么让我的须弥蔷薇开花的吗？用同样的方法就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090110,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "来，看你的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				}
			]
		},
		{
