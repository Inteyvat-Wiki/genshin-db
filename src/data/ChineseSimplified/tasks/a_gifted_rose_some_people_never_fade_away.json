				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "老头子我都快不抱希望了，没想到这花最后还是种出来了，果然活着就能有奇妙的事发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090702,
					"content": "小姑娘，还在为沙法卡特叔叔的事难过吗？别愁啦，活着的人要带着死去的人那些心愿活下去才算对得起他们哩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090703,
					"content": "老先生…我已经不小了，那些和我一起长大的朋友们，说不定她们的孩子都会去店里买香料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "赛芭"
				},
				{
					"id": 732090704,
					"content": "但无论如何你说得对，既然活着总要开开心心地活下去才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛芭"
				}
			]
		}
	]
