			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "只要这几株能健康地生长，我们以后一定能培育出更多的金蔷薇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732090602,
					"content": "不过在这之前，还是得先看到这几株金蔷薇开花我才放心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
