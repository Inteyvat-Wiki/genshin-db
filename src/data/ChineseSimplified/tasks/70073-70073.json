			"dialogs": [
				{
					"id": 700730101,
					"content": "我想和这个大家伙切磋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "善哉！吾主亦须时刻舒展神躯，落下的蕈片口感才会更美味！还请全力以赴，切莫手下留情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩答伐"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
