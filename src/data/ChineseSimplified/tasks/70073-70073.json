							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"摩答伐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "吾主摩诃婆苏{RUBY#[D]赐生世尊之嗣}提婆耶弗啊，愿汝的耆婆{RUBY#[D]命根}提耶深入这岩地的基石，愿汝的美味胜过世间一切神明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩答伐"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"摩答伐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "这是什么玩意儿…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "善哉斯问！此为吾等所供奉的赐生世{RUBY#[S]比夫茏}尊神之嗣，道成正味之蕈子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "摩答伐"
				},
				{
					"id": 700730303,
					"content": "龙呼常念草木之主与花{RUBY#[D]浮槃婆梨袈}圃之主，玛卡尼哈冈总向赤砂之神祷告——汝可问问他们，那三位尊神，有哪一位比吾主更美味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "摩答伐"
				},
				{
					"id": 700730304,
					"content": "须知不害即是正业。若非吾主的神躯，吾等亦要取鸟兽草木之命以维生…呜呼，何等可哀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "摩答伐"
				},
				{
					"id": 700730305,
					"content": "所幸，空之主将吾带离大地时，吾主的耆{RUBY#[D]孢子}婆亦与吾同行。如是汝观，今已生长至此，赐吾等无上妙味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩答伐"
				}
			]
		},
		{
