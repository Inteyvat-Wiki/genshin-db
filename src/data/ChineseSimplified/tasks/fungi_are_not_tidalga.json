			"dialogs": [
				{
					"id": 745080101,
					"content": "一段时间后，你与派蒙来到了「小小灵蕈大幻戏」的摊位前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "哼哼！滑滑弹弹软软嫩嫩的蕈兽真是太棒了！我还要继续玩这个游戏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080103,
					"content": "这位是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "本小姐是昂吉安妮，蒂蕾娜进入特巡队之前的教官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080105,
					"content": "我和蒂蕾娜不一样，不一样哦！不会因为你们是「超天顶领队级战力」就对你们畏畏缩缩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080106,
					"content": "这个很嚣张的美露莘…居然是蒂蕾娜以前的教官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080107,
					"content": "别紧张，「黄金流星」和「白银伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080108,
					"content": "不久前，蒂蕾娜小姐接到了别的任务，回到特巡队的驻地去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080109,
					"content": "昂吉安妮小姐是蒂蕾娜小姐请来，代替她负责活动场地安保的专业人士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080110,
					"content": "她也非常喜欢「小小灵蕈大幻戏」，和我玩得很开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 745080111,
					"content": "没错，无论是桌上的游戏，还是现实里圆圆的蕈兽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080112,
					"content": "滑滑弹弹软软嫩嫩，就像汐藻一样…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080113,
					"content": "你怎么流口水了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "才不会吃！抱着蹭一下也没关系吧！海妮耶都不介意我捏捏「欢腾之火」呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080116,
					"content": "#那，那你也只能捏捏「欢腾之火」！「咚咚小圆帽」只有我和{NICKNAME}才能抱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080117,
					"content": "干嘛这么小气！我全都要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080118,
					"content": "海妮耶说过，你们是这个游戏的专家，那不如就和我比划比划？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080119,
					"content": "如果我赢了，我也要揉捏「咚咚小圆帽」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 745080120,
					"content": "可恶，被她瞧不起了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080121,
					"content": "#{NICKNAME}，我们上吧，让她见识一下「小小灵蕈大幻戏」的第一代玩家的力量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080122,
					"content": "还有「月莲杯初代冠军」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "对对对！我们那么多威风的外号可不是白白得来的呢，哪有随便就被打败的道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745080123,
					"content": "还有「智巧勇武双连星」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "不许吃蕈兽伙伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}