			"dialogs": [
				{
					"id": 740090301,
					"content": "请您听我解释…这一切都是误会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "维吉尔"
				},
				{
					"id": 740090302,
					"content": "桑尼先生…您想，我们也只是想着这门生意很有赚头，上边又不同意，才想着…想着先赚一笔，将收入交给组织，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "维吉尔"
				},
				{
					"id": 740090303,
					"content": "可恶，居然无视我喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090304,
					"content": "我对组织绝对没有怨言…对了，我是被那些坏人骗了，才会做出这样愚蠢的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "维吉尔"
				},
				{
					"id": 740090305,
					"content": "#真是了不起，了不起。{NICKNAME}，您的身手真是名不虚传。您不这么认为吗？亲爱的卢卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090306,
					"content": "厉害。真的很强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090307,
					"content": "看在过去的情分上…桑尼先生…卢卡先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "维吉尔"
				},
				{
					"id": 740090308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090309,
					"content": "哎吔！不、不要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "维吉尔"
				},
				{
					"id": 740090310,
					"content": "#卢卡。客人还在呢。我们可不能做出失礼的事情，让{M#他们}{F#她们}不愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090311,
					"content": "明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090312,
					"content": "哼！维吉尔，你知道错了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090313,
					"content": "啊啊，我错了，我错了…请多多谅解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "维吉尔"
				},
				{
					"id": 740090314,
					"content": "知错就好，以后可不能再这样了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090315,
					"content": "#亲爱的维吉尔以后绝对不会这样了，派蒙、{NICKNAME}，我以我「白手套」桑尼的名誉，和我父亲与儿子的名誉保证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090316,
					"content": "我们走吧，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "嗯！谢谢你们，桑尼、卢卡。看来枫丹还是好人比坏人多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090321,
					"content": "#再见，希望我们还有机会合作，亲爱的派蒙、{M#尊敬的先生}{F#可爱的小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090322,
					"content": "噫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维吉尔"
				},
				{
					"id": 740090317,
					"content": "你们打算怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#身处世间，太过明白的话，多少有些无趣，不是吗？{M#尊敬的先生}{F#可爱的小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090319,
					"content": "如果您实在好奇的话，我们会先慢慢跟他…聊聊。就不耽误二位的时间了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "桑尼"
				}
			]
		},
