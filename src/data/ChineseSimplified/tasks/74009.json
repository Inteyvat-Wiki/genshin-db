					}
				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "这可真是巧遇啊，这可真是。您说对吧？亲爱的卢卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090103,
					"content": "你们是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090104,
					"content": "您瞧瞧我，可真是失礼。我是桑尼，朋友们有时候管我叫「白手套」。而这位「渔夫」卢卡，在特定的人群中小有名气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090105,
					"content": "喔，你们好！我是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090106,
					"content": "#我明白，我明白，您是派蒙，而这位金发的{M#先生}{F#小姐}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090107,
					"content": "咦？你认识我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090108,
					"content": "#当然认识，当然！只不过在今天之前，我认识您与{NICKNAME}，就如同我认识那维莱特大人，不过是单方面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090109,
					"content": "像二位这样杰出的人物，一旦踏上了我们枫丹的土地，自然会有小小鸟跟我们说喽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090110,
					"content": "原来我们这么有名吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "您瞧瞧您，真是谦虚！这么说吧，您出现在我们枫丹，对某些人而言，就像炸弹出现在欧庇克莱的大舞台上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090112,
					"content": "——当然，是好的方面！您说对吧？亲爱的卢卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090113,
					"content": "呃，这个要怎样才是好的方面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090114,
					"content": "唔…我不善言辞，您觉得呢？亲爱的卢卡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090115,
					"content": "林尼与琳妮特的魔术演出。炸弹、逃脱表演。爆炸性新闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090116,
					"content": "精辟！您瞧，我就想不出这样的说法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090117,
					"content": "原、原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090118,
					"content": "不过，为什么你叫「白手套」呀？你明明没戴手套…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090119,
					"content": "喔，这可是个刁钻问题。该怎么向您解释好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090120,
					"content": "设想您戴着白手套。这时，只要摸到脏东西，手套上就会留下污渍，对吧？所以，我的职责就是找到脏东西，然后处理掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090121,
					"content": "是喔…也就是负责清洁工作的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090122,
					"content": "说得好，亲爱的派蒙！我就没办法这么精简扼要地总结我的工作性质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090123,
					"content": "所以，枫丹廷的街道这么整洁，都是多亏了桑尼这样的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090124,
					"content": "哈哈哈，您说话可真中听！您就当做是这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090125,
					"content": "是喔…不过清洁工还需要带刀吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090126,
					"content": "您就当做是清理一些顽固垃圾的时候，才要派上用场的小道具吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090127,
					"content": "嗯，我明白了！那，卢卡是因为很会钓鱼，所以才叫「渔夫」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090128,
					"content": "嗯——倒也不完全是这样，不完全是这样。您瞧，在我们枫丹，不是有各种各样的鱼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090129,
					"content": "而教人如何与缤纷多彩的鱼群愉快地相处、平静地相处，就是他的特长。我说得对吗？亲爱的卢卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090130,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090131,
					"content": "咦？我不明白…如果是这样的话，那——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090132,
					"content": "哎呀呀，亲爱的派蒙，您可真会问问题。问的问题都很刁钻、很有水准呢。真希望能多与您聊聊，好好回答您的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090133,
					"content": "派蒙，别问了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "欸？好吧…那桑尼、卢卡，你们有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090136,
					"content": "您瞧，我们对「潜水」非常感兴趣，非常感兴趣。我们枫丹的水下充满了数之不尽的财富，无论是自然的还是前人留下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090137,
					"content": "听说，最近您在这里认识了一位好朋友，与他一同入水。您本领高强，甚至不需要潜水护具。您说对吧？亲爱的卢卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090138,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090139,
					"content": "你们想问维吉尔的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "没错。我们想问维吉尔的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090141,
					"content": "维吉尔…那个坏家伙！啊啊，气死我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090142,
					"content": "和派蒙一起，事无巨细地向「白手套」桑尼与「渔夫」卢卡说明了此前的经历。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "原来如此，原来如此。非常感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090144,
					"content": "不用谢！哼，那个坏东西，我可忘不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090145,
					"content": "——当然我们很感谢二位坦诚说明了关于维吉尔的遭遇。但我更感激的是，二位并不是他的朋友。不然的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090146,
					"content": "这么说吧：不然的话，之于你我，多少都会有些不便。您说对吧？亲爱的卢卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090147,
					"content": "应该对付不来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090148,
					"content": "我想也是，我想也是。真是太感谢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090149,
					"content": "你在说什么呀…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090150,
					"content": "他们是维吉尔的敌人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090152,
					"content": "#您这话可真令人伤心，{M#尊敬的先生}{F#可爱的小姐}。我可没有敌人，只有许多朋友，维吉尔也是其中之一。只不过，亲爱的维吉尔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090153,
					"content": "#我们需要和他好好「聊聊」。您应该能理解吧？亲爱的{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090154,
					"content": "当然，也自然是要为您与派蒙讨个说法。否则的话，对二位贵客就太失礼了，不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090155,
					"content": "那个，我没听懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090156,
					"content": "他是「白手套」。知道这个就行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "是喔…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090160,
					"content": "我们已经找到了维吉尔和他的朋友们的据点。我们不妨在据点会合，您看如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090161,
					"content": "为什么要我们一起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#尊敬的先生}{F#可爱的小姐}！维吉尔对您做出了如此冒犯的事情，我和卢卡若是不与您打招呼，就…和他聊聊的话，那可太失礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090163,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090164,
					"content": "您瞧，卢卡也明白这样的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090166,
					"content": "哼！我也要跟维吉尔聊聊！让他向我们道歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090167,
					"content": "哈哈哈，您可真善良。那我们在目的地会合吧，二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090165,
					"content": "好。走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "这些事情，不用太明白…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#身处世间，太过明白的话，多少有些无趣，不是吗？{M#尊敬的先生}{F#可爱的小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090135,
					"content": "找我们有什么事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
