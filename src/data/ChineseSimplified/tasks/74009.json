					"nextDialogs": [
						740090204
					],
					"speakerTitle": "看起来似乎有点坏的人"
				},
				{
					"id": 740090204,
					"content": "他要再不回来，我就忍不住…忍不住要喝这批乐斯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "看起来稍微有点危险的人"
				},
				{
					"id": 740090205,
					"content": "喂，别闹！那可是好不容易才搞来的货。如果敢乱动，维吉尔大哥可不会跟你客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "看起来不太正经的人"
				},
				{
					"id": 740090206,
					"content": "真是遗憾。亲爱的维吉尔似乎还没回来呢。不过，我们可以先和他们「聊聊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090207,
					"content": "呃，他们看起来…好像不太好聊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090208,
					"content": "这可未必，您觉得呢？亲爱的卢卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090209,
					"content": "没有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "卢卡"
				},
				{
					"id": 740090210,
					"content": "喂！真的没问题吗？总感觉，他们应该会直接动手吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740090211,
					"content": "哎呀！您可真是思虑周全，亲爱的派蒙。如果发生了那样的事情，就太不幸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "桑尼"
				},
				{
					"id": 740090212,
					"content": "…对他们来说哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑尼"
				}
			]
