			"dialogs": [
				{
					"id": 3840201,
					"content": "哦，这下人都到齐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840202
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840202,
					"content": "这个地方，风景真漂亮啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840203,
					"content": "和「命运的再会」这个主题很配吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840204,
					"content": "那么，该准备开始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840205,
					"content": "嗯，不论结果如何，至少已经看到了转机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840206,
					"content": "这段时间，整座蒙德城都背负了太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840207,
					"content": "只是到头来，解决问题的却是旅行者和一个歌手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840208,
					"content": "呵。骑士团勉强算是有些苦劳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840209,
					"content": "好啦好啦。大家都站开一些——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840210,
					"content": "尘世间最好的吟游诗人，要开始拨动他的琴弦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "温迪"
				}
			]
		},
		{
			"id": 38404,
			"completionStepIds": [
				38405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"38405",
							"2"
