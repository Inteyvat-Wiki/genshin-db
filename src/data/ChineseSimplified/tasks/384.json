			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"温迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3840401,
					"content": "巴——温迪阁下，请注意保护好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840402,
					"content": "哈哈…其实你不是现在才猜出那个身份的吧，琴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840403,
					"content": "不过，谢谢你继续用这个名字叫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840404,
					"content": "天空之琴怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840405,
					"content": "还能弹奏吗？…或者，还能用龙的泪滴修复吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840406,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840407,
					"content": "坏成这副样子的话…可能就没办法了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840408,
					"content": "不能就这样放过深渊法师。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "没错，如果不能击败腐蚀的源头，就无法减轻特瓦林所受的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840413,
					"content": "那么，我召集侦察骑士来追踪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840414,
					"content": "不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840415,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840416,
					"content": "不久前我在四风守护的神庙遗迹，亲手斩杀过它的一只同类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840417,
					"content": "咦？！是什么时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840418,
					"content": "想要追踪那些怪物的话，可以借助我的情报网和手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840419,
					"content": "迪卢克…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840420,
					"content": "虽然讨厌骑士团，但会用自己的方式来守护蒙德呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840421,
					"content": "小派蒙的语气，突然变得溺爱了起来…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "温迪"
				},
				{
					"id": 3840422,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840423,
					"content": "总之，等我消息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840424,
					"content": "我要让它们明白，不论深渊教团再怎么无法无天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840425,
					"content": "在蒙德，有些事也是不可以做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840410,
					"content": "特瓦林的情况很危险…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "但首先要让罪魁祸首付出代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "迪卢克"
				},
				{
					"id": 3840412,
					"content": "如果不能击败腐蚀的源头，就无法减轻特瓦林所受的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "迪卢克"
				}
			]
		}
	]
