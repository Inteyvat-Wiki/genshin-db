			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "让我想想，究竟是什么，让你再一次来到我的面前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200302,
					"content": "你的愚勇，是为了庇护那些民众，还是说…觐见我才是你的本意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200303,
					"content": "愚人众诱导了雷电将军。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "哦？将我从永恒的冥思中唤起，该不会就是为了说这些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200306,
					"content": "那你是否有些过于小觑我了。眼狩令的事，我当然知晓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200307,
					"content": "外面的事你都知道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "并非如此，我知道的只是一切关于「永恒」的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200309,
					"content": "包括眼狩令的颁布，也是由我所默许的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200310,
					"content": "而那些愚人众的所为，尚未构成对永恒的威胁，否则…他们早已被肃清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200311,
					"content": "可是眼狩令…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "愿望本就是不利于永恒的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200314,
					"content": "你或许还没有意识到，追逐愿望…往往会让人失去更多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200315,
					"content": "正如，收缴神之眼一事本身，并不会有人因神之眼离身而丧命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200316,
					"content": "丢掉性命的，反而会是那些执意要追逐愿望的人，不是么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200317,
					"content": "哲平…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "旅者，你在我眼中的确是特殊的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200319,
					"content": "你的身上似有数之不尽的不确定性，换言之，你与「永恒」相距最远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200320,
					"content": "所以，我无意要你理解其中意义，仅由此身为这天下人间代行「永恒」之道便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200321,
					"content": "此处是你的「一心净土」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "是由你的意识所构成的空间，对吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "没错，你居然会清楚这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200324,
					"content": "罢了，你是在寻找…动摇我意志的机会，对么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200325,
					"content": "我不想和你争论了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "我会直接将你「驳倒」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200328,
					"content": "好吧，「违逆永恒之人」，让我看看…你的觉悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200312,
					"content": "让稻妻的人民失去了很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "眼狩令不应该被颁布。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"雷电将军"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "你败了，影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200503,
					"content": "…是啊，我败了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200504,
					"content": "为什么不能相信你的子民，相信他们愿望的力量呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200505,
					"content": "那些愿望已经超脱了距离、超脱了空间与时间，已经是无人能将其扼杀之物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200506,
					"content": "当人们全力以赴前进时…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "这是你在璃月的旅途收获么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200510,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "人类向前奔跑，将神明甩在身后的国度吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200512,
					"content": "可我们又为何要自顾自…一厢情愿地放弃前进呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200513,
					"content": "…前进所带来的那些失去，你也同我一起见证过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200514,
					"content": "唯有永恒，唯有永恒才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200515,
					"content": "天理…对我来说是不知所谓的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200516,
					"content": "总而言之，你只是想永远地守护你心爱的稻妻，是么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200517,
					"content": "你说得有些太过轻描淡写了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200518,
					"content": "可是这个国度，是否有永恒存在的价值呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200519,
					"content": "失去了愿望，失去了变化，就仅仅是存在而已的国度，不过是一具空壳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200520,
					"content": "呵，那样的话，就算毁灭了又何妨呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200521,
					"content": "神子，收回你的妄言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200522,
					"content": "千世万代不变不移的永恒，这是我给予臣民的许诺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200523,
					"content": "可你的臣民需要的，并非是你的许诺，他们想要的是你的「注视」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200524,
					"content": "…神之眼吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200525,
					"content": "人类的寿命仅有百年，他们无力承担那些失去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200526,
					"content": "经历过一切的我，才会选择指引他们去往正确的「永恒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200527,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200528,
					"content": "…可是「永恒」对你来说，太过残酷了啊，影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200529,
					"content": "对我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200530,
					"content": "你不仅不再去注视世人，也已经不再注视自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200531,
					"content": "几百年来，一个人在这里，一定很寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200532,
					"content": "可这是必要的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200533,
					"content": "不前进的话，也会错过很多啊…在此静止直到永恒的你，不也在失去着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200534,
					"content": "明明忍受着这样的孤独，却又要为了永恒，而把这份孤独的时间尺度无限拉长…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200535,
					"content": "告诉我，为何此地的天空曾是那样晦暗…而偏偏此刻又泛起了光芒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200536,
					"content": "这里是你的「一心净土」，是你的内心世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200537,
					"content": "所以…其实你很开心可以再次见到我，你早已无法忍受此地的孤独了，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200538,
					"content": "我…没有什么好说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200539,
					"content": "呵呵，那我可有说不尽的话要和你讲，哦对了，就让我把这几百年间的事情讲给你听吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200540,
					"content": "几百年间的事，要讲多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200541,
					"content": "狐仙的记忆力可是很好的，几百年间的每一个细节我都不会忘记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200542,
					"content": "所以大概要讲个几百年吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200543,
					"content": "呵…呵呵…神子，我本以为已经不会再有机会与你这样会面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200544,
					"content": "能见到你，是永恒之中的变数…也算是惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200545,
					"content": "呵呵，既然你老老实实承认了，还可以继续做朋友哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200546,
					"content": "真是小孩子气的谈话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200547,
					"content": "不过，既然我输给了你们的计划，那我便会依照你们的意志，废除眼狩令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200548,
					"content": "但关于「永恒」，关于这个国家是否应该前进，我需要再考虑考虑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "雷电将军"
				},
				{
					"id": 20200549,
					"content": "哎呀，自始至终小孩子气的，都是你啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20200507,
					"content": "可以超乎神明的预料。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "甚至将神明的工作取代。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
