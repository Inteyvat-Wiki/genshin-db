			"dialogs": [
				{
					"id": 20210101,
					"content": "你们在雷电将军的「一心净土」里到底做了什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210102,
					"content": "眼狩令居然真的废除了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210103,
					"content": "主要是八重神子的功劳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "欸，这样啊…我还担心得很呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210106,
					"content": "所以神子这次找我们，难道是要跟我们道谢吗？嘿嘿…快过去找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20210104,
					"content": "是人们的愿望传达到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
		}
	]
