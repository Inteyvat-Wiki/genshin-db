					}
				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "到约定时间了，一行人再次碰面…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "我认真考虑过了。老师那个脾气，能孤身跑到沙漠来，就肯定做好了再也不回去的准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380103,
					"content": "他又是个爱憎分明，一意孤行的人，我们不可能说服他逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380104,
					"content": "我同意。我的老师纳菲斯也说过，居勒什这个人很死心眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380105,
					"content": "嗯，另外我还想到一些事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380106,
					"content": "缄默之殿的信息你们都知道了，我这里没有要补充的内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380107,
					"content": "我对这地方的记忆还是很模糊，多半是受跋灵影响。小时候我经常觉得头痛，反复发烧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380108,
					"content": "当时还会突然感受到某种伟大的情感，看见一些模糊的影子。可都是片段，记不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380109,
					"content": "我那时还小，只知道脑子里有股顽强的意志。现在想想，哪怕无法交流，赫曼努比斯也以某种方式鼓舞着人类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380110,
					"content": "那种传入精神的力量，也许就是他们信仰的东西。赫曼努比斯的意志和力量确实存在，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380111,
					"content": "你要受他威胁吗？没有更好的办法了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380112,
					"content": "别冲动，赛诺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "不，我不打算还。他们也许有资格把握七柱力量的去向，但我需要这份力量来守护须弥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380115,
					"content": "——我要正面对抗，堂堂正正地，再次赢下这股力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380116,
					"content": "对了，临走前艾尔海森提醒过我，缄默之殿从前是个古老的贵族般的组织，而贵族总是被自己的礼仪所束缚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380117,
					"content": "卡维也说他在沙漠工作时听说沙漠部落大多都有自己的规矩，沙漠人总说自己无法违背血统和部落规矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380118,
					"content": "我们不妨主动一些，提出我们的方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380119,
					"content": "哇…原来还可以这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380120,
					"content": "想到一起去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380121,
					"content": "占据先机，主动提出无法拒绝的条件，我们就有可能拿下他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380122,
					"content": "听起来挺像那么回事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "嗯，切入口也想到了。我们可以去找赛索斯，告诉他我懂一些医学，想看看他祖父的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380113,
					"content": "一定还有办法的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
