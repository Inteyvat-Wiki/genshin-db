			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "赛索斯，我们谈谈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380202,
					"content": "你想清楚了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380203,
					"content": "在那之前，我稍微懂一点医学，能不能让我看看巴穆恩的情况？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380204,
					"content": "没问题，不过我们的人里也有医生，你想看出什么新花样怕是不可能了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380205,
					"content": "我只是需要一个答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380206,
					"content": "跟我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380207,
					"content": "轻一点，别吵到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380208,
					"content": "提纳里掏出这次随身带着的一些检查用具，为巴穆恩做了基本检查。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380210,
					"content": "我们到外面说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380211,
					"content": "巴穆恩深度昏迷了，情况很不乐观。你们的医生肯定也诊断出了同样的结果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380212,
					"content": "年轻时受过重伤，后来又积劳成疾，年迈体衰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380213,
					"content": "我必须遗憾地通知你……他的状况对我来说还算眼熟，一般这样的人最多只能再坚持几天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380214,
					"content": "…这些我早就知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380215,
					"content": "你是他的继承人吧？看得出，你尊重他，但你们想法不完全一样，你顾虑的方面更多，更现实。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380216,
					"content": "开个条件吧，在巴穆恩还看得见的时间里给这件事一个结果，我知道你在乎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380217,
					"content": "对啊，很多事不能拖，你应该明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380219,
					"content": "其实，你们俩现在的处境非常相似，都跟养育自己的人想法不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380220,
					"content": "而且明明是另一代人的矛盾，做决定的却是你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380221,
					"content": "你说得没错，这件事里双方立场都已经变化转移了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380222,
					"content": "我同意，赛诺。一切皆因赫曼努比斯而起，不妨也用他的仪式来做了断。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380223,
					"content": "传说赫曼努比斯刚到图莱杜拉城时曾与人比武，他和他的两位同伴连日战斗，收服人心，招揽了大批有志之士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380224,
					"content": "那些人后来都成为了缄默之殿的一份子。这是我们的开始，也是我们的仪式——「决斗之仪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380225,
					"content": "很有意义，就用这个办法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380226,
					"content": "你也拥有赫曼努比斯之力，与缄默之殿有很大关系。我同意你带同伴参加这场比试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380227,
					"content": "三对三，可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380228,
					"content": "但我有要求。你们作为攻擂方，必须连胜三局，而且赛诺，你我都要赌上自己持有的跋灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380229,
					"content": "放任居勒什带走跋灵是爷爷从前因怜悯犯下的错误，也是缄默之殿必须跨过的议题，这一点上我不能退让。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380230,
					"content": "正合我意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380231,
					"content": "如果我赢了，缄默之殿必须释放居勒什，并将过去的事一笔勾销。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380232,
					"content": "如果你赢了，我会归还这份力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380233,
					"content": "一言为定。那么明天晚上八点，到仪式之厅见面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛索斯"
				}
			]
		},
