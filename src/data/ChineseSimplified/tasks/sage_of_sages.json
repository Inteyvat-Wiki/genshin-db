			"dialogs": [
				{
					"id": 130380301,
					"content": "今日，当着众贤之至贤，赫曼努比斯大人权柄与威能的见证，我等将再次举行决斗之仪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380302,
					"content": "此为至圣的仪式，观礼者将不可打扰，百般恭敬，庄严地观看全过程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380303,
					"content": "缄默之殿的代表。防守方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380304,
					"content": "爷爷，你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380305,
					"content": "…咳…多少年了，你竟然举办这个仪式，赛索斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "巴穆恩"
				},
				{
					"id": 130380306,
					"content": "我知道我在做什么，爷爷，放心看着吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380307,
					"content": "教令院的代表。进攻方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380308,
					"content": "准备好了。今天我们会用实力赢下话语权。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380309,
					"content": "那么，请双方就位，决定出战顺序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380310,
					"content": "在这里，我等将不问来者何来，去者何去，赌上赫曼努比斯的力量，战斗直到决出胜负！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380311,
					"content": "我打头阵吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "哎？真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130380313,
					"content": "真的。士气很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#我同意，{NICKNAME}很强，率先出战能震慑对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380315,
					"content": "那你第二个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380316,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380317,
					"content": "决定好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380318,
					"content": "我们也决定好了，开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛索斯"
				}
			]
