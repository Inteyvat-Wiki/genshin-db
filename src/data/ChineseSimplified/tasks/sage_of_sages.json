			"dialogs": [
				{
					"id": 130380501,
					"content": "第二回合也结束了。第三回合的选手，请上前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380502
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380502,
					"content": "我准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380503
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380503,
					"content": "我也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380504
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380504,
					"content": "这是本次仪式的最后一环，请记住你们双方开出的条件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380505
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380505,
					"content": "准备好的话，随时可以开始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380506
					],
					"speakerTitle": "杜安雷"
				},
				{
					"id": 130380506,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380507
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380507,
					"content": "我是赫曼努比斯力量的适合者，现任缄默之殿首领巴穆恩之孙，赛索斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380508
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380508,
					"content": "长久以来，我们缄默之殿谨遵赫曼努比斯大人的要求保守秘密，亦为求自保之力而于走投无路之时进行实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380509
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380509,
					"content": "我们追随他的真知与力量，渴求他的灵魂与光明一同降下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380510
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380510,
					"content": "现在，我要为争夺这份力量而战！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380511
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380511,
					"content": "我是大风纪官赛诺，贤者居勒什的学生与继承者，为捍卫我的力量、我的老师与我的国家而战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380512
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380512,
					"content": "你呢？还有没说出口的话吧。既然是崇高的决斗，就在赫曼努比斯眼前展露你的真心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380513
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380513,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380514
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380514,
					"content": "（所有人…不论男女老少，都在期待着这场战斗的结果。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380515
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380515,
					"content": "爷爷是贤明的领导者，也是背负了血腥之名的首领。我知道他怎么想，也知道他怎么期待我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380516
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380516,
					"content": "但我们已经被信仰束缚了很久，后来我去了一趟雨林，见到了城里的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380517
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380517,
					"content": "时代变了，现在的须弥人似乎更快乐自由一些。我站在高处，俯瞰着脚下的街景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380518
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380518,
					"content": "然后我想到你。赛诺，你也拥有这份力量，却过着与我截然不同的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380519
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380519,
					"content": "赫曼努比斯的跋灵各有象征，威能、荣光…以及诸多未解之秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380520
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380520,
					"content": "我想过，大概是因为我们获得的跋灵象征不同，才会有这种区别。又或者…你已经找到了我不曾拥有的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380521
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380521,
					"content": "我不仅是一个战士，更是我自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380522
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130380522,
					"content": "…对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380523
					],
					"speakerTitle": "提纳里"
				},
				{
					"id": 130380523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380524
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380524,
					"content": "你我都是赫曼努比斯的容器，也不全是。他的名字影响了你我，改变了我们的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380525
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380525,
					"content": "如果是你，一定可以回答我的问题——在这份力量与信仰之外，我还能带来什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380526
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380526,
					"content": "来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380527
					],
					"speakerTitle": "赛索斯"
				},
				{
					"id": 130380527,
					"content": "怎么样？感觉还好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380528
					],
					"speakerTitle": "派蒙"
