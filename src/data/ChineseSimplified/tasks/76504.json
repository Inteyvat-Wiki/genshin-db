			"dialogs": [
				{
					"id": 765040701,
					"content": "#{NICKNAME}，派蒙，你们好。吃了吗？今天有什么特别的预定安排吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040702,
					"content": "我们正在四处参观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "了解了。四处走走，用镜头记录见闻，是不错的放松方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040705,
					"content": "不过，我没有在你身上检测到留影机呢。是不是出门的时候太匆忙，把它忘在什么地方了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040703,
					"content": "顺便寻找拍摄素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
