			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊涅芙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#{NICKNAME}，派蒙，你们好。吃了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040102,
					"content": "伊涅芙？你怎么也跑到屋顶上来啦。难道是…在观察云的形状，计算下雨的概率？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765040103,
					"content": "我正在执行一项…意外偏离预定轨道的任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040104,
					"content": "原定计划是为爱诺采购她清单上指定的「高精度齿轮」和「特制六角螺丝」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040105,
					"content": "但在返回工坊的途中，遭遇了一次…不可预见的物资拦截事件。一只鹰隼，以极快的速度，从我的手中叼走了那枚特制螺丝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040106,
					"content": "所以你就跑到屋顶上来找鹰隼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "是的。根据该生物的习性，屋顶是其可能的临时停落点。我正在进行全方位的视觉扫描与声音探测，试图定位目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040108,
					"content": "不过，截至目前，并未捕捉到有效踪迹。初步推测，目标已逃离我的追踪范围，或已将「猎物」转移至更隐蔽的巢穴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040109,
					"content": "后备计划已启动：重新前往指定供应商处，采购一枚同型号螺丝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040110,
					"content": "话说回来。你们出现在高处，难道也在…追踪某种小动物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040111,
					"content": "没有没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "对呀对呀，我们本来是想找个视野开阔的地方，拍一拍那夏镇的全景照片，记录下这里繁忙又有活力的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765040114,
					"content": "想不到竟然会在这里遇上正在「追捕小偷」的伊涅芙！这也是一种超小概率的「偏离轨道的惊喜事件」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765040115,
					"content": "机会难得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "可以。请指示我需要配合的站立位置、身体朝向以及推荐的面部表情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040118,
					"content": "#我想，我会登上屋顶，然后在这里遇到你们，还能让{NICKNAME}为我拍摄画片，这一系列事件的发生概率，恐怕比那只鹰隼归还螺丝还要低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040119,
					"content": "请务必将这难得的「惊喜」时刻，精确地记录下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 765040116,
					"content": "可以为你拍摄画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "我只是在寻找拍摄素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
