					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490302,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490303,
					"content": "嗯，赫利俄斯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490304,
					"content": "赫利俄斯是什么很了不起的东西吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490305,
					"content": "当然！吾当时主持建造赫利俄斯，举全国之力，以此抵御深海龙嗣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490306,
					"content": "是整个白夜国，除吾之外，再无第二人能完成的伟业！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490307,
					"content": "啊，听上去真是了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490308,
					"content": "可是这么了不起的大人物，为什么会被封在这里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490309,
					"content": "吾…吾是被人背叛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490310,
					"content": "当初天国塌落于无底深渊之下，诸民受龙嗣所害，是吾，吾掌持建造赫利俄斯，以此救众生于倒悬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490311,
					"content": "可是那群贪鄙小人！一旦性命无虞，就行欺上瞒下之事…最后竟还，推举稚童作国首。可笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490312,
					"content": "就连吾也被他们陷害，身死囹圄之中！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490313,
					"content": "可恶！可恶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490314,
					"content": "对了，汝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490315,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490320,
					"content": "就是汝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490321,
					"content": "原本吾之圣服被放置于此，只可惜年月之久，仅余残丝败缕，已难以作为凭依。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490322,
					"content": "只要汝能通过考验，吾就将寄托意念的供奉之物托付于汝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490323,
					"content": "希望汝能…成功通过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490324,
					"content": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722490317,
					"content": "派蒙，在叫你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "欸，他明明就在看着你嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722490319,
					"content": "（而且眼神还相当热切的样子。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "派蒙"
				}
			]
		},
