			},
			"dialogs": [
				{
					"id": 760020101,
					"content": "#喂，那边金发的{M#并肩子}{F#斗花子}！来得巧，这空码想吃横的，帮着搭把手，事后挑片儿短不了你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "巴苏"
				},
				{
					"id": 760020102,
					"content": "#什么玩意儿，打不过想拉人？行啊，你能干我也能干，{M#小哥}{F#小姐}听我的，帮我把这家伙做了，等摩拉到手，我分你一半！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "霍伊卡"
				},
				{
					"id": 760020103,
					"content": "欸，欸？！我们只是路过而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
