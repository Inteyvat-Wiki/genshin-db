			"dialogs": [
				{
					"id": 760020301,
					"content": "呼…还是让他们邮了。这群水滚子也是不识相，竟然敢别到我们的梁子上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "巴苏"
				},
				{
					"id": 760020302,
					"content": "多谢相帮。待弟兄们把这位「贝勒维尔小姐」送到那夏镇，片子自然短不了二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "巴苏"
				},
				{
					"id": 760020303,
					"content": "嗯嗯，记得酬劳就…咦，等等，你们难道是人贩子吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760020304,
					"content": "哈哈，别误会，小妹子，绑票的生意我们可不做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "巴苏"
				},
				{
					"id": 760020305,
					"content": "「贝勒维尔小姐」是这个铁皮玩意儿的名字。从灰河一路运过来的，花了不少功夫。要是让人别了，弟兄们可就赔大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "巴苏"
				},
				{
					"id": 760020306,
					"content": "哦哦，原来是枫丹的发条机关…不过，这么看看的话，枫丹的技术还真厉害啊，运到这里还能动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760020307,
					"content": "小妹子又在开玩笑了。这铁皮玩意儿的能源系统早就被拆了，哪有可能——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "巴苏"
				},
				{
					"id": 760020308,
					"content": "「警告。启动模式<color=#FF5E41FF>异常</color>。能源模块<color=#FF5E41FF>异x5F02&#5E38常</color>。校验失败。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "「贝勒维尔小姐」"
				},
				{
					"id": 760020309,
					"content": "「校验失败。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭歼灭歼灭歼</color>——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "「贝勒维尔小姐」"
				},
				{
					"id": 760020310,
					"content": "#噫——！{NICKNAME}，小心呀！",
