			"dialogs": [
				{
					"id": 402390301,
					"content": "正好大家都在！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402390302,
					"content": "事情终于要告一段落，大家最好把该聊明白的事情都聊明白。离开会场之后产生的纠纷，伏尼契商会概不负责哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390303
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390303,
					"content": "嗯…璃月方面受到的危害并不严重，打掉转卖渠道也达成了我此行的目的，那些人就全部交给枫丹方面处理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390304
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402390304,
					"content": "多谢通融，因为要整理卷宗，我确实需要把那些人都抓回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390305
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390305,
					"content": "至于你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390306
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390306,
					"content": "你毕竟是伏尼契商会名下的人，我要随随便便就把你带走，估计秘闻馆的主人也不会答应吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390307
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390307,
					"content": "那你有什么建议吗？夏沃蕾小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390308
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390308,
					"content": "嗯…不久前，出于追捕犯人的需要，我毁坏了展会在那夏镇安置的广告牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390309
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390309,
					"content": "这是警探大人的「自首」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390310
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390310,
					"content": "我的意思是，我不带他走了，作为交换，那个广告牌的事情也一笔勾销，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390311
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390311,
					"content": "成交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390312
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390312,
					"content": "我原本以为这件事很难处理，结果是这样解决的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402390313,
					"content": "叔叔，我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390314
					],
					"speakerTitle": "阿提"
				},
				{
					"id": 402390314,
					"content": "你的事，大姐姐们跟我们讲了，但是…我们还是想让你当我们的叔叔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390315
					],
					"speakerTitle": "阿娅"
				},
				{
					"id": 402390315,
					"content": "可是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390316
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390316,
					"content": "假如你当年没有轻信那些人的承诺，也给收留你的旅团留下了用来自保的武器，或许就不会招致那样的后果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390317
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390317,
					"content": "所以在我看来，你真正的罪过不是研究武器，而是没有用自己的知识保护好那些人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390318
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390318,
					"content": "你…说的是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390319
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390319,
					"content": "那么，一个真正能赎罪的机会就摆在你面前，你却还要犹豫吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390320
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390320,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390321
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390321,
					"content": "就让我好好赎罪吧，孩子们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390322
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390322,
					"content": "#{NICKNAME}，还有璃月的夜兰小姐，这次合作很愉快，那么我就先别过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390323
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402390323,
					"content": "#{NICKNAME}，我手上也有不少公务，就恕不久陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390324
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 402390324,
					"content": "看来你自由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390325
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390325,
					"content": "就算她们不抓我…我为了自己的目的加入了商会，还差点毁掉你们的声誉，你真的不打算处理我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390326
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390326,
					"content": "你刚加入商会的时候，我就知道你说了很多谎话。但当你声称沙漠是你的「故乡」时，我却发现你并没有在说谎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390327
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390327,
					"content": "实不相瞒，我也是愿意把沙漠称为「故乡」的人，所以我对你背后的故事很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390328
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390328,
					"content": "#有劳{NICKNAME}，你的故事我已经拿到了。这个故事还不错，所以你带来的那些麻烦就姑且算是这个故事的附赠品吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390329
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390329,
					"content": "真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390330
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390330,
					"content": "不过，你毕竟触犯了商会的许多禁忌，我不能让你继续留在商会里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390331
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390331,
					"content": "我明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390332
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390332,
					"content": "我建议你带着这些孩子回到沙漠去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390333
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390333,
					"content": "为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390334
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390334,
					"content": "从我记事起，沙漠里的争斗似乎就没有停止过，但了解过你的故事后，我觉得沙漠里的人也能拥有另一种生活方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390335
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390335,
					"content": "现在的须弥跟之前已经大不相同了，在那位小吉祥草王的治下，你帮助这三个孩子重建故乡也不是不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390336
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390336,
					"content": "感谢你的好意，但是已经过去了这么多年，那片绿洲肯定已经被风沙掩埋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390337
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390337,
					"content": "就算重新搭起几个帐篷又能怎样？现实终究是很残酷的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390338
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390338,
					"content": "这位客人，要不要瞧一瞧？只要价钱公道，什么都能从咱这里买到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390339
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390339,
					"content": "只要有摩拉，什么都能买到？哼…那我能为这些孩子买回一个「故乡」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390340
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390340,
					"content": "多莉她的叫卖风格就是这样的啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402390341,
					"content": "可以哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390342
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390342,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402390343,
					"content": "锵锵！且看这枚充满魔力的宝石，那位大名鼎鼎的魔女艾莉丝的杰作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390344
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390344,
					"content": "只要把它种下去，即便是黄沙滚滚的地方，也能长出一眼泉水，造就一片绿洲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390345
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390345,
					"content": "什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390346
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390346,
					"content": "嗯…是真货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390347
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 402390347,
					"content": "挪德卡莱贸易展会果真就像它宣传的那样，什么都可以买到…不过这样的宝物肯定也是天价，我们无福消受就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390348
					],
					"speakerTitle": "阿梵波谛"
				},
				{
					"id": 402390348,
					"content": "怎么说呢，委托我出手这枚宝石的魔女专门叮嘱过，它的定价应该是「孩子们的快乐」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390349
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390349,
					"content": "唉…明明有更赚钱的卖法，但这位魔女的要求还真不好回绝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390350
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390350,
					"content": "「孩子们的快乐」？那是多少摩拉呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390351
					],
					"speakerTitle": "阿提"
				},
				{
					"id": 402390351,
					"content": "嗯…有了！我只要这三个孩子在展会上挣到的钱，这样就可以看作是他们凭借自己的努力买回了「故乡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390352
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390352,
					"content": "这肯定是一件非常快乐的事，对不对？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390353
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390353,
					"content": "成交！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390354
					],
					"speakerTitle": "阿提"
				},
				{
					"id": 402390354,
					"content": "好嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390355
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 402390355,
					"content": "没想到最后还能遇到这样的惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402390356,
					"content": "不愧是多莉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402390357
					]
				},
				{
					"id": 402390357,
