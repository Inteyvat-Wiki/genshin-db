			"dialogs": [
				{
					"id": 766530201,
					"content": "到底是哪里出错了呢？只有理论知识的话果然还是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766530202,
					"content": "这位的订单就不用确认了…茜涅特，来自枫丹的工程师…这个订单是我最感兴趣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530203,
					"content": "您终于来了！那就还有希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766530204,
					"content": "你好，我们算是爱诺的助手哦。话说这位需要我们帮什么忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530205,
					"content": "她设计了一种可以利用月矩力进行远距离交流的机器人，特别好玩！但是故障太多了，所以只能来找我调试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530206,
					"content": "真是惭愧，只是抱着试一试的好奇心根本做不出成果，最终还是要靠实践…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766530207,
					"content": "听上去不是什么麻烦事，那就交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530208,
					"content": "说起来有些不好意思…我希望能修改一下订单的内容。之前等待回复的时候没有其他事情做，我又搞砸了一些事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766530209,
					"content": "我忽然很好奇换个环境能不能解决故障的问题，就找了几个月矩力不同的区域，分别测试了一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766530210,
					"content": "结果，机器人还是发生了故障，全部失联…所以，除了之前约好的调试之外，能不能也帮我把那些机器人找回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766530211,
					"content": "全丢了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530212,
					"content": "如果需要支付额外的报酬，我会想办法的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "茜涅特"
				},
				{
					"id": 766530213,
					"content": "嗯…对应的探测手段有很多，那些机器人都是用月矩力驱动的，它们活动过的地方会留下一些「月矩力纹样」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530214,
					"content": "我会给你们准备一种特殊的仪器，只要用它收集足够多的「月矩力纹样」，就可以探测到对应的机器人藏在哪里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530215,
					"content": "唔…估计会很好玩，看在这一点的份上，就不收取额外的费用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530216,
					"content": "真的？非常感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜涅特"
				}
			]
		}
	]
}