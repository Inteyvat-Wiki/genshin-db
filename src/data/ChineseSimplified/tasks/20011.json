			},
			"dialogs": [
				{
					"id": 200110301,
					"content": "这样子可以走过去了…谢谢，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110302,
					"content": "因为没多少钱，安娜的病又始终不见好，所以我经常来这采草药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110303,
					"content": "虽然草药采到了，但没想到今天会被这群家伙袭击，还好你赶过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110304,
					"content": "这个给你，我经常用这个给安娜泡茶喝，这样她的咳嗽才会好些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110305,
					"content": "你也经常在野外跑吧，自己要照顾好自己啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				}
			]
