			"dialogs": [
				{
					"id": 200110201,
					"content": "谢谢你，旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110202,
					"content": "可是还有个路障在这，我还是过不去，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110203,
					"content": "哈哈哈，本来我可以自己搞定…可我吃了丘丘人好几下，全身都在痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110204,
					"content": "不过还好，我给安娜摘的这些草药都没坏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110205,
					"content": "抱歉，虽然已经很麻烦你了，但是你能再帮我把这路障给解决掉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110206,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "谢谢，我要休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200110207,
					"content": "我还有急事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "可安娜还在家等着我…请你再帮帮我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安东尼"
				}
			]
		},
