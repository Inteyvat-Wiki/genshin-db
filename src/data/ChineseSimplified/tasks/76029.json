			},
			"dialogs": [
				{
					"id": 760290201,
					"content": "爱诺！你在家吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290202,
					"content": "哇！是派蒙的声音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290203,
					"content": "你们好呀！是带着零食来看望爱诺的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290204,
					"content": "就知道你会这么说，喏，来的路上就为你准备好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290205,
					"content": "快给我快给我，等下伊涅芙就要回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290206,
					"content": "那么今天要和爱诺一起玩什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290207,
					"content": "嘿嘿…实际上，有件事情想拜托爱诺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290208,
					"content": "呜哇！拿…拿走拿走！快把那怪东西拿走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290209,
					"content": "怪东西？是说这琴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290210,
					"content": "说了我讨厌用科学和机械原理解释不通的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290211,
					"content": "那个琴隔三差五就会出现在我家门口，但我每次把它修好后，它又会莫名其妙地不见了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290212,
					"content": "我…我才不信有这种神神鬼鬼的东西呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290213,
					"content": "啊…看来这其中有些误会呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290214,
					"content": "误会？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290215,
					"content": "这是一位朋友的琴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "嗯，她其实没有恶意啦，每次悄悄拿走，也有些缘由在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290218,
					"content": "真的吗？你们没在骗我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290219,
					"content": "那…那我就信你们，再修一次…这次就修得彻底一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290220,
					"content": "你们在这里等一下哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290221,
					"content": "爱诺还是挺可靠的呀，就是被悄悄放东西的行为吓到有些可怜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290222,
					"content": "的确该回报她一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290223,
					"content": "嗯嗯…呃啊！你怎么突然出现在这里啦！这次是吓到我们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290224,
					"content": "给你们点东西就回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290225,
					"content": "嗯？这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290226,
					"content": "是月灵收集的一些「宝物」，它想要谢谢这位工匠，觉得她会喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290227,
					"content": "哦~好多稀奇古怪的零件呢。好吧，我们收到了，待会儿就转交给爱诺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290228,
					"content": "你回去的路上也要小心哦，别被人看见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290229,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "嗯？怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290232,
					"content": "那边…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290234,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290235,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290236,
					"content": "…相似度比对中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290237,
					"content": "在和什么比对啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290238,
					"content": "与挪德卡莱月神像的人物相似度…百分之九十五…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290239,
					"content": "是…是演员！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#检测到{NICKNAME}的心率上升…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290243,
					"content": "修好啦！这次应该再也不会坏了，顺带一提刚才的零…伊…伊涅芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290244,
					"content": "刚才的零…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290245,
					"content": "刚才的零件也很管用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290246,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290247,
					"content": "嗯？你们身后这位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290248,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290249,
					"content": "是琴的委托人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "（总觉得有些眼熟…我在哪里见过这位姐姐吗？不管了，这不重要。派蒙给我的零食应该藏好了吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290252,
					"content": "对…对！这些零件也是她送过来的，说是想感谢爱诺你帮忙修琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290253,
					"content": "嗯？我看看…哇！都是些古老的稀有零件欸！真的可以收下吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290254,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290255,
					"content": "谢谢你！以后有什么要修的东西也可以来找我哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290256,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290257,
					"content": "呃…那，那我们差不多回去了。爱诺，伊涅芙，我们改天再找你们玩哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290258,
					"content": "（得赶快带「少女」离开，不然伊涅芙要认出来了！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290259,
					"content": "好…好呀！那就改天见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290260,
					"content": "（得赶快回去收拾一下，不然伊涅芙要发现零食屑了！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290261,
					"content": "好，二位再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290262,
					"content": "…爱诺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290263,
					"content": "怎…怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290264,
					"content": "这些零件需要供起来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290265,
					"content": "啊？为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290266,
					"content": "它们好像是「月神的赠物」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290267,
					"content": "呃，伊涅芙你在说什么…我等下帮你检查检查线路吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "爱诺"
				},
				{
					"id": 760290250,
					"content": "是怕生的客户！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "有…有误差！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "误差范围较小，推断结论可靠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 760290216,
					"content": "那个朋友有些怕生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
