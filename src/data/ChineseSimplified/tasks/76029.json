			"dialogs": [
				{
					"id": 760290101,
					"content": "你们好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290102,
					"content": "咦？哥伦比娅你要出门吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290103,
					"content": "嗯，出去修琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290104,
					"content": "…什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290105,
					"content": "有只月灵的琴坏了，它很珍惜这琴，我想帮它修好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290106,
					"content": "月灵们还真是多才多艺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290107,
					"content": "嗯，它经常在这里弹琴，我偶尔也会和着琴声唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290108,
					"content": "我之前就这么觉得了，你还真是宠月灵呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290109,
					"content": "它们一直陪着我，还经常给我带好玩的东西回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290110,
					"content": "（菈乌玛说过，这是因为月灵想让月神开心的天性使然吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "不过我问一句，你打算怎么修好这琴呀？你不是说自己不能被别人看到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290112,
					"content": "唔…以前我会拜托小动物或者月灵，让它们把要修的东西放到工匠家门口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290113,
					"content": "工匠发现后，一般都会顺手把东西修好。不过有时也会发现不了，要等几天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290114,
					"content": "听起来有些周折呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290115,
					"content": "不如交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290117,
					"content": "放心吧，我们去的话说不定今天就能修好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290118,
					"content": "…好吧。谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290119,
					"content": "别客气。顺带一提，你一般放在哪个工匠的家门口呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760290120,
					"content": "我不知道她名字。她家门口有个大大的机械手，住在一个圆圆的，像海螺一样的家里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290121,
					"content": "（难道说是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "里面还经常传来蛋卷的香味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760290123,
					"content": "我好像知道是谁了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
