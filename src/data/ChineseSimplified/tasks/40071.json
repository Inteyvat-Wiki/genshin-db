						],
						"stepId": 4007103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旁白",
					"莫娜",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "「如今的国民无从忆起，但学者知道，远在早于圣徒时代约六百年的混沌期间，皇女殿下便已君临世间。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "旁白"
				},
				{
					"id": 400710302,
					"content": "不会吧？旁白？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710303,
					"content": "不愧是书里的世界，竟然还有旁白给我们讲故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710304,
					"content": "路断了，走不过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710305,
					"content": "那边有个装置，像是等着我们靠近一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710306,
					"content": "我总觉得…这里的一切是不是太过刻意了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710307,
					"content": "是圣国嘛。体谅一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710308,
					"content": "也是，这么明显，完全就是希望被人发现嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710309,
					"content": "不愧是菲谢尔，在这种地方坦率得可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4007110,
			"completionStepIds": [
				4007110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007110",
							"2"
						],
						"stepId": 4007110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱昂",
					"莫娜",
					"辛焱",
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "天哪，请救救我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400711002,
					"content": "喂，这不是个雕像吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711003,
					"content": "请别这么说！我是幽夜净土的骑士，莱昂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400711004,
					"content": "骑士？完全看不出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711005,
					"content": "看不出吗？好吧。就算如此，也请各位不要怪罪为夜鸦骑士们设计配发盔甲的奥兹华尔多大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400711006,
					"content": "奥兹华尔多大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME}应该听说过吧？奥兹的全名是奥兹华尔多·赫芙那梵茵斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711008,
					"content": "我知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "那还是梅姬斯图斯好念一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711011,
					"content": "嗯，我也这么想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400711012,
					"content": "啊哈哈，大家都这么说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711013,
					"content": "各位朋友，打扰你们愉快的聊天时间实在非我所愿，只是，你们应该还不知道前面的大门上了锁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400711014,
					"content": "确实不知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711015,
					"content": "但愿好心的你们能动动手指将我救上去，作为报答，我非常愿意将打开大门的方法教给各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "莱昂"
				},
				{
					"id": 400711016,
					"content": "你都这么说了…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711009,
					"content": "我现在知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
