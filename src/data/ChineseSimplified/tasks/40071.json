				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "欸？怎么换地方了，但又没回到海滩上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711402,
					"content": "这里似乎是蒙德的住宅呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711403,
					"content": "贵安，尊贵的「断罪之皇后」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400711404,
					"content": "小艾咪亲爱的，妈妈做了煎肉排和渔人吐司，快来趁热吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "菲谢尔的母亲"
				},
				{
					"id": 400711405,
					"content": "咳咳！母后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400711406,
					"content": "噢噢，瞧我，都给忘了。咳！断罪之皇女，汝可知此刻正是午餐时分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "菲谢尔的母亲"
				},
				{
					"id": 400711407,
					"content": "当然了母后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400711408,
					"content": "噢——！窗外景色如此迷人，皇女，皇后，二位可否赏光与我这「断罪之皇帝」一同外出野餐？看看风景，享受上天恩赐的美味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "菲谢尔的父亲"
				},
				{
					"id": 400711409,
					"content": "是的，非常愿意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400711410,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400711412,
					"content": "呃…那个，大家是不是都有话想说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711413,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "我直接问了，小艾咪…是菲谢尔的真名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711415,
					"content": "应该是吧。刚才那两个声音，好像是她的爸爸妈妈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711416,
					"content": "…看我干什么？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711417,
					"content": "可能有点冒昧，但…你真的姓梅姬斯图斯吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400711418,
					"content": "哼，你在小看我？本占星术士的全名是：阿斯托洛吉斯·莫娜·梅姬斯图斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711419,
					"content": "…对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400711420,
					"content": "好长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711421,
					"content": "只有天才能拥有这个名字哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711422,
					"content": "总觉得没有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711423,
					"content": "刚才那些，你们感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711424,
					"content": "我确定了一件事，「合上书本」也是一种引起幻境变化的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400711425,
					"content": "菲谢尔的家人居然肯配合她，厉害啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711426,
					"content": "但也不会一直如此。听声音，这是她小时候的回忆吧？长大可就不是这样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711427,
					"content": "莫娜知道很多嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711428,
					"content": "身为朋友知道这些很正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711429,
					"content": "…菲谢尔现在，会在哪里呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711430,
					"content": "刚才那个声音说她要出门，我们不如也出去看看，应该会有线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
