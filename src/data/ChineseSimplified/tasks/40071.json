			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"枫原万叶",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "醒了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710202,
					"content": "唔…又是早上了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "怎么样？出现什么了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "说出来你可能不信，什么事都没发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710205,
					"content": "你醒啦？那我们直接说结论，四周都找过了，没有可疑的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710206,
					"content": "按照之前两处幻境的规律，应该会有一件承担着「入口」职责的物品才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400710207,
					"content": "这就怪了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "会不会是没到时候？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710209,
					"content": "你的意思是，再等等？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710210,
					"content": "嗯。而且，菲谢尔不在这里。我想，她很可能比我们更急着找到入口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710211,
					"content": "我们等等吧。给幻境…不，给菲谢尔一点时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710212,
					"content": "大家赞同莫娜的说法，聚在一起喝茶休息。之后，又分为两队四处搜索。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "终于，在白白走了好几个来回后，海滩上突然多出了一些东西。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "有什么东西掉在沙滩上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710215,
					"content": "是一本书？旁边还有只…呃…乌鸦的雕像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400710216,
					"content": "这尊雕像长得好像奥兹哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710217,
					"content": "一起出现是什么意思？这本书，是它送来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710218,
					"content": "这是什么？日记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710219,
					"content": "我看看…《圣国的咏唱》？我都没见过叫这个名字的书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710220,
					"content": "看封面，难道是…菲谢尔自己写的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710221,
					"content": "这么一说确实像她的风格。《圣国的咏唱》，书名不错，我喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710222,
					"content": "这本书的名字，有种神圣感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400710223,
					"content": "怎么样？要碰碰它吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710224,
					"content": "…还没回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710225,
					"content": "算了，我们先去看看吧。如果菲谢尔见到这本书，应该会来找我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710226,
					"content": "我同意哦！就像被人偷看了日记一样，肯定要进来阻止我们的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007103",
