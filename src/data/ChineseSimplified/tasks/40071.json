					"nextDialogs": [
						400711506
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711506,
					"content": "她俩很受打击的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711507,
					"content": "实不相瞒，我也不喜欢看被腰斩的书。",
