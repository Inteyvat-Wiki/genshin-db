					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "前面好像没有路了，只有一本书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711302,
					"content": "我们刚才听到的，应该就是书里的故事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711303,
					"content": "所以，书名中的圣国，指的就是幽夜净土。这本书是在用国民的口吻歌颂皇女殿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711304,
					"content": "也算是自传的一种吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "书已经翻到最后一页了，但它们的故事听起来还没结束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400711306,
					"content": "后续呢？我想听后续！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711307,
					"content": "那就得继续探索了吧。比起这个，看完的书…还是先合上比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
