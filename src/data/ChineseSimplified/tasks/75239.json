			"dialogs": [
				{
					"id": 752390101,
					"content": "扎卡那小子…活不干完就旷工了，那些玩偶也不知道放哪去了。我非得投诉他不可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
					],
					"speakerTitle": "卡内"
				},
				{
					"id": 752390102,
					"content": "什么玩偶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "是一些以鳍游龙为原型的小玩偶，我在给它们上色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "卡内"
				},
				{
					"id": 752390104,
					"content": "但是我的徒弟扎卡最近没来上班，他手上还有三个没上色的半成品玩偶，也不知道被他放去哪里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "卡内"
				},
				{
					"id": 752390105,
					"content": "这位客人，你能帮我找一找它们吗？我想应该就在附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡内"
				}
			]
		},
