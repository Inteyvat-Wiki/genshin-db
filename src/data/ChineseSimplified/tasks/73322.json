			},
			"dialogs": [
				{
					"id": 733220801,
					"content": "我们回来啦，瑟法娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220802,
					"content": "「净觉花」已悉数摆脱污秽的侵蚀，汝也不必惶恐了，瑟法娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220803
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220803,
					"content": "好厉害，不愧是斯露莎姐姐！这么多年来一直无比可靠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220804
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220804,
					"content": "#「谒颂主」{NICKNAME}大人，也有劳你了！我给你准备了谢礼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220805
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220805,
					"content": "我在照顾「净觉花」的路上，捡到了亮晶晶金闪闪的东西，听说每个人类和他们的喵喵汪汪都喜欢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220806
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220806,
					"content": "难道是…摩拉？那我确实不讨厌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220807,
					"content": "斯露莎姐姐想要什么谢礼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220808
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220808,
					"content": "肤浅，瑟法娜！完成伟业才是吾心系之事，无需费心感谢吾，悉心照料汝的躯体与「净觉花」便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220809
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220809,
					"content": "意思是，瑟法娜不用和斯露莎客气，照顾好自己就可以了？这句话倒还挺像个姐姐欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220810,
						733220811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220810,
					"content": "斯露莎似乎不擅长表达关怀呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220812
					]
				},
				{
					"id": 733220812,
					"content": "胡乱猜测！吾只是在述说瑟法娜的职责，给她警示罢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220813
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220813,
					"content": "以尔等人类能理解的概念而言，「净觉花」与吾辈花灵皆诞生于万种母树的甘露，是同源的「家人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220814
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220814,
					"content": "守候「净觉花」的花灵终日面对污秽之物的侵袭，当然要时刻注意躯壳的劳损。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220815
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220815,
					"content": "瑟法娜虽有失职之处，但守候「净觉花」的时日不短，倒也不可否认她的苦劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220816,
						733220817
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220816,
					"content": "「家人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220818
					]
				},
				{
					"id": 733220818,
					"content": "不管怎么样，斯露莎还是在照顾后辈吧？也许斯露莎心里也藏着温柔的一面呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733220819,
					"content": "温柔？我觉得这个说法很贴切！虽然斯露莎姐姐总是说着很可怕的话，但她经常帮我解决困扰，是最关心我的好前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220820
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220820,
					"content": "大不敬…不许再用这种离奇的措辞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220821
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220821,
					"content": "多费口舌也没有意义了…吾等还要熄灭「焚真之天象」，没空再闲聊了，就与瑟法娜别过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220822
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220822,
					"content": "待吾铸定伟业，彻底驱除黯色的力量，必将使「甘露花海」的色彩重归纯净无暇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220823
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220823,
					"content": "啊，斯露莎姐姐要走了吗？那…祝你一切顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220824
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220824,
					"content": "我会一直等着你们的，斯露莎姐姐，还有「谒颂主」大人和白色的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220825
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220825,
					"content": "下次再见的时候，还请「谒颂主」大人和白色的伙伴倾听斯露莎姐姐的故事。我还有好多好多话想和你们说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220826
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733220826,
					"content": "#哼…之后未必会再见了。不过，尽管与吾之「谒颂主」细说吧，好让{M#他}{F#她}更为详实地记述吾之功业！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220817,
					"content": "这样说来，的确很重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220818
					]
				},
				{
					"id": 733220811,
					"content": "说不定以前真的对瑟法娜很好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733220812
					]
				}
			]
		},
