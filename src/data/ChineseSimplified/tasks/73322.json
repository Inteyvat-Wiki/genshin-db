					"nextDialogs": [
						733220921
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220921,
					"content": "咳咳！反正，「净觉花」的危机已经结束了！瑟法娜，以后我还会来看望你和「净觉花」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733220922
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733220922,
					"content": "终有一天，黯色的余烬将丝缕无存，「甘露花海」的色彩也会重归纯净无暇。",
					"roleType": "TALK_ROLE_NPC",
