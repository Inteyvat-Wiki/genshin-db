			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑟法娜",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733221001,
					"content": "虽说黯色的力量还在肆虐…但所有花池都受到了净化，恢复了生机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221002
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221002,
					"content": "怎么回事呢？有谁在帮我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221003
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221003,
					"content": "如果真是这样，或许我和花池们也获得了万种母树的庇佑…真是太幸运了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221004
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221004,
					"content": "瑟法娜，好久不见啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221005
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221005,
					"content": "等等，我没看错吧…是斯露莎姐姐？你居然回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221006
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221006,
					"content": "你不会再突然离开吧？不会一去就是好久好久吧？不会的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221007
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221007,
					"content": "#冷静，吾的去留不是重点！这次，吾与「谒颂主」{NICKNAME}来通知你，吾等弥补了汝的过失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221008
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221008,
					"content": "吾正遂行熄灭「焚真之天象」的伟业，顺势祓除了黯色的侵蚀，解救了所有花池。但汝务必牢记，这是汝的失职！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221009
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221009,
					"content": "原，原来是斯露莎姐姐的功劳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221010
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221010,
					"content": "我…我明白自己的过错了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221011
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221011,
					"content": "实在感谢你们…我可以松口气了…一直以来的不安全都消散了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221012
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221012,
					"content": "瑟法娜居然管斯露莎叫姐姐呢，这个姐姐未免也太严厉了，根本让人喜欢不起来嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221013,
					"content": "何等幼稚！前辈对于后辈，自然是要多加提点的，怎么能看着她们犯错，还温声细语！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221014
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221014,
					"content": "没…没错！以前斯露莎姐姐可是很照顾我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221015
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221015,
					"content": "斯露莎姐姐在「净觉花」前，发出「目标是比肩西摩格」的宣言时…比什么心得都能鼓舞我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221016
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221016,
					"content": "从那时起，我就觉得，斯露莎姐姐的意志真可敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221017
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221017,
					"content": "所以我才学着人类对同辈长者的称谓，如此称呼她，这代表着我的敬意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221018
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221018,
					"content": "真是个性格和善的花灵啊…完全想象不出斯露莎被其他花灵严厉管教后，还亲切地叫对方「姐姐」的场景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221019,
					"content": "多…多嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221020,
						733221021
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221020,
					"content": "先聊聊正题吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221022
					]
				},
				{
					"id": 733221022,
					"content": "对哦，斯露莎姐姐的「谒颂主」或许不怎么了解「净觉花」？那我就借前辈们的话介绍一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221023
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221023,
					"content": "曾有一位花灵如此诵唱——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221024
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221024,
					"content": "「这凝明的色彩，是生命之泉流转的灵迹」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221025
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221025,
					"content": "「伴我长存，与我妙舞清歌，编织悠久的欢欣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221026
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221026,
					"content": "…后边忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221027
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221027,
					"content": "这段时间一直在抵抗污秽的侵袭，太累了，意识有点模糊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221028
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221028,
					"content": "不用勉强自己哦，典故什么的记不起来也没关系，就用轻松一点的说法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221029
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221029,
					"content": "那我想想…「净觉花」虽不是「甘露花海」中最为珍贵之物，但确是我们花灵极为重视的「伴侣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221030
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221030,
					"content": "许多花灵在完成了每天应尽的职责后，就会与「净觉花」为伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221031
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221031,
					"content": "在人类眼中就像…自小就一直陪着他们成长的…歌声是「喵喵」和「汪汪」的生灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221032
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221032,
					"content": "猫猫和狗狗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221033
					]
				},
				{
					"id": 733221033,
					"content": "原来是这样，如果陪着我长大的猫猫狗狗生病了，我也会很难过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221034
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221034,
					"content": "更别说，生活中只有猫猫狗狗当朋友了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221035
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221035,
					"content": "瑟法娜这么一描述，我就能理解了，「净觉花」的健康确实超级重要！我们之前的辛苦都没有白费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221036
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221036,
					"content": "真是粗浅的比喻，其实「净觉花」的重要性远在这之上，瑟法娜还是需要修习言辞的门道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221037
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221037,
					"content": "话说回来，这次不仅劳烦了斯露莎姐姐，还有第一次见面的「谒颂主」大人，我得好好准备给你们的谢礼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221038
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221038,
					"content": "我在照顾「净觉花」的路上，捡到了亮晶晶金闪闪的东西，听说每个人类和他们的喵喵汪汪都喜欢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221039
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221039,
					"content": "难道是…摩拉？那我确实不讨厌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221040
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221040,
					"content": "斯露莎姐姐想要什么谢礼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221041
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221041,
					"content": "肤浅，瑟法娜！完成伟业才是吾心系之事，无需费心感谢吾，悉心照料汝的躯体与「净觉花」便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221042
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221042,
					"content": "意思是，瑟法娜不用和斯露莎客气，照顾好自己就可以了？这句话倒还挺像个姐姐欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221043,
						733221044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221043,
					"content": "斯露莎似乎不擅长表达关怀呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221045
					]
				},
				{
					"id": 733221045,
					"content": "胡乱猜测！吾只是在述说瑟法娜的职责，给她警示罢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221046
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221046,
					"content": "以尔等人类能理解的概念而言，「净觉花」与吾辈花灵皆诞生于万种母树的甘露，是同源的「家人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221047
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221047,
					"content": "守候「净觉花」的花灵终日面对污秽之物的侵袭，当然要时刻注意躯壳的劳损。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221048
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221048,
					"content": "瑟法娜虽有失职之处，但守候「净觉花」的时日不短，倒也不可否认她的苦劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221049,
						733221050
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221049,
					"content": "「家人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221051
					]
				},
				{
					"id": 733221051,
					"content": "不管怎么样，斯露莎还是在照顾后辈吧？也许斯露莎心里也藏着温柔的一面呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221052
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733221052,
					"content": "温柔？我觉得这个说法很贴切！虽然斯露莎姐姐总是说着很可怕的话，但她经常帮我解决困扰，是最关心我的好前辈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221053
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221053,
					"content": "大不敬…不许再用这种离奇的措辞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221054
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221054,
					"content": "多费口舌也没有意义了…吾等还要熄灭「焚真之天象」，没空再闲聊了，就与瑟法娜别过吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221055
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221055,
					"content": "待吾铸定伟业，彻底驱除黯色的力量，必将使「甘露花海」的色彩重归纯净无暇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221056
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221056,
					"content": "啊，斯露莎姐姐要走了吗？那…祝你一切顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221057
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221057,
					"content": "我会一直等着你们的，斯露莎姐姐，还有「谒颂主」大人和白色的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221058
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221058,
					"content": "下次再见的时候，还请「谒颂主」大人和白色的伙伴倾听斯露莎姐姐的故事。我还有好多好多话想和你们说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733221059
					],
					"speakerTitle": "瑟法娜"
				},
				{
					"id": 733221059,
					"content": "#哼…之后未必会再见了。不过，尽管与吾之「谒颂主」细说吧，好让{M#他}{F#她}更为详实地记述吾之功业！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733221050,
					"content": "这样说来，的确很重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221051
					]
				},
				{
					"id": 733221044,
					"content": "说不定以前真的对瑟法娜很好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221045
					]
				},
				{
					"id": 733221021,
					"content": "关于「净觉花」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733221022
					]
				}
			]
		},
