			},
			"dialogs": [
				{
					"id": 755060101,
					"content": "嗨，你们来了啊，这里就是最后一处深渊蜜虫出没的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060102,
					"content": "把这里的蜜虫捉住就算搞定了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060103,
					"content": "嗯，就算还有一些漏网之鱼，也不是大问题，我会抽空处理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060104,
					"content": "族里也有传来消息，病人的情况这几天基本都好转了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060105,
					"content": "真是不错的消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060106,
					"content": "不过还有一件可惜的事，小派蒙警惕的阴谋并没有发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060107,
					"content": "那些浆果看来就是自然地长在了蜜虫的聚集地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060108,
					"content": "唔…我可没有预测什么愚人众…盗宝团之类的展开…我这是在展示一个优秀的向导该有的警惕心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060109,
					"content": "相信你可以一直保持。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "嘿嘿，那是当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060111,
					"content": "好咯，那我们就快速解决最后的任务吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060112,
					"content": "好耶！捉虫小队，最后出击！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
