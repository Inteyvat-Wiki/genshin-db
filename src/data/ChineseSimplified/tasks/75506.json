				]
			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#希诺宁？还有{NICKNAME}和派蒙？你们好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060202,
					"content": "欧洛伦？你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060203,
					"content": "你身体恢复好了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "多谢关心，奶奶给我灌了很苦的东西，强迫我休息了好几天，现在已经好很多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060205,
					"content": "你好呀！欧洛伦，你也是来帮希诺宁捉蜜虫的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060206,
					"content": "捉蜜虫？哦！原来十分甜被你们捉走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060207,
					"content": "难怪极限甜、异常甜它们也不见了…原来如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060208,
					"content": "呃…这些是蜜虫的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060209,
					"content": "是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060210,
					"content": "这是为了方便区分，我不会评价它们的，它们就算不产蜜也都很棒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060211,
					"content": "所以…这些蜜虫都是你养的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060212,
					"content": "我其实没怎么干扰它们的作息起居，我们只是在同一片领地生活，是比较融洽的那种关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060213,
					"content": "呃…抱歉，我不知道这回事。因为它们被深渊污染，影响到了部族，所以不得不来处理一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060214,
					"content": "对对对…我们也没有伤到它们的性命哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060215,
					"content": "那就好…没关系，不用这么在意，我本来也是来处理这个问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060216,
					"content": "只是有件事要纠正一下，蜜虫是一种很聪明的小生命，它们不是被深渊污染了，是它们主动吃下了深渊能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060217,
					"content": "欸？是主动吃的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060218,
					"content": "是这样没错，它们一次只吃一点点，虽然一点点就会让自己的身体膨大很多，但是不会致死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060219,
					"content": "之后它们就会飞到很远的地方，然后产下包裹了污染物的燃素蜜珠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060220,
					"content": "蜜珠外壳可以隔绝一定的污染，这样做，就能逐渐把深渊能量从家园里剥离出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060221,
					"content": "虽然要做很多很多遍，但是它们都很有耐心，就算是蚂蚁搬家也没问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060222,
					"content": "呃…原来它们是在保护家园啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060223,
					"content": "我还是第一次知道，原来它们也知道这片土地正在被侵害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060224,
					"content": "嗯，十分甜它们也一直在努力战斗！全是很能干的好蜜虫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060225,
					"content": "纳塔不愧是战争的国度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "不过欧洛伦，你是怎么找到这里来的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060227,
					"content": "噢，因为我给蜜虫喂了一种麻痹果的种子，它们不会消化的，过不了多久就会排泄出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060228,
					"content": "种子落地后很快就能生长起来，变成小果丛，跟着果丛，我就能找到它们出没的地方啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060229,
					"content": "然后我就会它们把产下来的蜜珠收集起来处理，再用麻痹果把它们带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060230,
					"content": "不过看来你们已经替我做了这些事，也没有伤害到它们的性命。真是谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060231,
					"content": "原来这些麻痹果子是这么回事啊。我还绞尽脑汁地想，会不会有什么阴谋呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060232,
					"content": "怎么了？给你添麻烦了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060233,
					"content": "那倒没有啦！放心放心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060234,
					"content": "欧洛伦，我们会把清除了污染的蜜虫给你原原本本送回去的，请你放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060235
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060235,
					"content": "这样就再好不过了，它们都是很重要的生命，一定要好好对待才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060236
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060236,
					"content": "既然事情已经解决，那就再见啦，各位，欢迎你们下次去我那里做客，我带你们认识其他好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060237
					],
					"speakerTitle": "欧洛伦"
				},
				{
					"id": 755060237,
					"content": "很期待，再见啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060238
					]
				},
				{
					"id": 755060238,
					"content": "呼~没想到事情是这样，欧洛伦这家伙，还挺会制造「惊喜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060239
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060239,
					"content": "#也谢谢你们啦，{NICKNAME}和派蒙，要不然我这一趟肯定很没劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060240
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060240,
					"content": "这个送给你们，是没被污染的燃素蜜珠，别有压力，不贵重的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060241
					],
					"speakerTitle": "希诺宁"
				},
				{
					"id": 755060241,
					"content": "就当留个纪念吧，为这些也在替纳塔战斗的小家伙们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希诺宁"
				}
			]
		}
	]
}