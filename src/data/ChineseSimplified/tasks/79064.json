			"dialogs": [
				{
					"id": 790640601,
					"content": "发现可疑人士！虽然不知道你们犯了什么法，但是现在最高戒备，走，和我们去自首！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "巨人卫兵"
				},
				{
					"id": 790640602,
					"content": "你们四散逃开。卡佩喊了一句「各凭本事！」 \\n甩开守卫之后，你们在原地重新集合了。好在没有人被抓…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "再试试吧。",
