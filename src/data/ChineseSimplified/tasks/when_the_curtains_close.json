						],
						"pointId": 330201505
					}
				]
			},
			"dialogs": [
				{
					"id": 401060101,
					"content": "二十年前，教令院刚刚拿到萨齐因的资产。像是为了庆祝那笔数额很大的投资，那一届学院庆典办得格外隆重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060102
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060102,
					"content": "那时我还小，走在城里看见到处都是学院争霸赛的海报，忍不住向老爹提了这件事。我还说那个冠冕很特别，很漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060103
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060103,
					"content": "老爹问我：「要不要我拿下冠军，把冠冕送你玩几天？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060104
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060104,
					"content": "我很高兴，不停点头。可没想到，那一届比赛最后老爹并没有拿到冠冕。他回家时看上去异常失落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060105
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060105,
					"content": "之后他说是要去沙漠考察，离开了家，没过多久就遭遇流沙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060106
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060106,
					"content": "…过去很多年里我一直不太能面对这件事。假如当初不是我多嘴，所有的事情也许就不会发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡维"
				}
			]
		},
		{
			"id": 7352402,
			"completionStepIds": [
				7352403
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡维"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060107,
					"content": "你父亲可能在那年见过萨齐因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060108
					]
				},
				{
					"id": 401060108,
					"content": "欸？难道说我们调查中，二十年前那个去沙漠的人其实是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401060109,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060110
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060110,
					"content": "…哈哈，所以萨齐因见到我才觉得熟悉？这可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060111
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060111,
					"content": "…老爹那种过度善良的人，听到萨齐因的理论肯定会很难过的。所以他才去了沙漠，去寻找那些还在受苦的人…我完全能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060112
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060113
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060113,
					"content": "我曾反复告诉自己，或许他不是因为没拿到冠军才失落，那件事并不一定是我看到的那样。但…归根结底还是因为我跟他提了比赛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060114
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060114,
					"content": "卡维…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401060115,
					"content": "不用担心。我…我砸碎了那枚冠冕。以后再也不会发生这样的悲剧了。再也不会了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡维"
				}
			]
		},
		{
			"id": 7352403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡维"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060116,
					"content": "（隐瞒自己之前做过的调查。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060117
					]
				},
				{
					"id": 401060117,
					"content": "抱歉，我还在想学院争霸赛的事情，一不小心就自言自语起来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060118
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060118,
					"content": "你看起来很难过…真的不要紧吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401060119,
					"content": "没关系。已经是过去的事了，人总是要向前看的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡维"
				}
			]
		},
		{
			"id": 7352404,
			"completionStepIds": [
				7352406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352406",
							"2"
						],
						"stepId": 7352406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡维",
					"艾尔海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060201,
					"content": "聚餐的时候你跑到哪里去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060202
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060202,
					"content": "我怎么不记得我有义务向你汇报这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060203
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060203,
					"content": "总不会是找个地方看书去了吧？你也该改改你的作风了，人不能只靠看书活着啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060204
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060204,
					"content": "靠你请客吃饭活着的难度更大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060205
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060205,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060206
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060206,
					"content": "哼，没那么难猜。你是去调查萨齐因了吧？看那些笔记就知道了。但我不认为萨齐因的研究能让你感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060207
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060207,
					"content": "那家伙的做法让人很不舒服。你嘛…我确实讨厌你的观念，可你和萨齐因是两种人，观点也不该有重合才对。利己主义不等于虚无。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060208
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060208,
					"content": "撇开兴趣，萨齐因能凭个人力量留下这种规模的实验，不是完全没意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060209
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060209,
					"content": "另外，谢谢夸奖。但我只是走在去院里的路上，不是想听你说这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060210
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060210,
					"content": "对学者而言还有什么比探讨理念更崇高的话题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060211
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060211,
					"content": "据我所知，你口中让人不舒服的萨齐因，很可能在二十年前与你父亲见过面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060212
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060212,
					"content": "…你说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060213
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060213,
					"content": "…难道…不，原来是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060214
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060214,
					"content": "哈，所以萨齐因看到我才觉得眼熟。老爹去沙漠，竟然是受到了他的影响…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060215
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060215,
					"content": "恐怕是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060216
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060216,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060217
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060217,
					"content": "幸好我把冠冕摔了。以后…应该不会再发生这种事才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060218
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060218,
					"content": "知识的边界总在向外延伸，未来一定还会有人重新研究相同的事情。对因论派而言，这是合理的研究方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060219
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060219,
					"content": "又要开始你那套观点了吗？就算真像你所说，人总在落入学识的圈套，事情也未必就会再变成那样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060220
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060220,
					"content": "而且你得承认，部分个体与群体之间不存在行为一致的必然性，萨齐因是个案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060221
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060221,
					"content": "阻止了他的你也是。这种争斗本就是特殊的，可争斗本身不会只发生于现在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060222
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060222,
					"content": "你也说了，「部分个体」。你心里很清楚，不是每个人都会做出你那种选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060223
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060224
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060224,
					"content": "…就算如此，我也不会放弃我的观点。别想说服我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060225
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060225,
					"content": "无所谓。我们为这些事争论了很多年，不指望你能想明白，对错也早就不是话题的核心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060226
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060226,
					"content": "…谢谢你告诉我这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060227
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060227,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060228
					],
					"speakerTitle": "艾尔海森"
				},
				{
					"id": 401060228,
					"content": "我说，谢谢你告诉我这些。喂！别装作没听到的样子！你故意的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060229
					],
					"speakerTitle": "卡维"
				},
				{
					"id": 401060229,
					"content": "道谢应该拿出平时三倍的诚意吧，再说一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尔海森"
				}
			]
		}
	]
}