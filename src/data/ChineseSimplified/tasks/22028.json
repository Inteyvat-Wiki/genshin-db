			"dialogs": [
				{
					"id": 220280501,
					"content": "就是这里了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280502,
					"content": "我听人说，很久以前，有一位同心大叔向这个神龛供奉了许多纸鹤，许愿花见坂的大家都能平平安安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280503,
					"content": "后来这附近发生了一场火灾，有一栋屋子着了火，但那栋屋子本来就是偷工减料建的，一下子就被火烧完塌掉了，火势根本没来得及向外蔓延…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280504,
					"content": "大家都觉得，这是神明大人在保佑呢…嘿嘿，所以我还专门折了纸鹤带过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280505,
					"content": "先不说这些了！这一次，我们供奉什么比较好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280506,
					"content": "和同心大叔一样，供奉纸鹤的话，或许也能得到回应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280507,
					"content": "不过我觉得，这个神龛既然是在茶室附近，那供奉抹茶味的金平糖会不会更有诚意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280508,
					"content": "唔，而且我还挺喜欢吃抹茶味金平糖的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280509,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
