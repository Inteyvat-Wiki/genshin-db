			"trigger": {
				"objectNames": [
					"翔太"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你听我说！你听我说！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280102,
					"content": "上次供奉了神龛以后，我的愿望真的实现了…一小部分！虽然只有一部分…但这肯定是神明的回应吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280103,
					"content": "你许的是什么愿望？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "呃…我上次许的愿望是，希望神明让我看的那册漫画的作者再画快点，最好两天一更。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280105,
					"content": "然后，那个作者真的在一期里更新了两倍的量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280106,
					"content": "不过…据说接下来就要连续休刊三期了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280107,
					"content": "这实现愿望的方式还挺均衡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "唔…不管怎么说，神明应该是已经听见我的愿望了。之所以没有完全实现，肯定是因为我还供奉得不够！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280110,
					"content": "所以今天，我们就把其他地方的神龛也供奉了吧！这样神明大人肯定会完全实现我的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280111,
					"content": "我问过爸爸和妈妈了，这附近还有两个神龛，一个在木漏茶室附近，一个在出城的路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280112,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你觉得我们先去哪个神龛比较好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280108,
					"content": "感觉反倒是少更了一期啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
