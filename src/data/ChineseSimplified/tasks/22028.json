					"nextDialogs": [
						220280801
					]
				},
				{
					"id": 220280801,
					"content": "好！那我们就这么做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280802
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280802,
					"content": "真希望这一次，神明也会回应我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280803,
					"content": "明天我就来看看，有没有什么特别的迹象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280804,
					"content": "对了，谢谢你陪我到现在，这些东西给你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280805,
					"content": "希望神明大人真的能回应我的愿望…",
					"roleType": "TALK_ROLE_NPC",
