				"points": []
			},
			"dialogs": [
				{
					"id": 80120801,
					"content": "#…醒了，太好了，{NICKNAME}醒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120802,
					"content": "#可担心死我了…{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120803,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120804
					]
				},
				{
					"id": 80120804,
					"content": "你昏迷的时候，发生了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120805
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120805,
					"content": "我已经调查过附近的地脉了，似乎曾经受过深渊力量的影响，一直躁动不已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120806
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120806,
					"content": "地脉里毕竟流动着世间的信息与记忆，莫非你看到了什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120807,
						80120808
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120807,
					"content": "创立深渊教团的亚尔伯里奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120809
					]
				},
				{
					"id": 80120809,
					"content": "你是说克洛达尔·亚尔伯里奇么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120810
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120810,
					"content": "他创立深渊教团以后，为了自己对深渊的「信仰」而做了许多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120811
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120811,
					"content": "但最终不死诅咒同时折磨着他的肉体和精神，他信仰的深渊并没有拯救他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120812
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120812,
					"content": "在百年后，他完全变得疯疯癫癫，然后再也不知所踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120813
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120813,
					"content": "不过他也的确留下了很多麻烦，就比如之前你们遇到过的「污秽逆位神像」，甚至也是他当年利用深渊力量制造的神秘产物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120814,
						80120815
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120814,
					"content": "可是最终…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120816
					]
				},
				{
					"id": 80120816,
					"content": "#可以这么说吧，不然{M#她}{F#他}也就不会是深渊教团的{M#公主}{F#王子}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120817
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120817,
					"content": "#{NICKNAME}…你还好吗？看你的表情…到底发生什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120818,
					"content": "我有一个故事…要和你们讲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120819
					]
				},
				{
					"id": 80120819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120820
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120820,
					"content": "你的讲述令戴因斯雷布陷入了深深的思考…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120821
					]
				},
				{
					"id": 80120821,
					"content": "#以你的视角，看到了{M#她}{F#他}数百年前的记忆…简直不可思议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120822
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120822,
					"content": "果然「命运的织机」这个概念出现于那个时代…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120823
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120823,
					"content": "而且很有可能克洛达尔的儿子卡利贝尔当时的状态，还与之有所关联…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120824
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120824,
					"content": "#只是这段故事，你的血亲从未和我提起…所以其实那个时候，{M#她}{F#他}就已经下定决心要走这条路了么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120825,
						80120826
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120825,
					"content": "我也很想知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120827,
						80120828
					]
				},
				{
					"id": 80120827,
					"content": "但可以确定的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120829
					]
				},
				{
					"id": 80120829,
					"content": "是啊，那家伙一定独自思考了很久吧，可以说…这件事就是一切的「开端」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120830,
						80120831
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120830,
					"content": "对了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120832
					]
				},
				{
					"id": 80120832,
					"content": "什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120833
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120833,
					"content": "这片田地里埋了什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120834
					]
				},
				{
					"id": 80120834,
					"content": "田地？你怎么忽然关心这种事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120835,
					"content": "…是这里么？那就挖开来看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120836
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120836,
					"content": "花了一点时间，你和戴因确认了田地下埋藏的东西…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120837
					]
				},
				{
					"id": 80120837,
					"content": "…吓死我了，你们埋、埋回去了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120838,
					"content": "埋好了，睁眼吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120839
					]
				},
				{
					"id": 80120839,
					"content": "一具男性尸骨和一具女性尸骨被埋在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120840
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120840,
					"content": "有趣的是，这具男性尸骨埋葬时间明显晚于女性尸骨，男性尸骨手里还握着一条丝巾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120841
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120841,
					"content": "#这说明什么，{NICKNAME}，你怎么知道这下面埋着尸体的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120842,
						80120843
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120842,
					"content": "我想这具男性尸骨的身份…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120844
					]
				},
				{
					"id": 80120844,
					"content": "什么？这不可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120845
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120845,
					"content": "除非…克洛达尔·亚尔伯里奇最终摆脱了不死诅咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120846
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120846,
					"content": "或许吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120847
					]
				},
				{
					"id": 80120847,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120848
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120848,
					"content": "这一切太混乱了，我需要时间整理，也需要再努力从我的记忆中搜罗些东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120849
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120849,
					"content": "#就这么先分别吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120850
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120850,
					"content": "欸，你怎么又要走了，明明跟我们一起也可以呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120851
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120851,
					"content": "暂且还是分开行动为好，因为…「那家伙」说不定已经看见你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120852
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120852,
					"content": "「那家伙」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120853,
						80120854
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120853,
					"content": "难道你指的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120855
					]
				},
				{
					"id": 80120855,
					"content": "没错，我已经对他的身份有了猜测…这也是我需要串联线索来确认的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120856
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120856,
					"content": "如果时机成熟，下次见面我会告诉你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120857
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120857,
					"content": "#可是你说，「那家伙」说不定已经看到{NICKNAME}了，要怎么「看到」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120858,
						80120859
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120858,
					"content": "那毕竟是在回忆里的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120860
					]
				},
				{
					"id": 80120860,
					"content": "如果是他的话…这些恐怕都不是可以限制他的要素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120861
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120861,
					"content": "这…究竟是什么样的存在啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120862
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120862,
					"content": "「罪人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120863
					]
				},
				{
					"id": 80120863,
					"content": "#好了，就聊到这里吧，{NICKNAME}的精神也需要好好休息，再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120864
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120864,
					"content": "戴因那家伙又走了呢，这下又剩下我们两个啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120865
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120865,
					"content": "哦对了派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120866
					]
				},
				{
					"id": 80120866,
					"content": "嗯？怎么啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120867
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120867,
					"content": "我很想你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120868
					]
				},
				{
					"id": 80120868,
					"content": "啊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120859,
					"content": "而且是在数百年前…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120860
					]
				},
				{
					"id": 80120854,
					"content": "那时在我脑海中回荡的声音？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120855
					]
				},
				{
					"id": 80120843,
					"content": "就是克洛达尔·亚尔伯里奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120844
					]
				},
				{
					"id": 80120831,
					"content": "还有一件事我需要确认下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120832
					]
