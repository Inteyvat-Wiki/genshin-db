			"trigger": {
				"objectNames": [
					"巡林员",
					"巡林护卫",
					"巡林护卫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120401,
					"content": "巡林员…不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120402
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120402,
					"content": "喂，你们是什么人，怎么好像没见过你们，在这里干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120403
					],
					"speakerTitle": "巡林员"
				},
				{
					"id": 80120403,
					"content": "你们见到丘丘人了么？从这个方向过去的丘丘人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120404
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120404,
					"content": "先回答我的问题…不要自找麻烦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120405
					],
					"speakerTitle": "巡林员"
				},
				{
					"id": 80120405,
					"content": "我问你！有没有！见到丘丘人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120406
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120406,
					"content": "埃德…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120407
					]
				},
				{
					"id": 80120407,
					"content": "你…你干什么啊，有什么好激动的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120408
					],
					"speakerTitle": "巡林员"
				},
				{
					"id": 80120408,
					"content": "丘丘人不是随处可见吗？当然见到过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120409
					],
					"speakerTitle": "巡林员"
				},
				{
					"id": 80120409,
					"content": "是啊，就刚才，我们还在那边解决掉了几个，愣头愣脑的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120410
					],
					"speakerTitle": "巡林护卫"
				},
				{
					"id": 80120410,
					"content": "你们…你们…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120411
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120411,
					"content": "该死的巡林员，该死的七神子民！给我为卡利贝尔偿命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120412
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120412,
					"content": "你…！口出狂言的外国人，是在挑衅我们巡林员么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120501
					],
					"speakerTitle": "巡林员"
				},
				{
					"id": 80120501,
					"content": "你们这些巡林员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120502,
						80120503
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120502,
					"content": "适可而止，埃德！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120503,
					"content": "否则我会和巡林员一起制服你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120515,
					"content": "在你的规劝下，双方暂时冷静了下来…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120505
					]
				},
				{
					"id": 80120505,
					"content": "真搞不明白，我们不过是干掉了几个丘丘人，怎么就发这么大的火…不可理喻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120506
					],
					"speakerTitle": "巡林护卫"
				},
				{
					"id": 80120506,
					"content": "你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120507
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120507,
					"content": "他才刚刚恢复神智，怎么能就这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120508
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120508,
					"content": "巡林员…真的、真的都没留手么？对所有见到的丘丘人都下手了么…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120509
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120509,
					"content": "好吧，莫名其妙的家伙，非要问的话，我之前自己离队去…去上厕所的时候，刚好撞见一个丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120510
					],
					"speakerTitle": "巡林护卫"
				},
				{
					"id": 80120510,
					"content": "我一开始很紧张，但后来发现那个丘丘人没什么敌意，只是浑浑噩噩在往…往那个方向走了，我就没管它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120511
					],
					"speakerTitle": "巡林护卫"
				},
				{
					"id": 80120511,
					"content": "还有希望！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120512,
					"content": "很有可能是卡利贝尔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120513,
					"content": "是啊，太好了…太好了…走，我们快过去找他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120514
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120514,
					"content": "喂，就这么走了？你们也太目中无人了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巡林员"
				}
			]
		},
