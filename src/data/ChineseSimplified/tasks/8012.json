			"dialogs": [
				{
					"id": 80120701,
					"content": "…哈哈，没错，就是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120702
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120702,
					"content": "我终于弄明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120703
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120703,
					"content": "（我…刚刚昏过去了么，隐约记得卡利贝尔摘下了面具，然后…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120704
					]
				},
				{
					"id": 80120704,
					"content": "啊，你醒了，旅行者…我正想跟你分享这份喜悦呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120705
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120705,
					"content": "哦，不对…没必要叫你什么「旅行者」了，我早就认出你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120706,
						80120707
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120706,
					"content": "认出我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				},
				{
					"id": 80120708,
					"content": "呵呵…我原本就认识你啊，只不过是在聊天的过程中逐渐确认是你罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120709
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120709,
					"content": "可我之前并不认识你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120710
					]
				},
				{
					"id": 80120710,
					"content": "这很正常，你是那样高贵，怎么可能认识我们所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120711
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120711,
					"content": "而且…从一开始我就用了假名，埃德是我曾经的侍从的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120712
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120712,
					"content": "而我真正的名字是克洛达尔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120713
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120713,
					"content": "…克洛达尔·亚尔伯里奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120714,
						80120715
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120714,
					"content": "亚尔伯里奇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120716,
					"content": "所以你也看到了吧，那种力量…卡利贝尔身上的力量与你口中「罪人」的力量如出一辙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120717
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120717,
					"content": "而我现在非常确信…那种力量就是…「深渊」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120718
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120718,
					"content": "我终于见识到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120719,
						80120720
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120719,
					"content": "我什么也没看清…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120721,
					"content": "你少管！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120722
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120722,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120723
					]
				},
				{
					"id": 80120723,
					"content": "罪人…罪人…唯有罪人才能拯救罪人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120724
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120724,
					"content": "卡利贝尔的命运不该是这样，不过现在…太好了，他可以重新纺织自己的命运了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120725
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120725,
					"content": "在那极度的悲伤之中诞生，他将会成为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120726
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120726,
					"content": "…「命运的织机」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120727
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120727,
					"content": "（这个概念出现了…「命运的织机」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120728,
						80120729
					]
				},
				{
					"id": 80120728,
					"content": "那的确是深渊的东西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120730,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120731
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120731,
					"content": "危险…不祥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120732
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120732,
					"content": "没想到，你居然会这么说，居然在否定深渊…真是可笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120733
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120733,
					"content": "我们曾经都相信，你会带给坎瑞亚力量与希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120734
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120734,
					"content": "因为你就代表着深渊，代表了超乎想象、超越理解的神秘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120735
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120735,
					"content": "而坎瑞亚只要掌控了深渊，就能掌控一切！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120736
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120736,
					"content": "我们曾如此憧憬着那样的未来，如此凝望着你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120737
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120737,
					"content": "可你…究竟给我们带来了什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120738
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120738,
					"content": "#坎瑞亚的…{M#公主}{F#王子}大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120729,
					"content": "可深渊是危险而不祥的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120720,
					"content": "卡利贝尔到底怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120715,
					"content": "你是！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120707,
					"content": "埃德，你还好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				}
			]
		},
		{
			"id": 801208,
			"completionStepIds": [
