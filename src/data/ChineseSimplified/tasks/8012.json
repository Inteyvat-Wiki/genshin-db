					"埃德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120202,
					"content": "怎么回事，卡利贝尔呢！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120203,
						80120204
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120203,
					"content": "不在房间里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				},
				{
					"id": 80120205,
					"content": "不，卡利贝尔…难道有人来过了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120206
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120206,
					"content": "不对，门没被破坏，周围好像也没有任何其他人留下的痕迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120207,
						80120208
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120207,
					"content": "他自己跑出去了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120209,
					"content": "糟了，卡利贝尔现在的样子，万一遇上巡林员或者冒险家的话，岂不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120210,
						80120211
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120210,
					"content": "想办法先找到他吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120212,
					"content": "等等…这里好像被动过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120213
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120213,
					"content": "难道说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120214
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120215
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120215,
					"content": "镜子…碎掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120216
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120216,
					"content": "（镜子？那面镜子…不是早就碎掉了么？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120217
					]
				},
				{
					"id": 80120217,
					"content": "镜子碎掉了说明什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120218
					]
				},
				{
					"id": 80120218,
					"content": "他一定是摘掉了面具…看到了面具下自己的模样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120219
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120219,
					"content": "糟了，不听话的孩子…我们快去追他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120211,
					"content": "事不宜迟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120208,
					"content": "怎么这么突然…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120204,
					"content": "难道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				}
			]
		},
		{
