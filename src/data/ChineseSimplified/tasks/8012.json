			"dialogs": [
				{
					"id": 80120101,
					"content": "怎么回事，不对啊，这怎么可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120102,
						80120103
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120102,
					"content": "消失了…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				},
				{
					"id": 80120104,
					"content": "那些朝拜的丘丘人也不知道哪里去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120105
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120105,
					"content": "之前难道都是幻觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120106,
						80120107
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120106,
					"content": "不太可能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120108,
					"content": "的确…不可能是幻觉，那种伟大而神秘的力量还在我的头脑里、在我的身体里回荡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120109
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120109,
					"content": "不是幻觉，不是巧合，更不是梦境，而是确确实实存在的「神秘」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120110
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120110,
					"content": "…走吧，旅行者，「它」的消失一定存在着意义…我相信在未来一定还会遇到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120111,
						80120112
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120111,
					"content": "你真是执迷不悟啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120113,
					"content": "不是神明…而是「罪人」吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120112,
					"content": "先回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120107,
					"content": "总不能我们两个同时出现了幻觉吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120103,
					"content": "明明就是这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				}
			]
		},
		{
			"id": 801202,
