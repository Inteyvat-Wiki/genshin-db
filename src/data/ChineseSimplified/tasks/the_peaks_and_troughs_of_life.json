{
	"id": 74671,
	"type": "WQ",
	"name": "人生的波峰与波谷",
	"description": "枫丹科学院的研究员玛卡德尔似乎正在为什么而发愁…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
