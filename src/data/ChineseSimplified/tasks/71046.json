		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
