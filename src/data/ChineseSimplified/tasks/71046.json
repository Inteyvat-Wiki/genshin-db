				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"铁弘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "请留步！层岩巨渊禁地，外来旅客请…啊，是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460202,
					"content": "糟了，快跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710460203,
					"content": "派蒙，别闹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "哈哈哈哈…抱歉吓到你们了。救命恩人我怎么能不记得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460207,
					"content": "我也是最近才换防过来的…没想到正巧能在这里遇到恩人，真是好运气呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460208,
					"content": "恩人…？我们做过什么好事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710460209,
					"content": "哪里的话！大家对付海中大魔那时候，我也在群玉阁呀。受了点伤，前阵子才好利索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460210,
					"content": "可能你对我没什么印象，不过我可忘不了你。并肩作战的兄弟们都见证了你对璃月的付出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460211,
					"content": "关于层岩巨渊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "前两年矿洞里发生了不明原因的事故，被七星下令关停了。矿工也大多安然无恙地疏散了出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460213,
					"content": "只不过呀，可惜了，这么大的一座矿就这样停产了。工人们领了补贴就各做各的营生去了…唉，一朝人散了，再重聚就难了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460214,
					"content": "啊，抱歉扯远了。我相信你是有要事才会来这里，就不先拦着你了。有什么事请直接去找沐宁吧，他就在入口处的营地里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460215,
					"content": "呃…不是不信任，只是职责所系。我还是要叮嘱一句，可不要在这里做违法乱纪的事情哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "铁弘"
				},
				{
					"id": 710460216,
					"content": "放心吧，你还信不过我们吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710460204,
					"content": "你认得我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "被认出来了，快跑！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}