				"objectNames": [
					"元青"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "呜哇…是，是之前的那些人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210070602,
					"content": "孤木孑立，无林可依…哈哈，一个人，果然是什么都做不到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "元青"
				},
				{
					"id": 210070603,
					"content": "红叶萋萋，无风自离…如果我能相信大哥和老头子的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070604,
					"content": "红叶簌簌，乘风散去…宝贝，宝贝…为了宝贝，什么都没了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070605,
					"content": "盘木森森，荫蔽家庭…孩子们，我们都是一家人呐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "元鸿"
				},
				{
					"id": 210070606,
					"content": "你们都觉得，我把宝贝藏在了矿洞里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "元鸿"
				},
				{
					"id": 210070607,
					"content": "但是，我哪里有什么宝贝…你们还记得这棵树吗，这是你们小时候，我们全家一起栽的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "元鸿"
				},
				{
					"id": 210070608,
					"content": "我每年都会过来，在这里面埋点东西，希望你们长大之后，我们全家再一起去挖出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "元鸿"
				},
				{
					"id": 210070609,
					"content": "到时候，我们就用这里面的东西去买点好吃的，买点小酒，全家在一起，聊聊过去的小事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "元鸿"
				},
				{
					"id": 210070610,
					"content": "孩子们哪，孩子们哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元鸿"
				}
			]
		}
	]
