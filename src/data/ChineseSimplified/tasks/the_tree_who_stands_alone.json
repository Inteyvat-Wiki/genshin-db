				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "什么兄弟，大哥们只会把好东西自己先拿到手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070302,
					"content": "老头子也是一副老糊涂的样子，睁一只眼闭一只眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070303,
					"content": "他们应该还不知道，宝贝在矿洞里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070304,
					"content": "必须要快点去拿宝贝，然后就走…走得远远的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元成"
				}
			]
		},
