					"nextDialogs": [
						210070202
					],
					"speakerTitle": "元青"
				},
				{
					"id": 210070202,
					"content": "好不容易趁他们没反应过来，抢先跑过来矿洞里拿宝贝，怎么这么多怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
