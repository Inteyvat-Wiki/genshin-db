			"dialogs": [
				{
					"id": 210070501,
					"content": "走啦…都走啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "元鸿"
				},
				{
					"id": 210070502,
					"content": "元青，元良…还有元成，傻孩子们，你们再好好看看，再好好想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元鸿"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
