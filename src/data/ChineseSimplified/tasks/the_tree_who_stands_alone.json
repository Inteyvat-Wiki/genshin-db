			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "嘿嘿…这下宝贝都是我的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070402,
					"content": "大哥和小弟可真是傻子，抓了两句就跑，嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070403,
					"content": "什么祖训，有用的就一句，宝贝就在矿洞里，嘿嘿嘿，这下子宝贝全都是我的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元良"
				}
			]
		},
