			"dialogs": [
				{
					"id": 766740101,
					"content": "哇哦，没想到最后的成品这么出人意料。如果真的有人误入这里，应该会为魔女的力量赞叹不已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766740102,
					"content": "如果真的有人误入这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "这个嘛，要看对方是怎样的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766740105,
					"content": "引导很容易催生贪婪和懒惰。如果是像你们一样自食其力的人，我很愿意提供一些帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766740106,
					"content": "但是，如果是那些把全部希望都寄托在魔女的力量上，想要不劳而获的人…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766740107,
					"content": "难、难道说要把他们变成雕塑吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766740108,
					"content": "那倒不会，我会引导他们离开这里，去附近的秘闻馆，那个叫奈芙尔的女人应该比我更懂得如何跟他们打交道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766740109,
					"content": "想要不劳而获，不付出代价怎么行呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 766740103,
					"content": "你会引导他们实现愿望吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
	]
