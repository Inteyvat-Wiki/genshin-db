					"nextDialogs": [
						400340602
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340602,
					"content": "汪呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340603,
					"content": "这、这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340604,
					"content": "帽子狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "才不是啦！这算什么外号啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340609,
					"content": "不管怎么说，好像没有攻击我们的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340610,
					"content": "汪汪——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340611,
					"content": "呜哇，它跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340612,
					"content": "边跑边回头看我们，或许是让我们跟上去的意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340613,
					"content": "我们快跟上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "嗯，说不定真相就在前面…或许就如同珊瑚社长预料的那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340606,
					"content": "刀子狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "是帽子狗才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340608,
					"content": "黑影。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340609
					]
				}
			]
		},
		{
			"id": 4003409,
			"completionStepIds": [
				4003409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
