					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "嗯，你们果然来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340103,
					"content": "龙二的话，按照目前收集到的线索和我的推理，他已经去八酝岛调查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340104,
					"content": "我把方位标记在你的地图上，如果你赶紧动身，应该还可以和他会合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340105,
					"content": "怎么突然这么急急忙忙的，之前不还在侦探社等我们一起的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340106,
					"content": "因为已经接近尾声了。你们也快点动身，一同见证真相的浮现吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340107,
					"content": "#这么一说，我也有点迫不及待了。我们快走吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "龙二！我们来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340202,
					"content": "啊，是你们。珊瑚社长让我先过来调查，说你们晚点就会过来。果然如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340203,
					"content": "还多亏了她告诉我们，你在这里呢！龙二调查得怎么样啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340204,
					"content": "咦，这里怎么都是些关着小动物的笼子，没有人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340205,
					"content": "刚刚走开了，是盗宝团。珊瑚社长告诉我，他们打算偷狗来训练成「寻宝犬」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340206,
					"content": "就像盗宝鼬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "没错，就像盗宝鼬。只不过鼬因为太过调皮，不服管教，所以失败了。这次，他们就以更加忠心的「狗」为目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340210,
					"content": "以前处理过不少盗宝团的相关委托。这么一想，珊瑚社长说得果然没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340211,
					"content": "就像人有脚印，组织也会留下自己独有的痕迹。整个事件中，虽然有着其他迷失、被困的小动物，但痕迹最终还是指向了盗宝团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340212,
					"content": "参考了一下当时的解决办法，然后我就调查到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340213,
					"content": "不过居然不派个人留守，比起之前的案件，这次的作案者们心也太大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340214,
					"content": "#嗯，真是一群心大的坏家伙！不过嘛，{NICKNAME}，你打了这么多天架也累了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340215,
					"content": "所以趁他们不在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "没错，就这么办吧！嘿嘿，我们好默契哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340216,
					"content": "我们偷偷把它们给救出来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "就像派蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "派蒙"
				}
			]
		},
