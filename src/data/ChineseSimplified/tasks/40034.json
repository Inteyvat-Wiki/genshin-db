				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#呼，总算结束了。真是搞不懂，怎么突然就开始战斗了，明明影狼丸之前看起来还挺友好的，还好有{NICKNAME}在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340902,
					"content": "#咦，为什么影狼丸会跟着{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340903,
					"content": "汪呜汪呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340904,
					"content": "这叫声好像听起来有点高兴？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "你怎么听出来的！我还一头雾水呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340906,
					"content": "#如果我的猜想没错的话，影狼丸应该已经成为{NICKNAME}的忍犬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340907,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340908,
					"content": "欸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "关于忍犬的契约方法，我也只是略有耳闻罢了。据说忍者看中忍犬后，需要打败它，才能得到忍犬的认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340910,
					"content": "忍者渴望强大的伙伴，忍犬也是一样的，只有互相认可，才能完成契约。看来确实是这样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340911,
					"content": "#可是{NICKNAME}又不是忍者…而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340912,
					"content": "呜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340913,
					"content": "派蒙怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}，你先同意答应我一件事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340915,
					"content": "什么事情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "你先说答应嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340917,
					"content": "好吧，我答应你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "就算你现在已经契约了影狼丸，你也不能忘记派蒙是你最最最好的伙伴哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340919,
					"content": "嗯，派蒙是我最好的伙伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340921,
					"content": "比起猫和狗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "欸嘿嘿。我们永远都是最最最好的伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340924,
					"content": "咳咳，两位关系真好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340925,
					"content": "不过话又说回来，既然影狼丸实力那么强，为什么之前那个人还要留信下来，让别人照顾它呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340926,
					"content": "#这个我知道哦！{NICKNAME}，很强对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340927,
					"content": "确实实力超群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340928,
					"content": "#但是如果有一天，万一有什么意外，我不得不和{NICKNAME}分开，我也会很担心的。这和{NICKNAME}强不强，其实没什么关系啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340929,
					"content": "#呸呸，我在说什么不吉利的事情！总之只是打个比方！我和{NICKNAME}是最好的伙伴，我们是不会分开的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340930,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "派蒙的推理很合理。那么接下来唯一的问题是，为什么这只狗狗会偷走村民们的小动物，并守着呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340932,
					"content": "呃…唔…这个机智的派蒙也想不出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340933,
					"content": "#可惜，影狼丸也没办法说话，不然让{NICKNAME}去问问就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340934,
					"content": "我们去找找珊瑚吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "对哦，还有珊瑚！这个时候总该轮到头脑派出场了，我们去找她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400340936,
					"content": "嗯，我先去把藏起来的小动物还回去，我们到时候侦探社汇合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 400340922,
					"content": "还是派蒙更可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003410",
							"2"
						],
						"stepId": 4003410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "珊瑚社长，我们回来了，事情是这样子的……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400341002,
					"content": "原来如此。我大概知道为什么影狼丸会守着小动物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341003,
					"content": "是想要带着其他小动物变强吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341004,
					"content": "它小的时候很弱，然后又变强了，对吧。所以它就想通过训练，也带着别的小动物变强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341005,
					"content": "后来它看到愿意保护弱小的旅行者之后，又认可了旅行者作为主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341006,
					"content": "这也是出于它对弱小的同情心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341007,
					"content": "不过这只是我通过线索进行的推理罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341008,
					"content": "至于真实情况嘛，应该也八九不离十了。但由于影狼丸不会说话，我们也没办法得到一个肯定的回答了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341009,
					"content": "珊瑚说话也很有道理呢！不愧是头脑派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341010,
					"content": "汪汪汪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400341011,
					"content": "呜哇，你也是在肯定珊瑚说的话吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341012,
					"content": "不要以为奉承我，下次你们有委托的时候我就会打折哦。不过呢，这个案子算是办结了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341013,
					"content": "#感谢{NICKNAME}和派蒙，多亏了你们才能办结这个案子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400341014,
					"content": "哦，差点忘了，「四方之网」你们用着感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341015,
					"content": "挺好用的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "嗯，我记下来了。我会和我的那位朋友说的，谢啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341018,
					"content": "#不客气！以后有什么困难，随时来找我们哦！{NICKNAME}可厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341019,
					"content": "旅行者确实实力不俗，但是不用和我说这些客套话，毕竟感情是真相的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341016,
					"content": "总担心它会破掉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003411",
							"2"
						],
						"stepId": 4003411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影狼丸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "呼——终于追上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341102,
					"content": "嗯？它面前的是…一封信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400341103,
					"content": "我们先看看吧，这是目前唯一的线索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400341104,
					"content": "嗯！让我看看，里面写的是什么……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341105,
					"content": "「致有缘…」呃，太破了看不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341106,
					"content": "可能是「致有缘之人」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400341107,
					"content": "哦哦，然后是…「我们家是专门训练忍犬的世家，为忍者们带来了许许多多可靠的伙伴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341108,
					"content": "「……此番征兵令下来，怕是凶多吉少。我此生没什么遗憾，唯一放心不下的只有影狼丸。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341109,
					"content": "「小时候，它太弱了，所以忍者们来进行契约的时候，它被剩了下来。但是没关系，身为训练师，我不会放弃任何一只狗。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341110,
					"content": "「经过日复一日的努力，影狼丸真的变得越来越厉害了。只可惜，它完全不想和任何忍者契约。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341111,
					"content": "「虽然战争还未开始，但奉行所的催促越来越急，我已无暇顾及其他，现在到了不得不离开的时候了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341112,
					"content": "「只好留下这一封信，若是日后有人能找到这里，请代替我照顾一下影狼丸。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341113,
					"content": "「它脸上有一道疤痕，是年幼时留下的，气场也与其他普通狗狗不同，很好辨认。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341114,
					"content": "信里说的这只影狼丸应该就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341115
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400341115,
					"content": "带我们来的这只。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341116
					]
				},
				{
					"id": 400341116,
					"content": "确实很好辨认呢！信上还有行内容，我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400341117,
					"content": "「我知道这是不情之请，但也实在没有别的办法。还有，若是今后它愿意契约了，能带着自己中意的人来到这里的话，那么契约方法是…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341118
					],
					"speakerTitle": "派蒙"
