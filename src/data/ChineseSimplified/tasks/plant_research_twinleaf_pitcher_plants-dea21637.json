			"dialogs": [
				{
					"id": 762000801,
					"content": "笨猫——到底在哪里…欸？你找到它了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "玛尔佳"
				},
				{
					"id": 762000802,
					"content": "它被那边的双叶笼草困住了，虽然是植物，但却是食肉的掠食者呢，消化月萤虫也只需要几天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000803,
					"content": "幸好发现得早，它现在只是有点虚弱，要是再晚些就不好说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000804,
					"content": "居、居然这么危险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "朱卡"
				},
				{
					"id": 762000805,
					"content": "还不都怪它自己要往这儿钻，真是只笨猫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "玛尔佳"
				},
				{
					"id": 762000806,
					"content": "公平地说，这可不能怪它，是因为双叶笼草会散发一种特殊的气味，对人没什么影响，但昆虫之类的却会被吸引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000807,
					"content": "双叶笼草就是用这种方式捕食的。这一带的双叶笼草多得有点异常了，所以就连小动物也被影响了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000808,
					"content": "哦…哦，总之这草莫名其妙长这么多，肯定不是好事对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "玛尔佳"
				},
				{
					"id": 762000809,
					"content": "嗯，如果放任不管的话，可能会造成危害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000810,
					"content": "好，那除草就交给我们了。朱卡，你也来帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "玛尔佳"
				},
				{
					"id": 762000811,
					"content": "让那笨猫吃了这么久苦头的家伙，我们也得好好回敬一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "玛尔佳"
				},
				{
					"id": 762000812,
					"content": "和两个宝藏猎人一起清除掉了在这一带异常生长的双叶笼草…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "呼——总算结束了。我们也该回那夏镇了…小姑娘，多谢了，帮我们找到这只笨猫，要是没有你帮忙，它还不知道要被困多久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "玛尔佳"
				},
				{
					"id": 762000814,
					"content": "不过说起来，要不是刚才玛尔佳喊得那么大声，说不定我们早就找到它了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000815
					],
					"speakerTitle": "朱卡"
				},
				{
					"id": 762000815,
					"content": "要、要你多嘴！总之，它现在安全回来了不就行了吗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000816
					],
					"speakerTitle": "玛尔佳"
				},
				{
					"id": 762000816,
					"content": "（虽然她嘴上笨猫、笨猫地叫，其实还是很关心同伴的嘛。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000817
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000817,
					"content": "是呀，它现在平安无事才是最重要的。野外还是很危险的，你们也要多留意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000818,
					"content": "谢谢你，我们会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "朱卡"
				},
				{
					"id": 762000819,
					"content": "也祝你调查顺利。那就再见咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛尔佳"
				}
			]
