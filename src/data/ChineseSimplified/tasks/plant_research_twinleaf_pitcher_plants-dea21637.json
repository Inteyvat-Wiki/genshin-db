			"dialogs": [
				{
					"id": 762000501,
					"content": "露米，你也觉得它就在这儿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000502,
					"content": "呀吼吼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "露米"
				},
				{
					"id": 762000503,
					"content": "解救了被困的虎纹猫…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "他们要找的就是你吧，看起来没什么皮外伤，不过要是再晚点就不好说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "莉奈娅"
				},
				{
					"id": 762000505,
					"content": "总之，先去找你的伙伴吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉奈娅"
