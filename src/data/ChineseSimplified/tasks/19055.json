			"dialogs": [
				{
					"id": 190550901,
					"content": "轰大叔，货已经到了，请来清点一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190550902,
					"content": "嗯，走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "轰大叔"
				},
				{
					"id": 190550903,
					"content": "轰…唔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 190550904,
					"content": "嘘！别出声，我们偷偷跟上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鹿野院平藏"
				}
			]
		},
		{
			"id": 1905510,
			"completionStepIds": [
				1905504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
