			"trigger": {
				"objectNames": [
					"德田",
					"轰大叔",
					"将司"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "大叔的情报很准确啊，我们到的时候，那伙野伏众居然还在睡大觉，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190551002,
					"content": "被我们一网打尽，货物也全部收缴回来了，都在这了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190551003,
					"content": "我来清点…嗯…都没问题，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "轰大叔"
				},
				{
					"id": 190551004,
					"content": "哪里的话，多亏了轰大叔的商队去努力贸易，村里粮食的价格才能降下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "德田"
				},
				{
					"id": 190551005,
					"content": "就是就是，还有我们这些老伤号，谁会想到打仗留下的后遗症这么厉害啊，幸好有轰大叔带回来的救命药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "将司"
				},
				{
					"id": 190551006,
					"content": "要多谢上面的支持，所以情况才会变好。村里的库存情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "轰大叔"
				},
				{
					"id": 190551007,
					"content": "今晚就要确认，明天一早，我去珊瑚宫请示五郎大人后，就得出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "轰大叔"
				},
				{
					"id": 190551008,
					"content": "放心，轰大叔，我们把清单都整理好了，跟我们来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "将司"
				}
			]
		},
