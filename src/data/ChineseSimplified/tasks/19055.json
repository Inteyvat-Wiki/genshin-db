			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}，再次向你道歉，我没有对你说实话，真的很过意不去，但我…不得不这么做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551602,
					"content": "我理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "对了，心海知道这事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "珊瑚宫大人么…只能说，战争带来了很多糟糕的东西，也让我们成长了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551605,
					"content": "那到底是知道还是不知道啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 190551606,
					"content": "这…你们不好奇，是谁推动的新商品法案吗？不可能是勘定奉行，这对他们没有直接好处，我们也没有熟人在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551607,
					"content": "是哦，这样说起来，就好像是神明的援手一样，突然帮了你们一把。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 190551608,
					"content": "哈哈，神明吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551609,
					"content": "前一阵子鸣神岛那边举办了容彩祭，我和珊瑚宫大人也应邀前去参加了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 190551610,
					"content": "那时我在集市等待，而珊瑚宫大人去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				}
			]
		},
