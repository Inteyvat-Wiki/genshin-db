			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿鲁埃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "旅行者，你是来店里帮忙的吗？非常欢迎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130202,
					"content": "不是啦，我们只是想给一个朋友调一杯咖啡，他现在好像…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130203,
					"content": "他现在有点难过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "你们说的那个朋友。是坐在那边的艾尤恩吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130206,
					"content": "你认识他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "我和洛耶茨是老朋友了。他和我提起过，说他们办公室里来了一位聪明又勤恳的小伙子，就是艾尤恩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130208,
					"content": "不用担心他。刚刚去复律庭里工作的年轻人，总是会沮丧一段时间的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130209,
					"content": "等他们找到一个只属于自己的位置后，心情就会放松下来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130210,
					"content": "老板，你怎么这么有经验呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130211,
					"content": "因为我也曾经是复律庭里占着坑的一个萝卜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130212,
					"content": "但我不满意自己只做个萝卜，就离开了我的坑，然后…来开了这家咖啡厅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130213,
					"content": "听起来发生了很多事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "哈哈哈，也许吧。但现在我只不过是个咖啡厅的老板罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130216,
					"content": "好了，你们不是还要给艾尤恩做一杯咖啡吗？我去调试一下仪器，你们准备好了就来找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿鲁埃"
				},
				{
					"id": 240130214,
					"content": "总感觉里面有很多故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "他现在压力很大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
