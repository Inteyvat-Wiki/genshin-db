			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "唉，我真是想不通，为什么会这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130102,
					"content": "艾尤恩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "旅行者，真高兴见到你。你是来喝咖啡的吗？让我来请你一杯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130105,
					"content": "你怎么啦？看起来脸色好难看，是又被谁逼着熬夜了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130106,
					"content": "谢谢关心。这次是我自己的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130107,
					"content": "我最近正在思考…我工作的意义究竟是什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130108,
					"content": "我一直认为复律庭是一个公正，高效，人人都愿意互帮互助的强力机构。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130109,
					"content": "在复律庭的管理下，整个枫丹廷都会朝着更好的方向发展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130110,
					"content": "但现在看来，它就像是一个破破烂烂的机关屋子。齿轮，杠杆，旋臂乱七八糟地耷拉着…只有外壳却一直保持光鲜亮丽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130111,
					"content": "它之所以能运转起来，只是因为一系列的巧合与教训，而不是精密地思考和设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130112,
					"content": "我…我想做些什么，但根本无从下手。我怕只要做错了一件事，就会让这间机关屋子整个垮塌掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130113,
					"content": "虽然洛耶茨先生时常和我说，让我放宽心，就算我再怎么犯错，状况也不可能比现在更糟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130114,
					"content": "这，这算是安慰吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240130115,
					"content": "唉，抱歉，我不该和你抱怨这些。我今天之所以出来散心，主要原因也是想暂时逃避这些事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130116,
					"content": "我来给你调杯咖啡吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "真的？你会调咖啡吗？真是太厉害了，我之前也想学，但总是没时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130118,
					"content": "那就拜托你了，我会在这里等着的…希望工作别在咖啡厅里追上我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130103,
					"content": "今天你休息吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
