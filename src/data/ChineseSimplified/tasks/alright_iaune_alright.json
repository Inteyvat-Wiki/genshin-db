				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "旅行者，你…你还真给我调了杯咖啡吗？这怎么好意思，太麻烦你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130402,
					"content": "不用客气。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "…这咖啡！比复律庭里供应的那些咖啡好喝多了！不…不如说根本就不是一个层次的咖啡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130405,
					"content": "要是能天天喝到这种咖啡，我也不会每天下午都昏昏欲睡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130406,
					"content": "谢谢你的咖啡，喝完这杯之后，我又得去工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130407,
					"content": "要加油。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "那当然了。我必须得快点成长，早日成为洛耶茨先生那样能独当一面的人才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130410,
					"content": "唉，但在那之前，我还得做多少噩梦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240130408,
					"content": "打起精神来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "赶紧喝了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
