					"content": "听起来不错呢，那就开始调制吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240133102,
					"content": "开始调制咖啡…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "唔…闻起来就很香！快把这杯咖啡端给艾尤恩，让他打起精神来吧！",
					"roleType": "TALK_ROLE_NPC",
