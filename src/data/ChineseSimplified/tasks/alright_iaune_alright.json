		{
			"id": 2401304,
			"completionStepIds": [
				2401304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401304",
							"2"
						],
						"stepId": 2401304,
