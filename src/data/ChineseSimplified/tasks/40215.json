				]
			},
			"dialogs": [
				{
					"id": 766530401,
					"content": "总算来了，这么难得的外包机会，你总不会忘了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530402,
					"content": "再确认一下，你的订单是哪个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530403,
					"content": "…我是格乌登提，月矩力试验设计局的外派代表，这下你能想起来了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530404,
					"content": "好啰嗦…讲订单内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530405,
					"content": "你…我再说明一遍，最近有一批失控的侦察单元飞出了月矩力试验设计局，到处游荡，我的任务就是回收它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530406,
					"content": "可是这些侦察单元都飞得很高，我一个人处理很费劲，所以才向你提供这个外包机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530407,
					"content": "说是回收，其实就地销毁也可以，我们的目标是不让这些侦察单元落到外人手里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530408,
					"content": "哦，我想起这个订单了。那些侦察单元飞得很高，普通人根本够不到，但我掌握了一种人工搭建月灵旅路的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530409,
					"content": "#我记得{NICKNAME}能让月灵帮忙？那可以试试让它利用这种月灵旅路飞到天上去，把那些侦察单元通通打下来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530410,
					"content": "#嗯，交给{NICKNAME}肯定没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530411,
					"content": "小菜一碟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "对了，我不准备用摩拉支付，报酬的话，就用侦察单元的零部件抵扣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530414,
					"content": "这一点在发订单的时候就已经讲明了，你可不要变卦啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530415,
					"content": "用零部件抵账？你刚才说过不希望那些侦察单元落到外人手里吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530416,
					"content": "所以我才说这是个难得的外包机会嘛，凡事总有变通，看在你们辛苦的份上，我不介意睁一只眼闭一只眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "格乌登提"
				},
				{
					"id": 766530417,
					"content": "好怪啊，看上去更像是不愿意付钱吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530418,
					"content": "有没有摩拉无所谓啦，那些侦察单元的零部件很重要，我接下来的研发项目正好用得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "爱诺"
				},
				{
					"id": 766530419,
					"content": "好吧，既然爱诺这么说了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766530412,
					"content": "有些挑战性。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
}