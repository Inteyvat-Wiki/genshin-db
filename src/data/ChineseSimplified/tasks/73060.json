			"dialogs": [
				{
					"id": 730600401,
					"content": "梦景林莽…安静的曲子，水的声音，鸟扑棱翅膀的声音，踩在枝桠上的声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730600402,
					"content": "和那菈还有派蒙说话…派蒙好玩。但是可惜，派蒙不想变成种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "兰贡迪"
				},
				{
					"id": 730600403,
					"content": "因为派蒙不是兰那罗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730600404,
					"content": "梦景林莽已经没问题了，兰百梨迦在荼诃之座，但是不担心，谒颂幽境的「蕈兽」很多，兰那库拉，担心…",
