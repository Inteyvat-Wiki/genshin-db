			"dialogs": [
				{
					"id": 730600201,
					"content": "金色的那菈，好像什么也不怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "兰那库拉"
				},
				{
					"id": 730600202,
					"content": "金色的那菈是勇敢的那菈，就像那菈法留纳一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730600203,
					"content": "虽然担心在荼诃之座的兰百梨迦和在梦景林莽的兰贡迪，但是有金色的那菈帮助，一定不会有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730600204,
					"content": "#治好了法留纳神机，就不会有坏家伙到苗圃捣乱了，苗圃的花，想要送给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰那库拉"
				}
			]
		},
