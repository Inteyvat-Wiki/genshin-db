			"dialogs": [
				{
					"id": 730600301,
					"content": "兰百梨迦果然顺利，但是担心在谒颂幽境的兰那库拉和在梦景林莽的兰贡迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730600302,
					"content": "兰那库拉…坏蘑菇太多，万一兰那库拉又被坏蘑菇抓到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "兰般度"
				},
				{
					"id": 730600303,
					"content": "太多担心，没用。金色的那菈很强，打倒大大铁块，就像大风刮倒朽木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "兰百梨迦"
				},
				{
					"id": 730600304,
					"content": "只要治好法留纳神机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰般度"
