			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "没想到我们会被困在这个地方，这下可真是难办了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280602,
					"content": "就算我博学广闻，那也是在律法领域之内。我可不懂什么「越狱」的知识…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280603,
					"content": "亏我还和老爹定过「要快乐生活」的契约呢…唉，至少我不能消沉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280604,
					"content": "往好处想，能来新地方开开眼界，还能和旧友重逢，都是好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280605,
					"content": "嗯嗯…对，好事。嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烟绯"
				}
			]
		},
