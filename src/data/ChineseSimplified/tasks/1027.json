			"dialogs": [
				{
					"id": 10280801,
					"content": "不行，我要再去看一次。拿出我荒泷天下独尊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280802,
					"content": "老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280803,
					"content": "噫！干嘛那么严肃嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280804,
					"content": "烤堇瓜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280805,
					"content": "哈？发生了那么大的事情，你就叫我在这烤堇瓜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280806,
					"content": "哞！哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280807,
					"content": "听见没，阿丑都说你说得对…等等，阿丑你又是帮哪边的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280808,
					"content": "哞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280809,
					"content": "后勤是很重要的。保持充沛的体力和稳定的精神状态，才能应对未知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280810,
					"content": "阿丑也知道这个道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280811,
					"content": "好啊，你们一个两个的…这就已经吃上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280812,
					"content": "等等，已经熟了？香倒是挺香的…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280813,
					"content": "好吧，那就先垫垫肚子再想办法。别把堇瓜吃完了，也给我留两个啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒泷一斗"
				}
			]
		},
