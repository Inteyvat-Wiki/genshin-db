			},
			"dialogs": [
				{
					"id": 750680101,
					"content": "这些非人之物还真是难缠，非人的怪物。勇士啊…我是冒险团的夸恩因，我的职责…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680102
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680102,
					"content": "我的职责…就是清理这些怪物，对，我是冒险团里的战士，小心，勇士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680103
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680103,
					"content": "这些怪物，非常狡猾，会伪装成不同的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680104
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680104,
					"content": "每天夜里，在入睡之前都会听见…听见躲藏在这古老废墟里的它们的声音，所以才…无法在营地入睡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680105
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680105,
					"content": "这里全是这样的怪物。你们也…也要小心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因"
				}
			]
		},
