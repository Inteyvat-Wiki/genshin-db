					}
				]
			},
			"dialogs": [
				{
					"id": 750680401,
					"content": "你还在这里啊，勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680402
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680402,
					"content": "从前，有学者说，这座烬城之中，古老暴虐的城主有…阻止深渊侵蚀的办法，于是我们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680403
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680403,
					"content": "可是，这真是邪门的地方啊，勇士，我最近也觉得、觉得有点奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680404
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680404,
					"content": "有的时候，前一天还完整的路，一觉醒来，就变得破破烂烂的…那些石头屋子原本是那样吗，总觉得，应该更完整一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680405
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680405,
					"content": "但有的时候，醒来却能看到本来不应该再出现的朋友…那些是怪物吗？大概，是变成我朋友模样的怪物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680406
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680406,
					"content": "我要…我在这里担负的职责就是，清理掉那些怪物，但是为什么…为什么我要那么做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680407
					],
					"speakerTitle": "夸恩因"
				},
				{
					"id": 750680407,
					"content": "总之，这是奇怪的地方，你们还是…快点离开吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夸恩因"
				}
			]
		},
