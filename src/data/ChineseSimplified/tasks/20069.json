			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芙萝拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "这些花也变得没精神了，好可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "因为经常有人到店里来买单枝鲜花用来送人，所以我每天都会特别剪一些花备用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690104,
					"content": "但是那些剪下来的花保存不了多久，如果当天没卖完的话，就会枯萎很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690105,
					"content": "虽然我也尝试过很多方法，但一天之后，大部分花的品质也都没法看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690106,
					"content": "到底有什么方法能让花卉保存得久一些呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690107,
					"content": "用保存食材的方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "我是听「猎鹿人」的莎拉说，他们会把没用完的食材放在荫凉的地方，或者用冰块保存…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690109,
					"content": "我之前也尝试过这种方法。但不知道为什么，直接用冰块保存的话，花的颜色和外形都会变得很奇怪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690110,
					"content": "不能说是枯萎了…也不能说是鲜花，但总之是没法看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690114,
					"content": "我问了很多人，然后那位萨义德先生…你知道吗？就是那位学者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690115,
					"content": "他有一天来买花的时候告诉我，他曾经在一本书上看到一种「冷藏花卉」的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690116,
					"content": "具体来说…就是用一个容器装着花，然后再把这个容器放在冰块附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690117,
					"content": "他还说，如果想要实验的话，旁边雪山上的低温环境就很合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690118,
					"content": "但我听说雪山上很危险，一时半会也找不到愿意帮我的冒险家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690119,
					"content": "旅行者，你能帮我把这三盒鲜花埋到雪山上的雪里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690120,
					"content": "交给我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "谢谢你愿意帮忙，我想想…雪山我听说很大，也有很多不同的区域，保存的效果应该也不一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690123,
					"content": "唔，还是对比一下效果比较好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690124,
					"content": "请你帮我把这些花分别放在雪山上的<color=#00E1FFFF>七天神像旁边</color>、<color=#00E1FFFF>山里的水边</color>，还有…<color=#00E1FFFF>洞窟的入口</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690121,
					"content": "要埋在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "当天卖完就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "这样当然最好啦，但每天总归会有那么一两枝没人买的花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "芙萝拉"
				},
				{
					"id": 200690113,
					"content": "虽然只有这么一两枝，但我也不想让它们就这样白白枯萎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "芙萝拉"
				}
			]
		},
