							2107.804,
							254.285,
							-402.662
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "好险！幸好有狼群的帮忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080302,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080303,
					"content": "它们也拖住了很多兽境猎犬…甚至，在帮我们驱赶敌人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080304,
					"content": "可是，这不是狼的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080305,
					"content": "嘿嘿，就像雷泽想要帮助「卢皮卡」，「卢皮卡」又怎么会让你陷入危险呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080306,
					"content": "也许它们向北风的王狼说，「哼哼，这不是『卢皮卡』的问题，这是世界的问题！」然后就跑过来帮忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080307,
					"content": "嗯，「卢皮卡」，就是，「卢皮卡」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080308,
					"content": "我是人类中的「卢皮卡」，我不用是狼，但是…只要是能够帮到「卢皮卡」，就是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080309,
					"content": "说得对，雷泽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080310,
					"content": "或许王狼会答应…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
