			"dialogs": [
				{
					"id": 100080101,
					"content": "雷泽——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080102,
					"content": "闻到了，熟悉的气味，原来是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080103,
					"content": "最近，还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080104,
					"content": "嘿嘿，一切都好，对了，雷泽，怎么王狼一见到我们就消失了，你们在讨论什么秘密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080105,
					"content": "要开始狩猎，我在说服…领主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080106,
					"content": "打猎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080107,
					"content": "#（对了，{NICKNAME}，难道这就是雷泽的「课题」吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080108,
					"content": "雷泽，难道是狼群又没有吃的东西，所以大家要开始打猎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080109,
					"content": "请给我捕兽夹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "不，不是…这次的打猎，不是为了填饱肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080112,
					"content": "而是为了，杀死敌人。漆黑的狼群，侵占的领土…发出奇怪的臭味，越来越浓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080113,
					"content": "要净化森林…狩猎敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080114,
					"content": "所以，王狼答应了吗，我还记得那个时候，王狼还说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080115,
					"content": "我想想，是怎么说的来着…咳咳，「雷泽，你不准参与讨伐。因为这是狼的问题。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080117,
					"content": "啊，我不是故意的…对不起，雷泽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080118,
					"content": "没关系，因为我和「卢皮卡」在一起，而且，师父告诉了我，和领主说话的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080119,
					"content": "丽莎说的…和领主说话的方法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080120,
					"content": "啊，我明白了，是说服王狼的办法吧，所以你刚才已经说服王狼了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080121,
					"content": "嗯，说话很累，可是，成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080122,
					"content": "居然能够说服那个顽固的大家伙，了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080123,
					"content": "漆黑的狼，是世界的敌人。师父说，这不是狼的问题，而是世界的问题…师父是对的，领主也承认了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080124,
					"content": "不过，因此，狼群不会参与，是「我」与「漆黑狼群」的战争…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080125,
					"content": "嘿嘿，那就让我们也一起帮忙吧！那些奇怪的兽境猎犬，我们也早就看不顺眼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080126,
					"content": "谢、谢谢…如果，有你们的帮助，一定能顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080127,
					"content": "不过，要怎么开始狩猎呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080128,
					"content": "我们要，像把猎物赶到陷阱，把漆黑狼群，赶到这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080129,
					"content": "领主会，困住他们，我们来…把它们解决掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080130,
					"content": "…准备好，跟我说一声，就开始，狩猎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 100080401,
					"content": "现在就出发吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "林猪长得够大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
