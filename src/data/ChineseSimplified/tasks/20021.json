			},
			"dialogs": [
				{
					"id": 200210101,
					"content": "为什么使用风之翼还要考飞行执照这种东西啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210102,
					"content": "哥，你考过飞行执照吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210103,
					"content": "我不用风之翼，从来没考过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "安东尼"
				},
				{
					"id": 200210104,
					"content": "你要考飞行执照？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "因为风之翼是冒险的必备道具嘛，所以我就想练习一下风之翼的使用方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210106,
					"content": "但我没想到…居然还有飞行执照这种东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210107,
					"content": "虽然我已经报名考试了…但一些知识点我还是没完全背熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210108,
					"content": "旅行者，我听安柏小姐说，你已经有飞行执照了，能请你辅导我一下吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210109,
					"content": "是安柏为你监考吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "那倒不是，我只是在报名的时候遇见了安柏小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210111,
					"content": "她为我介绍飞行执照考试情况的时候提到了你，她说你考得可好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210112,
					"content": "所以，我就想来请教一下你有关飞行执照考试的问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210115,
					"content": "那…我有三个问题想要问你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210116,
					"content": "唔…第一个问题是，在飞行时，最多可以同时几人共用一架风之翼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210113,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "太好了！那就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "安娜"
				}
			]
		},
