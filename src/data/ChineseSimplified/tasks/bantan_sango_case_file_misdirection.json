				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "旅行者，又见面了。上次多亏了你帮忙，社长已经确定了犯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350102,
					"content": "但想让那个犯人彻底伏法，需要再做一些准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350103,
					"content": "社长会处理其他的事，我们就继续上次的工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350104,
					"content": "还要继续找盗宝团麻烦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "没错。虽然那个犯人也许和我们要对付的那些盗宝团没关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350106,
					"content": "但那些盗宝团平日里也没有做什么好事，这次就让他们继续「帮」我们一把好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350112,
					"content": "具体的地点社长也已经给我标好了，就在城外不远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350113,
					"content": "城内的话…社长也已经私下里和天野和安藤先生交代过了，他们也会配合我们行动的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350114,
					"content": "而且…社长也已经承诺了他们，破获这桩案子的功劳，都归他们所有。他们一定会很乐意合作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350115,
					"content": "思考和计划就交给社长吧，我们继续去和那些盗宝团好好「交流」一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350116,
					"content": "我把地点也标在你的地图上了，我们这就出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350107,
					"content": "还要继续麻痹那家伙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "没错。我们还要继续让他以为，我们的目标还是盗宝团。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350109,
					"content": "这样，社长才能有更多的时间来完善计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350110,
					"content": "呵呵…反正那些盗宝团平日里也没有做什么好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350111,
					"content": "这次，就让他们继续「帮」我们一把好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "龙二"
				}
			]
		},
		{
			"id": 2203502,
