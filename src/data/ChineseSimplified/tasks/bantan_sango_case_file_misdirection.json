				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "嗯，这次的动静也够大了，天野和安藤先生会配合我们，让城里的那个盗贼察觉到这个消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350205,
					"content": "这还要折腾多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "很快了，只要社长做好准备，我们就可以去给这桩案子收尾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350207,
					"content": "这些报酬给你，旅行者，多谢你帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220350208,
					"content": "这是社长亲自指定的数目，应该是十分合适的，请收下吧，说不定之后还要麻烦你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				}
			]
		},
