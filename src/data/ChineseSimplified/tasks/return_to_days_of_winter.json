			},
			"dialogs": [
				{
					"id": 200290101,
					"content": "呼…总算能回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290102,
					"content": "你要回国了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "啊？是你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290104,
					"content": "没错，我最近才刚接到上头的命令，让我回至冬去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290105,
					"content": "说是什么…我被调去另外一个执行官大人手下，暂时不用在蒙德这边待命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290106,
					"content": "也不知道我到底被调去哪位执行官大人手下了，可千万别是「散兵」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290107,
					"content": "你大概什么时候离开？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "上头没说，只要我先把东西收拾好，到时候尽快出发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290109,
					"content": "哎呀，总算是能离开这破地方，不用天天吃修女的白眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290110,
					"content": "哦对了，旅行者，你看我们俩也合作了这么长时间了，你最后再帮我个忙呗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290111,
					"content": "和之前一样，你帮我忙，我付你报酬，绝对不让你白跑，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290112,
					"content": "你又要讲什么故事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "哈哈哈，我这里能告诉你的「愚人众故事」已经全部讲完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290115,
					"content": "这次你帮我忙，我绝对付你真金白银的报酬，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290116,
					"content": "除非，你想听我给莉莉讲的那些童话故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290117,
					"content": "你要我帮什么忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "嗯…其实我这次想请你帮的忙，也和莉莉有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290121,
					"content": "除了你之外，整个蒙德城里愿意听我这个「愚人众坏叔叔」说话的，估计也就只有莉莉这孩子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290122,
					"content": "我要是走了，估计以后也不可能有机会再回蒙德城了…我就想最后送点礼物给莉莉做留念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290123,
					"content": "但你也知道，我要是自己上街买东西，指不定要吃多少白眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290124,
					"content": "所以，这件事就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290125,
					"content": "你就去玛乔丽那边，帮我看看有什么适合送给小孩子的礼物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290118,
					"content": "你还在陪莉莉玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "我就是偶尔…偶尔陪她玩玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290113,
					"content": "你这里，愚人众的故事真是特别多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
		{
			"id": 2002902,
			"completionStepIds": [
				2002902
