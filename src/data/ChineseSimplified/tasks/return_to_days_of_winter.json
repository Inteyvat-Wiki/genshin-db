				"points": []
			},
			"dialogs": [
				{
					"id": 200290201,
					"content": "你好，有什么事吗？旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290202,
					"content": "关于适合送给小朋友的礼物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "送给小朋友的礼物…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290204,
					"content": "嗯…这么一说，我最近确实在试着做一些小玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290205,
					"content": "但做这些玩具的时候，需要用很多钩钩果来染色，但我手里的钩钩果都用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290206,
					"content": "虽然我已经拜托了舒特去野外采一些钩钩果，但他到现在也没有回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290207,
					"content": "旅行者，你能帮我去野外找找舒特吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290208,
					"content": "有了足够的钩钩果之后，我应该就可以把那些玩具做出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290209,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "舒特说，他要去<color=#00E1FFFF>奔狼领附近</color>采钩钩果，你可以去那边找找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290212,
					"content": "那就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200290210,
					"content": "舒特去哪里了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
