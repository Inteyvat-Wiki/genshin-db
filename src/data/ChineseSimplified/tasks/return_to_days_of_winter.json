			},
			"dialogs": [
				{
					"id": 200290401,
					"content": "你拿到礼物了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290402,
					"content": "你回去之后会做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "做什么？那…肯定是听上头的调遣呗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290404,
					"content": "唉，如果运气不好，说不定又要被丢到什么鬼地方呆着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290405,
					"content": "无论如何，别把我丢去稻妻就行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290406,
					"content": "你为什么突然被调走了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "还能是因为什么，当然是因为「女士」大人…那个…牺牲了呗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290408,
					"content": "哎呀，我这种级别的人，听上头的命令行事就行了，想那么多干啥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290409,
					"content": "莉莉去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "我听鲁道夫和她说，要带她去广场上玩，还是什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290411,
					"content": "哼，估计是不想让莉莉和我这个「愚人众坏叔叔」说话吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				},
				{
					"id": 200290412,
					"content": "再见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "嗯，礼物的事就拜托你了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维克多"
				}
			]
		},
