			"dialogs": [
				{
					"id": 750231201,
					"content": "你这个敌对角色怎么是没事前商量过的临时演员啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750231202,
					"content": "嘘！别吵，我们要开始拍摄了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231203
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231203,
					"content": "「不可原谅…安息吧，我的朋友们，哦哦…哦哦…看到倒下的部族{RUBY#[D]好兄弟们}民，真想流下泪水！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231204
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231204,
					"content": "「但是此时不是流泪的时刻，枯焦的{RUBY#[D]修洛特尔}使者近在眼前，今日我必将报仇血恨叽呀——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231205
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231205,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231206
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231206,
					"content": "无牙也无齿的猛兽，脸色就像遥远国度的名产堇瓜一般冷静沉着！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231207
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231207,
					"content": "那是一张怎样的脸，是一张即使吞下「火山级辣度塔塔可」也不会有丝毫变化的残忍面孔，真是可怕至极——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231208
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231208,
					"content": "「这一次，这一次，一定要让你后悔到死呀！」说着，尾巴上系着红丝巾的巨兽使用了锻炼千百遍的「大炖肉火焰」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231209
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231209,
					"content": "好了，就是这个时候！把雷史莱姆引到木桶边，击碎那个木桶吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231210
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750231210,
					"content": "在这个时候击碎木桶？木桶就是什么「大炖肉火焰」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750231211,
					"content": "总觉得有点奇怪，但是…好吧，我们试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
