			},
			"dialogs": [
				{
					"id": 750230201,
					"content": "#{NICKNAME}，快看快看！这里又有留影机又有布景，会不会是映影的拍摄场地？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230202,
					"content": "#不过这里的布景…这些房子都好小喔！显得{NICKNAME}都像是巨人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230203,
					"content": "唔…呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230204,
						750230207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230204,
					"content": "渺小的人类…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230205
					]
				},
				{
					"id": 750230207,
					"content": "给派蒙住应该不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230208
					]
				},
				{
					"id": 750230205,
					"content": "呀呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230206,
					"content": "哼哼，这下我们就是名副其实的「大人物」了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230208,
					"content": "什么嘛，我才不要住那么小的房子，手脚都伸展不开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230239,
					"content": "一个纳塔人十分自然地加入了对话…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230209
					]
				},
				{
					"id": 750230209,
					"content": "哦！几位也对映影感兴趣吗？那请务必助我阿卡坦加一臂之力，让全新的流行席卷纳塔的土地吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230210
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230210,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230211,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}怎么这么高兴，你附和他做什么呀？你也喜欢映影吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230212,
					"content": "呀呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230213,
					"content": "小家伙，眼光真不错！实话说，这里的一切都是为了让一只小嵴锋龙成为明日之星而准备的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230214
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230214,
					"content": "可惜那只小嵴锋龙被我朋友带走了。我们因为创作理念不和大吵一架，之后她就带着我最重要的演员一去不回，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230215
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230215,
					"content": "真不该和朋友合作。项目失败了，朋友也没了。我输两次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230216
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230216,
					"content": "但是没关系，现在又有一只小嵴锋龙来到我的面前，看这跃跃欲试的样子，一准能成功、爆红！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230217
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230217,
					"content": "怎么样？几位要是能协助我完成这部跨时代的作品，我一定重重酬谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230218,
						750230219
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230218,
					"content": "#既然{REALNAME[ID(2)|SHOWHOST(true)]}喜欢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230221
					]
				},
				{
					"id": 750230219,
					"content": "百分之百成功听起来像什么骗术。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230220
					]
				},
				{
					"id": 750230220,
					"content": "就算不能一炮而红，协助拍摄的酬劳总归是会支付的，你们也不会亏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230221
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230221,
					"content": "帮忙是可以啦，不过我们还不知道你要拍的映影是什么内容呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230222,
					"content": "我设想的内容是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230223
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230223,
					"content": "嗡——嘭、嘭嘭、嘭。炫目的白光消失，圆润但有刺的来客抵达了部族。滋滋、滋滋，它在草地上停留了片刻，就能闻到焦枯的气味。「噫！希泊巴的使者！」部族的人们露出恐怖的表情，嘭、嘭嘭、嘭，「它过来了！连牙也没有的邪恶生物！要把部族啃噬殆尽！」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230224
					]
				},
				{
					"id": 750230224,
					"content": "#正当邪恶的暴徒将要跃入部族防卫阵地的时候！哐——哐——尾巴上系着红丝巾的救星突然现身。「怎么会在这里？」比黑曜石更坚固的双爪，无论怎样的土石都能轻易击碎，「但对手的柔韧程度更甚无赖的脸皮，{REALNAME[ID(2)|SHOWHOST(true)]}的胜算…」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230225
					]
				},
				{
					"id": 750230225,
					"content": "「呀——！」与其说是怒吼，更像是尖啸，没牙的邪恶生物也噗噜噜地震动。冲天的火光之后是隆隆的巨响，和比浸泡在液态燃素里更热的热浪！连牙也没有的邪恶生物四散而去，「好烫！好烫！」余波席卷了幸免于难的部族。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230226
					]
				},
				{
					"id": 750230226,
					"content": "而尾巴上系着红丝巾的救星不知何时已经无声息地离开，就像没有人知道它怎样到来…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750230227,
					"content": "如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230228
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230228,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230229,
						750230231
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230229,
					"content": "我就想看这样的作品，太棒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230230
					]
				},
				{
					"id": 750230231,
					"content": "风格很独特，有点难消化。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230232
					]
				},
				{
					"id": 750230230,
					"content": "我就知道！会有人喜欢这样的风格！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230232,
					"content": "这个嘛…我之前听外边来的人说，「差异化竞争」也是一条不错的路子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230233,
					"content": "#呃，我是不太懂啦，不过只要{REALNAME[ID(2)|SHOWHOST(true)]}喜欢就好吧。那我们具体应该做些什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230234,
					"content": "很简单的。首先是放置演出道具，<color=#00E1FFFF>把木桶和元素诱饵放到合适的位置</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230235
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230235,
					"content": "木桶是杀手锏，最好在<color=#00E1FFFF>画面中间</color>，但是不能遮挡主角和房屋布景。元素诱饵放在<color=#00E1FFFF>敌对角色入场的方向</color>会比较合适吧，也就是侧边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230236
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230236,
					"content": "#演员都到场了就需要动起来了。{REALNAME[ID(2)|SHOWHOST(true)]}，尾巴上系着红丝巾的救星登场！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230237
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230237,
					"content": "等到剧情需要时，两位<color=#00E1FFFF>将敌对角色引导到木桶附近</color>，之后迅速离开，在安全位置<color=#00E1FFFF>击碎木桶</color>，就大功告成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230238
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230238,
					"content": "我已经等不及看成片的效果了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿卡坦加"
				}
			]
		},
