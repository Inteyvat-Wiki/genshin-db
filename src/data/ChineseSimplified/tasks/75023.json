				},
				{
					"id": 750230724,
					"content": "导演，我们的奖金呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "留影机的操作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "就算是我也觉得太危险了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
