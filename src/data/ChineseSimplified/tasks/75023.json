			"dialogs": [
				{
					"id": 750230301,
					"content": "怎么了，需要我重复一遍步骤吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230302,
					"content": "再讲一遍让我听听。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "先是放置演出道具，木桶放在<color=#00E1FFFF>画面中心但不遮挡主角和布景的位置</color>，元素诱饵放在<color=#00E1FFFF>敌方角色入场的方向</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230304,
					"content": "之后，等到需要的时候，<color=#00E1FFFF>引导敌对角色到木桶附近</color>，再退到安全位置<color=#00E1FFFF>击碎木桶</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230305,
					"content": "不用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "那就万事拜托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿卡坦加"
				}
