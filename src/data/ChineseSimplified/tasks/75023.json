			"dialogs": [
				{
					"id": 750230701,
					"content": "呀！呀呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "好啦好啦，别这么着急嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230703,
					"content": "说实话刚才我也替小家伙捏了一把汗呢，为了追求真实感，炸药的量也准备得比较充分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230704,
					"content": "区区爆炸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "唔呀呀呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "总之，有了这次的经验，之后就知道如何改善了。谢谢几位的协助，我们这就来看看成片的效果吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230709,
					"content": "出人意料的是，画面中既没有尾巴系着红丝巾的救星，也没有发出滋滋声的邪恶敌人，更没有惊心动魄的爆炸场景，有的只是阿卡坦加不断变换的表情…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "我成主角了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230711,
					"content": "恭喜啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "这不对吧！难道是留影机…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230714,
					"content": "说起来这的确是我第一次正式使用留影机…难不成是给弄反了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230715,
					"content": "你说得倒是轻松，那我们刚才的辛苦不是都白费了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230716,
					"content": "呜…呜呜…呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#明明{REALNAME[ID(2)|SHOWHOST(true)]}也很期待的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230718,
					"content": "抱歉抱歉，全都是我的错！这样，刚才就当是彩排，这次才是正式的，我一定拿出十二万分的干劲，拍出最精彩的映影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230719,
					"content": "呜…呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "兴致很高的样子呢，那就当你是愿意的好啦。但愿这次别再出什么岔子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230721,
					"content": "于是按之前的流程又走了一遍，总算是得到了想要的结果…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "了不起！完美！只能说是超出预期了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230723,
					"content": "这点小事轻车熟路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "除了原本约定的报酬，这张画片送给你们留作纪念吧，唉，怎么说也算得上是我的得意之作呢，当然，也多亏了几位的协助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "阿卡坦加"
				},
				{
					"id": 750230726,
					"content": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}威风凛凛的样子，确实很不错呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750230727,
					"content": "呀！呀呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}也很满意，那就结果好一切都好咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
