			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700201,
					"content": "咦？那不是琴团长吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700202,
					"content": "她好像在和什么人说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700203,
					"content": "等她们说完，过去打个招呼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700204,
					"content": "…所以，我们的态度就是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700205,
					"content": "若无法立刻剿灭作乱的魔龙，不如将蒙德的城防移交给「愚人众」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700206,
					"content": "蒙德的龙灾是可以处理的，只要让我们把那头野兽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700207,
					"content": "「野兽」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700208,
					"content": "嗯？代理团长大人的意思是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700209,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700210,
					"content": "希望贵国的外交官能拿出更职业的态度来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700211,
					"content": "你们想「处理」蒙德的四风守护之一？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700212,
					"content": "我不希望有人在西风骑士面前说这种疯话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700213,
					"content": "呵…呵呵呵…也没你说的那么疯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700214,
					"content": "很好，今天的磋商到此为止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700215,
					"content": "这次的成果就是「双方坦诚地交换了建设性的意见」，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700216,
					"content": "我会…如实记录的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "安娜斯塔西娅"
				},
				{
					"id": 3700217,
					"content": "#啊，{NICKNAME}，你回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700218,
					"content": "十分感谢你的协助，城市周围的元素循环终于安定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700219,
					"content": "风魔龙上次袭击的余波，算是暂时告一段落了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700220,
					"content": "不过，使团那边施加的压力，也已经大到了很难无视的地步……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700221,
					"content": "使团？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700222,
					"content": "是外交使团吗…来自璃月港吗？还是稻妻城？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700223,
					"content": "是至冬国，在七神中信奉冰神的国家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700224,
					"content": "他们的使者有个特殊的名字：愚人众——听说过么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700225,
					"content": "啊，原来是「愚人众」。确实有听过！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700226,
					"content": "不过，是那种不太好的名声呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700227,
					"content": "我不认为直接杀死风魔龙是正确的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700228,
					"content": "而且，冰之神统率的「愚人众」，觊觎着风神眷属的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700229,
					"content": "这件事本身就已经非常可疑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700230,
					"content": "说到「力量」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#怎么了，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700232,
					"content": "有件东西想让骑士团看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "嗯？好，那我们就回骑士团总部吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700234,
					"content": "不要在…这种地方，谈论重要的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
		},
		{
			"id": 37005,
			"completionStepIds": [
				37005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37005",
							"2"
						],
						"stepId": 37005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "是蕴含着某种力量的结晶…但，丽莎，你能分析它的构成吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700402,
					"content": "嗯，我来看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700403,
					"content": "可以发现结晶内部有些污秽杂质，不过更进一步的研究就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700404,
					"content": "很抱歉，现在还得不出有用的结论。给我一点时间，我去禁书区找些资料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700405,
					"content": "那么丽莎，之后的研究调查就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700406,
					"content": "嗯，如果有什么进展，我会通知大家的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700407,
					"content": "不过嘛，不要太期待上古的文献能有什么帮助。而且——咿啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700408,
					"content": "呜…好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700409,
					"content": "结晶里的那种污秽杂质，稍稍靠近，就会让我感到刺痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700410,
					"content": "是了，原来是这样啊…是与「神之眼」的互斥呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700411,
					"content": "那种污秽的力量，会和我们体内的元素之力相互排斥，纠缠相杀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700413,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#不过，真是奇怪。{NICKNAME}明明也能使用元素之力，却不受影响呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700415,
					"content": "小可爱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "行，就这样办。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "总之，这枚结晶还是让小可爱保管吧。放在我们手里也只是徒增疼痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3700417,
					"content": "…真是不可思议的现象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700418,
					"content": "你对这一切——对自己身上这些特殊的地方，有什么头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700420,
					"content": "我想也是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700421,
					"content": "#那么，{NICKNAME}。这是骑士团第二次的不情之请：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700422,
					"content": "请接受西风骑士团荣誉骑士的爵位…与代理团长的谢意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700424,
					"content": "西风的…荣誉骑士？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3700426,
					"content": "也请你再次帮助我们，寻找这些谜团的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700427,
					"content": "魔龙的狂乱，与怪异的结晶…我想，这背后的答案一定关系着蒙德的和平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700428,
					"content": "愿风擦拭你的双眼，让你看清真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3700429,
					"content": "如果有什么最新发现，我们就在这里再会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 4820221,
					"content": "按照我给你<color=#00E1FFFF>标记好的路线</color>，一路平稳地飞到终点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "安柏"
				}
			]
		}
	]
}