					"狗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950101,
					"content": "要给它留点什么好吃的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950102,
					"content": "（期待地看着你们。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "狗"
				}
			]
		},
		{
			"id": 7329504,
			"completionStepIds": [
				7329504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329504",
							"2"
						],
						"stepId": 7329504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950401,
					"content": "你还好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950402,
					"content": "我…我…唉…多谢两位搭救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950403
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950403,
					"content": "昨晚做了个好梦，梦里卡特皮拉站在朝圣之路的终点冲我招手，记得梦里我想，真怪呀，朝圣之路怎么会是洞窟接着洞窟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950404
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950404,
					"content": "可是卡特皮拉分明就站在长长狭路的尽头，于是我赶忙朝他的方向跑去，结果不等我抵达，就被狗叫给吵醒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950405
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950405,
					"content": "且不论狗叫的部分…我想这肯定是好兆头啊，今天一定能有所收获，于是带着写生的道具出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950406
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950406,
					"content": "结果…结果在迷宫里好像无头飞萤，还被丘丘人给缠上…最后不仅没逃脱，装着画稿的背包也在逃跑时掉落了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950407
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950407,
					"content": "今天也是丢三落四的一天呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950408
					]
				},
				{
					"id": 732950408,
					"content": "这能怪我吗？这一带简直比枫丹的下水道还难绕…对了，我听说须弥人都是住树上的，难道这里真的是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950409
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950409,
					"content": "妈呀！须弥人到底都排泄了些什么东西啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950410
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950410,
					"content": "应该不是你想的那样啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950411,
					"content": "唉…我的人生就是失败的连续，一步错步步错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950412
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950412,
					"content": "今早为什么要离开安全的地方呢？虽说梦见了好兆头，可那毕竟只是一个梦，我怎么就当真了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950413
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950413,
					"content": "昨天为什么不诚实一点告诉你们我的难处呢？要是早让你们带路，又怎么会落得今天的下场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950414
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950414,
					"content": "当初为什么要离开枫丹呢？就算不离开枫丹，日子也没到完全过不下去的地步…反而离开之后一件好事也没发生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950415
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950415,
					"content": "你、你先不要泄气嘛，适合采风的地方，我们可以带你去的！不过现在应该先把丢失的东西找回来吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950416,
					"content": "唔…虽然不知道能不能全都完整地找回来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950417,
					"content": "哈哈，可能已经被丘丘人捡走当厕纸了吧，反正…反正也不是什么值钱的东西，呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950418
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950418,
					"content": "诚实一点吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950419
					]
				},
				{
					"id": 732950419,
					"content": "对啊，就算不是能卖出很多价钱的东西，对于连本人来说也是很珍贵的吧？我们会尽量帮你找找的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950420,
					"content": "…话说回来，「胡椒」呢？它没和你在一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950421,
					"content": "哼，没良心的东西…它老早就跑掉了，现在应该躲在什么安全的地方悠闲自得吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950422
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950422,
					"content": "真不敢相信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950423,
					"content": "唔…要不你先回营地休息一下，处理一下伤口吧！我们找到丢失的东西之后回营地找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950424,
					"content": "谢谢两位…好朋友，人生在世就得靠朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于连"
				}
			]
		},
		{
			"id": 7329506,
			"completionStepIds": [
				7329506
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329506",
							"2"
						],
						"stepId": 7329506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"狗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950601,
					"content": "欸？这不是「胡椒」嘛！它好像看守着什么呢…等等，这情景有点熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950602,
					"content": "（似乎认出了你们，摇起了尾巴。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950603
					],
					"speakerTitle": "狗"
				},
				{
					"id": 732950603,
					"content": "唔…难道它是在看守于连的画稿吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950604,
					"content": "「胡椒」短吠了两声，很快离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732950605
					]
				},
				{
					"id": 732950605,
					"content": "它又走掉了呢，上次也是这样…话说回来，丘丘人把画稿捡回来干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950606,
						732950608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950606,
					"content": "可能也有装饰的需求吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950607
					]
				},
				{
					"id": 732950607,
					"content": "唔…真的是这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950608,
					"content": "难道真的是当厕纸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950609
					]
				},
				{
					"id": 732950609,
					"content": "#噫——{NICKNAME}怎么会有这么脏的想象！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7329508,
			"completionStepIds": [
				7329508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329508",
							"2"
						],
						"stepId": 7329508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950801,
					"content": "它果然已经回来了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950802,
					"content": "喂，于连！我们找到画稿带回来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950803,
					"content": "哦哦！感谢两位好朋友…为了这种不值钱的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950804
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950804,
					"content": "别这么说，你不是枫丹知名画家嘛，知名画家的手稿肯定也是很值钱的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950805,
					"content": "呃，是…或许是吧，我其实不太关注这方面，毕竟真正的艺术应该是无价的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950806
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950806,
					"content": "不愧是知名画家，每句话都感觉很有艺术感很有哲理呢！说起来，我们找到画稿的时候，「胡椒」也在旁边守着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950807,
					"content": "和之前一样。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950808
					]
				},
				{
					"id": 732950808,
					"content": "嗯！我觉得，它肯定还是很关心你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950809,
					"content": "你们是说，不顾我喂养它这么久却带我走进歧途，还留我独自面对丘丘人的家伙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950810
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950810,
					"content": "唔…它、它可能也有它的考虑吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950811,
					"content": "对了，于连虽然嘴上这么说，其实心里还是很喜欢它的吧？不然也不会用特别的留影机给它拍画片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950812,
					"content": "画片？什么画片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950813
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950813,
					"content": "就是夹在画稿里的那一张狗的画片呀，和它一模一样！色彩看起来很独特呢，应该是用枫丹的什么特别的留影机拍摄的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950814,
					"content": "啊…那个其实是我画的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950815
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950815,
					"content": "欸？知、知名画家果然很厉害呢！不仅画得像，配色也…也很艺术！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950817
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950817,
					"content": "（难道是我夸得不对吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950818,
						732950819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950818,
					"content": "（别问我，我也不懂。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				},
				{
					"id": 732950820,
					"content": "我也不想画这样的东西…我只是…我只是想当个一流的画家，你们说，这件事真的这样难办吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950821
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950821,
					"content": "唉…对不起，我不该对两位好朋友说谎。一旦说出第一个谎言，之后就需要更多谎言…我已经…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950822
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950822,
					"content": "其实我只是个半吊子，无法像其他人一样「正确地」分辨颜色，但是又不想放弃成为画家的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950823
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950823,
					"content": "所以借助了一个…朋友的力量，得到了画什么像什么的能力，但还是没办法辨别色彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950824
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950824,
					"content": "等等，你说「得到了画什么像什么的能力」…这是不经过训练就能获得的能力吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950825,
					"content": "是啊，我这个朋友他比较神通广大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950826
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950826,
					"content": "真的吗？我不信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950827
					]
				},
				{
					"id": 732950827,
					"content": "应该说，现在的我已经没办法画得不像了，这或许就是能力的代价吧。说起来的确有些离谱，不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950828
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950828,
					"content": "于连当即摹写了一份冒险家的经验交给你。\\n你将摹写的副本与原本两相比较，并未发现任何不同。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950848
					]
				},
				{
					"id": 732950848,
					"content": "唯一的区别或许是，副本读完之后有种脑袋空空的奇妙感觉…\\n就像是读了，但完全没读。只有时间白白被浪费，却没能获得任何经验…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950849
					]
				},
				{
					"id": 732950849,
					"content": "唔…看着和原版没什么区别…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950829,
					"content": "哈哈，那当然，虽然没当上知名画家，制作赝品我可是一把好手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950830
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950830,
					"content": "可那不是违法的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950831
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950831,
					"content": "…是啊，所以我在服过刑之后决定做点正经营生，这次一定要当一个堂堂正正的画家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950832
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950832,
					"content": "可是这画什么像什么的能力…如果不是卡特皮拉赋予我的，我一定会把它称作诅咒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950833
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950833,
					"content": "现在的我就像是坏掉的留影机，只能产出颜色错乱的「画片」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950834
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950834,
					"content": "原本以为循着纯水精灵的朝圣之路就能找到解药…让我也能像常人一样分辨色彩，让我像无垢的孩童一样充满创造力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950835,
						732950837
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950835,
					"content": "卡特皮拉到底是谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950836
					]
				},
				{
					"id": 732950836,
					"content": "是朋友…可靠的朋友，是他告诉我循着纯水精灵的朝圣之路就能在须弥找到治愈一切伤痛，让人重获新生的灵药…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950839,
					"content": "…听起来好可疑的感觉！你这个朋友是个什么朋友呀…你该不会是被骗了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950840,
					"content": "他见多识广怎么会骗我。一定是我自己的问题吧，就像之前说的，我的人生就是失败的连续…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950841
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950841,
					"content": "我想灵药恐怕是被安放在重重保护之下，像我这样的俗人终究是无法企及的，我已经…认清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950842
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950842,
					"content": "其实狗也一定不想陪我来须弥吧，不然也不会一路给我使绊子找气受。要是当初让它留在枫丹就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950843
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950843,
					"content": "唔…我是觉得它肯定还是想和你在一起的，而且它肯定很喜欢你的画…所以不要这么快就放弃嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950844
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950844,
					"content": "非常暖心的安慰…但我已经不抱希望了。两位好朋友，难得你们帮了我几次，我却提供不了什么像样的报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950845
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950845,
					"content": "等我休息一阵恢复得差不多了就准备返回枫丹了。虽然是很厚脸皮的请求…到时可以麻烦两位将我带到主路上吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950846
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950846,
					"content": "唉…要是能更早放弃…或者没有死要面子…说不定现在已经走在正确的路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950847
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950847,
					"content": "只是带路的话当然没问题，既然你已经决定了…那就先好好休息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950850
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950850,
					"content": "嗯，谢谢你们，好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于连"
				},
				{
					"id": 732950837,
					"content": "朝圣之路是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950838
					]
				},
				{
					"id": 732950838,
					"content": "卡特皮拉告诉我这是纯水精灵们历经的道路，在朝圣之路的尽头也就是须弥，能找到治愈一切伤痛，让人重获新生的灵药…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950819,
					"content": "（是超越派蒙理解的艺术呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				}
			]
		},
		{
			"id": 7329509,
