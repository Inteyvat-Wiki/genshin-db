				{
					"id": 732951201,
					"content": "啊，两位好朋友，丢失的画稿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732951202
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732951202,
					"content": "还没呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732951203
					]
				},
				{
					"id": 732951203,
					"content": "没关系，反正…反正不是什么值钱的东西…",
					"roleType": "TALK_ROLE_NPC",
