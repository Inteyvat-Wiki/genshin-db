			"dialogs": [
				{
					"id": 732950901,
					"content": "朝圣之路…怎么会跟丢了痕迹呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950902
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732950902,
					"content": "…朝圣之路？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732950903,
					"content": "啊，没什么，呃，只是一种…一种比喻的说法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于连"
				}
			]
