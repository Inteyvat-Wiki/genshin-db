			},
			"dialogs": [
				{
					"id": 722020101,
					"content": "雷鸟大人…抛弃了我吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020102,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "雷鸟大人…请您不要动怒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020105,
					"content": "我会尽我之力，阅读您的旨意，阅读您的教谕…但是…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020106,
					"content": "但是…为什么您在拒绝我…为什么…呜呜…呜呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020107,
					"content": "为什么…我无法深入您的迷雾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020108,
					"content": "阅读…你在说什么呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "您留下的雷石…我会再想办法的…银璨璨的船来了，我的时间不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020110,
					"content": "雷石…那是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "逢岳之野的雷石…只有操使雷电的人才能够让它们活起来…只有在迷雾中寻觅通路的人，才能找到它们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020112,
					"content": "如雷鸟伫立…如雷鸟展翼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "知世"
				},
				{
					"id": 722020113,
					"content": "迷雾…不是已经消散了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
