			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "旅行者，你来得正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400310102,
					"content": "这个熟悉的开头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310103,
					"content": "下一句肯定是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "不愧是熟练的冒险家呢。如你所说，有适合你的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400310106,
					"content": "万端珊瑚侦探社那边需要人手，指明希望你能帮忙调查「小动物大量失踪奇案」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400310107,
					"content": "欸？只是找小动物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310108,
					"content": "#哼哼，这么简单的事情，还需要{NICKNAME}出马吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310109,
					"content": "没关系，我也送过外卖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "而且，「万端珊瑚」不应该是解决案件的侦探社吗？怎么反而委托冒险家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310114,
					"content": "是这样的，珊瑚小姐需要一名经验丰富的冒险家，与龙二先生一同外出行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400310115,
					"content": "另外，我看看…珊瑚小姐拜托我这么说：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400310116,
					"content": "「有很多人的宠物都在这次事件中失踪了，所以敝社一口气接到了很多委托。如果能解决，能收到非常丰厚的报酬。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400310117,
					"content": "#非常丰厚…！嗯嗯，这样啊，{NICKNAME}，我觉得…不能回到主人身边的小动物很可怜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310118,
					"content": "而且委托无论大小，都是能让人成长进步的好事，对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310119,
					"content": "派蒙真好懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "总之，我们去找珊瑚他们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310110,
					"content": "没关系，我也修过车…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "没关系，我也击败过风魔龙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "击败风魔龙算是「简单的事情」吗…？真不愧是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "凯瑟琳"
				},
				{
					"id": 400310104,
					"content": "有新的委托喔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚",
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "不错，你们来得比我预想中还要快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310203,
					"content": "那是当然！我们一听到有丰厚的报…报告小动物失踪的案件，就马上赶来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310204,
					"content": "#说吧，怎么回事？只要有我和{NICKNAME}在，不管是什么难题，都会顺利解决的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310205,
					"content": "工作的可是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "派蒙也会努力给你加油的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310207,
					"content": "很有精神。那么，事情是这样的。最近突然出现了许多委托，请我们寻找走失的小动物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310208,
					"content": "这些小动物大多是一些家养的宠物，原本不会自己乱跑才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310209,
					"content": "虽然稻妻确实有一些怪力乱神的故事，但万事皆有其因果，不存在逻辑无法解开的谜团。这几天我们的现场调查也证明了这一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310210,
					"content": "工作的可是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400310211,
					"content": "派蒙也会努力给你加油的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310213,
					"content": "…谢谢，不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400310214,
					"content": "这几天，我循着动物失踪的痕迹，找到了几个野外的营地。有一些是由魔物驻守的，倒没有太大问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400310215,
					"content": "但是，在其中一个营地里，想要放走被困的小动物时…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400310216,
					"content": "…但却「被一团突然出现的黑影给解决了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310217,
					"content": "等我醒来时，营地里已经什么都没有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400310218,
					"content": "真是难看哪，龙二哟。在「三本刀金八」事件中，你像传说中的恶鬼虎千代一样，咆哮着打倒犯人的气势到哪去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310219,
					"content": "还抱着装死的我，大喊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310220,
					"content": "社长，停一停！停！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 400310221,
					"content": "后、后来呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310222,
					"content": "先解决手头的事件吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "总之，我们「万端珊瑚」需要你们这样经验老到的冒险家，一起去拯救小动物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310228,
					"content": "有你们在的话，就算龙二被打晕，多少也有个照应呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310229,
					"content": "那珊瑚你自己为什么不去试试看呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310230,
					"content": "我吗？我是头脑派，最重要的是动脑子。对我来说，身体只是一个附件而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310231,
					"content": "（呜哇，她懒得好理直气壮。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310232,
					"content": "当然也不会让你们白打工的，说好的报酬是不会少的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310233,
					"content": "报酬！！那我们现在就出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310234,
					"content": "这个派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "等等。走之前，带上这个吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310237,
					"content": "咦？这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310238,
					"content": "<color=#00E1FFFF>「四方之网」</color>，是我请友人依照书中记载的「惟神阴阳术」制作的方便道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310239,
					"content": "虽然力量不足以降伏罪犯，但只要瞄得准，小动物还是可以轻松捕获的，大概。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "珊瑚"
				},
				{
