			"dialogs": [
				{
					"id": 400315101,
					"content": "#有什么事吗，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315102,
						400315107,
						400315110
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315102,
					"content": "关于「四方之网」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "这个啊…原本是打算给龙二用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315104,
					"content": "毕竟，我们的工作也不是完全没有危险。龙二几次受伤，所以就想请人做一个「可以远远地制服犯人」的便利道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315105,
					"content": "当时，我还看了很多古籍，设计这张网子，再委托友人制作的。但到最后，成品也只有控制小动物程度的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315106,
					"content": "无论如何，能在你手中发挥力量就最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315107,
					"content": "关于「三本刀金八」事件…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "对那个事件很感兴趣吗？是这样的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315109,
					"content": "…转念一想，龙二似乎很抗拒讨论当时的事情。还是算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315110,
					"content": "我先出发了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315111
					]
				},
				{
					"id": 400315111,
					"content": "嗯。慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
