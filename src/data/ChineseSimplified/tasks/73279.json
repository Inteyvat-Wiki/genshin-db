				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "啊，我的小猎鹰回来了！谢谢你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790702,
					"content": "抱歉…我遭到了伏击，多亏他们相救，我才能回来见您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790703,
					"content": "「他们」…？是我们尊贵的「镇灵主人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790704,
					"content": "对不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790705,
					"content": "没关系，没关系啦！塔德菈受伤了，你也对她好些嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790706,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790707,
					"content": "…你受伤了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790708,
					"content": "…对不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790709,
					"content": "是什么动物把你搞成这样的？是人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790710,
					"content": "是北方人，我遭到了北方人的伏击…他们发现自己被跟踪了，就设下埋伏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790711,
					"content": "设下埋伏的应该是你才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790712,
					"content": "被猎物反咬成这个样子，对猎鹰来说，像什么样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790713,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790714,
					"content": "…去休息吧，你需要休息。稍后我会为你疗伤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790715,
					"content": "塔德菈只是默默点点头，忍着疼痛缓步离开了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "马塞拉对塔德菈有点苛刻呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790717,
					"content": "你们之间关系…不好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "嗯？不，怎么会呢！她是我最爱的「猎鹰」…我爱她，但不溺爱她。猎鹰没有给你带回猎物的话，怎么能喂饱它呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790719,
					"content": "原来是这样…哼，那女孩不会有好结果的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790723,
					"content": "这些报酬请您一定收下，感谢您，尊贵的「镇灵主人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790724,
					"content": "咳咳，你是不是忘了什么？这里还有两个人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790725,
					"content": "嘿嘿，其中一个也不算「人」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790726,
					"content": "哦…我忘了，这个小精灵不是人。不过我们也应该得到感谢吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790727,
					"content": "喂——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790728,
					"content": "哈哈，抱歉、抱歉，请您收下额外的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790729,
					"content": "还有额外的报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790730,
					"content": "…仍是不多，不过既然我的大人没什么意见，那就这样吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790731,
					"content": "很好，啊…希望有时间的话，您能再来一趟…我想，我的「猎鹰」仍然需要您的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790720,
					"content": "请不要太苛待塔德菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "苛待？不，我太纵容她了，她的本领退步了…我只是在教育她而已，她是个优秀的「猎鹰」，我怎会忍心伤害她呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790722,
					"content": "那么猎鹰的结局，往往是什么样呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "利露帕尔"
				}
			]
		}
	]
