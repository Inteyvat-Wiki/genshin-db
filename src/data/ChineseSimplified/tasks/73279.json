			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"马塞拉",
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#啊，{NICKNAME}，尊贵的「镇灵主人」，大驾光临，令我受宠若惊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790102,
					"content": "好呀，又是一个沙漠奴才。我的大人…唉，算了，您有您自己的判断，我相信您就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790103,
					"content": "不知您是否有闲暇赏光…我如同企盼明月和雨露一般，企望您的到来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790104,
					"content": "无事献殷勤，必不怀好意，你不如说得明白些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790105,
					"content": "很好，镇灵大人…我的确有事相求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790106,
					"content": "哈哈，没什么大事…是我的猎鹰，塔德菈…她应该是遇险了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790107,
					"content": "唉…如果不是因为我的腿脚不行，也就不用麻烦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790108,
					"content": "我明白了，所以我们要去救她，然后你会谢谢我们，给我们好多摩拉，我们再去大吃一顿庆祝胜利！对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790109,
					"content": "呃…是的，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790110,
					"content": "如果是这样的话，就交给我们好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790111,
					"content": "每到这种时候，逻辑就格外清晰呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "唉…那就这样吧，为了这贪婪的小家伙能大吃一顿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790113,
					"content": "万分感谢…那么这件事就拜托给您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790114,
					"content": "啊…她最后出现的地点，在这里，请让我为您标出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790115,
					"content": "你们要找的人，塔德菈…她的个子很高，肤色黝黑，留着浅色的长发，手持长弓…嗯，这些信息应该够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790116,
					"content": "怎么样，你们记住了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790117,
					"content": "嗯…高个子，深色皮肤的女孩子，浅色长发，还拿着长弓！嘿嘿，我记性很好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790118,
					"content": "嗯…愿流风引导您穿越黄沙，避开重重险阻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790119,
					"content": "好，我们走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7327902,
			"completionStepIds": [],
