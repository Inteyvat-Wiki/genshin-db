					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"塔德菈",
					"利露帕尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790602,
					"content": "那个…你就是塔德菈吗？我们是来救你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790603,
					"content": "嗯…？嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790604,
					"content": "你把他们放走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790605,
					"content": "那些人构不成威胁了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "…他们会回去，告诉其他人。这样他们都会知道我们在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790608,
					"content": "你看，智者所见略同。我喜欢这女孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790609,
					"content": "那些不要紧啦！他们再来，我们就再把他们打跑！不过你受伤了…需要我们帮忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790610,
					"content": "我还好，还能走，还能找个地方自己死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790611,
					"content": "哦…那还好啦，她还能找个地方——喂，一点也不好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790612,
					"content": "我开玩笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790613,
					"content": "哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790614,
					"content": "我喜欢这女孩的幽默感…若有似无的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790615,
					"content": "谢谢你们，我们回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790616,
					"content": "你的腿脚方便吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "不方便，但也不需要搀扶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790618,
					"content": "不休息一下吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "休息…？不，我们还没那么熟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790620,
					"content": "但我觉得我们可以认识一下，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790621,
					"content": "谢谢，以后吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔德菈"
				},
				{
					"id": 732790606,
					"content": "没必要赶尽杀绝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
