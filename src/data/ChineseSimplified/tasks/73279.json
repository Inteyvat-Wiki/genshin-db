			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"利露帕尔",
					"愚人众先遣队员甲",
					"愚人众先遣队员乙",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "嘘…！你看…有人在那边…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790402,
					"content": "哦…我的大人，这些人…就是此前你们曾反复提及的「蠢人众」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790403,
					"content": "是「愚人众」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "有区别吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790405,
					"content": "你小声一点啦！万一被发现了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790406,
					"content": "没关系的，他们听不到我说话。不信你们看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790407,
					"content": "喂！大胖子！我在这边！开饭了，开饭了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790408,
					"content": "嗯…？你听到什么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "愚人众先遣队员甲"
				},
				{
					"id": 732790409,
					"content": "没有，怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "愚人众先遣队员乙"
				},
				{
					"id": 732790410,
					"content": "唔…我还以为开饭了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "愚人众先遣队员甲"
				},
				{
					"id": 732790411,
					"content": "哼哼，看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790412,
					"content": "利露帕尔也会玩这种小孩子把戏呀…嘿嘿，总觉得有点可爱呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790413,
					"content": "你看…那边！他们关押的那个是不是塔德菈呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790414,
					"content": "唔我记得她…个子很高，肤色黝黑，留着浅色的长发…应该就是她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732790415,
					"content": "记性不错嘛，小家伙。我们动手吧，我的大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "利露帕尔"
				},
				{
					"id": 732790416,
					"content": "#好，{NICKNAME}，我们动手吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7327906,
