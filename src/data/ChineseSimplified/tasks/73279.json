			"dialogs": [
				{
					"id": 732790201,
					"content": "怎么，你们找到她了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790202,
					"content": "啊，还需要时间，是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "马塞拉"
				},
				{
					"id": 732790203,
					"content": "那么还要劳烦你们尽快救出塔德菈…时间不等人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马塞拉"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
