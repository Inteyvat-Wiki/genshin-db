			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "咦，刚才七天神像是不是突然很夸张地亮了一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680102,
					"content": "好奇怪，以前发生过这样的事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680103,
					"content": "七天神像发光很正常吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}，没有觉得不舒服吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680108,
					"content": "吔，水、水在对我说话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "最好是能说啦！还有心情开玩笑，看来没什么问题嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680112,
					"content": "不过，确实在那阵光亮起来之后，周围的空气也变得稍微湿乎乎了一些，说不定也是刚才冒出的水元素力的功劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680113,
					"content": "哼哼，听说在枫丹，如果能运用好元素力，就能够在水下畅游，说不定还能捡到掉在水里的宝藏呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680114,
					"content": "打捞宝藏的工作，就交给你了，我…我就负责在岸上为你放风！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680115,
					"content": "一个人下水，好寂寞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "呜，但是、但是水里很可怕嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680118,
					"content": "说不定一个不小心，就会被卷入水流里，晕头转向，怎么都飞不起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680119,
					"content": "就像在蒙德遇到你之前那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680120,
					"content": "那我再把你钓上来好啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "…真的吗，那、那也不是不可以和你一起到水里去。哼，你可得说话算话哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680116,
					"content": "可以出点力了派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "哇！感觉可以用鳃呼吸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "好啊，你先长个鳃出来看看吧。哼，看起来精神不错嘛，害我白担心了一小会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746680105,
					"content": "好像冒出了水？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "不愧是水神的国度呢，连七天神像都会冒出水来…才怪啦，刚才那个光亮怎么想都不是正常反应。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}