					"id": 10280495,
					"content": "你记不记得，魈也在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "魈…对哦！你是不是想叫他来帮忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280497,
					"content": "我认为可以一试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "好，试试看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280499,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "魈，能听见吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280502,
					"content": "……",
