			"trigger": {
				"objectNames": [
					"烟绯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "嗯？不对，怎么搞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280402,
					"content": "我们…我们怎么回来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280403,
					"content": "这里是我们走过的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280404,
					"content": "对，是起点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280405,
					"content": "可我们没走错啊，刚才一路走的都是通往出口的路，没有往回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280406,
					"content": "我也记得是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280407,
					"content": "旅行者，你也确定没错对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280408,
					"content": "嗯，我觉得没有走错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280410,
					"content": "在稻妻有种说法，商人晚上走夜路中了狸妖的奸计，整晚都在同一个地方绕个不停，直到天亮还走不出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280411,
					"content": "不就是鬼打墙嘛，我也知道哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280412,
					"content": "原来大家都知道，那就好办了，我现在认为，我们就是遇到了这种怪事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280413,
					"content": "不过没关系，我有个帮手能驱邪，遇到这种情况，就该叫他出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280414,
					"content": "一斗这个鬼，身边竟然有驱邪的伙伴…他心可真大啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280415,
					"content": "迟钝是老大过得好的资本嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280416,
					"content": "来吧，阿丑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280417,
					"content": "哞——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280418,
					"content": "这就是咱们荒泷派编外成员，阿丑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280419,
					"content": "哞哞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280420,
					"content": "哦，阿丑在向大家问好呢。你们叫他阿丑也行，丑哥也行。阿丑可擅长找路了，一会儿就让他带我们走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280421,
					"content": "原来还有编外成员…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280422,
					"content": "我觉得不像靠谱的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280423,
					"content": "谁知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280424,
					"content": "阿丑，去！给兄弟们找条明路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280425,
					"content": "哞——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280426,
					"content": "阿丑开始在四周寻找是否有隐藏的出口…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "哞…哞哞…哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280428,
					"content": "嗯？噢噢…啊？！不会吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280429,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280430,
					"content": "阿丑说，他沿路找遍了，根本没有出口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280431,
					"content": "可我们既然能进来，没理由出不去啊。不行…我去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280432,
					"content": "你们注意到了吗？起初我们以为自己是从上空掉下来的，那时头上还有高不见顶的出口…现在出口也消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280433,
					"content": "怎么会这样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280434,
					"content": "看来，地下这些建筑不是我们想的那么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280435,
					"content": "…我四处检查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280436,
					"content": "这里四处都是岩壁，会不会…会不会是我们记错了，其实我们根本不是从这里掉下来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280437,
					"content": "喂，你是在害怕吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280438,
					"content": "我、我可没有那么胆小！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280439,
					"content": "哞——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280440,
					"content": "阿丑也觉得你害怕了。没关系，害怕就说出来，我们保护你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280441,
					"content": "派蒙，有我在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#愣着也不是办法，再找找路吧。阿忍，你陪着恩人，我带{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280443,
					"content": "好，大家都要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280444,
					"content": "恩人什么的，言重了，叫烟绯就行。一斗先生不愧是帮派老大，很有领导力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280445,
					"content": "哪里哪里，你叫我一斗就行。既然说好都是同伴，就该彼此照顾。派蒙，怕的话本大爷可以捂住你的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280446,
					"content": "众人兵分几路，检查了四周的环境，但并无收获…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "…唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280448,
					"content": "真的没有出口…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280449,
					"content": "哞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "阿丑"
				},
				{
					"id": 10280450,
					"content": "我觉得，这地方有问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280451,
					"content": "老大，你们那里怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280452,
					"content": "没有收获。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "而且就在刚才，我余光好像瞥到几个人影…别是真闹鬼了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280454,
					"content": "虽然现在气氛很不对劲，但我还是要说，一斗，你自己不就是鬼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280455,
					"content": "不是啦！我是说那种，那种忽闪忽闪，一会儿有一会儿没的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280456,
					"content": "嗯？一斗，其实…你怕鬼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280457,
					"content": "啊呀。被人家看出来了呢，老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280458,
					"content": "我、我哪有！你们不许乱说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "荒泷一斗"
				},
				{
					"id": 10280459,
					"content": "嘻嘻，看你这样我忽然不怕了…喂放牛的，要是害怕的话，我可以捂着你的眼睛哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10280460,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280461,
					"content": "看来，我得找点别的事做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280462,
					"content": "（嗯？阿忍走到一旁，似乎找了几块石头，又从口袋拿出树枝和堇瓜…嗯嗯？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "放点盐…胡椒也来一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280464,
					"content": "请问你是在烤堇瓜吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "对。烤堇瓜很好吃，一会儿你也尝尝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280466,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "唔…有甜咸两种，你喜欢哪种？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280468,
					"content": "都可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "嗯，那就都试试好了。越是现在这种场合，越要稳定精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280470,
					"content": "如果我没猜错的话，这里可能藏着不方便让我和老大知道的秘密。不过别担心，我会注意不让老大打扰你们讨论机密的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280471,
					"content": "哇，居然在烤东西吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280472,
					"content": "烟绯小姐要来一点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280473,
					"content": "我不饿，你们先吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280474,
					"content": "说起来，跟阿忍也是好久没见了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280475,
					"content": "是啊。上回见面还是我在璃月念书的时候了，你来替我的老师代了一节课。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280476,
					"content": "代课…啊，想起来了，是有一年的冬天对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280477,
					"content": "对，大家都说你讲课很有趣。这么说来…应该叫你一声师姐才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280478,
					"content": "嗯嗯，这个叫法真不错，我喜欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280479,
					"content": "没想到会跟师妹一起遇到这种意外，也算是缘分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280480,
					"content": "烟绯还会讲课，真厉害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "而且风格诙谐幽默，寓教于乐，很受学生欢迎哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280482,
					"content": "哈哈哈，师妹真是过奖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280483,
					"content": "几位，都在啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280484,
					"content": "夜兰，我们分头找过了，这附近没有出口。你呢？有什么收获吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280485,
					"content": "没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280486,
					"content": "而且…虽然我不想这么说，但还是做好心理准备吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280487,
					"content": "如果一直找不到路，我们也许会在地下待一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280488,
					"content": "…我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "烟绯"
				},
				{
					"id": 10280489,
					"content": "…明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280490,
					"content": "但世上不应存在只能进不能出的地下空间，这不合理…我会继续想办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280491,
					"content": "各位假如找到疑似出口的地方，也千万记得在保证安全的前提下进行探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "夜兰"
				},
				{
					"id": 10280492,
					"content": "（说起来，魈也在这里。还记得他提过，如果遇到棘手的情况，可以呼唤他的名字。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "（…嗯，或许是个办法。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "喂喂，看你神情严肃，是要做什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "派蒙"
				},
