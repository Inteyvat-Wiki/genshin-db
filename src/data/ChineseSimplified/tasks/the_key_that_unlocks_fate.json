			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丘丘人"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "欸，有个丘丘人在这里呢，是在休息吗？看起来好像没什么攻击性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160202,
					"content": "为什么躲在这里呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160203,
					"content": "啊，你把它吵醒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160204,
					"content": "嗯？跑掉了…我们在纳塔的名号，已经对丘丘人都这么有威慑力了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160205,
					"content": "好像有东西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "你说那个亮晶晶的？刚刚它逃跑的时候从身上掉出来的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160207,
					"content": "唔…我猜是它自以为捡到了什么宝贝，准备在这里藏起来吧，没想到这么快就被我们给发现了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160208,
					"content": "我看看我看看，虽然感觉以丘丘人的智慧，应该不是什么好东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160209,
					"content": "……！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#啊？怎么了，{NICKNAME}，怎么你的表情这么严肃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160211,
					"content": "这不就是一把普通的钥匙吗，不过样式确实有点稀奇，不像是纳塔的风格…嗯…会是哪个国家造的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160212,
					"content": "这是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "飞船休眠仓？什么飞船，什么休眠仓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160215,
					"content": "等等！飞船休眠仓？难、难道说！是你来到提瓦特乘坐的那个飞船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160216,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "怎么会突然出现在这里！你确定不是你刚才自己掉的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160218,
					"content": "我的在这里…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "哦~看上去一模一样…那么这把不是你的，难道说它应该属于…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160221,
					"content": "一共就只有这两把。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "果然如此…唔，这个时候我才真切地感受到你是个「外星人」…哦不，「降临者」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160224,
					"content": "那么这个情况，让我推断一下，逻辑应该是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160225,
					"content": "#丘丘人之所以能在附近捡到这把钥匙并且藏起来，是因为你{M#妹妹}{F#哥哥}在这附近弄丢了它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160226,
					"content": "#也就说明你的{M#妹妹}{F#哥哥}最近曾在这一带活动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160227,
					"content": "也就是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#是啊…没想到原本只是随口答应帮伊安珊巡逻，结果有了这么重大的发现，甚至还得到了你{M#妹妹}{F#哥哥}的线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160230,
					"content": "我们现在是继续在附近找找线索呢，还是先到「沃陆之邦」找伊安珊呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160231,
					"content": "你们在这儿啊，辛苦了，看来你们巡逻很用心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160232,
					"content": "伊安珊！你怎么过来了，不是应该在「沃陆之邦」集合吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160233,
					"content": "我们正考虑要不要去找你，刚刚有了重大发现！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160234,
					"content": "我是来通知你们不用继续巡逻了，因为健美比赛刚刚取消了，一会儿会有巡逻队过来接手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160235,
					"content": "等等，发生什么了，这么突然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160236,
					"content": "「深渊教团」打过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160237,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160238,
					"content": "没想到这么快就印证了猜想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#（看来是{M#荧}{F#哥哥}又有行动了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#（这次一定要把握住机会，与{M#她}{F#他}见面。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "我之前对深渊教团的名号有所耳闻，但从未见过它们如此大规模、大范围的行动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160242,
					"content": "简直…像是准备与纳塔整个国家开战一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160243,
					"content": "单单一个「教团」，要与被称为「战争之国」的国家开战？难以置信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160244,
					"content": "印象里深渊教团大多情况下都是在暗中活动，这种情况我们也是第一次见…他们到底想要做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160245,
					"content": "现在单单从「沃陆之邦」的视角，战况还不够明确。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160246,
					"content": "目前「沃陆之邦」的防御应该不成问题，我决定到圣火竞技场去找玛薇卡了解一下情况，毕竟那里才是中枢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160247,
					"content": "#要不要跟我一起，{NICKNAME}，有纳塔的英雄坐镇总归更让人放心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160248,
					"content": "我也很需要了解情况。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "那正好，我们一起过去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160249,
					"content": "我对深渊教团也有所了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "「深渊教团」很可能也来过了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#一把在我身上，一把属于我{M#妹妹}{F#哥哥}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "…我一直有好好带在身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "…飞船休眠仓的钥匙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
