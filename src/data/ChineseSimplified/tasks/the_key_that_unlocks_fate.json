						"position": [
							-2649.083,
							279.082,
							10084.27
						],
						"pointId": 351500003
					}
				]
			},
			"dialogs": [
				{
					"id": 80160101,
					"content": "这么巧，我们的英雄「杜麦{RUBY#[S]希望}尼」还有派蒙，居然会在这里遇到你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160102
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160102,
					"content": "这不是伊安珊教练嘛！你怎么一个人在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160103,
					"content": "先、先说好，我可不是刻意来找你的，你的那些减肥和增肌的训练课程我暂时还没有兴趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160104,
					"content": "哈哈哈…知道知道，我也不是什么魔鬼教练，一向还是很尊重学员自己的意志的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160105
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160105,
					"content": "不过…适度的有氧训练应该还是百利而无一害的，比如代替我在这一带巡逻一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160106,
						80160107
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160106,
					"content": "与其说是训练…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				},
				{
					"id": 80160108,
					"content": "开个玩笑，你说得没错，我是想找个帮手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160109
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160109,
					"content": "最近我们「沃陆之邦」正在筹备一场健美比赛，临时抱佛脚加练的人太多了，以至于附近巡逻都缺了人手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160110
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160110,
					"content": "所以你在替他们巡逻？你自己不需要准备吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160111,
					"content": "我就算了吧，一方面是我一向认为只有长期的自律才能呈现最优秀的身体状态，临时抱佛脚没什么意义。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160112
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160112,
					"content": "另一方面则是…如你们所见我的身材，比较大众的重量级比赛我无法参加，而我所在的重量级又没有对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160113
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160113,
					"content": "是这个道理哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160114,
					"content": "欸！看着我干嘛，我才不要和你比！我们才不是一个重量级！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160115,
					"content": "#{NICKNAME}，我们去帮她巡逻吧，我怕伊安珊一会儿把我抓去比赛了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160116,
					"content": "哈哈哈…真好，一个眼神就搞定了委托的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160117,
						80160118
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160117,
					"content": "好吧，看在派蒙的面子上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160119,
					"content": "那就谢谢两位了，麻烦确保这一带没有什么异常情况就好，只是最基础的巡逻工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160120
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160120,
					"content": "我到另外一边再转转，晚些时候我们回「沃陆之邦」集合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160121
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160121,
					"content": "没问题，你快去吧，伊安珊教练。我们很擅长四处闲晃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160118,
					"content": "好吧，看在伊安珊的面子上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160107,
					"content": "更像是给你帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				}
			]
		},
		{
			"id": 801602,
