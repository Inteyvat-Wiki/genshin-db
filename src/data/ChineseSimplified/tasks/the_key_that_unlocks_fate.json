			"dialogs": [
				{
					"id": 80160301,
					"content": "玛薇卡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160302
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160302,
					"content": "#哦？你们来了，我正准备派人去找你，伊安珊。既然{NICKNAME}也在，那就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160303
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160303,
					"content": "目前战况怎么样？信使们有汇报些什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160304
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160304,
					"content": "纳塔各地同时有深渊教团的家伙出现，很明显是有组织和计划的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160305
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160305,
					"content": "敌人数量也不容小觑，如果不是这次的事，我们根本不知道深渊教团的势力在暗中已经发展到了这般规模。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160306
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160306,
					"content": "也就是说…倾巢出动来进攻我们？可他们的目的究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160307
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160307,
					"content": "这也是我所疑惑的，深渊教团过去在纳塔的活动并不多，也从来没有什么过节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160308
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160308,
					"content": "总不能是为了…给刚被纳塔打败的「深渊」报仇吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160309
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160309,
					"content": "虽然这理由听起来很莫名其妙，但如果是他们的话，倒也不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160310,
					"content": "还不能下定论，对方的真实目的还需要多多留意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160311
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160311,
					"content": "那你们现在打得过他们吗？伤亡情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160312,
					"content": "虽说他们是倾巢出动，但深渊教团现在面对的，可是刚刚与真正的深渊正面对抗并且取胜的纳塔勇士们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160313
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160313,
					"content": "没错，而且有一整个国家那么多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160314
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160314,
					"content": "深渊教团的战力与正牌的「深渊」还是有不小差距的，没有那种无休无止的气势。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160315
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160315,
					"content": "但毕竟也算是「战争」，我们必须重视，尽可能将伤亡降到最低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160316
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160316,
					"content": "#现在各部族已经积极组织防御了，{NICKNAME}，这次的事件算是纳塔自己的事，你可以选择和我一起留在圣火竞技场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160317
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160317,
					"content": "不，与我有关。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160318
					]
				},
				{
					"id": 80160318,
					"content": "嗯？你指的是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160319,
						80160320
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160319,
					"content": "目前深渊教团的领导者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				},
				{
					"id": 80160321,
					"content": "是的，就是这么一回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160322,
					"content": "没想到…居然还有这层关系在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160323
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160323,
					"content": "#既然如此，你知道{M#她}{F#他}的目的是什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160324
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160324,
					"content": "这也是我一直想知道的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160325
					]
				},
				{
					"id": 80160325,
					"content": "至少现在，他们两个的关系并不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160326,
					"content": "#{NICKNAME}一直想要找到{M#她}{F#他}，弄清楚到底发生了什么…可对方却似乎一直在回避。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160327,
					"content": "原来如此，兄妹矛盾吗…挺常见的，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160328
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160328,
					"content": "是没错啦…但你真的搞明白情况了吗喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160329,
					"content": "不愧是你们，兄妹两个人闹别扭这种事，都能左右世界的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160330
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160330,
					"content": "按照我的理解，你现在的立场还是站在我们这边的，并且也是一头雾水，没错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160331,
						80160332
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160331,
					"content": "那是当然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160333,
					"content": "哈哈哈，那我就放心了，一开始听你说的时候，我还担心要陷入两难的局面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160334
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160334,
					"content": "根据已知的情报，深渊教团似乎将主力攻势放在了「烟谜主」部族…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160335
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160335,
					"content": "如果不想跟我留在这里坐镇中央，我建议你优先去支援「烟谜主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160336
					],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160336,
					"content": "正合我意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160337
					]
				},
				{
					"id": 80160337,
					"content": "那我也跟你一起去吧，「沃陆之邦」现在承受的压力很小，战力应该分配给更需要的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160338
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160338,
					"content": "嗯，拜托你们了，需要支援的话请随时联系我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛薇卡"
				},
				{
					"id": 80160332,
					"content": "甚至比你们更想揍深渊教团。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160320,
					"content": "#是我的{M#妹妹}{F#哥哥}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				}
			]
		},
