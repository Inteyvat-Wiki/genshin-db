					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160512,
					"content": "#我要是{M#她}{F#他}早把名字改了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
