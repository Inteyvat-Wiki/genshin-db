					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 80160402,
					"content": "不愧是黑曜石奶奶，早知道有你在，支援「烟谜主」的必要性就该重新审视一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160403,
					"content": "还是深渊教团更应该重新审视下进攻目标才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 80160404,
					"content": "我看刚才他们过来的方向，根据作战经验，应该有深渊教团的据点才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160405,
					"content": "不如乘胜追击，一举拔掉他们进攻所依托的据点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160406,
					"content": "刚刚这里是发生了战斗吗？需不需要帮忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "苏图拉"
				},
				{
					"id": 80160407,
					"content": "「烟谜主」的战士们也来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80160408,
					"content": "刚经历过大战，大家的作战协同性就是高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 80160409,
					"content": "气势都到这里了，一鼓作气攻上去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊安珊"
				}
			]
		},
