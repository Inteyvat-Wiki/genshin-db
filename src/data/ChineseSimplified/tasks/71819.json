					"向明"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "嗯？你有什么事，我在执行任务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190202,
					"content": "关于海灯节礼品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "小声点！我在执行任务呢，什么礼品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190204,
					"content": "是总务司要你送来的？哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190205,
					"content": "唉，又是一年海灯节了，本来今年我还想早点回家的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190206,
					"content": "可是看现在这状况，我可不敢放松…估计我又得晚几天回家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190207,
					"content": "谢谢你跑这一趟，这个我就收下了，辛苦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190208,
					"content": "唉，那家伙到底什么时候走啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "向明"
				}
			]
		},
