					"弘毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190301,
					"content": "这井水到底是怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190302,
					"content": "关于海灯节礼品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "噢，这是总务司送过来的吧。谢啦，我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190304,
					"content": "不过，我还得接着在这执勤一段时间，免得有居民在节日期间过来取水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190305,
					"content": "唉，这井水也不知道是怎么回事…但总之，肯定是喝不得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弘毅"
				}
			]
		},
		{
			"id": 7181904,
			"completionStepIds": [
