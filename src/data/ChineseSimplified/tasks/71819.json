			},
			"dialogs": [
				{
					"id": 718190501,
					"content": "哎…这怎么上去呢，唔…不然还是换个法子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190502,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "旅行者？哈哈，没事没事，我正在想着怎么爬上去把那盏霄灯拿下来呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190504,
					"content": "不过这树也太难爬了，我这一身的甲胄，爬一半就滑下来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190505,
					"content": "呃…旅行者，如果你愿意的话，能不能帮我上去把那盏霄灯给取下来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190506,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "行，那就拜托你了，那孩子都急哭了，可得快点把霄灯拿回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蔡乐"
				}
			]
		},
		{
			"id": 7181906,
			"completionStepIds": [
				7181908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181908",
