			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "唉…事情真是做不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "没事，我正在梳理海灯节期间要处理的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190104,
					"content": "只不过…越梳理越多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190105,
					"content": "虽然其他同事帮我分担了一部分，但今年轮到我带队去送霄灯，得快点准备好东西才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190106,
					"content": "送霄灯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "对喔…你应该不知道，我说的「送霄灯」不是你想的那种，普通地把霄灯送给别人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190109,
					"content": "简单来说…应该更像是送去节日的祝福啦，氛围啦之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190110,
					"content": "比如，海灯节期间，虽然大部分人都回家过节了，一般的店铺也会休假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190111,
					"content": "但为了维持节日里的秩序，还有处理一些事务，还有一部分千岩军会继续在节日期间值班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190112,
					"content": "总务司在海灯节期间一般也会安排人去给他们送些礼品去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190113,
					"content": "我今天就正准备去给负责城里守卫的千岩军们「送霄灯」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190114,
					"content": "不过…我带的人也不太够了，有些礼品送出去了，但还有些没送出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190115,
					"content": "旅行者，你能帮我把这些礼物送过去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190116,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "你愿意帮忙吗？那太好了，就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190118,
					"content": "要送给谁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "我看看…还有没送到的千岩军是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190120,
					"content": "向明…弘毅…还有蔡乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190121,
					"content": "我把他们的位置标记给你，就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190107,
					"content": "是要送很多人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
			"id": 7181902,
			"completionStepIds": [
				7181902
