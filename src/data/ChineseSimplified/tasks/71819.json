					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蔡乐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "怎么样，你拿到霄灯了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190602,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "我看看…对，就是这盏，谢谢你啊，我这就把霄灯给他们带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190604,
					"content": "这么长时间了，也不知道那两个孩子是不是还待在原地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190605,
					"content": "关于礼品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "这是总务司送的吧，行，我收下了，谢谢你跑这么一趟啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190607,
					"content": "这也是千岩军的职责吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "你说帮忙摘霄灯吗？哈哈哈，当然算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190609,
					"content": "不管是摘霄灯，还是赶走不怀好心的人，或者是去击退魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190610,
					"content": "帮助需要帮助的人，这就是千岩军的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190611,
					"content": "好了，再次感谢你。我要赶紧把霄灯带给那两个孩子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "蔡乐"
				},
				{
					"id": 718190612,
					"content": "然后我还得接着去处理另外的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蔡乐"
				}
			]
		},
