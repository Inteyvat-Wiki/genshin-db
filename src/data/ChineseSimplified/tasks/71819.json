				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "你回来了，礼品发的怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190702,
					"content": "都发给对应的人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "谢谢，实在是帮大忙了…没有你的话，我肯定忙不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190704,
					"content": "他们整个节日里都不会放假吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "这个…唉，虽然总务司也会安排千岩军们交替值班…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190706,
					"content": "但璃月实在是太大了，需要驻守和巡逻的地方也太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190707,
					"content": "就算是交替值班，人手也总是不够，总会有人不得不在节日期间值班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190708,
					"content": "而且因为每年的海灯节都很盛大，所以在节日期间，有的地方工作压力反而会更大，无论怎么分配人手都不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190709,
					"content": "那真是辛苦了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "没有啦，没有，这是我们应该做的…只要海灯节一切顺利就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190712,
					"content": "对了，在海灯节期间，其实还有很多人需要帮助，如果你愿意的话，可以多多去帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190713,
					"content": "如果能让更多的人能参与到「海灯节」中来，节日的氛围也肯定会更加红火吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190714,
					"content": "我们之所以会「送霄灯」，也是希望每个人都能放出一盏霄灯，许出自己的心愿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190715,
					"content": "如果再说得宽泛点…就是把「海灯节」带去四面八方，让所有人都能感受到海灯节的氛围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190716,
					"content": "毕竟，海灯节可是所有人的节日啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190717,
					"content": "好啦，我还要有事情要做，就先去忙了，祝你在海灯节上玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190710,
					"content": "辛苦你们了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
