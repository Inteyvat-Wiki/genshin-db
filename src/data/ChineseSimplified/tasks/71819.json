				"points": []
			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "呜呜…我，我还没写好愿望呢…呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "一弦"
				},
				{
					"id": 718190402,
					"content": "弦儿乖，千岩军叔叔去已经帮你拿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190403,
					"content": "关于蔡乐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "你是在找那位千岩军叔叔吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190405,
					"content": "刚才弦儿在霄灯上写愿望的时候，不小心把霄灯放飞了，一直往那边飞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190406,
					"content": "那位千岩军叔叔说，他看见霄灯挂在了树上，他去那边帮我们拿霄灯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190407,
					"content": "那盏霄灯很特别吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "我是这么和弦儿说的，但是她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190410,
					"content": "呜…不…不嘛，那是哥哥做给我的，哥哥做了好久才做好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "一弦"
				},
				{
					"id": 718190411,
					"content": "弦儿乖，千岩军叔叔很快就回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190412,
					"content": "抱歉，如果你急着找那位千岩军叔叔的话，可以去那边找找看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190408,
					"content": "不能重新做一盏吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
		{
