				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛诺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "好热…要是有乘凉的地方就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100202,
					"content": "稍微休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "还有不少路要走，再坚持一下。而且从周围环境来看，这里也不适合休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100204,
					"content": "呼…好吧，可赛诺不觉得热吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100205,
					"content": "当然觉得，不过我已经习惯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100206,
					"content": "有什么秘诀吗？我感觉已经快坚持不住啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100207,
					"content": "尽可能保持清醒，然后靠毅力撑着。一旦放松下来，只会更加疲惫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100208,
					"content": "一步一步走，不要让大脑判断身体的极限，到相对安全的地方再彻底放松。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100209,
					"content": "好吧。不过安全的地方指的是哪里呢？我觉得这里很安全呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100210,
					"content": "你看，这里是一望无际的沙漠，附近也没什么怪物——呜哇！这些毒蝎是从哪里来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100211,
					"content": "小心，这些家伙不太对劲——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛诺"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛诺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "呼…没想到这里居然会有毒蝎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100402,
					"content": "这不是普通的毒蝎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100403,
					"content": "你看，它们的钳子上有编号，这是人为饲养的毒蝎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100404,
					"content": "你的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "有人不希望我们去拍卖会，所以派它们过来围堵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100406,
					"content": "反正周围是漫漫黄沙，就算我们被干掉，也不会有人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100407,
					"content": "好危险！幸好我们没有放松警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100408,
					"content": "但是不太对…沙漠中没有固定的路，他们怎么知道我们会到这里来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100409,
					"content": "#别动，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100410,
					"content": "果然…他们把这东西放在你身上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100411,
					"content": "这是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100412,
					"content": "妙论派造出来的小型定位器，能够据此确定佩戴者的大致方位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100413,
					"content": "我记得这个装置没有获得量产许可，他们是从哪里搞来的…莫非有妙论派的学者牵涉其中？可是不太对…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100414,
					"content": "#居然还有这种东西，为什么会在{NICKNAME}的身上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100415,
					"content": "应该是和佣兵缠斗的时候，被他们放上去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100416,
					"content": "抱歉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "当时情况很乱，没发现很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100419,
					"content": "幸亏赛诺发现了，那我们快把它扔掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100420,
					"content": "…不，还是先让它留在你身上，应该会派上用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100421,
					"content": "继续去拍卖会吧，在这里耽误太久，说不定会有别的危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100417,
					"content": "没注意到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛诺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "奇怪，这里就是拍卖会吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100602,
					"content": "一个人都没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "是呀！一个人都没有，难道说是中场休息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100604,
					"content": "打败那些佣兵团之后，我们立刻马不停蹄地赶往这里。之所以这么急，就是担心会有人过来通风报信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100605,
					"content": "而我们还是扑了个空，想必是因为这里的人通过定位器观察到了我们的动向，提前撤离了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100606,
					"content": "那我们现在该怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100607,
					"content": "搜。他们没来得及转移所有的罐装知识，这里可能会有线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100608,
					"content": "那我们可要好好找一找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"赛诺",
					"巴哈利"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "哇！真的抓到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100702,
					"content": "你就是在背后捣鬼的大坏蛋吗？快把你知道的说出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100703,
					"content": "这个人知道什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "刚刚他出现的时候，我没有第一时间出手，而是在旁边观察了一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100706,
					"content": "他不是幕后主使，但他应该是一个分量不轻的商人。我说的对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100707,
					"content": "不愧是赛诺，看得真准…早知道你没走，我就不贪这点便宜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100708,
					"content": "贪便宜？什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100709,
					"content": "得知你们要来，各地的罐装知识商人立刻作鸟兽散，货物也来不及全部带走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100710,
					"content": "这些暂时都是无主之物，只要抢在别人之前拿回去，就能大赚一笔。当然，现在说这些也没有什么意义了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100711,
					"content": "你应该知道是谁在制造和售卖罐装知识吧。需要我动手，还是你自己说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100712,
					"content": "我自己说吧。不过在那之前，我希望换个地方说话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100713,
					"content": "留在这里，如果被别人看到我和你们接触，我和我的家人也会有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100714,
					"content": "你想去哪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100715,
					"content": "到我家吧，在阿如村，那里很安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100716,
					"content": "#可以。{NICKNAME}，把定位器丢掉，我们过去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100704,
					"content": "这个人的「分量」够吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"西敏",
					"巴哈利",
					"赛诺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "爸爸，你回来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100802,
					"content": "啊，是客人吗？你们好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100803,
					"content": "这是我的女儿，名叫西敏，稍微有些怕生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100804,
					"content": "乖，你先自己玩会儿，爸爸有事要和几位客人聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100805,
					"content": "噢…好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100806,
					"content": "赛诺的名字，业内没有不知道的。你们两位怎么称呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100807,
					"content": "#我是派蒙，这位是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100808,
					"content": "说实话，我也没想到那位独来独往的赛诺，居然会有同伴。所以看着定位器逐渐远离，我才笃定是赛诺无功而返。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100809,
					"content": "不过，就算你们抓到了我，我还是想劝你们一句…到此为止吧，不要继续查下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100810,
					"content": "为什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100811,
					"content": "制造、销售、分赃…每个环节少则几十人、多则上百人，高额的利润让所有人聚拢在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100812,
					"content": "为了维护这条来之不易的产业链，每个人都会竭尽全力，就算是你也只能撞得头破血流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100813,
					"content": "而且就算你真的做到了，也没有任何人会感谢你。或许你自己都会感到难过…为什么要这么拼命呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100814,
					"content": "每个人都有自己的坚持，没什么好说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100815,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100816,
					"content": "爸爸…喝茶…还有客人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100817,
					"content": "哦，瞧我都忘了给客人倒茶了。多谢你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100818,
					"content": "没事…那个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100819,
					"content": "家里的茶很苦。所以，我把爸爸给我的糖放进去了。应该会好喝一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100820,
					"content": "真懂事，糖还有吗？没有的话，爸爸下次再给你买。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100821,
					"content": "好…我去休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "西敏"
				},
				{
					"id": 130100822,
					"content": "不是说参与其中的人可以获得高额的利润吗？我从你身上看不到这一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100823,
					"content": "…其实，这也是我想跟你们说的，一个我自己的请求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100824,
					"content": "我的女儿，出生起就患有一种顽疾。她的心肺比一般人虚弱，稍微剧烈的运动就可能导致晕厥，甚至面临生命危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100825,
					"content": "因为这个原因，她自幼没有玩伴，整天把自己关在房间里。平时还要吃很多药，开销很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100826,
					"content": "而我呢，原本只是个小商人，起早贪黑、东奔西走，赚到的那点钱远远不够，只能一天天地看着她越来越虚弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100827,
					"content": "直到有人找上我，给我指了一条生财之道——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100828,
					"content": "售卖罐装知识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100829,
					"content": "没错。赚到了钱，总算可以给她治病。看着她逐渐好起来，我心里比谁都开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100830,
					"content": "像我这样的人还有很多。走私罐装知识在你看来不可原谅，但对我们来说这却是活命的办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100831,
					"content": "我告诉你这些，就是想劝你一句——收手吧，赛诺大人，给我们一条活路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100832,
					"content": "怎么会这样…也就是说如果我们禁止售卖罐装知识，她就会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100833,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100835,
					"content": "我必须要知道真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100836,
					"content": "我可以找人帮那孩子看病，但我不能对走私罐装知识视而不见。这是两码事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100837,
					"content": "我就知道你会这么说，不过有你这句话就够了。既然你执意要查下去，就去房屋后面找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100838,
					"content": "那里有我不久前刚刚进的货，看过之后，你就明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "巴哈利"
				},
				{
					"id": 130100839,
					"content": "与赛诺一同来到了房屋后面。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "居然有这么多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100841,
					"content": "整整齐齐装了这么多箱子，这里还只是其中一个商人的窝点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100842,
					"content": "这个数量不可能是小作坊生产的。难道真的是教令院？可是像这样大宗货物进出，不可能没有审查…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100843,
					"content": "快看，这些罐装知识好像不太一样，难道这就是记录归寂之庭的罐装知识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100844,
					"content": "应该没错。等等，这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100845,
					"content": "没见过的标记。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "这是风纪官的放行图章。印有这个标记，就意味着里面的货物已经由风纪官审查过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100848,
					"content": "见到定位器的时候，我怀疑有教令院的人参与其中，但我想不明白怎么把这么多罐装知识送出教令院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100849,
					"content": "现在我明白了。有了这个图章，货物进出教令院就无需二次审查，可以畅行无阻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100850,
					"content": "哼，难怪不希望我继续查下去。破坏风纪的竟是风纪官本身，难以置信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100851,
					"content": "也可能是误会。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}，可以拜托你一件事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100853,
					"content": "既然这些罐装知识来自教令院，那么关于归寂之庭的罐装知识，很可能用的也是教令院内封存的研究资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100854,
					"content": "只要去资料室查看记录，就能搞清楚背后是谁在捣鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100855,
					"content": "但以我现在的身份，贸然出现在教令院，只会打草惊蛇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100856,
					"content": "这件事，可以拜托你来调查吗？我会写信给纳比尔，让他带你去资料室。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100857,
					"content": "包在我们身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100858,
					"content": "这段时间我也不会闲着。虽然幕后之人的线索指向教令院，但对方明显在教令院外也很有势力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100859,
					"content": "从巴哈利那里可以拿到一些其他商人的信息，我留下来提前做些准备。你们有什么新的发现，可以随时回来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100846,
					"content": "赛诺认识吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
