	"talks": [
		{
			"id": 1301002,
			"completionStepIds": [
				1301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
