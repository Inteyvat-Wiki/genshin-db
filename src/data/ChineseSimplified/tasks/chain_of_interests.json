					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "好耶！那我们就在这里休息一会儿，然后回去找赛诺吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130101006,
					"content": "在附近坐下歇息了一段时间。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "感觉时间差不多了，我们回拍卖会那里看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130101008,
					"content": "不知道赛诺那边有没有收获…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
