					"nextDialogs": [
						130100616
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100616,
					"content": "难怪你让我带着定位器…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "他们匆忙撤离，很多货物来不及带走，不可能一直这样放着不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100618,
					"content": "确认我们「离开」之后，自然会有人过来收拾。所以要让定位器离这里足够远，让他们误以为自己已经安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "赛诺"
				},
				{
					"id": 130100619,
					"content": "我明白了！你是想让我们当诱饵，来骗他们现身！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130100620,
					"content": "好吧，我们现在就出发，这里就交给你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "派蒙"
				},
