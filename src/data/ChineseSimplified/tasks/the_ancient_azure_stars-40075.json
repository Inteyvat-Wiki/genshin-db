			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"莫娜",
					"枫原万叶",
					"菲谢尔",
					"奥兹"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "哇，又出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400750802,
					"content": "莫娜，那个冒险家…真的死了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750803,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750804,
					"content": "我只见过他一次。至今有三年多，所以…他应该已经不在人世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750805,
					"content": "可是，就没有一点他还活着，只是你算错的可能吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400750806,
					"content": "可那样不公平吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "遇到坏事就全然拒绝，遇到好事就深信不疑。这样的事，不能被称为占卜，只能算是自我安慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750808,
					"content": "作为日常娱乐当然没关系啦，但我学的是一门没有谎言的学问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750809,
					"content": "否定我自己的结论，是在亵渎占星术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750810,
					"content": "残酷，但也真实。命运确实是这样的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400750811,
					"content": "平时我可不说这种话，但既然提到了，还是希望大家别把占星术跟街边小摊小贩的那些抽签活动混为一谈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750812,
					"content": "我们研究星象，绝不是为了让谁听了奉承高兴一整天。占星术士，是为了验证真实，见证世界之理而存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750813,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750814,
					"content": "啊——！所以我说，占星术士就是个招人讨厌的职业啊！很伟大跟惹人厌完全不冲突嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750815,
					"content": "为何突然这般吵闹？汝也不是那么不值得结交的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400750816,
					"content": "小姐的意思是，很高兴和您成为朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400750817,
					"content": "不是啦！我没那么说吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400750818,
					"content": "奥兹，你怎么回事？越来越喜欢假传我的旨意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400750819,
					"content": "哎呀哎呀，为什么呢，难道是我太担心小姐得罪好朋友，特意时时刻刻挽回吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400750820,
					"content": "我见识没那么广，只认识你一个占星术士，不过你给我的感觉很好哦，完全不讨人厌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750821,
					"content": "随便向别人打听秘密，又把不喜欢的结果随手丢弃，那些人自己才要反思一下，命运可不是那么便宜的东西啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750822,
					"content": "如果命运是三言两语便能回避的东西，人间就不会有别离之苦了。莫娜，别往心里去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400750823,
					"content": "追逐本心，永不忘记正确之事，这样足矣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 400750824,
					"content": "咳咳，也…也没必要这样关怀我哦，我很强韧的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750825,
					"content": "那你耳朵为什么红红的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "呃、呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750827,
					"content": "…好吧，那…那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750828,
					"content": "谢谢大家…了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750829,
					"content": "听不清楚，请大声向本皇女献上你的崇敬与祝福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400750830,
					"content": "好了好了殿下，比起斗嘴，您还是先去水池倒映出的新地点回收其他碎片吧。没有那个，我们可进不去幻境啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750831,
					"content": "唯有小姐您锐利的目光才能锁定秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "奥兹"
				},
				{
					"id": 400750832,
					"content": "既然如此，好吧好吧，本皇女就移驾海滩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "菲谢尔"
				},
				{
					"id": 400750833,
					"content": "走了，莫娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400750834,
					"content": "哦、哦哦！来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400750835,
					"content": "…哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		}
	]
}