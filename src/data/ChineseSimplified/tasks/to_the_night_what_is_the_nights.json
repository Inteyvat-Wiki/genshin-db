					"nextDialogs": [
						750050256
					]
				},
				{
					"id": 750050256,
					"content": "哼…这么丑的东西，想也不会值太多钱吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "派蒙"
				},
				{
