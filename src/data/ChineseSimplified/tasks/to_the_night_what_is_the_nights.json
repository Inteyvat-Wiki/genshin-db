				]
			},
			"dialogs": [
				{
					"id": 750050101,
					"content": "#{NICKNAME}，你看，这里有一道被封印的大门！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050102,
					"content": "哼哼，我有种直觉，刚才我们在附近拿到的几个奇怪东西，一定和开启大门有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050103,
					"content": "真奇怪，这道门的背后会是什么地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050104,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050105,
						750050110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050105,
					"content": "也许是怪物的巢穴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050106
					]
				},
				{
					"id": 750050106,
					"content": "哇…有怪物的地方，一定会有宝藏的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050107,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050108,
					"content": "那可不一定哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050109
					]
				},
				{
					"id": 750050109,
					"content": "哼，少说丧气话啦，我们进去看看不就知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050115,
					"content": "喂，两位异邦人！唔…还有一只系着丝巾的小嵴锋龙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050116
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050116,
					"content": "唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050117,
					"content": "哎呀，精神的小家伙，你没告诉他们：封印之所以是封印，就因为这里是「禁地」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050118
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050118,
					"content": "哦，除了深远的诅咒，你们在里面找不到任何东西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050119
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050119,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050120,
					"content": "也就是说…没有宝藏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050121,
					"content": "宝藏嘛…大概也是有的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050122
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050122,
					"content": "大概？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050123
					]
				},
				{
					"id": 750050123,
					"content": "不过那就不是异邦人该染指的东西了，那扇被封印的门后既是「禁地」也是「圣地」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050124
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050124,
					"content": "平时只有来经受考验的讯使在完成试炼，拿到资格之后才得以进入，据说里面存放着远古的先民与夜晚的世界沟通的媒介…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050125
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050125,
					"content": "这么说来，我只是稍微有事离开了一小会儿，你们就取得了证明试炼完成的三枚钥石？这还真是不得了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050126
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050126,
					"content": "嘿嘿，爬高下低，找东西啊，这种活我们可擅长了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050127,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050128,
					"content": "即使是部族的讯使看来也没有你们这般矫健的身手。这样，虽然部族的禁地肯定是没法让你们进去，不过，我的营地就在附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050129
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050129,
					"content": "就让我招待你们垫补下肚子，再休息一会儿，怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050130
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050130,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050131,
						750050135
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050131,
					"content": "我们还不饿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050132
					]
				},
				{
					"id": 750050132,
					"content": "我也…！唔，我是有点饿啦…要不然，我们就去休息一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050133,
					"content": "真拿你没办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050134
					]
				},
				{
					"id": 750050134,
					"content": "嘿嘿…我还在长身体嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050139,
					"content": "噗嗤…你们关系还真好呢。走吧，去我的营地那儿歇息一会儿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050140
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050140,
					"content": "我会准备些热乎的食物，远方的来客，说不定我们有很多话题可以聊聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050135,
					"content": "既然来都来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050136
					]
				},
				{
					"id": 750050136,
					"content": "没关系，你休息，我放哨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050137,
					"content": "你只会睡得比我还熟吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050138
					]
				},
				{
					"id": 750050138,
					"content": "喂——！别太小看我啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050110,
					"content": "也许是藏宝的洞窟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050111
					]
				},
				{
					"id": 750050111,
					"content": "哇！我的直觉也是这样，里面一定是藏宝的洞窟没错啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050112,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050113
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050113,
					"content": "不要太兴奋啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050114
					]
				},
				{
					"id": 750050114,
					"content": "里面有什么，进去看看就知道了！我们先把这道大门打开吧！嘿嘿，宝藏，宝藏，我们来咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "派蒙"
				}
			]
		},
