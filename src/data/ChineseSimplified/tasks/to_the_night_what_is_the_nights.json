					"nextDialogs": [
						750050252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050215,
					"content": "只是好奇而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050216
					]
				},
				{
					"id": 750050216,
					"content": "对呀，看到一扇被封印着的大门，有谁不会好奇呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050217,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050218
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050218,
					"content": "正派人吧。",
