						750050282
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050282,
					"content": "事先警告你们一句…遗迹里道路曲折，机关众多。一定要小心危险哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷格巴"
				},
