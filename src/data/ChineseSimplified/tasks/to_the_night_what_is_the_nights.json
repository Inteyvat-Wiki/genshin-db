			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"雷格巴"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2235.689,
							208.739,
							7959.164
						],
						"pointId": 8109
					},
					{
						"sceneId": 3,
						"position": [
							-2237.073,
							208.846,
							7958.869
						],
						"pointId": 8110
					},
					{
						"sceneId": 3,
						"position": [
							-2236.62,
							208.781,
							7958.013
						],
						"pointId": 9244
					}
				]
			},
			"dialogs": [
				{
					"id": 750050201,
					"content": "不必客气，你们随意吧。要不要尝尝我的手艺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050202
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050202,
					"content": "如果想自己做的话，那边的箱子里有食谱。还有些我用不上的东西，你可以翻一翻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050203
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050203,
					"content": "欸？你还随身准备着食谱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050204,
					"content": "我自己画的，画了好几份。说不定谁能用得上。如果遇到需要解救的人，也能拿来救命呢。你说是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050205
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050205,
					"content": "哇，你想得还真周到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050206,
					"content": "毕竟在部族外面，你只能自己靠自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050207
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050207,
					"content": "对了，我们还没问过你的名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050208
					]
				},
				{
					"id": 750050208,
					"content": "我的名字？哈！雷格巴吧，叫我雷格巴就好。那么你们呢，朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050209
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050209,
					"content": "向雷格巴作了自我介绍。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050210
					]
				},
				{
					"id": 750050210,
					"content": "#派蒙，{NICKNAME}，还有小嵴锋龙{REALNAME[ID(2)|SHOWHOST(true)]}…你们在纳塔相遇，真是奇妙的缘分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050211
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050211,
					"content": "#话说回来，{NICKNAME}。你们在部族的禁地附近做什么？嗯？寻宝？打探秘密？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050212,
						750050215
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050212,
					"content": "当然是寻宝啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050213
					]
				},
				{
					"id": 750050213,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050214
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050214,
					"content": "嗯嗯！这种被保护得很好的地方，总有可能藏着宝贝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050220,
					"content": "总之，不要对那里动歪心思了，外来人。我是不会让你们进去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050221
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050221,
					"content": "那里是古老的先人与夜晚重新建立起联系的地方，自那以后，越来越多的部族人才能步入「夜神之国」的门扉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050222
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050222,
					"content": "嗯?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050223,
					"content": "「夜神之国」到底是个什么样的地方啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050224,
					"content": "哈哈，据说那是所有纳塔人在离开这个世界才会前往的地方…只有少数人有从那里返回的经历。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050225
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050225,
					"content": "据说那是个流水犹如荧光，伫立着巨大黑曜石碑之处。比起部族的禁地，「夜神之国」才是你们最好不要好奇的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050226
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050226,
					"content": "所以，你之前说的，下面的那个…和夜晚世界沟通的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050227,
					"content": "媒介，对，就是以前的人和「大灵」…也是来自「夜神之国」的使者接触的古老道具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050228
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050228,
					"content": "哇，古老的道具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050229,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050230
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050230,
					"content": "…或许我说的有点多了。总之，在部族人与「夜神之国」建立稳定联系的现在，早已不用媒介，而且在我看来手段实在简陋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050231
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050231,
					"content": "但那好歹也是人类部族的圣物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050232
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050232,
					"content": "唔…嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050233
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050233,
					"content": "好吧、好吧…我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050234,
					"content": "对，不要去禁地，那样才是真正正确的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050235
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050235,
					"content": "哈！哈！你们的伙伴很聪明，是个非常聪明的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050236
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050236,
					"content": "我曾经也有许多伙伴…许多很聪明的孩子。但现在，我孑然一身，离群索居已久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050237
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050237,
					"content": "咳咳…啊，没想到天色已经如此之深了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050238
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050238,
					"content": "哈啊…听了好多半懂不懂的东西，我也发困了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050239,
					"content": "哎，都怪我，偶尔遇见能说话的人，就变得喋喋不休了…这样，如果你们不嫌弃的话，就在这里休息一晚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050240
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050240,
					"content": "我来为你们准备床铺。反正夜里我也得在附近巡逻，不必担心安全的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050241
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050241,
					"content": "哇，好贴心！那就谢谢你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050242,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050243
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050243,
					"content": "在温暖的草榻上躺下，伴着闪烁的营火，你很快便陷入了梦乡…\\n不过你总觉得耳边有细碎而嘈杂的声响，令你无法沉入深眠。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050244
					]
				},
				{
					"id": 750050244,
					"content": "直到——\\n直到脸颊旁冰凉湿润的触感突然袭来，将你带离了粘稠黑暗的夜梦…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050245
					]
				},
				{
					"id": 750050245,
					"content": "#你睁开双眼，{REALNAME[ID(2)|SHOWHOST(true)]}熟悉而友好的面孔占据了你的视野。\\n或许刚才是它在舔舐你，试图将你唤醒。\\n又过了片刻，你才注意到，它似乎正试图给你展示什么东西——一座奇特的黑曜石像…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050246
					]
				},
				{
					"id": 750050246,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050247,
						750050249
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050247,
					"content": "这是你找到的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050248
					]
				},
				{
					"id": 750050248,
					"content": "呀…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050252
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050252,
					"content": "唔…这个东西看起来好瘆人，太不吉利啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050253,
						750050255
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050253,
					"content": "派蒙还讲究吉利吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050254
					]
				},
				{
					"id": 750050254,
					"content": "我只是照实说我的感觉啦…看着就不像什么好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050257,
					"content": "#不过，话说回来！{REALNAME[ID(2)|SHOWHOST(true)]}一定是趁我们睡觉的时候出去乱跑了！我说的对不对呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050258,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050259
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050259,
					"content": "真难办，这个东西是从哪里捡来的…会不会是很危险、很脏的地方呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050260
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050260,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050261
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050261,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}？{NICKNAME}！小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050262
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050262,
					"content": "我们还在这里呢，怎么啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050263
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050263,
					"content": "#我听到{REALNAME[ID(2)|SHOWHOST(true)]}的叫声就赶过来了。发生什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050264
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050264,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050265
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050265,
					"content": "这个…这是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050266
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050266,
					"content": "天哪，这座黑曜石像，就是藏在那个被封印的大门后面，部族禁地深处，以前先民用来与「夜神之国」沟通的媒介…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050267
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050267,
					"content": "这是你们让小嵴锋龙挖出来的？你们、你…异邦人，觊觎部族的圣物，亏我还为你们准备营地和休息的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050268,
						750050270,
						750050272
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050268,
					"content": "等等，我们可以解释…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050269
					]
				},
				{
					"id": 750050269,
					"content": "这不是我们故意做的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050274,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050275
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050275,
					"content": "和雷格巴交代了前因后果…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050276
					]
				},
				{
					"id": 750050276,
					"content": "居然是这样，唉，我居然忘了这个小家伙可以四处挖洞…倒是我有点疏忽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050277
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050277,
					"content": "唉，这下可麻烦了，让我想想…虽然已经长久时间没有用过，但是这个媒介也是圣物，要是「大灵」生气就麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050278
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050278,
					"content": "啊，那怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050279
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750050279,
					"content": "总之，就要麻烦你们，把这东西归还回它应该去的地方啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050280
					],
					"speakerTitle": "雷格巴"
				},
				{
					"id": 750050280,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050281
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
