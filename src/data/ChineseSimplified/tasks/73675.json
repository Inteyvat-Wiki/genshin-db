{
	"id": 73675,
	"type": "WQ",
	"name": "未来星坠落的地方",
	"description": "女孩芭努独自一人在野外搜寻着什么…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5096,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
