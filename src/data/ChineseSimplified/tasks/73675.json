	],
	"talks": [
		{
			"id": 7367501,
			"completionStepIds": [
				7367501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367501",
							"2"
						],
						"stepId": 7367501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭努",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736750101,
					"content": "哇，太好了！不是镀金旅团不是盗宝团，是衣着正经的陌生人，得赶快抓住机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750102
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750102,
					"content": "嗯，那个…「这位行路的朋友，请停下你的脚步！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750103,
						736750104
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750103,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750105
					]
				},
				{
					"id": 736750105,
					"content": "「您好！括号，根据对方性别选择称呼先生或者女士，括号。唐突打扰非常抱歉，烦请您在百忙之际抽空…嗯…听取我的请求。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750106
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750106,
					"content": "括、括号？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750107,
					"content": "不行不行，不能打断，要不然我就记不得下一句了。下一句是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750108
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750108,
					"content": "「括号，用简要的语言描述你遇到的困难…并礼貌地请求对方协助，然后郑重向对方表示感谢，括号。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750109
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750109,
					"content": "最后一句是——「括号，范例，括号。感谢您的慷慨大度，我将永远把它记在心上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750110
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750110,
					"content": "「同时，我愿意为您的不辞辛苦支付可观的报酬，因此我恳请您稍稍考虑这一请求。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750111
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750111,
					"content": "呼，这遍一个字都没背落，肯定没问题。那么，找未来星的事就靠你帮忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750112
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750112,
					"content": "听起来像是有事要委托我们，但我怎么听不懂你说的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750113,
					"content": "哪里有问题呢？《游学者不可不知的五十件事》上说，要找人帮忙的话就这么说，不该有问题啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750114,
						736750116
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750114,
					"content": "哪里都有问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750115
					]
				},
				{
					"id": 736750115,
					"content": "这样吗？等、等一下，我找一找「哪里都有问题」的时候该背哪一段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750118
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750118,
					"content": "女孩从口袋里掏出了一本叫作《游学者不可不知的五十件事》的书，焦急地翻了起来。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736750119
					]
				},
				{
					"id": 736750119,
					"content": "唉，这上面没说。但是沙尔玛明明说遇到问题的时候，只要翻这本书就好了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750120
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750120,
					"content": "虽然很混乱，但是看样子，小朋友你是遇到了困难需要帮助对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750121,
					"content": "既然书本派不上用场，不如用你自己的话说说你碰到的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750122,
					"content": "我想想，事情是这样的：我叫芭努，是跟着地图来这里找未来星的，未来星一共有六颗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750123
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750123,
					"content": "只要找到全部六颗未来星，就能召唤出大未来星，大未来星超级厉害的，我的目标就是召唤出大未来星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750124
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750124,
					"content": "哦，之前你说的「找未来星」指的就是这件事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736750125,
					"content": "嗯，未来星的设定差不多就是这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750126,
						736750128
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750126,
					"content": "设定？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750127
					]
				},
				{
					"id": 736750127,
					"content": "对呀，我觉得比起我平时看的那些，这个设定还挺好懂的，不过就是太简单了，不好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750130
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750130,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750131
					]
				},
				{
					"id": 736750131,
					"content": "然后，嗯…这个设定我觉得太模糊了，没有解释该怎么找到未来星。为了解决这个问题，我又想了一个补充设定：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750132
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750132,
					"content": "女孩从身后的草丛里翻出了一个奇怪的物体。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736750133
					]
				},
				{
					"id": 736750133,
					"content": "就是这个重要道具，它叫…嗯就叫「芭努的智慧」吧。它可以指引出未来星的位置，很厉害吧，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750134
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750134,
					"content": "我觉得这个名字超级酷！不过它太高了，而且又很重，我搬不动，就变得不酷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750135
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750135,
					"content": "我想找你们帮忙的就是这件事，你们应该能搬得动吧，能帮我用它找到未来星吗？召唤出大未来星之后我可以给你们付很多很多报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750136,
						736750137
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750136,
					"content": "这就是你的委托吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750138
					]
				},
				{
					"id": 736750138,
					"content": "#遇到{M#大哥哥}{F#大姐姐}你们之前，我还试过找别人帮忙。但他们听到未来星的时候表情都变得很怪，都不想听我说下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750139
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750139,
					"content": "他们还让我不要胡闹，乖乖回家找爸爸妈妈去，真气人。我又不是瞒着家人溜出来的玩的幼稚鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750140
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750140,
					"content": "大人们总是这样，就因为我是小孩子，就觉得我在乱说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750141
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750141,
					"content": "但未来星是真实存在的！我才没有在幻想，只要你们带着…嗯…「芭努的智慧」找一找就会知道我有没有撒谎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750142
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750142,
					"content": "要是你们也不愿意帮忙，唉，我再等等看，遇到的下一个人会不会愿意听我说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750143
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750143,
					"content": "好吧，我可以去看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750144
					]
				},
				{
					"id": 736750144,
					"content": "#你相信我！太好了，{M#大哥哥}{F#大姐姐}你拿着这个「芭努的智慧」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750145
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750145,
					"content": "你要记得哦，「芭努的智慧」运行一段时间之后要休息一会儿才能再指出未来星的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750146
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750146,
					"content": "还有这本《游学者不可不知的五十件事》你也拿着，我在这本书的地图插画里标了未来星的位置，你们可以跟着地图走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750147
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750147,
					"content": "你们找到全部六颗未来星就来找我吧，我带你们一起去看大未来星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750137,
					"content": "我考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750138
					]
				},
				{
					"id": 736750128,
					"content": "这又是哪本书里的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750129
					]
				},
				{
					"id": 736750129,
					"content": "哦，这个设定的话，我觉得应该是现编的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750130
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750116,
					"content": "你没说遇到的困难是什么。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750117
					]
				},
				{
					"id": 736750117,
					"content": "这样吗？等、等一下，我找一找「没说遇到的困难是什么」的时候该背哪一段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750118
					],
					"speakerTitle": "芭努"
				},
				{
					"id": 736750104,
					"content": "什么事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750105
					]
				}
			]
		}
	]
}