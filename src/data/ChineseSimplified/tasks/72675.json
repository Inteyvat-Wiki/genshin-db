			},
			"dialogs": [
				{
					"id": 722641401,
					"content": "呶！修行开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722641402,
					"content": "开心就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "黄毛好强。砰砰，好大好圆就没了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722641404,
					"content": "因为平时有在锻炼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "呶！想和黄毛一样强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722641406,
					"content": "所以修行。修行修行，变强变强。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722641407,
					"content": "吉法师变强了以后，想干什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "报复刑部小判，呶哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722641409,
					"content": "把五百藏变成不是石头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722641410,
					"content": "加油。修行的路线就交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "呶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 722641412,
					"content": "开心就好。回头见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				}
			]
		},
		{
