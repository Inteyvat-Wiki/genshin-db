					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750302,
					"content": "不是金色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750303,
					"content": "欸！震惊！居然不是金色的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750304,
					"content": "就算你们这么说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "这么一想，虽然和你旅行的时候抓过很多晶蝶，但从来没注意过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750307,
					"content": "有种…我有种自己突然长大了，有些幻想破灭了的感觉…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750308,
					"content": "看来派蒙也需要修行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "白毛加油。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750310,
					"content": "真是的，别给我加油啦！明明是吉法师要修行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750311,
					"content": "不过，还是有点失望喔…为什么岩晶蝶的晶核不是金色的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750312,
					"content": "对。晶蝶是金色，为什么不是金色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750313,
					"content": "可能晶蝶就是这样的物种。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "嗯…没办法了。总之，按原计划行动吧。我们带吉法师看看死兆星号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750314,
					"content": "就算你们问我我也不知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "这个我也没办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
