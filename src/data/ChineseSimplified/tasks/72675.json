			},
			"dialogs": [
				{
					"id": 726750601,
					"content": "接下来，带吉法师我们去死兆星上看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750602,
					"content": "不好。船要是沉呶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750603,
					"content": "这艘船不会沉的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "我们就是坐这个船，去的稻妻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "对呀！然后，我们才认识了五百藏和吉法师。不用担心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750606,
					"content": "喔！原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750607,
					"content": "而且北斗大姐头很可靠，南十字星的人也很可靠。所以呀，这艘船就是海上最安全的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750608,
					"content": "呶！好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				}
			]
		},
		{
