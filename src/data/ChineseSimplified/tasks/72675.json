			},
			"dialogs": [
				{
					"id": 726750101,
					"content": "和雪山不同，不冷。也没有雪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750102,
					"content": "这里是孤云阁！传说是当年岩王帝君击败那个…那个…很多头的大水蛇，叫什么来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750103,
					"content": "漩涡之魔神？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "啊，对！漩涡之魔神奥赛尔！当年就是在这里，被石枪打败、镇压的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750106,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750107,
					"content": "嘿嘿，厉害吧？不过我们也和它战斗过！我们在凝光小姐的群玉阁上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750108,
					"content": "金色的晶蝶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750109,
					"content": "原来是在感叹这个喔！好好听人说话啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750110,
					"content": "毕竟和稻妻的晶蝶不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "他应该没见过不是紫色的晶蝶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#嗯…也是啦。真拿吉法师没办法。{NICKNAME}，抓个晶蝶给他看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750113,
					"content": "为什么不是你去抓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "但是，明明是你比较熟练嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750118,
					"content": "可以是可以，不过只能抓到晶核。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "好棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750115,
					"content": "会飞的明明是你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "但是，抓晶蝶还是你比较熟练嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750117,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "奥赛尔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
		},
