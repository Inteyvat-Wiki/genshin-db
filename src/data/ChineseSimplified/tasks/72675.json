			},
			"dialogs": [
				{
					"id": 726750401,
					"content": "看，死兆星号！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750402,
					"content": "好厉害！好多水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750403,
					"content": "而且，好大！好大而且在水上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750404,
					"content": "这么大，一定很重。为什么不会沉下去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750405,
					"content": "因为死兆星号是船呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750406,
					"content": "但是，泥巴船就会沉。五百藏说过。兔子、妖狸、泥巴船的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750407,
					"content": "嗯…不过，北斗的死兆星号不是泥巴做的，所以不会沉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750408,
					"content": "为什么不是泥巴，就不会沉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750409,
					"content": "吉法师说话倒是越来越流利了…不过应该怎么说呢…对了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750410,
					"content": "#哼哼，{NICKNAME}，让我考考你。为什么船能浮在水面上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750411,
					"content": "船是木头做的，草元素厉害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "欸？草元素有这样的作用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750413,
					"content": "唔…不过，为什么拿盾牌的丘丘人不能浮在水面上呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750416,
					"content": "呜呶呶，听不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750417,
					"content": "没关系，等吉法师长大以后，变得像派蒙一样聪明，就能明白了。为什么船能浮起来，为什么雪山会下雪，都能明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750418,
					"content": "我看你也不懂吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750422,
					"content": "不管怎么说，这里正好可以看到死兆星号，给吉法师留影吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750423,
					"content": "留影！画像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750424,
					"content": "嗯，没错！吉法师站好别乱跑喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750420,
					"content": "现在不用明白也行的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "有些事情不明白也行的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "浮力大于重力，船就能浮起来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "原来是这样吗！嗯嗯我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "派蒙"
				}
			]
		},
