			},
			"dialogs": [
				{
					"id": 726750801,
					"content": "你看！视线很好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750802,
					"content": "呶，好厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750803,
					"content": "那边好多山。是什么地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750804,
					"content": "嗯？那边的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750805,
					"content": "是稻妻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "没错！那边应该就是影向山。影向山下面，就是镇守之森。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750808,
					"content": "好远。五百藏在海的那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750809,
					"content": "嗯。不过，我们会陪你一起修行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750810,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750811,
					"content": "接下来，去什么地方好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750812,
					"content": "唔，有没有什么对我们来说很熟悉，又有好吃的东西的地方呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750813,
					"content": "派蒙就想着吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "好吃的东西，好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750815,
					"content": "#{NICKNAME}你看，吉法师就比较懂。吃遍世界上好吃的东西，也是很重要的修行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750816,
					"content": "如果不能理解这样的道理，吉法师很快就会超越你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750818,
					"content": "哎呀，不管怎么说，爬桅杆真累人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750819,
					"content": "白毛要爬？明明会飞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750820,
					"content": "别在意这种细节！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750821,
					"content": "总之，今天就到这里吧。接下来去什么地方，让我好好考虑一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726750822,
					"content": "呶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法师」"
				},
				{
					"id": 726750817,
					"content": "这么说来，我也饿了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "是你住的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
	]
}