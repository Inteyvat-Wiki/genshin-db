			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "咦？孩子们，你们是来找我的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830202,
					"content": "关于「鸣草」的种子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "种子…喔，你是想要把这种子，种在「尘歌壶」里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830204,
					"content": "这倒也不是不行，毕竟那大小也是一片天地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830205,
					"content": "只不过，你们今天只拿了这一包种子来，难道，你们就只打算种这一包种子吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830206,
					"content": "对、对喔！我们都不知道怎么搜集种子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830207,
					"content": "这一包种子种完了之后，我们去哪里找其他的种子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830208,
					"content": "好了，好了，别着急。我这里正好有一个我很多年前用过的小匣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830209,
					"content": "我之前移栽花卉的时候，都是用这个小匣子装的，装在匣子里的花，能够保存很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830210,
					"content": "而且，把花装在匣子里之后，这匣子还能化出几枚花种…这样，想要种植也很方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830211,
					"content": "虽然这匣子现在有些不太好用了…但至少还留着一些「化种」之能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830212,
					"content": "唔…反正我老婆子现在也没怎么用过这匣子了…就把它送给你们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830213,
					"content": "你们无论是想种些花花草草，还是想种点作物，这匣子应该都能派上些用场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830214,
					"content": "谢谢婆婆！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "谢谢婆婆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830216,
					"content": "呵呵，不用这么客气，快点去试试看吧，但侍弄花草可不是件简单的事，你们可要做好心理准备啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 721830217,
					"content": "婆婆果然很强啊…但是在试那个匣子之前，我们还是先回去壶里，试试种一下那个种子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830218,
					"content": "唔，真希望这种子能快点长大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}