			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斑目百兵卫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830101,
					"content": "这个是…种子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830102,
					"content": "这是「鸣草」的种子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830103,
					"content": "你知道这种植物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "唔，算是了解一些吧。我之前见过这种植物，也听人讲过它的奇异之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830105,
					"content": "我记得…即使是在无风的情况下，这种植物也会随着雷鸣之声微微振动来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830106,
					"content": "种出来好看吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "如果光论外表的话…应该还是挺好看的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830108,
					"content": "阁下是想试种一下「鸣草」吗？但这附近可没有什么合适的土地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830109,
					"content": "我有自己的土地。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "是、是这样吗？不愧是阁下…连封地都已经拿到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830111,
					"content": "那敢问阁下，您的封地是在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830112,
					"content": "不在稻妻内。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "喔！我也听闻过阁下在蒙德和璃月的壮举。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830114,
					"content": "那样的壮举，获赐封地也是正常，真不愧是阁下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830120,
					"content": "喂，你说的「土地」，不会是之前婆婆给我们的「尘歌壶」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830121,
					"content": "那里面，真的能种东西吗？婆婆之前也没有说过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830122,
					"content": "回去问问吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "那好吧，我们回去问问婆婆好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830124,
					"content": "仙人，是很强的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "是、是这样吗？不过婆婆确实很强就是了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830126,
					"content": "那好吧，我们回去问问婆婆好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721830115,
					"content": "在一盏壶里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "一盏…壶里？阁下，您就别和我开玩笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830117,
					"content": "我也听闻过阁下在蒙德和璃月的壮举。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830118,
					"content": "想必您的封地不是在璃月，就是在蒙德吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "斑目百兵卫"
				},
				{
					"id": 721830119,
					"content": "唉，真不愧是阁下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "斑目百兵卫"
				}
			]
		},
		{
			"id": 7218302,
			"completionStepIds": [
				7218302
