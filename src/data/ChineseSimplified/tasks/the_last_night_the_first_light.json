			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}、派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010102,
					"content": "嘿嘿，我们来啦！这里好热闹呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010103,
					"content": "这段时间大家都辛苦了，总算是将善后的工作也处理得差不多了，这才有时间组织宴会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010104,
					"content": "你也辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "我做的这些实在不算什么。而且，如果没有你们的协助，即使最终能够获胜，恐怕也会付出更多的牺牲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010106,
					"content": "我们可是你的队员呢！就不要说这种见外的话啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010107,
					"content": "嗯，说得也是。啊，老爷子准备发言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010108,
					"content": "各位战友，各位兄弟姐妹，今天我们汇聚一堂，不是为了单纯的欢庆，而是为了纪念这场来之不易的胜利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010109,
					"content": "在我们举杯之时，不要忘记那些再也无法与我们举杯同庆的人，他们以血肉为代价，兑现了誓言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010110,
					"content": "在此次的战役中，叶洛亚率领的「魇夜之莺」调查分队承担了最为艰巨的任务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010111,
					"content": "#尤其是{NICKNAME}两位，在这危难之际仍义无反顾加入我们，在作战中发挥了不容忽视的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010112,
					"content": "他们不畏牺牲，迎难而上，从危难中为我们开拓了通向胜利的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010113,
					"content": "他们的功绩，所有为了生者和未来而奋斗的人的功绩，都将被永远铭刻于历史之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010114,
					"content": "是的，我们胜利了！尽管付出了巨大的代价。我们可以流泪，可以哀悼，但绝不能被悲痛击垮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010115,
					"content": "因为我们所为之奋斗的「未来」将要到来，为了让火种传递，为了让引路的明灯继续照耀，我们还不能停下脚步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010116,
					"content": "但是，只在今日，让我们为了胜利，为了英勇不朽的战友们，也为了未来，干杯吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼基塔"
				}
			]
		},
