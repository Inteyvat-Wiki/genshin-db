						],
						"pointId": 361100061
					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "通往魔天的门扉已经开启，此等微弱的月矩力能奈我何！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011302,
					"content": "但为何我会被困囿于此…我明白了，是三宝磨又一次拒绝了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011303,
					"content": "瞧瞧是谁来了，稀客呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "爱莉厄"
				},
				{
					"id": 761011304,
					"content": "…谁在那里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011305,
					"content": "这副模样…啊，是你，雷勒。太好了，我就知道你还活着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011306,
					"content": "现在，命令三宝磨的力量臣服于我！拥有圣嗣之血的你一定能做到。毕竟和那三个废物不同，你是我最欣赏的弟子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011307,
					"content": "哈，居然把我认作了雷勒…当年那个巧舌如簧的妖僧竟然昏聩至此，真是讽刺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "爱莉厄"
				},
				{
					"id": 761011308,
					"content": "不要犹豫，雷勒。你忘记我们共同的理想了吗？你不想取回那本应属于你的地位与身份了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011309,
					"content": "为受欺凌和侮辱的人们创造「乐园」，让那些丑陋的妖精贵族都对你俯首，整个苍星王廷只有同为人类的我愿意帮你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011310,
					"content": "如今，只差最后一步我就能登上群星的阶梯…当天穹之外的「乐园」降临时，唯有你我这样的受选之人才能够活下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011311,
					"content": "那时，所有的腐败与污秽都将被洗净，这不正是你所渴望的世界吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011312,
					"content": "不，那并非他想要的世界…都到这种时候了，还在试图施展你那拙劣的骗术吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "爱莉厄"
				},
				{
					"id": 761011313,
					"content": "从一开始你就在利用他，所有的谎言都不过是为了让他替你取得三宝磨，你口中的那个「乐园」从来就只有你自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "爱莉厄"
				},
				{
					"id": 761011314,
					"content": "就连他一开始会丢掉军官的身份成为大盗，也是因为你和阿尔维斯大公共同设下的圈套吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "爱莉厄"
				},
				{
					"id": 761011315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011316,
					"content": "虽然你认错了人，不过继承了他身份与意志的我，当然也不会拒绝雷德·米勒之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "爱莉厄"
				},
				{
					"id": 761011317,
					"content": "以雷德·米勒的名义，拉乌斯万格，妖僧，「教授」，不死的毒蛇…就由我为你的故事画上最后的句点吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "爱莉厄"
				},
				{
					"id": 761011318,
					"content": "我们做到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761011319,
					"content": "这次终于，将那不死的妖魔彻底葬送了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761011320,
					"content": "「那不死的毒蛇必将两度复活，再被三次击倒…直到被月下世界的英雄们彻底埋葬…」\\n与英勇的执灯士们并肩作战，终于消灭了「教授」…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "之后，在皮拉米达城盘桓了数日…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
