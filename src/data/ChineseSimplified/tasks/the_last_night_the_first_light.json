			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "老爷子，我们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010302,
					"content": "回来就好，苦壑崖的情况怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010303,
					"content": "简明扼要地说明了情况…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "果然如此啊…从这里也能清楚地观测到，厄布拉神柱完全被深渊力量…被那不死的妖魔「教授」给控制了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010305,
					"content": "但它目前还没有太大的动作，想来是那位爱莉厄小姐在全力与之抗衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010306,
					"content": "她为我们争取来的难能可贵的时间，一点也不能浪费。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010307,
					"content": "所幸在菲林斯和大家的帮助下，准备工作已经完成得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010308,
					"content": "有了你们带回来的「螺旋剑」，「德肋庇革劳诺之箭」也就成型了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010309,
					"content": "呃…「德肋庇革劳诺之箭」是什么？是跟「银灯芯」、「螺旋剑」一样厉害的圣物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010310,
					"content": "哈哈，是比它们更厉害的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010311,
					"content": "五百年前，铸灯者力有未逮，只将那不死的妖魔封印于苦壑崖之下。但在那之后，铸灯者和初代咏月使也并未放弃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010312,
					"content": "为了在未来的某一天，彻底终结那不死的妖魔，他们用古老的技术打造了这把「弓矢」，由我们执灯人代代守护至今。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010313,
					"content": "现在终于到了让它完成使命的时刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010314,
					"content": "哦…居然有这么厉害的箭，真想看看…它长什么样子呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010315,
					"content": "傻孩子，你们早就见过了，不如说，我们就在「德肋庇革劳诺之箭」里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010316,
					"content": "啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "难、难道是要把我们一起发射出去…怎么想都不可能吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010320,
					"content": "这座麦酒大厅就是围绕「德肋庇革劳诺之箭」建造的，而你们带回的「螺旋剑」，正是它所缺失的箭头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010321,
					"content": "只要将「螺旋剑」装填进这里，就能让「德肋庇革劳诺之箭」进入发射准备了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010322,
					"content": "可这不是壁炉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010323,
					"content": "是壁炉，也是让「螺旋剑」化为「箭镞」的特殊装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010324,
					"content": "趁那「恶卵」尚未孵化…用这传承至今的「弓矢」，将它彻底葬送吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010325,
					"content": "在此期间，想必那不死的妖魔还会垂死挣扎吧，不管它送来多少爪牙，我们一定会替你们拦下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010326,
					"content": "发射「德肋庇革劳诺之箭」的重任，就交给你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 761010318,
					"content": "是要把我也发射出去吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#原来{NICKNAME}就是我们的最终决战兵器！…才不是吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "派蒙"
				}
			]
		},
