			"dialogs": [
				{
					"id": 761010201,
					"content": "叶洛亚！你可算回来了，尼基塔执灯长正等你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "奥拉维"
				},
				{
					"id": 761010202,
					"content": "欸？尼基塔…执灯长？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}，「尼基塔」不就是委托我们去找「银灯芯」的那个老爷爷吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010204,
					"content": "我记得他明明说自己只是个普通的执灯士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761010205,
					"content": "是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "老爷子可真是的…唉，你们就当是他的恶作剧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010208,
					"content": "先不说这些了，我们去向他报告情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 761010206,
					"content": "不，他怎么看都不像普通执灯士吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
		},
