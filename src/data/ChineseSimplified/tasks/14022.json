						],
						"pointId": 7889
					}
				]
			},
			"dialogs": [
				{
					"id": 140220901,
					"content": "久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220902
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220902,
					"content": "不久不久，有什么要到这里才能送呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220903,
					"content": "…来，给你这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220904
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220904,
					"content": "这是…一枚胸针？还是「千织屋」的样式。咦？我也有份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220905,
					"content": "暂时只做了这两枚，想来想去，还是决定先送给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220906,
						140220907
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220906,
					"content": "谢谢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220908
					]
				},
				{
					"id": 140220908,
					"content": "这次你们帮了我很大的忙，而且几乎一直陪着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220909
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220909,
					"content": "我有时候觉得，就算是为了不辜负你们的相信，我也不能认输。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220910
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220910,
					"content": "这次更多还是千织自己的功劳啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220911,
					"content": "这我敢肯定地告诉你，绝对不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220912
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220912,
					"content": "在「梦想」的道路上走了这么久，我已经感受到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220913
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220913,
					"content": "除了自己的信念与坚持之外，最不可或缺的，就是支持你的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220914
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220914,
					"content": "一个人能做到的事情非常有限，这次如果不是你们相助，我可能真的会一败涂地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220915
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220915,
					"content": "也没有那么夸张吧…倒是我很担心千织你在时装秀上说的那些，你就不怕之后没人来买你的衣服吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220916,
					"content": "或许我的说辞的确有些高傲，但那都是我最真诚的想法。我不会被这个世界牵着走，更别说被任何人牵着走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220917
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220917,
					"content": "我有自信，「千织屋」的衣服，一定是最好的那一个。好的东西，人们自然会追随。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220918
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220918,
					"content": "嘿嘿，那我就放心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220919,
					"content": "接下来，我们是不是该去参加庆功宴了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220920,
					"content": "嗯，当然。不过在那之前，再让我欣赏一下今晚的夜色吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220921
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220921,
					"content": "我敢肯定，这会是我来枫丹之后，所见过最美的一晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千织"
				},
				{
					"id": 140220907,
					"content": "我会好好保管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220908
					]
				}
			]
		},
