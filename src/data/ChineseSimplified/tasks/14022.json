			"dialogs": [
				{
					"id": 140220801,
					"content": "…现在怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220802
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220802,
					"content": "再往左靠一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220803
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220803,
					"content": "…这样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220804
					],
					"speakerTitle": "绮良良"
				},
				{
					"id": 140220804,
					"content": "嗯，完美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220805
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220805,
					"content": "嘿咻…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220806
					],
					"speakerTitle": "绮良良"
				},
				{
					"id": 140220806,
					"content": "哦！很合适呢！千织小姐，我能拍一张吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220807
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220807,
					"content": "当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220808
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220808,
					"content": "我都不知道千织姐你还做了新招牌呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220809
					],
					"speakerTitle": "绮良良"
				},
				{
					"id": 140220809,
					"content": "时装周前就做好了。想着等时装秀成功之后再挂上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220810
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220810,
					"content": "想要风靡提瓦特，没有一个自己的招牌怎么行？在这一点上，「刺玫会」可比你领先哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220811
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220811,
					"content": "这么一想的话，我们魔术团队是不是也该考虑设计一个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220812
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140220812,
					"content": "哥哥和我的招牌图案，分别是「怪笑帽帽猫」和「惊奇猫猫盒」。还得把佩伊加进来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220813
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140220813,
					"content": "那佩伊就是…「不笑饿饿鹅」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220814
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140220814,
					"content": "噗哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220815
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220815,
					"content": "听起来是需要在帽子里塞两只猫和一只企鹅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220816
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220816,
					"content": "哇，好像很暖和！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220817
					],
					"speakerTitle": "绮良良"
				},
				{
					"id": 140220817,
					"content": "画面好挤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220818
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140220818,
					"content": "#千织小姐！我拍好了，连带着{NICKNAME}给我的那些证据，文章明天就能登上《蒸汽鸟报》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220819
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220819,
					"content": "谢谢你，夏洛蒂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220820
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220820,
					"content": "没事没事，将真相带给观众，是一位记者应该做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220821
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220821,
					"content": "以后「温亨廷先生」的装饰，我全都免费帮你定制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220822
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220822,
					"content": "欸欸欸！真…真的可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220823
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220823,
					"content": "当然。林尼和琳妮特也别客气，以后有什么想要的演出服，随时和我说一声就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220824
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220824,
					"content": "不是演出服也行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220825
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140220825,
					"content": "那就多谢千织小姐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220826
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140220826,
					"content": "我就不要什么好处了！你平时多来串串门就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220827
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220827,
					"content": "我也不需要什么，只要千织姐以后的跨国快递继续指名我就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220828
					],
					"speakerTitle": "绮良良"
				},
				{
					"id": 140220828,
					"content": "哦，说到这个，绮良良你什么时候回去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220829
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220829,
					"content": "欸！这个…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220830
					],
					"speakerTitle": "绮良良"
				},
				{
					"id": 140220830,
					"content": "「刺玫会」专门为你准备了一辆车，可以让你坐在里面，我们推着你出枫丹哟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220831
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220831,
					"content": "那也太丢人了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220832
					],
					"speakerTitle": "绮良良"
				},
				{
					"id": 140220832,
					"content": "嘿嘿，那我们有没有什么好处呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220833,
					"content": "当然有，待会儿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220834
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220834,
					"content": "扰乱会场秩序、私自挪用会场灯光、公众场合使用武器、危险演出不报备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220835
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220835,
					"content": "呃，夏沃蕾，你听我们说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220836
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220836,
					"content": "…要是你们看见了我所描述的那些罪人，记得来向我这个特巡队队长汇报。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220837
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220837,
					"content": "报罪名开心吗？吓我一跳呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220838
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220838,
					"content": "吓一跳的是我。会场上那出下次能提前告诉我一声吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220839
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220839,
					"content": "告诉你你就会答应了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220840
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220840,
					"content": "不会，但至少能让我不被吓到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220841
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220841,
					"content": "我这不是已经补偿你了吗？灰河那处生产有害商品的黑心工坊，我人都帮你捆好放在那里。还不够贴心吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220842
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220842,
					"content": "好吧，不和你争了。今晚我认输。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220843
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220843,
					"content": "什么嘛，既然在这里的大家都是朋友，不如就待会儿一起去吃一顿吧！记在「刺玫会」的账上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220844
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220844,
					"content": "我就免了。还有一堆手续要办，你们玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220845
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220845,
					"content": "对了，千织，我路上遇到维格尔，让我给你带个话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220846
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220846,
					"content": "行了行了，肯定就是些道歉什么的，不用劳烦你。我改天上门去嘲笑他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220847
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220847,
					"content": "你还挺了解他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220848
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220848,
					"content": "这次也谢谢你了，夏沃蕾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220849
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220849,
					"content": "应该的。另外我再说一句——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220850
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220850,
					"content": "刚才的时装秀真是漂亮极了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220851
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220851,
					"content": "还用你说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220852
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220852,
					"content": "好了好了，要参加庆功宴的朝这儿看，跟我来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220853
					],
					"speakerTitle": "娜维娅"
				},
				{
					"id": 140220853,
					"content": "#{NICKNAME}，派蒙，能先到风景好的地方等我一下吗？我去和娜维娅说我们晚点到。有东西送你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220854
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220854,
					"content": "风景好的地方？哦！是那里对吧，没问题！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220855
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220855,
					"content": "嗯，我很快就来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千织"
				}
			]
		},
