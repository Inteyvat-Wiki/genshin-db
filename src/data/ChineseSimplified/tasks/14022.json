			"dialogs": [
				{
					"id": 140220701,
					"content": "…总算回到出口了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220702,
					"content": "…哦？真是意外。连下面的房间都困不住你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220703
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220703,
					"content": "厄舍！你逃不掉了！我们已经掌握了你工厂的犯罪证据！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220704,
					"content": "你又凭什么觉得，我会让证据离开这个工厂呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220705
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220705,
					"content": "又是机械警卫…你有完没完？拿这些钱去干点正事不好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220706
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220706,
					"content": "这就是我的正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220707
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220707,
					"content": "搞垮「千织屋」？还是做你的臭衣服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220708
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220708,
					"content": "是去证明「时尚」仅仅为一场可笑的闹剧，一场无知的狂欢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220709
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220709,
					"content": "…你被「时尚」这个概念套住了，厄舍。别去迎合它，做自己的东西，去改变它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220710
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220710,
					"content": "别在这对我说教！你早晚也会有一天对「时尚」低头，它说到底就只是一种舆论而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220711
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220711,
					"content": "它是人们对一种理念的向往。而「千织屋」的理念，就是绝不低头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220712
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220712,
					"content": "哼，当人们看到时尚界推崇的「千织屋」一落千丈的时候，他们就会知道这理念有多可笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220713
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220713,
					"content": "你就为了证明自己这个无聊的念头，才对我的品牌下手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220715
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220715,
					"content": "…以前的你可不是这样的，那个想做出震撼人心作品的厄舍去哪儿了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220716
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220716,
					"content": "我只是意识到那种不切实际的梦想有多么荒唐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220717
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220717,
					"content": "…你放弃了自己的梦想，现在又转过头来贬低它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220718
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220718,
					"content": "你自以为看清了一切，但…你不过是想证明自己放弃的那条路是错的，才能心安理得地过下去罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220719
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220719,
					"content": "我就直说了吧，你这样子很可悲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220720
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220720,
					"content": "可悲的是你。像个傻子一样做着什么「风靡提瓦特」的白日梦，我看你连枫丹都要待不下去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220721
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220721,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220722
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220722,
					"content": "…你说得对，或许所有追逐梦想的人都是傻子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220723
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220723,
					"content": "但更可悲的，是那些连傻子都不敢做的懦夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220724
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220724,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220725,
						140220726
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220725,
					"content": "…千织，你先走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220727
					]
				},
				{
					"id": 140220727,
					"content": "没错，这里交给我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220728,
					"content": "不，应该是你们先走才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220729
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220729,
					"content": "欸？可是…他还有枪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220730,
					"content": "没事的。你们去会场，告诉大家计划照常进行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220731
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220731,
					"content": "这里，必须由我「亲自」给他一个教训。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220732,
						140220733
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220732,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220734
					]
				},
				{
					"id": 140220734,
					"content": "…千织你一定要赶上啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220735,
					"content": "想走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220736
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220736,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140220737
					]
				},
				{
					"id": 140220737,
					"content": "看在与你合作过的份上，我一直对你手下留情，厄舍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220738
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220738,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220739
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220739,
					"content": "但「参观」完你的工厂之后，我就不那么想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220740
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220740,
					"content": "哼…还在嘴硬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220741
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220741,
					"content": "不管你经历了什么，不管你为什么会变成这个样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220742
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220742,
					"content": "用我朋友的话说——我一点都不同情你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220743
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220743,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220744
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220744,
					"content": "就让我来告诉你，「千织」这个品牌代表了什么吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千织"
				},
				{
					"id": 140220733,
					"content": "…千万小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220734
					]
				},
				{
					"id": 140220726,
					"content": "…时装秀要紧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220727
					]
				}
			]
		},
