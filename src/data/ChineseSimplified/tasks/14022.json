					"content": "万众瞩目的「枫丹时装周」隆重开幕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140201202
					],
					"speakerTitle": "时装周宣传画报"
				},
				{
					"id": 140201202,
					"content": "本届时装周汇聚了众多知名设计师。他们精心雕琢的品牌新作，也将于最后的时装秀上与大家见面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140201203
					],
					"speakerTitle": "时装周宣传画报"
				},
