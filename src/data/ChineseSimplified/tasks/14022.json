			"dialogs": [
				{
					"id": 140220201,
					"content": "你们来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220202
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220202,
					"content": "千织！衣服的制作还顺利吗？你看起来有些累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220203,
					"content": "还剩最后几道工序，已经交给爱洛芙了。应该能赶上晚上的时装秀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220204
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220204,
					"content": "这时间掐得好危险…你不去没事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220205,
					"content": "放心，我哪边都没打算输。况且今晚时装秀，厄舍工厂停业，要找证据的话这是我们唯一的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220206
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220206,
					"content": "虽然是他有错在先，但我们这么闯进去，是不是也算犯罪呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220207,
					"content": "他的工厂平时也开放参观。今天说的是停业，没说停止参观。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220208
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220208,
					"content": "我们只是好奇的顾客而已，有什么问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220209
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220209,
					"content": "你要是这么说的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220210,
					"content": "好了，厄舍的工厂就是那间。抓紧时间，该行动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220211
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220211,
					"content": "呃…怎么会开在那种地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220212,
					"content": "营销策略不同，「千织屋」主打高级定制，他主打便宜多销。可能这里租金便宜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220213
					],
					"speakerTitle": "千织"
				},
				{
					"id": 140220213,
					"content": "好吧，只是看起来阴森森的，我绝对不会去那里买衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220214,
					"content": "你说得对，待会儿也多加小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千织"
				}
			]
		},
