					"speakerTitle": "派蒙"
				},
				{
					"id": 30080620,
					"content": "妮露的花神之舞就要开场了，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080613,
					"content": "你有没有察觉到一些异样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080614
					]
				}
			]
		},
		{
			"id": 300807,
			"completionStepIds": [
				300807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300807",
							"2"
						],
						"stepId": 300807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"妮露"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080701,
					"content": "…以你的学识，我不认为你具备与我辩论的资格。你现在该做的，是尽快找人把这些可笑的布置撤掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080702
					],
					"speakerTitle": "阿扎尔"
				},
				{
					"id": 30080702,
					"content": "回去之后，让书记官在下次「识藏日」前拟定好禁止公开艺术表演的法令，届时再通过虚空公布给民众。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080703
					],
					"speakerTitle": "阿扎尔"
				},
				{
					"id": 30080703,
					"content": "是，我回去就通知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080704
					],
					"speakerTitle": "塞塔蕾"
				},
				{
					"id": 30080704,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080705
					],
					"speakerTitle": "阿扎尔"
				},
				{
					"id": 30080705,
					"content": "花神诞祭…你们就好好庆祝神明的诞生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080706
					],
					"speakerTitle": "阿扎尔"
				},
				{
					"id": 30080706,
					"content": "妮露，你还好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080707,
					"content": "啊，迪娜泽黛，大贤者居然要求我们停止演出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080708
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 30080708,
					"content": "没关系的，这也是没办法的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080709
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080709,
					"content": "明明你一直那么期待的，我不想你留下遗憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080710
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 30080710,
					"content": "的确很遗憾，但对我来说，不给大家添麻烦更加重要。大贤者已经说过可能会查办组织者了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080711
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080711,
					"content": "话虽这么说…那好吧，下次花神诞祭我们一定想办法让它圆满！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080712
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 30080712,
					"content": "下次吗，我应该…已经不在了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080713
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080713,
					"content": "嗯？你刚刚说什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080714
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 30080714,
					"content": "没什么，我要回去休息了，大家辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080715
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080715,
					"content": "那些不解风情的贤者们，居然会这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080716,
						30080717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080716,
					"content": "太可惜了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080718
					]
				},
				{
					"id": 30080718,
					"content": "欸，迪娜泽黛已经回去了吗？那我们也回去休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080719,
					"content": "花神诞祭在遗憾的氛围中被迫中止了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30080717,
					"content": "不知为何感觉也是意料之中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080718
					]
				}
			]
		},
