			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪娜泽黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080101,
					"content": "早上好，迪娜泽黛，不好意思我们迟到了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080102,
					"content": "没有，是我来得太早了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080103
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080103,
					"content": "你好像有点没精神…是没睡好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080104,
					"content": "我很好，不用担心。我们走吧？先去那边的摊位上逛逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080105
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080105,
					"content": "好啊…欸？旅行者，你在发什么呆呢，我们快走吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 300802,
			"completionStepIds": [
				300802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300802",
							"2"
						],
						"stepId": 300802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪娜泽黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080201,
					"content": "这里是卖「七鲜桌」菜品的摊位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080202
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080202,
					"content": "您可真有见识，小姐，我还以为现在没什么人知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080203
					],
					"speakerTitle": "阿玛尔"
				},
				{
					"id": 30080203,
					"content": "怎么好像都是些素的食物呀，唔，有点失望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080204,
					"content": "说起来，你刚才说的「七鲜桌」是什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080205,
					"content": "是花神诞祭的一种习俗，人们在餐桌上摆满这些菜品，用来象征须弥神明的七种美德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080206,
						30080207
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080206,
					"content": "等等…从刚才开始…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				},
				{
					"id": 30080208,
					"content": "…从灰尘上看，应该是「月亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080209
					],
					"speakerTitle": "齐米亚"
				},
				{
					"id": 30080209,
					"content": "真的吗，我怎么觉得像是某种吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080210,
					"content": "嗯…「月亮」象征着…嗯…我有点忘了，稍等下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080211
					],
					"speakerTitle": "齐米亚"
				},
				{
					"id": 30080211,
					"content": "他在偷偷翻书吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080212,
					"content": "哦，对了对了，意味着「虚幻」与「谎言」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080213
					],
					"speakerTitle": "齐米亚"
				},
				{
					"id": 30080213,
					"content": "但只要相信自己的直觉，克服心中的恐惧，太阳就一定会升起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080214,
						30080215
					],
					"speakerTitle": "齐米亚"
				},
				{
					"id": 30080214,
					"content": "似乎听过这句话…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080216,
					"content": "明白了，我会参考的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080217
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080217,
					"content": "啊…哪里哪里，我也不过是现学现卖而已，哈哈…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080218
					],
					"speakerTitle": "齐米亚"
				},
				{
					"id": 30080218,
					"content": "好像也挺有趣的，走吧，我们去下一站。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080215,
					"content": "是「既视感」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080207,
					"content": "总有种熟悉的感觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				}
			]
		},
