			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"毗伽尔",
					"迪娜泽黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080401,
					"content": "法里斯！法里斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080402
					],
					"speakerTitle": "帕奇"
				},
				{
					"id": 30080402,
					"content": "好了，兵士们，拿了雅尔达糖的奖赏，就要对小吉祥草王心怀忠诚，解散吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080403
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 30080403,
					"content": "是！法里斯骑士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080404
					],
					"speakerTitle": "帕奇"
				},
				{
					"id": 30080404,
					"content": "这是什么情况，在演戏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080405,
					"content": "花之骑士法里斯也是花神诞祭的一种象征，很受孩子们欢迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080406
					],
					"speakerTitle": "迪娜泽黛"
				},
				{
					"id": 30080406,
					"content": "要不是迪娜泽黛小姐的赞助，孩子们也没机会见到我这个花之骑士啊，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080407
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 30080407,
					"content": "哦对了，你们要不要也来点雅尔达糖果，都在这些盒子里，你们挑挑看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080408
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 30080408,
					"content": "挑？这些看上去不都一样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080409,
					"content": "哈哈，可没那么简单，每个盒子里都装着随机的一种口味，要看运气。糖果有堇瓜味，日落果味，香辛果味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080410
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 30080410,
					"content": "欸，确实很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080411,
					"content": "…然后还有蜥蜴尾巴味和鬼兜虫味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080412
					],
					"speakerTitle": "毗伽尔"
				},
				{
					"id": 30080412,
					"content": "欸！怎么会有这种味道的糖啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080413,
					"content": "唔…还是你来帮忙选吧，我要吃日落果味的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080414,
					"content": "好，这五个糖果盒，从左到右是一号到五号，你选几号呢？",
