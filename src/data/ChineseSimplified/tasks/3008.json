						30080803,
						30080804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080803,
					"content": "好像脑袋确实昏沉沉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080805
					]
				},
				{
					"id": 30080805,
					"content": "我也有这种感觉！所以我其实中午开始就放弃思考了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080806,
					"content": "既然如此，我们还是早点休息吧，就当是太累产生的幻觉…有什么事明天再想吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080807,
					"content": "「嘀——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080808,
					"content": "…知能输出略有下降，但仍在正常阈值范围内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080809
					],
					"speakerTitle": "卡瓦贾"
				},
				{
					"id": 30080809,
					"content": "继续留意数值变动，尽早查明原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎尔"
				},
				{
					"id": 30080804,
					"content": "没有思考太多，但头脑却特别疲惫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080805
					]
				}
