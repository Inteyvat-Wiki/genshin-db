			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉多米尔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710622801,
					"content": "谢谢你的食物，有什么话请跟安东连长说吧，我没什么可以告诉你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622802
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710622802,
					"content": "呃…请不要误会，我是说，关于部队机密，你明白的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622803
					],
					"speakerTitle": "拉多米尔"
				},
				{
					"id": 710622803,
					"content": "咳咳，总之…希望我们下次能作为朋友再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉多米尔"
				}
			]
		},
		{
			"id": 7106234,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
