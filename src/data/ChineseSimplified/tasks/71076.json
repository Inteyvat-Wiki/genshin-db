			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"达尼拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710622901,
					"content": "感谢你的帮助，实在抱歉没有什么能给你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622902
					],
					"speakerTitle": "达尼拉"
				},
				{
					"id": 710622902,
					"content": "安托哈他还是第一次当连长，哈…恐怕也是最后一次咯。但只要能把我们都活着弄出去，他这个连长也是合格了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
