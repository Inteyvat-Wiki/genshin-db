						],
						"pointId": 72
					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "「那里，能激活鳞石的镌刻之光，那就是许可…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890602,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "这里能够看到…看到整座圣城呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890604,
					"content": "「是啊，真是昔日辉煌可悲的残影啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890605,
					"content": "唔嗯…呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "「你想问那场审判最后的结果？呵呵…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890607,
					"content": "「说想要进行圣裁的人当然知道执掌一切光焰的主人陷入假死，只是当偶尔清醒的王真的出现在场…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890608,
					"content": "「原本聒噪不休的十三位领主和三位亲王立刻收回了他们的话语，整场闹剧般的审判不了了之…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890609,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "「再然后…其中的三位亲王死于与人类的战争，众领主中的十位消亡于圣城图兰的崩塌，一位残留于奇琴乌图…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890611,
					"content": "「唯有一位领主存活至今…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890612,
					"content": "「但想必，那并不是它想要存续的形式吧…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890613,
					"content": "「好了…继续前往圣山之心吧，那里埋藏了一切…埋藏了…旅途终末的热望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890614,
					"content": "「我在此处的使命将尽…受龙所选者，此处曾是多么美丽的地方啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890615,
					"content": "「去触碰那火鳞镌刻之光吧…去获取，通往圣山之心的许可…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890616,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "阿万尤…唔，又走了！这名字我都还没有叫上几次呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890618,
					"content": "不过，这下总算弄到了前往「圣山之心」的许可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890619,
					"content": "唔嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "这边的光…消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
