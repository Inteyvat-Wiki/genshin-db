				]
			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "「走吧，让我们看看他们把许可藏在了哪里…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890302,
					"content": "「看来它们就把东西放在那…还真是藏都不藏…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890303,
					"content": "「不过看上去只是一个空壳载体…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890304,
					"content": "呜哇，怎么突然有这么多的兽境猎犬…唔，那个许可也被…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890305,
					"content": "「大概是门口的保护没有了，所以它们得以乘虚而入了吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890306,
					"content": "那、那现在怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890307,
					"content": "「没关系，只要启动审议之庭的修复净化装置就好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890308,
					"content": "「在那里…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源龙仆"
				}
			]
		},
