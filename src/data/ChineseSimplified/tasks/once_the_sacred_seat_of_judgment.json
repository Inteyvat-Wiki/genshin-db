			"dialogs": [
				{
					"id": 751890701,
					"content": "检测到阴影大敌之威胁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890702,
					"content": "内部抵御…自动修复模式启动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890703,
					"content": "啊，没想到在这种建筑内部也有这种机关…那些魔物一下子就被消灭了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890704,
					"content": "「毕竟这座建筑是为了矗立千万年而建造的，不仅能够御敌，还可以自我修复…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890705,
					"content": "而且，金光闪闪的…真想摸一摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890706,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "「哈哈，你最好还是打消那个念头…它可认不得你是『朋友』还是『敌人』…它只会无条件地烧却碰到的所有东西。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890708,
					"content": "「…愚蠢又粗暴的做法，哼，不知道是谁设计的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890709,
					"content": "不过，我们也可以用这个打开那个罩住许可的罩子吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890710,
					"content": "值得一试…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "那我们就…想办法把这个东西升上去好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890712,
					"content": "好正经的提案…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "波嗯，呜呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "「说得没错，没想到这位白色的使者还真是深藏不露…有着这样的智慧呢，真是让人讶异。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890715,
					"content": "…我是不懂你们在惊讶什么啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "派蒙"
				}
			]
		}
