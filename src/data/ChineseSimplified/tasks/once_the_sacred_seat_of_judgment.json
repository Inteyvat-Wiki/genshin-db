			"dialogs": [
				{
					"id": 751890501,
					"content": "「我就知道你们要到这里来，所以就提前来恭迎大驾了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890502,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "「虽然我知道你只是出于礼貌，但我见到你确实很高兴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890504,
					"content": "啊，果然是你，呃，这次你又要叫什么名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890505,
					"content": "「这次的名字属于『审议之庭』的书记官，实际上在秘源龙仆被发明出来以后，他已经很少亲自动笔。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890506,
					"content": "「阿万尤…你可以这么称呼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890507,
					"content": "好吧，阿万尤，这次你是来帮我们搞定那个什么进入「圣山之心」的许可的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890508,
					"content": "「不然『圣山之心』设置的『象拟聚星』会在无许可的进入者进入的瞬间进行攻击…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890509,
					"content": "「…我提取了这具『阿万尤』的记录，进入圣山之心的许可被放置在了审议之庭之上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890510,
					"content": "「为此我不得不踏足这里…愚昧却自以为是者集合处，无能而为无能自傲者的聚集地。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "秘源龙仆"
				},
				{
					"id": 751890511,
					"content": "「也是这些家伙装模作样，审度同族的所在…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源龙仆"
				}
			]
		},
		{
			"id": 7518906,
			"completionStepIds": [
				7518905
			],
