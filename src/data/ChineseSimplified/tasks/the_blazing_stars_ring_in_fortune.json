			"trigger": {
				"objectNames": [
					"胡桃",
					"香菱",
					"钟离"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350701,
					"content": "呼——吃饱了吃饱了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350787
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350787,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350702
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 400350702,
					"content": "香菱呀，真亏你能想出那种烤鱼配蘸水的新吃法，特别是那碗蘸水，味道可真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350703
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350703,
					"content": "嘿嘿，那可是我的特制蘸水，味道当然好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350704
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350704,
					"content": "干煸绝云椒椒磨成粉，加蒜泥、葱段拌匀，再加入盐、醋、酱油，最后以滚油钓香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350705
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350705,
					"content": "看似粗犷的手法背后，是厨师对口味与调料比例的精准理解。多一分则多，少一分则少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350706
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350706,
					"content": "此谓之「精道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350780
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350780,
					"content": "嗯嗯嗯对对。怎么样香菱，夸到你心坎里了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350781
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350781,
					"content": "嘿嘿…怪害羞的呢…谢谢钟离先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350782
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350782,
					"content": "我觉得吧，我这个人已经很能说会道了，没想到跟你一比，还是不够看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350783
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350783,
					"content": "堂主何必跟我客气。堂主的口才，整座璃月港有目共睹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350784
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350784,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350785
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 400350785,
					"content": "锅巴要来点什么吗？不用客气，本堂主请你！账记香菱头上就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350786
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350786,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350707
					],
					"speakerTitle": "锅巴"
				},
				{
					"id": 400350707,
					"content": "你们又在说什么好吃的啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350708,
					"content": "哟！是旅行者和派蒙啊，什么风把你们吹来啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350709
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350709,
					"content": "慢着！先别说，让本堂主细细算来…唔，是来过海灯节的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350710
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350710,
					"content": "一看就看出来了吧，还用猜吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350711,
					"content": "哎呀，这不是跟你们熟，逗你们乐嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350712
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350712,
					"content": "你们来得刚好，我正在请大家试吃新菜呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350779
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350779,
					"content": "「三碗不过港」的老板给了好评，钟离先生和胡桃也都满意，但我总觉得，还得请更多人试试才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350713
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350713,
					"content": "怎么样，你们要吃吃看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350714
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350714,
					"content": "要吃要吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350715,
					"content": "我们是来找钟离先生的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350716
					]
				},
				{
					"id": 400350716,
					"content": "啊？不、不吃吗？好吧…那先办正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350717,
					"content": "许久不见，近来旅行可还顺利？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350718
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350718,
					"content": "还不错，长了不少见识。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350719
					]
				},
				{
					"id": 400350719,
					"content": "如此甚好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350720
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350720,
					"content": "所以呢所以呢？找咱们客卿有何贵干呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350721
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350721,
					"content": "先说好，我们今天出门也有正事要办哦！试菜只是顺便啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350722
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350722,
					"content": "办、办事，不能是往生堂的事吧？明明在过节呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350723,
					"content": "过节也有生老病死是不是？别大惊小怪的。好啦，吓唬你的，我是想着今天天气不错，出来看看街景，顺道宣传一下业务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350724
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350724,
					"content": "你们聊着吧，我跟香菱去老板那边蹭点茶喝。钟离忙完记得找我就行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350725
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350725,
					"content": "可以。堂主慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350726
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350726,
					"content": "旅行者，发生什么事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350727
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350727,
					"content": "事情是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350728
					]
				},
				{
					"id": 400350728,
					"content": "向钟离说明了刻晴的情况…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350729
					]
				},
				{
					"id": 400350729,
					"content": "玉衡星为人刚正又聪敏勤勉，自是栋梁之才。不过，凡事均有度，还是身体要紧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350730
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350730,
					"content": "有什么办法劝劝她吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350731
					]
				},
				{
					"id": 400350731,
					"content": "对呀对呀，你说话总是很有道理的样子，她应该会听你的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350732,
					"content": "我若是岩王帝君，尚能说服她几分。但我如今是一介客卿，也得考虑身份了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350733
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350733,
					"content": "何况玉衡星和我并不算熟识，冒昧进言说教，只会招人反感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350734
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350734,
					"content": "欸？那怎么办…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350735,
					"content": "旁敲侧击，或可一试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350736
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350736,
					"content": "要是有一个能让她动容的故事，就能将你要说的道理融入其中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350737
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350737,
					"content": "取材自生活，便能赢得共鸣。话中谈及亲近的人事，更能事半功倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350738
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350738,
					"content": "呃…是什么意思呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350739,
					"content": "我们去找熟悉刻晴的人问问。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350740
					]
				},
				{
					"id": 400350740,
					"content": "旅行者果真是一点就通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350741
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350741,
					"content": "寻些素材来吧。你若愿意，我也可以帮着提些建议。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350742
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350742,
					"content": "构思妥当后，将此故事经你之口说与玉衡星即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350743
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350743,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350744
					]
				},
				{
					"id": 400350744,
					"content": "玉衡星与你有交情。要说人选，你最是合适。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350745
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350745,
					"content": "原来是这样！也就是说，找刻晴认识的人多打听对吧？从谁先开始呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350746,
					"content": "原来你们在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350747
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350747,
					"content": "咦？刻、刻晴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350748
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350748,
					"content": "没想到钟离先生也在。上次「送仙典仪」还是多亏了先生帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350749
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350749,
					"content": "帮了些小忙而已，玉衡星不必客气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350750
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350750,
					"content": "你、你怎么来了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350751
					]
				},
				{
					"id": 400350751,
					"content": "怎么了？你们的表情为什么这么奇怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350752
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350752,
					"content": "莫非是我来得太突然，打扰到你和钟离先生谈话了？抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350753
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350753,
					"content": "不不，没打扰没打扰。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350754
					]
				},
				{
					"id": 400350754,
					"content": "刻晴怎么突然想到要找我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350755
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350755,
					"content": "我来，是想请你们将我引见给仙家。佳节将至，我要代表璃月七星给各路仙家送些礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350756
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350756,
					"content": "上次跟仙人们并肩作战的时候，他们不都见过你了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350757
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350757,
					"content": "既然认识，直接去绝云间就行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350758
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350758,
					"content": "一面之缘而已，仙人们或许已经记不得我了。贸然访问，怕是会惹人不快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350759
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350759,
					"content": "所以我想，请你们引见才是最符合礼数的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350760,
						400350761
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350760,
					"content": "当然没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350764
					]
				},
				{
					"id": 400350764,
					"content": "原来还要负责上门送礼，做七星可真辛苦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350765
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350765,
					"content": "我们会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350766
					]
				},
				{
					"id": 400350766,
					"content": "好，那便说定了。我先回去准备礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350767
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350767,
					"content": "大好的节日却要麻烦你陪着我东奔西跑，实在抱歉…我们速战速决，绝不耽搁你看烟花的行程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350768
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350768,
					"content": "那不如一起去看烟花吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350769
					]
				},
				{
					"id": 400350769,
					"content": "欸？一、一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350770
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350770,
					"content": "也好，等我忙完手上的事，就随你一起去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350771
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350771,
					"content": "钟离先生也是。今年的「烟花会」质量不错，先生切莫错过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350772
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350772,
					"content": "当然。多谢提醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350773
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350773,
					"content": "我先去忙了。旅行者，你准备完毕直接来群玉阁找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350774
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350774,
					"content": "走掉了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350775
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350775,
					"content": "玉衡星办事向来雷厉风行，令人安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350776
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350776,
					"content": "#钟离你也很可靠啊！对吧{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350777
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350777,
					"content": "承蒙夸奖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350778
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350778,
					"content": "刚才说的事，也请二位记在心上。等你们搜集了足够多的素材，我们可以约在此处，再做商讨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 400350761,
					"content": "刻晴没问过甘雨吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350762
					]
				},
				{
					"id": 400350762,
					"content": "甘雨这几天请假，一时半会儿找不到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350763
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350763,
					"content": "还是麻烦你吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350764
					],
					"speakerTitle": "刻晴"
				}
			]
		},
		{
