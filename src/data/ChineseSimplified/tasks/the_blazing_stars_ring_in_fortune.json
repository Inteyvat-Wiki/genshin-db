					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350602
					],
					"speakerTitle": "摆渡人"
				},
				{
					"id": 400350602,
					"content": "二位好。请问有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350603
					],
					"speakerTitle": "摆渡人"
				},
				{
					"id": 400350603,
					"content": "我想找客卿钟离…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350604
					]
				},
				{
					"id": 400350604,
					"content": "客卿跟堂主一起出门了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350605
					],
					"speakerTitle": "摆渡人"
				},
				{
					"id": 400350605,
					"content": "两个人都出门了？难、难道他们是去工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350606,
					"content": "堂主说，是去散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350607
					],
					"speakerTitle": "摆渡人"
				},
				{
					"id": 400350607,
					"content": "如果二位要找他们，可以去「三碗不过港」看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350608
					],
					"speakerTitle": "摆渡人"
				},
				{
					"id": 400350608,
					"content": "听说，堂主经常去那一带…做宣传。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摆渡人"
				}
			]
		},
		{
			"id": 4003507,
