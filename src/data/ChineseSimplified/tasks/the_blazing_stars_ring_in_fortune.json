	"talks": [
		{
			"id": 4003502,
			"completionStepIds": [
				4003502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003502",
							"2"
						],
						"stepId": 4003502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350201,
					"content": "…这份通知送去总务司，让他们把上面列出的各项工作整理安排给各部门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350202,
					"content": "转告他们，海灯节诸事繁杂，但无论大小工作都要办妥办好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350203,
					"content": "凝光小姐！嘿嘿，我们又来玩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350204,
					"content": "没有打扰你吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350205
					]
				},
				{
					"id": 400350205,
					"content": "贵客来访，怎么能说是打扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350206,
					"content": "看你们的样子，是来璃月过海灯节的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350207,
					"content": "是呀！今年海灯节你们都在忙什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350208,
					"content": "还是老样子，各种杂事。对了，总务司今年策划了一场「烟花会」，值得一看哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350221
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350221,
					"content": "海灯节向来以放飞「明霄灯」为节日重点，但最近璃月发生了许多事。我想，人们需要更多温暖与团结感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350222
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350222,
					"content": "所以我认为，至少今年我们要采取更特别也更贴近每一个人的庆祝方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350223
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350223,
					"content": "将「烟花」送至璃月各处，选择合适的时间全数点燃。让更为炽热的光与热连接起人们的情感，这便是总务司的决定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350209
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350209,
					"content": "烟花？我们在别的地方似乎也见过烟花哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350210,
					"content": "璃月的烟花有什么特别之处吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350211,
					"content": "烟花这一事物，最早是从璃月的某种发明演变而来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350212
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350212,
					"content": "璃月祖先创造烟花时，为它取名「爆竹」。它能发出强光与巨响，可用于驱赶毒蛇猛兽或是警示他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350213,
					"content": "早年人们在外耕种，联络不便。「爆竹」一物因能发出巨响，必要时会被用来传递信号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350214
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350214,
					"content": "璃月港正式建立后，人们生活好转，不再赶往百里之外的土地耕种。渐渐地，也不再靠「爆竹」防身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350215
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350215,
					"content": "但先民手持「爆竹」艰苦垦荒的精神被延续下来，作为一种习俗流传在民间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350216,
					"content": "「爆竹」便是烟花的前身。我们改良了「爆竹」，放到海灯节期间燃放，以这种形式来纪念先民们的奋斗精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350217
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350217,
					"content": "不愧是璃月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350218
					]
				},
				{
					"id": 400350218,
					"content": "真厉害…璃月的东西都好有历史渊源啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350219,
					"content": "相信你们也已经习惯了。历史越久远，土地上的每一件事物就会承载越多价值。这便是璃月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350220
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350220,
					"content": "烟花相关的事务，我交由刻晴负责了。如果你们对烟花感兴趣，就随我一同去见她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4003503,
			"completionStepIds": [
				4003503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003503",
							"2"
						],
						"stepId": 4003503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"刻晴",
					"朋义"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350301,
					"content": "唔…布置烟花的地点还得再加几个。眼光要全面，不能局限在城里，难道轻策庄的人就不过海灯节了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350302
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350302,
					"content": "但、但是大人，这样的话，预算就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350303
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350303,
					"content": "预算是什么？是「办好某件事最合适的量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350304
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350304,
					"content": "如果你认为现在的预算不够办好这件事，就向总务司提出申请，重新核算审批。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350305
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350305,
					"content": "我们的目的是办好这届海灯节，预算是为了更好地规划，不能本末倒置啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350306
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350306,
					"content": "是，我明白了，刻晴大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350307
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350307,
					"content": "嗯。安全第一，务必保证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350308
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350308,
					"content": "凝光，旅行者。难得见你们过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350309
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350309,
					"content": "旅行者是来参加海灯节的吗？刚好再过不久应该就能准备完毕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350310
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350310,
					"content": "刻晴在忙什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350311
					]
				},
				{
					"id": 400350311,
					"content": "复核烟花布置，再检查一下相关设施。算是日常的小工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350312
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350312,
					"content": "恕我直言，这类工作交给下属处理也行。你已经连轴转了好几天，也该休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350313
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350313,
					"content": "小事而已，无妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350314
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350314,
					"content": "朋义，劳烦你重新做个规划，总结成书面报告递交到总务司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350315
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350315,
					"content": "我去城里看看烟花布置点的情况，稍后回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350316
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350316,
					"content": "旅行者，你是贵客，适逢佳节，还请留在城内好好享受节日氛围。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350317
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350317,
					"content": "朋义，我交代你的事，都记住了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350318
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350318,
					"content": "是，记清楚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350319
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350319,
					"content": "好。凝光，旅行者，告辞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350320
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350320,
					"content": "凝光大人，还有这位…旅行者，我就先不打扰二位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350321
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350321,
					"content": "刻晴大人跟我讲了好多计划，我得重新去写一份计划书…抓紧时间，抓紧时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350355
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350355,
					"content": "啊对！差点忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350356
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350356,
					"content": "旅行者，这里有个「烟花筒」，刻晴大人之前提过你可能会感兴趣，让我留着它，等见到你就交给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350357
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350357,
					"content": "有动手能力的人，有了这个就能亲手调配制作属于自己的烟花了。你要是有时间，请务必试试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350322
					],
					"speakerTitle": "朋义"
				},
				{
					"id": 400350322,
					"content": "刚才我完全插不上话欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350323,
					"content": "不对，应该说，我是「完全不敢插话」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350324,
					"content": "刻晴，好强的气势…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350325
					]
				},
				{
					"id": 400350325,
					"content": "你也这么觉得对吧？刻晴的气势比之前更强了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350326,
					"content": "而且也比之前更忙…为什么呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350327,
					"content": "众仙家将璃月港交由凡人全权治理，我们七星便担起了引导民众的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350328
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350328,
					"content": "我们接手各个领域的重要工作，紧锣密鼓地安排各项事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350329
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350329,
					"content": "话虽如此，事事亲为仍很费神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350330
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350330,
					"content": "往年，海灯节相关的统筹事宜都由江舟负责。但她家中老父年迈，今年便请调去了其他部门。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350331
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350331,
					"content": "海灯节的工作，便落到了我和刻晴肩上。我担任总负责人，至于万众瞩目的「烟花会」，就交给刻晴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350332
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350332,
					"content": "兹事体大，我认为，应当托付给最可靠的人。而刻晴严于律己，又对工作充满热忱，是最佳人选。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350333
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350333,
					"content": "确实是非常严格的人呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350334,
					"content": "不错。对人对己都万分严格，以至于投入过度，连续操劳了好些日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350335
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350335,
					"content": "我认为，这不是长久之计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350336
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350336,
					"content": "过犹不及，是璃月人都该懂得的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350337
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350337,
					"content": "我不是没劝过她，但她的性格你们也知道。巧舌如簧的人遇上刻晴，也是要碰一鼻子灰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350338
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350338,
					"content": "旅行者，你跟刻晴关系不错，又见识广阔，不如也帮我劝劝她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350339,
						400350340
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350339,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				},
				{
					"id": 400350341,
					"content": "不愧是旅行者。劝说刻晴绝非易事，有你帮忙我也安心得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350342
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350342,
					"content": "我还得回群玉阁处理些事务，先行一步。刻晴的事，就劳你多费心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350343
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350343,
					"content": "凝光离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350344
					]
				},
				{
					"id": 400350344,
					"content": "你真的有办法说服刻晴吗？连凝光小姐都搞不定她欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350345,
					"content": "而且，想要说服一个人，至少得理解那个人现在的感受吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350346,
					"content": "刻晴现在应该是连续操劳，连休息日都没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350347,
					"content": "感受是…「很累」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350348
					]
				},
				{
					"id": 400350348,
					"content": "这么浅显的理解根本没用吧！再想想，更重要更深入的感受是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350349,
					"content": "或者，我们找个有心得的可靠的朋友问问吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350350,
					"content": "那就找钟离吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350351
					]
				},
				{
					"id": 400350351,
					"content": "嗯？钟离…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350352,
					"content": "他也比较了解璃月人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350353
					]
				},
				{
					"id": 400350353,
					"content": "嗯，确实很可靠！就问他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350354
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350354,
					"content": "他现在是「往生堂」的客卿，那我们就去「往生堂」找找他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350340,
					"content": "我会想个办法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				}
			]
		},
