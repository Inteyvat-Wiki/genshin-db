					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "怎么…怎么会这样，连父亲的鱼饵配方也没有用吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620302,
					"content": "不要难过，都怪那个遗迹守卫！一定是它把「海中月」吓跑了！我们再试试吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726620303,
					"content": "嗯，要不我们再试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620306,
					"content": "先算了吧，我有点累了。或许楠塔克是对的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620307,
					"content": "唉…我现在想去外面散散心，我得好好想想之后的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620308,
					"content": "这些是报酬，不管怎么说，还是非常感谢你们的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620309,
					"content": "看来鲸井小姐现在想要一个人静静呢，我们过一阵子再来看看她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
