			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鲸井椛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "你们来看！我又翻了一遍父亲的航海日志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620102,
					"content": "里面有一份附录，提到了他们曾经开发过的特殊鱼饵配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620103,
					"content": "他们遇见「海中月」那次，使用了一种混合了海草与魔晶矿的特殊鱼饵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620104,
					"content": "如果我们也能做出这个，或许能够吸引到「海中月」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620105,
					"content": "海草我倒是有很多，只是魔晶矿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620106,
					"content": "别担心，我这里有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "欸？真的吗？是在荒海那边开采的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620108,
					"content": "父亲的日志中有提到，魔晶矿一定要在荒海那边的废墟里发掘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620109,
					"content": "虽然不清楚和普通的魔晶矿有什么区别，但是既然已经决定要这么做了，我们还是严谨一些，遵循书训比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620110,
					"content": "说起来，荒海那边有很多魔物，很危险。我们去冒险家协会挂一个委托吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620111,
					"content": "不用，我来搞定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "啊…对了，我都忘了你本来就是个强大的冒险家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620113,
					"content": "有你帮忙实在是太幸运了，那就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620114,
					"content": "我先回去取一些制饵工具，稍后我们在荒海西侧的沙滩那儿汇合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鲸井椛"
				}
			]
		},
		{
			"id": 7266202,
			"completionStepIds": [
				7266204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
