			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鲸井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "这么快就找到了吗？不愧是强大的冒险家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620202,
					"content": "这些够吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "嗯，接下来看我的吧，只要这样…这样…再这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620204,
					"content": "做好了，就是这些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620205,
					"content": "接下来要做的就是把鱼饵撒下去，然后等着「海中月」出现了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726620206,
					"content": "嗯，我特意选了这个地方，当年我们就是从这里上岸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620207,
					"content": "那条指引我们返航的「海中月」，也是在这里消失的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620208,
					"content": "所以，大家准备好了吗？见到「海中月」可别忘了许愿哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620209,
					"content": "如果没有成功怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620211,
					"content": "别说丧气话，会成功的，「海中月」一定会来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620212,
					"content": "嗯！会成功的！大鱼大鱼，你一定要乖乖上钩呀！拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726620213,
					"content": "你们看！你们快看！水下在发光！有什么过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "鲸井椛"
				},
				{
					"id": 726620214,
					"content": "真的吗？真的是「海中月」来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726620215,
					"content": "呜哇——遗迹守卫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726620216,
					"content": "怎么会是这家伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
