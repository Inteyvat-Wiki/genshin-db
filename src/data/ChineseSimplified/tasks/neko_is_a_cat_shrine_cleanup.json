			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寝子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "唔喵…那个箱子果然很管用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640102,
					"content": "是汝啊。那个「塞钱箱」，确实很管用呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640103,
					"content": "汝等修好之后不久，就有两个绿绿的人类过来神社了，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640104,
					"content": "不仅往里面塞了钱，那个高高的，绿绿的人类听见奴家说话之后，还很激动。人类真是大惊小怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640105,
					"content": "「塞钱箱」真是好东西哪。如果再修一个，那就有更多人了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640106,
					"content": "事情不是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "是吗。人类的事情，还真是麻烦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640108,
					"content": "这个问题，应、应该和神社的环境有关吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721640109,
					"content": "奴家的神社怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640110,
					"content": "稍微有点乱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "哎呀，是这样吗？不过，那些小家伙们都很喜欢在落叶堆里玩啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640113,
					"content": "啊，不过仔细一想，阿响也经常用那个一头刺刺的长棍子，把树叶弄到一起。既然阿响会这么做，那一定是对的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640114,
					"content": "要打扫哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "奴家怎么会懂汝等人类的讲究嘛。唔…阿响的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640117,
					"content": "太阳还没出来的时候，阿响经常拿着那个长棍子在地上摆来摆去。奴家喜欢追着长棍子玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640118,
					"content": "但现在奴家可是「代宫司」，这种举动不合适。奴家可不是一般的小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640119,
					"content": "但是，阿响也会对地上用水。水可是坏东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640120,
					"content": "百目鬼有时候也会来，用交叉的铁片咔嚓咔嚓。然后树枝和树叶就会掉下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640121,
					"content": "「百目鬼」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "是一个好高好高，声音好大好大的人类。经常和阿响一起玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640125,
					"content": "哼！每次他都会把奴家最喜欢的那几根树枝剪掉，是个讨厌的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640126,
					"content": "听起来…真的就是「打扫」，或者说「整理」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721640127,
					"content": "扫地，洒水，还有修剪树枝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721640128,
					"content": "都是很熟悉的工作啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "这就是「打扫」吗？奴家明白了，那就拜托汝等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640130,
					"content": "对了，咔嚓咔嚓就不必了。现在的树枝，奴家很喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640131,
					"content": "长棍子落叶和水行了。汝等明白了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640132,
					"content": "交给我们吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "喵喵，这项工作可是阿响专门交付给奴家，只有奴家才能完成的重要工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640133,
					"content": "对了，「阿响」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "阿响就是阿响，是浅濑神社的宫司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640135,
					"content": "那你的名字…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "奴家叫「寝子」，名字是阿响起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 721640137,
					"content": "平常都是由阿响出面招待来神社的人，不用奴家来照顾神社。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
