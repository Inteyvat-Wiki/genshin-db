			"dialogs": [
				{
					"id": 790720101,
					"content": "#哎呀，真是荣幸。您就是那位{NICKNAME}吧，旁边这位一定是您的同伴派蒙小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720102,
					"content": "嘿嘿，没错，就是我们啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790720103,
					"content": "我们有这么出名？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "星轨王城里的消息，总是比其他地方更灵通一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720105,
					"content": "不得不说，您来得正好，我正好做完了这副名为「飞帽」的游戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720106,
					"content": "虽然我不能像那篇《飞帽匠》里的帽子匠一样，让所有人都拥有一顶漂亮的帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720107,
					"content": "但我相信，这副「飞帽」游戏，一定能将欢乐带给所有游玩它的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720108,
					"content": "我还为这款游戏设计了三种完全不同的玩法…呃，当然！规则也绝不复杂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720109,
					"content": "我相信，您只要玩上一局，就能完全理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720110,
					"content": "想要试试！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "没问题，请到这边来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德维特"
				},
				{
					"id": 790720112,
					"content": "暂时没空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "别担心，等您有空了再来找我吧，我这段时间会一直待在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德维特"
				}
			]
		}
	]
