					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "嗯…今天也是风平浪静的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400402,
					"content": "我的家族受到温妮莎大人命令，世代在此为蒙德守望风暴，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400403,
					"content": "虽然自从有了巴巴托斯大人的庇护，蒙德再也没有受到风暴的侵扰，瞭望台也逐渐废置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400404,
					"content": "但即使是这样，我还是会不由自主地想去瞭望塔上看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400405,
					"content": "辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "谢谢你，但是说到我的「职责」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400407,
					"content": "我倒宁愿永远不去真正履行它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400410,
					"content": "好了，谢谢您帮我，这些风车菊是给您的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400411,
					"content": "在之前，我的家族常以风车菊的生长程度，来判断一个地区的风力大小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400412,
					"content": "丝毫无风的地方，或者暴风侵袭的地方，都不会有风车菊存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400413,
					"content": "只有在蒙德这样温柔的风中，它才会顺利地生长。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400414,
					"content": "真希望，它们能一直这么顺利地生长下去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400408,
					"content": "是很辛苦的历史啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "是的，希望那段历史永远不再重演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "芬德"
				}
			]
		},
