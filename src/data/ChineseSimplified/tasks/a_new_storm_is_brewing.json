			},
			"dialogs": [
				{
					"id": 200400501,
					"content": "虽然她话是这么说，但是前面的怪物很多呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400502,
					"content": "我们去帮芬德小姐扫除一下周围吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400503,
					"content": "看她认真的样子，搞不好会想着直接冲过去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400504,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "嗯，认真的人就应该得到帮助呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400505,
					"content": "真有人会认真到这种地步吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "那种是最糟糕的情况啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200400508,
					"content": "为了不让这种情况发生，我们快点去扫除魔物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
