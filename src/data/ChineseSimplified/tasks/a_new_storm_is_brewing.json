					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "唉，到底怎么过去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400102,
					"content": "哦…您找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400103,
					"content": "您在这做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "我正准备去望风角的瞭望塔，去看看海上是不是有风暴在聚集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400105,
					"content": "可是前面有一群怪物挡住了路…我在思考怎么过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400106,
					"content": "哦，不用担心，我没有让您代我去瞭望的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400107,
					"content": "这是我的职责，也是我个人的坚持而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400108,
					"content": "您忙您的去吧，我自己再好好想想办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				}
			]
		},
		{
