			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芬德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "您还有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400202,
					"content": "前面已经安全了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "咦？感谢风神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400204,
					"content": "不，不对，抱歉，我应该感谢的是您才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400205,
					"content": "我该怎么回报您呢…哦，对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "芬德"
				},
				{
					"id": 200400206,
					"content": "请您来瞭望塔顶吧，我在那等着您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芬德"
				}
			]
		},
		{
			"id": 2004003,
