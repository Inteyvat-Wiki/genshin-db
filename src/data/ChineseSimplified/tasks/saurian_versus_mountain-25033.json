						250330207,
						250330208
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330207,
					"content": "加油，奇卡！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "呜？！呜呜，呜…",
					"roleType": "TALK_ROLE_NPC",
