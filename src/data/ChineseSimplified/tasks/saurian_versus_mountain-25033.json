			"dialogs": [
				{
					"id": 250330101,
					"content": "乖乖喔，今天吃饱了吗？有没有力气训练呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330102,
					"content": "呜，呜呜，呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330103,
					"content": "呜哇，这么有活力？好！那今天可要加把劲了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330104,
					"content": "一起加把劲吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "#欸？您好呀，{M#大哥哥}{F#大姐姐}！我们正在进行爬山训练呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330107,
					"content": "呜呜！呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330108,
					"content": "呜呜，呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330109,
					"content": "训练得怎么样？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "那个…至少能说「有进步」吧。这次奇卡爬的比上次高多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330111,
					"content": "就是在爬山的时候，奇卡的攀爬动作有些不熟练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330116,
					"content": "#{M#大哥哥}{F#大姐姐}，你能再为我们示范一遍吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330117,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "#谢谢你！这次我一定能看清{M#大哥哥}{F#大姐姐}的动作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330119,
					"content": "奇卡，你也要睁大眼睛喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330120,
					"content": "呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330123,
					"content": "#那就拜托你啦，{M#大哥哥}{F#大姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330124,
					"content": "#我们会在地上看着{M#大哥哥}{F#大姐姐}，算好时间的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330125,
					"content": "呜，呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330121,
					"content": "这次可要看清我的动作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "当然啦。我和奇卡都会睁大眼睛仔细看的，这次一定能看清！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330112,
					"content": "看起来它恢复得不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "当然啦。妈妈都说，我可擅长照料奇卡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330114,
					"content": "奇卡的进步可大了，爬的高度也比上次高很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330115,
					"content": "就是在爬山的时候，奇卡的动作有些不熟练…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "特拉忒"
				}
			]
