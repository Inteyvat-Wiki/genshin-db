						250330210
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330210,
					"content": "乖乖喔，奇卡。亚瓦尔叔叔说了，只要我们努力，一定能变得更厉害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330211,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330212,
					"content": "#{M#大哥哥}{F#大姐姐}，谢谢你帮忙，这枚果子给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330213,
					"content": "这是奇卡刚刚摘到的，它的动作比之前快了好多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330214,
					"content": "#嘿嘿，都是因为有{M#大哥哥}{F#大姐姐}给奇卡做榜样。奇卡才能变得这么厉害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330215,
					"content": "呜呜，呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330216,
					"content": "好啦，那我们就先回部族去找马伊塔了。唔…他现在应该在部族里吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330208,
					"content": "你们可以做到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330203,
					"content": "不是最佳成绩。",
