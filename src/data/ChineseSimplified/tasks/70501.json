			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留云借风真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "不知道这机关能不能制作甜品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010102,
					"content": "这次要做什么菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "旅行者，你来得正好。本仙刚刚想好这次要做的菜色，其名为「布丁」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010104,
					"content": "这种叫做「布丁」的菜色，是我从最近流行的食谱里看来的。据说香软可口，是款不错的甜品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010105,
					"content": "本仙在其原有做法上稍加改造…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010106,
					"content": "此外，加入了「稻米」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010107,
					"content": "改造后的这道菜理应由本仙亲自赐名，唔…就叫它「米饭布丁」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010108,
					"content": "怎么听着这么管饱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "这道甜品重在「稻米」的品质，本仙当即启动「机关烹饪神机」，令它寻找上等稻米。一路奔波，来到了此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010110,
					"content": "旅行者，来得早不如来得巧，再为本仙跑一趟，取来上等稻米吧。据机关显示，那种稻米应该离这里不远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010111,
					"content": "为什么又是我去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "调整机关费时，本仙暂时分身乏术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010114,
					"content": "你手脚麻利，是不可多得的帮手。你就再替本仙跑一趟吧，等「米饭布丁」做出来，自然少不了你的份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010115,
					"content": "总之，就有劳你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010116,
					"content": "机关烹饪神机…启！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010117,
					"content": "旅行者，本仙已启动机关，你快循着气息的踪迹，去把本仙要的那种稻米拿回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留云借风真君"
				},
				{
					"id": 705010112,
					"content": "您自己不是会飞吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布伦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "谢谢你们，谢谢你们救了我…我叫布伦，是个商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010202,
					"content": "唉…真是倒霉。我本来正在运一批货物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010203,
					"content": "但没想到…才走到半路，突然被一群魔物袭击了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010204,
					"content": "我一个劲地向前跑，顾不上车里的货物，也来不及辨认方向…一直跑到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010205,
					"content": "到了这里之后，我还以为彻底甩掉它们了，就想要下车清点一下货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010206,
					"content": "但是它们突然又不知道从哪钻了出来…幸好有你们帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010207,
					"content": "你运的是什么货物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "我运的是一批食材，稻米之类的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010209,
					"content": "看来这就是那位仙人要我们找的稻米了，但是，看起来好像也没剩下多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705010210,
					"content": "能卖一些稻米给我吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "你要买稻米？不是我不卖，只是…我在逃跑的时候，车上的货物基本上都丢在路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010212,
					"content": "现在那些魔物只怕是把这些货物当做战利品，搬回它们的营地里去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010213,
					"content": "我也正在头疼，怎么才能把那些货物拿回来，要是拿不回来的话，这趟生意我可就亏惨了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010214,
					"content": "旅行者…我看你刚才的身手很好，你能帮我去拿回这些货物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010215,
					"content": "要、要是你愿意帮我的话！你要的稻米，你要多少我就送给你多少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010216,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "谢谢你！那就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010220,
					"content": "你带着我的货运热气球去吧，把那些货物放在这上面就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010221,
					"content": "那就拜托你了，旅行者，我就在这等着你，拿到货物之后，就拿回来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010218,
					"content": "我应该拿不动那么多货物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "没关系，这个我有办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "布伦"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050107",
							"2"
						],
						"stepId": 7050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布伦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "你把货物拿回来了吗？谢谢你，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010302,
					"content": "你之前说…想要稻米，对吧？请你稍等一下，我挑一些品质比较好的给你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010303
					],
					"speakerTitle": "布伦"
				},
				{
					"id": 705010303,
					"content": "好了！这些稻米给你，应该足够你用了。",
