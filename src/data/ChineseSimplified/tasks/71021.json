			"dialogs": [
				{
					"id": 710210101,
					"content": "这岛这么远，我可怎么过去啊…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210102,
						710210106
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710210102,
					"content": "用风之翼吧。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "算了吧，我去了教令院之后，就一年到头呆在屋内，基本上不去室外活动。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710210104,
					"content": "而且在教令院也基本用不上风之翼，我那些风之翼的操作已经全还给考官了…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710210105,
					"content": "要我用风之翼飞过去，飞一半我就要掉水里…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710210106,
					"content": "雇船吧。$UNRELEASED",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "我也这么想，我记得荆夫港那里可以雇到船，但是那里也太远了。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710210108,
					"content": "这一来一去也不知道要花多少时间…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "亨利莫顿"
				},
				{
					"id": 710210109,
					"content": "但是我总不能自己造一艘吧，这教令院里也没教过啊…$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亨利莫顿"
				}
			]
		}
	]
