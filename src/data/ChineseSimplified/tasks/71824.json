			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲尔戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "旅行者，有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240202,
					"content": "关于小冥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "你说她啊，自从上次那件事之后，她就安稳很多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240204,
					"content": "不过，那孩子倒也可怜，之前逢年过节，客栈越是热闹，她就越落寞，所以才经常捣乱，吓坏了客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240205,
					"content": "但她应该也只是想有人陪着她玩吧，毕竟，她也只是个孩子而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240206,
					"content": "能送盏霄灯给她吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "给她送霄灯？嗯…这个主意倒还不错，不过那孩子很难找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240209,
					"content": "如果想找她的话，你就在晚上去旁边的树林里，把霄灯挂在树梢上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240210,
					"content": "这样的话，她应该就能看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240207,
					"content": "不知道她喜不喜欢霄灯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
