			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "得再加紧点了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240102,
					"content": "生意这么好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "没有。这不是正过节吗？客栈里一堆人回去过节了，干活的人少了一堆，活差不多都得我自己来做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240104,
					"content": "还好，客人不算太多，我一个人还顶得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240105,
					"content": "咳，我还得谢谢你，上次帮我那个忙，要不是你，我现在估计都没法正常开工…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240106,
					"content": "你最近还…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "没有！绝对没有，相信我，绝对没有！要再来一次，我绝对受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240109,
					"content": "你要是真想打听那件事…她的话，就去问问老板吧，我是真…真不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240107,
					"content": "那她最近…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
