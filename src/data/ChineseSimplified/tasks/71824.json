			"dialogs": [
				{
					"id": 718240301,
					"content": "怎么样，你们把霄灯送过去了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240302
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240302,
					"content": "应该…算是送过去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "嗯，这样就最好了，这样那孩子应该也会高兴一些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "菲尔戈黛特"
				},
				{
					"id": 718240304,
					"content": "不知道…那孩子会许什么愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲尔戈黛特"
				}
