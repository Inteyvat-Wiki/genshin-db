			"trigger": {
				"objectNames": [
					"凯万",
					"荷贝特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "你就通融一下嘛，我是真心来求你办事的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040102,
					"content": "没什么好说的，我不能让步，请回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040103,
					"content": "哇啊，这两人怎么吵起来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731040104,
					"content": "哟，异乡人，能帮我说服这位小姐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040105,
					"content": "今天她突然找过来，一直缠着我，说是想让我帮忙钓一批古董。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040106,
					"content": "吓跑了我的鱼不说，还想占用我接下来的时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040107,
					"content": "我说啊小姐，你这么心急，难道是想借这批古董发财？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040108,
					"content": "不是的，凯万先生，我是教令院合作方的雇员荷贝特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040109,
					"content": "那些古董都是教令院搜集来用做研究的，我负责管理它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040110,
					"content": "但就在昨天，运输文物的小船出了点意外，有几件文物掉进了河里，被水流冲到了下游来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040111,
					"content": "那你去找专业的捕捞队啊！你找我一个钓鱼的人干嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040112,
					"content": "找捕捞队就太慢了，我之前听人介绍说，「鱼钩上的绝景」凯万先生几乎每天都能钓到失物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040113,
					"content": "而且你也经常在这片流域钓鱼，所以我想要请你下杆，看看能不能把文物给…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040114,
					"content": "完全是病急乱投医啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "咳咳，荷贝特小姐，我对你的遭遇表示同情，但我只是一个钓鱼的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040118,
					"content": "我下杆只为了钓鱼，也只可能钓上来鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040119,
					"content": "明明一条鱼都没钓上来过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731040120,
					"content": "咳！我一直抱着这样的想法练习钓鱼的技巧，从没想过用这门本领干别的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040121,
					"content": "所以你还是去请其他人比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040122,
					"content": "欸…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040123,
					"content": "那不然…这样好了，我不求你帮我钓到失物，只需要你换个地方钓鱼，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040124,
					"content": "你就当…就当是我付钱请你钓鱼啦！拜托你了，拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040125,
					"content": "我说你们啊，我可是一个渔夫啊！渔夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040126,
					"content": "换一个地方钓鱼也不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "拜托拜托，你看，我报酬都准备好了，你就帮帮我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040129,
					"content": "真是受不了你们…行吧，就当是换个心情了。你要我在哪里钓鱼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040130,
					"content": "太谢谢你了，跟我来就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040131,
					"content": "和之前一样，旅行者，麻烦你们帮我找找鱼饵的材料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040132,
					"content": "我想想…这次的特别材料是薄荷，不过需要从我常去的地方采集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040133,
					"content": "我把大概的位置给你标注在地图上，那就拜托你了啊。等你把东西拿过来，我会给你详细算清楚报酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040134,
					"content": "我先跟着荷贝特小姐去钓鱼点了，待会儿在那边碰头吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040127,
					"content": "渔夫也会钓到各种东西啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "如果是凯万下杆的话，确实…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "我下杆只是为了钓到大鱼好吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "凯万"
				}
			]
		},
