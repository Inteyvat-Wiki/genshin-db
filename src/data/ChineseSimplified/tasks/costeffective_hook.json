					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凯万",
					"荷贝特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "动作挺麻利嘛，辛苦了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040402,
					"content": "请赶快开始吧，不然那些文物…呃…那些鱼都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040403,
					"content": "别心急，要感受水流的韵律，下杆时的心态要平和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040404,
					"content": "让我试试看吧，在这里能钓上什么大鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040405,
					"content": "凯万制作了鱼饵，开始了垂钓",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "漫长的等待后，凯万钓到了一个湿漉漉的包裹",
