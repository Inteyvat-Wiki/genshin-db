					"nextDialogs": [
						731040416
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040416,
					"content": "有个地方的香辛果特别好，我给你标注一下位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040417,
					"content": "我们就先动身了，在下一个钓鱼点会合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯万"
				}
			]
