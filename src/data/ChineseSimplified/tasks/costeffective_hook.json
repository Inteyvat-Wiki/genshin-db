					"nextDialogs": [
						731040413
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040413,
					"content": "唉，快点出发吧，我还想快点回去清清静静地钓鱼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "凯万"
				},
				{
					"id": 731040414,
					"content": "没问题，请跟我来吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "荷贝特"
				},
				{
					"id": 731040415,
					"content": "旅行者，这次的特别材料就改成香辛果吧，我的直觉告诉我，这种材料最合适。",
