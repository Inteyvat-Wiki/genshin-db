						"sceneId": 3,
						"position": [
							2107.945,
							108.778,
							11199.08
						],
						"pointId": 13476
					}
				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "（哥伦比娅…不在吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "在找我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350103,
					"content": "呜哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350104,
					"content": "吓我一跳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "感觉到你来了，就想试试能不能从背后接近你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350107,
					"content": "你好像很闲欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350108,
					"content": "唔…有吗？和以前也差不多吧。在「愚人众」的时候也没什么特别要干的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350109,
					"content": "女皇需要的只是「月神」的力量，没派我出去抢过「神之心」什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350110,
					"content": "那你平时会做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "散散步、看看月亮，偶尔唱唱歌，但后来桑多涅不让我唱，我就唱得少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350112,
					"content": "咦？她不喜欢吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350113,
					"content": "不是的。她说我唱得很好听，但那时我加入「愚人众」不久，她说其他人听到我唱歌有时会紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350114,
					"content": "说在不知道的人看来，我就像要…使用什么能力一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350115,
					"content": "原来如此…我大概能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350116,
					"content": "啊，还有一个原因。她说自己晚上基本都在搞研究，白天我唱歌会碰上她补觉的时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350117,
					"content": "（这才是主要原因吧！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "所以，后来我就只在晚上到桑多涅门口去唱歌。但还是被她赶走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350119,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350120,
					"content": "你和其他人相处得好吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "「相处」吗…唔…刚认识的时候，阿蕾奇诺似乎很想和我「相处」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350122,
					"content": "她总是悄悄出现在我后面，就像刚才那样。说是想…「试探」一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350123,
					"content": "我也试着和她玩一样的游戏，但她总在我还离很远的时候就转过头来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350124,
					"content": "直到有次我不得不利用「月亮」的力量，才总算突然到她身后吓了她一跳。但那之后她就不和我玩这游戏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350125,
					"content": "（「仆人」恐怕一开始就没想过这是「游戏」吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350126,
					"content": "「博士」也经常叫我去配合他做一些有关「光界力」的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350127,
					"content": "我去过几次，但不是用月矩力打打这个，就是用月矩力操纵那个。很无聊，后来就没去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350128,
					"content": "看来你今天心情不错…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "嗯，虽说是「离家出走」，但过去也有些愉快的回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350131,
					"content": "阿蕾奇诺和桑多涅对我都不错，还有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350132,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350133,
					"content": "（她的表情…是想起了谁…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "把手给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350135,
					"content": "…欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "我想起罗莎琳教过我…要记得对别人表示感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350138,
					"content": "谢谢你今天来听我说这些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350139,
					"content": "这没什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "（这是…月神的赐福？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "今天就聊到这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350142,
					"content": "结束得好突然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350143,
					"content": "嘘…派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "好吧，你说得对，那今天就先不打扰她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350144,
					"content": "她可能想起了一些往事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "…为什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "聊了很多以前的话题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "为什么要从背后出现…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}