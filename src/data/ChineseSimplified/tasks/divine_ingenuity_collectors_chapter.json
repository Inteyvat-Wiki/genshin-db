			"trigger": {
				"objectNames": [
					"宏朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706740101,
					"content": "怎么这次跑到蒙德来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740102,
						706740103
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740102,
					"content": "宏朗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				},
				{
					"id": 706740104,
					"content": "旅行者！真是太巧了，没想到会在这里遇见你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740105
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740105,
					"content": "至于现在的情况…看看旁边这道门，你应该差不多明白了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740106,
						706740107
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740106,
					"content": "上次的那种秘境又出现了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740108,
					"content": "没错。多亏了你上次帮忙探索了那处秘境，我们得到了很多宝贵的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740109
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740109,
					"content": "不过…虽然协会也已经帮忙四处调查，但几乎没有从外界找到更多有价值的信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740110
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740110,
					"content": "我们正准备派出更多人手探索，甚至联系了其他协会的人来帮忙，这个秘境却突然消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740111
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740111,
					"content": "直到今天，它才突然出现在了蒙德…多亏了蒙德冒险家协会的兄弟传来了消息，我才能第一时间赶来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740112
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740112,
					"content": "你们开始探索了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740113
					]
				},
				{
					"id": 706740113,
					"content": "那是当然，秘境就摆在面前，我们可没有退缩的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740114
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740114,
					"content": "这个秘境的「规则」似乎没有变太多，依然是根据进入者的念头而拟想出某种物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740115
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740115,
					"content": "但在探索过程中，我们发现…这处秘境居然可以变化出一些「敌人」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740116
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740116,
					"content": "这些「敌人」会对我们发动攻击，被攻击到后，我们也会感受到真实的痛感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740117
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740117,
					"content": "怎么说呢…简直和真实的「战斗」没什么两样了，冒险家们对这件事也十分感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740118
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740118,
					"content": "但是，有些冒险家连自己拟想出的「敌人」都打不过，还要别人帮他搞定，真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740119
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740119,
					"content": "咳！不说这些了，旅行者，如果你愿意的话，就再和我们一起探索这处秘境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740120,
						706740122
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740120,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740121
					]
				},
				{
					"id": 706740121,
					"content": "哈哈哈，那太好了！有你帮忙，我们的工作一定能事半功倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740122,
					"content": "我不会遇见啥危险吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740123
					]
				},
				{
					"id": 706740123,
					"content": "呃…以你的身手，只要提高警惕，应该不会有问题的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740124
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740124,
					"content": "总之，如果你愿意的话，就帮我们探索一下这处秘境吧，有你帮忙，我们的工作一定能事半功倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740107,
					"content": "是你一直在研究的那种秘境？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740103,
					"content": "这是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				}
			]
		}
	]
}