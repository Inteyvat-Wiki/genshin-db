			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"罗尔夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "躲远点，伙计！这地方很危险，一会要是「狂猎」出现了，我可没余力保护你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920102,
					"content": "你怎么知道会有「狂猎」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "作为执灯人，应对「狂猎」灾祸是我的职责，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920104,
					"content": "看见旁边这个汐印石了吗？为了确保对「狂猎」的清剿万无一失，我得在这盯上三天三夜才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920105,
					"content": "汐印石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "汐印石是我们执灯人为了驱散「狂猎」气息所设置的封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920107,
					"content": "虽然我也不清楚其中的原理，不过通常来说，出现过「狂猎」的地方所残留的气息，很容易把它们再次引来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920108,
					"content": "因此在击退「狂猎」后，我们便会设置这种汐印石。若是附近再有「狂猎」出现，它也能在战斗中护佑我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920109,
					"content": "我可不怕什么「狂猎」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "虽然不知道你哪来的这种自信，不过「狂猎」可不是能随意应对的敌人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920111,
					"content": "听我一句劝，遇到有这种汐印石的地方，还是小心谨慎为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗尔夫"
				},
				{
					"id": 760920112,
					"content": "不打扰了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "好的，路上小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "罗尔夫"
				}
			]
		},
