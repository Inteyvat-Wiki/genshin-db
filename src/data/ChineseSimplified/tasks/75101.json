			"dialogs": [
				{
					"id": 751010101,
					"content": "哦哦，这样才正常嘛…那种和七天神像建立稳固联系的感觉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751010102,
					"content": "所以之前七天神像不正常，果然是因为夜神之国里有那个坏家伙！看来七天神像之前也很辛苦呢…你很努力了，七天神像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751010103,
					"content": "虽然和火元素共鸣的力量也不是你给的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751010104,
					"content": "嗯，是和火神共同战斗时候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751010105
					]
				},
				{
					"id": 751010105,
					"content": "#是呀，那个时候我可担心了…不过果然还是{NICKNAME}更强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010106
					],
					"speakerTitle": "派蒙"
				},
				{
