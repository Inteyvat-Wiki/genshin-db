				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80050301,
					"content": "刚才那些是…为什么忽然袭击我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050302,
					"content": "「黑蛇骑士」，曾隶属于坎瑞亚宫廷卫队。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050303
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050303,
					"content": "等等！宫廷卫队…他们曾经是你的下属吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050304,
					"content": "曾经是。可如今他们身上那强烈的诅咒气息，还有舍弃了所有荣耀的战斗方式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050305
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050305,
					"content": "…已经是深渊的爪牙了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050306,
					"content": "…先前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050307
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050307,
					"content": "啊，戴因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050308,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050309
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050310
					],
