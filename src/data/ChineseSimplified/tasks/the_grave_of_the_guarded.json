			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80050101,
					"content": "这边有一些丘丘人生活的痕迹，会是委托里涉及到的那些丘丘人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050102,
					"content": "委托？说起来，你们还没告诉我…为何你们会出现在这里，一般的旅行者可没理由涉足层岩巨渊之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050103
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050103,
					"content": "我们是接到冒险家协会的委托，来调查层岩巨渊内丘丘人反常聚集的事件的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050104,
					"content": "一路下来，终于在这里发现了线索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050105,
					"content": "你们想要答案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050106
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050106,
					"content": "欸？戴因知道些什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050107,
					"content": "碰巧知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050108,
						80050109
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050108,
					"content": "我怎么没发现？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050110
					]
				},
				{
					"id": 80050110,
					"content": "你们无法察觉异样也情有可原。此地的怪异，其实在于…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050111
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050111,
					"content": "…这里的环境正在削弱「诅咒」的效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050112
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050112,
					"content": "诅咒！我记得之前说过，戴因作为坎瑞亚的国民，身中不死诅咒什么的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050113,
					"content": "几百年来，诅咒带来的苦痛依旧每天都在纠缠我。而来到此地，身体却感觉得到了片刻的喘息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050114
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050114,
					"content": "此时此刻，我的身体也正在向我表达着强烈的意愿，那就是——「留下来」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050115
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050115,
					"content": "削弱诅咒…这里为什么会有这样神奇的效果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050116,
					"content": "这也是我想要查明的，不过据我所知，深渊教团还尚未拥有实现类似效果的技术。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050117,
						80050118
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050117,
					"content": "也就是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050119
					]
				},
				{
					"id": 80050119,
					"content": "嗯，你知道为何丘丘人都戴着面具么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050120,
						80050121
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050120,
					"content": "我有所了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050122
					]
				},
				{
					"id": 80050122,
					"content": "因为它们都在回避着自己如今的面貌，害怕着水中的倒影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050123
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050123,
					"content": "毕竟那和它们记忆中的自己相比，太过丑陋，也太过绝望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050124
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050124,
					"content": "果然丘丘人也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050125
					]
				},
				{
					"id": 80050125,
					"content": "不死诅咒其实…也并非真正永久的「不死」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050126
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050126,
					"content": "难道还有逆转的机会吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050127,
					"content": "不。而是在「磨损」的作用下，灵魂与肉体依旧会被消磨殆尽，哪怕不是以「死亡」这一形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050128
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050128,
					"content": "当那些丘丘人意识到自我的终结将至，似乎会本能地找寻一个安静又黑暗的角落，与几百年来的苦痛道别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050129
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050129,
					"content": "而能够削弱诅咒效果的此地，对它们来说一定是最好的灵柩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050130
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050130,
					"content": "居然…会是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050131,
					"content": "闲聊到此为止，警戒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050132
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050132,
					"content": "怎么、怎么了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80050133,
					"content": "敌袭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80050121,
					"content": "我不太清楚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050122
					]
				},
				{
					"id": 80050118,
					"content": "来到此处的丘丘人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050119
					]
				},
				{
					"id": 80050109,
					"content": "和那座倒着的城市有关么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050110
					]
				}
			]
		},
		{
			"id": 800503,
			"completionStepIds": [
				800503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
