				]
			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "咦，刚才那是，绒、绒翼龙？还真的是绒翼龙把雕像偷到这个地方来的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480202,
					"content": "等等，它是不是直接抓着那个雕像跳下去了，跳进了，火山口里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480203,
					"content": "那里就是火山口…还挺壮观的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480204,
					"content": "唔，之前问路的时候，不是说火山口聚集了海量的气态燃素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480205,
					"content": "对哦！<color=#00E1FFFF>穿越气态燃素的办法</color>，就像…刚才的绒翼龙那样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480206,
					"content": "不过，呜，这么高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480207,
					"content": "没关系，我会抱住派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "咦，你也愿意吗？真的吗…好、好吧，既然这样好像也没有那么害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480214,
					"content": "而且，不仅仅是高，别忘了那些气态燃素呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480215,
					"content": "唔，等、等准备好，我们就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480210,
					"content": "只要落地瞬间派蒙能拉住…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "拉不住啦，先不说我有没有那么大的力气，什么叫落地的瞬间嘛，这个时机的把握也太难了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480212,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "你也是，不许跟着瞎起哄。唉…被你们这么一闹，一点紧张感都没有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "派蒙"
				}
			]
		},
