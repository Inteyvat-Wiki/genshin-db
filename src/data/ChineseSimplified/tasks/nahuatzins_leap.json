			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751480101,
					"content": "受龙所选者，啊，受龙所选者啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480102,
					"content": "登上冠冕之顶，跃入圣山之火吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480103,
					"content": "去揭开吧，去揭开金印，揭开亿万余火的焰光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480104,
					"content": "唔嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "怎么了，难道又看到什么奇怪的话？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480106,
					"content": "感觉…更加清晰了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "咦，是因为靠近了火山的关系吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480109,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "…看起来就像是，那个一直跟你们说话的人就在火山里一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480111,
					"content": "不过既然靠近火山的时候又能看到那些东西，就说明我们没有走错路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480112,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "感觉…距离更近了一些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
