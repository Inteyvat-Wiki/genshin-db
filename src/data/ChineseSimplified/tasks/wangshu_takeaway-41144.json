						411440303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440303,
					"content": "哼，来得正好，有个叫铃官的客人在我这点了一份松茸酿酒卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440304,
					"content": "她让我晚些时候送到荻花洲西北面的一个地方，钱已经付好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440305,
					"content": "怎么样，如果你有空的话，就帮忙送过去吧，报酬少不了你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
