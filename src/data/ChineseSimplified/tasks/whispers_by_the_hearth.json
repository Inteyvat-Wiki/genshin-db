			"dialogs": [
				{
					"id": 742500201,
					"content": "多谢桑多涅女士的款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500204,
					"content": "嗯，您慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500203,
					"content": "茶会时间该结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
