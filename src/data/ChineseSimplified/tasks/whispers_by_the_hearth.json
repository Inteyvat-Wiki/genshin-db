			},
			"dialogs": [
				{
					"id": 742500101,
					"content": "这么想想，以前你们到至冬时，都没这样好好地招待过你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500102,
					"content": "请别这么说，桑多涅女士。即便那时没像这样一起坐下来聊天，但您每次都为我们准备了美味的茶点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500103,
					"content": "哎，抱歉。以前在那边太忙了，下次你们去的时候会多照顾你们一些的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500104,
					"content": "你以前也从不给我玩你发明的机械。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500105,
					"content": "那是其他原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500106,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500107,
					"content": "其实「父亲」大人也和我们说过，尽量不要打扰桑多涅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500108,
					"content": "没事，我不在意。下次多来我这边喝点下午茶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500109,
					"content": "真的吗？我其实…一直都想让您帮我看看佩伊…有些改进的方向想向您请教。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500110,
					"content": "好啊，这可是我的专业领域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500111,
					"content": "…谢谢桑多涅女士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500112,
					"content": "当「执行官」真的很辛苦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500113,
					"content": "你要这么问的话…是有点吧。要考虑的事情很多。尽管工作中更多不爽的地方是来源于同事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500114,
					"content": "也就是说…与他人的相处很重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500115,
					"content": "算是吧。我看林尼在这方面应该没什么问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500116,
					"content": "哈哈，不敢不敢，桑多涅女士抬举我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500117,
					"content": "你想成为「执行官」吗？算了，这话题不应该我来问。当我没说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742500118,
					"content": "嗯…这话题对我来说还有些远呢。或许以后再想也不迟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500119,
					"content": "当「执行官」是不是就没时间和我们一起行动了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 742500120,
					"content": "如果是这样的话…难道说…我和琳妮特也必须成为「执行官」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 742500121,
					"content": "你们两个，说了这是以后考虑的问题啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500122,
					"content": "而且，不论到哪里，我都不会抛下你们的，这我保证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 742500123,
					"content": "哈…有时真羡慕你们这一家子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
