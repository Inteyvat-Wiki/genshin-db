						"position": [
							1803.217,
							240.145,
							10366.37
						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "重修库塔尔神像？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180302,
					"content": "正是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180303,
					"content": "她不再是没有翅膀，只能孤独望着天外之月的「库塔{RUBY#[S]月之少女}尔」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180304,
					"content": "我们见证了她舒展双翼的模样，知晓了她重获生命的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180305,
					"content": "所以，与之相对，神像也该好好修缮一番了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180306,
					"content": "听着倒是不错呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180307,
					"content": "你告诉霜月之子其他人了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "嗯。我为大家讲述了月神的牺牲与重临。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180309,
					"content": "以及在那片柔光的引领下，我们是如何对抗那污染世界的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180310,
					"content": "对于月神回归这件事，众人无不喜悦。我便借此机会传达了哥伦比娅的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180311,
					"content": "她想将我们视作家人，也想被我们看作是家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180312,
					"content": "大家怎么说？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180314,
					"content": "月神大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "索妮齐娅"
				},
				{
					"id": 761180315,
					"content": "把月神大人当家人这件事…真的不会太僭越吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "洛乌佳"
				},
				{
					"id": 761180316,
					"content": "我相信，这正是哥伦比娅内心真实的愿望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180317,
					"content": "（咏月使大人竟然真的直接叫月神大人「哥伦比娅」！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "库涅贡妲"
				},
				{
					"id": 761180318,
					"content": "诸位或许仍能记得，我前些时日说过的那句话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180319,
					"content": "「路当以真相铺就，当由我们自己铺就。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180320,
					"content": "我不会要求每个人都与我做出同等选择，但在今日，我也有一句良言想与各位分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180321,
					"content": "「如果想要邀请月光驻留，首先便需打开紧闭的门户。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180322,
					"content": "…就是这样，根据这几天的情况来看，似乎比我预期的还要乐观一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180323,
					"content": "菈乌玛大人，新一批石材已经运到仓库了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "马西捷"
				},
				{
					"id": 761180324,
					"content": "知道了，我马上过去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180325,
					"content": "刚才我说的话，包括你见到的这些景象，能暂时对哥伦比娅保密吗？我想为她准备一个惊喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 761180326,
					"content": "我知道是好心啦，但你们月神和信奉月神的人还真是喜欢惊喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180327,
					"content": "我们会守密的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "那个，菈乌玛，封口费…我是说，今天的飨月餐还有没有多余的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180329,
					"content": "哈，我来为两位准备。对了，还有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈乌玛"
				}
			]
		},
