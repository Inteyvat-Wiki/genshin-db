			"dialogs": [
				{
					"id": 761180101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180102,
					"content": "你有没有闻到一股好香的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180104,
					"content": "哥伦比娅一个人在胡吃海喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}，派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180106,
					"content": "她吃得好开心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180107,
					"content": "你们要不要也尝一点？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180108,
					"content": "你吃你吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "难得看到你在这里吃东西的样子，是你特意从外面买回来的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180110,
					"content": "是菈乌玛送来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180111,
					"content": "噢！她还是很照顾你的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180112,
					"content": "前提是我不能离开这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180113,
					"content": "这是软禁吧？！你就被这些东西收买了吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180114,
					"content": "她还带了些有趣的书本、精巧的玩具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180115,
					"content": "简直像出差的妈妈和留守家中的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180116,
					"content": "菈乌玛解释原因了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "她让我最近都别出门，尤其不要去霜月之子那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180118,
					"content": "我问了来送餐的小动物们，但它们也受到了菈乌玛的指示，每一只都保持着沉默。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180119,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180120,
					"content": "我猜她可能是在准备什么吧，和我有关的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180121,
					"content": "放心吧，我原本也不觉得待在这里有什么无聊的。饭菜好吃，合我胃口，不出门也挺好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180122,
					"content": "况且，如果是霜月之子的大家在准备什么的话，我更不该出于好奇心而去打乱大家的计划。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180123,
					"content": "要不我们去探探口风？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "是啊，说得我也好奇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180125,
					"content": "可以呀，不过你们最好做点心理准备哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180126,
					"content": "她恐怕猜得出你们会来见我，可能什么都不会对你们讲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
