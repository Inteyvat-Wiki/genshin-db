			"dialogs": [
				{
					"id": 761180401,
					"content": "你们回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180402,
					"content": "哥伦比娅，你猜得一点没错，菈乌玛她什么都没和我们说呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180403,
					"content": "她好像挺忙碌的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "这几天我们会在这里陪你的！你就好好期待吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180405,
					"content": "期待什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180406,
					"content": "呃…！没，没什么，我们也不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180407,
					"content": "呵呵…好吧，那我就先期待有你们相伴的这几天吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180408,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "长翎鹮"
				},
				{
					"id": 761180409,
					"content": "噢！送菜的来了。欸？菜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180410,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "长翎鹮"
				},
				{
					"id": 761180411,
					"content": "它说「时间到了」。你们知道是什么意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180412,
					"content": "噢噢噢我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180413,
					"content": "哥伦比娅。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180415,
					"content": "你不是蒙着眼睛么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "嗯，怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180417,
					"content": "但你蒙着眼睛也能用月矩力观察外界的模样对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180418,
					"content": "没错，不如说，这样的感知还更清晰一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180419,
					"content": "那…那如果让你先别去感知外面发生了什么变化的话，可以吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180420,
					"content": "是「惊喜」，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180421,
					"content": "看来你已经猜到了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180422,
					"content": "好的，我知道了，那我把手交给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
