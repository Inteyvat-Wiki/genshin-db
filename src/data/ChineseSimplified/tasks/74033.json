			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡特皮拉",
					"米图尔"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4596.75,
							-46.38,
							4590.743
						],
						"pointId": 4614
					},
					{
						"sceneId": 3,
						"position": [
							4595.909,
							-46.38,
							4592.177
						],
						"pointId": 5582
					},
					{
						"sceneId": 3,
						"position": [
							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "米图尔，你还好吗？应该没被困太久吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330402,
					"content": "我的救星！你们可算来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330403,
					"content": "科布伦茨呢？他没跟你们一起吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330404,
					"content": "是他向我求助，说你被困在这里了。不过中途被看守打断，他就先行离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330405,
					"content": "我就知道他不是个靠得住的生意伙伴！他肯定是怕了，自己心虚理亏，所以逃跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330406,
					"content": "你说，做生意，不胆大点能有收益吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330407,
					"content": "他笨手笨脚也就算了，还瞻前顾后的…你猜怎么着，现在别说是「纯洁之水」了，枫达都进来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330408,
					"content": "枫达进来了，我们还能有活路吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330409,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330410,
					"content": "怎么，你们也喜欢枫达吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330411,
					"content": "怎么，你不喜欢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "我当然喜欢！我必须承认，它是相当强力的竞争对手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330415,
					"content": "不多说了，我得去找科布伦茨这家伙算账去了。对了，他是不是没有支付报酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330416,
					"content": "的确没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330417,
					"content": "…有时我真想把他塞进桶里让他好好反省反省。总之，请你们收下这些特许券。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330418,
					"content": "#请{NICKNAME}和派蒙收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330419,
					"content": "欸？全都给我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330420,
					"content": "当然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330421,
					"content": "嘿嘿，那我们就收下啦。之后有机会也可以去破烂骨头商店看看有没有什么好东西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330422,
					"content": "对了，既然给你们添了不少麻烦，作为赔礼，我这儿有几瓶新鲜的健康饮料，你们要不要尝尝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330423,
					"content": "新鲜的…健康饮料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330424,
					"content": "比「纯洁之水」健康多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330425,
					"content": "给我来一杯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "（喂！卡特皮拉刚才是不是说过，还是不要喝比较好…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330427,
					"content": "#{NICKNAME}刚才说的不算！我们来之前已经…呃，已经喝了很多饮料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330431,
					"content": "真可惜啊，这么好的健康饮料，还是之后有机会再好好品尝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330432,
					"content": "这么不凑巧吗？那好吧，之后如果有机会记得来找我，我一定好好款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330433,
					"content": "那我就先告辞了，还得去找科布伦茨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330434,
					"content": "我有些别的事要办，就暂时道别吧。特许券的事你们不用太忧心了，<color=#00E1FFFF>有线索的话我会贴在黑板上的</color>。稍晚一些我们再会合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330435,
					"content": "嗯，那我们晚点再见！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330428,
					"content": "给我来杯枫达。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "有倒是有…嗯？你是不是瞧不上我的健康饮料？我跟你说哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "米图尔"
				},
				{
					"id": 740330430,
					"content": "#{NICKNAME}不是这个意思啦！只是…只是我们来之前已经喝过很多饮料了，现在饱得不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330413,
					"content": "还行吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "哦？看来是有品位的顾客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "米图尔"
				}
			]
		}
	]
}