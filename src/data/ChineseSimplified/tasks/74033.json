			"dialogs": [
				{
					"id": 740330101,
					"content": "晶簇矿坑道封锁之后，这里就不太有人来了，这里的机械装置也不适合外行摆弄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330102,
					"content": "不过这次就是有人随意摆弄传动机阀，把自己的同伴关了起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330103,
					"content": "总之，我们先操作传动机阀打开通向<color=#00E1FFFF>一号备品仓库</color>的连通路吧。如果待会儿他要请你喝什么饮料，最好还是婉拒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740330104,
					"content": "谁要请我们喝饮料？为什么不喝呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740330105,
					"content": "待会儿你就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
