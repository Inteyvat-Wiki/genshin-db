			"dialogs": [
				{
					"id": 6080101,
					"content": "呼，好久没在风花节期间尽情电什么人了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 6080102,
					"content": "老师，以前难道很多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 6080103,
					"content": "你说电人？当然不多了，啊哈哈，只是偶尔啦。不过还挺解压的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 6080104,
					"content": "啊对了，前些日子老师给我写信还问起这件事呢，我当时说的可是「温柔待人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 6080105,
					"content": "学生继承老师的风格，很合理吧？我的老师也是一个温柔的素论派老爷子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 6080106,
					"content": "所以这次也只用了很温柔的电法哦？就算琴看到都不方便阻止我的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 6080107,
					"content": "原来，可以温柔地电人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 6080108,
					"content": "看起来丽莎小姐状态很不错，真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 6080109,
					"content": "是啊，活动一下身体，对健康也很有益处呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				}
			]
