				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "嗯…让我看看…好像又出现新的藏宝图了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980402,
					"content": "不是说要帮助「受困的兰那罗」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#咳咳！对，我们这回没有找到屋主，真是令人担心！所以，{NICKNAME}，我觉得，我们多去图画里描绘的地方看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980404,
					"content": "到了那些地方以后，我们就能根据上面描绘的地点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980405,
					"content": "找到更多宝藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "对！啊，不对！找到需要帮助的兰那罗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980409,
					"content": "嗯…感觉这个「邮箱」很神奇，说不定之后还会有新的图画传回来。之后，我们多留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980407,
					"content": "找到「受困的兰那罗」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "嗯！而且，说不定还能得到宝藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "派蒙"
				}
