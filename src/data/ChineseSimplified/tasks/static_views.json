			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "我看看我看看…嗯？这是兰那罗的画吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980302,
					"content": "随便翻别人的东西不好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "是喔？明明，一路上冒险家的营地、遗迹的宝箱什么的，我们都清理过不知道多少回啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980304,
					"content": "嗯…不如这么说吧！这个房子周围没见到兰那罗，我们很担心，所以想看看有没有什么线索。说不定，还能帮助受困的兰那罗呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980305,
					"content": "你说得对。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "哼哼，那当然！不管怎么说，这幅画看上去…好像是附近的风景，对吧？不得了，说不定是藏宝图…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}，我们去画出来的地方看看吧！或许真的有兰那罗留下的宝藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730980306,
					"content": "哦。那可真是太有道理了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
