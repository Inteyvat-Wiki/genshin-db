					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "哎哟…还是得想个办法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "是您啊，唉…别提了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310104,
					"content": "最近客栈的生意越来越好，来店里住的人也越来越多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310105,
					"content": "有的一个人过来找清净，有的拖家带口过来旅游。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310106,
					"content": "唉，虽然客栈生意好我很高兴，但这周围有很多魔物徘徊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310107,
					"content": "如果有哪个小朋友跑出去玩，或者是哪位老人出去散步的时候遇见那群魔物的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310108,
					"content": "为了防止这种事发生，我得出去驱赶一下客栈周围的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310109,
					"content": "但我一个人，也驱赶不了多少魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310110,
					"content": "旅行者，你能帮我一把吗？报酬肯定不会少你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310111,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "那就拜托您了。我之前就注意到了几处魔物的营地，里面有不少危险的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310116,
					"content": "而且，还有另外一群魔物偷偷摸到了客栈附近，还扎起了营…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310117,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310118,
					"content": "这样吧，那些危险的魔物就交给我了，您帮我处理一下那些客栈周围的魔物就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310119,
					"content": "把那些魔物赶走之后，我们再来客栈里碰头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310120,
					"content": "这些魔物，真是够烦人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310112,
					"content": "你的身手应该不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "我？这个…您谬赞，算是过得去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310114,
					"content": "但是就凭我一个人，也不可能把那些魔物全部都打倒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "淮安"
				}
			]
		},
