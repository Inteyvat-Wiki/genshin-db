			"dialogs": [
				{
					"id": 413590201,
					"content": "怎么样，寻宝之旅还顺利吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590202,
					"content": "已经找到全部宝藏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "你居然真的把三张图都解完了…你还挺厉害的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590204,
					"content": "咳，对于你这种实力高超的冒险家，我们协会也特别准备了一份大礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590205,
					"content": "看到对面那些宝箱了吗？打开吧，里面的东西都归你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590206,
					"content": "我拿了之后…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "后面的人当然就没了，冒险就是这样，战利品谁先拿到就归谁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413590208,
					"content": "好了，祝你在海灯节玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
