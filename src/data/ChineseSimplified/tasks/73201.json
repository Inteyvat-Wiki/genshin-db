			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "「从『三十人团』退休后，我每天都会来这里喝上一杯咖啡。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011102,
					"content": "「每天代理店长都会给我泡同一种咖啡，说书人也会讲同一个故事。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011103,
					"content": "「或许这样的周而复始才是须弥生活的真谛吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "「玛达赫先生的说书题材内容虽然老套，不过在对故事节奏的把握上还是相当老练的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011202,
					"content": "「只不过现在大家都已经习惯了通过虚空获取信息，习惯性地忽视了这些技术上的『考究』与艺术形式上的『熟成』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011203,
					"content": "「这就是你所言甚虚了，一切艺术形式皆有定时，一旦其能创造的『实利』被剥削殆尽，也就到了被淘汰的时日。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011204,
					"content": "「正如果实到了烂熟的时刻，就应该降解进入土壤，为新的植物提供养料。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011205,
					"content": "「所以我一贯蔑视你这样的实利主义者，艺术创作来源于宝贵的闲暇，怎么能与目的为商业消费的生产和剥削等同呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011206,
					"content": "「闲暇的人就像球状大地上行走的人，是不存在的。不如你自己开动脑筋好好想想，有谁的生产活动能够离开商业交换？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011207,
					"content": "「两位的纸上争论还是一贯的犀利呢…不过卡维先生这个月的账单该结了哦，仍旧是记在艾尔海森先生账上吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011208,
					"content": "「不，我要让这个被惯坏了的家伙体验一下商业社会的险恶。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "留言板"
				},
				{
					"id": 732011209,
					"content": "「代理店长小姐，这个人的欠账麻烦记在桑歌玛哈巴依老爷账上，毕竟咖啡管够才能好好搞艺术嘛！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留言板"
				}
			]
		},
		{
			"id": 7320113,
