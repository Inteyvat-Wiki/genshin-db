			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雅克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#是你啊，{NICKNAME}。取回莉利丝小姐的宝物以后，我们就掌握了胜利的关键。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002602,
					"content": "终于，有机会打倒入侵的外来者，拯救出莉利丝小姐。如此一来，「雅克管弦乐团」也将奏响…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002603,
					"content": "序曲的最后一个章节。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002604,
					"content": "居然才是序曲吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "嗯？你不会以为救出莉利丝小姐，重新拯救了王国，一切就到此结束了吧？哈！现实世界可不是童话故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002607,
					"content": "就是因为有你这样想法的天真家伙很多，历史才会不断地重蹈覆辙。下一步，要颠覆根深蒂固的阶级体制和分配方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002608,
					"content": "在一个合理平等世界里——不必多说，平等自然是合理状态，也一定是莉利丝小姐向往的状态。之所以将其并列是考虑到现状…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002609,
					"content": "我先走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "我们首先应当根据…设立…推翻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅克"
				},
				{
					"id": 741002605,
					"content": "可以精炼一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
