					"莫里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "（嗅嗅）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003102,
					"content": "汪汪，是好人。摸摸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003103,
					"content": "好哦，摸摸莫里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "摸了摸莫里。\\n因为是水构成的（狗），所以湿漉漉的。\\n但是莫里看上去很高兴。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "汪汪，谢谢好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003106,
					"content": "下次再摸吧，莫里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "呜，莫里坏坏，所以不摸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003108,
					"content": "这跟好坏有什么关系？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "汪汪，好狗狗摸摸，坏狗狗…修。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003110,
					"content": "呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "莫里"
				},
				{
					"id": 741003111,
					"content": "看到莫里很伤心，你伸出手摸了摸莫里。\\n因为是水构成的（狗），所以湿漉漉的。\\n莫里蓝色的眼睛里重新出现了光彩。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "汪汪，谢谢摸摸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫里"
				}
			]
		}
	]
