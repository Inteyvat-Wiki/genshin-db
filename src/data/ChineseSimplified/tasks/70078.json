			"dialogs": [
				{
					"id": 700780101,
					"content": "奥多夫，你不知道，骑士团的人都去过很多次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780102
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780102,
					"content": "啊呀，我这段时间都在至冬嘛。骑士团的人都去过塔里这件事，今天还是第一次知道呢…结果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780103
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780103,
					"content": "能有什么结果，现在旧灯塔里的警报还时不时会闪上一会儿呢，温斯洛那个家伙一开始还说，「深渊，是深渊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780104
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780104,
					"content": "听了他的话，骑士团如临大敌，结果全副武装到了那儿一看，一点深渊的痕迹也没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780105
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780105,
					"content": "这样来回几次，那些骑士们也被折腾得够呛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780106
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780106,
					"content": "要我说，其实就是旧灯塔底下那些警戒机关老化了，不过…嗯…最近倒是有些传言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780107
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780107,
					"content": "呵呵，这还能有什么传言？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780108
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780108,
					"content": "有传言说，在那里出没的，其实是从前战死的骑士的幽灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780109
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780109,
					"content": "幽、幽灵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780110,
					"content": "哇——两位，不要在谈论恐怖话题时突然这样大喊大叫，你们这样可比幽灵还吓人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780111
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780111,
					"content": "不、不好意思，我也不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780112,
					"content": "没事没事，聊天的时候总是人越多越热闹才对，两位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780113
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780113,
					"content": "和酒桌边聊天的几位互相作了自我介绍…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700780114
					]
				},
				{
					"id": 700780114,
					"content": "#{NICKNAME}和派蒙…啊呀，原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780115
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780115,
					"content": "对了，说起来，温斯洛现在还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780116
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780116,
					"content": "他被那个警戒机关发出的光亮吓得不轻，住在旧灯塔里，时不时就有机关发生动静，是谁都受不了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780117
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780117,
					"content": "听说最近都有点疯疯癫癫的了…不过那也算是种报应，你管他做什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780118
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780118,
					"content": "这警戒机关总不能就这样吧，我可就住在旧灯塔周围，更何况…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780119
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780119,
					"content": "说不定有别的东西在下面，不去看看总是有点担心，也不能就让温斯洛就那样待在那，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780120
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780120,
					"content": "啊，这么说来，难道说我们之前在旧灯塔前遇到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780121,
						700780123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780121,
					"content": "差点被派蒙吃掉的那个…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780122
					]
				},
				{
					"id": 700780122,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780124,
					"content": "嗯？两位在旧灯塔前遇到什么…哈哈，难道是遇到幽灵了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780125
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780125,
					"content": "不是，我们遇到了一个看上去慌慌张张，疯疯癫癫的人，大概就是那个住在旧灯塔里的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780126,
					"content": "…温斯洛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780127
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780127,
					"content": "你想去帮温斯洛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780128
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780128,
					"content": "先说好，那底下原先是古战场，我可不去那里冒险。更何况，骑士团都去过了，问题也没有解决…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780129
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780129,
					"content": "那我们就得找比西风骑士团的骑士们更可靠的人了，比如曾经拯救过蒙德的大英雄之类的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780130
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780130,
					"content": "哼哼，这样的大英雄去哪里找呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780131,
						700780132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780131,
					"content": "大英雄，正在此处！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780134
					]
				},
				{
					"id": 700780134,
					"content": "哈哈，两位英雄，恕我直言，能接受我的不情之请吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780135
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780135,
					"content": "吔，但是有讨人厌的作怪幽灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780136,
					"content": "啊呀，也有故事里的幽灵徘徊不去只为守护深藏山林之中的财宝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780137
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780137,
					"content": "哦！财宝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780138,
						700780139
