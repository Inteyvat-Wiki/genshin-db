			"dialogs": [
				{
					"id": 700782001,
					"content": "奥多夫，我们回来了！怎么样，警戒机关还有问题吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782002,
					"content": "没有了，警戒机关已经停止闪烁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782003
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782003,
					"content": "啊呀，好快，两位居然这么迅速地解决了麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782004
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782004,
					"content": "是啊，原来那些风…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782005,
					"content": "那些风想必就是不愿意离开的骑士英魂发出的怒吼…警戒机关的闪烁只是一种警告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782006
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782006,
					"content": "欸，等等，其实幽灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782007,
					"content": "其实幽灵们并不想真正伤害你，温斯洛，他们只是对你想要让他们离开的想法感到不满。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782008
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782008,
					"content": "真、真的吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782009
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700782009,
					"content": "他们是对抗深渊牺牲在这里的英雄，怎么会真的做伤害你的事情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782010
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782010,
					"content": "#咳咳…多谢这两位，{NICKNAME}和派蒙，{M#他们}{F#她们}是西风骑士团的荣誉骑士，也是顶级的…顶级的幽灵谈判专家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782011
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782011,
					"content": "虽然…呃，不过，这个头衔还挺帅气的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782012,
					"content": "刚刚的那声仿佛脚下石板开裂的巨响…两位应该没在那阵巨响里受伤吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782013
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782013,
					"content": "毫发无损。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782014
					]
				},
				{
					"id": 700782014,
					"content": "#那就好，我刚刚还有些担心来着，咳咳，刚才的那阵巨响其实就是…就是{NICKNAME}和派蒙与骑士团的幽灵们进行的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782015
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782015,
					"content": "…嗯…超级通灵…掰手腕谈判！本地人都知道，啊呀，那是一种非常危险的平息幽灵愤怒的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782016
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782016,
					"content": "超级通灵掰手腕谈判？真、真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782017,
						700782019
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700782017,
					"content": "只是普通的塌陷罢了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782018
					]
				},
				{
					"id": 700782018,
					"content": "#多么强大，与幽灵掰手腕比赛时因为发出的巨力使遗迹塌陷，对于谈判大师{NICKNAME}来说只是普通的日常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782021
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782021,
					"content": "总之，经过谈判，这些幽灵的愤怒也应该平息了下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782022
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782022,
					"content": "那、那他们再也不会出来作祟…不不不，我的意思是，出来影响警戒机关了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782023
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700782023,
					"content": "那可说不准啊温斯洛，得看你表现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782024
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782024,
					"content": "我…我这两天表现得可好了，我好好清理了英雄们墓边的野草，还仔细擦拭了墓碑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782025
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700782025,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782026
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782026,
					"content": "#啊呀，干得好，温斯洛，{NICKNAME}谈判顺利，你做出的弥补一定也起到了很大的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782027
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782027,
					"content": "如果你能一直这样，那些曾经的英魂们一定会舒舒服服躺在三尺之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782028
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782028,
					"content": "如果能安稳躺在那，谁愿意没事就出来折腾呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782029
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782029,
					"content": "#别紧张了，温斯洛，你看，事情都会解决的。如果警戒机关再出问题，我们也能找{NICKNAME}来帮你谈判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782030
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782030,
					"content": "你说得对…唉，奥多夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782031
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700782031,
					"content": "也谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782032
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700782032,
					"content": "#好了，至于{NICKNAME}和派蒙，感谢你为我们作出的贡献，这是给你们的报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782033
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782033,
					"content": "之前说要准备的东西就是这个，我就知道你们能够解决这个事件的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782034
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782034,
					"content": "原来是报酬，我还以为准备的是什么冒险用的道具呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782035
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700782035,
					"content": "我有自知之明，做点生意还行，冒险可不是我的强项。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782036
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782036,
					"content": "好了，两位朋友，下次再来酒馆吧，我们就能聊点其他有趣的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700782019,
					"content": "普通一掰罢了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782020
					]
				},
				{
					"id": 700782020,
					"content": "#这是只有{NICKNAME}才能办到的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782021
					],
					"speakerTitle": "奥多夫"
				}
			]
		}
	]
