			"dialogs": [
				{
					"id": 700780201,
					"content": "奥多夫，你不知道，骑士团的人都去过很多次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780202
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780202,
					"content": "啊呀，我这段时间都在至冬嘛。骑士团的人都去过塔里这件事，今天还是第一次知道呢…结果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780203
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780203,
					"content": "能有什么结果，现在旧灯塔里的警报还时不时会闪上一会儿呢，温斯洛那个家伙一开始还说，「深渊，是深渊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780204
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780204,
					"content": "听了他的话，骑士团如临大敌，结果全副武装到了那儿一看，一点深渊的痕迹也没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780205
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780205,
					"content": "这样来回几次，那些骑士们也被折腾得够呛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780206
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780206,
					"content": "要我说，其实就是旧灯塔底下那些警戒机关老化了，不过…嗯…最近倒是有些传言…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780207
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780207,
					"content": "呵呵，这还能有什么传言？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780208
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780208,
					"content": "有传言说，在那里出没的，其实是从前战死的骑士的幽灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780209
					],
					"speakerTitle": "伦纳特"
				},
				{
					"id": 700780209,
					"content": "幽、幽灵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780210,
					"content": "哇——两位，不要在谈论恐怖话题时突然这样大喊大叫，你们这样可比幽灵还吓人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780211
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780211,
					"content": "不、不好意思，我也不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780212,
					"content": "没事没事，聊天的时候总是人越多越热闹才对，两位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780213
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780213,
					"content": "和酒桌边聊天的几位互相作了自我介绍…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700780214
					]
				},
				{
					"id": 700780214,
					"content": "#{NICKNAME}和派蒙…啊呀，原来如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780215
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780215,
					"content": "对了，说起来，温斯洛现在还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780216
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780216,
					"content": "他被那个警戒机关发出的光亮吓得不轻，住在旧灯塔里，时不时就有机关发生动静，是谁都受不了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780217
					],
					"speakerTitle": "马泰奥"
				},
				{
					"id": 700780217,
					"content": "听说最近都有点疯疯癫癫的了…不过那也算是种报应，你管他做什么…",
