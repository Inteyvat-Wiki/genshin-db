					},
					{
						"sceneId": 3,
						"position": [
							3598.987,
							174.395,
							-275.348
						],
						"pointId": 16306
					}
				]
			},
			"dialogs": [
				{
					"id": 700780701,
					"content": "呜…别过来…别过来…别再闪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780702
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780702,
					"content": "啊呀，温斯洛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780703
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780703,
					"content": "谁——谁啊！我把门都关上了，你们怎么进来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780704
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780704,
					"content": "幽、幽灵——别、我错了，你们别靠近我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780705
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780705,
					"content": "哇，看上去好严重，都有点神志不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780706,
					"content": "白色幽灵，白色幽灵出现了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780707
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780707,
					"content": "如此大叫着，名为温斯洛的男人险些就这样背过气去…\\n在奥多夫的安抚下，才稍稍冷静了下来，恢复了一些理智。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700780708
					]
				},
				{
					"id": 700780708,
					"content": "好点了吗，温斯洛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780709
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780709,
					"content": "好？好什么好…奥多夫，你！你来干什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780710
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780710,
					"content": "你就是来看我的笑话的，对不对…你还带了这个白色的家伙来，就是为了吓我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780711
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780711,
					"content": "你们这些本地人，你们一直在排斥我，嫉妒我住在这，你们这些、你们这些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780712
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780712,
					"content": "冷静点，温斯洛，我们是来帮你的。我们一直都在帮你，温斯洛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780713
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780713,
					"content": "在你叫嚷着要把底下那些「阴湿的，恐怖的，麻烦的玩意儿」迁到港外的野地里的时候，我们来帮你，劝你不要这么干。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780714
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780714,
					"content": "那时我跟你说，「会有报应的，温斯洛。」…你看，现在你变成了这样，我心里也很难受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780715
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780715,
					"content": "你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780716
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780716,
					"content": "#然后，这两天我刚从至冬回来，就听说你被这里的幽灵啊什么的折磨，立刻找来了能够解决麻烦的{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780717
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780717,
					"content": "我们一直在帮你，温斯洛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780718
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780718,
					"content": "谁知道…谁知道你们是不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780719
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780719,
					"content": "#唉…你如果不相信我，也该相信相信{NICKNAME}，{M#他}{F#她}可是骑士团的荣誉骑士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780720
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780720,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780721
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780721,
					"content": "行了，温斯洛，继续待在这儿对你的精神状况可不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780722
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780722,
					"content": "#{NICKNAME}，派蒙，看看这可怜人吧，我先带他上去透透气，遗迹的事就交给你们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780723
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780723,
					"content": "要是我们没能成功…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780724
					]
				},
				{
					"id": 700780724,
					"content": "也将化作它们中的一员…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780725
					]
				},
				{
					"id": 700780725,
					"content": "噫、噫啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780726
					],
					"speakerTitle": "温斯洛"
				},
				{
					"id": 700780726,
					"content": "真是的，又在说些奇怪的话！别在这里吓人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780727,
					"content": "哈哈，我想下面的东西应该不会那么危险，好了，祝你们能顺利解决问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780728
					],
					"speakerTitle": "奥多夫"
				},
				{
					"id": 700780728,
					"content": "嗯嗯，我们一定会的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700780729,
					"content": "奥多夫扶着脚步蹒跚、神色难看的温斯洛离开了塔下的遗迹…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
