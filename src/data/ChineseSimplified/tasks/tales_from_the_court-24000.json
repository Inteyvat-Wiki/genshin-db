			"dialogs": [
				{
					"id": 240000101,
					"content": "我再重复一遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000102,
					"content": "利弗先生，我十分理解您的诉求，也非常愿意尽我所能向您提供帮助，但这件申请…您看这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000103,
					"content": "经办人是克拉佩尔先生，您所有曾经提供的材料都归他整理提交，除了经办人之外，我们都没有权力办理啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000104,
					"content": "现在他正在出外勤，不在办公室里，您的这份材料必须要盖上他的公章，才能进入我们的报销流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000105,
					"content": "行了吧！我都来了三次了，你们到底办不办事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000106,
					"content": "利弗先生，请冷静一下，克拉佩尔先生所在的办公室毕竟只有两个人，除了他之外，只有一位蒙图瓦先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000107,
					"content": "但蒙图瓦先生年事已高，已经在等待退休，很久不在办公室里坐班了，就连工资也不拿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000108,
					"content": "好吧，那我去他的办公室总行了，让那位老先生过来把章拿出来，我来盖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000109,
					"content": "真的非常抱歉，利弗先生，这可不行。一方面这样不合规定，另一方面，公章钥匙在克拉佩尔先生手上，除了他之外没人能拿到公章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000110,
					"content": "而且…我也得办其他的事去了…相信我，今天克拉佩尔先生一定会回来，为您把这件事彻底办结的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000111,
					"content": "好吧…祝你今天愉快，柯妮莉娅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000112,
					"content": "您也是，利弗先生，祝您愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "柯妮莉娅"
				},
				{
					"id": 240000113,
					"content": "柯妮莉娅匆匆离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "今天又只能回去了…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000115,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "没什么大事，我只不过是又白跑一趟，浪费了宝贵的半天时光罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000118,
					"content": "我真是受够了这个叫克拉佩尔的家伙！沫芒宫在我们这订购了几件发条机械，但是到现在还没付款！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000119,
					"content": "我第一次来找他，他说现在是月底，办公室需要进行月度封账审计，要到下个月月头才能往外出款，暂时不接受申请。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000120,
					"content": "第二次来，他说盖章用的印油用光了，但印油的供应商仓库着了火，要去别的地方采购，暂时盖不了章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000121,
					"content": "第三次，他说这份「外部援请人员信息登记表」又更新了，我还得重新填一次。但这张表已经用完了，新印的明天才能送来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000122,
					"content": "我今天准备来取那张表，但他根本就不在办公室，天哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000123,
					"content": "欸？利弗先生，我有什么能帮您的吗？瞧您这一副发愁的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000124,
					"content": "莱弥娅警官，见到您真好，事情是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000125,
					"content": "利弗絮絮叨叨地讲述了事情的经过…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "克拉佩尔先生啊…这位先生确实挺难打交道。但他今天确实去了伊黎耶岛办事，不在沫芒宫内。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000127,
					"content": "不过，无论他在哪里，我们还是先去把那张表拿到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000128,
					"content": "欸？但克拉佩尔先生说，那张表已经用完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000129,
					"content": "我有办法解决您的问题。我记得，某些长期和沫芒宫合作的店铺也遇见过你现在所面对的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000130,
					"content": "他们的解决方法是，隔一段时间就来沫芒宫索取可能会用到的表格和文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000131,
					"content": "这样做一方面是方便以最快的速度填写和提交文件，另一方面，也可以在第一时间获知表格和文件是否有更改之处…这就是所谓的「有备无患」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000132,
					"content": "难，难道表格就是这么被拿光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000133,
					"content": "总得来说，这几家店里肯定有富余的最新表格，我们就去找他们拿一张吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000134,
					"content": "而且，我相信当他们听到你在沫芒宫白跑这么多趟之后，肯定很愿意帮你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000135,
					"content": "对了，我们还得赶在沫芒宫的下班时间之前拿到表格，并且完全填写完毕，再拿到克拉佩尔先生的办公室里去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000136,
					"content": "这位旅行者，请问您愿意帮助一下利弗先生吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000137,
					"content": "旅行者！拜托你帮帮忙吧，再不办完这件事，我今天晚上肯定又睡不着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 240000138,
					"content": "好，好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "请您帮我们去这两个店铺看看，向他们借一份最新的「外部援请人员信息登记表」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000141,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000142,
					"content": "请您去伊丝黛莱小姐的铁匠工坊，还有卡隆先生的钟表店看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000143,
					"content": "不久之前，伊丝黛莱小姐曾经为沫芒宫维修过路灯，卡隆先生则帮沫芒宫校正过时钟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000144,
					"content": "这两位非沫芒宫职员经常被沫芒宫雇佣去工作，手上一定有「外部援请人员信息登记表」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000145,
					"content": "那就拜托您了，我和利弗先生稍后也会分头行动，去其他的店铺问问情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱弥娅"
				},
				{
					"id": 240000139,
					"content": "但我要做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "你遇见什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
			"id": 2400002,
			"completionStepIds": [
				2400002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400002",
							"2"
						],
						"stepId": 2400002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊丝黛莱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240000201,
					"content": "真是麻烦…就这么一点钱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 240000202,
					"content": "关于「外部援请人员信息登记表」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "叙述了利弗的经历和想要借表格的请求…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "唉，利弗也真是倒霉。但是…我也没有多余的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 240000205,
					"content": "我在给沫芒宫维修路灯的时候，带上了一个店里的人做帮手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 240000206,
					"content": "因为那个人基本没帮上忙，我就没有把他写进「外部援请人员信息登记表」里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 240000207,
					"content": "但在提交表格的时候，克拉佩尔坚持要我把所有人员都写进去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 240000208,
					"content": "还说什么，如果不如实填写就会造成「难以估量的严重后果」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "伊丝黛莱"
				},
				{
					"id": 240000209,
					"content": "只不过少了一个人而已，怎么可能造成什么严重后果，真是莫名其妙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊丝黛莱"
				}
			]
		},
