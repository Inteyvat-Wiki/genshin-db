				]
			},
			"dialogs": [
				{
					"id": 751320601,
					"content": "啊，异邦的勇士啊…我能感受到…你所做出的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320602,
					"content": "真是了不起啊，勇士，被侵蚀的力量也回归了夜神的国度，我能感受到夜魂们的欢悦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320603,
					"content": "那么…就将这些作为报酬吧，勇士，达成伟业者，应当有所奖赏，请收下这些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "谜画涂鸦中的意志"
				}
			]
		}
	]
