			},
			"dialogs": [
				{
					"id": 751320501,
					"content": "小心那漆黑之敌漫行之处，小心侵蚀一切的敌雠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320502,
					"content": "异邦的勇士啊…有什么想要得知之事吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320503,
					"content": "关于英雄的壁画…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "东侧，诸多流光荧树摇曳的洞窟之中，正如手持织卷的叙事人所说，过往故事之中亦有被潜藏其中的恐怖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320505,
					"content": "或许其中的阴影正借由过往的故事本身，寻求逃脱之法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320506,
					"content": "关于迷海之上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "西侧被迷雾深藏的岛屿，那里原本是祭祀的圣所，亦是许久之前与暝视的龙众签立契约者的居留之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320508,
					"content": "只是淤泥从中涌现，圣所变作了漆黑的孔窍，那里亦被封印与遗忘…啊，可是那狡猾的敌人不会如此轻易放弃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320509,
					"content": "关于失色之雾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "那原本是名为奥奇卡纳塔的古城毁灭之时产生的污秽之雾，原本已遭封绝…可岁月与遗忘亦是大敌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320511,
					"content": "若是…啊…若是有人能够重新驱散那些失色之雾就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "谜画涂鸦中的意志"
				},
				{
					"id": 751320512,
					"content": "不，没有什么想知道的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "啊…还请切记，务必…务必小心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "谜画涂鸦中的意志"
				}
			]
		},
