			},
			"dialogs": [
				{
					"id": 710350101,
					"content": "二位，要点什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 710350102,
					"content": "三份烤吃虎鱼，打包。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "好嘞！您在这稍等一会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 710350104,
					"content": "三份？你一份，我一份…还有一份是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350105,
					"content": "想去看看铜雀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "你是说之前把七星灯和香炉给我们的那位铜雀先生吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350108,
					"content": "对喔，记得铜雀先生说过他很想念烤吃虎鱼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350109,
					"content": "不过，铜雀先生应该已经走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350110,
					"content": "去看看也好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "嗯，那我们就再去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350112,
					"content": "之前在那边见到铜雀先生的时候，那间庙又破又旧，旁边好像还有盗宝团的踪迹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350113,
					"content": "希望，铜雀先生的雕像别被人弄坏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350114,
					"content": "二位，您要的三份烤吃虎鱼打包好了，您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "卯师傅"
				},
				{
					"id": 710350115,
					"content": "#好香啊！{NICKNAME}，那我们就快点出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350106,
					"content": "铜雀喜欢吃烤吃虎鱼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
