			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王平安",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "这座庙还是这么破败…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350402,
					"content": "赶紧交代，你怎么突然想要来修庙的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350403,
					"content": "咳，那就说来话长了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350404,
					"content": "我之前为了假扮仙人，搜集了很多资料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350405,
					"content": "那次受了仙师教诲之后，我不是立下了从善的誓吗？回去之后，我就准备把那些资料全部毁掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350406,
					"content": "但我转念一想…与其把这些资料毁掉，不如我把这些资料，还有我行骗时的手段编写成册，散发给其他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350407,
					"content": "这样，说不定能帮助大家识破一些骗子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350408,
					"content": "没想到，我编写的这本册子还真帮不少人防了骗，连总务司的人都说我这个册子很有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350409,
					"content": "除了我自己写的那部分内容之外，他们还拜托我加入一些其他的防骗内容…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350410,
					"content": "为此，总务司还付了我不少钱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350411,
					"content": "除了那本小册子之外，我还在编写另外一本有关「护法夜叉」的书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350412,
					"content": "我想用这本书来向大家宣传一下「护法夜叉」的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350413,
					"content": "这样做，我的那些民俗学知识也算是用在了正道上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350414,
					"content": "这位「铜雀」的庙，我也是在编写有关「护法夜叉」的书的时候发现的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350415,
					"content": "上面记载说，那座庙本来是先民们为了纪念夜叉「铜雀」所建。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350416,
					"content": "但我找到这座庙的时候，真没想到它居然如此破败…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350417,
					"content": "回去之后我左思右想，最后还是决定…自己出钱，把这座庙重修一遍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350418,
					"content": "毕竟，我能重新走回正道，也是多亏了仙师教诲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350419,
					"content": "重修这座庙，也算是为我之前做的那些错事赎一些罪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350420,
					"content": "唔…听起来不像是假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350421,
					"content": "#{NICKNAME}，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350422,
					"content": "感觉还挺真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "什么叫感觉挺真的，这就是真的，千真万确！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350426,
					"content": "唉，算了，您爱怎么想就怎么想吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350427,
					"content": "您要是真不信，就等正式开工之后自己过来看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350424,
					"content": "你之前是骗子欸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "我现在不是了啊！我现在可是个正经人，我不都在仙师面前立誓了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "王平安"
				}
			]
		},
