				"points": []
			},
			"dialogs": [
				{
					"id": 710350301,
					"content": "谢谢仙师，谢谢英雄…真是巧了，又遇见您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350302,
					"content": "你认识我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350303,
					"content": "我怎么敢忘了仙师的样子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350304,
					"content": "你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "哎呀，我叫王平安！您想起来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350306,
					"content": "「掇星攫辰天君」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "啊？！别别别千万别，什么「掇星攫辰」，您可别损我了，仙师还在这呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350310,
					"content": "我正准备去山里的一座供奉着夜叉「铜雀」的庙看看呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350311,
					"content": "但刚进山不久，就被那群盗宝团盯上了…多谢仙师相救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350312,
					"content": "等一下，你去铜雀先生的庙做什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350313,
					"content": "难不成…你在打铜雀先生雕像的主意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350314,
					"content": "没有！我绝不会有这种想法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350315,
					"content": "那你想做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "我是…想要重修一下那座庙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350317,
					"content": "我今天过来，本来是准备再仔细看看那座庙的情况，好回去购置材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350318,
					"content": "没想到，半路上被盗宝团给盯上了，只能逃跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350319,
					"content": "但我跑着跑着就…迷路了。后面的事，您都知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350320,
					"content": "去庙那边详细说吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "对，这里不是谈话的地方，我们先去庙那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350322,
					"content": "有什么话，我们到那边再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350323,
					"content": "你们去吧，我还有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350324,
					"content": "欸！你要走吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350325,
					"content": "已经…走掉了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350308,
					"content": "我记得你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "多亏您还记着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "王平安"
				}
			]
		},
		{
