				"points": []
			},
			"dialogs": [
				{
					"id": 710350201,
					"content": "你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350202,
					"content": "你也是来看铜雀的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "只是路过此处，驻足片刻罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350204,
					"content": "你们来，是有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350205,
					"content": "我们是来看铜雀先生的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350206,
					"content": "不过，这周围还是和上次一样，简直是一团乱啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350207,
					"content": "明明建了庙，也做了雕像…怎么没人过来维护一下呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350208,
					"content": "也许是忘了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "这也能忘记吗？夜叉明明是保护了璃月港的大英雄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350211,
					"content": "魈…你、你是不高兴了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350212,
					"content": "没有，夜叉但行守护之责，本就无意寻求什么后人纪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350213,
					"content": "不说这些了，我们快点来吃烤吃虎鱼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350214,
					"content": "唔…要是魈也想吃的话，我们可以各自把烤吃虎鱼切一半给你喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350215,
					"content": "不必了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350216,
					"content": "救命啊！救命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 710350217,
					"content": "咦？我好像听见了什么声音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710350218,
					"content": "有人呼救，在那边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "魈"
				},
				{
					"id": 710350219,
					"content": "快走！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "欸？把烤吃虎鱼收好呀！我还没吃呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
