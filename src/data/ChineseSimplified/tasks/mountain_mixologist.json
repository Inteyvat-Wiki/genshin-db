			"dialogs": [
				{
					"id": 705230101,
					"content": "外地来的客人？欢迎来到轻策庄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230102,
					"content": "你好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "我先说我先说，我们先自我介绍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230105,
					"content": "#这是无所不能的旅行者{NICKNAME}，我是旅行者最好的伙伴派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230106,
					"content": "我们正在帮外地的客人订购佳酿节的特色饮品，看到了你的委托，所以就来直接和你商量了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230107,
					"content": "原来如此，真是爽快人！那我也不废话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230109,
					"content": "我是厨师关垂，需要采购<color=#00E1FFFF>100箱「假日果酿」</color>，用来兑茶水，给干体力活的兄弟们喝个痛快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230110,
					"content": "好！那我们就开工了，请提供采购资金吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230111,
					"content": "早就准备好了，请收下这些「佳酿晶冻」！下单后想必还会有盈余，不管还剩多少，都是两位劳苦功高的报酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230112,
					"content": "我们都收下了，待会儿就出发！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230113,
					"content": "好极了！等着你们两位的好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230114,
					"content": "好迅速的交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#别愣着啦，{NICKNAME}，我们快走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230117,
					"content": "有什么想说的，就等下单以后再来聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230118,
					"content": "早点搞定这些工作，我们就能早点开店啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230119,
					"content": "开店开店，嗯哼哼~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230115,
					"content": "派蒙也上道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "请问你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
