					"关垂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "关垂先生，我们回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230302,
					"content": "你需要的100箱「假日果酿」已经订好了，这是给你的单据，请收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230303,
					"content": "好好好！两位真是帮大忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230304,
					"content": "我要好好研究一下「假日果酿」，把这种新鲜饮料和茶水按特定的比例混合，调出最好的口感，让兄弟们下地干活时更有干劲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230305,
					"content": "呃，听起来有点像调酒，不过用茶水来兑…真的能做到吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230306,
					"content": "放心吧，我以前在外边当过一段时间厨师。这种做法能在成本和口味之间取得最好的平衡，我已经调配过很多次了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230307,
					"content": "有点想试试看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "下次你们来轻策庄玩的时候，我就用成品来招待你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230309,
					"content": "#好哦！到时候就让{NICKNAME}先尝尝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230310,
					"content": "加油啊，调配饮品的厨师！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "谢谢你们！有空常来啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "关垂"
				}
			]
		},
		{
