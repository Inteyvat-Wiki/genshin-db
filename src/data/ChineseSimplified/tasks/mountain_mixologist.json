			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "这次佳酿节的特色饮品，想来就和轻策庄的山泉茶水很般配！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230402,
					"content": "有劳你们两位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230403,
					"content": "关于你自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "我和几个兄弟搬回庄里还没多久。平时我负责给下地干活的兄弟们做点饭菜，送到田里去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230405,
					"content": "不过我做的大多是些简单管饱的菜式，拿出来招待外地的客人还是有点寒碜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230406,
					"content": "轻策庄虽不热闹，但美食可一点都不少，你在庄里逛逛就能见识到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230407,
					"content": "关于茶水…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "下地干活的兄弟们口渴得厉害，经常半天就喝掉一大缸茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230409,
					"content": "田地和庄里的茶水摊隔着一段距离，来来回回不太方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230410,
					"content": "凯叔一把年纪了，可不能麻烦他给兄弟们送茶，这个活儿就由我包揽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230411,
					"content": "我和几个兄弟在外地闯荡过一段时间，大缸的茶水对我们来说有点清淡，有时兄弟们想喝些味道重的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230412,
					"content": "所以我会往茶水里加些饮品，调出新鲜的风味，让兄弟们乐呵乐呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230413,
					"content": "当然，我做的茶水只提供给几个兄弟，可不能抢凯叔的生意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230414,
					"content": "闲下来以后，我们也会去凯叔的茶水摊品茶，帮他干些杂活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "关垂"
				},
				{
					"id": 705230415,
					"content": "我们去去就回。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "好啊！等着你们的好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "关垂"
				}
			]
		},
