			"dialogs": [
				{
					"id": 705230201,
					"content": "哦！你们又来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "格奥尔格"
				},
				{
					"id": 705230202,
					"content": "这次还是帮别国的客人下单吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "格奥尔格"
				},
				{
					"id": 705230203,
					"content": "没错哦，这次我们需要100箱「假日果酿」，委托人是轻策庄的厨师关垂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230204,
					"content": "我们准备好出价了，格奥尔格先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230205,
					"content": "怎么有种商业对决的感觉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "喔！气势很强嘛！那就让我看看你们这次的觉悟吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格奥尔格"
				},
				{
					"id": 705230206,
					"content": "请接招吧，格奥尔格先生！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
