	"talks": [
		{
			"id": 7369801,
			"completionStepIds": [
				7369801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369801",
							"2"
						],
						"stepId": 7369801,
