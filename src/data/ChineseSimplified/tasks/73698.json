				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖尔宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980101,
					"content": "看来前一项训练进行得很顺利嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980102,
						736980104
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736980102,
					"content": "还算顺利吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980103
					]
				},
				{
					"id": 736980103,
					"content": "嗯，对于斯露莎来说或许有些太简单了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980106,
					"content": "呵呵，那就让我期待一下她这次的表现吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980107
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736980107,
					"content": "对了，关于听斯露莎讲故事的部分，原来之前斯露莎是因为叛逆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980108,
					"content": "这个就不必说了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980109,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980110,
					"content": "咳，总之，现在我已经脱、脱离了那个阶段了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980111
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980111,
					"content": "重要的是，在同「谒颂主」及白飘飘回溯花灵诞生的历史之后，谈到了深林中草木的眷属和他们独有的节日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980112
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980112,
					"content": "花灵没有自己的节日这件事让我耿耿于怀，前辈难道不这样觉得吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980113
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980113,
					"content": "要我说，应该让人类来参与花灵的节日，由他们来唱诵称赞花灵的诗篇，然后由我选出最优秀的那一个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980114,
					"content": "据我所知，无忧节可不是这样胡闹的节日哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980115
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736980115,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980116
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980116,
					"content": "总觉得斯露莎这种找人类来记录功业的想法就和其他的花灵很不一样…这应该也是矫论团的影响吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980117,
					"content": "正因为如此，回顾和反思过去才是有意义的行为。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980118
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736980118,
					"content": "呵呵，不管怎么说，就让我期待一下她这次的表现吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 736980104,
					"content": "倒也没那么顺利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980105
					]
				},
				{
					"id": 736980105,
					"content": "斯露莎并不像自己说的那么厉害嘛，接下来得多努力才行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7369806,
			"completionStepIds": [
				7369806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369806",
							"2"
						],
						"stepId": 7369806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980601,
					"content": "哦！我记得这里，我们之前来过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980602,
						736980604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980602,
					"content": "的确是令人印象深刻的地方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980603
					]
				},
				{
					"id": 736980603,
					"content": "刚看到的时候吓了一跳呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980606,
					"content": "记得斯露莎说过这家伙是因为运气不好才被封印在这里。不过，它跟斯露莎的训练有什么关系呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980607,
					"content": "啊，难道说，祖尔宛的意思是：「呵呵，斯露莎，看看吧，这就是运气不好的家伙的下场」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980608,
					"content": "噗…前辈才不是会做这种无聊的事的花灵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980609,
					"content": "…言归正传，虽然之前从这里经过时没有细说，但是导致它被封印的那场灾难，你们应该也很熟悉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980610,
					"content": "五百年前的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980611,
					"content": "没错。那应该是一瞬间的事吧，你们看，即便已经变成结晶的现在，它依然保持着当时的动态。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980612,
					"content": "就好像一旦封印解除，它马上又会轰隆隆地在洞穴中穿行一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980613,
					"content": "这刹那，将是你的永恒…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980614
					]
				},
				{
					"id": 736980614,
					"content": "呜啊，我可不要变成这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980615,
					"content": "虽说可能是一瞬间发生的事，唔…不行不行，光是想想就觉得害怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980616,
					"content": "不会让派蒙遇到这种事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980617
					]
				},
				{
					"id": 736980617,
					"content": "#那当然啦！我也绝不会让{NICKNAME}遇到这样的危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980618,
					"content": "唉，那你们应该感谢吾辈花灵才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980619
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980619,
					"content": "当时为了平息灾祸，包括花灵在内的许多族类与存在都献出了生命…有时甚至是比生命更珍贵的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980620
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980620,
					"content": "现在的我们能够免于它所遭遇的无可转圜的灭顶之灾，正是因为当年的那些牺牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980621
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980621,
					"content": "也正是因为我没能亲历那场大灾厄，当这片土地再次遭遇危机之时，我才更应该有所作为…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980622,
					"content": "这么说来，它的年纪比斯露莎还要大，也算是斯露莎的前辈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980623,
					"content": "不过它可不会活过来了。毕竟已经结晶化几百年了，等待它的或许只剩下销蚀的命运吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980624,
					"content": "因为那场灾厄而殒命的生灵数不胜数，它们中的许多就像这个倒霉的家伙一样，被封进了灾祸发生的刹那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980625,
					"content": "但这许多的生灵却比我们眼前的倒霉家伙更加不幸，因为它们早已在百年来岁时的流逝中将形体消磨殆尽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980626,
					"content": "而今什么也没有剩下，没有人记得它们，更无处凭吊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980627
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980627,
					"content": "我们眼前的倒霉家伙嘛，只是因为原本就格外巨大，又生在免于酷晒与烈风的地下洞穴，这才保留得较为完好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980628
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980628,
					"content": "不过大陆上还没有什么生灵能敌得过时间，哪怕是生灵的遗骸也不行。总有一天，它也会消失得无影无踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980629
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980629,
					"content": "总觉得有些可惜呢…到头来，就连生存过的痕迹也不能留下的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980630,
					"content": "唔，人类留下的文献里应该能找到有关它的记录吧，这样的东西对人类来说还是很稀罕的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980631
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980631,
					"content": "以前听前辈说起过，除了矫论团的人类，也有从森林来的学者四处调查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980632
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980632,
					"content": "不过听说有些人类坚信风蚀沙虫是流沙鳗鳗的完整形态…有这样的学识和联想，真忧心这些人类记录下来的内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980633
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736980633,
					"content": "这不是根本靠不住吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980634,
					"content": "仔细想想，明明人类的记录这样不可靠，斯露莎却还热心地寻找人类来当「谒颂主」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980635,
					"content": "说不定在这块结晶销蚀殆尽之前，为斯露莎所写的颂诗都会被传得面目全非了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980636,
					"content": "到时候人们听到的颂诗里说的花灵勇者可能就是既不粉也不可爱，外形硬朗可靠，待人温和有礼，行事理智不冲动…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736980637,
					"content": "听起来很像理想中的勇者形象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980638
