			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路通",
					"加尔恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "加尔恰先生，我再次诚心地建议您。我们可以卖几部书以筹措资金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131102,
					"content": "不！绝不！亲爱的路通，你这是让我去贩卖我的灵魂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230131103,
					"content": "先生，但问题在于没人愿意为灵魂出价啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230131104,
					"content": "你怎么还在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "旅行者？您怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230131107,
					"content": "呃…我上次的试验失败了，我稀释史莱姆凝液的方法有问题…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230131108,
					"content": "做出来的润滑剂不仅没有起到润滑「推数机」轴承的作用，反而让它们更容易卡死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230131109,
					"content": "所以，我需要更多的史莱姆凝液来做试验。您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230131110,
					"content": "交给我吧。",
