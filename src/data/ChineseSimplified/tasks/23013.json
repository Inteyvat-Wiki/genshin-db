				"points": []
			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "路通，我们的资金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130202,
					"content": "我们总能找到方法活下去的，加尔恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130203,
					"content": "我们璃月人有句老话叫做「车到山前必有路」，我认为十分适合用于形容咱们现在的处境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130204,
					"content": "这句话的意思是，当我们前进的道路被一座大山挡住的时候，总是能找到跨过去的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130205,
					"content": "啊哈，非常巧妙的比喻，那看来我们的处境还不算太糟糕嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130206,
					"content": "加尔恰先生，那您觉得写下这句话的人，当时找到跨过山的办法了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130207,
					"content": "呃？噢，见鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
