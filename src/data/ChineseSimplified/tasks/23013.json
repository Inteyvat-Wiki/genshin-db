			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加尔恰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "旅行者，你拿到史莱姆凝液了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130302,
					"content": "已经拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "太棒了！这些应该就足够了，我回去就开始做试验，有了这些润滑剂，我的「推数机」一定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130304,
					"content": "我得去研究一下，路通，剩下的事就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130305,
					"content": "是的，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130306,
					"content": "这是您的报酬，旅行者，非常感谢您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130307,
					"content": "嗯…以我并不高远的眼光来看，我们之后也许还会需要您的帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130308,
					"content": "请您放心，只要账目还归我管理，您就一定能收到合理的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130309,
					"content": "…唉，我之所以会和加尔恰先生一起旅行，就是不愿意像我父母一样，一生都在璃月总务司的某个部门里梳理账目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130310,
					"content": "但现在…我除了和加尔恰先生一同进行运算工作外，还要来帮他梳理账目…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130311,
					"content": "也许这就是所谓的「命运使然」吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
		{
