				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "我亲爱的路通，你…确定就是这个地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130102,
					"content": "不会错的，加尔恰先生，这里就是史莱姆最常出没的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130103,
					"content": "我对史莱姆聚集地这一点毫无怀疑，我的问题是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130104,
					"content": "这些史莱姆，是否有些太多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130105,
					"content": "加尔恰先生，这就是我们缺少资金所导致的后果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130106,
					"content": "你是…加尔恰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "旅行者！太巧了，您也来须弥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130109,
					"content": "你在这里做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "哈哈哈，我之所以在这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130111,
					"content": "自讨苦吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130112,
					"content": "勇敢赴险。谢谢，路通，你能不能稍微…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130113,
					"content": "如您所愿，先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130114,
					"content": "回到正题，我之所以来这里，是想要寻找一些「史莱姆凝液」来为我的「推数机」制作润滑剂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130115,
					"content": "但是，一方面是因为市场上贩卖的「史莱姆凝液」普遍放置时间太久，质量不高，另一方面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130116,
					"content": "是因为加尔恰先生购买了太多书籍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130117,
					"content": "…是因为，我们被迫支付了许多…必要性支出！导致资金匮乏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130118,
					"content": "所以我们才来这里，想要直接取得一些新鲜的史莱姆凝液。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130119,
					"content": "不过如您所见，我亲爱的路通身为一个璃月人，既不会武功，也不会做菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130120,
					"content": "所幸我依然有着梳理账目的天赋…这都得感谢总务司复杂的税务规则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130121,
					"content": "…而我，总不可能拿着我的「推数机」零件去砸人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130122,
					"content": "你需要我的帮助？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "在某种意义上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130124,
					"content": "没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130125,
					"content": "路通，我们…呃，我们还有钱吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130126,
					"content": "在支付了这位旅行者的报酬后，我相信咱们总能找到方法活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230130127,
					"content": "那就成！拜托您了，旅行者，请帮我去拿点史莱姆凝液回来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加尔恰"
				},
				{
					"id": 230130107,
					"content": "你怎么会在这里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
			"id": 2301302,
