			"dialogs": [
				{
					"id": 250360101,
					"content": "…果然这个问题还是太简单了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "凯塔"
				},
				{
					"id": 250360102,
					"content": "喔。真不好意思，我刚才在思考，没注意到您过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "凯塔"
				},
				{
					"id": 250360103,
					"content": "向您问好。我是「烟谜主」的凯塔，正在这里做学徒，负责管理资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "凯塔"
				},
				{
					"id": 250360104,
					"content": "你在思考什么问题？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "啊…只是一些有关纳塔的过去，当下和未来的简单问题，不值一提。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "凯塔"
				},
				{
					"id": 250360106,
					"content": "您看起来是一位来自远方的旅者。我能感觉到，你交游良多，所思甚广…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "凯塔"
				},
				{
					"id": 250360107,
					"content": "如果您愿意的话，可以试试体验一下我已经记录在册的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "凯塔"
				},
				{
					"id": 250360108,
					"content": "这些问题的答案就在您的旅途之中——无论过去，当下还是未来的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯塔"
				}
			]
		},
