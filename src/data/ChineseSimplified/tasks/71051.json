			"dialogs": [
				{
					"id": 710500801,
					"content": "关于放在水边的奇怪物件…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "嗯？你把那个东西放在水边了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500803,
					"content": "怎么样，有发生什么特殊反应之类的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500804,
					"content": "出现了岩龙蜥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "岩龙蜥？那个东西放到水里变成了岩龙蜥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500806,
					"content": "哦，不是那个东西变成的，而是岩龙蜥看到那个东西之后就游出来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500807,
					"content": "吓了我一跳，要是这个东西入水直接变成岩龙蜥，那我的世界观的立柱都要崩塌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500808,
					"content": "那个东西到底是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "说来也简单，该怎么说明好呢，这样吧，让我先猜一猜，那只岩龙蜥，有没有什么特别之处…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500810,
					"content": "比如说，元素附着属性是水之类的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500811,
					"content": "好像是这样的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "那就对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500816,
					"content": "那只岩龙蜥应该可以调用水元素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500817,
					"content": "层岩巨渊的地下水，水元素含量很高，特殊的聚集点就会养出类似你钓上来的水草一样的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500818,
					"content": "岩龙蜥，当然了，其他生长在层岩巨渊的亲水生物也一样，靠食用这种富含水元素的水草来提升自己的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500819,
					"content": "所以那个东西其实就是…富含水元素的水草！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500820,
					"content": "只是水草吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "嗯，就是水草，不过富有如此元素量的水草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500822,
					"content": "正常环境可长不出来，除非有什么非常纯净又巨大的能量影响了水源…不说这个了，这些水草…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500823,
					"content": "说不定有一天也会生出意识变成元素生物，真是值得好好研究一番啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500813,
					"content": "没看见…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#难道是因为解决得太快了所以根本没在意到吗…真是厉害啊，不愧是传说中的{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500815,
					"content": "不过根据我的推测…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "海迪夫"
				}
			]
		}
	]
