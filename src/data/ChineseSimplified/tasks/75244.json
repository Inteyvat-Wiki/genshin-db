			"dialogs": [
				{
					"id": 752440101,
					"content": "哦呀，你也是来钓鱼的吗？要知道钓鱼啊，要戴着足够坚固的帽子才行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440106,
					"content": "为什么要戴帽子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "因为戴帽子才安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440107,
					"content": "可你也没戴帽子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "这就是我跟你搭话的原因…真不好意思，我的帽子被风吹跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440104,
					"content": "不介意的话，能帮我找一找吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440108,
					"content": "为什么不自己去找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "如果我去找帽子，就必须要放下鱼竿，如果我拿起鱼竿，就没法去找帽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "瑞安提"
				},
				{
					"id": 752440109,
					"content": "所以拜托你，请帮我一把吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑞安提"
				}
			]
		},
