			"dialogs": [
				{
					"id": 411490301,
					"content": "听说有特别订单…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411490302
					]
				},
				{
					"id": 411490302,
					"content": "对啊，你来得正好。早些时候，瓦里特先生在我们这订了一份庄园烤松饼，钱也已经预付好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490303
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411490303,
					"content": "然后，他让我们晚些时候把餐送到明冠峡南面的一个地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490304
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411490304,
					"content": "但不知道为什么，最近要求外送的餐品越来越多，我们的人手都不够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490305
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 411490305,
					"content": "如果你愿意的话，就请帮忙跑一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
