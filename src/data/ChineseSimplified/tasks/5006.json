					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50069903
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50069903,
					"content": "没事，可能是我幻听了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50069904
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50069904,
					"content": "别这样，好吓人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50069905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50069905,
					"content": "我也听到了，是来自深渊的声音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50069906
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50069906,
					"content": "咿？！它它它、它说什么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50069907
					],
					"speakerTitle": "派蒙"
				},
				{
