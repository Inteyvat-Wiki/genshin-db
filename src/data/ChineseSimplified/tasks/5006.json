			"dialogs": [
				{
					"id": 50060601,
					"content": "大灵女士？大灵女士！我回来了，我和我的伙伴现在就帮你疗伤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060602
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060602,
					"content": "大灵女士，能听到吗？大灵女士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060603
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060603,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060604
					],
					"speakerTitle": "「此地的伟大精神」",
					"speakerSubtitle": "夜之意志的代行者"
				},
				{
					"id": 50060604,
					"content": "果然污染已经非常严重了，无法回应我们的呼喊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060605
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060605,
					"content": "直接开始吧，各位准备好，把深渊的力量赶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060606
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060606,
					"content": "我也会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060607
					]
				},
				{
					"id": 50060607,
					"content": "小心，那家伙来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060608
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060608,
					"content": "怎么这么快？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060609
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50060609,
					"content": "愚昧的勇气毫无价值，小小的灵魂妄图延缓我的脚步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060610
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060610,
					"content": "那我只好先送他一程了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060611
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060611,
					"content": "你、你把穆尔科给…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060612,
					"content": "与其关心一个终将散去的灵魂，不如考虑一下你们自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060613
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060613,
					"content": "或许曾经你们战胜过和我类似的东西，但因此就轻视我，我会让你们付出代价。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060614
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060614,
					"content": "这一切都是你干的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060615
					]
				},
				{
					"id": 50060615,
					"content": "不，深渊的力量令人沉醉，它所策划的毁灭也如同艺术品，我只是不想错过近距离欣赏的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060616
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060616,
					"content": "我还以为不会有人类和这个小女孩一样天真，结果居然有这么多送上门来的蠢货。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060617
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060617,
					"content": "这就是短命的人类的悲哀，对于压倒性的力量根本没有认知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060618
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060618,
					"content": "「古名」？自尊心？友情？那种空虚的东西只是用来自我麻醉罢了，根本没有任何力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060619
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060619,
					"content": "火神打造这么多堂而皇之的概念，只是出于吝啬！不愿意把原初的馈赠让给你们这些普通人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060620
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060620,
					"content": "不然，为什么火神是最强的存在，而你却弱到这种程度，卡齐娜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060621
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060621,
					"content": "我、我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060622
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060622,
					"content": "卡齐娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060623
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060623,
					"content": "把手给我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060624
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060624,
					"content": "感觉到了吗？我就在你身边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060625
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060625,
					"content": "谢谢你，我想起来了，我不用再害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060626
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060626,
					"content": "因为我已经不是「一个人」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060627
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060627,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060628
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060628,
					"content": "你说得对，精神的慰藉并不能产生任何力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060629
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060629,
					"content": "但你又错得离谱，因为你的力量都是不劳而获，所以无法理解力量的根源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060630
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060630,
					"content": "什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060631
					],
					"speakerTitle": "科莫奎"
				},
				{
					"id": 50060631,
					"content": "正因为友情，才会让我们充满勇气，无人退缩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060632
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060632,
					"content": "会产生力量的并不是友情本身——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060633
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060633,
					"content": "而是相信友情这个概念，并聚在一起的我们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060634
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060634,
					"content": "说得好，玛拉妮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060635,
					"content": "这种程度的敌人，交给我们两个就足够了。准备上了，卡齐娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060636
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060636,
					"content": "嗯，实在是对不起，但是…但是…我果然想暴揍你一顿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060637
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060637,
					"content": "让它知道，整个纳塔都找不到几个打得过我们联手的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛拉妮"
				}
			]
		},
