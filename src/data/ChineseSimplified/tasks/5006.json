			},
			"dialogs": [
				{
					"id": 50060501,
					"content": "你们来了，你们终于来了，呜呜呜…谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060502
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060502,
					"content": "那个深渊魔物有可能从任何地方出现，好几次我都差点被抓到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060503
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060503,
					"content": "大灵遮蔽了我的气息，然后我就一直在拖延时间，东躲西藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060504
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060504,
					"content": "嗯，你很了不起，你没有受伤比什么都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060505
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060505,
					"content": "接下来怎么办，我们要回去吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060506,
					"content": "我有个请求，我们能不能一起去看看大灵的状况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060507
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060507,
					"content": "「还魂诗」的问题，虽然我不知道该怎么描述，但肯定和深渊污染有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060508
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060508,
					"content": "看到眼前的状况，基本可以证实火神的猜想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060509
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50060509,
					"content": "在「夜神之国」里，有六个主要的图腾柱，它们代表各个部族的大灵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060510
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060510,
					"content": "如果说主要图腾柱是大灵的本体，那这里的图腾柱，就是一个共享大灵意识的分身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060511
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060511,
					"content": "正是许许多多分身的存在，大灵的意识才能覆盖整个「夜神之国」，无论灵魂去了什么地方，它们都能找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060512
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060512,
					"content": "但如果分身受到了严重的污染，灵魂就会迷失在「夜神之国」之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060513
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060513,
					"content": "可现在的情况是，一定不止这一个分身出现了问题，就算驱赶了深渊之力，也于事无补。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060514
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50060514,
					"content": "那我们要对大灵弃之不顾吗？它一直在保护我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060515
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060515,
					"content": "救一个也是救。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060516
					]
				},
				{
					"id": 50060516,
					"content": "我赞同，而且我们能借这个机会，把试图追击卡齐娜的深渊魔物揪出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060517
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060517,
					"content": "要是能铲除这个家伙，应该能让「夜神之国」恶化的速度有所缓和吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060518
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060518,
					"content": "呃、呃…啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060519
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060519,
					"content": "怎么了，卡齐娜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060520
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060520,
					"content": "没、没事，就是有点头疼，又有声音在脑子里响，它让我扔下大灵，赶紧回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060521
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060521,
					"content": "要不还是走吧，卡齐娜在这里的时间太长了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060522,
					"content": "没事的，我…我不会听它胡说八道，我能坚持住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060523
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060523,
					"content": "图腾柱在哪里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060524
					]
				},
				{
					"id": 50060524,
					"content": "就在前面不远处，我来带路，我也会战斗的，所以求求你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060525
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060525,
					"content": "听我说，卡齐娜，我们会和你一起去，但我们是为了帮助大灵，而不是想要去为你证明什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060526
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060526,
					"content": "你不需要为自己证明什么，如果撑不住了，就依靠我们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060527
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060527,
					"content": "速战速决吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060528
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50060528,
					"content": "嗯，来都来了，不如把问题解决得彻底一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060529
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060529,
					"content": "我们走，这边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060530
					],
					"speakerTitle": "卡齐娜"
				},
				{
					"id": 50060530,
					"content": "我就留在这里，拖延那个深渊魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060531
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060531,
					"content": "什么？这样的话，你会很危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060532
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060532,
					"content": "没关系，我的力量不如那个家伙，但我比它更熟悉这里，而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060533
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060533,
					"content": "我的时间已经不多了，相信你们和我那个朋友一样，不太擅长面对离别。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060534
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060534,
					"content": "快走吧，达成目的，然后离开这里，回你们应该回的地方去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060535
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060535,
					"content": "感谢你为我们做的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060536
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50060536,
					"content": "你是很了不起的英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060537
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060537,
					"content": "哈哈哈，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060538
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060538,
					"content": "「我们不会孤军奋战」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆尔科"
				}
			]
		},
