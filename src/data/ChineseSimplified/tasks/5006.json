					}
				]
			},
			"dialogs": [
				{
					"id": 50060201,
					"content": "为什么要拽我啊！你们太重了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060202,
					"content": "看来我们已经顺利抵达了，这里就是…夜神之国。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060203
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060203,
					"content": "在故事里听到这个名字的时候，完全想象不到是这样一副光景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060204
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50060204,
					"content": "而且到处都是深渊力量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060205
					]
				},
				{
					"id": 50060205,
					"content": "就是因为深渊的过量淤积，才把卡齐娜困在了这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060206
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060206,
					"content": "从这里开始，我们对现实世界的认知就完全失效了，这里什么都有可能发生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060207
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060207,
					"content": "我最关心的是我们要怎么回去，刚刚的入口明显就是有去无回啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060208,
					"content": "看到天空的裂口，以及投射到地面上的光了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060209
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060209,
					"content": "就是脚下这一片，还有头顶的…哇，这么远，我们从那么高的地方掉下来？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060210,
					"content": "这就是我说的认知失效，明明是从那么高的地方掉下来，连一点冲击都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060211
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060211,
					"content": "我们想要回去，也不需要重新爬回那个入口，只需要站在这束光下，心中祈祷就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060212
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060212,
					"content": "这、这样就行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060213,
						50060215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060213,
					"content": "现在不要试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060214
					]
				},
				{
					"id": 50060214,
					"content": "嗯，我知道，一不小心回去了就麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060217,
					"content": "也就是说，找到卡齐娜，把她带回到这里就行了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060218
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060218,
					"content": "嗯，因为这束光是从现实投下，也是现实与这个世界的「纽带」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060219
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060219,
					"content": "这里看上去地势复杂，视野也不太好，我们要怎么找到卡齐娜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060220
					],
					"speakerTitle": "伊安珊"
				},
				{
					"id": 50060220,
					"content": "而且这些随处漂浮的黑乎乎的东西，对我们好像也很不友好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060221,
					"content": "那些都是深渊的力量，千万要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060222
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060222,
					"content": "呜哇，有鬼！鬼说话了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 50060223,
					"content": "冷静一点，我是来帮你们的。你们就是帮助维查玛的人，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060224
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060224,
					"content": "你该不会是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060225
					]
				},
				{
					"id": 50060225,
					"content": "嗯，我就是维查玛的朋友，原本我已经完全融化在了这个国度中，却又感觉到一股神奇的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060226
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060226,
					"content": "那种力量像是在寻找我，将我这个概念重新凝聚，当然，这是非常困难的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060227
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060227,
					"content": "以这样不完整的样子与你们相见，我也十分抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060228
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060228,
					"content": "不，该道歉的应该是我们，因为那时候的灵觉髓石受到了深渊力量的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060229
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060229,
					"content": "如果不强行把它停下来，维查玛和附近的「悬木人」都会有危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060230
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 50060230,
					"content": "嗯，我明白，谢谢你们能保护他。这么多年过去了，他居然还为了我做这样的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060231
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060231,
					"content": "在那个神奇装置的作用下，我感觉我的灵魂和他连接在了一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060232
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060232,
					"content": "原来就连我们的遗憾，都是如此相似…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060233
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060233,
					"content": "无论是凯旋还是牺牲，都想要和最好的朋友站在一起，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060234
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 50060234,
					"content": "是啊，对我们来说，这是注定无法实现的愿望了，但你们还有机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060235
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060235,
					"content": "你们在寻找一个「回声之子」的小姑娘对吧，她在被深渊力量的化身追赶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060236
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060236,
					"content": "我也想趁我仍然能保持形态的机会帮助她，跟我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50060237
					],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060237,
					"content": "你们要小心，这里已经被深渊侵蚀得很严重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆尔科"
				},
				{
					"id": 50060215,
					"content": "现在不准跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50060216
					]
				},
				{
					"id": 50060216,
