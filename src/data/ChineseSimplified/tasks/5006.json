					"content": "打得不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50061004
					]
				},
				{
					"id": 50061004,
					"content": "被小看了就应该用这种方式回击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50061005
					],
					"speakerTitle": "伊安珊"
