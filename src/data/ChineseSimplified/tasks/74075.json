					}
				]
			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "这里好像有人不久前来过啊。居然遇到了比我们还熟悉考古探险的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750202,
					"content": "地上还有…一块怀表？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750203,
					"content": "按照我们冒险的惯例，让我看看这个石碑提示哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750204,
					"content": "「此处乃灵魂之象限，灵魂之庙宇，灵魂之间」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750205,
					"content": "「伴你长眠」…「生于一瞬，常与相违，从不分离」…「人间至宝」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750206,
					"content": "啊，很明显我的朋友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "思索思索。很贵重的怀表，又是人间之宝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750209,
					"content": "我明白了，一定是摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750210,
					"content": "不、不太像是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "你说的有道理。一般谜底不会这么俗气的。应该就是，怎么说呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750212,
					"content": "对了，是「财富」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750213,
					"content": "很好，我们姑且当作不是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "气死我了。你怎么这么不信任我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750215,
					"content": "那你说这个是什么吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750216,
					"content": "今天天气挺好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "喂喂，不要转移话题啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
