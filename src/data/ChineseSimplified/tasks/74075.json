			"dialogs": [
				{
					"id": 740751701,
					"content": "仔细检查了机关顶部的空间，什么都没有发现。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740751702
					]
				},
				{
					"id": 740751702,
					"content": "这里依旧什么都没有欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740751703,
					"content": "所以卡特皮拉你能告诉我们，我们究竟要找什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751704
					],
					"speakerTitle": "安"
				},
				{
					"id": 740751704,
					"content": "我们是在寻找锻铸水仙十字圣剑的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751705
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751705,
					"content": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751706
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751706,
					"content": "无法理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751707
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740751707,
					"content": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751708
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751708,
					"content": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751709
					],
					"speakerTitle": "西摩尔"
				},
				{
					"id": 740751709,
					"content": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751710
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751710,
					"content": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751711
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751711,
					"content": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751712
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751712,
					"content": "为什么这些东西会用来打造圣剑啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740751713,
					"content": "水仙十字结社的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751714
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751714,
					"content": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751715
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751715,
					"content": "好玄乎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751716
					]
				},
				{
					"id": 740751716,
					"content": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751717
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751717,
					"content": "总之我们赶紧去下一处地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
