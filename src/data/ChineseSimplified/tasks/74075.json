					"nextDialogs": [
						740751602
					]
				},
				{
					"id": 740751602,
					"content": "结果最后这里什么都没有吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740751603,
					"content": "并不是，看起来是已经被人拿走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751604
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751604,
					"content": "那岂不是我们的计划已经失败了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740751605,
					"content": "「理性」的诞生需要四个象限合一。只要我们能拿到剩下的几个，我们就还有机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751606
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751606,
					"content": "既然如此，我们就快点去接下来的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
