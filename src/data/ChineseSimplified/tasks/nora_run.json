				},
				{
					"id": 200581102,
					"content": "可以的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200581103
					]
				},
				{
					"id": 200581103,
					"content": "那我要快点长大，等爸爸工作完了，我就要和他一起去玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581106
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200581106,
					"content": "不过，长大之后应该就不难了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581107
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200581107,
					"content": "谢谢你啦，这些给你，是我悄悄搜集的宝物，就给你做礼物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581108
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200581108,
					"content": "快点收好…还有，别和葛瑞丝阿姨说啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诺拉"
