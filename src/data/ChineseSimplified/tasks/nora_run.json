			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580202,
					"content": "要上去做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "葛瑞丝阿姨说，如果想要向谁说悄悄话，只要告诉蒲公英，然后撒出去，风神大人就会把蒲公英和悄悄话一起带给那个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580204,
					"content": "而且撒的地方越高，心愿就能传达地越快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580205,
					"content": "葛罗丽姐姐就拜托过冒险家，帮自己去风神像上撒过蒲公英…结果隔了几天，古德温哥哥就回信了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580206,
					"content": "诺拉也有悄悄话告诉爸爸，而且也找好蒲公英了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580207,
					"content": "但是…葛瑞丝阿姨一直不许，一直说等我长大之后，才能回去和爸爸一起住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580208,
					"content": "到底怎么样才能长大得更快呢，我也在很努力地锻炼了，但还是这么矮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580209,
					"content": "嗯…我经常看见你在城里飞来飞去，你能教教我，平时你都是怎么飞的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580210,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "嘻嘻，那我就在旁边看啦。这次，总是在葛瑞丝阿姨的允许范围内了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580212,
					"content": "要一起飞吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "不行不行，葛瑞丝阿姨看见了，又要训我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "诺拉"
				}
			]
		},
