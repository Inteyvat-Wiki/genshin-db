			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "唉，诺拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580902,
					"content": "你在照顾她吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "哦，因为一些原因，她的母亲…暂时不在家里，目前是由我来照顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580904,
					"content": "还有其他几个需要照顾的孩子，都是由我来负责，这也是修女的责任之一呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580905,
					"content": "我就好像突然多了很多孩子一样，他们都是好孩子，和葛罗丽也都很处得来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580906,
					"content": "唔…我照顾时间最长的提米，都开始叫我葛瑞丝妈妈了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580907,
					"content": "诺拉的爸爸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "是巴顿先生，他之前因为太喜欢喝酒，家里出了很大的问题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580909,
					"content": "教会和西风骑士团都警告过他几次，但他一直没有悔改的意思，最后还是迪卢克老爷帮的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580910,
					"content": "维多利亚修女的意思是，现在的巴顿不适合照顾诺拉，所以干脆把诺拉交给教会照顾，让巴顿先生一个人反省一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580911,
					"content": "但是，诺拉也在长大，「爸爸在努力工作，不能去打扰」的借口也不能用了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580912,
					"content": "风神大人的蒲公英，也不是哪都能到的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				}
			]
		},
