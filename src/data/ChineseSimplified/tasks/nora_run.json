			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"诺拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "呜…怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "你看见风神像了吗？往上看，很高很高的地方…就是风神大人手的那个地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580104,
					"content": "我想要上去玩…但是，葛瑞丝阿姨一定不会让我爬上去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580105,
					"content": "拜托拜托，拜托你去和葛瑞丝阿姨说话吧，别让她看过来，我爬得很快，一下子就能爬上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580106,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "那就拜托你啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580110,
					"content": "总之，就拜托你去吸引住葛瑞丝阿姨了，我这就去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580111,
					"content": "诺拉，不准去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580112,
					"content": "呼…稍微走神了一会，她居然来麻烦您了，抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580113,
					"content": "怎么这样！就是上去玩一玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "诺拉"
				},
				{
					"id": 200580114,
					"content": "不行就是不行，你父亲也不会允许的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580115,
					"content": "还有您，请您也别迁就她。要是您做这种危险的事情，肯定也有人会担心的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞丝"
				},
				{
					"id": 200580108,
					"content": "太危险了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "没关系啦，我可是很厉害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "诺拉"
				}
			]
		},
		{
			"id": 2005802,
