			"dialogs": [
				{
					"id": 150080201,
					"content": "哇，前面有好多鳍游龙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080202,
					"content": "果然，第一个线索和鳍游龙有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080203,
					"content": "部族外的人拿到地图的复制品后，大多能推断出这个结论，但他们找的方向往往是错误的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080204,
					"content": "初代首领制作地图时在这个环节留了一个特殊的记号，那是我们部族用来标识鳍游龙群的暗号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080205,
					"content": "所以，随便找一两头落单的鳍游龙可拿不到线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080206,
					"content": "玛拉妮果然很专业！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080207,
					"content": "可是根据我查到的资料，除非为了争夺温泉池，鳍游龙根本不喜欢群居…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080208,
					"content": "那就告诉你一个只有「流泉之众」的向导才知道的秘密吧，野外的鳍游龙每隔一段时间就会聚集到前面的山谷里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080209,
					"content": "就像是…部族里定期举办的聚会一样。不过，时节一过，它们就会迅速离开。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080210,
					"content": "如果不是经常在纳塔来回赶路的向导，很难看到这种景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080211,
					"content": "竟然有这种事？得赶快记录下来，必须在论文的相关论述里进行说明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080212,
					"content": "根据我对地图的解读，线索就藏在那个山谷的深处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080213,
					"content": "那要过去的话，岂不是得先穿过龙群？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080214,
					"content": "嗯…只能想办法悄悄溜过去，尽量不要惊动它们。它们应该是在跟朋友聚会，肯定不想被打扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080215,
					"content": "要主动钻到龙群里？这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080216,
					"content": "咳咳…既然决定合作，那双方都该出一份力。不过，卡嘉她之前刚刚被这种鳍游龙袭击过，不方便来做这种事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080217,
					"content": "我的话…没什么问题！就让卡嘉在这里等候，原本要交给她的任务一并由我来完成就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080218,
					"content": "噗…本来就不需要所有人一起去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080219,
					"content": "#我们正好需要有人留下来照看行李，这个就拜托两位了，{NICKNAME}和派蒙跟我来就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080220,
					"content": "是这样吗？那自然最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080221,
					"content": "不过，你关爱后辈的心思我已经领会到了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
