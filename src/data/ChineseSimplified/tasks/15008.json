			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}还有派蒙，这边！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080102,
					"content": "玛拉妮已经到了呀，呃，那个怪大叔也在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080103,
					"content": "早上好，两位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080104,
					"content": "早上好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080105,
					"content": "我们什么时候出发？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080106,
					"content": "哈哈，就像个小孩子一样，在旅行开始前总是迫不及待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080107,
					"content": "我是想尽快开始办正事…你肯定也知道这不是什么轻松的春游，我希望我们彼此都能拿出一点专业的态度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080108,
					"content": "不用担心，我作为向导很专业的。咳咳…那么，我们的神秘岛之旅正式开始了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080109,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080110,
					"content": "首先，大家看到这座雕像了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080111,
					"content": "嗯嗯，它是什么重要的线索吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080112,
					"content": "倒不是线索啦，它是我们「流泉之众」的初代首领从神秘岛归来后立在这里的，算是个纪念地标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080113,
					"content": "出发前首先要做的事呢，就是触摸这座雕像，向先祖祈福，这样我们前往神秘岛的旅途就会更加顺利哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080114,
					"content": "…这种说法能找到什么理论依据吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080115,
					"content": "理论依据？没有。但我老师教过我，启程前往神秘岛之前，这是必要的一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080117,
					"content": "很好，你没有在自己不专业的领域指手画脚，这也是一种很专业的表现哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080118,
					"content": "好吧，只是这样就没法写进论文里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080119,
					"content": "大家一起来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080120,
					"content": "在此向先祖致意，后辈将踏上您走过的旅途，见证您曾完成的壮举，在您的注视下出发，在您的守望中归来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080121,
					"content": "真的有种要开启一场伟大的冒险的感觉呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080122,
					"content": "接下来请做好准备，我们要去寻找第一个线索咯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛拉妮"
				}
			]
		},
