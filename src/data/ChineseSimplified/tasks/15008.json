			"dialogs": [
				{
					"id": 150080301,
					"content": "这些鳍游龙好警觉啊，这样根本进不去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080302,
					"content": "既然已经根据地图提供的信息推断出线索在那个山谷里，那直接把这些龙赶走不就好了？阁下的身手应该都很厉害吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080303
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080303,
					"content": "首先，部族里的前辈一直告诫我，绝对不能主动伤害鳍游龙，那是一等一不吉利的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080304
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080304,
					"content": "另外，私自闯入别人的聚会就算了，还要赶别人走？这种行为真的很恶劣哎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080305,
					"content": "这算是什么理论…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080306
					],
					"speakerTitle": "维兰德"
				},
				{
					"id": 150080306,
					"content": "那我们想想其他办法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080307,
					"content": "嗯…肯定有办法可以在不惊动它们的同时进入山谷。只靠我一个人想办法肯定要很久，我想麻烦大家一起出出点子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080308,
					"content": "让我想想…绕路可不可以？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080309,
					"content": "从地图给的信息来看，线索的位置在龙群中间，从另一边走就会遇到另一边的鳍游龙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080310
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080310,
					"content": "那确实难办了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150080311,
					"content": "…卡嘉姐姐，我发现你总是在帮维兰德圆场的时候才说话，你也有自己的想法吧？能不能讲讲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080312
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080312,
					"content": "我吗？好吧…之前维兰德决定去鳍游龙身上找线索，为了帮忙，我也查阅了一些有关鳍游龙的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080313
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080313,
					"content": "我发现了一个很有趣的地方，我们一向认为鳍游龙依靠听觉来辨别猎物的方向，其实它的嗅觉也十分灵敏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080314
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080314,
					"content": "不过，我也不知道这一点有没有用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080315
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080315,
					"content": "哦…哦！很有用的，卡嘉姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080316
					],
					"speakerTitle": "玛拉妮"
				},
				{
					"id": 150080316,
					"content": "叫我卡嘉就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080317
					],
					"speakerTitle": "卡嘉"
				},
				{
					"id": 150080317,
					"content": "#那就麻烦你们继续留在这里看好行李，{NICKNAME}和派蒙跟我来，我想到办法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛拉妮"
				}
			]
		},
