				]
			},
			"dialogs": [
				{
					"id": 741860301,
					"content": "卡西奥多大人，卡西奥多大人…是您吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741860303,
					"content": "没错了，果然是您，您终于回来了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860304,
					"content": "我奉命把守这座要塞，但是那些残虐的龙蜥与蛮族的攻势实在太猛，我才只能一退再退来到了这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860305,
					"content": "从那以后似乎过去了很多很多年…外面的情况怎么样了，我们胜利了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741860307,
					"content": "…是吗，那么是我们输了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860308,
					"content": "我很抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741860309,
					"content": "您别这样说，尊贵的大人。在我加入至尊的军团之时，便曾想过会有这样一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860310,
					"content": "至尊曾说，要带领我们砸碎「法图纳」的镣铐。但事情又怎会这样容易呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860311,
					"content": "毕竟我们对抗的可是命运，而命运是连伟大的神明都无法违抗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860312,
					"content": "最后，一切的努力都是徒劳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741860313,
					"content": "不，大人。我们曾向天命举起刀剑，我们创造的事业挑战了高天的律法。面对那个预言，我们奋起反抗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860314,
					"content": "虽然我们还是失败了…一定是有人背叛了我们，才使我们走上了歧途…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860315,
					"content": "但结果已经不重要了，无论如何，我们都会铭刻在世界的「历史」之上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "无名的魔像"
				},
				{
					"id": 741860316,
					"content": "喂，他怎么倒下了，石头人也会像这样突然失去意识吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741860317,
					"content": "我还不知道他的名字…看上去，他的「历史」已经终结了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "小呜斯"
				},
				{
					"id": 741860318,
					"content": "也太可怜了，他就这样在这里战斗了数千年吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741860319,
					"content": "但现在，他终于能得享安宁了，我们继续前进吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小呜斯"
				}
			]
		}
	]
}