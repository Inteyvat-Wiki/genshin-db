					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "我有宝物想要出售。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "您又找到了什么稀奇东西？请让我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710104,
					"content": "将龙骨花凝珠的故事告诉了琳琅。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "听您所说，这可是一件了不得的古物啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710106,
					"content": "只是我入手察看一番，并没有感觉到特别明显的异样，或许需要长期使用才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710107,
					"content": "依我之见，您所听来的神妙效用，可能有些夸大了，又或者...说不定只是失败者的托辞呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710108,
					"content": "哈哈，您不用在意，我只是随口一说，您听听便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710122,
					"content": "在我们古董行当里，这种事情倒十分常见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710109,
					"content": "另外，您似乎没有对它密封保存，粗粗看去，它的表面似乎已经有了一些耗损。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710110,
					"content": "这样一来，价格又要小打一点折扣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710123,
					"content": "您看，80000摩拉如何？除此之外，再加5份特色料理丰年有余。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710111,
					"content": "我相信这是一个不错的价格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710112,
					"content": "你会拿它做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "其实跟它的功效相比，我倒觉得它背后的那段故事更有价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710114,
					"content": "我猜港里的说书人、戏班子，或者玉京台上的贵人们都会对它有兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710115,
					"content": "就算只摆在本店的柜台上展示，也能算上一件珍稀的古董了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710116,
					"content": "公道的价格，成交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "您可真爽快，这些摩拉请收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710118,
					"content": "往后要是还有类似的宝贝，敝店随时恭候您的光临。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710119,
					"content": "我再考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "嗯，对于这种珍奇宝物，货比三家…啊不是，价比三家也是应该的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710121,
					"content": "如果您考虑好了，可以再来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
