				{
					"id": 722710201,
					"content": "关于龙骨花凝珠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "那么，您考虑的如何了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710203,
					"content": "敝店愿意以80000摩拉加5份丰年有余来收购。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710204,
					"content": "就决定卖给你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "谢您惠顾，这些摩拉请收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710206,
					"content": "往后要是还有类似的宝贝，敝店随时恭候您的光临。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710207,
					"content": "我还要再考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710208
					]
				},
				{
					"id": 722710208,
