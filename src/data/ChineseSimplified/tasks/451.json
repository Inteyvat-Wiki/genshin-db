			},
			"dialogs": [
				{
					"id": 4510101,
					"content": "这里叫做「奔狼领」，据说蒙德的人很少涉足这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510102,
					"content": "虽然就在蒙德城附近，但这里生态原始，是一个自然法则至上的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510103,
					"content": "正所谓弱肉强食，连史莱姆都能长得很巨大哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510104,
					"content": "看，就是这——么巨大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510105,
					"content": "…它们进攻过来了！做好准备！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
						],
						"stepId": 45104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷泽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "谢…谢谢你——奔狼领的狼群来了！快逃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510303,
					"content": "不用担心。 狼是朋友。 可，你们是谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510304,
					"content": "我们只是普通的旅行者……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510305,
					"content": "不普通，你们。 不过，有熟悉的气味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510306,
					"content": "熟悉的气味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510307,
					"content": "骑士团，对吧？骑士团里有朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510308,
					"content": "你叫什么名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "我是雷泽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510311,
					"content": "你也是西风骑士团的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510312,
					"content": "和骑士团没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510314,
					"content": "呜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510315,
					"content": "狼群…是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "啊……狼群，是家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510317,
					"content": "家人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510318,
					"content": "家人。将我养大，和我一起生活的家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510319,
					"content": "好像这中间有很复杂的故事……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510320,
					"content": "他们在责怪我。为了帮助你们，埋伏暴露了。没有抓到野猪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510321,
					"content": "#这样吗…那就让{NICKNAME}来帮忙抓野猪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME}也是很厉害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510323,
					"content": "我，我觉得不必了。骑士团的朋友每次动手，狼群都要饿肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510324,
					"content": "不用和我们客气啦。你们就等着我们的好消息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510309,
					"content": "你也是骑士团的人吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "我是雷泽。 和骑士团没有关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "雷泽"
				}
			]
		},
