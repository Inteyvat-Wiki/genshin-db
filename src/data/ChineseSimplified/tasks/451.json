			"dialogs": [
				{
					"id": 4510601,
					"content": "你看，我们弄到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510602,
					"content": "谢谢你们。不过…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510603,
					"content": "不过要是我们自己来，能抓五六头。有狼今晚要空肚子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510604,
					"content": "呜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510605,
					"content": "不要在意，谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510606,
					"content": "你们比起骑士团那个红色，看起来很烫的女孩子——朋友，要厉害多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510607,
					"content": "她出手的话，估计山会烧起来。猪，一头也抓不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510608,
					"content": "我该走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510609,
					"content": "最近这里不安全。你们小心，保护好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510610,
					"content": "真是奇特的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510611,
					"content": "他提到的骑士团那个朋友。红色，很烫的女孩子——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}，你想到了谁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
