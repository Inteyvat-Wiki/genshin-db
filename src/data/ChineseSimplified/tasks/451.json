					"speakerTitle": "雷泽"
				},
				{
					"id": 4510502,
					"content": "狼群有自己的方法，更有效。不过陷阱，很新鲜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510503,
					"content": "放置好以后，把野猪赶过去，对吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "雷泽"
				},
				{
					"id": 4510504,
					"content": "不会爆炸吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷泽"
				}
