			},
			"dialogs": [
				{
					"id": 3081101,
					"content": "呀，小可爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081102,
					"content": "这么危险的事你也来帮忙，真令人感动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081103,
					"content": "这段时间里有什么不明白的，都可以来问姐姐喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081104,
					"content": "图书管理员主要负责做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "嗯，这个问题问得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081106,
					"content": "基本上，就是体力活和脑力活之外的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081107,
					"content": "那究竟是还剩哪一种事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081111,
					"content": "所以，你们也可以多信任我一些喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081108,
					"content": "为什么图书管理员会来遗迹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "嗯，这个问题问得不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081110,
					"content": "答案嘛，当然是因为琴信任我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "丽莎"
				}
			]
		},
