				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081301,
					"content": "只是在门外，就能感受到元素力乱流所带来的烦躁感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081302,
					"content": "抓紧夺回这座庙宇，好让身体舒畅一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				}
			]
		},
		{
			"id": 30814,
			"completionStepIds": [
				30814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"30814",
							"2"
						],
						"stepId": 30814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"丽莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "东风之龙，南风之狮，北风之狼，西风之鹰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081402,
					"content": "它们是蒙德四方之风的守护者，也是风神「巴巴托斯」的眷属。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081403,
					"content": "特瓦林——这就是风魔龙的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081404,
					"content": "在被人们称作魔龙以前，它曾是「四风守护」中的「东风之龙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081405,
					"content": "这就是，四方之风的力量中，特瓦林只能借用三方的原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081406,
					"content": "从一开始，它就已经在燃尽「自己」了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081407,
					"content": "它为什么要这样做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "我想…是因为「恨」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081410,
					"content": "恨…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081411,
					"content": "是对蒙德的憎恨啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081412,
					"content": "以恨意为驱动、将恨意作为比风更强的力量，化作魔龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081413,
					"content": "可是，「四风守护」之一，为什么反而会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081414,
					"content": "憎恨它本该守护的那座城市呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3081415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081416,
					"content": "身为蒙德人，真难自己说出口呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081417,
					"content": "拿去看吧…这是百年前发生的故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丽莎"
				},
				{
					"id": 3081408,
					"content": "它为什么要做到这种地步？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
}