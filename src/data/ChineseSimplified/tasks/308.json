		},
		{
			"id": 30813,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"30802",
							"2"
						],
						"stepId": 30802,
						"stateName": "QUEST_STATE_UNFINISHED"
