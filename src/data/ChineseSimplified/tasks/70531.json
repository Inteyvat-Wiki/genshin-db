				"points": []
			},
			"dialogs": [
				{
					"id": 705310101,
					"content": "前辈，请稍等一下！您也是来参加「召唤王大奖赛」的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310102,
					"content": "如果您有空的话，我想向您介绍一下我们冒险家协会正在举办的「诸景巡礼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310103,
					"content": "我，我倒是有空…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "谢谢前辈！我就简单为您介绍一下本次协会所举办的「诸景巡礼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310106,
					"content": "简单来说，我们冒险家协会在蒙德的各处放置了许多「巡景台」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310107,
					"content": "您要做的，就是找到这些「巡景台」，并且用「巡景台」上的印章，在我们发给您的「巡景手册」上盖上纪念章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310108,
					"content": "只要找到所有「巡景台」，并且集齐所有的纪念章…您就算是完成挑战啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310109,
					"content": "这活动…还真是有冒险家协会的风格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "嘿嘿…放置那些「巡景台」的位置，我们可是专门设计过的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310111,
					"content": "虽然…有些「巡景台」的位置有点偏僻，说不定周围还有魔物出现…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310112,
					"content": "但我觉得，以前辈的身手，对付那些魔物肯定也是轻轻松松啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310113,
					"content": "那么，我马上把「巡景手册」给您，祝前辈玩得开心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奥妮"
				},
				{
					"id": 705310104,
					"content": "你，你先说说看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}