			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "欢迎试玩「玲珑霄灯图」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570102,
					"content": "什么…什么图？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "「玲珑霄灯图」，怎么样，你想试试玩一下吗？很简单的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570104,
					"content": "你看见后面的这几扇画屏了吗？还有前面的这三盏灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570105,
					"content": "这些灯是我特意去找人定制的，打开之后，可以映出各种不同的图案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570106,
					"content": "而且，如果用正确的方式转动这三盏灯，还能把三盏灯的图案拼在一起，形成一个完整的图案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570107,
					"content": "啊…这么说你估计也不太明白，这样，你先去试试看转动一盏灯吧。熟悉一下基本操作，然后我再详细和你讲玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135703",
							"3"
						],
						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "哦呀，你学得很快嘛，知道了基本的原理，那你可以试着正式开始玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570202,
					"content": "会很难吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "不会不会，你刚才不是学会怎么转动这些灯了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570204,
					"content": "正式玩的时候，只需要旋转这三盏灯，把它们映在屏风上的图案组合成一整个正确的图案就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570212,
					"content": "我会提前告诉你应该组合的图案，但是转动三盏灯的方式…可能就要你自己好好推敲一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570205,
					"content": "拼出来之后呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "唔，我不知道你注意到没有，后面的这些屏风，上面画的可都是我们璃月的「地图」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570207,
					"content": "当你把正确的图案拼出来，并且映在地图上之后，就可以发现我们冒险家协会特意准备好的「宝藏」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570208,
					"content": "为了设置那些藏宝地，协会可是请了很多人，折腾了很长时间呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570213,
					"content": "但是那些宝箱嘛…也和我对面的那些宝箱一样，如果你确定了地点，应该很好找的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570209,
					"content": "我已经把图案调整好了，今天的图案是<color=#00E1FFFF>「琉璃百合」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570210,
					"content": "哦对了，还有件事，这「玲珑霄灯图」上灯的图案，只有在晚上才看得最清楚，你最好是等晚上再过来玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570211,
					"content": "而且，这几盏灯可是协会专门请人来做的，这么漂亮的灯，不仔细看看的话，实在有些可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
