					"nextDialogs": [
						413570302
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570302,
					"content": "已经找到全部宝藏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "全部都找到了？你寻宝的功夫还不错嘛，不少人连灯都转不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570304,
					"content": "既然你找到了全部的宝藏…那这些奖励给你，收下吧，祝你在海灯节玩得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
