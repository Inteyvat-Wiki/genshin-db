			"trigger": {
				"objectNames": [
					"玥辉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "矿工大哥，我们是来汇报委托结果的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080102,
					"content": "哦！总算又见到你们了！之前我还有些担心，虽然付了钱，可仔细想想，委托别人调查那么诡异的地方，别出什么事才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80080103,
					"content": "万一有什么，我会一辈子良心不安的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80080104,
					"content": "没事没事，我们是谁呀！你看，我们不是好好的回来了吗？情况也都调查清楚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080105,
					"content": "厉害厉害！所以，下面是什么情况？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80080106,
					"content": "唔…欸…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080107,
					"content": "有一群丘丘人在下面养老。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "养老？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80080111,
					"content": "总、总之，到下面去的那些丘丘人都没有什么攻击性了，也希望矿工们不要故意打搅它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080112,
					"content": "没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "我们这些矿工可怕麻烦了，绝对不会主动招惹它们。我们眼里啊，只有亮晶晶的东西和金灿灿的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80080115,
					"content": "唔，唔…很可信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80080116,
					"content": "虽然不太明白你们在说什么，但有二位做担保，我就放心了，随时可以继续开工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80080117,
					"content": "这回多亏二位！跑这么一趟，辛苦你们了，这些谢礼就请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玥辉"
				},
				{
					"id": 80080113,
					"content": "可以放心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "下面是丘丘人们的理想乡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "理想乡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "玥辉"
				}
			]
		}
	]
}