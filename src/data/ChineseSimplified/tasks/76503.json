			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲林斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#哦？是{NICKNAME}和派蒙两位。没想到会在如此偏僻的地方与你们重逢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030102,
					"content": "你们是追寻着某种线索而来，还是意外地迷路至此？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030103,
					"content": "我们正在四处参观。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "原来如此。从这艘废船的甲板望去，月矩力试验设计局那庞大的轮廓，确实有种…异样的壮观，如同蛰伏的巨兽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030106,
					"content": "是啊，光是这样远远地看着，都很有压迫力呢。不知道里面到底藏着多少秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765030107,
					"content": "嗯，对于寻求独特素材的你们而言，它能提供不少的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030108,
					"content": "毕竟，光明与黑暗的交界，往往最能诞生引人入胜的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030109,
					"content": "嘿嘿，菲林斯站在这里，身边总伴着那盏幽蓝的灯，看起来就很有故事性呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765030110,
					"content": "说起来，你今天不用驻守在…呃…那个地方吗？是在休假？还是在巡逻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765030111,
					"content": "算是两者兼而有之吧。守望那些可能从阴影中滋生的灾祸，便是我们「执灯士」永恒的职责。无论身处何地，这份警惕都不能松懈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030112,
					"content": "不过，目前为止，此地的气息还算平稳。你们大可不必过于紧张，安心进行你们的创作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030113,
					"content": "机会难得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "为我留影么？这倒是有些出乎我的意料。说实话，我并不太习惯站在镜头面前，成为被审视的对象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030116,
					"content": "你们一定能够理解的。我更习惯与沉默的墓碑为邻，与逝者的低语为伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030117,
					"content": "不过，若是拒绝朋友这份真诚的请求，未免也太不解风情，失了待客之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030118,
					"content": "请随意，记录你们认为值得留存的瞬间。我很乐意为你们的艺术创作增添一份微不足道的灵感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 765030114,
					"content": "可以为你拍摄画片吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "顺便寻找拍摄素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
