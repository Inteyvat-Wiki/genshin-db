							"7321718",
							"2"
						],
						"stepId": 7321718,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "「我行现已开通前往荆夫港的航线，诚邀各位友商加盟我们的水果贸易。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171802,
					"content": "「等一下，从这到蒙德的航程，怎么说进口水果也太离谱了吧。你要是说酒水贸易我可能还有点兴趣。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
