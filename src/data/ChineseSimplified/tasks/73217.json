			"dialogs": [
				{
					"id": 732170101,
					"content": "此乃奥摩斯港港务主管所设公告板，奥摩斯港内外重要事务皆在此公示，如有问题也可在此留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "「还在为论文格式困扰吗？还在到处寻找论文灵感吗？该试试新方法了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170202,
					"content": "「本人知论派出身，兼通素论派、妙论派，承接论文写作辅导答疑业务。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170203,
					"content": "「是时候脱离痛苦了，去旅店联系阿曼迪普先生吧，可以讲价。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170204,
					"content": "「可以代写吗？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170205,
					"content": "「不行，监察官大人不会允许这种事情的发生。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170206,
					"content": "「确实，请潜心求学，不要心怀不轨。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "你听说过浮空术吗？你见过空中飞人吗？你想知道飞天驮兽背后隐藏的奥秘吗？那就不要错过枫丹飞天艺术团首次须弥展演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170302,
					"content": "欢迎光临，莫失良机，随到随看，仅需五摩拉即可观赏这一独特的艺术展演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170303,
					"content": "「实在太精彩了，我在枫丹也没看过这么精彩的表演！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
