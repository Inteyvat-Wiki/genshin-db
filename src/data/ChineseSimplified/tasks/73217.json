			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "水手船客、往来商旅、内外市民，本港规章均已于此公告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171502,
					"content": "如遇纠纷，可联系治安官夏姆寻求帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "「与其去须弥城里游览什么大巴扎，还不如看看我们奥摩斯港的旧市街。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171602,
					"content": "「比起被教令官指手画脚搞得面目全非的大巴扎，我们这里保留的须弥特色可要多得多了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171603,
					"content": "「当然，要是想欣赏舞蹈的话，还是得去祖拜尔剧场的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171604,
					"content": "「乡下人就是乡下人，须弥城的规划是由学者们精心设计的，分区无不遵循科学道理。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171605,
					"content": "「倒是有的人什么也不懂就在这里大放厥词，拿奥摩斯港这乱七八糟的街道当个宝了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171606,
					"content": "「不听不听，树洞人念经！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "「说起来实在难为情。我们原本是常年负责维护商船的工人，一直靠祖上传下来的手艺吃饭。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171702,
					"content": "「但是从前段时间开始，虚空录入了新的技术，以前的经验完全派不上用场了。年轻人还能通过虚空申请学习，我们这些年纪大了的，可就只能改行了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171703,
					"content": "「虽然书记官大人说我们可以出海碰碰运气，不过因为实在没钱还得再准备一段时间。大家有什么活计的话，也请来找我们吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171704,
					"content": "「别听那个书记官的，正巧我知道有位大主顾需要工匠，我这就把你们推荐给她。这些钱你们也先拿去吧，别考虑什么出海了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171705,
					"content": "「真希望你少做点无谓之事。有人成功，有人落魄，本身就是世间运行的定则，何必为了自己充好人而干涉世界的运行起落？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171706,
					"content": "「我们的书记官大人又开始讲他的神秘主义课程了。为什么？我开心！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171707,
					"content": "「你可不要忽视了，追求互助与公平的本性与义怒也是人驱动世界运转的道理，而不是什么『优胜劣汰』的谬论！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171708,
					"content": "「你也不要搞错了，我同样从来没有否认过你所说的这些，但你完全不懂我在和你说什么，我也不想再和你解释了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171709,
					"content": "「和血气上脑的人辩论真是头痛…话说回来，你自己的预算哪去了？别告诉我你把教令院的补贴都花在这种无聊的事情上了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171710,
					"content": "「『穷人穷苦于富人的富裕，所以富人应广散善财。』佐尔菲卡尔贤者说的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171711,
					"content": "「他没说过。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171712,
					"content": "「他说过。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171713,
					"content": "「他没说过，这个月酒钱你自己负责。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171714,
					"content": "「我不跟你争论这个了，但给我一个月时间，他一定说过。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
			"beginWay": "TALK_BEGIN_MANUAL",
