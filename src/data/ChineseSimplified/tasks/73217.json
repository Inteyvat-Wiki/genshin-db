			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "本港所有入港船只皆需在港务主管处登记所有人信息、入港事由等信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170502,
					"content": "若为商船还需提供载运商品的详细信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170503,
					"content": "商船未经登记不得在此卸货或开展贸易活动，一经发现，必将严惩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
