					"speakerTitle": "公告板"
				},
				{
					"id": 732170702,
					"content": "近期海兽活动频繁，出港船只请注意法逻斯塔发布的预警信息，或通过虚空提前获取海域信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170703,
					"content": "如有疑问，请咨询守塔人。",
					"roleType": "TALK_ROLE_NPC",
