				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "「沙普尔旅舍的服务虽然不错，但是房间隔音实在太差了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170902,
					"content": "「当初看奥摩斯港物价便宜才决定留在这里备考，看来我还是得搬去须弥城里才行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170903,
					"content": "「今年要是再考不上，就只能回老家种田了。不知道到时候能不能带点『丰沃之惠』走…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
