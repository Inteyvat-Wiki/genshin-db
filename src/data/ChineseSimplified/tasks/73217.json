			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "「最近派下来的教令官真是越来越没用了，什么事情都是一问三不知。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171002,
					"content": "「况且现在开放了虚空权限，这些外行的教令官水平还不如我呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171003,
					"content": "「也就只有那位不是经常能看见的书记官大人，上次还帮我们理清了船只调度的时间表。看来教令院还不至于全是傻蘑菇。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "「自从赛诺前辈当上大风纪官后，虽然要干的活变多了，但因为不用再牵扯进那些无聊的学派斗争，感觉反而轻松了不少。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171102,
					"content": "「不然我也不能趁着出差调查的功夫来这里偷懒。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171103,
					"content": "「最近赛诺前辈也不知道去了哪里，写在这里的话，应该不会被他看到吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171104,
					"content": "「我已经看到了。请限于明日中午之前自动报到，领受处分。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171105,
					"content": "「不要浪费我的时间。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
