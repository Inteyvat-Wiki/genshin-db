			"dialogs": [
				{
					"id": 732170601,
					"content": "本港现严查走私活动，凡经本港出入的货物皆需登记并接受检查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170602,
					"content": "如发现未经登记的货品或明令禁止进出口的违禁物品，将全部处以没收。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170603,
					"content": "由此造成的一切后果皆由所有人自行承担。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
