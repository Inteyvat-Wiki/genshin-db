					"nextDialogs": [
						732170802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170802,
					"content": "入住旅客如有教令院学籍，还有特殊折扣哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
