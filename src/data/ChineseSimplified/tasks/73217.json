				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "特别提醒，整个须弥的佣兵行业都由「镀金旅团」承接，绝无二家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170402,
					"content": "请勿轻信他人，以防被来头不明的人骗取佣金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170403,
					"content": "如需雇佣保镖、守卫，亦或其他委托，请联系「三十人团」驻奥摩斯港队长费罗兹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321705,
