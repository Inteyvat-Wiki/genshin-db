			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"多莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830901,
					"content": "根据莱依拉的纸条，应该要在这里和「全能商人」碰头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830902,
					"content": "看你们东张西望的神态，大概是在找「全能商人」吧？那就欢迎光临啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830903
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830903,
					"content": "对啊对啊，你很懂嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830904,
					"content": "不对，怎么是多莉？莱依拉说的「全能商人」原来就是你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830905,
					"content": "有什么好奇怪的？「桑歌玛哈巴依老爷的商品种类最多最神奇」，这是全大巴扎的老板和客人都知道的事哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830906
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830906,
					"content": "「万能」「全能」「大能」和不管什么能…都是我多莉的专属招牌。别的商人想用都免谈，除非先付几百万授权费！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830907
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830907,
					"content": "呃，我们早该想到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830908,
					"content": "话说回来，莱依拉居然找你们跑腿了？看来她真的沉迷在驯兽师大赛里了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830909
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830909,
					"content": "原来你和莱依拉的关系还挺好的，对她的情况很了解嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830910,
					"content": "嘿！这和关系好坏无关。莱依拉在我这里买过一些东西，虽然不算特别贵重，但对于一个学员来说，也算是出手阔绰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830911
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830911,
					"content": "我当然会留意她的动向，知道她参加了可疑的比赛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830912,
						400830913
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830912,
					"content": "你也知道些隐情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				},
				{
					"id": 400830914,
					"content": "嗯哼，我只是隐隐觉得不对劲罢了。正好我这里有些卖不出去的烫手货，屯着也是生锈，不如交给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830915
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830915,
					"content": "唔…看起来只是一些零件和残缺的笔记？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830916,
					"content": "听说是大赛主办方试图销毁的仪器和文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830917
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830917,
					"content": "他们太大意了，有些人拾荒发财的意愿可是很强的！这些东西都被打捞上来转手给了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830918
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830918,
					"content": "仔细看，这些文件上有些词汇跟「花花琼脂」的配方很像呢。仪器残骸也和「意智宝珠」的一些地方有相似之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830919,
					"content": "说不定是用来实验的产品。先收起来吧，到时候让神子看看，也许她能找到不对劲的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830920,
						400830921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830920,
					"content": "总之可以先假设…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830922,
					"content": "结果我们一开始的担心好像快要应验了…我还想和「咚咚小圆帽」无忧无虑地一起玩呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830923,
					"content": "虽然不清楚你们在商量什么，但看起来这些东西对你们还挺有用的。就给你们打个折好啦，六千万摩拉，谢谢惠顾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830924
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830924,
					"content": "欸！太狡猾了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830925,
					"content": "嘿嘿，开玩笑的，这种东西除了你们和风纪官也没人会关心了吧。就当是做了一单普通的生意，给你们的赠品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830926
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830926,
					"content": "莱依拉的订货单交给我吧，我只需要知道莱依拉想要的究竟是什么，备货后就托专人送过去，不劳你们跑腿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830927
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830927,
					"content": "吓死我了，我还以为我们要白干了，算上奖金都不一定能随便付这么多钱吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830928,
					"content": "这是莱依拉的订货单。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830929
					]
				},
				{
					"id": 400830929,
					"content": "呃啊，掺了松茸末的面粉、陈年果酱和墩墩桃汁…蕈兽真的会吃这些东西吗？莱依拉究竟是怎么知道的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830921,
					"content": "考特里亚有问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830913,
					"content": "你手里有情报吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				}
			]
		},
		{
			"id": 4008313,
			"completionStepIds": [
				4008313
			],
