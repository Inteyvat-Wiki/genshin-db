			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莱依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "#{NICKNAME}，派蒙。我在赛程上看见你们顺利晋级了，恭喜你们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400831302,
					"content": "哦哦！莱依拉，今天你很有精神嘛，「转转悠悠兽」也开开心心，看来也打了个大胜仗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831303,
					"content": "这次我赢得很惊险，只是勉强赢过对手一线，还好之前有和八重小姐一起去闭关训练。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400831304,
					"content": "刚刚「全能商人」托人把我要的东西送过来了，由衷感谢你们！待会儿我就带着「转转悠悠兽」去调整状态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400831305,
					"content": "呃咳咳…力气不够了…我们还是压低音量吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400831306,
					"content": "说起来，怎么没有看见神子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831307,
					"content": "八重小姐好像有什么急事，和左右加小姐他们先走了。好像还有一位「三十人团」的佣兵在给他们领路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400831308,
					"content": "我回到赛场的时候，他们已经走远了，追上去问话好像有点唐突…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400831309,
					"content": "也许她还有工作要忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "也对哦，这段时间神子一直在比赛，偶尔去处理一下主编大人的工作也很正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831312,
					"content": "而且神子说过，她想一边度假一边取材，说不定那个佣兵就是他们的导游呢，我们也不用担心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831313,
					"content": "嗯，接下来就是八强赛了，最关键的一场比赛…虽然有点害怕，但我们还是一起努力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400831314,
					"content": "好！这样看下来，我们晋级还蛮顺利的嘛，莱依拉一定要加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831315,
					"content": "我们也不能松懈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "没错，我们要保持警惕！至于从多莉手里拿到的东西，我们也拍几张照，和今早的照片放在一起，等到下次见面时给神子看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831316,
					"content": "要兼顾比赛和调查。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "毕竟「八重堂」的事务很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
		},
		{
			"id": 4008314,
			"completionStepIds": [
				4008307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008307",
							"2"
						],
						"stepId": 4008307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831401,
					"content": "看起来都是很普通的「花花琼脂」而已，毕竟是能展示给所有人看的东西，就连配方都摆在桌上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831402,
						400831403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831402,
					"content": "就算它们的成分有蹊跷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				},
				{
					"id": 400831404,
					"content": "那我们也没法把它们拿去调查啊，这算是偷盗了吧，会让我们丢掉比赛资格的，搞不好还要被「三十人团」抓起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831405
					],
					"speakerTitle": "派蒙"
				},
