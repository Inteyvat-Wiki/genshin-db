	"talks": [
		{
			"id": 4008305,
			"completionStepIds": [
				4008305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008305",
							"2"
						],
						"stepId": 4008305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"莱依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "神子！对不起！我们没想到「咚咚小圆帽」噼里啪啦一顿打，就把左右加小姐给淘汰了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830502,
					"content": "派蒙…驯兽师是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "哦？左右加是不是非常气馁，念叨着「凡人没法企及」之类的夸张说辞？蹲在地上哀嚎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830505,
					"content": "完全一致呢，你还真是了解她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830506,
					"content": "这样反而更好，左右加会把这次打击当成宝贵的素材，生动地描写出主角成长过程中所受的挫折，牵动读者们的心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830507,
					"content": "至于展现反派的压迫力，和精彩的夺冠过程，就要从你们身上取材啦。可别在我这个半吊子选手之前被淘汰哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830508,
					"content": "坏了，我成反派了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "蹭饭的事先别计较了啦！神子你千万要让左右加小姐笔下留情啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830511,
					"content": "#{NICKNAME}、派蒙、还有八重小姐…呃咳咳咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830512,
					"content": "莱依拉，你悠着点啊，好怕你直接昏倒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830513,
					"content": "我还好…之前我写信给生论派的学员了，没想到对方的反响很热烈，几个小时后就回了信，附上了我需要的资料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830514,
					"content": "根据这些资料，我试着给「转转悠悠兽」做了不少吃的，可能是因为食材不准确的缘故，「转转悠悠兽」不是很喜欢的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830515,
					"content": "之后我列出了一份改良版的清单，也包括了「咚咚小圆帽」可能喜欢的食材，结果搞到后半夜才睡，所以今天有点呼吸不畅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830516,
					"content": "这么快就有结果了？效率好高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830517,
					"content": "（只是没睡好…会呼吸不畅吗？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "小莱依拉那边的情况如何？有好好招待对手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830519,
					"content": "嗯！多亏八重小姐带我们去修行，「转转悠悠兽」更听我的话了，反应快得让我都有些羡慕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830520,
					"content": "但对手明显也变强了，我的压力有点大。为了打进八强赛，我想和「转转悠悠兽」再去训练一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830521,
					"content": "问题在于…我又想在明早七点去找「全能商人」，一次性买齐计划中的所有食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830522,
					"content": "#这很好办，我陪你去闭关训练吧，至于买东西的工作，拜托小家伙们就好了，{M#他们}{F#她们}很擅长帮人跑腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830523,
					"content": "听起来，你们两位好像经常为八重小姐工作呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830524,
					"content": "没错，我们很乐意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "啊！对对对！请别把我们写成凶巴巴的坏人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830527,
					"content": "不用担心，小莱依拉，他们刚刚还在为打败左右加的事向我道歉呢，你先去买杯饮品，喘口气吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830528,
					"content": "有劳你们了！实在感激不尽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830529,
					"content": "这里是我和「全能商人」碰头的地址，食材清单也写在上面了，请收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "莱依拉"
				},
				{
					"id": 400830530,
					"content": "不用这么客气啦！你也调查了「咚咚小圆帽」的喜好，我们这是在互相帮忙，你就放心去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830531,
					"content": "关于上次没能展开的讨论，这场比赛背后的「不安定因素」…或许有个不错的切入点——用来培养蕈兽的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830532,
					"content": "「花花琼脂」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "这可是小说里最精彩的桥段之一——秘密调查。小家伙一直很好奇吧？「意智宝珠」和「花花琼脂」的魔力究竟从何而来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830535,
					"content": "而且，不搞清楚这场比赛的底细，让海妮耶只凭自己的意愿莽撞行事，或许会闹出更大乱子哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830536,
					"content": "呜…话题突然变得好复杂，我有点听不懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830537,
					"content": "建议你们在临近天亮的时候行动，那段时间，人们通常都很疲惫。也许你们可以找到关键的线索哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830538,
					"content": "你真的要按神子说的做吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830539,
					"content": "这是最初参赛的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "这么一说也没错，那就等到明天凌晨，去培养蕈兽的地方看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830542,
					"content": "我们只是在确认比赛的安全程度。我是不会怀疑「咚咚小圆帽」的，你放心好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830540,
					"content": "这是为了和同伴安心共处。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "神子听说了什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "如果不答应，我们的形象就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "派蒙蹭反派的饭，派蒙更坏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "应该负全责的是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
