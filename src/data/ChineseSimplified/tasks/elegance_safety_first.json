			"dialogs": [
				{
					"id": 747000101,
					"content": "嘿嘿，我觉得装点水族箱明明还是很有趣的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000102,
					"content": "既然桑多涅不介意，我们以后不如也多下去捞点，让这里变得漂漂亮亮的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000103,
					"content": "喂，你们两个，过来一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000104,
					"content": "嗯？怎么了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000105,
					"content": "喏，这个给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000106,
					"content": "这是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000107,
					"content": "我帮你们改良的水下行动装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000108,
					"content": "欸？！真的吗？谢谢你桑多涅！你人真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000109,
					"content": "小机械装置而已，举手之劳。主要还是你们上次捕鱼，怎么说呢…很…原始…真让人有些看不下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000110,
					"content": "有…有这么不堪吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000111,
					"content": "效率低下，毫无技巧可言，而且一点都不优雅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000112,
					"content": "让你见笑了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "算了，你们有你们的习惯，我不多说什么。但既然你们想继续装饰这水族馆，最好带上我给的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000114,
					"content": "枫丹水下不只有温和好看的小鱼，还有很多具有攻击性的危险大鱼。这既是为你们的成功率着想，也是为了安全着想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000115,
					"content": "非常感谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "哼，行了，要下水就快去吧。回来后记得告诉我装置的使用感受，我可以根据你们的反馈进行调试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000116,
					"content": "我会带上它的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
