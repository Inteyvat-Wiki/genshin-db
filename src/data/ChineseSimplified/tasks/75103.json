			"dialogs": [
				{
					"id": 751030101,
					"content": "哇，好多鱼肉！你们在这里干什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030102,
					"content": "#欸？啊，你们好！金发的{M#大哥哥}{F#大姐姐}，还有白色的…白色的…呃，应该是妹妹吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030103,
					"content": "我和伊瓦伊正在等这些浮流鸟上岸呢。反正也没有什么别的事情好做嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030104,
					"content": "呃，等浮流鸟上岸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030105,
					"content": "呜，呜呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030106,
					"content": "好啦好啦，伊瓦伊是乖孩子，对吧？要有耐心，不可以着急喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030107,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030108,
					"content": "总之，我们原本打算来这里玩。除了朗戈叔叔，一般没人来这里，所以这就是我们的秘密基地！大概是这样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030109,
					"content": "结果没想到，今天反而被这些浮流鸟占去先机啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030110,
					"content": "所以呢，我就准备了这些鱼肉，打算把浮流鸟们吸引过来。浮流鸟可是很喜欢吃鱼肉的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030111,
					"content": "但浮流鸟好像并没有被吸引过来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "是呀，可能是因为距离太远了，没闻到鱼肉的气味吧？要是能想办法先把它们引到岸上来的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030117,
					"content": "哎，要是朗戈叔叔的话，估计会说<color=#00E1FFFF>「只要把它们撞上岸就好！」</color>之类的吧…可惜，我和伊瓦伊力气太小，只会被反过来撞飞啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030118,
					"content": "#嗯…{NICKNAME}，要不然我们来试试看吧？如果把浮流鸟引到岸上来的话，说不定它们就会被鱼肉吸引啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751030112,
					"content": "原来如此，派蒙其实也是浮流鸟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "圆滚滚的，喜欢吃鱼肉…原来如此，的确是浮流鸟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "帕尼娅"
				},
				{
					"id": 751030114,
					"content": "嗯，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "伊瓦伊"
				},
				{
					"id": 751030115,
					"content": "才不是呢！话说回来，这些浮流鸟不是完全没被吸引过来嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "派蒙"
				}
			]
		},
