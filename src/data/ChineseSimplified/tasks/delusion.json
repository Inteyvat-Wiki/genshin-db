			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宫心海",
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150101,
					"content": "#{NICKNAME}，哲平的情况还好吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150102,
						20150103
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150102,
					"content": "我们都没有注意到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				},
				{
					"id": 20150104,
					"content": "…我已经下令，在军队中收缴所有邪眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150105
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150105,
					"content": "绝大部分的人，虽然出现了生命力流失的现象，但情况还不严重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150106
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150106,
					"content": "但也有少部分人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150107
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150107,
					"content": "珊瑚宫大人，我打算单独开一个伤兵营，观察他们的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150108
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150108,
					"content": "将士们闹得很厉害，明知是邪眼，他们也打算用下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150109
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150109,
					"content": "此事交给你来负责，我必须要去一趟前线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150110
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150110,
					"content": "出了这么大的事情，军心一定会有所动摇。如果幕府军趁乱进攻，就功亏一篑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150111
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150111,
					"content": "#{NICKNAME}，你有什么打算吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150112
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150112,
					"content": "去阻止愚人众的计划。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150113
					]
				},
				{
					"id": 20150113,
					"content": "不行，太危险了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150114
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150114,
					"content": "锁国令还在继续，他们的邪眼应该是在稻妻生产的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150115
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150115,
					"content": "能够调动如此庞大的人力物力，背后必有本土势力支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150116
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150116,
					"content": "想要阻止他们，就只能捣毁他们生产邪眼的工厂。但那里一定有重兵把守…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150117
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150117,
					"content": "不能让你冒这样的风险，至少带着军队一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150118
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150118,
					"content": "没时间了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150119
					]
				},
				{
					"id": 20150119,
					"content": "珊瑚宫大人，我们收缴邪眼的时候很匆忙，应该瞒不过愚人众的眼线。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150120
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150120,
					"content": "如果我们再花时间整顿军队，他们听到风声，一定会提前逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150121
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150121,
					"content": "我知道…让我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150122
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150122,
					"content": "在收缴邪眼的时候，我确实想过。工厂既要庞大，又必须隐蔽，还要邻近交通要道，保证原材料供应…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150123
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150123,
					"content": "符合这些条件的地方不多，再结合士兵们收到邪眼的地点推断，工厂很可能是在<color=#00E1FFFF>八酝岛</color>西南部的临海山崖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150124
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150124,
					"content": "我不会阻止你，但你一定要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150125
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150125,
					"content": "我们失去了很多曾并肩作战的人，不想再失去你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150126
					],
					"speakerTitle": "珊瑚宫心海"
				},
				{
					"id": 20150126,
					"content": "我们也走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150127
					]
				},
				{
					"id": 20150127,
					"content": "欸？要去那个<color=#00E1FFFF>邪眼工厂</color>吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150128,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150129
					]
				},
				{
					"id": 20150129,
					"content": "真的吗？真的不再考虑一下吗？好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150103,
					"content": "情况是突然恶化的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				}
			]
		},
		{
