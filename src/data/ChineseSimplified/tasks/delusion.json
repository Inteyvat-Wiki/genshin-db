			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「散兵」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150401,
					"content": "没想到你们能找到这里来，做得不错嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150402
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150402,
					"content": "有趣。才见面，就是一副要找我拼命的样子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150403,
						20150404
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150403,
					"content": "你们制造邪眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				},
				{
					"id": 20150405,
					"content": "噢，原来是说这件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150406
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150406,
					"content": "你们似乎搞错了一点。我虽然站在这里，但也只是代为执行计划而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150407
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150407,
					"content": "主谋当然另有其人了。不是很能干吗？尽情去找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150408
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150408,
					"content": "才这点「小事」就被激怒了？你好像变了嘛…变得不堪一击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150409
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150409,
					"content": "你竟然说这是小事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150410,
					"content": "难道不是吗？在这浮世之中，人命如同草芥一般。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150411
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150411,
					"content": "没有邪眼，他们也一样会死。至少，邪眼还给了他们实现「愿望」的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150412
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150412,
					"content": "眼狩令的价值，你们真的了解吗？当初促成这件事花了不小的力气，自然是因为它有利于我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150413
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150413,
					"content": "不过现在看来，一切都很值得。制造纷争，为推广邪眼铺路，让力量自行吸引追寻它的弱者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150414
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150414,
					"content": "只需要一点点代价，就能得到掌握世界的感觉。用性命换取无上之力，挺划算的不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150415
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150415,
					"content": "眼狩令是你们促成的？难道说，你们从一开始就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150416,
					"content": "稻妻的外侧看起来十分稳固，但内侧…充满了留给我们的机会。稍加力气，就能从内部攻破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150417
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150417,
					"content": "永恒可以把时间拉得很长，然而，其间每一个节点都会变得无比脆弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150418
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150418,
					"content": "就像你在反抗军的朋友一样，无论怎么努力，都不过是徒劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150419
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150419,
					"content": "如同水中泡影，绚烂的同时，便会迎来毁灭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150420
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150420,
					"content": "越是失去就越想得到，越是无能就越要挣扎！哈哈哈，这种闹剧真让人开心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150421,
						20150422
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150421,
					"content": "哲平他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150423,
					"content": "#喂！{NICKNAME}，快冷静下来——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150422,
					"content": "他才不是无能之人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150404,
					"content": "你们把邪眼分发给反抗军…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				}
			]
		},
