			"dialogs": [
				{
					"id": 718050601,
					"content": "关于那两本书…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050602
					]
				},
				{
					"id": 718050602,
					"content": "书都送到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050603
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718050603,
					"content": "都送到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "谢谢你。「万文集舍」能开到现在，都是多亏了这些老客人的支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718050605,
					"content": "而且，这些老客人也都是真正爱书的人。能拿到好书，他们应该也会很开心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718050606,
					"content": "旅行者，谢谢你帮我这个忙，这些报酬请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718050607,
					"content": "如果你以后想买书的话，尽管来找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纪芳"
				}
			]
		},
