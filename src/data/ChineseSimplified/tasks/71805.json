			},
			"dialogs": [
				{
					"id": 718050501,
					"content": "年轻人，你有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050502,
					"content": "这是纪芳给你的书。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "我想起来了，之前我跟「万文集舍」订了一本《玑衡经》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050504,
					"content": "没错没错，这就是我要的书，总算送来了。呵呵，我还以为客人太多，纪芳把这本书的事给忘了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050505,
					"content": "送来就好，送来就好…哦唷，这装帧还不错，纪芳有心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050506,
					"content": "谢谢你年轻人，这本书我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "天叔"
				}
			]
		},
