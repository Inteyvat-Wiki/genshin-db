			},
			"dialogs": [
				{
					"id": 718050401,
					"content": "年轻人，你有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050402,
					"content": "这是纪芳给你的书。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "这是《帝君尘游记·四》？我记得我早就订了这本书，怎么拖了这么久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050404,
					"content": "让我看看…咦？居然是初版，难怪现在才送来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050405,
					"content": "我还以为是因为客人太多，纪芳把这本书的事给忘了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050406,
					"content": "这本书我就收下了，谢谢你，年轻人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德安公"
				}
			]
		},
		{
