				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "这是…一艘，呃不，是半艘船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030102,
					"content": "为什么这种地方会有半艘船？咦，这船身上面还刻着字呢，我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030103,
					"content": "「…居然前半截没了，剩下后半截还能飘这么远，真不愧是我的船，哈哈哈…不过，船上的东西大概都已经沉进海里了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030104,
					"content": "「…好像，是顺着东南方漂流的来着？算了，不管这些，剩下要解决的问题，就是怎么离开这里…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030105,
					"content": "好像是一群遇到海难的人了呢，这上面说「前面半截」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030106,
					"content": "呜哇…难道这里就是「后面半截」吗？整艘船都断成两截了，他们到底遇见了什么啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030107,
					"content": "唔，这上面说，他们顺着「东南方」漂流来着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030108,
					"content": "那我们也顺着他们漂流的方向，去找找这艘船的「前面半截」吧，说不定会有什么发现呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030109,
					"content": "把这段刻着字的木板也带上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "你是觉得，这上面刻的字也会是线索吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030111,
					"content": "好吧，反正这船上的木板看着都快坏掉了，应该很简单就能掰下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790030112,
					"content": "拿下来之后，我们就快点去找另外半截船吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
