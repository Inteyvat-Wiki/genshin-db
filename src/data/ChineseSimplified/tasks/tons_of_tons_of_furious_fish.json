			"dialogs": [
				{
					"id": 747100101,
					"content": "嗯…在足够宽敞，装饰还特别用心的水箱之中，乖巧的鱼儿们来回游动…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100102,
					"content": "这场景的确非常漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100103,
					"content": "这也是水族馆吸引人的地方之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747100104,
					"content": "要是它们在开放的水域里也这么安分就好了，潜入水下的人们就能更沉浸地享受自然生命的美景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100105,
					"content": "言归正传，多亏你们的协助，我查出了这些鱼儿暴躁的原因——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100106,
					"content": "这些年来，陆陆续续发生了一些水运事故，还有坏家伙违法倾倒废弃物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100107,
					"content": "大量人造物品沉入海底，不断堆积，破坏了许多鱼儿的栖息地，导致鱼儿们的攻击性愈发高涨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100108,
					"content": "之前，已经有一批潜水员接到委托，开始专门处理这些垃圾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100109,
					"content": "看来得提醒他们，有劳他们加快进度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100110,
					"content": "听起来短期内无法解决啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "是的，在此期间，我们还是继续之前的工作，尽可能把更多暴躁的鱼儿请回来休养吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100113,
					"content": "将病患与致病环境隔离开来，是相当重要的步骤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747100114,
					"content": "收到！就放心交给我们吧，我们继续寻找患者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747100111,
					"content": "一时半会儿应该处理不完…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
}