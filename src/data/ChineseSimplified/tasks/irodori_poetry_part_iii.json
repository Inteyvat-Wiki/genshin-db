			"trigger": {
				"objectNames": [
					"莱内",
					"大伴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "大伴先生的这首诗，突破了稻妻诗歌的格式，却又用了稻妻的古典手法，罗列了人生中各种难忘的回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726930602,
					"content": "是想告诉我，蒙德和稻妻，虽然看起来大相径庭，但是却也有共通的美感吧。正如我们二人抛开蒙德人与稻妻人的身份，单纯作为诗人的交流一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726930603,
					"content": "莱内先生这样年轻，却能如此快速地领会诗句的情谊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930604,
					"content": "老头子我之前以为所谓忘年之交不过是一些妄言，今天才知道确有其事，也算是一大快事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930605,
					"content": "#还有这位玉成雅事的{M#小哥}{F#姑娘}，我们三人能在这里相会，也算是有缘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930606,
					"content": "是啊，远渡来稻妻这一路上的颠簸都不重要了，而即便回到蒙德，我也会鲜明地记得稻妻的一草一木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726930607,
					"content": "这也多亏了这位朋友带来的画片，谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726930608,
					"content": "希望将来有一天，我们三人还能有机会再会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930609,
					"content": "一定会的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱内"
				}
			]
		},
