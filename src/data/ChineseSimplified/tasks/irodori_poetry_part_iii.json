					"大伴",
					"莱内"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "#{M#小哥}{F#姑娘}，你来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930102,
					"content": "昨天的诗，莱内先生写出了我们的相见恨晚之感，那么自然我也打算作一首诗赠于他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930103,
					"content": "能得到大伴先生的赠诗，我可真是太荣幸了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "莱内"
				},
				{
					"id": 726930104,
					"content": "虽说我已经是个老头子了，但最近结识了数位蒙德朋友后，我也对蒙德产生了不小的兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930105,
					"content": "这首诗我仿照了蒙德吟游诗人的写法，诗句中还会提到一些蒙德的景物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930106,
					"content": "#可惜我不曾去过蒙德，不知道这位{M#小哥}{F#姑娘}，能否帮我拍摄一些<color=#00E1FFFF>蒙德的特产</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930107,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "#哈哈，{M#小哥}{F#姑娘}，那就劳烦你了。与前几日一样，要四张画片就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269304",
							"2"
						],
						"stepId": 7269304,
						"stateName": "QUEST_STATE_UNFINISHED"
