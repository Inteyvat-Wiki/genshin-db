			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大伴",
					"莱内"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "#{M#小哥}{F#姑娘}，画片的事情怎么样了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930202,
					"content": "在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "谢谢，谢谢，有了这些素材，应该可以写出满意的诗句来。嗯，让我构思一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930204,
					"content": "#{M#小哥}{F#姑娘}，根据你的画片，我试写了这些。诗里具体要用哪句，也请你来选一选吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
				}
			]
		},
		{
			"id": 7269303,
