			"dialogs": [
				{
					"id": 726930501,
					"content": "这里的野果是虚指一些悲伤的事情吧，不像初次饮酒、初次读诗一样是什么愉快的记忆，但是却和即将到来的离别一样，让人印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱内"
				}
			]
		},
		{
