				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610201,
					"content": "将「触媒」的能量分给了赞玛兰。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "呜哇，大蘑头亮起来了！现在是不是该叫「荧光大蘑头」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610203,
					"content": "#赞美{NICKNAME}，赞美派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610204,
					"content": "#多亏{NICKNAME}，多亏派蒙，赞玛兰重获了生命的辉光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610205,
					"content": "但切不可放松大意，赞玛兰知道，邪气的源头仍在，邪气随时可能再来袭扰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610206,
					"content": "欸，那该怎么办才好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610207,
					"content": "呜啊，哪里冒出来的这些黑泥？这就是大蘑头说的「邪气」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#赞美{NICKNAME}，赞美派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610302,
					"content": "赞玛兰的呼唤久久未得到回应。多脚的和四脚的自不必说，两脚的也对赞玛兰的呼救置若罔闻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610303,
					"content": "#只有真正有智慧者才会回应赞玛兰的呼唤。派蒙是有智慧者，{NICKNAME}也是有智慧者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610304,
					"content": "两脚的之中的佼佼者理应获得赞玛兰的感谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610323,
					"content": "哼哼，「有智慧者」派蒙，不容小觑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610305,
					"content": "小事一桩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#相信假以时日，{NICKNAME}和派蒙也能成为与赞玛兰和赞玛兰的同族相提并论的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610307,
					"content": "等等，大蘑头这话是什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610308,
					"content": "多脚的不如四脚的，四脚的不如两脚的，自然两脚的也不如无脚的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610309,
					"content": "#虽然{NICKNAME}和派蒙先天不足，但只要有心，后天的努力也未必不能改变运命的走向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610310,
					"content": "不过是个荧光大蘑菇而已，竟然这么嚣张！不知道荧光蘑菇能不能做成料理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610311,
					"content": "野菇鸡肉串应该不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "漂亮的蘑菇都会骗人，一定有毒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "派蒙胃口不小。今日吃蘑菇，明日吃蘑菇，百日之后派蒙之中已经不剩派蒙，只留蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610314,
					"content": "#呜呜，{NICKNAME}，大蘑头讲话好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610315,
					"content": "唔，派蒙不懂幽默。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610316,
					"content": "这话一点也不幽默！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610317,
					"content": "赞玛兰摆脱了邪气，同族却仍在受苦。而今的赞玛兰力有不逮，无法像过去那般为弱者提供庇佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610318,
					"content": "#赞玛兰恳请{NICKNAME}，莫要吝惜哀怜，拯救无法自救的弱者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610319,
					"content": "#意思是，还有其他的病怏怏的蘑菇吗？{NICKNAME}，要不要帮帮它们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610320,
					"content": "来都来了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "如果顺路的话。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "那就快点出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610207,
					"content": "呜啊，哪里冒出来的这些黑泥？这就是大蘑头说的「邪气」吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
