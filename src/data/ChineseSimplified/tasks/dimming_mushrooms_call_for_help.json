			"dialogs": [
				{
					"id": 710610401,
					"content": "#赞美{NICKNAME}，赞美派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610402,
					"content": "虽于心不安，但且容赞玛兰直言，正如两脚的有言：「帮人帮到底」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610403,
					"content": "你该不会还有事情想让我们跑腿吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "可你不是人而是蘑菇啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "两脚的这等远见卓识的确配得上有智慧者的称号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610406,
					"content": "同为安享大地恩惠的有生之物，彼此扶助才顺应道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610407,
					"content": "还请不要推辞，收下这份「才慧之瑞佑」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610408,
					"content": "获得了「才慧之瑞佑」。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "呜啊…这是什么东西，看起来好可疑的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610410,
					"content": "此处仍有不少邪气在空中游荡，赞玛兰能够感知，却无法分辨源头的所在。沿水流探索，必定会有所发现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME}只要对邪气的源头使用「才慧之瑞佑」，赞玛兰的同族自会把问题处理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610412,
					"content": "邪气的源头…的确不能放着不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "…说真的，你怎么不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME}比派蒙更懂幽默。赞玛兰无脚而{NICKNAME}有脚，有脚的活计自然由有脚的完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610415,
					"content": "况且赞玛兰身负更重要的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610416,
					"content": "更重要的使命指？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#此番消耗了太多气力，和{NICKNAME}、派蒙交谈非常愉快，但赞玛兰需要休眠，积蓄力量抵御邪气，荫蔽同族，繁衍生息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610418,
					"content": "#祝福{NICKNAME}，祝福派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "赞玛兰"
				},
				{
					"id": 710610420,
					"content": "喂，大蘑头，喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}，看来大蘑头已经睡着啦，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610207,
					"content": "呜啊，哪里冒出来的这些黑泥？这就是大蘑头说的「邪气」吗？",
