				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉莉希"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766690101,
					"content": "（或许<color=#FFCC33FF>菈乌玛</color>会关心「飨月餐」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766690102
					]
				},
				{
					"id": 766690102,
					"content": "您好，是要…呜哇！菈乌玛大人，您怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690103
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690103,
					"content": "辛苦了，莉莉希。今天发放「飨月餐」时，还顺利么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690104
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766690104,
					"content": "嗯！可顺利啦，无论是做「飨月餐」还是发「飨月餐」，都超级超级顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690105
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690105,
					"content": "自从雅珂达小姐来陪我发了几天餐之后，就再也没有人来捣乱，也没有人插队了，大家都很听话地排队拿餐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690106
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690106,
					"content": "之前，一直有一个大块头来捣乱，不仅乱插队，还一个人拿好几份餐…坎托尔先生上去阻止，还被揍了好几拳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690107
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690107,
					"content": "那一天，正好雅珂达小姐也来拿餐，看见那个大块头捣乱之后，她一下子跳起来，狠狠地把那家伙踹翻啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690108
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690108,
					"content": "雅珂达小姐踹翻那家伙之后，还稳稳地接住了那一份没打开的「飨月餐」，然后，她就指着趴在地上的人说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690109
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690109,
					"content": "「既然对恩人和食物都没有敬畏之心，那你今天就饿着吧。滚一边去，别挡着路，当心我再给你一脚！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690110
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690110,
					"content": "之后，雅珂达小姐就陪我一起发了好多天餐…为了感谢她，我也做了很多好吃的送给她啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690111
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690111,
					"content": "如此说来，的确应当感谢她。或许…我也应当为你再雇一个护卫，就和我上次说的一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690112
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766690112,
					"content": "欸？不用的不用的，本来人手就不够，与其多雇一个护卫，不如再多开一个发放餐食的地点呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690113
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690113,
					"content": "而且，现在秩序真的已经很好了。雅珂达小姐偶尔也会过来看一眼，有她和坎托尔先生在，肯定不会再有人来捣乱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690114
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690114,
					"content": "希望如此。这样吧，莉莉希，我会让我的几位朋友轮流过来，如果你需要帮助，就告诉它们吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690115
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766690115,
					"content": "朋友…？应该也是住在岛上吧，我认识么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690116
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690116,
					"content": "呵呵，你对它们一定不陌生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690117
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766690117,
					"content": "那我就不打扰你了。再见，莉莉希。愿月神护佑你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690118
					],
					"speakerTitle": "菈乌玛"
				},
				{
					"id": 766690118,
					"content": "再见！菈乌玛大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉希"
				}
			]
		},
