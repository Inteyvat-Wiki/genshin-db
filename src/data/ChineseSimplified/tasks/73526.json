	],
	"talks": [
		{
			"id": 7352601,
			"completionStepIds": [
				7352601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352601",
							"2"
						],
						"stepId": 7352601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玛蒂哈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735260101,
					"content": "早知道就找人帮忙跑腿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260102
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260102,
					"content": "只不过是第一次测试，居然就要翻山越岭，这是什么人间疾苦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260103
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260103,
					"content": "你不要紧吧？说话都有气无力的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260104,
					"content": "#{NICKNAME}，她看起来完全虚脱了，我们做点东西给她吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260105,
					"content": "在附近的炉灶做好了热气腾腾的炸萝卜丸子和烤肉排，让这位虚脱的陌生人补充了体能…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260106
					]
				},
				{
					"id": 735260106,
					"content": "哈哈哈哈！我又活过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260107
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260107,
					"content": "手艺还不错，可惜食材和调料的品质不好，导致食物的口感干巴巴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260108
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260108,
					"content": "这种时候就不要挑三拣四了啦，吃饱肚子不就行了吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260109,
					"content": "错了错了！越是困苦的时候，越要想象奢侈的生活，这样才能给自己奋斗的动力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260110
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260110,
					"content": "越是资金周转不开时，越要想办法高额借款，这样才能大开大合，抓住破局的机会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260111
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260111,
					"content": "这就是我，「幻之玩具王·玛蒂哈」给你们的回报——逆转局势的商业秘诀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260112
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260112,
					"content": "幻…之玩具王？听起来倒是挺威风的，不过看你狼狈的样子，总感觉有蹊跷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260113,
						735260114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260113,
					"content": "玩具还没造好吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				},
				{
					"id": 735260115,
					"content": "你们！你们是怎么看穿的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260116
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260116,
					"content": "刚才你都饿得快昏倒了啦，神志不清的时候还在自言自语，说什么测试，找人跑腿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260117,
					"content": "一看就知道，你还没做好你的招牌玩具吧？甚至连饭都顾不上吃了，未免也太惨了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260118,
					"content": "可…可恶，被你这么一说，我好不甘心！我的「吼吼小狐」已经进入生产前的最终阶段了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260119
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260119,
					"content": "只要测出了「吼吼小狐」的飞行包线，就能完成蕈兽都能看懂的说明书。再借一大笔钱批量生产，就能盈利了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260120
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260120,
					"content": "什么飞行包线？什么说明书？不要对我们讲这么多术语啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260121,
					"content": "空谈无益，就让你们见识一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260122
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260122,
					"content": "玛蒂哈从行囊中取出了一个蓝色的包裹，对它快速充气。\\n片刻过后，造型奇妙的玩具便在你们的面前成形了，稳稳地飘浮在半空中。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260123
					]
				},
				{
					"id": 735260123,
					"content": "这就是你说的王牌玩具吗？明明一点都不像狐狸啦！还不如起个…「大耳朵日落果炸弹·青之星星限定版」之类的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260124,
					"content": "还有，「吼吼」是怎么回事？它的表情也不像在笑啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260125,
					"content": "不不不，是因为它的喷气装置工作时的动静听起来像是人在吼吼大笑！不信你们听听看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260126
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260126,
					"content": "（发出难以名状的低频啸叫，大概也许勉强可以用「吼吼」来打比方）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260127
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260127,
					"content": "#她到底从哪听到的这种笑声…{NICKNAME}，我有点担心她的精神状态…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260128,
					"content": "总之，「吼吼小狐」由小型热气球提供升力，隐藏的小喷气口提供推力，有着不错的操作性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260129
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260129,
					"content": "想象一下，它可是能灵活飞行的玩具！别说一般的小孩了，就连大人也无法抵抗它的诱惑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260130,
						735260131
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260130,
					"content": "这么一说，确实很新奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260132,
					"content": "我闻到了熟悉的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260133,
					"content": "让我猜猜看，玛蒂哈的下一句话是——「拜托你们帮我完成最后的测试吧，我会给你们一笔报酬的」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260134,
					"content": "#但我和{NICKNAME}还得好好商量一下，毕竟我们很忙，只拿一点点报酬可是吃亏的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260135,
					"content": "不不不，只是一点奖金可不够，让我算算看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260136
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260136,
					"content": "「吼吼小狐」一年内总销售额的六成，哦不，七成分红，你们觉得足够吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260137
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260137,
					"content": "七成！这未免也太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260138,
					"content": "咳咳…这才像话嘛，「幻之玩具王」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260139,
						735260140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260139,
					"content": "一年内能量产吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260141,
					"content": "这就是关键所在了，两位！你们尽快完成测试，就能让「吼吼小狐」提前投入生产和销售，拿到更多分红！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260142
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260142,
					"content": "我们一起努力，把产品做到最好，才能达成双赢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260143
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260143,
					"content": "也对哦，越想越有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260144,
					"content": "#嘿嘿，{NICKNAME}，这样一来，我们也算是进军玩具产业，称得上是商业人士了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735260145,
					"content": "事不宜迟，我之前请教过不少冒险家，根据他们的经验，布置了几个测试飞行包线的挑战，先给你们大概指示一下方位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260146
					],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260146,
					"content": "「吼吼小狐」的未来，还有「幻之玩具王」的招牌，全都拜托你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛蒂哈"
				},
				{
					"id": 735260140,
					"content": "量产了也未必能盈利…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260131,
					"content": "说不定能卖得很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260114,
					"content": "也许已经破产了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				}
			]
		}
	]
}