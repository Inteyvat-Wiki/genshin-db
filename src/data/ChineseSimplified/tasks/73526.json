{
	"id": 73526,
	"type": "WQ",
	"name": "「幻之玩具王」和「吼吼小狐」",
	"description": "在「琉形蜃境」中漫步之时，你和派蒙发现了一位困顿之中的商人，或许有效帮助她以后，你们也能得到少见的回报…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2023,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
