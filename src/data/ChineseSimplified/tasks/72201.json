				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蛎罗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "哎呀哈哈哈哈哈…哈哈…哈哈哈哈哈！！哦哟哟…岔气了岔气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010202,
					"content": "哈哈哈哈眼泪都笑出来了！！阿雀呀，要是你还在这里就好了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010203,
					"content": "我有点生气了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "哈哈哈哈对不起，对不起…别生气嘛。是这么回事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010206,
					"content": "我和妻子从前就一直喜欢捉弄别人，各种恶作剧从来没有重样的，大家也都乐在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010207,
					"content": "后来呀，她生了场大病，去得早…那时候吩咐我，一定要在她的坟前好好地整一个老实人，不然她的灵就没办法离开…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010208,
					"content": "为了完成阿雀的愿望…怎么样，我做的还不错吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010209,
					"content": "这个玩笑很无聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "啧，啧。岛外的人呀，一点都不有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010213,
					"content": "就连喷水痦子戏法你也不愿意看…真是无聊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010214,
					"content": "再见，我走啦，我走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010210,
					"content": "会出人命的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "我不会再相信你的胡说了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "告诉我这是怎么回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
