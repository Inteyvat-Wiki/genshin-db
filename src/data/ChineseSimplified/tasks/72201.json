	"talks": [
		{
			"id": 7220101,
			"completionStepIds": [
				7220101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220101",
							"2"
						],
						"stepId": 7220101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蛎罗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "唉…过路的人呀…可怜可怜我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "谢谢你还愿意听一个老人自倒苦水…唉…过来，过来，听我多聊几句吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010105,
					"content": "我这辈子呀…就没有一天转运的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010106,
					"content": "我刚出生的时候，主持出生礼的祭司大人不小心碰翻了油灯，烧光了姑妈的一头长发…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010107,
					"content": "哎哟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "后来，我患上了奇怪的病，从此四肢不调；再后来有一天，我从摇篮中被甩飞出来，摔断了六根肋骨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010109,
					"content": "等我长大了一点，有一天表叔被蘑菇呛了个半死，我爸爸在抢救他的时候用铲子打中了我的头…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010110,
					"content": "然后有一次，心爱的小团雀被家里养的鹈猿兽吃掉了，鹈猿兽被一头瞎野猪撞下了山崖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010111,
					"content": "然后，喜欢的女孩子不小心把祭司大人献祭给了雷鸟大人，被驱逐出岛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010112,
					"content": "等我长大成人，奶奶因为我长得太丑郁郁而终；后来爷爷也随她而去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010113,
					"content": "再后来呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010114,
					"content": "家庭对你来说多少算是慰藉吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "啊，说起家庭…我成人礼的时候，巫医大人说我可能不会有孩子了，因为我长了一个…等一下，我给你看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010116,
					"content": "不要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "唉…再听我说最后一句吧…也是我想拜托你帮一个可怜老人最后的忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010119,
					"content": "请你直说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "前些阵子，我埋葬妻子的时候不小心把自己的金戒指掉进了墓坑，也一并埋进去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010122,
					"content": "那是我最后的财产了…可我不敢重新挖出来…因为那样会触怒她的灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010123,
					"content": "所以你要我偷坟掘墓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "你是外人嘛…外人做什么都不奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010125,
					"content": "啊不是，不是…我的意思是，如果是外人的话，就可以避免触怒本地的灵了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010126,
					"content": "去千来神祠吧…她的坟墓就在神祠的旁边呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蛎罗"
				},
				{
					"id": 722010120,
					"content": "不要再提奇怪的话题就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "这个话题已经足够了！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "需要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
		{
			"id": 7220102,
			"completionStepIds": [
				7220103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
