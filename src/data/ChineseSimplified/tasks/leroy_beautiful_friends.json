			"dialogs": [
				{
					"id": 741570201,
					"content": "此屋待售。价格实惠，欲购从速。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "房屋出售信息"
				},
				{
					"id": 741570202,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，还有派蒙姐姐，勒鲁瓦先生好像不住在这里了。你们后来见过他吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570203,
					"content": "（喂，要说实话吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741570204,
					"content": "见过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "原来你们见过！那你帮我告诉他点心很好吃了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570206,
					"content": "说了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#我就知道{NICKNAME}{M#哥哥}{F#姐姐}会守信用，你们真好，我带了泡泡桔过来，请你们一起吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570214,
					"content": "茉莉叹了口气，向你们挥手作别，正打算离开这条街道…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "大门打开，秋和阿托斯从屋内走了出来。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "果然外面的声音是你们。还有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570217,
					"content": "只是正巧路过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "是吗？世界真小。正好我和秋也打算离开了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570219,
					"content": "伯努瓦呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "哦，他已经去别的地方了，那个地方我们几十年后才会去，你们短期内应该见不到他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570221,
					"content": "不过这也不好说，明天和意外究竟哪个先来？谁知道呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570225,
					"content": "这不是那个总来找伯努瓦的小鬼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570227,
					"content": "阿姨你好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570228,
					"content": "…太像了，还有紫色的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570229,
					"content": "阿、阿姨有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570230,
					"content": "你多大了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570231,
					"content": "我九岁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570232,
					"content": "你爸爸妈妈叫什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570233,
					"content": "唔…阿姨怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570234,
					"content": "你的表情…这个小孩怎么了？…总不会这么巧吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570235,
					"content": "告诉我你是不是被收养的，快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570236,
					"content": "#…{NICKNAME}{M#哥哥}{F#姐姐}，这个阿姨你认识吗？她要干什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570237,
					"content": "哪有你这么问的，我来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570238,
					"content": "小姑娘，我记得你和爸爸关系很好，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570239,
					"content": "对，勒鲁瓦先生对我特别好。女婿叔叔，他是不住在这里了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570240,
					"content": "没错，他去了很远的地方，以后不回来住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570241,
					"content": "爸爸他平常都和你们聊些什么呀？可以告诉我吗，回去我可以告诉爸爸，你很想念他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570242,
					"content": "勒鲁瓦先生请我吃点心，让我摸娜娜，还会夸我眼睛好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570243,
					"content": "还有呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570244,
					"content": "他经常让我代他向爸爸妈妈问好，虽然爸爸妈妈非常不喜欢这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570245,
					"content": "每次爸爸都会很生气，说勒鲁瓦先生是坏人，是「勒索」他们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570246,
					"content": "虽然爸爸妈妈不许我过来，但是我和勒鲁瓦先生约好了，所以我还是会偷偷过来，叔叔你不要告诉我爸爸哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570247,
					"content": "他就是会做这样的事，不把最后一点价值榨干绝对不停手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570248,
					"content": "…混账…不好意思，刚才我们在说别的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570249,
					"content": "叔、叔叔阿姨还有别的事情吗？没有的话，我、我先回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570250,
					"content": "…你的爸爸和妈妈爱你吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570251,
					"content": "他们是世界上最好的爸爸和妈妈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570252,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570253,
					"content": "这很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570254,
					"content": "我要回家了，叔叔阿姨再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570255,
					"content": "再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570256,
					"content": "这样就行了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "这个场景我想象过很多次…没有一个比知道她过得幸福更好，这样就够了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570259,
					"content": "我…不是我父亲，我不打算给她现在的家庭找麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570260,
					"content": "不是我故意扫兴，你不是买了一个音乐盒给她吗？也不送了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570261,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570262,
					"content": "没有必要了，她…看起来不缺这种东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570263,
					"content": "以后我会经常想办法来看她的，她需要什么我会想办法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570264,
					"content": "…这个盒子我送给别人吧，好歹挑了那么久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570265,
					"content": "白头发的小女孩，你喜欢礼物吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570266,
					"content": "我吗？你要送给我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741570267,
					"content": "是的，就送给你，让它发挥最后一点价值吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570268,
					"content": "阿托斯，抱歉，我们还要在枫丹廷逗留一阵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "莫蒂西娅"
				},
				{
					"id": 741570269,
					"content": "没关系，去哪里对我来说都一样。走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570270,
					"content": "你们目送他俩走出这条街，勒鲁瓦一家的故事就此结束。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "不打算让她知道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "伯努瓦怎么样了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "这个世界上充满了不均衡，过度的贫乏和过度的贪婪，枫丹的律法没能施予的惩罚，就由我们自己施予吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570224,
					"content": "我的意思是，他去他该去的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570208,
					"content": "忘记了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "啊，好吧。那太遗憾了，唉，看来我是再也没机会让勒鲁瓦先生知道了。那我带过来的泡泡桔…还是送给你们好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570210,
					"content": "没见过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "啊，那太可惜了，我应该再也见不到勒鲁瓦先生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570212,
					"content": "#我带了泡泡桔过来，本来觉得说不定能见到勒鲁瓦先生，既然他不住在这里了，这些桔子就给{M#哥哥姐姐}{F#姐姐们}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570213,
					"content": "不管怎么说，我想我会一直记得勒鲁瓦先生的。再见啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "茉莉"
				}
			]
		},
