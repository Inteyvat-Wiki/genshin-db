			"dialogs": [
				{
					"id": 741780201,
					"content": "#你好，{M#小兄弟}{F#小妹妹}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780202
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780202,
					"content": "今天可真是糟糕的一天啊，你说对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780203
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780203,
					"content": "你不走运，我们也倒霉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780204
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780204,
					"content": "你带宠物散步，遇上我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780205
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780205,
					"content": "你不走运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780206
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780206,
					"content": "我们本想差不多收工了，但遇上你，也只好打起精神再干一票。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780207
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780207,
					"content": "我们倒霉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780208
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780208,
					"content": "派蒙，怎么办，我们被打劫了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780209
					]
				},
				{
					"id": 741780209,
					"content": "难道不应该先反驳我不是什么需要带到户外散步的宠物吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780210,
					"content": "算了…这种时候就要表现得比对方更凶狠才行，看我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780211,
					"content": "#我们可是大名鼎鼎的{NICKNAME}和派蒙，你们这些不法之徒，要是不想吃不了兜着走，就赶紧退下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780212,
					"content": "多稀罕哪，这么能说会道的宠物，要是我们抓了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780213
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780213,
					"content": "肯定能卖个大价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780214
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780214,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780215,
					"content": "话不多说，这就开打吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780216
					]
				},
				{
					"id": 741780216,
					"content": "请、请等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780217
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780217,
					"content": "哈维沙姆先生、金格尔先生，我们不是说好了吗？只要我交出手上这批货物，两位这段时间就不再为难来往的无辜行人和小动物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780218
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780218,
					"content": "这么说来我们认识尚浅，还没给你讲过我们的经历。从前我们在枫丹廷当学徒，后来被赶走了，你知道为什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780219
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780219,
					"content": "他们说，不够上进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780220
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780220,
					"content": "对！可是不管怎么说，我们哥俩都是知错能改的人。既然上一份工作因为不够上进丢了，那对现在的工作就得十二分上进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780221
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780221,
					"content": "我对打击恶势力也十五分有兴趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780222
					]
				},
				{
					"id": 741780222,
					"content": "#看不出来，{M#小兄弟}{F#小妹妹}个头不高，志气不小。看来今天是非打不可了，也好，让你见识一下我们哥俩的本领。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780223
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780223,
					"content": "十八分厉害的本领。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780224
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780224,
					"content": "停一停，请停一停。听我一句劝吧，几位，这样无谓的争斗对你们双方又有什么益处呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780225
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780225,
					"content": "无论是两败俱伤，还是其中一方殒命，这样的结局都是我所不乐见的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780226
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780226,
					"content": "所幸我的钱财够多，虽然没有二十分那么多，但我愿意多付一份赎金，只求你们双方不要再纠缠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780227
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780227,
					"content": "你…你没事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780228,
					"content": "啊，谢谢关心，除了暂时少了一些活动的余裕，其他一切都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780229
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780229,
					"content": "是他们把你关起来的对吧？为什么你不仅不向我们求救，还要再多向他们付一份赎金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780230,
					"content": "好心的朋友，生活中总有些困境是仅靠自己的力量难以克服的，我相信哈维沙姆先生和金格尔先生现在就在这样的困境中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780231
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780231,
					"content": "如果能用一点微不足道的钱财，拯救两个，或者甚至是四个人，还有比这更便宜的买卖吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780232
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780232,
					"content": "至于我，不劳两位费心，我已与哈维沙姆先生和金格尔先生约定好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780233
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780233,
					"content": "我带他们取走一批货品，届时他们就会将我释放。而他们也便有了本金，可以换个营生，不用再与无辜行人和小动物为难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780234
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780234,
					"content": "你的确是这么说的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780235
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780235,
					"content": "我们的确是这么听见的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780236
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780236,
					"content": "居然为了素不相识的人…真是金子一般的心啊，我真是太感动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780237
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780237,
					"content": "#我们是信守承诺的人，今天就先放过带宠物散步的{M#小兄弟}{F#小妹妹}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780238
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780238,
					"content": "#那太好了，{NICKNAME}{M#弟弟}{F#妹妹}和派蒙，你们可以回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780239
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780239,
					"content": "不用担心我，我这就带哈维沙姆先生和金格尔先生去取走要给他们的货物…很轻松的任务。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780240
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780240,
					"content": "盗宝团将红发青年从笼子里解放出来，三人一道向东边去了…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741780241
					]
				},
				{
					"id": 741780241,
					"content": "#他们居然就这样走了…{NICKNAME}，你说那两个盗宝团真的会放过那个人吗？我感觉他笨笨的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780242,
						741780244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780242,
					"content": "明明可以付钱给我让我来解决问题…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780243
					]
				},
				{
					"id": 741780243,
					"content": "可能他是那种连蚂蚁都不忍心伤害的人吧！真的有这种人吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780246,
					"content": "好在意到底是怎么回事！他们刚才往东边去了…不如我们跟上去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780244,
					"content": "搞不好他们三个都在演戏…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780245
					]
				},
				{
					"id": 741780245,
