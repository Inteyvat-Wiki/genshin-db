					}
				]
			},
			"dialogs": [
				{
					"id": 741781001,
					"content": "这里的货变多了，看来他们的手下之前也没闲着。不过这次，他们应该真的吃到教训了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781002
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781002,
					"content": "对了，你也出了不少力，这些财货也应该分你一部分才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781003
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781003,
					"content": "感觉怪怪的，还是不要了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781004
					]
				},
				{
					"id": 741781004,
					"content": "哈哈，好吧。那就谢谢你了，除了感谢，我也没有别的东西可以给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781005
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781005,
					"content": "这些财货你准备怎么处理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781006
					]
				},
				{
					"id": 741781006,
					"content": "嗯？当然是交给真正需要它们的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781007
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781007,
					"content": "哦！这场景看起来像是我要独吞财富，我的所作所为也和他们没什么两样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781008
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781008,
					"content": "那、那你到底是怎么打算的？不如说，你到底是怎么想的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741781009,
					"content": "之前对哈维沙姆和金格尔所说的话也是出自我的真心，现在的你们应该能够听得出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781010
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781010,
					"content": "这个世界上充满了不均衡，过度的贫乏和过度的贪婪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781011
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781011,
					"content": "有些人沉沦、困顿，仅仅只是因为他们遇到了仅靠自己的力量难以越过的困境，我想为这样的人提供一点帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781012
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781012,
					"content": "可惜哈维沙姆和金格尔则是另一类，过度的贪婪，想要靠暴力从弱者身上攫取本不属于他们的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781013
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781013,
					"content": "并且枫丹的律法尚未给与他们应得的惩罚，我无法原谅…不管你们怎么说，我会做我认为正确的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781014
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781014,
					"content": "你有你的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781015
					]
				},
				{
					"id": 741781015,
					"content": "或许也可以被称作是自负，或者另一种形式的贪婪吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781016
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781016,
					"content": "所幸在这条道路上我并非独行，有志同道合的伙伴同我一道。即使我们只能为世界带来一些微小的改变…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781017
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741781017,
					"content": "无论如何，这次就多谢了，后会有期！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "红发青年"
				}
			]
		},
