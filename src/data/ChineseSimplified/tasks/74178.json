			"dialogs": [
				{
					"id": 741780401,
					"content": "看到他们了！我们先躲起来观察一下情况吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780402,
					"content": "…这些就是约定好的货品了，虽然不多，但是应该足够帮助你们度过这段困难的时间了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780403
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780403,
					"content": "我点点货…哈，确实不多不少，正好是你说的数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780404
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780404,
					"content": "你是个爽快人，我们就喜欢爽快人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780405
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780405,
					"content": "既然你出手这么爽快，那我们再多取一点也没问题吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780406
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780406,
					"content": "毕竟你的钱财太多，你不珍惜，不如交给我们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780407
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780407,
					"content": "…唉。原本以为能听到什么新鲜说辞，结果还是老一套啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780408
					],
					"speakerTitle": "看似懦弱的红发青年"
				},
				{
					"id": 741780408,
					"content": "老一套有用，为什么不用老一套？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780409
					],
					"speakerTitle": "哈维沙姆"
				},
				{
					"id": 741780409,
					"content": "得让你吃点苦头，我正想学学，求饶有什么新鲜说辞可用。看招！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780410
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780410,
					"content": "#（{NICKNAME}，怎么办？我们要去救他吗？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780411,
					"content": "（再看看情况吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780412
					]
				},
				{
					"id": 741780412,
					"content": "（欸？可是…唔，那就听你的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741780413,
					"content": "红发青年吹了一声口哨，从树林的隐蔽处跃出两个青年…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741780414
					]
				},
				{
					"id": 741780414,
					"content": "求饶的新鲜说辞我们是一句也没有。不过倒是有不少老套办法让你们把之前打劫无辜路人夺得的钱财吐出来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780415
					],
					"speakerTitle": "红发青年"
				},
				{
					"id": 741780415,
					"content": "大哥的意思是，这是最后的机会，你们现在照做的话，我们就不用继续把老套戏码演完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780416
					],
					"speakerTitle": "布朗什"
				},
				{
					"id": 741780416,
					"content": "想吃苦头的话，我随时奉陪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780417
					],
					"speakerTitle": "布勒"
				},
				{
					"id": 741780417,
					"content": "啊？你们又是哪里冒出来的？还有你…你什么时候换了身衣服？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780418
					],
					"speakerTitle": "金格尔"
				},
				{
					"id": 741780418,
					"content": "不过是马戏团的小丑，要吃苦头的是你们才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈维沙姆"
				}
			]
		},
