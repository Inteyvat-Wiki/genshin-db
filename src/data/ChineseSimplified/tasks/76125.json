			"dialogs": [
				{
					"id": 761250201,
					"content": "（哥伦比娅，果然不在这里…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "难道哥伦比娅真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250203,
					"content": "（她踏入了「月之门」，没人知道门内有什么，但那是个将极为强大的猎月人都彻底撕碎了的地方…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "（如果我当时…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "哥伦比娅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250207
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761250207,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761250208,
					"content": "是你们啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250209,
					"content": "~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250210
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761250210,
					"content": "你们…也在等哥伦比娅回来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761250212,
					"content": "就连你也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250213,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761250214,
					"content": "呜…不要那么难过嘛，打起精神来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250215,
					"content": "大家一起难过的话，不就像是…不就像是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250216,
					"content": "我才不要这么想呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250217,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "（…我不能沉溺在自责之中。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "（哥伦比娅不是为了看到这样的局面才做出的牺牲，更何况…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "我…还没有放弃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "哥伦比娅，她的每一位朋友，都不会就此放弃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "再给我们一点时间。我没法向各位许诺什么，但我一定会尽力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761250224,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 761250225,
					"content": "它们，这是在…鼓励我们？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250226,
					"content": "嗯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
				},
				{
					"id": 761250227,
					"content": "谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250228,
					"content": "想要陪你们做点什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250229,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761250230,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "月灵"
				},
				{
					"id": 761250231,
					"content": "这只月灵…似乎是喜欢弹琴的那只。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250232,
					"content": "这只月灵…有点心神不宁的样子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250233,
					"content": "要不你弹点什么吧？听到熟悉的旋律，说不定就可以稍稍安下心来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250234,
					"content": "熟悉的旋律…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "演奏哥伦比娅常哼的歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "…它们睡着了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250237,
					"content": "看起来小家伙们很久都没有好好休息过了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250238,
					"content": "我们悄悄离开这里吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250239,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250240,
					"content": "桑多涅！你怎么会在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250241,
					"content": "随便出门散散心不行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250242,
					"content": "她没有回来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250244,
					"content": "奇迹怎么可能没有代价呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250245,
					"content": "你要往哪个方向走？我是说…好不容易遇见了，要不要再一起走一段？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761250246,
					"content": "算了吧，今天心情不好，说出来的话不会好听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761250247,
					"content": "而且我看，这里最不需要的就是安慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
