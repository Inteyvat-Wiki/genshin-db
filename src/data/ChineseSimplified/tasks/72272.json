			"dialogs": [
				{
					"id": 722720102,
					"content": "我有宝物想要出售。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "欸？其实小店已经有了固定的进货渠道，平时也没有收购散货的业务...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720104,
					"content": "不过看你的样子…似乎是个了不起的东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720105,
					"content": "既然如此…不如先给我看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720106,
					"content": "将龙骨花凝珠的故事告诉了御舆源一郎。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720108,
					"content": "坦白说…虽然这个故事很神奇…但是好像也稍微神奇过头了些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720109,
					"content": "这种东西，已经有些超出我的理解能力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720110,
					"content": "请别见笑，毕竟我也只是会做些手工艺品的家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720120,
					"content": "这样吧，80000摩拉，最多再加5份刺身拼盘，这种料理可不便宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720111,
					"content": "这个价格你接受的话，我就买下这件宝物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720112,
					"content": "你会拿它做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "我还说不清楚，得再仔细琢磨一下这个东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720114,
					"content": "如果情况好的话，说不定可以加工成一种特别的根付，这样应该能多卖点价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720115,
					"content": "公道的价格，成交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "那么这些摩拉请收好。我得去好好研究研究这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720117,
					"content": "我再考虑一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "嗯…刚好我也可以再想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "御舆源一郎"
				},
				{
					"id": 722720119,
					"content": "如果你考虑好了，可以再来找我。",
