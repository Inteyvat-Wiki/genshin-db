			"dialogs": [
				{
					"id": 705500301,
					"content": "噔噔！完成了——这杯新品，可莉肯定喜欢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "哇啊！嘟嘟可的糖果也在饮料上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500303,
					"content": "杯子里有好多好多橙红色，嘟嘟可好像趴在白色的云朵上…这是更厉害的好天气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500304,
					"content": "可莉尝尝看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "嗯嗯…好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500306,
					"content": "可莉要慢慢喝，不能咕噜咕噜就错过了好味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500307,
					"content": "#真神奇…荣誉骑士{M#哥哥}{F#姐姐}，好像把阳光装进了果汁里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500308,
					"content": "玩累了的感觉都消失了，好温暖，但是又很平静？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500309,
					"content": "#…呼啊~荣誉骑士{M#哥哥}{F#姐姐}最厉害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500310,
					"content": "这杯饮料就由可莉来起名吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "真的吗？那我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500313,
					"content": "天气好，心情好，嘟嘟可应该会唱歌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500314,
					"content": "嘟嘟可唱歌，可莉也会跟着唱…所以就叫它…嘟嘟可晴天合唱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500315,
					"content": "好名字，我支持！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "#嘿嘿，谢谢荣誉骑士{M#哥哥}{F#姐姐}，给可莉做了这么好喝的饮料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500318,
					"content": "我要回去告诉妈妈，现在蒙德最好喝的饮料，就是嘟嘟可晴天合唱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500319,
					"content": "可莉开心，我也开心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#那，可莉就把妈妈念的咒语写在纸上，送给荣誉骑士{M#哥哥}{F#姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500322,
					"content": "#荣誉骑士{M#哥哥}{F#姐姐}也要学会魔法，做出自己想要的糖果哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500323,
					"content": "下次再见啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500320,
					"content": "通过了可莉老师的试炼！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "可莉的命名最棒了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "可莉给它一个厉害的名字吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
