					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "「好天气」来啦，可莉尝尝看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "哇啊，原来「好天气」是这种颜色？紫色的天空…是亮亮的夜晚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500203,
					"content": "可能是指日落后晴朗的傍晚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "可莉先喝一点，再认真地想想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500206,
					"content": "啊，喝完了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500207,
					"content": "好喝！酸酸甜甜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500208,
					"content": "如果在吃烤鱼的时候喝这杯，可莉肯定能呼呼吃掉好几条，饭量加倍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500209,
					"content": "一小杯不够喝，可莉还想要再来一杯…蛋糕一样的饮料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500210,
					"content": "懂了，可莉想追加「液态甜点」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#唔…我也不知道要加什么配方，我和荣誉骑士{M#哥哥}{F#姐姐}一起想想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500214,
					"content": "可莉带来的糖果好特别！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "这个吗？嘿嘿…是妈妈教我用炼金台做出来的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500216,
					"content": "好多好多糖，加上妈妈的枫丹朋友带来的花，芭比洛斯阿姨的星星蜂蜜，欧欧阿姨送给妈妈的魔力果酱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500217,
					"content": "把材料放在炼金台上，许愿一个形状，跟着妈妈念咒语，「嘭~」的一声，嘟嘟可样子的糖果就出现了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500218,
					"content": "成分和工艺都好厉害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "#嘟嘟可糖果也送荣誉骑士{M#哥哥}{F#姐姐}几份！你喜欢这种糖果的话，我也教你妈妈念的咒语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500221,
					"content": "#这样，荣誉骑士{M#哥哥}{F#姐姐}也能做出自己想要的糖果了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500222,
					"content": "谢谢可莉分享厉害的配方！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "嘿嘿，如果有不懂的地方，可以来找可莉喔！魔法糖果的问题，可莉是专家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500225,
					"content": "可莉今天还有什么要做的事吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "嗯！妈妈最近给了可莉一本厉害的书，每晚都要读一章，学学问，然后早早按时睡觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500227,
					"content": "那本书教可莉怎么做「推进剂」，可以让蹦蹦炸弹「呜呼~」地蹦更高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500228,
					"content": "学…学这个对吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "不高深哦…和炸弹有很多相像的地方，只要削的时候小心一点就好，像削蜡笔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500231,
					"content": "睡前的时间也很重要！妈妈会坐在可莉身边，给可莉讲各种各样的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500232,
					"content": "妈妈拿出一个…一台…一盏宝石做的灯，「叮当~」发出光来，投在天花板上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500233,
					"content": "天花板变成了故事板？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "是呀是呀，故事讲到哪里，天花板上的光点就变出好看的图案来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500235,
					"content": "有的时候，妈妈讲着讲着，自己就先睡着了，可莉就给妈妈盖上被子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500236,
					"content": "#等可莉学会怎么用这盏灯，可莉就来给荣誉骑士{M#哥哥}{F#姐姐}讲故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500237,
					"content": "好呀好呀！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "嘿嘿，可莉现在记住了好多好多故事，也能给大家带来新鲜的快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500240,
					"content": "可莉晚上还会吃东西嘛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "嗯！回去以后，可莉要边读书边吃…裹了一点盐的小坚果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500242,
					"content": "以前晚饭后，可莉都要吃蛋糕的！可是琴团长说，蛋糕里的白糖太多了，睡前吃了很不好，会发胖，还会牙疼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500243,
					"content": "所以妈妈听了芭比洛斯阿姨的建议，给我小坚果吃，说这个能帮助脑袋记住更多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500244,
					"content": "坚果的味道淡淡的，有点像在嚼草，不过，裹上盐后也不难吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500245,
					"content": "确实是个解决办法，营养和健康很重要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "也许我们可以想想看，有没有既健康，又够甜的材料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "对喔…可莉还是想吃甜甜的东西！蛋糕的奶油薄一点也好…或者，多放水果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500248,
					"content": "对了，妈妈那个戴眼镜的朋友，还送了她一袋枫丹的水果，圆圆滚滚，叫泡泡桔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500249,
					"content": "可莉连着吃了好几个，很甜很甜，琴团长也觉得没问题，因为：「水果的甜和白糖的甜不一样！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500250,
					"content": "所以，一定要吃坚果的话，好像可以把它们放在果汁里泡一泡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500251,
					"content": "说起来，可莉的三餐一般怎么安排？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "三餐？吼吼，可莉有的时候一天吃五顿哦，还有吃七顿的时候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500253,
					"content": "这么多！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "因为，冒险要花掉很多力气，一次吃太饱的话，跑起来又很不自在…所以每次吃少一点，多吃几顿就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500255,
					"content": "之前是阿贝多哥哥在管可莉的饭，饭盒里的料理，总是被阿贝多哥哥摆得漂漂亮亮，像画一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500256,
					"content": "的确是阿贝多的风格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "如果阿贝多哥哥在雪山忙，可莉也会跟着骑士团的大家，到营地里吃饭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500259,
					"content": "凯亚哥哥的营地最整洁，安柏姐姐的营地有时在树上，好玩！赫塔阿姨最会做大餐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500260,
					"content": "妈妈回来以后，就有更多更有意思的好吃的，比如把好多种鱼肉和鱼汤，做成布丁那样的方块，叫做五彩鱼冻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500261,
					"content": "说得我都有点馋了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "巧克力脆脆片也很好！是妈妈用巧克力和饼干做出来的新发明！有点苦，但酥酥脆脆香香，苦完以后更甜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500264,
					"content": "#吃了以后力气满满…下次我带几份来给荣誉骑士{M#哥哥}{F#姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500265,
					"content": "好，我知道要怎么改啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "再给可莉调一杯好喝的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "这么快嘛？好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500268,
					"content": "下一杯饮料会有多好喝呢…可莉很好奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500262,
					"content": "不愧是大冒险家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "我也想尝尝阿贝多的手艺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "我等可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "听…听起来很难？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "我会努力学，做出糖果的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "实在是不得了的甜品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "好的，再给可莉来一杯厉害的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "可莉想要什么风味，都可以调！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "饮料的名字不太合适，我来改！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
