					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#咦？咦咦？是荣誉骑士{M#哥哥}{F#姐姐}？好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500102,
					"content": "好耶！是可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "哈哈，优菈姐姐告诉我，赫塔阿姨找来了厉害的帮手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500105,
					"content": "#看到了荣誉骑士{M#哥哥}{F#姐姐}，我就知道，这里一定是全提瓦特最厉害的饮料店！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500106,
					"content": "谢谢可莉，以后能做到的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "还…还不是吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500109,
					"content": "#那就…可莉到过的饮料店里，荣誉骑士{M#哥哥}{F#姐姐}的最厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500110,
					"content": "#反正，不管荣誉骑士{M#哥哥}{F#姐姐}做出什么饮料，可莉肯定都会觉得好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500111,
					"content": "这回需要可莉严格一点！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "喔…喔！是这样吗？但可莉对你根本严格不起来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500114,
					"content": "我想想…那我就学习阿贝多哥哥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500115,
					"content": "阿贝多哥哥给蒂玛乌斯叔叔当面批改作业的时候，很认真！可莉都能听进去每一句话！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500116,
					"content": "好好好，可莉来当老师！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "嘿…那可莉要厉害地点单了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500119,
					"content": "再过不久，可莉就要和妈妈一起去炸鱼了…不要告诉琴团长哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500120,
					"content": "今天，可莉和妈妈一起炸了好多好多鱼…不要告诉琴团长哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500121,
					"content": "这几天，可莉和妈妈开开心心玩了好久好久，最快乐了！被关禁闭也没关系！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500122,
					"content": "所以，可莉想点一杯「好天气」——大晴天，阳光暖暖，心情一定很棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500123,
					"content": "收到，可莉老师，这就开工！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "嘿嘿，会是什么味道呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 705500124,
					"content": "明白，可莉大师，这就开工！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "好好好，大炼金术士可莉！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "这次可莉随便挑我毛病！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "谢谢可莉，我会加油变强！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "好耶！可莉来做客！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
			"id": 7055002,
