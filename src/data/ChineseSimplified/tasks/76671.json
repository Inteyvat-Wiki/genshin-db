					},
					{
						"sceneId": 3,
						"position": [
							6050.061,
							231.727,
							9915.102
						],
						"pointId": 361100043
					},
					{
						"sceneId": 3,
						"position": [
							6051.46,
							231.727,
							9914.742
						],
						"pointId": 361100044
					}
				]
			},
			"dialogs": [
				{
					"id": 766710201,
					"content": "之前看到就很好奇了，为什么执灯人的营地里会有这种像是餐车一样的小车呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710202,
					"content": "虽然要是能在上面做饭的话看起来是很方便啦，但感觉应该不会有这么简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710203,
						766710205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710203,
					"content": "或许能做更复杂的料理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710204
					]
				},
				{
					"id": 766710204,
					"content": "那我可要尝尝啦…不对吧，我不是在说这种不简单啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710207,
					"content": "它们嘛，正式一点的称呼应该叫作「月厢车」，是我们执灯人用至冬的机关车改造而成的运输工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710208
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710208,
					"content": "你们可以把它们当作可移动的灯塔，同样也是依靠月矩力的燃料驱动的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710209
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710209,
					"content": "虽然移动的速度不是很快，但相比起在运输物资上消耗宝贵的人力，有了它们的帮助也算给我们省了不少事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710210
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710210,
					"content": "至于派蒙说的料理嘛，之前我倒是没有考虑过，但如果在里面装上烤面包机的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710211,
						766710212
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710211,
					"content": "派蒙的话不用那么当真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710213
					]
				},
				{
					"id": 766710213,
					"content": "不不，能及时填饱肚子对于执勤的执灯士来说也是很重要的，派蒙的话倒是提醒我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710214
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710214,
					"content": "如果我们能配置一辆专门的餐车的话，大家就不用再为了吃口热饭而在野外垒石做灶了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710215
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710215,
					"content": "对吧对吧，然后大家还可以用它来做各种各样好吃的东西，一起在这里开篝火晚会！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710216,
					"content": "唔，不过营地里的大家看起来都很忙的样子，应该也没有这种心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710217,
					"content": "其实我也希望有一天能够放下心来，和大家坐在一起吃吃喝喝，想想就会觉得很幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710218
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710218,
					"content": "不过眼下还不是放松的时候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710219
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710219,
					"content": "果然是这样啊…是因为狂猎的原因吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710220,
					"content": "嗯，你们也看到了，最近狂猎的活动越来越频繁，因此我们不得不加强戒备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710221
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710221,
					"content": "为此需要对据点进行整备，定时派出执灯士调查巡逻，保证来往的道路畅通无阻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710222
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710222,
					"content": "唔，光是听你说，我就已经开始累了…执灯人的工作还真是辛苦啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710223,
					"content": "这只是一些基础的工作罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710224
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710224,
					"content": "像是更危险的，比如对付那些不知道会在何时何地出现的狂猎，这样的职责都是老爷子，还有菲林斯、奥拉维他们在承担着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710225
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710225,
					"content": "我想也不能事事都让老爷子操心，就把这些最基础的工作接过来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710226
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710226,
					"content": "其实相比起筹备物资，眼下最棘手的还是人力的问题，实在是巧妇难为无米之炊啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710227
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710227,
					"content": "因为执灯人曾经的据点大多年久失修，没办法作为长久的栖身之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710228
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710228,
					"content": "现在大家只能不停地在野外的营地与总部之间疲于奔命，久而久之能作为战力的人就更少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710229
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710229,
					"content": "有什么解决的办法吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710230
					]
				},
				{
					"id": 766710230,
					"content": "想要解决的话，就必须把这里改建成永久性据点。而作为执灯人的营垒，最重要的就是要有一座灯塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710231
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710231,
					"content": "意思就是说，你们要在这里建一座灯塔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710232,
					"content": "没错，只有建起了灯塔，才能在狂猎袭击时有所凭依。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710233
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710233,
					"content": "不过说起来容易，实际上嘛…你们刚才也看到了，目前的进展并不是很顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710234
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710234,
					"content": "对哦，我都快忘了我们是要来帮忙的了。所以到底是遇到什么问题了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710235,
					"content": "是这样的，为了建造营垒需要大量的燃料和物资，它们都是用月厢车从皮拉米达城源源不断地运输过来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710236,
						766710237
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710236,
					"content": "就地取材不行吗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710238
					]
				},
				{
					"id": 766710238,
					"content": "要是那么简单的话就好了。我们需要的不是普通的燃料，而是用月矩力精炼而成的特殊油料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710239
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710239,
					"content": "虽然附近植物里的月矩力是很丰富，采集过来也不是不能勉强撑一会…但要用它们来供应灯塔的话，就完全是杯水车薪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710240
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710240,
					"content": "原本昨晚运送燃料与物资的运输车就该到了，但直到现在都没看到影子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710241
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710241,
					"content": "负责运输的瓦蒂什做事一向严谨，我想他应该不会大意到连时间都搞错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710242
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710242,
					"content": "因此我才担心会不会是路上遇到了什么麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710243,
						766710244
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710243,
					"content": "停停，你别总往坏处想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710245
					]
				},
				{
					"id": 766710245,
					"content": "对啊，就算是被骗得钻进了酒桶出不来，又或者是被人埋进土里只剩下个脑袋，最后也总有办法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710246,
					"content": "反正也不会比这些还糟吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710247,
					"content": "噗嗤，这些该不会都是你们在冒险途中遇到过的情况吧？看来我还是低估你们的实力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710248,
						766710249
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710248,
					"content": "其实还有更夸张的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710250
					]
				},
				{
					"id": 766710250,
					"content": "总之，我们先在附近找找看吧，说不定他只是迷路了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710251,
					"content": "确实，你们说得对。事不宜迟，那就拜托你们和我一起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710252
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710252,
					"content": "嗯嗯，那是当然，我们现在就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710249,
					"content": "梅洛彼得堡也不是没待过…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710250
					]
				},
				{
					"id": 766710244,
					"content": "别急，这种事情我碰得多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710245
					]
				},
				{
					"id": 766710237,
					"content": "我看旁边的木材就挺多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710238
					]
				},
				{
					"id": 766710212,
					"content": "餐车的事情是开玩笑的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710213
					]
				},
				{
					"id": 766710205,
					"content": "或许能变形成战斗机器人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710206
					]
				},
				{
					"id": 766710206,
					"content": "真的假的，难道说是那种，如果你说不喜欢它做的菜，它就会拿勺子攻击你的料理机器人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710207
					],
					"speakerTitle": "派蒙"
				}
			]
		},
