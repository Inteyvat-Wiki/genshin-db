						],
						"pointId": 361100048
					}
				]
			},
			"dialogs": [
				{
					"id": 766710601,
					"content": "队、队长！太好了，终于有人来了。救命啊，队长！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710602
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710602,
					"content": "瓦蒂什，你怎么会在这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710603
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710603,
					"content": "这就说来话长了…这些曼陀草制造的壁障从里面根本解除不了，我已经快被困在里面一天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710604
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710604,
					"content": "等一下，那可就奇怪了。按理来说这里不在皮拉米达城过来的大道上，也算不上是什么捷径。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710605
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710605,
					"content": "至于这些曼陀草，它们通常不会主动攻击路人，除非是有人入侵了它们的领地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710606
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710606,
					"content": "所以，你到底是怎么被它们困在这里的，要是不能给我一个合理的解释，我就只能让你在里面多待一会了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710607
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710607,
					"content": "哇，很少看到叶洛亚生气的样子，我都有点害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710608,
						766710609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710608,
					"content": "毕竟是队长，需要有威严的一面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710610
					]
				},
				{
					"id": 766710610,
					"content": "是哦，果然还是当冒险家比较轻松…幸好我们只是编外的队员，不然也要被叶洛亚管教了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710611,
					"content": "呃啊…好吧，事情的经过是这样的。昨天夜里，我在前往营地的路上被一大群曼陀草挡住了去路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710612
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710612,
					"content": "队长你也知道我平常喜欢研究一些昆虫啊、植物啊什么的，这么多曼陀草聚在一起，是很少见的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710613
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710613,
					"content": "我想着不能错过研究的机会，就跟着它们一路来到了这里，结果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710614
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710614,
					"content": "非常抱歉！我会承担起责任的，接下来一个星期的值夜就由我…不，一个月，这一个月的值夜就由我承担了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710615,
						766710617
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710615,
					"content": "还是先救人吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710616
					]
				},
				{
					"id": 766710616,
					"content": "你说得对，违反纪律的事情就等回去再说。我们先想办法把人弄出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710621
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710621,
					"content": "#{NICKNAME}，又得麻烦你们了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710622
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710622,
					"content": "呜呜，谢谢你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710617,
					"content": "反正物资已经拿到了，不如…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710618
					]
				},
				{
					"id": 766710618,
					"content": "欸，什么意思，该不会是要丢下我不管吧？不要啊，求求你们了，我已经知道错了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710619
					],
					"speakerTitle": "瓦蒂什"
				},
				{
					"id": 766710619,
					"content": "看他这么可怜，我们还是先把他救出来吧。反正等回了营地，他也会接受应得的惩罚的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710620,
					"content": "派蒙说得对，违反纪律的事情就等回去再说。我们先想办法把人弄出来吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710621
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710609,
					"content": "执灯人也有自己的纪律。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710610
					]
				}
			]
		},
