			"dialogs": [
				{
					"id": 766710101,
					"content": "居然还没到吗？这下可真是伤脑筋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710102
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710102,
					"content": "怎么办，老大！且不说灯塔那边的兄弟们正等着开工，要是燃料也供给不上，整个营垒怕是都要熄火了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710103
					],
					"speakerTitle": "安莱夫"
				},
				{
					"id": 766710103,
					"content": "是啊，队长，得赶紧想想办法啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710104
					],
					"speakerTitle": "伊捷莉"
				},
				{
					"id": 766710104,
					"content": "我知道了，你们不用太担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710105
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710105,
					"content": "先回去自己的岗位上吧，这件事就交给我来处理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710106
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710106,
					"content": "#{NICKNAME}，派蒙，是你们来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710107
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710107,
					"content": "你好呀，叶洛亚，大家怎么都聚在门口？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710108,
						766710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710108,
					"content": "你看起来好像很忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710110
					]
				},
				{
					"id": 766710110,
					"content": "没事，一点小状况而已，不是什么大事，我已经在想办法处理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710111
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710111,
					"content": "叶洛亚每次遇到事情总想着偷偷一个人解决，也说给我们听听嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710112,
					"content": "该不会是不好意思说吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766710113,
					"content": "哈哈，怎么会呢。只是这种我自己能解决的事情，就不太想让大家为此操心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710114
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710114,
					"content": "不过你们现在也算是调查分队「魇夜之莺」的成员，作为队长我是不会见外的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766710115
					],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710115,
					"content": "这里说话有些不太方便，我们先进去再慢慢说吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶洛亚"
				},
				{
					"id": 766710109,
					"content": "出什么事了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766710110
					]
				}
			]
		},
		{
			"id": 7667102,
			"completionStepIds": [
				7667104
			],
