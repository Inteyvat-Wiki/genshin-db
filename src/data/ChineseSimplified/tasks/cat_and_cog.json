			"dialogs": [
				{
					"id": 761850101,
					"content": "嗯，美味的茶水点心。多谢桑多涅小姐的招待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850102,
					"content": "没什么，你中意就好。我还带了些阿舍鲁喜欢的零食。对不对？阿舍鲁？过来，乖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850103,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "阿舍鲁"
				},
				{
					"id": 761850104,
					"content": "希望你同挪德卡莱，以及同「秘闻馆」的这份情谊，能够对未来我们之间的合作有所益处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850105,
					"content": "嗯，我也希望如此。来，阿舍鲁，尝尝这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850106,
					"content": "另外，关于之前向桑多涅小姐打听的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850107,
					"content": "哈哈，你这小肉垫真软。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850109,
					"content": "桑多涅小姐…你该不会是借茶会的名义来我这里揉猫的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850110,
					"content": "欸…？有，有吗？没有的事！和「秘闻馆」的往来我也放在心上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850111,
					"content": "过来，阿舍鲁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850112,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "阿舍鲁"
				},
				{
					"id": 761850113,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850114,
					"content": "那我们具体聊聊「往来」相关的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850115,
					"content": "…啧。有…就算有一点点是想揉猫又怎样啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850116,
					"content": "平时很多小动物都不喜欢机械，好不容易前段时间在这里研究「数秘阵列」和阿舍鲁混熟了，揉一下又怎样啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850117,
					"content": "哈…好吧好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850118,
					"content": "去吧，阿舍鲁。反正我也管不了你喜欢蹭谁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850119,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "阿舍鲁"
				},
				{
					"id": 761850120,
					"content": "揉个痛快之后别忘了聊正事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850121,
					"content": "说了我有放在心上的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
