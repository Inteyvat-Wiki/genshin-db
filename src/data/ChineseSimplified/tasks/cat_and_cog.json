					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850202,
					"content": "（再这么坐一会儿吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761850204,
					"content": "哦，慢走。有空常来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 761850203,
					"content": "茶会时间该结束了。",
