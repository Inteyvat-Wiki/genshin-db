			"dialogs": [
				{
					"id": 2005902001,
					"content": "唔，不过只是单单一句「好卖的东西」，你肯定也不知道找什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005902002,
					"content": "我想想，不如你去找找<color=#00E1FFFF>「和丘丘人有关的战利品」</color>吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005902003,
					"content": "那些想要彰显自己实力的冒险家们，说不定会很感兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛乔丽"
