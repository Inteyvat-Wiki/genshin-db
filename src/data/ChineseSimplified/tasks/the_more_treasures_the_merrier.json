			"trigger": {
				"objectNames": [
					"玛乔丽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "这下可糟糕了，怎么办呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "旅行者！你来得正好！你知道，这里是我家开的纪念品商店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590104,
					"content": "之前，我老爹会收购其他的冒险家带回来的战利品，然后摆在店里卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590105,
					"content": "但是自从冒险家协会…不是那么热闹之后，我能收购的东西也越来越少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590106,
					"content": "而且还尽是一些不怎么值钱的东西，根本没有客人愿意买。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590107,
					"content": "旅行者，你会四处冒险对吧？能不能帮帮我，去找点好卖的战利品回来？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590108,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "那就拜托你了！找到之后，我一定把它卖个好价钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590110,
					"content": "派蒙其实就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "抱歉，应该没人会买哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 200590112,
					"content": "因为…肯定会自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玛乔丽"
				}
			]
		},
