			"dialogs": [
				{
					"id": 2005910001,
					"content": "这个是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 2005910002,
					"content": "客人！你眼光真不错，一眼就看中了我们店里最好的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005910003,
					"content": "这是这位旅行者，刚从丘丘人首领手里夺下来的战利品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005910004,
					"content": "那个可怕的丘丘人，不知道危害了蒙德多长时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005910005,
					"content": "就算是这位旅行者，也是经历了一场苦战呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005910006,
					"content": "是，是这么厉害的丘丘人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 2005910007,
					"content": "…要是我拿着这个给塞琉斯先生，或者斯坦利先生看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 2005910008,
					"content": "他们说不定就会对我另眼相看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "杰克"
				},
				{
					"id": 2005910009,
					"content": "对啊客人，别担心，本店绝对为顾客保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005910010,
					"content": "别犹豫了客人，这个货物可是很抢手的哟——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "玛乔丽"
				},
				{
					"id": 2005910011,
					"content": "我要再想想…旅行者，她说的是真的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杰克"
				}
			]
		},
