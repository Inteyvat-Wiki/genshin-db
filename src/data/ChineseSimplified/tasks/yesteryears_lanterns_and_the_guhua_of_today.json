			},
			"dialogs": [
				{
					"id": 413370901,
					"content": "我离开古华派的时候，同门弟子已经寥寥无几了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370902,
					"content": "师父没有责备我，只是叫我要好好生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370903
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370903,
					"content": "但是，我现在也不知道我是不是真的在好好生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370904
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370904,
					"content": "又或者，我只不过是在得过且过罢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370905
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370905,
					"content": "我听人说，有一位叫孙宇的古华派门人正在访仙，想要复兴古华派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370906
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370906,
					"content": "我要是有他这种勇气的话…就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370907
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370907,
					"content": "抱歉，一个人说了这么多，难得到外面来透透气，就是想多说一些话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370908
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370908,
					"content": "你好像有点难过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370909
					]
				},
				{
					"id": 413370909,
					"content": "我、我没事，只不过每年过节的时候，都有点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370910
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370910,
					"content": "好了，时间也差不多了，祝你们海灯节快乐，也麻烦你代我向拜托你放灯的人带句话，就说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370911
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370911,
					"content": "就说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370912
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370912,
					"content": "就说…芷若祝他海灯节快乐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370913,
					"content": "也祝你海灯节快乐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "嗯，谢谢你，路上小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芷若"
				}
			]
		},
