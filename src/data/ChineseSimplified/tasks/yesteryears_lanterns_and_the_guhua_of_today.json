			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芷若"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "有一次放霄灯的时候，有一位兴致高昂的师兄非要和我比剑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370702,
					"content": "我还没说话，我的一个好姐妹帮我用水悄悄浇湿了师兄站着的那块地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370703,
					"content": "那地又湿又滑，师兄还没出剑，刚走了一步就摔了个屁股墩，我笑得不行，也不小心摔倒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370704,
					"content": "当时那位师兄也没生气，只是指着我笑。然后，周围的大家也笑成了一团…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370705,
					"content": "不知道，这位师兄现在在哪里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芷若"
				}
			]
		},
		{
			"id": 4133708,
