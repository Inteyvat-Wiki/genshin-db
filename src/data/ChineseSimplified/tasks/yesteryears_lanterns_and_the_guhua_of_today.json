					"nextDialogs": [
						413371003
					]
				},
				{
					"id": 413371003,
					"content": "原来如此，芷若…我还记得她，当年她还关照过我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371004
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413371004,
					"content": "原来她还记得古华派啊，太好了，太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371005
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413371005,
					"content": "关于小雀儿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371006
					]
				},
				{
					"id": 413371006,
					"content": "啊，小雀儿的头痛好了些，刚才也许是真着凉了，我正准备给她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371007
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413371007,
					"content": "师兄，刚刚你说的那个「芷若」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371008
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413371008,
					"content": "是古华派的师姐吗？人好看吗？你和她很熟悉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371009
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413371009,
					"content": "唔…倒说不上熟悉，不过芷若很擅长做伤药，之前受了伤，大家都愿意去找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413371010,
					"content": "哈哈哈，这么一说，古华派里的人，喜欢她的人应该也很多吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371011
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413371011,
					"content": "师兄，你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413371012,
					"content": "啊…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413371013,
					"content": "师兄，你和这位芷若师姐之间的关系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413371014,
					"content": "这…我们也不太熟悉，嗯，可以说是同门之谊吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413371015,
					"content": "喔…那师兄，那你我之间的关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413371016,
					"content": "哈哈哈，那自然是同门之谊了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371017
					],
					"speakerTitle": "孙宇"
				},
