	"talks": [
		{
			"id": 4133702,
			"completionStepIds": [
				4133702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133702",
							"2"
						],
						"stepId": 4133702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "在这附近放灯，或许就能被仙人所见吧？但是这材料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370202,
					"content": "你在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "啊，失礼了，我和师妹正在考虑放霄灯一事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370204,
					"content": "不过，我们手头这制作霄灯的材料有些不足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370205,
					"content": "如果这位朋友愿意的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370206,
					"content": "又是古华派，古华派古华派…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370207,
					"content": "好不容易的一个海灯节，许的愿望还是古华派…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370208,
					"content": "师妹，你我都是古华派门人，振兴古华派，自然是我们的责任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370209,
					"content": "是是是，师兄说什么，就是什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370210,
					"content": "唉…这位朋友，如果你愿意的话，能麻烦你找一些霄灯的材料给我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370211,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "非常感谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370216,
					"content": "咳，我清点了一下，现在好像还缺了一朵清心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370217,
					"content": "之前的那些摘了太长时间，变得又干又脆，没法用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370218,
					"content": "清心也能用来编霄灯吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "呵呵，这是之前在古华派里，我和师弟师妹们胡闹的时候想出来的怪法子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370220,
					"content": "让霄灯带上些花香，倒也有些乐趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370221,
					"content": "我就在这里等你，找到材料就请你送回来吧，麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370213,
					"content": "你的师妹好像有话想说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "没什么，没什么，师兄说什么就是什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370215,
					"content": "唉，师妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "孙宇"
				}
			]
		},
