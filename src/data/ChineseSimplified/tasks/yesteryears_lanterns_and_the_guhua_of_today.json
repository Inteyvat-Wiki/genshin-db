					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芷若"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370601,
					"content": "你们是来…放灯的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370602,
					"content": "只有古华派弟子知道这个放灯的地方，可是我对你们没有什么印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370603,
					"content": "我是代人来放灯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "还有古华派的人记得这里吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370605,
					"content": "我过来的时候看着这周围寂寥无人，本来有些难过的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370606,
					"content": "但现在知道还有古华派的人记得这里，心里反倒是好受了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370607,
					"content": "之前古华派会在这里放灯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "嗯…那个时候都是编好霄灯后，师长领着我们过来，师长在前面走，我们捧着霄灯在后面跟着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370609,
					"content": "那时候…山上山下，霄灯连成一片，可好看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370610,
					"content": "可是现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370611,
					"content": "…我们还是先把灯放起来吧，过去的事，如果不着急，我们可以边走边说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芷若"
				}
			]
		},
		{
			"id": 4133707,
			"completionStepIds": [
				4133713
			],
