			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "谢谢你，这样我就能把霄灯编出来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370402,
					"content": "霄灯编好了，师妹，你待会就把愿望写上去吧，你的字是写得很好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370403,
					"content": "写，我写就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370404,
					"content": "师妹…你…是不是有些不高兴？怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370405,
					"content": "没有，我哪有不高兴，能帮师兄放霄灯，我可高兴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370406,
					"content": "咳…咳！你们要去哪放灯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "对，这位朋友说得对，我们该准备去放灯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370409,
					"content": "那师兄你自己去吧，我就不去了，爬山太累了…我才没那个劲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370410,
					"content": "这…我们刚刚才在这里休息了一段时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370411,
					"content": "我头有些痛，不知道是不是方才吹了山风了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 413370412,
					"content": "这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370413,
					"content": "我…我帮你们去放吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "这…唉，那就麻烦朋友了。我本来准备去个特别的地方放飞霄灯的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370416,
					"content": "之前古华派尚…在的时候，每逢海灯节，师长都会带着我们去那里放灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370417,
					"content": "可惜现在山门败落，那个地方，也久未有古华派门人放霄灯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370418,
					"content": "如今朋友既然愿意帮忙，那就请朋友代我去那边放飞这霄灯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370419,
					"content": "我把位置标给你，我先去照顾照顾我家师妹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 413370414,
					"content": "我来帮忙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "咳…咳！你们该去放灯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
			"completionStepIds": [
				4133706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133706",
							"2"
						],
						"stepId": 4133706,
