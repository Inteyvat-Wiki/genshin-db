					"芷若"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "曾经我也看到过希望，有一位新入古华派的少年，仪表堂堂，天赋异禀，看上去是能重振山门的奇人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370802,
					"content": "但他踪迹难寻，常常见不到影子，唉，说到底，将振兴门派的愿望寄托于他人，本来就不对吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 413370803,
					"content": "所以，还是由他去，不要期待为好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芷若"
				}
			]
		},
