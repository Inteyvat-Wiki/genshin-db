				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡桃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110501,
					"content": "怎么样，是不是觉得诅咒全都被驱散了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110502
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110502,
					"content": "对，前所未有的舒畅！是健康的感觉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110503
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110503,
					"content": "非常谢谢你，还有这位旅行者！不然我可能就真的因为诅咒暴毙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110504
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110504,
					"content": "那，我现在就可以告诉你了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110505
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110505,
					"content": "锵锵！你被骗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110506
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110506,
					"content": "欸？怎、怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110507
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110507,
					"content": "这个东西，一般人接触不到，但其实就是普通的地脉镇石啦，它很容易吸引怪物过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110508
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110508,
					"content": "那些怪物也根本就不是什么诅咒的具象化，就是真正的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110509
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110509,
					"content": "那就奇怪了，明明我什么都没做，你却感觉完全没事了，那说明什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110510
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110510,
					"content": "这、这个…难道，其实我没有被诅咒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110511
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110511,
					"content": "可是，那我为什么会生病呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110512
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110512,
					"content": "着凉了，吃了坏掉的东西，或者自己吓唬自己，都有可能…我倾向最后一种，是我这里的常见病哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110513
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110513,
					"content": "没想到是这样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110514
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110514,
					"content": "我也没想到，但…总之还是要谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110515
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110515,
					"content": "道谢就不必了，以后不要这么疑神疑鬼的，我也不是每次都能找到合适的方法安慰你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110516
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110516,
					"content": "人这一辈子这么短，趁着还活着抓紧时间好好享受生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110517
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110517,
					"content": "这话怎么听着…有点怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110518
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110518,
					"content": "那、那我先走了，抱歉给你们添麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110519
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110519,
					"content": "看来不是狼哥干的，我稍微安心了一点。可是，只要狼哥没有下落，就不能阻止他乱来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110520
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110520,
					"content": "既然这件事已经解决了，我们是不是可以继续去找狼哥了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110521
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110521,
					"content": "我觉得，应该没这个必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110522
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110522,
					"content": "因为要找的人已经主动上门来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110523
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110523,
					"content": "狼、狼哥——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110524
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110524,
					"content": "那、那个…抱歉，打扰你，还有你们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110525
					],
					"speakerTitle": "狼哥"
				},
				{
					"id": 111110525,
					"content": "他就是狼哥？为什么是个小孩子？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110526,
					"content": "因为是幽灵嘛，理所当然地保持着他当年的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110527
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110527,
					"content": "呃，和「狼哥」这个名字给我留下的印象不太一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110528,
					"content": "先带他回往生堂再说。接下来还有不少事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				}
			]
		},
