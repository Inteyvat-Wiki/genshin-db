	"talks": [
		{
			"id": 1111101,
			"completionStepIds": [
				1111101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111101",
							"2"
						],
						"stepId": 1111101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"老孟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110101,
					"content": "老孟，我回来啦！很遗憾，还是没找到狼哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110102
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110102,
					"content": "这样啊，那就麻烦了。我们能猜到的地方，算是都找过了一遍了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110103
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110103,
					"content": "狼哥到底是谁啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110104,
					"content": "我还是从头开始解释吧。我的老家就在无妄坡附近，小时候，我有几个玩得很好的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110105
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110105,
					"content": "狼哥，就是其中之一，和我关系特别好，形影不离。可是，某一天因为意外，他不幸去世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110106
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110106,
					"content": "我总是忘不了这件事，可能因为我是个特别恋旧的人吧，所以我现在也经常回无妄坡看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110107
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110107,
					"content": "但就在前段时间我从无妄坡回来之后，我就觉得很不舒服，而且每天晚上的梦里，狼哥都会出现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110108
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110108,
					"content": "我就觉得，是不是我惊动了他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110109,
						111110110
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110109,
					"content": "听着很像幻想故事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				},
				{
					"id": 111110111,
					"content": "可能吧，虽然我没有证据，但我怎么都放心不下来，越想越担心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110112
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110112,
					"content": "想到孩提时代的友人，有可能变成了恶鬼，这种事怎么能接受啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110113
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110113,
					"content": "他就是因为这个原因，才加入的往生堂。拜这件事所赐，我也不用给他付工钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110114
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110114,
					"content": "不过，老孟说的这种事是有可能的，因为确实时不时就会有鬼灵在现世游荡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110115
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110115,
					"content": "但恶鬼什么的，纯粹就是自己吓唬自己了，我自己都没有碰到过几次恶鬼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110116
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110116,
					"content": "可是，这也不能证明狼哥的事没有危险，我真的很不想看到他去到处害人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110117
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110117,
					"content": "你们看，就是这样，如果不能把狼哥找出来的话，我说什么老孟都听不进去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110118
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110118,
					"content": "刚刚我们找的那几个人，同样也是老孟的童年好友，本来以为狼哥会藏在他们那里，结果又扑了个空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110119
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110119,
					"content": "无妄坡附近也找了，以前的朋友也找了，这下线索是彻底断了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110120
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110120,
					"content": "抱歉，抱歉，请问你们是往生堂的人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110121
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110121,
					"content": "我叫洛成，我最近感觉很不对劲，感觉有什么东西在盯着我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110122
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110122,
					"content": "前几天我和朋友去无妄坡试胆，回来之后我就病倒了，每天都做噩梦，找医生也诊断不出毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110123
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110123,
					"content": "我这样，肯定是被诅咒了对吧！被魔神诅咒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110124
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110124,
					"content": "对对对，嗯，是的，魔神诅咒，可严重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110125
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110125,
					"content": "你也知道对吧！就是那个，传说中在魔神战争中死去的魔神，对世间降下的痛苦诅咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110126
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110126,
					"content": "只要无法驱逐这种诅咒，最后就会烧穿五脏，骨肉分离，下场非常凄惨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110127
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110127,
					"content": "传说里中了这种诅咒的症状，跟我现在简直是一模一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110128
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110128,
					"content": "无妄坡，诅咒…不对，应该不是诅咒，多半是因为狼哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110129
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110129,
					"content": "唉，停一下停一下，你们两个，都就此打住，别再自说自话了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110130
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110130,
					"content": "你才是最喜欢自说自话的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110131,
					"content": "往生堂擅长解决这种鬼怪和魔神的事吧！能不能帮帮我！我还不想死！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110132
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110132,
					"content": "好啊，没问题，交给我吧，找我是找对人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110133
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110133,
					"content": "不过要解除诅咒需要一个合适的场地，还要提前做一点准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110134
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110134,
					"content": "新来的，我需要你帮我，跟我一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110135
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110135,
					"content": "那、那我也一起去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110136
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110136,
					"content": "你先帮他做一下准备。焚香驱邪那一套，我教过你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110137
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110137,
					"content": "做完准备工作来找我。等这头忙完，我们再讨论狼哥的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110138
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110138,
					"content": "好吧，只能这样了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110139
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110139,
					"content": "那，我们走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110110,
					"content": "这种事不存在吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				}
			]
		},
		{
			"id": 1111102,
			"completionStepIds": [
				1111102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111102",
							"2"
						],
						"stepId": 1111102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110201,
					"content": "所以，神神秘秘的，到底要做什么啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110202,
					"content": "什么都不做，在这儿等着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110203
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110203,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110204,
					"content": "你不会把什么魔神诅咒的说法当真了吧？那种东西，早就被扑灭喽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110205
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110205,
					"content": "那我们为什么要到这里来？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110206
					]
				},
				{
					"id": 111110206,
					"content": "你也看到那两个人了，一个觉得自己被诅咒，一个觉得挚友变成了恶鬼，都不好好听别人说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110207
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110207,
					"content": "唉，所以我说，普通人什么都不知道才是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110208
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110208,
					"content": "为这种事情绪失控的人，我见得太多了。想让人平静下来，必须让他们看到令人信服的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110209
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110209,
					"content": "面对相信鬼怪的人，就该当着他们的面消灭鬼怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110210
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110210,
					"content": "唔…这话听起来像哄三岁小孩的把戏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110211,
						111110213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110211,
					"content": "让普通人知晓一切或许更好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110212
					]
				},
				{
					"id": 111110212,
					"content": "对哦，如果说恐惧来源于未知的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110216,
					"content": "因为没有人能保证，把真相告诉无知之人，就能让现状变好而不是变糟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110217
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110217,
					"content": "我要将靠近「边界」的人拉回去。既然是心理作用，就对症下药，当成心理作用来处理好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110218
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110218,
					"content": "倒是有点道理…那，诅咒的事又怎么说？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110219,
					"content": "这个嘛，你们听说过「夜叉」的历史吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110220,
						111110221
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110220,
					"content": "没听过。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110222,
					"content": "他们曾经和魔神作战，打得眼花缭乱、昏天黑地。虽然魔神最后被击败，但它们的怨念久久不散。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110223
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110223,
					"content": "有怨念化为瘟疫，在普通人之间传播开来，惶恐的人们都以为那是「魔神降下的诅咒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110224
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110224,
					"content": "很多人被瘟疫夺去了性命，而这种瘟疫又以死去的人为温床，继续扩散。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110225
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110225,
					"content": "后来有人发现了阻止瘟疫扩散的方法：净化空气，焚烧尸骸。而第一批开始做这种事的人，就是「往生堂」最初的创立者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110226
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110226,
					"content": "原、原来是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110227,
					"content": "嗯，在那之后又过了许多年，那一场瘟疫终于被完全扑灭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110228
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110228,
					"content": "类似的事件，历史上「往生堂」处理过很多次，最后的结果，都是让璃月的生死重新回到某种平衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110229
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110229,
					"content": "简而言之，我们就像是「看门人」，不仅帮普通人看门，也帮不是人的东西看门，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110230,
						111110231
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110230,
					"content": "这就是「维护生死的边界」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110232,
					"content": "所以，「诅咒」只是心理作用，这我比谁都要清楚。但曾经存在这种事，也是不能告诉普通人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110233
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110233,
					"content": "我们稍微等一等吧，等会儿就用这个地脉镇石，演一出好戏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110234
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110234,
					"content": "终于来了，我们也刚刚准备好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110235
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110235,
					"content": "看，这就是用来驱邪的特殊装置，可以把诅咒从你的体内吸引出来，再具象化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110236
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110236,
					"content": "不用担心会有危险，因为这边的旅行者是身经百战的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110237,
						111110238
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110237,
					"content": "果然是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110239,
					"content": "哦哦，对哦，忘记说了，哈哈，但是无所谓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110240
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110240,
					"content": "这样真的就没问题了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110241
					],
					"speakerTitle": "洛成"
				},
				{
					"id": 111110241,
					"content": "相信堂主吧，虽然人看上去有点奇怪，但她做事是很认真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110242
					],
					"speakerTitle": "老孟"
				},
				{
					"id": 111110242,
					"content": "喂，怎么能用「奇怪」来形容我呀？至少也该是天真烂漫、不拘一格吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110243
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110243,
					"content": "总之，速速开工！新来的，去启动装置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111110238,
					"content": "我可没听说过要战斗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110231,
					"content": "没想到还源远流长。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110221,
					"content": "了解一点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110213,
					"content": "派蒙今年几岁？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110214
					]
				},
				{
					"id": 111110214,
					"content": "为什么突然问这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111110215,
					"content": "我更关心为什么不能直接告诉大家真相！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1111103,
			"completionStepIds": [],
