			"dialogs": [
				{
					"id": 3600101,
					"content": "呼，小菜一碟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600102,
					"content": "不过没想到，原来你也不是没有战斗能力的路人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600103,
					"content": "谢谢你刚才的支援啦，这一战感觉如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600104,
					"content": "轻轻松松。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "说起来，「丘丘人」怎么会出现在这里呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3600107,
					"content": "这种生物，一般不会在离城市这么近的地方建立营地吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3600108,
					"content": "是啊。它们本该只在荒野游荡才对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600109,
					"content": "但最近风魔龙经常出现，果园被摧毁，商路也受到了影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600110,
					"content": "风暴爆发时又经常有人受伤…所以骑士团要分心防御。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600111,
					"content": "所以这些烦人的生物，活动范围就越来越近？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3600112,
					"content": "是呀。不过今天又清理了一个营地，还是很有收获的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600113,
					"content": "跟我来吧！认真负责的好骑士要护送你们进城了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600105,
					"content": "勉勉强强。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				}
			]
		}
	]
