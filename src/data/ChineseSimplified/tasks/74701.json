				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "咦？怎么感觉这边多了一个池子？牌子上写了什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010102,
					"content": "「危险，请勿靠近」？什么意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010103,
					"content": "字面意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010104,
					"content": "哇！桑多涅。吓我一跳，这牌子是你立的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010105,
					"content": "嗯，免得谁好奇心重掉到了这池子里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010106,
					"content": "这池里有什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010107,
					"content": "食人鱼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010108,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010109,
					"content": "哈哈，逗你玩的，还真信啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010110,
					"content": "我早些时候发现水族箱里有些鱼领地意识比较强，性格也比较暴躁，会攻击其他小鱼。就把它们移到这里来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010111,
					"content": "吓我一跳…所以说，这里就像是鱼儿们的特殊疗养所一样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010112,
					"content": "嗯，这池子水比较深，空间也大许多。能让那些领地意识较强的鱼冷静冷静。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010113,
					"content": "我还找梅洛彼得堡的希格雯护士要了些特制的饵食，缓解缓解它们暴躁的脾气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010114,
					"content": "哦，原来是这样。你还是挺关心这些鱼的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010115,
					"content": "看它们在鱼缸里打架谁都不好受吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010116,
					"content": "的确。那干脆这个工作也交给我们吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010117,
					"content": "好啊。总之只要池子里的鱼有心情到水面上来透气，就说明它们疗养得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010118,
					"content": "治好了它们的脾气，就又能把它们放回水族箱里了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010119,
					"content": "放回哪儿随你们自己定。我只负责把不听话的捞到这个池子里而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747010120,
					"content": "好吧，但你的告示牌也太吓人了，要不换一个？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747010121,
					"content": "唔…也行。你们捕的鱼，听你们的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
}