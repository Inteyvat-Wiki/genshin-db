					"阿桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400701,
					"content": "你们来啦，愿望我已经写在霄灯上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400702,
					"content": "现在时候也正好…我们马上放飞霄灯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400801,
					"content": "我的愿望，果然还是希望所有的璃月的居民，都能无病无灾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400802,
					"content": "那「不卜庐」的生意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "哈哈，所以说是我个人的愿望嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400804,
					"content": "我愿意为人抓药，是因为我不想看到有人因为病痛而受折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400805,
					"content": "老话说得好，「但愿世间人无病，何愁架上药生尘」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400806,
					"content": "哈哈，而且只要大家都健健康康的，我也不会那么忙了，应该也是件好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400807,
					"content": "啊，糟了！我想起来，还有一家的药没有送到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400808,
					"content": "抱歉，我要先走了！祝你们海灯节快乐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
				}
			]
		},
