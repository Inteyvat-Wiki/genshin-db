			},
			"dialogs": [
				{
					"id": 413400601,
					"content": "这霄灯又规整又结实，呵呵，我的手艺可比这差远了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400602
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400602,
					"content": "那等到晚上，我们就去把这盏霄灯放起来吧，我知道一个不错的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400603
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400603,
					"content": "放灯之前的这段时间，我要好好想想，究竟许什么愿望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
				}
			]
		},
