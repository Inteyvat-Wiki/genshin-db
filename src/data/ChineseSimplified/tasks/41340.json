			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "不好意思，过节还要麻烦你，每年海灯节「不卜庐」的患者都会变多，实在是有点忙不过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400102,
					"content": "为什么会这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "海灯节的时候，大家都会放下工作陪伴家人，自然也少不了各种饭宴，香醇美酒，鸡鸭鱼肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400104,
					"content": "这样一来，难免消化不良，或者闹出这样那样的病症…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400105,
					"content": "虽然我总是劝人「切忌暴饮暴食」，但逢上了佳节良宵，这种劝告实在是没什么效用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400106,
					"content": "刚刚又有几家人联系我，让我去送治消化不良和胃病的药。可「不卜庐」的事也不能放下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400107,
					"content": "旅行者，如果你愿意的话，能帮忙去送几份药吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
				}
			]
		},
		{
			"id": 4134002,
			"completionStepIds": [
				4134003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
