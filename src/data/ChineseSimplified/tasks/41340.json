			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "辛苦你们了，药应该都送到了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400402,
					"content": "感觉他们还会接着犯病…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "没办法，如果不注意生活习惯，肠胃病很难根治，只有再次生病的时候再对症下药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400405,
					"content": "不过这下子，我也终于可以喘口气了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400406,
					"content": "关于霄灯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "放霄灯？我们…一般不会放啦，放霄灯是为了许愿的，「不卜庐」能许什么愿呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400408,
					"content": "别的商家都希望生意兴隆，但治病救人的药庐总不能期待这种事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400409,
					"content": "阿桂先生是善良的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "不过就我个人来说，我还是想放盏灯的，毕竟过节嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400412,
					"content": "但霄灯我做了几天了，因为太忙，现在也只开了个头。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400413,
					"content": "趁现在短暂的休息时间，我也只能多编两下，等到霄灯做好，海灯节怕是都结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400414,
					"content": "我来帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "真、真的吗？那就谢谢你了，感激不尽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400410,
					"content": "阿桂先生很诚实啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "感觉只能治一时…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				}
			]
		},
