			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志华"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "是不是吃了什么不干净的东西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "志华"
				},
				{
					"id": 413400202,
					"content": "关于阿桂的药…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "哦！谢谢，这个就是我找阿桂开的胃药吧？我确实有些消化不良…这肚子难受得紧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "志华"
				},
				{
					"id": 413400204,
					"content": "我其实就在市集里逛了一会，吃了一会，一不小心就吃多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "志华"
				},
				{
					"id": 413400205,
					"content": "你都吃了些什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "唔…炒饭，鱼生，水果，好多好多虾，对了，还有很好喝的酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "志华"
				},
				{
					"id": 413400207,
					"content": "难怪会有胃病…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "所以才需要吃药嘛。但是你想，要是过节都不能想吃什么就吃什么，日子过得是不是就太没意思了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "志华"
				},
				{
					"id": 413400210,
					"content": "总之，谢谢你们的药，我也趁这个机会，稍微歇一会儿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志华"
				},
				{
					"id": 413400208,
					"content": "就算是过节也不能太放纵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
