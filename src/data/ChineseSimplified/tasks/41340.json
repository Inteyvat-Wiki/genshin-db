			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"观海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "唔唔，哎哟…真难受…你、你有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "观海"
				},
				{
					"id": 413400302,
					"content": "关于阿桂的药…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "哦哦，谢谢你们！是我订的…来得真及时。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "观海"
				},
				{
					"id": 413400304,
					"content": "哎呀，有药吃就好多了，我估计我是晚上吹海风引了风寒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "观海"
				},
				{
					"id": 413400305,
					"content": "不是消化不良吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "怎么可能？我的肠胃好得很，给你讲，我之前一顿饭能吃下三条烤鱼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "观海"
				},
				{
					"id": 413400307,
					"content": "就算是现在，吃饭喝酒的时候，周围的朋友也没有谁是我的对手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "观海"
				},
				{
					"id": 413400308,
					"content": "好了，不说了，我赶快吃药，接下来还有一场酒局呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "观海"
				},
				{
					"id": 413400309,
					"content": "总之要保重身体。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "哈哈哈，没关系啦，又不是老头子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "观海"
				},
				{
					"id": 413400312,
					"content": "不过谢谢你的好意，我会注意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "观海"
				},
				{
					"id": 413400310,
					"content": "身体垮掉再想修养就晚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
