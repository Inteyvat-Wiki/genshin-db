			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄机"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2131.829,
							396.2,
							2597.355
						],
						"pointId": 311500160
					}
				]
			},
			"dialogs": [
				{
					"id": 711340101,
					"content": "唷！客官，看您这风尘仆仆的样子，在找喝茶歇脚的地儿吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340102
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340102,
					"content": "你这有茶喝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340103
					]
				},
				{
					"id": 711340103,
					"content": "可不是，方圆几里，就小的这一家茶摊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340104
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340104,
					"content": "那都有什么茶呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340105,
					"content": "呃…嗯…爆…火热爆裂甜甜花蜜茶，嗯，没错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340106
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340106,
					"content": "是一种用野生甜甜花和骗骗花蜜融合而成的特饮。入口火热，回味清凉，驱疲解累，别处可见不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340107
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340107,
					"content": "哦！是没听过的茶呢！感觉会很好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340108,
					"content": "不巧的是，小的手头原料用完了，但旁边的原料地很危险呢，既要摘甜甜花，又要对付神出鬼没的<color=#00E1FFFF>火骗骗花</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340118
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340118,
					"content": "假如能有足够的原料重新支撑小店，付出再多报酬小的又何惧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340109
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340109,
					"content": "但可惜现在…真是难为情啦，客官要不别处转转？小的回头去趟冒险家协会，请他们帮忙取些原料再…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340110
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340110,
					"content": "好消息，我们就是冒险家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340111
					]
				},
				{
					"id": 711340111,
					"content": "呃…咳咳…这…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340112
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340112,
					"content": "没错，爆裂甜甜花蜜茶，一定要喝到，让我们去帮你解决原料的问题吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340113,
					"content": "那…那里的骗骗花，可就像暝垣山上的石头一样多哦！你们还是别冒这个险吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340114
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340114,
					"content": "…可如果真有那么多，这里不应该叫骗骗花山才对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340115,
					"content": "呃…我又想起来，其实我和冒险家协会有过合作协议…也就是说，这样贸然让两位接手，也不太好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340116
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340116,
					"content": "你这个人好奇怪，有现成的冒险家给你帮忙你还不乐意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340117,
					"content": "总之，茶饮虽好，时机不巧，呵呵，客官请回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340119
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340119,
					"content": "好吧，好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340120,
					"content": "#（{NICKNAME}…你说我们要是不听他的，直接去把原料取来，是不是就有茶喝啦？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340121,
					"content": "（好想试试他说的那个茶哦！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7113403,
			"completionStepIds": [
				7113403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
