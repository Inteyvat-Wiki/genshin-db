						],
						"stepId": 7113403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄机"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711340301,
					"content": "咦？客官你们…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340302
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340302,
					"content": "原料给你，上茶吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340303
					]
				},
				{
					"id": 711340303,
					"content": "什么？你们真的去解决了那些<color=#00E1FFFF>火骗骗花</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340304
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340304,
					"content": "确实有不少只哦，不过在我们面前还是不够看啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340305,
					"content": "有不少只？啊不不，小的当然知道有不少只，哈哈，两位果真是艺高人胆大啊，佩服，佩服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340306
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340306,
					"content": "（还好这两位没事…不然我可就失职了…看来下次得换个说辞…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340307
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340307,
					"content": "哼哼，这下你总不能推脱了吧，我们现在就想喝特别的火热爆裂甜甜花蜜茶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340308,
					"content": "咳咳…好…小的这就准备…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340309
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340309,
					"content": "（可恶…要怎么做…应该不会很难吧？！应该把甜甜花和骗骗花蜜倒在一起就好吧？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340310
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340310,
					"content": "玄机面露难色，但还是拿出你们带来的原料，一股脑放进了一个杯子。不到片刻后，他又取出了一些，但最后，还是都放了回去。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340311
					]
				},
				{
					"id": 711340311,
					"content": "之后他盖上茶盖，使劲摇晃起来。不久，一碗漂浮着奇怪泡沫的褐色液体被端到你们面前。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340312
					]
				},
				{
					"id": 711340312,
					"content": "你意识到有什么不太对，但派蒙接了过来，一饮而尽。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340313
					]
				},
				{
					"id": 711340313,
					"content": "啊呸呸呸——这是什么东西啊！我从来没有喝过这么难喝的东西…你这个茶摊子到底是怎么开下去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340314,
					"content": "呃哈哈…真、抱歉！让客官的舌头受了委屈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340315
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340315,
					"content": "这点小心意，请收下吧！就当是对舌头的赔罪，还有为两位找来原料的报酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340316
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340316,
					"content": "唔…好吧。虽然你泡茶的手艺不行，人品还是很不赖的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711340317,
					"content": "呵呵，哪里的话…总之，托两位的福，小的原料备齐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340318
					],
					"speakerTitle": "玄机"
				},
				{
					"id": 711340318,
					"content": "没什么事两位也尽早返回吧，毕竟是野外，难说还有什么危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄机"
				}
			]
		},
