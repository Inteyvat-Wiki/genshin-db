			"dialogs": [
				{
					"id": 760440101,
					"content": "「旗舰」的悬赏里有一条很棘手呢，几乎没什么线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440102,
					"content": "前阵子还听说他在伦波岛北边伤人呢，现在却突然消失得无影无踪，一点消息也没有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440103,
					"content": "「凡走过必留痕迹」，哪怕是抹除痕迹，也会留下新的印迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760440104,
					"content": "再者，悬赏里没有明文写出，也不代表他们没有掌握任何信息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760440105,
					"content": "说得也是，我去找勒塞克问问好了，凭我的资深身份，应该能问出些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440106,
					"content": "那就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760440107,
					"content": "嗯，放心吧，老板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
		},
