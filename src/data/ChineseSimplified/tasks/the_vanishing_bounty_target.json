					}
				]
			},
			"dialogs": [
				{
					"id": 760440201,
					"content": "悬赏目标的信息都在板上，问我也行，但赏金多少没有商量的余地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440202
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440202,
					"content": "关于悬赏目标…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440203
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440203,
					"content": "板上有四个目标，但只有三个有线索。被人指控欺诈而悬赏的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440204
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440204,
					"content": "…停一下，停一下！敷衍那些新入行的宝藏猎人也就算了，对我也这样？你知道我要问的是哪个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440205
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440205,
					"content": "「秘闻馆」要插手吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440206
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440206,
					"content": "那得看老板的意思。欸？怎么变成你问我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440207
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440207,
					"content": "说起来，「裂颚」哈尔克到现在还是下落不明，难道不是因为你们给的线索写得太模糊了吗？你自己看看，连外貌特征都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440208
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440208,
					"content": "要是哪个宝藏猎人连这个都不知道，那肯定也不是哈尔克的对手，何必让他们浪费时间…浪费自己的性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440209
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440209,
					"content": "好吧，那除了他下巴上那道骇人的疤痕，还有什么其他的特征？最好是其他人不知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440210
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440210,
					"content": "其他人不知道的…你是说身上的，比如说背上的印记之类？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440211
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440211,
					"content": "对，就是这种，原来真有啊！不过你又是怎么知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440212
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440212,
					"content": "我不知道。有没有我也不知道。再说，就算真的有，你准备怎么查验？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440213
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440213,
					"content": "这、这么说来也是…唉，真的就没什么独家消息？看在咱们这么熟的份上，就不能透露一点吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440214
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440214,
					"content": "哈尔克在那夏镇暴露了本性之后逃窜去了伦波岛北部一带，在那里继续为非作歹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440215
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440215,
					"content": "这我都知道，之前多多少少听过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440216
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440216,
					"content": "但他最近不是没了消息吗？要是去了北边，皮拉米达城还好，但要是去了至冬堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440217
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440217,
					"content": "（冰天雪地的，我这胳膊能受得了吗…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440218
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440218,
					"content": "不会，他还在伦波岛，只是不知道他在哪里藏身。这条是独家消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440219
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440219,
					"content": "欸，这你又是怎么确定的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440220
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440220,
					"content": "那就是商业机密了，价钱是另算的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440221
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440221,
					"content": "嘁，小气。唉，一个下巴有疤的壮汉，哪怕只是在伦波岛上，走十步也能碰到一个吧，这要怎么找啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440222
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440222,
					"content": "那就看在我们这么熟的份上，给你一个建议，别光盯着下巴上的疤痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440223
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440223,
					"content": "…你是想说，他会设法把下巴上的疤痕遮住？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440224
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440224,
					"content": "有道理…他会被称作「裂颚」就是因为那道标志性的伤疤，反过来说，如果没了这道疤痕，他就和其他壮汉没什么区别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440225
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440225,
					"content": "这样一来，只要找刻意遮挡下巴的壮汉就好了。算是一条新线索，好吧，之后有进展了再来找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440226
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440226,
					"content": "等你的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒塞克"
				}
			]
		},
