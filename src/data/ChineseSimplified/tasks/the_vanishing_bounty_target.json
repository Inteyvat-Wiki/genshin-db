			"dialogs": [
				{
					"id": 760440301,
					"content": "「旗舰」的悬赏啊…不知不觉就只剩最后一条了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440302,
					"content": "#听闻是多亏了{NICKNAME}的活跃，不过看来就算是{M#他}{F#她}，对这最后一条悬赏也是束手无策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760440303,
					"content": "毕竟实在没什么线索嘛——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440304,
					"content": "啊，悬赏上没写，倒也不见得真的没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440305,
					"content": "看来你有头绪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760440306,
					"content": "我去找勒塞克问问好了，凭我的资深身份，应该能问出些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "雅珂达"
				},
				{
					"id": 760440307,
					"content": "那就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "奈芙尔"
				},
				{
					"id": 760440308,
					"content": "嗯，放心吧，老板！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂达"
				}
			]
