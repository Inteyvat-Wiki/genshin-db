			"trigger": {
				"objectNames": [
					"拉菲克",
					"绮珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230220101,
					"content": "这里的强度要是再增加的话，就必须把这里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220102,
					"content": "如果你采用这种设计，就和之前没什么本质区别了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "绮珊"
				},
				{
					"id": 230220103,
					"content": "你们还在设计船吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "是你啊，旅行者。没错，在上次试航结束之后，我和绮珊又讨论了一些…嗯…关键节点上的设计。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220105,
					"content": "在我们…充分地交流后，正准备尝试一种新的设计方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220106,
					"content": "但是在材料使用上，我们又产生了一些分歧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220107,
					"content": "不过这一次！我可是听了绮珊的意见，花大价钱买了一批好材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220108,
					"content": "旅行者，你看，我一个人搬不完，绮珊的力气也不大，你就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220109,
					"content": "我们一起去搬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "真是可靠，那我们赶紧出发吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220112,
					"content": "这次的材料可是绮珊亲自选的，应该不会出什么问题了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220113,
					"content": "而且这次，我还给你准备了更多的报酬，真是谢谢你帮忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220110,
					"content": "别说了，走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
