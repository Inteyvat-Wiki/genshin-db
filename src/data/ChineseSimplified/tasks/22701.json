			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "这里就可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010402,
					"content": "到底是什么事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "唉，还是我师妹小雀儿的事。我与她平日习武练功形影不离，她的功夫也不在我之下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010404,
					"content": "但这次进绝云间寻访仙迹本就路途艰辛，她又爱说话，前几天着了凉，嗓子也哑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010405,
					"content": "我看朋友功夫也是不凡的，能不能请你帮我去旁边的山崖顶上摘三朵清心回来，我给小雀儿泡水喝养养嗓子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010406,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "那就拜托朋友了，小雀儿太活泼了，我可不敢独自去采药，放她一个人在这。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010408,
					"content": "为什么要避着她？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "让朋友看笑话了，我师妹她从小就性子要强，万事都不肯落了旁人半点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010410,
					"content": "要是当着她面说给她找药养嗓子，她一定会和我置气不肯喝药，所以只能避着她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010411,
					"content": "我又不敢独自去采药，把她留在原地，所以只能拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		},
