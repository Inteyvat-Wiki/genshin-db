					"孙宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "有话直说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "我师兄同你搭话，你给我客气点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010203,
					"content": "师妹，是我主动叫住这位朋友的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010204,
					"content": "只怕这人又是个想来绝云间碰仙缘的投机贼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010205,
					"content": "师妹，好了，好了，你先在这里歇歇吧，我和这位朋友说几句话就回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010206,
					"content": "师兄，有什么事不能当着我说的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010207,
					"content": "只是一些杂事，师妹你肯定是不愿意听的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010208,
					"content": "哼，肯定又是要说古华派的事了…好啦，师兄你不愿意我听，我不听就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010209,
					"content": "这位朋友，请随我去那边，我再和你细细说过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孙宇"
				}
			]
		},
		{
