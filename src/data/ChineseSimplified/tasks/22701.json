			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "这是采给你治嗓子的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "朋友！你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010703,
					"content": "…我哪里有这么娇弱，吹点风就嗓子哑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010704,
					"content": "不过，这些清心倒是正好来止止我师兄的头疼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010705,
					"content": "师妹，你听我说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010706,
					"content": "师兄，你先去避风的地方歇歇吧，我待会煮了糖水给你喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010707,
					"content": "你，拿好这些，赶紧走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小雀儿"
				}
