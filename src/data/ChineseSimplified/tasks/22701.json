			"dialogs": [
				{
					"id": 227010501,
					"content": "你回来了，我所托之事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010502,
					"content": "已经采到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "这些就可以了，谢谢朋友，容我找些谢礼给你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010504,
					"content": "咦？你怎么采了这么多清心回来，师兄，你是不是又头痛了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小雀儿"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
