			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "是给你师兄治头痛的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "师兄，你若要去采药，我给你去采就是，何必拜托这外人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010603,
					"content": "再说了，这人不知来历，说不定有什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010604,
					"content": "…好了，师妹，这位朋友是帮了我们的，不要这么说人家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010605,
					"content": "谢谢你，这些谢礼请你收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "孙宇"
				},
				{
					"id": 227010606,
					"content": "收下了就快点走吧，我师兄头疼吹不得风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "小雀儿"
				},
				{
					"id": 227010607,
					"content": "师兄，我们快点去那边避避风，我煮点热糖水给你喝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小雀儿"
				}
			]
		},
