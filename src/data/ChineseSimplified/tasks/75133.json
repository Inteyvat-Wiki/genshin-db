			"dialogs": [
				{
					"id": 751330301,
					"content": "#哇，打开了，这次多亏了{REALNAME[ID(2)|SHOWHOST(true)]}才找到了机关呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330302,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#不愧是{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "不过也不要自满哦，接下来还有更多的挑战在等着我们呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330305,
					"content": "既然入口已经打开了，不管怎么样我们都得下去探个究竟了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330306,
					"content": "我也同意呢，小派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330307,
					"content": "叽…叽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "「绿松石」"
				},
				{
					"id": 751330308,
					"content": "嗯？绿宝你怎么这么抗拒的样子啦，不会是害怕了吧。可不能在这里退缩啊，我们的冒险之旅才刚走完一半呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330309,
					"content": "咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "「绿松石」"
				},
				{
					"id": 751330310,
					"content": "玻娜你就不要强迫绿宝啦，它看起来真的很害怕的样子，难不成是下面有什么不得了的危险东西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330311,
					"content": "好可怕！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#喂，你怎么也开始害怕了，像{REALNAME[ID(2)|SHOWHOST(true)]}一样打起精神来啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330313,
					"content": "开始跃跃欲试了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "哇，没想到你这么有精神，虽然我也觉得不管下面有什么都不会是你的对手啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330315,
					"content": "不用担心，我们有勇敢小龙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "呀…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "唔，绿宝这么害怕的话，不如就先留在这里。啊，不过也不能把绿宝一个人抛下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
