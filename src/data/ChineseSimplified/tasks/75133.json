					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "没想到绿宝把我们带到了这里，看起来和我们遇到玻娜的那个地方一样，是座奇怪的要塞呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330102,
					"content": "瞧，这里也有幅一模一样的壁画，唔…不过这个上面倒是没有被涂抹的痕迹，是因为这里太高了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}，你说，这上面画的不会就是刚才玻娜说的那个蛇王吧，一看就不是很好惹的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330104,
					"content": "嗯嗯，这家伙就是蛇王奥奇坎哦，传说他为了建造天蛇船，残酷地压迫民众，直到最后引来了深渊，落得个身死国灭的下场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330105,
					"content": "当然这也只是传说啦，毕竟就连那个蛇王最后到底怎么样了，部族里的叙事人也有一大堆不同的说法呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330106,
					"content": "说不定他现在还徘徊在那艘天蛇船里以财宝为食呢，又或者一直阻碍我们的邪龙，其实就是他的怨灵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330107,
					"content": "咕叽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "「绿松石」"
				},
				{
					"id": 751330108,
					"content": "哇，好可怕。你别说这种吓人的话吧，绿宝都被你吓到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330109,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#自从打败了那条坏龙，{REALNAME[ID(2)|SHOWHOST(true)]}就一直跃跃欲试的样子，难不成是在偷偷和绿宝进行什么冒险比赛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330111,
					"content": "话说回来，我们要找的那个祭坛究竟在哪呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330112,
					"content": "如果绿宝所指的方向没错的话，就是在这下面…欸？我以为会是在更高的地方呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330113,
					"content": "难道是搞错了什么吗，源火祭坛应该不会藏在山体的中心吧，那岂不是要把整座山都吹塌了才能把我们送到天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330114,
					"content": "难道是有什么特殊的传送手段？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "呃，刚才在下面还说得信誓旦旦的，这下可难办了。而且我们又听不懂绿宝说话，也不知道它到底是什么意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330116,
					"content": "咕噜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "「绿松石」"
				},
				{
					"id": 751330117,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你有什么头绪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330119,
					"content": "我知道了，小派蒙，它的意思是说，只是一板一眼地盘逻辑的话，冒险可是没办法继续的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330120,
					"content": "又是你乱编的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751330121,
					"content": "总之，不管下面是什么，我觉得都应该先去一探究竟呢，这也是冒险的一部分吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751330122,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#唔，没想到{REALNAME[ID(2)|SHOWHOST(true)]}这么精神，那我们先调查看看要怎么才能下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
