			},
			"dialogs": [
				{
					"id": 200430101,
					"content": "腰怎么这么痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "我正准备去工作，但是突然腰很痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430104,
					"content": "我已经和昆恩约好去他的水果摊帮忙，现在只能休息一下再去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430105,
					"content": "唉，但是光待在这里也只是耽误事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430106,
					"content": "你能帮我去问问昆恩，他需要我做什么工作吗？我也好做些准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "那就拜托你了，我只要休息一会就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430109,
					"content": "这看着不远…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "喂，这么点小事，帮个忙也没关系吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
