			"dialogs": [
				{
					"id": 200430501,
					"content": "你找到日落果了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430502,
					"content": "已经找好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "谢谢，这些应该就够优律小姐买了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430504,
					"content": "唉，但是很多客人们还是走掉了，一个人果然还是忙不过来啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430505,
					"content": "哦对了，谢谢你们帮忙，要给你们谢礼才行，稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430506,
					"content": "谢礼就不用了，我们有事情拜托你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430507,
					"content": "关于米歇尔小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "米歇尔小姐…你们遇见她了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430509,
					"content": "希望我交给她一点轻松的工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430510,
					"content": "可我一开始就只准备让她帮忙看店啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430511,
					"content": "是，是这样吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430512,
					"content": "不过现在客人们都走了，看来是不用人看店了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430513,
					"content": "麻烦你们告诉米歇尔小姐，让她回去休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430514,
					"content": "我等会准备去看看那批货到底怎么回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				}
			]
		},
