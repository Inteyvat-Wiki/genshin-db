				"points": []
			},
			"dialogs": [
				{
					"id": 200430301,
					"content": "怎么还没送来，糟糕了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430302,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "啊…摊子里的日落果卖光了，我刚去订了几批日落果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430304,
					"content": "但是到现在也没送来…好多客人都在等着买呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430305,
					"content": "光是优律小姐就来了三趟了，她就只要<color=#00E1FFFF>三颗日落果</color>，我可不想失去这个老顾客啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430306,
					"content": "我还要看摊子…要是谁能帮我去城外找点日落果回来就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430307,
					"content": "很急的话，我能帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "你愿意帮忙吗？那太好了，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200430309,
					"content": "米歇尔小姐马上就来…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "等一下！米歇尔小姐那个样子，怎么出去摘果子啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430311,
					"content": "我们来帮忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
