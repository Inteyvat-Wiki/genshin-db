			},
			"dialogs": [
				{
					"id": 200430601,
					"content": "你们问昆恩先生了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430602,
					"content": "昆恩先生请你回去休息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "昆恩先生的店里今天没有什么工作喔，请回去好好休息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430604,
					"content": "是吗，呼…看来要去找别的事做了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430605,
					"content": "咦，咦？！你不去休息吗？好不容易不用工作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200430606,
					"content": "你们感受一下四周，巴巴托斯大人的风还在勤劳地工作着。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430607,
					"content": "我们这些被他庇佑着的人，也没有偷懒的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430608,
					"content": "不过，你是去做什么事了，怎么出了这么多汗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "米歇尔"
				},
				{
					"id": 200430609,
					"content": "看来你也是个忙碌的人呢。不过这样也好，借助着辛勤的汗水，才能更清晰地感受到巴巴托斯大人的风。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "米歇尔"
				},
