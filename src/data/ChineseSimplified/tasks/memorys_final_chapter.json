			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"兰纳真",
					"兰迦鲁",
					"兰纳迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "兰纳迦，他来啦，他们来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 730590202,
					"content": "嗯嗯，来啦，来啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730590203,
					"content": "#来啦，那菈{NICKNAME}，白色的飞飞。欢迎你们，我们三个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 730590204,
					"content": "到了，月亮。到啦，种下花朵的时刻。你们准备好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 730590205,
					"content": "我准备好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "嗯，我也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590207,
					"content": "那么…兰纳真，兰迦鲁，我们开始仪式吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 730590208,
					"content": "「归去，归去，花园的梦，森林的记忆…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 730590209,
					"content": "「迎接吧，让我们：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 730590210,
					"content": "「渐浓的睡梦，不散的欢欣。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 730590211,
					"content": "「庆贺呀，让我们：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730590212,
					"content": "「石榴歌唱，苹果鼓掌！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730590213,
					"content": "兰那罗们种下干瘪的花朵，随着歌谣在风中回荡，花朵奇迹般地重返了新生…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "哇…这三朵花，又活过来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590215,
					"content": "是呀，因为…是慈悯的，「无郁夷摩」。所以，她要让记忆有重新焕发的机会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 730590216,
					"content": "嗯！即使我们不再记得你们啦，记忆也会…唔，融进叶脉和根系中间，变成绿叶，变成年轮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 730590217,
					"content": "或者变成肉肉的虫虫，给别的虫虫吃，别的虫虫留下滋养草木的东西，让我们全都长大大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "兰迦鲁"
				},
				{
					"id": 730590218,
					"content": "可是…你们还是不记得我们了，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590219,
					"content": "嗯…因为，并不专属于你我，记忆…过去经历的事情，我们，已经分给了森林里的所有草木…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "兰纳迦"
				},
				{
					"id": 730590220,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "但是没关系呀，我们已经是新的朋友了，对吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "兰纳真"
				},
				{
					"id": 730590222,
					"content": "嗯！新朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兰迦鲁"
				}
			]
		},
