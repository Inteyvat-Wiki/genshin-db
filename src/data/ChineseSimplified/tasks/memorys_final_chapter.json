				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "「石榴歌唱，苹果鼓掌…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590102,
					"content": "你好呀，海亚姆先生！你怎么在这里？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590103,
					"content": "哦哦，你好，你好。白色的小朋友，和…唉…抱歉，孩子，我的脑袋不太清楚了，时间稍微一长就记不住名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590104,
					"content": "#叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "哈哈…好啊，你们就是之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590106,
					"content": "对！我们就是那两个「杰万」——勇敢的年轻人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590107,
					"content": "嗯…所以，告诉我，「兰那罗」，他们还记得我吗？还记得我们所有人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590108,
					"content": "欸…这个…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590109,
					"content": "他们还记得你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590111,
					"content": "这样啊…但我看不到他们了，也听不到他们如何想念我…真是遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590114,
					"content": "呵呵…我看不到他们了。我太老了，看不到他们的样子，听不到他们的声音…错过了，都错过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590115,
					"content": "咳咳…抱歉，我先离开了。或许只有期待奇迹了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590116,
					"content": "奇迹不能去理解，不能去追求，只能等待呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "海亚姆"
				},
				{
					"id": 730590117,
					"content": "海亚姆蹒跚着离开了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "他们不记得你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "但是…我们还可以和他们重新交朋友呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
