			"dialogs": [
				{
					"id": 706940101,
					"content": "邦邦小姐，腰还疼吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940102
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940102,
					"content": "目前没事了…热敷当真见效快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940103
					],
					"speakerTitle": "「邦邦滚石」"
				},
				{
					"id": 706940103,
					"content": "嘿嘿，用慢速火药加热湿绷带的方法，可得把握好时间哦，不然就会把绷带点燃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940104
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940104,
					"content": "这种加热绷带的方法，可能只有宵宫才能想到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940105,
					"content": "#等等…看看这是谁来了！名副其实的大英雄，和{M#他}{F#她}的白色伙伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940106
					],
					"speakerTitle": "「邦邦滚石」"
				},
				{
					"id": 706940106,
					"content": "漫画织卷里的场景，要在我眼前上演了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940107,
						706940108
					],
					"speakerTitle": "「邦邦滚石」"
				},
				{
					"id": 706940107,
					"content": "你们这是在疗伤？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				},
				{
					"id": 706940109,
					"content": "不打紧！只不过是在野外转悠，找了些以前没怎么见过的强敌练手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940110
					],
					"speakerTitle": "「邦邦滚石」"
				},
				{
					"id": 706940110,
					"content": "宵宫小姐才是，我不小心扭到腰咕噜噜摔成雪球滚下来的时候，帮了我大忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940111
					],
					"speakerTitle": "「邦邦滚石」"
				},
				{
					"id": 706940111,
					"content": "哇啊…听着就疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940112,
					"content": "哈哈，按照《炽魂斗士战记》的说法，「我只是一个路过的战士罢了」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940113
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940113,
					"content": "而且是自由的雇佣战士！骑士团已经给我行动许可了，可以自行击退魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940114,
						706940115
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940114,
					"content": "听起来，还有魔物在徘徊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940116,
					"content": "好像不妙啊，要不要通知骑士团那边，再派一些人手来支援？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940117,
					"content": "确实不能怠慢，不过情况也不算紧急啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940118
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940118,
					"content": "骑士团的专业人士已经把「国际越野赛」场地周围的魔物清理完了，剩下的都是一些游荡不定的家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940119
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940119,
					"content": "说实话，参加越野赛的选手们中，也不乏武力不错的冒险家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940120
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940120,
					"content": "他们有体魄，有胆识，让他们像普通人一样，处处小心魔物，人家反而觉得自己被看轻了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940121
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940121,
					"content": "所以，按照冒险家协会的办事传统，我们就地组成团队，将处理这些魔物当成了一种试炼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940122
					],
					"speakerTitle": "「邦邦滚石」"
				},
				{
					"id": 706940122,
					"content": "正是——「斗魂试炼」，在清剿魔物的基础上，尽量模仿英雄们的战斗风格，实现对自我的超越！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940123
					],
					"speakerTitle": "「邦邦滚石」"
				},
				{
					"id": 706940123,
					"content": "这个思路，确实很符合「沃陆之邦」的作风！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940124,
						706940125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706940124,
					"content": "那我要加入！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940126,
					"content": "#好啊！很久没看见{NICKNAME}露一手了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940127
					],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940127,
					"content": "非常期待，现在你的身手…漂亮得像是哪种烟花？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宫"
				},
				{
					"id": 706940125,
					"content": "我也不能缺席！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940115,
					"content": "那需要谨慎，附近还有平民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940108,
					"content": "刚刚经历过战斗吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				}
			]
		}
	]
}