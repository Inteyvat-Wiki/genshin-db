			"dialogs": [
				{
					"id": 760360301,
					"content": "这些就够了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360302,
					"content": "嗯，它看起来很满意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360303,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360304,
					"content": "我以前都不知道月灵还会画画呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360305,
					"content": "它们其实和我们一样，有着各自的性格和爱好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360306,
					"content": "欸？难道说挪德卡莱的每一只月灵你都认识？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360307,
					"content": "嗯，只要见过的话就认识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360308,
					"content": "这么厉害？！在我看来除了努昂诺塔有些特殊之外，其他月灵几乎都长一个样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360309,
					"content": "那这只会画画的小家伙叫什么名字呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360310,
					"content": "名字…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360311,
					"content": "你该不会没给它们取名字吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360312,
					"content": "我认识它们，它们也认识我，不需要名字…我也没有名字呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360313,
					"content": "不要把不好的传统延续下去呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360314,
					"content": "呃…那，那我想想…「努昂诺塔」意思是月神赐福下诞生的生灵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360315,
					"content": "那「画」在「霜月之子」的语言里是怎么说的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360316,
					"content": "好像是…梅…娜？梅拉？是梅拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360317,
					"content": "听着还不错，那就叫它「梅拉」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360318,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360319,
					"content": "怎么样，梅拉，你画好了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360320,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360321,
					"content": "哦！我看看我看看…这！这…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360322,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "这画得也太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360324,
					"content": "我还以为画得会比较孩子气…或者…像美露莘那样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360325,
					"content": "月灵很擅长感知周围的环境，在临摹所见之物的时候，倾向于将自己的感受原封不动地记录下来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "「少女」"
				},
				{
