			"dialogs": [
				{
					"id": 760360101,
					"content": "不是这个蓝色吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360103,
						760360104
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360103,
					"content": "哥伦比娅？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "嗯？是你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360106,
					"content": "帮帮我好吗？之后会给你们好处的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360107,
					"content": "呃…你什么时候才能改掉这个习惯啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360108,
					"content": "你之前也帮过我们很多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "对啊，就算没什么好处我们也会帮忙的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360111,
					"content": "所以到底怎么了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360112,
					"content": "唔…准确来说，是它需要帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360114,
					"content": "这只月灵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360115,
					"content": "这孩子不知从哪里捡到了一支画笔，回来后在我周围开心地晃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360116,
					"content": "我给它找了些画布和颜料，但画了一阵子后，它好像怎么也调不出心仪的颜色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360117,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 760360118,
					"content": "咦，你怎么出来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360119,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 760360120,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360121,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 760360122,
					"content": "呃…就算你这么比划，我们也不知道你要什么啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360123,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 760360124,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "努昂诺塔"
				},
				{
					"id": 760360125,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760360126,
					"content": "呀！它好像看上了你的背包。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360127,
					"content": "你们身上有带合适的颜料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360128,
					"content": "我们不会随身带那种东西啦…话说回来，哥伦比娅是从哪里找到颜料的？你平时也不像会画画的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360129,
					"content": "这孩子有些等不及，我就随手用身边带颜色的花朵给它做了些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360130,
					"content": "哦！难道说，努昂诺塔也是想找一些色彩丰富的东西来做颜料吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360131,
					"content": "快快快，看看我们包里都有些什么。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760360109,
					"content": "你之前也给过我们赐福…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "发生什么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				}
			]
		},
