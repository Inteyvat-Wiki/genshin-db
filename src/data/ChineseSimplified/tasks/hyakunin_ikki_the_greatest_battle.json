	"talks": [
		{
			"id": 7266001,
			"completionStepIds": [
				7266001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
