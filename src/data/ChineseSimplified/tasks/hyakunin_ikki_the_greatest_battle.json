			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一庆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "嗨！那边那位异乡人，有兴趣战斗吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600102,
					"content": "我是身经百战的战士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "太好了，我果然没看错人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600106,
					"content": "事情是这样的，最近似乎又有人在秘密举办「百人一揆」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600107,
					"content": "百人一首？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "不不不，是百人一揆。百人一首是什么呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600110,
					"content": "过去模仿天狗的「天狗党人」当中，曾经流传过某种传统仪式。简单来说，是这样的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600111,
					"content": "时令不景气时、心情低落时；或是有值得庆贺的喜事发生时；或者只是单纯感到无聊的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600112,
					"content": "就是通过酣畅淋漓的打斗，来进行庆祝、或者消除晦气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600113,
					"content": "好像什么时候都能举办…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "…仔细一想，似乎确实是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600115,
					"content": "总之，我们换个地方说话吧。城里人多口杂，不太方便…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600109,
					"content": "愿闻其详。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "有什么委托吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "也不算是委托吧。总之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "茅葺一庆"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一庆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "我们到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600202,
					"content": "只要踏入这扇看起来十分可疑的大门，就能进入百人一揆的场馆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600203,
					"content": "好兴奋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "虽然「天狗党」早已因为有违公序良俗而被取缔，但不时还会有人秘密举办百人一揆的乱斗大会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600206,
					"content": "而来自世界各地渴求争斗的魔物、冒险者、战士，冥冥之中也会被它吸引，在它的舞台上酣畅淋漓地大打出手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600207,
					"content": "你可以和志同道合的同伴、战友一起去参战。毕竟，所谓「百人」，自然是人数越多越好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600208,
					"content": "你看起来是云游四海的冒险家，想必有愿意与你一同参加的朋友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600209,
					"content": "你不参加吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "我吗？我会以旁观者的身份参与，为你喝彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600211,
					"content": "其实，我的目的是写出最精彩的格斗小说，斩获八重堂的「这本小说真厉害」大奖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600212,
					"content": "而我的直觉告诉我，你一定会是格斗场上最耀眼的明星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600213,
					"content": "我会尽力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "小说的名字我已经想好了，就叫《百人一揆～最强武斗大会篇～》。如果有朝一日你在八重堂书店里看见这本书，那其中一定会有金发的异邦战士登场。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600216,
					"content": "我很期待你的表现。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一庆"
				},
				{
					"id": 726600214,
					"content": "那当然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "好可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}