			"dialogs": [
				{
					"id": 765090101,
					"content": "好你个「热心商人」…怎么，买卖做到这样的地方来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090102
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090102,
					"content": "唉，你不懂，像我们这样兜里空空的平民，看到了哪有商机，就像野狗嗅到了煮得香喷喷的骨头一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090103
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090103,
					"content": "哼，惯会贫嘴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090104
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090104,
					"content": "还是多看看你眼前的局势吧，我看你也是马上要「兵败如山倒」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090105
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090105,
					"content": "#我看未必…正好，{NICKNAME}您也来了啊，快来帮我看看，怎么在这位的手下「逆转颓势」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090106
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090106,
					"content": "哼哼，那你们可算问对人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090107,
					"content": "和我之前玩的有些不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090108
					]
				},
				{
					"id": 765090108,
					"content": "啊，没错，来一个新地方「做生意」，总是要做出一些特别的改变的，你面前的是我改良过的、最新版的兵棋推演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090109
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090109,
					"content": "总之，就是玩法更丰富的推演——现在，有「战线领队」，有不同作用的旗帜…玩起来就会更像是在指挥一支真正的军队了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090110
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090110,
					"content": "只不过和客人推销到半路时，被这位搅了买卖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090111
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090111,
					"content": "为了证明我卖的是合法商品，不被这位报警抓起来，我只好和她来上一盘，以证明我卖的东西不是什么危险的「军事武器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090112
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090112,
					"content": "你又自顾自说上了半天啊…啊，您一定是大名鼎鼎的旅行者吧，还有这位，最好的向导派蒙，久仰久仰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090113
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090113,
					"content": "没想到我们这位热心的枫丹商人人脉竟如此惊人…两位声名远播，今天我终于有幸一窥真容了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090114
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090114,
					"content": "我叫维斯菈娃，是一个…「热心保镖」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090115
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090115,
					"content": "只可惜这盘推演还没结束，不然我一定现在就好好招待你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090116,
						765090117
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090116,
					"content": "（真招待还是真「招待」。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090118
					]
				},
				{
					"id": 765090118,
					"content": "嘿嘿，不用这么客气！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090119,
					"content": "你人还是蛮不错的嘛！以前碰到像你这样打扮的，呃…一般二话不说就是要先打一架的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090120,
					"content": "啊哈，现在是休假期，一般情况下，能动手的时候也尽量不动手，更何况…总之，现在我怎么都不会对您动手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090121
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090121,
					"content": "但你们看起来要动手了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090122
					]
				},
				{
					"id": 765090122,
					"content": "对啊！刚刚过来的时候，虽然你俩只是在玩兵棋推演，但感觉气氛很紧张，看来是误会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090123,
					"content": "想切磋切磋？不错的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090124
					],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090124,
					"content": "也不是不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090125
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090125,
					"content": "喂喂喂！只是打个比方啦，你俩怎么一副当真的样子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765090126,
					"content": "哈哈，别担心，我们也只是开玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090127
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090127,
					"content": "不过看来我这个新商品还有调节矛盾的作用——在紧急关头，两位正欲要战的人掏出了这款新版兵棋推演…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090128
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090128,
					"content": "哎呀，废话多了，不如你直接上手试试！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090129
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090129,
					"content": "好主意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090130
					]
				},
				{
					"id": 765090130,
					"content": "或者，你先来帮我打败她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765090131
					],
					"speakerTitle": "埃德勒"
				},
				{
					"id": 765090131,
					"content": "不许请外援！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "维斯菈娃"
				},
				{
					"id": 765090117,
					"content": "（这个人看起来很危险。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765090118
					]
				}
			]
		}
	]
}