					"nextDialogs": [
						750641102
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750641102,
					"content": "#啊…哈！就你来吧！{REALNAME[ID(2)|SHOWHOST(true)]}小朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750641103,
					"content": "噗，人家的个头明明比你还大点呢！",
