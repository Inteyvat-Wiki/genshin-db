			"dialogs": [
				{
					"id": 750640601,
					"content": "哈哈，很好！请我们的小模特不要动…真聪明。三、二、一，咔嚓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640602,
					"content": "快看，真是杰作！是谁拍的？是我拍的！是谁拍的？是马尼菲科·德·拉·马尼菲桑斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640603,
					"content": "谢谢你们，真是太感谢了！哈哈！这里是答应你们的尾款！啊…还有这个，你看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640604,
					"content": "哇…尾款！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640605,
					"content": "欸？只有一摩拉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640606,
					"content": "太好了…接下来，我们真正的主角要登场了！别害羞！像明星一样登场吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640607,
					"content": "呼…完事了！这份副本送给你们做礼物，你们比枫丹的任何画廊都要更早得到这份杰作！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640608,
					"content": "谢谢，我们会珍惜的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "可是，尾款…尾款…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640613,
					"content": "接下来我会去这个地点…来，让我在你的地图上标出来。嘿嘿，在接下来的旅程中，说不定我们又会相遇呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640614,
					"content": "说不定下一次，我还会麻烦你们帮忙哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640615,
					"content": "呜，不要把那种事情说得好像理所当然一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640616,
					"content": "哈哈，那不是我能决定的，是命运！是命运让我们相遇的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640617,
					"content": "再见了，祝你们一路好运，朋友们！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640618,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "马尼菲科收拢起行李，飞快地跃上了热气球。\\n你们看到热气球先是剧烈地摇晃了两下，引得马尼菲科开怀大笑，然后很快恢复了稳定，向着远方飘去。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "看起来不会太值钱…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "唔嗯？呜呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "是呢…好失望…我还以为尾款会比定金多一点的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "派蒙"
				}
