			"dialogs": [
				{
					"id": 750640412,
					"content": "嗒哒！看吧，光与影的奇迹！枫丹的最新工业成果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640413,
					"content": "这东西对我们来说已经不新鲜啦！你还没说要我们帮什么忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640414,
					"content": "请直说需要我们帮什么忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "看样子，一定是要我们帮忙拍照吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640418,
					"content": "哦哦…好吧，好的！这里是你们的定金，请先拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640419,
					"content": "这么多钱！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640420,
					"content": "哇！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "正如你们所见，我需要给本土的龙类拍几张画片，不是那种动物图鉴上的三视图…不，我要的是那种更有生命力的画片！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640422,
					"content": "嗯、嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640423,
					"content": "只是…唉，有生命力的东西未必愿意听我指挥。假如方便的话，或许身为冒险家的你们可以帮我拍出足够理想的画片吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640424,
					"content": "嗯、嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640425,
					"content": "当然，假如超出你们能力范围的话也不必勉强啦，不过我想你们至少能保护我不被这附近的生物攻击。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640426,
					"content": "所以，定金请尽管留着吧。帮不帮忙就全看你们咯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640427,
					"content": "哇啊…这么多钱，沉甸甸的…真的可以给我们留着吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640428,
					"content": "那还有假！这点钱还需要我多加确认吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640429,
					"content": "哈！哈！那你算是找对人啦！我派蒙就是闻名全——纳塔的驯龙大师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640430,
					"content": "#没问题，没问题！只要有我和{NICKNAME}在，你想要什么龙，我们都能帮你驯服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640431,
					"content": "嵴锋龙？小意思！绒翼龙？太容易！暝视龙？明明白白！还有…呃，鳍游龙、匿叶龙、秃角龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640432,
					"content": "秃角龙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "…大头龙、小手龙、大眼龙、可怕龙、超可怕龙、不那么可怕龙、奇奇怪怪龙、平平常常龙、干干瘦瘦龙、鼓鼓囊囊龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640435,
					"content": "哼哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "那都是些什么啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "还有…嗷呜嗷呜龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640439,
					"content": "嗷呜，嗷呜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "哇呀哇呀龙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640441,
					"content": "哇！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "反正、反正我们全都能搞定！相信我，我们可是驯龙大师哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640443,
					"content": "嗯、嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "唉…我们会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#这么多定金都拿了，我们会帮忙的啦！对不对，{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640446,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640447,
					"content": "抱歉，我现在没空。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "可是已经收了定金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750640449,
					"content": "哈，没关系的，等你们下次有时间吧！我也不是非需要帮手不可就是了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750640437,
					"content": "停一下，听听你自己在说什么！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "等等……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "请给我钱，我会帮忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "我们很酷，请先给钱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "派蒙"
				}
			]
		},
