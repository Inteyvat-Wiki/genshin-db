					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720211
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720211,
					"content": "受人所托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720214,
					"content": "#嗯…而且，冒昧一猜，这位应该就是{NICKNAME}吧，说到底，此事还和{NICKNAME}有些牵连呢。",
					"roleType": "TALK_ROLE_NPC",
