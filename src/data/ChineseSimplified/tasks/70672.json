			},
			"dialogs": [
				{
					"id": 706720101,
					"content": "咦，这不是阿圆吗，怎么到猫尾酒馆里来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720102,
					"content": "阿圆——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720103,
					"content": "你好呀，阿圆！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720104
					]
				},
				{
					"id": 706720104,
					"content": "原来是二位啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720105
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720105,
					"content": "阿圆，你怎么会到这儿…不对！原来你也可以从尘歌壶里跑出来的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720106,
					"content": "那是当然…嗯，这么说来，在壶天之外与两位相见倒还是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720107
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720107,
					"content": "虽说是仙人创造「壶灵」以处理洞天之中的诸多琐碎杂事，不过壶灵活动倒也并不受限于洞天所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720108
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720108,
					"content": "就如阿嘟…哦不，「寻瑰纳琦真君」，平日亦会在四方游走，蒐集那些蒙尘的奇珍之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720109
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720109,
					"content": "哎呀，相较之下，我确实很少从壶中出来就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720110
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720110,
					"content": "原来是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720111,
					"content": "啊，那这次阿圆为什么从壶中出来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720112,
						706720115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720112,
					"content": "难道是来买喝的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720113
					]
				},
				{
					"id": 706720113,
					"content": "虽说也想尝尝此处的饮品与璃月有何不同，但今日毕竟是受人所托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720114
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720114,
					"content": "受人所托？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720117,
					"content": "#嗯…而且说到底，这件事还和{NICKNAME}有些牵连呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720118
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720118,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720119
					]
				},
				{
					"id": 706720119,
					"content": "#哎呀，自从「七圣召唤」流行，想必{NICKNAME}也发现了，发函邀请朋友前来酒馆对局颇有乐趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720120
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720120,
					"content": "只不过在收到邀请函后须千里迢迢赶来，实在是苦事一件，于是有人便托我来此处利用术法，做出一个类似壶天的小房间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720121
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720121,
					"content": "收到邀请函欲来此处之人，只是一瞬灵犀，便可出现在那房间之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720122
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720122,
					"content": "#这样，{NICKNAME}可以自由使用这房间邀人对局，同时也免去了那些受邀者的一些麻烦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720123
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720123,
					"content": "哇，那还真的挺方便的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720124,
					"content": "不过，这里毕竟是玛格丽特小姐的酒馆，你用仙术这样改造，她知道了不会生气吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720125,
					"content": "嗯…这倒是无碍，毕竟房间本身不在猫尾酒馆内，而且，在这之前当然也已经过酒馆主人的同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720126
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720126,
					"content": "「欸呀，璃月的法术还挺好用的嘛，能把酒馆面积扩大一倍吗？」酒馆主人这样说…可惜我的术法做不到这点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720127
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720127,
					"content": "还、还挺像是玛格丽特小姐会说的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706720128,
					"content": "二位在此倒是正好，我本来还正想着什么时候你们回到壶中洞天再说明此事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720129
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720129,
					"content": "那现在就开始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720130
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720130,
					"content": "好，这样就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720131
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720131,
					"content": "#那么，现在就请{NICKNAME}尽情使用这个房间，邀请各处的朋友前来对局吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720132
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720132,
					"content": "啊…差点忘记了，是酒馆里的小家伙拜托我要向你说的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720133
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720133,
					"content": "#{NICKNAME}，希望你能感受到「七圣召唤」的乐趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720115,
					"content": "不会是来打牌的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720116
					]
				},
				{
					"id": 706720116,
					"content": "虽不中却也不远了。我并不是为了牌戏而来，但受托之事确实和牌有关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720134
					],
					"speakerTitle": "阿圆"
				},
				{
					"id": 706720134,
					"content": "阿圆驱使仙术，对酒馆进行了一番改建，并更换了对局邀请板。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
