					"nextDialogs": [
						400040811
					],
					"speakerTitle": "贝儿"
				},
				{
					"id": 400040811,
					"content": "那…那璃月安危就托付两位了，我们盗宝团也不希望全城尽毁啊。$UNRELEASED",
					"roleType": "TALK_ROLE_NPC",
