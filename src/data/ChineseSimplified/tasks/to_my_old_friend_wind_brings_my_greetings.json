			},
			"dialogs": [
				{
					"id": 400040201,
					"content": "#{NICKNAME}，嚯，好久不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040202,
					"content": "凯亚，我们去璃月海灯节了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040203,
					"content": "怎么样，海灯节有趣吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040204,
					"content": "好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040205,
					"content": "那你好好期待蒙德的羽球节吧。应该也不会让你失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040206,
					"content": "说正事吧，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "啊，对了。凯亚，事情是这样的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040208,
					"content": "嗯…建灯用的木、纸、油这些材料…无论怎么想，都很容易滑向危险的方向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040209,
					"content": "哼哼，很有意思，你们为什么觉得我会认识这个符号呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040210,
					"content": "因为凯亚神通广大，值得信任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040212,
					"content": "呵呵呵，不敢当，我哪有那种本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040213,
					"content": "出现了！骑士「谦虚」的品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040214,
					"content": "哼哼，在璃月呆了一阵子，变得牙尖嘴利了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040220,
					"content": "回到正题吧。这是跨国犯罪组织「盗宝团」的符号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040221,
					"content": "你如果有兴趣的话，我可以安排你和线人见一面哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040222,
					"content": "西风骑士团不是不和敌人做交易吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040223,
					"content": "——那是我凯亚的线人，不是西风骑士团的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040224,
					"content": "晚些时候，去风起地吧。我会安排线人去赴会的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040225,
					"content": "谢谢你，凯亚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040226,
					"content": "记住了，「酒中出真知」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040227,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040215,
					"content": "因为凯亚黑白通吃，可以依赖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "没错！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400040217,
					"content": "啧啧。作为荣誉骑士，要慎言啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040218,
					"content": "什么叫黑白通吃？我们西风骑士团是不和敌人做交易的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 400040219,
					"content": "这就是骑士「诚实」的品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "凯亚"
				}
			]
		},
