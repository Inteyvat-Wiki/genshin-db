			"dialogs": [
				{
					"id": 110240301,
					"content": "我还想在这里多待一会儿，以后能像此番追忆的机会，只怕会越来越少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240302,
					"content": "「盐之魔神」，有点可怜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "在魔神战争的年代，断定事物善恶是非的标准，都和现在不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240304,
					"content": "当然…现在的我，也希望她能生在一个更加温柔的时代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240305,
					"content": "遗物会增强奥赛尔的力量吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "虽然「盐盏」与「盐尺」仍具权能，可对奥赛尔来说，不值一提。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240307,
					"content": "若有朝一日他恢复元气，卷土重来…呵，一定会再次被击败吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240308,
					"content": "你接下来要去做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "好问题，如果是以前，可能会给你特别具体的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240310,
					"content": "但现在…嗯，大概是想要继续履行往生堂客卿的职责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "钟离"
				},
				{
					"id": 110240311,
					"content": "不过，如果这次的旅途你乐在其中的话，下次「记录」，不妨再结伴同行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "钟离"
				}
			]
		}
	]
