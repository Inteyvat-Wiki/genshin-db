					{
						"sceneId": 3,
						"position": [
							4410.831,
							150.124,
							4633.232
						],
						"pointId": 6132
					}
				]
			},
			"dialogs": [
				{
					"id": 140040801,
					"content": "出来吧，我们把帽子带回来啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040802,
					"content": "真的吗？太谢谢你们了！我这就出来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040803
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040803,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040804
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040804,
					"content": "什么嘛，你不是有头发吗？还这么浓密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040805,
					"content": "唉，我就说你们误会了，不是那么回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040806
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040806,
					"content": "等一下，这个不是我丢掉的那顶帽子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040807
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040807,
					"content": "因为你说的那顶帽子实在是找不到了，所以我们去买了新的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040808,
					"content": "准确说是别人送的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040809
					]
				},
				{
					"id": 140040809,
					"content": "哦，原来是这样，谢谢你们。但很不好意思，对我来说，不是原来的那顶帽子就不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040810
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040810,
					"content": "因为有什么纪念意义吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040811,
					"content": "这个，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040812
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040812,
					"content": "抱歉，我也解释不清楚。时间很紧，我再去周围找找看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040813
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040813,
					"content": "帽子的话，我刚刚在下面捡到一顶，这是你的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040814
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040814,
					"content": "公爵大人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040815
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040815,
					"content": "哦，是莱欧斯利，有一阵子不见了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040816,
					"content": "今天没什么事，就到处巡视一下。我办公的地方虽然宽敞，但待久了也难免觉得闷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040817
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040817,
					"content": "你们还是老样子，只要有人需要帮忙，无论事情大小，都不会拒绝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040818
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040818,
					"content": "这就是冒险家的精神嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040819,
					"content": "呵，都想让他们到梅洛彼得堡开个分部了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040820
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040820,
					"content": "对你们「檐帽会」来说，帽子是非常重要的东西吧，这可不能随便乱丢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040821
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040821,
					"content": "不然下次估计就没有这样的好运气了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040822
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040822,
					"content": "明白了，非、非常感谢，公爵大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040823
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040823,
					"content": "那…那我先走了，呃，我…我先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040824
					],
					"speakerTitle": "费索勒"
				},
				{
					"id": 140040824,
					"content": "好怪的人，完全搞不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040825,
					"content": "他是做了什么亏心事吗？怎么看到你就像丢了魂一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040826,
					"content": "怎么会，恰恰相反，「檐帽会」的人从不惹事生非，工作态度积极向上，很让我省心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040827
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040827,
					"content": "他的话，我想只是比较内向吧，突然看到我估计有点紧张。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040828
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040828,
					"content": "啊？内向…还有内向的罪人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040829,
					"content": "地面之上有千百罪名，犯罪者亦有千百动机，「罪人」只不过是一个归类标签。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040830
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040830,
					"content": "无论是「邪恶」，还是「暴戾」，还是「自私」，都不足以描述复杂的人性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040831
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040831,
					"content": "他是什么样的人，又为什么会定罪，不去了解他的故事就无从得知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040832
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040832,
					"content": "有道理，反正只要你不在乎就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040833,
						140040834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040833,
					"content": "「檐帽会」是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				},
				{
					"id": 140040835,
					"content": "虽然绝大多数的帮会只是让罪人间的斗殴变成群殴而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040836
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040836,
					"content": "但「檐帽会」的确是在尝试一些比较新鲜有趣的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040837
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040837,
					"content": "你们现在有时间吗？不妨随我去特许食堂坐一坐，正好我也想和你们聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040838
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040838,
					"content": "在那之后如果感兴趣的话，我还可以带你们去「檐帽会」的休息处看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040839
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040839,
					"content": "我对那个食堂没什么好印象，不过反正也没事情做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040840
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040840,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040841
					]
				},
				{
					"id": 140040841,
					"content": "那么请随我来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040834,
					"content": "还有人会认真工作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				}
			]
		},
		{
			"id": 1400409,
