					}
				]
			},
			"dialogs": [
				{
					"id": 140040901,
					"content": "这不是公爵大人还有旅行者嘛，欢迎来到特许食堂，需要今天的福利餐吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040902
					],
					"speakerTitle": "韦尔赛"
				},
				{
					"id": 140040902,
					"content": "不过公爵大人应该提前打个招呼，超豪华福利餐今天可是一份也没有做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040903
					],
					"speakerTitle": "韦尔赛"
				},
				{
					"id": 140040903,
					"content": "那我就不用了。你们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040904,
						140040905
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040904,
					"content": "我不饿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040906
					]
				},
				{
					"id": 140040906,
					"content": "我…我也不要，我宁愿把肚子留给更好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040907,
					"content": "真可惜，看来我们都欣赏不来韦尔赛你的手艺啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040908
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040908,
					"content": "哈哈，那只能请公爵大人想想办法，多给我安排点食材种类，这样我才能开发出更多套餐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040909
					],
					"speakerTitle": "韦尔赛"
				},
				{
					"id": 140040909,
					"content": "不需要食物的话，我给你们上几瓶饮料吧，都是刚到货的好东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040910
					],
					"speakerTitle": "韦尔赛"
				},
				{
					"id": 140040910,
					"content": "这个还不错，原来你这里不只有福利餐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040911,
					"content": "一般人可享受不到，这是公爵大人和你们的独家待遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040912
					],
					"speakerTitle": "韦尔赛"
				},
				{
					"id": 140040912,
					"content": "嘿嘿，我就喜欢独家待遇，那给我两瓶，我很能喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040913,
					"content": "好嘞，稍等哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040914
					],
					"speakerTitle": "韦尔赛"
				},
				{
					"id": 140040914,
					"content": "过了一会儿，韦尔赛把饮料送了上来。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140040915
					]
				},
				{
					"id": 140040915,
					"content": "之前的见面略显仓促，后来又发生了这样那样的事，一直没有机会和你们聊些私人话题。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040916
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040916,
					"content": "我是个很喜欢听故事的人，之前听说了你们在枫丹的种种事迹，很想听听真实情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040917
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040917,
					"content": "要聊这个可就有的说了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040918,
						140040921,
						140040924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040918,
					"content": "战天斗地，行侠仗义。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040919
					]
				},
				{
					"id": 140040919,
					"content": "不错不错。既有勇气投身危险的事件，又有能力全身而退，这可不是随便什么人都能做到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040920
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040920,
					"content": "要不是你们有这样可贵的品质，我可能根本没有机会与你们二位结识。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040927,
					"content": "感觉你一直在捡好听的说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040928,
					"content": "之前那个卖帽子的人明说想要巴结我们，但你是这里的「公爵」，没有理由这么做吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040929
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040929,
					"content": "毕竟你们也帮助了梅洛彼得堡，让我能继续在这地方自娱自乐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040930
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040930,
					"content": "只是出于单纯的敬佩，表达适度的赞扬，难道很奇怪吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040931,
						140040932
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040931,
					"content": "说实话，有点。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040933
					]
				},
				{
					"id": 140040933,
					"content": "原来如此，是信任感的原因啊。没办法，谁让我的故事不值一提呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040934
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040934,
					"content": "我很早就成为罪人被扔到了这里，摸爬滚打很长时间之后，才当上了这里的老大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040935
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040935,
					"content": "手段也是多种多样，有黑有白，只不过在这个地方，没有罪加一等，只有胜者为王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040936
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040936,
					"content": "怎么样，就算知道了这些，也不能提升信任感吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040937
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040937,
					"content": "也是啊，你和我们一路上遇到的人都不太一样…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040938,
					"content": "呵呵，在这点上我也有自知之明。不过这也不影响我对你们另眼相看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040939
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040939,
					"content": "——我很愿意把我们的友善关系保持下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040940,
						140040941
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040940,
					"content": "我也是这样的态度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040942
					]
				},
				{
					"id": 140040942,
					"content": "公爵大人，按照你的指示，我们果然在货物堆里找到了一箱未经报备的违禁品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040943
					],
					"speakerTitle": "格莱"
				},
				{
					"id": 140040943,
					"content": "东西隐藏得很好，对方已经不是第一次做这样的事了，货物的源头我们正在追查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040944
					],
					"speakerTitle": "格莱"
				},
				{
					"id": 140040944,
					"content": "好的，有进展及时通知我，东西留下，先回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040945
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040945,
					"content": "是的，公爵大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040946
					],
					"speakerTitle": "格莱"
				},
				{
					"id": 140040946,
					"content": "抱歉，我都差点把这件事忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040947
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040947,
					"content": "违禁品是什么？不会是很危险的东西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040948
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040948,
					"content": "应该不是，一般提到违禁，往往是想要偷偷运进来的货物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040949
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040949,
					"content": "罪人们很多都身怀绝技，就算很普通的东西也能玩出花来，所以在物品管理上需要格外注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040950
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040950,
					"content": "让我看看…嗯，和预想中差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040951
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040951,
					"content": "哇，有摩拉，小零食，毛线团，绳子，机器零件，还有宝石！收获好丰富啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040952
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040952,
					"content": "等等，既然被你收缴了，也就是说…这些东西现在都归你所有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040953
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040953,
					"content": "嗯，不然也没别的处理方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040954
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040954,
					"content": "#那不是赚疯了吗？！{NICKNAME}，你要不要也搞个「公爵」来当当！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040955,
						140040957
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040955,
					"content": "那派蒙你呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040956
					]
				},
				{
					"id": 140040956,
					"content": "我当仓库管理员！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040959
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040959,
					"content": "没想到你会这么喜欢，那这样吧，这里你随便挑一个东西，算我送你的礼物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040960
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040960,
					"content": "真的吗？随便一个都行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040961
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040961,
					"content": "你可不要反悔哦，我下手超狠的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040962
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040962,
					"content": "我怎么会用这种事开玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040963
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040963,
					"content": "那…我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040964
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040964,
					"content": "就它了，这个黑黑的宝石，一看就是高级货！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040965
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040965,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040966
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040966,
					"content": "我不要了。我不喜欢这个，换一个吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040967,
						140040968
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040967,
					"content": "怎么了，派蒙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040969
					]
				},
				{
					"id": 140040969,
					"content": "这个石头很奇怪，拿起来之后我就想起来很多不开心的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040970
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040970,
					"content": "控制都控制不住，什么讨厌的想法都往外冒…我觉得这个东西很不对劲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040971
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040971,
					"content": "是这样吗？我来试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040972
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040972,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040973
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040973,
					"content": "派蒙说的没错，我也看到了一些不是很愉快的回忆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040974
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040974,
					"content": "也给我试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040975
					]
				},
				{
					"id": 140040975,
					"content": "没关系吗？这种体验真的不算好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040976,
						140040977
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040976,
					"content": "我想和你们信息一致。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040978
					]
				},
				{
					"id": 140040978,
					"content": "原来如此，那你来试试吧，我想它对身体应该没有坏处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040979
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040979,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040980
					]
				},
				{
					"id": 140040980,
					"content": "#怎么样，{NICKNAME}，你也看到了什么吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040981,
						140040982
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040981,
					"content": "嗯，确实如你们所说。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040983
					]
				},
				{
					"id": 140040983,
					"content": "这个宝石就由我来保管，之后我会好好调查一番，派蒙选个其他的东西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040984
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040984,
					"content": "那…唉，算了，我不要了。本来想选小零食的，现在都有点不敢吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040985,
						140040986
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040985,
					"content": "同意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040987
					]
				},
				{
					"id": 140040987,
					"content": "有道理，保险起见，还是把整箱东西全部销毁吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040988
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040988,
					"content": "正好饮料喝得差不多了，接下来我带你们去「檐帽会」看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040989
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040989,
					"content": "我来为你们介绍，顺便我们还能继续聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040990
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040990,
					"content": "你不会平时每天都这么闲吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040991
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040991,
					"content": "你才发现？我们第一天见面时不也这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040986,
					"content": "谨慎是正确的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040987
					]
				},
				{
					"id": 140040982,
					"content": "至少都是…印象深刻的记忆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040983
					]
				},
				{
					"id": 140040977,
					"content": "我的体质比较特殊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040978
					]
				},
				{
					"id": 140040968,
					"content": "不舒服吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040969
					]
				},
				{
					"id": 140040957,
					"content": "「公爵」的称号归我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040958
					]
				},
				{
					"id": 140040958,
					"content": "哦？我们刚刚才达成了和平意向，现在就要抢我位置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040959
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040941,
					"content": "感谢你的招待，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040942
					]
				},
				{
					"id": 140040932,
					"content": "因为你基本不提你自己的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040933
					]
				},
				{
					"id": 140040921,
					"content": "一点点了解了这个国度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040922
					]
				},
				{
					"id": 140040922,
					"content": "原来如此，确实很有旅行者的风格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040923
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040923,
					"content": "沿途记录所见所闻，广交朋友，你的视野和机遇将超过所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040924,
					"content": "其实都和我关系不大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040925
					]
				},
				{
					"id": 140040925,
					"content": "呵呵，这种回答未免太谦虚了一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040926
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040926,
					"content": "或许只是你一个不经意的举动，就催生出了新的变化，扭转了既定的命运。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040927
					],
					"speakerTitle": "莱欧斯利"
				},
				{
					"id": 140040905,
					"content": "没有豪华版就算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040906
					]
				}
			]
		},
