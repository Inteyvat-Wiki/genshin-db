			"dialogs": [
				{
					"id": 140040501,
					"content": "水里也没有，还以为会被吹进去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040502,
					"content": "不知道掉到什么地方去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040503,
						140040504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040503,
					"content": "放弃吧，这里太大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040505
					]
				},
				{
					"id": 140040505,
					"content": "也对啊，不想被人看到秃头的话，只要有帽子遮住就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040506,
					"content": "我们可以去「破烂骨头商店」看看，我印象中那边杂七杂八什么都有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040507,
						140040509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040507,
					"content": "怎么说到商店就兴奋起来了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040508
					]
				},
				{
					"id": 140040508,
					"content": "嘿嘿，因为顺手还能买点其他东西啊，去都去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040512,
					"content": "走吧，先过去看看再说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040509,
					"content": "…先说好，只买帽子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040510
					]
				},
				{
					"id": 140040510,
					"content": "欸？你怎么知道我在盘算什么！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040511,
					"content": "#唉，{NICKNAME}你越来越不好对付了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040504,
					"content": "不如直接去买一个。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040505
					]
				}
			]
		},
