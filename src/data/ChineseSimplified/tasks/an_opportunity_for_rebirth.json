			"dialogs": [
				{
					"id": 140040701,
					"content": "欸？我怎么记得这里的老板不是你来着…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040702,
					"content": "哈哈哈，埃尔瓦德大哥去进货了，这时候一般就让我来守摊子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040703
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040703,
					"content": "等下，金发的外国人，加上一只会飞的白色姜饼人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040704
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040704,
					"content": "你们就是传说中的旅行者和得力搭档派蒙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040705
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040705,
					"content": "对！…哎不对！呃，半对不对？我是想说，我不是什么姜饼人，我是得力搭档派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040706,
					"content": "抱歉抱歉，直到现在才有机会一睹真容，太激动了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040707
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040707,
					"content": "要是有什么说错话的地方，还请多多担待，不要跟我这样的小人物计较。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040708
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040708,
					"content": "啊，也没必要一下子这么客气，我只是吐槽而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040709,
					"content": "你们在伊黎耶岛做的那些事，早就传到梅洛彼得堡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040710
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040710,
					"content": "前段时间听说你们来到了这里，还被公爵大人亲自接待，我们都羡慕得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040711
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040711,
					"content": "现在谁都知道你们是公爵大人身边的红人，都希望能结识一下呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040712,
						140040713
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040712,
					"content": "原来是因为他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040714
					]
				},
				{
					"id": 140040714,
					"content": "哈哈，与其用谎言来拍马屁，我觉得还是坦诚一点比较好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040715
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040715,
					"content": "当初我就是听说埃尔瓦德大哥好像和公爵大人关系不一般，才主动说要来帮他看店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040716
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040716,
					"content": "结果这么久过去了，公爵大人我没见过两次，倒是和大哥成了很好的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040717
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040717,
					"content": "谁做事还没点目的了，但目的是否能实现，也不能强求嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040718
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040718,
					"content": "所以你又看上我们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040719,
					"content": "一码归一码，能碰见你们，本来就是我的荣幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040720
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040720,
					"content": "对了，你们想要什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040721
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040721,
					"content": "男士的帽子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040722
					]
				},
				{
					"id": 140040722,
					"content": "没问题，还有其他的吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040723
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040723,
					"content": "随便挑吧，不用担心「特许券」，都由我来买单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040724
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040724,
					"content": "那怎么行，太不好意思了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040725,
					"content": "哎，反正大哥也不发我工资，每次就让我挑些看得上的东西带回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040726
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040726,
					"content": "我最近也不缺什么，不如送给你们，交个朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040727
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040727,
					"content": "都说到这个份儿上了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040728
					]
				},
				{
					"id": 140040728,
					"content": "那、那我挑挑看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040729,
					"content": "一阵犹豫之后，派蒙很克制地挑选了两种点心。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140040730
					]
				},
				{
					"id": 140040730,
					"content": "真的不再选一点吗？这种机会很难得哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040731
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040731,
					"content": "不用啦，这样就够了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040732,
					"content": "你也有不想占便宜的时候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040733
					]
				},
				{
					"id": 140040733,
					"content": "占便宜和随便拿不一样，还是占便宜更开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040734,
					"content": "算了，聊这个话题就太复杂了，那个人还在等我们呢。下次再和你科普派蒙心理学。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040735,
					"content": "谢谢你，那我们就先走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040736,
					"content": "好的，谢谢惠顾！记得在公爵大人那里给「破烂骨头商店」一个好评哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040737
					],
					"speakerTitle": "尚博迪克"
				},
				{
					"id": 140040737,
					"content": "这种要好评的方式真狡猾啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140040713,
					"content": "我还以为是个人魅力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040714
					]
				}
			]
		},
		{
			"id": 1400408,
