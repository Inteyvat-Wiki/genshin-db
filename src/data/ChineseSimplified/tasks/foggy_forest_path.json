					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820733,
					"content": "呃…突然骂人不太好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "派蒙"
