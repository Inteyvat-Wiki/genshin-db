			"dialogs": [
				{
					"id": 740820701,
					"content": "一滴晶莹的水珠出现在了祭坛上。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "咦，这滴水珠…这滴水珠不会就是宝藏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820703,
					"content": "长得不太像宝藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "我也觉得…毕竟这么顺利就得到了…那它会是什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820705,
					"content": "说不定是镇压魔王的关键物品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "什么？那我们岂不是闯大祸了，快！快把它放回去！希望还来得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820707,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820708,
					"content": "完蛋了！魔王出来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820709,
					"content": "魔王？美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820715,
					"content": "吓死我了…原来是一位美露莘…你怎么在这里呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
