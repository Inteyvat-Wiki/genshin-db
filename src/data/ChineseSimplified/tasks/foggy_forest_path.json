					"nextDialogs": [
						740821038
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740821038,
					"content": "我们会尽快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#派蒙，珀西芙！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821040
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740831040,
					"content": "珀西芙高兴地蹦跳了两下，然后略显匆忙地离开了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
