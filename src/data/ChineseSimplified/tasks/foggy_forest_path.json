					"nextDialogs": [
						740820740
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820740,
					"content": "你喜欢这个名字？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820742,
					"content": "#太好了！那就这么叫你了，嘿嘿。我是派蒙，这是{NICKNAME}，很高兴认识你，珀西芙，我还没见过你这样的美露莘呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820743,
					"content": "#派蒙，珀西芙！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820744,
					"content": "伊黎耶…美露莘…",
