			"dialogs": [
				{
					"id": 740820101,
					"content": "（大部分字迹被磨毁，仅能依稀辨识出——「…清露…歌于幽林雾道…」）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "刻字的石碑"
				},
				{
					"id": 740820102,
					"content": "哎呀！好多字被磨掉了！这些应该是什么景点介绍吧？有些游客真是不太道德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820103,
					"content": "游客应该只会写字的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#嗯…说的也对，比如写点{NICKNAME}和派蒙在此一游之类的…不不不，我们很有道德，我们不会乱写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820105,
					"content": "那这样想就奇怪了，为什么字被磨掉了？只剩下这句…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820106,
					"content": "就连这句上面也有好多划痕，肯定是没磨干净，幸运的幽林雾道，你是漏网之鱼哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820107,
					"content": "幽林雾道是什么地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "嗯…林子里面有很多雾的道路？是这个意思吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820109,
					"content": "有点想去找找看呢，总感觉隐藏了什么秘密，最后指向一个珍贵的宝藏！书里都是这么写的，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820110,
					"content": "你在哪个地摊看的书？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "我才不是只会吃东西的派蒙！我有预感，这个幽林雾道一定藏着宝藏，所以才会被人掩盖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820113,
					"content": "#{NICKNAME}，是时候开始寻宝之旅了！带上你最好的伙伴，拥有绝对敏锐宝藏嗅觉的派蒙出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820111,
					"content": "你在哪座书库看的书？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
