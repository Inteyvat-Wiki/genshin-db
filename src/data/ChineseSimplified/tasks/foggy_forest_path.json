			"dialogs": [
				{
					"id": 740820401,
					"content": "（大部分字迹被磨毁，仅能依稀辨识出——「…清露…三…」）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "神秘祭坛"
				},
				{
					"id": 740820402,
					"content": "可恶，这上面的字也被毁掉了，一定有秘密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820403,
					"content": "清露？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "「清露」是什么意思？清清的露水？可是这附近到处都是水啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820405,
					"content": "至于这个「三」字，该不会是指三滴水吧？真头痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820409,
					"content": "快问问你的绝对敏锐宝藏嗅觉啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "已经问过了！总之…总之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820411,
					"content": "总之它说跟「三」和「水」有关嘛，我们应该在附近找一找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820406,
					"content": "三？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "「三」是三个东西的意思吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820408,
					"content": "至于「清露」，难道是清清的露水？可是这附近到处都是水…真头痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "派蒙"
				}
			]
		},
