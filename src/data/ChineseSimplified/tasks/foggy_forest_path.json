					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820746,
					"content": "伊黎耶岛不好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "伊黎耶，美露莘，现在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820748,
					"content": "珀西芙，伊黎耶，保护…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820749,
					"content": "伊黎耶岛正在变得不好，然后，你要保护它？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820750,
					"content": "#派蒙，{NICKNAME}，伊黎耶，邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820751,
					"content": "#呃…这次有五个词，呃…你希望派蒙和{NICKNAME}给伊黎耶岛邦邦邦邦来两下子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820752,
					"content": "美露莘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820753,
					"content": "你希望我们帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820755,
					"content": "原来是帮忙呀，幸好幸好，如果要让我们给这座岛来两下子，那真的挺难办的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820756,
					"content": "邦邦，邦邦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820757,
					"content": "有报酬吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "报…酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820759,
					"content": "#哎呀，{NICKNAME}，你看珀西芙都不太会说话，肯定找不到其他人帮忙了，我们就帮帮她吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820760,
					"content": "那要怎么帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "钥匙，钥匙，钥匙，数量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820763,
					"content": "然后呢？钥匙的数量是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820764,
					"content": "钥匙！钥匙！钥匙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820765,
					"content": "三把钥匙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "珀西芙！钥匙，雾道，南…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820767,
					"content": "钥匙，泉眼，北…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820768,
					"content": "钥匙，垂柳，东…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820769,
					"content": "哦，原来是这个意思…那我先记一下…一共有三把钥匙，分别是南边的雾道，北边的泉眼，东边的垂柳…是这样吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820770,
					"content": "钥匙，钥匙，钥匙，广场，西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820771,
					"content": "西边的广场还有三把钥匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820772,
					"content": "集齐三把钥匙去广场？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#派蒙，美露莘！{NICKNAME}，珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820774,
					"content": "#哎呀，珀西芙，你不要老是说这种显得{NICKNAME}比我聪明的话嘛！明明我和{M#他}{F#她}差不多聪明才对！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820775,
					"content": "总而言之，现在我们已经得到一把钥匙了，看来只要再弄到另外两把就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820776,
					"content": "伊黎耶，美露莘…珀西芙，保护！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820777,
					"content": "你放心啦，虽然不知道发生了什么，但我们会帮你保护伊黎耶岛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820778,
					"content": "不过我再补充一小点哦，珀西芙，假如你碰巧看见一种没人要的，金灿灿的，圆滚滚的东西，或者一看就很贵的箱子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820779,
					"content": "能跟我们说一声就再好不过啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820780,
					"content": "珀西芙似懂非懂地摸了摸头，又高兴地蹦跳了两下，然后略显匆忙地离开了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#啊，她就直接跑掉了，看来是很紧急的事啊。{NICKNAME}，我们现在就去寻找另外两把钥匙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820761,
					"content": "那要怎么帮忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "说不定是别人存放在这里的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "什么？完蛋了，那我们不就成小偷了？对不起对不起…我们快把东西放回去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820712,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820713,
					"content": "完蛋了！主人回来了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820714,
					"content": "主人？美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "珀西芙"
				}
			]
