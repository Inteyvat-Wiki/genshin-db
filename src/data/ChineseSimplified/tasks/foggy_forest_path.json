					"nextDialogs": [
						740821028
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740821028,
					"content": "呃，我怎么感觉其实也没有很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821029
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740821029,
					"content": "珀西芙，那位来客，守护，邦邦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821030
					],
					"speakerTitle": "珀西芙"
				},
				{
