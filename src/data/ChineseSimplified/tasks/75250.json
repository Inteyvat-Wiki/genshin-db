			"dialogs": [
				{
					"id": 752500101,
					"content": "买到玩偶的游客们陆续离开了，这时，有几位不速之客来到了绵驮园——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "昨天来抢劫的愚人众？是你们！你们…你们还想干什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752500104,
					"content": "有我在，别担心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "不…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "为首的愚人众摆了摆手，递出了一张纸条。你摊开纸条，上面是歪歪扭扭的几句话——",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "原来昨天伸手的时候，其实是在付钱吗…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752500113,
					"content": "对、对不起…是我错怪你们了…实在对不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752500114,
					"content": "这些玩具请全部拿走吧！这是对你们的感谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752500115,
					"content": "为首的愚人众摇了摇头，只摆出了一个「三」的手势。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "我明白了…你们和纳塔的英雄一样，都是值得敬佩的战士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "阿罗哈"
				},
				{
					"id": 752500117,
					"content": "那我就准备一些色彩最适合你们的玩具吧，谢谢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿罗哈"
				}
			]
		},
