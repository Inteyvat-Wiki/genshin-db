			"dialogs": [
				{
					"id": 750530101,
					"content": "嗬，异邦人，眼神不错…怎么样，来试试，「目随羽视」的挑战？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530102,
					"content": "锻炼视力…也能，得到嘉奖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530103,
					"content": "哦哦，真是简洁的说明…也像是什么都没说…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750530104,
					"content": "详细的规则，还在后头…如果你们，想要试试看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530105,
					"content": "那就听听看吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "三只绒翼龙，会往外飞，盯住中间那只…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530107,
					"content": "等它们都飞回，<color=#00E1FFFF>认出…原本在中间的那只</color>，就是这样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530108,
					"content": "唔，也就是说，这三只会在空中变换位置，我们得找到原本在中间的那只？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750530109,
					"content": "很对。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530110,
					"content": "怪不得说这个挑战能够锻炼视力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750530111,
					"content": "先来点，简单的，试试水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530112,
					"content": "如果没问题，我们再，正式玩一把。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530113,
					"content": "挑战成功，奖励归你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530114,
					"content": "还有别的事，之后再来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "好，反正，我一直在这。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530116,
					"content": "那就试试吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "准备好，就击打，靶子，开始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				}
			]
		},
