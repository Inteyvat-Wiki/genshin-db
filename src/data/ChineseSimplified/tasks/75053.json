			"dialogs": [
				{
					"id": 750530301,
					"content": "已经没有奖赏，自然没有，「目随羽视」挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530302
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530302,
					"content": "难道有，其他的，问题？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530303,
						750530307,
						750530311
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530303,
					"content": "关于「目随羽视」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "那是，很久以前，部族，流传下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530305,
					"content": "因为「花羽会」，锐利的眼睛，很是重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530306,
					"content": "这一代，就由，我来主持，负责。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530307,
					"content": "为什么说话很慢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "以前，受过伤，从很高的地方…摔下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530309,
					"content": "喉咙，和胸口，让我不能…如以往一样，说话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530310,
					"content": "但我，不觉得…现在…很糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
				},
				{
					"id": 750530311,
					"content": "不，没什么问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "祝福你…再见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "穆蒲"
