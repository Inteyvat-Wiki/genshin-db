			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"罗莎莉亚",
					"凯亚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040202,
					"content": "怎么了，不合罗莎莉亚的口味吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040203,
					"content": "我可以重做一杯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "不，不是针对你。我只是很少喝茶，这种味道会让我想起一些事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040205,
					"content": "跟教会有关的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040206,
					"content": "嗯。有一次教会办活动，我没去，没想到芭芭拉给我留了一份茶和点心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040207,
					"content": "点心放得太久口感很差，她偷偷收走了。但那杯茶，差不多就是这个味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040208,
					"content": "罗莎莉亚现在的神态，可真是少见呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040209,
					"content": "看来蒙德要多一个红茶爱好者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040210,
					"content": "那还是酒好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040211,
					"content": "凯亚呢，对饮品满意吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "如果我挑几个瑕疵出来，你是不是会帮我重做一杯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040213,
					"content": "哈哈哈，开玩笑的，我怎么会做这种招你讨厌的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040214,
					"content": "唉，凯亚的思维总是这么跳跃！真亏罗莎莉亚能跟他一起喝酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040215,
					"content": "是吗？我根本不关心他的思维。喝酒，就只聊酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040216,
					"content": "何况，你也好，这里的老板也好…凯亚只会试探自己感兴趣的人或事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040217,
					"content": "喂！咱们好歹也是酒友吧，你怎么出卖我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040218,
					"content": "这就算出卖了？根本无所谓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040219,
					"content": "平时生活中「正经人」可太多了。还是酒馆里人人松散的气氛更适合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040220,
					"content": "哦？到批评正经人的时段了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040221,
					"content": "说起这个，我认识的某个人，应该能排进「蒙德正经人榜」前三吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040222,
					"content": "要说程度…哦，应该这么形容。他已经正经到被当面这样评价表情也完全不会变化的地步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040223,
					"content": "居然还有这种排名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040224,
					"content": "当然啦。我想想…还有连续喝酒天数排行、最长工作时间排行、厨房杀手排行、禁忌知识储备量排行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040225,
					"content": "蒙德人也太闲了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040226,
					"content": "不用上班的人，有那么多吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040227,
					"content": "不…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "#呜，就没有什么能让我和{M#他}{F#她}一起上榜的排行吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040230,
					"content": "有啊，比如「最佳酒保」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040231,
					"content": "真，真的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040232,
					"content": "#太好了，{NICKNAME}，我们也在这里一起留下我们的名字了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040233,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040234,
					"content": "哼，这种氛围倒是不错嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040235,
					"content": "#可不是嘛，光看着{M#他}{F#她}们就觉得开心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040236,
					"content": "极富感染力的氛围，嗯，会成为酒馆一大卖点的呢。看来「最佳酒保」称号给对人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040237,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040238,
					"content": "没什么，这次多谢两位款待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040239,
					"content": "嗯，我差不多也该回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040240,
					"content": "另外，红茶味道很好，之后我会试着自己泡泡看…如果早上起得来的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040241,
					"content": "那就再见喽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040242,
					"content": "下次见。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "我大概知道都在指谁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}