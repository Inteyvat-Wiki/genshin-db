				"points": []
			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "哟，今天的酒保居然是你，真是罕见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040102,
					"content": "那我就要一杯午后之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040103,
					"content": "一开口就为难别人，真有你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040104,
					"content": "#哎呀，只是想看{M#他}{F#她}如何应对嘛。倒是没想到罗莎莉亚小姐今天也来喝酒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040105,
					"content": "酒馆里刁钻的客人那么多，旅行者不早点积累起经验可不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040106,
					"content": "凯亚还是那么油嘴滑舌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705040107,
					"content": "冤枉啊，我是一片好意！你不是应该感谢我吗？比如说，给我来一杯简简单单的月夜暗巷什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040108,
					"content": "啊对，要大杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "凯亚"
				},
				{
					"id": 705040109,
					"content": "给我随便来一杯。有茶香的饮品都行，量不用太大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "罗莎莉亚"
				},
				{
					"id": 705040110,
					"content": "明白了，请稍等片刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "慢慢来。等待美味出品的时间，也是很令人兴奋的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凯亚"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
