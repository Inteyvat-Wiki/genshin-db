			"dialogs": [
				{
					"id": 750701401,
					"content": "可恶，我们又得重来一次了！呃…我是说，如果你们不介意的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750701402,
					"content": "唉…既然来都来了，没什么介意不介意啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750701403,
					"content": "我们继续吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "嗯，谢谢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750701405,
					"content": "请让我们休息一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "跳崖可是体力活，也该让人家休息一下啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750701407,
					"content": "唔…抱歉，是我欠考虑了。等你们准备好了直接开始就是，我一直在这里等着呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "马尼菲科"
				}
			]
		},
