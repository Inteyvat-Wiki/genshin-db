			"dialogs": [
				{
					"id": 750700901,
					"content": "哈哈，完美！副本给你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750700902,
					"content": "哇！果然好厉害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750700903,
					"content": "来，给你报酬，这是第二次…不，第三次受你们帮助了，我都怀疑如果没有你们帮忙，我这次摄影之旅还能不能走到最后！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750700904,
					"content": "我的下一个目的地是这里…在地图上给你们标好了。如果有兴趣的话，我时刻等着与你们再次合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750700905,
					"content": "啊…时间差不多了，我要走咯！也祝你们好运！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "马尼菲科"
				},
				{
					"id": 750700906,
					"content": "马尼菲科收拾好行李，欢快地跃上了热气球。\\n随着热气球慢慢远去，小小的马尼菲科哈哈大笑，留下了悠远的回声。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
