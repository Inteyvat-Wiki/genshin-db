					"瓦希德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "关于肥料的使用说明…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "对对，我还没有和你说明，这次带过去的肥料得以特别的方法施用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360203,
					"content": "我看看…按照手册上的说明，施用顺序应该是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360204,
					"content": "首先向肥料中加入<color=#37FFFF>清水</color>，然后再加入<color=#37FFFF>碎叶</color>，最后<color=#37FFFF>搅拌均匀</color>并施入田地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360205,
					"content": "千万不要记错了，否则不仅可能发生意外情况，更会影响顾客对我们的印象，以后的订单就悬了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360206,
					"content": "我记住了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "那这件事交给你了。你把「丰沃之惠」交到顾客手上之后，他的首付款就是你的酬劳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360208,
					"content": "你再说一遍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "首先向肥料中加入<color=#37FFFF>清水</color>，然后再加入<color=#37FFFF>碎叶</color>，最后<color=#37FFFF>搅拌均匀</color>并施入田地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360210,
					"content": "拜托你了，旅行者…我们都加把劲儿，这个月的业绩说不定还有希望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				}
			]
		},
