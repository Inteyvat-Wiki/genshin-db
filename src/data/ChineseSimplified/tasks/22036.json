			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦希德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "这生意真是难做，我卖的明明都是童叟无欺的好货啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360102,
					"content": "真是奇怪了，为什么没多少人来买呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360103,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "哦，是你啊，旅行者。唉…别提了，我这店里的肥料还是卖不出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360105,
					"content": "不是有爱拉尼帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "她…确实帮了点忙，但问题就是，我俩都不知道怎么推销，只会呆在店里等顾客上门…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360107,
					"content": "但离岛的情况你也知道，这里哪有什么顾客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360108,
					"content": "所以，我就去找商会的先生们请教了一下，他们建议我搞一下什么…「营销」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360109,
					"content": "具体就是，多和客人谈一谈肥料的具体效果和原理，有理有据地向大家多多宣传，还有什么「试用」服务…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360110,
					"content": "但是…我实在是不懂那些高深的东西，而且这肥料也不是我研究出来的，我怎么讲得出啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360111,
					"content": "不过，就算是拿着说明书念，我也必须要去周围跑一跑，宣传一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360112,
					"content": "爱拉尼已经出去宣传了，我等会也要出去。旅行者，能请你帮我分担一些宣传工作吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360113,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "那太好了！那就拜托你了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360115,
					"content": "你要去的那个地方就在「绀田村」，离这不远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360119,
					"content": "那里有一位绀田传助先生，对我们店里的肥料有些兴趣，之前他还来过店里和我聊了一会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360120,
					"content": "如果能带着一些货去他那里宣传，并且请他「试用」的话，说不定他会愿意来多买点肥料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360116,
					"content": "爱拉尼去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "她说要顺便取取材什么的，说是要走远一点。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220360118,
					"content": "你要去的那个地方就在「绀田村」，离这不远。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "瓦希德"
				}
			]
		},
		{
			"id": 2203602,
			"completionStepIds": [
				2203602,
				2203608
			],
			"beginWay": "TALK_BEGIN_NONE",
