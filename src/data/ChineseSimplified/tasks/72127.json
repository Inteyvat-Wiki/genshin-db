			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"叶名山薰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "谢谢您，这些甜甜花就够了，等会我就去做干花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270302,
					"content": "对了，我还有一个小礼物送给您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270303,
					"content": "喏，这朵干花请您拿好啦，虽然有点枯了…但这可是一朵很宝贵的花喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270304,
					"content": "谢谢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "这可是这片花海里长出来的第一朵花，是您帮我找到的花种，所以，我想把这朵花送给您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270308,
					"content": "虽然也不是什么很有价值的东西，但还是…非常谢谢您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270309,
					"content": "大家都会回来的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "嗯！所以我得再多种点花，这样大家回来的时候，就能看到更多的花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270305,
					"content": "有什么特别的地方吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "当然有特别的地方啦，不然我可不会特别把它送给您呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "叶名山薰"
				}
			]
		}
