			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"叶名山薰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "您来啦，您注意到周围了吧，已经有很多花开了，怎么样，漂亮吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270102,
					"content": "很漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "嘿嘿…那当然啦。我可是很用心在照顾它们呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270106,
					"content": "对了，能请您再帮我个忙吗？现在花开得这么好了，我本来想要去摘几朵花做成干花，和信一起寄给那些还没有回踏鞴砂的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270107,
					"content": "但是…不知道是不是我睡太少了，刚才出去采了几朵花就累得不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270108,
					"content": "能拜托您帮我去这周围摘几朵甜甜花来吗？只要三朵就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "那就拜托您了，我在这稍微休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270112,
					"content": "我只是想要甜甜花那种吸引人的香气，信件里也会附上其他干花的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270113,
					"content": "我想，读信的时候被甜甜花的香气环绕…读信人的心情说不定也会好一些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270114,
					"content": "那就拜托您了，我在这稍微休息一下…您摘到花之后，就请拿来给我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叶名山薰"
				},
				{
					"id": 721270111,
					"content": "甜甜花好像随处都可见…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "你种了多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "也没有太久啦，就是…就是稍微少睡了一会而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "叶名山薰"
				}
			]
		},
		{
