				"points": []
			},
			"dialogs": [
				{
					"id": 3061101,
					"content": "就是这里了，被废弃的<color=#00E1FFFF>四风守护庙宇</color>之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061102,
					"content": "这些庙宇已经荒废好多年了，蒙德的民众也根本不会来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061103,
					"content": "搞不好里面会有野兽筑巢，或者丘丘人建立营地呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061104,
					"content": "唉…毕竟连风魔龙自己，都放弃了自己的庙宇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061105,
					"content": "你说风魔龙…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "…是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061108,
					"content": "虽然我也很不愿意接受，但…风魔龙，曾经也是「四风守护」之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061109,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3061110,
					"content": "先不提这些了。你感受到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061111,
					"content": "这里面的「风」，有些不对劲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061112,
					"content": "#进去看看吧，{NICKNAME}。要小心，龙的力量正在影响这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061106,
					"content": "你说「自己的庙宇」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
		},
