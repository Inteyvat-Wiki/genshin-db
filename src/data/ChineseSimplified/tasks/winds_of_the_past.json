			},
			"dialogs": [
				{
					"id": 3061001,
					"content": "呼…真累人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061002,
					"content": "不过，这样就能为琴团长分担一些辛劳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061003,
					"content": "以前我们的防御力量，起码还能守住城里的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061004,
					"content": "简单来说主要是因为有琴在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061005,
					"content": "但现在风魔龙已经直接袭击了蒙德内部…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061006,
					"content": "「风向变了，我们的策略也会作出相应的变化。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061007,
					"content": "听起来很有哲理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "这是丽莎喜欢说的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061010,
					"content": "对了，之前我们聊到的「四风守护」话题——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061011,
					"content": "如果想知道过往的历史，也可以去问丽莎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061012,
					"content": "…先说明，不是因为我历史学得不好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061013,
					"content": "图书管理员的知识储备，总之…就是会比侦察骑士更完备一点吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3061008,
					"content": "你原创的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
		{
			"id": 30611,
			"completionStepIds": [
				30601
