				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "旅行者，您回来了，请问我的箱子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480302,
					"content": "就在这里。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "太好了！非常感谢您…唉，您拿着举荐信来来访，我却让您如此辛劳，真是太不好意思了…这些摩拉还请您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480305,
					"content": "你们不是说…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "咦？您连这句话也知道吗？我们普尔比鲁尼一门里确实有这种训诫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480307,
					"content": "但这句话只是用来劝诫我们，在任何时候都不能因为钱财或其他外部原因而动摇研究的原则。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480308,
					"content": "毕竟，如果一个研究者将逐利作为自己的首要学术原则，那么…他就不配做一个研究者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480309,
					"content": "但您为了帮助我辛苦奔波，理应获得一份数量合理的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480310,
					"content": "再次感谢您的帮助，如果您以后需要我的帮助，请尽管开口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480311,
					"content": "「金钱不能作为智慧的报酬」吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "已经拿回来了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
