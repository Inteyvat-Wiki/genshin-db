			"dialogs": [
				{
					"id": 733480101,
					"content": "但是…如果没有那些样本的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480102,
					"content": "关于普尔比鲁尼一门…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "是的。我是普尔比鲁尼一门现在的「诃般荼」，请问您找我有什么事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480105,
					"content": "是关于学术问题吗？但看您的装束，并不像是教令院里的学者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480106,
					"content": "关于海迪夫的举荐信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "这是海迪夫…海迪夫学弟的亲笔信？稍等，容我看一看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480108,
					"content": "嗯，看来他在层岩巨渊的研究推进得很顺利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480109,
					"content": "…菌类调查…水生环境…古代生物化石…特殊的地质环境…样本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480110,
					"content": "很好，很好，很好！他的学术嗅觉和考察能力还是如此优秀，果然没令我失望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480111,
					"content": "哼…虽然不是太愿意在外人面前承认，但普尔希娜门人的学术能力，还是值得信任的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480112,
					"content": "而且，海迪夫在信里也强调了很多次您对他的巨大帮助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480113,
					"content": "在您的帮助下，他的研究就如同「猛虎插上了翅膀一样顺利」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480114,
					"content": "不用再重复一遍了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "是这样吗？咳，是我失态了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480117,
					"content": "等他回到教令院，普尔希娜一门的学术史册上，一定又将添上光辉的一笔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480118,
					"content": "呃…还有，我们两个师门之间的千年友谊，也一定会大大增进的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480119,
					"content": "总而言之！我同时代表普尔比鲁尼和普尔希娜，再次感谢您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480120,
					"content": "对了，他在信里还拜托我为您准备一些礼物…这没有问题，请您稍等一会。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480121,
					"content": "您不会也给我一封信做报酬吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "那当然不会！您辛苦劳碌，帮助海迪夫四处考察，付您摩拉是再自然不过的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480123,
					"content": "但…请您原谅，我今天出门太过匆忙，没有带多少摩拉。如果您愿意的话，还请在这里稍等我一会…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480124,
					"content": "虽然都是很为各自门派自豪的学者…但他和海迪夫的样子完全不一样呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480125,
					"content": "看起来好像…真没有多少钱的样子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480126,
					"content": "怎，怎么会呢？我们普尔比鲁尼一门可是学者世家，绝不可能有财物上的困扰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480127,
					"content": "只不过，我们将大部分的财物都投入了研究之中，在研究之外…就会略显拮据。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480128,
					"content": "但这并不妨碍我们的研究，不如说，正因为我们没有被物欲遮蔽双眼，所以才能将智慧的道路看得更加清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480129,
					"content": "我这就回去为您准备报酬。但在这之前，我还有一个不情之请…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480130,
					"content": "我看海迪夫在信中写道，您的身手十分矫健，战斗经验也十分丰富，是一位出类拔萃的，万里挑一的精锐冒险家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480131,
					"content": "如果！如果您愿意的话，能帮我一个忙吗？在不久之前，为了调查一处地区的地质环境，我一个人进入沙漠考察…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480132,
					"content": "因为…我没多少钱，所以没有雇佣护卫。我想着，如果快去快回，应该也不会有什么风险…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480133,
					"content": "但我运气实在不好，考察结束后，在回去的路上被盗宝团袭击了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480134,
					"content": "虽然我安全逃回了城里，也没有受伤，但装着所有地质样本和笔记的箱子却丢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480135,
					"content": "在商人和盗宝团的眼里，那个箱子也许根本就不值钱…但在我眼里！这箱子里的东西价值连城，无可替代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480136,
					"content": "我一时半会找不到愿意帮忙的冒险家…旅行者，能请您帮帮我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480137,
					"content": "我会帮忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "太感谢了！没有您，我都不知道如何是好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480140,
					"content": "我这就把被袭击的地点标在地图上，那个箱子一定就在那附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赛达菲"
				},
				{
					"id": 733480138,
					"content": "包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "我已经听他说过了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "请问您是普尔比鲁尼的学者吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
		{
			"id": 7334802,
