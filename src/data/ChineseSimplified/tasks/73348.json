			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "欸，你怎么回来了，找到普尔比鲁尼一门的人了吗？应该没费多大劲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480402,
					"content": "找是找到了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "嗯？你怎么一副欲言又止的样子，你不会被人给为难了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480405,
					"content": "向海迪夫讲述了和赛达菲有关的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "赛达菲学长啊…他可是出了名的死心眼，有时候连老师都对付不来他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480407,
					"content": "而且还拒绝所有资助，坚持自己研究，说要保持自己研究的纯洁性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480408,
					"content": "这就是「金钱不能作为智慧的报酬」吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480409,
					"content": "这是他们普尔比鲁尼一门学者的研究原则…哈哈，我们普尔希娜一门没有这么迂腐就是啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480410,
					"content": "唔…也不能这么说，只是我比较有钱而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480411,
					"content": "你是怎么赚钱的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "你怎么这么一副怀疑的样子？我的这些钱也是我辛苦打拼出来的啊，你知道做期货交易有多麻烦吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480414,
					"content": "期、期货交易？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "做期货交易…又要关注货物交易量，又要关注市场动向，还要权衡投资的方向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480417,
					"content": "我最开始只是投一点钱玩玩，不想影响我的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480418,
					"content": "但谁知道…唉！谁知道我越赚越多，放在交易所里的钱也越来越多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480419,
					"content": "我的本职是学者啊！我想要做研究，我想要做学术！我想要的是学术成果，不是摩拉成果！我一直这么告诫自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480420,
					"content": "但只要待在须弥城里，我就不由自主地走进交易所，一笔又一笔地做期货交易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480421,
					"content": "我账上的钱是越来越多，但我的学术研究一点进展都没有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480422,
					"content": "所以！我才请了这么多人，一起进入层岩巨渊里考察。只有待在这个没有交易所的地方，我才能安心开展学术研究！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480423,
					"content": "如果研究不出成果，我…我就不从层岩巨渊里出去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 733480415,
					"content": "你用期货交易来赚钱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "那你为什么这么有钱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "发生了一些事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
