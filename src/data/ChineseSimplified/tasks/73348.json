			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"达拉"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1856.942,
							155.632,
							5478.944
						],
						"pointId": 330700023
					},
					{
						"sceneId": 3,
						"position": [
							-1855.365,
							155.684,
							5479.971
						],
						"pointId": 330700024
					},
					{
						"sceneId": 3,
						"position": [
							-1855.176,
							155.344,
							5478.426
						],
						"pointId": 330700025
					}
				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "等一下！等一下！停手！别打了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "达拉"
				},
				{
					"id": 733480202,
					"content": "呼…呼…就一箱子书，没必要下这么狠的手，你要的话，全都给你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "达拉"
				},
				{
					"id": 733480203,
					"content": "就只有这些？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "我对天发誓！我们在这里就只挖到了这一个箱子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "达拉"
				},
				{
					"id": 733480206,
					"content": "除了书之外，里面还有一些石头和装在瓶子里的泥巴…石头里面嘛，倒是有些好看的宝石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "达拉"
				},
				{
					"id": 733480207,
					"content": "你们把这些宝石拿走了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "喂！把那些宝石全部还回来！那都是珍贵的地质样本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480209,
					"content": "地质…样本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "达拉"
				},
				{
					"id": 733480210,
					"content": "还回来。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "还！还！全都还！快快快，把东西都放进箱子里…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "达拉"
				},
				{
					"id": 733480213,
					"content": "东西…东西都放在箱子里了，兄弟们就先走了…哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "达拉"
				},
				{
					"id": 733480214,
					"content": "赛达菲想找的东西应该都在里面啦，我们把箱子拿回去给他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480215,
					"content": "但他居然一个人进了沙漠，还挖了这么多地质样本，记了这么多笔记，真是一位了不起的学者啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733480211,
					"content": "我数到三。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "还有其他的吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
