					"content": "还没有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "没关系，「遗迹猎者」这种敌人，确实需要谨慎准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
