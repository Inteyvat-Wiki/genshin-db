			"dialogs": [
				{
					"id": 221100301,
					"content": "怎么样？消灭掉了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100302,
					"content": "已经消灭掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "连遗迹猎者都不在话下…无论从哪个角度来看，你的实力都已经够强了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100304,
					"content": "…还是没找到和「剑」有关的东西？呼…意料之中，这个词我都要说厌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100305,
					"content": "没关系，辛苦你了，完成了我这么多不知所谓的委托。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100306,
					"content": "「藏锋」，你究竟藏在哪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100307,
					"content": "一定会找到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "…你是在安慰我吗？这么一点小事，连挫折都算不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100310,
					"content": "无论找到什么时候，什么地方…我也会把那柄剑找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100311,
					"content": "我会继续扩大搜索范围，以后说不定还会找你帮忙，放心，我也会付给你相应的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100316,
					"content": "好了，这是你的报酬，拿好。我要去筛选下一批委托了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100317,
					"content": "…「藏锋」，我一定会找到你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100308,
					"content": "这些委托，听着和「剑」都没关系。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "那是因为，所有和「剑」有关的委托，我都已经接了个遍…但始终一无所获。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100313,
					"content": "然后，我认为…能逼得大哥丢掉武器的，只能是极其危险的情况。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100314,
					"content": "所以我开始接受其他的委托，在那些足够危险的地方，寻找那把「藏锋」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "岚姐"
				},
				{
					"id": 221100315,
					"content": "不过，足够危险的委托数量稍微有点多，我一个人已经忙不过来了，所以我才会请你来帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "岚姐"
				}
			]
		}
	]
