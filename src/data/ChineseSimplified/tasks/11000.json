			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "小声点，我正在打猎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000302,
					"content": "早就听说蒙德有很多好食材，现在一看果然名不虚传！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000303,
					"content": "你是猎人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "不不不，我是个厨师，立志走遍各地，搜寻珍奇食材的厨师！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000306,
					"content": "我叫香菱，从璃月港来，你们呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000307,
					"content": "#我叫{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "你好啊，我是派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000309,
					"content": "派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000310,
					"content": "怎么了？为什么突然盯着我看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000311,
					"content": "好奇妙的生物，这个可以吃吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000312,
					"content": "她是我的好朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "可惜了，朋友那就是不能吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000316,
					"content": "你们的关系真好，其实我也有这样的好朋友，叫作锅巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000317,
					"content": "名字怎么还是吃的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000318,
					"content": "哈哈，因为很可爱啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000319,
					"content": "对了对了，你们可以帮我狩猎吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000320,
					"content": "这里有好多猎物，全都是绝佳的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000321,
					"content": "我一个人实在是抓不过来，放走了又太可惜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000322,
					"content": "听起来好麻烦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000323,
					"content": "别这么说嘛，等下送给你们好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000324,
					"content": "#好、好吃的？一言为定，{NICKNAME}可擅长这个了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000325,
					"content": "一点立场都没有啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "嘿嘿，别在意别在意，你的朋友都已经答应了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000328,
					"content": "不管用什么方法，只要能带回来兽肉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000329,
					"content": "那就交给你们了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000326,
					"content": "别无视我的意见啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "当然可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "不可以！派蒙不是吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000304,
					"content": "你是冒险家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
		{
			"id": 1100004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
