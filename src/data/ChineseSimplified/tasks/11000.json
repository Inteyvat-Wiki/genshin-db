			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "这里的野猪太肥美了，还很有活力，肉质一定是极棒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000402,
					"content": "啊，说着说着肚子就饿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "哇，有这么多，一部分用来煎，一部分配上蘑菇炒，还有些和史莱姆凝液试试看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000502,
					"content": "她瞬间就入迷了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "我们很自然地被忽略了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000506,
					"content": "啊啊，不好意思不好意思，一不小心就去想菜谱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000507,
					"content": "这个是答应送你们的好吃的。现在就尝尝看吧！把感想告诉我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000508,
					"content": "我们是被当成试菜员了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000509,
					"content": "哦哦！这、这个…太好吃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000510,
					"content": "可以告诉我们是怎么做的吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000511,
					"content": "嘿嘿，当然可以了！只不过我还没有写成菜谱，我想想看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000512,
					"content": "要不然这样吧！我现在再做一次，你们就照着学！看一遍肯定就明白了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000513,
					"content": "这么复杂的菜看一次也记不住啦…而且锅和调味料都没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110000514,
					"content": "哎呀，这还不简单。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000515,
					"content": "锅用岩板，油用刚刚猎到的野猪的油，搬石头堆成灶，木头和茅草生旺火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000516,
					"content": "糖用甜甜花，至于盐，我之前在一个洞穴里找到了很多崖盐，够用好几天的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000517,
					"content": "这、这也太轻车熟路了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "嘿嘿，我总按捺不住尝试新菜的心情。但又不能每次出门都带好锅碗瓢盆什么的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000520,
					"content": "稍等下，我现在就去准备。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000521,
					"content": "喂！你们在这里干什么啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 110000601,
					"content": "这里是野猪们的栖息地，是不可以打猎的！把它们都吓跑了怎么办？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 110000602,
					"content": "我们猎人不做杀鸡取卵的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 110000603,
					"content": "啊！我懂我懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000604,
					"content": "只有最合适的环境才能诞生这么鲜美的肉质！如果被吓跑的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000605,
					"content": "不行不行，那绝对是美食界…不对，是全人类的一大损失！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000606,
					"content": "真是有个性的理解方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "对不起，没想到会造成这么大的影响！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000609,
					"content": "唉，你们去和杜拉夫先生道个歉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 110000610,
					"content": "他是我们这些猎人的领头人，他很看重狩猎的规矩，现在特别生气。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "艾伦"
				},
				{
					"id": 110000611,
					"content": "现在该怎么办？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "我觉得应该去和他道歉的，毕竟做错了事嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000614,
					"content": "让我们陪你一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
