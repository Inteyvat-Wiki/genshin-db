			"dialogs": [
				{
					"id": 200060101,
					"content": "餐品外送订单",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060102,
					"content": "欢迎光临猎鹿人…旅行者？你来得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060103,
					"content": "抱歉啦，我知道你饿着肚子，但是能请你帮我个忙吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060104,
					"content": "清泉镇里的欧琳小姐订了一份<color=#00E1FFFF>蜜酱胡萝卜煎肉</color>，但是我听说，清泉镇最近总是有史莱姆出来捣乱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060105,
					"content": "我自己不敢过去…能请你帮我把餐品送给<color=#00E1FFFF>清泉镇的欧琳</color>吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060106,
					"content": "好吧，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "等你回来的时候，会有一顿大餐做回报的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060109,
					"content": "拜托了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060107,
					"content": "太饿了，我只是来吃饭的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
