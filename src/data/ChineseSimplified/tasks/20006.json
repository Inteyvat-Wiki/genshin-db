						200060402
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060402,
					"content": "你回来了，餐品送到了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060403,
					"content": "这是餐费。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "我看看…没错，太感谢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060405,
					"content": "还有，这份<color=#00E1FFFF>美味的蟹黄火腿焗时蔬</color>给你，刚刚做好的，赶紧趁热吃了吧。",
