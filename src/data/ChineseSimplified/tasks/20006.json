			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "谢谢你，这些史莱姆真讨厌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "活跃的欧琳"
				},
				{
					"id": 200060202,
					"content": "要不是我饿到没力气了，这些家伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "活跃的欧琳"
				},
				{
					"id": 200060203,
					"content": "这是你订的餐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "唔——是胡萝卜和肉的香气…要是能早点吃到，那些史莱姆早就被我打飞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "活跃的欧琳"
				},
				{
					"id": 200060205,
					"content": "算了不管了，这是餐费，带回去给莎拉小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "活跃的欧琳"
				}
			]
		},
