			},
			"dialogs": [
				{
					"id": 220290201,
					"content": "您刚才是留手了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290202,
					"content": "不用顾忌我的面子，阁下，请使出全力吧，我…必须要变强才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				}
			]
		},
		{
			"id": 2202903,
			"completionStepIds": [
				2202903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
