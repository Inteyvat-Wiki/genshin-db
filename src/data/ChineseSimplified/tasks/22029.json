				"objectNames": [
					"朝仓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "呼…呼…阁下的武艺，果然高强…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290302,
					"content": "在下…在下领教了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290303,
					"content": "你、你没事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "没…没事，只是需要调整一下气息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290306,
					"content": "但您强大到这种程度，就算是您说您打倒过巨龙我也信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290307,
					"content": "其实我真的打倒过巨龙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "哈哈哈…在下当然是相信的。谢谢您和我对练，这场比试，在下铭记在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290309,
					"content": "如果阁下愿意的话，请以后常来和我对练，有您这样的强者磨砺…我一定能完成那件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290310,
					"content": "那件事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "咳…只是我的一点小心愿而已，这次谢谢您了，这些报酬请收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290312,
					"content": "我还要回去休息一下，您…您的那些招数，力道可真是太足了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝仓"
				},
				{
					"id": 220290304,
					"content": "抱歉、刚才没收住手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
