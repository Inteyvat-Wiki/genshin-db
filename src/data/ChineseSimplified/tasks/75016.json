			"dialogs": [
				{
					"id": 750160301,
					"content": "打扰一下，两位…应该是从异邦而来的旅人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160302
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160302,
					"content": "哈…抱歉，你们身边的这只小嵴锋龙，难道是你们的伙伴吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160303
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160303,
					"content": "尾巴上还绑着条漂亮的丝巾，真是个精神的小家伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160304
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160304,
					"content": "#是啊，我们刚进纳塔就遇见了，它是{REALNAME[ID(2)|SHOWHOST(true)]}，最近都和我们一起旅行呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160305,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160306,
					"content": "在一起旅行吗。不过，恕我僭越，这可是相当危险的行为啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160307,
						750160308
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160307,
					"content": "人和龙一起旅行很危险？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160310
					]
				},
				{
					"id": 750160308,
					"content": "谢谢，我有小心不被吃掉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160309
					]
				},
				{
					"id": 750160309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}才不会吃你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160310,
					"content": "在纳塔，人和龙一起生活不是很正常的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160311,
					"content": "#难道是旅行这件事很危险，{REALNAME[ID(2)|SHOWHOST(true)]}不能进行长途跋涉吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160312,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160313
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160313,
					"content": "#这倒不是…多走走对任何龙和人都有好处，恕我直言，只是你们的小嵴锋龙，{REALNAME[ID(2)|SHOWHOST(true)]}不太一样。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160314
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160314,
					"content": "抱歉，自顾自地说了那么多还没做自我介绍。我的名字是曼科，是龙遗物研究协会的研究员，负责考察一些部族风俗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160315
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160315,
					"content": "说白了，也就是探究部族过去习俗的研究者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160316
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160316,
					"content": "小嵴锋龙的名字我倒是已经知道了，两位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160317
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160317,
					"content": "#我是派蒙！{M#他}{F#她}的名字是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160318,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160319
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160319,
					"content": "#真是有活力，看来派蒙和{NICKNAME}把你照顾得很好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160320
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160320,
					"content": "嗯…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160321,
					"content": "#那是当然啦！我们一起吃了好多好吃的呢，对吧，{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160322,
					"content": "#啊，{REALNAME[ID(2)|SHOWHOST(true)]}，不许乱跑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160323,
					"content": "真是可惜啊，明明是这么有活力的小嵴锋龙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160324,
						750160325
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160324,
					"content": "所以到底有什么危险的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160326
					]
				},
				{
					"id": 750160325,
					"content": "别用这种语气说它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160326
					]
				},
				{
					"id": 750160326,
					"content": "抱歉，恕我不善言辞…不过我也是真心感到遗憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160327
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160327,
					"content": "#我就开门见山地说了，你应该已经见过不少小嵴锋龙了吧，可{REALNAME[ID(2)|SHOWHOST(true)]}与它们都不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160328,
						750160330
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160328,
					"content": "尾巴上的漂亮丝带！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160329
					]
				},
				{
					"id": 750160330,
					"content": "角上的红色印记？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160331
					]
				},
				{
					"id": 750160227,
					"content": "#我就开门见山地说了，你应该已经见过不少小嵴锋龙了吧，可{REALNAME[ID(2)|SHOWHOST(true)]}与它们都不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160228,
						750160230
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160329,
					"content": "哈哈，那应该是出自你的手笔吧，我要说的当然不是那个，而是它角上的印记。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160331
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160331,
					"content": "那不是一般的小龙能够拥有的印记，实际上，这在记载之中被称为「焰{RUBY#[D]修库特尔}主之祝」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160332
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160332,
					"content": "怎么说呢，拥有这个印记的幼龙往往具备不可思议的力量，比如力气比别的龙大，有些能游得更快，或者跳得更高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160333
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160333,
					"content": "听上去还挺不错的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160334
					]
				},
				{
					"id": 750160334,
					"content": "但是之前就说了，那是「焰主」之祝，不是它们自己的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160335
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160335,
					"content": "那是来自更远古的龙众的力量，而现在纳塔龙的身躯已无法承担那样的伟力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160336
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160336,
					"content": "而「大灵」和夜神之国也都排斥这样的力量，不愿意接纳它们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160337
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160337,
					"content": "所以在成长的过程中，它们或者会因为这力量死去，或者会因此变得失去理智，这两者都很危险。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160338
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160338,
					"content": "或许你应该把它交给回声之子，他们会妥善处置它的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160339,
						750160340
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160339,
					"content": "处置？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160341
					]
				},
				{
					"id": 750160340,
					"content": "句子里有个很冰冷的词。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160341
					]
				},
				{
					"id": 750160341,
					"content": "恕我嘴拙…但交给当地人是个比较好的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160342
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160342,
					"content": "…谢谢你告诉我这些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160343
					]
				},
				{
					"id": 750160343,
					"content": "但是你仍然不打算放弃它，对吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160344,
						750160345
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160344,
					"content": "放弃永远不是第一项的选择…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160346
					]
				},
				{
					"id": 750160345,
					"content": "我不会放弃自己的伙伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160346
					]
				},
				{
					"id": 750160346,
					"content": "…唉，好吧。好吧，旅人，我已经见到你的决心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160347
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160347,
					"content": "我不知道是否应该告诉你，毕竟这也是纳塔「本地人」才知道的秘辛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160348
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160348,
					"content": "#如果你要尝试拯救{REALNAME[ID(2)|SHOWHOST(true)]}，你必须带着它踏上前往火山的朝圣路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160349
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160349,
					"content": "传说中，部族的勇士会带着被一分为二的信物，在大火山之中洗去了自己的伙伴被死去{RUBY#[D]修库特尔}之龙惦记的姓名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160350
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160350,
					"content": "然后在那里，让自己的龙重新被夜神之国接纳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160351
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160351,
					"content": "你为什么要告诉我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160352
					]
				},
				{
					"id": 750160352,
					"content": "因为现在六大部族的人已经不会、也无暇去做这样的尝试了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160353
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160353,
					"content": "但你不一样，你是异邦的旅人，不被部族陈旧的观念所束缚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160354
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160354,
					"content": "而如果你能成功，你会证明一些古物的铭刻和险些化为尘土的织卷里描述的东西直到今日仍然确凿无疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160355
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160355,
					"content": "这对我很重要…如果你想进行尝试，我就为你找到那信物所在之处。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160356
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160356,
					"content": "你也可以，救你的伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160357,
						750160358
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160357,
					"content": "听上去是个双赢的局面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160359
					]
				},
				{
					"id": 750160358,
					"content": "值得一试…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160359
					]
				},
				{
					"id": 750160359,
					"content": "那么…如果我找到了说好的地方，我会联系你们的。或者你们也可以来找我，我最近会在回声之子那边进行考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160360
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160360,
					"content": "再会了，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160361
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160361,
					"content": "于是，名为曼科的龙遗物研究协会会员转身离去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750160362
					]
				},
				{
					"id": 750160362,
					"content": "#真是的，{REALNAME[ID(2)|SHOWHOST(true)]}，下次可不许乱跑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160363,
					"content": "呜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160364
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160364,
					"content": "#啊，对了，{NICKNAME}，刚才那个部族的人走了吗？他没说什么奇怪的话吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160365
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160365,
					"content": "事情是这样…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160366
					]
				},
				{
					"id": 750160366,
					"content": "#唔…也就是说，其实{REALNAME[ID(2)|SHOWHOST(true)]}现在生了病，我们得带着需要带的东西去火山，帮{REALNAME[ID(2)|SHOWHOST(true)]}治病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160367
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160367,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160368
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160368,
					"content": "#唉，{REALNAME[ID(2)|SHOWHOST(true)]}倒是一副没有听懂的样子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160369
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160369,
					"content": "不过没关系，说不定在它长大之前，我们就「刷刷刷」地把所有问题都解决了，就能让它正常健康地长大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160370
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160370,
					"content": "#真不知道那个人靠不靠谱…反正就是找什么信物，{NICKNAME}我们也到各种地方找找看吧，说不定我们比他更早找到呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160371
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160371,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160372
					]
				},
				{
					"id": 750160372,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160373
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160373,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也一起吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160374
					]
				},
				{
					"id": 750160374,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		}
	]
}