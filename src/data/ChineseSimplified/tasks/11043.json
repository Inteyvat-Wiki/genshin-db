				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430101,
					"content": "不会是要我们从这么高的地方跳下去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430102,
					"content": "不一定，如果你们有更好的办法的话。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430103,
						110430104
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430103,
					"content": "必须得有吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				},
				{
					"id": 110430105,
					"content": "无论用什么办法，只要能够抵达下面的湖的对岸，就算完成了实验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430106
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430106,
					"content": "根据你完成的时间，以及达到的最快速度，我会进行分析与比较的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430107
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430107,
					"content": "#在湖的对岸，也就是说，想让{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}在雪山游泳？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430108,
					"content": "当不限制条件的时候，人就会本能地去选择自己认为最合理的方式完成目标。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430109
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430109,
					"content": "可能有人觉得冰雪中的湖水难以忍受，但可能另外的人就喜欢这种冰冷刺骨的方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430110
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430110,
					"content": "无论你们做出了什么选择，都是实验的一部分，对我来说，都具有十足的研究价值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430111,
						110430112
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430111,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430113,
					"content": "拜托你了，非常期待你交出的答卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430112,
					"content": "比起超能力这要轻松多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430104,
					"content": "这种模棱两可的回答最让人紧张。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				}
			]
		},
		{
			"id": 1104303,
			"completionStepIds": [
				1104303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104303",
