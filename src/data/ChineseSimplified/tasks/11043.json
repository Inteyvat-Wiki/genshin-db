				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿贝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "辛苦你了，你的表现令我刮目相看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430302,
					"content": "不愧是传闻中的旅行者，各项数据都已经远超蒙德的平均水平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430303,
					"content": "可是看你一直跟着我们，好像也没有气喘吁吁嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430304,
					"content": "我吗？其实我用炼金术偷了一些懒，不过这些都不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430305,
					"content": "如果提瓦特的法则没有影响你，那我可以获得几种对异世界文明的猜想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430306,
					"content": "如果提瓦特的法则影响了你，那我也可以推测在没有影响的状况下，会发生怎样的演化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430307,
					"content": "其中蕴含的无数可能性，实在太有趣了，值得反复品味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430308,
					"content": "但是…这对你的研究又有什么帮助呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430309,
					"content": "困扰我多时的问题已经解开，等回到营地之后，我应该能为你们呈现一些独特的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430310,
					"content": "你有像这样研究过其他东西吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "那你可能马上要被和很多奇奇怪怪的东西一起类比了，你可能会不乐意吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430312,
					"content": "黄金，石化古树，八倍大的太阳——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430313,
					"content": "探究本质的过程令人着迷。可惜，这种着迷的时光，注定只是须臾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430314,
					"content": "我宁愿将我一切的精力都倾注其中，然而样本终究是有限的，当未知逐渐变为已知，那种趣味也就会逐渐消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430315,
					"content": "最终它们都会变为日落果，甜甜花这样平淡无奇的存在，不再值得花时间去关注了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430316,
					"content": "哦，所以你画的那副丘丘人的画，不同的丘丘人之间才会有那么明显的区分啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430317,
					"content": "对，当时我也说了，「很无聊，不值得浪费时间」。因为对我来说，它们的趣味早就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430318,
					"content": "那在实验之后，我们在你的眼里也会变成这样吗？变成…呃，草稿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110430319,
					"content": "这个不必担心，你们是我的协助者，这份情谊我是不会忘记的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430320,
					"content": "好了，在返回营地之前，让我们进行最后一项，也就是智能方面的实验吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "阿贝多"
				},
				{
					"id": 110430321,
					"content": "跟我来，现在我们去另一侧的遗迹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿贝多"
				}
			]
		},
