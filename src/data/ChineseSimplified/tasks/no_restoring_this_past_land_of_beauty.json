						710220212
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220212,
					"content": "当然，这也算是协会的正式工作。完成以后也会有对应的酬劳，怎么样，你意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220213
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220213,
					"content": "怎么？看你的表情…是发生了什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220214
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220214,
					"content": "之前就去过那里了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220215
					]
				},
				{
					"id": 710220215,
					"content": "原来已经去过了吗？不愧是优秀的冒险家，对异常情况的嗅觉非常敏锐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220216
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220216,
					"content": "关于天遒谷与古岩龙蜥的情况…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220217
					]
				},
				{
					"id": 710220217,
					"content": "…巨大的遗迹空洞、以及洞窟中的古岩龙蜥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220218
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220218,
					"content": "大体上了解了。感谢你带来的消息，我整理成书面文档后，会再向协会做正式报告的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220219
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220219,
					"content": "那边是怎么一回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220220
					]
				},
				{
					"id": 710220220,
					"content": "嗯…根据一些典籍上的记载，天遒谷那边的遗迹，在遥远的过去曾经是繁荣的集镇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220221
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220221,
					"content": "之所以变成了现在的样子，似乎是和某位古老龙王的动乱有关…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220222
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220222,
					"content": "虽然那场动乱没什么详细的记载，但据传说，最后是由帝君与仙家一起将它囚禁在了洞天的樊笼中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220223
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220223,
					"content": "而它的眷属则遁逃至了地下，陷入深眠，等待着那位古老龙王复苏的那一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220224
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220224,
					"content": "那些出现的魔物，难道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220225
					]
				},
				{
					"id": 710220225,
					"content": "哈哈哈，民话中流传的东西，谁又知道几分真几分假呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220226
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220226,
					"content": "不过不管怎么说，频繁的地震，还有那些突然出现的魔物，都必须要快点制订好对策才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220227
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220227,
					"content": "对了，还请你收下这些报酬，谢谢你带来的这些消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "治平"
				}
			]
		},
