				"points": []
			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "这次是发生在天遒谷吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#是{NICKNAME}啊，幸会，没想到今天能在这见到你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220104,
					"content": "唔…说起来，你最近去过天遒谷、南天门一带吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220107,
					"content": "最近协会里不断接到南天门到天遒谷那一带的地震报告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220108,
					"content": "最开始只是轻微的晃动，但最近似乎越来越严重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220109,
					"content": "不久之前，协会里又接到报告，在一次格外强烈的地震后，部分的山体与遗迹发生了坍塌，露出了一片巨大的洞窟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220110,
					"content": "报告中还描述说，在那边见到了某种未知的魔物。根据描述，可能是过去曾经作乱的「岩龙蜥」和「古岩龙蜥」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220111,
					"content": "需要我做什么吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "唔，我想拜托你去天遒谷的那个大空洞去搜索一下，看看地震对周围环境造成的影响。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220113,
					"content": "还有那些魔物的情况，如果真的大规模出现了，肯定也不能放着不管，必须快点制订对策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220114,
					"content": "当然，这也算是协会的正式工作。完成以后也会有对应的酬劳，怎么样，你意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220115,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "那就拜托你了，去那里搜索的时候，请千万注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "治平"
				}
			]
		},
