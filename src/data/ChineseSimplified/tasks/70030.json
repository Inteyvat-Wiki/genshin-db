	"talks": [
		{
			"id": 7003001,
			"completionStepIds": [
				7003002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003002",
							"2"
						],
						"stepId": 7003002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"重佐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300101,
					"content": "哟！旅行者，好久不见，别来无恙啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300102
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300102,
					"content": "我们见过吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300103
					]
				},
				{
					"id": 700300103,
					"content": "啊…你…居然就这样把我忘了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300104
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300104,
					"content": "我是「死兆星」号的大副重佐啊，你之前还搭我们「死兆星」号去的稻妻呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300105
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300105,
					"content": "#没有没有，重佐大副，我们当然记得你啦，{NICKNAME}又在开玩笑了，哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300106,
					"content": "欸——我说呢！这才对嘛，毕竟我堂堂「死兆星」号的大副…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300107
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300107,
					"content": "咳咳，有什么要帮忙吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300108
					]
				},
				{
					"id": 700300108,
					"content": "啊，其实不是我，是那位暂留在我们船队的万叶小兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300109
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300109,
					"content": "你应该有印象的吧？从稻妻返航的时候，他也跟着回来了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300110
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300110,
					"content": "不知道怎么了，这一路上感觉他心情很不错，有事没事就拉着大家吟诗作歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300111
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300111,
					"content": "可惜我们船上，上到北斗大姐头、下到小月小丫头，哪找得出半个有这种…有这种…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300112,
						700300114
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300112,
					"content": "雅兴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300113
					]
				},
				{
					"id": 700300113,
					"content": "对！雅兴！哪找得出半个有这种雅兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300116,
					"content": "所以啊，刚到璃月，他就下船游山玩水去了，看来真是被我们这帮大老粗憋坏啰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300117
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300117,
					"content": "可他才走没多久，就传来讯息，拜托我们留意一下你的行踪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300118
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300118,
					"content": "他遇到麻烦了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300119
					]
				},
				{
					"id": 700300119,
					"content": "具体什么情况倒没提，只说要是见到了你，就请你前去一叙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300120
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300120,
					"content": "听口气没那么要紧，但如果是小事，我想也用不着旅行者你出马吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300121
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300121,
					"content": "#其实我们也经常处理小事的，是吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300122,
						700300123,
						700300124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300122,
					"content": "嗯，经常喂鸽子什么的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300125,
					"content": "噢——真没想到，你还会帮大家做这些不起眼的活啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300126
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300126,
					"content": "怪不得大姐头那么欣赏你，看来你身上有着她所谓的「烟火气」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300127
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300127,
					"content": "哎呀！闲话扯太多了，还是请你快去万叶小兄弟那里看看吧，他最近应该在璃月港北边那一带活动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300128
					],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300128,
					"content": "我还要去忙船队的事，就不送你们了，路上多小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "重佐"
				},
				{
					"id": 700300123,
					"content": "嗯，经常替餐馆送餐什么的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300124,
					"content": "嗯，经常打扫卫生什么的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300114,
					"content": "怪癖！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300115
					]
				},
				{
					"id": 700300115,
					"content": "不不，应该叫雅兴！哪找得出半个有这种雅兴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "重佐"
				}
			]
		},
		{
			"id": 7003002,
			"completionStepIds": [
				7003004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003004",
							"2"
						],
						"stepId": 7003004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300201,
					"content": "琴音嘒嘒，琴枕槁槁，独弦系世，独木终老…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300202
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300202,
					"content": "哟！万叶小兄弟！你在这里呀？我们来帮忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300203,
					"content": "哦？你们来了，好久不见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300204
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300204,
					"content": "「万叶小兄弟」这个称呼，从派蒙嘴里说出来，倒确实别有一番风味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300205
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300205,
					"content": "嘿嘿嘿，我和重佐大副学的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300206,
						700300207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300206,
					"content": "你挺悠闲嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				},
				{
					"id": 700300208,
					"content": "哈哈，难道在你眼中，我是那种肩挑恶命、步履深沉之人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300209
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300209,
					"content": "是重佐大副说你有事找我们啦，谁知道你这么悠哉，还在这看风景，还吟诗哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300210,
					"content": "稻妻事了，我已经心无他念。再访璃月，自然该广习此间诗赋，遍闻悬月妙音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300211
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300211,
					"content": "至于请你们帮忙一事，原先是没有的，但可惜你们来迟了一步，所以现在有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300212
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300212,
					"content": "欸？好晕，「原先是没有的…所以现在又有了…」，什么嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300213,
					"content": "你这家伙，是不是在山里吃了坏东西，怎么连话都说不明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300214,
					"content": "嘘——二位请听。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300215
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300215,
					"content": "二位有什么感觉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300216
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300216,
					"content": "呜哇，这琴声…要我说的话，好像跟卖唱的弹的差不多嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300217,
					"content": "哦，卖唱的？希望有日能结识一番。旅行者，你觉得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300218,
						700300219
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300218,
					"content": "这琴坏了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300220,
					"content": "不错，确实如此，不过更关键的是，它有一种奇妙的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300221
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300221,
					"content": "这把无名古琴，是我游览群山间，偶然在一座遗落洞府里得来的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300222
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300222,
					"content": "那时这琴虽老旧，但仍完好。我见猎心喜，不自觉便拨弄了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300223
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300223,
					"content": "没想到，琴声初起，我便一阵恍神，彷佛有人正与我合奏，那感觉，似曾相识...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300224
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300224,
					"content": "让我想想，你真的没有吃到什么让人产生幻觉的东西吗?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300225,
					"content": "大概是没有，因为一曲落下，我便醒过神来，这才仔细端看起那洞府，果然大有玄机。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300226
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300226,
					"content": "那府内杂草横生，主人想必已经离去许久。可那一桌一椅皆纤毫不染，更有阵阵幽香扑鼻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300227
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300227,
					"content": "就连风中一直吵闹的杂音也在那偃息了。此等神异，我猜测，那就是璃月传说中的仙家宝地吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300228
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300228,
					"content": "哇喔喔喔！所以这把琴是仙人留下来的宝物吗？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300229,
					"content": "哈哈，谁知道呢？那之后我又想，此等妙事，当然要跟朋友分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300230
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300230,
					"content": "可我在璃月，除了大姐头外，就只有你一位朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300231
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300231,
					"content": "大姐头对这种事情恐怕是毫无兴趣，我便想着，不如请你来体会一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300232
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300232,
					"content": "于是便拜托了重佐大副，让他留意你的行踪。只可惜在你们来之前，这琴损坏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300233
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300233,
					"content": "嗯，是我的过失，我拿着它游历各处，使用太频繁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300234
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300234,
					"content": "啊，仙人的宝物也会坏吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300235,
					"content": "连那位雷神大人都没办法握住永恒…就更别说其他事物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300236
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300236,
					"content": "#呜呜，{NICKNAME}，你、你一定要保护好我们的尘歌壶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300237,
					"content": "不过好在，这种损坏是可以修复的，因为它更像是休眠，是琴中的能量随着时间流逝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300238
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300238,
					"content": "所以只要找到正确的材料，就能唤醒它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300239
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300239,
					"content": "如果我没有听错的话，这种材料大概是...琉璃百合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300240
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300240,
					"content": "你怎么知道的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300241
					]
				},
				{
					"id": 700300241,
					"content": "我有说过吧，风会带着万物的呢喃在世间穿行，而我恰好能够听见其中几缕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300242
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300242,
					"content": "所以我知道了一些，关于这古琴往昔的只言片语。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300243
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300243,
					"content": "去吧，我在这里等你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300244
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300244,
					"content": "你是璃月港的大英雄，这点小事应该不成问题吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300219,
					"content": "这琴挺贵的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300207,
					"content": "你挺不务正业嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				}
			]
		},
