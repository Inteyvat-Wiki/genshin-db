			},
			"dialogs": [
				{
					"id": 700300301,
					"content": "风儿都还没有带回你的消息，你就已经出现了。真是让我大开眼界，你是怎么做到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300302
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300302,
					"content": "#嘿嘿，{NICKNAME}比你想象的还要厉害哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700300303,
					"content": "咳咳，这些够吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300304
					]
				},
				{
					"id": 700300304,
					"content": "给我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		},
		{
			"id": 7003004,
			"completionStepIds": [
				7003007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
