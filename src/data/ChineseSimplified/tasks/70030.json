			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"枫原万叶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300401,
					"content": "嗯，品质很好，这些就足够了，将它们捣成汁液，浸入琴身，应该就能让古琴回春了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300402
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300402,
					"content": "嗯——这熟悉的感觉。它醒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300403
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300403,
					"content": "#来，{NICKNAME}，试试吧，它就交给你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300404
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300404,
					"content": "交给我是什么意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300405
					]
				},
				{
					"id": 700300405,
					"content": "哈哈，难道诗人不可以直抒胸臆吗？「交给你」的意思就是：这把琴，送你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300406
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300406,
					"content": "再访璃月，我是来倾听这一方世界的。能在这片岩神守护的古老大地中，听见那些生生不息的低语，我很满足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300407
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300407,
					"content": "当然，要是哪天这琴你不要了，我会来拿的。但...希望永远不要有那一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300408
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300408,
					"content": "好了，我要继续上路了，这种时候璃月人会怎么说？啊，对了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300409
					],
					"speakerTitle": "枫原万叶"
				},
				{
					"id": 700300409,
					"content": "#{NICKNAME}，「后会有期」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "枫原万叶"
				}
			]
		}
	]
