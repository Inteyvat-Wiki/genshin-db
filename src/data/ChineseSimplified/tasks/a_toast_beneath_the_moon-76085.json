				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520202,
					"content": "怎么样怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520203,
					"content": "它让我回想起了非常久远的过去，那时我和「霜月之子」生活在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520204,
					"content": "他们习惯将新鲜的薄荷叶、香料和浆果干共同冲泡，制成具有混合风味的饮品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520205,
					"content": "每次经过窗边的时候，我总会闻见小屋里飘出淡淡的草木清香…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520206,
					"content": "后来呢？你尝了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520207,
					"content": "试过，但没喝成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520208,
					"content": "欸？为什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520209,
					"content": "「神明大人」突然说出「能尝尝你家的茶吗？」这种话之后…没人敢真的将家中的「粗茶」献上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520210,
					"content": "啊，也是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520211,
					"content": "最后到我手中，就变成了在华美包装下「献予神明」的「贡品」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520212,
					"content": "不是说它难喝。但…它少了某种我路过窗边时闻到的…温馨的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520213,
					"content": "现在可以喝个够了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520215,
					"content": "很美味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520216,
					"content": "…不过，倒是很少见到加入牛奶的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520217,
					"content": "毕竟是从蒙德带来的配方嘛，他们喝茶还挺喜欢加牛奶、奶油和糖的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520218,
					"content": "很新奇，感觉还不错。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520219,
					"content": "呼，你喜欢就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520220,
					"content": "嗯，谢谢你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520221,
					"content": "原来不止月光能映照往事，饮品的芳香，也能唤起深藏于过去的风景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
