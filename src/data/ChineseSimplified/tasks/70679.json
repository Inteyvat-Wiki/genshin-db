			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"吉盖克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "您好，您好！哎呀，真是巧了，咱们又见面啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790102,
					"content": "抱歉，你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "我是吉盖克斯！风行迷踪，您想起来了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790106,
					"content": "原来是你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706790107,
					"content": "完全想起来了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "您这副表情，完全是没有想起来嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790109,
					"content": "无论如何，请您看这边。这一副「风行迷踪」您肯定记得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790110,
					"content": "您上次帮我试玩了过后，不是也给我提出了很多意见吗？那都是好主意，我基本上都采纳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790111,
					"content": "我对游戏规则和玩法进行了又一次…呃，准确来说是好几次的改进。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790112,
					"content": "不会很难理解吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "您放心吧，这些新玩法您肯定会喜欢的，容我为您简单解释一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790115,
					"content": "首先，在这副全新的「风行迷踪」里，我首次加入了名为「发信机」的东西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790116,
					"content": "游侠只要成功启动四个「发信机」，就可以击败猎手，获得胜利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790117,
					"content": "而猎手要做的事嘛…还是不变，只要把所有游侠抓住，就算他们赢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790118,
					"content": "但在这次的「风行迷踪」里，游侠被猎手抓住后，不会直接出局，而是会被投入一个叫做「监控地」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790119,
					"content": "只要过段时间，或者是有其他游侠帮忙，被抓住的人就可以从「监控地」逃脱，继续和猎手周旋啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790120,
					"content": "不过，如果被抓住过的人再次被抓住…那就不得不被判出局啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790121,
					"content": "听起来有点复杂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "放心，也就是听起来复杂，只要多玩几局，您就全明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790124,
					"content": "那我来试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "好！您来这边…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790126,
					"content": "还有别的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "没事，您有空的时候再来也行，我还会在这待一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉盖克斯"
				},
				{
					"id": 706790122,
					"content": "这么多新规则啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "你没有加入奇怪的玩法吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "你是…风行迷踪！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "我是吉盖克斯！好吧，您说的也没错，我倒也情愿风行迷踪比我更出名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "吉盖克斯"
				}
			]
		}
	]
}