			"dialogs": [
				{
					"id": 761820101,
					"content": "这就是你曾经生活的地方吗？真漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820102,
					"content": "以前更漂亮。我打理花园可是很有一手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820103,
					"content": "哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820104,
					"content": "你又傻笑什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820105,
					"content": "想象了一下那时的桑多涅蹲在花丛边的样子，觉得很可爱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820106,
					"content": "我等下可以进屋看看吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820107,
					"content": "当然，我已经把灰尘都清理过一遍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820108,
					"content": "你今后打算怎么处理这个家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820109,
					"content": "嗯…果然还是想留下它。有时间就回来打理一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761820110,
					"content": "没时间的话，我也可以来帮你打理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820111,
					"content": "这里和曾经你房间给我的感觉一样，令人安心。我很喜欢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820112,
					"content": "哼…随你便吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
