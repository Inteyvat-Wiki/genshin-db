			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "「璃月之永固，人世之绸缪，愿据此大计，徐徐而行…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130502,
					"content": "你回来了啊，稍等，还有最后几句…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130503,
					"content": "嗯…行了，写完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130504,
					"content": "这是「扣三丝」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "不急不急，你先看看这本书怎么样，我自认书法尚可，写的字应该是能够入眼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130506,
					"content": "这就是诗人的实力吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "哈哈哈，谬赞，谬赞了。这本书给你，可别弄丢了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
