			"dialogs": [
				{
					"id": 718130701,
					"content": "你把那些林猪都赶跑了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130702,
					"content": "都赶跑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "那就行了，我等会就去取竹子去，等做好了之后，我直接送去月海亭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130704,
					"content": "这单子还挺大的，应该能赚不少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路爷"
				}
