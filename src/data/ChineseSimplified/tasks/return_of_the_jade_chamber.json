			"trigger": {
				"objectNames": [
					"纪芳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "你好，想要买什么书吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718130202,
					"content": "我们想要《珠玑宝矿》。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "《珠玑宝矿》？这本书我这里可没有…怎么，你要得很急吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718130204,
					"content": "关于重建群玉阁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "咦？群玉阁要重建了吗？那确实得好好筹备，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718130206,
					"content": "不然，你去找清昼问问吧，他读过很多书，说不定他知道在哪能找到这本《珠玑宝矿》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "纪芳"
				},
				{
					"id": 718130207,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "清昼我记得经常在望舒客栈待着，你可以去那边找找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "纪芳"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
