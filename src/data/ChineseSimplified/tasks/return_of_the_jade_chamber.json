			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路爷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "嗯？你有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130602,
					"content": "我们想要订制一些竹制的小摆件…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "竹制的小摆件？我倒是也能做，但你这个订单是从哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130604,
					"content": "是百闻给的清单…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "嚯…月海亭那边来的订单啊，行，我尽量加紧做就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130606,
					"content": "不过，我经常去取材料的竹林那边，最近不知道为什么，突然多了很多林猪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130607,
					"content": "虽然也没什么大影响，但我总得绕着它们去取竹子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130608,
					"content": "要是你们能把那些林猪赶跑的话，我现在就能去取点竹子回来开工了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "路爷"
				},
				{
					"id": 718130609,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "那我就在这里等你，你赶跑那些林猪之后，就回来和我说一声吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路爷"
				}
			]
		},
