			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "难写，真是难写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130302,
					"content": "关于《珠玑宝矿》…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "《珠玑宝矿》？哦，我记得那本书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130304,
					"content": "我之前为了写一首和商贾之事有关的诗而四处取材，在一个地方偶然读过这本书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130305,
					"content": "那本书里说的东西虽然我有些看不懂，但有些事例对我作诗倒也有所启发。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130306,
					"content": "我想想那首诗是什么啊，你稍等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130307,
					"content": "你还记得那本书在哪里能找到吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "你们要找那本书？那我可不记得在哪能找这本书了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130309,
					"content": "不过，如果你们急着要，我倒是可以直接手写一份给你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130310,
					"content": "手写一份？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "欸，那本书的内容倒也不长，记下来也不难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130313,
					"content": "而且我那时候读那本《珠玑宝矿》的时候，藏书的人压根也不让我借阅出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130314,
					"content": "但作诗哪是一朝一夕的事…我就把那本书给抄了一份走，因为内容也不太多，我也就差不多背下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130315,
					"content": "这就是诗人的实力吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "不值一提，不值一提。不过…我写一份这本书给你，你也帮我个小忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130317,
					"content": "说来有些不好意思，我一直在这取材，却忘了吃饭，现在有些饿了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130318,
					"content": "请你帮我拿一份「扣三丝」过来吧，我也会在这帮你写那本《珠玑宝矿》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130319,
					"content": "等你回来了，我差不多也就写好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130311,
					"content": "你全记下来了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
