			"dialogs": [
				{
					"id": 716540201,
					"content": "哇…这壶里的空间，好像比萍姥姥那盏更大呢，中间还有一栋好大的房子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540202,
					"content": "不过，周围却没什么东西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540203,
					"content": "派蒙去开凿石头，再造一座屋子吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "凿不动！你自己不是拿着剑吗？你自己去凿啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540207,
					"content": "唉，不过除了那个房子之外，这周围怎么空荡荡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540208,
					"content": "欸？等等，那是什么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716540205,
					"content": "派蒙去挖个地洞，暂时住进去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "明明有房子，为什么我还要挖地洞啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "派蒙"
				}
			]
		}
