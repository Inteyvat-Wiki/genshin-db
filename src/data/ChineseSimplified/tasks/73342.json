			"dialogs": [
				{
					"id": 733420101,
					"content": "哇，斯露莎还挺厉害的嘛，一下子就让周围焕发了生机！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733420102,
					"content": "花灵的力量真奇妙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733420103
					]
				},
				{
					"id": 733420103,
					"content": "大惊小怪！以吾之威能，拯救「净觉花」不过是举手之劳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420104
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733420104,
					"content": "黯色的侵蚀还在扩张，这片「净觉花」只不过是诸多受害者之一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420105
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733420105,
					"content": "其他花池也没法幸免于难，瑟法娜想必正手忙脚乱，惊慌失措吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420106
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733420106,
					"content": "听起来，你说的瑟法娜，应该是个勤勤恳恳照顾花儿们的好花灵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733420107,
					"content": "#我们就帮帮那位花灵吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733420108,
					"content": "这点功绩，作为伟业正道旁的小小装点倒也无妨。吾之「谒颂主」，你就多多留意这样的「净觉花」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733420109,
					"content": "下次看到了就通知你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733420110
					]
				},
				{
					"id": 733420110,
					"content": "嗯，我们一起拯救这些漂亮的花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
