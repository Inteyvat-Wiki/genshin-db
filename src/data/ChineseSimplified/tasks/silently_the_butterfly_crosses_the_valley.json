			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "唔…嗯？尔等何人？扰我好梦…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150402,
					"content": "欸？！什么东西在说话？好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150403,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150404,
					"content": "哇啊啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150405,
					"content": "哈哈哈哈哈！害怕就对咯！若我未被山石所困，你们早就进我肚子里啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150406,
					"content": "什么…？啊！原来只是会说话的石像呀…我还以为是什么怪物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150407,
					"content": "哼，什么叫「只是会说话的石像」！石像会说话难道不可怕吗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150408,
					"content": "呃，像这样的石像，我们在外面已经见过很多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150409,
					"content": "什、什么！唉，好吧，那看来是吓不到你们了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150410,
					"content": "为什么非要吓到别人呀，真是的！明明只是个石像而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150411,
					"content": "哼！就算我「只是个石像而已」，此地可是药君大人的洞府！药君大人还在的时候，就不喜欢别人随意打扰她的安宁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150412,
					"content": "所以呀，我就要把讨厌的家伙全部吓跑！就算药君大人离开了也是一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150413,
					"content": "不过，你们的气息和那些普通的凡人好像也有些不同，而且也没有被我吓到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150414,
					"content": "可不可以拜托你们，帮我一个忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150415,
					"content": "哦？那你要我们帮什么忙呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150416,
					"content": "咳咳，你们看这些彩色的蝴蝶！自从洞府的主人离开后，这些小家伙就散落得遍地都是，到处乱飞——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150417,
					"content": "嘘…先等一下，你头上就有一只呢！稍等一下，让我们帮你拿下来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
