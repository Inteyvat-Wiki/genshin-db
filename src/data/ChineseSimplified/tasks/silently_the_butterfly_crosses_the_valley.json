				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "呼…对啦，就是这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150502,
					"content": "先前洞府药君曾引彩蝶点缀门户，后来洞府机关破败，这些彩蝶与药罐…原是用于滋养那棵仙树的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150503,
					"content": "仙树？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150504,
					"content": "哼哼，没错！想当初，这仙树乃是药君大人亲手栽下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150505,
					"content": "虽说现在已经枯萎，但药君大人说过，只要彩蝶还没有散尽，那棵树便可以复生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150506,
					"content": "唉…自从无力维持人形之后，她很快便离开了，不知如今过得如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150507,
					"content": "「彩蝶汇坛中，复枯木逢生之貌…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "没错没错！只要…不对，你们是怎么知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150509,
