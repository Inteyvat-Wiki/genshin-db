			"dialogs": [
				{
					"id": 711150601,
					"content": "呼…对啦，就是这个！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150602,
					"content": "先前洞府药君曾引彩蝶点缀门户，后来洞府机关破败，这些彩蝶与药罐，原是用于滋养那棵仙树的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150603,
					"content": "仙树？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711150604,
					"content": "哼哼，没错！想当初，这仙树乃是药君大人亲手栽下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150605,
					"content": "虽说现在已经枯萎，但药君大人说过，只要彩蝶还没有散尽，那棵树便可以复生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150606,
					"content": "唉…自从无力维持人形之后，她很快便离开了，不知如今过得如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150607,
					"content": "所以我要怎么做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "啊，不好意思，一不小心就沉浸在药君大人的回忆里了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150609,
					"content": "咳咳，听好啦，人类！只要把那些彩蝶赶进罐子里，就能滋养那棵枯木啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150610,
					"content": "哼哼，这就是药君大人设计的仙家机关，很神奇吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150611,
					"content": "我试试看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "嗯嗯，那就拜托你们了，好心的人类！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150613,
					"content": "为什么是彩蝶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "欸？对喔，为什么呢…也许是因为药君大人比较喜欢彩蝶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "「慢悠悠仙像」"
				},
				{
					"id": 711150615,
					"content": "呃…总之，拜托你们帮忙把那些彩蝶赶回罐子里吧，好心的人类！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「慢悠悠仙像」"
				}
			]
		},
