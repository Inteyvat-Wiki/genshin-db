					"黄衫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "我和弗朗西斯联络过了，那批货物他已经收到，多亏了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160502,
					"content": "什么时候联络的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "哈哈，不用在意，我们镖师的腿脚比一般人快不少，交接事务嘛…自然也快不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160504,
					"content": "这趟多亏你帮忙，干活拿报酬是天经地义，我也不会短你的。你稍等一下啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160505,
					"content": "海灯节也不休息吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "干我们这行的，生意一时有一时无，海灯节也着不了家，没办法嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160507,
					"content": "你是在四处旅行吧，大家在海灯节的时候都会放霄灯，你也可以体验体验。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160508,
					"content": "那你呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "每年都在外面跑，我倒几乎没什么闲工夫放过霄灯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160512,
					"content": "要是有现成的，放一盏博个好彩头也不错，可惜我是没空自己编霄灯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160513,
					"content": "虽然少了点节日气氛，但也无所谓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160514,
					"content": "我帮你去准备一盏吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "咦？你要帮我准备霄灯吗？你倒是个热心的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160515,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "你放霄灯了吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "这倒还没有，我们在外漂泊的人，哪有这些闲功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "黄衫"
				}
			]
		},
		{
			"id": 7181607,
