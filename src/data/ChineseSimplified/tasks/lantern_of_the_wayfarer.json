			"trigger": {
				"objectNames": [
					"黄衫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "这叫我怎么送得过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160102,
					"content": "怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "是旅行者吧，这时候来璃月正好能赶上海灯节，你运气不错，但是我就没法开心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160104,
					"content": "我们璃月人有海灯节放霄灯的传统，所以每年这时候霄灯材料的货运量都很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160105,
					"content": "今年不知道是不是我的错觉，货运量好像比往年还多了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160106,
					"content": "我一个人还真有些忙不过来，这个客商还是个不了解璃月路况的枫丹客商，一直在催…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160107,
					"content": "我有心请人帮把手，又一直找不到合适的人选，你愿不愿意来帮忙走一趟镖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160108,
					"content": "没问题。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "好！我就喜欢爽快的人，要是接镖的那位也能像你这么爽利就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160110,
					"content": "那位的名字叫什么来着，好像是弗朗…弗朗西斯来着，外国人的名字我实在念不来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160115,
					"content": "你愿意帮忙的话，就请你到存放货物的地方和我碰头吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160116,
					"content": "具体地点我已经帮你标注在地图上了，那我先行一步，我们稍后见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160111,
					"content": "枫丹客商？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "没错，叫什么…弗郎…弗朗西斯，外国人名字真是难念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160113,
					"content": "也不知道他订这么大一批霄灯材料要干嘛，不过…人家出钱，我出力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "黄衫"
				},
				{
					"id": 718160114,
					"content": "放心，你帮了忙之后，报酬肯定也少不了你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "黄衫"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
