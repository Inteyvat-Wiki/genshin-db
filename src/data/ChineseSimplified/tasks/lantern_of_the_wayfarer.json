			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"弗朗西斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "这是…我订的货物，哦天呐，终于送到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "弗朗西斯"
				},
				{
					"id": 718160402,
					"content": "看你的装束，运货的这位朋友，你也不是璃月本地人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "弗朗西斯"
				},
				{
					"id": 718160403,
					"content": "亲爱的朋友，不知道你有没有尝试过璃月美食，那简直是太美妙了，相信我，你真该去试试。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "弗朗西斯"
				},
				{
					"id": 718160404,
					"content": "好了，现在这批货也到了，我可以先放心去享受美食了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗朗西斯"
				}
			]
		},
