					"王平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "您敬好香了吧，感觉怎么样？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310502,
					"content": "还不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "那就好。希望这座庙以后香火会盛一点…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310504,
					"content": "我会暂时待在这里一段时间。这里很清静，是个进行编写工作的好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310505,
					"content": "我得尽快整理一下我之前搜集的那些资料，然后继续编写那本有关「护法夜叉」的书。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310506,
					"content": "您以后有空的话，也可以多来这庙里看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310507,
					"content": "想要敬香的话，直接找我拿香就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310508,
					"content": "唉，其实我还想把周围也再整修一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310509,
					"content": "路得重新铺一遍，两边要加上围栏，旁边还要再做个花圃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				}
			]
		},
