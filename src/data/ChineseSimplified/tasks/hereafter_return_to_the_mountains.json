			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "这庙看着还算不错…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310302,
					"content": "确实很不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "欸？您来得倒是刚刚好，这庙才修好不久，我刚给工匠们结完钱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310304,
					"content": "唉…没想到居然花了这么多钱，我辛苦赚的那些钱，已经全部砸里面了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310305,
					"content": "不过无论如何，这庙建好了就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310306,
					"content": "您想去庙里敬敬香吗？我还专门托人做了一个新香炉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310307,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "这几柱香您拿着，香炉就在那边。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718310308,
					"content": "你也敬香了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "那当然。庙刚建好之后，我可是敬了一柱上好的香，刚刚才烧完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "王平安"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
