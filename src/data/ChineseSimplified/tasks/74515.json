			"completionStepIds": [
				7451501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7451501",
							"2"
						],
						"stepId": 7451501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745150101,
					"content": "#欸？是{NICKNAME}和派蒙？太好了，你们出现的正是时候！我正准备去冒险家协会发布委托呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150102,
					"content": "#竟然有送上门来的委托？好哎，{NICKNAME}今晚我们可以吃大餐了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150103,
					"content": "咳咳，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150104
					]
				},
				{
					"id": 745150104,
					"content": "啊…我是说，作为知名冒险家，我们对出场费可是有一定要求的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150105,
					"content": "报酬的事情你们不必担心。只要你们像以前那样负责好具体的实验模块，报酬绝对管够！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150106,
					"content": "像、像以前那样？唔——那个…这位先生，我们以前见过吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150107,
					"content": "唉…你们又把我忘了吗？是我啊，须弥的教令院学者胡塞尼，我们明明都合作过那么多次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150108,
					"content": "对、对不起，完全没有印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150109,
					"content": "那「导能原盘」呢，总该有些记忆吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150110,
						745150111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150110,
					"content": "难道是「圆盘人」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150113
					]
				},
				{
					"id": 745150113,
					"content": "「圆盘人」——？哦，我想起来了，是之前在离岛和层岩巨渊见过的那位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150114,
					"content": "你变化好大，唔——感觉变得阳光了不少，怪不得一下子认不出来了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150115,
					"content": "呵呵，有么？那应该是因为我现在太开心了吧，说实话，我已经好久没这么走运过了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150116,
					"content": "哇！发生了什么好事啊？也讲给我们听听！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150117,
					"content": "这就说来话长了，话说在上次分别之后，我直接就回到了「教令院」，并根据收集到的数据提出了人造导能原盘的设想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150118,
					"content": "在看到立项书的第一刻，导师他神情十分激动，当场给予了立项书以「高度的赞扬」，然后就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150119,
					"content": "然后就…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150120,
					"content": "然后他就把我赶出了须弥，让我在枫丹替他跑腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150121,
					"content": "啊？为什么？不是夸奖么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150122,
					"content": "他夸我十分勇敢，竟然敢把幻想文学当做立项书提交给他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150123,
					"content": "这怎么看都不是夸奖吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150124,
					"content": "的确，我也因此心灰意冷了一阵子。不过幸运的是，我在枫丹遇到了不错的合伙人和投资方，他们一眼就看上了我的项目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150125,
					"content": "在他们的协助下，我成功地将之前的研究与枫丹的技术相融合，制造出了人造导能原盘的原型机，也就是「胡塞尼原盘」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150126
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150126,
					"content": "只要「胡塞尼原盘」按照我的计算中的那样通过实验，别说智慧之神的考验，就连成为贤者都不是没有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150127
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150127,
					"content": "你竟然还没有毕业啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150128
					]
				},
				{
					"id": 745150128,
					"content": "咳咳，不要在意这种没有意义的混淆变量，这不过是我通往成功之路的一点小波折而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150129
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150129,
					"content": "现在最重要的，就是验证「胡塞尼原盘」的具体表现，为此我需要召集志愿者在秘境中使用并对它进行验证。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150130
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150130,
					"content": "#那么{NICKNAME}，我想请问，你愿不愿以志愿者的身份参加这次对「胡塞尼原盘」的实验工作呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150131,
						745150133
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150131,
					"content": "简单来说，就是用它战斗吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150132
					]
				},
				{
					"id": 745150132,
					"content": "嗯，没错。我相信你的战斗能力，但现在的「胡塞尼原盘」还尚未达到它的设计预期，请注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150133,
					"content": "好的，交给我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150134
					]
				},
				{
					"id": 745150134,
					"content": "#{NICKNAME}，我相信你的战斗能力，但现在的「胡塞尼原盘」还尚未达到它的设计预期，请注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150111,
					"content": "好像也没有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150112
					]
				},
				{
					"id": 745150112,
					"content": "那「圆盘人」呢？这个称号你们总该有印象了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150113
					],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
}