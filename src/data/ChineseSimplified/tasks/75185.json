			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "乌乌黑蛋是什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "说到乌乌黑蛋，那可是只有我们火山地区才能创造的美食啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850303,
					"content": "将鸟蛋放在地热喷口上，利用火山喷出的气态燃素进行烤制，等到火候正好的时刻取出，就能得到一枚完美的乌乌黑蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850304,
					"content": "不过，要是不小心烤焦了，味道就会变得相当……不同寻常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伦图"
				}
			]
		},
		{
			"id": 7518504,
