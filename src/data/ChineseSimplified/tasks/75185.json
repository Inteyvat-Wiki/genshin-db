			"dialogs": [
				{
					"id": 751850701,
					"content": "是你们啊，身手矫健的异邦旅人。怎么样，有尝试自己动手制作乌乌黑蛋吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850702,
					"content": "尝试过了，吃完浑身有力！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "对吧，对吧，这可是蕴含了火山精华的美味啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850704,
					"content": "据说每天都吃的话，能让身体变得越来越健壮呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850705,
					"content": "烤过头了，吃完差点晕过去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "哈哈哈，那个味道很让人印象深刻吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850707,
					"content": "我倒是觉得吃习惯之后，也没那么难以下咽啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850710,
					"content": "还没有，下次试试。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
