			"dialogs": [
				{
					"id": 751850201,
					"content": "现在只需要完成一个小小的「火山蛋挑战」——将那边的地热喷口打破，取出里面的乌乌黑蛋，就能品尝到新鲜出炉的美味了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伦图"
