			"dialogs": [
				{
					"id": 751850401,
					"content": "两位真是好身手啊，咻咻咻地几下就完成了挑战。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850402,
					"content": "让我看看——哦哦，这个黝黑的色泽和浓厚的气味，真是让人胃口大开啊。快趁热品尝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "伦图"
				},
				{
					"id": 751850403,
					"content": "这份食谱你们也拿着，以后如果还想品尝乌乌黑蛋，可以自己动手烹饪看看哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伦图"
				}
			]
