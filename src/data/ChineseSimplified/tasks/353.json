			},
			"dialogs": [
				{
					"id": 3532801,
					"content": "呀，是不是感受到这个世界的「元素」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532802,
					"content": "看起来，你只要触碰神像，就能获得「风」的元素力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532803,
					"content": "这个世界的人想要获得力量，绝对不可能像你这样轻松…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532804,
					"content": "这力量的来源…果然是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "嗯，因为你本来就不是这个世界的人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532809,
					"content": "从这里向西走，就可以抵达自由城邦「蒙德」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532817,
					"content": "蒙德是「风」的城市，在七神中供奉的正是风神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532810,
					"content": "能从神像获得力量的你，会不会在那里找到神的线索呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532811,
					"content": "#而且，蒙德有很多吟游诗人，说不定能打听到你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532812,
					"content": "好，那就出发吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532813,
					"content": "这个世界的「元素」回应了祈愿，我觉得这算是一个好兆头哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3532807,
					"content": "真是邪门。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "「邪门」这种词对神灵真是太不尊重了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
