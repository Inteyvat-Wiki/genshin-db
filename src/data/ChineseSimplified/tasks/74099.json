			"dialogs": [
				{
					"id": 740990101,
					"content": "关于之前钓到魔物的经历…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "啊！仔细一想…因为自己投下的鱼饵引来魔物，确实是很特别的体验！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 740990103,
					"content": "虽然我个人不是很怕魔物啦，以前独自在科学院和枫丹廷之间来往的时候，也和一些盗贼打过架，没怎么吃过亏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 740990104,
					"content": "但我现在是以钓鱼协会理事的身份站在这里的，不能做失职的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 740990105,
					"content": "无论是吓跑了水下的其他鱼，还是干扰到附近钓鱼的人，都是辜负了大家对我这个理事的认可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "德拉萝诗"
				},
				{
					"id": 740990106,
					"content": "所以，我还是要保守一点，谨慎一点！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德拉萝诗"
				}
			]
		}
