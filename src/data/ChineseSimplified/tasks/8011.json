			"dialogs": [
				{
					"id": 80110601,
					"content": "卡利贝尔，谢天谢地，这里一切如常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110602,
					"content": "不去祭拜七天神像了么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "我…只是隐隐有种感觉，刚刚的事是某种命运的安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110605,
					"content": "在我最不想祭拜神像的时候，发生了刚才的那件事，仿佛是对我的某种引导…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110606,
					"content": "听你说，我好像在「那个东西」前跪拜了，说不定…效果也差不多呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110607,
					"content": "简直莫名其妙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "不管你怎么说，我都要先尝试一下…是你说过的，「总归要尝试所有的可能性」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110610,
					"content": "再一次将药喂给了丘丘人…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "卡利贝尔…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110612,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110613,
					"content": "爸…爸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110614,
					"content": "啊…卡利贝尔！天哪，这是真的，这是奇迹，我的卡利贝尔！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110615,
					"content": "居然…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "看到了吧，有效果了，卡利贝尔又能说话了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110618,
					"content": "妈妈呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110619,
					"content": "妈妈她…卡利贝尔，你先看着我，你认得出我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110620,
					"content": "嗯，你是爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110621,
					"content": "哈…哈哈哈…救赎，这就是被救赎的感觉吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110622,
					"content": "你现在感觉还好吗，卡利贝尔，意识还清醒吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110623,
					"content": "嗯…我好像睡了很久，梦里我躲在一个小房间里，一直一直不敢出去，但也不想出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110624,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110625,
					"content": "我的身体！我的身体怎么了！这、这是我吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110626,
					"content": "爸爸…这是怎么回事！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110627,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110628,
					"content": "…不要慌张，儿子，只是…只是在你睡着的时候，我们到了一个童话里的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110629,
					"content": "这个世界不再有坎瑞亚，不再有我们的家园，但同样也没有了红色的天空和末日一样的灾难。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110630,
					"content": "你会像这样，作为一个小怪兽的模样，和爸爸永远在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110631,
					"content": "我…我是死了么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110632,
					"content": "没有，说什么呢，卡利贝尔…你看你的胳膊上还有妈妈的丝巾，她也在祝福和保佑你呢，你怎么可能死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110633,
					"content": "这样吗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110634,
					"content": "嗯，刚醒来的你可能有些混乱，你就先在这里好好休息吧…一切都会好起来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110635,
					"content": "哦对了…你一定要记得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110636,
					"content": "不要摘下面具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110637,
					"content": "记住了吗？不要摘下面具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110638,
					"content": "好的…好的爸爸，我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "卡利贝尔"
				},
				{
					"id": 80110639,
					"content": "父子间的对话持续了很久，埃德仿佛得到了救赎一般…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "从那一天起，我就从来没有像现在这样开心过…这居然是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110641,
					"content": "是啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "哼，我就知道什么七神根本不可能指望得上，呸…我居然还祭拜了七天神像，简直是我此生最大的耻辱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110644,
					"content": "凶手，永远都会是凶手，想要他们拯救什么，我可真是太天真了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110645,
					"content": "反倒是，我们在洞穴里见到的那位不知名的神，那才是真正伟大的神明，和七神什么的不一样！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110646,
					"content": "那神秘的力量，令人痴迷…一定是我之前虔诚跪拜的缘故，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110647,
					"content": "哦这么说来，向神明许愿，愿望得以实现之后，是不是应该…应该那个叫什么「还愿」来着？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110648,
					"content": "反正求神的事我不太懂，但这次我觉得一定有必要去「还愿」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110649,
					"content": "可是…那并不是神明，埃德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "「罪人」？喂，你在胡说什么，你对那位神明有什么了解，怎么敢如此出言亵渎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110652,
					"content": "他的神力你也已经看到了，七神怎么可能带来这样的奇迹？他只会是高于七神之上的神，「罪人」什么的简直莫名其妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110653,
					"content": "算了…不管你如何看待，都影响不了我的虔诚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110654,
					"content": "我现在就去还愿，你不跟着来也无所谓。",
					"roleType": "TALK_ROLE_NPC",
