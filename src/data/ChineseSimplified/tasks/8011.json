			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"埃德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "这里好阴森，这个地方…以前也存在吗？好像从来没有发现过这里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110202,
					"content": "你看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "啊？他们…他们是在膜拜什么吗？一边走，一边跪拜…看起来很虔诚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110205,
					"content": "我从未见过这样的景象，这个地方究竟藏了些什么…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110206,
					"content": "只有一探究竟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110207,
					"content": "（这里的气氛，诡异的情景，难道…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "那些丘丘人在做什么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
