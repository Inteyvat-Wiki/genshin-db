			},
			"dialogs": [
				{
					"id": 80110401,
					"content": "刚才那个家伙到底是什么？简直是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110402,
					"content": "吓到了么？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "…简直是完美的生命体，令人赞叹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110405,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "他身上透露着的那股神秘的气息，危险却又优雅的力量，真是太吸引人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110407,
					"content": "真亏你能将这样的存在击败，你的实力有些超乎我的想象了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110408,
					"content": "你的品味还真是独特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "我们继续前进吧，我已经越来越好奇，越来越兴奋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110409,
					"content": "我只是经验丰富罢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "我以前见过类似的家伙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
