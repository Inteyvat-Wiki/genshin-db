			"trigger": {
				"objectNames": [
					"埃德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110101,
					"content": "好像…不是卡利贝尔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110102,
					"content": "不是他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "嗯。卡利贝尔胳膊上的丝巾是我曾经送给他母亲的礼物，如今被我拿来做记号。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110105,
					"content": "我怕是眼睛也快撑不住了，连自己的儿子都认不清了，这副身体…唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110106,
					"content": "不过这个丘丘人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "是啊，好像对我们完全没有兴趣，只是坚定地往那个方向走…那边有什么吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110109,
					"content": "不清楚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "嗯，关于丘丘人…知道的越多越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80110110,
					"content": "跟上去看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "稍微有些奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "他的胳膊上没有丝巾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
