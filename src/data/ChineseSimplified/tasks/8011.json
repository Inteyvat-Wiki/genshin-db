			"dialogs": [
				{
					"id": 80110301,
					"content": "停下，人类。汝等并未获准来此地探寻「命运」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "命运使徒"
				},
				{
					"id": 80110302,
					"content": "（深渊使徒？不对，好像从未在深渊教团见过这样的家伙…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "怎么，汝等执意要「觐见」么？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "命运使徒"
				},
				{
					"id": 80110304,
					"content": "…也无妨，那就赐予汝等「命运的试炼」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "命运使徒"
				}
			]
		},
