			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "怎么样，风景很不错吧？「胡椒」刚才也很高兴呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960802,
					"content": "面对这样的景色，语言已经显得多余了。卡特皮拉说得对，铁格子之外还有广阔的世界…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960803,
					"content": "铁格子…于连之前说自己在枫丹的住处很小…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960804,
					"content": "咳，须弥的自然风物挺多的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "…啊，对对！他已经决定要当个堂堂正正的画家了，换个环境也挺好的，那话怎么说的来着…拓宽视野！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960806,
					"content": "虽然于连自己说想要放弃…但我觉得没必要那么快就下结论嘛！可以再多考虑考虑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960807,
					"content": "想一想还有很多和眼前的景色一样，或者比这还要壮美的绝景你都还没见识过呢，说不定…说不定看过之后就有灵感了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960808,
					"content": "至于辨别颜色…于连自己也说了，「只是看到了不同的景色」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960809,
					"content": "「但是美是共通的。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960811,
					"content": "的确…你们的话很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960812,
					"content": "是你自己的话啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960813,
					"content": "我…哈哈，原来这道理我是明白的，只是…只是我总是走上错误的路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960814,
					"content": "「胡椒」带你走了这条路，我们才能认识呢，所以这也不完全是「错误的路」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960815,
					"content": "虽然没能帮你找到纯水精灵的朝圣之路挺遗憾的…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960816,
					"content": "这种东西真的存在吗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "我到现在也相信朝圣之路的确存在，不过…对我来说，能否找到它的终点已经不再重要了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960818,
					"content": "因为我已经找到我想要的答案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960819,
					"content": "谢谢两位好朋友，唉，我该怎么感谢你们呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960820,
					"content": "要是之前买下了那枚神奇鸟蛋就好了…能够抵消掉一天的厄运的神奇道具，送给你们这样的冒险家正合适呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960821,
					"content": "是啊，真可惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME}居然真的相信有这样方便的神奇道具吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960825,
					"content": "我打算在这里多留一下，这里让人心绪宁静，很适合思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960826,
					"content": "有种能够画出点什么不一样的东西的预感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960827,
					"content": "谢谢两位的帮助，也祝好朋友旅途顺利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于连"
				},
				{
					"id": 732960823,
					"content": "多谢，不过还是不用了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "为什么呀！就算不能抵消厄运…说不定…说不定它是比普通鸟蛋好吃一百倍的鸟蛋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "派蒙"
				}
			]
		},
