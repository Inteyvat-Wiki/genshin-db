			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "充满了大自然的气息…是不是很适合写生和寻找灵感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960402,
					"content": "这是刻板印象啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "唔…可是如果是我就会很想提起画笔呢，这里的景物都有种充满生命力的美，而且色彩也都很绚丽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960404,
					"content": "咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960406,
					"content": "对不起…我不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960407,
					"content": "哈哈，没关系，我只是看到了不同的景色。但是美是共通的，对吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960408,
					"content": "嗯！我很喜欢这里的景色呢，感觉心灵都被净化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960409,
					"content": "派蒙的心灵应该不需要净化吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "两位好朋友，给了我这样一个一开始甚至没有说实话的陌生人这么多的善意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960411,
					"content": "两位都是有着纯洁心灵的好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960412,
					"content": "嘿嘿…倒也不用这么夸奖啦。对了，其实还有更特别的景色呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960413,
					"content": "#{NICKNAME}，你一定知道我在说什么，也让于连见识一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
