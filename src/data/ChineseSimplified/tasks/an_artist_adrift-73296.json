			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "听说画家在动笔之前都会从不同角度观察…这应该不是什么「刻板印象」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960302,
					"content": "我们一起在附近转转？还可以去视野更好的高处观察一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960303,
					"content": "听起来是个不错的主意，我已经准备好出发了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960304,
					"content": "#对了，不如我们比比谁先到终点？{NICKNAME}，准备好出发了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329604",
