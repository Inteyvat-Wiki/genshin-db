			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于连"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#派蒙，还有{NICKNAME}，你们果然来了！出门在外还是得靠朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960202,
					"content": "因为答应了给你带路嘛，而且带路也不是什么难事！举手之劳…这时候该说是举足之劳吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960203,
					"content": "不过，你真的这么快就回枫丹吗？难得到了须弥，其实须弥可看的风景还是很多的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960204,
					"content": "雨林的风景很不错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "有很多树，很多河！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960208,
					"content": "听起来确实很诱人，但是我想…我其实还没有做好远游的准备。这次虽然是一次失败的旅行，但是也算是收获了一些教训吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960209,
					"content": "唔…那…那这附近也有很值得一看的景观呢！要是错过就太可惜啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960210,
					"content": "派蒙推荐的地方准没错。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "既然两位坚持，我再推辞就显得对好朋友失礼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "于连"
				},
				{
					"id": 732960212,
					"content": "嘿嘿，我可是提瓦特的最佳向导，带路就交给我吧！你们可不要掉队啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960206,
					"content": "沙漠的景观很特别。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "有很多沙，很多遗迹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
