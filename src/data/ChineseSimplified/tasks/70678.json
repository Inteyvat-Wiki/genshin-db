					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706785102
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706785102,
					"content": "如果愿意的话，客人不妨再试试登台表演，之后可以从宝箱里获得玩具勋章作为奖励哦！",
					"roleType": "TALK_ROLE_NPC",
