					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "旅行者，居然能在这里遇见你，看来社长说得没错，我们很有缘分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200102,
					"content": "你在这里做什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "是社长的嘱咐，为上次的工作做最后一点收尾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200104,
					"content": "其实就是给同心大人们送一些点心过去，感谢他们的协助罢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200105,
					"content": "他们应该感谢我们。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "话这么说没错。但这其实也就是借这个借口送点礼物过去，打点打点人情而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200108,
					"content": "毕竟，我们侦探社在将来可能会有很多事需要他们多多照拂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200109,
					"content": "这绝对是珊瑚教你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "呵呵，没错，你的直觉还是一如既往的敏锐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200112,
					"content": "那你自己怎么想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "我？天野和安藤…之前也和我共事过，给朋友送点点心，也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200114,
					"content": "但是…今天社长还让我去调查另外一件事，从时间上来看，我应该抽不出身了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200115,
					"content": "旅行者，能请你帮我把这些点心送给三个人吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200116,
					"content": "交给我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "多谢你愿意帮忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200121,
					"content": "这里有三份点心，要送给天野和安藤，还有大和田先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200122,
					"content": "大和田先生？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "他也是我之前的…同事。在我离开奉行所之前，对我很照顾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200124,
					"content": "在之前处理连环盗窃案时，他也在奉行所那边帮了我们一些忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200125,
					"content": "那这件事就拜托你了，旅行者。你把点心送过去之后，我们再回来这里碰头吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200118,
					"content": "你去送比较好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "还是…社长的委托比较要紧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200120,
					"content": "之后我会再找时间去拜访那三位的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200110,
					"content": "一听就是珊瑚找的理由…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "不是我们协助了他们吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
