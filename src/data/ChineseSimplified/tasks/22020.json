				"objectNames": [
					"龙二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "辛苦你了，旅行者，礼物都…交给他们了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200502,
					"content": "这都是珊瑚让你做的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "你…都发现了？抱歉…让你去送礼物这件事，确实是社长的嘱咐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200505,
					"content": "社长说，想要彻底解决当年我的那桩案件，把幕后的真凶揪出来，你是不可或缺的帮手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200506,
					"content": "这案子还没有彻底解决吗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "没有。社长说，当年她找到那个「犯人」时，一切都…太完美了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200508,
					"content": "在社长开展调查后，线索，动机和证据几乎都是自己跑到了社长手里，而且都齐齐指向那个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200509,
					"content": "虽然最后奉行所将那个人作为犯人处理，但社长始终认为，真正的犯人另有其人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200514,
					"content": "我想，她之所以愿意把我收进社里工作，一定也是为了找到侦破那桩案子的机会吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200515,
					"content": "但是，我又能帮上什么…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "社长的心思…我从来都猜不透。但她有一次和我说，或许是因为她一直待在稻妻，眼界已经变得狭窄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200517,
					"content": "如果能有一个见识广阔，又无拘无束的人愿意来帮忙，说不定这桩案子的侦破工作就能有突破性的进展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200518,
					"content": "旅行者，或许社长觉得，你就是那个能帮她忙的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200519,
					"content": "那我也算是「侦探」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "如果你愿意帮忙的话，那是当然了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200523,
					"content": "但无论如何，你帮了我们侦探社这么多忙，这一次的报酬还请你先收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200524,
					"content": "这些话，也是珊瑚教的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "不，这一次，这些话都是我自己想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200526,
					"content": "再次感谢你的协助。如果你愿意的话，还请多来我们那边转转吧，社长应该…也会十分欢迎你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200521,
					"content": "这桩案子，报酬不少吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "那我可说不准，但是…一定会是一笔足够让你满意的报酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200510,
					"content": "这案子是珊瑚说的「完美犯罪」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "是的。社长说，当年她找到那个「犯人」时，一切都…太完美了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200512,
					"content": "在社长开展调查后，线索，动机和证据几乎都是自己跑到了社长手里，而且都齐齐指向那个人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200513,
					"content": "虽然最后奉行所将那个人作为犯人处理，但社长始终认为，真正的犯人另有其人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "龙二"
				},
				{
					"id": 220200503,
					"content": "你直接把事情告诉我就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
