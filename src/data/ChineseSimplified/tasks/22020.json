			"trigger": {
				"objectNames": [
					"天野",
					"安藤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "哦？旅行者，你怎么来了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200202,
					"content": "这是龙二送给你们的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "哦？我看看…这不是「绯樱饼」嘛，龙二这小子还真是客气…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200204,
					"content": "#喂，安藤，你也别这么警惕了嘛。虽然这位旅行者是外国人，但{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}不是刚帮了我们吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200205,
					"content": "亏那小子还记得我们喜欢吃的东西，没白和他同事一场…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200206,
					"content": "龙二之前和你们共事过？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "啊？他没和你提过吗？我俩之前确实和他共事过很短一段时间。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200208,
					"content": "不过，那家伙不知道为什么，突然卷入了一个事件里。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200209,
					"content": "虽然最后托珊瑚的福，把那个真正的犯人揪了出来，帮龙二脱了罪。但那家伙在那之后也离开奉行所，去珊瑚那边工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200210,
					"content": "除了这些之外，再多的我也不知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200211,
					"content": "好了，说到这里就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220200212,
					"content": "唔，也是。不过那小子在珊瑚那边过得可比我们滋润太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200213,
					"content": "要是可能的话，我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200214,
					"content": "我说你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220200215,
					"content": "咳！不说了不说了，谢谢你旅行者，这些点心我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220200216,
					"content": "记得帮我给龙二和珊瑚问个好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "天野"
				}
			]
		},
