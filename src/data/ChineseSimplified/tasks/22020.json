			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "唔…这个地方还不错吧。我可是经常来这里透气的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200405,
					"content": "景色不错，空气也很新鲜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200406,
					"content": "有什么想问的，就在这里问吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200407,
					"content": "你也是龙二之前的同事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "是龙二告诉你的吗？没错，之前龙二确实和我共事过。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200411,
					"content": "当年发生的那件事，不知道龙二有没有和你提过，你知不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200412,
					"content": "简单来说的话，就是龙二那小子因为太冲动，落进了人家已经设好的陷阱，成了替罪羊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200413,
					"content": "就算是我出来为他担保，负责判决的人还是执意定他的罪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200414,
					"content": "虽然我也拜托了很多人调查，但最后要么无功而返，要么反过来告诉我，不要再接着查下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200415,
					"content": "呵呵，当时的我…怎么说呢，也听从了告诫，没有再查下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200416,
					"content": "这件事和「龙二是冤枉的」这件事一样，都是众人皆知的秘密，所以告诉你了也没关系。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200417,
					"content": "既然大家都知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "正因为所有人都意识到「大家都知道」，所以反而没有人敢再插手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200419,
					"content": "不过，还好有一个「什么都不知道」的侦探恰好来奉行所办事，对这件案子产生了兴趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200420,
					"content": "在这位侦探的行动下，那桩案子最终得以侦破，龙二也洗清了冤屈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200421,
					"content": "然后，龙二就离开了奉行所，从此在那个侦探的手底下做事。故事到这里就结束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200422,
					"content": "你为什么告诉我这些？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "是谁让你把这份礼物送给我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200424,
					"content": "是龙二。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "龙二之所以会送礼物过来给我，想必也是「社长的嘱咐」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200426,
					"content": "以龙二的性格，如果珊瑚让他亲自送礼物过来，那我就算是住在火海里，他也会把礼物毫发无损地亲自送过来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200427,
					"content": "如果龙二让你转交礼物给我，那么一定也是珊瑚嘱咐他这么做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200428,
					"content": "是珊瑚想让我知道这件事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "哈哈哈，你的反应倒也不慢。现在你在这里，几乎就相当于珊瑚在和我说：「我有了个新帮手」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200430,
					"content": "看来，她对当年的事还耿耿于怀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200431,
					"content": "也难怪，毕竟…到现在她也没有找到真正设下那个陷阱的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200432,
					"content": "好了，能告诉你的事，我已经全都告诉你了。到底要不要上珊瑚的这艘船，你就自己决定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200433,
					"content": "哦对了，你回去的时候，顺便帮我谢谢龙二的「绯樱饼」吧，我一直很喜欢吃这个。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200409,
					"content": "龙二为什么会离开奉行所？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "他之所以离开奉行所，当然是他自己的选择。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "大和田"
				}
			]
		},
		{
			"id": 2202005,
