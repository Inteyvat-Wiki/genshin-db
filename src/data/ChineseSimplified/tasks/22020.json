				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "喔？你是…那位金发的旅行者吧，我听天野提起过你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200302,
					"content": "怎么，找我有什么事吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200303,
					"content": "这是龙二送给你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "哦呀，居然是「绯樱饼」，这可不能随随便便就吃掉，得找个合适的地方好好品尝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200305,
					"content": "上杉，稍微在这里代我一下。如果有人来找我，就让他们等一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200306,
					"content": "大和田先生，现在可是上班时间…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 220200307,
					"content": "哈哈哈，没关系，只不过是出去透透气而已，很快就回来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200308,
					"content": "唉…好吧，但您可要快点回来，要是哪位大人突然过来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 220200309,
					"content": "放心吧，奉行所刚刚破了一桩案子，就算是来人，应该也是过来嘉奖的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200310,
					"content": "那么就交给你，上杉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 220200311,
					"content": "旅行者，和我一起出去转转吧，我知道一个地方，很适合悠闲地吃掉这些点心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大和田"
				}
			]
		},
		{
			"id": 2202004,
