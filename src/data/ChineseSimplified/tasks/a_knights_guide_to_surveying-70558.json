			"dialogs": [
				{
					"id": 705580101,
					"content": "教官，你看这条测绘路线设计得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580102
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580102,
					"content": "这里的高度…还有障碍…兼顾了实际情况和测试难度…甚至还保留了一定的趣味性，你做得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580103
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580103,
					"content": "特雷斯阁下，我觉得，我可以教给你的知识已经不剩多少了，接下来主要是巩固与举一反三…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580104
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580104,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580105
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580105,
					"content": "特雷斯还在担心什么呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580106
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580106,
					"content": "如果我要有你这样的学习速度，第八小队的枪匠们…尤其是科赫，都要把我当成典范供起来，敲打那些偷懒鬼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580107
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580107,
					"content": "埃洛雯已经做得很好了啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580108
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580108,
					"content": "这次用的标定物，不都是你做的吗？如果要让我来的话，呃，大概会被洛恩副队长放在什么「不明物品展示柜」里吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580109,
						705580110
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580109,
					"content": "在忙什么呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580111
					]
				},
				{
					"id": 705580111,
					"content": "怎么这么多人聚在一起…是骑士团的野餐环节吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705580112,
					"content": "啊，是荣誉骑士前辈和派蒙，你们好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580113
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580113,
					"content": "这位是特雷斯阁下，最近洛恩副队长让他过来和我交流学习测绘技术，于是我们一起设计了「测绘寻物」的挑战…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580114
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580114,
					"content": "这位是埃洛雯，和我一样也是游击小队的队员，这两天帮了我们大忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580115
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580115,
					"content": "#是大名鼎鼎的荣誉骑士前辈和{M#他}{F#她}的好伙伴派蒙啊！百闻不如一见，真是气度不凡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580116
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580116,
					"content": "嗯，嗯？！天哪，见到最厉害，最出名的风云人物了…我该怎么办好…埃洛雯，快想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580117
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580117,
					"content": "欸？不、不用这么紧张？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705580118,
					"content": "嗯…不用担心，埃洛雯只是有时候会沉浸于一些「状态」中——现在应该是「超级崇敬状态」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580119
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580119,
					"content": "展现出更多样的个性，让对方捉摸不透真实的你…嗯嗯，我又学到了一些新东西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580120
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580120,
					"content": "…特雷斯，你也未免太好学了啦。作为没什么资历的晚辈，见到最厉害的骑士，紧张不是很正常吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580121
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580121,
					"content": "更何况，现在正是要签名的绝佳时机啊…等、等等，我想想该怎么说出口好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580122
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580122,
					"content": "你已经说出口了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580123,
						705580124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705580123,
					"content": "满足这个小小心愿可不在话下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580125
					]
				},
				{
					"id": 705580125,
					"content": "天哪！那我一定会好好保存的…嗯？今天真是一个好幸运的日子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580126
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580126,
					"content": "哦对哦对，还要感谢米卡，要不是你来找我帮忙，我也不可能碰到这么棒的机会…下次你有需要，我还来帮你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580127
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580127,
					"content": "嗯？那先多谢了…主要还是因为我们荣誉骑士前辈和派蒙平易近人、待人真诚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580128
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580128,
					"content": "你也不要老是忘掉自己的功劳！你这个样子，同事拿薪水都良心不安了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580129
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580129,
					"content": "在这方面，特雷斯简直和你如出一辙，明明完全掌握了测绘技巧，但表现出来的时候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580130
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580130,
					"content": "哎，不对！如果现在是在战场上，我作为敌方，已经狠狠地被欺骗了！等等，这难道也算是你们的小计谋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580131
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580131,
					"content": "咦？还有这种逻辑？我一下子也没反应过来！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580132,
						705580133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705580132,
					"content": "或许是只对测绘精益求精。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580134
					]
				},
				{
					"id": 705580134,
					"content": "荣誉骑士太夸奖我了…其实，测绘这件事，确实总会让人觉得自己做得不够，因为结果往往影响的不仅仅是你自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580135
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580135,
					"content": "教官说得没错，所以我总想着…时时刻刻把控好每一个细节，务必小心、小心、再小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580136
					],
					"speakerTitle": "特雷斯"
				},
				{
					"id": 705580136,
					"content": "那说到这，不如让我们荣誉骑士前辈来试试特雷斯设计的「测绘寻物」挑战？正好看看我们特雷斯的水平究竟如何！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580137
					],
					"speakerTitle": "埃洛雯"
				},
				{
					"id": 705580137,
					"content": "唔，这似乎是个好主意…如果荣誉骑士前辈和派蒙有空的话…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580138
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580138,
					"content": "没关系吗？测绘…听起来就很复杂欸，没学过相关的东西也能来吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580139,
						705580140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705580139,
					"content": "我是新手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580141
					]
				},
				{
					"id": 705580141,
					"content": "啊，新手也没关系的…我们的目的就是设计出「门外汉也能一遍学会的测绘路线」，这样才有助于深入浅出地引导新兵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580145
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580145,
					"content": "多亏上次联合演习牵线搭桥…这次我们得到了各国友军的帮助，得以在不同的地形条件下进行测绘寻物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580146
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580146,
					"content": "当然，作为回报，最后我们总结的经验教训，也要与友军们共享，可谓是一起变强！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580142
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580142,
					"content": "即便地形多样，测绘的复杂度较高…对于冒险经验无人可敌的荣誉骑士前辈而言，应该也只是趣味游戏的难度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580143
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 705580143,
					"content": "这么一说，我们倒是可以试试看了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705580144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705580144,
					"content": "#反正，{NICKNAME}也很擅长现场学习，原地变成任何领域的专家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705580140,
					"content": "派蒙也是外行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580141
					]
				},
				{
					"id": 705580133,
					"content": "米卡总是严格要求自己啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580134
					]
				},
				{
					"id": 705580124,
					"content": "我听到了，这签名你非收不可。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580125
					]
				},
				{
					"id": 705580110,
					"content": "好热闹啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705580111
					]
				}
			]
		}
	]
}