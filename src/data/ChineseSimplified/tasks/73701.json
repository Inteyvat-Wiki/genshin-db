	"talks": [
		{
			"id": 7370101,
			"completionStepIds": [
				7370101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370101",
							"2"
						],
						"stepId": 7370101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖尔宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737010101,
					"content": "啊呀，斯露莎看起来没什么精神的样子，是训练遇到什么阻碍了吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010102
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010102,
					"content": "该说是阻碍呢还是困惑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010103,
					"content": "向祖尔宛说明了此前的对话内容…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737010104
					]
				},
				{
					"id": 737010104,
					"content": "原来是这样，不过，人类记录下来的东西与实情并不相符倒也不是什么新鲜事了，毕竟是健忘又偏执的种类。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010105
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010105,
					"content": "想来世事大抵如此，旁观者虽能纵览全局但却无法体察其中忽微，亲历者虽置身其中但又难免囿于己见。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010106
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010106,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010107,
					"content": "感觉没起到什么安慰的作用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010108
					]
				},
				{
					"id": 737010108,
					"content": "原来你们是想让我来说些暖心的话宽慰斯露莎吗？别忘了，这可是她的训练内容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010109
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010109,
					"content": "遇到困难时自己想办法解决困难，这才是训练的目的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010110
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010110,
					"content": "好像是这个道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010111,
					"content": "如果斯露莎连这点小事也做不好，那只能说她愧对花灵勇者的名号，也担不起「双角的花冠」的重量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010112
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010112,
					"content": "到时候，就算是仁慈如我，也只好狠下心来…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010113
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010113,
					"content": "会、会没收花冠吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010114,
					"content": "惩罚的内容嘛，就等到真的失败时再揭晓吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010115
					],
					"speakerTitle": "祖尔宛"
				},
				{
					"id": 737010115,
					"content": "呜…斯露莎也不想头顶凉飕飕吧，之后得加倍努力才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7370106,
			"completionStepIds": [
				7370106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370106",
							"2"
						],
						"stepId": 7370106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737010601,
					"content": "明明是看惯了的景色，现在却只觉得心情复杂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010602
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010602,
					"content": "呃…往好处想，这说明斯露莎比起从前有成长了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010603,
					"content": "究竟是成长还是退化而不自知…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010604
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010604,
					"content": "打起精神来呀斯露莎，这么灰心丧气的样子，一点都不像你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010605,
					"content": "对了，既然来都来了，不如斯露莎给我们讲讲矫论团最初的历史？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010606,
					"content": "虽然现在是这副模样…但是建立之初一定还是有可取之处的吧？否则祖尔宛也不会帮助他们，斯露莎也不会被他们所吸引了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010607,
					"content": "好吧，既然你们想听…不过，你们知道的，我的诞生是在矫论团建立之后，所以在那之前的事我也只是听说。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010608
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010608,
					"content": "据说，在一切发生以前，就有纯白的一群试图将灾难即将发生的消息传递出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010609,
					"content": "但只是传递消息，并不能阻止灾厄降临。很快，漆黑的浪潮席卷了大地，万物众生悚惧不已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010610
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010610,
					"content": "就像我们之前见到的风蚀沙虫的结晶，就连那样强壮的生灵也在最初的劫祸中罹难了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010611
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010611,
					"content": "相比之下，人类这样柔弱的生物，就算作鸟兽散也不是什么值得苛责的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010612,
					"content": "但偏偏有些人，却奔着灾厄涡旋的正中而来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010613,
					"content": "这些人就是最初的矫论团吗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010614,
					"content": "嗯。其中为首的正是那伽朱那，他们原本是深林之中的学者，但却为了平息灾厄的余波而扎根此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010615
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010615,
					"content": "对了，还有个金发的…前辈虽然对他言及不多，但是应该至少是个「有趣」的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010616
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010616,
					"content": "#唔…可惜是几百年前的人物，不然真想让{NICKNAME}和他见见，当面比一比谁更「有趣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010617,
						737010618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010617,
					"content": "这有什么好比的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010619
					]
				},
				{
					"id": 737010619,
					"content": "接着说，在我诞生之后，灾厄的余波也已经平息得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010620
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010620,
					"content": "所以斯露莎已经没什么可做的了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010621,
					"content": "唔…也不是完全无事可做，毕竟污秽没有完全根除的一天。只是…像神鸟「西摩格」那样壮烈灿然的牺牲不再是必须的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010622,
					"content": "更何况在我之前，米希尔、拉沙鲁这些花灵早就各司其职了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010623
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010623,
					"content": "在那伽朱那之后，前辈就渐渐不和矫论团的人类往来了，但是对方显然还是对我们花灵十分在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010624,
					"content": "这也不奇怪，毕竟对他们来说，吾辈花灵就是颂诗的主角嘛，会有钦慕之情也是理所应当。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010625,
					"content": "那时我常常听他们高声诵读诗篇，久而久之，神鸟献身的景象也似乎变得愈发鲜明了。前辈说起这些时却是轻描淡写…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010626,
					"content": "听起来像是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010627,
					"content": "被人类的花言巧语给…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010628
					]
				},
				{
					"id": 737010628,
					"content": "怎么会？我明明是被神鸟的慈爱与意志所打动才决心效法的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010629
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010629,
					"content": "跟矫论团的人类交好也只是因为，他们会毫无保留地对我讲述过去发生的事…当、当然，适度的赞美也不是完全没有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010630
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010630,
					"content": "同样一个故事，用夸张的讲法来讲会比较吸引人嘛，我也喜欢听精彩的故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010631,
					"content": "哦！不过初衷是为了记录真实的历史的话，这样就有大麻烦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010632,
					"content": "对啊，无论是我还是矫论团的人类，渐渐习惯了将夸张变成普通，这才会变成现在的样子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010633
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010633,
					"content": "矫论团的文献典籍里不再只是简单的事实记录，而是充满了各种言辞的修饰与主观的注解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010634
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010634,
					"content": "…而我也不知不觉重视声名而胜过行动本身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010635
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737010635,
					"content": "斯露莎好像想明白了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010636,
					"content": "至少比来时看起来有精神了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010637
					]
				},
				{
					"id": 737010637,
					"content": "这不是好事么，嘿嘿，这下就算是祖尔宛也不会说出要把花冠没收这种话了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737010638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010638,
					"content": "斯露莎的训练还剩最后一点就结束了，肯定可以得到祖尔宛的认可的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737010618,
					"content": "那我赢定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737010619
					]
				}
			]
		}
	]
}