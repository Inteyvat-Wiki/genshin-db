				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "药已经配好了， 但是这种药治标不治本，想要彻底根除的话，要一直服药静养才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600802,
					"content": "我和他说过很多次，他似乎都没听进去，一直说这样就可以了，无论是谁都劝不动。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600803,
					"content": "好了，请你们快点把药带给特纳先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600804,
					"content": "谢谢你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600805,
					"content": "不客气，我只是做了分内的事而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600806,
					"content": "麻烦你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600807,
					"content": "没事。唉…如果有一个人能照顾特纳先生的话，他也不用一直服药了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉丽安娜"
				}
			]
		},
