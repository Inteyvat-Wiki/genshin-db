				"points": []
			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "等等…我看看，我们带着的甜甜花好像已经够数了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200600402,
					"content": "要直接拿去给<color=#00E1FFFF>吉丽安娜修女</color>吗？还是去再找一些？",
