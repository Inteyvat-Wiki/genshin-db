					"盖伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "呃，你好！你手上拿的是甜甜花吧。虽然很唐突，你能不能卖给我一份？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 200600502,
					"content": "我老爹一直在咳嗽，我问吉丽安娜小姐要了份止咳的药方，但是她那边材料已经用光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 200600503,
					"content": "我也是去配药的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "是，是这样吗？那还是算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 200600505,
					"content": "抱歉，耽误了你的时间，赶紧去教堂吧，吉丽安娜小姐还在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盖伊"
				},
				{
					"id": 200600506,
					"content": "甜甜花应该很好找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "啊？哦…我知道，但是我还要守门呢，实在是抽不开身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 200600508,
					"content": "就是去问吉丽安娜小姐，我也只能趁着午休的时候赶紧问了问。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "盖伊"
				},
				{
					"id": 200600509,
					"content": "算了，看你的样子，应该也是去配药的吧…不耽误你了，快点去教堂吧，吉丽安娜小姐应该还在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盖伊"
				}
			]
		},
