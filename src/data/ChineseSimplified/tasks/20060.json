			"dialogs": [
				{
					"id": 200600701,
					"content": "特纳先生可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600702,
					"content": "我是来配药的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "咦？不是摩可和海莉来吗，怎么今天是你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "吉丽安娜"
				},
				{
					"id": 200600704,
					"content": "材料已经搜集到了吧，我来看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉丽安娜"
				}
			]
		},
		{
