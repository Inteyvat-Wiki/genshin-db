			"trigger": {
				"objectNames": [
					"特纳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "你好，客人，你知道我儿子盖伊吗？咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600102,
					"content": "你怎么了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "没事没事，老毛病了，没什么大问题，但就是一直好不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600104,
					"content": "之前去<color=#00E1FFFF>教会</color>里也看过了，修女们也不能一口气治好，只能开药缓解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600105,
					"content": "唉，我年纪大了，也走不了太长的路，之前都是请摩可和海莉帮我去配药。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600106,
					"content": "她们今天刚好有事…咳咳…我已经和<color=#00E1FFFF>吉丽安娜小姐</color>说好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600107,
					"content": "只要带着材料过去，她就会把药配好。只要<color=#00E1FFFF>三份甜甜花</color>就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600108,
					"content": "好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600109,
					"content": "咳咳，咳…那就拜托你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600112,
					"content": "就三份甜甜花，然后去教会找吉丽安娜修女配药，<color=#00E1FFFF>千万别让盖伊知道。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600113,
					"content": "我听说，教会和西风骑士团也有关系吧，那小子是西风骑士，可要时刻注意自己的言行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600114,
					"content": "要是为了我这个老头子犯了什么错，那就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600115,
					"content": "抱歉，让你听我唠叨了半天，快点去吧，路上小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600110,
					"content": "可以让你儿子盖伊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "特纳"
				},
				{
					"id": 200600111,
					"content": "哎呀，孩子在外面奋斗，我们老家伙怎么能拖后腿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "特纳"
				}
			]
		},
