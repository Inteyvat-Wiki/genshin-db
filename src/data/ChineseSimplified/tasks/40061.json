				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "今天海祇岛刮起了南来风，我就料想会有好友来拜访。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610102,
					"content": "#每次你这么一说话，我和{NICKNAME}就要奔波大半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400610103,
					"content": "不要这么说嘛。我们不是，好搭档吗？最好的那种。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610104,
					"content": "不过今天，我确实有件事想要拜托你们。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610105,
					"content": "相传，我家先祖在珊瑚宫海祇御灵祭之事外，还追加了另一套试炼。和海祇岛存亡无关，和真相有关。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610106,
					"content": "另一套…试炼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400610107,
					"content": "现在海祇岛的存亡危机既然已经解除了，那我就出于祖传的义务与责任提醒你们一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610108,
					"content": "你们可以去那个所谓的「蛇心之地」的某处，寻找第二试炼的线索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610109,
					"content": "哎呀，解脱了，轻松了。这份沉重的责任可以传给我未来的女儿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610110,
					"content": "祖传的任务就是说这么简单的一句话吗！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400610111,
					"content": "…我至今还是有点跟不上露子的思维…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}