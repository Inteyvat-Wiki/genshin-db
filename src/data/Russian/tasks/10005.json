			"dialogs": [
				{
					"id": 100050201,
					"content": "Альбедо! Паймон знала, что мы найдём тебя здесь. О! Ты рисуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100050202,
					"content": "Да. Наконец-то у меня появилось свободное время, и я решил взять кисть и попрактиковаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050203,
					"content": "Да, много чего произошло...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "Несомненно. Благодаря твоей помощи и помощи моих товарищей-рыцарей, дело было решено без особых проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050205,
					"content": "Кроме того, я смог выполнить последнее задание, которое оставила мне наставница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050206,
					"content": "Я не мог и мечтать о лучшем исходе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050207,
					"content": "Сахароза быстро прогрессирует в учёбе и может самостоятельно выполнять многие алхимические проекты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050208,
					"content": "У Ордо Фавониус на данный момент нет для меня никаких заданий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050209,
					"content": "Никаких обязанностей, никаких задач, никаких проблем, которые нужно решать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050210,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "Нет. Просто странно, когда не нужно ломать голову над решением всевозможных проблем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050213,
					"content": "Честно говоря, мне сложно привыкнуть к беззаботной жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050214,
					"content": "Я всё время думаю, нет ли каких-то вопросов, которые нужно решить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050215,
					"content": "Но, к сожалению, в Мондштадте на данный момент всё спокойно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050216,
					"content": "Нет ничего плохого в том, чтобы наслаждаться личным временем. Нет ничего хорошего в том, чтобы работать до седьмого пота.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100050217,
					"content": "Если тебе настолько скучно, можешь пойти с нами! Паймон научит тебя истинному искусству безделья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100050218,
					"content": "Ха-ха, надо учиться у лучших.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 100050219,
					"content": "А если ты ищешь неприятностей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "#{F#Путешественница}{M#Путешественник}! Не говори так! Ты нас сглазишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100050220,
					"content": "...у меня талант их находить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "Ты как будто расстроен...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
