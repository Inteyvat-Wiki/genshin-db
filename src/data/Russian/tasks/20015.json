				"points": []
			},
			"dialogs": [
				{
					"id": 200150301,
					"content": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150302
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200150302,
					"content": "Dala beru yo?! Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150303
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 200150303,
					"content": "Kundala gusha! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150304
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200150304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150305
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 200150305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150306
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 200150306,
					"content": "Ух ты! Кажется, он меня понял. Смотри, он хочет нам что-то показать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150307
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200150307,
					"content": "#Это... это оружие! Аааа! Путешественни{F#ца}{M#к}, на помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
