			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элла Маск"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200150101,
					"content": "#Эй, путешественни{F#ца}{M#к}, я здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150102
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200150102,
					"content": "Осторожно, не вспугни тех хиличурлов! Почему ты постоянно без разговоров крушишь их лагеря?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150103
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200150103,
					"content": "Ладно, это неважно. Я уже давно учу язык хиличурлов и сейчас наконец-то смогу попрактиковаться с носителями! Это в сто раз интереснее, чем учить язык по скучным книжкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150104
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200150104,
					"content": "А тут целый лагерь хиличурлов! Я не могу упустить такую возможность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 200150105,
					"content": "#Ну что, путешественни{F#ца}{M#к}, поможешь мне пройти в их лагерь и найти для практики хиличурла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
		{
			"id": 2001502,
			"completionStepIds": [
				2001503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
