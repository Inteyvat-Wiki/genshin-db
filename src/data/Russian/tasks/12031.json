	"talks": [
		{
			"id": 1203101,
			"completionStepIds": [
				1203101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203101",
							"2"
						],
						"stepId": 1203101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "Что ж, помощнички. Хорошо, что вы пришли, как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310102,
					"content": "Хм, это только ради гонорара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310103,
					"content": "Итак, Мико, и что именно нам нужно сделать для этого Хякки якко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310104,
					"content": "А то мы так-то даже понятия не имеем, что это вообще такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310105,
					"content": "Хякки якко переводится как «ночное шествие духов». Звучит немного зловеще, но на самом деле это просто встреча ёкаев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310106,
					"content": "Прежде, когда ёкаи собирались вместе, они вдоволь напивались и один за другим взмывали в небо. И было их так много, что они собой заслоняли луну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310107,
					"content": "Но теперь воспоминания ёкаев, что просачиваются сквозь артерии земли, очень слабы. И летать они больше не умеют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310108,
					"content": "Так что я проведу ритуал созыва, чтобы собрать вместе все блуждающие воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310109,
					"content": "Когда придёт время, они соберутся в небе над Великим храмом Наруками. Исчерпав свою энергию, они с лёгким сердцем вернутся туда, где им место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310110,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "На самом деле всё уже давно готово к ритуалу. Помните заклинание и упоминание безлунной ночи, которые я добавила в наш роман?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310112,
					"content": "Да, что-то там о «Тайных заклинаниях Кицунэ» в безлунную ночь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310113,
					"content": "Именно. Только это не те заклинания, что исполняют желания. Эти заклинания даруют покой воспоминаниям артерий земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310114,
					"content": "Давайте вместе поможем им отправиться в путь, когда придёт пора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310115,
					"content": "И что требуется от меня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Скоро я начну подготовку к ритуалу и хочу попросить вас о двух услугах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310117,
					"content": "Во-первых, передайте жрицам, чтобы покинули гору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310118,
					"content": "Во время Хякки якко воспоминания ёкаев наполнят небо над Великим храмом Наруками. Нужно увести жриц, чтобы никто из них не стал одержимой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310119,
					"content": "После этого я начну ритуал, и воспоминания начнут собираться. Это займёт некоторое время. А вы побудьте у подножия горы Ёго и последите за монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310120,
					"content": "Воспоминания обычно рассеяны и не представляют угрозы. Но их сконцентрированная энергия, скорее всего, потревожит монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310121,
					"content": "Они попытаются подняться на гору. Вы не должны допустить этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310122,
					"content": "Ясно. А потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310123,
					"content": "Хмм... Что ж, если вам захочется прийти к храму и помочь, а заодно посмотреть на ёкаев вблизи, я буду не против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310124,
					"content": "#{NICKNAME}, идём скорей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
				1203102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203102",
							"2"
						],
						"stepId": 1203102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Маки",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "Уйти с горы? Это приказ госпожи Гудзи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 120310202,
					"content": "Да, Мико говорит, что ритуал может быть опасен для вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310203,
					"content": "Вот как... Я немедленно всех выведу. А как же вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 120310204,
					"content": "Нам нужно ещё кое-что для неё сделать. А потом мы вернёмся и проведём ритуал вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310205,
					"content": "Мы ведь переживаем за неё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Видимо, госпожа Гудзи полностью вам доверяет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 120310208,
					"content": "Раньше госпожа Гудзи никогда не позволяла присутствовать на её ритуалах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 120310209,
					"content": "Спасибо за помощь и... удачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Маки"
				},
				{
					"id": 120310210,
					"content": "Не переживай! Мы крепче, чем кажемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310206,
					"content": "Просто мы хотим увидеть ёкаев.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико",
					"Паймон",
					"Окадзаки Рикуто"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "Ребята, привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310402,
					"content": "Мико... Как же так? Ты ешь без нас?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310403,
					"content": "Ага. Вы же платите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310404,
					"content": "Я как представила, что могу бесплатно есть дорогущую еду и пить лучшее вино... Ох, как же я бежала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310405,
					"content": "Эй, шеф, видишь этих двоих? Счёт потом им принесёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310406,
					"content": "Как скажете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "Окадзаки Рикуто"
				},
				{
					"id": 120310407,
					"content": "Уф...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310408,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "Да что с вами? Присаживайтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310410,
					"content": "Вы просто обязаны попробовать эту рыбу. Она обитает только у острова Сэйрай, ночью её привезли в Инадзуму. Когда я делала заказ, она была ещё жива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310411,
					"content": "А вот это попробуете? Обычно такое дорогое вино мне не по карману.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310412,
					"content": "Если не переносите спиртное, то здесь огромный выбор соков. Цены на любой вкус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310413,
					"content": "Гр-р... Мико! Это уже слишком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310414,
					"content": "В прошлый раз, когда мы работали над романом, ты заказала нам только самые простые кусикацу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310415,
					"content": "Хм? Не помню такого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310416,
					"content": "Так всё и было.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "Ну и что? Вы же сами меня пригласили, так ведь? И вообще, я важная персона, стыдно было бы угощать меня чем-то заурядным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310419,
					"content": "Мико, эта еда стоит кучи деньжищ. Ты не боишься, что мы не сможем расплатиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310420,
					"content": "Хи-хи, об этом даже не беспокойтесь. Издан ещё один тираж нашего романа, так что вас ждёт щедрая оплата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310421,
					"content": "Что-о-о?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310422,
					"content": "#А-а-а! {NICKNAME}, она нас провела! С самого начала ей от нас была нужна только мора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310423,
					"content": "Не стоило терять бдительности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Ха-ха-ха! Видели бы вы сейчас свои лица. Вот умора! Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310426,
					"content": "Кстати, поскольку загаданные в безлунную ночь желания не исполнились, романы с заклинаниями вышли из моды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310427,
					"content": "#Так что вам придётся придумать что-то новое для следующей главы «Удивительных приключений путешественни{F#цы}{M#ка}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310428,
					"content": "И сдавать-то уже скоро. Так что не оплошайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310424,
					"content": "Нас обманули...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "Только кусикацу и жареный тофу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
