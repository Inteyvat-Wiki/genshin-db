			"dialogs": [
				{
					"id": 120290812,
					"content": "Тёмной-тёмной ночью монстры медленно собираются здесь...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 120310801,
					"content": "Эти монстры выглядят какими-то взвинченными!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310802,
						120310803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310802,
					"content": "Нельзя пускать их на гору.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310803,
					"content": "Давай-ка избавимся от них. Поможем Мико.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310804,
					"content": "Да-да, давай скорее с ними разделаемся и вернёмся на гору смотреть на ёкаев, хи-хи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310805,
					"content": "#{NICKNAME}, они нападают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
