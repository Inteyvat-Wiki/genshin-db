				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120311001,
					"content": "Спасибо вам за угощение. Истинное удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311002
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120311002,
					"content": "Ах да, я уже вам сказала? Эи видела наш ритуал созыва у Великого храма Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311003
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120311003,
					"content": "Я, конечно, знаю, что иногда она может упереться на пустом месте. Но всё равно меня застало врасплох её длиннющее письмо, в котором она меня обругала и сказала, что мы «зашли слишком далеко».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311004
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120311004,
					"content": "Даже не понимаю, зачем поднимать такой шум. Ведь все счастливы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				}
			]
		},
