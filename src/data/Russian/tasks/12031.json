				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120311901,
					"content": "#Ох, прямо не могу дождаться. Почему же следующая глава «Удивительных приключений путешественни{F#цы}{M#ка}» всё ещё не вышла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311902
					],
					"speakerTitle": "Кёта"
				},
				{
					"id": 120311902,
					"content": "Надо же, безлунная ночь и правда наступила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311903
					],
					"speakerTitle": "Осукэ"
				},
				{
					"id": 120311903,
					"content": "Да, огромное чёрное облако над горой Ёго той ночью. Оно просто возникло из ниоткуда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311904
					],
					"speakerTitle": "Тэцуо"
				},
				{
					"id": 120311904,
					"content": "Я загадал желание так, как описано в книге, но ничего не произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311905
					],
					"speakerTitle": "Осукэ"
				},
				{
					"id": 120311905,
					"content": "Эх, романы они и есть романы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311906
					],
					"speakerTitle": "Тэцуо"
				},
				{
					"id": 120311906,
					"content": "#Хватит с меня заклинаний из романов. Та ночь стала последней каплей. И всё же что-то подсказывает мне, что «Удивительные приключения путешественни{F#цы}{M#ка}» ещё долго будут оставаться интересными!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311907
					],
					"speakerTitle": "Осукэ"
				},
				{
					"id": 120311907,
					"content": "А? Паймон нигде не видит Мико.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120311908,
					"content": "Похоже, её здесь нет. Может быть, она уже зашла внутрь? Пойдём поищем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
