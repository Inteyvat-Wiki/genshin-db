			},
			"dialogs": [
				{
					"id": 120310901,
					"content": "Хм, как я и предполагала, ритуал прошёл как по маслу. Спасибо вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310902
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310902,
					"content": "Мико, с тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310903
					]
				},
				{
					"id": 120310903,
					"content": "Хм? Да, всё отлично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310904
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310904,
					"content": "Но твоё лицо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310905
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310905,
					"content": "Я в порядке! Правда. Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310906
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310906,
					"content": "Уф... Честное слово...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310907
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310907,
					"content": "Мико...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310908,
					"content": "Ну ладно, если хотите что-то для меня сделать, то давайте договоримся, что вы угостите меня обедом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310909
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120310909,
					"content": "Конечно! Мы приглашаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120310910,
					"content": "Угостить? Замётано!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310911
					]
				},
				{
					"id": 120310911,
					"content": "Тогда до встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				}
			]
		},
