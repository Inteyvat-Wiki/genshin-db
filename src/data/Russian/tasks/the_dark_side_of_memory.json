			"dialogs": [
				{
					"id": 60080201,
					"content": "Она плохо выглядит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080202,
					"content": "Прости за беспокойство. С тобой всё в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080204,
					"content": "Твоё состояние ухудшилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "...Голова кружится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080206,
					"content": "Кажется... скоро я вернусь на Луну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080207,
					"content": "Не может быть, чтобы ей было настолько плохо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080208,
					"content": "Хм? Я чувствую в твоём теле... силу Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080209,
					"content": "Мы забрали Лунный Светоч у Фатуи. Он может тебе помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Ммм... И что вам нужно на этот раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080211,
					"content": "Серьёзно? Это всё, о чём ты можешь думать сейчас? Твоё здоровье важнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080213,
					"content": "(Неужели... она так привыкла? Она долго жила там, где все использовали друг друга...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Возможно, в будущем мне понадобится твоя помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "...О. Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080216,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080217,
					"content": "Ох... Спасибо, я вернулась на землю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080218,
					"content": "Ты не сдвинулась с места... Тебе уже лучше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080219,
					"content": "Намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080220,
					"content": "Что ты сделала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "Луна в твоём теле... безмолвна, подобно отражению в воде... Восхитительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080223,
					"content": "Я лишь извлекла из воды лучик её света. Этого достаточно, чтобы не потерять связь с землёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080224,
					"content": "Кажется, я чувствую и другие изменения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "Это «благословение Богини Луны». Всё, с чем я соприкасаюсь, несёт на себе эту метку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080226,
					"content": "Она безвредна и со временем исчезнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080227,
					"content": "Кстати, не хочешь ли ты стать хранительницей Лунного Светоча, раз уж ты вернула себе силу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080228,
					"content": "Он ведь принадлежит «божеству», верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080229,
					"content": "Это останки Арии, Богини Вечной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080230,
					"content": "Какое это имеет отношение к... Что? Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080231,
					"content": "Вы не знали об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080232,
					"content": "Лаума сказала, что этот фрагмент отличается от других, и она чувствует в нём божественную силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080233,
					"content": "И она права. Когда я извлекла луч лунного света из Лунного Светоча, я также извлекла некоторые воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080234,
					"content": "Вот почему я знаю, что он принадлежит Богине Вечной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080235,
					"content": "Но Лаума тоже заглянула в прошлое, используя Лунный Светоч. Почему она не увидела этого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080236,
					"content": "(Лаума упоминала, что может улавливать лишь краткие, размытые фрагменты... Возможно, это нечто такое, что может почувствовать только Богиня Луны...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Когда-то на небе было три Луны, каждая из которых принадлежала своей богине, управлявшей ею.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080238,
					"content": "Но после войны погребального пламени все три были убиты, а две из трёх Лун были разбиты вдребезги во время противостояния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080239,
					"content": "После смерти Арии её сила превратилась в этот Лунный Светоч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080240,
					"content": "Останки Радужной Луны до сих пор не найдены, а Богиня Морозной Луны мертва, но её Луна так и не была разрушена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080241,
					"content": "Как гласило пророчество, однажды эта Луна породит новое божество - сущность, которую Дети Морозной Луны называют Куу{RUBY#[S]Дева Луны}тар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080242,
					"content": "Я чувствую, что моя сила связана с Морозной Луной. Но она находится за пределами ложного неба, слишком далеко от меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080243,
					"content": "Про контроль можно и не говорить... Чтобы только чувствовать её, требуется огромное усилие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080244,
					"content": "Погоди, дай Паймон всё обдумать... У нас есть Лунный Светоч Вечной Луны, никто не может найти Лунный Светоч Радужной Луны... А у тебя есть Лунный Светоч Морозной Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080245,
					"content": "Нет. Он может образоваться только после смерти Богини Луны. Считайте это разновидностью энергетического ядра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080246,
					"content": "Это всё равно что спросить, есть ли на Луне камни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080247,
					"content": "Хочешь сказать, что ты олицетворяешь силу Морозной Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080248,
					"content": "Да. Божество с Сердцем Бога называется Архонтом... Значит ли это, что ты Богиня Луны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080249,
					"content": "Это совсем другое...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "Ты не хочешь стать Архонтом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080251,
					"content": "Дело не в этом! И почему ты так стремишься передать этот титул кому-то другому?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080252,
					"content": "Ладно, не будем пока думать о том, как стать Богиней Луны. Мы хотим узнать, стоит ли нам вернуть тебе Лунный Светоч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080253,
					"content": "Я не хочу этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080254,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080255,
					"content": "И он тоже этого не хочет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080256,
					"content": "Что это значит?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080257,
					"content": "Когда я соприкоснулась с его силой, я почувствовала некое отторжение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080258,
					"content": "Полагаю, так происходит потому, что я тоже Богиня Луны. Две луны не могут взойти в одно и то же время и тем более не могут поглотить друг друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080259,
					"content": "Значит, он пока останется у меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "#Ты уверен{F#а}? Лаума говорила, что ты хорошо скрываешь эту силу, но Субретка сразу её почувствовала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080261,
					"content": "Да и Дикая Охота далеко не похожа на обычных врагов. Если она обнаружит Лунный Светоч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080262,
					"content": "Ты говоришь об этом явлении, словно описываешь человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080263,
					"content": "Похоже, что за ней стоит кто-то, причём с очень чёткой целью. И этот кто-то без устали охотится за Лунным Светочем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080264,
					"content": "Очень знакомо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080265,
					"content": "Что? Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080266,
					"content": "Мои коллеги упоминали о каком-то человеке, когда я ещё была среди Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080267,
					"content": "Он был родом из Каэнри'ах и овладел силой Бездны во время бедствия... И у него была пагубная привязанность к Лунам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080268,
					"content": "Каэнри'ах? Мы не знаем, имеет ли фантом, которого мы видели, какое-то отношение к этому, но подробности вроде бы совпадают... Как звали этого человека?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080269,
					"content": "Я знаю только то, как его называют другие, - Лунный мститель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080270,
					"content": "Один из Пяти Грешников?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Да, я слышала это прозвище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080272,
					"content": "А?! Дайн говорил о нём, верно? Значит, наш враг - Лунный мститель, один из Пяти Грешников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080273,
					"content": "Нет. Он должен быть сильнее...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Я слышала, что он исчез вскоре после бедствия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080275,
					"content": "Но когда я спросила своих коллег, куда он делся, они ответили: «Неужели ты не знаешь?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080276,
					"content": "Почему они так сказали?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080277,
					"content": "Говорят, он попал в «отражение Луны», откуда нет возврата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080278,
					"content": "Стоп, подожди... Слишком... много информации!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080279,
					"content": "Я чувствовала себя примерно так же. Они, похоже, считали, что я должна знать всё о Лунах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080280,
					"content": "Но, как я уже говорила... Моя «прелюдия» лежит за пределами лживого неба. Я даже не помню своего имени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080281,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080282,
					"content": "В общем, после его исчезновения ситуация с Дикой Охотой резко ухудшилась, и с тех пор она стала знамением бедствия Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080283,
					"content": "Нынешний феномен унаследовал это название, значительно превзойдя своё прошлое воплощение как по масштабам, так и по степени разрушительности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080284,
					"content": "Хм. Подумать только, мы противостоим одному из пяти легендарных Грешников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080285,
					"content": "Это перебор! Должно быть, тогда, на Звёздной отмели, нам просто повезло... Или, может быть, он не выкладывался на полную?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080286,
					"content": "И всё же... Он победил Марионетку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080221,
					"content": "#Или... Что я сделал{F#а}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
				600802,
				600803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Субретка"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Хм? Что ты там говоришь? Можешь повторить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080402,
					"content": "Э-э-э... Это твоя... бывшая коллега? Да, мы вместе были на Звёздной отмели, и её победила Дикая Охота...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080404,
					"content": "Ты... улыбнулась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080405,
					"content": "...Вовсе нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080406,
					"content": "(Определённо да!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080407,
					"content": "Вы не ладите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080408,
					"content": "Нет. Я всего лишь представила себе её потрясённое выражение лица после поражения и нашла это забавным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080409,
					"content": "Ей пришлось несладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080410,
					"content": "О, она скоро привыкнет. В этом ей нет равных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080411,
					"content": "#Так, мы отклонились от темы. Мы знаем, насколько опасен парень, нацелившийся на Лунный Светоч... Ты уверен{F#а}, что хочешь носить его с собой, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080412,
					"content": "Если верить разведке Фатуи, Лунный мститель одержит верх, даже если против него выступит весь Нод-Край.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080413,
					"content": "Возможно... на данный момент его что-то сдерживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Прежде чем я приму решение, я хочу попросить тебя об одолжении, Коломбина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "Мм? Говори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080417,
					"content": "#Как думаешь, ты сможешь показать мне, что произошло, когда мы с {F#моим братом}{M#моей сестрой} приземлились в Нод-Крае на нашем космическом корабле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080419,
					"content": "Как-то быстро ты согласилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080420,
					"content": "Я уже говорила, что для меня это лишь лучик лунного света. Ничего особенного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080421,
					"content": "Дай мне руку и приготовься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "#(То же самое, что я видел{F#а} раньше, только чётче...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(Мы благополучно приземлились...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Кажется, прошло много времени...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(Мы по-прежнему внутри космического корабля. Мы были там так долго... Интересно, когда {M#Люмин}{F#Итэр} успел{M#а} выйти?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Это... {M#Люмин}{F#Итэр}?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Как такое может быть? Никто не покидал корабль с того момента, как мы приземлились! Дверь до сих пор не открывали!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Что это за место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#Итэр}{F#Люмин}! Пойдём! Нужно скорее уходить!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "...А?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "Ты... в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080434,
					"content": "Наш космический корабль... После приземления прошло очень много времени...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#За это время никто не выходил из корабля, но {M#Люмин}{F#Итэр}... каким-то образом {M#нашла}{F#нашёл} меня снаружи корабля...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Что?! Как такое возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080437,
					"content": "Я не знаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "Тайны, сокрытые в воспоминаниях, подобны печенью. Откусишь, и оно крошится во все стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080439,
					"content": "#(Это... слишком подозрительно. Я {F#должна}{M#должен} узнать всю правду.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Но, как сказала Нефер, расследовать будет нечего, если Нод-Край будет уничтожен...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Хорошо. Я оставлю Лунный Светоч при себе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "А? Ну ладно, раз ты так говоришь. Но эта штука...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080444,
					"content": "Тебе понадобится моя помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080445,
					"content": "С чем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "Я могу помочь тебе спрятать Лунный Светоч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080447,
					"content": "Правда? Это было бы здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080448,
					"content": "Обнаружить его и так нелегко, но я могу научить тебя ещё лучше скрывать его присутствие с помощью куувяки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080449,
					"content": "Например, вот так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080450,
					"content": "О! Похоже на щит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080451,
					"content": "(Такой... мягкий и нежный... как лунный свет...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Чувствуешь? А теперь постарайся сохранить это ощущение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Ты быстро учишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080455,
					"content": "Выглядит довольно прочным. Наверное, его можно использовать для самообороны в случае необходимости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080456,
					"content": "Спасибо, что научила меня...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Ты всегда здесь, Коломбина? Снаружи, конечно, опасно, но ты выходила погулять или ещё куда-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080458,
					"content": "Кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080459,
					"content": "...Не люблю незнакомцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080460,
					"content": "И где мы находимся согласно твоей шкале?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Чуть выше незнакомцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080462,
					"content": "Когда с Дикой Охотой будет покончено...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "Точно! Дети Морозной Луны сильно изменились с нашей последней встречи. Кто знает, может, они тебе понравятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080466,
					"content": "Я подумаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080467,
					"content": "Похоже, она устала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080468,
					"content": "Возможно, она давно не говорила так много...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "В общем, спасибо, что согласилась помочь нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080470,
					"content": "...Пустяки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080471,
					"content": "Цветы любят таких гостей, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 60080463,
					"content": "...пойдём, прогуляемся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}