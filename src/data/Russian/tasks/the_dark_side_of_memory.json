			"dialogs": [
				{
					"id": 60080101,
					"content": "Посмотрим... что изменилось с нашего последнего визита?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080102,
					"content": "#Меньше, чем я предполагал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "Да. Похоже, всё налаживается. Лаума молодец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080104,
					"content": "Лаума, мы пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080105,
					"content": "Как прошли последние несколько дней?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "Заключительные работы оказались гораздо сложнее, чем я ожидала. Решить проблемы, которые накапливались в течение долгого времени, - задача не из лёгких.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080107,
					"content": "Думаю, мне потребуется ещё несколько недель. К счастью, те, кто остался, похоже, преодолели первоначальное замешательство и стали более инициативными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080108,
					"content": "Словно наконец обрели подлинную веру в столь непростое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080109,
					"content": "Всё благодаря тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080110,
					"content": "Нет. Нужно было сделать это раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080111,
					"content": "В последние несколько дней я заботилась о своём здоровье и теперь смогу помочь вам проникнуть в прошлое с помощью Лунного Светоча, который ты оберегаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080112,
					"content": "Спасибо, что помнишь об этом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "Кстати, ты слышала что-нибудь новое о том фантоме, с которым мы столкнулись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080114,
					"content": "Я поспрашивала, но безуспешно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080115,
					"content": "А вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080116,
					"content": "Мы тоже не добились особых успехов, но вот что у нас есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080117,
					"content": "Я уловила суть... Похоже, у вас тоже много работы. Пожалуйста, не забывайте следить за своим здоровьем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080118,
					"content": "#{NICKNAME}, тогда прошу за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "#Что ты увидел{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080121,
					"content": "(Это... Нод-Край? Всё так знакомо...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(Это... звезда в небе?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(Нет! Это наш космический корабль!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "Это... всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080125,
					"content": "Похоже, это было очень-очень давно. Воспоминания, которые я ощутила, в высшей степени неспокойны и беспорядочны. Это всё, что позволяет мне выявить моя сила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080126,
					"content": "(По крайней мере стало известно, что наш космический корабль приземлился в Нод-Крае... Точнее, возле Звёздной отмели.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#(Это совпадает с тем, что {M#сказала}{F#сказал} мне {M#Люмин}{F#Итэр}... Но я хочу знать больше...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 60080129,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080130,
					"content": "Цветы поменяли цвет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080131,
					"content": "(Эти цветы - отражение силы Субретки. Неужели её тело...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(Я помню, она упоминала, что хотела использовать Лунный Светоч, чтобы восстановить часть своей силы...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "Да, нужно навестить её и узнать, чем мы можем ей помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080135,
					"content": "Я надеюсь на вашу помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080136,
					"content": "Ах да, вот лекарство, которое ты просила у Куратория тайн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080137,
					"content": "Спасибо, что проделали этот путь и принесли его. Вы мне очень помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080138,
					"content": "И ещё... Если позволишь, мне кажется, что Куу{RUBY#[S]Дева Луны}тар может помочь тебе более детально разобраться в воспоминаниях о твоём космическом корабле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 60080139,
					"content": "Точно. Она же Куутар, в конце концов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080140,
					"content": "Но сперва нужно проверить, всё ли у неё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 60080141,
					"content": "До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
