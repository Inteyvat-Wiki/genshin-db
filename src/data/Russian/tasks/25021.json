				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кацкаль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Хора, на этот раз ты никуда не денешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210102,
					"content": "Р-р-р... Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250210103,
					"content": "Какой Хора сегодня послушный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "Ага. Всё дело в дрифтболе, который я сделал с твоей помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210105,
					"content": "Благодаря этому мячу Хора меня слушается. Купание, еда, сон и дрессировка, теперь всё стало намного проще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210106,
					"content": "Особенно стрижка когтей! Раньше я бегал за ним до потери пульса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210107,
					"content": "А теперь достаточно просто положить мяч перед ним, и Хора послушно садится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210108,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250210109,
					"content": "#Хора, ты помнишь {M#его}{F#её}? {M#Он помогал}{F#Она помогала} делать для тебя игрушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210110,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250210111,
					"content": "Сидеть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "Ого! Хора тебя помнит. Сколько радости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210114,
					"content": "Хочешь попробовать подстричь ему когти? Заодно можешь и рога протереть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210115,
					"content": "Это очень важно для детёнышей тепетлизавров. Они долбят скалы и роют землю, и их когти нужно постоянно полировать и стричь, если они ломаются или растут длинными и кривыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210116,
					"content": "Только так можно добиться идеальной формы когтей тепетлизавра, когда он вырастет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210117,
					"content": "Держи! Воспользуемся этим шансом и приведём Хору в порядок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210118,
					"content": "Сколько нюансов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "Р-р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250210121,
					"content": "Кхе... Хора редко бывает таким послушным. Меня радует мысль, что сегодня мне не придётся гоняться за ним по всему клану...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210122,
					"content": "Спасибо большое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "Пустяки! Ну что, приступим! Я буду говорить, что и как делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210124,
					"content": "Чтобы он расслабился, нужно аккуратно почистить его спину большой щёткой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210130,
					"content": "Затем начисть его рога щёткой с мягкой щетиной, только три увереннее, иначе останется грязь в бороздках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210125,
					"content": "Затем возьми полотенце и протри им Хору... Так он расслабится и высунет когти на всех четырёх лапах, вот тогда и можно будет их подстричь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210126,
					"content": "Какое подробное описание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "Само собой. Ведь я вырастил его. Во всём клане... нет, во всём Натлане нет никого, кто знал бы его лучше, чем я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210129,
					"content": "А теперь подстриги ему когти, следуя моим инструкциям. Я буду рядом. Если что-то непонятно, спрашивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250210127,
					"content": "Ты действительно хорошо знаешь Хору.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "Откуда взялось волнение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Погладить Хору.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
