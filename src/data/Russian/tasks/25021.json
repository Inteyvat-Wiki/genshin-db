			"trigger": {
				"objectNames": [
					"Кацкаль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Хора не может расслабиться и смотрит на вас в замешательстве.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212710,
					"content": "(Кацкаль сразу приступает к работе. Поухаживав за Хорой, ему наконец удаётся подстричь тому когти...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "Ничего, я тоже иногда неправильно его понимаю. Но Хора точно знает, что ты друг и желаешь ему добра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212702,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250212703,
					"content": "Ну вот, я же говорил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212704,
					"content": "Спасибо вам, друзья! Ик! Возьмите это!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212705,
					"content": "Сложно догадаться, что в голове у завриана. Мне пришлось провести с Хорой немало времени прежде, чем я научился его понимать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212706,
					"content": "Но мне и этого достаточно. Всё же нам ещё жить вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212707,
					"content": "А? Где Хора? Только не говорите, что снова сбежал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212708,
					"content": "Эй! Хора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				}
			]
		},
