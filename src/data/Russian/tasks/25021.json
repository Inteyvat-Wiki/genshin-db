				"objectNames": [
					"Хора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250213701,
					"content": "(Хора наклоняет голову, почёсывает живот, а затем растерянно смотрит на вас.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250213702,
					"content": "Ты не можешь всё время играть с Хорой. Однажды нужно приступить к настоящему делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213703,
					"content": "Кхе! Давай я помогу. Позволь продемонстрировать правильный способ мытья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213704,
					"content": "(Кацкаль сразу приступает к работе. Поухаживав за Хорой, ему наконец удаётся подстричь тому когти...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250213705,
					"content": "Не зацикливайся на игре с Хорой. У тебя ещё есть работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213706,
					"content": "Р-р-р! Р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250213707,
					"content": "Ха-ха-ха, похоже, ты нравишься Хоре. Неудивительно, что он такой послушный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213708,
					"content": "Спасибо тебе за помощь. Возьми это в знак моей благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213709,
					"content": "Хм, может быть... попробовать поиграть с Хорой, а уже потом мыть его?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213710,
					"content": "Хора, как тебе такая идея?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213711,
					"content": "А? Где Хора? Только не говорите, что снова сбежал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250213712,
					"content": "Эй! Хора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				}
			]
		}
	]
