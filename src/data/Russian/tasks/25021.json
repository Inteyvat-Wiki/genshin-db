			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кацкаль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Хора постепенно успокаивается. Он расслабляется, и на лапах показываются когти. Похоже, их тоже пора бы подстричь.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250212610,
					"content": "Вы подстригаете когти Хоре под руководством Кацкаля.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "Ха-ха-ха, не думал, что ты хорошо разбираешься в таких вещах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212602,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Хора"
				},
				{
					"id": 250212603,
					"content": "Хора тоже тебя благодарит. У тебя всё очень аккуратно вышло, теперь он будет копать быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212604,
					"content": "Держи, это подарок за помощь. Кстати, должен предупредить: если в будущем доведётся ухаживать за другими заврианами, не надо слепо копировать сегодняшний опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212605,
					"content": "У каждого завриана свой характер и к ним нужен разный подход. До сих пор я разобрался только в предпочтениях Хоры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212606,
					"content": "Но мне и этого достаточно. Нам ещё долго жить вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212607,
					"content": "А? Где Хора? Только не говорите, что снова сбежал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Кацкаль"
				},
				{
					"id": 250212608,
					"content": "Эй! Хора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кацкаль"
				}
			]
		},
