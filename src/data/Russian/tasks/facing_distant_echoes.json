			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Чжэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550201,
					"content": "Ха-ха, мы на месте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550202,
					"content": "Страшно даже подумать, что здесь могут быть и подземные руины... Ух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550203,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "Н-ничего. Совсем ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550206,
					"content": "Выглядишь ты неважно. Тебе нехорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726550207,
					"content": "Ха-ха... Просто я обычно не покидаю судно, так что этот вход в руины... ну, он впечатляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550208,
					"content": "Серьёзно? Паймон так не думает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726550209,
					"content": "#И... и всё же приказ капитана должен быть выполнен. Тебе, конечно же, очень интересно, какие сокровища могут там быть, верно, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550210,
					"content": "А потому... Могу ли я предложить тебе, со всем твоим опытом и навыками, возглавить наш поход?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550211,
					"content": "Ты - это что-то...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "#А вот и он! Ну же, путешественни{F#ца}{M#к}, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726550204,
					"content": "Нашла что-то новое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
		},
		{
			"id": 7265503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
