			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Чжэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550301,
					"content": "Хм... Может быть, тебе нужно разогреться, или что-то вроде того?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550302,
					"content": "Можешь рассказать мне что-нибудь об этих руинах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Ну, я ведь техник, а потому почти не знакома с историей континента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550305,
					"content": "Тем не менее я полагаю, что эти руины как-то связаны с огромной катастрофой, случившейся здесь пятьсот лет назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550306,
					"content": "Я выросла на этой легенде, которую то и дело рассказывали старые моряки... Она гласила, что ни суше, ни морю не увернуться от цепкой хватки Бездны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550307,
					"content": "Но для меня эта легенда ничем не отличалась от историй о призраках, которыми пугают детей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550308,
					"content": "Ведь истинными являются лишь те кошмары, которые видишь воочию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550303,
					"content": "Тебе что-нибудь известно об этих таинственных механизмах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
			]
		}
	]
}