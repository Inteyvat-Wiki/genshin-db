					"Му Чжэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550101,
					"content": "Что ж, похоже, мы, наконец, обнаружили нашу цель! Прекрасно! Думаю, теперь я могу вернуться на корабль и немного поспать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550102,
					"content": "Что? Ты просто возьмёшь и оставишь нас вот так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726550103,
					"content": "Конечно же нет! Мы так близки к цели! Давайте сейчас же двинемся в путь и схватим этот руинный механизм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Му Чжэнь"
				},
				{
					"id": 726550104,
					"content": "Хм, а вот Паймон подумала, что ты собираешься вернуться на корабль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726550105,
					"content": "Эх... Ладно, проехали. Следуем за ней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7265502,
			"completionStepIds": [
				7265503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265503",
							"2"
						],
						"stepId": 7265503,
						"stateName": "QUEST_STATE_UNFINISHED"
