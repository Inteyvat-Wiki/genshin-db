			"dialogs": [
				{
					"id": 750711001,
					"content": "#Ха-ха, {NICKNAME} и Паймон, моя муза и... э-э-э, мини-муза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711002,
					"content": "#О! И {REALNAME[ID(2)|SHOWHOST(true)]}, конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711003,
					"content": "Это кто тут мини?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750711004,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "Ха-ха, не обращайте внимания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711006,
					"content": "Ха, для Паймон это важно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750711007,
					"content": "Тебя снова посетило вдохновение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "Конечно, но... Хе-хе, это означает... что я снова вынужден просить вас о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711009,
					"content": "Ничего страшного! Ты ведь каждый раз платишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750711010,
					"content": "Ха-ха, отлично, мой маленький наёмник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711017,
					"content": "Смотри, я хочу сфотографировать тепетлизавра... Тсс, тише, не спугни его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711018,
					"content": "Я никогда раньше не встречал таких заврианов, но уже некоторое время наблюдаю за ними... Это поистине очаровательные существа, у каждого из которых под твёрдыми пластинами скрывается уникальная личность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711019,
					"content": "Этот выучил основные команды после того, как его несколько раз покормили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711020,
					"content": "Мне понадобится ваша помощь, дорогие укротители заврианов, чтобы взять его с собой и сфотографировать, как он общается с другими тепетлизаврами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711021,
					"content": "Ха-ха! Всё очень просто, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711022,
					"content": "Да, суперпросто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750711023,
					"content": "(Не то чтобы ты был очень занят...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "Ха-ха, да, вот это энергия! Помогите мне привести отбившегося от остальных тепетлизавра, и мы начнём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711024,
					"content": "(Всё не так просто, как ты думаешь!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "Нужны муссы? Опять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "Мусс... Паймон очень хочется попробовать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750711013,
					"content": "Гр-р, гр-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "Музы! Не еда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "Магнифико"
				},
				{
					"id": 750711015,
					"content": "Если заплатишь нам, мы обменяем мору на еду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750711016,
					"content": "Как скажешь, Паймон... Но моры у меня достаточно, так что можете не беспокоиться о том, что потратите время впустую!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Магнифико"
				}
			]
		},
