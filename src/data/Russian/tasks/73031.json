						730310308
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730310308,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310309,
					"content": "Подготовка к Празднику Утсава почти завершена. Жду с нетерпением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310310,
						730310311
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730310310,
					"content": "Интересно, как там Рана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#{NICKNAME}, нужно проверить, как она там. Может, ей стало лучше? Тогда мы сможем привести её на праздник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310316,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "Я тоже навещу Арану, но чуть позже. Идите без меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730310321,
					"content": "#Нара {NICKNAME}, Паймон, ещё увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арама"
				},
				{
					"id": 730310317,
					"content": "Хотелось бы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "#Я бы не стал{F#а} слишком надеяться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310311,
					"content": "Я тоже жду с нетерпением.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "Интересно, насколько он отличается от других праздников? Паймон так рада, что сможет отпраздновать его вместе с друзьями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310314,
					"content": "Вот бы и Рана была с нами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310306,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310307
					]
				}
			]
		},
