			"dialogs": [
				{
					"id": 730310101,
					"content": "Араджа, Арама, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310102,
					"content": "#Нара {NICKNAME} и Паймон! Какая радость снова вас видеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730310103,
					"content": "#О, вы вернулись. Все только и говорят о том, как {F#высокая и сильная}{M#высокий и сильный} нара по имени {NICKNAME} всем вокруг помогает. Они очень счастливы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730310104,
					"content": "#Ещё бы им не быть счастливыми. Всегда здорово, когда тебе кто-то помогает! Правда, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310105,
					"content": "Это точно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "#Нет-нет! Они счастливы, потому что у них {F#появилась новая подруга}{M#появился новый друг}. Хотя Аранакин, Аранага и Арагару уже всё забыли, но лес помнит всё. История не будет забыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730310108,
					"content": "О...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730310109,
					"content": "Подготовка к Празднику Утсава почти завершена, но нам нужно ещё немного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730310110,
					"content": "#Да! Нара {NICKNAME} и Паймон, всё благодаря вам. Праздник Утсава уже близко! Скорее бы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730310106,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
