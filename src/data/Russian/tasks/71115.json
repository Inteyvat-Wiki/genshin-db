			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1564.785,
							176.775,
							1791.793
						],
						"pointId": 310100215
					},
					{
						"sceneId": 3,
						"position": [
							1571.267,
							176.334,
							1796.476
						],
						"pointId": 310100248
					},
					{
						"sceneId": 3,
