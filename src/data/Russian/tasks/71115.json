						],
						"pointId": 310100249
					}
				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "Э... Вы кто такие? Вы потревожили мой сон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150402,
					"content": "А? Кто это сказал? Паймон страшно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711150403,
					"content": "Бу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150404,
					"content": "А-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711150405,
					"content": "Ха-ха-ха-ха-ха! Правильно делаешь, что боишься! Если бы не каменная тюрьма, вы бы уже давно были у меня в животе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150406,
					"content": "Что? Ой! Так это же всего лишь говорящая статуя... Паймон думала, что какой-то монстр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711150407,
					"content": "Хм, что значит «всего лишь говорящая статуя»?! С каких пор говорящие статуи перестали быть страшными?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150408,
					"content": "Ну... Мы видели немало подобных статуй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711150409,
					"content": "Ч-что?! Ох, ладно. Похоже, у меня не получится вас напугать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150410,
					"content": "Почему ты так хочешь кого-нибудь напугать? Ты ведь обычная статуя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711150411,
					"content": "Хм! Да, я «обычная статуя», а вы находитесь в обители Властительницы лекарств. Пока госпожа была с нами, она не любила, когда её покой нарушали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150412,
					"content": "Вот почему я хочу пугать разных негодников, что приходят сюда. Даже после смерти госпожи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150413,
					"content": "Но вы отличаетесь от обычных смертных, и мне не удалось вас напугать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150414,
					"content": "Могу я попросить вас об одолжении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150415,
					"content": "Хм? Тебе нужна помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711150416,
					"content": "Кхе-кхе, посмотрите на этих разноцветных бабочек! После того как хозяйка покинула это место, они летают повсюду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Беззаботный симулякр"
				},
				{
					"id": 711150417,
					"content": "Тсс... Одна из них уселась тебе на голову! Подожди, мы тебе поможем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
