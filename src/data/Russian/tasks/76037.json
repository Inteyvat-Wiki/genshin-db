			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лешек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760370101,
					"content": "Информация о всех четырёх разыскиваемых целях на доске. Можете задавать вопросы, но размер вознаграждения обсуждению не подлежит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Лешек"
				},
				{
					"id": 760370107,
					"content": "#Готов{F#а} предоставить доказательства.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "Расскажи о целях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "На данный момент есть четыре цели, но только по трём из них есть зацепки. Гадалка из Сумеру, Хидимби, обвиняемая в мошенничестве, часто появляется <color=#00E1FFFF>около южного порта</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Лешек"
				},
				{
					"id": 760370104,
					"content": "Обезумевший кайраги из Инадзумы убил множество торговцев, проходивших через <color=#00E1FFFF>Пустынный коридор</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Лешек"
				},
				{
					"id": 760370105,
					"content": "Говорят, что члены банды, занимающиеся контрабандой опасных веществ, <color=#00E1FFFF>разбили лагерь на пляже к северу от города</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Лешек"
				},
				{
					"id": 760370106,
					"content": "Информации о жестоком пирате по имени Харк Рваная Пасть пока нет. Возможно, он где-то затаился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лешек"
				},
				{
					"id": 760370108,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Прощай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лешек"
				}
			]
		},
		{
			"id": 7603702,
