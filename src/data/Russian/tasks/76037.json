				}
			]
		},
		{
			"id": 7603703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7601901",
							"0"
						]
