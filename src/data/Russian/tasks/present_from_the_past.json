						110040317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110040305,
					"content": "Крио папоротник!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
