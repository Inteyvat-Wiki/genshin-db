			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сога Сумида-но-рю Сакон Сигэхира"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "#{F#Почтенная путница}{M#Почтенный путник}, можно вас на пару слов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110102,
					"content": "Избавлю вас от лишних подробностей, скажу только, что мне нужна ваша помощь. Недавно достойнейший Юй Хуанъи из Ли Юэ отправил мне редчайшую драгоценность, но она до сих пор не дошла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110103,
					"content": "У меня есть основания полагать, что ей завладел хранитель сей местности. Если вам встретится сокровище, о котором говорил достойнейший Юй Хуанъи, не могли бы вы вернуть его мне? Я непременно отблагодарю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сога Сумида-но-рю Сакон Сигэхира"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "Вот и мы! Смотри, это и есть то самое «сокровище», которое ты имел в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 701110202,
					"content": "О, я безмерно вам благодарен! Большое спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110203,
					"content": "Не буду откладывать, немедленно вскрою печать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110204,
					"content": "Ч-что это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110205,
					"content": "Ой! Эта штука сейчас взорвётся?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 701110206,
					"content": "Почтеннейший Юй Хуанъи не стал бы причинять мне вред... Неужели защитник сделал из сокровища бомбу?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110207,
					"content": "Стыдно признать, но я не знаю, как обезвредить бомбу... Выбора нет! Придётся её выбросить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110208,
					"content": "Не бойтесь! Теперь я вспомнил. Один знатный человек из Гипербореи как-то рассказывал о том, как правильно создавать святую гранату!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110209,
					"content": "«Сосчитай до трёх, не больше и не меньше. До четырёх ты не должен считать, и до двух тоже, до пяти считать не надо. Когда число три, являющееся третьим числом...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110210,
					"content": "Хватит объяснять! Если ты её не бросишь, она и правда взорвётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7011103,
			"completionStepIds": [
				7011103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
