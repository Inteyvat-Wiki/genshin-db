							620.8
						],
						"pointId": 230
					}
				]
			},
			"dialogs": [
				{
					"id": 701110301,
					"content": "Что? Ложная тревога! Паймон так испугалась, а оказалось, это всего лишь фейерверк...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 701110302,
					"content": "К-какое великолепие... За все годы моей службы под началом её превосходительства Наруками Огосё я не видел столь ослепительных огненных цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110303,
					"content": "Так вот оно что! Это и есть чудесное зрелище, которое хотел показать мне почтенный Юй Хуанъи... Я и подумать не мог, подумать не мог...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110304,
					"content": "«Ночь темна, точно чёрный нефрит, в полночь яркий цветок распускается в облаках, лепестки его подобны пене морской, до тишины остаётся лишь миг, когда звёзды рассыплются, капли дождя рассеются в пустоте...» До чего изящные строки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Сога Сумида-но-рю Сакон Сигэхира"
				},
				{
					"id": 701110305,
					"content": "Паймон не понимает, что тут изящного... Но главное, что всё хорошо закончилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}