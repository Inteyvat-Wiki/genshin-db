		},
		{
			"id": 7408805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэкер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "Изначально это место должно было стать Институтом прикладного использования механизмов Бутора. Господин Бутор был ведущим специалистом в области исследования классических пружинных механизмов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740880502,
					"content": "Но... с точки зрения науки, развитие и усовершенствование классических пружинных механизмов зашло в тупик. Слишком очевидны недостатки таких механизмов в применении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740880503,
					"content": "В общем, постепенно исследования господина Бутора не стали принимать в расчёт. Он не только столкнулся с сокращением финансирования, но также с нехваткой кадров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740880504,
					"content": "После череды неудач группа господина Бутора была расформирована, а исследование почти заброшено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Нэкер"
				},
				{
					"id": 740880505,
					"content": "Эх, если позволите, я бы сказал, что господину Бутору конкретно не повезло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэкер"
				}
			]
		},
		{
			"id": 7408806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
