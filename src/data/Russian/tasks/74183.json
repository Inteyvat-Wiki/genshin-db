				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "#Не думал{F#а}, что вишапы вырастают такими большими.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Пф. Они просто неумытые варвары. Я бы не удивился, если бы они во что-нибудь ещё более странное вырастали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Господин Осси"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
