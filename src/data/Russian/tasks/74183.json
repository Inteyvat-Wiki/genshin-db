				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Господин Осси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "Кстати, а Нёвиллет разве не...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "Точно! Нёвиллет - Дракон воды же, да? Так получается, что этот парень намного старше даже Нёвиллета?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832203,
					"content": "Уже родился новый Дракон воды? И действительно, всё-таки с кончины прежней Владычицы всех вод уже много лет прошло... так много лет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Господин Осси"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Господин Осси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "Короче говоря, злой дракон Сцилла был раньше другом севаста, но он восстал против него в решающий момент битвы между нами, ремурийцами, и... фонтейнцами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832302,
					"content": "Тогда Сцилла привёл армию жестоких потомков драконов к Махимосу, и хотел прорваться во внутренний город к Капитолию, где находился севаст.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832303,
					"content": "Махимос?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Ага, люди в деревне постоянно говорят об этом Махимосе и о какой-то колокольне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832306,
					"content": "Верно. Махимос - это внешний город столицы, но чтобы злому дракону попасть во внутренний город, ему нужно было пройти через Врата Януса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832307,
					"content": "Это барьер, который разделяет внешнюю и внутреннюю части города. И симфония, которую создавал севаст со своими музыкантами, покрывала всю Ремурию с помощью Золотого пути, проходящего через Ворота Януса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832308,
					"content": "Боэций со своей армией воспользовались этим и запечатали злого дракона, закрыв Врата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832309,
					"content": "Возможно, Сцилла хотел предстать перед севастом, но это больше не было возможно. Потом злой дракон был погребён под водой вместе с Ремурией, и севаст тоже пропал без следа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832310,
					"content": "(Что-то здесь не так...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#{NICKNAME}, ты что-то вспомнил{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832314,
					"content": "Кажется, здесь какая-то путаница.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Хм... Я обо всём этом уже потом услышал, ведь во время катастрофы меня в столице не было...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832316,
					"content": "Никто не знает, что тогда случилось с севастом. Боюсь, что разузнать что-то мы можем, только продолжив наш путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832317,
					"content": "Большая светящаяся рыба, которую мы видели в замке, - это, должно быть, мысли, испускаемые Сциллой вовне через трещины в своей каменной тюрьме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832318,
					"content": "Боюсь, что он уже нас заметил. Он так долго был здесь запечатан, и вот наконец учуял кого-то постороннего. Конечно, он постарается заманить нас внутрь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832319,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832320,
					"content": "Погоди-ка! Ты сказал, что путь в золотой дворец идёт через какие-то там ворота. Но разве Боэций их не закрыл? Получается, что мы никак не сможем пройти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832321,
					"content": "Да, это будет затруднительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832322,
					"content": "Вот уж нет предела его грубости! Для показухи сказал «жду тебя в золотом дворце», а сам даже дверь нам не открыл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832323,
					"content": "Я что подумала, может, как-нибудь сломать печати дракона, чтобы поверженный противник нам дверь проломил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832324,
					"content": "Нет! Как так можно?! Это всё-таки заклятый враг Ремурии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832325,
					"content": "Но враг моего врага мне друг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "Точно! Это так давно было. Может, он решил начать с нового листа и стать добрым драконом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832328,
					"content": "Но он всё равно дракон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Господин Осси"
				},
				{
					"id": 741832329,
					"content": "#Ну и что такого? Даже если и дракон, может быть, он благоразумный дракон. У нас уже есть опыт с драконами. Да ведь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741832326,
					"content": "Но ведь Ремурии уже давно нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832311,
					"content": "#(...Я видел{F#а} во сне... Тогда...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832312,
					"content": "(...Сцилла приходил к Рему...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832304,
					"content": "#Я {F#слышала}{M#слышал} об этом в деревне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				}
			]
