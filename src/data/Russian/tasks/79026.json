			"trigger": {
				"objectNames": [
					"Руководитель Театра сумерек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790260101,
					"content": "Добро пожаловать! Добро пожаловать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260102,
					"content": "Рад приветствовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260104,
					"content": "#Вы, должно быть, и есть {F#прославленная}{M#прославленный} {NICKNAME}! И с вами ваш верный спутник, госпожа Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260105,
					"content": "Ого! Откуда ты наши имена знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790260106,
					"content": "Конечно, мне известны имена дорогих гостей нашего острова, ведь я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260107,
					"content": "Ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790260108,
					"content": "Прославленный руководитель Театра сумерек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260109,
					"content": "Оказывается, и правда есть люди, которые величают себя прославленными.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "Хотя ты и называешь себя прославленным, но Паймон никогда не слышала о тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790260111,
					"content": "Это уже неважно, ведь теперь вы точно слышали обо мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260112,
					"content": "Мы проделали огромную работу, и наконец наша пьеса «Сказание о принцессе с мечом» готова к премьере!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260113,
					"content": "Всего пять действий, каждое поделено на два акта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260114,
					"content": "Дорогие гости, вы прибыли как раз кстати! Занавес вот-вот поднимется. Прошу вас, устраивайтесь поудобнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260115,
					"content": "Мне ещё нужно уладить кое-что за кулисами, так что разрешите откланяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "Руководитель Театра сумерек"
				},
				{
					"id": 790260116,
					"content": "Вы увидите дебют лучшей пьесы Театра сумерек! Занавес вот-вот поднимется. Прошу вас, занимайте места!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Руководитель Театра сумерек"
				}
			]
		}
	]
