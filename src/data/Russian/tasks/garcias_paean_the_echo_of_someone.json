	"talks": [
		{
			"id": 2301701,
			"completionStepIds": [
				2301701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301701",
							"2"
						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гарсия",
					"Лу Тун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "#Путе-путешественни{F#ца}{M#к}! Как хорошо, что вы здесь! Мы тут с госпожой Кайей допиваем кофе и собираемся вернуться к делам. Позвольте я вас познакомлю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230170102,
					"content": "#Это и есть путешественни{F#ца}{M#к}, о {F#которой}{M#котором} ты рассказывал? Какая честь познакомиться с вами! Я Кайя. Гм... Занимаюсь танцами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230170104,
					"content": "Привет, Гарсия рассказывал о тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Хи-хи, правда? Я очень рада, а мне казалось, у него на уме только его машина, да ещё Лу Тун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230170106,
					"content": "Что вы, госпожа, не принимайте Лу Туна в расчёт. Уверен, господин Гарсия со мной согласится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230170107,
					"content": "Нет уж, если бы не Лу Тун, Гарсия остался бы без единой моры в кармане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230170108,
					"content": "Не могу согласиться, госпожа. Уверен, даже в самых стеснённых обстоятельствах Гарсия приберёг бы немного мор, чтобы хватило на две чашечки кофе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230170109,
					"content": "Три чашечки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230170110,
					"content": "Я не перестаю восхищаться вашей живой добротой, господин Гарсия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Лу Тун"
				},
				{
					"id": 230170111,
					"content": "#Кхм, вернёмся к делу! Путешественни{F#ца}{M#к}, мне по-прежнему нужны печати, с которыми ходят Похитители сокровищ. Если ты раздобудешь такие печати, я их куплю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230170112,
					"content": "Мне в последнее время удалось немного подзаработать... Так что за вознаграждение не беспокойся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				}
			]
		},
		{
			"id": 2301702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
