			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "Здравствуйте! Ну, о чём вы хотели спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175002,
					"content": "Как ты познакомилась с Гарсией?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "#Вот так прямо спрашиваешь? Это так типично для искател{F#ьницы}{M#я} приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175004,
					"content": "Мы познакомились с Гарсией, когда магистр пригласил его в нашу труппу для наведения порядка в счетах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175005,
					"content": "Ха-ха-ха! По правде говоря, мне ещё не доводилось видеть человека, который совершенно не вписывался бы в атмосферу труппы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175006,
					"content": "Пока мы исполняли музыку, танцевали, пили и пели песни, он с Лу Туном молча занимался подсчётами в стороне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175007,
					"content": "Однажды я заметила на нём очень странную одежду, на которой, казалось, был нарисован какой-то узор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175008,
					"content": "Мне стало любопытно, и я спросила его, что это за узор. Он ответил, что это чертёж одного устройства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175009,
					"content": "А нарисовал он его на одежде потому, что неожиданно не нашёл ручку и бумагу, когда обсуждал с кем-то это устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175010,
					"content": "Поэтому он взял уголёк и нарисовал схематическое изображение прямо на своей одежде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175011,
					"content": "Потом мы говорили о следах на его одежде и этом устройстве... Конечно же, большую часть времени он говорил, а не я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Кайя"
				},
				{
					"id": 230175012,
					"content": "Хи-хи, он очень странный человек, но в то же время... очень харизматичный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кайя"
				}
			]
		},
		{
