					"Гарсия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170301,
					"content": "Гм, для испытаний этих брошей должно хватить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230170302,
					"content": "Вот ваше вознаграждение, спасибо за работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230170303,
					"content": "#Путешественни{F#ца}{M#к}, почему вы так на меня смотрите? Мне даже как-то неуютно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Гарсия"
				},
				{
					"id": 230170304,
					"content": "Так, мне пора работать, самое время поработать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарсия"
				}
			]
		},
