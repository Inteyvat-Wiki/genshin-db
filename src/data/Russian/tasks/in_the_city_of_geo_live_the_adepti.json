						400030924
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030925,
					"content": "Ты узнаёшь его, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030926
					]
				},
				{
					"id": 400030924,
					"content": "Этот символ оставил ваш подозреваемый.",
