					"nextDialogs": [
						400030925
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400030926,
					"content": "Нет, не узнаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030927
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030927,
					"content": "#Приложи максимум усилий и покажи, на что ты способ{F#на}{M#ен}.",
