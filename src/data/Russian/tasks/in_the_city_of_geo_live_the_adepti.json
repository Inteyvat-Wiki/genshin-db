			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Хуо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "Кажется, монстров больше не осталось. Я думаю, что мы можем... Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 400030402,
					"content": "Кто вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 400030403,
					"content": "Цзя И отправил нас к тебе, он сказал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030404,
					"content": "Ах вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 400030405,
					"content": "Департамент по делам граждан благодарит вас за помощь. Ваше обращение будет рассмотрено в ближайшее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 400030406,
					"content": "Надеюсь, что мы ещё встретимся в Ли Юэ, добрые путешественники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "Син Хуо"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}, мне кажется, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030408,
					"content": "Департамент по делам граждан не воспринимает нас всерьёз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "Да! Именно это я и хотела сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030410,
					"content": "Для местных жителей все эти вкусности больше не кажутся чем-то особенным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030411,
					"content": "Но для путешественника, который неделями перебивался грибами да ягодами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030412,
					"content": "Для вас Праздник морских фонарей - самый главный праздник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030416,
					"content": "Вернёмся к месту, где мы увидели того странного парня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030417,
					"content": "Паймон слышала, что преступники любят возвращаться на место преступления. Так работает их психология.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030418,
					"content": "Но никакого «преступления» не было...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "Это значит, что времени у нас мало! Если материалы загорятся, будет слишком поздно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030413,
					"content": "Пора брать дело в свои руки!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "Именно это Паймон сказать и хотела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400030415,
					"content": "Такие опытные путешественники, как мы, должны подойти к этому делу более ответственно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Паймон"
				}
			]
		},
