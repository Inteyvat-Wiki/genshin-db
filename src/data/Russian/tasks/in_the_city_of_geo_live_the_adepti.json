					"nextDialogs": [
						400030922
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400030922,
					"content": "Я не хочу запятнать копьё, сразившее бессчётное количество демонов, людской кровью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 400030923,
					"content": "А это что такое?",
