			"dialogs": [
				{
					"id": 700920301,
					"content": "Всё разом исчезло... Типичная Алиса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700920302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700920302,
					"content": "Проклятая ведьма! Рано или поздно я тебя найду!",
					"roleType": "TALK_ROLE_NPC",
