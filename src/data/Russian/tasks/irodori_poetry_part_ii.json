				"points": []
			},
			"dialogs": [
				{
					"id": 726920101,
					"content": "#{F#Госпожа}{M#Господин}, как раз вовремя! Мы с Лэннэ работаем над новым стихотворением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726920102,
					"content": "Снова нужна моя помощь с вдохновением?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Ха-ха, верно. Следуя указаниям Отомо, я написал другое стихотворение в инадзумском стиле, хотя я всё ещё неопытен в этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726920104,
					"content": "Тема этого стихотворения - «дружба». Мы оба можем только сожалеть о том, что не встретились раньше. Я хотел бы написать о животных, бродящих в обществе друг друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726920105,
					"content": "Раз стихотворение об Инадзуме, нужно использовать только местных <color=#00E1FFFF>уникальных животных</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726920106,
					"content": "Мы часто видимо уникальных животных Инадзумы, и ходящих, и летающих...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726920107,
					"content": "#Но они появляются только в дикой природе, так что давай отправляться на поиски, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726920108,
					"content": "Я у вас в долгу! Пожалуйста, сделайте <color=#00E1FFFF>4</color> фотографии разных уникальных животных Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лэннэ"
				}
			]
		},
		{
			"id": 7269202,
