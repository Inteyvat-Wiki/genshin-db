			"dialogs": [
				{
					"id": 726920501,
					"content": "Друг, раз вам с Отомо обоим нравится эта фраза, то используем её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726920502,
					"content": "Стихотворение Лэннэ и фотографии весьма дополняют друг друга. Честно говоря, стихотворение становится всё более и более трогательным по мере чтения, особенно если при этом смотреть на фотографии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726920503,
					"content": "Если честно, я тоже писал стихотворение, для которого мне завтра может понадобиться ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "Отомо"
				},
				{
					"id": 726920504,
					"content": "Для вас тоже нужно сделать фотографии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "Хех, лучше обсудим это завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Отомо"
				}
			]
		},
