			"dialogs": [
				{
					"id": 726920201,
					"content": "Друг, фотографии уже готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726920202,
					"content": "Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "Сейчас посмотрим... Да, замечательно! Кажется, я знаю, о чём написать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "Лэннэ"
				},
				{
					"id": 726920204,
					"content": "Я написал несколько строф, основанных на твоих фотографиях. Выбери, какую нам следует использовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лэннэ"
				}
			]
		},
