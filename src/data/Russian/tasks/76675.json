							9726.784
						],
						"pointId": 14164
					},
					{
						"sceneId": 3,
						"position": [
							5925.497,
							284.186,
							9722.368
						],
						"pointId": 15086
					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "#{F#Что здесь делает героиня, принёсшая нам отменное вино?}{M#Что здесь делает герой, принёсший нам отменное вино?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751002,
					"content": "У меня к тебе тот же вопрос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "Хех... В моей кружке самый особый из всех возможных напитков. Им можно наслаждаться исключительно в одиночестве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751005,
					"content": "#Но раз ты меня застукал{F#а}, налью тебе кружечку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751006,
					"content": "#Так и знал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "Прости, я пошутил! У меня нет ни капли алкоголя. Если хочешь выпить, обратись к Омине, у неё всегда есть чем угоститься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751009,
					"content": "В лагере всегда должен быть хотя бы один трезвый человек, который будет оберегать своих пьяных товарищей от ночных происшествий. Это было моим неизменным правилом с самого начала экспедиции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751010,
					"content": "Увы, сегодня мой черёд быть трезвым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751011,
					"content": "...Поэтому в ночь, когда все пьяны, я не могу позволить себе лишнего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751012,
					"content": "Вот так совпадение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "Кто знает? Может быть, судьба решила подшутить надо мной? Опоздай доставка на день, и, возможно, я бы пил с остальными вино в своё удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751015,
					"content": "#Опоздай ты на день, возможно, ты бы не {F#оказалась}{M#оказался} в этом лагере, не попал{F#а} бы на нашу вечеринку, и у нас не было бы возможности вот так поговорить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751016,
					"content": "Никто не может предсказать, к каким результатам приведёт тот или иной выбор, пока не настанет время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751017,
					"content": "Прямо как когда я решил возглавить эту экспедицию... Я и представить не мог, что заберусь так далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751018,
					"content": "Целью экспедиции... была Дикая Охота?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "...Так и вышло, да. Но когда мы выступили в поход, я «знал» только одно: на север надвигалась Бездна, грозившая смести весь Тейват.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751020,
					"content": "Нам требовалось время, чтобы мобилизоваться. Но где появится враг и в каком виде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751021,
					"content": "...Когда мы отправлялись в путь, для нас это было загадкой. Всё, что мы могли делать, - это собирать информацию по ходу движения, готовясь к любым непредвиденным обстоятельствам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751022,
					"content": "И вы отправились в экспедицию, обладая такими скудными данными?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "Ха, быстро учишься! Но, к сожалению, противник не будет послушно ждать, пока мы подготовимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751025,
					"content": "Пока мы колеблемся, Бездна продолжает забирать бесчисленные жизни. Чем раньше мы выступим, тем скорее можем изменить их судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751026,
					"content": "Это всё, что нам нужно было знать, чтобы начать поход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751027,
					"content": "Достойно Рыцаря Бореалиса...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "Не надо формальностей, почётный рыцарь! И ты не исключение. Твоё путешествие тоже изменило судьбы многих людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751030,
					"content": "Мондштадт, Двалин... или нынешний Нод-Край, экспедиционные войска... и я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751031,
					"content": "#Мы можем сидеть у костра, петь песни и мечтать о будущем за кружкой вина... Всё это стало возможным благодаря тебе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751032,
					"content": "#...Неужто я настолько {M#силён}{F#сильна}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "...Ха-ха, кто знает? Судьба непредсказуема. Но пока мы живы, всегда есть надежда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751034,
					"content": "Вино, которое я не выпью сегодня, выпью завтра - они припасут его для меня. Мы живы, а это значит, что завтра нас ждут вино и друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751035,
					"content": "#Так что, {NICKNAME}, давай выпьем! За завтрашний день! За надежду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Варка"
				},
				{
					"id": 766751028,
					"content": "В этом вся суть рыцарей Ордо Фавониус...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "Разведка - основа любой кампании?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "В тот самый день, когда доставили вино из одуванчиков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
