						766750605
					]
				},
				{
					"id": 766750605,
					"content": "Когда Рэйзор впервые попробовал это упражнение, ему потребовался целый день, чтобы закончить. Угадаешь почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750606
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766750606,
					"content": "Четверть дня ушла на перемещение бочек, а три четверти - на то, чтобы понять, что я говорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Варка"
