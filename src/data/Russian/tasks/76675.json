						],
						"pointId": 15083
					}
				]
			},
			"dialogs": [
				{
					"id": 766750901,
					"content": "А! Магистр ордена! Почётный рыцарь! Они вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "Винфрид"
				},
				{
					"id": 766750902,
					"content": "Они вернулись! Они вернулись! Скорее, встречайте их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "Экберт"
				},
				{
					"id": 766750903,
					"content": "Ух ты, какой тёплый приём... Паймон смущена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766750904,
					"content": "Я почувствовал этот аромат за сотни метров! Аромат вина из одуванчиков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "Лейфхельм"
				},
				{
					"id": 766750905,
					"content": "Фирменный продукт винокурни «Рассвет»! Вернулись... мои воспоминания... все вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "Винфрид"
				},
				{
					"id": 766750906,
					"content": "Э-э... похоже, вы ждали не нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766750907,
					"content": "Да... этот запах... в точности как в моих воспоминаниях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "Экберт"
				},
				{
					"id": 766750908,
					"content": "Как же хорошо, столько лет прошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "Лейфхельм"
				},
				{
					"id": 766750909,
					"content": "А я думал, что напрочь забыл вкус вина из винокурни «Рассвет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "Винфрид"
				},
				{
					"id": 766750910,
					"content": "Вкус вина не изменился... Значит, родной дом в Спрингвейле тоже не изменился? Наверное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "Экберт"
				},
				{
					"id": 766750911,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "...Спасибо тебе, почётный рыцарь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "Экберт"
				},
				{
					"id": 766750914,
					"content": "...Ладно, не надо так волноваться. Кто-то ещё не вернулся в лагерь? Подождём, пока все соберутся, прежде чем открывать. А пока идите готовиться к пиру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766750915,
					"content": "Так точно! Мы сейчас же займёмся приготовлениями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "Винфрид"
				},
				{
					"id": 766750916,
					"content": "...Видишь, я же говорил, что выпивка - дело серьёзное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 766750917,
					"content": "Ммм... Медовое мясо с морковкой... Цыплёнок в медовом соусе... Паймон не может поверить, что здесь можно попробовать настоящие мондштадтские блюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766750918,
					"content": "Хм... А где Варка? Кто-нибудь его видел? Он же не валяется где-нибудь в канаве, пьяный в стельку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766750919,
					"content": "Учитывая боевые способности его печени - вряд ли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "Хорошо... Паймон доест ещё одну порцию и догонит тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766750920,
					"content": "Пойду поищу, а ты кушай дальше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "#Я был{F#а} там. Он совсем не изменился.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
			"completionStepIds": [
				7667510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
