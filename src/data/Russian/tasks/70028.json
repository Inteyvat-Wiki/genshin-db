			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуссени"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280301,
					"content": "Как всё прошло? Шипы работали как надо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280302,
					"content": "Работали, как и задумывалось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "Хорошо, хорошо, это хорошо. Надеюсь, что они не сломаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280304,
					"content": "В таком случае всё, что нам нужно, это чтобы аномальный молотильщик приблизился к шипам, когда мы их активируем, и тогда у нас получится отключить его от источника питания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280305,
					"content": "На этот раз ты сможешь победить его раз и навсегда, так что дерзай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280306,
					"content": "Я верю в твои силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				}
			]
		}
	]
}