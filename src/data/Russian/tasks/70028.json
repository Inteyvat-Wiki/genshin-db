			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуссени"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "Благодаря собранным тобой тестовым данным мы завершили окончательную калибровку шипов Пурсины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280102,
					"content": "Теперь я с достаточной уверенностью могу заявить, что они будут работать корректно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280103,
					"content": "Пока шипы будут находиться в тех местах, где часто бывает наша аномальная модель, у нас будет возможность контролировать её источник питания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280104,
					"content": "Пока мы можем полностью активировать шипы, этот механизм не сможет запустить свои протоколы самовосстановления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280105,
					"content": "Спасибо за помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "Нет, нет, не благодари меня. Благодари тех, кто был до нас, и оставленную ими мудрость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280109,
					"content": "Если бы нас не направляли эти знания, мы бы не смогли придумать способ одолеть этого аномального молотильщика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280110,
					"content": "Всё, что мы делали до сих пор, опиралось на подобные знания, и именно знания являются самым ценным ресурсом в мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280111,
					"content": "Звучит непросто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "Ничего страшного. Ведь высшая мудрость ещё не направила тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280113,
					"content": "...Ха, посмотри, как далеко я зашёл в этом вопросе. Думаю, я был слишком взволнован тем, что смог починить шипы Пурсины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280114,
					"content": "Что ж, настало время для последней фазы наших приготовлений. Я имею в виду, что мы должны разместить эти шипы на острове Цуруми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280115,
					"content": "...Боюсь, что я не смогу тебе с этим помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280116,
					"content": "#Согласно местным законам, люди, не имеющие вида на жительство, подобно мне, не могут свободно передвигаться по Инадзуме. Поэтому эта задача ложится на тебя, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280117,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "Спасибо. Я бы посоветовал не действовать сразу же после размещения шипов. Вместо этого быстро проверь, всё ли работает нормально, а затем возвращайся ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280119,
					"content": "Думаю, мы можем позволить себе быть более осторожными ради твоей же безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 700280107,
					"content": "Слава технологиям!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "Не совсем. Я бы славил знания, которые оставили нам наши предшественники.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Хуссени"
				}
			]
		},
		{
			"id": 7002803,
			"completionStepIds": [
				7002803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002803",
							"2"
						],
						"stepId": 7002803,
						"stateName": "QUEST_STATE_UNFINISHED"
