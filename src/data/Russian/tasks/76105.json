			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мальта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#Братец}{F#Сестрица}, видишь тех каменных крабов? Кажется, они проводят какой-то таинственный ритуал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Мальта"
				},
				{
					"id": 761050102,
					"content": "Думаю, это их естественное поведение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "Да? Гм... Наверное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Мальта"
				},
				{
					"id": 761050104,
					"content": "В Нашгороде тоже много людей, которые ведут себя похоже. Одни ходят, взявшись за руки, другие встречают друг друга тумаками, а потом расходятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Мальта"
				},
				{
					"id": 761050105,
					"content": "Наверное, это естественное поведение обитателей Нашгорода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Мальта"
				},
				{
					"id": 761050106,
					"content": "В точку. Ты быстро схватываешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#{M#Братец}{F#Сестрица}, ты поможешь мне загнать всех каменных крабов в пруд?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Мальта"
				},
				{
					"id": 761050109,
					"content": "Хм... это как собрать всех охотников за сокровищами во «Флагмане»? Очень интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Мальта"
				},
				{
					"id": 761051501,
					"content": "#Хочу посмотреть, что случится, когда все каменные крабы соберутся вместе... {M#Братец}{F#Сестрица}, у тебя найдётся свободная минутка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мальта"
				},
				{
					"id": 761050107,
					"content": "Думаю, они немного отличаются от крабов, но ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
			"id": 7610503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
