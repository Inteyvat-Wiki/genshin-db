					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150501,
					"content": "#Приветствую, {M#золотой}{F#золотая} нара! И тебя, маленькая белая леталка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 732150502,
					"content": "Эй, ничего Паймон не маленькая! На себя бы лучше посмотрел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150503,
					"content": "А я чего? Я не маленький! О, кстати, вы здесь зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 732150504,
					"content": "Просто вернулись вас проведать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "Агась! Мы же столько всего вместе пережили. И зло победили, и спели вместе, и спасли Мутайи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150506,
					"content": "Мотийиму!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 732150507,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150508,
					"content": "Ох, простите. Вы наверняка говорите правду. Вот только я совсем ничего не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 732150509,
					"content": "Ой! Ничего страшного! Не грусти, пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150510,
					"content": "(Он действительно всё забыл...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
