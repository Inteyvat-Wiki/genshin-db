			"trigger": {
				"objectNames": [
					"Аранага",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "Привет, друг нара! Э... хотел тебе что-то сказать, да вот забыл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 732150102,
					"content": "Ничего! Мы очень рады всех вас видеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150103,
					"content": "Приятно, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 732150104,
					"content": "Расскажи о Мотийиме.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "Она больше не разговаривает, но с ней всё хорошо. Восстанавливает силы, лес... Спасибо вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранага"
				},
				{
					"id": 732150106,
					"content": "Расскажи о потере памяти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "Потере памяти? О, энергия ведь истощилась, кусава. Вот и они испарятся, воспоминания. Мало-помалу, как капельки росы поутру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранага"
				}
			]
		},
		{
			"id": 7321502,
			"completionStepIds": [
				7321502
			],
