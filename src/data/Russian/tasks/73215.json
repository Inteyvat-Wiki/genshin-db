			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арагару",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150301,
					"content": "#Привет, и спасибо вам большое, {M#золотой}{F#золотая} нара и белая леталка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 732150302,
					"content": "Что вы тут делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 732150303,
					"content": "Ты же сам просил, чтобы мы не забывали приходить к тебе поиграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150304,
					"content": "Э-э, я такое говорил?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 732150305,
					"content": "Говорил.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 732150309,
					"content": "В любом случае спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				},
				{
					"id": 732150307,
					"content": "Чего, не рад нам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "Н-нет, вовсе нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Арагару"
				}
			]
		},
