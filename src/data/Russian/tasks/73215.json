			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аранакин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150201,
					"content": "Привет-привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 732150202,
					"content": "Привет, малыш! Ты нас ещё помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150203,
					"content": "Ах ты, белая леталка! Никакой я не малыш! Вы не забыли ту песню, которой я вас научил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 732150204,
					"content": "Конечно, не забыли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 732150206,
					"content": "Тогда пообещайте мне, что даже если я сам её забуду, вы будете помнить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакин"
				}
			]
		},
		{
			"id": 7321503,
			"completionStepIds": [
				7321502
			],
