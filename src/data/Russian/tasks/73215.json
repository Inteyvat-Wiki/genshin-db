			},
			"dialogs": [
				{
					"id": 732150601,
					"content": "#{M#Золотой}{F#Золотая} нара, белая леталка! Это вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 732150602,
					"content": "Ага! Мы пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150603,
					"content": "Хе-хе! Я тут, правда, позабыл много чего. Так что вы мне напоминайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 732150604,
					"content": "Это из-за кусаве?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Да. Аранага вам, наверное, уже рассказал. Вся сила в памяти. Нет памяти - нет и силы.",
