				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150401,
					"content": "#Приветик, {M#золотой}{F#золотая} нара и белая леталка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 732150402,
					"content": "Привет! Как поживаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150403,
					"content": "Хорошо поживаю! А вы зачем пришли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 732150404,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150405,
					"content": "Хорошо... Но почему вы пришли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 732150406,
					"content": "Мы с вами пережили столько приключений, что это место стало для нас будто родным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732150407,
					"content": "Ох? Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 732150408,
					"content": "Он забыл о наших прошлых приключениях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7321505,
