				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хувишка"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2009.721,
							274.996,
							4224.615
						],
						"pointId": 330800394
					}
				]
			},
			"dialogs": [
				{
					"id": 735210301,
					"content": "В этом Турнире даршанов мой фаворит - Сайно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210302
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210302,
					"content": "Даже если не принимать во внимание умений генерала махаматры, достаточно вспомнить прошедшие турниры, и сразу станет ясно, что даршан Спантамад выигрывал чаще других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210303
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210303,
					"content": "Многие говорят, что в даршане Спантамад полно гениев: Сайрус, Ружичка, Лиза, Сайно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210304
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210304,
					"content": "Чем ярче сияет талант, тем быстрее турнир становится предсказуемым. Пожалуй, самым напряжённым состязанием было соревнование двадцатилетней давности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210305
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210305,
					"content": "Мой друг в то время тоже участвовал в турнире, и я был там специально, чтобы его поддержать. Последний раунд был сыгран в лесу Авидья, куда мало кто осмеливался войти. Никто не знал, что произошло в густой чаще...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210306
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210306,
					"content": "Позже я узнал, что Академия отменила это соревнование. После этого из Турнира даршанов исключили события, предполагающие борьбу не на жизнь, а насмерть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210307
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210307,
					"content": "Расскажи о своём друге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210308
					]
				},
				{
					"id": 735210308,
					"content": "Дай-ка подумать... Он... порядочный и добрый, но очень ранимый и чувствительный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210309
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210309,
					"content": "А главное, он заботился о нас как о друзьях. Мы нередко пили вместе, и это время было наполнено весёлым смехом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210310
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210310,
					"content": "Жаль, что прошлого не вернуть. Кто-то покинул наш мир, кто-то исчез без следа, кто-то намеренно живёт в уединении... Говорят, что судьба непредсказуема, и это действительно так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210311
					],
					"speakerTitle": "Хувишка"
				},
				{
					"id": 735210311,
					"content": "Похоже, двадцать лет назад и правда что-то случилось... Кстати, а разве Викас не предлагал нам обращаться к нему, если возникнут вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210312,
					"content": "У нас сейчас как раз есть время. Может, найдём его и спросим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7352104,
