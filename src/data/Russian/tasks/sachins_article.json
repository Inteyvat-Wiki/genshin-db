			},
			"dialogs": [
				{
					"id": 735210101,
					"content": "#Ай, снова {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210102
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210102,
					"content": "У меня есть свежая информация о Фестивале Академии, хотите узнать больше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210103
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210103,
					"content": "За деньги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210104,
					"content": "Совершенно бесплатно! Госпожа Сангема-бай проявляет беспрецедентную щедрость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210105
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210105,
					"content": "Помните Сачина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210106
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210106,
					"content": "Именно он спонсировал Фестиваль Академии, верно? Говорят, что именно он предоставил призовые деньги и Диадему знания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210107,
					"content": "Верно! Не так давно в пустыне я встретила одного старого торговца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210108
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210108,
					"content": "Угадайте, что я у него купила? Записки бродячего торговца! Теперь я смогу избежать самых опасных участков пустыни и посетить больше мест!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210109
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210109,
					"content": "Но самое главное, что там упоминается Сачин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210110
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210110,
					"content": "Оказывается, Сачин часто наведывался в пустыню, чтобы изучать местные обычаи, и много общался с местными странствующими торговцами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210111
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210111,
					"content": "Большую часть текста уже невозможно прочесть, но это рассказ от первого лица о крупном спонсоре, стоящем за Фестивалем Академии! Хотите посмотреть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210112
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210112,
					"content": "Хорошо, показывай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210113,
					"content": "Хм, ничего не ясно! Дори, ты понимаешь хоть что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210114,
					"content": "Слишком сложно, да? Какая жалость! Но всего за миллион моры я готова провести для вас анализ текста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210115
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210115,
					"content": "Тогда не надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210116,
					"content": "Раз платить вы не хотите, то специальная информация Дори на этом заканчивается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210117
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 735210117,
					"content": "Но я могу дать вам одну подсказку! На площадке турнира должен быть кое-кто, присутствовавший на многих Фестивалях Академии. Беседа с ним может что-то для вас открыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дори"
				}
			]
		},
		{
			"id": 7352102,
			"completionStepIds": [
				7352102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
