						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Викас"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-406.229,
							281.227,
							2791.158
						],
						"pointId": 330201342
					},
					{
						"sceneId": 3,
						"position": [
							-405.308,
							281.227,
							2791.237
						],
						"pointId": 330201343
					}
				]
			},
			"dialogs": [
				{
					"id": 735210401,
					"content": "...Двадцать лет назад? Почему вас вдруг заинтересовали столь давние события? Вы что-то о них услышали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210402
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210402,
					"content": "Мы хотели узнать про пропажу диадемы двадцать лет назад. Кажется, тогда у кого-то из участников сильно изменился характер?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210403,
					"content": "Вы и так уже немало знаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210404
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210404,
					"content": "Викас, ты от нас что-то скрываешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210405,
					"content": "Вовсе нет. Просто двадцать лет назад я был всего лишь пятилетним мальчишкой. Что я тогда мог знать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210406
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210406,
					"content": "Но есть вещи, о которых я никому не рассказывал. Присоединиться к комитету по планированию Фестиваля Академии меня сподвиг один из его бывших членов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210407
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210407,
					"content": "Мы с ним познакомились во время путешествия. Он был... немного робким и всегда прятался, когда случалось что-то неожиданное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210408
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210408,
					"content": "Четыре года назад я сказал ему, что хочу вернуться в Академию и что там скоро начнётся Фестиваль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210409
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210409,
					"content": "А потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210410,
					"content": "Когда он услышал о Фестивале Академии, он как будто до смерти перепугался и принялся говорить, что его это всё не касается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210411
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210411,
					"content": "Я подошёл к нему в тот вечер, чтобы попрощаться, и он настоял, чтобы мы сперва выпили. А перебрав, начал болтать разный вздор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210412
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210412,
					"content": "В тот раз я тоже выпил немало, и сквозь туман в моей голове я плохо разбирал его рассказ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210413
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210413,
					"content": "Помню лишь, как он говорил, что Диадема знания была утеряна на некоторое время. Тогда он отвечал за установку и возвращение диадемы и очень испугался из-за её исчезновения, но в конце концов нашёл её в дупле дерева.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210414
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210414,
					"content": "Мы его видели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210415,
					"content": "Он утверждал, что Диадема знания - очень ценная реликвия, которая упомянута во многих текстах. Легенда гласит, что её создал знаменитый мастер древности и что она хранит многие тайны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210416
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210416,
					"content": "Сачин в конце концов доверил хранение Академии. Если бы этот мой старший коллега из Академии потерял диадему, он бы за всю жизнь не рассчитался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210417
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210417,
					"content": "Даже если она была утрачена лишь на время, об этом никто не должен был узнать. Академия строго осудила бы подобную грубую халатность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210418
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210418,
					"content": "Поэтому он всё скрывал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210419,
					"content": "Да. Он сказал, что в те времена об этом расспрашивали многие, даже маленькие дети. Но он лишь твердил им в ответ, что диадема никогда не терялась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210420
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210420,
					"content": "Вот только его испуг всё не проходил, поэтому, когда шум утих, он просто бросил работу и ушёл из Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210421
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210421,
					"content": "Я в тот вечер слишком много выпил, а когда очнулся на следующий день, он исчез. Чем больше я думал об этом, тем сильнее крепло предчувствие, что с Фестивалем Академии может случиться беда, если доверить его подобным типам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210422
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210422,
					"content": "В то время я был без работы, так что просто присоединился к комитету по планированию Фестиваля. Я попытался узнать больше о произошедшем, но это ни к чему не привело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210423
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210423,
					"content": "Диадема была потеряна и найдена, а человек, о котором ходили слухи, будто у него изменился характер, покинул этот мир, и от него ничего нельзя узнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210424
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210424,
					"content": "Двадцать лет - это большой срок. Такой большой, что никто и не помнит и не заботится о том, что тогда случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210425
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210425,
					"content": "Это всё, что я знаю. Если вам любопытно, можете продолжать расследование и, возможно, вам однажды откроется истина...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210426
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210426,
					"content": "Да у нас и подсказок никаких больше нет. А у тебя? Например, куда отправился тот твой знакомый?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210427,
					"content": "Я давно ничего о нём не слышал. Я искал его в пустыне, но в этом огромном море песка такая случайная встреча маловероятна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210428
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210428,
					"content": "Впрочем, у меня есть информация о Сачине. Хотите послушать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210429
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210429,
					"content": "Хм... Конечно, почему бы и нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210430,
					"content": "Во время моих странствий одним из моих спутников был предводитель наёмников, и в одной из наших бесед он упомянул, что у него есть сочинение учёного из Академии Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210431
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210431,
					"content": "Казалось, он считал его каким-то сокровищем и отказывался просто так показать мне. Лишь после долгих уговоров позволил взглянуть на текст. Я не мог прочитать содержание, но видел, что статья подписана Сачином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210432
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210432,
					"content": "В то время я не знал, кто такой Сачин, и мне было всё равно. Но когда я вошёл в комитет, то понял, что он был тем самым знаменитым мудрецом Вахуманы, который спонсировал Фестиваль Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210433
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210433,
					"content": "Если вам интересно, поищите в пустыне, в долине Дахри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210434
					],
					"speakerTitle": "Викас"
				},
				{
					"id": 735210434,
					"content": "Информация о Сачине? Хорошо, мы посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
