				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Васудева"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735210201,
					"content": "Вид этих молодых людей навевает воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210202
					],
					"speakerTitle": "Васудева"
				},
				{
					"id": 735210202,
					"content": "Турнир среди даршанов всегда служил для молодых гениев сценой, на которой они могут показать себя. К сожалению, не каждый гений в итоге может достигнуть успеха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210203
					],
					"speakerTitle": "Васудева"
				},
				{
					"id": 735210203,
					"content": "Почему ты так говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210204
					]
				},
				{
					"id": 735210204,
					"content": "Большинство гениев упрямы и равнодушны, им трудно понять мучения других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210205
					],
					"speakerTitle": "Васудева"
				},
				{
					"id": 735210205,
					"content": "А те, кто способен сопереживать другим, в свою очередь, склонны грустить и сомневаться в себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210206
					],
					"speakerTitle": "Васудева"
				},
				{
					"id": 735210206,
					"content": "Слабовольный человек не способен сделать шаг вперёд. А сильная воля не даёт её обладателю свернуть с пути, даже если тот оказался неверным. Есть над чем задуматься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Васудева"
				}
			]
		},
		{
			"id": 7352103,
			"completionStepIds": [
				7352103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
