					"Сухайб"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2712.056,
							67.739,
							4387.715
						],
						"pointId": 331000111
					}
				]
			},
			"dialogs": [
				{
					"id": 735210501,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210502
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210502,
					"content": "Ой... Этот парень выглядит по-настоящему свирепо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210503,
					"content": "Если есть что сказать, говорите. Я вас дожидаться не стану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210504
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210504,
					"content": "Мы слышали, что у тебя есть статья Сачина. Мы хотели бы взглянуть на неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210505,
					"content": "...Вы смеётесь надо мной, ребята?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210506
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210506,
					"content": "Ничего подобного! С чего ты взял?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210507,
					"content": "Похоже, вы действительно не в курсе. Я недавно решил убедиться в её подлинности. Оказалось, что это всего лишь чьи-то путевые заметки... Ничего ценного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210508
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210508,
					"content": "В то время некий Сачин нанял моего отца для охраны. Этот Сачин всё время ходил, задавал вопросы, всё постоянно записывал и бурчал что-то себе под нос. Это было очень странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210509
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210509,
					"content": "Однажды его рукопись унесло ветром, но он не придал этому большого значения. Отец считал, что для образованных людей записи очень ценны, потому зажёг факел и всю ночь искал пропавшие бумаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210510
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210510,
					"content": "Мы-то здесь грамоте не обучены. Отец относился к написанному, как к сокровищам, поэтому и передал мне. Откуда ему было знать, что записки ничего не стоят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210511
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210511,
					"content": "Да, вот это разочарование... А эти записки всё ещё у тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210512,
					"content": "Конечно. Хотите взглянуть? Раз они ничего не стоят, то и прятать от других незачем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210513
					],
					"speakerTitle": "Сухайб"
				},
				{
					"id": 735210513,
					"content": "Это и есть записи Сачина? Ничего не понятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210514,
					"content": "Однако... от одного взгляда на эти неразборчивые надписи становится грустно. Интересно, почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210515,
					"content": "Мы посмотрели, спасибо большое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735210516,
					"content": "Не за что. Хоть в них и нет большой цены, я хочу сохранить их у себя. В конце концов, это отец передал их мне. Захотите посмотреть ещё раз - приходите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сухайб"
				}
			]
		},
