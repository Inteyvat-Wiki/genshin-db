			"dialogs": [
				{
					"id": 722070301,
					"content": "Ха-ха... так вот где сокровище брата. Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070302
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070302,
					"content": "Хотя мы не сможем вместе отправиться в страну снов, я уверен, что мы сможем превратиться в частички света и вернёмся, чтобы найти тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070303
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070303,
					"content": "Интересно, а духи, блуждающие в чужой стране, тоже видят сны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситоки"
