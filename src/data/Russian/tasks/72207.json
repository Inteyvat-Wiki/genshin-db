				"points": []
			},
			"dialogs": [
				{
					"id": 722070101,
					"content": "Этого недостаточно... Совсем мало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070102,
					"content": "Сокровище, которое оставил мне брат, находится в этих ракушках...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070103,
					"content": "Они везде... они повсюду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070104,
					"content": "Это сокровище брата... я не могу уйти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070105,
					"content": "Сокровище?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Он отправился за пределы туманного моря, и это очень разозлило священника. Он сказал, что дух моего старшего брата никогда не сможет вернуться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070108,
					"content": "Но брат сказал, что там есть прекрасные цветы и морской жемчуг, что отец катается там на лодке, и они с сестрёнкой машут нам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070109,
					"content": "Он оставил свои сокровища и не вернулся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситоки"
				},
				{
					"id": 722070106,
					"content": "Расскажи о своём брате...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
