				"points": []
			},
			"dialogs": [
				{
					"id": 120240401,
					"content": "#*Зевает* Грядут мирные переговоры. Ты как, {NICKNAME}? {F#Готова}{M#Готов}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240402
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240402,
					"content": "Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240403
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240403,
					"content": "Это указания, которые я написала вчера вечером. Переговоры эти сложные, но как тщательно бы я ни размышляла, смогла предусмотреть только сто восемьдесят семь ситуаций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240404
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240404,
					"content": "Я все их записала. Таким образом ты сможешь быстро приспосабливаться независимо от развития событий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240405
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240405,
					"content": "Ничего себе! Она огромна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120240406,
					"content": "Посмотрим... «Ожесточённый спор», «Начало схватки», «Вооружённое восстание», «Скоординированная атака», «Захват заложников»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120240407,
					"content": "Так много! И к каждому ты нашла решение... Паймон теперь намного спокойнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120240408,
					"content": "Вот и славно. Эти мирные переговоры особенные. Они станут значительным шагом вперёд как для Ватацуми, так и для сёгуната.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240409
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240409,
					"content": "Но недовольство наших солдат ослабляет нашу позицию на переговорах. Нам придётся приложить больше усилий, чтобы переговоры были успешными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240410
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240410,
					"content": "Я, как Божественная Жрица острова Ватацуми, беру эту ответственность на себя. Не желаешь ли ты мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240411,
						120240412
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240411,
					"content": "Я обязательно помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240413
					]
				},
				{
					"id": 120240413,
					"content": "Отлично. Пора выходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240412,
					"content": "Мне тоже хочется, чтобы переговоры обернулись успехом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240413
					]
				}
			]
		}
	]
