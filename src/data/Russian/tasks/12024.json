			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми",
					"Кудзё Сара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240101,
					"content": "Давно не виделись, Кудзё Сара. Последняя наша встреча произошла на поле боя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240102
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240102,
					"content": "Да уж... в тот раз ты нанесла нам сокрушительный удар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240103
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240103,
					"content": "Прежде чем мы продолжим, скажи, что привело сюда тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240104
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240104,
					"content": "Я буду присутствовать при переговорах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240105
					]
				},
				{
					"id": 120240105,
					"content": "#Это так. {NICKNAME} станет {F#свидетельницей}{M#свидетелем} переговоров о мире.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240106
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240106,
					"content": "#{F#Она приняла}{M#Он принял} непосредственное участие в сражениях между нами и {F#сделала}{M#сделал} неоценимый вклад в установление мира. Думаю, никого более подходящего не найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240107
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240107,
					"content": "Согласна. Тогда приступим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240108
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240108,
					"content": "Начнём с управления водным пространством. В военное время мы запретили кораблям из Ватацуми ловить рыбу в водах Наруками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240109
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240109,
					"content": "Этот запрет мы решили снять, но теперь вашим судам, которые будут рыбачить в наших водах, в соответствии с законодательством Наруками придётся платить налог, чтобы возвращаться с уловом на Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240110
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240110,
					"content": "Идёт. Но, раз они будут платить налог, на время пребывания в ваших водах они должны находиться под защитой комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240111
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240111,
					"content": "Любые убытки, связанные с проблемами общественной безопасности, должны быть компенсированы комиссией Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240112
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240112,
					"content": "Принято. Внесём это в соглашение. В наших руках ваши суда будут в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240113
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240113,
					"content": "По всей видимости, переговоры идут довольно гладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120240114,
					"content": "Перейдём к вопросу передвижения и военной юрисдикции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240115
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240115,
					"content": "В прошлом наши люди по прибытии на Ватацуми, как и ваши по прибытии на Наруками, подвергались длительным допросам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240116
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240116,
					"content": "В результате этого пострадало экономическое взаимодействие. Всё меньше купцов занимается торговлей между островами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240117
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240117,
					"content": "Поскольку война завершилась, предлагаю назначить комиссию Ясиро советом по управлению торговлей между нашими островами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240118
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240118,
					"content": "Торговля - дело обоюдное. Если мы хотим добиться успеха, необходимо привлечь купцов с обеих сторон. Полную власть вверять комиссии Ясиро нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240119
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240119,
					"content": "Насколько мне известно, на данный момент Ватацуми испытывает острую нехватку средств множества ресурсов. Вы останетесь в выигрыше, если позволите комиссии Ясиро всё организовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240120
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240120,
					"content": "Это правда, у нас наблюдается некоторая нехватка, но со временем мы восстановимся. Благодаря широкому ассортименту товаров, которые мы способны производить, а также тесным торговым связям с другими областями мы можем обеспечить себя всем необходимым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240121
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240121,
					"content": "Тем более, что такие вопросы должен обсуждать с нами клан Камисато. Вы выходите за полномочия комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240122
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240122,
					"content": "Значит, пока мы это отложим. К вопросу военной юрисдикции: силы острова Ватацуми должны вернуться в юрисдикцию комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240123
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240123,
					"content": "Это неосуществимо. По меньшей мере, пока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240124
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240124,
					"content": "Ничего неосуществимого не вижу. За безопасность Инадзумы всецело отвечает комиссия Тэнрё. Мы не можем допустить, чтобы Ватацуми оставался единственным исключением из этого правила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240125
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240125,
					"content": "Ах вы дрянные Кудзё! Мало того, что вступили в сговор с Фатуи, так ещё хотите отнять у нас всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240127
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240127,
					"content": "Кокоми! Какой номер указания для подобного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120240128,
					"content": "Последний... но вы пока подождите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240129
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240129,
					"content": "Не вмешивайся, Тадакацу. Ситуация изменилась. Ожидайте дальнейших распоряжений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240130
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240130,
					"content": "Уверяю вас, ваши опасения мне хорошо известны. Но далее разбираться буду я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240131
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240131,
					"content": "Госпожа Кудзё, это серьёзное обвинение. Вам следовало бы объясниться перед островом Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240132
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240132,
					"content": "...Прошу простить меня. Никому ничего не предпринимать, пока я не закончу расследование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240133
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240133,
					"content": "Вы двое, подойдите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240134
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240134,
					"content": "Говорите. Сговор с Фатуи? Это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240135
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240135,
					"content": "Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240136
					],
					"speakerTitle": "Мотосукэ"
				},
				{
					"id": 120240136,
					"content": "Сговором я бы это не назвал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240137
					],
					"speakerTitle": "Суэ Ёситака"
				},
				{
					"id": 120240137,
					"content": "К нам обратились несколько Фатуи... Они говорили о сотрудничестве с целью продолжения войны против Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240138
					],
					"speakerTitle": "Мотосукэ"
				},
				{
					"id": 120240138,
					"content": "Тогда я подумал, почему бы и нет. Терять всё равно было нечего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240139
					],
					"speakerTitle": "Мотосукэ"
				},
				{
					"id": 120240139,
					"content": "Н-но мы были осторожны! Мы ни на что не соглашались. Мы просто сказали, что они могут отправиться на Ватацуми и доставить там немного неприятностей, а потом смотрели бы по ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240140
					],
					"speakerTitle": "Суэ Ёситака"
				},
				{
					"id": 120240140,
					"content": "Госпожа Кудзё, никакого заговора нет. Мы поговорили с ними один раз, и всё. Ума не приложу, как люди с Ватацуми об этом узнали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240141
					],
					"speakerTitle": "Суэ Ёситака"
				},
				{
					"id": 120240141,
					"content": "Достаточно. По возвращении вы будете наказаны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240142
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240142,
					"content": "Это же Фатуи. Вы что, забыли, что они нам причинили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240143
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240143,
					"content": "Вы вообще должны держаться от них подальше, не говоря уже о сотрудничестве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240144
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240144,
					"content": "Чего они пытались добиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240145
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240145,
					"content": "Основные силы Фатуи уже покинули Инадзуму. Те, что обратились к нам, хотели отомстить за своего босса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240146
					],
					"speakerTitle": "Суэ Ёситака"
				},
				{
					"id": 120240146,
					"content": "Так это были подчинённые той дамы?.. Значит, им нужна месть. Они хотят, чтобы в Инадзуме продолжались беспорядки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240147
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240147,
					"content": "Рано или поздно я выслежу их всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240148
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240148,
					"content": "За эту неурядицу мы понесём ответственность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240149
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240149,
					"content": "Приношу искренние извинения. Данная ситуация произошла из-за моей оплошности. Прошу дать нам ещё один шанс, чтобы продолжить переговоры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240150
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240150,
					"content": "Хе-хе... Конечно, госпожа Кудзё. Уверена, вы эту проблему уладите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240151
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240151,
					"content": "Но, пока в рядах комиссии Тэнрё раздор, доверить ей командование силами острова Ватацуми я не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240152
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240152,
					"content": "Не могу возразить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240153
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240153,
					"content": "Вернёмся к этому вопросу позже. Когда внутренние проблемы комиссии Тэнрё будут решены, мы рассмотрим его вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240154
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240154,
					"content": "Вопросы торговли я обговорю с комиссией Ясиро и удостоверюсь, что обе стороны примут полное участие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240155
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240155,
					"content": "Похоже, Кудзё Сара перешла в оборону. Теперь переговоры пойдут легко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240156
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120240156,
					"content": "Не ожидала, что великолепный стратег и командир Ватацуми также окажется умелым переговорщиком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240157
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240157,
					"content": "Надеюсь, наша следующая встреча пройдёт в ключе таких же переговоров... Решать разногласия на поле боя весьма обременительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240158
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240158,
					"content": "Сегодня остановимся на этом. Когда я вернусь, то проведу тщательное расследование внутренних проблем комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240159
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240159,
					"content": "Недавно мы разбили лагерь Фатуи. Полагаю, скоро они вновь попытаются связаться с вашими людьми, чтобы получить поддержку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240160
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240160,
					"content": "Советую пока ни о чём им не говорить, чтобы не спугнуть их. Пусть они сначала придут к вам. Тогда можно будет поймать их всех сразу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240161
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240161,
					"content": "Я обдумаю это. Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240162
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240162,
					"content": "Засим позвольте откланяться. До встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240163
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 120240163,
					"content": "Ваше превосходительство, мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240164
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240164,
					"content": "Поговорим, когда вернёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
		{
			"id": 1202402,
			"completionStepIds": [
				1202406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202406",
							"2"
						],
						"stepId": 1202406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240201,
					"content": "Ваше превосходительство, в-вы знали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240202
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240202,
					"content": "Меня уже уведомили о причинах ваших действий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240203
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240203,
					"content": "Считая, что комиссии Тэнрё нельзя доверять, вы хотели сорвать мирные переговоры и возобновить войну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240204
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240204,
					"content": "К счастью, был разоблачён и расстроен их тайный заговор. Но всё это чистая случайность, и цель ваших методов не оправдывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240205
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240205,
					"content": "Но ваше превосходительство, столько наших соратников отдали жизнь. Разве все наши усилия не пропадут впустую, если мы сейчас остановимся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240206
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240206,
					"content": "Я хочу сражаться! Я хочу полной победы, даже если придётся заплатить высшую цену!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240207
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240207,
					"content": "Ваши настроения мне понятны... но нельзя навязывать свою волю и ожидать, что за последствия будут нести ответственность другие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240208
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240208,
					"content": "Во время войны у нас были взлёты и падения, и завершилось всё славной победой. Думаю, для тебя это было крайне волнительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240209
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240209,
					"content": "Но как же все те, кто видел войну по-другому? Каждый день она приносила многим невыносимые страдания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240210
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240210,
					"content": "Жители Ватацуми хотят мира, поскольку они давно пожертвовали почти всем на дело войны. Они устали, и не хотят, чтобы вы затащили их обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240211
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240211,
					"content": "Я... но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240212
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240212,
					"content": "Я понимаю, правда. Но виновны не только вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240213
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240213,
					"content": "В значительной мере это было моё упущение. Я научила вас питать волю к борьбе, но не отпускать её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240214
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240214,
					"content": "Вы не виноваты, ваше превосходительство! Это всё... наш эгоизм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240215
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240215,
					"content": "В любом случае мы готовы принять наказание согласно военным законам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240216
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240216,
					"content": "Хорошо. Настоящим заявляю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240217
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240217,
					"content": "...что сегодня основываю тайные войска. Они будут отвечать за безопасность острова Ватацуми и нейтрализацию всех возможных угроз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240218
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240218,
					"content": "Вы с товарищами можете присоединиться, но подготовка будет суровой. Понадобится упорство и сила воли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240219
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240219,
					"content": "Ваше превосходительство... ч-что вы такое говорите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240220
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240220,
					"content": "Из мирных переговоров я заключила, что в ближайшем будущем клан Кудзё мира и стабильности не достигнет. Многие стремятся к миру, но некоторые всё ещё хотят войны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240221
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240221,
					"content": "Правильно, что Ватацуми идёт к миру, но нам нужно оставаться способными защитить себя. Всех тех, у кого воля к борьбе не угасла, я приглашаю начать самые невыносимые тренировки в вашей жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240222
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240222,
					"content": "И чтобы я вас не видела до тех пор, пока вы не сможете победить в сражении двух самураев сёгуната одновременно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240223
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240223,
					"content": "...Спасибо, ваше превосходительство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240224
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240224,
					"content": "Ладно. Записаться можете у Горо. И помните... больше никакого самоволия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240225
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240225,
					"content": "А если что-то случится... больше послаблений от меня не ждите, какой бы причина ни была.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240226
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240226,
					"content": "...Так точно. Отныне мы сосредоточимся на тренировках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240227
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240227,
					"content": "Благодарим за такую возможность, ваше превосходительство. Мы сейчас же отправимся к генералу Горо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240228
					],
					"speakerTitle": "Тадакацу"
				},
				{
					"id": 120240228,
					"content": "Уф... Кажется, это всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240229
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240229,
					"content": "Энергия опять падает... встретимся на тайной базе и отдохнём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
		{
			"id": 1202403,
			"completionStepIds": [
				1202405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202405",
							"2"
						],
						"stepId": 1202405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240301,
					"content": "Спасибо за всё. С твоей помощью на Ватацуми вновь был восстановлен мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240302
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240302,
					"content": "Как у тебя с энергией?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240303
					]
				},
				{
					"id": 120240303,
					"content": "Она понемногу восстанавливается... Скоро она будет полной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240304
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240304,
					"content": "Этот день показал, что я всё ещё не очень хорошо справляюсь с ситуациями, в которые вовлечено множество людей. У меня уже выходит лучше, но я до сих пор нервничаю перед толпой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240305
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240305,
					"content": "Думаю, в следующий раз на переговоры отправлю Горо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240306
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240306,
					"content": "Ты проделала отличную работу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240307
					]
				},
				{
					"id": 120240307,
					"content": "...Ты так думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240308
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240308,
					"content": "Ах, на деле мне до стандартов Божественной Жрицы ещё далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240309
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240309,
					"content": "В прошлом я только и хотела, что победить, восстановить мир и обеспечить всем счастливую жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240310
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240310,
					"content": "Но теперь я понимаю, что этого недостаточно. Счастье и желания людей такие разные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240311
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240311,
					"content": "Мне ещё предстоит долгий путь. Но ничего. Если его не преодолеть одним прыжком, придётся двигаться маленькими шагами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240312
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 120240312,
					"content": "В общем... Я недостаточно зрелая. Могу ли я попросить тебя... остаться на Ватацуми? Побыть со мной больше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
		{
