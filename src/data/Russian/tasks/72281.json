			"dialogs": [
				{
					"id": 722810701,
					"content": "В списке есть детский сборник рассказов под названием «Ночь на горе Ёго». Думаю, его можно купить здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810702
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810702,
					"content": "Детский сборник рассказов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810703,
					"content": "Да. Это для детей на Ватацуми. Госпожа говорит, что книга написана простым языком и очень полезна для изучения новых слов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810704
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810704,
					"content": "Здравствуйте, можно, пожалуйста, пять сборников рассказов «Ночь на горе Ёго».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810705
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810705,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810706
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 722810706,
					"content": "Ого, вам повезло! В одной из книг, которые вы только что купили, есть купон, дающий вам право на бесплатный подарок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810707
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 722810707,
					"content": "Ого, Горо выиграл подарок! Как здорово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810708,
					"content": "Держите, это игрушечная лиса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810709
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 722810709,
					"content": "Что? Игрушечная л-лиса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810710
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810710,
					"content": "Вы в порядке? У вас шерсть на хвосте дыбом встала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810711
					],
					"speakerTitle": "Фукумото"
				},
				{
					"id": 722810711,
					"content": "Всё нормально, спасибо за подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810712
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810712,
					"content": "#{NICKNAME}, ты не мог{F#ла} бы забрать эту игрушечную ли... лису, пожалуйста?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810713
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810713,
					"content": "Ты уверен?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810714
					]
				},
				{
					"id": 722810714,
					"content": "Да. Это мой подарок за то, что ты сопровождаешь меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810715
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810715,
					"content": "Кажется, Горо всё ещё не восстановился после встречи с Мико.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810716,
					"content": "Ладно, дальше... Хм, это не главная цель, но давайте купим лёгкий роман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810717
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810717,
					"content": "В списке указано, что редактор по имени Онодэра купил для госпожи последний том «Легенды о клинке». Лучше не заставлять его долго ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810718
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810718,
					"content": "Мы с ним знакомы. Мы отведём тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
