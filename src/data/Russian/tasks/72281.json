				"points": []
			},
			"dialogs": [
				{
					"id": 722810501,
					"content": "Горо, ты в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810502,
					"content": "А! Это вы... Эх, я не ожидал, что появится сами-знаете-кто... Это застало меня врасплох. И в следующий миг я уже прятался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810503
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810503,
					"content": "Я должен следить за безопасностью госпожи, но теперь я бесполезен и превратился в обузу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810504
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810504,
					"content": "Горо, не будь так строг к себе. Вообще-то, Кокоми дала тебе очень важное задание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810505,
					"content": "Вы отдаёте список книг Горо.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722810506
					]
				},
				{
					"id": 722810506,
					"content": "Список покупок... Понял, госпожа хочет, чтобы я исправил свои ошибки! Без проблем, предоставьте это мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810507
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810507,
					"content": "Горо, разреши пойти с тобой. Заодно мы покажем тебе всё на празднике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810508,
					"content": "Большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Горо"
				}
			]
		},
