			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми",
					"Горо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810201,
					"content": "#{NICKNAME}, Паймон, давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810202
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810202,
					"content": "Ого, это же Кокоми и Горо. Божественная Жрица и генерал Ватацуми лично приехали на праздник Иродори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810203,
					"content": "Да, но мы здесь не в качестве представителей Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810204
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810204,
					"content": "Сейчас на Ватацуми всё спокойно, и я хотела купить кое-какие книги. Поэтому решила посетить праздник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810205
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810205,
					"content": "Горо не особо заинтересован в празднике Иродори, но он сказал, что если я собираюсь на Рито, то он будет меня сопровождать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810206
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810206,
					"content": "Госпожа Сангономия путешествует за пределами острова Ватацуми, а также встречается сегодня со своим другом по переписке. Как её генерал, я обязан убедиться в её безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810207
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810207,
					"content": "...Другом по переписке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810208,
					"content": "Да. Мы недавно начали обмениваться письмами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810209
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810209,
					"content": "У нас одинаковый вкус в лёгких романах, а ещё мы всё время делимся друг с другом интересными мыслями. Конечно же, порой мы также яростно спорим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810210
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810210,
					"content": "Поскольку мы оба собирались приехать на праздник Иродори, мы решили воспользоваться возможностью, чтобы более подробно обсудить книги и наши взгляды на романы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810211
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810211,
					"content": "Звучит довольно профессионально! Раз вы оба любите романы, почему бы вам не попробовать написать роман вместе? Кто знает, может быть, вы перевернёте литературную сцену Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810212,
					"content": "Ха-ха, очень интересная идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810213
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810213,
					"content": "#Мне пора, {NICKNAME}. Нам с Горо пора отправляться на встречу в условленном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810214
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810214,
					"content": "Кокоми, Паймон очень интересно, что же у тебя за друг такой. Можно пойти с тобой? Не беспокойся, Паймон будет наблюдать издалека и не станет мешать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810215,
					"content": "Позволь подумать... Да, думаю, вы можете пойти со мной. Хорошо, пойдём вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				}
			]
		},
		{
			"id": 7228104,
			"completionStepIds": [
				7228104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228104",
							"2"
						],
						"stepId": 7228104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми",
					"Горо",
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810401,
					"content": "Это место встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810402
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810402,
					"content": "Здесь никого. Кажется, мы пришли рано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810403
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 722810403,
					"content": "Ого, кто это у нас здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810404
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810404,
					"content": "М-мико!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810405,
					"content": "(О нет, Паймон не рассчитывала встретиться с Мико! Они с Кокоми - противницы, а ещё они верят в разных богов...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810406,
					"content": "(Неужели... возникнет конфликт?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810407,
					"content": "Госпожа Гудзи из Великого храма Наруками. А я-то думала, откуда разит высокомерием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810408
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810408,
					"content": "Хе-хе, это же глава острова Ватацуми, похожая на слабую медузу, но жалящая своими словами столь же сильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810409
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810409,
					"content": "Ой-ёй... Всё стремительно выходит из-под контроля...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810410,
					"content": "Здравствуй, приятно познакомиться, «Роскошный жареный тофу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810411
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810411,
					"content": "Взаимно, «Глубоководная камбала».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810412
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810412,
					"content": "Ха-ха-ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810413
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810413,
					"content": "Эй... Что здесь происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810414,
					"content": "Мико - подруга Кокоми по переписке?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810415,
					"content": "Не может быть. Посмотри на них, они уже знакомы! Это значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810416,
						722810417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810416,
					"content": "Вся эта встреча друзей по переписке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				},
				{
					"id": 722810418,
					"content": "Хм? О чём ты говоришь? Я не понимаю. Я всего лишь пришла обсудить книги с госпожой Глубоководной камбалой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810419
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810419,
					"content": "Пойдём. Встреча пройдёт в поместье комиссии Кандзё наверху. Вид там просто потрясающий, идеальное место, чтобы выпить чай и обсудить творческие идеи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810420
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810420,
					"content": "Кто обсуждает книги в комиссии Кандзё? Вы серьёзно думаете, что кто-то в это поверит?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810421,
					"content": "Вы собираетесь говорить не о литературной сцене Инадзумы... а о ситуации в Инадзуме в целом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810422,
					"content": "Хе-хе, остров Ватацуми скоро проведёт официальные переговоры с сёгунатом о будущем развитии Инадзумы. Очень важно провести неформальную встречу, подобную этой, до начала официальных переговоров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810423
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810423,
					"content": "Верно. Особенно с кем-то не из сёгуната, таким как я, кто находится в хорошем положении, чтобы проверить, где каждая сторона проводит границы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810424
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810424,
					"content": "Но это только наша первая встреча. Ещё слишком рано объявлять об этом широкой публике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810425
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810425,
					"content": "Мм, ясно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810426,
					"content": "Кстати, а где ваш генерал? Разве ты не говорила, что он тоже присоединится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810427
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810427,
					"content": "Точно... Где же Горо?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810428,
					"content": "Горо пошёл купить кое-какие книги для меня. Он не сможет прийти на встречу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810429
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810429,
					"content": "Какая жалость. Мне хотелось поглядеть на его мохнатые ушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810430
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 722810430,
					"content": "#{NICKNAME}, мне нужно поговорить с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810431
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810431,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810432
					]
				},
				{
					"id": 722810432,
					"content": "У меня сложилось впечатление, что Горо не нравится иметь дело с Гудзи Яэ, поэтому поначалу я не хотела брать его с собой на Рито.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810433
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810433,
					"content": "Я заметила, что он инстинктивно спрятался, когда увидел её. Однако у Горо сильное чувство ответственности, и ему будет стыдно, когда он увидит меня снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810434
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810434,
					"content": "Поэтому я хотела бы попросить его купить несколько книг, чтобы облегчить его положение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810435
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810435,
					"content": "Но Горо редко что-либо покупает. Пожалуйста, сопроводи его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810436
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810436,
					"content": "Конечно, без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810437
					]
				},
				{
					"id": 722810437,
					"content": "Кокоми, сосредоточься на своей встрече с Мико. А книги предоставь нам с Горо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810438
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722810438,
					"content": "Спасибо. Я составила список необходимых мне книг. Пожалуйста, передайте его Горо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 722810417,
					"content": "...всего лишь прикрытие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				}
			]
		},
