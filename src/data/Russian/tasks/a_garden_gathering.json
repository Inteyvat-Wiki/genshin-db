			"dialogs": [
				{
					"id": 761820101,
					"content": "Так вот где ты жила раньше? Как здесь красиво.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820102,
					"content": "Раньше было ещё красивее. Я умею ухаживать за садом как надо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761820103,
					"content": "Ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820104,
					"content": "Почему ты опять смеёшься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761820105,
					"content": "Я представила, как Сандроне сидит на корточках возле клумбы, и эта картина показалась мне ужасно милой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820106,
					"content": "А можно мне заглянуть внутрь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820107,
					"content": "Конечно. Я там всё отмыла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761820108,
					"content": "Как ты собираешься распорядиться этим домом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820109,
					"content": "Хм... Хочу оставить его себе. В свободное время буду возвращаться сюда и ухаживать за ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761820110,
					"content": "Если ты будешь слишком занята, я могу присматривать за ним вместо тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820111,
					"content": "Я чувствую себя здесь так же спокойно, как раньше в твоей комнате. Мне тут очень нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820112,
					"content": "Хм... Как хочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				}
			]
		},
