			"dialogs": [
				{
					"id": 761820201,
					"content": "...Здесь так красиво.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820202,
						761820203
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761820204,
					"content": "Да. Мы ещё придём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761820203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Марионетка"
