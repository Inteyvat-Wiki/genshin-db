					"Джиллиана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600701,
					"content": "Ох уж этот Таннер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600702,
					"content": "Мне нужно приготовить лекарство.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "#Хм. Ты новеньк{F#ая}{M#ий}? А где Моко и Хилли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600704,
					"content": "#Ты прин{F#есла}{M#ёс} ингредиенты? Давай посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джиллиана"
				}
			]
		},
		{
			"id": 2006008,
			"completionStepIds": [
				2006009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
