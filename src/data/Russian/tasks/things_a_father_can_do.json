					"Джиллиана"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "Лекарство готово. К сожалению, оно всего лишь снимает симптомы. Чтобы ему стало лучше, Таннер должен больше отдыхать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600802,
					"content": "Я говорила ему об этом много раз, но он не обращает внимания. Всегда отвечает, что с ним всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600803,
					"content": "Ладно. Скорее отнеси лекарства Таннеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600804,
					"content": "Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600805,
					"content": "Не за что. Я просто делаю свою работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600806,
					"content": "Не буду тебя отвлекать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Джиллиана"
				},
				{
					"id": 200600807,
					"content": "Эх, если бы кто-то смог позаботиться о Таннере, ему не пришлось бы принимать эти лекарства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джиллиана"
				}
			]
		},
