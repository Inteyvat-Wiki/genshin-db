			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Таннер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "#Приветствую тебя, путешественн{F#ица}{M#ик}! Ты не встречал{F#а} моего сына? Его зовут Гай. *кхе-кхе*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600102,
					"content": "Всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Всё никак не могу вылечить эту дурацкую простуду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600104,
					"content": "Я обращался к сёстрам <color=#00E1FFFF>церкви</color>, но они не смогли вылечить болезнь. Зато они прописали мне лекарства, которые снимают боль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600105,
					"content": "Эх, я уже старенький. Не могу далеко ходить. Вот раньше лекарства для меня всегда готовили Моко и Хилли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600106,
					"content": "Но сейчас они очень заняты... кхе-кхе. Впрочем, <color=#00E1FFFF>Джиллиана</color> знает, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600107,
					"content": "Надо только, чтобы кто-то отнёс Джиллиане ингредиенты для лекарства, а она уже всё приготовит. Нужно лишь собрать <color=#00E1FFFF>три цветка-сахарка</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600108,
					"content": "Хорошо, займусь этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600109,
					"content": "Спасибо! Кхе-кхе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600112,
					"content": "Отнеси три цветка-сахарка сестре Джиллиане, она приготовит мне лекарство. Только <color=#00E1FFFF>Гаю ничего не рассказывай</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600113,
					"content": "Говорят, что церковь связана с орденом. Теперь юноше придётся следить за своими словами и поведением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600114,
					"content": "Надеюсь, что он не наделает глупостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600115,
					"content": "Прости, я и так тебя достаточно надолго задержал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600110,
					"content": "А почему не попросить своего сына?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 200600111,
					"content": "Гай где-то далеко, сражается с монстрами. Ему точно не до этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Таннер"
				}
			]
		},
