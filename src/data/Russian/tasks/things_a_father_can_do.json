				"points": []
			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "Подожди... Мы уже собрали достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200600402,
					"content": "Отнесём их <color=#00E1FFFF>сестре Джиллиане</color>? Или ты хочешь собрать ещё?",
					"roleType": "TALK_ROLE_NPC",
