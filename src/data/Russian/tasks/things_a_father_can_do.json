			"trigger": {
				"objectNames": [
					"Гай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "О, привет! Это у тебя цветок-сахарок? Прости за дерзость, но можно купить одну штучку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Гай"
				},
				{
					"id": 200600502,
					"content": "У моего отца ужасный кашель. Я просил сестру Джилиану приготовить лекарство, но у неё закончились ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Гай"
				},
				{
					"id": 200600503,
					"content": "Мне они тоже нужны для лекарства.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Да? Понятно. Ну ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Гай"
				},
				{
					"id": 200600505,
					"content": "Не буду тебя отвлекать. Поспеши к Джиллиане, ты найдёшь её в соборе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гай"
				},
				{
					"id": 200600506,
					"content": "Цветок-сахарок легко найти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Я знаю. Но я должен охранять ворота, мне нельзя покидать пост.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Гай"
				},
				{
					"id": 200600508,
					"content": "Я могу встретиться с Джиллианой только во время обеда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Гай"
				},
				{
					"id": 200600509,
					"content": "#Похоже, что ты сможешь сам{F#а} справиться с доставкой лекарства. Поспеши к Джиллиане, она должна быть в соборе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гай"
				}
			]
		},
