	"talks": [
		{
			"id": 2006001,
			"completionStepIds": [
				2006001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
