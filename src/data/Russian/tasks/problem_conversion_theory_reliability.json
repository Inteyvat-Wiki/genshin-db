			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рафик",
					"Ци Шань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "... Поэтому я считаю, что нельзя экономить на материалах в этой части.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230200102,
					"content": "Не переживай, я всё просчитал: эта часть достаточно прочная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200103,
					"content": "Но есть много проблем, которые невозможно предугадать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230200104,
					"content": "О чём вы спорите?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "А, это ты. Мы как раз обсуждаем проблемы проектировки того судна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200106,
					"content": "Я всё точно просчитал, каждая его часть обладает достаточной прочностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200107,
					"content": "А Ци Шань настаивает, что нельзя полагаться на их прочность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200108,
					"content": "Вся эта прочность, о которой ты говоришь, существует лишь в теории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230200109,
					"content": "При спуске на воду степень выдерживаемой нагрузки судна должна многократно превосходить твои цифры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230200110,
					"content": "Я понимаю, о чём ты. Но мои ресурсы ограничены, к тому же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200111,
					"content": "Даже если я бы и взял материалы подороже, мне бы хватило в лучшем случае лишь на киль корабля... Эх!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200112,
					"content": "Итак, предлагаю пока просто действовать по моему плану. Я уже купил все материалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200113,
					"content": "#Если у тебя есть желание помочь, путешественн{F#ица}{M#ик}, не мог{F#ла} бы ты перенести вместе со мной часть материалов? Мне одному не справиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200114,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "Тогда поручаю это тебе. Мне ещё нужно кое-что рассчитать. Когда закончу, перенесу остальные материалы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200115,
					"content": "Ци Шань тоже разбирается в кораблестроении?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "О да, в некоторых частях она делает расчёты быстрее меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200117,
					"content": "Не знаю, почему она работает официантом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Рафик"
				}
			]
		},
