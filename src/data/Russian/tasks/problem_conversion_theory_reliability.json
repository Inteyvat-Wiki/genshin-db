				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200501,
					"content": "#Ого! Спасибо, путешественни{F#ца}{M#к}. Вот твоя награда за труды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200502,
					"content": "Но эти материалы действительно очень тяжёлые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200503,
					"content": "Я начну строить как можно скорее. Лодка маленькая, много усилий не потребует и скоро будет готова к ходовым испытаниям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230200504,
					"content": "Заранее подготовьте спасательное оборудование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230200505,
					"content": "Ох, всё точно будет в порядке. Доверься мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рафик"
				}
