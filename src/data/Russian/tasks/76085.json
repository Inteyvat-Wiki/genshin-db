				]
			},
			"dialogs": [
				{
					"id": 760520401,
					"content": "Хм, знакомый запах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520402,
					"content": "Правда? Откуда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520403,
					"content": "Из комнаты Сандроне. У неё был напиток с таким запахом. Запах привлёк моё внимание, и когда она это заметила... она долго держала напиток в руках, не допивая его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520404,
					"content": "Словно... ждала, что я спрошу о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520405,
					"content": "И... ты спросила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520407,
					"content": "Что ты спросила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520408,
					"content": "«Разве ты не должна пить машинное масло?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520409,
					"content": "И... как она отреагировала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520411,
					"content": "Она сказала нечто довольно неприятное. Не хочу повторять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520413,
					"content": "Ты потеряла интерес после одного глотка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520414,
					"content": "Прости, но он был горьковатым... в общем, не очень вкусным. Неудивительно, что Сандроне выглядела такой кислой, когда его пила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520415,
					"content": "Паймон думает, что на то могли быть и другие причины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
