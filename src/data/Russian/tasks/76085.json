			"dialogs": [
				{
					"id": 760850601,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850602
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850602,
					"content": "Этот напиток очень вкусный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850603,
					"content": "Это мой самый любимый напиток на данный момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850604,
					"content": "Ух! Наконец-то мы нашли вкус, который нравится Коломбине. Паймон тронута...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760850605,
					"content": "Ммм... прости, что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850606,
					"content": "Подытожим: никакой явной горечи, не добавлять фруктовый сок в чистом виде, молоко можно, но лучше без него...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850608,
					"content": "Вот он, рецепт «невесомости»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Хорошо, что удалось выявить предпочтения. Теперь будем знать, что готовить в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760850610,
					"content": "...В будущем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850611,
					"content": "Конечно, мы же друзья! Если захочешь какой-нибудь напиток, только скажи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760850612,
					"content": "Так вот почему ты не допиваешь свой напиток? Ты бережёшь его, потому что думаешь, что это последний и больше не будет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760850613,
					"content": "...Хм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850614,
					"content": "Не беспокойся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760850616,
					"content": "Спасибо за угощение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
