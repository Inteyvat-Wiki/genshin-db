				"points": [
					{
						"sceneId": 3,
						"position": [
							2155.005,
							109.349,
							11195.66
						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520202,
					"content": "Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520203,
					"content": "Это напоминает мне о давних временах, когда я жила с Детьми Морозной Луны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520204,
					"content": "Они готовили чай из свежих листьев мяты, специй и сушёных ягод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520205,
					"content": "Каждый раз, когда я проходила мимо их домов, из окон доносился тонкий аромат трав...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520206,
					"content": "Ты когда-нибудь пробовала его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520207,
					"content": "Я хотела, но случая не представилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520208,
					"content": "О, почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520209,
					"content": "Когда «богиня» приходит к вам и спрашивает, можно ли попробовать ваш чай, никто не осмеливается предложить ей «простой чай», приготовленный для себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520210,
					"content": "О... Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520211,
					"content": "В итоге я получила «подношение» божеству в изысканной упаковке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520212,
					"content": "Не могу сказать, что он невкусный... Но в нём нет ощущения... «дома».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520213,
					"content": "Это можно исправить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520215,
					"content": "Вкус восхитительный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520216,
					"content": "...Признаться, идея добавлять молоко мне кажется довольно нетрадиционной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520217,
					"content": "Это рецепт из Мондштадта. Там любят добавлять в чай молоко, сливки и сахар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520218,
					"content": "Это необычно... в хорошем смысле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520219,
					"content": "Фух, Паймон рада, что тебе понравилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760520220,
					"content": "Мм... Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760520221,
					"content": "Похоже, лунный свет - не единственное средство, с помощью которого можно заглянуть в прошлое. Даже аромат напитка может вернуть давно забытые воспоминания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
		{
