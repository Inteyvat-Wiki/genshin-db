					"nextDialogs": [
						400681206
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400681206,
					"content": "Он утверждает, что весь остров превратился в музыкальный инструмент. Просто поразительно...",
					"roleType": "TALK_ROLE_NPC",
