						400681207
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400681207,
					"content": "И важную роль здесь играют водные артерии... Может, их надо почистить, чтобы «сыграть» на острове...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400681208,
					"content": "Обычно перед игрой на инструменте его нужно сначала почистить. В этом есть смысл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
