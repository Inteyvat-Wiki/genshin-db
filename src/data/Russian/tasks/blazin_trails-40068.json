			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Синь Янь",
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "Подъём, лодырь! Солнце уже слепит глаза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680202,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "Паймон, это не страшно, я сплю с закрытыми глазами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "Вот поэтому ты и не видишь, как солнце слепит глаза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}, как тебе спалось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680206,
					"content": "Могло быть и хуже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "Похоже, у всех одна и та же история. Сегодня я встал первым, так что во время прогулки нарвал фрукты для всех на завтрак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680209,
					"content": "А Паймон пришлось ждать, когда ты наконец проснёшься и мы сможем приступить к еде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680210,
					"content": "Все с удовольствием завтракают фруктами и непринуждённо общаются между собой...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "Что? А Фишль куда-то ушла с самого утра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680212,
					"content": "Да, похоже, она не хотела оставаться с нами. Сказала, что у неё задание для Гильдии искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680213,
					"content": "Не слишком похоже на правду! Она же прибыла сюда, чтобы вернуть Нирвану Ночи! А теперь вдруг образовалось какое-то задание для гильдии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680214,
					"content": "Будет тебе, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "Судя по её выражению лица, это было что-то важное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680216,
					"content": "Мы пытались послать Мону утешить её, как в прошлый раз... но Фишль сказала, что Мона не разбирается в делах искателей приключений, а потому не может пойти с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680217,
					"content": "И она даже не воспользовалась отговоркой про Нирвану Ночи, чтобы побыть одной. Непохоже на неё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680218,
					"content": "Видимо, у неё возникли серьёзные проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680219,
					"content": "Я бы очень хотела помочь ей. Но в одном она была права: сегодня мы отправимся исследовать другой остров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680220,
					"content": "Что? Правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "Да, решение было принято единогласно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680222,
					"content": "Как это единогласно? Меня не было на голосовании!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "А ну, Паймон проголосовала за тебя. Она сказала, что вы всегда вместе: куда ты, туда и она. И наоборот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680224,
					"content": "#Хе-хе, ты же искатель{F#ница} приключений! Паймон знает, что тебе не терпится отправиться на поиски!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680225,
					"content": "(Ох уж эта Паймон... Что ж, пусть будет так.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "Фишль предложила нам отправиться без неё, поскольку ей нужно кое-что проверить. Но нам не следует беспокоиться, она догонит нас, как только всё закончит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680227,
					"content": "Не стоит о ней беспокоиться, ведь, несмотря на её... причуды, Фишль - опытная искательница приключений. Думаю, нам следует поверить ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680228,
					"content": "Я знаю Фишль не так давно, поэтому могу ошибаться. Но мне чудится в ней какой-то внутренний конфликт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680229,
					"content": "Похоже на то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680230,
					"content": "Разногласия с другими людьми либо преодолеваются, либо забываются. Но когда ты конфликтуешь с самим собой, от этого нелегко избавиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680231,
					"content": "У меня были схожие чувства, поэтому я очень хорошо понимаю её. Хоть природа её проблем точно неизвестна, ей определённо нужно побыть одной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680232,
					"content": "Согласна. Вот только было бы интереснее отправиться в сегодняшнее путешествие всем вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680233,
					"content": "Синь Янь исполнена командного духа, как обычно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680234,
					"content": "#А, кстати, забыла кое-что сказать вам. Сегодня утром на острове к северу отсюда появилась иллюзия. Мы отправимся туда на исследование, как только {NICKNAME} закончит с завтраком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680207,
					"content": "Неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
