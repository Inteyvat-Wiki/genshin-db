					"nextDialogs": [
						400681005
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400681005,
					"content": "Цветок сказал, что водные артерии связаны с растениями, а растения приведут нас к роднику. Думаю, нам нужно идти вдоль потока.",
					"roleType": "TALK_ROLE_NPC",
