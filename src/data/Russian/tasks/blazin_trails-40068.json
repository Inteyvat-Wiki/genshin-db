			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Мона",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "С виду обычный остров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680302,
					"content": "Кажется, пахнет горелым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680303,
					"content": "Образы в чаше становятся яснее, но пока там мало что видно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680304,
					"content": "Смотрите, что я нашла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680305,
					"content": "Хм, это... барабан. Или растение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680306,
					"content": "Или растение-инструмент...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680307,
					"content": "Синь Янь, как ты думаешь, это может быть твой остров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680308,
					"content": "Ой, думаете, этот инструмент для меня? Ну, я попробую сыграть на нём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680309,
					"content": "Подожди! Вчера я прикоснулся к рокарию в бонсае, и мы тотчас переместились в другое пространство. Синь Янь, ты не хочешь сначала подготовиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680310,
					"content": "Ты прав, но мне переживать не о чем. Когда дело касается музыки, я готова ко всему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				}
			]
		},
