			},
			"dialogs": [
				{
					"id": 400680501,
					"content": "Дверь заперта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680502,
					"content": "Мона, превратишься в воду, чтобы проскользнуть внутрь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "А давай ты оставишь свои глупости при себе, заранее благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680506,
					"content": "Синь Янь, ты зачем заперла дверь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680507,
					"content": "Если бы я знала... Ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680508,
					"content": "Но вообще-то... Обычно я кладу ключи под горшок с цветами. Может, ключ где-то здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680509,
					"content": "О! А здесь есть горшок с цветами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680510,
					"content": "Нет, но был... цветок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "Стоит попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680504,
					"content": "Кадзуха, перепрыгнешь преграду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "Давайте придумаем что-нибудь другое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
