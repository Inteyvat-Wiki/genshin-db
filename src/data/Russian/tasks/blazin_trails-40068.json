				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "Ого, этот цветок просто огромный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680902,
					"content": "Здесь так жарко! Неужели это из-за цветка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680903,
					"content": "Да уж да! Я не ждал гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680904,
					"content": "А-а-а-а! Он умеет говорить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680905,
					"content": "Вчера белка тоже разговаривала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "Паймон знает, но это другое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680908,
					"content": "Здравствуйте! Мы прикоснулись к похожему на барабан растению на побережье и оказались здесь. А вы тут главный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680909,
					"content": "Это чертог музыки, а я лишь его привратник. Друзья мои, вы здесь для того, чтобы достичь музыкальных высот?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680910,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680911,
					"content": "Тогда скажи мне, что бы тебе хотелось выразить с помощью музыки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680912,
					"content": "Дух бунтарства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680913,
					"content": "Отличный ответ! Очень рад это слышать. Мне повезло встретить музыканта со схожими идеалами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680914,
					"content": "Синь Янь даже с гигантскими цветами хорошо ладит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680915,
					"content": "Люди, с которыми легко найти общий язык, везде заводят друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680916,
					"content": "Раз вы сюда добрались, вам наверняка хочется углубиться в чертог музыки. Но для этого я должен спеть, а я совсем осип. Мне очень жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680917,
					"content": "Тебе нездоровится? Нужно какое-то... э-э... лекарство от простуды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680918,
					"content": "Нет, просто я давно не пил студёной родниковой воды. После пары глотков моё горло прочистилось бы, и я мог бы открыть вам путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680919,
					"content": "Студёная родниковая вода?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680920,
					"content": "Да. Выпив этой воды, любой станет петь как соловей - будь то уставший взрослый, сонная птица или невинный ребёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680922,
					"content": "Тогда я разыщу её для тебя. Ты только скажи, где искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680923,
					"content": "Спасибо тебе! От чистой воды растения набираются силы и могут одолеть даже высокие горы. Родник можно найти на заросшем зеленью горном хребте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680924,
					"content": "Так нам придётся забраться в горы! А Паймон думала, что и морская вода сгодится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680925,
					"content": "Горный источник и морская гладь имеют разную натуру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680926,
					"content": "Однако, чтобы увидеть этот источник, вам понадобится моя сила. Протяни мне руку, друг, и сможешь увидеть то, что вижу я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "Пламенное сердце"
				},
				{
					"id": 400680927,
					"content": "После этого рукопожатия мы стали друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680906,
					"content": "Вчера лодка тоже разговаривала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
