				"points": []
			},
			"dialogs": [
				{
					"id": 400680401,
					"content": "Кхе-кхе! У Паймон полный рот пыли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680402,
					"content": "С тобой всё в порядке, Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680403,
					"content": "Ну вот, мы снова переместились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680404,
					"content": "Это место выглядит таким заброшенным... Синь Янь, эта иллюзия связана с тобой, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680405,
					"content": "Думаю, что так. Но... и правда, почему она выглядит так уныло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680406,
					"content": "Смотрите, там что-то светится. Похоже, нам туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680407,
					"content": "Давайте посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680408,
					"content": "Нет-нет, подождите! Это слишком просто. Наверняка там ловушка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400680409,
					"content": "Может, и так, но нам больше некуда идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400680410,
					"content": "Именно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "Если это действительно иллюзия Синь Янь, то здесь не должно быть ловушек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400680412,
					"content": "Твои слова мне по душе! Ты понимаешь, что это не в моём стиле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400680413,
					"content": "Звучит разумно. Ладно, давайте проверим, но будем начеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
