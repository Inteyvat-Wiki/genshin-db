			"dialogs": [
				{
					"id": 240010301,
					"content": "Вот и он. Выглядит неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 240010302,
					"content": "Когда же госпожа Стаэль осознает, что собаки не отличаются любовью к операм или к её романам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 240010303,
					"content": "Вернёмся. Госпожа, вероятно, очень переживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Блесин"
				}
			]
