				]
			},
			"dialogs": [
				{
					"id": 240010401,
					"content": "Бареа! Ох, мой малыш! Где же ты был?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Стаэль"
				},
				{
					"id": 240010402,
					"content": "Он спрятался в тихом местечке, чтобы немного отдохнуть. Эдакий коротенький отпуск.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 240010403,
					"content": "Ах, я так волновалась! Спасибо вам, офицер Блесин! Вы непременно станете героем моей следующей книги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Стаэль"
				},
				{
					"id": 240010404,
					"content": "Благодарю за честь, госпожа, но приберегите чернила для более выдающейся личности. Боюсь, читателя не заинтересует обыденная жизнь простого жандарма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 240010405,
					"content": "В таком случае сгущу краски... Клянусь, будет увлекательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Стаэль"
				},
				{
					"id": 240010406,
					"content": "Ваше обещание само по себе сделало мою жизнь ярче, госпожа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Блесин"
				},
				{
					"id": 240010407,
					"content": "Ох, но ведь в финале истории читателю нужно дать пищу для размышлений! Кого же сделать вашим напарником в этом рассказе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Стаэль"
				}
			]
		},
