			},
			"dialogs": [
				{
					"id": 710622801,
					"content": "Спасибо за еду. Пожалуйста, поговорите с командиром роты Антоном. Мне больше нечего вам сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622802
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710622802,
					"content": "Пожалуйста, не поймите меня неправильно. Речь идёт о военной тайне, ну вы понимаете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622803
					],
					"speakerTitle": "Радомир"
				},
				{
					"id": 710622803,
					"content": "Кхм, в любом случае... надеюсь, в следующий раз мы сможем увидеться как друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Радомир"
				}
			]
		},
		{
			"id": 7106234,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
