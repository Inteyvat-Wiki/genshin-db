			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Антон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621201,
					"content": "Мы скоро эвакуируемся и просим прощения, если помешали вашему приключению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621202,
						710621210,
						710621213,
						710621221
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621202,
					"content": "О сотрудничестве с Миллелитами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621203
					]
				},
				{
					"id": 710621203,
					"content": "Давным-давно, когда это место только закрылось, мы искали Цисин из Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621204
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621204,
					"content": "Сначала переговоры шли хорошо... и Синьоре даже удалось заключить несколько торговых соглашений в интересах обеих сторон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621205
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621205,
					"content": "А переброс Фатуи в Разлом был одним из дополнительных условий... Мы пришли сюда проводить исследования и уничтожить источник аномалий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621206
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621206,
					"content": "Вся информация, полученная в ходе наших расследований, справедливо распределялась между Снежной и Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621207
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621207,
					"content": "И у вас не было другой цели?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621208
					]
				},
				{
					"id": 710621208,
					"content": "По крайней мере, насколько нам известно, нет. Горожане даже благословляли нас, когда мы отправились в путь, и все считали... что мы - герои, которые жертвуют собой ради других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621209
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621209,
					"content": "Эх... кто же знал, что всё так обернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621210,
					"content": "Насчёт чёрного бедствия...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621211
					]
				},
				{
					"id": 710621211,
					"content": "Или чёрная катастрофа. Да как её ни называй... Это бедствие, которое произошло пятьсот лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621212
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621212,
					"content": "В общем... это извечный враг людей зимы. Мы верим, что... бедствие пятисотлетней давности затаилось, и мы должны всегда быть осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621213,
					"content": "Насчёт вас...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621214
					]
				},
				{
					"id": 710621214,
					"content": "А что насчёт нас? Да что тут говорить... мы упорно сражаемся и терпим поражения. Всё просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621215
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621215,
					"content": "Когда мы спустились, мы были девятой ротой, шестьдесят четыре человека. А сейчас? Больше половины, вместе с командиром роты, погибли или пропали без вести... Я смею предположить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621216
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621216,
					"content": "Хотя это одно и тоже... Нас разбросало по Ли Юэ, мы потеряли связь друг с другом. Мы проиграли и давно должны были отступить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621217
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621217,
					"content": "Ваши сослуживцы на поверхности напали на Ли Юэ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621218
					]
				},
				{
					"id": 710621218,
					"content": "Это неожиданно, но я понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621219
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621219,
					"content": "Для господина Пульчинеллы естественно отказаться от относительно малоценных активов ради более значимых начинаний. Так он мыслит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621220
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621220,
					"content": "Мы, как его непосредственные подчинённые, не станем возражать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621221,
					"content": "О Катарине...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621222
					]
				},
				{
					"id": 710621222,
					"content": "Вы её видели? Она жива?.. Надеюсь, она простит нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621223
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621223,
					"content": "Она и её младший брат младший сержант Николай выросли в Доме очага... Они дети Царицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621224
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621224,
					"content": "Она сказала, что ей непременно нужно отыскать своего брата. Мне кажется, атмосфера внизу подпортила ей мозги... Её брат никак не мог выжить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621225,
						710621230
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621225,
					"content": "Поэтому вы её бросили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621226
					]
				},
				{
					"id": 710621226,
					"content": "Бросили? Нет, она... она сама осталась. В конце концов, если у кого-то из нас возникнут ненужные навязчивые идеи, они тянут назад весь отряд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621227
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621227,
					"content": "Мы... мы готовы пожертвовать своими жизнями или жизнями наших близких ради всех... Это позиция Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621228
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621228,
					"content": "Катя была готова на это. Как и Коля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621229
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621229,
					"content": "Я бы понял, если бы они сделали то же самое со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621230,
					"content": "Не в таком уж и плохом она состоянии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621231
					]
				},
				{
					"id": 710621231,
					"content": "#Потому что ты чуж{F#ая}{M#ой}. Фатуи не могут и не должны терять хладнокровие перед простыми людьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621232
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621232,
					"content": "Но для неё мы были семьёй. Она тоже была нашей семьёй... когда-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621233
					],
					"speakerTitle": "Антон"
				},
				{
					"id": 710621233,
					"content": "Это она сама настояла на том, чтобы найти Колю... Надеюсь, она нас простит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Антон"
				}
			]
		},
