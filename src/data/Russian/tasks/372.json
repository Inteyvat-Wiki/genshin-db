					"Парень в зелёном"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3720101,
					"content": "А вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "Парень в зелёном"
				},
				{
					"id": 3720102,
					"content": "Да, точно! Это вы напугали Двалина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "Парень в зелёном"
				},
				{
					"id": 3720103,
					"content": "Кого? Двалина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720104,
					"content": "Это настоящее имя Ужаса Бури.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "А, ну да... Чаще его называют Ужас Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720107,
					"content": "Почему ты его так называешь? Вы с ним особенно близки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720108,
					"content": "А как ты думаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "Парень в зелёном"
				},
				{
					"id": 3720109,
					"content": "#Эй, {NICKNAME}! Этот парень какой-то странный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720110,
					"content": "Здравствуй! Нам нужно поговорить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "Здравствуй, чужестранец. Мы уже встречались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "Парень в зелёном"
				},
				{
					"id": 3720113,
					"content": "Меня зовут Венти. Я бард.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720114,
					"content": "Трёхкратный обладатель награды «Лучший бард Мондштадта».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720115,
					"content": "Чем я могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720116,
					"content": "Ты же узнал нас! Ты прекрасно понимаешь, что нам нужно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720117,
					"content": "Ужас Бури конечно же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720118,
					"content": "А? Ужас Бури?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720119,
					"content": "Эй! Не делай вид, что не понимаешь, в чём дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}, покажи ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720121,
					"content": "Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720122,
					"content": "Что? Совсем не мутный! Кристалл очистился? Как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720123,
					"content": "Не знаю, когда это произошло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "Это Двалин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720126,
					"content": "Это слеза страданий, пролитая драконом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720127,
					"content": "Слеза...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720124,
					"content": "#В прошлый раз, когда я смотрел{F#а} на него, он был очень мутный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "Расскажи о себе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "Ты не помнишь? Лиза же рассказывала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
		{
			"id": 3720301,
			"completionStepIds": [
				37203
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
