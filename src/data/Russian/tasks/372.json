			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Парень в зелёном"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3720501,
					"content": "Невероятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720502,
					"content": "#Ты... действительно надел{M#ён}{F#ена} удивительными способностями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720503,
					"content": "Барды слагают баллады о таких, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720504,
					"content": "Юный воин-герой,\\nВ глазах его свет!\\nЗаточен меч остро,\\nИ у зла шансов нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720505,
					"content": "Эх... Жаль, что сейчас нет времени, чтобы положить эти гениальные стихи на музыку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720506,
					"content": "Даже если мы не будем трогать Двалина, жизненные силы его всё равно покинут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720508,
					"content": "Как же я его понимаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "Я могу тебе ещё чем-нибудь помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "Как рыцарь Ордо Фавониус, я рекомендую тебе сдаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "Пламенный гнев сжирает его изнутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720509,
					"content": "#Благодарю тебя за то, что ты очистил{F#а} кристалл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720510,
					"content": "Но у меня есть свой план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720512,
					"content": "#Ты уже сделал{F#а} очень много. Я очень признателен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720513,
					"content": "Теперь у меня есть план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720515,
					"content": "Ты действительно думаешь, что это необходимо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720516,
					"content": "Забудь об этом. У меня есть другой план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720517,
					"content": "Какой ещё план?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720518,
					"content": "Эта слеза напомнила мне о давнишнем приятеле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720519,
					"content": "Каком ещё давнишнем приятеле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720520,
					"content": "Мне пора идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720521,
					"content": "Эй! Куда ты собрался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720522,
					"content": "К символу героев Мондштадта. Пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 3720524,
					"content": "Стоит присмотреть за этим «чудиком», как ты его называешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#Хм. Что ты думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720526,
					"content": "Ты знаешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "#Он тоже считает тебя странн{M#ым}{F#ой}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3720528,
					"content": "#Мне кажется, я где-то слышал{F#а} его голос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}