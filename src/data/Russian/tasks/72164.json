						721640202
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640202,
					"content": "Всё чисто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640203
					]
				},
				{
					"id": 721640203,
					"content": "Мяу-мяу. Отлично. Я тоже закончила - разогнала этих жуков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640204
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640204,
					"content": "Святилище выглядит всё лучше. Ящик отремонтирован, везде чисто. Мяу-мяу... Скоро здесь станет больше посетителей, жаждущих выразить своё почтение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640205
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640205,
					"content": "Мяу-мяу, мы непременно вернём святилищу былую славу до того, как вернётся Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640206,
					"content": "На сегодня остановимся на этом. Спасибо вам за помощь, мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640207
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640207,
					"content": "Всё время говорить на вашем языке... так утомительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640208
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640208,
					"content": "Мне нужно отдохнуть. Может быть, спустя какое-то время мне снова понадобится ваша помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640209
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640209,
					"content": "Когда это время придёт, возвращайтесь. Мяу-мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
