			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Нэко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "Мяу... Ящик действительно работает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640102,
					"content": "А, это ты. Этот ящик для подношений и правда работает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640103,
					"content": "#После того, как ты его починил{F#а}, к святилищу пришли два человека в зелёном, мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640104,
					"content": "Они принесли мору! А ещё высокий зелёный человек так разволновался, когда услышал, как я говорю! Вы, люди, такие нервные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640105,
					"content": "И всё-таки ящик для подношений - чудеснейшая вещь. Возможно, ремонт еще одного ящика привлечет еще больше людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640106,
					"content": "Это так не работает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "Правда? Человеческие дела такие сложные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640108,
					"content": "Важнее общая обстановка в святилище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721640109,
					"content": "И как вам в моём святилище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640110,
					"content": "Ну, тут лёгкий беспорядок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "Правда? Но этим маленьким негодникам так нравится играть в опавших листьях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640113,
					"content": "Но если подумать, Хибики всё время сгребала листья в кучу такой колючей длинной палкой. Раз Хибики так делала, значит это правильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640114,
					"content": "Где нужно сделать уборку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "Где мне разобраться во всех этих человеческих хитросплетениях. Хибики говорила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640117,
					"content": "Хибики брала эту палку и махала ей по земле туда-сюда. А я любила на эту палку охотиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640118,
					"content": "Но сейчас я временная настоятельница, и такие забавы мне не по статусу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640119,
					"content": "Но я помню, что Хибики ещё наливала на пол воду. Вот уж это никуда не годится, вода такая противная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640120,
					"content": "А ещё иногда приходил Домэки, брал такую железную штуку из двух половинок и делал щёлк-щёлк! И после этого листья и ветки падали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640121,
					"content": "Домэки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "Такой высокий человек. Они с Хибики часто играли вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640125,
					"content": "Фыр! Он все время обрезал ветки, которые мне больше всего нравились. Неприятный тип.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640126,
					"content": "Похоже, что они наводили чистоту и порядок. Это ещё называется «уборка».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721640127,
					"content": "Подметали пол, мыли его, обрезали ветки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721640128,
					"content": "Знакомая работа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "Это и есть «уборка»? Теперь я поняла. Можете этим заняться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640130,
					"content": "И да, щёлк-щёлк не надо. Ветки меня полностью устраивают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640131,
					"content": "Хватит длинной палки, листьев и воды. Вы меня поняли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640132,
					"content": "Мы с этим справимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "Мяу! Эту важную работу могу выполнить только я, сама Хибики назначила меня ответственной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640133,
					"content": "Да, могу я спросить? Хибики - это...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Хибики - это Хибики. Настоятельница святилища Асасэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640135,
					"content": "А твоё имя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "Меня зовут Нэко, и это имя мне дала Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640137,
					"content": "Обычно в святилище всех принимала Хибики, и мне не надо было здесь ни за чем присматривать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640138,
					"content": "Тогда у меня не было ни имени, ни титула. Я просто спала где захочу и играла с кем захочу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640139,
					"content": "А потом Хибики назвала меня Нэко, это значит «Засоня». Потому что я люблю поспать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640140,
					"content": "Хибики сейчас здесь нет, но святилищу нужна настоятельница. Поэтому я временно заняла этот пост.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640141
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640141,
					"content": "Из-за этого я и хочу, чтобы святилище сделалось таким же оживлённым, как раньше, к тому времени, как вернётся Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640142
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640142,
					"content": "Да! И когда она вернётся, я смогу сразу улечься спать у Хибики за пазухой, а не ждать, пока она починит ящик для подношений или разворошит листья палкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640143
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640143,
					"content": "Что ж, займитесь этим. А у меня дела: в святилище забрались противные жучки, нужно их прогнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640144
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 721640123,
					"content": "Щёлк-щёлк?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640124
					]
				},
				{
					"id": 721640124,
					"content": "А это, наверно, про обрезку ветвей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721640115,
					"content": "Что именно нужно сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640111,
					"content": "Небольшая уборка не помешала бы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				}
			]
		},
