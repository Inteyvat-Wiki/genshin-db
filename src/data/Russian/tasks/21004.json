				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "Порой даже Архонты не могут уклониться от своей судьбы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042002,
					"content": "#Я наш{F#ла}{M#ёл} подсказки в четырёх разных руинах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Четыре руины, четыре подсказки... Четыре завета Гуй Чжун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042004,
					"content": "Каждая подсказка объясняет один из заветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042005,
					"content": "Чтобы правильно разгадать шифр, нам необходим оригинальный текст Четырёх заветов Гуй Чжун. Эти четыре подсказки достаточно важны, но всё-таки они второстепенны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042006,
					"content": "Эти пять текстов как-то связаны, но как именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042007,
					"content": "Слияние.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Слияние... Эти четыре текста должны быть как-то связаны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042009,
					"content": "Постой... Я помню, что четыре завета были найдены в четырёх разных руинах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042010,
					"content": "Хм... Это всего лишь мои догадки, но, может быть, эти разные <color=#00E1FFFF>руины</color> соотносятся с четырьмя разными заветами Гуй Чжун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042011,
					"content": "Но пока я ещё не могу понять, как именно они соотносятся. Возможно, тебе придёт что-нибудь в голову... Особенно после того, как ты изучишь эти руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042012,
					"content": "В конце концов, я всего лишь щупленький учёный. Я не создана для полевых исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210042013,
					"content": "В любом случае мне есть над чем подумать. Буду ждать от тебя новостей. Ты знаешь, где меня найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		},
