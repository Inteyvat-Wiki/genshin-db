		{
			"id": 2100450,
			"completionStepIds": [
				2100450
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100450",
							"2"
						],
						"stepId": 2100450,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Как продвигаются поиски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045003,
					"content": "Успешно. Они действительно сливаются воедино.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Правда? То есть я была права! Сокровища находятся в месте слияния Четырёх заветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045005,
					"content": "Составители этой загадки, должно быть, с глубоким почтением относились к Гуй Чжун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045006,
					"content": "Они сохранили её заветы для будущих поколений, несмотря на то, что Ассамблея Гуйли была уничтожена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045007,
					"content": "Должно быть, современники просто обожали Гуй Чжун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045008,
					"content": "Она хотела, чтобы её народ был мудрым и придерживался нравственных норм. Она хотела, чтобы её люди были здоровыми и сильными, и чтобы их объединяла общая цель - защита своего дома, защита Ассамблеи Гуйли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045009,
					"content": "Но она потерпела поражение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Поражение? Можно и так сказать, в конце концов, она погибла... А её люди остались без крыши над головой, после разрушения ассамблеи Гуйли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045011,
					"content": "И всё же Четыре завета Гуй Чжун вновь увидели свет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045012,
					"content": "Эти заветы служат народу Гуй Чжун как указания и благословения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045013,
					"content": "Когда-то её народ захватил эту самую землю, руководствуясь её заветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045014,
					"content": "И пускай она больше не с нами, но её идеалы и убеждения никогда не исчезнут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045015,
					"content": "Кем бы ни был её почитатель, в сообразительности ему не откажешь. Использовать таинственные сокровища в качестве приманки для того, чтобы передать заветы Гуй Чжун - это очень умно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045028,
					"content": "Однако говорил ли тот человек о цветных металлах и драгоценных камнях, или же он считал сокровищем сами заветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045029,
					"content": "Ха-ха... По крайней мере, для меня очевидно, что заветы Гуй Чжун - настоящее сокровище, которое не сравнится с любыми сундуками золота или драгоценных камней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045030,
					"content": "Но если предоставить людям выбор... Выбрал ли бы кто-нибудь список советов, а не материальные ценности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045016,
					"content": "Похоже, что она была мягким Архонтом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Не уверена, что «мягкий» - подходящее слово для описания Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045018,
					"content": "Но, возможно, так было не всегда. Давным-давно Архонты, правившие народами, действительно могли считаться мягкими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045019,
					"content": "Они оберегали своих людей, ходили с ними по одной земле, и вместе стремились в светлое будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045020,
					"content": "Но мягким Архонтам было не под силу защитить свой народ. Взгляни на Гуй Чжун... Нам пришлось решить замысловатые загадки и устроить целую охоту за сокровищами, и всё это лишь для того, чтобы сохранить заветы, которые когда-то были известны каждому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045021,
					"content": "#Я бы хотел{F#а} с ней встретиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "#Хотел{F#а} бы встретиться с Архонтом? Интересные у тебя желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045023,
					"content": "Давай пофантазируем... Оказавшись перед Гуй Чжун, что ты ей скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045024,
					"content": "«Спасибо, Гуй Чжун!», «ты сделала всё возможное...» и прочие успокоительные фразы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045025,
					"content": "Если бы я оказалась перед Гуй Чжун... Я бы безошибочно процитировала её Четыре завета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045026,
					"content": "А потом сообщила бы ей, что потомки всё ещё чтут и почитают её идеалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210045027,
					"content": "Эти слова смогли бы немного успокоить Гуй Чжун, которая потеряла всё. Я так думаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		},
