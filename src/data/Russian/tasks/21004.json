			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сорайя"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "«Четыре завета Гуй Чжун»... Что это может означать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040102,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "#Ха-ха! А ты {M#настойчивый}{F#настойчивая}. Давай начнём расшифровку «Четырёх заветов Гуй Чжун»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040106,
					"content": "«Обучай мудростью, следуй добродетели, укрепляй свои кости, преследуй амбиции - слияние этих четырёх заветов известно как \"Ассамблея Гуйли\"».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040107,
					"content": "Эти заветы действительно применимы к реальной жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040108,
					"content": "Но в них также зашифрована подсказка, которая поможет нам найти сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040109,
					"content": "У меня не получилось её расшифровать. Думаю, нам придётся использовать то, что учёные назвали бы «устаревшим подходом».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040110,
					"content": "Семь надписей, которые мы обнаружили ранее, находятся в разных руинах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040111,
					"content": "Так как мы не знаем точно, с чего начать поиски, предлагаю осмотреть руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040112,
					"content": "Все?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Эм... Давай ограничим зону поисков долиной Гуйли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040114,
					"content": "Однако я всего лишь обычный учёный и не смогу поспевать за таким опытным путешественником, как ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040115,
					"content": "Поэтому всю полевую работу придётся выполнять тебе. Дай мне знать, если найдёшь что-нибудь интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040129,
					"content": "Кстати, в одних руинах я наткнулась на странную круглую пластину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040130,
					"content": "Но одной пластины недостаточно для комплексного анализа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040131,
					"content": "Сейчас мне кажется, что они связаны с Четырьмя заветами Гуй Чжун.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040132,
					"content": "Давай я отмечу это место на твоей карте. Возможно, там ты найдёшь какую-нибудь подсказку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040116,
					"content": "Нужно осмотреть все руины? Прямо вот совсем все?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "Конечно же нет! Надо признать, что мы никогда не сможем изучить ВСЕ руины в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040118,
					"content": "Давай ограничим зону поисков. Если сокровища связаны с ассамблеей Гуйли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040119,
					"content": "То логично было бы начать с долины Гуйли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040120,
					"content": "Ах, да! Мне просто не хватит сил бегать с тобой по долине целый день. Я не хочу быть обузой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040121,
					"content": "Поэтому всю полевую работу придётся выполнять тебе. Дай мне знать, если найдёшь что-нибудь интересное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040122,
					"content": "Держитесь, руины Ли Юэ, я иду!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "#Стой! Неужели ты собрал{F#ась}{M#ся} исследовать все руины в Ли Юэ? На это уйдёт целая вечность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040124,
					"content": "Ты слишком бурно реагируешь на слово «сокровища»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040125,
					"content": "Если сокровища связаны с ассамблеей Гуйли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040126,
					"content": "Давай для начала ограничимся поисками в долине Гуйли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040127,
					"content": "Постой! Я ещё не закончила! Не забудь тщательно осмотреть все руины! Если найдёшь что-нибудь интересное, поскорее возвращайся ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040128,
					"content": "Помни, искать нужно в долине Гуйли. Умерь свой энтузиазм искателя приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040104,
					"content": "Отправляемся на поиски сокровищ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Ух ты, стоит только упомянуть сокровища, и ты уже рвёшься в бой! Хм... Давай начнём расшифровку «Четырёх заветов Гуй Чжун»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Сорайя"
				}
			]
		},
		{
