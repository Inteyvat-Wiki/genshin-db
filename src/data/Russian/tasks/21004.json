			},
			"dialogs": [
				{
					"id": 210040201,
					"content": "Меня очень интересуют подобные поиски.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040202
					]
				},
				{
					"id": 210040202,
					"content": "Я отмечу на твоей карте расположение первых руин. Рекомендую начать поиски в этом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Сорайя"
				},
				{
					"id": 210040203,
					"content": "Если обнаружишь подсказку, прояви профессионализм и сначала <color=#00E1FFFF>всё запиши</color>, чтобы после спокойно обдумать находку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сорайя"
				}
			]
		},
		{
