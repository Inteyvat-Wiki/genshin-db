							9393.557
						],
						"pointId": 13574
					}
				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "#Кого я вижу! Наши постоянные {F#посетительницы}{M#посетители}! Хотите инвестировать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 760470202,
					"content": "Мне тут птичка напела, что твои инвестиционные купоны сплошной обман...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "Да бросьте! Просто у вас сейчас полоса неудач, вот вы и нафантазировали себе непонятно что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 760470204,
					"content": "Посудите сами. Так не бывает, чтобы дело всегда приносило вам стабильный доход, не требуя при этом никаких вложений. Где-то мы выигрываем, где-то проигрываем. Когда я был в Сумеру... Кхм. Я хочу сказать, сейчас удача от вас отвернулась, но удача - такая ветреная особа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 760470205,
					"content": "«Надежда» улыбается только самым упорным. Продолжайте покупать купоны, и однажды доход будет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 760470206,
					"content": "Ладно. Я как-нибудь ещё зайду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "#Ты что, серьёзно? Дал{F#а} ему вот так запросто себя заболтать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760470209,
					"content": "#Будешь нас обманывать, добром не кончишь! Мы... да, мы знаменитые {NICKNAME} и Паймон! У нас в городе полно друзей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760470210,
					"content": "Друзей? Что вы имеете в виду? Тех самых... друзей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Дабит"
				},
				{
					"id": 760470211,
					"content": "...Что? Да! Именно тех самых! И у нас их целая толпа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760470212,
					"content": "Ох, что же вы сразу не сказали? Я ведь не знал, что вы опасные люди. Вот, забирайте. Это всё ваше. Купоны я вам больше не продаю. Берите и уходите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дабит"
				},
				{
					"id": 760470208,
					"content": "Не вешай мне лапшу на уши.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
}