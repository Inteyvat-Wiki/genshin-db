					}
				]
			},
			"dialogs": [
				{
					"id": 790460901,
					"content": "Капельки, обращённые в камень, вообще смогут выпить зелье? И как вода будет пить воду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790460902,
					"content": "Или зелье предназначено для наружного применения? Нужно попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "Проклятие! Разве скроешься от них? Это жульничество, жульничество!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461002,
					"content": "Паймон так бы и пнула эти механизмы призраков, чтобы они полетели вверх тормашками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461003,
					"content": "Подожди, Капелька, что ты делаешь? Там призраки тебя увидят! Опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461004,
					"content": "Ты сошёл с ума? Уже утратил всякую надежду и решил присоединиться к своим друзьям в загробном мире?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Гневный главарь призраков"
				},
				{
					"id": 790461005,
					"content": "Нет, он хочет пожертвовать собой, чтобы отвлечь внимание врага... И откуда только взялся этот классический самоотверженный порыв?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Весёлый главарь призраков"
				},
				{
					"id": 790461006,
					"content": "Всё изменилось! Одинокий Гидро эйдолон застыл и медленно превратился в каменную статую, закрыв вас от смертельной линии обзора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Голос из громкоговорителя"
				},
				{
					"id": 790461007,
					"content": "Капелька... Он превратился в камень... и всё ради того, чтобы мы смогли достать ключ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461008,
					"content": "Капельку ещё можно вернуть к жизни!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "Точно! Пока призраки нас не видят, всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461011,
					"content": "Неужели Капелька догадался про это? Весьма умно и очень храбро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}, нужно поскорее найти ключ и достать лекарство. Мы не можем позволить Капельке страдать слишком долго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461009,
					"content": "Нельзя терять ни минуты!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904612",
							"2"
						],
						"stepId": 7904612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "Голос рассказчика описывает вам удивительную картину...\\nМудрецы осторожно капнули зельем на застывшего Капельку, и случилось чудо...\\nВремя будто обратилось вспять, и Капелька вернулся к жизни...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "О-о-о... Вот что значит обратиться в камень... Это очень неприятное чувство, очень неприятное. Я не могу допустить, чтобы мои друзья продолжали страдать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "Одинокий Гидро эйдолон"
				},
				{
					"id": 790461103,
					"content": "Капелька, зачем ты бросился вперёд, не сказав нам ни слова? Напугал Паймон до смерти! Как хорошо, что мы быстро достали лекарство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461104,
					"content": "Эти призраки так кричали, что я испугался и слова вымолвить не мог...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "Одинокий Гидро эйдолон"
				},
				{
					"id": 790461105,
					"content": "Но вы мудрецы, поэтому я подумал, что вы обо всём догадаетесь и без моих подсказок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "Одинокий Гидро эйдолон"
				},
				{
					"id": 790461106,
					"content": "Даже если бы я полностью окаменел, я знал, что вы спасете меня сразу, как только добудете лекарство, и всё будет хорошо! Я особо даже не волновался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "Одинокий Гидро эйдолон"
				},
				{
					"id": 790461107,
					"content": "Гм... Может, Паймон слишком увлеклась? Паймон ужасно переживала за Капельку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461108,
					"content": "Вжиться в роль - это правильно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "Ух! Мы ведь просто хотели немного развлечься, а Паймон с головой ушла в игру. Паймон неловко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461111,
					"content": "В общем... Мы уже преуспели в нашем начинании, теперь бери зелье и иди спасать своих друзей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461112,
					"content": "Спасибо, огромное спасибо вам! Я... Я так признателен, что это не передать словами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "Одинокий Гидро эйдолон"
				},
				{
					"id": 790461113,
					"content": "Мы с моими друзьями будем вечно помнить о том, что вы для нас сделали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "Одинокий Гидро эйдолон"
				},
				{
					"id": 790461114,
					"content": "Да ладно тебе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "Паймон надеется, что призраки прекратят свои бесчинства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461117,
					"content": "Впредь будьте осторожнее в лесу, не приближайтесь к этому замку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461118,
					"content": "Примите поздравления! Безупречная стратегия двух мудрецов и самоотверженность Гидро эйдолона отлично дополнили друг друга. Проклятие скоро спадёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "Голос из громкоговорителя"
				},
				{
					"id": 790461119,
					"content": "Появление мудрецов заставило призраков смирить свой нрав, а Гидро эйдолон и его товарищи снова вернулись к беззаботным играм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "Голос из громкоговорителя"
				},
				{
					"id": 790461120,
					"content": "Когда-то мрачный и загадочный лес превратился в спокойное место, где все живут в мире и согласии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "Голос из громкоговорителя"
				},
				{
					"id": 790461121,
					"content": "Постановка «Проклятие окаменения» подошла к концу. Благодарим за просмотр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "Голос из громкоговорителя"
				},
				{
					"id": 790461122,
					"content": "Отлично, мы закончили «Проклятие окаменения»! Паймон полностью погрузилась в происходящее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461123,
					"content": "Если так посудить, то уместные реплики и взаимодействие со зрителями могут вызвать небывалые эмоции... Где Дайя научилась таким приёмам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461124,
					"content": "Если бы только был шанс встретиться с ней, Паймон бы хорошенько расспросила её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790461115,
					"content": "Не стоит благодарности!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "Это значит, что Паймон здорово проводит время.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
