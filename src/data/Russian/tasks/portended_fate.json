			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эйде"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120202,
					"content": "В чём дело? Где Кариберт?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120203,
						80120204
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120203,
					"content": "Его здесь нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				},
				{
					"id": 80120205,
					"content": "Нет, нет, нет... Может, его нашёл кто-то другой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120206
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120206,
					"content": "Нет, нет, этого не может быть. Никаких признаков взлома и чужого присутствия нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120207,
						80120208
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120207,
					"content": "Может, он сбежал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120209,
					"content": "Плохо дело. Если Кариберта в его нынешнем состоянии увидят лесные дозорные или искатели приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120210,
						80120211
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120210,
					"content": "Тогда мы должны найти его первыми...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120212,
					"content": "Постой... Здесь что-то изменилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120213
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120213,
					"content": "О нет, он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120214
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120214,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120215
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120215,
					"content": "Зеркало... оно разбито...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120216
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120216,
					"content": "(Это зеркало... Оно же всегда было разбитым?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120217
					]
				},
				{
					"id": 80120217,
					"content": "Что это означает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120218
					]
				},
				{
					"id": 80120218,
					"content": "Должно быть, он снял маску... и увидел своё нынешнее обличье...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120219
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120219,
					"content": "Почему он меня не послушал?.. Мы обязаны найти его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120211,
					"content": "Нужно поспешить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120208,
					"content": "Но почему?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120204,
					"content": "Выходит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				}
			]
		},
		{
			"id": 801204,
			"completionStepIds": [
				801207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
