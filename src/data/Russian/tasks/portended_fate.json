						"stepId": 801207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лесной дозорный",
					"Лесной страж",
					"Лесной страж"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120401,
					"content": "Проклятье, лесные дозорные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120402
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120402,
					"content": "Эй, вы кто такие? Мы вас раньше не видели. Что вам здесь нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120403
					],
					"speakerTitle": "Лесной дозорный"
				},
				{
					"id": 80120403,
					"content": "Вы не видели хиличурла? Здесь проходил хиличурл... вы не видели его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120404
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120404,
					"content": "Я первая спросила... Не нарывайтесь на неприятности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120405
					],
					"speakerTitle": "Лесной дозорный"
				},
				{
					"id": 80120405,
					"content": "Я тебя спрашиваю!.. Ты не видела ХИЛИЧУРЛА?!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120406
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120406,
					"content": "Эйде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120407
					]
				},
				{
					"id": 80120407,
					"content": "В-вы чего? Не нужно так распаляться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120408
					],
					"speakerTitle": "Лесной дозорный"
				},
				{
					"id": 80120408,
					"content": "И что тут такого? В округе полно хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120409
					],
					"speakerTitle": "Лесной дозорный"
				},
				{
					"id": 80120409,
					"content": "Точно. Вот прям только что мы с парочкой этих болванов и разобрались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120410
					],
					"speakerTitle": "Лесной страж"
				},
				{
					"id": 80120410,
					"content": "Вы... Вы!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120411
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120411,
					"content": "Проклятые лесные дозорные! Гнусное отродье семи! Если вы хоть пальцем тронули Кариберта, вы за это поплатитесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120412
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120412,
					"content": "Ты!.. Безумный чужестранец! Да как ты смеешь оскорблять Лесной дозор?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120501
					],
					"speakerTitle": "Лесной дозорный"
				},
				{
					"id": 80120501,
					"content": "Будьте вы неладны, дозорные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120502,
						80120503
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120502,
					"content": "Остановись, Эйде!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120503,
					"content": "Или нам с лесными дозорными придётся остановить тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120515,
					"content": "После ваших уговоров они на время успокоились...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120505
					]
				},
				{
					"id": 80120505,
					"content": "Не понимаю, зачем поднимать шумиху из-за парочки каких-то хиличурлов?.. Бессмыслица и только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120506
					],
					"speakerTitle": "Лесной страж"
				},
				{
					"id": 80120506,
					"content": "Вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120507
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120507,
					"content": "К нему едва вернулся рассудок... Как вы могли так с ним поступить?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120508
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120508,
					"content": "Дозорные... вы и в самом деле никого из них не пощадили? Перебили всех хиличурлов, которых видели?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120509
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120509,
					"content": "Вот чудак... Ладно, раз уж тебе обязательно знать, я наткнулся на одного хиличурла, когда отделился от отряда... справить нужду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120510
					],
					"speakerTitle": "Лесной страж"
				},
				{
					"id": 80120510,
					"content": "Сначала я испугался, но понял, что ему нет до меня дела. Он брёл себе... вон туда. И я оставил его в покое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120511
					],
					"speakerTitle": "Лесной страж"
				},
				{
					"id": 80120511,
					"content": "Ещё есть надежда!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120512,
					"content": "Это мог быть Кариберт!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120513,
					"content": "Да! Замечательно... замечательно... Идём! Нужно найти его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120514
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120514,
					"content": "Вы что, просто возьмёте и уйдёте? Хоть бы спасибо сказали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лесной дозорный"
				}
			]
		},
