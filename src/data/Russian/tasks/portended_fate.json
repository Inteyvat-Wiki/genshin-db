				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120701,
					"content": "...Ха-ха, ясно. Теперь я понимаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120702
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120702,
					"content": "Всё сходится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120703
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120703,
					"content": "(Что случилось?.. У меня был обморок? Помню, как Кариберт снял маску, а потом...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120704
					]
				},
				{
					"id": 80120704,
					"content": "Наконец-то сознание вернулось к тебе, теперь мы сможем разделить радость, путешестве...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120705
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120705,
					"content": "Хотя постой... Почему я до сих пор так тебя называю? Я уже давно знаю, кто ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120706,
						80120707
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120706,
					"content": "Знаешь, «кто я»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				},
				{
					"id": 80120708,
					"content": "Хе-хе... Я с самого начала подозревал, что это ты. Но я должен был поговорить с тобой, чтобы убедиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120709
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120709,
					"content": "Но мы никогда не встречались прежде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120710
					]
				},
				{
					"id": 80120710,
					"content": "Разумеется. Человек такого высокого положения, как ты, не может знать всех нас лично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120711
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120711,
					"content": "Тем более, что... всё это время я пользовался вымышленным именем. «Эйде» - так когда-то звали одного из моих слуг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120712
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120712,
					"content": "Моё настоящее имя - Клотар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120713
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120713,
					"content": "...Клотар Альберих.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120714,
						80120715
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120714,
					"content": "Альберих!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120716,
					"content": "Этого нельзя было не увидеть. Несомненно, сила внутри Кариберта - та же, что и сила того, кого ты называешь «Грешником»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120717
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120717,
					"content": "Сейчас я уверен... Это сила Бездны, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120718
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120718,
					"content": "Наконец-то я вижу её собственными глазами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120719,
						80120720
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120719,
					"content": "Мне было плохо видно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120721,
					"content": "Не твоё дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120722
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120722,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120723
					]
				},
				{
					"id": 80120723,
					"content": "Грешник... Да, только грешник способен спасти другого грешника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120724
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120724,
					"content": "Кариберт не заслуживал такой участи, но сейчас... Это прекрасно. Он может сплести свою судьбу сначала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120725
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120725,
					"content": "Рождённый в ужасном горе, теперь он станет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120726
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120726,
					"content": "...«Плетением судьбы»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120727
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120727,
					"content": "(Опять этот термин... «Плетение судьбы»...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120728,
						80120729
					]
				},
				{
					"id": 80120728,
					"content": "Это существо и правда было из Бездны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120730,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120731
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120731,
					"content": "Зловещая?.. Опасная?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120732
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120732,
					"content": "Я и подумать не мог, что ты станешь такое говорить, станешь отрицать Бездну... Это нелепо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120733
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120733,
					"content": "Когда-то мы верили, что ты принесёшь Каэнри'ах могущество и надежду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120734
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120734,
					"content": "В тебе мы видели Бездну... чудесную загадку за гранью воображения и понимания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120735
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120735,
					"content": "...А тот, кто властвует над Бездной, властвует над всем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120736
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120736,
					"content": "Мы мечтали о таком будущем. Мы надеялись, что ты приведёшь нас к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120737
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120737,
					"content": "И что же досталось нам вместо этого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120738
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120738,
					"content": "#...о {M#принцесса}{F#принц} Каэнри'ах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120729,
					"content": "Но Бездна зловещая и опасная...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120720,
					"content": "Что всё-таки случилось с Карибертом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120715,
					"content": "Ты?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120707,
					"content": "Эйде, ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				}
			]
		},
		{
			"id": 801208,
			"completionStepIds": [
				801212,
				801213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801212",
							"2"
						],
						"stepId": 801212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дайнслейф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120801,
					"content": "#...Ты {M#очнулся}{F#очнулась}! Ох, какое облегчение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120802,
					"content": "#Паймон от беспокойства чуть с ума не сошла! ...{NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120803,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120804
					]
				},
				{
					"id": 80120804,
					"content": "#Что произошло, когда ты {M#потерял}{F#потеряла} сознание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120805
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120805,
					"content": "Я проверил артерии земли поблизости. Оказывается, на них повлияла Бездна, и с тех пор им не было покоя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120806
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120806,
					"content": "#По артериям земли текут знания и воспоминания мира... Что ты {M#видел}{F#видела}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120807,
						80120808
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120807,
					"content": "Основателя ордена Бездны... Альбериха...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120809
					]
				},
				{
					"id": 80120809,
					"content": "Ты о Клотаре Альберихе?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120810
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120810,
					"content": "После основания ордена Бездны вера в неё подвигла Клотара на многое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120811
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120811,
					"content": "Но проклятье бессмертия без конца истязало его тело и дух, и Бездна, в которую он веровал, в конце концов не спасла его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120812
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120812,
					"content": "Сто лет спустя он окончательно утратил разум и пропал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120813
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120813,
					"content": "Тем не менее его тёмное наследие продолжало жить... Та осквернённая статуя, с которой мы сталкивались ранее, была лишь одним из таинственных порождений его силы Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120814,
						80120815
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120814,
					"content": "Но в итоге...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120816
					]
				},
				{
					"id": 80120816,
					"content": "#Можно сказать и так. В противном случае {M#она бы не стала принцессой}{F#он бы не стал принцем} Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120817
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120817,
					"content": "#{NICKNAME}, ты в порядке? Судя по твоему виду... что-то произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120818,
					"content": "Мне... нужно рассказать вам одну историю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120819
					]
				},
				{
					"id": 80120819,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120820
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120820,
					"content": "Ваши слова погрузили Дайнслейфа в глубокие раздумья...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120821
					]
				},
				{
					"id": 80120821,
					"content": "#Значит, ты {M#видел}{F#видела} воспоминания {M#сестры}{F#брата} многовековой давности... собственными глазами. Невероятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120822
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120822,
					"content": "Но, как я и предполагал, понятие «Плетения судьбы» в самом деле появилось в ту эпоху...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120823
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120823,
					"content": "И, похоже, оно связано с сыном Клотара, Карибертом, и его состоянием...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120824
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120824,
					"content": "#Вот только {M#твоя сестра}{F#твой брат} не {M#говорила}{F#говорил} мне об этом ни слова... Значит, {M#она выбрала}{F#он выбрал} этот путь уже тогда?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120825,
						80120826
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120825,
					"content": "#Я тоже {M#хотел}{F#хотела} бы знать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120827,
						80120828
					]
				},
				{
					"id": 80120827,
					"content": "Но ясно одно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120829
					]
				},
				{
					"id": 80120829,
					"content": "Действительно. Должно быть, этот черёд событий вызвал период глубоких раздумий. Можно сказать, с этого всё и началось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120830,
						80120831
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120830,
					"content": "Кстати...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120832
					]
				},
				{
					"id": 80120832,
					"content": "Что именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120833
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120833,
					"content": "Нужно узнать, что закопано в этом поле.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120834
					]
				},
				{
					"id": 80120834,
					"content": "В поле? Почему вдруг это тебя волнует?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120835
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120835,
					"content": "...То есть, здесь? Что же, давайте раскопаем поле и посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120836
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120836,
					"content": "Через некоторое время вы с Дайнслейфом обнаруживаете, что именно было закопано в поле...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120837
					]
				},
				{
					"id": 80120837,
					"content": "...Паймон так перепугалась. Вы уже з-закопали их обратно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120838
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120838,
					"content": "Да. Можешь открыть глаза.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120839
					]
				},
				{
					"id": 80120839,
					"content": "Останки мужчины и женщины, похороненные вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120840
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120840,
					"content": "Любопытно, что мужчина был погребён значительно позже, а в руках он держит шёлковый платок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120841
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120841,
					"content": "#Что это означает? {NICKNAME}, как ты {M#узнал}{F#узнала}, что здесь похоронены тела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120842,
						80120843
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120842,
					"content": "Я думаю, что останки мужчины...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120844
					]
				},
				{
					"id": 80120844,
					"content": "Что? Быть этого не может...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120845
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120845,
					"content": "Разве что... Клотар Альберих смог избавиться от проклятья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120846
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120846,
					"content": "Возможно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120847
					]
				},
				{
					"id": 80120847,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120848
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120848,
					"content": "Как всё запутано... Мне нужно время, чтобы разобраться. И ещё выудить из памяти недостающие фрагменты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120849
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120849,
					"content": "#Пришло время расстаться, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120850
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120850,
					"content": "А? Опять уходишь? Мог бы остаться с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120851
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120851,
					"content": "Нам стоит пока разделиться, потому что... «Он» мог увидеть тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120852
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120852,
					"content": "«Он» это кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120853,
						80120854
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120853,
					"content": "Ты имеешь в виду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120855
					]
				},
				{
					"id": 80120855,
					"content": "Именно. Я догадываюсь, кто это... но для полной уверенности мне нужно подтвердить другие детали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120856
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120856,
					"content": "Я дам тебе знать о нашей следующей встрече, когда придёт время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120857
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120857,
					"content": "#Но что значит «\"он\" мог увидеть» {M#путешественника}{F#путешественницу}? Как такое возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120858,
						80120859
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120858,
					"content": "Это же просто воспоминание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120860
					]
				},
				{
					"id": 80120860,
					"content": "Если это он... боюсь, для него это не помеха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120861
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120861,
					"content": "Почему? Что ОН такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120862
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80120862,
					"content": "«Грешник»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120863
					]
				},
				{
					"id": 80120863,
					"content": "#Ладно, остановимся на этом. {NICKNAME}, тебе нужно хорошо отдохнуть. До встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120864
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80120864,
					"content": "И вот снова Дайнслейф уходит, и снова мы с тобой вдвоём...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120865
					],
					"speakerTitle": "Паймон"
				},
