			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эйде"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80120101,
					"content": "Что? Быть не может... Что произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120102,
						80120103
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120102,
					"content": "Ничего нет?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				},
				{
					"id": 80120104,
					"content": "Молящихся хиличурлов тоже нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120105
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120105,
					"content": "Неужели всё это было иллюзией?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120106,
						80120107
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120106,
					"content": "Вряд ли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120108,
					"content": "Действительно... Это не могла быть иллюзия. Я до сих пор чувствую, как по телу разливается великая и таинственная сила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120109
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120109,
					"content": "Не иллюзия, не совпадение, и определённо не сон! Чудо... да, божественное чудо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120110
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120110,
					"content": "...Пойдём. У его исчезновения должна быть причина... Уверен, однажды мы увидим его вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120111,
						80120112
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120111,
					"content": "Ты говоришь как фанатик...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120113,
					"content": "Может, это и правда было не божество, а «Грешник»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120112,
					"content": "Нам стоит вернуться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120107,
					"content": "Нам не могло привидеться одно и то же.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120103,
					"content": "Но ведь это то самое место...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				}
			]
		},
		{
			"id": 801202,
			"completionStepIds": [
				801204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
