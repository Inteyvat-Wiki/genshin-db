			"dialogs": [
				{
					"id": 80120601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120602
					],
					"speakerTitle": "Кариберт"
				},
				{
					"id": 80120602,
					"content": "Кариберт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120603
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120603,
					"content": "Мы нашли его!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120604
					]
				},
				{
					"id": 80120604,
					"content": "Кариберт, остановись! Это я, твой папа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120605
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120605,
					"content": "Что бы ты ни видел... всё это иллюзия. Обман!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120606
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120606,
					"content": "Я же говорил тебе, мы в сказочном мире, где всё понарошку... Прошу, Кариберт, вернись. Пойдём домой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120607
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120608
					],
					"speakerTitle": "Кариберт"
				},
				{
					"id": 80120608,
					"content": "Кариберт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120609,
						80120610
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120609,
					"content": "Не отвечает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120611
					]
				},
				{
					"id": 80120611,
					"content": "Как такое могло случиться? Разве разум не вернулся к нему? Он же слышит меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120612
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120612,
					"content": "Ну же, Кариберт, идём домой... Папа заберёт тебя домой, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120613,
						80120614
					],
					"speakerTitle": "Эйде"
				},
				{
					"id": 80120613,
					"content": "Подожди, с ним что-то не так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120615
					]
				},
				{
					"id": 80120615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кариберт"
				},
				{
					"id": 80120614,
					"content": "Что с ним сделала та странная сила?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120615
					]
				},
				{
					"id": 80120610,
					"content": "Он вернулся к прежнему состоянию...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120611
					]
				}
			]
		},
		{
			"id": 801207,
			"completionStepIds": [
				801211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
