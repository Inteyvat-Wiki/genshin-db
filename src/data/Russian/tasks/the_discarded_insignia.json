			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чевка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790231501,
					"content": "Вы до сих пор не нашли способ активировать механизм... Я не хочу вас торопить, но в чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231502,
						790231504,
						790231508
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231502,
					"content": "Зачем вы прибыли на острова?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231503
					]
				},
				{
					"id": 790231503,
					"content": "Ради выполнения славной миссии, зачем же ещё?! Но какой именно... я расскажу вам после того, как найдём Якова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231504,
					"content": "Этот шеврон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231505
					]
				},
				{
					"id": 790231505,
					"content": "Он не мой, но кажется мне знакомым. Странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231506
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231506,
					"content": "Это шеврон Якова. Он пошёл на задание вместе со своим отцом, а вернулся один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231507
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231507,
					"content": "Он получил этот шеврон после того задания... Я завидовал, что он смог добиться такой чести, поэтому я часто брал шеврон и любовался им...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231508,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
