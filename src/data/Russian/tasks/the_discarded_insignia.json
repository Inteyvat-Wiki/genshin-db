				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Чевка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230801,
					"content": "Это из-за меня... это из-за меня он такой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230802
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230802,
					"content": "Нет, я должен вернуть... я должен вернуть ему шеврон... я должен найти шеврон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230803
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230803,
					"content": "Эй! Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230804,
					"content": "Шеврон... шеврон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230805
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230805,
					"content": "Вообще ноль внимания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230806,
					"content": "Паймон, крикни погромче!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230807
					]
				},
				{
					"id": 790230807,
					"content": "А смысл? Он всё равно нас не слышит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230808,
					"content": "Прямо как Агафья, когда мы её только встретили. Тогда она пришла в сознание после того, как мы дали ей фотографию из карманных часов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230809,
					"content": "Наверняка есть что-то, что может привести этого Электро молотобойца в сознание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230810,
					"content": "#Кажется, он ищет какой-то шеврон... {NICKNAME}, может, дать ему то, что он ищет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7902311,
