					"Чевка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230101,
					"content": "Это из-за меня... это из-за меня он такой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230102
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230102,
					"content": "Нет, я должен вернуть... я должен вернуть ему шеврон... я должен найти шеврон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230103
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230103,
					"content": "Что бормочет этот Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230104,
					"content": "Эй, что ты там делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230105,
					"content": "Шеврон... шеврон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230106,
						790230107
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230106,
					"content": "С ним что-то не так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				},
				{
					"id": 790230108,
					"content": "Паймон как-то тревожно. Откуда здесь Электро молотобоец? Не замышляет ли он чего недоброго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230109,
					"content": "#{NICKNAME}, а ты что думаешь об этом молотобойце?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230110,
					"content": "Тревожиться стоит разве что о его заряженных атаках...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230111
					]
				},
				{
					"id": 790230111,
					"content": "Да, эти его стремительные спринты - пугающая штука... Но я не об этом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230112,
					"content": "Разве мы не должны привести его в чувство и спросить, что он здесь делает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230113,
					"content": "История и правда странная...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230114
					]
				},
				{
					"id": 790230114,
					"content": "И не говори. Этот Фатуи здесь один одинёшенек, твердит про какой-то шеврон. Как будто что-то ищет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230115,
					"content": "Такое не каждый день увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230116,
					"content": "Что сделало его таким?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230117,
					"content": "Из-за этого устройства...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230118
					]
				},
				{
					"id": 790230118,
					"content": "Ага, Фатуи также подверглись влиянию этого устройства. Но это не помогло разбудить его. И что же нам теперь делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230119,
					"content": "Я должен найти шеврон... Я должен найти его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230120
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230120,
					"content": "#Кажется, он ищет какой-то шеврон... {NICKNAME}, может, дать ему то, что он ищет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230107,
					"content": "С ним невозможно разговаривать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				}
			]
		},
