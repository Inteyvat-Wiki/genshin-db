			},
			"dialogs": [
				{
					"id": 790231101,
					"content": "Я должен найти шеврон... Я должен найти его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231102
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231102,
					"content": "(Нужно поговорить с ним снова, когда найдём шеврон...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902312,
			"completionStepIds": [
				7902313
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902313",
							"2"
						],
						"stepId": 7902313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чевка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790231201,
					"content": "Это... это он. Я прекрасно помню эти царапины... Откуда здесь вмятина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231202
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231202,
					"content": "Вспомнил! Она образовалась, когда Яков выбросил шеврон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231203
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231203,
					"content": "Так вот почему мы нашли его в таком странном месте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231204,
					"content": "Правда? Ха-ха-ха, я и представить не мог, что он будет на побережье... Спасибо большое! Нечасто встретишь таких хороших людей, как вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231205
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231205,
					"content": "#Эй, но вы... Вы же {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231206
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231206,
					"content": "#Да, я {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231207
					]
				},
				{
					"id": 790231207,
					"content": "А это Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231208,
					"content": "Понятно... Раз уж я попал в ваши руки, у меня нет выбора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231209
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231209,
					"content": "Отец учил меня: «Если попал в руки врага, пожертвуй собой ради чести семьи».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231210
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231210,
					"content": "Звучит устрашающе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231211,
						790231212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231211,
					"content": "Я не верю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231213
					]
				},
				{
					"id": 790231213,
					"content": "Мы просто хотим знать, что вы здесь делаете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231214,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231215
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231215,
					"content": "Отец учил меня: «Выдавать информацию своему врагу - это то же самое, что совершить предательство. В нашей семье нет предателей!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231216
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231216,
					"content": "Твой отец слишком строг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231217,
					"content": "Это уже перебор...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231218
					]
				},
				{
					"id": 790231218,
					"content": "Согласно мировоззрению моего отца, это позор, что я не только оказался в ваших руках, но и принял вашу помощь. Мне очень стыдно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231219
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231219,
					"content": "По правде говоря, мне так стыдно, что хочется плакать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231220
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231220,
					"content": "Всё с тобой ясно... Но это не повод для гордости, не надо говорить об этом во всеуслышание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231221,
					"content": "Но отец учил меня: «Плати за добро добром». В нынешней ситуации его наставления противоречат друг другу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231222
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231222,
					"content": "Поэтому я решил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231223
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231223,
					"content": "Что ты решил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231224,
					"content": "Я решил делать то, что я сам хочу. Я всё вам расскажу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231225
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231225,
					"content": "Да здравствует голос разума!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231226,
					"content": "Меня зовут Чевка. Раньше я занимался проверкой сигнала... Я не очень хорошо помню тот период, но я помню, что мы оказались на этом острове...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231227
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231227,
					"content": "Вспомнил! Я был с Яковом, и в какой-то момент между нами разгорелась ссора, в результате которой он выбросил шеврон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231228
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231228,
					"content": "Потом я... увидел, как Яков вошёл в какую-то странную штуку и исчез вместе с ней. С тех пор я не видел его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231229
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231229,
					"content": "Вот почему я здесь. Я искал способ увидеть его снова... Но потом у меня в голове вдруг зажужжало, и разум помутился. Вот как я оказался в том состоянии, в котором вы меня нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231230
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231230,
					"content": "Странная штука, которая исчезает после того, как вы в неё войдёте... Это одна из баек об архипелаге Золотого Яблока?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231231,
						790231232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231231,
					"content": "Это ужасная ловушка с искажённым пространством!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231233
					]
				},
				{
					"id": 790231233,
					"content": "Паймон кажется, что это маловероятно. Больше похоже на то, как работают те странные механизмы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231234,
					"content": "Хм, тогда, проход наверняка можно как-то открыть снова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231235,
					"content": "Вы можете открыть проход?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231236
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231236,
					"content": "Конечно. Вопрос в другом: зачем нам помогать тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231237,
					"content": "Ты же Фатуи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231238
					]
				},
				{
					"id": 790231238,
					"content": "Если вы сможете открыть проход и найти Якова, я скажу вам всё, что вы захотите. Ну, кроме дурного о Предвестниках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231239
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231239,
					"content": "Ух ты, какой быстрый поворот! Паймон аж почувствовала себя злодейкой... А как же наставления твоего отца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231240,
					"content": "Я виноват в случившемся с Яковом... Есть вещи, которые важнее этих так называемых принципов и учений... Ну, я так думаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231241
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790231241,
					"content": "#Ладно, уговорил! Ну что, {NICKNAME}, попробуем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790231232,
					"content": "Это невидимый монстр-людоед!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231233
					]
				},
				{
					"id": 790231212,
					"content": "...что его отец мог сказать такое!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231213
					]
				}
			]
		},
