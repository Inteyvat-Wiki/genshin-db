			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чевка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230501,
					"content": "Я и не знал, что здесь есть такой остров. Очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230502
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230502,
					"content": "Не помню, чтобы видел его во время нашего последнего исследования...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230503
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230503,
					"content": "Чевка, в чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230504,
					"content": "Да нет, ничего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230505
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230505,
					"content": "Да, Яков определённо побывал на этом острове!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230506,
					"content": "Точно, я должен найти Якова! Я обязан! Яков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230507
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230507,
					"content": "Эй, незачем так громко кричать. Успокойся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230508,
					"content": "Извини.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230509
					],
					"speakerTitle": "Чевка"
				},
				{
					"id": 790230509,
					"content": "#Не надо так нервничать, ты в безопасности. {NICKNAME}, давай поищем Якова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
