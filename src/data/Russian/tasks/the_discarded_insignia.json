			"dialogs": [
				{
					"id": 790230301,
					"content": "Слушай, может, он ищет тот шеврон, который мы нашли на пляже? Такой потрёпанный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230302,
					"content": "Давай покажем ему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790230303,
					"content": "Да, давай покажем ему шеврон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902305,
			"completionStepIds": [
				7902307
			],
