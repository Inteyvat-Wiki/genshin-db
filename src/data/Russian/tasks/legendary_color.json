			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бирам"
				],
				"points": [
					{
						"sceneId": 1200,
						"position": [
							409.031,
							104.539,
							380.959
						],
						"pointId": 3
					},
					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Взгляните. Это один из свитков, оставленных нашими предками. Нам нужно будет сплести что-то подобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250702,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250703,
					"content": "На изображении вы видите легендарного шамана Уитцилин. Она жила двести лет назад. И в своё время тоже была избрана старейшиной иктомизавров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250704,
					"content": "Она в совершенстве владела тайным искусством цвета и блестяще выполнила свою миссию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250705,
					"content": "На этом свитке записаны её деяния. Очень может быть, что она приложила руку к его созданию. Уровень работы поражает воображение, даже рядом с другими подобными свитками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250706,
					"content": "К сожалению, после её смерти избранным только и остаётся, что надеяться на «дар духов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250707,
					"content": "Ты собираешься возродить старую традицию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "Да, точно сказано. Единственное, что я бы поправил в твоей формулировке: возрождать традицию буду не «я», а «мы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250709,
					"content": "Ого! Паймон взволнована!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250710,
					"content": "Дай нам образцы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250711,
					"content": "Помощница вождя достаёт образцы для крашения.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "#{NICKNAME}, технология окраски ткани довольно сложна, но я уверен, что ты справишься. Главное - внимательно слушай мои указания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250713,
					"content": "Хорошо. Давай начинать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "На образец уже нанесены контуры рисунка, тебе остаётся лишь закрасить сегменты нужными цветами. Но чтобы краситель впитался в ткань, требуется время. Не спеши, иначе разные цвета на ткани могут смешаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250715,
					"content": "(Окрасить ткань, следуя инструкциям Бирама)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Отлично. Ткань окрасилась, рисунок получился ровным и чётким. Теперь давай пустим в ход остатки красителя. Скорее всего, в результате мы увидим тот самый особый цвет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250717,
					"content": "Ура, последний шаг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250718,
					"content": "(Нанести остатки красителя)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Эм... И что, получилось? Паймон ничего не видит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250720,
					"content": "Цвет не проявился... Ничего не вышло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250721,
					"content": "#Я где-то {F#ошиблась}{M#ошибся}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "#Нет, у тебя отличная техника. И ты чётко следовал{F#а} моим инструкциям. Скорее всего, у меня самого получилось бы точно так же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250723,
					"content": "Тогда что пошло не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250724,
					"content": "Быть может, нужна особая технология плетения ткани. Или краситель следует наносить иначе... Как бы там ни было, я пока далёк от разгадки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250725,
					"content": "Прости... Жаль, что мы не смогли помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250726,
					"content": "Это я должен просить у вас прощения. Вы столько работы проделали зря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250727,
					"content": "Разумеется, я заплачу вам вознаграждение, как мы и договаривались. Но я надеюсь, вы не станете отказываться от этого задания. Я продолжу свои исследования и буду информировать вас о прогрессе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250728,
					"content": "Не беспокойся, мы сдаваться не привыкли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250729,
					"content": "Но у Паймон есть один вопрос... Почему вы не фиксируете свою историю письменно? Зачем нужны эти свитки, если с ними столько мороки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250730,
					"content": "Ты ведь сам говорил, что хочешь изменить старые традиции! Может, с этого и начать? Записывать историю на бумаге намного проще. И записи получились бы подробнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250731,
					"content": "...Думаю, вы не совсем верно поняли мои идеи, но это вполне нормально. Я отвечу на твой вопрос, но сначала хочу кое-что вам показать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "Бирам",
					"speakerSubtitle": "Вождь Повелителей Ночного Ветра"
				},
				{
					"id": 150250732,
					"content": "Ага... Давай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
