			"dialogs": [
				{
					"id": 150250101,
					"content": "Вы и есть избранные старейшиной Тлапо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250102,
					"content": "Да! А ты кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250103,
					"content": "Меня зовут Тольтек. Вождь назначил меня вашим проводником. Посланник вождя уже ввёл меня в курс дела. Так что следуйте за мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тольтек"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
						],
						"stepId": 1502503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тольтек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "#{NICKNAME}, мы ведь здесь уже бывали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250202,
					"content": "Да, но не забывай, что мы избранные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "Странно, что даже после того как работа была закончена, наши предки всё равно не снимали печать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250204,
					"content": "С тех пор как пещеру запечатали, единственным человеком, который попал внутрь, был великий шаман Уитцилин. Это случилось два столетия назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250205,
					"content": "По её словам, в граффити рассказывается история героя по имени Кунтур...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250206,
					"content": "Простите, я отвлёкся. Я очень люблю граффити, могу говорить о них часами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250207,
					"content": "Ты точно не хочешь к нам присоединиться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250208,
					"content": "Нет. Однажды я пытался войти в пещеру, но печать преградила мне путь. Мой иктомизавр пробовал снять печать, но даже это не помогло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250209,
					"content": "Думаю, это особое испытание, которое приготовили для нас предки. Только прошедшие испытание достойны любоваться произведениями древних.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250210,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150250211,
					"content": "Не беспокойтесь обо мне. Всё равно я не пошёл бы с вами, даже без печати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250212,
					"content": "Я не такой, как наш вождь. Мне не хватает силы духа бросить вызов традициям. А вдруг что-то пойдёт не так, если я к вам присоединюсь? Ведь вы были избраны старейшиной иктомизавров, а я нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Тольтек"
				},
				{
					"id": 150250213,
					"content": "Ну ладно... Мы скоро придём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
