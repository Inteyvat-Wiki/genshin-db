							10151.47
						],
						"pointId": 10050
					}
				]
			},
			"dialogs": [
				{
					"id": 750670101,
					"content": "#Эти нечеловеческие существа очень сильны... Приветствую тебя, {M#храбрый воин}{F#храбрая воительница}... Я, Кенин, член отряда искателей приключений. Мой долг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670102
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750670102,
					"content": "#Мой долг... расправиться с этими монстрами. Да, я член отряда искателей приключений. Осторожно, {M#храбрый воин}{F#храбрая воительница}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670103
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750670103,
					"content": "Эти монстры очень хитры и могут принимать различные обличья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670104
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750670104,
					"content": "Каждую ночь, когда я пытался заснуть, то слышал... слышал их голоса. Они прятались в этих древних руинах. Поэтому я... не мог заснуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670105
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750670105,
					"content": "Здесь много монстров. Соблюдайте осторожность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кенин"
				}
			]
		},
		{
			"id": 7506702,
			"completionStepIds": [
				7506704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
