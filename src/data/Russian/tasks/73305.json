			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лилупар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733051201,
					"content": "...Осторожно. Я чувствую, как под землёй что-то трясётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051202
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 733051202,
					"content": "А? Что ты чувствуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733051203,
					"content": "Ничего страшного... это просто тренировка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051204
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 733051204,
					"content": "А, всё в порядке, просто тренировка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733051205,
					"content": "Подожди-ка. Какая такая тренировка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733051206,
					"content": "Тсс. Они здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лилупар"
				}
			]
		},
		{
			"id": 7330522,
			"completionStepIds": [
				7330522
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330522",
							"2"
						],
						"stepId": 7330522,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лилупар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733052201,
					"content": "Соедините меня с шахматной фигурой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 733052202,
					"content": "Соединить? Это в каком смысле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733052203,
					"content": "На ней должен быть выступ, вставьте его в отверстие на моей бутылке. Ничего сложного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 733052204,
					"content": "Эй, а ты ничего не путаешь? Твоя бутылка ровная, на ней нет никаких отверстий для подключения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733052205,
					"content": "Ты просто не можешь его увидеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 733052206,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733052207,
					"content": "Потому что я только что это придумала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "Лилупар"
				},
				{
					"id": 733052208,
					"content": "А-а... Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733052209,
					"content": "#Ладно, шутки в сторону. {M#Мой повелитель}{F#Моя повелительница}, просто возьмите меня и прикоснитесь к той фигуре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лилупар"
				}
			]
		}
	]
}