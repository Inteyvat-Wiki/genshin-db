			"dialogs": [
				{
					"id": 250270501,
					"content": "Ну как? Вы узнали мнение людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270502
					],
					"speakerTitle": "Милу Нуи"
				},
				{
					"id": 250270502,
					"content": "#Я услышал{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270503
					]
				},
				{
					"id": 250270503,
					"content": "Вы передаёте Милу Нуи отзывы клиентов...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250270504
					]
				},
				{
					"id": 250270504,
					"content": "Да? Вот так? Спасибо, их отзывы очень ценны для меня. Я постараюсь внести коррективы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Милу Нуи"
				},
				{
					"id": 250270505,
					"content": "Но почему они все как один определили мою пластинку как сборник детских песен?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Милу Нуи"
				},
				{
					"id": 250270506,
					"content": "Нет уж, мне точно нужно что-то поменять... Вот только с чего начать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Милу Нуи"
				}
			]
