			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Махина Нуи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Милу выпустил новую пластинку. Стоит ли её купить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Махина Нуи"
				},
				{
					"id": 250270202,
					"content": "О пластинках Милу Нуи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "А? У него отличные пластинки. Салу и заврёнок их обожают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Махина Нуи"
				},
				{
					"id": 250270204,
					"content": "Когда они капризничают и не хотят ложиться спать, я включаю им песню Милу «Ода весне».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Махина Нуи"
				},
				{
					"id": 250270205,
					"content": "Под неё они тут же ложатся и крепко спят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Махина Нуи"
				},
				{
					"id": 250270206,
					"content": "Ох... Но Салу всё повторяет, что ей нравится более яркая музыка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Махина Нуи"
				},
				{
					"id": 250270207,
					"content": "Вот бы господин Милу написал парочку энергичных песен. Под них ей было бы веселее играть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Махина Нуи"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
