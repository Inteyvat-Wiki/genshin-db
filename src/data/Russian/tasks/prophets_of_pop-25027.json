					],
					"speakerTitle": "Милу Нуи"
				},
				{
					"id": 250271602,
					"content": "Как твоя философия музыки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271603
					]
				},
				{
					"id": 250271603,
					"content": "#Ах, {NICKNAME}, рад видеть вас снова! Если хотите спросить о моих музыкальных идеалах, то могу лишь сказать, что... я усердно работаю в поисках прорыва.",
