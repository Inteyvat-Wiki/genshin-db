			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "Что за... Какой бойкий парень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131602,
					"content": "Дело плохо. Нужно добраться до Драконьего хребта и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131603,
					"content": "Паймон, изменения в мире грёз не изменят прошлого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "Ах... Точно. Вольфганг вообще «здесь» только потому, что архипелаг Золотого Яблока находится под воздействием того устройства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131606,
					"content": "Вот почему Паймон решила, что он спасся... Но в действительности он остался заперт в самой первой тайной комнате...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131607,
					"content": "И всё же этот Вольфганг так... бесит! Мы столько ему помогали, а он собирается «проложить путь для других»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131608,
					"content": "Неужели он не может хоть немного больше ценить свою жизнь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131609,
					"content": "Все за чем-то гонятся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "Паймон поняла! Поняла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131612,
					"content": "И всё же мне хотелось бы, чтобы таких людей ждал лучший конец. Например, они бы вернулись в Мондштадт, стали бы великими искателями приключений, может, сходили бы в таверну, чтобы поиграть с кошками, и досыта наелись бы цыплёнка в медовом соусе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131613,
					"content": "Почему для них никогда ничего не заканчивается хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131610,
					"content": "Благодаря таким, как он...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "Вольфганг никогда не доберётся до Драконьего хребта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
		{
			"id": 7901318,
			"completionStepIds": [
				7901318
