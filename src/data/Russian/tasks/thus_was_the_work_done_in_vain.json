					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131101,
					"content": "Дверь открылась! Фух, это было довольно сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131102,
					"content": "#{NICKNAME}, похоже, тут записей Вольфганга нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131103,
					"content": "Значит, в этом мире он ещё не успел сюда добраться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "Мы открыли комнату... Теперь он не попадёт в ловушку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131105,
					"content": "А вдруг устройство сработает снова...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "Погоди-ка... Почему бы нам не оставить ему сообщение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131108,
					"content": "Давай попробуем написать где-нибудь на видном месте. Расскажем ему, как разблокировать механизм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131106,
					"content": "Мы ведь не сможем открыть его снова...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
		{
			"id": 7901312,
			"completionStepIds": [
				7901315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
