			},
			"dialogs": [
				{
					"id": 790131201,
					"content": "Это место достаточно заметно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "Послание"
				},
				{
					"id": 790131202,
					"content": "Будем надеяться, что Вольфганг увидит сообщение и не запрёт себя в тайной комнате...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "Послание"
				},
				{
					"id": 790131203,
					"content": "Давай вернёмся и посмотрим. Может быть, его записи изменились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Послание"
				}
			]
		},
