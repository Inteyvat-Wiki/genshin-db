			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131801,
					"content": "(Старая гравировка, которая гласит...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "Гравировка"
				},
				{
					"id": 790131802,
					"content": "«Здесь очень сильный ветер, поэтому не стану пользоваться записной книжкой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "Гравировка"
				},
				{
					"id": 790131803,
					"content": "«Рассветы здесь прекрасные. Моё сердце наполняется радостью оттого, что я преодолел множество опасностей, чтобы добраться сюда».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "Гравировка"
				},
				{
					"id": 790131804,
					"content": "«Интересно, придёт ли кто-нибудь после меня, чтобы увидеть это».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "Гравировка"
				},
				{
					"id": 790131805,
					"content": "«Теперь, когда я справился с этим испытанием... Вперёд, к Драконьему хребту!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "Гравировка"
				},
				{
					"id": 790131806,
					"content": "«Прекрасное место. Только цыплёнка в медовом соусе не хватает...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "Гравировка"
				},
				{
					"id": 790131807,
					"content": "«Вольфганг».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гравировка"
				}
			]
		},
		{
			"id": 7901319,
			"completionStepIds": [
				7901327
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7901327",
							"2"
						],
						"stepId": 7901327,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "Так здесь не было никаких записей, потому что он вырезал сообщение на столбе. Значит, ему удалось добраться сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131902,
					"content": "Откуда только берётся его уверенность? Если бы мы ему не помогли, он до сих пор бы торчал в тайной комнате!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131903,
					"content": "Если он отправится на Драконий хребет, то превратится в цельномороженое мясо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131904,
					"content": "Это уже перебор...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "А? В смысле, он попадёт в беду, если отправится на Драконий хребет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790131908,
					"content": "Нужно отговорить его, да побыстрее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
