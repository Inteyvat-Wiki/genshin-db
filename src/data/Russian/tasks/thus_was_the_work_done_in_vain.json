			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790130201,
					"content": "Хе-хе, цыплёнок в медовом соусе очень вкусный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130202,
					"content": "Паймон понимает, почему этот Вольфганг скучал по нему!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130203,
					"content": "Бедняжка, заперт в ловушке без единого шанса в последний раз съесть цыплёнка в медовом соусе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130204,
					"content": "Эта записная книжка очень старая...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#Да, но... Помнишь, как мы прошли через что-то вроде пруда на острове, чтобы добраться до острова с другой стороны, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130217,
					"content": "На острове, который находится по ту сторону пруда, здания выглядят не такими старыми и разрушенными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130218,
					"content": "Здесь по сравнению с ними просто руины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130219,
					"content": "Может, здания внутри пруда...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "Похоже на то! Как будто те же самые места, но какими они были давным-давно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}, ты хочешь сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130223,
					"content": "То место внутри пруда - это прошлое этого острова?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130207,
					"content": "Получается... Мы сможем спасти этого искателя приключений, если узнаем, где находится тайная комната!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130208,
					"content": "Это сработает только в мире грёз...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "Да, но... Даже если это всё неправда и этого искателя приключений не существует... Разве мы не должны хотя бы попытаться спасти его? Его судьба была такой печальной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130212,
					"content": "Что ж, думаю, ты права.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#Хе-хе! Паймон знала, что ты согласишься, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130216,
					"content": "Давай поищем на острове внутри пруда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130214,
					"content": "Давай посмотрим...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "Да, давай попытаемся спасти этого Вольфганга!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790130209,
					"content": "Это не изменит того, что произошло на самом деле...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "...это прежний облик зданий снаружи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "Это произошло давным-давно, Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
