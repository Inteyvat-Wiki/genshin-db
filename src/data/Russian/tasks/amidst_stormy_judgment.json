			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "Как странно... Тут никогда так тихо не бывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080302,
					"content": "Гав, гав... Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 20080303,
					"content": "Тома опять чревовещанием занимается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080304,
					"content": "Тома... Тома...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080305,
					"content": "Гав! Гав! ...Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 20080306,
					"content": "Эй, хватит прятаться... Паймон тебя уже заметила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080307,
					"content": "Хм, тишина... Да куда же он делся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080308,
					"content": "Гав, гав, гав! Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 20080309,
					"content": "Хм? Чего это с Таромару такое? Он всегда такой умный пёсик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080310,
					"content": "Привет, вы Тому не видели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080311,
					"content": "Нет, мы думали, он с тобой! Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080312,
					"content": "Этого я и боялась... По пути сюда я услышала, что Тому забрала комиссия Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080313,
					"content": "Я не была уверена, что это правда, и поэтому сразу пришла сюда. Раз он не пришёл, как мы условились, значит это действительно так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080314,
					"content": "Сёгун Райдэн устраивает сегодня церемонию Охоты у статуи всевидящего божества, чтобы отметить сотый конфискованный Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080315,
					"content": "Я боюсь, что сотый владелец Глаза Бога, о котором идёт речь... это Тома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080316,
					"content": "Неужели... церемония, которой была занята комиссия Тэнрё и о которой рассказывал Тома, это и есть эта церемония Охоты? А готовили её именно для него?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080317,
					"content": "Похоже на то. Сёгун и комиссия Тэнрё считают церемонию важным событием. Сотым Глазом Бога они хотят отметить текущий успех Охоты на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080318,
					"content": "...Этого нельзя допустить. Мы должны его спасти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080319,
					"content": "Гав, гав! Гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "Таромару"
				},
				{
					"id": 20080320,
					"content": "Тише.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "Но ты Сирасаги Химэгими.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "Да! Нравится тебе или нет, но ты представляешь всю комиссию Ясиро. Так что если ты пойдёшь и выкинешь какой-то номер, то по сути объявишь, что вы враги сёгуна Райдэн, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080323,
					"content": "И если сделать это публично, то ты втянешь много обычных людей из комиссии Ясиро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20080324,
					"content": "Выбора нет... Я должна действовать быстро - церемония вот-вот начнётся. Я не могу просто бросить Тому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080325,
					"content": "Он мой друг! Подумать только, мы совсем недавно все вместе ели сябу-сябу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080326,
					"content": "Он и мой друг тоже. Я его спасу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "Но потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080328,
					"content": "Ты сама сказала. У нас мало времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080330,
					"content": "...Хорошо, я... я буду вас ждать. Возвращайтесь в целости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20080331,
					"content": "Не волнуйся, Аяка. Если жизнь друга в опасности - мы не подведём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
