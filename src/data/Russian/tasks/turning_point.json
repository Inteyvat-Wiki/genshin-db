			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бу Юнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Кэ Цин сказала, надо говорить так...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210302,
					"content": "Простите, здесь продаётся луна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210303,
					"content": "Да. Сколько вам нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Бу Юнь"
				},
				{
					"id": 10210304,
					"content": "Мне не очень удобно говорить о цифрах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210305,
					"content": "Прекрасный ответ. Пожалуйста, поднимайтесь. Ах да... У вас запланирована встреча с Нин Гуан?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Бу Юнь"
				},
				{
					"id": 10210306,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10210307,
					"content": "(Однако они использовали не гостевой пароль, а пароль Нефритового Равновесия. Что-то здесь не так...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бу Юнь"
				}
			]
		}
	]
}