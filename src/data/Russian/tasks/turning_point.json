				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "Фух... Паймон вымоталась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240202,
					"content": "Если бы мы не увидели парящий Нефритовый дворец сразу после того, как вышли из Золотой палаты, то не знали бы куда нам идти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240203,
					"content": "Фух... Мы же успели, да? Архонт Вихрей ещё в море? Он ещё не уничтожил Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240204,
					"content": "Вы? Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 10240205,
					"content": "А! Это Адепты! Что вы делаете в Нефритовом дворце? Паймон думала, что вы поссорились с Цисин... или уже помирились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240206,
					"content": "Перед лицом столь чудовищной опасности, Адепты и Цисин решили на время забыть о своих разногласиях и объединить силы в борьбе с общим врагом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10240207,
					"content": "Гм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Владыка Лун"
				},
				{
					"id": 10240208,
					"content": "Вот оно что... А как вы планируете защищать Ли Юэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240209,
					"content": "Ух ты... От одного вида Архонта Вихрей у меня мурашки по коже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240210,
					"content": "Не только у тебя. Новобранцы Миллелита еле держатся на ногах от страха. Наверное, простым смертным лучше не видеть пугающий лик древнего божества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10240211,
					"content": "Именно поэтому мы должны остановить чудовище, пока оно не добралось до Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Кэ Цин"
				},
				{
					"id": 10240212,
					"content": "Страшновато... Получается, две тысячи лет назад Архонты сражались против таких вот существ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 10240214,
					"content": "Смогут ли объединившиеся силы Цисин, Адептов и Миллелитов справиться с этим морским божеством?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240215,
					"content": "Мы обсуждали этот вопрос и пришли к выводу, что... едва ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10240216,
					"content": "Что? Но... Но вы все обязаны защищать город! Должен быть какой-то способ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240217,
					"content": "Есть только один способ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10240218,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10240219,
					"content": "Баллиста Гуй Чжун уже однажды привлекла внимание Цисин. Они подробно изучили её строение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10240220,
					"content": "Судьба распорядилась так, что создатель баллисты Гуй Чжун среди нас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10240221,
					"content": "Что простые смертные могут понять в механизме Адептов? Достаточно немного модифицировать арбалетную башню, чтобы превратить баллисту в смертоносное оружие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Хранитель Облаков"
				},
				{
					"id": 10240222,
					"content": "Хе-хе... Мы должны быть благодарны за такое «благословение» Адепта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10240223,
					"content": "Пусть будет так. Мы воспользуемся новой баллистой Гуй Чжун, чтобы отразить атаку древнего божества. Для этого все Адепты должны объединить усилия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 10240224,
					"content": "Времени больше нет. Битва начинается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нин Гуан"
				}
			]
		},
		{
			"id": 102408,
			"completionStepIds": [
				102408
			],
