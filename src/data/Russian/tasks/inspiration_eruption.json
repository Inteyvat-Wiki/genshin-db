			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Биле"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "Ха-ха-ха, как же эта игра всё-таки вдохновляет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220102,
					"content": "Какая-то новая игра?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "#{F#Путешественница}{M#Путешественник}! Вы вовремя, я как раз ищу кого-нибудь, кто бы опробовал мою игру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220104,
					"content": "Я назвал эту игру «Прорыв вдохновения».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220105,
					"content": "Она идеально повторяет весь процесс того как мы, барды и поэты, творим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220106,
					"content": "То есть нужно пить, пить и пить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "Расскажи поподробнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "Ха-ха-ха, а у вас хорошее чувство юмора. Пробуждать вдохновение с помощью вина - это отличная идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220108,
					"content": "Но для настоящей поэзии одного вина недостаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220110,
					"content": "Самый первый этап в создании поэзии - это поиск вдохновения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220111,
					"content": "Кто-то путешествует, другие погружаются в себя. Есть и те, кто... особенно любят стимулировать творческий процесс вином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220112,
					"content": "Поиск вдохновения - самый сложный этап, потому что мы не можем заранее знать, где оно нас ждёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220113,
					"content": "Большую часть времени нам кажется, что всё это впустую, мы теряем терпение и впадаем в хандру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220114,
					"content": "Но на самом деле мы потихоньку накапливаем вдохновение, сами того не осознавая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220115,
					"content": "Наступит переломный момент, и это вдохновение вырвется наружу единым потоком, превращаясь в чудесные стихи... Или картину. Или что-то ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220116,
					"content": "Разве из этого тоже можно сделать игру?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "Ха-ха-ха, конечно! Разобраться в создании стихов очень просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220118,
					"content": "К счастью, в Мондштадте оказалось немало господ, умеющих делать настольные игры, которые заинтересовались моей идеей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220119,
					"content": "Мы как следует всё обдумали и совместными усилиями создали эту прекрасную игру, «Прорыв вдохновения».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220120,
					"content": "Если интересно, можете сыграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "Биле"
				},
				{
					"id": 715220121,
					"content": "Кто знает, вдруг благодаря этому вы научитесь создавать настоящие стихи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Биле"
				}
			]
		}
	]
}