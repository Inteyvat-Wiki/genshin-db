	"talks": [
		{
			"id": 1202001,
			"completionStepIds": [
				1202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202003",
							"2"
						],
						"stepId": 1202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Горо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200101,
					"content": "Нам крупно повезло, что ты здесь. Без тебя мы бы не смогли помешать их побегу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200102
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200102,
					"content": "Что это у тебя? Указания от Кокоми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200103,
					"content": "Дай Паймон взглянуть... Ого, да здесь целая книга! И это всё указания Кокоми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200104,
					"content": "Да, но это не всё. У меня с собой ещё пять томов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200105
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200105,
					"content": "Ты не шутишь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200106,
					"content": "У её превосходительства найдётся план для любой ситуации. К тому же это её «Общие указания к действию», а они подробнее большинства других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200107
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200107,
					"content": "Но всё же хорошо, что они у нас есть. С ними мы готовы к ситуациям любой сложности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200108
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200108,
					"content": "Разобраться во всех ситуациях трудно, не говоря уже о том, чтобы записать их. Сколько же у Кокоми ушло на это времени?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200109,
					"content": "Командир! Вы вернулись на Ватацуми, чтобы вновь возглавить отряд Рыба-меч II? Нам вас недоставало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200110,
						120200111
					],
					"speakerTitle": "Котоку"
				},
				{
					"id": 120200110,
					"content": "Отряд Рыба-меч II всё так же силён?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				},
				{
					"id": 120200112,
					"content": "Госпожа Сангономия говорит, что сейчас время мирное, и численность войск следует уменьшить и помочь гражданскому населению вернуться к обычной жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200113
					],
					"speakerTitle": "Котоку"
				},
				{
					"id": 120200113,
					"content": "Половина из нас составляет особые отряды, которые поддерживают взводы. Другую половину перевели на патрулирование, строительство, земледелие и другие подобные работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200114
					],
					"speakerTitle": "Котоку"
				},
				{
					"id": 120200114,
					"content": "Понравилось это не всем. Два дня назад мой приятель жаловался, что его отправили строить дом, а он хотел остаться на передовой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200115
					],
					"speakerTitle": "Котоку"
				},
				{
					"id": 120200115,
					"content": "Дух сопротивления жив, значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200116,
					"content": "Ах да, мы здесь потому, что Кокоми пригласила нас на пир в честь победы. Горо, не подскажешь, где она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200117,
					"content": "Думаю, госпожа Сангономия сейчас в деревне Боро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200118
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200118,
					"content": "Говорят, там что-то произошло, и её превосходительство решила разобраться лично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200119
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200119,
					"content": "#Нам тоже, пожалуй, пора. Кхм, также... {NICKNAME}, по пути проверь, как у солдат дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200120
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200120,
					"content": "Я чувствую, что недовольство среди них растёт, а почему, не знаю... Они не говорят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200121
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200121,
					"content": "Они всегда рассказывали мне о своих трудностях, но теперь они что-то скрывают. Боюсь, у них могут быть неприятности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200122,
						120200123
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 120200122,
					"content": "Я посмотрю, что могу сделать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200124,
					"content": "Отлично! Паймон тоже будет рада видеть всех вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200125,
					"content": "#Тогда выдвигаемся, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120200123,
					"content": "Будет здорово повидаться с ними.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200111,
					"content": "Как у вас дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				}
			]
		},
		{
			"id": 1202002,
			"completionStepIds": [
				1202004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202004",
							"2"
						],
						"stepId": 1202004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэндзиро"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200201,
					"content": "Ты же... командир отряда Рыба-меч II, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200202
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200202,
					"content": "Это ты! Спасибо тебе. Благодаря твоим действиям на Ватацуми снова мир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200203
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200203,
					"content": "Я не из Рыбы-меча II, но видел тебя в Татарасуне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200204
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200204,
					"content": "А тот бой с самураями сёгуната... Это было нечто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200205
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200205,
					"content": "Могу ли я что-нибудь сделать для тебя? Я к твоим услугам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200206
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200206,
					"content": "#Я {F#слышала}{M#слышал}, что последнее время люди на взводе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200207
					]
				},
				{
					"id": 120200207,
					"content": "На взводе, говоришь? Я тоже это заметил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200208
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200208,
					"content": "Война закончилась совсем недавно, и, возможно, все ещё не отошли от боёв. Мы постоянно видели смерть. Такое забывается нескоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200209
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200209,
					"content": "Война кончилась так внезапно, а настроиться на нормальную жизнь так сразу непросто. Думаю, со временем всё наладится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200210
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200210,
					"content": "Другого объяснения я не вижу. Но я уверен, пока госпожа Сангономия с нами, Ватацуми в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200211
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200211,
					"content": "А с твоим возвращением здесь ещё безопаснее! Если что-нибудь понадобится, только скажи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200212
					],
					"speakerTitle": "Дэндзиро"
				},
				{
					"id": 120200212,
					"content": "Какой славный парень... Пойдём и поспрашиваем других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1202003,
			"completionStepIds": [
				1202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202005",
							"2"
						],
						"stepId": 1202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арисава"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200301,
					"content": "*Зевает* Наконец-то мир... лучше не бывает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200302
					],
					"speakerTitle": "Арисава"
				},
				{
					"id": 120200302,
					"content": "Хм? Мы знакомы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200303
					],
					"speakerTitle": "Арисава"
				},
				{
					"id": 120200303,
					"content": "Где-то я тебя уже видел... не припомню, где именно. Но ты определённо не враг. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200304
					],
					"speakerTitle": "Арисава"
				},
				{
					"id": 120200304,
					"content": "#Я {F#слышала}{M#слышал}, что последнее время люди на взводе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200305
					]
				},
				{
					"id": 120200305,
					"content": "На взводе? В смысле? Я ничего такого не замечал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200306
					],
					"speakerTitle": "Арисава"
				},
				{
					"id": 120200306,
					"content": "Да и обычно я ни с кем не общаюсь. Как по мне, все они слишком шумные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200307
					],
					"speakerTitle": "Арисава"
				},
				{
					"id": 120200307,
					"content": "И миром, который дался нам так тяжело, следует наслаждаться. В моей жизни теперь только солнце и морской бриз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200308
					],
					"speakerTitle": "Арисава"
				},
				{
					"id": 120200308,
					"content": "Прости, что не смог ответить на твой вопрос. Вот что, спроси у госпожи Сангономии. Она всё знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200309
					],
					"speakerTitle": "Арисава"
				},
				{
					"id": 120200309,
					"content": "Ой... он вот-вот заснёт. Оставим его в покое и спросим у кого-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
