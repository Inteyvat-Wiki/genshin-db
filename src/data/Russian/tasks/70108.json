			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сайрус"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Привет. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 701080402,
					"content": "У меня для вас письмо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Письмо? ...А, это от неё. Могу поспорить, она опять спрашивает об экспедиции...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 701080404,
					"content": "Эх, и что мне делать?.. На Драконьем хребте слишком опасно, и сейчас с огнём не сыщешь группы, которая бы отважилась туда подняться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 701080405,
					"content": "#Скоро я напишу ей ответ, в котором поясню ситуацию. Спасибо, что доставил{F#а} мне письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 701080406,
					"content": "Чуть не забыл... Ранее она написала, чтобы я подготовил для тебя награду. Возьми, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 701080407,
					"content": "Напоследок я добавлю... Боец ты, кажется, хороший, но в горах следует проявлять осторожность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Сайрус"
				},
				{
					"id": 701080410,
					"content": "Эх, Драконий хребет... Подвернись мне возможность повести группу в заснеженные горы, я бы непременно ею воспользовался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайрус"
				}
			]
		},
