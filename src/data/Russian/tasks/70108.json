			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эстер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "Маячок установлен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701080302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Очень хорошо! Спасибо. Теперь я могу более-менее точно установить высоту горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701080304,
					"content": "Да, насчёт награды... Я попросила Сайруса кое-что подготовить для тебя. Не забудь зайти к нему, когда будешь в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701080305,
					"content": "По пути передай ему это письмо. Он обещал держать меня в курсе о подготовке второй экспедиции в горы, но от него до сих пор нет новостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Эстер"
				},
				{
					"id": 701080306,
					"content": "Когда мои маячки будут отремонтированы, мне придётся вернуться на Драконий хребет и установить их. Там ещё столько всего нужно изучить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эстер"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
