			"dialogs": [
				{
					"id": 710190201,
					"content": "В этом горшке лежит большой камень... Паймон думает, это часть сада камней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710190202,
					"content": "Но разве такие вещи не должны находиться в садах или подобных местах? Зачем ставить его здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710190203,
					"content": "Смотри! На его верхушке что-то есть. Кажется, это какой-то знак... Паймон думает, что это должно быть важно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710190204,
					"content": "Раз уж мы путешествуем по Ли Юэ, давай поищем похожую на этот камень гору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710190205,
					"content": "Будет здорово, если что-нибудь найдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
