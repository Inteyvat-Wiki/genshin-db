			"dialogs": [
				{
					"id": 730240401,
					"content": "Хм? Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730240402,
					"content": "Ах ты, гриб поганый! Кыш отсюда, кыш!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240403
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730240403,
					"content": "#Ой, {NICKNAME}, тот человек попал в беду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730240404,
					"content": "Скорее на помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
