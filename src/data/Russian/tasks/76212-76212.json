			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Квиаукетцаль"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "Вы остановились у верхней части ближайшей книжной полки...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "#Здесь безопасно. Что случилось, {F#златовласая красавица}{M#мой златовласый друг}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120305,
					"content": "Ничего, простое любопытство...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "Помост высокий, с него открывается хороший вид. Подходящее место, чтобы спрятаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120309,
					"content": "У нас в большом{RUBY#[S]племени} доме оставаться на земле было опасно. Владыкам {RUBY#[S]суверенные правители}над нами могло вдруг прийти в голову убить нас, и налётчики из других больших {RUBY#[S]племён}домов могли напасть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120310,
					"content": "Только укрывшись среди скал и древесных крон, подобно кетцалю, мы могли опередить бедствие, сбежать, уцелеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120311,
					"content": "Да и потом, Виндия сказала, что хочет увидеть, как я летаю. Она хочет пе{RUBY#[S]сочинять}ть истории о герое, что отправляется на поиски приключений верхом на гигантской птице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120312,
					"content": "Она точно тебя не обманула?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "Нет. Виндия очень хорошая. Наверное, такая же хорошая, как Владыка Перекрёстка. Они очень добрые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120314,
					"content": "Но вы летаете очень высоко. Впечатляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120315,
					"content": "Вот, это вам. Подарок в знак нашей дружбы. А теперь мне нужно подумать, как летать ещё выше, чтобы никто меня не настиг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120316,
					"content": "Здесь нет ни великих {RUBY#[S]суверенных правителей}владык, ни завоевателей, которые так любят содрать с кого-нибудь кожу. Здесь безопасно, но... я привыкла искать пути к отступлению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Квиаукетцаль"
				},
				{
					"id": 762120306,
					"content": "#Я подумал{F#а}, вдруг ты тут застряла...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "Спасибо. Нет, я не застряла. На высоте безопасно, здесь меня не убьют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "Квиаукетцаль"
				}
			]
		}
	]
}