			"trigger": {
				"objectNames": [
					"Великий Сэннити"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Эй, кто из вас главарь? Выходи! Сразись со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Великий Сэннити"
				},
				{
					"id": 727350102,
					"content": "Я Великий Сэннити, великан среди великанов. Гранд-мастер Ханакадо потребовал голову главаря банды Аратаки... И я здесь, чтобы забрать её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Великий Сэннити"
				},
				{
					"id": 727350103,
					"content": "Ух ты, он выглядит свирепо... И звучит тоже! Похоже, на этот раз у нас действительно сильный противник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727350104,
					"content": "Откуда ты взялся, а?! И что это за идея - к своему имени прибавлять «великий»? Пытаешься быть круче меня, сопляк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727350105,
					"content": "Ладно, «великан среди великанов», пора уменьшить тебя в размерах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727350106,
					"content": "Т-такой высокий! А ты... ты - óни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Великий Сэннити"
				},
				{
					"id": 727350107,
					"content": "Ты выглядишь так, будто можешь съесть меня на завтрак! Почему такой парень, как ты, увлекается боями жуков? Это же детская забава... Во что я ввязался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Великий Сэннити"
				},
				{
					"id": 727350108,
					"content": "Что? «Детская забава»? Ты пожалеешь о своих словах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727350109,
					"content": "Похоже, ты ничего не знаешь о боях жуков. Я исправлю твоё заблуждение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 727350110,
					"content": "Преподай ему урок!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Да! Давай, завали его! Ты сможешь, Пастушонок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 727350113,
					"content": "Что ж... Сейчас посмотрим кто кого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Великий Сэннити"
				},
				{
					"id": 727350111,
					"content": "Проучи его!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}