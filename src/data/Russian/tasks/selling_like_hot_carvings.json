			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рази",
					"Танжер",
					"Коллеи",
					"Мамду",
					"Файез",
					"Касит",
					"Алия",
					"Рухи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "Отец-аранара осознаёт свою ошибку, и сын-аранара его прощает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "Рази"
				},
				{
					"id": 735010202,
					"content": "Да, думаю, детям понравится этот сюжет, но отец-аранара как-то слишком быстро осознаёт свою вину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "Рази"
				},
				{
					"id": 735010203,
					"content": "Может, они с сыном должны вместе столкнуться с какими-нибудь трудностями? Тогда они смогут понять друг друга, и отец-аранара, увидев старания своего сына, почувствует угрызения совести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "Танжер"
				},
				{
					"id": 735010204,
					"content": "А когда отец-аранара чувствует угрызения совести, он должен говорить медленнее или быстрее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "Рази"
				},
				{
					"id": 735010205,
					"content": "Это зависит от того, как говорит аранара-сын. Интереснее слушать, когда персонажи говорят с разной скоростью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "Танжер"
				},
				{
					"id": 735010206,
					"content": "Танжер, Рази, а вот и мы! Чем занимаетесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735010207,
					"content": "Мы с папой обсуждаем сюжет новой сказки, на этот раз я буду рассказывать её сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "Рази"
				},
				{
					"id": 735010208,
					"content": "Но мне всё-таки немного не по себе при мысли, что мой рассказ будет слушать столько людей. Поэтому я решил попросить у папы совета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "Рази"
				},
				{
					"id": 735010209,
					"content": "Ого! В Сумеру появился новый юный сказочник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735010210,
					"content": "Спасибо вам! Не появись вы, Рази точно сбежал бы от меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "Танжер"
				},
				{
					"id": 735010211,
					"content": "Как хорошо, что всё наладилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735010212,
					"content": "Вот только... Паймон вдруг вспомнила, в этой истории осталось одно подозрительное звено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735010213,
					"content": "А? Что такое? Нужна моя помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010214,
					"content": "Откуда в том дупле могли взяться записки торговца из Мондштадта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735010215,
					"content": "По-почему ты вдруг об этом вспомнила? Да это простое совпадение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010216,
					"content": "Многие люди оставляют в дуплах записки со своими секретами. Мне кажется, ничего удивительного здесь нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010217,
					"content": "Коллеи почему-то разволновалась.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "Хнык... У-у-у... Ладно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010220,
					"content": "На самом деле у меня тоже есть свои секреты и огорчения. И я тоже люблю подойти к дуплу и доверить ему свои тайны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010221,
					"content": "Но теперь я увидела, как изменились Рази и господин Танжер, и мне пришла в голову одна мысль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010222,
					"content": "#{NICKNAME}, можно попросить тебя побыть моим дуплом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010223,
					"content": "Я с радостью.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "Серьёзно, совсем ничего удивительного?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
