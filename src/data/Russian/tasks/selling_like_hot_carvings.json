	"talks": [
		{
			"id": 7350101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350101",
							"2"
						],
						"stepId": 7350101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Касит",
					"Алия",
					"Мамду",
					"Файез",
					"Рухи",
					"Коллеи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "Ну вот, у меня такой уже есть. А я хотел другого, самого пухлого и кругленького.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "Касит"
				},
				{
					"id": 735010102,
					"content": "Ладно, скоплю ещё немного моры и соберу коллекцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "Касит"
				},
				{
					"id": 735010103,
					"content": "Да ладно, ты ведь каждый день покупаешь нового? И до сих пор не собрал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 735010104,
					"content": "Купил бы сразу целый набор, там семь деревянных аранар, и ни один не повторяется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 735010105,
					"content": "Тогда сюрприза не будет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "Касит"
				},
				{
					"id": 735010106,
					"content": "А мне и не нужны сюрпризы, я просто хочу собрать всех аранар! Потому что отношусь к этому делу по-настоящему серьёзно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 735010107,
					"content": "Я наконец скопила достаточно моры, сегодня куплю целый набор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 735010108,
					"content": "Ой, извини, Касит только что купил последнего аранару, сегодня весь товар в нашей лавке распродан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "Мамду"
				},
				{
					"id": 735010128,
					"content": "Мы как раз нанимаем новых резчиков, так что приходите завтра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "Мамду"
				},
				{
					"id": 735010109,
					"content": "Ладно, тогда я приду завтра. Погодите, вы что, назвали деревянных аранар товаром?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "Алия"
				},
				{
					"id": 735010110,
					"content": "Да! Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "Касит"
				},
				{
					"id": 735010111,
					"content": "Ладно, ладно, виноват, я ошибся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "Мамду"
				},
				{
					"id": 735010112,
					"content": "Извините, все деревянные аранары на сегодня распроданы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010113,
					"content": "Распроданы? Что же делать... Я хотел купить новых аранар, подарить двоюродному братишке, завтра он придёт к нам в гости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "Рухи"
				},
				{
					"id": 735010114,
					"content": "Давай так, ты ведь живёшь по соседству с Рази, верно? Завтра с утра мы доставим новых аранар прямо к тебе домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010115,
					"content": "Спасибо, дядюшка Фаиз! Только уж вы не забудьте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "Рухи"
				},
				{
					"id": 735010116,
					"content": "Не забуду, «Ремёсла Акары» никогда ещё не обманывали ожиданий своих маленьких покупателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010117,
					"content": "А, новый покупатель. Простите, сегодня все деревянные аранары...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010118,
					"content": "А, это вы! Спасибо вам за помощь. Мы хотели сами прийти к вам, чтобы выразить свою благодарность, но, как видите, в последнее время дел невпроворот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010119,
					"content": "Без вашей помощи праздник по случаю двадцатой годовщины открытия нашей лавки прошёл бы совсем иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010120,
					"content": "Вижу, дела у вас идут неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "Дети просто обожают аранар.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "Всё благодаря Рази! Кто бы мог подумать, что такой малыш способен сочинить столько необычных историй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010123,
					"content": "О, чуть не забыл! В благодарность за вашу помощь мы хотели подарить вам на память «Опытный образец аранары».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "Файез"
				},
				{
					"id": 735010124,
					"content": "Ой, что это... Я прямо... прямо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010125,
					"content": "Потрясена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "Да, точно, потрясена. Выглядит эта штука очень загадочно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "Коллеи"
				},
				{
					"id": 735010127,
					"content": "Давайте мы как следует подумаем и решим, принимать ли такой подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735010129,
					"content": "Проблемы с игрушками решены. Теперь давай посмотрим, как поживают Танжер и Рази?",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
			"completionStepIds": [
				7350101
			],
			"beginWay": "TALK_BEGIN_NONE",
