					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Фудзивара Тосико",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "Спа... Спасибо вам, уф... Они подкрались ко мне так незаметно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620102,
					"content": "Кто ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "Меня зовут Фудзивара Тосико, я здесь... э-э-э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620105,
					"content": "Ладно, вы же меня спасли... Я всё вам расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620106,
					"content": "На самом деле, я ищу сокровище, которое оставили мои предки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620107,
					"content": "Сокровище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721620108,
					"content": "Ты его нашла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "Ха-ха-ха, ну конечно. По некоторым подсказкам я поняла, где находится сокровище и догадалась, как туда проникнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620110,
					"content": "Но как раз в тот момент, когда я собиралась активировать переключатель и войти туда, где хранятся сокровища, эти чудовища подкрались и напали на меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620111,
					"content": "Спасибо вам за то, что отогнали от меня этих монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620112,
					"content": "А теперь, извините...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620113,
					"content": "Вы не могли бы ещё немного поохранять меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620114,
					"content": "Я все ещё должна найти сокровище, но боюсь, что не справлюсь со всеми этими монстрами в одиночку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620115,
					"content": "Ну конечно! Я смогу его найти!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620116,
					"content": "И сокровище действительно существует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "Ну конечно, смогу! Доверьтесь мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620119,
					"content": "Я даже переключатель для входа в хранилище сокровищ нашла. Он вот там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620120,
					"content": "Вот только, кажется, его нельзя просто взять и включить, нужен какой-то специальный метод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620121,
					"content": "У меня, конечно, есть оставленная предками карта с подсказками про этот механизм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620122,
					"content": "Но... ха-ха-ха... я всё равно представления не имею, как его включать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620123,
					"content": "О, почему бы и вам не взглянуть? Может, вы что-нибудь разберёте на чертеже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620124,
					"content": "Уф, ну и как же активировать этот механизм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фудзивара Тосико"
				},
				{
					"id": 721620117,
					"content": "Ты и правда сможешь его найти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
