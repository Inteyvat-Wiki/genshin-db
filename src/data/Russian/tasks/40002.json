			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуэй Синь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "Здравствуйте! Спасибо вам за пожертвования на праздник морских фонарей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020202,
					"content": "Сегодня я хотел бы обсудить с вами дело, не связанное с пожертвованиями. Речь идёт о купле-продаже. Вас это интересует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020203,
					"content": "Звучит гораздо интереснее, чем работать за бесплатно. Паймон в деле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400020204,
					"content": "Славно! Спасибо за помощь. Теперь позвольте мне объяснить ситуацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020205,
					"content": "Для проведения фестиваля нам понадобятся два вида плаустрита.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020206,
					"content": "Один из них называется азурит. Его можно найти в северной части гор Тяньхэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020207,
					"content": "Если корни обычного растения оплетают азурит, то это растение может давать плоды с левитационными семенами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020208,
					"content": "Другой называется вермилионит. Для обычных людей такой камень очень опасен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020209,
					"content": "Древние руинные охотники в долине Гуйли, потерявшие способность к полёту, используют его, чтобы держаться в воздухе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020210,
					"content": "Ясно. Азурит и вермилионит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400020211,
					"content": "(На самом деле, это просто синий и красный плаустрит. Торговцы дали им красивые имена, чтобы привлечь покупателей...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020212,
					"content": "Верно! Принесите мне и тот, и другой. Удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуэй Синь"
				}
			]
		},
		{
			"id": 4000205,
			"completionStepIds": [
				4000205
