			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуэй Синь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "Хм... Это отличные образцы азурита и вермилионита!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020502,
					"content": "Спасибо вам! Вот ваша награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020503,
					"content": "Ваши старания не пройдут даром. Каждый камень украсит Праздник морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020504,
					"content": "Кстати, раз уж вы попали на праздник, обязательно посмотрите на лунный фонарь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020505,
					"content": "Строительные работы продолжаются, и причал выглядит всё более и более празднично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Хуэй Синь"
				},
				{
					"id": 400020506,
					"content": "#Как интересно! {NICKNAME}, пойдём посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4000214,
			"completionStepIds": [
				4000214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
