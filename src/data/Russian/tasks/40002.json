			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021001,
					"content": "В последний день праздника много людей будут наблюдать за запуском лунного фонаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021002,
					"content": "Не к добру этот подозрительный парень шныряет здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021003,
					"content": "Если он испортит строительные материалы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021401,
					"content": "Необходимо срочно доложить о нём в департамент по делам граждан Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021406,
					"content": "Паймон, почему это так тебя беспокоит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "Потому что... Потому что все жители Ли Юэ усердно работали! И никто не смеет испортить праздник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021408,
					"content": "...А если честно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "Потому что... рядом с причалом находится та закусочная, где готовят требуху «Чжун Юань»! Это просто любовь с первой миски и на всю жизнь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021410,
					"content": "Ты в их рекламу влюбилась больше, чем в само блюдо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "Хе-хе-хе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4000215,
			"completionStepIds": [
				4000215
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000215",
							"2"
						],
						"stepId": 4000215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзя И"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021501,
					"content": "Это местный департамент по делам граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 400021502,
					"content": "Мы хотим доложить о подозрительной деятельности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "Да, мы только что заметили странного типа, околачивающегося у склада материалов для лунного фонаря. А они, между прочим, легковоспламеняющиеся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021504,
					"content": "Мы не можем допустить, чтобы история требухи «Чжун Юань» вот так вот закончилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021505,
					"content": "Похоже, что дело действительно серьёзное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 400021506,
					"content": "Паймон тоже так считает! Ведь фирменный стиль кухни Ли Юэ - это душа и сердце всего города...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400021507,
					"content": "Кажется, что мы говорим о разных серьёзных делах. Но, разумеется, мой маленький друг, ты тоже абсолютно права.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "Цзя И"
				},
				{
					"id": 400021508,
					"content": "Я сообщу начальству о вашем беспокойстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "Цзя И"
				},
				{
