				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лайла"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860101,
					"content": "#{NICKNAME}, Паймон и Бам-бам-шапочка, мы здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860102
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400860102,
					"content": "Лайла! Ну как, весело проводишь время с Кручезверем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860103,
					"content": "Конечно! Кручезверь помог мне нести сумки. А ещё мы пошли в дальний поход, где увидели звёздное небо. Ко всему этому, он посодействовал с моим докладом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860104
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400860104,
					"content": "Продукты из списка почти готовы. А такие ингредиенты, как мука, вызывают у меня кашель. Однако я ещё не нашла любимую игрушку Кручезверя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860105
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400860105,
					"content": "Если бы улучшенная версия жемчужины мудрости помогла нам в общении с плесенниками, то это было бы здорово! Я об этом также написала в письме, попросив учёных из Амурты придумать что-либо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860106
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400860106,
					"content": "Лайла, похоже, пылает невероятным энтузиазмом! Она так много говорила, а всё ещё полна сил. Чего только не сделаешь ради своего питомца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860107,
					"content": "Ох, мои силы почти иссякли. Лучше пойдём скорее к Яэ, иначе я больше не выдержу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лайла"
				}
			]
		},
		{
			"id": 4008602,
			"completionStepIds": [
				4008602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008602",
							"2"
						],
						"stepId": 4008602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860201,
					"content": "Ого, вы так рано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860202
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860202,
					"content": "Мико, тебе правда пора в путь? Паймон кажется, что ты пробыла в Сумеру слишком мало и толком не отдохнула...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860203,
					"content": "Что ты, я отлично отдохнула. С вашей помощью я собрала всё необходимое. К тому же я не только поучаствовала в состязании, но и разоблачила заговор злодея...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860204
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860204,
					"content": "Я попрошу Соуку отказаться от своих первоначальных персонажей и сделать вас главными героями в следующем романе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860205,
						400860206
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860205,
					"content": "Кажется, ты тоже что-то замышляешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				},
				{
					"id": 400860207,
					"content": "Ах да! Теперь Паймон понимает, что ты намекала нам много раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860208,
					"content": "Тебе нужно было всего лишь разоблачить Эльхингена, так зачем же ты ходила вокруг да около?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860209,
					"content": "Было бы очень скучно сразу раскрыть всю правду. Я просто хотела посмотреть, что вы будете делать в данной ситуации. В итоге вы преподнесли мне огромный сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860210
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860210,
					"content": "Сначала я думала, что сюжет между вами и плесенниками будет разворачиваться наподобие истории между хозяином и слугой. Но вы предложили нечто лучшее: дружеские отношения, основанные на взаимопонимании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860211
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860211,
					"content": "Но с другой стороны, Эльхинген, как хозяин, передан вам, и это правильно. Разумеется, его приёмы могли доставить вам немного хлопот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860212
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860212,
					"content": "Паймон снова ничего не может понять. В следующий раз я запишу все слова Мико и тщательно изучу их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860213,
					"content": "Ладно, хватит болтать. Я передаю вам Громовёрта, хорошенько позаботьтесь о нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860214
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860214,
					"content": "Вам и Хании придётся приложить усилия. Продолжится ли такой захватывающий турнир, зависит полностью от ваших дальнейших действий. А я буду с нетерпением ждать этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400860206,
					"content": "Ты знаешь, что с Эльхингеном что-то не так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				}
			]
		},
		{
			"id": 4008603,
			"completionStepIds": [
				4008603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008603",
							"2"
						],
						"stepId": 4008603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хания",
					"Лайла"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860301,
					"content": "Вы как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860302
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860302,
					"content": "Я собрала жемчужины мудрости других участников турнира и выбрала подходящее место для проживания плесенников. Таким образом они ни в коем случае не окажут негативного влияния на окружающую среду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860303
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860303,
					"content": "Поздоровайся со всеми, Огнерадость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860304
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860304,
					"content": "Огнерадость?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860305
					]
				},
				{
					"id": 400860305,
					"content": "Это новое имя Пиро-1. При первой нашей встрече он вёл себя хорошо, а у меня было весёлое настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860306
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860306,
					"content": "Если бы я раньше отказалась от своих предубеждений, на меня не давили негативные эмоции, и я бы любила плесенников, то, возможно, у меня всегда было бы такое настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860307
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860307,
					"content": "Хания наконец полностью излечила свою душу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860308
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400860308,
					"content": "И правильно! Хотя Паймон уже привыкла к имени «Пиро-1», но и новое имя очень красивое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860309,
						400860310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860309,
					"content": "Поздравляю, Хания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				},
				{
					"id": 400860311,
					"content": "Я буду очень требовательна к себе во время ухаживания за добрыми плесенниками. Так что не беспокойтесь о своих дружочках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860312
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860312,
					"content": "Что ж, настало время прощаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860313
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400860313,
					"content": "Иди, Кручезверь. И слушайся Ханию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860314
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400860314,
					"content": "Громовёрт, Мико обязательно навестит тебя во время следующего Турнира укротителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860315,
					"content": "Бам-бам-шапочка, дай пять! Паймон было очень весело с тобой, и тебе тоже было хорошо. Паймон будет очень ждать встречи с тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400860316,
					"content": "Мы обязательно встретимся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860317
					]
				},
				{
					"id": 400860317,
					"content": "Надеюсь, тот день, когда люди и плесенники смогут жить вместе, настанет очень скоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860318
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860318,
					"content": "Мы верим вам и будем ждать хороших новостей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хания"
				},
				{
					"id": 400860310,
					"content": "А также поздравляю Огнерадость.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				}
			]
		}
	]
}