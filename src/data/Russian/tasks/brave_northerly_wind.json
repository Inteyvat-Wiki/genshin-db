			"dialogs": [
				{
					"id": 790740101,
					"content": "Ты только глянь, ещё два храбреца! Хотите бросить вызов потоку северного ветра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740102,
					"content": "Прошу, сюда. Вы наверняка будете летать лучше всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740103,
					"content": "Спокойнее!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "Полёт не терпит спокойствия. Абсолютно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740106,
					"content": "Спокойствие только притупляет ощущение ветра. Единственный способ раскрыть свой потенциал - столкнуться с порывом ветра без всякой подготовки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740107,
					"content": "Среди нынешних белок-летяг одни трусы! Совсем забыли наставление из истории о «Храбром северном ветре»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740108,
					"content": "Стоят себе в безопасном месте, восхищаются храбростью листьев, танцующих на ветру, но сами боятся и шагу ступить навстречу потоку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740109,
					"content": "Если так пойдёт и дальше, как мы сможем охранять королевство вместе с её высочеством принцессой?! Это же немыслимо! Немыслимо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740110,
					"content": "Какая энергичная белка-летяга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790740111,
					"content": "Похоже, ему действительно нравится летать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "Поэтому я нашёл несколько воздушных потоков и установил в них кое-какие механизмы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740113,
					"content": "Только самые храбрые и умелые летуны смогут пройти такой маршрут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740114,
					"content": "Хватит ли у вас смелости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740115,
					"content": "А почему бы и нет?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Отлично! Следуйте за мной. Отсюда рукой подать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740117,
					"content": "Гм... У нас есть ещё кое-какие дела...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Дела? Нужно ещё время на подготовку? Ладно, буду ждать вас здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740119,
					"content": "Захотите бросить вызов ветру, приходите ко мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кланш"
				},
				{
					"id": 790740104,
					"content": "#Я ни слова не сказал{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}