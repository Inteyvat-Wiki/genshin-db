			"trigger": {
				"objectNames": [
					"Валерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "#Ого! {M#Кошачий спаситель}{F#Кошачья спасительница} и заклинательница кошек Паймон! Не могу поверить, что вы действительно пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470102,
					"content": "А? Как ты нас назвала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705470103,
					"content": "Звучит знакомо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Мы, кажется, уже встречались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705470106,
					"content": "Ха-ха! Заклинательница кошек помнит меня! Валерина не промах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470107,
					"content": "Мы можем поболтать об этом чуть позже. Давай сначала сыграем в мою новую игру? Она меня всю неделю радует!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470108,
					"content": "Великая битва Додоко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470109,
					"content": "Ого! Как много Додоко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705470110,
					"content": "Они выглядят знакомо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "#{M#Кошачий спаситель}{F#Кошачья спасительница}... Кхе-кхе, то есть наш сияющий, великий почётный рыцарь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470113,
					"content": "Этот игрушечный Додоко создан по вашему образу и подобию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470114,
					"content": "#Она права! Ух ты, вплоть до цветов и узоров... Хах, это же твоя копия, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705470115,
					"content": "В игре Искромётному Додоко, Сияющему Додоко, Рыцарю Додоко и Ведьме Додоко предстоит объединить усилия и с помощью взрывчатки победить невиданных врагов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470116,
					"content": "Я лишь отвечаю за финансирование и функционирование игры. Я не знаю подробностей, не знаю, как выглядят реальные прототипы этих противников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470117,
					"content": "Но я верю, что, если настанет день, когда они встретятся в реальной жизни, удивительные Додоко смогут победить их всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470118,
					"content": "Конечно! Ни один монстр не сможет остановить Кли и её лучшего друга Додоко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705470119,
					"content": "Давайте попробуем!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Верю, вы отлично проведёте время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Валерина"
				},
				{
					"id": 705470120,
					"content": "Новая игра с Додоко!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Прототип очевиден.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Неизвестное прозвище...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
