					}
				]
			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, Паймон, спасибо вам. Я очень рада, что в итоге встретила вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950102,
					"content": "Хе-хе! Ты ведь попала в неприятности из-за нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950103,
					"content": "Погоди-ка, что значит «в итоге»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950104,
					"content": "Это приключение было опасным, но я увидела много удивительных вещей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950105,
					"content": "Это не так уж и плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950106,
					"content": "Цайтлинд, почему ты уходишь от ответа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950107,
					"content": "Разве?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цайтлинд"
				}
			]
		},
