					}
				]
			},
			"dialogs": [
				{
					"id": 760950501,
					"content": "Вы хорошо отдохнули? Поговорили со всеми, с кем хотели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950502,
					"content": "Ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "Не торопитесь, спокойно отдохните.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950506,
					"content": "Цайтлинд, успокойся и послушай меня. Я не хочу проявить неуважение или говорить под влиянием слепой надежды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950507,
					"content": "Твоя сестра, скорее всего, не умерла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950508,
					"content": "Но я видела надгробие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950509,
					"content": "На надгробии даже есть фотография моей сестры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950510,
					"content": "Но... разве могила не может оказаться пустой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950511,
					"content": "Паймон тоже надеется, что с сестрой Цайтлинд всё в порядке. Но твоё предположение слишком уж оптимистичное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950512,
					"content": "В последнем письме сестра написала мне, что твёрдо решила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950513,
					"content": "В её прощании наверняка не было написано, что она собирается покончить с жизнью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950514,
					"content": "Она сказала, что уезжает очень далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950515,
					"content": "Она говорила, что её мечта - объехать весь мир, пока не состарилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950516,
					"content": "Хильда говорила буквально. Она покинула санаторий и отправилась путешествовать по миру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950517,
					"content": "Она с тобой об этом говорила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950518,
					"content": "Она всегда была жизнерадостной и прекрасно ладила со всеми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950519,
					"content": "Значит, она тебе не говорила, что у нас нет других родственников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950520,
					"content": "Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950521,
					"content": "Давай отбросим эмоции и посмотрим на ситуацию трезво.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950522,
					"content": "Если бы её уход из жизни принёс горе трём или четырём людям, эта тяжесть, возможно, перевесила бы её печаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950523,
					"content": "Но у неё есть только я, и она знает, что я её понимаю. Что я прощу её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950524,
					"content": "Это не так. Не надо так думать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950525,
					"content": "Не нужно меня жалеть. В детстве, пока родители были живы, мы жили счастливо. Этих воспоминаний было достаточно, чтобы двигаться дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950526,
					"content": "Но взрослая жизнь полна трудностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950527,
					"content": "С детства я была более замкнутой, общение с людьми изматывало меня. Я думала, что моей общительной сестре легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950528,
					"content": "Когда сестра выросла, она всегда выглядела измождённой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950529,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950530,
					"content": "У вас ещё есть будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950531,
					"content": "О, похоже, она не рассказала о своём женихе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950532,
					"content": "Он был хорошим человеком. Обычным, добрым, интересным. Иногда я жалею, что он был таким. Если бы он был плохим, всё было бы проще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950533,
					"content": "В его семье было наследственное заболевание. Какая-то странная болезнь, которая не позволяла жить долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950534,
					"content": "Иногда он шутил, что Анемо Архонт слишком хорошо продумал Мондштадт, поэтому даже такая семья, как его, всё никак не исчезнет с лица земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950535,
					"content": "Потом он сказал, что должен спасти мир, и ушёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950536,
					"content": "Спасать мир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950537,
					"content": "Наш мир всё ещё существует, так что, возможно, он действительно спас его в каком-нибудь неприметном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950538,
					"content": "Ты же сам говорил, что если бы человек, живущий вечно, не полюбил всех и не стал любим всеми, мир погрузился бы в печаль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950539,
					"content": "Я думаю, ты прав. Короткая жизнь не заслуживает любви.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950540,
					"content": "Он хотел пожертвовать своей жизнью ради любви, но в итоге лишь причинил сестре ещё больше боли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950541,
					"content": "Он отправил её в санаторий в горах. В этот самый санаторий, окутанный проклятьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950542,
					"content": "Она никогда не рассказывала мне об этом. Прости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950543,
					"content": "После всего услышанного всё ещё будете настаивать на том, что сестра жива?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950544,
					"content": "Да. Потому что она кое-что здесь сделала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950545,
					"content": "Из-за моей трусости ей пришлось жить дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950546,
					"content": "Я глубоко уважаю вас, Историй. Но мне кажется, что за долгие годы вы видели слишком много страданий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950547,
					"content": "Страданий, достаточно сильных, чтобы потопить весь мир... Для обычного человека, такого как я, даже незначительной доли этого достаточно, чтобы похоронить целую жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950548,
					"content": "Вы не можете понять меня и сестру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950549,
					"content": "Скажите, как мне вернуться назад? Я обычный человек, которому суждено прожить короткую жизнь. Вечность не для меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950550,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950551,
					"content": "Господин Историй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950552,
					"content": "Это место когда-то было полностью отрезано от внешнего мира, поэтому покинуть его было невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950553,
					"content": "Но после падения Нихилиты Декс, кажется, обрёл способность переносить людей современности между Залом столпов и землёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950554,
					"content": "Но он не может забрать тех, кто был избран и поднят сюда, потому что он дитя созерцателя. Это правило глубоко заложено в его сущности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950555,
					"content": "Что? Декс сродни Нихилите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950556,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950557,
					"content": "Если вы хотите вернуться, вам придётся отказаться от всех своих воспоминаний и знаний и подняться на самую вершину. Раньше это требовалось для аудиенции у госпожи, а теперь - для аудиенции у Меланты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950558,
					"content": "Я не смогу пойти с вами. Позвольте мне хотя бы проводить вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950504,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Историй"
				}
			]
		},
