					},
					{
						"sceneId": 103,
						"position": [
							156.335,
							170.333,
							410.095
						],
						"pointId": 108
					},
					{
						"sceneId": 103,
						"position": [
							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Историй, мы освободили все три области. И почти всех спасли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950302,
					"content": "И даже нашли все вещи Цайтлинд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950303,
					"content": "О-о, большое вам спасибо. Нихилита стал очень внимательным, с тех пор как открыл глаза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950304,
					"content": "Хорошо, теперь твоя очередь! Ты говорил, что есть способ подняться и что за это нужно заплатить определённую цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950305,
					"content": "Выкладывай! Паймон не боится ни приключений, ни расходов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950306,
					"content": "И ещё, как нам отправить Цайтлинд обратно? Ей здесь делать нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950307,
					"content": "Я всё объясню, но вам сначала нужно отдохнуть. Завтра я всё подробно расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950308,
					"content": "Ну хорошо! Но тут же нет ни кроватей, ни еды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950309,
					"content": "Подобные желания здесь угасают. Задумайтесь. Вы до сих пор не испытывали ни голода, ни усталости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950310,
					"content": "Что? Тогда чем Паймон будет заниматься весь день, пока мы отдыхаем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950311,
					"content": "Здесь много удивительных людей из разных эпох. Пообщаться с ними может быть очень интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950312,
					"content": "#Ладно. Но даже если Паймон не устала, она всё равно будет спать на голове у {F#путешественницы}{M#путешественника}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760950313,
					"content": "Цайтлинд, когда отдохнёшь, я хотел бы с тобой поговорить. О том, о чём я говорил раньше. О том, над чем нужно подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950314,
					"content": "Поговорим позже, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Историй"
				},
				{
					"id": 760950315,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Цайтлинд"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME} и Паймон, приходите, когда отдохнёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Историй"
				}
			]
		},
