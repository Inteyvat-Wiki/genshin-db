			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "#Уф... Спасибо, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850102,
					"content": "Главное, что всё хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "Меня зовут Элбер. Я торговец. Изначально я хотел здесь отдохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850105,
					"content": "Но откуда я мог знать, что на меня нападут хиличурлы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850106,
					"content": "У тебя нет сопровождения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "Да, мы слышали в городе, что все иностранные торговцы обычно нанимают кого-нибудь из Пустынников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850109,
					"content": "Эх, а я... просто пожадничал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850110,
					"content": "Ну и цены заламывают эти Пустынники! Один просит больше другого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850111,
					"content": "Я всего лишь мелкий торговец, у меня нет таких денег...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850112,
					"content": "И я подумал: я тоже кое-что умею, путь предстоит не слишком далёкий, как-нибудь обойдусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850113,
					"content": "Но я и представить не мог, что нападение хиличурлов испугает моих вьючных яков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850114,
					"content": "Не успел я ничего предпринять, как меня сбил на землю один вьючный як. Только я поднялся - меня тут же лягнул второй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850115,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850116,
					"content": "А затем они оба удрали, а на меня набросились хиличурлы. К счастью, вы подоспели на помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850117,
					"content": "#Но всё моё имущество - на спинах тех вьючных яков... Путешественни{F#ца}{M#к}, могу я попросить тебя вернуть их мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850118,
					"content": "Я... я не хочу, чтобы и меня залягали...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "Нет-нет, даже не переживай об этом. Обычно они очень смирные, но эти хиличурлы опрокинули их еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850121,
					"content": "Они очень много прошли с товарами на спинах и сильно проголодались, поэтому, когда опрокинули их еду, они просто взбесились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850122,
					"content": "Вот как... Поесть не дали, еду перевернули...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850123,
					"content": "Ох! Паймон закипает, стоит ей только подумать об этом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850124,
					"content": "Паймон быстро улавливает суть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "Вот и хорошо... Вот, возьми эту еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850126,
					"content": "Когда найдёшь вьючных яков, подкорми их этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850127,
					"content": "Пока есть еда, вспышек ярости можно не бояться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850128,
					"content": "Я видел, как один из них раскидал хиличурлов и, не обращая ни на что внимания, убежал далеко-далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850129,
					"content": "А другого схватили и увели хиличурлы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850130,
					"content": "#Я отмечу примерные направления, в которых исчезли вьючные яки... Рассчитываю на тебя, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850131,
					"content": "Как только я верну товары, я обязательно расплачусь с тобой по совести!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850119,
					"content": "Мне... мне не хотелось бы, чтобы меня толкали...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "Разве тебя никто не охраняет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "Пустяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
		{
			"id": 7318502,
