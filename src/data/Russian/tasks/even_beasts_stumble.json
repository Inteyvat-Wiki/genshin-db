			"trigger": {
				"objectNames": [
					"Успокоить яка"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1115.35,
							179.749,
							3576.298
						],
						"pointId": 330300143
					}
				]
			},
			"dialogs": [
				{
					"id": 731850501,
					"content": "Кажется, у этого вьючного яка так себе настроение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850502,
					"content": "Ого! Посмотри на его копыта. Они такие огромные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850503,
					"content": "Если он пнёт, то и сознание потерять недолго...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850504,
					"content": "Паймон, давай ты отдашь ему угощение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "#{F#Сама}{M#Сам} иди! Скорее! Скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850506,
					"content": "Приятного аппетита...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "#Я вовсе не {F#хотела}{M#хотел} оскорбить ваши копыта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "Вьючный як медленно проглатывает угощение, он как будто становится спокойнее...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "Кажется, он уже не так сильно сердится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850509,
					"content": "Давай поскорее вернём его. Осторожно! Не дай себя лягнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731850511,
					"content": "Вы вернулись к Элберу вместе с вьючным яком...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "Отлично! Я думал, что больше не увижу этого вьючного яка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "Элбер"
				},
				{
					"id": 731850513,
					"content": "#Спасибо, путешественни{F#ца}{M#к}. Огромное спасибо тебе!",
