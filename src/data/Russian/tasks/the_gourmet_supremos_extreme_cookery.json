			"dialogs": [
				{
					"id": 220300301,
					"content": "Я позабочусь о лагере справа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300302
					]
				},
				{
					"id": 220300302,
					"content": "Да будет так, оставляю его вам. Сам я пойду в другой лагерь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300303,
					"content": "Ты справишься в одиночку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "Они просто монстры. Не стоит беспокоиться обо мне. Если бы не срочность вопроса сохранности ингредиентов, я бы смог одолеть их всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300305,
					"content": "Хорошо, как только уничтожите монстров и достанете ингредиенты, сможете найти меня в другом лагере.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300306,
					"content": "Давайте приступим к работе. Если ингредиенты будут испорчены, боюсь, что блюдо не получится таким вкусным, как я обещал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				}
			]
		},
