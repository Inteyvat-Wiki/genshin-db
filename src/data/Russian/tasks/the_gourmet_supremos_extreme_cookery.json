			"dialogs": [
				{
					"id": 220300201,
					"content": "Это здесь. Две группы монстров разбили лагерь по обе стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300202,
					"content": "Я уже пробрался туда на разведку. Хотя монстры в левом лагере кажутся слабее, их там очень много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300203,
					"content": "В правом лагере монстров меньше, но они намного сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300204,
					"content": "Пожалуйста, уничтожьте монстров в одном из лагерей, а другой предоставьте мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				}
			]
		},
