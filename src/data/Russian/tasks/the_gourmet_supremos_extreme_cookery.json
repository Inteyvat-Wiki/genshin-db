			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камэи Мунэхиса"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "Мы снова встретились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300102,
					"content": "Простите мне мою дерзость, но сегодня мне нужна ваша помощь с одним делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300103,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "После того, как меня нанял Сюй Дун, я путешествую с ним и его командой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300107,
					"content": "Я хочу сделать несколько подарков в знак благодарности за то, что он меня приютил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300108,
					"content": "Но поскольку Сюй Дун, похоже, предпочитает кулинарию боевым искусствам, я хотел бы самостоятельно приготовить немного еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300109,
					"content": "Я уже нашел два места для хранения необходимых ингредиентов и планировал забрать их, как только они окончательно созреют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300110,
					"content": "Однако эти два места занимают две группы монстров, и они уже забрали все ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300111,
					"content": "Для приготовления моего блюда мне первостепенна свежесть ингредиентов. Я планировал сначала собрать их в одном месте, а затем отправиться в другое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300112,
					"content": "Но теперь, когда обе группы монстров уже забрали ингредиенты, я должен получить эти два ингредиента обратно как можно скорее, если хочу приготовить это блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300113,
					"content": "Однако... Я не могу быть в двух местах одновременно. Даже если я справлюсь с монстрами в одном месте, ингредиенты уже будут испорчены монстрами во втором.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300114,
					"content": "Поэтому мне нужна ваша помощь. Мы победим этих монстров одновременно и достанем оба ингредиента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300115,
					"content": "Хорошо, положись на меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "Премного благодарен. Никаких слов не хватит, чтобы воздать должное оказанной вами помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300119,
					"content": "Хм... но разговор об этом здесь не принесёт нам много пользы. Пожалуйста, пройдёмте со мной, и мы всё хорошенько обсудим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300117,
					"content": "После того, как ты закончишь своё блюдо, можно мне немного?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "#Конечно. Только так и должно быть, Вы будете перв{F#ой}{M#ым}, кому оно достанется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Камэи Мунэхиса"
				},
				{
					"id": 220300104,
					"content": "Не нужно таких формальностей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "Поскольку мне кое-что от вас нужно, подобный этикет необходим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "Камэи Мунэхиса"
				}
			]
		},
		{
