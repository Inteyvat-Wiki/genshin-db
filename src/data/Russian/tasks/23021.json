			"trigger": {
				"objectNames": [
					"Рафик",
					"Ци Шань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "#Путешественни{F#ца}{M#к}, ты как раз вовремя! Я только что спустил судно на воду. Оно очень устойчиво.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210102,
					"content": "Мои расчёты были безошибочны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210103,
					"content": "Итак, а когда начнутся испытания с нагрузкой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210104,
					"content": "#Не спеши. Вот и путешественни{F#ца}{M#к} при{F#шла}{M#шёл}. Сейчас начнём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210105,
					"content": "Что значит испытания с нагрузкой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "Проще говоря, мы будем нагружать лодку тяжёлыми грузами для проверки её грузоподъёмности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210107,
					"content": "Хм... Мне нужно, чтобы кто-то помог мне перенести грузы на борт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210108,
					"content": "#Путешественни{F#ца}{M#к}, ты так{F#ая}{M#ой} сильн{F#ая}{M#ый} и ловк{F#ая}{M#ий}, так хорошо справил{F#ась}{M#ся} в тот раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210109,
					"content": "Так вот зачем ты меня позвал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "Ну что ты! Мне и правда одному не справиться, только ты сможешь мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210112,
					"content": "И вознаграждением тебя не обижу! Я пару дней назад как раз отремонтировал один большой корабль, неплохо заработал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210113,
					"content": "Неплохо заработал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210114,
					"content": "А? Но я это, все деньги вложил в этот корабль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210115,
					"content": "Все?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210116,
					"content": "Кое-что осталось! Ох, я угощу тебя кофе, не переживай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210117,
					"content": "#Путешественни{F#ца}{M#к}, пора за дело! Скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210110,
					"content": "Так не пойдёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
