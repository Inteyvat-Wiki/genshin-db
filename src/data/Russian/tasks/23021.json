			"dialogs": [
				{
					"id": 230210801,
					"content": "Отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210802,
					"content": "В конструкции корабля нет никаких проблем. Ватерлиния тоже в порядке, без уклонений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210803,
					"content": "Ци Шань, гляди, мои расчёты безукоризненны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210804,
					"content": "Не радуйся раньше времени. Это только первый этап испытаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210805,
					"content": "А ещё ты не учёл погоду и изменение центра тяжести судна из-за смещения груза во время плавания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210806,
					"content": "Ага, я учту. Дай мне пока порадоваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210807,
					"content": "#Кстати, путешественни{F#ца}{M#к}, вот твоё вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210808,
					"content": "Ци Шань, ну ты можешь хоть раз за меня порадоваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210809,
					"content": "И какая от этого будет польза кораблестроительству?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210810,
					"content": "Лучше подумай, как порадовать свой кошелёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ци Шань"
				}
			]
		},
