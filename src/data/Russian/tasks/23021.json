					"Ци Шань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "Отличненько! Так сойдёт, посмотрим, что получится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210601,
					"content": "Ох! Корабль протекает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230210615,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210602,
					"content": "Он весь покосился! Как так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 230210603,
					"content": "Скорее забирай груз, точно что-то случилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210604,
					"content": "Вы вместе с Рафиком в спешке сняли тяжёлый груз с корабля...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "Фух! Ну хоть вещей было не так много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210606,
					"content": "Что? В чём проблема?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210607,
					"content": "А я что говорила! Твои расчёты и в теории были слишком рискованными, нельзя было на них полагаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210608,
					"content": "А... Ну я... Ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210609,
					"content": "Так не должно быть, я всё точно рассчитал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210610,
					"content": "#Путешественни{F#ца}{M#к}, спасибо за твою помощь. Вот, возьми в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210611,
					"content": "Мне нужно всё заново пересчитать. Ци Шань, поможешь мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "Рафик"
				},
				{
					"id": 230210612,
					"content": "Так говоришь, будто я не помогала тебе раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "Ци Шань"
				},
				{
					"id": 230210613,
					"content": "Ладно, рассчитаю. Потом не забудь про обещанный кофе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ци Шань"
				}
			]
		},
