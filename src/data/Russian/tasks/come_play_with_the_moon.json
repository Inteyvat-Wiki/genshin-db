			"dialogs": [
				{
					"id": 761220101,
					"content": "Коломбина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220102,
					"content": "А? Странно. Паймон готова поклясться, что слышала голос Коломбины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220103,
					"content": "...Ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220104,
					"content": "Ой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220105,
					"content": "Приветствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220106,
					"content": "Ой-ой-ой, зачем так пугать Паймон? Почему сразу нельзя сказать, что ты здесь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220107,
					"content": "Я подумала, что, раз вы хорошо знакомы с этой игрой, нужно увеличить уровень сложности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220108,
					"content": "Вот же! В следующий раз Паймон тебя хорошенько напугает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220109,
					"content": "Хорошо, буду ждать с нетерпением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220110,
					"content": "Коломбина, где твоя повязка на глаза?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "О, похоже, куухенки сняли её, когда мы играли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220112,
					"content": "Я обычно и так не открываю глаза, так что разницы нет. Если им нравится, пусть играют с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220113,
					"content": "Кстати, Коломбина, разве ты не хочешь почаще выходить на прогулку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220114,
					"content": "Тебе больше не нужно ни от кого прятаться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Хм... Времени у меня предостаточно. Могу пойти когда хочу и куда хочу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220116,
					"content": "Но я беспокоилась, что вы будете волноваться, если придёте меня искать, а я ушла, не сказав ни слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220117,
					"content": "В такой ситуации...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Да-да, нам просто важно знать, что с тобой всё в порядке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220120,
					"content": "Хорошо, я об этом подумаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220121,
					"content": "Подумаешь?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220122,
					"content": "Может быть, это место тебе нравится больше всего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Всё, что здесь произошло... для меня приятные воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220124,
					"content": "Однако у меня есть и другая причина ждать вас здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220125,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220126,
					"content": "Я хочу сделать вам сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220118,
					"content": "...достаточно оставить записку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
