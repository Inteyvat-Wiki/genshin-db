			"dialogs": [
				{
					"id": 761220201,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761220202,
					"content": "Луоннотар! Это же ты! Ты вернулась и стала ещё более сияющей, чем раньше! Паймон думала, что больше никогда тебя не увидит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220203,
					"content": "Та картина...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "Мы очертили её форму лунным светом, после чего я наполнила её новой силой и новыми благословениями, чтобы дать ей новую жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220205,
					"content": "Ей больше не нужно нести мою душу. Её судьба принадлежит ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220206,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761220207,
					"content": "А-а, она летит сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220208,
					"content": "Да, я пробудила все воспоминания о времени, которое вы провели вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220210,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761220211,
					"content": "Ах, Паймон так рада, что ты вернулась, луоннотар. Паймон обещает, что с этого момента будет добрее к тебе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220212,
					"content": "Паймон не ожидала такого сюрприза... Паймон в полном восторге!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761220213,
					"content": "Спасибо тебе, Коломбина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "Не за что. Я тоже рада снова увидеть луоннотар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220216,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761220217,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220218,
					"content": "(Она всё так же любит луоннотар, но её выражение лица отличается от прежнего.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "(Похоже, луоннотар для неё не просто созданный фамильяр, а близкая подруга.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "Иди, ты наверняка скучаешь по ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761220221,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "Луоннотар"
				},
				{
					"id": 761220222,
					"content": "Приходите к нам снова в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
