			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Часка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756610101,
					"content": "У меня возникла мысль, что нужно прийти и посмотреть... Приветствую, «Тума{RUBY#[S]Надежда}йни».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610102
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610102,
					"content": "#Дай угадаю. Ты {F#пришла}{M#пришёл} на испытание воинов клана Цветочного Пера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610103,
						756610106
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610103,
					"content": "Именно так. Моя задача - проверить сложность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610104
					]
				},
				{
					"id": 756610104,
					"content": "#Ты не будешь разочарован{F#а}. Я предъявляю самые высокие требования к наездникам кукузавров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610105
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610105,
					"content": "Обучение - не самая сильная моя сторона, поэтому, когда мне предложили разработать экзаменационные этапы, я выбрала метод «вспомнить все сложные задачи и добавлять их одну за другой».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610109,
					"content": "В результате... девяносто девять процентов воинов нашего племени потерпели неудачу - причём на первом же этапе. В итоге я последовала совету Ирады и уменьшила сложность на порядок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610110
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610110,
					"content": "Но я сомневаюсь, что испытания, даже в первоначальном виде, смогут тебя по-настоящему увлечь. Если это наша цель... Придётся использовать ситуации, в которых даже я окажусь беспомощной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610111,
						756610112
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610111,
					"content": "Спасибо за добрые слова, но я не нуждаюсь в особом отношении!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610113,
					"content": "#Я и не пыталась, но считаю, что ты {F#достойна}{M#достоин} уважения. Я не наставница, но я верю в свою способность оценивать силу тех, кого встречаю на своём пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610114
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610114,
					"content": "Учитывая твои способности... тебе подойдут только самые сложные испытания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610115,
						756610116
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610115,
					"content": "Нужно подумать, насколько эти этапы подходят для обычных воинов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610117,
					"content": "...Справедливо. У тебя есть задание, которое нужно выполнить, а у нас будет больше возможностей в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610118
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610118,
					"content": "Однажды я устрою в твою честь пир, который превзойдёт битвы лучших наездников кукузавров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610116,
					"content": "Оценить универсальность уровня тоже очень важно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610112,
					"content": "Ха-ха, не стоит меня недооценивать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610106,
					"content": "#Может быть, я ради тебя {M#пришёл}{F#пришла}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610107
					]
				},
				{
					"id": 756610107,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610108
					],
					"speakerTitle": "Часка"
				},
				{
					"id": 756610108,
					"content": "Значит, ты хочешь превзойти меня? Я только «за». Я напичкала площадку самыми тяжёлыми испытаниями, с которыми я сталкивалась в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Часка"
				}
			]
		}
	]
}