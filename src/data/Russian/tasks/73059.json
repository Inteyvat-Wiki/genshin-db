				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "«Гранатники поют под яблонь овации...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590102,
					"content": "Здравствуй, почтенный Хайям! Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730590103,
					"content": "О, здравствуй, здравствуй, белая кроха... И... Ох, прошу прощения, милое дитя, память у старика никуда не годится, имена быстро вылетают из головы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590104,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "Ха-ха, хорошо... Мы ведь с вами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590106,
					"content": "Да! Мы - те самые джавансы, отважные молодые герои!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730590107,
					"content": "Да... Тогда скажите, помнят ли меня аранары? Помнят ли они всех нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590108,
					"content": "Гм... Как бы сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730590109,
					"content": "Они тебя помнят.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730590111,
					"content": "Вот как... Но я их больше не вижу, не слышу, как они меня вспоминают... Какая жалость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590114,
					"content": "Ха-ха... Я их больше не вижу. Я слишком стар, я не вижу аранар, не слышу их голосов... Поздно, слишком поздно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590115,
					"content": "Кхе-кхе... Простите, я пойду. Остаётся надеяться только на чудо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590116,
					"content": "Чудо невозможно постичь, за ним невозможно угнаться, на него можно только надеяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Хайям"
				},
				{
					"id": 730590117,
					"content": "Хайям, пошатываясь, уходит...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "Они тебя не помнят.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "Но... Мы можем снова с ними подружиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
