			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аранакин",
					"Арагару",
					"Аранага",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "Аранага, а вот и они, вот и они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730590202,
					"content": "Да! Ура, они пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730590203,
					"content": "#Нара {NICKNAME}, белая леталка. Приветствуем мы втроём вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730590204,
					"content": "А вот и луна. Настало время посадить цветы. Вы готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730590205,
					"content": "#Я готов{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "И Паймон тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730590207,
					"content": "Тогда... Аранакин, Арагару, приступим к ритуалу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730590208,
					"content": "«Домой, домой, сновидения сада, воспоминания леса...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730590209,
					"content": "«Встречайте их, да будет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730590210,
					"content": "...Крепким сон, а радость бесконечной».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730590211,
					"content": "«Ликуйте же! И пусть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730590212,
					"content": "...Гранатники поют под яблонь овации!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730590213,
					"content": "Аранары посадили засохшие цветы в землю, и пока ветер носил эхо их песни, случилось чудо: к цветам вернулась жизнь...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "Ого... Все три цветка снова ожили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730590215,
					"content": "Да, потому что... У Мотийимы достаточно милосердия. Даёт памяти - возродиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730590216,
					"content": "Да! И даже если мы вас забудем, память всё равно... Всё равно вплетётся в корни и ветви, превратится в зелёные листья, в годовые кольца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730590217,
					"content": "Или в толстеньких жучков и червячков, которых съедят другие жучки и оставят взамен то, что питает растения и помогает нам расти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "Арагару"
				},
				{
					"id": 730590218,
					"content": "Но... Вы всё равно нас не помните, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730590219,
					"content": "Да... Потому что память... Не твоя и не моя. Мы разделили прошлое со всеми травами и деревьями в лесу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "Аранага"
				},
				{
					"id": 730590220,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "Это не беда, мы ведь снова подружились, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "Аранакин"
				},
				{
					"id": 730590222,
					"content": "Да! Вы наши новые друзья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арагару"
				}
			]
		},
