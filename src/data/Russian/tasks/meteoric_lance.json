					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740740202,
					"content": "(Осмотреть лежащего человека...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740740203
					]
				},
				{
					"id": 740740203,
					"content": "Неужели, неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740740204,
