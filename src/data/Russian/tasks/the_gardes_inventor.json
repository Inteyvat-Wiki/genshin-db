			"trigger": {
				"objectNames": [
					"Фрежюс",
					"Шене"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "Здравствуйте, друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 745110102,
					"content": "Вы... жандармы? Вам что-то от нас нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745110103,
					"content": "Хе-хе, а вы как думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110104,
					"content": "Неужели из-за полётов на планере и лазания по городским стенам...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "Ого, вы и такое вытворяли? Помедленнее, я записываю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110107,
					"content": "Нас обвели вокруг пальца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745110108,
					"content": "Шучу. Позвольте представиться, меня зовут Шене, а это мой старший коллега, Фрежюс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110109,
					"content": "Он ищет людей для испытания своего нового изобретения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110110,
					"content": "Изобретения? Какого изобретения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745110111,
					"content": "Турель на дистанционном управлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 745110112,
					"content": "Смотрите, раньше турелям нужен был оператор на месте, так? Противнику достаточно попасть по турели, и всё, нам конец. Но если бы мы могли управлять турелью дистанционно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110113,
					"content": "Это бы помогло минимизировать потери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 745110114,
					"content": "Вот! Как и ожидалось от Фрежюса, что трижды отклонял приглашение от Исследовательского института. Он без труда изобрёл такую удивительную вещь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110115,
					"content": "Трижды отклонял приглашение от Исследовательского института?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 745110117,
					"content": "Верно, верно! Знаете ли, талант Фрежюса так заинтересовал Исследовательский институт, что они трижды предлагали ему место высококлассного исследователя за кругленькую сумму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110118,
					"content": "Но он остался здесь, потому что любит работу жандарма. Очень мило!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110119,
					"content": "Но даже так он не может позволить своему таланту пропадать впустую, поэтому время от времени создаёт что-то новенькое. Старается ради нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110120,
					"content": "Потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745110121,
					"content": "Кхм, хватит об этом. Шене, помнишь, чему я тебя учил? Чем умнее человек, тем он скромнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 745110122,
					"content": "Конечно, Фрежюс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110123,
					"content": "В общем, мы бы хотели предложить вам опробовать турель на дистанционном управлении. Место и мишени мы уже подготовили. На вознаграждение тоже не поскупимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 745110124,
					"content": "Хе-хе, это вы по адресу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745110125,
					"content": "#{NICKNAME} и Паймон повидали немало интересного. Мы легко поможем вам оценить практичность изобретения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 745110126,
					"content": "Удачи вам. И удачи тебе, Фрежюс!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "Шене"
				},
				{
					"id": 745110127,
					"content": "Эм... В общем, нам сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фрежюс"
				},
				{
					"id": 745110105,
					"content": "Неужели из-за фехтования в черте города...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}