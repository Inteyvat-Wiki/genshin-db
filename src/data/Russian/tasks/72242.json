			"dialogs": [
				{
					"id": 722420401,
					"content": "Вот это да! Паймон и не думала, что под островом Ватацуми может быть такое огромное место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722420402,
					"content": "Похоже, нам надо в центр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722420403,
					"content": "#Что ж, {NICKNAME}, давай пойдём потихоньку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722420404,
					"content": "Начнём с тех руин, они как раз недалеко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722420405,
					"content": "Раз тут есть здания - значит, были люди... А где люди, там и письменность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722420406,
					"content": "А где есть всякие там значочки и бумажки... там мы сможем найти подсказки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
