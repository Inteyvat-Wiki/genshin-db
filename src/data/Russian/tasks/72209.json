				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Ещё один спокойный день...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090102,
					"content": "Мяу, вы уже здесь? Мне вчера так хорошо спалось после вашей уборки, мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090103,
					"content": "Те два человека в зелёном вчера снова гуляли возле святилища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090104,
					"content": "Но кроме них, в святилище больше никто не приходил. Как странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090105,
					"content": "Но когда зашли те два зеленых человечка, их, похоже, очень заинтересовала вон та деревянная стойка, мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090106,
					"content": "Я помню, Хибики говорила, что эти деревянные штучки называются «молитвенные дощечки» и на них раньше рисовали лошадей. А это «стойка для молитвенных дощечек». Многие приходили в святилище из-за неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090107,
					"content": "Хм... Получается, людям нравится дерево? Ведь люди приходили в святилище, чтобы положить мору в ящик и повесить кусочки дерева на деревянную стойку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090108,
					"content": "Вряд ли это из-за любви к дереву.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "А почему тогда? Из-за любви к лошадям?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090110,
					"content": "Причём здесь лошади?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Как бы там ни было, стойка всё равно сломана, а деревянных кусочков осталось мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090113,
					"content": "Не знаю, что там у людей с деревом и лошадьми, но в святилище нужна эта штука.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090114,
					"content": "Из-за того, что стойка сломана, не осталось дерева. Вот никто и не приходит в святилище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090115,
					"content": "Так что прошу тебя, почини стойку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090116,
					"content": "Мы с этим справимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Кстати, материалы с прошлого раза, когда мы чинили ящик для подношений, ещё остались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722090118,
					"content": "В таких вопросах никогда нельзя быть уверенной... И почему людям так нравится дерево?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090119,
					"content": "Знаешь что, не бери в голову... Паймон вспомнила, что у нас есть запасы. Нам только нужно осмотреться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722090120,
					"content": "Как бы там ни было, стойку я поручаю вам. А у меня и без того есть чем заняться. Святилище само о себе не позаботится, мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090129,
					"content": "После починки ящика и стойки количество прихожан должно увеличиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090121,
					"content": "Как давно не чинили эту стойку для молитвенных дощечек?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Давным-давно. Она сломалась ещё до ящика. А ящик тоже сломался давным-давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090123,
					"content": "То есть ты даже примерно не знаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722090124,
					"content": "Я не считаю, сколько раз всходит и заходит солнце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090125,
					"content": "В любом случае у нас должно было что-то остаться с того раза, когда мы чинили ящик для подношений, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722090126,
					"content": "В таких вопросах никогда нельзя быть уверенной... И почему людям так нравится дерево?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090127,
					"content": "Знаешь что, не бери в голову... Паймон вспомнила, что у нас есть запасы. Нам только нужно осмотреться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722090128,
					"content": "Как бы там ни было, стойку я поручаю вам. А у меня и без того есть чем заняться. Святилище само о себе не позаботится, мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090111,
					"content": "К лошадям это тоже не имеет отношения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
		{
