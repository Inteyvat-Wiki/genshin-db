			},
			"dialogs": [
				{
					"id": 722090201,
					"content": "Похоже, эта стойка для молитвенных дощечек сломалась давным-давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090202,
					"content": "Чем занимаешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "#О, здравствуй, путешественни{F#ца}{M#к}. Мы с Эйко сейчас исследуем местность вокруг этого святилища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090204,
					"content": "Хотя многое в святилище находится в запущенном состоянии, но здесь есть всё необходимое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090205,
					"content": "Должно быть, жившие неподалёку люди приходили сюда. Думаю, святилище пришло в упадок, когда люди покинули деревню Косэки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тайсукэ"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220904",
							"2"
						],
						"stepId": 7220904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "Мяу-мяу. Деревянная стойка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090302,
					"content": "Теперь в полном порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Ого! Неплохо, теперь святилище выглядит куда солиднее, мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090304,
					"content": "А теперь скажи этим двум зелёным человечкам, что стойку починили. И теперь они могут вешать на неё деревянные дощечки. А потом пусть приведут ещё несколько человек, чтобы те пришли набить ящик морой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090305,
					"content": "Почему бы тебе самой не сходить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "Ну нет! Этот зеленый, высокий человек очень страшный. Он может читать мысли кошек... Он видит меня насквозь, мяу-мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722090307,
					"content": "Не говоря уже о том, что он слишком волнуется каждый раз, когда разговаривает со мной. Мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220905",
