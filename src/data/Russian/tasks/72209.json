						"stepId": 7220905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тайсукэ",
					"Эйко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "#Привет, путешественни{F#ца}{M#к}? Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090402,
					"content": "Стойка для молитвенных дощечек теперь цела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "О, твоя работа? У тебя доброе сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090404,
					"content": "Это было поручением госпожи временной настоятельницы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "Нэко сама дала тебе поручение?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090406,
					"content": "Неужели госпожа Нэко приняла во внимание наши действия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090407,
					"content": "Ну не совсем так.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "Эйко! Давай посмотрим на стойку для молитвенных дощечек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090410,
					"content": "Сначала ящик для подношений, потом стойка для молитвенных табличек...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090411,
					"content": "Эта временная настоятельница действительно всерьёз взялась за восстановление святилища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090412,
					"content": "Но все жители этих мест давно уехали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090413,
					"content": "Проще говоря, никто на этом острове не придет в это святилище, кроме нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090414,
					"content": "Что ты хочешь сказать, Эйко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090415,
					"content": "Понимает ли это временная настоятельница? Зачем она восстанавливает святилище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090416,
					"content": "Неважно, может, я просто слишком подозрительна. Мы можем подойти к стойке для молитвенных дощечек, без проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090417,
					"content": "Но осторожность не помешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090418,
					"content": "Эйко, госпожа Нэко всего лишь кошка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090408,
					"content": "Можно и так сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
		{
