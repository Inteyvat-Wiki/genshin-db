				"points": []
			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "Стойка выглядит отлично, хорошая работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090502,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Но вот молитвенные дощечки... На них ничего не разглядеть. Как давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090505,
					"content": "Эйко! Взгляни, я нашел немного дерева и сделал несколько дощечек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090506,
					"content": "Раз уж стойка в порядке, на неё нужно повесить молитвенные дощечки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090507,
					"content": "У тебя есть какие-нибудь желания, Эйко? Я могу разрисовать дощечку для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 722090508,
					"content": "Повесить свою молитвенную дощечку в этом святилище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090509,
					"content": "Ха-ха, а что, забавная мысль! Передай мне одну из этих дощечек, а с рисунком я разберусь сама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 722090510,
					"content": "Похоже, они собираются повесить молитвенные дощечки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722090511,
					"content": "Расскажем об этом Нэко, она наверняка обрадуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722090503,
					"content": "Это было нетрудно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
