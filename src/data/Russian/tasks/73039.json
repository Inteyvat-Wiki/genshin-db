			},
			"dialogs": [
				{
					"id": 730390101,
					"content": "Братья осознали свои ошибки. Праздник Утсава - счастливый день, поэтому Арапакати не будет злиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730390102,
					"content": "Да, Арапакати, ты больше не злись. Радостный день нужно отмечать со «вкусом радости»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730390103,
					"content": "Пришло время продемонстрировать результаты нашей кулинарной практики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730390104,
					"content": "Я давно готов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730390105,
					"content": "Ура! У нас будет пир в честь Праздника Утсава! Скорее бы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730390106,
					"content": "Ура! Пир в честь Праздника Утсава!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Вода в Ванаране самая лучшая! Из неё можно приготовить вкуснейший суп. Наре наверняка понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730390109,
					"content": "#Чтобы нара {NICKNAME} и Паймон почувствовали истинный вкус радости, нужно позволить им руководить братьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730390110,
					"content": "Лишь так нары смогут приготовить блюда, которые им нравятся. Это называется «этикет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730390111,
					"content": "#Нара {NICKNAME}, хочешь руководить процессом готовки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730390107,
					"content": "Чрезмерные ожидания ни к чему...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
