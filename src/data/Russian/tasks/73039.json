				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391001,
					"content": "Кстати! Раз уж сегодня такой радостный день и аранары так увлечённо для нас готовят, нужно и нам что-нибудь для них приготовить. Как говорится, ответить добром на добро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730391002,
					"content": "Хм... что же им может понравиться? Давай приготовим овощной суп! Хе-хе, пускай узрят мастерство нары!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7303911,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303907",
							"2"
						],
						"stepId": 7303907,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7303907"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арапакати"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391101,
					"content": "Горячий овощной суп готов! Наверное, и аранары закончили готовить свои блюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7303912,
			"completionStepIds": [
				7303908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303908",
							"2"
						],
						"stepId": 7303908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арапакати",
					"Арачатора",
					"Арасака",
					"Арапас",
					"Арафала"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#Да уж, лучше бы попросить путешественни{F#цу}{M#ка} помочь. А то опять приготовишь такое же блюдо, что и в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730391201,
					"content": "Благодаря совету Паймон и вашему чуткому руководству аранара наконец приготовил блюдо.\\nПосле вы все вместе насладились его вкусом...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "Как вам классическая кухня нар?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730391203,
					"content": "#Ох... Арапакати, конечно, предложил, чтобы нара {NICKNAME} руководил{F#а} братьями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391204,
					"content": "Это блюдо... именно так нары представляют себе «вкус радости»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730391205,
					"content": "Радость покидает меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730391206,
					"content": "В Ванаране вкуснейшая водица... Как она смогла превратиться в... это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730391207,
					"content": "А вот «непревзойдённые свежие плоды» всё такие же вкусные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730391208,
					"content": "А? Как же так? Неужели аранарам совсем невкусно? А Паймон очень вкусно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730391209,
					"content": "Я не знаю, что значит «невкусно», но... вкус очень резкий. Ощущение, будто ты бежишь-бежишь и вдруг лбом о дерево стукнулся!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391210,
					"content": "Ого... П-похоже, у аранар культурный шок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730391211,
					"content": "#Братья повели себя очень плохо. Вы должны поблагодарить нару, а не обижать {F#её}{M#его}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391212,
					"content": "У-у-у... простите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730391213,
					"content": "Да не это! «Спасибо» надо сказать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391214,
					"content": "#Спасибо, нара {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730391215,
					"content": "#Главное, что нара {NICKNAME} и Паймон наслаждаются едой! Не обращайте внимания на это дурачьё. Если нары счастливы, то и нам на душе хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391216,
					"content": "#Нара {NICKNAME} совсем не похож{F#а} на нару Варуну. В своё время нара Варуна много говорил{M#а} о {M#своём брате}{F#своей сестре}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391217,
					"content": "#А вот нара {NICKNAME} почти ничего не говорит. Всё хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391218,
					"content": "#Ох... {NICKNAME}, скажи что-нибудь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730391219,
					"content": "Спасибо за беспокойство.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "Правда? Ну, раз так, то хорошо. Спасибо вам. Примите эти цветы в подарок от нас с братьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391223,
					"content": "#Надеемся, что в Ванаране нара {NICKNAME} и Паймон ещё не раз почувствуют «вкус радости»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730391220,
					"content": "(Промолчать.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#В общем, не стоит волноваться, Арапакати! {NICKNAME} в порядке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "Паймон"
				}
			]
		},
