	"talks": [
		{
			"id": 48101,
			"completionStepIds": [
				48101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48101",
							"2"
						],
						"stepId": 48101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "Иногда мне кажется, что я летаю слишком высоко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#{NICKNAME}! Я искала тебя повсюду. Как тебе планер? Нравится парить на ветру?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810104,
					"content": "Похоже, что тебе нравится парящий полёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810105,
					"content": "#Но ты ещё не получил{F#а} лётную лицензию, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810106,
					"content": "Лётная лицензия? Это ещё что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810107,
					"content": "Хм. Это лицензия, позволяющая тебе летать над Мондштадтом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810108,
					"content": "#Но {NICKNAME} без лицензии летает уже очень давно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810109,
					"content": "Вот именно! Уже весь город видел, что вы летаете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810110,
					"content": "Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810111,
					"content": "Значит... Ты искала нас, чтобы вручить лётную лицензию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810112,
					"content": "Нет! У Ордо Фавониус строгие правила относительно полётов в городе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810113,
					"content": "Для начала тебе нужно сдать экзамен, только потом Орден выдаст тебе лицензию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810114,
					"content": "#Я буду принимать у тебя экзамен, {NICKNAME}! Давай проверим твои лётные навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810115,
					"content": "Я подарила тебе планер, поэтому я чувствую за тебя ответственность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810117,
					"content": "Ты же не будешь слишком строга ко мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "#Ладно, я сам{F#а} справлюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "Экзамен! Ненавижу экзамены. Но если его будет принимать Эмбер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810118,
					"content": "Даже не думай об этом! Точка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810120,
					"content": "#{NICKNAME}, я уверена, что у тебя не возникнет проблем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810121,
					"content": "#Давай устроим быструю проверку твоих лётных навыков. Весь город видел, как ты преследовал{F#а} дракона!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810122,
					"content": "Однако мы обязаны соблюдать закон и летать по правилам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810123,
					"content": "Вот «Руководство по управлению планером». Не нужно учить всё наизусть, но ознакомиться со всей книжкой всё-таки стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810124,
					"content": "К примеру, на одном планере может парить только один человек, нельзя превышать установленный лимит веса, нельзя взлетать с помощью Анемо слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810125,
					"content": "В общем, тебе нужно всё это прочитать. Я тоже читала много толстых книжек, когда Лиза учила меня магии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810126,
					"content": "Такая толстая книжка! Чем раньше начнёшь читать, тем быстрее закончишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810127,
					"content": "Отлично! Когда дочитаешь, ищи меня в долине Ветров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4810401,
					"content": "«Руководство по управлению планером» не звучит как очень интересная книжка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810402,
					"content": "Мне ничего не остаётся делать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "Больше похоже на сказку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "Жители Мондштадта чувствуют романтику в обучении полётам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Какая увлекательная история! Но для «Руководства по управлению» она написана в слишком странном стиле..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4810604,
					"content": "Ладно, пойдём скорее к Эмбер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}