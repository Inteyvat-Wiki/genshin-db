			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Паймон, привет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761690102,
					"content": "Мы тоже пришли его навестить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "Хоть он и не скажет об этом вслух, но в душе он, несомненно, будет рад, если узнает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761690104,
					"content": "Вы некоторое время стоите вместе с Иллуги перед могилой...\\nИллуги обратился к павшему товарищу, рассказывая о мелких и крупных событиях, произошедших в Пирамиде за последнее время...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Он наверняка обрадовался, узнав, что в Пирамиде у всех всё хорошо, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761690106,
					"content": "Да. Он выполнил своё задание, и мы продолжим выполнять наше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 761690107,
					"content": "А после нас придут другие. Они будут защищать эту землю, как шпороцветник, что продолжает жить, несмотря на ураганы и лютый мороз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		},
