				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Таннер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Здравствуйте! Есть вести от моего сына?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680601,
					"content": "Кто вы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Я? Приятели называют меня старина Таннер. Я фермер на этой винокурне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680603,
					"content": "Мой отец был фермером. И его отец тоже был фермером. Лучшие вина приготовлены из нашего винограда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680604,
					"content": "Все владельцы винокурни хорошо обращались с нашей семьёй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680605,
					"content": "Но я не думаю. что моему сыну тоже стоит становиться фермером.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680701,
					"content": "Вашего сына?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Гай! Его зовут Гай! Моего сыночка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680703,
					"content": "#Не слышал{F#а} о нём? Ну ничего! Рано или поздно весь Мондштадт узнает его имя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680704,
					"content": "Гай будет сильнейшим рыцарем в Ордо Фавониус! Я в него верю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680705,
					"content": "Я потратил все свои сбережения на то, чтобы его жизнь была лучше моей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680706,
					"content": "Гай уверенно идёт к своей цели. Он стал оруженосцем в шестнадцать и с тех пор обеспечивает всю семью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680801,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Прощай! Если встретишь моего сына, скажи ему, чтобы почаще приходил домой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Таннер"
				}
			]
		},
