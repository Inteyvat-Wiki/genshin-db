			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Таннер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "Как мы можем тебе помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "Кто вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680203,
					"content": "Ах, путешественники! Это так любезно с вашей стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680204,
					"content": "Виноград вот-вот поспеет. Но вдруг откуда ни возьмись в округе появилось стадо кабанов. Им пришёлся по вкусу мой виноград.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680205,
					"content": "Одному мне с ними не справиться, а сынишка мой далеко. Вот и остаётся только смотреть, как они здесь хозяйничают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Таннер"
				},
				{
					"id": 4680206,
					"content": "Помогите мне избавиться от кабанов, и я щедро вам отплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Таннер"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
