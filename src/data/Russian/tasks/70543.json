			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430102,
					"content": "...Мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 705430103,
					"content": "Это вы. Я... разговариваю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430104,
					"content": "Разговариваешь?.. Рэйзор, ты разговариваешь с Дымком?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430105,
					"content": "Мяу, мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 705430106,
					"content": "Кажется, Дымок пытается сказать... «Всё верно»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430107,
					"content": "Знакомый запах, ищет друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430108,
					"content": "Всё хорошо, он счастлив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430109,
					"content": "Мяу, мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 705430110,
					"content": "Запах привлёк друзей. Рад видеть тебя. Ты пахнешь ветром и дождём. Знакомый запах... Запах кошек, тоже знакомый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430111,
					"content": "У Паймон сладкий аромат. Хороший запах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430112,
					"content": "А?! Сладкий... Может, это запах блинов, которыми нас угостила Валерина? Неужели Паймон съела так много?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430113,
					"content": "#Я отдал{F#а} тебе половину моей порции, помнишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Правда? Паймон даже не заметила... Это блины виноваты в том, что они такие вкусные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430116,
					"content": "А ещё Паймон хочет съесть цыплёнка в медовом соусе, мясной стейк и картофельные оладьи... и ещё яблочного напитка бы выпить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430117,
					"content": "#Звучит как выбор для следующей трапезы! {NICKNAME}, давай сделаем заказ Валерине! Пойдём с нами, Рэйзор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430118,
					"content": "С-спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430119,
					"content": "Дымок принёс мне много... орехов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430120,
					"content": "И мясо в коробках... Я наелся досыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 705430121,
					"content": "Похоже, это доставка Валерины. Дымок доставил еду Рэйзору?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430122,
					"content": "Мяу-мяу. Мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 705430123,
					"content": "Паймон и представить себе не могла, что кошки будут заботиться о гостях «Замка котиков»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430124,
					"content": "Похоже, Рэйзор отлично ладит с кошками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705430114,
					"content": "Не волнуйся, ты можешь съесть в три раза больше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}