			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "Нужно впитывать дождевую водичку, чтобы побыстрее вырасти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190102,
					"content": "Привет! Ты же этот... Ара... да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190103,
					"content": "Ты брат Арапакати?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "#Выкрутил{F#ась}{M#ся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190107,
					"content": "...Расти, расти и становись вкусняшкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190108,
					"content": "Вообще нас не замечает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190105,
					"content": "Арасака.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Арасака! Ты Арасака?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "Ой! Это же нары... Огромные! Страшные!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190202,
					"content": "Пожалуйста... Не срывайте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190203,
					"content": "Нет-нет, мы и не собирались ничего рвать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190204,
					"content": "Фух, тогда хорошо... Эти персики зайтун я сам вырастил. Прямо из маленьких семечек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190205,
					"content": "Н-нет, вы, нары - плохие! Нельзя срывать чужие персики зайтун!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190206,
					"content": "П-почему у нар такие плохие повадки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190207,
					"content": "Да мы же ничего не сделали! И сорвать мы ничего не успели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190208,
					"content": "Ещё ничего не сделали, а уже такие жуткие! А если бы что-то сделали - от страха умереть можно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190209,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190210,
					"content": "Нет! Думай, думай, Арасака! Ради персиков зайтун, ради кулинарной тренировки... Тебе нельзя отступать, нельзя бояться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190211,
					"content": "Значит, ты Арасака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190212,
					"content": "Ого! Откуда в-вы знаете моё имя?.. Откуда вы, нары, вообще появились... М-мы только встретились, а вы уже знаете, как меня зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190213,
					"content": "Так ты сам сказал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Мой длинный язык меня погубит! Мне не жить... Теперь вы используете моё имя для страшного проклятия... Прошу вас, пощадите меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190215,
					"content": "Я сделаю, что хотите... Только мои персики зайтун не отдам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190219,
					"content": "Не волнуйся, нас Арапакати прислала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190220,
					"content": "Арапакати? О, моя дорогая сестричка, лучик света в тёмной чаще...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190221,
					"content": "Вы объясняете ситуацию Арасаке.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "Ого! Праздник Утсава... Уже так скоро... Так вы, нары, приехали на праздник?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190223,
					"content": "Извините, я вас только что назвал плохими нарами, но вы - хорошие нары. Ведь только хороших нар пускают в Ванарану на Праздник Утсава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190224,
					"content": "На носу Праздник Утсава, а если я вернусь в Ванарану, не закончив свои кулинарные практики... Так нельзя... Но я не могу пропустить Праздник безделья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190225,
					"content": "Чего ты так разволновался? У тебя же ещё вон, твои персики зайтун, ну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190226,
					"content": "Моих персиков зайтун недостаточно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190227,
					"content": "Мне непременно нужно добыть «вкус счастья». Без «вкуса счастья» персики зайтун - просто обычные персики зайтун...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190228,
					"content": "Арачатора, Арапас, Арафала - никто не верит, что бывает «вкус счастья». Я сделаю и покажу им. И нарам дам попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190229,
					"content": "«Вкус счастья»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "Хи-хи, однажды я попробовал «вкус счастья».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190232,
					"content": "«Вкус счастья»... он такой белый-белый, его потрёшь, а он рассыпается и становится белой валукой, но не твёрдой и колючей. Он в твёрдом пузыре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190233,
					"content": "Белый валука?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Белый валука - это белый песок, да?.. А что за твёрдый пузырь?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190236,
					"content": "Уф, Паймон ничего не понимает. А где этот «вкус счастья»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190237,
					"content": "А ты почему интересуешься? Хочешь вперёд меня заполучить «вкус счастья»? Страшно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190238,
					"content": "Мы помочь тебе хотим...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Помочь мне? Зачем мне помогать? Я с-сам могу достать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190242,
					"content": "Но там много нар шастает. А один пахнет валукой. Ох, я так боюсь... Вот бы там было поменьше нар, тогда бы я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190243,
					"content": "Ай, ну ладно, я не справлюсь. Я... не пойду в Гандхарву, там так много нар. И повсюду мёртвые деревья. Я боюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190244,
					"content": "У меня там был друг из нар, но это было очень-очень давно. Теперь он изменился и не слышит мой голос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190245,
					"content": "Так, значит, этот твой «вкус счастья» в Гандхарве?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190246,
					"content": "«Вкус счастья» не из земли растёт, его нары делают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190247,
					"content": "Я так хочу снова его попробовать. Я помню, как я был рад, когда впервые его попробовал. Это так вкусно! Так вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190248,
					"content": "Вместе с другом нарой мы считали кусочки солнечного света, словно золотые листья, падающие с деревьев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190249,
					"content": "Мы пели песни и пробовали «вкус счастья». Каждый раз, когда я вижу солнечный свет, застрявший в листве, я вспоминаю его. А когда я его вспоминаю, я тут же думаю о «вкусе счастья».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190250,
					"content": "И я хочу, чтобы Арапакати попробовала. А когда начнётся Праздник Утсава - чтобы попробовали и нары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190251,
					"content": "#Паймон поняла! Паймон и {NICKNAME} с этим справятся. Да, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190252,
					"content": "Я тоже хочу немного счастья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Правда? А вы меня не обманете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190255,
					"content": "Ни за что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190256,
					"content": "Но в Гандхарве столько людей! Кого нам искать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190257,
					"content": "А я вам скажу. Недавно по этой дороге я видел нару, <color=#00E1FFFF>идущего в Гандхарву</color>. Вот у него с собой был «вкус счастья».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190258,
					"content": "На спине он тащил выпуклую штуку. В таких штуках нары носят вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190259,
					"content": "Выпуклая штука на спине... <color=#00E1FFFF>Наверное, дорожный мешок или корзина</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190260,
					"content": "Понятно. Мы достанем тебе «вкус счастья»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190253,
					"content": "Ну раз мы уже пообещали...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "Ого! Паймон, а ты страшная!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "Эй! Паймон просто хочет помочь Арасаке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730190234,
					"content": "Твёрдый пузырь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "Что за «вкус счастья»?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "Да мы уже поняли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "Что?! Уже поняли? Так вы давно за мной следите... Н-неужели... неужели вам от меня что-то нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190218,
					"content": "Что? Персики зайтун? Н-ни в коем случае! Я всё отдам, н-но только не их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Арасака"
				}
			]
		},
		{
			"id": 7301903,
