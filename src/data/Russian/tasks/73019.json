			},
			"dialogs": [
				{
					"id": 730190301,
					"content": "Н-ну что? Вы нашли «вкус счастья»?.. Ну там... в Гандхарве?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730190302,
					"content": "У одного нары на спине была выпуклая штука. А в ней наверняка был «вкус счастья»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арасака"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"2"
