	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Субретка"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "...Может быть, на полтона выше. Попробуем ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490102,
					"content": "Привет, Коломбина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490103,
					"content": "Ты... учишь куухенки играть на лире?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490104,
					"content": "Да. Они так обрадовались, что её починили. И теперь не отходят от меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490105,
					"content": "Игра на лире никогда не была моей сильной стороной. Я больше привыкла слушать, как играют другие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490106,
					"content": "О, верно! Если бы у тебя была группа, ты бы точно была вокалисткой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490107,
					"content": "#Если говорить о музыкальных инструментах... {F#Путешественница}{M#Путешественник} - настоящий талант! От лиры до барабана джем-джем - он{F#а} играет на всём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490108,
					"content": "Паймон преувеличивает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Правда? Тогда... может быть, ты их научишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490111,
					"content": "Почему бы и нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Мы разучивали песню, которую я обычно пою. Может быть, ты помнишь, как она звучит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490114,
					"content": "Или... Другая мелодия тоже подойдёт. Куухенки редко слышат музыку из других мест. Мне тоже было бы интересно послушать что-нибудь эдакое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490115,
					"content": "(Хм, что же сыграть?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Попробуем ту, которую всегда поёт Коломбина...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Какую мелодию выбрать?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Попробуем спокойную мелодию...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "#Это было прекрасно. Удивительно, что ты запомнил{F#а} мою мелодию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490605,
					"content": "Хе-хе, это потому, что ты замечательная певица! Когда мы слышим твой голос, то иногда останавливаемся послушать, как ты поёшь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490606,
					"content": "Куухенки очарованы твоим выступлением. Возможно, они почерпнули что-то новое для себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490607,
					"content": "В будущем мне снова может понадобиться твоя помощь в обучении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490608,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490609,
					"content": "Нет, нет, это было бесплатное выступление. Никакой платы за обучение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490610,
					"content": "Хм? Плата за обучение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490611,
					"content": "Я подумала... что нежное сияние лунного света станет подходящим аккомпанементом для такой прекрасной мелодии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490701,
					"content": "Попробуем весёлую...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "О, это всё? Я могла бы слушать её вечно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490703,
					"content": "Как я говорила, это единственная колыбельная, которую я помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490704,
					"content": "Я не до конца понимаю её смысл, но, послушав мелодию в твоём исполнении, я чувствую, что какой бы ответ ни ждал меня там, на Луне... он будет прекрасен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490705,
					"content": "Дай мне руку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490706,
					"content": "Тебе не нужно ничего давать нам взамен. Правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490707,
					"content": "Ах, у меня другое намерение... Я хотела украсить твою мелодию лучами нежного лунного света.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490801,
					"content": "Попробуем что-нибудь чужеземное...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "Удивительно... Я слышала подобные мелодии раньше, но твоё исполнение придаёт им совершенно новое звучание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490803,
					"content": "#Возможно, в нём заключены чувства, которые {F#путешественница}{M#путешественник} испытывал{F#а} к той стране.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490804,
					"content": "Любопытно то, что... я могу представить этот пейзаж, слушая мелодию. Интересно, насколько реальность соответствует моему воображению...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490805,
					"content": "Тебе стоит как-нибудь побывать там! Мы будем твоими проводниками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760490806,
					"content": "Мм... Возможно. Если этот день когда-нибудь наступит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760490112,
					"content": "Но что мне сыграть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "...но я и правда музицирую время от времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
