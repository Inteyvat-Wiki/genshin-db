			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "Спешите попробовать новинку - калейдофонарь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590102,
					"content": "Готово новое изображение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "#А то! Ты сложил{F#а} предыдущие с такой лёгкостью, что я был просто обязан поменять фонари на самые сложные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590104,
					"content": "Принцип игры всё тот же, но теперь фонари <color=#00E1FFFF>соединены друг с другом</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590105,
					"content": "Хе-хе, просто попробуй, и ты сразу поймёшь, в чём дело. Сегодня нужно сложить <color=#00E1FFFF>журавля</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590106,
					"content": "Когда сложится изображение, можешь отправляться на поиски сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Цянь"
				}
			]
		},
