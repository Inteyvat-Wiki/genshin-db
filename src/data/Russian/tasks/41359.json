					"Малыш Цянь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "Ну как идёт поиск сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590202,
					"content": "#Я уже их все наш{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "#Ты разгадал{F#а} все три изображения... Впечатляет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590204,
					"content": "Кхм. За выдающиеся достижения в области поиска сокровищ Гильдия приготовила для тебя особый подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590205,
					"content": "Видишь эти сундуки? Всё, что в них есть, - твоё. Налетай!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590206,
					"content": "Если всё досталось мне...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "То другие останутся с носом. Таковы приключения - кто успел, тот и съел!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590208,
					"content": "Ну, ладно. Счастливого Праздника морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Цянь"
				}
			]
		},
