			"dialogs": [
				{
					"id": 413590301,
					"content": "#Надо же... Собрал{F#а} все картинки, запросто так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590302
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590302,
					"content": "#Что, уже справил{F#ась}{M#ся}?.. Да ты лихой искатель приключений, скажу я тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413590303,
					"content": "Рассмотри ширму. На ней ты найдёшь все ведущие к сокровищам подсказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Цянь"
				}
			]
		},
