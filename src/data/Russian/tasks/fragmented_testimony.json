			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рэнчо",
					"Пия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200101,
					"content": "Ну, как продвигается работа по твоей теме?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200102
					],
					"speakerTitle": "Рэнчо"
				},
				{
					"id": 130200102,
					"content": "В следующем месяце жду публикацию. Фух... Последние дни я думала, что всё отменят. К счастью, это была ложная тревога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200103
					],
					"speakerTitle": "Пия"
				},
				{
					"id": 130200103,
					"content": "Среди наставников, которые руководили твоей работой, был Азар. Я боялся, это скажется на твоём проекте. Как всё разрешилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200104
					],
					"speakerTitle": "Рэнчо"
				},
				{
					"id": 130200104,
					"content": "Но Академия назначила исполняющего обязанности великого мудреца! Он проверил наши проекты и разрешил продолжать исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200105
					],
					"speakerTitle": "Пия"
				},
				{
					"id": 130200105,
					"content": "Исполняющий обязанности великого мудреца? Никогда раньше не слышал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200106
					],
					"speakerTitle": "Рэнчо"
				},
				{
					"id": 130200106,
					"content": "Говорят, новый состав мудрецов ещё не утвердили... Поэтому он временно исполняет обязанности великого мудреца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200107
					],
					"speakerTitle": "Пия"
				},
				{
					"id": 130200107,
					"content": "Но благодаря его заступничеству нам удалось сохранить результаты исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200108
					],
					"speakerTitle": "Пия"
				},
				{
					"id": 130200108,
					"content": "Вот опубликую работу и устрою себе настоящий отпуск, отдохну как следует. В Мондштадт съезжу, развеюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200109
					],
					"speakerTitle": "Пия"
				},
				{
					"id": 130200109,
					"content": "Они там совсем с ума посходили - назначили аль-Хайтама исполняющим обязанности великого мудреца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200110
					],
					"speakerTitle": "Раджкумар"
				},
				{
					"id": 130200110,
					"content": "Не сердитесь, наставник. Я тоже очень огорчён. С таким научным стажем вы один из величайших учёных Академии. Как им в голову могло прийти назначить этого юнца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200111
					],
					"speakerTitle": "Рэхан"
				},
				{
					"id": 130200111,
					"content": "Глупец! Ты думаешь, я злюсь, потому что сам метил в мудрецы? Я просто не могу понять, что они нашли в аль-Хайтаме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200112
					],
					"speakerTitle": "Раджкумар"
				},
				{
					"id": 130200112,
					"content": "Когда-то он был моим студентом, крайне редко появлялся в аудитории. Я спросил, почему он отсутствует на занятиях, а этот мальчишка заявил, что лучше дома изучит самостоятельно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200113
					],
					"speakerTitle": "Раджкумар"
				},
				{
					"id": 130200113,
					"content": "Наглец! Никакого уважения! И этот человек стал исполняющим обязанности великого мудреца? Какая беда для Академии. Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200114
					],
					"speakerTitle": "Раджкумар"
				},
				{
					"id": 130200114,
					"content": "Не расстраивайтесь, наставник. Я... я принесу вам воды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200115
					],
					"speakerTitle": "Рэхан"
				},
				{
					"id": 130200115,
					"content": "Тсс... Открою вам один секрет! Говорят, исполняющий обязанности великого мудреца когда-то учился у нас в Хараватате!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200116
					],
					"speakerTitle": "Резахани"
				},
				{
					"id": 130200116,
					"content": "Правда? Кто это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200117
					],
					"speakerTitle": "Фариба"
				},
				{
					"id": 130200117,
					"content": "Его зовут аль-Хайтам. Я его никогда не видел, но все разговоры в последнее время только о нём. И непонятно, что правда, а что нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200118
					],
					"speakerTitle": "Ровшан"
				},
				{
					"id": 130200118,
					"content": "А ещё один учёный из Вахуманы в последнее время тоже оказался в центре внимания. Говорят, его выберут одним из мудрецов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200119
					],
					"speakerTitle": "Ровшан"
				},
				{
					"id": 130200119,
					"content": "Да? А он сейчас преподаёт? Может, нам стоит заглянуть к нему?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200120
					],
					"speakerTitle": "Фариба"
				},
				{
					"id": 130200120,
					"content": "Ого... Как быстро распространилась новость о назначении аль-Хайтама исполняющим обязанности великого мудреца. Но всё равно есть люди, которые его не знают. Выходит, он никакая не знаменитость?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200121,
					"content": "Одни его хвалят, другие ругают... Особенно этот старик. Он аль-Хайтамом очень недоволен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200122,
					"content": "Ой, что такое? Тебе нехорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200123,
					"content": "Матра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200124
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200124,
					"content": "Матра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200125,
					"content": "Я Ильяс. Мне нужно поговорить с матрой, дело очень важное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200126
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200126,
					"content": "Ой, посмотри на себя! Тебе бы лучше как следует отдохнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200127,
					"content": "Давай ты скажешь нам, что случилось, а мы передадим матре?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200128,
					"content": "Нет. Я должен сам, я верю только матрам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200129
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200129,
					"content": "Помогите мне дойти. Это важное дело, мне очень нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200130
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200130,
					"content": "Раз ты так говоришь... Ладно, мы тебя отведём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1302003,
			"completionStepIds": [
				1302003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302003",
							"2"
						],
						"stepId": 1302003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аарав"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200301,
					"content": "Привет! Мы хотели спросить, Сайно сейчас в Академии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200302,
					"content": "Знакомые лица... Вы друзья господина Сайно? Его сейчас нет на месте, отбыл по делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200303
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200303,
					"content": "Можете пока рассказать всё мне, а я передам ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200304
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200304,
					"content": "Мы встретили этого человека у входа в Академию. Он требовал встречи с матрой, говорит, у него какое-то срочное дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200305,
					"content": "Да? Тогда позволь мне узнать, что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200306
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200307
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200307,
					"content": "Сирадж...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200308
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200308,
					"content": "Сирадж? Знакомое имя. Тот учёный из Вахуманы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200309
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200309,
					"content": "Учёный из Вахуманы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200310,
					"content": "Да, восходящая звезда даршана Вахумана. Говорят, он столь же смел, сколь умён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200311
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200311,
					"content": "А ещё говорят, скоро он возглавит Вахуману и станет одним из шести мудрецов... Так что ты говорил про Сираджа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200312
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200312,
					"content": "Я должен его разоблачить... Сирадж проводит опасный эксперимент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200313
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200313,
					"content": "Он похитил меня, связал и притащил в эту ужасную пещеру... Там повсюду стояло лабораторное оборудование...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200314
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200314,
					"content": "Я вырвался и бежал... Ещё немного, и он бы поймал меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200315
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200315,
					"content": "Не волнуйся. Расскажи, как всё было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200316
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200316,
					"content": "Что у него там за эксперименты? Где эта пещера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200317
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200317,
					"content": "Я не помню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200318
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200318,
					"content": "А? Это ведь очень важно! Как не помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200319,
					"content": "Я помню только, как Сирадж подошёл ко мне, а потом сознание у меня помутилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200320
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200320,
					"content": "Я забыл многое из того, что помнил. Я как будто попал в кошмар. Но я знаю, что там очень опасно, их надо остановить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200321
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200321,
					"content": "Да, и я слышал, что они собираются провести сделку в таверне. Надо поспешить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200322
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200322,
					"content": "Раз ты так говоришь... Ладно, я попрошу своих товарищей проверить Сираджа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200323
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200323,
					"content": "Но перед этим тебе придётся пройти проверку на детекторе лжи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200324
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200324,
					"content": "Ты мне не веришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200325
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200325,
					"content": "Нет, что ты. Это обычная процедура.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200326
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200326,
					"content": "Прошу вас, подождите здесь. А мы скоро вернёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200327
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200327,
					"content": "Ожидание немного затянулось...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130200328
					]
				},
				{
					"id": 130200328,
					"content": "О, аль-Хайтам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200329,
					"content": "Введу вас в курс дела: Ильяс прошёл проверку на детекторе лжи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200330
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200330,
					"content": "Это значит, что его словам, скорее всего, можно доверять. Мы решили начать расследование, опираясь на ту информацию, что он предоставил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200331
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200331,
					"content": "Согласно протоколу, я доложил обо всём господину аль-Хайтаму. Выслушав меня, он оставил письмо господину Сайно, а потом выказал желание отправиться на расследование вместе с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200332
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200332,
					"content": "Странно. Чтобы аль-Хайтаму захотелось присоединиться к матрам? Может, на то есть какие-то особые причины?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200333
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200333,
					"content": "Не выдумывай, мне просто стало интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200334
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200334,
					"content": "Правда? Как много у тебя свободного времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200335,
					"content": "#{NICKNAME}, может, тоже посмотрим, что там случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200336
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200336,
					"content": "Участие господина аль-Хайтама в нашей операции уже противоречит правилам. А вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200337
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200337,
					"content": "Впрочем, ладно. Это ведь вы привели ко мне Ильяса. Я разрешаю вам присоединиться к нашему отряду, но вы должны хранить всё в тайне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200338
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200338,
					"content": "Не беспокойся. Мы умеем держать язык за зубами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200339
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200339,
					"content": "Тогда я расскажу, что нам известно на данный момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200340
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200340,
					"content": "Ильяс утверждает, что Сирадж собирается заключить сделку в таверне с неким исследователем из Кшахревара. Это один из немногих фактов, которые он хорошо помнит. Похоже, он случайно услышал об этом, когда бежал из пещеры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200341
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200341,
					"content": "Надо сказать, что Сирадж сейчас не в Академии, месяц назад он подал заявку на проведение длительного полевого исследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200342
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200342,
					"content": "Сделка в таверне, о которой говорит Ильяс, должна случиться совсем скоро. Поэтому мы решили немедленно отправиться в таверну и произвести досмотр всех подозрительных личностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200343
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200343,
					"content": "Так и есть. Мы выдвигаемся в путь, а вы - как хотите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200344
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200344,
					"content": "Да ладно тебе! Мы же договорились, что идём вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1302005,
			"completionStepIds": [
				1302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302005",
							"2"
						],
						"stepId": 1302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200501,
					"content": "Мы на месте, господин аль-Хайтам. Что дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200502
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200503
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200503,
					"content": "Господин аль-Хайтам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200504
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200504,
					"content": "Вижу, ты не читал последних циркуляров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200505
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200505,
					"content": "В недавнем указе Академии ясно сказано, что даже мудрецы не имеют права вмешиваться в действия матр во время расследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200506
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200506,
					"content": "Генерал махаматра никогда бы не спросил у меня, что ему делать. Наоборот, попросил бы меня «не лезть со своими указаниями».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200507
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200507,
					"content": "...Да, вы правы. Тогда прошу вас подождать здесь, а мы оцепим территорию и задержим всех, кто попадает под подозрение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200508
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200508,
					"content": "Ильяс, оставайся здесь. Господин аль-Хайтам, отдаю главного свидетеля по делу под вашу защиту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200509
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200509,
					"content": "Хорошо. Но было бы лучше, если бы он мог защитить себя сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200510
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200510,
					"content": "Ничего не меняется... Аль-Хайтам, ты такой же заносчивый, как тогда, в деревне Аару.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200511,
					"content": "Отвечая на никудышные вопросы, ты только потворствуешь тому, кто их задаёт. И я должен был чётко обозначить ему свою позицию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200512
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200512,
					"content": "Что ты хочешь сказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130200513
					]
				},
				{
					"id": 130200513,
					"content": "Аарав был столь же озадачен моим желанием участвовать в расследовании, как и вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200514
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200514,
					"content": "Но ему картина представлялась несколько иначе. Примерно так: «Исполняющий обязанности великого мудреца решил присвоить себе часть полномочий матр».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200515
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200515,
					"content": "Своим вопросом он явно меня испытывал. В прежние времена матры находились под влиянием мудрецов, и им трудно было избежать подобных бюрократических ловушек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200516
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200516,
					"content": "Но ему не было нужды меня испытывать. Надеюсь, он поймёт, что я не собираюсь вмешиваться в их работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200517
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200517,
					"content": "Как сложно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130200518,
					"content": "Вот почему я с самого начала не хотел становиться исполняющим обязанности великого мудреца. Высокий пост неизбежно всё усложняет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200519
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200519,
					"content": "Простите... Господин аль-Хайтам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200520
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200520,
					"content": "У меня сомнения. Я должен спросить... Мы с вами раньше встречались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200521
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200521,
					"content": "Нет, я тебя не помню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200522
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200522,
					"content": "Ха-ха... Я так и думал. Где бы я мог встретиться с таким человеком, как вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200523
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200523,
					"content": "Тогда почему ты спрашиваешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200524
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200524,
					"content": "Просто при первой встрече у меня откуда-то появилось ощущение... будто мы знакомы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200525
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130200525,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200526
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200526,
					"content": "Проделки памяти? Или...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200527
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200527,
					"content": "Господин аль-Хайтам! Мы задержали подозреваемого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200528
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200528,
					"content": "Сираджа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200529
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200529,
					"content": "Нет, учёного из Кшахревара, с которым готовилась сделка. Его имя - Нарендра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200530
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200530,
					"content": "Гос... господин аль-Хайтам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200531
					],
					"speakerTitle": "Нарендра"
				},
				{
					"id": 130200531,
					"content": "Подождите, вы можете мне объяснить, что происходит? Да, я украл некоторые детали из лаборатории для перепродажи, но разве такая мелочь стоит внимания исполняющего обязанности великого мудреца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200532
					],
					"speakerTitle": "Нарендра"
				},
				{
					"id": 130200532,
					"content": "Силы небесные, кажется, я попал в серьёзный переплёт... Я... я просто хотел немного заработать, прошу, пощадите меня! Я больше не буду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200533
					],
					"speakerTitle": "Нарендра"
				},
				{
					"id": 130200533,
					"content": "Мне нужно задать ему несколько вопросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200534
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200534,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200535
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200535,
					"content": "Ты знаком с Сираджем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200536
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200536,
					"content": "Так зовут моего покупателя. Мы договорились встретиться в таверне, но он не пришёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200537
					],
					"speakerTitle": "Нарендра"
				},
				{
					"id": 130200537,
					"content": "В чём заключалась сделка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200538
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200538,
					"content": "Не знаю, что у него за эксперименты, но ему понадобилось большое количество источников питания и электрических компонентов, которые есть только на нашем проекте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200539
					],
					"speakerTitle": "Нарендра"
				},
				{
					"id": 130200539,
					"content": "Он связался со мной в частном порядке, уговорил списать некоторые компоненты из лаборатории как брак и пообещал купить их по высокой цене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200540
					],
					"speakerTitle": "Нарендра"
				},
				{
					"id": 130200540,
					"content": "Мы договорились, что я передам ему товар сегодня в таверне, но я не ожидал, что он не придёт. Уж тем более не ожидал встретить вас...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200541
					],
					"speakerTitle": "Нарендра"
				},
				{
					"id": 130200541,
					"content": "Наверное, Сирадж понял, что Ильяс может его выдать, и потому не явился на встречу? Что ж, здесь ниточка обрывается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200542
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200542,
					"content": "Но есть и хорошая новость: что бы там ни задумал Сирадж, без этих источников питания и компонентов его эксперименты остановятся. Так что у нас есть время на расследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200543
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200543,
					"content": "У вас остались вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200544
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200544,
					"content": "Нет. Нарендру можете уводить. Но мне нужен ненадолго Ильяс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200545
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200545,
					"content": "О, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200546
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200546,
					"content": "Ильяс прошёл полную проверку на детекторе лжи, у него действительно потеря памяти. Так что мы не надеемся, что он окажет в дальнейшем помощь в расследовании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200547
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200547,
					"content": "Однако могу ли я спросить, зачем он вам понадобился?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200548
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200548,
					"content": "Я читал некоторые научные работы о потере памяти. Хочу попытаться помочь ему всё вспомнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200549
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130200549,
					"content": "Вот оно что... Тогда мы возвращаемся в Академию, а Ильяс остаётся в вашем распоряжении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200550
					],
					"speakerTitle": "Аарав"
				},
				{
					"id": 130200550,
					"content": "Идите за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аль-Хайтам"
				}
			]
		},
