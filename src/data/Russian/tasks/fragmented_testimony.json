		{
			"id": 1302012,
			"completionStepIds": [
				1302012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302012",
							"2"
						],
						"stepId": 1302012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130201201,
					"content": "Сирадж не пришёл в таверну, Нарендра ничего не знает... Получается, расследование забуксовало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201202,
					"content": "Аль-Хайтам, ты правда собираешься следить за этим делом? Паймон видит, что оно вызвало у тебя необычный интерес. Даже странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201203,
					"content": "Я думал, ты уже сама догадалась, в чём причина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201204
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201204,
					"content": "#А? Паймон ни о чём не догадывается! {NICKNAME}, а ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201205,
					"content": "Ты знаком с Сираджем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130201206
					]
				},
				{
					"id": 130201206,
					"content": "Да, мы учились на одном курсе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201207
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201207,
					"content": "Вот оно что! Значит, ты решил присоединиться к расследованию, когда Аарав рассказал тебе, кто подозреваемый!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201208,
					"content": "Тебе интересно не само дело, а главный подозреваемый, потому что ты с ним знаком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201209,
					"content": "Твои выводы весьма далеки от реальности, но я и не надеялся, что тебе удастся сделать более точное заключение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201210
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201210,
					"content": "Пока тебе достаточно знать, что мы учились на одном курсе. Потом я стал секретарём, а он продолжил строить научную карьеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201211
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201211,
					"content": "Год назад он подал заявку на исследование. Просмотрев заявку, великий мудрец спросил, что я думаю, и я высказался против. Тема Сираджа касалась одного из Шести смертных грехов: он хотел вмешаться в эволюцию человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201212
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201212,
					"content": "Первый из Шести смертных грехов - вмешиваться в эволюцию человека, последний - давать волю языку и не ведать страха. Шесть смертных грехов являются источником всего зла в этом мире, и именно опираясь на запреты шести грехов, мудрецы устанавливают и корректируют свод правил Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201213
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201213,
					"content": "На мой взгляд, исследование Сираджа было слишком наивным, при этом оно нарушало принципы Академии. Великий мудрец учёл моё мнение и принял решение отклонить заявку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201214
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201214,
					"content": "Вот почему он решил купить источники питания и компоненты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201215,
					"content": "Скорее всего, он пытается обойти правила и провести эксперимент в тайне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201216
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201216,
					"content": "Звучит очень подозрительно. Лучше бы нам его остановить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201217,
					"content": "Ильяс, напряги память! Может, вспомнишь что-нибудь ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201218,
					"content": "Извините. Я пробовал, но как бы я ни старался, все воспоминания будто скрыты за густой пеленой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201219
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201219,
					"content": "После сильного стресса человек может стереть из памяти часть событий, чтобы защитить свою психику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201220
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201220,
					"content": "Но эти воспоминания не исчезают, они просто запечатываются на время. Если оказать должное воздействие на память, их можно восстановить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201221
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201221,
					"content": "Попробуй вспомнить что-нибудь важное, пусть и не связанное с этим делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201222
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201222,
					"content": "На самом деле из памяти стёрлось очень многое. И не только события, связанные с моим похищением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201223
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201223,
					"content": "Что я за человек?.. Чем занимался?.. Какие-то вещи я помню, а другие будто начисто исчезли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201224
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201224,
					"content": "Но я смутно помню, что есть две задачи, которые я обязательно должен выполнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201225
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201225,
					"content": "Расскажи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201226
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201226,
					"content": "Первая: забрать в Академии жалованье и отнести младшей сестре в Гандхарву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201227
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201227,
					"content": "Подробностей не помню... Помню только, что раньше я каждый месяц относил сестре жалованье, чтобы поддержать нашу семью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201228
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201228,
					"content": "А вторая? Что ещё нужно сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201229,
					"content": "Не помню. Извините. Я правда многое забыл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201230
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201230,
					"content": "Неудивительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201231
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201231,
					"content": "Сейчас из всех нас ты один видел Сираджа и знаешь, где находится та пещера. Поэтому мы приложим все усилия, чтобы помочь тебе восстановить память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201232
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 130201232,
					"content": "Потерять память... Наверное, это ужасно. Но не беда, мы поможем тебе всё вспомнить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130201233,
					"content": "Спасибо. Это не просто ужасно, я даже не знаю, как описать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201234
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201234,
					"content": "Лишившись памяти, я даже не представляю, что я вообще за человек... В голове шум, будто за памятью я вот-вот потеряю и сознание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201235
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201235,
					"content": "Но помимо этого тошнотворного чувства, ещё я испытываю облегчение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201236
					],
					"speakerTitle": "Ильяс"
				},
				{
					"id": 130201236,
