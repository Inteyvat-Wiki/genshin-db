					"nextDialogs": [
						766500215
					],
					"speakerTitle": "Хорёк-барахольщик"
				},
				{
					"id": 766500215,
					"content": "Хе-хе, Паймон не поймаешь, Паймон летает! Хе-хе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766500216,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "Хорёк-барахольщик"
				},
				{
					"id": 766500217,
					"content": "На меня не забирайся...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "Ладно, не будем обижать гостей.",
					"roleType": "TALK_ROLE_NPC",
