			"dialogs": [
				{
					"id": 102010101,
					"content": "Мы на месте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010102,
					"content": "Вот здесь было спрятано моё огрооомное сокровище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010103,
					"content": "А сейчас здесь только огромная дыра в земле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010104,
					"content": "Подожди... Кто это там?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "Маг Бездны?! Должно быть, именно о нём говорила Джинн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010106,
					"content": "А что это у него в руках?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010107,
					"content": "Моё сокровище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010108,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010109,
					"content": "Ага... Эта девчонка привела помощников. План немного изменился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010110,
					"content": "Эй! Вернись и сражайся! Трус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010111,
					"content": "В погоню!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
