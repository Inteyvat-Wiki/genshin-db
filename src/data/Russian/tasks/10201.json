				"points": []
			},
			"dialogs": [
				{
					"id": 102010301,
					"content": "Вход в подземелье! Маг Бездны ускользнул через него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010302,
					"content": "Значит, он сам загнал себя в угол.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "*Тяжело дышит*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010305,
					"content": "Кли... Ты не хочешь немного передохнуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010306,
					"content": "Может, ты подождёшь здесь, а мы вернём тебе сокровище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010307,
					"content": "Нет... Я пойду с вами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010308,
					"content": "Пушистик забрал моё сокровище! И я сама его верну!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010309,
					"content": "Какая храбрость.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "Хи-хи, не переживай... Кли уже большая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010312,
					"content": "#Вперёд, почётный рыцарь! {NICKNAME}, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010310,
					"content": "Но в подземельях очень опасно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "Погоня продолжается.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
		{
			"id": 1020104,
			"completionStepIds": [
				1020111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
