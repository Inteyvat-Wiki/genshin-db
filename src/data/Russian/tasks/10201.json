			"trigger": {
				"objectNames": [
					"Кли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "Вам удалось меня выследить. Хм... Я впечатлён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010402,
					"content": "Но на этом ваши успехи закончатся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010403,
					"content": "И что же ты сделаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010404,
					"content": "Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010405,
					"content": "Людская молва донесла до нас слухи о твоей силе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010406,
					"content": "Мы узнали, что маленькая девушка в красном обладает самым мощным сокровищем в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010407,
					"content": "А сейчас это сокровище в моих руках! Вы проиграли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010408,
					"content": "Твоё сокровище тебя и погубит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010409,
					"content": "Нет! Не трожь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010410,
					"content": "Ха! Ты дрожишь от страха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010411,
					"content": "Что у нас здесь? Огненный символ? Ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010412,
					"content": "Бум!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Маг Бездны"
				},
				{
					"id": 102010501,
					"content": "Нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010502,
					"content": "Я нарушила правила выживания... «Если кого-то поранит... Джинн злая станет»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010503,
					"content": "Всё кончено!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010505,
					"content": "Сокровище Кли - это бомба?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010506,
					"content": "Как круто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Теперь понятно, почему Кли называют самым сильным воином в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010509,
					"content": "Лучше её не злить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010510,
					"content": "Но... Куда она убежала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010511,
					"content": "Это её «Золотые правила выживания»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "Хм... Возможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102010514,
					"content": "Давай вернёмся в <color=#00E1FFFF>штаб Ордо Фавониус</color> и поговорим с Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
