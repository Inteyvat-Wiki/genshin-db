			"dialogs": [
				{
					"id": 240070101,
					"content": "Лави! Нашла что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070102,
					"content": "Нет, тут вообще ничего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070103,
					"content": "Что вы делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "#Ищем сокровища! {M#Братец}{F#Сестрица}, хочешь с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070105,
					"content": "Сокровища?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "Не слушай Верута, вечно он хвастает. Нам просто нужны кое-какие компоненты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070107,
					"content": "Ну и чем они не сокровище?.. Хм, должно быть где-то здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070114,
					"content": "Похоже, ничего мы тут не найдём. Поищем в другом месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070115,
					"content": "Конечно! Давай пройдём немного дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070116,
					"content": "Я с вами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "Ну прям как мой братец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070119,
					"content": "Тогда пройдём немного дальше. Я уверен, что здесь должны быть компоненты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070117,
					"content": "Не стоит убегать далеко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "А где Орель?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "Ищет господина Делерю, хочет задать какие-то вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070110,
					"content": "А нам нужно вести себя прилично... и искать сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070111,
					"content": "Хочешь с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070112,
					"content": "Не слушай Верута, вечно он хвастает. Нам просто нужны кое-какие компоненты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "Лави"
