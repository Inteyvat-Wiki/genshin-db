			"dialogs": [
				{
					"id": 240070501,
					"content": "Дай-ка взглянуть... Эта шестерёнка нам пригодится. А если открыть подшипник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070502,
					"content": "Зачем тебе это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Хочу сделать механическую куклу. Я давно интересовалась этой темой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070504,
					"content": "Вот вырасту и построю огромного-преогромного мека, то-то папа удивится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070505,
					"content": "Я прочитала много книг у него в кабинете, и по этим книгам делаю простые компоненты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070506,
					"content": "Нужно ещё поднапрячься, и сделаю мека!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070507,
					"content": "Но изучать механику в городе не получится, ведь родители сразу заметят, тогда сюрприза не выйдет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070508,
					"content": "Вот так это место превратилось в тайную лабораторию Лави. А я... просто ассистент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240070509,
					"content": "Эй, ассистент, кончай разговорчики! Пора заняться исследованиями. Сегодня мы делаем подвижную руку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240070510,
					"content": "Так точно! Начинаем исследование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верут"
				}
			]
		}
