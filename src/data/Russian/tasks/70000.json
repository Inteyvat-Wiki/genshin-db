					"Флора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "Добро пожаловать в «Шёпот цветов»! Вам что-нибудь подсказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 700000402,
					"content": "Я хочу сделать снимок для Саида.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Думаю, что Праздник ветряных цветов - это уникальная традиция Мондштадта. Жители Сумеру, наверное, его не отмечают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 700000404,
					"content": "Он хочет фотографию меня и моих цветов? Без проблем! У господина Саида действительно особенный склад ума. Наверное, все учёные такие, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				}
			]
		},
