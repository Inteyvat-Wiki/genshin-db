			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саид"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "Все фотографии уже готовы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000602,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "О, прекрасные кадры. Они безусловно украсят мой доклад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000604,
					"content": "Эти виды напоминают мне о праздниках на моей родине, Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000605,
					"content": "А какие у вас там праздники?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "О, вам, должно быть, наши традиции незнакомы. Каждый год в честь рождения малого властителя Кусанали мы отмечаем праздник Сабзеруз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000607,
					"content": "Ежели говорить об атмосфере, то от мондштадтского Праздника ветряных цветов он всё же отличается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000608,
					"content": "К слову сказать, я и Сабзеруз в этом году пропустил. Столько времени утекло. Интересно, как там дела в Академии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000609,
					"content": "Впрочем, я отдаляюсь от темы. Как бы то ни было, благодарю вас за помощь. Пожалуйста, прими это в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саид"
				}
			]
		}
	]
