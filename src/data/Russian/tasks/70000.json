			"trigger": {
				"objectNames": [
					"Саид"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "Какая романтичная традиция! Стоит узнать о ней побольше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000102,
					"content": "Чем занимаешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "#Ох, привет, путешественни{F#ца}{M#к}! Тебя тоже привёл в библиотеку интерес к мондштадтским романтическим песням?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000104,
					"content": "Слова на бумаге можно прочитать в любое время, но история, которая разворачивается вокруг нас, живёт лишь одно мгновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000105,
					"content": "У жителей Мондштадта существует множество обычаев для весёлого и романтичного Праздника ветряных цветов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000106,
					"content": "Какова форма этих традиций и какова их история? Это два наиболее многообещающих и привлекающих направления для исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000107,
					"content": "#Я готовлю отчёт о своих исследованиях и полагаю, что одних письменных описаний будет недостаточно. Не мог{F#ла} бы ты сделать несколько фотопанорам этого чудесного праздника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000108,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "#Благодарю тебя за помощь в проведении исследования, путешественни{F#ца}{M#к}. Я обязательно упомяну твоё имя в сносках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000113,
					"content": "Всё перечисленное следует задокументировать: <color=#00E1FFFF>цветочные украшения на площади с фонтаном</color>, <color=#00E1FFFF>украшенная цветами статуя Анемо Архонта</color>, а также <color=#00E1FFFF>трудолюбивая владелица цветочной лавки</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000115,
					"content": "Пожалуйста, сделай фотографии этих мест и передай их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000110,
					"content": "У тебя самого получится лучше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "Нет, нет, нет. Мне нельзя отвлекаться. Я только начал готовить черновик плана своего доклада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Саид"
				},
				{
					"id": 700000112,
					"content": "#Я рассчитываю на тебя, путешественни{F#ца}{M#к}. Кроме того, тебя будет ждать скромная компенсация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Саид"
				}
			]
		},
