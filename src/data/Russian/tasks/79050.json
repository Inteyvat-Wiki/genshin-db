			"dialogs": [
				{
					"id": 790501501,
					"content": "Ура, получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501502,
					"content": "Капельки выглядят такими счастливыми. От этого и у Паймон на душе хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501503,
					"content": "Мы сохранили плоды их дружбы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "Художник был бы рад узнать, что его друзья и посвящённая Миражу Велуриям картина в полном порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501506,
					"content": "Будем надеяться, однажды он вернётся к своим друзьям и проведает свой шедевр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501507,
					"content": "А картина-то выглядит совершенно уникально... И как у неё получается быть такой простой и в то же время такой великолепной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501508,
					"content": "Но что более важно, Паймон эту картину понимает! Может, и Паймон сможет нарисовать красивую и понятную картину в таком же стиле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501509,
					"content": "Шедевры необязательно должны быть сложны для понимания.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "Угу! Если ты не против, давай эту картину сфотографируем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501512,
					"content": "Фото поможет Паймон постепенно обучиться этой технике рисования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501514,
					"content": "Если у Паймон получится нарисовать красивую картину, может, она тоже сможет привлечь Капелек, и они захотят с нами дружить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790501510,
					"content": "Паймон тоже хочет овладеть этим стилем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501504,
					"content": "Мы исполнили их желание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
