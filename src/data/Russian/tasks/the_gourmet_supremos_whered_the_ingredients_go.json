				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джули"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Отлично, эти подойдут. Спасибо! Если бы не ты, мне пришлось бы идти туда и разбираться с этими монстрами самой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 220260302,
					"content": "Если бы это случилось, я действительно не знаю, когда бы я вспомнила, что изначально я пришла сюда за тем, чтобы набрать цветков сакуры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 220260303,
					"content": "В любом случае спасибо за помощь. Пожалуйста, возьми этот куриный шашлычок с грибами. Мисс Линн научила меня готовить этот классический деликатес для искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 220260304,
					"content": "А я отнесу эти цветки сакуры Сюй Дуну. Интересно, что он придумает сварганить на этот раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джули"
				}
			]
		}
	]
