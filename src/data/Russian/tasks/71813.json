				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мастер Лу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "Да? Вам что-то нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130602,
					"content": "Мы хотели бы заказать бамбуковые украшения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Бамбуковые украшения? Это сделать я могу, но сперва позвольте поинтересоваться, для кого этот заказ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130604,
					"content": "Это из перечня Бай Вэнь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Ого... Заказ от самого павильона Лунного моря? Хорошо. Я постараюсь выполнить его в кратчайшие сроки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130606,
					"content": "Вот только в бамбуковом лесу, где я часто собирал материалы, недавно ни с того ни с сего завелось множество лесных кабанов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130607,
					"content": "Хоть проблема это и не большая, мне приходится делать порядочный крюк, чтобы обходить их и собирать бамбук...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130608,
					"content": "Если бы вы могли их прогнать, я сейчас же собрал бы бамбук и приступил к работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130609,
					"content": "Я их прогоню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "Тогда я буду ждать тебя здесь. Дай знать, как прогонишь всех кабанов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мастер Лу"
				}
			]
		},
