			"dialogs": [
				{
					"id": 718130801,
					"content": "Приветствую! Чем могу быть полезна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130802
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718130802,
					"content": "Насчёт приготовлений к реконструкции...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "Это... «Россыпь жемчуга»? Где вы её достали? Я искала эту книгу по всему Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718130804,
					"content": "Цин Чжоу переписал её для нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "Тот поэт? Похоже, слава его вполне заслужена...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718130806,
					"content": "Спасибо, что помогли мне подготовить эти вещи. Как только мастер Лу пришлёт украшения, он получит надлежащую плату за свои услуги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718130807,
					"content": "Вы правда собираетесь отстроить Нефритовый дворец?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "Да, такой план у нас есть. Но необходимо столько всего подготовить и столько всего сделать... Вряд ли получится отстроить его быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718130809,
					"content": "Не говоря уже о поиске строительных материалов... Совсем непонятно, откуда столько брать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Бай Вэнь"
				},
				{
					"id": 718130810,
					"content": "Впрочем, не бери в голову. Спасибо тебе ещё раз за помощь и прими это в качестве награды. А теперь прошу прощения, мне нужно вернуться к работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бай Вэнь"
				}
			]
		},
