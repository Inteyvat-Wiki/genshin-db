			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзи Фан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Здравствуйте! Какую книгу вы ищете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718130202,
					"content": "Мне нужна книга «Россыпь жемчуга».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "«Россыпь жемчуга»? Сейчас, к сожалению, у нас её нет. Насколько срочно она нужна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718130204,
					"content": "Планируется реконструкция Нефритового дворца...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Что? Это правда? В таком случае им потребуются надлежащие приготовления. Минутку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718130206,
					"content": "Быть может, Цин Чжоу сможет подсказать, где найти эту книгу. Он всё-таки человек начитанный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 718130207,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Если мне не изменяет память, Цин Чжоу часто останавливается на постоялом дворе «Ваншу». Можешь поискать его там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзи Фан"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
