			"dialogs": [
				{
					"id": 718130701,
					"content": "#Ты уже прогнал{F#а} лесных кабанов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130702,
					"content": "Всех до единого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Вот и славно. Я сейчас же отправлюсь собирать бамбук. Когда украшения будут готовы, я отправлю их прямо в павильон Лунного моря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "Мастер Лу"
				},
				{
					"id": 718130704,
					"content": "На таком крупном заказе получится хорошенько заработать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мастер Лу"
				}
			]
		},
