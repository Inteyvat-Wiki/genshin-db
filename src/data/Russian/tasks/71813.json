							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цин Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Какую бы рифму подобрать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130302,
					"content": "Вы знаете книгу «Россыпь жемчуга»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "«Россыпь жемчуга»? Да, эту книгу я припоминаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130304,
					"content": "Как-то раз я отправился искать вдохновения для своей поэмы о купцах, и как раз тогда набрёл на эту книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130305,
					"content": "Её глубокий смысл скрылся от меня, но некоторые истории всё-таки стали вдохновением для моего произведения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130306,
					"content": "Позволь мне вспомнить его название, секундочку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130307,
					"content": "Не знаете, где сейчас эта книга?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Ох, так вы хотите её найти? Боюсь, я не смогу подсказать вам, где искать эту книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130309,
					"content": "Но если вы торопитесь, я мог бы написать для вас копию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130310,
					"content": "Написать копию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "Текст её совсем не большой, и запомнить его не составило труда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130313,
					"content": "Более того, владелец книги ни в какую не хотел её одалживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130314,
					"content": "И поскольку поэзию понукать нельзя, я решил переписать её содержимое... Его оказалось немного, и я всё более-менее запомнил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130315,
					"content": "Это очень впечатляет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "#Пустяки, мой друг, пустяки. Но... В обмен на рукописный текст ты тоже мог{F#ла} бы кое-что для меня сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130317,
					"content": "Мне неловко признаться... Я настолько увлёкся поисками вдохновения, что совсем забыл про обед, и сейчас я смертельно голоден.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130318,
					"content": "Прошу, принеси мне порцию супа «Три вкуса», а взамен я перепишу для тебя «Россыпь жемчуга».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130319,
					"content": "К моменту твоего возвращения у меня всё должно быть готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цин Чжоу"
				},
				{
					"id": 718130311,
					"content": "По памяти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
