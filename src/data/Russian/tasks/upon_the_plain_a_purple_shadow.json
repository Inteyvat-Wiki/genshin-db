					"Кагоцурубэ Иссин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370201,
					"content": "Уже много времени прошло с тех пор, как мы приплыли в Инадзуму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370202,
					"content": "Столько всего уже произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370203,
						120370204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370203,
					"content": "Как быстро время пролетело...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				},
				{
					"id": 120370205,
					"content": "Ага. Мы точно продвинулись в нашем путешествии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370206,
					"content": "Куда мы сегодня направимся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370207,
					"content": "Подожди.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370208
					]
				},
				{
					"id": 120370208,
					"content": "А? Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370209,
						120370210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370209,
					"content": "Осторожно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370210,
					"content": "Кто-то идёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370204,
					"content": "...а сколько воспоминаний.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				}
			]
		},
		{
			"id": 1203704,
			"completionStepIds": [
				1203704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203704",
							"2"
						],
						"stepId": 1203704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кагоцурубэ Иссин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "А? Так у тебя нет Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "Кагоцурубэ Иссин"
				},
				{
					"id": 120370402,
					"content": "Кажется, я обознался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "Кагоцурубэ Иссин"
				},
				{
					"id": 120370403,
					"content": "Ты хотя бы присмотрись, а потом уже на людей бросайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370404,
					"content": "Нет, не так... Кого бы ты ни искал, нельзя вот так просто атаковать людей! Это опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370405,
					"content": "Вы встречали человека по имени Каэдэхара Кадзуха?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "Кагоцурубэ Иссин"
				},
				{
					"id": 120370406,
					"content": "Он, как и ты, носит одноручный меч. Ещё говорят, что у него Анемо Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "Кагоцурубэ Иссин"
				},
				{
					"id": 120370407,
					"content": "А зачем он тебе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "Тебя это не касается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "Кагоцурубэ Иссин"
				},
				{
					"id": 120370409,
					"content": "Неважно. Раз ты не знаешь, то и разговаривать нам не о чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "Кагоцурубэ Иссин"
				},
				{
					"id": 120370410,
					"content": "Да что с ним такое! Помахал своим странным мечом, ничего не объяснил и даже не извинился. Сумасшедший какой-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370411,
					"content": "Вот уж точно мы ему ничего о Кадзухе не расскажем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370412,
					"content": "Именно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "Да ведь? Хотя Паймон думает, что, если бы он сошёлся с Кадзухой в честной схватке, ничего бы ему не светило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370416,
					"content": "Но на всякий случай нам нужно поскорее рассказать обо всём Кадзухе. Пусть он держит ухо востро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370417,
					"content": "#Я тут подумал{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "#А? О чём подумал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370419,
					"content": "У него с Кадзухой, наверное, какая-то особая связь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "Особая связь? Хочешь сказать, что они знакомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370421,
					"content": "Ну, у меня такое ощущение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "Хм... Да, есть немного... Но всё-таки большинство людей выглядят похоже, когда дерутся. Это ничего особо не доказывает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370424,
					"content": "В любом случае давай предупредим Кадзуху, а то как бы он в беду не попал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370425,
					"content": "Паймон слышала, что Южный Крест сейчас пополняет запасы на острове Рито. Давай его там поищем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370422,
					"content": "...что их стили боя похожи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "Просто проблеск сообразительности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "Эй, не надо грубить. Паймон всегда очень сообразительная!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1203705,
			"completionStepIds": [
				1203705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203705",
							"2"
						],
						"stepId": 1203705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "Эй, привет! Ты не знаешь, где Кадзуха?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370502,
					"content": "Вы тоже Кадзуху ищете? Видимо, он и правда что-то выдающееся сделал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370503,
					"content": "Тоже?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Ха-ха-ха! Мы причалили за припасами на маленькой лодке. Только сошли на берег, так чуть ли не все инадзумцы сбежались расспрашивать нас о Кадзухе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370505,
					"content": "Если это из-за той битвы на побережье Надзути, то Бэй Доу там тоже себя хорошо показала, но что-то не вижу, чтобы она так популярна была!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370506,
					"content": "Его присутствие на корабле даже не особо ощущается. Иногда он не слушается приказов капитана, но ей всё равно. Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370507,
					"content": "Так, значит, ты не знаешь, что он такого сделал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370508,
					"content": "Я слышал, что он будто бы остановил Мусо но хитотати сёгуна Райдэн или что-то в этом духе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370509,
					"content": "Это правда так круто, как все говорят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370510,
					"content": "Это как когда Бэй Доу одолела Хай Шаня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "А! Ну с таким объяснением я сразу всё понял. Ха-ха-ха! Тогда его новая слава заслужена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370512,
					"content": "Его уже увели стражники комиссии Тэнрё. Сказали, им надо обсудить с ним что-то важное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370513,
					"content": "Сначала мне показалось, что его арестовать хотят... Но они так дружелюбно к нему относились. Похоже, они его очень уважают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370514,
					"content": "Ещё недавно подобное было бы сложно представить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370515,
					"content": "Может, это жест доброй воли сёгуната.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Спасибо тебе! Мы тогда пойдём и наведаемся в комиссию Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370518,
					"content": "Угу. А я останусь здесь и буду отгонять зевак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чао"
				},
				{
					"id": 120370516,
					"content": "Всё-таки отношение сёгуна Райдэн изменилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
