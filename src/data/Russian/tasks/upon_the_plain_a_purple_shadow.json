			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#О, это ты, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370602,
					"content": "Приветствую. А мы только что беседовали об отмене Охоты на Глаза Бога. Раз вы пришли, то прошу присоединиться к нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370603,
					"content": "Мы пригласили господина Каэдэхару, чтобы выразить дружеское отношение сёгуната.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370604,
					"content": "Именно благодаря вашим усилиям мы сейчас находимся в таком хорошем положении. Также у меня появилась возможность исправить ошибки, которые совершил мой клан, и за это я очень благодарен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370605,
					"content": "Всемогущий сёгун работает во всех сферах, чтобы смягчить противоречия, которые накопились в прошлом или вовсе их разрешить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370606,
					"content": "Трикомиссия предложила воспользоваться этой возможностью, чтобы восстановить репутацию клана Каэдэхара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370607,
					"content": "#Полагаю, ты {F#осведомлена}{M#осведомлён} о том, что произошло с кланом Каэдэхара?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370608,
					"content": "Кое-что мне известно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Если кратко, то в прошлом при сёгунате служили оружейники, передававшие мастерство, унаследованное от сёгуна, из поколения в поколение. Клан Каэдэхара был среди них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370611,
					"content": "Но однажды часть ремесленников сбежала в Снежную, кланы Каэдэхара и Камисато обвинили в недосмотре, и они попали в опалу. Им пришлось пережить тяжёлые времена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370612,
					"content": "Но позже мы узнали, что за всем стояли Фатуи. Недопустимо и несправедливо возлагать всю вину за произошедшее на кланы Камисато и Каэдэхара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370613,
					"content": "А сейчас господин Каэдэхара снова оказал Инадзуме большую услугу. Сёгун считает, что он достоин не только награды за свои заслуги, но и компенсации за чрезмерное наказание его клана в прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370614,
					"content": "Но чтобы избежать дальнейшего притеснения кузнечных кланов со стороны Фатуи, мы решили не обнародовать результаты расследования этого дела. Думаю, вы отнесётесь к этому с понимаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370615,
					"content": "Это большая честь. Я рад, что всемогущий сёгун и сёгунат оказали мне благоволение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370616,
					"content": "Однако... Буду ли я прав, если предположу, что это внимание не просто так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370617,
					"content": "Уверяю тебя, что это совсем не так. Мы лишь хотим исправить прошлую несправедливость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370618,
					"content": "Когда репутация и позиция клана Каэдэхара будет восстановлена, твоя семья сможет возродить оружейное дело, а тебе больше не придётся скитаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370619,
					"content": "При покровительстве сёгуна и полной поддержке сёгуната ты сможешь спокойно и безбедно жить в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370620,
					"content": "Боюсь, я уже привык к ветрам и штормам, мне не придётся по нраву жизнь в стенах величественного особняка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370621,
					"content": "Но мои предки гордились фамилией Каэдэхара и мастерством ковки, которое они передавали по наследству. На мне лежит ответственность перед кланом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370622,
					"content": "Кажется, тебя одолевают сомнения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370623,
					"content": "Если ты примешь это предложение, я думаю, что клеветнические слухи, которые ходят в народе, затихнут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370624,
					"content": "Клеветнические слухи? Да мы всю дорогу только хорошее о нём и слышим. Мы уж подумали, что приехал какой-то другой Каэдэхара Кадзуха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370625,
					"content": "Для некоторых Мусо но хитотати - это то, что невозможно победить. Они не могут принять то, что господин Каэдэхара действительно отразил удар сёгуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370626,
					"content": "Тогда нашлись свидетели, которые утверждали, что господин Каэдэхара кроме Анемо использовал ещё и Электро. Отсюда поползли слухи, что он использовал Глаз Порчи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370627,
					"content": "А? Но ведь тот, кто использует Глаз Порчи, стремительно стареет, а Кадзуха выглядит нормально...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370628,
					"content": "Да. Но для некоторых людей мысль, что один человек может использовать сразу два элемента, даже более немыслима.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370629,
					"content": "И подобных слухов было много. Мне совсем не по душе быть объектом пересудов, будь то популярность или порицание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370630,
					"content": "Но, возможно, если сёгунат публично меня поддержит, то буря утихнет быстрее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370631,
					"content": "Именно поэтому тебе стоит подумать об этом, ведь это благоприятно скажется на всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370632,
					"content": "Хм. Пожалуйста, дайте мне время это обдумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370633,
					"content": "Оставим наш разговор на потом. А что вас сюда привело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370634,
					"content": "Ой, мы чуть не забыли самое главное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370635,
					"content": "Вы рассказываете Каэдэхаре Кадзухе о нападении...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "Зачем такой опасный человек меня разыскивает?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370637,
					"content": "У тебя есть брат или сестра?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "Нет. Я в растерянности, как и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370640,
					"content": "Навыкам боевых искусств я выучился в своей семье, и изначально они использовались для испытания новых мечей. Мы много тренировались, чтобы отточить каждое движение и справедливо оценить качество клинка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370641,
					"content": "Со временем из этих техник сформировалось что-то вроде искусства фехтования клана Каэдэхара, предназначенное для проверки мечей, но с полным набором приёмов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370642,
					"content": "Эти приёмы сильно отличаются от более практичных, которыми пользуются в бою самураи. Сложно представить, что схожесть, о которой вы говорите, - просто совпадение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370643,
					"content": "Поэтому будь осторожен! Этот человек совсем ненормальный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120370644,
					"content": "Да. Похоже, он очень агрессивен. Тот, кто станет его целью, рискует получить травму, или того хуже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370645,
					"content": "В таком случае я немедленно отправлю людей на поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370646,
					"content": "Спасибо. Меня теперь разбирает любопытство из-за этого дела. И мне как раз нужно немного времени, чтобы обдумать ваше предложение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370647,
					"content": "#Я пойду с {M#путешественником}{F#путешественницей} на поиски нападавшего, а потом, как вернусь, дам вам чёткий ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370648,
					"content": "Хорошо, берегите себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 120370649,
					"content": "Идём. Надо найти этого нападавшего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 120370638,
					"content": "Кто-то учился с тобой у того же мастера?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "Я не помню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
