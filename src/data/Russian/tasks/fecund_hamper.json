			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аннетт"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736800101,
					"content": "Здравствуйте! Добро пожаловать на Праздник вина, да благословит вас Барбатос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800102
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800102,
					"content": "#Эй, {NICKNAME}, смотри. Доска объявлений, а на ней столько бумажек! Может, и для нас найдётся поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736800103,
					"content": "Хе-хе, это не поручения, а подсказки, чтобы искать бочонки изобилия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800104
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800104,
					"content": "Что ещё за «бочонки изобилия»? Это сокровища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736800105,
					"content": "Да, можно и так сказать. Наверное, вы впервые на Празднике вина. Если хотите, давайте я о нём расскажу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800106,
						736800107
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800106,
					"content": "Раз уж Паймон так интересно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				},
				{
					"id": 736800108,
					"content": "Хорошо. Если говорить простыми словами, бочонки изобилия - это подарки, которые жители Мондштадта готовят удачливым чужакам в честь Праздника вина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800109
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800109,
					"content": "Потому что Праздник вина - это не только праздник возвращения Барбатоса, но и день, когда люди делятся радостью от богатого урожая и вспоминают хорошие времена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800110
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800110,
					"content": "Каждый кладёт свой подарок в деревянный бочонок и прячет его в каком-то значимом для себя месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800111
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800111,
					"content": "Затем даритель оставляет подсказку о том, где искать подарок, и его получает тот счастливчик, который первым придёт на место и найдёт бочонок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800112
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800112,
					"content": "Ещё в бочонке каждый даритель оставляет послание тому, кто найдёт его подарок. Эти искренние пожелания часто имеют даже большую ценность, чем сам подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800113
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800113,
					"content": "Звучит очень интересно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736800114,
					"content": "Ну что, попробуете отыскать бочонки изобилия? Если вы знакомы с обычаями Мондштадта, легко догадаетесь, куда ведут подсказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800115
					],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800115,
					"content": "#{NICKNAME}, давай попробуем! Вдруг мы найдём подарок от кого-нибудь из наших знакомых!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736800116,
					"content": "Удачи! Счастливого Праздника вина!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аннетт"
				},
				{
					"id": 736800107,
					"content": "Давай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				}
			]
		}
	]
}