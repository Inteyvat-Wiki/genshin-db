					"Раеф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330301,
					"content": "#Путешественни{F#ца}{M#к}! Ты всё {F#принесла}{M#принёс}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Раеф"
				}
			]
		},
		{
			"id": 7323304,
			"completionStepIds": [
				7323307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323307",
							"2"
						],
						"stepId": 7323307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Раеф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "#Всё здесь! Большое спасибо, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330402,
					"content": "Ты точно не собрался открывать цветочный магазин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "Ну... Я хотел купить сразу побольше, чтобы лишний раз в магазин не бегать, понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330405,
					"content": "Ладно, иди отдохни. Я пока посажу семена, удобрю их и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330406,
					"content": "Раеф начинает работу...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "Вот и всё! Теперь Нермин остаётся лишь поливать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330408,
					"content": "#Путешественни{F#ца}{M#к}, можно тебя попросить помочь отнести ей цветочный горшок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330409,
					"content": "Почему ты сам не пойдёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "Мне нужно охранять дорогу. Если привезут продукты или другие товары, понадобится больше людей из деревни, чтобы забрать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330411,
					"content": "Ты же знаешь, если мы запоздаем, товары испортятся из-за палящего солнца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330412,
					"content": "Пожалуйста, помоги мне. Нермин живёт неподалёку отсюда. Нужно просто отнести ей цветочный горшок. Остальное я сам как-нибудь ей доставлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330403,
					"content": "Зачем тебе столько вещей?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
