			"trigger": {
				"objectNames": [
					"Азалай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "Ха, значит, всё-таки была ещё одна партия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "Азалай"
				},
				{
					"id": 732330202,
					"content": "Насчёт покупок Раефа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "А, ты про вещи, которые он у меня заказал? Тебе повезло! Они как раз в новой поставке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "Азалай"
				},
				{
					"id": 732330204,
					"content": "Должен заметить, его заказ довольно большой. Ты отнесёшь его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "Азалай"
				},
				{
					"id": 732330205,
					"content": "Он тяжёлый?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "Помимо горшка он заказал множество семян, удобрения и другие предметы для садоводства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "Азалай"
				},
				{
					"id": 732330208,
					"content": "Всё вместе весит довольно много. Ты точно сможешь всё унести?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "Азалай"
				},
				{
					"id": 732330209,
					"content": "Я справлюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "Вот как... Понятно. Я всё упакую. Спасибо за помощь, кстати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Азалай"
				},
				{
					"id": 732330210,
					"content": "#Я уже согласил{M#ся}{F#ась} помочь, так что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "Сколько он заказал?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
			"id": 7323303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
