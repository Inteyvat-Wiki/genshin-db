			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Раеф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "Ты уже здесь! Большое спасибо. Как дела у Нермин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330602,
					"content": "Она волнуется, что не сможет позаботиться о цветах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Что ж... Я помогу ей. И если не получится, спросим у кого-нибудь совета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330604,
					"content": "И даже если это не поможет... Найду что-нибудь, за чем будет легче ухаживать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330608,
					"content": "В общем, спасибо за помощь. Пожалуйста, возьми это в награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330609,
					"content": "Я доставлю остальные вещи позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330610,
					"content": "Постой. Почему к инструментам не приложена инструкция? О нет. Я же совсем не знаю, как ими пользоваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330605,
					"content": "Ты раньше никогда не отправлял ей цветы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Отправлял, но только уже выращенные. К тому времени, как они прибывали в деревню, они почти все увядали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Раеф"
				},
				{
					"id": 732330607,
					"content": "Поэтому я решил подарить ей только что посаженные цветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Раеф"
				}
			]
		},
