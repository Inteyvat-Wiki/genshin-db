			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нермин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "Внутри слышится какой-то шорох...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "Привет! Вам чем-нибудь помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 732330503,
					"content": "#Я {F#принесла}{M#принёс} цветочный горшок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "Это... от Раефа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 732330505,
					"content": "#Это цветок? Правда? Спасибо, что {F#принесла}{M#принёс} его сюда! Мне очень нравится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 732330506,
					"content": "Но... Смогу ли я вырастить эти цветы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 732330507,
					"content": "Ты первый раз выращиваешь цветы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "Нет. Просто... Я не очень хорошо забочусь о растениях. Все предыдущие завяли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 732330509,
					"content": "А эти цветы наверняка ещё более чувствительные. Я не смогу их вырастить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 732330510,
					"content": "Нет. Нет. Нельзя... Раз цветы уже здесь, я должна позаботиться о них!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "Нермин"
				},
				{
					"id": 732330511,
					"content": "Может, бабушка Кульсум мне поможет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нермин"
				}
			]
		},
		{
			"id": 7323306,
			"completionStepIds": [
				7323306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
