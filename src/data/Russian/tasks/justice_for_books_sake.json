					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "Книжный магазин «Ваньвэнь»... Здесь жители Ли Юэ покупают книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000202,
					"content": "Мы должны узнать, есть ли у них посвящённый Ли Юэ выпуск «Путеводителя по Тейвату»! Это очень интересно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзи Фан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "Смотри, листай сколько угодно. Покупать необязательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000302,
					"content": "Мы ищем посвящённый Ли Юэ выпуск «Путеводителя по Тейвату». У вас он есть в наличии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000303,
					"content": "Простите. Мы уже давно не заказываем этот путеводитель. Очень плохо продаётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000304,
					"content": "Эх... Выпуск про Мондштадт был таким интересным... Какая жалость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000305,
					"content": "Дело в том, что это не совсем путеводитель. В книге слишком много авторской отсебятины, совершенно бесполезной для путешественников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000306,
					"content": "Мне удалось продать всего несколько экземпляров, но их потом вернули недовольные покупатели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000307,
					"content": "Авторский стиль абсолютно невыносим...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "Жаль. Выпуск о Мондштадте - это всё-таки неплохие путевые заметки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000310,
					"content": "Но в этом магазине вы их не найдёте. Можете посмотреть у Чана Девятого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000311,
					"content": "У Чана Девятого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000312,
					"content": "Любитель старинных книг, который живёт в деревне Цинцэ. Он тот ещё брюзга, но о книгах поговорить любит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000313,
					"content": "Он был нашим постоянным покупателем, когда жил в Ли Юэ. Я до сих пор иногда отправляю ему редкие книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000324,
					"content": "Добраться до него будет непросто. Двигайся в сторону горы, что рядом с деревней Цинцэ, а затем на самый верх по деревянной лестнице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "Цзи Фан"
				},
				{
					"id": 120000314,
					"content": "Любитель старинных книг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000315,
					"content": "Возможно, в его коллекции найдётся и шестой том «Легенды о разбитой алебарде»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000316,
					"content": "Кто ты такой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "Но где же мои манеры? Прошу прощения, меня зовут Син Цю, я скромный ценитель литературы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000319,
					"content": "Мы оба ищем утерянные книги. Почему бы нам не направиться к Чану Девятому вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000320,
					"content": "Почему бы и нет? Укажи нам путь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "С удовольствием, любители книжек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000322,
					"content": "#Не думал{F#а}, что это так далеко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "Рекомендую наслаждаться природой и получать удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000317,
					"content": "Нельзя вот так подкрадываться к людям!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "В некоторых местах он словно подстрекает нарушить закон, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чан Девятый"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "*Вздыхает*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000502,
					"content": "Прошу прощения, вы Чан Девятый?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "Ага. Что вам нужно? Выкладывайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000504,
					"content": "Мы слышали, что у вас большая коллекция редких книг. Мы хотели бы позаимствовать выпуск «Путеводителя по Тейвату», посвящённый Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000505,
					"content": "*Хрипит* Как же мне надоели эти разговоры о книгах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000506,
					"content": "После того как запечатали Разлом, для горнодобывающего предприятия моей семьи наступили не лучшие времена. А затем вмешались Фатуи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000507,
					"content": "Чтобы выплатить долги, мне пришлось заложить моё собрание книг. Всё до последней книжки! Ты хоть представляешь, что это для меня значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000508,
					"content": "...Грустишь, потому что нечего почитать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "Нет! Я потратил всю жизнь на эту коллекцию! А теперь всё пропало! ПРОПАЛО!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000511,
					"content": "Ах... Какой смысл жаловаться? Ты всё равно не сможешь понять. Остаётся только надеяться, что мне хватит денег для выкупа всей коллекции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000512,
					"content": "Если тебе больше нечего сказать, то разговор окончен. Давай, до свидания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000513,
					"content": "Неужели шестой том «Легенды о разбитой алебарде» вы тоже заложили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000514,
					"content": "Давно я не слышал этого названия. У тебя хороший вкус, мой мальчик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000515,
					"content": "А чем тебе не нравится наш вкус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000516,
					"content": "Этот шедевральный труд определил литературный стиль целой эпохи. Но первая публикация осталась практически незамеченной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000517,
					"content": "Именно эта книга заложила основы целого жанра произведений о странствующем рыцаре и вдохновила многих подражателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000518,
					"content": "Оригинальные экземпляры можно пересчитать по пальцам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000519,
					"content": "В дальнейшие издания шестой том решили не включать. Вероятно посчитали, что он плохо встраивается в общую канву повествования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000520,
					"content": "Верно! Шестой том настолько редкий, что у меня просто рука не поднялась заложить его вместе с остальной коллекцией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000521,
					"content": "Вы хотите сказать, что книга по-прежнему у вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000522,
					"content": "Да. Это моё последнее сокровище.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000523,
					"content": "Чан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000524,
					"content": "А тебе хватает храбрости заставлять нас ждать. Ты собираешься продавать кор ляпис или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000525,
					"content": "Не стоит злить Маоцай Гуна, если тебе не нужны проблемы с Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000526,
					"content": "Ах! Снова ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000527,
					"content": "Ты же понимаешь, что я не могу дать тебе такую цену. Мне нужно выкупить коллекцию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000528,
					"content": "Решать тебе. А есть ты книжки будешь, что ли? Или тебя прямо вместе с книжками сразу закопать в землю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000529,
					"content": "Ах ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000530,
					"content": "Эй, полегче! Почтенный господин сам вправе решить, заключать ему сделку или нет. Не надо на него давить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000531,
					"content": "А вы кто такие? Не суйте нос не в своё дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000532,
					"content": "За почтенного господина заступился Син Цю, последователь школы Гухуа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000533,
					"content": "Ха-ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000534,
					"content": "Школа Гухуа! Вы только послушайте этого клоуна! Он думает, что он мастер Гухуа... Му-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000535,
					"content": "Я думал, что все старички, практикующие Гухуа, уже давно вымерли! Ты думаешь, что ты один из них?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000536,
					"content": "Правосудие должно быть беспристрастно. Я всего лишь тот, кто делает правильные вещи. А ты? Если ты служишь злу, значит ты сам являешься злом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000537,
					"content": "Ах ты... Ты пожалеешь, что перешёл мне дорогу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000538,
					"content": "А ты, Чан, продашь весь кор ляпис! Хочешь ты того или нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000539,
					"content": "Эх... Стервятники уже кружатся над поверженным львом. Мои дни сочтены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000540,
					"content": "Вернёмся к разговору о книге. Можно её одолжить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000541,
					"content": "Эм... Не самый подходящий момент.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "Эх, уже нет никакой разницы. Раз уж ты заступился за меня, забирай книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000544,
					"content": "Три долгих года я ждал этого дня! Мою благодарность невозможно передать словами. Я, Син Цю, не забуду проявленную вами щедрость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000545,
					"content": "Ладно, ладно. Не забудь вернуть её, когда прочитаешь. От юных последователей Гухуа всякого можно ожидать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 120000546,
					"content": "Эй! И ты вот так запросто уйдёшь? У нас ещё так много вопросов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000542,
					"content": "Нужно правильно оценивать обстановку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "...Скучаешь, потому что нечего почитать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
			"completionStepIds": [
				1200006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200006",
							"2"
						],
						"stepId": 1200006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Цю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "Настал твой звёздный час, да? Паймон правильно всё поняла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000602,
					"content": "Интересно. Вот это поворот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000603,
					"content": "Эй! Паймон с тобой разговаривает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000604,
					"content": "Неспроста эта книжка так высоко ценится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000608,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000605,
					"content": "Этот мужчина вёл себя так, словно он большой начальник!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "Возможно. Как они могут так обращаться с Чаном Девятым? Это просто грабёж, требовать за руду такую низкую цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000609,
					"content": "Мы обязательно должны помочь ему.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "Я с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000613,
					"content": "Значит, теперь ты нас слушаешь, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120000614,
					"content": "Я взял эту книгу, чтобы Чан Девятый не смог её заложить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000615,
					"content": "Я обязательно верну её, как я и обещал. Это вопрос чести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000616,
					"content": "Книга будет храниться у меня, пока я не смогу выкупить всю остальную коллекцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000617,
					"content": "И у тебя есть план?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "Конечно, есть. Предварительный. Осталось продумать все детали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000620,
					"content": "Мне нужно подумать. Это не займёт много времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000621,
					"content": "Ты всё ещё здесь? Это что, всего лишь игра для тебя? Ты думаешь, что никому не грозит реальная опасность?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000622,
					"content": "У вашей школы нет ни людей, ни особых талантов... Но храбрости вам не занимать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000623,
					"content": "Как вы там называетесь? Гухуа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000624,
					"content": "Древняя мудрость гласит: «Трясущая дуб букашка переоценивает свою силу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000625,
					"content": "Прекрати паясничать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000626,
					"content": "Прошу тебя, покинь это место. Я не потерплю посягательств на честную торговлю. Чан Девятый - благородный господин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000627,
					"content": "Это так мило, что ты хочешь защитить старика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000628,
					"content": "Жаль, но у тебя ничего не выйдет, малыш. Со мной мои приятели из Фатуи! Твой Хугуа тебе не поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000629,
					"content": "Пусть я и молод, но я не собираюсь убегать от опасности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000630,
					"content": "Тогда придётся преподать тебе урок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120000618,
					"content": "Кажется, что у тебя нет конкретного плана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "Поиски «Путеводителя по Тейвату» отменяются?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "Вы оставите поиски книги так легко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120000606,
					"content": "Похоже, он работает на Маоцай Гуна. Что думаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
		{
			"id": 1200010,
			"completionStepIds": [
				1200010
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200010",
							"2"
						],
						"stepId": 1200010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Цю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120001001,
					"content": "Я думал, у тебя обычное нефритовое украшение, а не Глаз Бога!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120001002,
					"content": "Сегодня победа за тобой! Но мы ещё не закончили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "Чан Ху"
				},
				{
					"id": 120001022,
					"content": "Увы, они едва ли извлекут урок из случившегося.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001003,
					"content": "Так значит у тебя есть Глаз Бога!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "Да, но я стараюсь как можно реже его использовать. Это было бы нечестно по отношению к моим врагам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001008,
					"content": "Сейчас они ушли, но будьте уверены: скоро они вернутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120001009,
					"content": "Я не допущу несправедливого отношения к тем, кто помог мне. Дела можно вести и честным, и нечестным путём, и я займусь тем, чтобы этот вопрос решился удовлетворительно для всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001010,
					"content": "Обычно Фатуи не принимают участия в подобных конфликтах. Но наглый тон их мальчика на побегушках намекает, что их слова не безосновательны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001011,
					"content": "Здесь должен быть замешан тайный заговор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001012,
					"content": "Он упоминал Маоцай Гуна. Мне знакомо это имя... У него есть богатый дом в Ли Юэ. Предлагаю вам двоим заняться расследованием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001013,
					"content": "Хорошо... А чем займёшься ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120001014,
					"content": "Я? У меня есть другие дела. Посмотрим... Давайте встретимся на террасе Юйцзин в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001015,
					"content": "Какие ещё у тебя дела? Ты уверен, что не злоупотребляешь нашей добротой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120001016,
					"content": "Ничего себе... Вот это поворот! Эта глава просто... невероятна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001017,
					"content": "Аргх! Как же он меня бесит! Так и хочется его стукнуть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120001018,
					"content": "Сначала давайте поможем Чану Девятому.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "Пф, ну ладно! Но сначала надо придумать ему кличку, потому что он меня БЕСИТ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120001021,
					"content": "С этого момента я буду называть его... книжным червём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120001019,
					"content": "Отомстить никогда не поздно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "Хм, а эта школа Гухуа не так уж и проста!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "Н-нет, вы неправильно поняли. Этот тип, конечно, сквернословит, но то, что он сказал о школе Гухуа, ну... Отчасти он всё же прав.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120001007,
					"content": "Я пытаюсь вернуть школе Гухуа былую славу, но эта задача не из лёгких.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Син Цю"
				}
			]
		},
