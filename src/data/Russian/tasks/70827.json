					"nextDialogs": [
						708270105
					],
					"speakerTitle": "Рыбка"
				},
				{
					"id": 708270105,
					"content": "#Паймон обязана вмешаться, голод - это так ужасно... {NICKNAME}, у нас есть лишнее мясо? Давай дадим ей кусочек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
