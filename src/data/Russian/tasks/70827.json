				{
					"id": 708270101,
					"content": "...Гав?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270102
					],
					"speakerTitle": "Рыбка"
				},
				{
					"id": 708270102,
					"content": "#Э? {NICKNAME}, смотри, собачка явно ужасно проголодалась...",
