				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш",
					"Маркозов",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Эй вы, коварные люди! Я предлагаю вам немедленно покинуть это место. Наследие и секреты пари не созданы для вас, и вам их не получить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733300702,
					"content": "Пари? Пари! Просто потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Маркозов"
				},
				{
					"id": 733300703,
					"content": "#А! Ещё здесь {M#юный герой}{F#юная героиня} и {M#его}{F#её}... питомец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Маркозов"
				},
				{
					"id": 733300704,
					"content": "#Эй! Следи за языком! Я {M#его}{F#её} лучший друг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733300705,
					"content": "Друг... Ну конечно! «Лучший друг»... Так красиво звучит. С детства мечтал, чтобы у меня был «лучший друг»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Маркозов"
				},
				{
					"id": 733300706,
					"content": "#{M#Юный герой}{F#Юная героиня}, вам ведь не нужен ещё один лучший друг?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Маркозов"
				},
				{
					"id": 733300707,
					"content": "О чём ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "Я хочу сказать... Не слишком справедливо, если у вас будет двое лучших друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Маркозов"
				},
				{
					"id": 733300711,
					"content": "Подобное неравенство непростительно... Поэтому будьте добры, передайте мне пари. А как я с ней буду обращаться... не ваша забота. Гарантирую, что она реализует весь свой потенциал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Маркозов"
				},
				{
					"id": 733300712,
					"content": "Заносчивый болван...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733300713,
					"content": "Доводов разума он не понимает, его не убедить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733300714,
					"content": "#Нам необязательно убеждать его словами... {M#Мой мудрый}{F#Моя мудрая} яснапати, ты ведь понимаешь, о чём я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733300715,
					"content": "О, Паймон поняла! Соруш хочет, чтобы мы его проучили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733300716,
					"content": "Пф! Тише, Белая Болталка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733300708,
					"content": "#Я бы не {M#отказался}{F#отказалась}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "Ни за что! Твоим лучшим другом может быть только Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}