			"dialogs": [
				{
					"id": 737080201,
					"content": "Похоже, сообщение было успешно передано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080202,
					"content": "Наконец-то мы снова встретились, Золотой метеор и Серебряный спутник.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080203,
					"content": "Ваш сияющий вид дарит мне прекрасное чувство, будто время остановилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080204,
					"content": "Давно не виделись, Хания!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "Так это правда вы, Хания и Бам-бам-шапочка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080206,
					"content": "Неудивительно, что у Паймон возникло странное чувство узнавания... Значит, Паймон и Бам-бам-шапочка всё ещё понимают друг друга!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737080212,
					"content": "Я представляла множество вариантов нашей встречи - например, можно было устроить пышный банкет или придумать особую церемонию приветствия, чтобы сделать вам огромный сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080213,
					"content": "Но всё это казалось слишком формальным. Вы всегда заняты, и долгие мероприятия могли бы доставить хлопоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080214,
					"content": "К тому же наши друзья-плесенники теперь предпочитают спокойную обстановку. Так что давайте проведём встречу в непринуждённой и естественной атмосфере.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080215,
					"content": "Верно-верно! Не зря ты, Хания, читала те труды. Спокойный настрой полезен для жизни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080216,
					"content": "Непринуждённая беседа приносит больше всего радости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "Огнерадость"
				},
				{
					"id": 737080218,
					"content": "Здесь и госпожа Соука, и Огнерадость, и... А это кто?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080219,
					"content": "Это моя подруга-плесенник Танцовщица ветра. Вы с Бам-бам-шапочкой тогда в 1/16 финала нас мгновенно победили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080220,
					"content": "Хе-хе, у тебя отличная память!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080221,
					"content": "Кажется, припоминаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "Короче говоря, как видите, дорогие покровители, нам больше не нужно договариваться о времени и месте следующей встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080224,
					"content": "Хания и я купили этот торговый район и превратили его в постоянно действующий Парк плесенников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080225,
					"content": "Подожди, ты хочешь сказать, что все эти сооружения здесь не для аренды под новую настольную игру, а...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080226,
					"content": "Совершенно верно. Отныне мы будем постоянно жить в гавани Бейда, продвигать настольные игры с плесенниками и обучать всех теории общения с животными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080227,
					"content": "Как только у вас будет свободная минутка, вы всегда можете прийти сюда и поиграть с нашими друзьями-плесенниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737080229,
					"content": "Ура! Друзья-плесенники!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "Вау! Это, это одна из самых лучших новостей за сегодня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080232,
					"content": "После первого турнира плесенников Паймон придумала столько идей для игр с Бам-бам-шапочкой! Теперь можно их потихоньку воплотить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080233,
					"content": "Кстати, содержание этого места, наверное, дорого обходится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "Не волнуйся, с морой сейчас проблем нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080235,
					"content": "За это время, помимо управления «Грибомеханикусом» и настольной игрой «Удивительный турнир плесенников» с помощью господина Бальфура...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080236,
					"content": "Мы ещё и обобщили прошлый опыт, систематизировали знания о приручении зверей и плесенников в единую теорию и даже попытались издать несколько книг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080237,
					"content": "Более того, некоторые учёные предложили мне финансовую поддержку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080238,
					"content": "Так, используя накопленные знания, я приношу пользу большему числу людей, зарабатываю мору и забочусь о моих друзьях-плесенниках. Дела идут как нельзя лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080239,
					"content": "Ого, это так круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080240,
					"content": "Паймон чувствует, что Хания уже стала серьёзным... «экспертом по теории приручения зверей», которая может справиться с любыми проблемами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080241,
					"content": "Всё благодаря руководству Соуки. Она предложила мне освоить нужные навыки, используя методы обучения студентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080242,
					"content": "Эй-эй! Только не перенимай это смирение. Я вовсе не супернаставник, так что просто поблагодари за комплимент!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080243,
					"content": "На словах всё выходит легко, но ведь были и трудности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "Конечно, я сталкивалась с трудностями, но пусть прошлое и плохое минует, не стоит вспоминать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080246,
					"content": "Больше всего я сожалею о том, что за последний год почти не выводила наших друзей-плесенников погулять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080247,
					"content": "С тех пор как я начала создавать свою теорию приручения зверей, мы почти всё время проводили в пещерах и на деревьях, живя как попало и работая над рукописями днём и ночью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080248,
					"content": "Деловая сторона жизни утомляет. А когда нужно было выполнить задачи в срок, то бывало совсем непросто. Теперь я намного лучше понимаю Соуку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080249,
					"content": "Но ведь не всё так плохо! В момент, когда заканчиваешь работу, всегда чувствуешь огромное удовлетворение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080250,
					"content": "Да, я согласна, каждое завершение работы заслуживает празднования с вкусным угощением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080251,
					"content": "Но наши друзья-плесенники не могут разделить с нами пищу. И, с их точки зрения, жизнь, наверное, казалась довольно скучной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080252,
					"content": "Если бы это продолжалось слишком долго, их душевное состояние могло пострадать, а это очень плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080253,
					"content": "А раз уж теперь у вас всё устроилось и есть постоянное жильё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080254,
					"content": "Может, мы с тобой возьмём плесенников погулять? Дадим им наиграться вдоволь, а потом вернём обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080255,
					"content": "Так вы сможете сосредоточиться на работе, а плесенники отлично повеселятся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080256,
					"content": "Отличная идея, Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "Поддерживаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080259,
					"content": "Что касается интересных мест, я чистый теоретик. Знаю о них только из книг. Когда я впервые приехала в Фонтейн, то даже заблудилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080260,
					"content": "А Хания и вовсе не знает, где в Сумеру можно весело провести время! Она всегда была поглощена работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080261,
					"content": "В прошлый раз мы долго были в Фонтейне, но маршрут был ужасно спланирован. В итоге мы так и не попали в кондитерскую, куда я мечтала зайти, и упустили шанс попробовать макароны, о которых я давно мечтала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080262,
					"content": "Кхм... Но вы же Золотой метеор и Серебряный спутник. Вы точно найдёте множество чудесных мест, чтобы удивить наших друзей-плесенников и подарить им незабываемые впечатления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080263,
					"content": "Мне нужно серьёзно подумать о выборе места!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "Подожди, возьми с собой эту маленькую фотокамеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080266,
					"content": "Хания достаёт самую обычную фотокамеру и кладёт её на голову Бам-бам-шапочки. Плесенник устойчиво удерживает фотокамеру, словно уже привык летать с подобными вещами на голове...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "Хоть на вид обычная камера, но это особенный сувенир на память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080268,
					"content": "Бам-бам-шапочка когда-то спас ребёнка одного торговца, заблудившегося в южной части чащи Апам. В благодарность торговец одарил плесенника множеством подарков, и в их числе была эта фотокамера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080269,
					"content": "Бам-бам-шапочке очень нравятся фотографии, сделанные этой фотокамерой. Так что в путешествии вы тоже сможете использовать её, чтобы сохранить воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080270,
					"content": "Я нашла специалиста по оборудованию, госпожу Элен, которая загерметизировала корпус фотокамеры. Теперь можно фотографировать во влажных местах, которые так любит Бам-бам-шапочка. И даже под водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080271,
					"content": "Иными словами, эта камера стала одним из символов почёта Бам-бам-шапочки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080272,
					"content": "Молодец, Бам-бам-шапочка!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737080275,
					"content": "#А что касается фотографий - не переживай! Паймон и {NICKNAME} эксперты! Внешний вид оборудования не важен, главное - чтобы получилось хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}, давай подготовимся и отправимся в путь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080277,
					"content": "И не забудь специальную еду для наших друзей-плесенников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080278,
					"content": "Верно, Паймон это тоже отлично помнит! Нужно взять побольше чудесного агара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080279,
					"content": "Новейшая улучшенная версия ещё вкуснее и лучше хранится. Не испортится даже в самую жару.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 737080280,
					"content": "Только не давай им слишком много за раз, переедание ни к чему хорошему не приведёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 737080281,
					"content": "Хе-хе, поняла! Кладём агар в ранец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080282,
					"content": "Теперь остаётся только отправиться в путь - и вернуться с кучей сувениров из нашего путешествия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080273,
					"content": "Так держать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "Я выберу места, которые будут и интересными, и красивыми!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "Я тоже хочу погулять с друзьями-плесенниками!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "Кажется, ты не упомянула много трудностей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "Теперь мы сможем часто видеться!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "Дружелюбная атмосфера помогла мне расслабиться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "Смутно припоминаю. Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "Точно, это Хания и Бам-бам-шапочка! Мы познакомились с ними на Турнире укротителей «Кубок лотоса нилотпала»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080210,
					"content": "Паймон помнит, что потом мы ещё встречались под Порт-Ормосом и в Кур-де-Фонтейне! Столько времени прошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Бам-бам-шапочка"
				}
			]
		},
