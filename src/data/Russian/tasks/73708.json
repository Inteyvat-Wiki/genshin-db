			"dialogs": [
				{
					"id": 737080101,
					"content": "Ой, плесенник пролетел мимо. Всё нормально?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080102,
					"content": "Вообще-то плесенники в городе - это опасно! Разве что это какой-то особый, дрессированный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080103,
					"content": "Хм, он мне кажется знакомым. Может, мы встречали этого плесенника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080104,
						737080107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080104,
					"content": "Погоди, это Бам-бам-шапочка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080105
					]
				},
				{
					"id": 737080105,
					"content": "Верно! Бам-бам-шапочка! Наш друг-плесенник, с которым мы познакомились в Сумеру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080106,
					"content": "А-а-а-а, мы так давно не виделись! Паймон хочет скорее подойти поздороваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080107,
					"content": "Особый, дрессированный?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080108
					]
				},
				{
					"id": 737080108,
					"content": "Хм... Бам-бам-шапочка? Наш друг-плесенник, с которым мы познакомились в Сумеру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080109
					],
					"speakerTitle": "Паймон"
				},
				{
