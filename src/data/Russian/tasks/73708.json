			},
			"dialogs": [
				{
					"id": 737080301,
					"content": "Уф... Наконец-то добрались!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080302,
					"content": "Путь был о-о-очень долгим, но Паймон уверена, что пик Тетикпак на территории Потомков Крон поразит наших друзей-плесенников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080303,
					"content": "У Паймон есть несколько пейзажных рисунков, по которым друзья-плесенники смогут сравнить картинку с тем, что видят перед собой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080304,
					"content": "Если они внимательно присмотрятся, сопоставят картинки с реальностью, начнут замечать мелкие детали, которые обычно ускользают от взгляда, и по-настоящему заинтересуются... значит, это место идеально подходит для более глубокого и продолжительного исследования!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080305,
					"content": "♪♫!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080306
					],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737080306,
					"content": "♫... ♩?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080307,
						737080308
					],
					"speakerTitle": "Огнерадость"
				},
				{
					"id": 737080307,
					"content": "И такой метод есть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				},
				{
					"id": 737080309,
					"content": "Хе-хе, когда у Паймон есть свободное время, она листает путеводители и изучает разные достопримечательности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080310,
					"content": "Это обязательный навык для любого хорошего гида!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080311,
					"content": "Ладно, давай позволим нашим друзьям-плесенникам самим всё оценить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737080308,
					"content": "Паймон, ты отлично разбираешься!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				}
			]
		}
	]
}