				},
				{
					"id": 718290702,
					"content": "С чего бы начать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290704
					]
				},
				{
					"id": 718290704,
					"content": "Хм... Может, бездельник поможет нам бесценным советом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290705
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290705,
					"content": "Ладно. Для начала мелко порубить мечом кусок мяса. Затем медленно превратить мясо в фарш и довести его до пастообразного состояния.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290703,
					"content": "Так... Какой первый шаг?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290704
					]
				}
			]
