				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "Давай попробуем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291402,
					"content": "Мммм... Этот вкус... Богатый и насыщенный. А текстура точно такая же, как у тофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291403,
					"content": "Выглядит оно весьма презентабельно и требует поистине первоклассного мастерства от повара. И как ведь ловко придумано, а? Мясное блюдо, которое имитирует вегетарианское. Бьюсь об заклад, многие бы захотели такое попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291404,
					"content": "Неплохо, весьма неплохо! Думаю, хозяину гостиницы это придётся по вкусу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291405,
					"content": "Вот так сюрприз! Оказывается, ты на что-то сгодился. Кто бы мог подумать, что ты запомнишь такой потрясающий рецепт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291406,
					"content": "Ха-ха-ха! Ладно, я тебе расскажу, только не смейся, пожалуйста. Я думал, что в этом рецепте зашифрованы секреты древнего искусства фехтования. Поэтому я учил его днями и ночами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291407,
					"content": "Теперь это кажется уже совсем бредовой идеей. Это всего лишь рецепт, откуда в нём возьмутся секреты фехтования?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291408,
					"content": "А зачем тебе секреты фехтования?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Чтобы найти кое-кого и восстановить справедливость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291410,
					"content": "Ха! Это был выдающийся поступок! А ты так спокойно об этом рассказываешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291411,
					"content": "Хе-хе... Я восстановил справедливость и пришёл сюда. К счастью, хозяин гостиницы позволил мне тут остановиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291412,
					"content": "Теперь я свободен от желаний. Фехтование мне больше ни к чему, а больше ничего я не умею... Ха-ха-ха, думаю, остаться здесь до конца жизни - не худший вариант.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291413,
					"content": "Ладно... Возьми этот рецепт. Если у тебя будет достаточно свободного времени, сможешь приготовить для себя. Блюдо хлопотное, но оно того стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291414,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Эм... Давай пока отложим это блюдо. Покажем его хозяину гостиницы, когда он придёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291418,
					"content": "А потом... Постой, дармоед, не так быстро. Иди сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291419,
					"content": "Тебе ещё что-то нужно? Другого рецепта у меня нет, я рассказал всё, что знал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291420,
					"content": "Ты же сам сказал, что кроме владения мечом у тебя нет других талантов. Что ж, доставай свой меч, будем рубить мясо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291421,
					"content": "Рубить мясо? Эм... Ну... Боюсь, что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291422,
					"content": "Ты быстро научишься. Сегодня нарубишь мяса, завтра приготовишь блюдо, потом другое, затем ещё одно. И вот ты уже выучил новый навык!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291423,
					"content": "Что ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291424,
					"content": "Научишься готовить несколько блюд, и мне больше не придётся тебя постоянно подкармливать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291425,
					"content": "Пошевеливайся! Если и дальше будешь канителиться, то не видать тебе завтра тефтелей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291426
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718291426,
					"content": "Постой-ка! Ты же не можешь угрожать мне голодной смертью? Ладно, ладно... порублю я мясо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291415,
					"content": "Ты останешься здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291416
					]
				},
				{
					"id": 718291416,
					"content": "Конечно! Мне всегда приятно полакомиться угощениями нашего любимого шеф-повара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291417
					],
					"speakerTitle": "Цзян Сюэ"
				}
			]
		}
	]
}