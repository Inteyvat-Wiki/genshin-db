			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Сюэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "Ого! Сегодня у нас особый гость. Обычно мы с поваром молча жуём его стряпню. Может быть, ваше присутствие оживит трапезу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290302,
					"content": "Кажется, сегодня повар чем-то сильно озадачен. Что стряслось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Сюэ"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Сюэ",
					"Улыбчивый Янь Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Тефтели получились неплохо! Они прямо тают во рту. Бульон тоже хороший, наваристый...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290402,
					"content": "Ох! Крабовая икра в мясе? Вот почему оно такое нежное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290403,
					"content": "#Путешественни{F#ца}{M#к}, попробуй, не стесняйся. Давай я тебя научу. Берёшь палочки, разламываешь тефтельку, обмакиваешь её в бульон, добавляешь немного риса и в рот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290404,
					"content": "Благодарю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Ешь досыта! Может быть, мне больше не придётся готовить на этой кухне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290410,
					"content": "Не придётся готовить на этой кухне? Кто это такое сказал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290411,
					"content": "Неужели это из-за меня? Хозяину гостиницы надоело, что ты меня постоянно кормишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290412,
					"content": "Но это несправедливо! Ведь я просто так отдавал постоялому двору свой лучший улов. Хотя бы частично это должно было покрыть мой счёт. Да и не похож хозяин гостиницы на скупердяя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290413,
					"content": "Секундочку... Лучший улов? Ты принёс пару мелких рыбёшек, да сам их потом и слопал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290414,
					"content": "Так что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290415,
					"content": "Эх... Ладно, я расскажу тебе, как обстоят дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290416,
					"content": "Вкусное, аппетитное, стильное, замысловатое, с индивидуальностью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290417,
					"content": "Ха-ха-ха... Уж не знаю, есть вообще на свете такое блюдо, которое соответствует требованиям твоего начальника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290418,
					"content": "Тебе смешно? Посмотрим, как ты запоешь, когда некому будет тебя подкармливать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290419,
					"content": "Ладно, ладно, шутки в сторону. Так вот почему ты такой напряжённый сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290420,
					"content": "Непросто расслабиться, когда твой босс ждёт от тебя кулинарного чуда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290421,
					"content": "Хм... Возможно, я могу тебе помочь. Пускай я сам и не великий кулинар, но так уж вышло, что я знаю один особенный рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290422,
					"content": "Я попробовал это блюдо, когда странствовал в дальних краях. Меня пригласили в гости к одной крупной шишке, где подавали... куриный тофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290423,
					"content": "Оно совсем не похоже на мясное блюдо. Это как нежнейший пудинг из тофу, но со вкусом мяса и трав. Редкий случай, когда мясное блюдо имитирует вегетарианское.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290424,
					"content": "Я попробовал кусочек и сразу попросил у хозяина рецепт. Но повар из меня никудышный, так что рецепт так и пылится где-то на дне сундука.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290425,
					"content": "Как же тебе удалось получить такой рецепт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Это... долгая история. Я кое-кому помог, и в знак благодарности меня пригласили на застолье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290427,
					"content": "Повар был совсем не против поделиться со мной рецептом. Он уверен, что ему хватит пальцев одной руки, чтобы пересчитать всех кулинаров, способных приготовить это блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290429,
					"content": "#В этом можешь быть уверен{F#а}! Тот повар говорил, что требуется не только кулинарное мастерство, но и умелое владение мечом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290430,
					"content": "Что это за блюдо такое, если для него нужно махать мечом? Я вот, к примеру, и ножом могу неплохо порубить мясо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290431,
					"content": "Боюсь, что у тебя доска треснет, пока ты своим ножичком будешь так мелко рубить мясо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290432,
					"content": "Чем мельче фарш, тем лучше тофу. Так мне повар сказал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290433,
					"content": "Правильная техника владения мечом - вот ключ к успеху! Сначала нужно порубить мясо на мелкие кусочки, а потом тыльной стороной меча перемолоть его в фарш.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290434,
					"content": "Постой. А какой нам прок от этого рецепта? Мечник из меня такой же плохой, как из тебя повар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290435,
					"content": "Где же нам найти умелого воина с кулинарными талантами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290436,
					"content": "Кажется, такой человек ближе, чем ты думаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290437,
					"content": "Кто? Я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "#Именно. Ну разве это не подарок судьбы? Ты хорош{F#а} и у плиты, и в бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290441,
					"content": "#Как насчёт того, чтобы дать путешественни{F#це}{M#ку} возможность попытаться приготовить это уникальное блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290442,
					"content": "Но это же задание для улыбчивого Янь Сяо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "Хозяин гостиницы ждёт от Янь Сяо новое блюдо. По большому счёту, ему должно быть всё равно, кто именно его приготовит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290444,
					"content": "Верно, шеф?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290445,
					"content": "Эм... Да! Звучит логично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290446,
					"content": "Какие ингредиенты нам понадобятся для куриного тофу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290447,
					"content": "Ничего сверхъестественного. Мясо птицы, ветчина, яйца и львиный зев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290448,
					"content": "На кухне есть запасы ветчины и птичьего мяса. А вот яйца у нас закончились, и львиного зева тоже нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290449,
					"content": "Эх, знал бы раньше, не стал бы готовить яичницу с мацутаке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290450,
					"content": "#Путешественни{F#ца}{M#к}, поможешь нам раздобыть ингредиенты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290451,
					"content": "Когда всё будет готово, мы вместе займёмся куриным тофу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290452,
					"content": "Ах, да! Конечно, я щедро вознагражу тебя за труды. Заранее благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Улыбчивый Янь Сяо"
				},
				{
					"id": 718290439,
					"content": "Готовить я люблю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "И с мечом ты умеешь обращаться. Мне довелось наблюдать тебя в деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290428,
					"content": "Должно быть, приготовить куриный тофу непросто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "А ты в этом неплохо разбираешься.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Ха-ха-ха! Немудрено научиться трапезничать со вкусом, когда тебя каждый день кормят подобными угощениями. Давай я научу тебя, как правильно есть тушёную рыбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718290407,
					"content": "А ты не будешь с нами есть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "Я? Я уже сыт по горло... Сыт по горло придирками хозяина гостиницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Улыбчивый Янь Сяо"
				}
			]
		},
