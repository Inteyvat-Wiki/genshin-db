			"dialogs": [
				{
					"id": 718291201,
					"content": "Теперь нагревай плиту! Начинаем медленно готовить мясную пасту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291202
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291202,
					"content": "Следи за пламенем. Если будет недостаточно огня, то мясо не приготовится. Если огонь будет слишком сильный, мясо потеряет свою консистенцию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291203
					],
					"speakerTitle": "Цзян Сюэ"
				},
				{
					"id": 718291203,
					"content": "Томить мясо в особом бульоне... Это блюдо точно не для бедняков.",
