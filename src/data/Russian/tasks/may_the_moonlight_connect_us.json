			"dialogs": [
				{
					"id": 760310101,
					"content": "Коломбина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310102,
					"content": "Хр-р-р... Хр-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310103,
					"content": "#О, она задремала. {NICKNAME}, давай вернёмся позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310104,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Барсук-стиляга"
				},
				{
					"id": 760310105,
					"content": "Эй, постой! Не ходи туда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310106,
					"content": "...Ох!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310107,
					"content": "Ой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Барсук-стиляга"
				},
				{
					"id": 760310109,
					"content": "Поскользнулся? Ничего, я в порядке. А? Вы тоже здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310110,
					"content": "Богиня Луны тоже чувствует боль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310111,
					"content": "Пока куувяки, которую они излучают, не отражает злого умысла, я не против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310112,
					"content": "Что случилось? Почему ты напуган?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Барсук-стиляга"
				},
				{
					"id": 760310114,
					"content": "Хм. Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310115,
					"content": "О-о-о! Ты тоже понимаешь их речь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310116,
					"content": "Луна высоко светит над Нод-Краем. Все животные, которые живут под светом куувяки, могут считаться «фамильярами Богини Луны».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310117,
					"content": "Что он говорит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310118,
					"content": "Монстры появились в его жилище, и он сначала искал Лауму, но монстры загнали его сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310119,
					"content": "Теперь понятно, почему он так напуган...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310120,
					"content": "Отвести его домой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Отведите его к Лауме. Она о нём позаботится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310122,
					"content": "Похоже, нам предстоит очередная вылазка. Только не забудь хорошо замаскироваться - мы ведь отправляемся к Детям Морозной Луны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
