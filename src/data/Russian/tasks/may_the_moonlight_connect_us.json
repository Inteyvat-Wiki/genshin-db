			"dialogs": [
				{
					"id": 760310201,
					"content": "...Да, верно. Попрошу Кунегунду принести фрукты попозже. Ей нужно отдохнуть следующие два дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310202,
					"content": "Хм, похоже, Лаума сейчас занята. Подождём немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310203,
					"content": "Много лет назад я поняла, что Голос Лунного Гимна очень важна для Детей Морозной Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310204,
					"content": "Иногда мне кажется, что их миссия даже сложнее, чем у божества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310205,
					"content": "Наконец-то она освободилась! Это наш шанс...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310206,
					"content": "Госпожа Лаума! Вам нужно взглянуть на оборонительные сооружения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Ванамо"
				},
				{
					"id": 760310207,
					"content": "Конечно. Уже иду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310208,
					"content": "Снова ушла! Ни секунды свободного времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310209,
					"content": "Давайте последуем за ними, но осторожно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
