			"dialogs": [
				{
					"id": 760310301,
					"content": "...Отлично. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310302,
					"content": "Ночью или днём, пусть лунный свет соединит нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310303,
					"content": "Хм? Это не то, что я слышала раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760310304,
					"content": "Тот человек ушёл! Быстрее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310305,
					"content": "Госпожа Лаума!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "Мацей"
				},
				{
					"id": 760310306,
					"content": "Опять?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310308,
					"content": "...Отличная работа. Я отойду ненадолго, но скоро вернусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310310,
					"content": "Всё чисто, можете выходить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310311,
					"content": "Давно ты нас заметила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310312,
					"content": "Как я могла не почувствовать Куу{RUBY#[S]Девы Луны}тар и её куувяки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310313,
					"content": "Могу я спросить, почему вы... следите за мной? Словно следите за моей работой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310314,
					"content": "Эм, насчёт этого... Прости. Мы хотели поговорить с тобой, но всё никак не находили подходящего момента... Паймон надеется, что мы тебе не создали неудобств...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760310315,
					"content": "Вот как... Понятно. Я разберусь с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760310316,
					"content": "Честно говоря, после того, как Паймон наблюдала за твоей работой весь день, ей как-то неудобно просить тебя о чём-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
