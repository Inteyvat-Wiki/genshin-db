				]
			},
			"dialogs": [
				{
					"id": 700740201,
					"content": "Так вот где мы достанем те самые «щепки, наструганные рыцарями»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740202,
					"content": "Ах! Магистр ордена! Почëтный рыцарь! Вы сегодня тоже пришли тренироваться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 700740203,
					"content": "Ну, не совсем... Но мы здесь ради одной важной цели. Думаю, это тоже считается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740204,
					"content": "Вы и так уже сильны, но всё равно стремитесь к совершенству... Пожалуйста, тренируйтесь! А я постою в сторонке, буду наблюдать и делать заметки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				}
			]
		},
