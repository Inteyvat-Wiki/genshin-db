				]
			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "Невероятно... С каких это пор хиличурлы стали такими сговорчивыми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700740902,
					"content": "Элла! Ты случайно не видела здесь Варку?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740903,
					"content": "Да, он только что сказал, что пойдёт одолжить котёл у хиличурлов... И как только хиличурлы его увидели, они тут же поспешили отдать ему котёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700740904,
					"content": "Самое странное - они почти не разговаривали. Неужели магистр ордена освоил неизвестный мне язык жестов хиличурлов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700740905,
					"content": "Не думаю, что это можно назвать общением...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "Да не в этом же дело! Где вообще сейчас Варка?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740908,
					"content": "Вон там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700740909,
					"content": "Наконец-то... Готово! Лучший напиток во всём Тейвате! Прямо сейчас в моих руках!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740910,
					"content": "Варка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "О? Вы наконец-то пришли? Хиличурлы оказались на удивление сговорчивыми, так что всё проще, чем я ожидал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740912,
					"content": "А теперь - время дегустации!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740913,
					"content": "Не пей, подожди!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "#Хм? Хочешь попробовать {M#первым}{F#первой}? Хе-хе, мечтай, малыш... Честь первого глотка принадлежит мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740915,
					"content": "Нет, я не...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "Не волнуйся! Я оставлю тебе немного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740917,
					"content": "*глыдь-глыдь* Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740918,
					"content": "Хм? Кажется, мне... плохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740919,
					"content": "Варка! Ты в порядке? Варка? Ва-а-арка-а-а-а!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740920,
					"content": "Магистр!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "Эй! Ты же победил божество, а теперь умрёшь здесь?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740923,
					"content": "О-ох... А-а-а...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740924,
					"content": "...На мгновение мне показалось, что я увидел всех прошлых Рыцарей Бореалис...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740925,
					"content": "Не знаю даже, ругать тебя за то, что так получилось...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "Дай мне переварить всё это... и напиток, и горький урок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740928,
					"content": "Вы объясняете Варке, что Диона благословлена безупречно смешивать напитки...\\nТолько в её руках странные ингредиенты превращаются в превосходные коктейли...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "Так вот оно что... Недостающий ингредиент на самом деле был благословением родниковой феи... Ха-ха, вот уж не ожидал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740930,
					"content": "Эй, не делай такое невинное лицо, будто ничего не случилось! Зачем ты нас пытался обмануть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740931,
					"content": "Извините, извините... Я действительно думал, что с этим рецептом всё в порядке, и хотел, смешав напиток, выпить его вместе с вами и всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740932,
					"content": "А сейчас... вы ведь пить уже не захотите, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740933,
					"content": "Думаю, нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "Хм... Что ж, я у вас в долгу! Что, если я угощу вас в «Хорошем охотнике», когда вернёмся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740936,
					"content": "Вот это другое дело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740937,
					"content": "На тебя легко повлиять...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "#Ой, да ладно! Ты же видел{F#а}, в каком он состоянии был после того глотка. Паймон уверена, что он уже сам всё понял!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740939,
					"content": "Эх... Пожалуй, мне некого винить, кроме самого себя, да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740940,
					"content": "Вернёмся к вопросу про твой урок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "Ха-ха! Планировал я эту историю за кружкой в таверне поведать, а придётся здесь, под открытым небом",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740943,
					"content": "...Так вы раздаёте задания всем в Мондштадте, да? Интересная идея... И мне положено какое-то задание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740944,
					"content": "Хе-хе, твоим заданием было «изменить судьбу, отражённую в чаше для гадания». Но ты с этим справился уже довольно давно - в тот самый момент, когда решил отправиться в экспедицию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Алиса"
				},
				{
					"id": 700740941,
					"content": "Почему о нём ничего не написано?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "Здесь уже речь не о смелости, а о безрассудстве.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "...или восхищаться тем, что ты ещё жив?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "Приди в себя, давай же!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "По крайней мере, не явно, словами или жестами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
