					}
				]
			},
			"dialogs": [
				{
					"id": 700740801,
					"content": "Гурр-гурр...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "Голубь"
				},
				{
					"id": 700740802,
					"content": "Есть! Перья у нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740803,
					"content": "Наконец-то! Это задание и правда оказалось сложнее, чем Паймон думала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740804,
					"content": "Осталось последнее... «Лечебный отвар, приготовленный в большом котле». Если я не ошибаюсь, он находится в ущелье Дадаупа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740805,
					"content": "Я направлюсь туда прямо сейчас. Догоните, когда сможете, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740806,
					"content": "Эй, постой! Вот это энтузиазм... Он сорвался с места быстрее, чем стая спугнутых голубей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740807,
					"content": "Классический пример, когда говорят «неудержимый как ветер»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "Да уж, выпить он не дурак!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740810,
					"content": "А? Кто здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "...Ах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740812,
					"content": "Диона? Ты что здесь делаешь? И ещё специально спряталась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740813,
					"content": "Я... я вышла собрать фрукты. Не думала, что вдруг наткнусь на этого дядьку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740814,
					"content": "Он в последнее время не отстаёт от меня, хочет, чтобы я ему снова приготовила тот коктейль... Пф, надоел уже, вот и приходится от него прятаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740815,
					"content": "О каком напитке речь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "Ну, ты же в курсе, что он недавно вернулся с частью экспедиционного отряда? Вот, и практически в первую очередь пришёл с соратниками в «Кошкин хвост» отмечать победу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740817,
					"content": "«Кошкин хвост»? Паймон думала, что они будут отмечать в штаб-квартире Ордо Фавониус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740818,
					"content": "Мне всегда казалось, что Варке больше по вкусу «Доля ангелов»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "Уф... поэтому я и сказала «практически». «Кошкин хвост» был третьим по счёту заведением - они решили обойти все таверны в городе и выпить в каждой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740820,
					"content": "...И Паймон уверена, что они повторят всё это снова, когда в следующий раз домой вернётся очередная группа их сослуживцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740821,
					"content": "Не сомневаюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "Короче говоря, я больше не могла выносить вид этих пьяных дядек! И я поставила себе цель - приготовить им самые отвратительные, тошнотворные напитки во всём Тейвате...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740823,
					"content": "Но, Диона...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "Ага, поэтому сначала я попросила Принца смешать напитки... Кто же знал, что эта пьяная компания начнёт гладить его, как только напьётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740826,
					"content": "...Так что Принц сбежал, даже не доделав коктейль. Зато он поцарапал того пьяницу-дядьку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740827,
					"content": "(А-а, так вот откуда у Варки шрам...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "И вот я там, в тёмном-тёмном подзе{RUBY#[D]таверна}мелье, сражаюсь с самыми свирепыми и жестокими чудов{RUBY#[D]Принц}ищами, которых только видел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740829,
					"content": "...Я смотрела на почти готовый напиток, в одном шаге от завершения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740830,
					"content": "В итоге я всё-таки сама доделала его...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "Ага...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740832,
					"content": "Позволь спросить из любопытства...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "Эм... Несколько щепок с одежды рыцарей, голубиные пёрышки, которые я подобрала в лесу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740835,
					"content": "И последний ингредиент, который я собиралась использовать для отрезвления... травяной отвар хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "Диона"
				},
				{
					"id": 700740836,
					"content": "Говоришь, всё это случилось вскоре после возвращения Варки, верно? Значит, выходит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740837,
					"content": "Никто ещё не рассказал ему, что...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "Ох... Быстрее, надо остановить его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740838,
					"content": "...только Диона способна смешать из этого вкусный напиток!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "...что ты туда добавила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "У тебя же не получится сделать невкусно, даже если ты захочешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "Он явно не может дождаться, когда начнётся дегустация.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
		{
