			"dialogs": [
				{
					"id": 700740401,
					"content": "Невероятно! Так вот как это делается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 700740402,
					"content": "У Паймон такое чувство, будто она слышала такие восторженные реакции уже раз сто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700740403,
					"content": "Хм... эти щепки... Форма, фактура, качество... Великолепно подойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 700740404,
					"content": "Для Паймон загадка, как ты одну щепку от другой отличаешь... Ладно, неважно, лишь бы ты был доволен. Теперь дальше - те самые «голубиные перья, обронённые в радости»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
