			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Громкий призрак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Эй, ты кто? Это мой стул! В таверне все знают, что здесь сижу я!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150102,
					"content": "Ты на острове с докладом? Или что? Нельзя садиться на чужое место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150103,
					"content": "И вообще, где моё пиво! Почему ещё не принесли? Давайте живее, а то мне скоро в ночной дозор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150104,
					"content": "Таверна? Пиво?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Ладно, место я могу и уступить! Но сначала давай выпьем и споём хором! Вот станем друзьями, тогда садись где пожелаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150107,
					"content": "Ты же знаешь песню? Йо-хо, поехали! Мы споём первую строчку, а ты подхватишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150108,
					"content": "«Вот у соседей музыка, и я пускаюсь в пляс!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "Нет, нет, нет! Ты чего? В Нод-Крае каждый ребёнок знает эту песню!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150113,
					"content": "Если не умеешь петь и веселиться, тебе с нами не по пути! А когда приходит Дикая Охота, солдату без товарищей приходится несладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150114,
					"content": "Так что не возвращайся, пока не выучишь песню! Ясно тебе? Эй, повтори мне пива!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Громкий призрак"
				},
				{
					"id": 760150110,
					"content": "«Моя подружка Паймон - девчонка просто класс!»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "«Вот призраки на острове хлебают свой пивас!»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Уступи мне ненадолго?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
