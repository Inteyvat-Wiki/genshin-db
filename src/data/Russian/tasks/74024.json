							2408.11,
							252.736,
							4985.173
						],
						"pointId": 340300092
					},
					{
						"sceneId": 3,
						"position": [
							2408.264,
							252.729,
							4986.404
						],
						"pointId": 340300093
					}
				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "Уф, что это ты тут делаешь в одиночку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240102,
					"content": "Ой! Разве можно вот так подкрадываться?! Из-за тебя я чуть не рассыпала порошок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240103,
					"content": "Порошок? Ой, а что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240104,
					"content": "Самоцветы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240105,
					"content": "Самоцветы? Откуда здесь самоцветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240106,
					"content": "Было бы странно, если бы их здесь не было. Это ведь моя мастерская по обработке самоцветов... Правда, вот названия у мастерской пока нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240107,
					"content": "Я подумывала назвать её «Студия Слуази», но, возможно, использовать моё имя вот так напрямую - не лучшая идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240108,
					"content": "Что значит «обработка самоцветов»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "Это то, чем я занимаюсь - превращаю камни в разные красивые украшения и... всякие такие штуки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240110,
					"content": "К сожалению, у меня давно не было заказов. Так что пока мне лучше сосредоточиться на изготовлении красок... И для этого мне тоже нужны самоцветы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240111,
					"content": "Краски из самоцветов? Серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240112,
					"content": "Да. А что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240113,
					"content": "Звучит как пустая трата самоцветов... которые можно было бы отдать Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240114,
					"content": "И вообще, зачем тебе краски? Паймон никогда не слышала, чтобы для изготовления украшений нужно было делать краски из самоцветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240115,
					"content": "Ко мне недавно пришла девочка и попросила сделать краски, сияющие, как самоцветы, и яркие, как солнце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240116,
					"content": "И ведь как раз эта девочка спасла мою младшую сестру, когда в нашей деревне была беда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240117,
					"content": "Вот почему мне захотелось исполнить её мечту и сделать «яркие, как солнце, краски» ей в подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240118,
					"content": "Постой, ты говоришь о...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "Та девочка, что любит рисовать... Её зовут Мамер?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240120,
					"content": "Хм... Да. Вы с ней знакомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240121,
					"content": "Вы рассказываете Слуази о том, что испытали вместе с Мамер...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "Значит... Вы и есть те благородные герои, что вместе с Мамер спасли Пуку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240123,
					"content": "Благородные?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240124,
					"content": "Да, это были мы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "Спасибо вам! Если бы не вы, Пука...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240127,
					"content": "Пожалуйста, если вы не против, возьмите это!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240128,
					"content": "(Красивые самоцветы...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#А мы точно можем это взять, {NICKNAME}? На вид это настоящая драгоценность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240131,
					"content": "И всё равно Паймон сомневается, что Мамер стала бы давать кому-то такое поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240132,
					"content": "Вряд ли это можно считать поручением. Она просто спросила, могу ли я это сделать. И убежала, даже не услышав ответа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240133,
					"content": "Ну... да. Это на неё похоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240134,
					"content": "#К слову говоря, благородные герои {NICKNAME} и Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240135,
					"content": "Какой предмет, по-вашему, цветом больше всего походит на солнце?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240136,
					"content": "Я пыталась сама понаблюдать за солнцем, но всё равно не уверена, какие материалы лучше использовать, чтобы воспроизвести этот цвет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240137,
					"content": "Хм... Цвет солнца, говоришь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240138,
					"content": "Может, золото?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "Хм, Канотила тоже говорила, что «золото - это слёзы солнца»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240140,
					"content": "Но не слишком ли это роскошно? Должен же быть какой-то материал попроще...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240148,
					"content": "Подумай. Надо найти что-то не слишком редкое и похожее цветом на солнце...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240141,
					"content": "Солнце?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "Да, логично. Больше всего на солнце похоже само солнце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240143,
					"content": "Но как можно превратить солнце в порошок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240144,
					"content": "Что? Зачем вообще обсуждать такие глупости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240145,
					"content": "Может быть, мои волосы подойдут?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "Хм?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "Слуази"
				},
				{
					"id": 740240147,
					"content": "Эй, нельзя пускать твои волосы на краску!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740240130,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "«Благородные» - это немного перебор...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
