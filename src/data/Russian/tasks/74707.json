				]
			},
			"dialogs": [
				{
					"id": 747070101,
					"content": "...Отлично! Снимем ещё один дубль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747070102,
					"content": "Хорошо. Снято!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747070103,
					"content": "Фурина! А с ней Коломбина и Тиори! И снова здравствуйте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747070104,
					"content": "Привет! Мы только что закончили снимать дополнительный материал, о котором вам рассказывали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747070105,
					"content": "А, это который с рыбками-актёрами? Ну и как, всё получилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747070106,
					"content": "Благодаря вам мы нашли идеального исполнителя. Съёмки прошли отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747070107,
					"content": "А ещё у вас настоящий талант к оформлению океанариума. Фурина сказала, что вы вдохновили её снять документальный фильм под водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 747070108,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "Да, мне тоже очень понравилось. Я чувствую, что рыбкам в аквариуме хорошо и уютно. Вы замечательно о них заботитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 747070111,
					"content": "Вот бы океанариум остался здесь навсегда. Тогда можно было бы время от времени приходить и любоваться рыбками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747070112,
					"content": "Если не хочешь расставаться, добавь побольше кадров с рыбками в свой фильм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Тиори"
				},
				{
					"id": 747070113,
					"content": "Так и сделаю. Тогда надо снять ещё несколько дублей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747070114,
					"content": "Добавить ещё рыбок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 747070115,
					"content": "Ещё несколько кадров! Свет, камера, по местам... Кинохлопушка, тебя это тоже касается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747070116,
					"content": "Паймон уже здесь! Хотя она никогда ещё не хлопала в хлопушку перед рыбками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747070109,
					"content": "Здорово, что вам у нас понравилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}