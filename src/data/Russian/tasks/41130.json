			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзин Лунь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "#Эй, путешественни{F#ца}{M#к}, сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "Это касается деревни Цинцэ. Из-за метеоритов монстры вокруг деревни обезумели. Они свирепствуют на дорогах и почти что взяли деревню в кольцо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300106,
					"content": "Пока мы на страже, жителям Цинцэ ничего не грозит, но ресурсы для деревни поступают извне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300107,
					"content": "Ввиду сложившихся обстоятельств Департамент по делам граждан выделить достаточно войск для сопровождения ресурсов не может... Обозы с таким количеством чудовищ не справятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300108,
					"content": "Мы тут с остальными подумали... Далеко от деревни Цинцэ мы отойти не можем, так хоть расправимся с монстрами вокруг неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300109,
					"content": "Таким образом мы поможем тем, кто сопровождает ресурсы. Однако наши разведчики доложили, что точек сосредоточения монстров немало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300110,
					"content": "Одни мы быстро справиться с ними не сможем. А если задержимся, боюсь, с деревней Цинцэ что-то случится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300111,
					"content": "#Путешественн{F#ица}{M#ик}, можешь ли ты помочь нам и взять часть монстров на себя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзин Лунь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "Плохо дело... Нам нужно подкрепление...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300202,
					"content": "С чудовищами покончено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "Большое тебе спасибо. Но только что случилось кое-что непредвиденное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300204,
					"content": "Я полагал, что монстры вокруг деревни обычные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300205,
					"content": "Мы зачистили один лагерь чудовищ и, перед тем как перейти к другому, решили передохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300206,
					"content": "Но вдруг из леса выбежал лавачурл с каменным панцирем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300207,
					"content": "Мы не успели отреагировать, как он набросился на нас. Он многих ранил, и вынудил нас отступить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300208,
					"content": "Он слишком опасен, чтобы позволять бродить ему по окрестностям, но другие отряды ещё не вернулись со своих заданий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300209,
					"content": "#Путешественн{F#ица}{M#ик}, помоги нам победить этого монстра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300210,
					"content": "Считайте, что его уже нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "Благодарю. Мне так неловко... Это ведь было нашим заданием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300212,
					"content": "Как раненые?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "Им своевременно оказали помощь, поэтому ничего серьёзного... Но вот передвигаться они пока не смогут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300214,
					"content": "Поэтому нам ничего не остаётся, как просить тебя о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300215,
					"content": "Мне так неловко... Это ведь было нашим заданием...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				}
			]
		},
		{
