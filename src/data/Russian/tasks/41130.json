			},
			"dialogs": [
				{
					"id": 411300501,
					"content": "У меня ещё есть другие дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300502
					]
				},
				{
					"id": 411300502,
					"content": "А... Ясно. Ничего, мы придумаем, как разобраться с этими чудовищами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				}
			]
		},
		{
			"id": 4113006,
			"completionStepIds": [
				4113012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113012",
							"2"
						],
						"stepId": 4113012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзин Лунь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "Ну как? Удалось одолеть то чудовище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300602,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "Прекрасно... Теперь мы можем вздохнуть с облегчением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300604,
					"content": "#Спасибо тебе за помощь, путешественн{F#ица}{M#ик}. Возьми это в качестве награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300605,
					"content": "Почему такой огромный монстр вдруг появился у деревни Цинцэ? Ничего не понимаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300606,
					"content": "Как бы там ни было, об этом придётся доложить в Департамент по делам граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300607,
					"content": "Надеюсь, они смогут выслать нам подкрепление...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				}
			]
		}
	]
