			"dialogs": [
				{
					"id": 411300301,
					"content": "#Мы рассчитываем на тебя, путешественн{F#ица}{M#ик}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300302
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300302,
					"content": "Эх, как это я его не заметил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				}
			]
