					"Цзин Лунь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300401,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "Отлично. Я позову других, и мы выступим. Нужно покончить с этим как можно скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "Цзин Лунь"
				},
				{
					"id": 411300403,
					"content": "Когда расправимся со всеми, встречаемся на этом же месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзин Лунь"
				}
			]
		},
		{
			"id": 4113005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
