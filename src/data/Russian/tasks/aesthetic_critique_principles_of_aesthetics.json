			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Не хватает какого-то напряжения... В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091102,
					"content": "Чего-то не хватает. Чего-то... решающего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091103,
					"content": "Фотографируешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Да, фотокамера - мой источник вдохновения для картин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091107,
					"content": "Позвольте представиться, Дэпьери, художник. Рад встрече!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091108,
					"content": "Э... Да, взаимно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "Как правило, я приглашаю всякого нового друга на чашечку кофе, но поблизости нет ни одной кофейни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091110,
					"content": "Тогда возьмём эту Фонту и выпьем за наше знакомство! Вам уже доводилось бывать в Фонтейне прежде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091111,
					"content": "В первый раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ах, момент для первого путешествия выбран как нельзя лучше! Отправляйтесь в город и полюбуйтесь видами - например, протянутыми над головой водными путями!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091113,
					"content": "Затем осмотрите механизмы тончайшей работы на улицах. Хоть и не все из них обладают достаточной эстетикой, на мой скромный взгляд художника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091114,
					"content": "И, наконец, зайдите в кафе и порадуйте себя чашечкой кофе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091115,
					"content": "Как знать, вдруг кто-то подойдёт и заведёт приятный разговор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091116,
					"content": "Но если этот кто-то будет заявлять, что состоит в Ассоциации любителей фотосъёмки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091117,
					"content": "Будьте с ними начеку! Они могут такого наговорить... Некоторые из них уж точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091118,
					"content": "Что же они делают?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Что они делают? Ведут культурную жизнь Фонтейна к полному уничтожению, вот что!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091122,
					"content": "Но не думайте, что я пугаю зазря. Как думаете, что они говорят в своей «ассоциации»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091123,
					"content": "«В точности изображения фотография значительно превосходит живопись!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091124,
					"content": "Только вслушайтесь! «В точности изображения»... Такую глупость выдавать за истину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091125,
					"content": "Если передавать картинку «как есть», то где же пространство для творчества?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091126,
					"content": "Несомненно, есть среди художников те, кто ищет способ сделать рисунок наиболее реалистичным... Но даже у этого корни лежат в эстетическом восприятии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091127,
					"content": "Эстетическом! Ведь главное - это эстетика, понимаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091128,
					"content": "Не очень...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "Наблюдение за окружающим миром глазами художника - это лишь один из этапов. Далее мы используем кисть, чтобы понять и воплотить подлинную красоту из глубины души.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091131,
					"content": "Я вовсе не считаю всех обладателей камер за олухов, лишённых всякого чувства прекрасного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091132,
					"content": "Многие мои друзья любят фотокамеры, и мне приятно с ними общаться. Временами их снимки вдохновляют меня на новые картины, а мои картины, в свою очередь, даруют вдохновение им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091133,
					"content": "А вот невежды, которые пространно рассуждают обо всяком вздоре, вызывают во мне огромное негодование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091134,
					"content": "Они оскорбляют и тех, кто любит живопись, и тех, кто предпочитает фотографию! Они... Они!.. Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091135,
					"content": "Не горячись, попей воды.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Ох, спасибо. Мне сложно удержаться от ярости всякий раз, когда речь заходит о них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091137,
					"content": "Вот почему мы с друзьями и решили с помощью фотокамер собирать «исходные материалы» для будущих картин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091138,
					"content": "Мы готовим выставку, где рядом с картиной будут располагаться снимки, которыми вдохновлялся художник. Тогда все увидят разницу между фотографией и живописью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091139,
					"content": "Вот только... Я не нахожу ничего интересного в моих снимках. Друзья говорят, что лучшие кадры получаются в далёких и опасных местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091140,
					"content": "Под водой, например, или на краю утёса, или в лесной чаще... Но в такие места я боюсь в одиночку идти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091141,
					"content": "А найти искателя приключений - дело небыстрое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091142,
					"content": "#Хм... {F#Дорогая путешественница}{M#Дорогой путешественник}, не хотите ли вы поработать на художника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091143,
					"content": "Если не попросишь рисовать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "Не беспокойтесь! Каждый из нас будет делать то, в чём хорошо разбирается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091146,
					"content": "И я заплачу. Я часто нанимаю искателей приключений в качестве охраны в моих поездках, так что правила я знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091147,
					"content": "Просто в этот раз дело такое срочное, а никого найти вовремя я не успел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091148,
					"content": "Решено! С вашей помощью у меня наверняка получится написать великолепную картину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091144,
					"content": "#Я только в приключениях хорош{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "Немного...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "А со мной они что-то могут сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "То же, что и с Фонтейном. Они уничтожат культурную жизнь, частью который вы могли бы стать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091105,
					"content": "Ты увлекаешься фотографией?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "О нет, камера - это не хобби, а лишь инструмент для сбора материалов. Мой главный инструмент - кисть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Дэпьери"
				}
			]
		},
