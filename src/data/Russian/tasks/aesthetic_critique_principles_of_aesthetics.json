			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "Это... Это не совсем то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090902,
					"content": "Какие фотографии тебе нужны в этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "На этот раз... Новых снимков не нужно. У меня просьба другого характера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090905,
					"content": "Кхм... Неловко об этом говорить... Но не можете ли вы найти чего-нибудь съестного? Чесночный багет, например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090906,
					"content": "У тебя... нет с собой еды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "Нет, что вы! Я принёс хлеб, варенье, немного мяса. Этого должно было хватить на весь день...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090909,
					"content": "Я положил еду рядом, сосредоточившись на рисовании, и так увлёкся... Короче, когда я действительно проголодался, еды уже не было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090910,
					"content": "Может, её похитил дикий зверь или голодный прохожий... Смею надеяться, что хотя бы они утолили свой голод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090911,
					"content": "А мой всё ещё требует утоления... В город я не вернусь, пока не соберу достаточно рабочих материалов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090912,
					"content": "Подожди, я сейчас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "Ох, я рассчитываю на вас! Чесночный багет можно найти в городском магазине!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090915,
					"content": "Ах, в теле лёгкая слабость. Голод или умственное переутомление?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090913,
					"content": "Я принесу тебе что-нибудь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "У тебя... нет моры, чтобы купить еды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "Куда отправиться теперь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
		{
			"id": 2400910,
			"completionStepIds": [
				2400914
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
