			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Посмотрим... Мои друзья кое-что подсказали, я всё записал в блокнот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090202,
					"content": "«Подводные растения»... «Волны»... «Свет и тень»... Что же я тут написал? Неужели я так много выпил?.. Да, вот в чём дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090203,
					"content": "Кхм. Пожалуйста, сделайте несколько снимков подводных растений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090204,
					"content": "Вероятно, когда я делал заметки, то был заинтересован светом и тенью, которые падают на растения под водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				}
			]
		},
		{
