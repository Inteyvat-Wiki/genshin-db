		{
			"id": 2400908,
			"completionStepIds": [
				2400908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400908",
							"2"
						],
						"stepId": 2400908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "Ну как дела с фотографиями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090802,
					"content": "Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "Посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090804,
					"content": "Ох, вот это красота! Красота! Кто бы мог подумать, что у вас такие таланты в области фотографии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090805,
					"content": "Из этого снимка я выберу великолепные материалы для картины!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090806,
					"content": "Спасибо большое. Где же мора?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090807,
					"content": "Вот, это вам. Возьмите же! Если появится возможность, приносите ещё фотографии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090808,
					"content": "А теперь... Как мне объединить это в картину?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				}
			]
		},
		{
			"id": 2400909,
			"completionStepIds": [
				2400901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400901",
							"2"
						],
						"stepId": 2400901,
						"stateName": "QUEST_STATE_UNFINISHED"
