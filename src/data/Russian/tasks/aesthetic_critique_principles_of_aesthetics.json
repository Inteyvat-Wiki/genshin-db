			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "Спасибо за помощь! Этого хватит, чтобы наполнить мой голодный желудок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091002,
					"content": "Это вам за помощь. А мне нужно скорее подкрепиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240091003,
					"content": "В следующий раз стоит взять печенье и положить его глубоко в сумку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				}
			]
		},
		{
			"id": 2400911,
			"completionStepIds": [
				2400901
