			"dialogs": [
				{
					"id": 240090401,
					"content": "Посмотрим... Мои друзья кое-что подсказали, я всё записал в блокнот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090402,
					"content": "«Грандиозные подводные руины!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090403,
					"content": "Да ладно? Я писал эти слова с таким усердием, что даже продырявил лист...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090404,
					"content": "Но это место, вероятно, обладает особой красотой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090405,
					"content": "Сделайте снимки таких подводных руин. Чем больше руины и чем сильнее разрушены, тем лучше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				}
			]
		},
