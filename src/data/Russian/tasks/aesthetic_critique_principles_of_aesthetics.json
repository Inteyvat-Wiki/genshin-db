			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дэпьери"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "#{F#Путешественница}{M#Путешественник}! Ты как раз вовремя. Я нашёл бесподобное местечко для фотосъёмки - нужна лишь твоя помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090102,
					"content": "Всё ищешь вдохновения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Ну разумеется. Материалов пока решительно недостаточно. Из одной фотографии не получится создать полную картину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090104,
					"content": "Обычно в качестве образцов я использую десятки изображений, а иногда и сотни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090105,
					"content": "Так много...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Как я и объяснял ранее, «творение» является важнейшим элементом изобразительного искусства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090108,
					"content": "Если просто перенести на полотно то, что видишь, то выйдет не картина, а фотография.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090109,
					"content": "Подлинный художник должен использовать своё эстетическое чутьё и внимательный взор, чтобы выбрать важное, преобразить нужное, отрезать лишнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090110,
					"content": "Так художник оставляет лишь самые изящные стороны каждого элемента, а затем переносит их на холст, превращая в картину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090111,
					"content": "Ничего не понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "Что ж... С каждой фотографии мне нужны лишь самые красивые части.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090114,
					"content": "Например, здесь прекрасный баланс света и тени, но фон весьма скудный. Поэтому для меня ценным будет лишь вышеупомянутый баланс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090115,
					"content": "#На другой фотографии запечатлена лучшая поза {F#путешественницы}{M#путешественника}, на третьей - прекрасное здание...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090116,
					"content": "Я будто бы складываю головоломку в своём воображении, где красота или безобразность целиком зависят от моего эстетического восприятия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090117,
					"content": "Это не вполне строгое определение процесса, ведь и выбранные элементы можно существенно изменять... Но основную мысль вы, должно быть, уловили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090118,
					"content": "Значит, тебе ещё нужна моя помощь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Ну... Да, всё верно! У вас выходят превосходные снимки! Мои друзья захотели встретиться с вами, как только увидели, какие работы у меня выходят с вашей помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090121,
					"content": "Несомненно, вместе мы создадим что-нибудь великолепное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090122,
					"content": "Поэтому прошу, во имя всего прекрасного и за справедливую плату, помочь мне ещё раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэпьери"
				},
				{
					"id": 240090119,
					"content": "Нужно собрать больше материалов, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Объясни простыми словами!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Картинки используются по-разному?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
