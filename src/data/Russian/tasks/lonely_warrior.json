						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110202,
					"content": "...Меч цел? Но я не ощущаю духа волка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110203,
					"content": "(...Похоже, я больше не в реальном мире. Вероятно, это пространство, сотканное из сплетённых сознаний Борея и Роланда.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110204,
					"content": "Назад дороги нет, а впереди лишь волчья пасть... Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110205,
					"content": "Значит, единственный путь - вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Варка"
				}
			]
		},
		{
			"id": 1601107,
			"completionStepIds": [
				1601107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
