					}
				]
			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "Это... сердца волка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110702,
					"content": "!.. «Роланд»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Варка"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Роланд"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "...Как пожелаешь, Рыцарь Бореалис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110902,
					"content": "Ха, я тебя не таким представлял. Ты и вполовину не так безумен, как в воспоминаниях духа волка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110903,
					"content": "Я ни разу не сбился с праведного пути. Но когда я смотрю на тебя... я не вижу героя, способного сразить дракона. Лишь заблудшую душу, что слишком долго скиталась. Тень рыцаря, каким ты был когда-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110904,
					"content": "Полагаю, в этом мы похожи. Ни один из нас не находится на пике своей силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110905,
					"content": "Войско Лунного мстителя разгромлено, и Роланд, которого ты видишь, лишь несовершенный образ, созданный Бездной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110906,
					"content": "Я обладаю той же мощью, что и Роланд в зените его силы, но сердце моё и разум застыли в том залитом кровью мгновении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110907,
					"content": "Поэтому я в нынешнем своём облике несовершенен... Рыцарь не может остановиться в своём развитии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110908,
					"content": "Освобожу тебя от несправедливости и направлю служить Бездне, после чего исправлюсь сам и продолжу следовать рыцарскому пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110909,
					"content": "Ха, этот мир не выдержит твоих безумств... Твоя одержимость осталась прежней, как я и думал. Похоже, у меня нет шансов тебя переубедить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110910,
					"content": "Никакие речи не заставят рыцаря усомниться в своих убеждениях, сколь благородными они ни казались бы. Ни один из нас не переубедит другого... но ты и сам это знаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110911,
					"content": "Иначе к чему возлагать все свои надежды на одну единственную мысль Борея?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110912,
					"content": "Клинок, в котором некогда обитал дух волка, разбит, и всё, что у тебя осталось, - лишь призрак, носящий его обличье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110913,
					"content": "Ты больше не в силах изменить ход событий, и на помощь никто не придёт... Это место станет твоей могилой, одинокий воин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110914,
					"content": "Ты отчасти прав... Впрочем, думаю, что возможность избежать этой участи у меня всё же есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110915,
					"content": "...Что ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110916,
					"content": "Мне нужно повлиять на волю одного создания, и уж точно не на твою...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110917,
					"content": "Забыл, где мы находимся? Это сердце Андриуса, бога северного ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110919,
					"content": "Андриус! Ты слышишь меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110920,
					"content": "Пробудись! Ты великий бог северного ветра! Сколько ещё ты будешь терпеть господство Бездны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110922,
					"content": "...Если это твой последний ход, то я глубоко разочарован, Рыцарь Бореалис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110923,
					"content": "Громкие заявления об искренних желаниях не способны породить чудеса. Этот мир не являет подобной милости своим обитателям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110924,
					"content": "...Вернуться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110925,
					"content": "...Вернуться в... артерии земли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110926,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110927,
					"content": "...Это мой выбор... мои воспоминания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110928,
					"content": "...Это ответ, который я нашёл... в конце своего путешествия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110929,
					"content": "Андр{RUBY#[S]Борей}иус... Наконец-то я вернул твой знак в твоё сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110930,
					"content": "Ха... Рыцарь Бореалис? Смотри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110931,
					"content": "...это единственное, что во{RUBY#[S]я}лк может сделать для люд{RUBY#[S]вы}ей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160110932,
					"content": "...От лица всего человечества благодарю тебя, Волчий лорд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110933,
					"content": "Борей... возвращается в артерии земли. Почему? Твой меч разбит, у тебя больше нет средств удержать его душу. Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110934,
					"content": "Уповать на чудеса - напрасная затея. Я прекрасно это понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110935,
					"content": "...Однако меч лишь одна из форм вместилища. Существуют иные пути сберечь душу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110936,
					"content": "...Волчий лорд некогда даровал силу своей души своей стае, укрепив их сердца и заточив их когти и клыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 160110937,
					"content": "...Даже если я того не желаю, душа Лупуса Бореалиса неминуемо разорвёт и поглотит сердце смертного... Как если бы человек и волк насильно слились в единое существо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Борей"
				},
				{
					"id": 160110938,
					"content": "...Если сердце человека согласно вобрать душу божества... С этой дороги не свернуть. Однако я не посмею отговаривать рыцаря, коли он сам избрал этот путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "«Капитан»"
				},
				{
					"id": 160110939,
					"content": "Твоё сердце, твоя душа... разрушаются?... Понятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110940,
					"content": "Ты наверняка задавался вопросом, как ягнёнок может укротить сердце волка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110941,
					"content": "Ответ прост: позволь волку поглотить сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110942,
					"content": "Дух волка в мече служил отвлекающим манёвром... настоящие мысли и память покоились в твоём сердце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110943,
					"content": "Чтобы не вызвать моих подозрений, ты намеренно дал душе Лупуса Бореалиса поглотить свою, а затем позволил мне вобрать её... Но... как ты нашёл в себе силы сражаться, неся такое тяжёлое бремя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110944,
					"content": "По сравнению с решением Лупуса Бореалиса... моя жертва - сущий пустяк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110945,
					"content": "У тебя несгибаемая воля и ты избрал необычную стратегию... Но истинный рыцарь так не поступает. Твоё решение неверно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110946,
					"content": "Теперь твоя душа слилась с душой Андриуса. Когда он полностью сольётся с артериями земли, ты тоже исчезнешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110947,
					"content": "#Ни Барбатос, ни {M#путешественник}{F#путешественница} не смогут уберечь твою душу в артериях земли, а уж тем более - спасти тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110948,
					"content": "Ты потерпел поражение, как и я. Увы, но я не могу даровать тебе спасение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110949,
					"content": "...Да упокоится твоя душа с Бореем, одинокий воин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Роланд"
				},
				{
					"id": 160110950,
					"content": "...Ха-ха, одинокий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110951,
					"content": "Прости, что разочаровываю, но... Как бы красиво ни звучало, что мы оба вернёмся в артерии земли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110952,
					"content": "Суть в том, что меня, в отличие от Роланда минувших дней, снаружи ждут отменное вино и верные друзья. Они предвкушают моё триумфальное возвращение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110953,
					"content": "Поэтому я пока не намерен смириться со своей участью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160110954,
					"content": "Динь-динь! Тебе письмо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				}
			]
		},
		{
			"id": 1601111,
