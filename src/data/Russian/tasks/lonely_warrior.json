			"dialogs": [
				{
					"id": 160111101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111102
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111102,
					"content": "...Иди вперёд и не оглядывайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Андриус"
				},
				{
					"id": 160111103,
					"content": "«Варка, я... Я знаю, что значит моё имя...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 160111104,
					"content": "«Ты доставил всем столько хлопот... Когда вернёшься - придётся как следует нас отблагодарить».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Розария"
				},
				{
					"id": 160111105,
					"content": "«У меня масса новостей... но они дождутся вашего возвращения».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 160111106,
					"content": "«Я не собираюсь возвращаться в орден, так что... придётся вам справляться самостоятельно».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 160111107,
					"content": "«...Магистр ордена, мы все ждём вас».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111109,
					"content": "Хм?... О.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111110,
					"content": "Я... недурно справляюсь с обязанностями магистра ордена, согласны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111111,
					"content": "...Буду считать ваше молчание знаком согласия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111112,
					"content": "Всё, что вы клялись оберегать ценой жизни... всё там, в целости и сохранности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111113,
					"content": "Ордо Фавониус, Мондштадт... и клятва, данная каждым рыцарем. Я буду защищать их ценой своей жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111114,
					"content": "Так что... это письмо я доставлю за вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111115,
					"content": "...Понимаю, что это всего лишь призрак настоящего Роланда, но... если будет время, прочтёте ему письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111116,
					"content": "Рустан и Арундолин никогда не забывали тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111117,
					"content": "Фух... Это была долгая экспедиция.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111118,
					"content": "Дальше я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111119,
					"content": "...доверюсь ветру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111122,
					"content": "!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Ноэлль"
				},
				{
					"id": 160111130,
					"content": "...Всем привет! Давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111131,
					"content": "...Как же здорово снова видеть вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111132,
					"content": "С возвращением, магистр ордена.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "...Да, я вернулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Варка"
				},
				{
					"id": 160111123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
