				"points": []
			},
			"dialogs": [
				{
					"id": 210240901,
					"content": "#Ты наш{F#ла}{M#ёл} накладные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240902,
					"content": "Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Спасибо тебе огромное! Как же я рад, что они нашлись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240904,
					"content": "Даже представить не могу, как разозлился бы мой начальник, потеряй я эти накладные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240905,
					"content": "Что? Ты хочешь узнать, что в этих накладных?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240906,
					"content": "Прости, но я не могу тебе сказать. Это коммерческая тайна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240907,
					"content": "Вот твоя компенсация... Минуточку. Одну из коробок открывали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240908,
					"content": "Что? Кто-то другой нашёл коробку и прочитал все накладные?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240909,
					"content": "Ох, мне конец... Я покойник! Т-так дело не пойдёт. Я срочно должен поговорить со своим начальником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240910,
					"content": "#Не переживай. Ты вне подозрений. Ты сделал{F#а} всё, о чём я просил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Ланда"
				},
				{
					"id": 210240911,
					"content": "Мне нужно связаться с начальником как можно скорее! Прошу тебя, возвращайся к своим делам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ланда"
				}
			]
		},
