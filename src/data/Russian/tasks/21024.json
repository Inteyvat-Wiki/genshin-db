					"Бао Эр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Выглядит бесполезно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240602,
					"content": "Ты не видела здесь коробку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Вот эту? Я только что нашла здесь какую-то коробку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240604,
					"content": "Внутри ничего не было кроме кучи накладных. Похоже, кто-то ведёт серьёзный бизнес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240605,
					"content": "Интересно, какую сумму владелец готов отдать за эти накладные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240606,
					"content": "На что ты намекаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "Не делай такое лицо. Я просто пошутила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240608,
					"content": "Все товары в этих накладных отнюдь не дешёвые. Интересно, кто же в Ли Юэ ведёт такой крупный бизнес?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240609,
					"content": "Наверное, это слишком крупная шишка. Мне такое пока не по зубам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240610,
					"content": "Но не кажется ли тебе, что просто так забрать коробку, на охрану которой я потратила время и силы, будет немного нечестно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240611,
					"content": "Услуга за услугу. Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240612,
					"content": "Принеси мне три кусочка полуночного нефрита, и я отдам тебе коробку. Договорились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240613,
					"content": "По сравнению с товарами, перечисленными в этих накладных, полуночный нефрит всего лишь мелочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240614,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Тогда за дело. Возвращайся с нефритом, и я отдам тебе коробку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240616,
					"content": "Что там написано?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Так ты не знаешь? Получается, ты просто выполняешь чьё-то поручение? Ну и ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240619,
					"content": "Послушай мой совет: не задавай лишних вопросов по поводу этих бумаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240620,
					"content": "Ладно. Принеси мне три кусочка нефрита, и я отдам тебе накладные. А потом ты вернёшь их тому, кто тебя об этом попросил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Бао Эр"
				},
				{
					"id": 210240621,
					"content": "И дело в шляпе. Без пыли и шума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бао Эр"
				}
			]
		},
