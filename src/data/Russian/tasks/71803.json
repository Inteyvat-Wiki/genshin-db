			"dialogs": [
				{
					"id": 718030501,
					"content": "Мяу, мяу... Мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030502
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 718030502,
					"content": "Эта кошка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030503
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030503,
					"content": "Возможно, Дымок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "Подожди, сейчас я достану поручение и мы сравним описание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030505,
					"content": "Сейчас посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030506,
					"content": "Почти всё совпадает... Похоже, что это действительно кот из поручения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030508,
					"content": "Вот хозяева обрадуются.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "Хах... И вот, сделав круг, мы опять вернулись к поиску пропавших котов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030510,
					"content": "Вот уж не знаешь, что сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030511,
					"content": "Я сообщу заказчикам о выполнении их поручений. Спасибо. Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030512,
					"content": "Похоже, что хозяева кота переехали. Понадобится время, чтобы с ними связаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030513,
					"content": "Я позабочусь о нём, пока хозяева не придут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030514,
					"content": "Мяу-мяу, мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дымок"
				}
			]
		}
	]
