			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дымок"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718030301,
					"content": "Мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 718030302,
					"content": "Э? Откуда здесь котик? Неужели это он мяукал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030303,
					"content": "Мяу... мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 718030304,
					"content": "Серый котик...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Серенький котик... Потерялся за городом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030306,
					"content": "А! Мисс Лань упоминала поручение о поиске серого кота. Может быть, это он? Кажется, его звали Дымок или что-то такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030307,
					"content": "Кто бы мог подумать, что он здесь... Неужели он всё время тут прятался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030311,
					"content": "Из-за лавачурла никто здесь не искал... А он тоже испугался и просто спрятался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030312,
					"content": "Хорошо, что мы пришли, а то бы он тут долго ждал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030313,
					"content": "Мяу... мяу-мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 718030314,
					"content": "Мяу... мяу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Эй, ты чего? Так тебя он тоже не понимает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030316,
					"content": "Давай отнесём его к мисс Лань, а она передаст его хозяевам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030319,
					"content": "Мяу... Мяу! Мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Дымок"
				},
				{
					"id": 718030320,
					"content": "Мяу... Мяу! Мяу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Сколько ты за ним не повторяй, он всё равно тебя не поймёт! Давай отнесём его побыстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030322,
					"content": "Кажется, он согласен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "А откуда ты... Ладно. Давай просто отнесём его поскорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030317,
					"content": "Давай отнесём к Лань...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Ага, ничего другого не остаётся. Отнесём ей, а она передаст хозяевам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030308,
					"content": "Неужели это Дымок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "Серенький котик... Потерялся за городом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 718030310,
					"content": "А! Мисс Лань упоминала это поручение! А он тут, оказывается... Неужели всё это время тут рядом прятался?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Паймон"
				}
			]
		},
