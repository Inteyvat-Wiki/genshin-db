			"dialogs": [
				{
					"id": 718030401,
					"content": "#Ты одолел{F#а} лавачурла с каменным панцирем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030402,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "Спасибо. Выполнение такого задания покажет всем, на что способна Гильдия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 718030404,
					"content": "Конечно. А ещё мы нашли Дымка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "Спасибо... Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
