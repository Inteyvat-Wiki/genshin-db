			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дилюк"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705050201,
					"content": "Прекрасный вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050202,
					"content": "Всё дело в ингредиентах! Если фрукты свежие и сочные, то и напиток выйдет сладким без всяких добавок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050203,
					"content": "Думаю, нужно сказать спасибо земле Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050204,
					"content": "Закат зелёной долины... Первый приготовленный мною напиток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050205,
					"content": "Я был ещё совсем маленьким. Мой отец разложил передо мной ингредиенты и сказал мне поэкспериментировать с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050206,
					"content": "Ни требований, ни указаний. Теперь я думаю, что он хотел проверить мою креативность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050207,
					"content": "В конце концов у меня получился фруктовый пунш, очень похожий на этот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050208,
					"content": "А? Почему фруктовый пунш?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050209,
					"content": "Вот и мой отец тоже удивился. На самом деле, я ничего особого не задумывал, просто хотел, чтобы получилось сладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050210,
					"content": "Сейчас понимаю, что я был юн и бестолков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050211,
					"content": "Мне так не кажется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050213,
					"content": "Наверняка вкус пришёлся по душе твоему отцу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "Ну не знаю... Тогда отец просто промолчал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050216,
					"content": "Но спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050217,
					"content": "Кстати, у меня кое-что есть для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050218,
					"content": "Но, полагаю, стоит подождать, пока ты не наберёшься опыта. С твоими способностями из тебя выйдет отличный бармен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050219,
					"content": "Йуху! Паймон тоже в команде болельщиков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050220,
					"content": "Вот и славненько. Желаю успехов. Увидимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050221,
					"content": "Заходи ещё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050214,
					"content": "Ему точно понравилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
	]
}