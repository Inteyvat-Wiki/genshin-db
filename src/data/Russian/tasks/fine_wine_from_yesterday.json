			},
			"dialogs": [
				{
					"id": 705050101,
					"content": "О, да это же господин Дилюк! Откуда ты тут? Ищешь, как бы скоротать время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050102,
					"content": "Что? Я и «скоротать время»? Вот уж вздор. Я слышал, что вы двое работаете барменами, вот решил заскочить и посмотреть, как у вас идут дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050103,
					"content": "Ого, как быстро разлетаются новости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050104,
					"content": "#{NICKNAME}, и как тебе быть барменом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050105,
					"content": "Ну, мы только начали...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "Да, пока ещё рано говорить об этом. Мы совсем недавно в деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050107,
					"content": "Расскажи просто о первом впечатлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050108,
					"content": "Волнение? Смущение? Хоть что-нибудь. Каково это - быть барменом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050109,
					"content": "Это... что-то новое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "А, вот как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050112,
					"content": "Эй, а почему ты не спрашиваешь у Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050113,
					"content": "Паймон сразу показалось... вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705050114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050115,
					"content": "Ну и хорошо. Рад за тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050116,
					"content": "Приготовишь мне Закат зелёной долины? Большой или маленький - без разницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050117,
					"content": "Ясно. Сейчас всё будет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "Здорово! Не спеши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 705050110,
					"content": "Немного суматошно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
		{
			"id": 7050502,
