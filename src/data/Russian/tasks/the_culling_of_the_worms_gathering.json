							174.01,
							5993.106
						],
						"pointId": 3965
					}
				]
			},
			"dialogs": [
				{
					"id": 735120101,
					"content": "#О, спасибо тебе, {M#храбрый путешественник}{F#храбрая путешественница}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120102
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120102,
					"content": "Фух, хорошо, что прошло не так много времени и детали не слишком повреждены... Нужно только кое-что подправить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120103
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120103,
					"content": "Винаяк начинает разбираться с техникой...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735120104
					]
				},
				{
					"id": 735120104,
					"content": "...Винаяк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120105
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120105,
					"content": "Почти готово... Я скоро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120106
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120106,
					"content": "Ви-на-як!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120107
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120107,
					"content": "Что? Шрия? Когда ты успела прийти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120108
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120108,
					"content": "Пока ты возился с компонентами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120109
					]
				},
				{
					"id": 735120109,
					"content": "Разве не ты говорила, что здесь опасно и кругом полно чудовищ? Так почему ты здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120110
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120110,
					"content": "...Просто переживала о компонентах. Если мы не выполним задание, я не смогу вернуться в Академию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120111
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120111,
					"content": "Ха, как я и говорил! Смотри, все детали на месте. Вернёмся, приведём их в порядок и наконец начнём сборку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120112
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120112,
					"content": "Для чего же нужны все эти детали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735120113,
					"content": "А, забыл вам рассказать. Это компоненты унутобойной пушки, нашего выпускного проекта этого года!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120114
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120114,
					"content": "Какая необычная тема!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735120115,
					"content": "Если бы тебе довелось выбирать тему работы, ты бы поняла почему... Ну ладно, это неважно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120116
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120116,
					"content": "Я должна представиться. Я Шрия, аспирант-исследователь из даршана Амурта, специализируюсь в области биологии и экологии пустынь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120117
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120117,
					"content": "Этот одержимый механикой болван - исследователь Кшахревара со специализацией в прикладной механике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120118
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120118,
					"content": "Меня зовут Винаяк. Спасибо вам за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120119
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120119,
					"content": "А разве люди с такими разными специальностями могут работать вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735120120,
					"content": "Ох, не напоминайте... Браться за совместную работу вместе с этим парнем было моей главной ошибкой за всё время обучения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120121
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120121,
					"content": "Да брось! Мы же оба успешно защитились, разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120122
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120122,
					"content": "Да, но на сколько лет ты отстал от сверстников?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120123
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120123,
					"content": "Да какая разница, я же выпустился. Я слышал, что некоторые только в прошлом году выбрали тему выпускной работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120124
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120124,
					"content": "А-а-а, хватит! Оставим эти глупые споры в студенческом прошлом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120125
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120125,
					"content": "Так это ты всегда начинаешь первой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120126
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120126,
					"content": "Глупости! Когда мы строили первый прототип...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120127,
						735120128
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120127,
					"content": "Хватит!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				},
				{
					"id": 735120129,
					"content": "Ого... Похоже, вы друг друга уже терпеть не можете. Как это в Академии додумались доверить вам это дело?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735120130,
					"content": "Ох, вообще-то, Академия нас не посылала... Этим делом должен был заняться Кунар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120160
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120160,
					"content": "Его можно назвать наставником моего наставника... Он был у нас во время защиты диссертации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120161
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120161,
					"content": "Я думаю, именно поэтому у него сложилось впечатление, что «какие-то молодые студенты в Академии сконструировали унутобойную пушку».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120162
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120162,
					"content": "Так что он отправил нас решать этот вопрос, сказав, что «Академия должна дать молодёжи больше возможностей проявить себя!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120163
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120163,
					"content": "Но он явно не учёл, что мы почти не разговаривали друг с другом после выпуска...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120131
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120131,
					"content": "Он даже убедил моего наставника... Кхм, зато у меня есть возможность снова применить унутобойную пушку на открытой местности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120132
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120132,
					"content": "Как только соберём, черви увидят всю её мощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120133
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120133,
					"content": "Опять этот болван о своих железках... Для меня ключевым является исследование причин агрессии унутов и сохранение экологического баланса в пустыне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120134
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120134,
					"content": "#{M#Уважаемый искатель}{F#Уважаемая искательница} приключений, похоже, у вас есть немалый опыт. Могу ли я попросить вас обеспечить нашу безопасность на время пребывания в пустыне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120135,
						735120136
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120135,
					"content": "Могу взяться за разумную цену.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120137,
					"content": "О вознаграждении можете не переживать. Академия не торопится оказывать нам поддержку, но финансирование у нас щедрое. Хотя кое-кто здесь и потратил большую часть на модернизацию оборудования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120138
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120138,
					"content": "Это было необходимо! Эй, а ты, оказывается, умеешь выражаться вежливо. Почему тогда мне ты вечно грубишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120139
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120139,
					"content": "Всё зависит от того, достоин ли собеседник моей вежливости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120140
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120140,
					"content": "Ох, они опять за своё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120141,
						735120142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735120141,
					"content": "Если хотите ссориться, можете заняться этим позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120143,
					"content": "Ох, прошу прощения. Это дурная привычка со времён учёбы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120144
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120144,
					"content": "Эти компоненты нужно вернуть в деревню Аару для дальнейшей наладки. Судя по всему, мы сможем начать сборку только завтра, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120145
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120145,
					"content": "Изначально мы планировали установить унутобойную пушку неподалёку, там, где видели унутов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120146
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120146,
					"content": "Когда мы за это возьмёмся, на нас могут напасть другие существа, привлечённые шумом. Надеюсь, ты нам поможешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120147,
						735120148
					],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120147,
					"content": "Никаких проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120149,
					"content": "А теперь можем продолжить наш спор. Мои расходы были абсолютно оправданы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120150
					],
					"speakerTitle": "Винаяк"
				},
				{
					"id": 735120150,
					"content": "Ах ты! Отлично! Хочешь детальных расчётов? Сам напросился!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шрия"
				},
				{
					"id": 735120148,
					"content": "Увидимся завтра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120142,
					"content": "Давайте начнём составлять план?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120136,
					"content": "Да, это пара пустяков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120128,
					"content": "Вы никак не угомонитесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				}
			]
		}
	]
}