			"dialogs": [
				{
					"id": 250330201,
					"content": "#{M#Братик}{F#Сестричка} {M#такой}{F#такая} молодец! Взбирается так же быстро, как и Майта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330202,
						250330203
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330202,
					"content": "Есть небольшие недочёты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "Такая скорость восхождения очень впечатляет. Мы с Тикой точно так не смогли бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330205
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330205,
					"content": "#Эх, нам нужно уложиться во время {M#братика}{F#сестрёнки}. На это потребуется много тренировок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330206
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330206,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330207,
						250330208
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330207,
					"content": "Поднажми, Тика!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330210
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330210,
					"content": "Хороший мальчик, Тика. Дядя Явар сказал, что если мы будем стараться, то обязательно преуспеем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330211,
					"content": "*Хнык*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330212,
					"content": "Спасибо за помощь! Возьми фрукт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330213,
					"content": "Тика только что сорвал их. И он двигался намного быстрее, чем раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330214,
					"content": "#Хи-хи, это благодаря тому, что {M#братик}{F#сестричка} стал{F#а} отличным примером для Тики. Поэтому он смог стать таким сильным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330215,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330216,
					"content": "Хорошо, сначала вернёмся в племя и найдём Майту. Хм, он должен быть в племени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330208,
					"content": "У вас всё получится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330203,
					"content": "Лучший результат",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				}
			]
		},
