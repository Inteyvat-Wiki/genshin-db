			"dialogs": [
				{
					"id": 250330101,
					"content": "Хороший мальчик! Ты наелся? Появились силы для тренировки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330102,
					"content": "Уй, у-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330103,
					"content": "Ого, сколько энергии! Хорошо! Сегодня нужно поднажать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330104,
					"content": "Постараемся вместе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "#Что? Приветствую, {M#братик}{F#сестричка}! Начнём же нашу тренировку по скалолазанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330107,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330108,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330109,
					"content": "Как идут твои тренировки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "Ну... Можно сказать, у нас наблюдается прогресс. В этот раз Тика забрался гораздо выше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330111,
					"content": "Просто Тика не очень понимает, как карабкаться вверх, и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330116,
					"content": "#{M#Братик}{F#Сестричка}, можешь показать нам ещё раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330117,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "Спасибо! В этот раз я буду внимательно смотреть за твоими движениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330119,
					"content": "Тика, ты тоже наблюдай во все глаза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330120,
					"content": "Аргх!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330123,
					"content": "#Эх... Хорошо. Тогда дело за тобой, {M#братец}{F#сестрица}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330124,
					"content": "Мы будем наблюдать за тобой у подножия, чтобы рассчитать время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330125,
					"content": "Р-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тика"
				},
				{
					"id": 250330121,
					"content": "В этот раз вы должны внимательно наблюдать за моими движениями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "Ещё бы! Мы с Тикой будем наблюдать очень внимательно, чтобы ничего не упустить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330112,
					"content": "Похоже, он идёт на поправку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "Ещё бы! Мама говорит, что я хорошо забочусь о Тике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330114,
					"content": "Он уже забирается гораздо выше, чем раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "Тлатем"
				},
				{
					"id": 250330115,
					"content": "Просто Тика не очень понимает, как подниматься на гору, и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Тлатем"
				}
			]
		},
