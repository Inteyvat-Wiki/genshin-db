			"dialogs": [
				{
					"id": 761160101,
					"content": "#О, это же {M#друг}{F#подруга}. {M#Наш}{F#Наша} и Бобика!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Анежка"
				},
				{
					"id": 761160102,
					"content": "А насчёт вас...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Мы тут пока останемся, нужно присмотреть за дверью лаборатории Држислава. Мы же её поломали... Нельзя, чтобы кто-то снова залез.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Анежка"
				},
				{
					"id": 761160104,
					"content": "Как всё приведём в порядок, или как только Слава вернётся домой, мы, может, тоже отправимся странствовать вместе с Бобиком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анежка"
				},
				{
					"id": 761160105,
					"content": "Про Држислава...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Без понятия, где он сейчас... Если вдруг встретите его где-то в пути, передайте от нас привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Анежка"
				},
				{
					"id": 761160107,
					"content": "Как же хочется ещё хоть раз провести с ним весь вечер во «Флагмане»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анежка"
				},
				{
					"id": 761160108,
					"content": "Расскажи про Бобика...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "Уже скучаешь? Заходи к нему, когда захочешь. Мы всегда рады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анежка"
				},
				{
					"id": 761160110,
					"content": "До встречи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Да-да! Мы ещё точно увидимся, ведь мы друзья не разлей вода!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анежка"
				}
			]
		}
	]
