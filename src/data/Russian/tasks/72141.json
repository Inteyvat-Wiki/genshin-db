					"Васидзу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411701,
					"content": "Нужно успокоить его, смягчить его гнев...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411702,
					"content": "#Ты отлично справил{F#ась}{M#ся}. Так держать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411703,
					"content": "Помни, что некоторые люди носят маски и будут пытаться тебя обмануть. Но он всегда будет помогать тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411704,
					"content": "Эм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "Эта женщина хитра, как кицунэ из легенд. Однажды я её уже отпустил. «Он» очень разозлился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411707,
					"content": "Теперь он снова зол... Я провинился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411708,
					"content": "Пожалуйста, прости меня... Я найду новую жертву. Найду новую жертву вместо старой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411709,
					"content": "Прошу, прости меня, прошу, прости меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411710,
					"content": "Прошу, прости меня, прошу, прости меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411705,
					"content": "Ну ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				}
			]
		},
