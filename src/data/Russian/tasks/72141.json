			"dialogs": [
				{
					"id": 721411801,
					"content": "А вот и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411802
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411802,
					"content": "С тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "Спасибо, что прощаешь мои грехи. Пожалуйста, позволь мне к тебе вернуться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411804,
					"content": "Это ты мне говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "Что? Но почему...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411806,
					"content": "Я руководил всеми жертвоприношениями и принимал все твои дары!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411807,
					"content": "А она, заклеймённая твоей печатью и работавшая на твоё благо, отвергла твой дар и предала нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411808,
					"content": "Ты вообще о чём...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "А, ну... Прошу прощения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411810,
					"content": "Мы не должны сомневаться в его выборе. Мы должны продолжать терпеть, продолжать поклоняться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411811,
					"content": "Ты меня слышишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "Продолжать терпеть... Продолжать поклоняться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
					],
					"speakerTitle": "Васидзу"
