				{
					"id": 721410701,
					"content": "По сравнению с его огромным богатством это очень скромная награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410702,
					"content": "Молись, поклоняйся, слушай его и позволь ему услышать тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410703
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410703,
					"content": "И тогда ты, как и я, услышишь его слова из глубин своего сердца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410704
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410704,
					"content": "И «он» избавит тебя от страданий и щедро вознаградит тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410705,
						721410706
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410705,
					"content": "Ох...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "Помни: если ты будешь поклоняться три раза в день, тебя ждёт награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410708,
					"content": "Помни, помни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410706,
					"content": "Как скажешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				}
			]
		},
