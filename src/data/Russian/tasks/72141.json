			"dialogs": [
				{
					"id": 721410101,
					"content": "?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410102,
					"content": "Привет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "......",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410106,
					"content": "Ты меня слушаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410108,
					"content": "Привет?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "...Пожалуйста, не надо меня больше беспокоить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410111,
					"content": "Он несчастен. Так как возмущение, создаваемое словами языка, заглушает мудрость слов сердца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410112,
					"content": "Словами языка?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "Слова языка подобны шуму дождя: они сотрясают барабанные перепонки и будоражат разум.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410114,
					"content": "Слова Сердца подобны туману, который просачивается внутрь и обволакивает разум...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410116,
					"content": "Тсс!.. Он слушает, он говорит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410117,
					"content": "Не сотрясай воздух языком, не слушай ушами, слушай своим сердцем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410118,
					"content": "Подойди сюда. Поклонись, помолись, а затем слушай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410119,
					"content": "Не забудь поклониться три раза, три раза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410120,
					"content": "(Попробовать.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "Пожалуй, откажусь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "Кивни, если можешь говорить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "Чем ты занимаешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
