				{
					"id": 721411201,
					"content": "Он идёт! Не прекращай поклоняться! Ни в коем случае!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411202,
						721411203
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411202,
					"content": "С тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "Он не в духе, и он будет зол!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411205,
					"content": "Чем могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "А всё из-за кого? Из-за той женщины! Той, что отказывается платить дань! Гадкая подхалимка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411208,
					"content": "Женщины?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "Она убегает, но ей от него не скрыться! Восемнадцать пар кровожадных глаз! Тысячи острых клыков! Бесчисленное множество ртов и языков, непрерывно жаждущих крови!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411211,
					"content": "Она не скроется, не скроется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411212,
					"content": "Пустынная страна, несчастный попрошайка из леса, который мнит себя мудрецом! Никто из вас её не защитит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411213,
					"content": "Пожалуйста, успокойся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "Возьми дань и иди поклоняться! Поклоняйся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721411214,
					"content": "О, вот это хорошо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "Да ну её!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "О, как он будет зол!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "Он идёт!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				}
			]
		},
