					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410605,
					"content": "Он счастлив выше всякой меры, и те, кто возрадуется ему, будут вознаграждены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410606,
					"content": "Если по другую сторону не будет его награды, то она появится там завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410607,
					"content": "Ты хоть понимаешь, о чём говоришь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "Возвращайся в другой раз, и ты всё увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Васидзу"
				},
				{
					"id": 721410608,
					"content": "Прошу простить мою поверхностность, но я всё ещё не понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410603,
					"content": "Счастье слишком поверхностно, чтобы его услышать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				}
			]
		},
