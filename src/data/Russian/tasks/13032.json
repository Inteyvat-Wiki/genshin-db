			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арапурва",
					"Авин",
					"Ёимия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "Паймон хотела спросить... Что значит «не готова»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320102,
					"content": "Нара Авин вспомнила не всё. Нужны и воспоминания, и мечты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "Арапурва"
				},
				{
					"id": 130320103,
					"content": "Мечты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320104,
					"content": "Но я больше не могу ходить. Даже если я однажды поправлюсь, никто не знает, когда это случится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320105,
					"content": "Лишние тревоги. Нара Авин должна помнить: мечты связаны с твоей душой, а не с телом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "Арапурва"
				},
				{
					"id": 130320106,
					"content": "С душой?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320107,
					"content": "Дальше я не пойду. Нара Авин сама должна найти своего друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "Арапурва"
				},
				{
					"id": 130320108,
					"content": "А? Пропал, как сквозь землю провалился!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320109,
					"content": "И небо стало каким-то другим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320110,
					"content": "С моей душой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320111,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320112,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320113,
					"content": "Я... могу стоять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320114,
					"content": "Это совсем не трудно. И как будто так и надо. Словно я и не болела вовсе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320115,
					"content": "Эй, мы что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320116,
					"content": "Оказались внутри сна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "Ну да, с нами это не в первый раз. Поэтому он и велел не тревожиться. Во сне Авин снова может ходить и бегать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320118,
					"content": "Смотрите, я стою! Хи-хи, я держусь на ногах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320119,
					"content": "Это ведь прекрасно! Теперь мы можем отправиться на поиски Арашани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320120,
					"content": "Давай наперегонки? Заодно проверим, как быстро ты бегаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320121,
					"content": "Наверное, я ещё не полностью восстановилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320122,
					"content": "Да ладно, какая разница! Побежали! Я тебя обгоню, пусть ты и старше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320123,
					"content": "Ой, убежала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320124,
					"content": "Надо же. Паймон думала, ей понадобится какое-то время, чтобы привыкнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320125,
					"content": "Наверное, это и есть талант.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "Хи-хи, точно. Давай скорее за ними!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320126,
					"content": "Сила желания творит чудеса.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
		{
