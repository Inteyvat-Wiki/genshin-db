						"stepId": 1303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Авин",
					"Ёимия",
					"Арашани"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "Значит, мы пришли на нужное место? Но где же аранара? Паймон видит только большой камень.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320502,
					"content": "Я так счастлива... почти забыла это чувство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320503,
					"content": "Понимаете, если я остаюсь на месте, мой мир сжимается и становится крошечным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320504,
					"content": "Но пока я бегу вперёд, перед глазами появляются новые и новые картины, и мир кажется бесконечным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320505,
					"content": "Я не знаю, как у меня это получилось. Но понимаю, что вы мне очень помогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320506,
					"content": "Ой, неважно. Главное - тебе многое удалось вспомнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320507,
					"content": "Воспоминания символизируют наше прошлое, но их сила не только в этом. Ещё они способны пролить свет на будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320508,
					"content": "Болезнь уйдёт, и радость к тебе вернётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320509,
					"content": "Да! Спасибо, Ёимия! Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320510,
					"content": "Давайте дальше искать Арашани? Похоже, здесь его нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320511,
					"content": "Да... Но тогда почему звезда привела нас сюда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320512,
					"content": "И этот камень выглядит очень необычно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "Не знаю, как объяснить... но мне он почему-то кажется знакомым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320514,
					"content": "Как будто он был частью меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320515,
					"content": "Я знаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320516,
					"content": "Наверное, это её уруит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320517,
					"content": "Уруит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320518,
					"content": "(Ёимия мастер импровизации.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "#(Я уже и забыл{F#а} о нём...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "Это очень редкая руда, символ стремлений и мечты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320521,
					"content": "Если ты её видишь, значит, ты смогла отыскать утраченное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320522,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320523,
					"content": "Похоже на сказку... Я думала, что уже не верю в сказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320524,
					"content": "Но я рада, что вера ко мне вернулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320525,
					"content": "А? Она прошла за ней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320526,
					"content": "Давай за ними!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320527,
					"content": "Эй! Ёимия! Эй! Ну, выбора у нас нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320528,
					"content": "Кажется, ничего не изменилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320529,
					"content": "Давно не виделись, нара Авин. Очень давно, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "Арашани"
				},
				{
					"id": 130320530,
					"content": "Арашани...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320531,
					"content": "Почему ты такая грустная? О, я понимаю. Ты не грустная, а счастливая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "Арашани"
				},
				{
					"id": 130320532,
					"content": "Арашани! У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320533,
					"content": "Ха-ха, аранары устроили нам поистине волшебное путешествие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320534,
					"content": "Помогли Авин отыскать пропавшего друга, а ещё показали нам, что такое уруит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320535,
					"content": "И нам надо будет найти свой уруит! Чтобы сделать из него чистейшие линзы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320536,
					"content": "Да! Паймон уверена, у нас тоже всё получится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320537,
					"content": "Настоящее приключение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "Мне тоже было очень весело.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "Но сначала нужно проводить Авин в город. Иначе её мама с ума сойдёт от беспокойства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320540,
					"content": "Картина перед глазами напоминает сон. Спустя мгновение вы оказываетесь на прежнем месте.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1303206,
			"completionStepIds": [
				1303206,
				1303207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303206",
							"2"
						],
						"stepId": 1303206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Авин",
					"Ёимия",
					"Арашани",
					"Арапурва"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "Это... всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320602,
					"content": "Мы видели прекрасный сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320603,
					"content": "Не грусти! Ведь он рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320604,
					"content": "Арашани! Ты... ты не ушёл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320605,
					"content": "Арашани должен извиниться. Арашани хотел найти нару Авин. Просто Арашани плохо помнит время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Арашани"
				},
				{
					"id": 130320606,
					"content": "Арашани боялся идти в город. Арашани не видел нару Авин и решил, что нара Авин завела себе новых друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Арашани"
				},
				{
					"id": 130320607,
					"content": "Это нормально и неизбежно. Тут не о чем печалиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Арапурва"
				},
				{
					"id": 130320608,
					"content": "Всё в порядке, я понимаю. Просто я не могла собраться с силами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320609,
					"content": "Но теперь я понимаю. Ёимия права. У каждого бывают в жизни чёрные полосы, но главное - поддерживать друг друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320610,
					"content": "Спасибо, что помогли мне вернуть воспоминания и мечты. Ваши усилия не пропадут даром!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320611,
					"content": "Хе-хе, брось, ты нам тоже очень помогла! Ведь мы понятия не имели, где искать уруит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320612,
					"content": "Но теперь я думаю, мы его быстро найдём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320613,
					"content": "Ёимия, ты ищешь уруит, чтобы увидеть метеоритный дождь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320614,
					"content": "Да! И когда я его найду, ты сможешь полюбоваться дождём вместе с нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320615,
					"content": "Но тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320616,
					"content": "...давай я просто одолжу тебе свой уруит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320617,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320618,
					"content": "Что... что случилось? Ты что... достала линзу из своего сердца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320619,
					"content": "Я тоже не могу сказать с уверенностью.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Арапурва"
				},
				{
					"id": 130320621,
					"content": "Ха-ха-ха, как ты поняла, что это то, что мы ищем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320622,
					"content": "Не знаю. Просто ты помогла мне вернуть лучшего друга, и я решила, что должна помочь тебе. И взяла самое дорогое, что у меня есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320623,
					"content": "И вот. Это то, что тебе нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320624,
					"content": "Спасибо! Я не ожидала, что это будет так просто. Ну что, давайте испытаем прибор в деле!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320625,
					"content": "Я плохо понимаю, как этим пользоваться... Но ничего, интуиция подскажет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320626,
					"content": "Где же... Где же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320627,
					"content": "О! Я вижу! Да ещё так чётко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320628,
					"content": "Идём, я покажу дорогу! Посмотрим на метеоритный дождь, и я провожу тебя домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320629,
					"content": "Спасибо за помощь! Но вместо тысячи слов благодарности я хочу сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320630,
					"content": "Вы все прекрасные рассказчики!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320631,
					"content": "О, какое совпадение. То же самое я хотел сказать про тебя, красная нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапурва"
				}
			]
		},
