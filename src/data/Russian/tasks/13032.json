					}
				]
			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "Фух... фух... а ты быстро... бегаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320202,
					"content": "Хе-хе, ты почти меня обогнала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320203,
					"content": "Авин бегает ничуть не хуже Ёимии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320204,
					"content": "Раньше я часто обгоняла взрослых. В беге главное не длина ног, а тренировки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320205,
					"content": "Ха-ха, пройдёт ещё пара лет, и мне за тобой не угнаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320206,
					"content": "Так, давайте посмотрим... Куда нам идти дальше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Ёимия"
				},
				{
					"id": 130320207,
					"content": "Смотрите, там что-то парит в воздухе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 130320208,
					"content": "Это... звезда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Может, она хочет, чтобы мы шли за ней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Авин"
				},
				{
					"id": 130320210,
					"content": "Гм, наверное... Давайте попробуем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёимия"
				}
			]
		},
		{
			"id": 1303205,
