				},
				{
					"id": 411240802,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "От человека, которого выбрал тот господин, меньшего ожидать и не следовало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
