			"dialogs": [
				{
					"id": 411245201,
					"content": "Ты ещё не уходишь? Ах, да... У тебя есть какие-нибудь вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411245202,
					"content": "Кто всё-таки этот господин такой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "Хм. Мы с ним старые знакомые. Он упоминал, что вы с ним одно время сражались плечо к плечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411245204,
					"content": "Имени его я тебе назвать не могу, иначе у меня будут неприятности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411245205,
					"content": "Почему бы просто не поймать всех Похитителей сокровищ сразу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "Ты хочешь сказать... Если мы заманили три банды Похитителей и справились с ними, то остальные прознают об этом и сбегут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411245207,
					"content": "Всё верно, но замысел того господина в этом и заключается. Но не поймать, а встряхнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411245208,
					"content": "При таких обстоятельствах у рыцарей для такой крупной облавы слишком мало людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411245209,
					"content": "Пока нашей главной задачей остаются метеориты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411245210,
					"content": "Что же до Похитителей сокровищ... Нужно было, чтобы они пока прекратили свою деятельность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				}
			]
