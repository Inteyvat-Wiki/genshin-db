			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "Ой, ну наконец-то. Я заждалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240202,
					"content": "Чего это ты меня ждёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "#Ну, что ты так{F#ая}{M#ой} неприветлив{F#ая}{M#ый}? У меня для тебя есть одно очень важное поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240204,
					"content": "#Уверена, метеориты ты уже видел{F#а}. Мондштадт они обошли, но тем не менее в городе творится бардак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240205,
					"content": "А в мутной воде, как водится, рыба лучше ловится. Кое-кто хочет воспользоваться ситуацией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240206,
					"content": "Ты говоришь о Похитителях сокровищ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "#Вот, сразу видно тёртого искателя приключений. Ты очень проницател{F#ьна}{M#ен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240212,
					"content": "Рыцари теперь хоть и в состоянии повышенной готовности, но им пришлось отправить помощь в области вокруг города, из-за чего в защите остались прорехи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240213,
					"content": "А жадные до денег Похитители сокровищ уже наверняка прикидывают, как бы это проскользнуть в город и сорвать куш.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240214,
					"content": "Чем я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "Ох, сколько энтузиазма!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240216,
					"content": "Похоже, запасной план того господина был ни к чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240222,
					"content": "Короче говоря, тот господин лично задержал Похитителей сокровищ, которые ранее разведывали окрестности Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240223,
					"content": "По их словам, в город под шумок планируют проникнуть три банды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240224,
					"content": "Поэтому мы поможем им найти идеальную точку для вторжения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240225,
					"content": "Что делать мне?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "Твоя задача проста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240232,
					"content": "Чтобы избежать поимки, разведчики Похитителей сокровищ поддерживают связь с остальными бандами посредством писем, которые они оставляют в определённых местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240233,
					"content": "Три разведчика должны были доставить собранную информацию в три разных места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240234,
					"content": "Вряд ли они ожидали, что их схватит тот господин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240235,
					"content": "Остальные Похитители сокровищ начнут планировать следующий шаг и выберут место для вторжения только после того, как получат эти данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240236,
					"content": "Но теперь мы сэкономим им усилия - тот господин разработал для них подробнейший план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240237,
					"content": "Возьми эти три письма и отнеси их в указанные точки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240238,
					"content": "Когда закончишь, возвращайся ко мне. Остальное обсудим потом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240226,
					"content": "А они не солгали?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "#Ха-ха-ха, а ты осторожн{F#а}{M#ен}, хм? Не волнуйся, Похитители сокровищ - народец малодушный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240228,
					"content": "В конце концов, они всего лишь кучка воров, которым кроме денег ничего не нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240229,
					"content": "«Работайте с нами, и будет вам прибыток. Но чтобы без фокусов...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240230,
					"content": "После этого аргумента они любезно приняли все условия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240217,
					"content": "С этим могут справиться рыцари.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "Ха-ха-ха, твой ответ меня нисколько не удивил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240219,
					"content": "Не переживай. На этот раз тот господин выделил немало средств. В убытке ты не останешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240220,
					"content": "А если чего по ходу дела найдёшь, можешь оставить себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240221,
					"content": "К тому же справиться с этим делом больше никому не под силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240208,
					"content": "Ты говоришь о хиличурлах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "Ха-ха-ха, ну конечно же нет. Хиличурлам не хватит ума на такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240210,
					"content": "Пока они за городскими стенами, рыцари всегда смогут дать им отпор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240211,
					"content": "Я имела в виду Похитителей сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Вэл"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112406",
							"2"
						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "#Ты уже доставил{F#а} письма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240602,
					"content": "Все письма на своих местах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "Вот и славненько. Похитители сокровищ обязательно составят по ним свои планы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240604,
					"content": "А идеальное для вторжения время должно быть между наступлением ночи и рассветом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240605,
					"content": "Идеальная точка вторжения... Конечно же, она у нас одна. Я отмечу её на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240606,
					"content": "Готово. Теперь нам остаётся ждать, когда Похитители сокровищ попадут к нам в ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240607,
					"content": "Что, если об этом узнают рыцари Ордо Фавониус?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "Хм... Дельное замечание. Наши нетрадиционные методы могут навлечь рыцарский гнев...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240609,
					"content": "Тем не менее тот господин поручился, что ничего подобного не произойдёт. Давай просто... Доверимся ему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240612,
					"content": "Как наступит ночь, задай попавшим в ловушку Похитителям сокровищ знатную трёпку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 411240610,
					"content": "Что, если Похитители сокровищ не придут?",
