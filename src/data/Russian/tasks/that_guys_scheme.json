			"dialogs": [
				{
					"id": 411240801,
					"content": "#Ты уже позаботил{F#ась}{M#ся} о Похитителях сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240802
