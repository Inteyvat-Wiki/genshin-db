				"objectNames": [
					"Айлин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200440101,
					"content": "Ох, какая головная боль! Что же мне с этим делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440102,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "Готовлюсь к отборочным соревнованиям в Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440104,
					"content": "Ох... Мне никогда не стать такой же сильной, как Джинн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440105,
					"content": "Нужно больше уделять внимание технике, а не силе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440106,
					"content": "Например, я хочу срубить все эти деревянные чучела одним ударом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440107,
					"content": "Если у тебя найдётся минутка, подскажи, как это сделать, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440108,
					"content": "Надо подумать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "Конечно, не спеши. Эти чучела никуда не денутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440111,
					"content": "Да и я тоже никуда не денусь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440114,
					"content": "Если бы только у меня было оружие побольше или такие элементальные силы, как у Джинн, я бы разнесла эти чучела в щепки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440109,
					"content": "Давай попробуем вместе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "Тебе нравится командный бой? Всегда приятно знать, что ты не один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440113,
					"content": "Но я училась сражаться только в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Айлин"
				}
			]
		},
