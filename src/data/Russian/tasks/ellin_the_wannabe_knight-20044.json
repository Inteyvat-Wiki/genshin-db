			},
			"dialogs": [
				{
					"id": 200440201,
					"content": "#Ну что? Придумал{F#а} что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440202
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440202,
					"content": "Всё ещё думаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440203
					]
				},
				{
					"id": 200440203,
					"content": "Эх. Я встречала уже таких путешественников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440204
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440204,
					"content": "С монстрами они запросто разделываются, а вот с чучелами справится не могут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440205
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440205,
					"content": "А они ещё и укрепляют их, будто дом на сваях строят. Словом, переоценивают свои силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440206
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 200440206,
					"content": "Если им так нужны трудности, то почему бы им просто не пойти в лес и не найти там самого большого монстра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				}
			]
		},
