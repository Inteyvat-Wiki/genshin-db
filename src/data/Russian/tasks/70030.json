				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300301,
					"content": "#Ты {F#вернулась}{M#вернулся} ещё до того, как ветер принёс вести о твоём успехе. Поразительно... как тебе это удаётся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300302
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300302,
					"content": "#Хе-хе, {NICKNAME} наверняка ещё круче, чем ты думаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300303,
					"content": "Кхм-кхм. Этого хватит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300304
					]
				},
				{
					"id": 700300304,
					"content": "Позволь взглянуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
		{
			"id": 7003004,
			"completionStepIds": [
				7003007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003007",
							"2"
						],
						"stepId": 7003007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300401,
					"content": "Да, великолепные образчики. Их будет достаточно. Если их растереть в пасту и нанести на цитру, она должна будет пробудиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300402
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300402,
					"content": "Да, то самое знакомое чувство. Она пробудилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300403
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300403,
					"content": "Попробуй и ты. Отныне она твоя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300404
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300404,
					"content": "Что ты хочешь этим сказать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300405
					]
				},
				{
					"id": 700300405,
					"content": "Ха-ха, нельзя уже поэту выразиться прямо? Скажу тогда по-другому: эта цитра - мой тебе подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300406
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300406,
					"content": "Я вернулся в Ли Юэ, чтобы услышать этот уголок мира. Шёпот бесчисленных голосов, что разносится в оберегаемых Гео Архонтом древних землях, удовлетворил меня в полной мере...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300407
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300407,
					"content": "Конечно, если однажды она тебе опостынет, я приду за ней. Но... надеюсь, такого не случится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300408
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300408,
					"content": "Ладно, меня зовёт путь. Как в такие мгновения обычно говорят в Ли Юэ? Ах да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300409
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300409,
					"content": "#«До скорой встречи», {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		}
	]
