	"talks": [
		{
			"id": 7003001,
			"completionStepIds": [
				7003002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003002",
							"2"
						],
						"stepId": 7003002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Цзо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300101,
					"content": "#Эй, путешественни{F#ца}{M#к}! Давно не виделись. Как поживаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300102
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300102,
					"content": "Мы знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300103
					]
				},
				{
					"id": 700300103,
					"content": "#Э... Ты... совсем {F#позабыла}{M#позабыл} меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300104
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300104,
					"content": "#Я же старпом Алькора, Чжун Цзо! Ты {F#плавала}{M#плавал} с нами в Инадзуму, помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300105
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300105,
					"content": "#Что ты, Чжун Цзо, {NICKNAME} просто шутит. Конечно же мы тебя помним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300106,
					"content": "Ах, я так и знал! Мы всё же говорим о грозном «Алькоре», а я на нём старший помощник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300107
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300107,
					"content": "Кхм, значит... Тебе нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300108
					]
				},
				{
					"id": 700300108,
					"content": "Эм, вообще-то да, но не мне. Это тот малыш Кадзуха, временный член нашего экипажа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300109
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300109,
					"content": "Вы ведь с ним знакомы? Он присоединился к нам на обратном пути из Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300110
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300110,
					"content": "Не знаю почему, но всю дорогу назад он находился в отличном настроении. Он то и дело предлагал всем почитать стихи и попеть песни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300111
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300111,
					"content": "К сожалению, ни у кого на корабле, от капитана Бэй Доу до Малыша Юэ, нету такой... этой... хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300112,
						700300114
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300112,
					"content": "Утончённости!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300113
					]
				},
				{
					"id": 700300113,
					"content": "Точно! Утончённости! Ни капли её у нас нету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300116,
					"content": "Так что когда мы опустили якорь в Ли Юэ, он покинул корабль и ушёл любоваться природой. Думаю, ему надоели неотёсанные матросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300117
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300117,
					"content": "Но вскоре от него пришло сообщение, в котором он просил отыскать тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300118
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300118,
					"content": "У него неприятности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300119
					]
				},
				{
					"id": 700300119,
					"content": "Никаких подробностей не было. Он только просил передать тебе, что хочет поговорить с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300120
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300120,
					"content": "Какой-либо опасности я по сообщению не увидел. Но разве кто-нибудь станет беспокоить тебя по мелочам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300121
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300121,
					"content": "#Да ну, мы постоянно занимаемся всякими мелочами, не так ли, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300122,
						700300123,
						700300124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300122,
					"content": "Ага. Кормим голубей и всё такое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300125,
					"content": "О... Я бы в жизни не догадался, что ты всем помогаешь с такой неказистой работёнкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300126
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300126,
					"content": "Недаром капитан души в тебе не чает. У неё, знаешь ли, слабость к честным трудягам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300127
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300127,
					"content": "Ой, чего это я!.. Если можешь, посмотри, как там малыш Кадзуха. Насколько я знаю, он должен быть где-то к северу от Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300128
					],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300128,
					"content": "А у меня ещё остаются дела на корабле. Ещё увидимся. Доброго пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Цзо"
				},
				{
					"id": 700300123,
					"content": "Да. Разносим еду и тому подобное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300124,
					"content": "Точно. Помогаем с уборкой и подобными делами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300114,
					"content": "Странности!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300115
					]
				},
				{
					"id": 700300115,
					"content": "Нет-нет, я имел в виду утончённость! На всём корабле ни у кого не сыскать неё и капли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "Чжун Цзо"
				}
			]
		},
		{
			"id": 7003002,
			"completionStepIds": [
				7003004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003004",
							"2"
						],
						"stepId": 7003004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300201,
					"content": "Уж моста не видать, продолжает шептать моя одинокая цитра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300202
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300202,
					"content": "Эй, малыш Кадзуха! Что ты тут делаешь? Мы пришли на помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300203,
					"content": "О? Вы добрались. Рад видеть вас вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300204
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300204,
					"content": "Это обращение, «малыш Кадзуха»... в устах Паймон приобретает новый оттенок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300205
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300205,
					"content": "Хе-хе-хе, это Паймон от старпома Чжун Цзо научилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300206,
						700300207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300206,
					"content": "Ты выглядишь вполне беззаботно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				},
				{
					"id": 700300208,
					"content": "Ха-ха, почему ты так говоришь? По-твоему, я из тех, кто с грустной миной несёт свою тяжкую участь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300209
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300209,
					"content": "Нет, это Чжун Цзо сказал нам, что мы зачем-то тебе понадобились! Мы же не знали, что ты тут беззаботно любуешься видами и предаёшься поэзии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300210,
					"content": "События Инадзумы остались в прошлом и более меня не беспокоят. Само собой разумеется, по возвращении в Ли Юэ я принялся исследовать стихи и мелодии этой земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300211
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300211,
					"content": "Что же до вашей помощи - изначально такой необходимости не было. К сожалению, вы опоздали, поскольку потребность сия как раз появилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300212
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300212,
					"content": "Ой, голова кругом... «Изначально не было, но теперь вдруг появилась»... Что это всё значит?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300213,
					"content": "Ты что, странных грибов наелся? Околесицу какую-то несёшь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300214,
					"content": "Тсс. Послушайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300215
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300215,
					"content": "Что скажете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300216
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300216,
					"content": "Ну ты даёшь... Паймон думает, ты играешь не хуже одного нашего знакомого барда, который выступает за мелочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300217,
					"content": "#О, среди ваших друзей есть профессиональный бард? Хотелось бы однажды познакомиться с ним. А что думаешь ты, путешественни{F#ца}{M#к}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300218,
						700300219
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300218,
					"content": "По-моему, цитра сломана.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300220,
					"content": "Да, так и есть. Но главное, что она обладает одной особенной способностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300221
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300221,
					"content": "Я нашёл эту безымянную древнюю цитру в заброшенном пещерном жилище, когда исследовал горы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300222
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300222,
					"content": "Выглядела она старой, но целой. Вид её распалил моё сердце, и я сам не заметил, как принялся перебирать струны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300223
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300223,
					"content": "Когда зазвучала мелодия, я вдруг будто перенёсся в другой мир. Я слышал, как кто-то играет вместе со мной. Всё это казалось таким знакомым...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300224
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300224,
					"content": "Постой, ты точно ничего такого не съел? Такого, из-за чего видишь то, чего на самом деле нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300225,
					"content": "Вряд ли, поскольку мой разум стал ясным вновь, когда мелодия завершилась. И тогда я как следует осмотрел пещеру. Как и ожидалось, в ней было полно загадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300226
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300226,
					"content": "Пещера заросла сорняками. Хозяин, должно быть, давно её покинул. Но стол и стулья были безупречно чистыми и издавали тонкий аромат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300227
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300227,
					"content": "Даже постоянный шум ветра внутри затихал. Поистине чудесное место. Могу лишь предположить, что это была сокровищница одного из легендарных Адептов Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300228
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300228,
					"content": "Ох-хо-хо! Так эта цитра - сокровище Адепта?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300229,
					"content": "Ха-ха, кто её знает? Тем не менее то были чудесные мгновения, и я был просто обязан поделиться этим с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300230
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300230,
					"content": "Но в Ли Юэ помимо капитана Бэй Доу из друзей у меня только ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300231
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300231,
					"content": "Не думаю, что такое могло заинтересовать Бэй Доу, поэтому я решил поделиться с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300232
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300232,
					"content": "Я попросил Чжун Цзо разыскать тебя. Но, к сожалению, древняя цитра сломалась до твоего прихода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300233
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300233,
					"content": "Виноват в этом я. Не надо было всюду брать её с собой и играть так часто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300234
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300234,
					"content": "Ох... даже сокровища Адептов могут поломаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300235,
					"content": "Если даже могучий Электро Архонт не в состоянии дотянуться до вечности... что уже говорить об остальном?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300236
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300236,
					"content": "#Ой-ой, {NICKNAME}, т-ты уж с нашим Чайничком безмятежности осторожнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700300237,
					"content": "К счастью, её можно починить. Это нечто сродни спячке - заключённая в ней энергия со временем рассеялась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300238
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300238,
					"content": "Нужно лишь найти подходящий материал, и она пробудится вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300239
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300239,
					"content": "Если я не ослышался, материал этот... глазурная лилия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300240
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300240,
					"content": "Где ты это услышал?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300241
					]
				},
				{
					"id": 700300241,
					"content": "Как я уже говорил, с собою ветер несёт шёпот всего, что живёт в этом мире. Кое-что доносится и до меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300242
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300242,
					"content": "Поэтому история этой древней цитры в общих чертах мне знакома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300243
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300243,
					"content": "Иди же. Я буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300244
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300244,
					"content": "#Ты же {F#спасительница}{M#спаситель} Ли Юэ. Такая мелочь определённо не вызовет у тебя затруднений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 700300219,
					"content": "Эта цитра выглядит ценной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300207,
					"content": "Вид у тебя расслабленный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				}
			]
		},
