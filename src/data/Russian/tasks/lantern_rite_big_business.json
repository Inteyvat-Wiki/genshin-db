				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мистер Чжу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413340101,
					"content": "Должен же быть какой-нибудь способ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340102
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340102,
					"content": "Для чего?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340103
					]
				},
				{
					"id": 413340103,
					"content": "#А, путешественни{F#ца}{M#к}. Наступил Праздник морских фонарей, и я тут думал, как на время праздника маленько оживить свой бизнес...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340104
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340104,
					"content": "#Сам{F#а} посуди, место здесь отличное, красивые пейзажи, еда... У нас её в достатке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340105
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340105,
					"content": "Вот как это может быть... В городе будут запускать лунный фонарь, а у нас вкусные блюда, отменные напитки и замечательные виды. Должно получиться великолепно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340106
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340106,
					"content": "Это будет главным преимуществом для привлечения клиентуры. Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340107,
						413340108
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340107,
					"content": "А лунный фонарь отсюда будет видно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				},
				{
					"id": 413340109,
					"content": "Эм... Да ну, всё будет видно. Лунный фонарь огромный. Хоть чуточку, но будет видно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340110
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340110,
					"content": "Ну да ладно, к этому вернёмся позже. Мне сперва нужно подготовить гостиницу к наплыву клиентов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340111
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340111,
					"content": "#Путешественни{F#ца}{M#к}, могу ли я тебя попросить собрать материалы для небесных фонарей? Я хотел бы украсить ими гостиницу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340112,
						413340113
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340112,
					"content": "#Я мог{F#ла} бы заодно и сделать их...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340114,
					"content": "Материалов будет достаточно. Плести фонари - дело хлопотное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340115
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340115,
					"content": "Собранные материалы передай Болвану Бэню, а он займётся всем остальным. Да и мне нужно кое о чём позаботиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340116
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340116,
					"content": "Без вознаграждения ты, конечно же, не останешься. Ты его получишь, когда придут клиенты, а дела пойдут в гору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340117
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340117,
					"content": "А если никто не придёт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340118
					]
				},
				{
					"id": 413340118,
					"content": "Хм... Даже если клиентов не будет, у меня всё равно кое-что для тебя есть, не переживай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340119
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340119,
					"content": "Как приведём гостиницу в порядок, так клиенты и появятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340120
					],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340120,
					"content": "Кхм... Просто передай эти материалы Болвану Бэню. Твоё вознаграждение будет зависеть от того, как сложится ситуация завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мистер Чжу"
				},
				{
					"id": 413340113,
					"content": "Нужны только материалы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340108,
					"content": "Что-то мне говорит, что нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				}
			]
		},
