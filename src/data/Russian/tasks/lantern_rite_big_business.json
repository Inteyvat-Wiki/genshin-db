			"dialogs": [
				{
					"id": 413342701,
					"content": "#Путешественни{F#ца}{M#к}, прости за беспокойство, но... Не мог{F#ла} бы ты проводить нас на гору?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342702,
						413342703
					],
					"speakerTitle": "Цзянь Цю"
				},
				{
					"id": 413342702,
					"content": "Конечно, я провожу вас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342704
					]
				},
				{
					"id": 413342704,
					"content": "Прости, но мы пока... по определённым причинам вернуться в город не можем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342705
					],
					"speakerTitle": "Цзянь Цю"
				},
				{
					"id": 413342705,
					"content": "Мы рассчитываем на твою защиту. Скорее, в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342706
					],
					"speakerTitle": "Цзянь Цю"
				},
				{
					"id": 413342706,
					"content": "Мы запустим небесный фонарик и сразу продолжим наше путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзянь Цю"
				},
				{
