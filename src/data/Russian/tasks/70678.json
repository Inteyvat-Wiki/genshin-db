						],
						"pointId": 6
					},
					{
						"sceneId": 48000,
						"position": [
							39.722,
							0.239,
							21.347
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 706780301,
					"content": "Браво! Ещё одно завораживающее выступление!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780302
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780302,
					"content": "Хотите узнать новый секрет актёрского мастерства? Выучить какую-нибудь красивую или элегантную позу? Давайте я научу вас секретам актёрского мастерства, а вы за это подарите мне игрушечные медали из сундука. В знак нашей дружбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780303
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780303,
					"content": "Дружба - хорошая штука, верно? От одного слова тепло разливается по груди и животу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780304,
						706780306
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780304,
					"content": "Дружба - это и правда здорово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780305
					]
				},
				{
					"id": 706780305,
					"content": "Паймон поддерживает! Вот только тепло в животе... Как-то это странно звучит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706780308,
					"content": "Ладно. Но медали из сундука... Это ведь просто игрушки, разве они чего-то стоят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706780309,
					"content": "Если верить в их ценность, игрушечные медали будут стоить дороже золотых. В этом и кроется секрет магии иллюзии. Так говорила госпожа маг, хотя я не до конца понимаю, что значат её слова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780310
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780310,
					"content": "Секретами актёрского мастерства со мной тоже поделилась госпожа маг, когда я загадал желание. И если она считает обмен честным, всё в порядке, разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780311
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780311,
					"content": "Паймон это не нравится... В сказках всегда так и бывает! Просишь ведьму о чём-то, а потом узнаёшь, что должен заплатить неподъёмную цену...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706780312,
					"content": "Вовсе нет, вам не о чем беспокоиться! Во-первых, между госпожой магом и ведьмой огромная разница. А во-вторых, я сразу сказал, что хочу взамен игрушечные медали. Так что всё честно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780313
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780313,
					"content": "П-правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706780314,
					"content": "Ну конечно! К тому же... желание загадывал я, так что если кому и придётся платить по счетам, то только мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780315,
						706780316
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780315,
					"content": "...Ты говоришь это так гордо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780317,
					"content": "Мне так понравились ваши выступления, что я готов заплатить любую цену. Интересно, хватит ли в книге чистых страниц, чтобы написать ещё несколько глав?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780318
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780318,
					"content": "Не переживайте! Пусть сейчас пустых страниц не осталось, потом они обязательно появятся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780319
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780319,
					"content": "Скорей бы уже настал тот день, когда все пустые страницы будут заполнены историями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706780316,
					"content": "Мне всё равно неловко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780306,
					"content": "Тепло в животе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780307
					]
				},
				{
					"id": 706780307,
					"content": "Ради всего святого... Только не говори, что ты начинаешь думать о живых консервах, как только речь заходит о дружбе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "Паймон"
				}
			]
		},
