			"dialogs": [
				{
					"id": 706785101,
					"content": "Пока не всё готово... Прошу, подождите ещё немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706785102
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706785102,
					"content": "Если хотите, можете выйти на сцену и выступить ещё раз, а наградой вам будут игрушечные медали из сундука!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Волчонок"
