			"dialogs": [
				{
					"id": 751870101,
					"content": "#У него нет огненной отметины на роге... Это не {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870102,
					"content": "Эй, откуда здесь взялся этот малыш?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870103,
					"content": "Яйцо завриана из Очканатлана...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "Ой! Оно сохранилось с тех самых пор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870105,
					"content": "Р-р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "Агуара"
				},
				{
					"id": 751870106,
					"content": "Значит, это было яйцо тепетлизавра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870107,
					"content": "Паймон помнит, что человек, который охранял яйцо, дал ему имя... Значит, этого малыша зовут Агуара?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870108,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "Агуара"
				},
				{
					"id": 751870109,
					"content": "Ой, ты знаешь своё имя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870110,
					"content": "Р-р-р?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "Агуара"
				},
				{
					"id": 751870111,
					"content": "#Он остался без родных, совсем как наш {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870112,
					"content": "#Может, присоединишься к нам? Паймон и {NICKNAME} отлично умеют ладить с тепетлизаврами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870113,
					"content": "Р-р-р! Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "Агуара"
				},
				{
					"id": 751870114,
					"content": "Хе-хе, Паймон знала, что ты согласишься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870115,
					"content": "Вы повязываете Агуаре красный шарфик, как раньше повязывали малышу.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "Да... Предыдущий хозяин этого шарфика вырос и стал удивительным заврианом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 751870117,
					"content": "Агуара! Паймон надеется, что ты тоже вырастешь большим и счастливым!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
