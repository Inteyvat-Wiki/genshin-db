				]
			},
			"dialogs": [
				{
					"id": 747130101,
					"content": "#{NICKNAME} и Паймон! Давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130102
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130102,
					"content": "Фремине! Почему ты в водолазном шлеме?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747130103,
					"content": "Ты недавно выбрался из воды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130104
					]
				},
				{
					"id": 747130104,
					"content": "Угу... В последнее время под водой стало очень суматошно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130105
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130105,
					"content": "Водолазов там в несколько раз больше, чем раньше. Они повсюду вылавливают затонувшие грузы. Я стараюсь помогать, чем могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130106
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130106,
					"content": "Когда дно расчистят и водолазы уйдут, под водой снова станет так же тихо, как раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130107
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130107,
					"content": "Вот оно что... Наверное, такая суета тебе очень мешает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747130108,
					"content": "Спасибо за заботу, Паймон. К счастью, всё не так плохо. Я обнаружил несколько интересных находок, кое-какие антикварные вещицы и украшения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130109
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130109,
					"content": "«Отец» велела мне все ценные и красивые находки приносить на этот корабль... Она сказала, вы знаете, куда их приспособить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130110
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130110,
					"content": "Арлекино всё продумала! Если эти красивые вещицы лежали на дне без дела, может, теперь они послужат для украшения нашего океанариума?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747130111,
					"content": "Или даже так: давай мы отправимся на поиски вместе с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747130112,
					"content": "Вы уверены? Я не хотел бы отнимать ваше время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130113
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130113,
					"content": "Да перестань! Ты же сам сказал, что будешь поднимать со дна разные интересные вещицы, у которых нет хозяина, и отдавать их нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747130114,
					"content": "Мы не можем позволить тебе работать в одиночку! Нехорошо сидеть сложа руки и принимать награды, которые мы вовсе не заслужили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130115,
						747130116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747130115,
					"content": "И вообще, искать древности на дне очень интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				},
				{
					"id": 747130117,
					"content": "Тогда... я поделюсь с вами разведданными водолазов, это сбережёт вам много сил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130118
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130118,
					"content": "Если найдёте что-то ценное, решайте сами, куда это приспособить. Но если у находок есть законные владельцы... надо будет вернуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130119
					],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130119,
					"content": "Хорошо, понятно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747130120,
					"content": "Будьте осторожны и не заплывайте в незнакомые места. Если столкнётесь с опасностью, постарайтесь как можно скорее подняться на поверхность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фремине"
				},
				{
					"id": 747130116,
					"content": "Мы обожаем охотиться за подводными сокровищами!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				}
			]
		}
	]
}