			"dialogs": [
				{
					"id": 715380301,
					"content": "Ух ты, как здорово получилось! Вот только... мне нечего подарить тебе в ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380302,
					"content": "Вот, возьми десерт в благодарность за помощь. Твой подарок стоит того, чтобы проделать ради него такой долгий путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380303,
					"content": "Я довольно давно уехала из Фонтейна... Интересно, как проходят тренировки моих офицеров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380304,
					"content": "Пора составить программу проверки физической подготовки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шеврёз"
				}
			]
		}
