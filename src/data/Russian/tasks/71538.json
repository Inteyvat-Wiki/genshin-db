			"dialogs": [
				{
					"id": 715380101,
					"content": "#Привет, {NICKNAME}! С Праздником морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380102,
					"content": "Ты... расследуешь дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Меня заставили взять отпуск.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380105,
					"content": "Заставили... взять отпуск?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "Согласно правилам Палаты Жардинаж, все сотрудники должны отгулять свой отпуск до конца года.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380107,
					"content": "Отчёт по итогам года показал, что я не взяла ни одного выходного, так что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380108,
					"content": "Непростая у тебя работа...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "Нет. Наши офицеры работают по сменному графику, но я, как командир, всегда на службе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380111,
					"content": "Я также сталкиваюсь с большим количеством экстренных случаев, поэтому... забываю взять отпуск.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380112,
					"content": "В этом году я была не против остаться без отгулов, но мои офицеры и слышать об этом не хотели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380113,
					"content": "Они начали кричать о том, что «правила существуют для того, чтобы их соблюдать» и «командир должен подавать пример». В общем, они не приняли отказа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380114,
					"content": "Один из сотрудников Палаты Жестьон, работающих с нами, упомянул, что Ли Юэ - лучшее место для отдыха во время Праздника морских фонарей. Он тут же достал билет на корабль, и... И вот я здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380115,
					"content": "Надо отдать ему должное: в это время года Ли Юэ - зрелище, достойное внимания. Я только что вернулась из деревни Цяоин. Мне очень понравился десерт из чайных листьев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380116,
					"content": "Я купила несколько для своих товарищей из Особого патруля. Я планирую последовать местным традициям и сделать несколько подарочных конвертов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380117,
					"content": "Но... я не очень хорошо разбираюсь в таких вещах, и, что бы я ни делала, мне всё кажется неправильным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380118,
					"content": "#{NICKNAME}, как правильно делают подарочные конверты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Шеврёз"
				},
				{
					"id": 715380119,
					"content": "У меня есть несколько советов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "В Особом патруле все такие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Не похоже... что ты при исполнении.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
