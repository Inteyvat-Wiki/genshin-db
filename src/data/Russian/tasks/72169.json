				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690301,
					"content": "Кораяки... Интересно, почему его назвали кораяки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690302,
					"content": "Ладно, сперва приготовим, а вопросы оставим на потом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690303,
					"content": "Ага! Готово! «Крабовый кораяки».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690304,
					"content": "Я попробую одного краба! М-м-м, восхитительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721690305,
					"content": "Дай мне краба поменьше. Сомневаюсь, что справлюсь с большим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721690306,
					"content": "#А эта порция для тебя, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690307,
					"content": "Вот, возьми также описание рецепта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690308,
					"content": "#Это блюдо приготовить несложно, так что можешь попробовать сам{F#а}, если хочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690311,
					"content": "Далее мы отправимся в окрестности <color=#00E1FFFF>острова Ясиори</color>. Если получится, свидимся там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690309,
					"content": "Ладно, пора и мне поесть, э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690310,
					"content": "Эй! Джули! Оставь этого краба мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
