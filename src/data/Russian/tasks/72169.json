				"objectNames": [
					"Сюй Дун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "#А, путешественни{F#ца}{M#к}! Как идёт ловля крабов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690202,
					"content": "О, отличный краб. Да ты мастер этого дела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690203,
					"content": "Что ж, раз у нас есть все ингредиенты, пора приступать к готовке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721690204,
					"content": "#Путешественни{F#ца}{M#к}, приготовление займёт у меня какое-то время. Прошу тебя, подожди здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
		{
			"id": 7216903,
