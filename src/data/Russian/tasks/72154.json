					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540801,
					"content": "Что ты собираешься снимать на плёнку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "Ага! Хороший вопрос. Действительно хороший вопрос. Но по правде говоря, мне надо будет всё ещё обдумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540803,
					"content": "Думаю, съёмки могут быть практически на любую тему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540804,
					"content": "Любовь! Интрига! Борьба! Да и разнообразные легенды тоже могут стать темой фильма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540805,
					"content": "Хоть я считаю, что фильмы обладают неким особым шармом, который ещё предстоит в полной мере раскрыть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540806,
					"content": "И всё же я думаю, что найду ответ на этот вопрос, снимая фильмы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
