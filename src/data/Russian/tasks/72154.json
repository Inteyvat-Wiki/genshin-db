				"points": []
			},
			"dialogs": [
				{
					"id": 721540201,
					"content": "О нет, не удалось снять, как полагается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540202,
					"content": "Пожалуйста, снова приготовьтесь, и снимем ещё дубль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
			"id": 7215403,
			"completionStepIds": [
				7215403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215403",
							"2"
						],
						"stepId": 7215403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "#Идеально! {F#Героиня}{M#Герой} моего сердца меня не подв{F#ела}{M#ёл}! Великолепное исполнение! Вы и правда звезда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540302,
					"content": "А? Что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "Звезда! Так называют самого важного актёра в фильме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540306,
					"content": "Итак, господин солдат, полагаю, вы хорошо видели эту демонстрацию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540307,
					"content": "В целом, да. Взмахивая мечом, я должен сосредоточиться не столько на «действии», сколько на «позе», правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Тораносукэ"
				},
				{
					"id": 721540308,
					"content": "Если вам нужна только «поза»... У меня есть по этому поводу несколько идей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Тораносукэ"
				},
				{
					"id": 721540309,
					"content": "А? Отлично! Обсудите этот вопрос с вашими товарищами-солдатами. Скоро будем снимать очередной дубль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540310,
					"content": "#Путешественни{F#ца}{M#к}, хочу от души вас поблагодарить за помощь. Вот. Это для вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540311,
					"content": "Какая тема твоего следующего фильма?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "Следующего фильма, да? Ну... По правде говоря, я пока разрываюсь между несколькими темами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540313,
					"content": "Возможно, стоит изобразить традиции Великого храма Наруками? Или поведать сказания о кицунэ и тануки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540314,
					"content": "В Инадзуме масса островов, и можно рассказать столько всяких историй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540315,
					"content": "Но в любом случае сперва мне нужно закончить съёмки «Седьмого самурая».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540316,
					"content": "Если господа в высоких кабинетах будут довольны, то подозреваю, что последующие кинопроекты пойдут легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540304,
					"content": "#Возможно, в следующий раз я взял{F#а} бы другую роль.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "Вообще не вопрос! Как только этот фильм будет готов, начнём планировать совершенно новый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
