	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "Погодите! Господин солдат, слова, которые вы только что прочитали, несут не ту эмоциональную окраску.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540102,
					"content": "«Самурай, очищающий землю, точно ветер».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540103,
					"content": "Помните, что я говорил вам по поводу пьесы? Она должна давать зрителям ощущение свободной и лёгкой жизни. Я сказал, свободной! Свободной, понимаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540104,
					"content": "В этой реплике - квинтэссенция всей вашей роли. Эти слова должны выражать ваши эмоции до конца, полностью и совершенно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540105,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Тораносукэ"
				},
				{
					"id": 721540106,
					"content": "А кроме того, взмахивайте мечом не слишком быстро... И следите за тем, чтобы находиться в кадре, иначе кинокамера ничего не запечатлеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540107,
					"content": "Станьте в позу, потом сделайте паузу, понятно? На мгновение остановитесь, а потом с огромной силой опустите меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540108,
					"content": "Но когда с кем-то сражаешься, взмахнуть так мечом не получится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Тораносукэ"
				},
				{
					"id": 721540109,
					"content": "Верно, но игру нужно подстраивать под особенности съёмки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540110,
					"content": "Пожалуйста, снова приготовьтесь, и снимем ещё дубль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540111,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#А, это вы! Не иначе, {F#девушка}{M#юноша}, вас принесло сюда попутным ветром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540115,
					"content": "Как видите, снимаем здесь с солдатом фильм о головорезах. Я назвал его «Седьмой самурай».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540116,
					"content": "Н-да, «фильм о головорезах» - так я называю этот жанр кино.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540117,
					"content": "В этих фильмах должны быть сцены сражений на мечах, а зрители совершают невероятное путешествие на поле боя... Ну, по крайней мере, задумка такая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540118,
					"content": "Кто бы мог подумать, что у господина Тораносукэ найдётся время...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "Это произведение одобрено начальством. По их мнению, это поможет повысить престиж сёгуната.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Тораносукэ"
				},
				{
					"id": 721540120,
					"content": "При этом я понятия не имею, как это господину Ксавье удалось их убедить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Тораносукэ"
				},
				{
					"id": 721540123,
					"content": "Если честно, господин Микоси Гэндзиро такой... серьёзный человек. К счастью, вдобавок он очень понимающий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540124,
					"content": "Когда я откровенно с ним поговорил, он с радостью удовлетворил мою просьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540125,
					"content": "Но... Взамен я должен снять фильм, связанный с сёгунатом, желательно с главным героем-самураем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540126,
					"content": "Но меня в любом случае всегда интересовала эта тема, так что я, конечно же, согласился, и господин Микоси Гэндзиро тоже остался очень доволен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540127,
					"content": "Кроме того, что он дал мне в помощь нашего приятеля солдата, он ещё выделил мне хорошо обученные подразделения, а потом сказал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540128,
					"content": "«Используй сцены, где звонко лязгает сталь, чтобы показать величие самураев и сёгуната».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540129,
					"content": "Должен сказать, что господин Гэндзиро и правда проницательный человек. Так быстро осознал огромный потенциал кино как инструмента пропаганды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540130,
					"content": "А что до меня, я никогда не откажусь от предложения, если оно позволяет мне снимать фильмы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540131,
					"content": "Как идут съёмки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "По правде говоря, так себе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540133,
					"content": "Хоть эти солдаты и прекрасно обучены боевым искусствам, к подобного рода постановочным сражениям они непривычны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540134,
					"content": "Они не только слишком быстро бьют мечами, так что камера ничего не успевает снять. Они ещё частенько выпадают из кадра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540140,
					"content": "#Путешественни{F#ца}{M#к}, если у вас есть время, не согласитесь ли пройтись по сценарию и сыграть сюжет, чтобы солдаты посмотрели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540141,
					"content": "Думаю, с вашей силой и пониманием вы будете превосходно двигаться перед камерой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540142,
					"content": "Побывав в роли зрителей, солдаты должны лучше понять сюжет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540143,
					"content": "Давайте! Для начала просто прочтите сценарий и реплики. В этой части в основном сражения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540144,
					"content": "«Битва проиграна».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "Ой, это реплики из другой сцены... В этой сцене по большей части битвы, так что слов тут немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540148,
					"content": "Ладно, дай-ка взглянуть на сценарий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "О, кстати, вам предстоит сыграть роль Дзюсабуро. Вместе с ещё несколькими товарищами крестьяне наняли его защищать деревню...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540150,
					"content": "В этой сцене у одного из наших товарищей - Кюдзо - есть слова... Я буду играть за него, и мы с вами будем читать реплики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540151,
					"content": "А теперь вам нужно воплотиться в свою роль, почувствовать её! Просто думайте о себе как о Дзюсабуро. Понимаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540152,
					"content": "Понимаю, режиссёр.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "Замечательно! Превосходно! Браво!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540155,
					"content": "Скажите, когда будете готовы. А мне пока нужно отрегулировать положение камеры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540153,
					"content": "Я. Дзюсабуро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "«Но даже перед лицом гибели самурай остаётся самураем».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "«Вы все профессиональные пугала...».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "«...но наши враги - не воробьи».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "А что, если я сыграю роль?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#Конечно! Конечно! Вы, {F#моя героиня}{M#мой герой}, навсегда в моём сердце!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540137,
					"content": "Я всегда буду помнить, как мы вместе сыграли в «Сказаниях из Татары».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540138,
					"content": "И хотя эти солдаты и прекрасно владеют боевыми искусствами, они непривычны к подобным постановочным сражениям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540139,
					"content": "Они не только слишком быстро бьют мечами, так что камера ничего не успевает снять. Они ещё частенько выпадают из кадра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540121,
					"content": "Как вы убедили его помочь вам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Да ладно, наш дорогой солдат прекрасно меня понял. На самом деле, труднее всего мне было убедить господина Микоси Гэндзиро, чтобы разрешил мне снимать кино в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540112,
					"content": "«Самурай, очищающий землю, точно ветер».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "Вы произнесли эти слова с излишней страстью. А нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
