					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540701,
					"content": "#Я ещё не совсем готов{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540702
					]
				},
				{
					"id": 721540702,
					"content": "Что ж, не переживайте. Спешить не нужно - просто скажите, когда будете готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
