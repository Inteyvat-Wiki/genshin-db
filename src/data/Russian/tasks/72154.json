			"dialogs": [
				{
					"id": 721540601,
					"content": "#Я {F#готова}{M#готов}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540602
					]
				},
				{
					"id": 721540602,
					"content": "Славно. Тогда давайте начнём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540603
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721540603,
					"content": "Я внесу кое-какие корректировки в кинокамеру и поставлю солдат обратно на позицию - и сможем начинать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
			"id": 7215407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
