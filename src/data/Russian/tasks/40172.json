					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720202,
						401720204
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401720202,
					"content": "Давай начинать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720203
					]
				},
				{
					"id": 401720203,
					"content": "Хорошо, поехали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401720204,
					"content": "Мне нужно ещё немного времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720205
					]
				},
				{
					"id": 401720205,
					"content": "Как скажешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				}
			]
		},
		{
			"id": 4017203,
