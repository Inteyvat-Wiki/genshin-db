							"2"
						],
						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кунь Цзюнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "Что у тебя там, Кунь Цзюнь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210202,
					"content": "А, вы пришли очень кстати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210203,
					"content": "Удалось что-нибудь найти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210204,
					"content": "В этом куске руды могут быть зацепки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210205,
					"content": "Руды? Между пропавшими и рудой может быть связь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210206,
					"content": "Мы этого не узнаем, пока сами не проверим. Подождите немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210208,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210209,
					"content": "Так сильно сосредоточился... Что это он делает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210210,
					"content": "Вижу. Четыре человека... выходят из шахты за кем-то, похожим на ребёнка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210211,
					"content": "Ребёнка? Откуда в шахте взялся ребёнок?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210212,
					"content": "Сам не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210213,
					"content": "В каком смысле, «вижу»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210214,
					"content": "Ох! «Вижу» не в привычном смысле этого слова... Только никому не рассказывайте! Это несколько необычно... Я всегда держал это в тайне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210215,
					"content": "Я... могу видеть воспоминания руды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210216,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210217,
					"content": "Ты не угадываешь, не предполагаешь, но «видишь»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210218,
					"content": "То есть ты прикладываешь руку к камню, а потом... вжух! И готово?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210219,
					"content": "Я всегда чувствовал, что руда содержит «воспоминания». Иногда она запоминает, что происходило вокруг. Мне всего лишь остаётся прикоснуться к ней, сосредоточиться, и... прочитать её воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210220,
					"content": "Очуметь! Значит, ты можешь узнать всё, что тут происходило?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210221,
					"content": "Это зависит от типа руды. Некоторые обладают удивительно отчётливыми воспоминаниями. Другие же, как куски белого железа, мало на что годятся. Их воспоминания сильно размыты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210222,
					"content": "У кор ляписа и кристаллов память куда сильнее. Они запоминают события до мельчайших подробностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210223,
					"content": "Видящий через камень... Потрясающе. Поистине уникальная способность. Дядюшка Дай мудро поступил, наняв тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210224,
					"content": "Ха-ха, рад помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210225,
					"content": "Из увиденного мною следует, что они пошли по этому пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210226,
					"content": "Эта дорога ведёт на север, за пределы шахты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210227,
					"content": "Север... надо будет рассказать об этом дядюшке Даю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112103",
							"2"
						],
						"stepId": 1112103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Браво"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Ты здесь работаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210302,
					"content": "Ах, да, да! Вы, должно быть, пришли из-за пропавших. Прошу вас, отыщите их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Браво"
				},
				{
					"id": 111210303,
					"content": "Я... я не знаю, что произошло. В тот день было пасмурно. Начальник взял несколько парней и ушёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Браво"
				},
				{
					"id": 111210304,
					"content": "Я и ещё четверо остались работать в шахте. Потом я ушёл на перерыв... ну, на небольшой перерывчик!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Браво"
				},
				{
					"id": 111210305,
					"content": "Я прилёг под одним из навесов и заснул. А когда проснулся, от ребят и след простыл! Недавно же с ними разговаривал, и вдруг... исчезли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Браво"
				},
				{
					"id": 111210306,
					"content": "М-может, я следующий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Браво"
				},
				{
					"id": 111210307,
					"content": "Значит, пропали люди, которые работали снаружи, а тот, что спал внутри, остался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210308,
					"content": "Возможно, что-то случилось в рабочей части шахты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210309,
					"content": "Ах! Какой ужас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210310,
					"content": "Происшествие в рабочей части... так и запишем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Вон там! Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210402,
					"content": "Разбросанные рубашки, штаны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210403,
					"content": "Повседневная одежда... Должно быть, она принадлежит дядюшке Даю и его людям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210404,
					"content": "Одна, две, три, четыре...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210405,
					"content": "Хм... всё верно. Десять рубашек и десять пар штанов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210406,
					"content": "Это сменная одежда, так? Посмотрите, дядюшка Дай постоянно носит одинаковые наряды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210407,
					"content": "Эти четверо человек ушли на шесть дней без сменной одежды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210408,
					"content": "Тут ещё несколько платков и кусков мыла... И пара поясов для инструментов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210409,
					"content": "Предметы для умывания, шахтёрское оборудование...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210410,
					"content": "Получается, никаких припасов они с собой не взяли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210411,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210412,
					"content": "Может, они им были ни к чему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Маловероятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210415,
					"content": "Но кирки их отсутствуют. Похоже, они ушли вместе с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210416,
					"content": "У них было время взять инструменты, но не предметы ежедневного пользования. Любопытно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210417,
					"content": "Хм... Зачем было оставлять всё, кроме инструментов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210418,
					"content": "Вариант первый: они работали неподалёку, и остальные вещи были им не нужны. Но они не вернулись, поэтому такая версия не выдерживает никакой критики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210419,
					"content": "Вариант второй: их вынудили покинуть это место, и думать о припасах у них не оставалось времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210420,
					"content": "Ой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210421,
					"content": "Думаешь... их похитили?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Вполне вероятно. Для дальнейших заключений нам понадобится больше улик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210423,
					"content": "Возможно, они ушли не по своей воле... Запишем это и расскажем дядюшке Даю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210413,
					"content": "Может, они просто забыли о них?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дядюшка Дай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Вы вернулись! Как идёт расследование?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210702,
					"content": "В окрестностях мы нашли три зацепки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210703,
					"content": "Первое. Все предметы ежедневного пользования на месте, но четыре кирки отсутствуют. Это говорит о том, что рабочие ушли не сами, а кто-то их увёл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210704,
					"content": "Увёл?! Но... кто мог их похитить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210705,
					"content": "Второе. Изначально рабочих оставалось пять. Один из них решил устроить перерыв и заснул, а когда проснулся, его коллеги будто испарились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210706,
					"content": "Исчезли все, кто продолжил работать. Тот, который ушёл спать, остался цел и невредим. Видимо, инцидент случился в рабочей части шахты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210707,
					"content": "Да, помнится мне, Браво упоминал, что собирался передохнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210708,
					"content": "Получается, кто-то проник в шахту и увёл их?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210709,
					"content": "Что подводит меня к третьему пункту. Кунь мастерски воспользовался своими... экспертными навыками и заключил следующее: шахтёров увёл ребёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210710,
					"content": "Ребёнок?! Но в округе ни одного поселения! Ребёнок не мог просто взять и пойти в шахту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210711,
					"content": "Таков наш вывод. Ваши люди следовали за ребёнком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210712,
					"content": "К-куда они ушли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210713,
					"content": "Мы предполагаем, что они ушли по дороге на север от шахты к руинам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210714,
					"content": "На север! Хорошо, я соберу людей и начну поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210715,
					"content": "Вам помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Вы оказали нам неоценимую помощь с расследованием, поэтому беготню мы возьмём на себя. Если мы сейчас поспешим, то, может быть, ещё нагоним их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210717,
					"content": "Постойте. Инцидент произошёл шесть дней назад. Даже если они шли пешком, то могут быть очень далеко отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210718,
					"content": "Эх... Вы правы. Давайте так. Я поведу людей к отдалённым поселениям и поспрашиваю там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210719,
					"content": "Поселений в окрестностях шахты совсем немного. Этой частью расследования займёмся мы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210720,
					"content": "Могу ли я попросить вас продолжить поиск улик? Давайте разделимся. Если по пути не встретимся, то собираемся завтра вечером на постоялом дворе «Ваншу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210721,
					"content": "Идёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210722,
					"content": "Тогда мы с группой выдвигаемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210723,
					"content": "Значит, они поговорят с людьми в поселениях, а мы продолжим расследование здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210724,
					"content": "Верно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210725,
					"content": "Но... в шахте больше зацепок нет. Не лучше ли нам пойти на север?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210726,
					"content": "Постойте... кое-кого не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210727,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210728,
					"content": "Точно, где Кунь Цзюнь? Паймон уверена, он всё ещё занят расследованием. Давайте позовём его!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
							"2"
						],
						"stepId": 1112108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кунь Цзюнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Кунь Цзюнь, что это ты ищешь? Зацепки мы все уже нашли, идём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210802,
					"content": "Ах, простите. Я искал кое-что для себя. Мне нужен драгоценный камень, который называется «Жемчужина дракона».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210803,
					"content": "«Жемчужина дракона»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210804,
					"content": "#Никогда о таком не слышал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "Жемчужина дракона часто используется в ковке. Для чего она тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210807,
					"content": "Я... я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210808,
					"content": "Простите, я забыл, зачем её ищу. Последнее время я... сам не свой. Я помню только, как меня зовут да где живу, и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210809,
					"content": "Признаться, меня постоянно что-то тревожит... будто осталось незаконченное дело, о котором я забыл. Это очень неприятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210810,
					"content": "О, Паймон такое чувство знакомо! Когда забудешь о чём-то, а о чём именно, вспомнить не можешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210811,
					"content": "Уф... Я не знаю даже, с чего начинать, и просто иду, куда глаза глядят. В тот день на рынке я услышал разговор, в котором упомянули Жемчужину дракона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210812,
					"content": "Это название прозвучало до боли знакомым, будто я был с этим камнем связан... Поэтому я решил, что должен его найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210813,
					"content": "Кто знает, если он окажется у меня в руках, может, я вспомню, что именно должен сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210814,
					"content": "Понятно... Если я смогу, то во время нашего путешествия помогу тебе его найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210815,
					"content": "Правда? Спасибо, Чжун Ли! Я крайне благодарен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210816,
					"content": "Пустяки, не стоит благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210817,
					"content": "Не пора ли нам в дорогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210818,
					"content": "К северу от Разлома находится перевал Линцзю. Если они пошли по этому пути, то непременно должны были остаться следы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210819,
					"content": "Отлично! Давайте посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210805,
					"content": "Мне о таком неизвестно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
