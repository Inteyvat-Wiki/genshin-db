			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дядюшка Дай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Ого, какая эта шахта огромная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 111210102,
					"content": "Инцидент случился на этом самом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210103,
					"content": "Шесть дней назад я и пара моих людей вышли наружу по делам. По возвращении мы обнаружили, что те четверо, что остались в шахте, пропали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210104,
					"content": "Я прошёлся по всей шахте с поисковой командой, но не нашёл и следа. Тогда я решил обратиться за помощью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210105,
					"content": "Иными словами, четыре шахтёра бесследно пропали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210106,
					"content": "Верно. Нас было десять. Пропали Лун, Смельчак Цэнь, Храбрец Цэнь и Мао. Мы все работали вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210107,
					"content": "Обычно рабочие в этой области - молодые мужчины в самом расцвете сил. Не могли они просто перейти в другую шахту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210108,
					"content": "Сомневаюсь. Жилья в округе никакого нет, и по дороге мы других шахт не видели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210109,
					"content": "Хм... Размеры этой шахты впечатляют. Вы уверены, что осмотрели каждый уголок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Кунь Цзюнь"
				},
				{
					"id": 111210110,
					"content": "Мы здесь всё вверх дном перевернули, разве только не копали вглубь. Не могли же четыре здоровых мужика взять и провалиться сквозь землю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Дядюшка Дай"
				},
				{
					"id": 111210111,
					"content": "Прежде чем делать какие-либо выводы, нам необходимо осмотреться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 111210112,
					"content": "Хорошо, я буду ждать здесь. Для поисков вам открыта вся шахта. Если вы найдёте какие-нибудь следы пропавших, обязательно дайте знать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дядюшка Дай"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
