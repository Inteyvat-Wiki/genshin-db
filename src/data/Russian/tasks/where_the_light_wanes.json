				"objectNames": [
					"Хун Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "#Ты уже проверил{F#а} те места? Сколько удалось собрать фонарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "Хун Юй"
				},
				{
					"id": 718210302,
					"content": "Три фонаря.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "Спасибо большое. На сбор фонарей в тех местах у меня ушла бы куча времени. У меня после каждого похода по ним ноги отваливаются...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "Хун Юй"
				},
				{
					"id": 718210304,
					"content": "#Благодаря твоей помощи я могу хоть немного передохнуть. Вот твоя награда. Ты её заслужил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хун Юй"
				}
			]
		},
