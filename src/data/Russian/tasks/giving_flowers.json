				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Варша"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710101,
					"content": "Хм, странно, как тут оказался ребёнок? Что ты делаешь здесь одна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710102,
					"content": "#Ух! {M#Чудак}{F#Чудачка}-человек и умеющая летать чудачка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710103
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710103,
					"content": "Как это невежливо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710104,
					"content": "Ага, ведь у меня нет родителей, которые воспитывали бы меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710105
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710105,
					"content": "(Кажется, намечается что-то интересное...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710106
					]
				},
				{
					"id": 730710106,
					"content": "Ну, как бы тебе объяснить... В общем, мы не чудики и мы точно хорошие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710107,
						730710109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710107,
					"content": "Мы просто добрые путешественники.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710108
					]
				},
				{
					"id": 730710108,
					"content": "Всё верно, поэтому мы не оставляем никого в беде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710111,
					"content": "#Кстати, меня зовут Паймон, а это {NICKNAME}. А как тебя зовут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710112,
					"content": "Меня зовут Варша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710113
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710113,
					"content": "А что ты делаешь одна тут, Варша? Если ты потерялась, то мы поможем тебе найти дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710114,
					"content": "Прошлые дела пусть останутся в прошлом. А я решила идти вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710115
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710115,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710116,
					"content": "Я больше не буду рассчитывать на взрослых, хочу полагаться только на себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710117
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710117,
					"content": "Такая маленькая, а говоришь как взрослая... Но ведь в лесу очень опасно. А с некоторыми трудностями маленькие дети не могут справиться самостоятельно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710118,
					"content": "Меня уже почти похитил плохой дядя. Ничего, теперь я более осторожна. Со мной всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710119
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710119,
					"content": "Этого человека я раньше видела в деревне Вимара. Он кажется очень добрым. А на самом деле ничем не отличается от других взрослых...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710120
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710120,
					"content": "Тебя чуть не похитил плохой дядя? Ты так ничему и не научилась! Постой, а как тебе удалось убежать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710121,
					"content": "Что-то быстрое и маленькое привело меня сюда. Я никогда не видела таких существ в Гандхарве. Наверно, это был лесной эльф.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710122
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710122,
					"content": "(Скорее всего, аранара.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710123
					]
				},
				{
					"id": 730710123,
					"content": "(А взрослый из деревни Вимара... Неужели это...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710124,
					"content": "Как бы то ни было, маленькому ребёнку находиться в лесу небезопасно. А вдруг с тобой что-нибудь случится, например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710125,
					"content": "Нападут плесенники.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710126
					]
				},
				{
					"id": 730710126,
					"content": "Точно! Или ты столкнёшься с плохими взрослыми, например, нарой Мараной. Ой, нет, Паймон хотела сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710127,
					"content": "Вдруг тебя снова захотят похитить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710128
					]
				},
				{
					"id": 730710128,
					"content": "#Ага, {NICKNAME} говорит правду. Или... Или ты проголодаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710129,
					"content": "В лесу можно найти много чего съедобного, например, грибы-звёзды, цветки-сахарки и мяту. К тому же я ем мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710130
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710130,
					"content": "Кроме того, когда-то я ухаживала за растениями, поэтому легко найду укромное место, чтобы посадить цветки-сахарки и мяту. Так что я с лёгкостью смогу прокормить себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710131
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710131,
					"content": "Однако если где-то есть питомник, в котором повсюду будут расти цветки-сахарки, то это окажется настоящим раем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710132
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710132,
					"content": "У этого ребёнка такое богатое воображение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710133,
					"content": "Как бы то ни было, мне тут лучше, чем в Гандхарве. По крайней мере, меня тут не колотят. Я понимаю, что вы желаете мне добра, но на данный момент не надо беспокоиться обо мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710134
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710134,
					"content": "Эх, по ней и не скажешь, через что ей пришлось пройти. Однако, похоже, её не убедишь вернуться в Гандхарву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710135,
					"content": "Здесь не так уж и опасно. Если она снова встретится нам на обратном пути, то, может быть, ещё передумает к тому времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710109,
					"content": "#Мы ищем {F#исчезнувшего брата}{M#исчезнувшую сестру}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710110
					]
				},
				{
					"id": 730710110,
					"content": "Видя девочку без взрослых, мы, естественно, переживаем за тебя и хотим помочь тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7307102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307102",
							"2"
						],
						"stepId": 7307102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Варша"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "Чтобы получить больше цветков-сахарков, нужны семена. А вот хлеб не посадишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710202,
					"content": "Если бы хлеб можно было разломить пополам и посадить два куска в землю, чтобы выросли новые хлеба, то на земле не было бы голода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Варша"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Варша"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "Привет, Варша. Ты всё ещё тут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710302,
					"content": "#Паймон, {NICKNAME}, привет! Ага, у меня всё хорошо, так что можете не волноваться за меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710303,
					"content": "Не думала, что ты всё ещё будешь здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710304,
					"content": "Вы по-прежнему хотите убедить меня вернуться? Но я никуда не пойду с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710305,
					"content": "Ну, если ты сама не захочешь, то мы не будем заставлять. А помнишь, ты говорила про питомник, где повсюду растут цветки-сахарки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710306,
					"content": "Да это лишь моя фантазия. Я-то знаю, что такого не бывает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710307,
					"content": "Хм, а она всё так же рассуждает по-взрослому...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710308,
					"content": "Ладно, не будем об этом. У нас есть для тебя хорошие новости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710309,
					"content": "Питомник, где повсюду растут цветки-сахарки, на самом деле существует.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "Это правда! Ты, наверное, не поверишь, но спасшие тебя лесные духи зовутся аранарами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710311,
					"content": "Когда-то мы помогли им посадить много випариаса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710312,
					"content": "Мы помогли земле вспомнить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "Ага, Аранакула говорил, что вана помнит всё, поэтому как только земля проснётся, в питомнике появится випариас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710314,
					"content": "Когда-то я тоже слышала подобные сказки. Но только дети смогут поверить в них. Я знаю, что ты, Паймон, переживаешь за меня, спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710315,
					"content": "Так ты же и есть ребёнок? Паймон рассказывает не сказку, а реальную историю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710316,
					"content": "Ага, так говорит каждый взрослый, рассказывая сказку детям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710317,
					"content": "Ну, если ты не веришь нашим словам, пошли с нами - и ты увидишь всё собственными глазами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710318,
					"content": "Так вы специально подготовили такое место? Ну что ж, я хочу посмотреть на всё это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710319,
					"content": "Ох, Паймон говорит правду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710320,
					"content": "#{NICKNAME}, давай возьмём Варшу в питомник аранар. Пусть она сама увидит, что это правда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7307104,
			"completionStepIds": [
				7307105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307105",
							"2"
						],
						"stepId": 7307105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Варша"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710401,
					"content": "#Это всё {NICKNAME} и Паймон приготовили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710402
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710402,
					"content": "И да и нет. За этим питомником ухаживают Аранакула и Аракара, а мы всего лишь немного помогаем. И все эти цветы растут здесь не ради сказок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710403,
					"content": "Аранакула и Аракара - лесные эльфы? То есть аранары?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710404
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710404,
					"content": "#Ага. Ты наконец веришь словам Паймон? Хе-хе, мы, Паймон и {NICKNAME}, не только помогаем им с питомником, но и вместе пережили удивительные приключения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710405,
					"content": "Аранара помогали похищенным детям вернуться в деревню Вимара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710406,
					"content": "Мне всё равно трудно поверить, что Паймон говорит правду. А если я останусь здесь, то я увижу их?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710407
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710407,
					"content": "В Ванаране на самом деле не опасно, но ты действительно не хочешь вернуться в Гандхарву?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710408,
					"content": "У тебя память как решето, Паймон. Ведь я уже сказала, что больше не буду рассчитывать на взрослых, а буду полагаться только на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710409
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710409,
					"content": "Но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710410
					]
				},
				{
					"id": 730710410,
					"content": "Не надо так сильно переживать за меня. Ведь со мной ничего не случилось, пока я была одна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710411
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710411,
					"content": "К тому же я умею ухаживать за растениями. Если этот питомник станет ещё красивее, то и аранары будут очень рады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710412
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710412,
					"content": "Ну, раз ты просишь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710413,
					"content": "Ты так беспокоишься, Паймон. Насколько я помню, обо мне никто так не заботился, как Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710414
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710414,
					"content": "Ох, Варша, Ванарана - безопасное место, но ты всё ещё ребёнок. Поэтому береги себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710415,
					"content": "#Хорошо. Паймон и {NICKNAME}, вы тоже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Варша"
				}
			]
		},
		{
			"id": 7307105,
			"completionStepIds": [
				7307107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307107",
							"2"
						],
						"stepId": 7307107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Варша"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710501,
					"content": "Хм, странно, как тут оказался ребёнок? Что ты делаешь здесь одна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710502,
					"content": "#Ух! {M#Чудак}{F#Чудачка}-человек и умеющая летать чудачка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710503
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710503,
					"content": "Как это невежливо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710504,
					"content": "Ага, ведь у меня нет родителей, которые воспитывали бы меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710505
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710505,
					"content": "(Кажется, намечается что-то интересное...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710506
					]
				},
				{
					"id": 730710506,
					"content": "Ну, как бы тебе объяснить... В общем, мы не чудики и мы точно хорошие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710507,
						730710509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710507,
					"content": "Мы просто добрые путешественники.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710508
					]
				},
				{
					"id": 730710508,
					"content": "Всё верно, поэтому мы не оставляем никого в беде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710511,
					"content": "#Кстати, меня зовут Паймон, а это {NICKNAME}. А как тебя зовут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710512,
					"content": "Меня зовут Варша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710513
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710513,
					"content": "А что ты делаешь одна тут, Варша? Если ты потерялась, то мы поможем тебе найти дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710514,
					"content": "Прошлые дела пусть останутся в прошлом. А я решила идти вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710515
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710515,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710516
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710516,
					"content": "Я больше не буду рассчитывать на взрослых, хочу полагаться только на себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710517
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710517,
					"content": "Такая маленькая, а говоришь как взрослая... Но ведь в лесу очень опасно. А с некоторыми трудностями маленькие дети не могут справиться самостоятельно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710518
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710518,
					"content": "Меня уже почти похитил плохой дядя. Ничего, теперь я более осторожна. Со мной всё будет в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710519
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710519,
					"content": "Этого человека я раньше видела в деревне Вимара. Он кажется очень добрым. А на самом деле ничем не отличается от других взрослых...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710520
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710520,
					"content": "Тебя чуть не похитил плохой дядя? Ты так ничему и не научилась! Постой, а как тебе удалось убежать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710521,
					"content": "Что-то быстрое и маленькое привело меня сюда. Я никогда не видела таких существ в Гандхарве. Наверно, это был лесной эльф.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710522
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710522,
					"content": "(Скорее всего, аранара.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710523
					]
				},
				{
					"id": 730710523,
					"content": "(А взрослый из деревни Вимара... Неужели это...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710524
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710524,
					"content": "Как бы то ни было, маленькому ребёнку находиться в лесу небезопасно. А вдруг с тобой что-нибудь случится, например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710525,
					"content": "Нападут плесенники.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710526
					]
				},
				{
					"id": 730710526,
					"content": "Точно! Или ты столкнёшься с плохими взрослыми, например, нарой Мараной. Ой, нет, Паймон хотела сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710527,
					"content": "Вдруг тебя снова захотят похитить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710528
					]
				},
				{
					"id": 730710528,
					"content": "#Ага, {NICKNAME} говорит правду. Или... Или ты проголодаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710529,
					"content": "В лесу можно найти много чего съедобного, например, грибы-звёзды, цветки-сахарки и мяту. К тому же я ем мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710530
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710530,
					"content": "Кроме того, когда-то я ухаживала за растениями, поэтому легко найду укромное место, чтобы посадить цветки-сахарки и мяту. Так что я с лёгкостью смогу прокормить себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710531
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710531,
					"content": "Однако если где-то есть питомник, в котором повсюду будут расти цветки-сахарки, то это окажется настоящим раем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710532
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710532,
					"content": "Питомник, где повсюду растут цветки-сахарки... А в питомнике, где мы помогали аранарам, растёт много цветков-сахарков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710533
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710533,
					"content": "Паймон имеет в виду, что есть место, похожее на рай?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710534
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710534,
					"content": "Это правда! Ты, наверное, не поверишь, но спасшие тебя лесные духи зовутся аранарами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710535
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710535,
					"content": "Когда-то мы помогли им посадить много випариаса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710536
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710536,
					"content": "Мы помогли земле вспомнить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710537
					]
				},
				{
					"id": 730710537,
					"content": "Ага, Аранакула говорил, что вана помнит всё, поэтому как только земля проснётся, в питомнике появится випариас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710538
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710538,
					"content": "Когда-то я тоже слышала подобные сказки. Но только дети смогут поверить в них. Я знаю, что ты, Паймон, переживаешь за меня, спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710539
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710539,
					"content": "Так ты же и есть ребёнок? Паймон рассказывает не сказку, а реальную историю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710540
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710540,
					"content": "Ага, так говорит каждый взрослый, рассказывая сказку детям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710541
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710541,
					"content": "Ну, если ты не веришь нашим словам, пошли с нами - и ты увидишь всё собственными глазами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710542
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730710542,
					"content": "Так вы специально подготовили такое место? Ну что ж, я хочу посмотреть на всё это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710543
					],
					"speakerTitle": "Варша"
				},
				{
					"id": 730710543,
					"content": "Ох, Паймон говорит правду...",
