			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 761140301,
					"content": "(Что это? Похоже на недогоревшие записи...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140302,
					"content": "(Раньше ведь говорили, что господин Дервент приютил раненых искателей приключений. Видимо, это случилось совсем недавно.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140303,
					"content": "(Но зачем всё это сжигать?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		},
