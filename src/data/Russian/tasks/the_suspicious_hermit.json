			"dialogs": [
				{
					"id": 761140201,
					"content": "Здравствуйте! Есть кто дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140202,
					"content": "Господин Дервент, вы здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140203,
					"content": "...Кто там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140204,
					"content": "Это Ягода из Куратория тайн. Хотела задать вам пару вопросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140205,
					"content": "...Ладно, спрашивай. Я болен, вставать тяжело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140206,
					"content": "(Странно. Дети из Банды Раковины говорили, что господин Дервент учил их грамоте и говорил мягко, спокойно...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140207,
					"content": "(Голос у него хриплый, но не похоже, что из-за болезни. Видимо, он всегда так говорит...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140208,
					"content": "Вам плохо? Может, врача позвать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140209,
					"content": "...Нет, не надо. Скоро пройдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140210,
					"content": "Ладно. Как поправитесь - посетите Нашгород. Ваши друзья за вас волнуются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140212,
					"content": "(...Почему он молчит? Кажется, в доме кто-то ходит, слышны тяжёлые шаги...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140213,
					"content": "Вы ведь почти не выходите из дома последнее время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140214,
					"content": "Потому что усиленно занимаюсь самосовершенствованием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140215,
					"content": "Говорят, что и одеваетесь вы теперь не так, как раньше. Никто и не подумал бы, что вы такой крепкий, пока на вас была одежда отшельника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140216,
					"content": "И ещё эта маска, отсекающая энергию куувяки. Это что, новая мода?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140217,
					"content": "...Она отсекает лишний шум из внешнего мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140218,
					"content": "То есть это тоже часть вашего совершенствования?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140220,
					"content": "Недавно к вам заходил странствующий торговец. Вы не знаете, куда он потом ушёл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140221,
					"content": "...Без понятия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "Дервент"
				},
				{
					"id": 761140222,
					"content": "Х-хорошо... Тогда не буду больше мешать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140223,
					"content": "(Чувствую, если продолжу его расспрашивать, будут проблемы...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140224,
					"content": "(Да, они были правы. Он словно стал совсем другим человеком...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140225,
					"content": "(Слишком мало сведений, я не могу вернуться к госпоже Нефер с пустыми руками. Нужно изучить это место повнимательнее.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		},
