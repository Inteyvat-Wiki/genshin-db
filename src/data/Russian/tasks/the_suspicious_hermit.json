			"dialogs": [
				{
					"id": 761140101,
					"content": "Теперь мы ищем... «странного отшельника»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140102,
					"content": "Ну, отшельники, они и так странные. Живут в глуши, что бы они ни творили - это неудивительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140103,
					"content": "Но любое изменение не бывает беспричинным, будь оно вызвано внутренними причинами или внешними обстоятельствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761140104,
					"content": "Кроме того, пропавший бродячий торговец тоже настораживает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761140105,
					"content": "Что? Но в тех местах полным-полно опасностей. Разбойники, чудовища... Да мало ли что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761140106,
					"content": "Если уж это общеизвестно, значит, торговцы, которые часто там ходят, должны иметь какие-то способы защиты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761140107,
					"content": "Тем не менее опытный торговец пропал бесследно. Должно быть, тут скрыта причина, о которой никто не знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761140108,
					"content": "Ягода, на этот раз тебе предстоит навестить этого «странного отшельника».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761140109,
					"content": "Путь дальний. Держись главной дороги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761140110,
					"content": "Хорошо, босс! Я не подведу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		},
