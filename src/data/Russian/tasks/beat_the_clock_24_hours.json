			"dialogs": [
				{
					"id": 750141320,
					"content": "Паймон от страха с ног до головы покрылась холодным потом! Хорошо, что Паймон успела спрятаться! Иначе она бы не обратила внимания на заврианов, а схватила бы Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750141321,
					"content": "Паймон, ты бросила нас и сбежала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141322
					]
				},
				{
					"id": 750141322,
					"content": "Р-р-р...",
