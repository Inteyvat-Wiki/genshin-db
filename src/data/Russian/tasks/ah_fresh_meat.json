			},
			"dialogs": [
				{
					"id": 701060201,
					"content": "Вот цельномороженое мясо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Выглядит очень неплохо... Хм, теперь недостаёт лишь одного ингредиента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060203,
					"content": "Доводилось ли тебе слышать о Короле снежных кабанов? Говорят, этот свирепый зверь живёт далеко в горах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060204,
					"content": "В рецептах говорится, что его изысканное мясо подойдёт для любого метода готовки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060205,
					"content": "#Путешественни{F#ца}{M#к}, ты мне с этим поможешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060206,
					"content": "Что я за это получу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Я кое-что для тебя уже приготовил, не переживай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Харрис"
				}
			]
		},
