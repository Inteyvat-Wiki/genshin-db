			"trigger": {
				"objectNames": [
					"Харрис"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Ещё бы парочку ингредиентов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "#О, привет, путешественни{F#ца}{M#к}. Я как раз совершенствую один древний рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060104,
					"content": "Недавно в горы ходила одна исследовательская группа. Среди них был мой друг, искатель приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060105,
					"content": "Из-за плохих погодных условий далеко они не зашли. Знакомый мой, однако, говорил, что группа, пытаясь укрыться от метели, набрела на древние руины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060106,
					"content": "Там они обнаружили разные книги и записи. Среди них даже был... рецепт, который на удивление хорошо сохранился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060107,
					"content": "Таким образом рецепт попал ко мне. Теперь я должен попробовать воссоздать это старинное блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060108,
					"content": "Признаться, о многих ингредиентах в рецепте я даже не слышал, а некоторые способы готовки вижу впервые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060109,
					"content": "Поэтому рецепт пришлось изменить, оставив только ключевые ингредиенты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060118,
					"content": "Как ты смотришь на то, чтобы помочь мне собрать необычные ингредиенты для рецепта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060110,
					"content": "#Буду {M#рад}{F#рада}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "Я очень рад твоему энтузиазму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060113,
					"content": "Слыхал я, что в горах заблудилось и замёрзло несколько поросят. Мне любопытно, как мороз повлиял на вкус их мяса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060114,
					"content": "#Поэтому я хотел бы, чтобы ты разыскал{F#а} этих поросят и прин{F#есла}{M#ёс} мне десять кусков цельномороженого мяса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060115,
					"content": "Цельномороженого мяса?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Это я так назвал мясо замёрзших поросят. Ведь мясо, которое благодаря льду сохранило особенную свежесть, именно цельномороженое! Ха-ха-ха, неплохое название, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060117,
					"content": "#Спасибо, что вызвал{F#ась}{M#ся} помочь мне. Когда соберёшь ингредиенты - возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Харрис"
				},
				{
					"id": 701060112,
					"content": "Какие ингредиенты тебе нужны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
