			},
			"dialogs": [
				{
					"id": 726770701,
					"content": "#{NICKNAME} очень сильн{F#ая}{M#ый}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770702,
						726770703
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770702,
					"content": "Ну так себе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "#{NICKNAME} и Паймон часто сражаются?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770705,
					"content": "Если подумать, цель нашего путешествия - помочь тебе найти потерянного родного человека, но по пути мы то и дело ввязываемся в драки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770706,
					"content": "Ничего. Мне нравится драться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770707
					]
				},
				{
					"id": 726770707,
					"content": "Ну... Это классно и всё такое, но наверняка есть занятия и получше, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770710,
					"content": "#Когда я стану великим бакэ-дануки, я буду таким же сильным, как {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770711
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770711,
					"content": "Конечно, Китибоси! Но ты должен пообещать Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770712,
					"content": "Что пообещать, Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770713
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770713,
					"content": "Ну... Кхм! Пообещай, что, когда ты станешь великим бакэ-дануки, как Иорой, то никогда-никогда не будешь обижать маленьких и лезть без причины в драки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770714,
					"content": "#Нельзя быть, как тот огненный цветок, который стал плеваться огнём, только завидев {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770715,
					"content": "А когда можно лезть в драки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770716,
						726770717,
						726770718
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770716,
					"content": "Только когда защищаешь себя...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770719,
					"content": "Мм... Не понятно, но я обещаю тебе, Паймон. Не обижать маленьких и не лезть без причины в драки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770720
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770720,
					"content": "Умница, Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770721
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770721,
					"content": "А теперь... Хм, осталось последнее из восьми мест, о которых говорил Иорой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770722
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770722,
					"content": "Мм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770717,
					"content": "Только когда защищаешь других...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770718,
					"content": "Когда ты отстаиваешь то, что правильно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770708,
					"content": "Драться так утомительно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770709
					]
				},
				{
					"id": 726770709,
					"content": "Да, но иногда без этого не обойтись, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770703,
					"content": "Просто мы столько раз с таким сражались.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				}
			]
