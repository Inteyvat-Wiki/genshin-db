						726770806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770806,
					"content": "Мм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770807
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770807,
					"content": "Можно отвести Китибоси посмотреть на большой пылающий цветок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770808
					]
				},
				{
					"id": 726770808,
					"content": "А? Неужели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770809,
						726770810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770809,
					"content": "Тут совсем недалеко есть Пиро орхидея.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				},
				{
					"id": 726770811,
					"content": "Пусть это будет сегодняшней тренировкой Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770810,
					"content": "Идём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				}
			]
