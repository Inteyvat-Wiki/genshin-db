			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726770301,
					"content": "Такой большой! Такой горячий! Так здорово иметь большой огненный цветок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770302,
					"content": "Да, вот так. И...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770303,
					"content": "Китибоси, подожди. Давай тебя сфотографируем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
