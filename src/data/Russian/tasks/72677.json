					"nextDialogs": [
						726770804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770804,
					"content": "Паймон, а если бы у нас был большой цветок, мы бы смогли растопить весь снег на Снежной горе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770805
					],
					"speakerTitle": "Китибоси"
				},
				{
