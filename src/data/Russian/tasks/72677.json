						726770402
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770402,
					"content": "Хи-хи, теперь ты понимаешь, Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770403,
					"content": "Ммм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770404
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770404,
					"content": "Что понимает, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770405
					]
				},
				{
					"id": 726770405,
					"content": "А ты представь, если бы мы тебя рисовали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770406,
					"content": "Именно поэтому мы решили сделать фото, а не рисовать. Не потому, что нам безразлично, а потому что мы заботимся о тебе и хотим потратить меньше времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770407,
						726770408,
						726770409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770407,
					"content": "О, так вот что ты задумала!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770410,
					"content": "Понимаю. Фото, хорошо. Очень... жарко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770411
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770411,
					"content": "Давайте поскорее избавимся от источника тепла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770412
					]
				},
				{
					"id": 726770412,
					"content": "Ммм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770408,
					"content": "Просто слов нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770409,
					"content": "Ты права, но тут очень уж жарко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				}
