					"content": "В этом раскалённом месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "В этом и смысл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770306
					],
					"speakerTitle": "Паймон"
				},
				{
