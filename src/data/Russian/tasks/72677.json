			"dialogs": [
				{
					"id": 726771001,
					"content": "Вид отсюда просто супер. Правда же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771002
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771002,
					"content": "Столько воды. Цвет просто супер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771003,
						726771008,
						726771011
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771003,
					"content": "Вы вдвоём разговариваете так, словно вы близняшки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#Но тут правда просто супер! А как ты опишешь этот цвет, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771005,
					"content": "Как Крио...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "Как что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771013,
					"content": "Хотя тут и правда просто супер. Здесь Паймон хочет рисовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771014,
					"content": "Паймон, ты умеешь рисовать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "Паймон может научиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771016,
					"content": "Рисовать... Но рисовать так тяжело. Я смотрел, как рисовал Утамаро. Долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771017,
					"content": "Если у людей есть фотографии, то зачем тогда рисовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771018,
					"content": "#Эм... Да, {NICKNAME}, зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771019,
					"content": "Думаю, потому что люди жаждут создать что-то своё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "Хм, в этом что-то есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771024,
					"content": "Когда рисуешь сам - вкладываешь душу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "Это правда. Не так-то просто мазок за мазком нарисовать целую картину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771026,
					"content": "Мм... Значит, фотографировать меня просто и без души?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771027,
					"content": "А? Н-нет, ты не так понял. Мы просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771028,
					"content": "Понимаешь, рисовать долго. Это утомительно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "Точно! Если мы будем долго рисовать, у тебя ноги затекут стоять на одном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771030,
					"content": "Я всё время стоял, когда был запечатан в камне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771031,
					"content": "Я долго пробыл в камне, а когда освободился, то ноги очень болели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771032
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771032,
					"content": "Ой, наверное, было очень больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771033
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771033,
					"content": "Но Паймон умеет вжух-вжух, так что ноги не будут болеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771034
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771034,
					"content": "Эй! Когда летаешь - работает всё тело. Это очень утомительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771035
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771035,
					"content": "Ого! Огненный цветок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771036
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771036,
					"content": "Эй, ты вообще слушаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771037
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771037,
					"content": "Ты о пылающем цветке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771038
					]
				},
				{
					"id": 726771038,
					"content": "Ну конечно! В лесу Тиндзю совсем не растёт пылающих цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771039
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771039,
					"content": "Хочешь цветочек, Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771040
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771040,
					"content": "Хочу! Он такой тёплый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771041
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771041,
					"content": "#Тогда попроси хорошо {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771042
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771042,
					"content": "#{NICKNAME}, хочу! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771043
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771043,
					"content": "Как-то неискренне. Или все бакэ-дануки так разговаривают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771021,
					"content": "Потому что фотокамеры очень дорогие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771022
					]
				},
				{
					"id": 726771022,
					"content": "Что? Дорогие? А наша не сломается? Мы ведь тащим её и в битвы, и на горы, и в воду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771023
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771023,
					"content": "Уф, в следующий раз будь аккуратнее, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771006,
					"content": "Как Анемо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771008,
					"content": "Ох, вы двое обладаете таким великолепным словарным запасом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771009
					]
				},
				{
					"id": 726771009,
					"content": "Мм, великолепным, как Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771010
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726771010,
					"content": "#Ну, Паймон не думает, что {NICKNAME} имеет в виду именно это... Но ты всё равно очень умный, Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726771011,
					"content": "Вид просто супер!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771012
					]
				},
				{
					"id": 726771012,
					"content": "#Хм, {NICKNAME}, а как же словарный запас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}