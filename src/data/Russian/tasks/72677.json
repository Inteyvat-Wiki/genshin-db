			},
			"dialogs": [
				{
					"id": 726770101,
					"content": "Вид отсюда просто супер. Правда же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770102,
					"content": "Столько воды. Цвет просто супер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770103,
					"content": "Вы вдвоём разговариваете так, словно вы близняшки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#Но тут правда просто супер! А как ты опишешь этот цвет, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770105,
					"content": "Как Крио...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "Как что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770113,
					"content": "#Хотя тут и правда просто супер. {NICKNAME}, помнишь того художника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770114,
					"content": "Ты о Вермеере?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "Да, точно! О нём! Помнишь, мы помогли ему вставить светящиеся жемчужины в статуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770118,
					"content": "Он даже подарил нам картину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770119,
					"content": "Это она?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "Да, именно! Смотри, Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770121,
					"content": "Мм! Очень похоже! Это фото?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770122,
					"content": "Нет, это нарисовали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770123,
					"content": "Э? Если у людей есть фотографии, то зачем тогда рисовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770124,
					"content": "#Эм... Да, {NICKNAME}, зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770125,
					"content": "Думаю, потому что люди жаждут создать что-то своё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "Хм, в этом что-то есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770130,
					"content": "Когда рисуешь сам - вкладываешь душу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "Это правда. Не так-то просто мазок за мазком нарисовать целую картину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770132,
					"content": "Мм... Значит, фотографировать меня просто и без души?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770133,
					"content": "А? Н-нет, ты не так понял. Мы просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770134,
					"content": "Понимаешь, рисовать долго. Это утомительно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "Точно! Если мы будем долго рисовать, у тебя ноги затекут стоять на одном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770136,
					"content": "Я всё время стоял, когда был запечатан в камне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770137,
					"content": "Я долго пробыл в камне, а когда освободился, то ноги очень болели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770138,
					"content": "Ой, наверное, было очень больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770139,
					"content": "Но Паймон умеет вжух-вжух, так что ноги не будут болеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770140,
					"content": "Эй! Когда летаешь - работает всё тело. Это очень утомительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770141,
					"content": "Ого! Огненный цветок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770142,
					"content": "Эй, ты вообще слушаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770143,
					"content": "Ты о пылающем цветке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "Ну конечно! В лесу Тиндзю совсем не растёт пылающих цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770145,
					"content": "Хочешь цветочек, Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770146,
					"content": "Хочу! Он такой тёплый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770147,
					"content": "#Тогда попроси хорошо {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}, хочу! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770149,
					"content": "И так разговаривают все бакэ-дануки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770127,
					"content": "Потому что фотокамеры очень дорогие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "Что? Дорогие? А наша не сломается? Мы ведь тащим её и в битвы, и на горы, и в воду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770129,
					"content": "Уф, в следующий раз будь аккуратнее, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770116,
					"content": "Какого художника?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "Вермеера! Помнишь, мы помогли ему вставить светящиеся жемчужины в статуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770106,
					"content": "Как Анемо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "Ох, вы двое обладаете таким великолепным словарным запасом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "Мм, великолепным, как Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 726770110,
					"content": "#Ну, Паймон не думает, что {NICKNAME} имеет в виду именно это... Но ты всё равно очень умный, Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726770111,
					"content": "Вид просто супер!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#Хм, {NICKNAME}, а как же словарный запас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
