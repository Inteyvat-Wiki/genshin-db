						],
						"pointId": 310702025
					}
				]
			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#Рада видеть тебя в этих краях, {NICKNAME}. Ты, должно быть, тоже прибыл{F#а} на Праздник морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350202,
					"content": "Делаешь подарочный конверт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Да, пытаюсь сделать конверт для Кандакии, но пока что результат меня не устраивает. Я как раз собиралась начать с самого начала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350204,
					"content": "Кандакия не с тобой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Ещё нет, но она скоро прибудет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350206,
					"content": "Сперва она не соглашалась ехать со мной в Ли Юэ. Сказала, что должна остаться и защищать деревню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350207,
					"content": "А я сказала, что в конце года каждый заслуживает того, чтобы расслабиться. Мне предстояло сопровождать караван в Ли Юэ, и она могла бы поехать со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350208,
					"content": "Я даже предложила, чтобы мои люди присмотрели за деревней, пока её не будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350209,
					"content": "Но мне не удалось её убедить. В итоге она передумала только потому, что жители деревни настойчиво просили её отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350210,
					"content": "Но даже тогда она продолжала настаивать на том, чтобы сначала закончить кое-какие дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350211,
					"content": "Но караван не может ждать... Так что я здесь одна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350212,
					"content": "Было непросто выбрать подарок - здесь столько всего достойного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350213,
					"content": "В итоге я купила ей ожерелье, но потом услышала о традиции дарить подарочные конверты на Праздник морских фонарей, и решила попробовать сделать такой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350214,
					"content": "И, ну... Как я уже сказала, результат меня не устраивает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350215,
					"content": "#Уверена, ты знаешь об этом больше меня, {NICKNAME}. Дашь пару советов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350216,
					"content": "Хорошо, дай посмотрю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
