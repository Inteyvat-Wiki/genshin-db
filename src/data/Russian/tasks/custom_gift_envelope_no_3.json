			"dialogs": [
				{
					"id": 715350401,
					"content": "О? У тебя золотые руки! Конверт очень красивый, спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350402,
					"content": "Будем считать, что это твой подарок мне! Сейчас мне нечего подарить тебе в ответ, но как только вернусь в Сумеру, я обязательно пришлю тебе что-нибудь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350403,
					"content": "Осталось сделать ещё один для Кандакии, чтобы подарить вместе с ожерельем. Уверена, она будет в восторге!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Дэхья"
				},
				{
					"id": 715350404,
					"content": "Интересно, она уже в Ли Юэ? Давненько мы с ней не виделись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дэхья"
				}
			]
		}
	]
