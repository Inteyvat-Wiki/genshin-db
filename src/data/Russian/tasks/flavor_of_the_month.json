			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Брук"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "#Ты вернул{F#ась}{M#ся}! Ну как, удалось найти сырое мясо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000702,
					"content": "Да, вот оно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "Ну-ка, дай его сюда... Выглядит очень свежим. Да, такое мясо подойдёт. Мы сделаем его основным ингредиентом. Теперь нам нужно найти подходящую приправу, которая бы смогла раскрыть «вкус ветра»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000704,
					"content": "И что же может раскрыть этот вкус? Конечно, это семена одуванчика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000705,
					"content": "#Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты собрать для меня немного семян одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000706,
					"content": "Хорошо, я займусь этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "Большое спасибо! А я пока пойду готовить мясо. Как соберёшь семена, сразу возвращайся назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Брук"
				}
			]
		},
