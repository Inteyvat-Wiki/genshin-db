			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аллан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "В-вы спасли меня... Большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 708000602,
					"content": "Никогда не думал, что охота на лесного кабана может навлечь на меня такую опасность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 708000603,
					"content": "Мы за ингредиентами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "Ох, вас прислала Брук? Я уже добыл для неё свежее мясо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 708000605,
					"content": "Всё моё внимание было сосредоточено на кабанах, и я не заметил монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 708000606,
					"content": "Мне удалось добыть мяса, но потом они окружили меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 708000607,
					"content": "#Можно попросить тебя отнести это мясо Брук, путешественни{F#ца}{M#к}? А я тем временем отправлюсь в город и залечу свои раны в соборе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Аллан"
				},
				{
					"id": 708000608,
					"content": "Ох, я уже чувствую, как Драфф читает мне нравоучения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аллан"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080007",
							"2"
