				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Ох, я хотела создать новое блюдо в честь Праздника ветряных цветов, основной темой которого был бы «вкус ветра». Сейчас я занимаюсь приготовлением необходимых ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000203,
					"content": "Я поручила Аллану отправиться в каньон Светлой короны и добыть мне самое свежее мясо. Прошло много времени, а он до сих пор не вернулся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000204,
					"content": "#Ещё немного и мои ингредиенты испортятся. Не мог{F#ла} бы ты отправиться следом в каньон Светлой короны и посмотреть, как обстоят дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000205,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Спасибо! Как только вернёшься, я дам тебе попробовать моё новое блюдо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Брук"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
