			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Испуганный Шустер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "Я-я ожил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 708001302,
					"content": "#Т-ты раз{F#ожгла}{M#жёг} костёр... С-спасибо тебе, добр{F#ая}{M#ый} путешественни{F#ца}{M#к}... Спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 708001303,
					"content": "С тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "Теперь, когда я согрелся, мне намного лучше... Я оказался здесь по поручению о добыче цельномороженого мяса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 708001305,
					"content": "Я начал свои поиски у подножия гор, но постепенно заходил всё дальше и дальше и даже не заметил, как потерял трутницу, а потом и вовсе заблудился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 708001306,
					"content": "Не знаю, что бы со мной сталось, если бы не вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 708001307,
					"content": "Так что же с твоим поручением?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "Так вас прислала Брук?.. Она, должно быть, торопится. По правде говоря, у меня не хватит сил, чтобы отнести ей это мясо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 708001309,
					"content": "Мне очень неловко, но можно попросить вас отнести ей его за меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "Испуганный Шустер"
				},
				{
					"id": 708001310,
					"content": "Ты можешь положиться на нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Я вам так благодарен! Берегите себя, а мне нужно быстрее дойти до лагеря у подножия горы и съесть чашку горячего супа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Испуганный Шустер"
				}
			]
		},
