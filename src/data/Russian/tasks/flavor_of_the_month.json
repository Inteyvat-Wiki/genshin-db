			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "Спасибо! Теперь все ингредиенты готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000902,
					"content": "Ах, да, вот это тебе. Держи. Небольшой подарок в знак благодарности за проделанную работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000903,
					"content": "Но как же всё-таки приготовить блюдо так, чтобы передать «вкус ветра»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 708000904,
					"content": "Варить или жарить?.. Хм, нет, лучше взять за основу оригинальный вкус ингредиентов, а затем уже посыпать семенами одуванчика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Брук"
				}
			]
		},
