			},
			"dialogs": [
				{
					"id": 221120501,
					"content": "Так-то лучше! Теперь постояльцы в безопасности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221120502,
					"content": "Но она не сочетается с общим стилем гостиницы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Не сочетается? Ничего не могу с этим поделать, плотник из меня неважный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221120504,
					"content": "Подожди... Там есть ещё одна дыра, которую нужно заделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221120505,
					"content": "Но на сегодня хватит ремонта. Дела в гостинице кипят. Пора возвращаться к гостям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221120506,
					"content": "Бизнес не должен останавливаться даже с обрушенной лестницей. Спасибо тебе за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
