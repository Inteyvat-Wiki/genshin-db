			"dialogs": [
				{
					"id": 221120201,
					"content": "Получилось найти доски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120202
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221120202,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Они на нижней террасе, их несложно найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221120204,
					"content": "Я бы и сам за ними сходил, но мне надо следить, чтобы никто из постояльцев не оступился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
