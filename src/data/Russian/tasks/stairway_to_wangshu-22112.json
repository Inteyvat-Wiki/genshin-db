					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Давай посмотрим... Этого должно хватить. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221120304,
					"content": "Ну что ж, приступим? Надо починить лестницу как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
