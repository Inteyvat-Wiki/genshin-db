			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Марионетка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "М? А вот и вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180102,
					"content": "Привет, Сандроне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762180103,
					"content": "Спасибо за приглашение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Хм, в письме было сказано, что ты устраиваешь чаепитие. Почему здесь ничего нет? Только не говори, что угощений тоже не будет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762180106,
					"content": "Ха, шутишь? Ты меня сильно недооцениваешь, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180107,
					"content": "Ого! А это откуда... откуда тут взялся стол?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762180108,
					"content": "Хе-хе, впечатляет? Моё новое изобретение: переносной чайный столик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180109,
					"content": "Компактно хранится, удобен при переноске, а кроме того, оснащён левитирующим устройством, как у Фажио.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180110,
					"content": "И самое впечатляющее... ай, ладно, не буду хвастаться, а то это уже напоминает рекламу. Сами увидите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180111,
					"content": "Вот, я приготовила чай и сладости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180112,
					"content": "Спасибо! Выглядит аппетитно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Ого!.. Как вкусно! Ты классно готовишь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762180114,
					"content": "Само собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180115,
					"content": "Но как ты вообще додумалась создать такой столик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762180116,
					"content": "Хотелось, чтобы мы с друзьями всегда могли посидеть спокойно и выпить чаю, где бы ни оказались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180117,
					"content": "Я уже говорила. Защищать то, что имеешь, не единственный способ сохранить самое ценное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180118,
					"content": "Теперь мне хочется чаще выбираться куда-то, встречаться с друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180119,
					"content": "Но напрашиваться в гости к людям и ожидать, что они приготовят чай и угощения, а потом будут убирать со стола... леди так себя не ведут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180120,
					"content": "Хе-хе, Паймон уверена, что твои друзья будут не против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762180121,
					"content": "Но я против. Да и потом, изобретение очень простое, мне оно почти ничего не стоило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180122,
					"content": "Раз он вам понравился, я сделаю вам такой же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180123,
					"content": "Что?! Ты уверена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762180124,
					"content": "А что такого. Я же говорила, что отлично умею мастерить такие вещицы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180125,
					"content": "Большое спасибо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Не благодари. Вы тоже очень помогли мне во время фестиваля «Фонтиналия», так что считайте это ответной услугой. Леди всегда так и поступают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 762180104,
					"content": "#Надеюсь, я не заставил{F#а} тебя долго ждать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}