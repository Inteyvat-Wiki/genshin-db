			"dialogs": [
				{
					"id": 191170106,
					"content": "Гав! Гав! Г-р-р...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "Пёс-ниндзя"
				},
				{
					"id": 191170107,
					"content": "Какой сердитый! Чуть опять меня не укусил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170108,
					"content": "Что же ты, оголодал совсем... хочешь кушать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170109,
					"content": "Даже если ты с нами и не пойдёшь, поесть-то ты должен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170110,
					"content": "Ты же не думаешь, что еда отравлена? Вот, я попробую немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170121,
					"content": "Видишь? Вкусно и неядовито.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170111,
					"content": "Тома...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "Давай, хоть немножко. Хоть маленький кусочек, и я тебя оставлю в покое. Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170114,
					"content": "Гав! Гав-гав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "Пёс-ниндзя"
				},
				{
					"id": 191170115,
					"content": "Вообще не собирается есть нашу еду... По-моему, какой-то он беспокойный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170116,
					"content": "В море что-то есть? Или его насторожило что-то поблизости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170117,
					"content": "Возможно, эти монстры?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "Думаешь, на него напали монстры? Это вполне возможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170119,
					"content": "В опасных ситуациях никто не думает о еде. Зачистим для нашего четвероногого друга окрестность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170120,
					"content": "#Спасибо, что {F#помогла}{M#помог}. Теперь здесь будет поспокойнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тома"
				},
				{
					"id": 191170112,
					"content": "Ты так стараешься...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
}