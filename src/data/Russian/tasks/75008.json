			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "Манку, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750080102,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Фух, как же долго пришлось ждать. Не буду врать, чем дольше я ждал, тем больше волновался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080104,
					"content": "Несмотря на то, что это была моя идея, если бы вы ушли в руины и не вернулись, я бы себе этого не простил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080105,
					"content": "Простите мою прямоту, но я должен спросить: вы ведь нашли дар, который оставил в руинах Мудрец украденного пламени?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080106,
					"content": "Это было нелегко...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "Я знал, что у вас всё получится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080109,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "Вот этот предмет в форме круглой пластины!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750080111,
					"content": "Ого... Золотое прошение. Кто бы мог подумать, что легендарное Золотое прошение и правда существует! Великолепно! Мне обязательно нужно занести это в результаты исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080112,
					"content": "Так значит, это называется Золотым прошением!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750080113,
					"content": "Да, верно. Ах, простите! Я так взволнован! Говорят, что Мудрец украденного пламени лично приложил руку к её созданию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080114,
					"content": "Мне на миг захотелось забрать её себе и превратить в семейную реликвию или что-то в этом роде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080115,
					"content": "#Ну уж нет! Нам нужно это, чтобы помочь завриану {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750080116,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Знаю... Однако из подсказок о нахождении даров я узнал, где только один из них, но понятия не имею, где другой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080118,
					"content": "Очканатлан...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Ох, прошу прощения, {NICKNAME}. Ты сказал{F#а} «Очканатлан»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080120,
					"content": "(Описать, что вы увидели во время прикосновения к каменной табличке...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Хм... Кто бы мог подумать... Очканатлан... Это руины древнего города по ту сторону моря к северу от клана Цветочного Пера...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080122,
					"content": "Раз это Очканатлан, то прошу прощения, но при всём своём желании я не смогу помочь. Не только племя запрещает ходить туда, но и Ассоциация реликвий заврианов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080123,
					"content": "Говорят, много лет назад членам Ассоциации реликвий заврианов поручили провести там исследование, и они бесследно исчезли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080124,
					"content": "С тех пор наша Ассоциация зареклась иметь какие-либо дела с Очканатланом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080125,
					"content": "Не беда! Этой информации нам вполне достаточно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750080126,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "Раз так, то благодарю вас ещё раз! Для меня было очень важно увидеть Золотое прошение. А теперь мне нужно поскорее вернуться обратно и всё записать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080128,
					"content": "#Ещё раз спасибо, {NICKNAME} и Паймон! Желаю вам счастливого пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080129,
					"content": "#А также желаю тебе, {REALNAME[ID(2)|SHOWHOST(true)]}, достаточно сил для уничтожения печати Благословения Повелителя огня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080130,
					"content": "Пока!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "Что же... Уверен, мы обязательно ещё встретимся там, где собираются все души в конце пути!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Манку"
				},
				{
					"id": 750080107,
					"content": "Это было проще простого.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
