				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Крепкий Ву"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Кто здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010302,
					"content": "Купец из Мондштадта хочет встретиться с Маоцай Гуном.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Он ничего не говорил об этой встрече.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010306,
					"content": "Господин сегодня занят. Все назначенные встречи отменены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010307,
					"content": "Занят? И чем же он таким занят?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010308,
					"content": "Господин готовится заключить важную сделку. Он уехал рано утром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010309,
					"content": "И куда же он уехал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010310,
					"content": "Прошу прощения, но господин запрещает обсуждать такие вещи с незнакомцами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010311,
					"content": "Незнакомцами? У нас с ним личные договорённости...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "Н-нет... То есть да, конечно... При всём уважении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010313,
					"content": "Приведи нас к Маоцай Гуну или пожалеешь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Прости меня! Прошу! Господин направился обсуждать дела в шатре «Синьюэ»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010316,
					"content": "Прошу, пощадите меня! Если господин узнает, то мне конец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010317,
					"content": "Мы и так потратили слишком много времени на пустую болтовню с невоспитанными стражниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010318,
					"content": "У нас есть более важные темы для разговора с твоим господином.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010319,
					"content": "Бл-благодарю вас. Желаю вам успехов и процветания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Крепкий Ву"
				},
				{
					"id": 120010320,
					"content": "#Отличная работа, {NICKNAME}! Никогда бы не подумала, что ты умеешь вести переговоры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010321,
					"content": "Это был блеф.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "#Учту на будущее, что ты способ{F#на}{M#ен} на такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010325,
					"content": "Должно быть, стражник говорил о ком-то из Фатуи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010326,
					"content": "Я тоже так думаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "Нам пора отправиться в шатёр «Синьюэ»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010327,
					"content": "Это может сыграть нам на руку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Ты тоже отлично сработала!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Ха! Паймон любит комплименты. А ещё больше Паймон любит разные вкусняшки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010314,
					"content": "Значит, твой господин должен заплатить за твою грубость?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Моё имя - {NICKNAME}. У меня личная договорённость с твоим начальником.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Личная договорённость... Я не вижу твоего имени в списках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Крепкий Ву"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Маоцай Гун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "Я понимаю. Не волнуйтесь, я обещаю, что заказ будет выполнен вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120010702,
					"content": "Хм... Мои источники сообщают, что у вас возникли проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120010703,
					"content": "Ох... Возникли небольшие технические трудности. Нам не удалось купить кор ляпис.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120010704,
					"content": "Но беспокоиться не о чем. Если Чан Девятый не продаст нам кор ляпис, мы купим его где-нибудь ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120010705,
					"content": "Замечательно. Фатуи интересует только результат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120010706,
					"content": "Фатуи готовы предоставить свою помощь. Но лишь в том случае, если сделка будет совершена вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120010707,
					"content": "Возможно, наша благосклонность будет вам не по карману.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120010708,
					"content": "Понятно. Я в долгу перед вами. Мне не хочется вас разочаровывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 120010709,
					"content": "Мы узнаем это, когда наступит время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Агент"
				},
				{
					"id": 120010710,
					"content": "Эх... Проклятый старик Чан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 610045701,
					"content": "Маоцай Гун вступил в сговор с Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 610045702,
					"content": "Кто знает, чем сейчас занимается этот книжный червь. Давай расскажем ему о нашей находке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1200108,
			"completionStepIds": [
				1200108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200108",
							"2"
						],
						"stepId": 1200108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Син Цю"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "Хм. Ты сказал, что у тебя есть другие дела. Весь такой загадочный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010802,
					"content": "На самом деле, ты просто пристроился в укромном месте и читал книгу всё это время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010803,
					"content": "Теперь понятно, чем занимается Маоцай Гун.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "Так я и думал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010805,
					"content": "Ты правда так думал или просто выпендриваешься сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010806,
					"content": "Дальнейший план действий предельно ясен. Мы должны доставить это письмо в торговую гильдию «Фэйюнь». Должно сработать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010807,
					"content": "По определённым причинам, которые я не могу раскрыть, у меня не получится помочь вам с этим заданием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010808,
					"content": "Вам не нужно знать содержимое письма. Когда настанет время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010809,
					"content": "А! Какой ужасный почерк! У меня сейчас кровь из глаз пойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010810,
					"content": "Это какой-то древний шрифт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010813,
					"content": "Как я уже сказал, вам не нужно знать содержание письма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010814,
					"content": "Тот, кому вы его передадите, всё поймёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010815,
					"content": "Ты уверен, что хочешь к ним обратиться? Это большая серьёзная организация, с чего бы они стали нам помогать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010816,
					"content": "Торговая гильдия «Фэйюнь».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "В Ли Юэ все только об этой гильдии и говорят. Похоже, дела у них идут неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010818,
					"content": "Будет здорово заручиться такой серьёзной поддержкой. Но с чего ты взял, что они захотят нам помогать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010819,
					"content": "Не переживай. Насколько мне известно, им не чуждо благородство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010820,
					"content": "Как только они прочитают это письмо, вне всякого сомненья они тут же бросятся нам на помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010821,
					"content": "Ты уверен в этом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Необходимо преподать Маоцай Гуну урок, который он никогда не забудет. Самостоятельно нам с этим не справиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010824,
					"content": "К тому же я не хочу, чтобы кто-либо ещё узнал о моей роли в этом деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010825,
					"content": "Почему нет? Ты же хочешь помочь Чану Девятому, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010826,
					"content": "«Творить добро и оставаться неузнанным» - вот поведение, достойное истинного рыцаря. Для меня воспоминания о содеянном - достаточная награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010827,
					"content": "За каждую полученную каплю добра я должен вернуть целый ручей благодарности. Мне не нужна ни похвала, ни награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010828,
					"content": "Звучит замечательно, но, если честно, ты ведь просто хочешь почитать книгу, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010829,
					"content": "Прошу, передайте это письмо представителю торговой гильдии «Фэйюнь». Вы найдёте его около «Глазурного павильона».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Син Цю"
				},
				{
					"id": 120010830,
					"content": "Эй! Прекрати игнорировать меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120010822,
					"content": "Зачем подключать их к этому делу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "Может, это шифровка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
}