			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "Эх... Когда же я стану эпичным искателем приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630202,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Привет. Вчера Сайрус рассказывал о своих приключениях в <color=#00E1FFFF>горах Буревестника</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630204,
					"content": "Вот, что он сказал: «Этот щит был просто невероятных размеров. Мои мощные удары не оставляли на нём ни малейшей царапины. А чудовище за щитом только усмехалось и смотрело мне прямо в глаза... Это было похоже на страшный сон...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630205,
					"content": "Деревянный щит, неуязвимый для любых атак. Хотел бы я на это посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630206,
					"content": "У меня так много других забот... Я даже представить не могу, какой ужасный монстр скрывался за тем щитом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630207,
					"content": "#Хм... Может быть, ты сам{F#а} поищешь этого монстра? Если тебе интересно, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630208,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Отлично! Спасибо тебе. Я буду ждать твоего возвращения. Хочу знать всё до малейших подробностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630210,
					"content": "Давай пойдём вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "Вместе со мной? Ну уж нет. Я не могу, у меня полно другой работы в Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630212,
					"content": "Приключения перестали быть прибыльным занятием. Конечно, в Гильдии можно получить какое-нибудь задание, но, скорее всего, это будет мелкое поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630213,
					"content": "Например: гонять кабанов для Драффа, найти кошку Маргариты, собрать цветы для Флоры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630214,
					"content": "Я рассчитывал немного на другие приключения, когда вступал в Гильдию. Хех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
