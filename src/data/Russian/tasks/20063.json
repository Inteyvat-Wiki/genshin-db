						],
						"stepId": 2006301,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"3",
							"20063"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джек"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "Как же сильно я хочу отправиться в приключение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630302,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Вчера Стэнли рассказал ещё одну историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630304,
					"content": "Но он выпил чуть больше обычного, поэтому история вышла совсем уж бессвязной. Если я правильно понял, то дело было <color=#00E1FFFF>недалеко от винокурни «Рассвет»</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630305,
					"content": "В его пьяном бормотании было сложно что-то разобрать... Он сказал что-то вроде: «Ледяные кристаллы торчали из туловища чудовища. Мои ноги дрожали от холода, но я как-то умудрился отколоть от монстра несколько кусочков льда... красивого блестящего льда... Я был очарован этими льдинками...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630306,
					"content": "Я даже представить себе не могу, какое чудовище заставило дрожать самого Стэнли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630307,
					"content": "Эх, хотел бы я сам посмотреть на этого монстра своими глазами. Только я бы сразу убежал, как только с этим чудовищем встретился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630308,
					"content": "А вот ты с ним справишься. Поищешь для меня это чудовище?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630309,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Отлично! Когда ты найдёшь его, возвращайся ко мне. Я хочу знать всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630311,
					"content": "Пойдём вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "Я бы с удовольствием присоединился к тебе, но у меня много дел в Гильдии. Ты понимаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630313,
					"content": "Сайрус поговаривает о том, чтобы отойти от дел. Планирует тихую жизнь в районе Спрингвейла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630314,
					"content": "С тех пор как у него родилась дочь, Герман ни разу не покидал город. Это большая потеря для Гильдии. Он был одним из лучших искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630315,
					"content": "Стэнли сейчас в затяжном отпуске. Он так давно не ходил в приключения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630316,
					"content": "Гильдия начала принимать от жителей странные задания, чтобы хоть как-то оставаться на плаву. Но нам не хватает рук даже для этих заданий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630317,
					"content": "Теперь мне приходиться работать вдвое больше обычного. Но я не могу так просто взвалить всё на плечи Беннета. Ему и так хватает забот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
		},
