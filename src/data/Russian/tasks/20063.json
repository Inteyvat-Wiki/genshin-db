			"dialogs": [
				{
					"id": 200630801,
					"content": "«Этот щит был невероятных размеров. Мои мощные удары не оставляли на нём ни малейшей царапины. А чудовище за щитом только усмехалось и смотрело мне прямо в глаза... Это было похоже на страшный сон...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630802
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630802,
					"content": "Вот, что рассказал мне Сайрус. Я помню каждое слово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630803,
					"content": "Также он сказал, что если бы он не сломал тот огромный щит, то монстр точно его бы прикончил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630804
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630804,
					"content": "Даже самый искусный мечник не смог бы победить того монстра, пока тот был защищён щитом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630805
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630805,
					"content": "А ещё, по словам Сайруса, этот монстр хорошо умеет выбирать правильный момент для атаки. Будь начеку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630806
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630806,
					"content": "Только великий искатель приключений, как Сайрус способен победить такого монстра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630807
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 200630807,
					"content": "Эх... Когда-нибудь я тоже стану таким крутым искателем приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
