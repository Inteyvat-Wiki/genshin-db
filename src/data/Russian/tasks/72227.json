					"Ру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270201,
					"content": "Поскорее бы вырасти и стать искателем приключений, как вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ру"
				}
			]
		},
		{
			"id": 7222703,
			"completionStepIds": [
				7222705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7222705",
							"2"
						],
						"stepId": 7222705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "Всё готово и здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270302,
					"content": "Вот это да! Настоящие искатели приключений способны и на такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270303,
					"content": "Хм... Раньше сюда приходили другие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270304,
					"content": "#Но они, конечно же, не были такими крутыми, как {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270305,
					"content": "Другие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270306,
					"content": "Да. Они искали маусиро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270307,
					"content": "Значит, Сумида...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "Паймон не понимает только, что такое маусиро? Мы слышали, что это традиционный местный музыкальный инструмент...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270310,
					"content": "Угу, это такая штука, которая издаёт звуки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270311,
					"content": "Из-за этого тумана почти ничего не видно, так? Для этого мы и используем маусиро - чтобы другие знали, где мы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270312,
					"content": "Всё-таки это куда лучше, чем кричать! Не то горло болеть будет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270313,
					"content": "Видимость действительно неважная...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270314,
					"content": "Ну да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270315,
					"content": "Па... Дедушка Мата говорит, что маусиро помогают душам потерявшихся в тумане найти дорогу домой, и поэтому они очень важны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270316,
					"content": "Очень важны, значит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270317,
					"content": "Недаром они нужны вам для церемонии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "Верно. Думаю, церемония вам понравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270319,
					"content": "Вы пока идите. Я ещё немного побуду под деревом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270320,
					"content": "Ты уверен, что с тобой ничего не случится? Рядом могут быть монстры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270321,
					"content": "Уверен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270308,
					"content": "Недаром Катерина предупреждала, что это поручение высокой сложности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
		{
