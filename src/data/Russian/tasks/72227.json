			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ру"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "Ты так круто смотришься в бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270102,
					"content": "О, и ты здесь, Ру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270103,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "Со мной всё хорошо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270106,
					"content": "Насчёт тех монстров...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "Я не знаю, откуда они взялись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270109,
					"content": "На местных они определённо не похожи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270110,
					"content": "Ага. Раньше на нашем острове таких монстров не было. Лохматых людей и огромных железяк тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270111,
					"content": "Когда-то тут жили птицы, которых мы называли «вэн камуй». Они были такими кроткими... и такими вкусными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270112,
					"content": "Что-то их не видать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "Да уж. Не знаю, когда это случилось, но они вдруг пропали, а вместо них появились эти монстры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270114,
					"content": "Уж не пришли ли они из-за моря тумана?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270115,
					"content": "Во внешнем мире тоже есть хиличурлы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "А они опасные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270117,
					"content": "Они правда очень опасные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "Но искать приключения весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270120,
					"content": "Я тоже хочу быть искателем приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270121,
					"content": "Паймон уверена, что ты станешь невероятным искателем приключений, когда вырастешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270122,
					"content": "А как же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "Ру"
				},
				{
					"id": 722270123,
					"content": "Мы позаботимся и о гнездовье. Вокруг полно монстров, так что лучше тебе лишний раз не высовываться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722270124,
					"content": "Мы займёмся этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "Но да, приключения увлекательны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "Не ранен?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
