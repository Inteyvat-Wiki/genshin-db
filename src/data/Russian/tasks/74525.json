			"dialogs": [
				{
					"id": 745250401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 745250402,
					"content": "У тебя такое серьёзное выражение лица.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "А, это ты. Нет, сегодня расследование уже завершено, и в округе пока тихо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 745250405,
					"content": "Меня лишь озадачил вид Пустынников, что только что прошли мимо. Какие-то они были мрачные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 745250406,
					"content": "Устали от долгой дороги?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "Полагаю, что причина экономическая. Пусть они и зовутся Пустынниками, с пустыми карманами даже им должно быть невесело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 745250409,
					"content": "А знаешь, что может быть весело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "Хм, можно. Однако если стоять неподвижно, фотография получится слишком простой и неинтересной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 745250412,
					"content": "Ничего, я использую силу Электро, чтобы фотографии получились действительно заряженными энергией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "Сайно"
				},
				{
					"id": 745250413,
					"content": "...Хорошая идея, получатся отличные снимки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "Теперь всё в твоих руках. Не упусти решающий момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сайно"
				},
				{
					"id": 745250410,
					"content": "Давай я сфотографирую тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "Может, они провалили задание?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "Ты что, преступника преследуешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
}