			"dialogs": [
				{
					"id": 760380901,
					"content": "(Возможно, <color=#FFCC33FF>Коломбину</color> заинтересуют сахарные фигурки?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380902
					]
				},
				{
					"id": 760380902,
					"content": "Сахарная фигурка... Кажется, я их раньше пробовала, можешь сделать одну для меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380903
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760380903,
					"content": "Конечно, минутку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380904
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380904,
					"content": "(Хм? Эту девушку я, кажется, уже видела в городе...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380905
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380905,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380906
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760380906,
					"content": "(Вау! Она вся в предвкушении... Думай, думай! Что ей больше всего подойдёт?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380907
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380907,
					"content": "(Доверься интуиции... доверься интуиции... Придумала!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380908
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380908,
					"content": "Эм... я закончила. Посмотри, тебе нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380909
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380909,
					"content": "Очень красиво. Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380910
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760380910,
					"content": "Рада, что тебе понравилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380911
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380911,
					"content": "(Да, интуиция не подвела - лёгкий и воздушный стиль идеально подходит такой же лёгкой и воздушной девушке!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380912,
					"content": "Мм, очень вкусно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760380913,
					"content": "Можешь сделать мне ещё две фигурки? Я хочу угостить куухенки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760380914,
					"content": "Угостить... куухенки? Можно, конечно, но у меня не хватит ингредиентов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380915,
					"content": "Хорошо, тогда я вернусь завтра вместе с куухенки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380916
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760380916,
					"content": "Хорошо, до свидания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хунайятта"
				}
			]
