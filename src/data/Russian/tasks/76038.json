				},
				{
					"id": 760380702,
					"content": "Дай мне фигурку побольше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380703
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760380703,
					"content": "Ягода, ты же не в первый раз покупаешь, должна знать, что все фигурки одинаковые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380704,
					"content": "Ах, мне сегодня так повезло! Ну же, сделай побольше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760380705,
					"content": "Повезло? Ты успешно выполнила поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380706,
					"content": "Хе-хе-хе, простое поручение по сопровождению. Всё прошло без сучка без задоринки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760380707,
					"content": "Груз и заказчик целы и невредимы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760380708,
					"content": "Хватит болтать, быстрее сделай мне побольше, я возьму навынос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760380709,
					"content": "Хорошо, подожди немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хунайятта"
				}
			]
