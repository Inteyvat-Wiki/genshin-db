			},
			"dialogs": [
				{
					"id": 760380201,
					"content": "Одну сахарную фигурку, пожалуйста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380202
					]
				},
				{
					"id": 760380202,
					"content": "Вот, пожалуйста! Ешьте сразу, когда откроете, иначе испортится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хунайятта"
				}
			]
		},
		{
