			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хунайятта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(Возможно, <color=#FFCC33FF>Лауму</color> заинтересуют сахарные фигурки?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Госпожа Хунайятта, мне, пожалуйста, несколько фигурок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760380302,
					"content": "Конечно, госпожа Лаума! Ну как, детям понравились фигурки, которые вы покупали в прошлый раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380303,
					"content": "Ха-ха, не то слово! Некоторые дети боялись разрушить такую красоту и не решались съесть фигурку, пока сахар не начал таять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760380304,
					"content": "Ясно... А давайте я как-нибудь возьму инструменты и приду к вам, чтобы дети посмотрели, как получаются такие фигурки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380305,
					"content": "Ох, замечательная идея. Дети будут очень рады!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Лаума"
				},
				{
					"id": 760380306,
					"content": "Но мы совсем заболтались... Мне пора заняться вашими сахарными фигурками. Как всё будет готово, отправлю их вам с посыльным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380307,
					"content": "Но сначала... Хе-хе, есть идея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380308,
					"content": "Подождите минутку, госпожа Лаума, сейчас я приготовлю для вас особенную фигурку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хунайятта"
				}
			]
		},
