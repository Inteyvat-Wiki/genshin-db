			"dialogs": [
				{
					"id": 760380508,
					"content": "(Возможно, <color=#FFCC33FF>Айно</color> заинтересуют сахарные фигурки?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "Привет! Мне тоже одну фигурку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760380502,
					"content": "Госпожа Айно! Давно не виделись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380503,
					"content": "Хе-хе, меня пригласили в город кое-что отремонтировать. Вот я и решила заодно купить себе немного сладостей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760380504,
					"content": "Скорее, пока Инеффа не видит... Сделай мне несколько фигурок? И сахару побольше, пожалуйста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760380505,
					"content": "Конечно... Только потом не забудь почистить зубы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380506,
					"content": "Да-да, обязательно. Я всегда чищу зубы после сладкого. У меня идеальные зубы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "Айно"
				},
				{
					"id": 760380507,
					"content": "Ха-ха... Одну секунду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хунайятта"
				}
			]
		},
