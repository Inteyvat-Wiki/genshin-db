				"points": []
			},
			"dialogs": [
				{
					"id": 760380409,
					"content": "(Возможно, <color=#FFCC33FF>Флинса</color> заинтересуют сахарные фигурки?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Госпожа Хунайятта, приготовьте для меня, пожалуйста, одну фигурку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760380402,
					"content": "Конечно! Ты ратник Флинс, верно? Я видела тебя в магазине.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380403,
					"content": "Да. Иногда я прихожу в город за покупками. Я весьма польщён, что вы меня запомнили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760380404,
					"content": "Я проходил мимо, увидел, как вы создаёте сахарные фигурки, и был впечатлён вашим мастерством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760380405,
					"content": "Как следует поразмыслив, я всё-таки решил обременить вас просьбой изготовить для меня одну фигурку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760380406,
					"content": "Ох, к чему такие церемонии, мне даже неловко стало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
