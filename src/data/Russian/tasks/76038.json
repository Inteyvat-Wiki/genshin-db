			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хунайятта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(Возможно, <color=#FFCC33FF>Нефер</color> заинтересуют сахарные фигурки?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "Хунайятта, одну сахарную фигурку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760380103,
					"content": "Госпожа Нефер, какая неожиданность! Что привело вас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380104,
					"content": "Прогулки на свежем воздухе полезны как для тела, так и для ума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760380105,
					"content": "Кроме того, сладкое помогает мне сосредоточиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760380106,
					"content": "Минуточку, сейчас всё будет готово...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380107,
					"content": "И, кстати, возьмите эту мору. Когда в следующий раз придёт Ягода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760380108,
					"content": "Сделать ей побольше? Или послаще?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380109,
					"content": "...Отдай ей эту мору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760380110,
					"content": "И скажи: «Нефер платит вдвое больше. Возвращайся, как только закончишь бездельничать. И прихвати для неё сахарную фигурку».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нефер"
				}
			]
		},
