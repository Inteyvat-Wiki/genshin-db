			"dialogs": [
				{
					"id": 760380601,
					"content": "(Возможно, <color=#FFCC33FF>Инеффу</color> заинтересуют сахарные фигурки?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380602
					]
				},
				{
					"id": 760380602,
					"content": "Простите. Мне одну фигурку, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380603
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380603,
					"content": "Конечно! Фигурка будет для госпожи Айно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380604,
					"content": "Ответ отрицательный. Айно велела, чтобы я пришла сюда и купила себе красивую сахарную фигурку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380605,
					"content": "Она объяснила, что это часть обучения «социальным навыкам», которое поможет мне в дальнейшем успешнее совершать покупки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380606,
					"content": "Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760380607,
					"content": "Но я всё равно не понимаю. Мне не требуется столько сахара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380608,
					"content": "Скорее всего, в конечном итоге Айно сама съест фигурку, пока я не буду видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380610
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380610,
					"content": "Госпожа Хунайятта, не могли бы вы изготовить фигурку меньшего размера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380611
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380611,
					"content": "Айно любит сладкое, но мне кажется, ей стоит сократить потребление сахара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380612
					],
					"speakerTitle": "Инеффа"
				},
				{
					"id": 760380612,
					"content": "Хорошо, конечно... Сейчас посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хунайятта"
				}
			]
		},
