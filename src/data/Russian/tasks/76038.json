				"points": []
			},
			"dialogs": [
				{
					"id": 760381109,
					"content": "(Возможно, <color=#FFCC33FF>Линнею</color> заинтересуют сахарные фигурки?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Приветствую, Линнея! Снова пришла за сахарной фигуркой для Луми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760381102,
					"content": "Да, Луми так любит сахарные фигурки, что каждый раз не может их съесть - лизнёт немного и просит меня убрать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Линнея"
				},
				{
					"id": 760381103,
					"content": "Но это ведь сахарная фигурка... Она растает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Линнея"
				},
				{
					"id": 760381104,
					"content": "Поэтому прошу тебя, Хунайятта, сделай для Луми ещё одну сахарную фигурку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Линнея"
				},
				{
					"id": 760381105,
					"content": "Хорошо! Подожди немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760381106,
					"content": "(Луми такая милая! Так и хочется погладить! Но это будет невежливо...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760381107,
					"content": "Готово, держи, Линнея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Хунайятта"
				},
				{
					"id": 760381108,
					"content": "Спасибо! Луми, сахарная фигурка готова. Хочешь... Ой, уснула. Тогда я отдам ей сахарную фигурку позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линнея"
				}
			]
		}
	]
