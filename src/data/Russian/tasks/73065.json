					"nextDialogs": [
						730650203
					],
					"speakerTitle": "Арапратап"
				},
				{
					"id": 730650203,
					"content": "#Потом Арапратап уберёт все «сокровища», а {F#златовласая}{M#златовласый} нара {F#должна}{M#должен} назвать Арапратапу число «сокровища», которое он загадал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650204
					],
					"speakerTitle": "Арапратап"
				},
				{
					"id": 730650204,
					"content": "#{F#Хорошая}{M#Хороший} нара, готов{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650205
					],
					"speakerTitle": "Арапратап"
				},
				{
					"id": 730650205,
					"content": "Давай начинать.",
