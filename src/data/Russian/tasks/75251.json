					"nextDialogs": [
						752510209
					]
				},
				{
					"id": 752510209,
					"content": "Пу... Пукли?.. А! Неужели он теперь вместо меня вкалывает?! Вот я влип... Спасибо, что напомнили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510210
					],
					"speakerTitle": "Папар"
				},
				{
