			"dialogs": [
				{
					"id": 752510101,
					"content": "Выпьем же! Хайне, брат, давай выпьем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510102
					],
					"speakerTitle": "Папар"
				},
				{
					"id": 752510102,
					"content": "Ух ты! Ты кто такой?! Ты что, с дерева упал?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752510103,
					"content": "Это же я, Папар! Брат Хайне, мы ведь договаривались выпить ещё по одной, а? Как же здорово, что мы здесь сегодня собрались! Что за чудная встреча...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510104
					],
					"speakerTitle": "Папар"
				},
				{
					"id": 752510104,
					"content": "О... Эм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510105
					],
					"speakerTitle": "Папар"
				},
				{
					"id": 752510105,
					"content": "Что?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752510106
					]
				},
				{
					"id": 752510106,
					"content": "А, брат мой Хайне, как ты превратился в двух братьев? Один высокий, другой низкий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510107
					],
					"speakerTitle": "Папар"
				},
				{
					"id": 752510107,
					"content": "Эй! Ты меня с кем-то путаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752510108,
					"content": "Что? А...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510109
					],
					"speakerTitle": "Папар"
				},
				{
					"id": 752510109,
					"content": "Брат! Где ты? Давай... Давай выпьем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510110
					],
					"speakerTitle": "Папар"
				},
				{
					"id": 752510110,
					"content": "Пьяница, свалившийся с дерева, пошатываясь, уходит прочь.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
