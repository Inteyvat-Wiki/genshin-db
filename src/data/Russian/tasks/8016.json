			"dialogs": [
				{
					"id": 80160401,
					"content": "Фух... Уже лучше. Мне это нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 80160402,
					"content": "Это наша Бабушка Ицтли! Знай я заранее, что ты будешь сражаться, я бы ещё подумала, так ли нужно подкрепление Повелителям Ночного Ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 80160403,
					"content": "Пф. Это ордену Бездны стоит подумать, на тех ли он напал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 80160404,
					"content": "Опыт подсказывает, что их опорный пункт находится в той стороне, откуда была предпринята атака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 80160405,
					"content": "Может, воспользуемся преимуществом и попробуем захватить его прямо сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 80160406,
					"content": "Здесь что, была битва? Нужна помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "Сутура"
				},
				{
					"id": 80160407,
					"content": "Воины Повелителей Ночного Ветра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80160408,
					"content": "Мы недавно воевали против Бездны и ещё не отвыкли сражаться плечом к плечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "Иансан"
				},
				{
					"id": 80160409,
					"content": "Раз мы все в сборе и готовы сражаться, в атаку! Захватим их опорный пункт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иансан"
				}
			]
		},
		{
			"id": 801605,
