			"dialogs": [
				{
					"id": 80161001,
					"content": "#Не беспокойся. Ты навсегда останешься {M#нашим героем, что бы там ни натворила твоя сестра}{F#нашей героиней, что бы там ни натворил твой брат}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80161002
					],
					"speakerTitle": "Мавуика"
				},
				{
					"id": 80161002,
					"content": "#Но если мы поймаем {M#твою сестру}{F#твоего брата}, я проучу {M#её}{F#его} как следует. Ты ведь не возражаешь?",
