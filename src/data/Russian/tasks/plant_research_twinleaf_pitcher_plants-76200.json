			},
			"dialogs": [
				{
					"id": 762000501,
					"content": "Луми, ты тоже думаешь, что она здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Линнея"
				},
				{
					"id": 762000502,
					"content": "Я-хо-хо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Луми"
				},
				{
					"id": 762000503,
					"content": "Попавшая в ловушку кошка спасена...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Так это тебя они искали, да? Хм... Похоже, ты не пострадала. Но если бы мы нашли тебя чуть позже... кто знает, что могло бы случиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Линнея"
				},
				{
					"id": 762000505,
					"content": "В любом случае сначала вернись к своим друзьям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линнея"
				}
			]
		},
