			"dialogs": [
				{
					"id": 752630301,
					"content": "Невероятно! Кому-то и правда удалось победить Бурю Нанаса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630302,
					"content": "#{M#Наш победитель}{F#Наша победительница} сегодня показал{F#а} суперскорость! Давайте поздравим {M#его}{F#её}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630303,
					"content": "Проиграл?! Не может быть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "Буря Нанаса"
				},
				{
					"id": 752630304,
					"content": "#{M#Он крут}{F#Она крута}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Но! Наши давние поклонники должны знать, что Буря Нанаса был не самым быстрым на этой трассе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630306,
					"content": "До него на сцене царили две абсолютные местные легенды. И сегодня они вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630307,
					"content": "Добро пожаловать, Невидимка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630308,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "И... Неуловимый!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630310,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "#Они серьёзные соперники. Ты ещё не настолько хорошо показал{F#а} себя, чтобы справиться с такими противниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630312,
					"content": "#Ты готов{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630313,
					"content": "#Готов{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "Сотрудники подготовили арену, зрители собрались... Вы встаёте на старт...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
