			"dialogs": [
				{
					"id": 752630501,
					"content": "Гонка завершена! Конец! Вот это исход!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630502,
					"content": "#...и {M#наш победитель}{F#наша победительница}... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630503,
					"content": "#Ого! {M#Он невероятный!}{F#Она невероятная!} {M#Ему}{F#Ей} действительно удалось превзойти и Невидимку, и Неуловимого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#{M#Он был подобен}{F#Она была подобна} золотой молнии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Эй! А как же серебряная молния? Вы разве не видели серебряную молнию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752630506,
					"content": "Проиграл, признаю. Такой скорости я никогда не достигну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "Буря Нанаса"
				},
				{
					"id": 752630507,
					"content": "Не надо сдаваться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Ты для меня образец для подражания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "Буря Нанаса"
				},
				{
					"id": 752630509,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "Примите главный приз, который мы приготовили для чемпиона этого турнира. Вы его заслужили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630512,
					"content": "Ваше имя навсегда войдёт в анналы Состязания на скорость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кинова"
				}
