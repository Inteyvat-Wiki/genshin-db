				"objectNames": [
					"Кинова"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "Я тоже хочу поучаствовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "Неожиданный поворот - появился отважный претендент!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630203,
					"content": "Что? Думаешь, у тебя есть шанс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630204,
					"content": "Сегодня столько неожиданностей... Кто же выиграет? Давайте узнаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630205,
					"content": "Сотрудники подготовили арену, зрители собрались... Вы встаёте на старт...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
