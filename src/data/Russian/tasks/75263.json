					"Кинова"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Уважаемые участники, Состязание на скорость вот-вот начнётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630102,
					"content": "Тот, кто победит Бурю Нанаса, нашего действующего чемпиона, выходившего победителем три дня подряд, выиграет сегодняшний главный приз! Сейчас ваш последний шанс зарегистрироваться на соревнование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630103,
					"content": "Пф! Для меня, Бури Нанаса, больше не осталось соперников? Всё? Все перепугались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630104,
					"content": "Буря Нанаса слишком силён. Победы три дня подряд. Никто не сможет его победить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Ох!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "А? Ты хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Пф. Так мы теперь даже заврианов допускаем? Отлично! Выпускайте всех своих зверей, и я покажу вам, как выглядит настоящая скорость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Кинова"
				},
				{
					"id": 752630108,
					"content": "Уникальный турнир! Смогут ли могучие заврианы свергнуть с трона Бурю Нанаса, нашего трёхкратного победителя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кинова"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
