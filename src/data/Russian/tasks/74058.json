				{
					"id": 740580401,
					"content": "Добро пожаловать... Ой, привет! Это вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580402
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580402,
					"content": "Вы принесли руду, как договаривались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580403
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580403,
					"content": "Пока нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740580404
					]
				},
				{
					"id": 740580404,
					"content": "Время пока терпит... Мастера ещё не успели обработать тот камень, что вы принесли в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580405
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580405,
					"content": "Но партия нового материала должна вдохновить мастеров, как вы считаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580406
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580406,
					"content": "Буду по-прежнему ждать вас здесь.",
