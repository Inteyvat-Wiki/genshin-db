			"dialogs": [
				{
					"id": 740580201,
					"content": "Ого... Как много! Вы очень мне помогли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580202,
					"content": "К сожалению, мастера плохо знакомы с такой рудой, и дело у них не спорится... Камень, который вы тогда принесли, давно в мастерской, а изделие пока не готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580203,
					"content": "Но не беспокойтесь! Чутьё меня не подводит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580204,
					"content": "Я сделаю из чудесной руды модные украшения, которые завоюют весь Фонтейн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580205,
					"content": "В следующий раз покажу вам, как выглядит готовое изделие. И преподнесу несколько образцов в качестве вознаграждения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580206,
					"content": "А может... к тому времени вы уже увидите мои украшения на ком-то из аристократов, ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Чесил"
				},
				{
					"id": 740580207,
					"content": "Ну что, буду всегда рад новой встрече!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чесил"
				}
			]
		},
