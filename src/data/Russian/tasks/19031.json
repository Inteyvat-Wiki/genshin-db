					"Фу Саньэр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "Разгуливать здесь в одиночку слишком опасно, хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102102,
					"content": "Никогда не знаешь, кто... или что встретится на пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102103,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "#Хм, что-то ты очень споко{F#йна}{M#ен}. Есть такая поговорка: «нельзя ходить вдоль реки, не намочив ног».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102106,
					"content": "#Если блуждаешь по таким жутким местам, будь готов{F#а} столкнуться с чем-нибудь... потусторонним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102107,
					"content": "То, что ты здесь увидишь, будет преследовать тебя в кошмарах до самой смерти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102108,
					"content": "Что, серьёзно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "#Что за дела, почему ты так споко{F#йна}{M#ен}? Обычно я не успеваю договорить, как все разбегаются в ужасе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102111,
					"content": "Всё потому, что передо мной самый обычный человек.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Может и так, но лучший способ изображать привидение - это создавать зловещую атмосферу, играя на потаённых человеческих страхах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102113,
					"content": "И в этом случае мой вид значения не имеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102117,
					"content": "Ну а людей вроде тебя мне ни за что не напугать, как ни старайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102118,
					"content": "Мне кажется, что ты просто отлыниваешь от работы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "#Ты неправ{F#а}. Да, пойду-ка я напугаю какого-нибудь трусишку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102120,
					"content": "А ты лучше возвращайся к своему спутнику. Он наверняка где-нибудь под кустиком дрожит от страха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102114,
					"content": "Неужели у тебя нет никакого наряда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Есть, но в нём невозможно дышать... К тому же наиболее искусный способ играть привидение - это перебирать те струны души, которые отзываются страхом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102116,
					"content": "И в этом случае мой вид значения не имеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Фу Саньэр"
				},
				{
					"id": 1903102109,
					"content": "Несусветица какая-то... Скажи-ка, что это ты тут делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Привет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
