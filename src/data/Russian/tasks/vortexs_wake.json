				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжун Ли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210201,
					"content": "Какое непримечательное место. Разве здесь может быть что-то ценное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210202
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210202,
					"content": "Хм? Паймон считает, что перед нами величественное зрелище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110210203,
					"content": "Я подразумеваю вовсе не вид, а... Раз уж на этом месте произошла великая битва, то здесь определённо должно быть что-нибудь необычное. Но что-то я даже не знаю, с чего начать поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210204
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210204,
					"content": "Вообще-то каменный лес Гуюнь - превосходное место для изучения богов, особенно - периода Войны Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210205
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210205,
					"content": "Легенда гласит, что Властелин Камня именно на этом месте сокрушил Архонта Вихрей копьями, сделанными из скал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210206
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210206,
					"content": "После многих лет ветряной эрозии эти каменные копья превратились в тот уникальный пейзаж, каким мы видим его сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210207
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210207,
					"content": "Э-эти огромные скалы были оружием Властелина Камня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110210208,
					"content": "Сейчас мы видим лишь их малую часть. Копья, которые метал Властелин Камня, значительно превосходили эти скалы как числом, так и размером.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210209
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210209,
					"content": "Но из-за различных углов, под которыми они вошли в землю, огромной массы, воздействия водной эрозии и силы притяжения многие из них целиком погрузились в морское дно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210210
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210210,
					"content": "Таким образом, помимо ветряной эрозии на образование каменного леса Гуюнь сильно повлияло первоначальное разрушение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210211
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210211,
					"content": "Тогда... божество, которое могло противостоять Властелину Камня, тоже было могучим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210212
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210212,
					"content": "Верно. В этом и заключается исследовательская ценность каменного леса Гуюнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210213
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210213,
					"content": "Большая часть предметов того времени затонула в море. Но благодаря гигантским волнам, которые поднял Архонт Вихрей, многие из них вновь смогли оказаться под лучами солнца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210214
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210214,
					"content": "Значит, мы можем найти несметные богатства, стоит лишь хорошенько поискать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210215
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210215,
					"content": "А, в смысле, богатства археологического толка, да? Ну, тогда я спокоен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210216
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210216,
					"content": "Раз уж с нами столько народу, думаю, лучше будет разделиться и приступить к поискам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210217
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210217,
					"content": "#Ладно. Тогда я пойду со {F#своей подругой}{M#своим другом}. И, хоть я обладаю определёнными знаниями из разных наук, с нашим экспертом по археологии мне не сравниться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210218
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210218,
					"content": "А? Вы имеете в виду меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210219
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110210219,
					"content": "В чём дело? Это ведь ваша профессия, чему вы так удивляетесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210220
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210220,
					"content": "Я поняла... Тогда я покажу дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210221
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110210221,
					"content": "Хорошо. Если кто-нибудь найдёт что-то редкое или ценное, то... Давайте встретимся на берегу напротив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжун Ли"
				}
			]
		},
		{
			"id": 1102106,
			"completionStepIds": [
				1102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102106",
							"2"
						],
						"stepId": 1102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Климент"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210601,
					"content": "...И ты называешь себя археологом? Того не знаешь, этого не знаешь... Да какой вообще от тебя толк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210602
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210602,
					"content": "У каждого из нас своя специализация! Я уже пыталась вам это объяснить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210603
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110210603,
					"content": "Прекратите ссориться! Что у вас тут произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110210604,
					"content": "Эта девчонка всё твердила, какой она археолог, а на деле об этих руинах ничегошеньки не знает! Даже мне, неместному, известно куда больше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210605
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210605,
					"content": "Теперь, чтобы найти что-нибудь ценное, я должен опираться на догадки... То есть опыт. Ай, только зря потратили время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210606
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210606,
					"content": "Предметом моих исследований всегда была Архонт Соли, и с реликвиями, принесёнными морем, я не знакома. Ничего необычного в этом нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210607,
						110210608
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110210607,
					"content": "(Что-то тут не так...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210609
					]
				},
				{
					"id": 110210609,
					"content": "Ну а ты! Постоянно спрашиваешь, сколько стоит то, сколько стоит это! Разве можно измерять ценность реликвий посредством лишь моры?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210610
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110210610,
					"content": "Это... Разве не проще всего измерять их стоимость морой? Тем более, что это соответствует традициям Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210611
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210611,
					"content": "Прошу, успокойтесь. Мы нашли кое-что любопытное. Давайте изучим этот предмет вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210612
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210612,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210613
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210613,
					"content": "Очень жаль. Эти предметы и в самом деле вынесло на берег из-за Архонта Вихрей, но к самому богу они никакого отношения не имеют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210614
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210614,
					"content": "Но вот каменная табличка с загадочным узором и слабой аурой божественной силы, которую мы нашли, может представлять научный интерес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210615
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210615,
					"content": "Скорее, скорее дай её мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210616
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210616,
					"content": "Хе-хе, ну хоть не уйдём с пустыми руками. Сила богов, ха-ха! Хорошая штучка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210617
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210617,
					"content": "Кхм, но другие предметы тоже чего-то стоят, верно? Должно хватить, чтобы отбить стоимость ваших услуг - всё моё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210618
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210618,
					"content": "Значит, для исследований подходят только вещи с остатками божественной силы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110210619,
					"content": "Вовсе нет. Я изучаю историю Архонта Соли потому, что она может поведать о былой культуре и верованиях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210620
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110210620,
					"content": "А ты... Для тебя археология лишь способ разбогатеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210621
					],
					"speakerTitle": "Вань Янь"
				},
				{
					"id": 110210621,
					"content": "Чушь! Я профессиональный археолог из Снежной. Разрази меня молния, если лгу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210622,
						110210623
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210622,
					"content": "(Нет, ты используешь археологию ради наживы...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210624
					]
				},
				{
					"id": 110210624,
					"content": "Да, к слову, эту чашку продавать не стоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210625
					],
					"speakerTitle": "Чжун Ли"
				},
				{
					"id": 110210625,
					"content": "Это почему же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210626
					],
					"speakerTitle": "Климент"
				},
				{
					"id": 110210626,
					"content": "Она входила в коллекцию Нин Гуан, и совсем не древняя. Должно быть, она упала сюда вместе с Нефритовым дворцом. И если ты не хочешь рассердить Цисин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210627
					],
