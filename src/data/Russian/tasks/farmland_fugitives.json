			"dialogs": [
				{
					"id": 736780101,
					"content": "Вы пришли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780102
					],
					"speakerTitle": "Фараби"
				},
				{
					"id": 736780102,
					"content": "У меня хорошие новости! Поскольку мы нашли неопровержимые доказательства существования снежного кабана, я только что получил письмо от своего научного руководителя, что тема моей дипломной работы одобрена Академией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780103
					],
					"speakerTitle": "Фараби"
				},
				{
					"id": 736780103,
					"content": "Ого, звучит здорово. Поздравляем тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736780104,
					"content": "Это хорошее начало, но последующие исследования займут много времени, поэтому мне придётся остаться в Мондштадте надолго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780105
					],
					"speakerTitle": "Фараби"
				},
				{
					"id": 736780105,
					"content": "Далее мне нужно выяснить, как кабаны попали с Драконьего хребта в лес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780106
					],
					"speakerTitle": "Фараби"
				},
				{
					"id": 736780106,
					"content": "Основываясь на ранее обнаруженных следах, я предполагаю, что они спустились по западной стороне Драконьего хребта, а затем прошли мимо винокурни «Рассвет» по направлению к Спрингвейлу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780107
					],
					"speakerTitle": "Фараби"
				},
				{
					"id": 736780107,
					"content": "Если это предположение верно, то мы сможем найти их следы поблизости. Поэтому наша цель на сегодня - исследовать этот вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780108
					],
					"speakerTitle": "Фараби"
				},
				{
					"id": 736780108,
					"content": "Вот оно что. А кто этот мужчина, одетый как охотник, рядом с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736780109,
					"content": "Здравствуйте, меня зовут Уолтер. Я отвечаю за безопасность возле винокурни «Рассвет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780110
					],
					"speakerTitle": "Уолтер"
				},
				{
					"id": 736780110,
					"content": "Эдмунд рассказал мне о том, что вы ищете снежного кабана. Пойдёмте со мной. Мне как раз нужны люди для помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780111
					],
					"speakerTitle": "Уолтер"
				},
				{
					"id": 736780111,
					"content": "Прошлой ночью несколько лесных кабанов ворвались на близлежащие сельскохозяйственные угодья и распугали всех голубей и уток. Птицы до сих пор не вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780112
					],
					"speakerTitle": "Уолтер"
				},
				{
					"id": 736780112,
					"content": "#Путешественни{F#ца}{M#к}, скоро мы отправимся на охоту. Если вы заметите этих птичек, то поймайте и верните их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780113
					],
					"speakerTitle": "Уолтер"
				},
				{
					"id": 736780113,
					"content": "Нет проблем, я обо всём позабочусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780114
					]
				},
				{
					"id": 736780114,
					"content": "#Говорят, ты умеешь обращаться с приспособлениями для охоты. Я тоже разместил кое-что поблизости, можешь их использовать. Отправимся, как только ты будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780115,
						736780116
					],
					"speakerTitle": "Уолтер"
				},
				{
					"id": 736780115,
					"content": "У меня всё готово. Вперёд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736780116,
					"content": "У меня ещё есть кое-какие дела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780117
					]
				},
				{
					"id": 736780117,
					"content": "Хорошо, не торопись. Я буду ждать тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Уолтер"
				}
			]
		}
	]
}