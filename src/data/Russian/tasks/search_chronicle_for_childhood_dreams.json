			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ранджит"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737040101,
					"content": "Новый день - новая надежда! Готовы отправиться в путь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040102
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040102,
					"content": "«Новая надежда» говоришь... Тебе не удалось подружиться с древним геовишапом, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737040103,
					"content": "Почему не удалось? Борьба - это одна из форм общения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040104
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040104,
					"content": "Если подумать, то мы хорошо пообщались и даже узнали друг о друге много нового.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040105
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040105,
					"content": "Как там говорят? «Дружба начинается с драки»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040106,
						737040108
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040106,
					"content": "Ничего удивительного...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040107
					]
				},
				{
					"id": 737040107,
					"content": "Хочу сказать, что пока не попробуешь, не узнаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040110,
					"content": "Значит, ты ещё не сдаёшься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737040111,
					"content": "Честно говоря, я всегда мечтал прокатиться на Пернатом плесеннике по всему Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040112
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040112,
					"content": "Но взрослые говорили мне, что это глупости. Я спрашивал у лесных стражей, но они лишь озадаченно смотрели и просили не рисковать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040113
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040113,
					"content": "Так что я отказался от этих идей и вырос нормальным, как и другие дети. А мои единственные приключения были связаны лишь с выбором ингредиентов для приготовления пищи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040114
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040114,
					"content": "Но иногда я вспоминаю свои далёкие и такие странные мечты, подобные аранарам из легенд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040115
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040115,
					"content": "Но если они реальны, то в какой момент я перестал их видеть и забыл о них?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040116
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040116,
					"content": "В Натлане я узнал о несчастном парне по имени Кунтур, которого возненавидело солнце из-за ошибки его отца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040117
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040117,
					"content": "Кунтур Немилый Солнцу был изгнан из своего племени; и, конечно, ни один житель Натлана не захотел бы с ним дружить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040118
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040118,
					"content": "Но он не сдался и не стал упрекать отца или судьбу! Вместо этого упорством и трудом он доказал, что не уступает самому отважному воину племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040119
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040119,
					"content": "В конце концов, он отличился великими достижениями и получил поддержку Иктомизавра, став героем своего племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040120
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040120,
					"content": "Эта история вдохновила и наделила меня мужеством возродить мою детскую мечту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040121
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040121,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737040122,
					"content": "Пожалуйста, помогите мне поладить с Пернатым плесенником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040123
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040123,
					"content": "В итоге всё равно приходится обращаться к нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737040124,
					"content": "У меня не хватит сил справиться с Пернатым плесенником... Но я постараюсь помочь. Позовите, если что-то понадобится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040125
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040125,
					"content": "Хватит болтать! Начнём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040126,
						737040127
					],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040126,
					"content": "Вперёд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737040127,
					"content": "Мне некогда. Увидимся позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040128
					]
				},
				{
					"id": 737040128,
					"content": "Хорошо. Я подожду тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ранджит"
				},
				{
					"id": 737040108,
					"content": "#Хотя {F#сражалась}{M#сражался}-то на самом деле я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040109
					]
				},
				{
					"id": 737040109,
					"content": "И какое это было сражение! Хочу сказать, что вы самые опытные искатели приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "Ранджит"
				}
			]
		}
	]
}