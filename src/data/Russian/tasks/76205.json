					}
				]
			},
			"dialogs": [
				{
					"id": 762050201,
					"content": "Какой длинный отрезок времени!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762050202,
					"content": "Мириады явлений как путеводитель, Всё сущее вписывается в священное имя. Слова переплетаются, а посланники объединяются. В этом святилище словами вымощены ступени твоего пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050203,
					"content": "Динь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050204
					],
					"speakerTitle": "Осмотреть дверь"
				},
				{
					"id": 762050204,
					"content": "Смотри, всё готово.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050205
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050205,
					"content": "Явленья природы путь могут открыть, книги - навечно имена сохранить.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050206
					]
				},
				{
					"id": 762050206,
					"content": "Слова и главы здесь сплетены, ангелы с волей небесной слиты.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050207
					]
				},
				{
					"id": 762050207,
					"content": "В священном месте в этот час слова проложат путь для нас.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
