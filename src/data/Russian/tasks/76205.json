					"Николь"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							6.488,
							5.308,
							-23.685
						],
						"pointId": 44
					},
					{
						"sceneId": 1156,
						"position": [
							7.903,
							5.33,
							-22.677
						],
						"pointId": 45
					},
					{
						"sceneId": 1156,
						"position": [
							7.952,
							5.33,
							-23.634
						],
						"pointId": 46
					}
				]
			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "Что же делать? Что мне делать? Они скоро придут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050102,
					"content": "Николь, а вот и мы! Эй-эй, Николь, не выталкивай нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762050103,
					"content": "Кхе... Извините...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050104,
					"content": "Ты не готова?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Как бы выразиться. Боюсь, я не смогу объяснить всё достаточно внятно. Придётся рассказать всё с самого начала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050106,
					"content": "Всё началось, когда ведьмы впервые бросили вызов Анемо Архонту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050107,
					"content": "Николь, это... было слишком давно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762050108,
					"content": "Ах, это уже слишком! Мне так неловко говорить... Но ничего не поделаешь, факты есть факты... Если Алиса не узнает, никто не будет смеяться надо мной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050109,
					"content": "Ой, её внутренний монолог опять просачивается наружу... Кроме того, он не исходит из её «уст»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762050110,
					"content": "Тсс...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "Я решила спрятать перья в верхней части кабинета. Подумала, что если усложню задачу, то чувство удовлетворения от достигнутого будет сильнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050112,
					"content": "Но я, честно говоря, не очень-то умею управлять этими беззаботными ветрами. Я могу взлететь лишь на определённую высоту, после чего словно упираюсь в невидимый потолок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050113,
					"content": "Ты можешь спустить перья при помощи магии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762050114,
					"content": "Но тогда это потеряет всякий смысл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050115,
					"content": "Ну да, действительно... Мы в тупике...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762050116,
					"content": "Николь, можешь сказать кое-что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "Что именно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050118,
					"content": "В Симуланке слова - это магия.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "А! Понятно! Давайте попробуем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Николь"
				},
				{
					"id": 762050121,
					"content": "Ох, это слишком, мне так неловко произносить это вслух...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "Но ничего не поделаешь, факты есть факты...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Если Алиса не узнает, никто не будет смеяться надо мной...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Вот бы твои слова стали лестницей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
