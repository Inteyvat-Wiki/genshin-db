			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ирмари"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "Эх, сегодня тоже не повезло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210402,
					"content": "Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "Рыбу ловлю. Но пока что на крючок попалась лишь какая-то ерунда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210404,
					"content": "Ладно бы это были безделушки с затонувших кораблей, уличные торговцы их с руками бы оторвали. Однажды я вытащил сапог с половиной... Ладно, замолкаю, а не то всю рыбу распугаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210405,
					"content": "Поблизости есть что-нибудь примечательное?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "Всё охотишься за сокровищами? Ищешь «Великое сокровище», что скрывается к востоку от луны, на запад от солнца... Нетрудно догадаться, что здесь его нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210407,
					"content": "В этих местах когда-то случилось немало кораблекрушений. Возможно, сокровища в затонувших кораблях, но найти их будет не так-то просто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210408,
					"content": "В таверне выжившие матросы рассказывали, что та ночь была безлунной, но среди вздымающихся до небес огромных волн что-то светилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210409,
					"content": "Говорят, то был Одноглазый Кратти - чудовище, что ведёт вечную борьбу с Морским змеем за власть над морем. Оно способно поглотить даже луну!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210410,
					"content": "Долгое время после этого море было чернее смолы, и корабли обходили эти проклятые воды стороной, боялись, что призраки на дно утащат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210411,
					"content": "Кто знает, вдруг те призраки до сих пор бродят где-то рядом... Но я их не видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210412,
					"content": "О дереве...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "С ним и правда что-то нечисто. Тут раньше был водоворот... Око Кратти - так его прозвали матросы. А потом раз - и внезапно посреди водоворота вдруг выросло дерево.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210414,
					"content": "Однако в те времена странностей было куда больше. Если подумать, всё началось, когда с неба посыпались камни... Быть может, и это дерево свалилось откуда-то с небес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210415,
					"content": "Временами можно увидеть блестящие штучки - настоящая диковинка! Я подумал, может, и новая рыба заведётся, вот и пришёл сюда попытать счастье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210416,
					"content": "Со мной как-то рыбачил один парень, всё время жаловался, что слышит какие-то странные песни... В общем, он так испугался, что больше я его здесь не видел. Хм... Он лишь наполовину Дитя Морозной Луны, а причуд у него - на целый народ хватит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210417,
					"content": "Расскажи о Знаке Мудреца...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "Знак Мудреца, «Великое сокровище», что скрывается к востоку от луны, на запад от солнца... Знаете что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210419,
					"content": "Жадность и погоня за чужим богатством никогда до добра не доводят. Взять хотя бы «Атлас». Говорят, капитан Гретир рассудок из-за этих сокровищ потерял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210420,
					"content": "В итоге он обрёл вечный покой на дне морском, а сокровища ему так и не достались. Все труды насмарку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				},
				{
					"id": 760210421,
					"content": "Не буду мешать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "Пустяки. Тут и намёка на рыбу нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ирмари"
				}
			]
		}
	]
}