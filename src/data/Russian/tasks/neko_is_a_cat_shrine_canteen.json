					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "Хотя... это уж слишком невероятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140102,
					"content": "Скульптура готова?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "Сначала камень был совсем на меня не похож. Но чем дальше, тем больше он меня напоминает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140104,
					"content": "Удивительные вы, люди, существа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140105,
					"content": "Очень шумно, но я как-никак временная настоятельница. Такие мелочи не стоят моего внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140106,
					"content": "Отнеси этих рыб тому здоровяку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140107,
					"content": "Они хорошие. Пусть это будет его... «лопата».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140108,
					"content": "Только рыба?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "Мяу, я пыталась отправить молодняк под руководством Комбумару половить зябликов, но что-то у них не очень получилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140110,
					"content": "А вот рыбу им ловить гораздо проще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140111,
					"content": "«Оплата».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "Мяу-мяу-мяу, вот зануда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722140113,
					"content": "Просто отдай ему их. Это хорошие вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "Вот теперь это на что-то похоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140202,
					"content": "Ха-ха, это вы. Смотрите, теперь больше похоже на госпожу временную настоятельницу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140203,
					"content": "Да, определенно что-то есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "Правда? Ха-ха, всё же у меня ушло на это несколько дней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140207,
					"content": "Эх, как есть хочется. Нужно поискать что-нибудь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140208,
					"content": "Нэко передала для тебя рыбу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "Эм-м, спасибо, конечно, госпоже временной настоятельнице, но я лучше сам что-нибудь поищу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140210,
					"content": "А то я уже несколько дней подряд питаюсь одной рыбой и смотреть на неё не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140211,
					"content": "Приходится самому искать себе пропитание. Когда везёт, то попадается зяблик или голубь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140212,
					"content": "Но мне бы так хотелось поесть мяса. Плотного, сочного мяса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140213,
					"content": "#Хм, путешественни{F#ца}{M#к}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140214,
					"content": "Может, принесёте мне три куска сырого мяса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140215,
					"content": "Я никудышный охотник, так что мне так и не удалось добыть мяса за эти несколько дней. Помогите мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140216,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "Прошу вас, мне бы хватило трёх кусков сырого мяса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140217,
					"content": "Ты не думал вернуться на остров Наруками, чтобы поесть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "Во-первых, это слишком далеко. А во-вторых... я только погрузился в работу, поймал «чувство камня». Если уеду, я его потеряю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140219,
					"content": "Я бы предпочёл быстро перекусить прямо здесь и продолжить работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140205,
					"content": "Скульптура заметно больше Нэко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "Ну, конечно. Госпожа временная настоятельница, конечно, покрупнее обычной кошки, но всё-таки статуя такого размера была бы слишком маленькой. Это ведь вещь для святилища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		},
		{
