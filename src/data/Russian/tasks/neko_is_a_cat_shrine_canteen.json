			"dialogs": [
				{
					"id": 722140301,
					"content": "Как все прошло? Удалось вам добыть сырое мясо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		},
		{
			"id": 7221404,
			"completionStepIds": [
				7221403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Осима Дзюмпэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "О-о-о, высочайшее качество! Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140402,
					"content": "Совсем скоро у меня будет отличная еда! Уверен, что теперь и скульптура будет готова раньше срока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140403,
					"content": "Какая тут связь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "После мяса сразу появляются силы для работы! А то на одной рыбе мне всё казалось, что молоток сейчас выпадет из рук...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140405,
					"content": "Честно говоря, я уже начал беспокоиться, что мне понадобится больше времени, чем ожидалось, чтобы закончить всю статую. Но теперь это не проблема, благодаря вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140406,
					"content": "Конечно, мой наниматель... кошка, но всё равно срывать сроки нехорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140407,
					"content": "В любом случае я хочу закончить работу поскорее. Госпожа временная настоятельница обещала, что когда скульптура будет готова, случится что-то хорошее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140408,
					"content": "Не знаю точно, о чём это, но... всё равно жду с нетерпением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Осима Дзюмпэй"
				},
				{
					"id": 722140409,
					"content": "Скоро вы сможете посмотреть на готовую работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осима Дзюмпэй"
				}
			]
		}
	]
}