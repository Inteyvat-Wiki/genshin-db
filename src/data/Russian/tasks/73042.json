			"trigger": {
				"objectNames": [
					"Араканта"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730420601,
					"content": "#Вот это весело было! Араканте очень понравилось играть с {F#золотой}{M#золотым} нарой! Ты {F#такая быстрая и сильная}{M#такой быстрый и сильный}. Прямо как настоящий тигр ришболанд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Араканта"
				},
				{
					"id": 730420602,
					"content": "С аранарами и настоящим тигром ришболандом тоже весело играть, но с новыми друзьями, особенно с нарой, ещё веселее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Араканта"
				},
				{
					"id": 730420603,
					"content": "А зачем тигру ришболанду догонять аранар?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Тигр ришболанд и аранары - друзья, а друзья играют вместе. Оказывается, нары боятся тигра ришболанда, вот мне и пришла в голову новая игра для Праздника Утсава!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Араканта"
				},
				{
					"id": 730420605,
					"content": "#Спасибо! Вот цветочек специально для {F#золотой}{M#золотого} нары!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араканта"
				}
