				"points": []
			},
			"dialogs": [
				{
					"id": 400315201,
					"content": "После того как ты доберёшься до животных, остальное я возьму на себя. Я мигом доставлю их по домам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315202,
						400315207,
						400315210
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400315202,
					"content": "Что ты можешь рассказать мне о Чёрной тени?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315203
					]
				},
				{
					"id": 400315203,
					"content": "Я слышал о секретной организации, которая тренировала псов-ниндзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315204
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400315204,
					"content": "Говорят, что одна такая собака по кличке Инудзин уничтожила бесчисленных монстров, угрожавших Инадзуме...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315205
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400315205,
					"content": "...Конечно, это всего лишь истории минувших дней. И всё же любопытно, может ли эта Чёрная Тень быть легендарным псом-ниндзя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315206
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400315206,
					"content": "Неважно. Моему поражению нет оправданий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400315207,
					"content": "Что ты собираешься использовать для отвлечения противника?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315208
					]
				},
				{
					"id": 400315208,
					"content": "Хоть у меня и не получилось спрятаться от него и спасти животных, но при обследовании территории я всё же смог установить несколько генераторов дыма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315209
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400315209,
					"content": "Если ты активируешь эти устройства, то они должны на время отвлечь его внимание. Я надеюсь, что они помогут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400315210,
					"content": "Я скоро вернусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315211
					]
				},
				{
					"id": 400315211,
					"content": "Хорошо, спасибо. Я посторожу здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				}
			]
		}
	]
