			},
			"dialogs": [
				{
					"id": 400310801,
					"content": "Спасибо тебе большое за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310802,
					"content": "#Видишь? {NICKNAME} сильнее всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310803,
					"content": "Теперь количество животных совпадает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310804,
					"content": "Секунду... Хм. Ещё нескольких не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310805,
					"content": "Уф, как же так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310806,
					"content": "Мы не можем расценивать это как поражение. Нас не унесла Чёрная тень, и нам удалось вернуть часть животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310807,
					"content": "Таким образом, наше расследование продвигается. Просто на данный момент у нас нет зацепок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310808,
					"content": "Вот что я думаю: я продолжу расследование, а вы пока можете заняться своими делами. Давайте встретимся в детективном агентстве Бантан Санго, как только появится новая информация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310809,
					"content": "Ну, похоже, что вариантов получше у нас всё равно нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
