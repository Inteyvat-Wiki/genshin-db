	"talks": [
		{
			"id": 4003101,
			"completionStepIds": [
				4003101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003101",
							"2"
						],
						"stepId": 4003101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "#Ты как раз вовремя, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 400310102,
					"content": "До боли знакомое начало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310103,
					"content": "Дальше ты скажешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "#Сразу видно опытного искателя приключений! Ты прав{F#а}, есть новое поручение, как раз для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 400310106,
					"content": "Детективному агентству Бантан Санго нужна помощь. Они надеются, что ты сможешь помочь в расследовании крупномасштабного исчезновения животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 400310107,
					"content": "Что? Просто пара мелких зверюшек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310108,
					"content": "#Да ладно. Ты правда думаешь, что для подобного задания требуется такая звезда, как {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310109,
					"content": "Ну и ладно, мне даже еду как-то приходилось разносить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "Слушай, но ведь это дело как раз для детективов Бантан Санго. Зачем им давать поручение искателям приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310114,
					"content": "Вот как обстоят дела: мисс Санго попросила опытного искателя приключений в качестве сопровождающего для Рюдзи во время расследования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 400310115,
					"content": "А ещё... Дайте-ка мне взглянуть. Мисс Санго поручила мне передать эти слова:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 400310116,
					"content": "«У многих людей пропали домашние любимцы, поэтому мы получили много заказов. После успешного завершения расследования гарантировано щедрое вознаграждение».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 400310117,
					"content": "#Щедрое вознаграждение!.. Хм-м, знаешь, {NICKNAME}... Паймон кажется, что этих милых крошек нужно спасти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310118,
					"content": "К тому же, большие там поручения или маленькие - все они ведут к самосовершенствованию, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310119,
					"content": "Паймон, твои хитрости шиты белыми нитками!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "Ой, ну и подумаешь. Всё равно давай разыщем Санго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310110,
					"content": "#Никаких проблем. В прошлом я даже тележки чинил{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "#Ничего, я не боюсь простых поручений - я и с Ужасом Бури {F#сражалась}{M#сражался}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "Так, значит, победа над Ужасом Бури - это для тебя пустяк? Очень... впечатляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 400310104,
					"content": "Есть новые поручения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго",
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "Неплохо. Вы прибыли быстрее, чем я думала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310203,
					"content": "Ну конечно! Стоило нам услышать про вознагражде... про потерянных зверюшек, и мы не стали терять ни минуты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310204,
					"content": "#Рассказывай, что же случилось? Теперь, когда Паймон и {NICKNAME} здесь, переживать не о чем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310205,
					"content": "Вот только работа опять вся достанется мне...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "Паймон оказывает тебе моральную поддержку, это тоже немало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310207,
					"content": "Вы, как обычно, полны энергии. Расскажу о задаче. В последнее время мы получаем огромное количество поручений по поводу потерянных животных. Разумеется, мы должны их найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310208,
					"content": "В основном это домашние животные, так что они не должны были просто сбежать без всякой причины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310209,
					"content": "Конечно, в Инадзуме хватает загадочных историй. Но ничего не происходит просто так, поэтому любую загадку можно решить с помощью логики. Наши расследования на месте происшествия подтверждают эту аксиому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310210,
					"content": "Расследования-то наши, а бегать вечно приходится мне одному...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310211,
					"content": "Хочешь, Паймон и тебя морально поддержит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310213,
					"content": "Спасибо за предложение, но я думаю, что справлюсь сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310214,
					"content": "За последние несколько дней поисков пропавших животных я обнаружил несколько лагерей в окрестностях. Некоторые из них охранялись монстрами - ничего особенного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310215,
					"content": "Но как раз когда я пытался освободить пойманных животных в одном из лагерей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310216,
					"content": "...Рюдзи вывела из строя «внезапно возникшая Чёрная тень».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310217,
					"content": "Когда я очнулся, лагерь был пуст.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310218,
					"content": "Ай-ай-ай, Рюдзи, как же так? Куда же подевался суровый Рюдзи, который с грозным рёвом, достойным óни Торатиё, победил преступника в деле «Самбонгатана Кимпати»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310219,
					"content": "А потом, рыдая, держал меня на руках, пока я притворялась мёртвой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310220,
					"content": "О нет, прошу, остановись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310221,
					"content": "Ого! А что было потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310222,
					"content": "Давайте лучше разберёмся с текущим делом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "Как бы то ни было, нам в Бантан Санго требуется помощь таких ловких искателей приключений, как вы, чтобы спасти этих животных!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310228,
					"content": "Если Рюдзи снова оглушат, вы хотя бы сможете приглядеть за обстановкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310229,
					"content": "Санго, а почему ты сама не хочешь пойти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310230,
					"content": "Ах, прошу, не забывайте, что я мозг этой группы. Моя работа - размышлять. А плоть моя лишь придаток к разуму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310231,
					"content": "(Ух ты, как здорово она аргументирует свою лень!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310232,
					"content": "Конечно, вы не будете работать бесплатно. Как и было сказано, вас ждёт немаленькое вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310233,
					"content": "Вот эти слова Паймон по душе! Чего же мы ждём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310234,
					"content": "Ох уж эта Паймон...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "Один момент, если позволите. Пожалуйста, возьмите это с собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310237,
					"content": "А это что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310238,
					"content": "<color=#00E1FFFF>Сеть вездесущности</color>. Я попросила подругу сделать её по записям об оммёдо Камуны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310239,
					"content": "Её силы недостаточно для ловли преступников. А вот для животных её должно хватить, надо только получше прицелиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310240,
					"content": "Благодаря этому вернуть пропавших животных будет проще простого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310241,
					"content": "Ух ты! Теперь это нам раз плюнуть! Спасибо, Санго, ты лучшая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310242,
					"content": "Ох, не думаю, что это заслуживает титула «лучшей». Просто дополнительная страховка от неудачи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310243,
					"content": "Рюдзи, отправишься с ними, ладно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310244,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310245,
					"content": "Я обнаружил ещё несколько цепочек следов пропавших животных. Следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310246,
					"content": "Тогда в путь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "Счастливого пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310247,
					"content": "Спасибо, Санго.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "Какая целеустремлённость!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "И что же случилось потом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "О, вы интересуетесь нашим прошлым делом? В общем, дело было так. Полицейский по имени Кимпати, который в обычное время славился своим миролюбием...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400310225,
					"content": "П-пожалуйста, давайте вернёмся к нашему делу о животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310226,
					"content": "Эм-м, да, конечно. Прости, Рюдзи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "Санго"
				}
			]
		},
		{
			"id": 4003103,
			"completionStepIds": [
				4003103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003103",
							"2"
						],
						"stepId": 4003103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "По текущим данным расследования, это должно быть здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310302,
					"content": "Сколько здесь зверюшек! Они все потерялись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310303,
					"content": "А это... собака?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310304,
					"content": "Это место сторожит собака?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310305,
					"content": "Ох, я понял, как было дело. Как неловко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310306,
					"content": "Почему тебе неловко, Рюдзи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310307,
					"content": "Эта собака и есть Чёрная тень, которая так легко со мной разделалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310308,
					"content": "Может быть, это просто очень сильная собака.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "Не нужно... не нужно меня утешать. Моя подготовка недостаточна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310312,
					"content": "И эта её величественная осанка и гордый вид...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310313,
					"content": "Хм, вам она никого не напоминает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310314,
					"content": "Чайный дом «Коморэ»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "Точно! Паймон тоже о нём подумала! Нам ведь ещё сначала показалось, что он умеет говорить. Жалко, что на самом деле это не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310317,
					"content": "Вы говорите о хозяине чайного дома «Коморэ»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310318,
					"content": "Так ты с ним знаком, Рюдзи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310319,
					"content": "Кое-что слышал. Они и впрямь похожи. Но нам лучше не терять бдительности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310320,
					"content": "Про Таромару известно, что он много времени проводит с людьми и очень дружелюбен. Но об этой собаке мы ничего не знаем. Поэтому я считаю, что мы должны быть осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310321,
					"content": "М-м-м, звучит логично, Рюдзи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310322,
					"content": "Это просто опыт, вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310323,
					"content": "И всё же, зачем этой собаке собирать животных и потом охранять это место? Паймон не понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310324,
					"content": "Возможно, нам понадобятся дополнительные подсказки, чтобы выяснить это. А пока давайте сосредоточимся на спасении животных. Их хозяева очень переживают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310325,
					"content": "#Теперь дело за тобой, {NICKNAME}. После того как ты доберёшься до животных, остальное я возьму на себя. Я мигом доставлю их по домам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310326,
					"content": "Может, лучше устроим совместную атаку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "Мы пока не знаем, можно ли победить этого врага с помощью «совместной атаки».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310328,
					"content": "У тебя есть опыт тайных операций?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310329,
					"content": "Ну мы как-то пытались украсть Небесную лиру...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "Это... наверно, был интересный опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310333,
					"content": "Как бы то ни было, если пробраться мимо охраны, спасти животных должно быть нетрудно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310334,
					"content": "Я установил кое-что, что может отвлечь его внимание. Надеюсь, это тебе поможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310335,
					"content": "Принимайся за дело. Я посторожу здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310330,
					"content": "Нам удалось ускользнуть от преследователей во время Церемонии Сошествия...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "Мы как-то следили за одной важной шишкой на Рито...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "Таромару.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "Выходит, что ты такой слабак, Рюдзи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "Эй! Собака просто слишком сильная, вот и всё! Паймон вот тоже наверняка не справилась бы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4003105,
