			},
			"dialogs": [
				{
					"id": 400310501,
					"content": "Очень впечатляюще! Ты отлично двигаешься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310502
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310502,
					"content": "#Хе-хе! {NICKNAME} с таким справляется на раз-два!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310503,
					"content": "Ну что ж. Переходим к нашей следующей цели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310504
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310504,
					"content": "Что? Так это ещё не всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400310505,
					"content": "Точно не всё. Судя по количеству полученных Санго заявлений, это самое большое исчезновение животных в истории Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310506
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310506,
					"content": "Даже если оставить историю в стороне, масштабы этой пропажи выходят далеко за рамки нормального.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310507
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310507,
					"content": "Я прошёл по следам в другие места и там тоже обнаружил пойманных животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310508
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310508,
					"content": "Опять требуется мастер тайных операций?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310509
					]
				},
				{
					"id": 400310509,
					"content": "В этот раз нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310510
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400310510,
					"content": "Не переживай, вряд ли кто-то из противников сравнится с тобой. Придёшь на место - сразу увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				}
			]
		},
		{
