				"points": []
			},
			"dialogs": [
				{
					"id": 400315101,
					"content": "#Тебе что-нибудь нужно, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315102,
						400315107,
						400315110
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400315102,
					"content": "Мы можем поговорить о Сети вездесущности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "Ах, это... Изначально я планировала дать её Рюдзи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400315104,
					"content": "Наша работа не так уж безопасна, ты же понимаешь? Рюдзи уже несколько раз был ранен. Вот я и подумала - как бы нам ловить преступников с дальнего расстояния?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400315105,
					"content": "Я прочитала много старых книг и придумала эту сеть, а потом поручила подруге её изготовить. Но увы, пока её достаточно лишь для ловли мелких животных",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400315106,
					"content": "Но, по крайней мере, тебе она может быть полезна, уже неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 400315107,
					"content": "Мне всё-таки интересно, что стало с Самбонгатана Кимпати...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "О, тебе и правда интересно? Вот что тогда произошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 400315109,
					"content": "Хотя нет, знаешь, лучше я воздержусь от рассказа, раз Рюдзи против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				},
				{
					"id": 400315110,
					"content": "Мне пора идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315111
					]
				},
				{
					"id": 400315111,
					"content": "Счастливого пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		},
