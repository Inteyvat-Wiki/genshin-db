					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715080102,
					"content": "#Я рад, что Хедив нашёл {F#такую помощницу}{M#такого помощника}, без тебя ничего бы не вышло.",
					"roleType": "TALK_ROLE_NPC",
