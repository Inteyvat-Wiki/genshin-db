					"Кодзуэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "Приветствую в чайном доме Коморэ! Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "Кодзуэ"
				},
				{
					"id": 728010202,
					"content": "Я насчёт Рамзая...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "А, этот делец... Да, действительно, он в доме. Однако в последнее время он выглядит очень обеспокоено. Не знаю, что случилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "Кодзуэ"
				},
				{
					"id": 728010204,
					"content": "Если хотите найти его, ступайте в дом. Вы тут же увидите его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кодзуэ"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280103",
							"2"
						],
						"stepId": 7280103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рамзай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "#Вы... Путешественни{F#ца}{M#к}? Чем я могу помочь вам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010302,
					"content": "Я насчёт путевых заметок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "А, вы о путевых заметках, которые я пишу для этой девочки Мидори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010304,
					"content": "В последнее время я так занят, совсем не до них. Она, должно быть, беспокоится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010305,
					"content": "А в этих путевых заметках всё правда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "Ха-ха-ха, а вы как думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010307,
					"content": "Мне в них что-то не верится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "Ха-ха-ха, вижу, вы повидали мир. Вас не обманешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010311,
					"content": "Верно. По сути, ни один из фактов, описанных в путевых заметках, не является истинным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010312,
					"content": "Однако некоторые места и действующие лица созданы по мотивам реальных событий... Большая часть содержимого заметок - плод моего воображения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010313,
					"content": "Конечно, не всё там выдумано. Например, в заметке, которую я пишу, некий человек создал супершар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010314,
					"content": "Затем он позвал друзей, надеясь вместе с ними пролететь на этом шаре вокруг Тейвата за 80 дней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010315,
					"content": "А еще для управления этим шаром не нужен Глаз Бога. Достаточно технической подкованности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010316,
					"content": "Эти люди путешествуют по свету на воздушном шаре, а по пути сталкиваются со всевозможными странными вещами и явлениями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010317,
					"content": "Я собирался написать обо всём этом Мидори. Но почему-то не успеваю даже закончить коротенький абзац.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010318,
					"content": "Но почему?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "Видите того человека в коридоре? Его зовут Хэйхати. И он всё смотрит и смотрит на меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010320,
					"content": "Я собирался выйти на прогулку, чтобы найти вдохновение для написания заметок. Но этот человек всюду следует за мной. Даже не знаю, какова его цель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010321,
					"content": "Боюсь, он замыслил что-то недоброе. И выйти отсюда я не решаюсь. Вот почему написание путевых заметок откладывается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010322,
					"content": "#К счастью, теперь вы здесь. Путешественни{F#ца}{M#к}, не проводите ли меня на улицу? Мне нужно найти вдохновение! Пока вы здесь, он не посмеет ничего со мной сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010323,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "Большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010327,
					"content": "Как говорится, бережёного бог бережёт. Кто-то наблюдает за мной со спины. Я должен во что бы то ни стало избавиться от него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010328,
					"content": "#Прошу, защищайте меня, пока я ищу вдохновение, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010329,
					"content": "На самом деле, у меня на примете есть несколько мест. Отправимся же туда прямо сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010330,
					"content": "Первое место неподалёку от пляжа. Идёмте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010325,
					"content": "Зачем ему это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "Не знаю. Но... Людям не нужны причины, чтобы замыслить против кого-то недоброе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010309,
					"content": "Надеюсь, что правда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "Ха-ха-ха, мне тоже хотелось бы, чтобы всё, о чём я пишу, сбывалось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Рамзай"
				}
			]
		},
