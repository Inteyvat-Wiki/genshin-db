		{
			"id": 7280105,
			"completionStepIds": [
				7280105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280105",
							"2"
						],
						"stepId": 7280105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рамзай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "Вода на этом пляже кристально чистая, а песок такой белый... Всё совсем не так, как в открытом море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010502,
					"content": "Замечательное место, откуда было бы здорово пуститься в плавание... или взлететь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728010503,
					"content": "Хм, этот пейзаж весьма привлекателен. Я сделаю кое-какие заметки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
