			"dialogs": [
				{
					"id": 728011301,
					"content": "Отсюда, с вершины горы, можно охватить взглядом почти весь остров Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011302
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728011302,
					"content": "Ветер на вершине довольно сильный, а высота отлично подходит для взлёта. Никаких препятствий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011303
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728011303,
					"content": "Да и Инадзума довольно далеко, так что нас не побеспокоит ни Досин... ни незваные гости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011304
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728011304,
					"content": "Это и впрямь хорошее место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011305
					]
				},
				{
					"id": 728011305,
					"content": "В конце концов, отсюда было бы неплохо взлететь... К тому же это место достойно упоминания в путевых заметках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011306
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728011306,
					"content": "Этот человек... он всё ещё следует за нами. Прямо-таки идёт по пятам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011307
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728011307,
					"content": "Я от него избавлюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011308
					]
				},
				{
					"id": 728011308,
					"content": "Нет, что вы, не беспокойтесь. Он не посмеет перейти к решительным действиям, пока вы рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011309
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728011309,
					"content": "С такими людьми надо быть настороже... Стоит только подойти, и они больше не отвяжутся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011310
					],
					"speakerTitle": "Рамзай"
				},
				{
					"id": 728011310,
					"content": "Ладно, на сегодня хватит. Вернёмся в чайный дом Коморэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рамзай"
