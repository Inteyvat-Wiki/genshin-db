				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060301,
					"content": "Теперь я подключусь к твоему терминалу Акаши и запишу данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060302
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060302,
					"content": "А теперь используй Капсулу знаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060303
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060303,
					"content": "#Возьми её в руку. Я помогу тебе установить связь с капсулой, чтобы ты мог{F#ла} активировать её силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аль-Хайтам"
				}
			]
		},
		{
			"id": 300604,
			"completionStepIds": [
				300606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300606",
							"2"
						],
						"stepId": 300606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060401,
					"content": "Теперь я снова запишу данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060402
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060402,
					"content": "Аль-Хайтам, ну, что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060403,
					"content": "#Хм... Купленная вами Капсула знаний явно улучшила {M#его}{F#её} способности. Во второй битве общие данные боевых навыков увеличились на 0,073% по сравнению с первой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060404
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060404,
					"content": "Так мало?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060405,
						30060406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060405,
					"content": "0,073%.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060407
					]
				},
				{
					"id": 30060407,
					"content": "Проклятье! Эта торгашка Дори провела нас! Один миллион моры? Эта штука и ста тысяч не стоит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060408,
					"content": "#Одна из возможных причин такого результата заключается в том, что {M#он уже был очень сильным}{F#она уже была очень сильной} на момент использования Капсулы, поэтому содержащиеся в ней знания вряд ли могли дать значительное увеличение показателей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060409
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060409,
					"content": "Зато это испытание позволило мне получить больше информации о вас. Я начинаю верить, что наше сотрудничество может быть выгодным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060410
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060410,
					"content": "Я возвращаюсь в викалу «Фундук». Жду новостей через два дня. Это мора, чтобы заплатить Дори за информацию. Заплати столько, сколько она попросит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060406,
					"content": "Это ничто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060407
					]
				}
			]
		},
		{
			"id": 300605,
			"completionStepIds": [
				300607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300607",
							"2"
						],
						"stepId": 300607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дори"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060501,
					"content": "Сюда, сюда! С возвращением, мои любимые клиенты. Чем я могу быть полезна на этот раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060502
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060502,
					"content": "Капсулы знаний или что-то другое, всё что угодно. Только скажите, и я найду способ достать это... Если у вас есть много блестящей моры, разумеется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060503
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060503,
					"content": "Дори, ты правда можешь достать всё на свете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060504,
					"content": "Ага! Выходит, одних Капсул знаний вам уже недостаточно? Не стесняйтесь, говорите, что у вас на уме!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060505
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060505,
					"content": "Мы хотим приобрести Капсулу знаний Архонта.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060506
					]
				},
				{
					"id": 30060506,
					"content": "О, хе-хе! Я знала, что такие обеспеченные клиенты, несомненно, жаждут чего-то большего, чем обычные Капсулы знаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060507
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060507,
					"content": "Знайте, такая информация не будет дешёвой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060508
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060508,
					"content": "Мне пришлось очень постараться, чтобы проложить себе путь на площадку аукциона. Не говоря уже о том, что, если кто-нибудь узнает, что это я допустила утечку информации, у меня будут большие проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060509
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060509,
					"content": "Как мы можем быть уверены в достоверности твоей информации? Довольно занятно, что информация оказалась у тебя именно в тот момент, когда она нам понадобилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060510,
					"content": "Хе-хе... Всё ценное на рынке является для меня товаром. Я всегда должна быть в курсе того, что актуально на рынке, чтобы заключать больше сделок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060511
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060511,
					"content": "Что касается подлинности информации, я сфотографировала сделку. Таким образом, никто не сможет поставить её под сомнение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060512,
						30060513
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060512,
					"content": "Назови цену.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				},
				{
					"id": 30060514,
					"content": "Всегда приятно иметь дело с такими хорошими клиентами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060515
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060515,
					"content": "Кхм, теперь, когда вы заплатили, приготовьтесь услышать шокирующую информацию. Капсулу знаний Архонта вчера купил не кто иной, как Мизри, лидер «Аин аль-Ахмара».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060516
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060516,
					"content": "«Аин аль-Ахмар»? Пустынники, которые поклоняются царю Дешрету?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060517,
					"content": "Да. Похоже, вы хорошо их знаете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060518
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060518,
					"content": "«Аин аль-Ахмар» сделали всё возможное, чтобы получить Капсулу знаний Архонта. Они верят, что в ней содержится сила царя Дешрета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060519
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060519,
					"content": "Эта Капсула знаний Архонта не похожа ни на что, виденное мною ранее. От неё исходило ярко-красное свечение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060520
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060520,
					"content": "Капсулу хорошо видно на фотографии, которую я сделала. Можете посмотреть сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060521
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060521,
					"content": "Спасибо за информацию, Дори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060522
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060522,
					"content": "Не стоит благодарности. Мои вчерашние усилия не пропали даром благодаря вам, мои проницательные клиенты. Не стесняйтесь обращаться ко мне, если вам понадобится что-то ещё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дори"
				},
				{
					"id": 30060513,
					"content": "Я покупаю эту информацию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				}
			]
		},
		{
			"id": 300606,
			"completionStepIds": [
				300608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
