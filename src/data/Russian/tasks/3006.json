			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060101,
					"content": "Вы пришли. Судя по вашему виду, вы добились успеха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060102
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060102,
					"content": "Ого, да здесь полно людей из Академии. Почему ты выбрал именно это место для встречи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060103,
					"content": "Викала «Фундук» находится под контролем Академии. Естественно, здесь работают люди из Академии. Я прибыл в Порт-Ормос под предлогом ведения официальных дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060104
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060104,
					"content": "Дерзости тебе не занимать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060105,
					"content": "Расслабься, здесь никого не интересует, о чём мы говорим, а матра сюда не заглядывает. Итак, расскажите, как прошла ваша встреча с Дори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060106
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060106,
					"content": "Вы рассказываете аль-Хайтаму, что произошло, и отдаёте ему купленные Капсулы знаний...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060107
					]
				},
				{
					"id": 30060107,
					"content": "Аль-Хайтам, мы выполнили свою часть договора. Можешь рассказать нам о Капсуле знаний, которую потеряла Академия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060108,
					"content": "Сначала я хотел бы узнать, зачем она вам? Можете не отвечать, конечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060109,
						30060110
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060109,
					"content": "Это не секрет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				},
				{
					"id": 30060111,
					"content": "#Верно, {NICKNAME} хочет получить аудиенцию у божества мудрости, чтобы задать ей несколько вопросов. Но за всё время нашего пребывания в Сумеру мы так и не смогли найти способ сделать это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060112,
					"content": "Мы узнали, что Академия потеряла что-то, что может быть связано с Архонтами, поэтому решили попытать счастья здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060113,
					"content": "В таком случае вы на верном пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060114
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060114,
					"content": "Некоторое время назад Академия потеряла в пустыне Капсулу знаний. Предположительно, это Капсула знаний Архонта, с помощью которой можно обрести божественную мудрость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060115
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060115,
					"content": "#Ух ты, даже такое есть?! Скажем, если мы найдём её, то будем знать всё: от способа получить аудиенцию у Дендро Архонта до ответа на вопросы о {M#твоей сестре}{F#твоём брате}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060116,
					"content": "Я очень сомневаюсь, что она обладает какими-либо мистическими свойствами, но капсула действительно существует и находится здесь, в Порт-Ормосе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060117
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060117,
					"content": "Где она сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060118,
					"content": "Выяснить это и есть наша следующая задача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060119
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060119,
					"content": "Ты тоже её ищешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060120
					]
				},
				{
					"id": 30060120,
					"content": "Не стану отрицать. Я провожу расследование, потому что мне интересно, что на самом деле представляет собой Капсула знаний Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060121
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060121,
					"content": "Как вам известно, Пустынники в Порт-Ормосе тоже положили на неё глаз. Это довольно ценный предмет, и знания, содержащиеся в нём, могут даровать власть и богатство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060122
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060122,
					"content": "В последнее время несколько бригад ведёт борьбу за право владеть капсулой, но победитель пока не выявлен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060123
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060123,
					"content": "Мои личные финансы и связи не могут конкурировать с финансами и связями Пустынников. После некоторых усилий мне, наконец, удалось достичь предварительной договорённости с несколькими бригадами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060124
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060124,
					"content": "Я согласился отказаться от владения Капсулой знаний Архонта в обмен на возможность изучить её. В конце концов, нет ничего плохого в том, чтобы понять, что это такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060125
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060125,
					"content": "Однако есть и те, кто не идёт на переговоры. Например, Пустынники из «Аин аль-Ахмара».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060126
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060126,
					"content": "Они твёрдо верят, что в Капсуле знаний Архонта заключена сила царя Дешрета и что он вернётся в этот мир, когда они получат капсулу. Они не позволят кому-либо из Академии запятнать дух своего божества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060127
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060127,
					"content": "Значит, ты преследуешь их, потому что они отказались сотрудничать с тобой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060128,
					"content": "Да. «Аин аль-Ахмар» не самая богатая и влиятельная бригада, но её члены полны решимости получить эту капсулу. Они используют любые скрытые методы обогащения, чтобы собрать достаточно средств.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060129
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060129,
					"content": "Поэтому я вмешиваюсь в их дела, чтобы принудить их к переговорам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060130
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060130,
					"content": "Капсула знаний Архонта должна быть выставлена на тайном аукционе в ближайшие несколько дней. Каждая бригада сделает свою ставку, и капсула будет тайно передана победителю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060131
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060131,
					"content": "Чтобы обеспечить безопасность капсулы и избежать внимания матры, получившая Капсулу бригада не будет раскрывать свою победу на аукционе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060132
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060132,
					"content": "Пока я не узнаю, кому в итоге достанется Капсула знаний Архонта, не о чем договариваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060133
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060133,
					"content": "Дори - самый надёжный источник информации, но раньше этот путь был для меня закрыт. Теперь, когда у меня есть вы, ситуация изменилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060134
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060134,
					"content": "Другими словами, ты хотел, чтобы мы подружились с Дори, чтобы узнать, где находится Капсула знаний Архонта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060135,
					"content": "Да, можно и так сказать, но такой расклад не вредит никому из нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060136
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060136,
					"content": "Послезавтра вернитесь к Дори и попытайтесь узнать о местонахождении Капсулы знаний Архонта. Если у неё не будет информации, подождите ещё два дня и обратитесь к ней снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060137
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060137,
					"content": "Если у меня будет возможность изучить Капсулу знаний Архонта, я поделюсь с вами результатами исследования. Как вам такое вознаграждение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060138,
						30060139
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060138,
					"content": "Именно это мне и нужно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060140,
					"content": "Хорошо, тогда встретимся через два дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060141
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060141,
					"content": "Аль-Хайтам, ещё один вопрос. Мы приобрели одну Капсулу знаний для себя, но не знаем, как ею пользоваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060142,
					"content": "Хотите использовать Капсулу знаний? Хорошо, я научу вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060143
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060143,
					"content": "Сделать это прямо под носом у Академии будет несколько проблематично. Пойдёмте на окраину города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060139,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060110,
					"content": "Мы ищем способ встретиться с Дендро Архонтом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				}
			]
		},
		{
			"id": 300602,
			"completionStepIds": [
				300602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300602",
							"2"
						],
						"stepId": 300602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060201,
					"content": "Это место подойдёт. Покажите мне свою Капсулу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060202
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060202,
					"content": "Вот она.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060203,
					"content": "«Техника фехтования на мечах VIII»... Капсула боевых знаний. Подобные знания встречаются редко, так как большинство из них используется Пустынниками для усиления своих боевых возможностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060204
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060204,
					"content": "Правда? Как здорово, что мы не зря её приобрели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060205,
					"content": "#Чтобы узнать эффективность знаний, я могу помочь тебе проверить твои боевые способности. Однако эффект, скорее всего, будет минимальным, если ты уже достаточно {F#сильна}{M#силён}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060206
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060206,
					"content": "Мы можем провести контролируемый эксперимент, в котором ты будешь сражаться в двух битвах. До использования Капсулы знаний и после.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060207
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060207,
					"content": "Пока ты сражаешься, я попрошу терминал Акаши измерить твои физические параметры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060208
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060208,
					"content": "В испытаниях могут быть различия в твоей физической силе, а также в способностях ваших противников... Но не волнуйся, позже я проведу статистический анализ, чтобы исключить искажение данных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060209
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060209,
					"content": "Ого... Аль-Хайтам, ты, наверное, один из отличников Академии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060210,
					"content": "Паймон интересно, ты не похож на тех студентов, которым нужны Капсулы знаний, чтобы закончить Академию, так почему ты рискуешь попасться матре ради этой капсулы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060211,
					"content": "Мне тоже интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060212
					]
				},
				{
					"id": 30060212,
					"content": "В большинстве случаев, когда невозможно понять действия учёного, их можно объяснить любопытством. Это незыблемая истина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060213
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060213,
					"content": "Хм... Похоже, ты пытаешься уйти от ответа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060214,
					"content": "Итак, приступим к испытанию. Просто сражайся, как обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аль-Хайтам"
				}
			]
		},
		{
			"id": 300603,
			"completionStepIds": [
				300604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300604",
							"2"
						],
						"stepId": 300604,
						"stateName": "QUEST_STATE_UNFINISHED"
