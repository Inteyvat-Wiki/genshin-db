			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аль-Хайтам"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060601,
					"content": "Аль-Хайтам, у нас есть для тебя информация!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060602,
					"content": "Правда? С удовольствием послушаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060603,
						30060604
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060603,
					"content": "Капсула в руках «Аин аль-Ахмара».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				},
				{
					"id": 30060605,
					"content": "Дори предоставила нам доказательства сделки. Взгляни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060606,
					"content": "О, снимок очень чёткий. Она не только решилась отправиться на торговую площадку Пустынников, но и подобралась очень близко. Это требует большого мужества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060607
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060607,
					"content": "На этой фотографии действительно изображён Мизри, лидер «Аин аль-Ахмара». В руке он держит уникальную красную Капсулу знаний. Она выглядит, как Капсула знаний Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060608
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060608,
					"content": "В таком случае если всё будет сделано правильно, то когда мы встретимся с ними на следующей неделе, то сможем заставить их раскрыть карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060609
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060609,
					"content": "Сначала Паймон не понимала, зачем провоцировать этих парней из «Аин аль-Ахмара», но теперь всё становится ясно. Всё идёт по твоему плану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060610,
					"content": "После победы над ними мы сможем наконец поговорить с их лидером и попросить его одолжить нам Капсулу знаний Архонта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060611,
					"content": "Спасибо за ваше время и усилия. Отдохните несколько дней, пока я сделаю кое-какие приготовления. Встретимся снова ровно в три часа пополудни в назначенный день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060612
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060612,
					"content": "Договорились!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060613
					]
				},
				{
					"id": 30060613,
					"content": "До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060614
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060614,
					"content": "День встречи с «Аин аль-Ахмаром»...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060615
					]
				},
				{
					"id": 30060615,
					"content": "Аль-Хайтам определённо не торопится. Где он может быть? А, вот и он.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060616
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060616,
					"content": "Извините, что заставил вас ждать. Пойдёмте на пирс перед Фаросским маяком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060617
					],
					"speakerTitle": "Аль-Хайтам"
				},
				{
					"id": 30060617,
					"content": "Да! Идём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30060604,
					"content": "Та самая бригада, с которой у нас намечена встреча.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				}
			]
		},
		{
			"id": 300607,
			"completionStepIds": [
				300609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
