			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Синь Янь",
					"Мона",
					"Каэдэхара Кадзуха",
					"Фишль",
					"Оз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "О, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400750802,
					"content": "Мона, этот искатель приключений... мёртв?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400750803,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750804,
					"content": "Я видела его лишь однажды. С тех пор прошло три года, так что... скорее всего, да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750805,
					"content": "М-может, есть хотя бы малюсенький шанс, что он ещё жив? Может, ты просчиталась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400750806,
					"content": "Но это несправедливо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "Если отрицать возможность плохого и слепо верить в хорошее, то это уже будет не предсказание, а самообман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750808,
					"content": "Гадать, чтобы развлечься, это одно дело, но в моей области специализации нет места для лжи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750809,
					"content": "Отрицать собственные заключения было бы кощунством по отношении к астрологии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750810,
					"content": "Такова судьба. Жестокая, но правдивая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400750811,
					"content": "Обычно я об этом не говорю, но, надеюсь, вы не станете ставить астрологию в один ряд с вытягиванием гадальных палочек у уличных лоточников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750812,
					"content": "Мы изучаем астрологию не для того, чтобы всем угождать. Астрологи существуют для того, чтобы проверять и подтверждать истину мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750813,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750814,
					"content": "Да!.. Именно поэтому, скажу я вам, к астрологии относятся с неприязнью. Искусство это великое, но приносящее всем досаду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750815,
					"content": "Почто ты так негодовать изволишь, госпожа Мегистус? Ты не так уж и недостойна дружбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400750816,
					"content": "Миледи хочет сказать, что рада быть вашим другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400750817,
					"content": "Н-нет! Ничего я такого не говорила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400750818,
					"content": "Оз, да что с тобой такое? В последнее время ты так и норовишь ложно истолковать мои изреченья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400750819,
					"content": "О, и почему же? Может, я беспокоюсь, что принцесса ненароком обидит друзей, вот я и пытаюсь смягчить её слова?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400750820,
					"content": "Хоть я других астрологов и не знаю, но думаю, что ты классная. Я вообще не чувствую неприязни к тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400750821,
					"content": "Ну а те, кто выискивают секреты и закрывает глаза на всё, что им не нравится... Это им стоит задуматься о том, что такие знания имеют свою цену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400750822,
					"content": "Если бы судьбу можно было избежать с помощью парочки фраз, в мире бы не было горя. Не принимай близко к сердцу, Мона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400750823,
					"content": "Главное - следовать зову сердца и поступать правильно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400750824,
					"content": "Кхм! Н-не надо утешать меня, спасибо. Я человек сильный, знаете ли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750825,
					"content": "Тогда почему у тебя уши покраснели?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "Эм... Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750827,
					"content": "Ладно, кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750828,
					"content": "С-спасибо... всем вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750829,
					"content": "Слишком тихи речи твои. Придай словам благодарности принцессе силы, выраженья!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400750830,
					"content": "Ладно, ладно, ваше высочество. Почему бы не отложить перебранку на потом и отправиться к новому месту в отражении пруда, чтобы собрать оставшиеся фрагменты? Без них нам не войти в мир грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400750831,
					"content": "Только ваш зоркий взгляд способен узреть то, что не под силу нам, миледи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400750832,
					"content": "Так и быть, принцесса отправится на пляж...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400750833,
					"content": "Идём, Мона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400750834,
					"content": "А?.. А! Уже иду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400750835,
					"content": "...Ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		}
	]
}