			"dialogs": [
				{
					"id": 740360101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360102,
						740360103
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360102,
					"content": "Айюн?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				},
				{
					"id": 740360104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360105
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360105,
					"content": "Айюн!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360106
					]
				},
				{
					"id": 740360106,
					"content": "А? Что? В чём дело? Да, я закончил, закончил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360107
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360107,
					"content": "Это я. Ты закончил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360108
					]
				},
				{
					"id": 740360108,
					"content": "А, это вы... Простите, я, похоже, задремал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360109
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360109,
					"content": "Господин Роялт и господин Семан полночи помогали мне, и под их руководством я наконец закончил эту инициативу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360110
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360110,
					"content": "Но я так устал, что стоило мне закрыть глаза, как я тут же уснул...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360111
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360111,
					"content": "Теперь мне нужно найти господина Фалеса для проставления официальной печати Палаты Жестьон, а затем отдать инициативу господину Дифору, её передадут в печать... И на этом всё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360112,
						740360113
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360112,
					"content": "Звучит очень просто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360114,
					"content": "Вовсе нет. Как бы то ни было, я слышал, что господин Фалес представил совершенно новый тип машины для проставления печатей. Говорят, что она очень удобна и сделана с учётом требований конфиденциальности, так что её планируют использовать во всей Палате Жестьон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360115
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360115,
					"content": "Смотрите, господин Роялт также дал мне ключ. Такой ключ есть у каждого отдела, он нужен для активации штамповочной машины... В общем, всё очень официально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360116
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360116,
					"content": "Может, лучше ты ещё поспишь? Тебя же ноги не держат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740360117,
					"content": "Раз уж осталось всего лишь поставить печать и разобраться с этой... штамповочной машиной, то и незачем так спешить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 740360118,
					"content": "Нет, нельзя больше тянуть время. Идёмте, нужно всего лишь поставить печать, это быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 740360113,
					"content": "Это куда проще, чем то, что ты уже сделал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360103,
					"content": "Ты закончил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				}
			]
		},
		{
