			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ин Эр",
					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716600101,
					"content": "Вы вернулись! Расскажите про эффект Зелий тлеющего града.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600102,
						716600105
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600102,
					"content": "Было бы лучше использовать его не в подземелье.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600103
					]
				},
				{
					"id": 716600103,
					"content": "Именно, это было бы идеально!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600104,
					"content": "А? Неплохая идея, расскажите подробнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600108,
					"content": "Вы в подробностях рассказываете Тимею детали эксперимента.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600109
					]
				},
				{
					"id": 716600109,
					"content": "Всё так, как вы предсказывали, госпожа Ин Эр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600110
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600110,
					"content": "Я вижу направление, в котором мне следует усовершенствовать Зелье тлеющего града. Необходимо контролировать результат сублимации в определённом диапазоне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600111
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600111,
					"content": "Может быть... если использовать свойства одуванчика и сделать специальную добавку, то можно заставить поток ветра воздействовать на зелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600112
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600112,
					"content": "Но никто этого раньше не делал. Мне потребуется много времени и сил, чтобы доказать целесообразность этого метода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600113
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600113,
					"content": "Паймон ничего не понимает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600114,
					"content": "Но мне кажется, что Ин Эр всегда высказывает дельные предложения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600115,
					"content": "Но мои предположения никак нельзя назвать точными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600116
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716600116,
					"content": "Пытаешься ли ты понять меня, ищущий алхимик, или польстить... и порадовать меня разными способами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600117
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716600117,
					"content": "Я... я просто искренне восхищаюсь вашей учёностью, госпожа Ин Эр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600118
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600118,
					"content": "Хорошо, хорошо. Тогда вам нужно работать усерднее. Возможно, в будущем вы сможете применить свои знания в других областях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600119
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716600119,
					"content": "Не забудьте рассказать мне о результатах своих исследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600120
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716600120,
					"content": "Конечно... я отправлю вам лучший экземпляр зелья в подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600121
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600121,
					"content": "Госпожа Ин Эр, если у вас есть время, я приглашаю вас пойти вместе с нами в ресторан «Народный выбор»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600122
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600122,
					"content": "На этом наш академический обмен окончен. Меня ждут дела в «Весенних ароматах».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600123
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716600123,
					"content": "Не забывайте навещать меня, когда у вас будет свободное время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600124
					],
					"speakerTitle": "Ин Эр"
				},
				{
					"id": 716600124,
					"content": "Всенепременно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600125
					]
				},
				{
					"id": 716600125,
					"content": "Спасибо, Ин Эр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600126,
					"content": "Ин Эр уходит.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600127
					]
				},
				{
					"id": 716600127,
					"content": "Увы, так и не получилось сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600128
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600128,
					"content": "Госпожа Ин Эр так занята. Нехорошо занимать её время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600129
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600129,
					"content": "Лучше подождать подходящего момента...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600130
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600130,
					"content": "Тимей, что ты там бормочешь себе под нос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600131,
					"content": "Ничего!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600132
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600132,
					"content": "Я просто обязан поблагодарить вас за помощь! Как и договаривались, я приглашаю вас в ресторан «Народный выбор».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600133
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600133,
					"content": "#Я и забыл{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600134
					]
				},
				{
					"id": 716600134,
					"content": "Время есть вкусняшки! Много вкусняшек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600135,
					"content": "Вы с Тимеем идёте в ресторан «Народный выбор» и наслаждаетесь роскошной трапезой.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600136
					]
				},
				{
					"id": 716600136,
					"content": "Ох! Паймон снова объелась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600137,
					"content": "На самом деле это было довольно интересное исследование, Тимей! Не забудь снова позвать нас, если соберёшься в Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600138,
						716600139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600138,
					"content": "Паймон ведь заботит не исследование!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600140,
					"content": "Паймон, между прочим, внесла свою лепту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600141,
					"content": "#Спасибо вам {M#обоим}{F#обеим}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600142
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600142,
					"content": "Боюсь, я ещё не скоро вернусь в Ли Юэ. После возвращения в Мондштадт я собираюсь сосредоточиться на улучшении Зелья тлеющего града.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600143
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600143,
					"content": "Возможно, скоро мне придётся просить вас побыть моими почтальонами. У меня не было времени выразить свою благодарность госпоже Ин Эр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600144
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600144,
					"content": "Что? Да вы же так долго разговаривали! Почему ты не успел поблагодарить её?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600145,
					"content": "Кхе-кхе! У госпожи Ин Эр очень... особенная манера речи! Нужно быть осторожнее со словами, поэтому лучше написать письмо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600146
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600146,
					"content": "Нам пора возвращаться. Мне не терпится приготовить Зелье тлеющего града.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600147
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 716600147,
					"content": "Мне одной кажется, что после разговора с Ин Эр Тимей стал вести себя очень странно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600148
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600148,
					"content": "Очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600139,
					"content": "Ты только о еде и думаешь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600105,
					"content": "Есть над чем поработать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600106
					]
				},
				{
					"id": 716600106,
					"content": "Да! Например, чтобы эффект проявлялся не в подземелье!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716600107,
					"content": "Мы как раз обсуждаем этот вопрос с госпожой Ин Эр. Опишите детали эксперимента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Тимей"
				}
			]
		}
	]
}