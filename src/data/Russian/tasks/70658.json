			"dialogs": [
				{
					"id": 706580101,
					"content": "Привет! Как тебе Праздник ветряных цветов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706580102,
					"content": "Спасибо за рекомендацию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "Хе-хе, у меня для тебя довольно расслабляющее событие. Оно называется «Песнь ветров».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706580105,
					"content": "Уверена, вы видели бардов Мондштадта. Участие в этом событии позволит вам сыграть прекрасные песни, так же, как и они!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706580106,
					"content": "Почувствуйте дыхание ветра на вершинах гор и берегах рек и вложите душу и сердце в свою мелодию. Это верный способ забыть все заботы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706580107,
					"content": "Но у меня совсем нет опыта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "Не волнуйся. Это событие специально сделано так, чтобы люди без музыкального опыта могли наслаждаться радостями музыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706580110,
					"content": "Всё будет хорошо до тех пор, пока вы следуете подсказкам и держите ритм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706580111,
					"content": "Это обнадёживает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "Наслаждайтесь праздником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706580112,
					"content": "Тогда я попробую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "Это действительно будет звучать хорошо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580103,
					"content": "У меня не было времени...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				}
			]
		}
