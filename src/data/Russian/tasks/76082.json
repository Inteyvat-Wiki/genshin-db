			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Майте",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "Ого! Он что, стал ещё больше, чем раньше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760141702,
					"content": "Хм-хм, конечно. После того как он съел столько с трудом найденных мною ягод лакка, его величество стал даже круглее, чем Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141703,
					"content": "Эй! К чему такие странные сравнения!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760141704,
					"content": "#Ого! Что такое? Как только {F#появилась}{M#появился} {NICKNAME}, так сразу проснулся интерес?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141705,
					"content": "#Похоже, хочет сразиться с {M#братцем}{F#сестрицей}... Ха, неужели не может смириться с тем, что в прошлый раз был полностью разгромлен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141706,
					"content": "Ну, давай!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#Будь осторожнее, {M#братец}{F#сестрица}. Он уже намного сильнее, чем в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141708,
					"content": "А? Прямо сейчас?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "#Не нужно потакать его прихотям, {M#братец}{F#сестрица}. Ты можешь принять его вызов, когда будет настроение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141710,
					"content": "Теперь это существо под моим покровительством и слушается меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141711,
					"content": "Подойди, молодец, лежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141712,
					"content": "Он что тебе, собака?! К тому же разве крабы не постоянно лежат?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
