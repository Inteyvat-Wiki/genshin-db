	"talks": [
		{
			"id": 7601414,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7608201",
							"2"
						],
						"stepId": 7608201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Майте"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "#Что такое, {M#братец}{F#сестрица}? Есть ещё вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141402,
					"content": "О том крабе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "Эх, несмотря на устрашающий вид, на самом деле у него всегда был довольно мягкий характер. Без своего странного камня он, наверняка, снова станет прежним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141404,
					"content": "А сейчас пусть прячется и думает о том, что наделал. Неважно, влиял на него камень или нет, всё сделанное им плохое уже не исправить, и раны крабиков, которых он ранил, тоже не стереть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141405,
					"content": "Как и в случае с алчным губернатором, которого когда-то одолел великий вор Рид Миллер, любые оправдания тут бессмысленны. Раскаяние всегда должно подкрепляться реальными действиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141406,
					"content": "Расскажи о том странном камне...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "Хм, камень, способный{RUBY#[D]Камень Твардовской} управлять человеческими желаниями... Кажется, сестрица Хидимби его так называла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141408,
					"content": "Кхм, в общем, кажется, что это такая же штука с неба, как и тот большой булыжник там, где живут Дети Морозной Луны. Раз уж улетел, наверное, больше не представляет для нас никакой угрозы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141409,
					"content": "Расскажи о Банде Раковины...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#А? {M#Братец}{F#Сестрица} хочет узнать о Банде Раковины? Ну, раз ты уже товарищ банды, то можешь спрашивать что угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141411,
					"content": "#Мы, можно сказать... организация взаимопомощи и сотрудничества для ровесников-единомышленников. Хотя {M#братец}{F#сестрица}, наверное, уже слишком взросл{M#ый}{F#ая}, чтобы к нам присоединиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141412,
					"content": "Если в Нашгороде тебе вдруг понадобится помощь, дай мне знать. Чем смогу, тем помогу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141413,
					"content": "Расскажи о том странном человеке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "А, ты о той фиолетовой жрице. Она же ничего плохого нам ещё не сделала, значит, по крайней мере сейчас она нам точно не враг. Давай постараемся просто не вмешиваться в её дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141415,
					"content": "Любопытство до добра не доведёт. Сестрица Катя тоже говорила держаться подальше от этих чудаков из Морозной Луны. Даже я, великий вор, чуть не попалась им - они хотели принести меня в жертву Богине Луны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141416,
					"content": "Принести в жертву?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "Ага, эти ребята очень жуткие. Говорят, они даже смешивают кровь разных людей... Ух, даже подумать страшно. Ладно, давайте не будем об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141418,
					"content": "К счастью, меня тогда поймала ничего не смыслящая девчонка, стоило рассказать ей несколько историй, и она согласилась меня отпустить. А иначе бы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141419,
					"content": "#Не... не то чтобы я боялась, ведь великий вор не может бояться! Просто хочу предупредить {M#братца}{F#сестрицу}, что лучше уж держаться подальше от их дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141420,
					"content": "Ах да, чуть не забыла про обещание выдать источник информации! О Детях Морозной Луны мне рассказала сестрица Хидимби.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141421,
					"content": "Если хотите найти её... хм, она, наверное, ещё где-то около Нашгорода? Если немного расспросить местных, думаю, быстро найдёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141422,
					"content": "Она вроде как собиралась на какое-то время уйти в тень...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "#А? {M#Братец}{F#Сестрица} уже встречал{M#ся}{F#ась} с сестрицей Хидимби? Я ничего не слышала о её планах отойти от дел... Ладно, выясню позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141424,
					"content": "Как-то тревожно на душе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "Не волнуйся, она очень надёжная. Я, Майте, тебе гарантирую, так что не стоит тревожиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майте"
				},
				{
					"id": 760141426,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "Ладно, попутного ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Майте"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
