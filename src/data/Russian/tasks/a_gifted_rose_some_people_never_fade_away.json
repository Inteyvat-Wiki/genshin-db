			"dialogs": [
				{
					"id": 732090501,
					"content": "Чтобы пробудить цветы этих молодых ростков, необходимо использовать силу <color=#00E1FFFF>Дендро</color>.",
					"roleType": "TALK_ROLE_NPC",
