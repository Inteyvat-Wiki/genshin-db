			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "Ах, это вы! Мы с розами ждём вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090102,
					"content": "Саббах тоже пришла пораньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732090103,
					"content": "В последнее время я часто сюда прихожу и уже прочитала все заметки, которые оставил Шафакат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090104,
					"content": "Раньше мне было одиноко в деревне Аару, но теперь я чувствую себя иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090105,
					"content": "По крайней мере, я не совсем одна. Теперь у меня есть розы и воспоминания о вас и господине Аффане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090106,
					"content": "В моей жизни всё ещё много приятных вещей, и поэтому я больше не чувствую себя такой одинокой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090107,
					"content": "Мы с господином Аффаном договорились, что я помогу ему ухаживать за золотыми розами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090108,
					"content": "Мы хотим вырастить их как можно больше и заполнить весь питомник. А пока пусть расцветут вот эти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090109,
					"content": "#Помнишь, как ты заставил{F#а} мои сумерские розы расцвести? Просто используй тот же метод, это должно сработать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090110,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "Давай, теперь дело за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				}
			]
		},
		{
			"id": 7320903,
			"completionStepIds": [],
