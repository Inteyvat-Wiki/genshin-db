					"speakerTitle": "Саббах"
				}
			]
		},
		{
			"id": 7320906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320902",
							"2"
						],
						"stepId": 7320902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "Если эти несколько роз вырастут здоровыми, то в будущем мы, безусловно, сможем вырастить ещё больше золотых роз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090602,
					"content": "Но перед этим я хочу увидеть, как расцветут эти золотые розы. Только тогда я успокоюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аффан"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320908",
							"2"
						],
						"stepId": 7320908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аффан",
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "Я уже почти потерял надежду. Не ожидал, что этот цветок действительно вырастет. Пока мы живы, с нами могут происходить удивительные вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090702,
					"content": "Ты всё ещё грустишь о Шафакате? Не печалься. Живые должны исполнять желания тех, кто уже покинул нас. Нельзя их подвести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090703,
					"content": "Господин Аффан... Я уже не так молода. Друзья из моего детства, должно быть, уже и сами обзавелись детьми, которые теперь уже достаточно взрослые, чтобы самим ходить в лавку за специями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090704,
					"content": "Но я согласна с вами. Мы живы, и нам нужно продолжать жить счастливо.",
