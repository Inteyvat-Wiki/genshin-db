						],
						"stepId": 7320903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саббах",
					"Аффан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "«О, роза-роза, желанье исполни».",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "«Роза златая из камня росла и пела мне песни».",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "Золотые розы действительно очень красивые. Паймон счастлива увидеть, как они расцветают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732090402,
					"content": "Паймон рада, что наши усердия не пропали даром!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 732090403,
					"content": "Желание наконец исполнилось.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "В конце концов, кое-что хорошее я сделал. Дядя Шафакат, я исполнил твоё желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090406,
					"content": "Жаль, что он этого не увидит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090407,
					"content": "Не говори так, Саббах. Ты помнишь последнюю строчку народной песни о розе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090408,
					"content": "«Песни мне дали сил для рожденья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090409,
					"content": "Песни одни лишь превыше судьбы и удела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090410,
					"content": "«Победят меня, победят время и вечное увядание жизни...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090411,
					"content": "Жизнь дяди Шафаката, его золотые розы и его песня всегда будут с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090412,
					"content": "Да, это так. Он преодолел время и увядание жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090413,
					"content": "Спасибо, что рассказали мне о дяде Шафакате. Это очень важно для меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090414,
					"content": "Он был изгнан сюда раньше меня, и, глядя на отголоски его жизни, я будто путешествую во времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090415,
					"content": "Я как будто увидела не только Шафаката, но и себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090416,
					"content": "Хотя я не могу поговорить с ними напрямую, но могу жить дальше с его сожалениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090417,
					"content": "Если мне удастся продолжить жизнь с его бременем, то, в конце концов, я обязательно искуплю свою вину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090418,
					"content": "Желаю тебе счастья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "Думаю, что жизнь здесь не так уж и плоха. Я была очень рада познакомиться с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090421,
					"content": "Розы действительно могут принести людям счастье. Господин Аффан, мы должны постараться и вырастить больше роз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090422,
					"content": "Ха-ха-ха, договорились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "Аффан"
				},
				{
					"id": 732090423,
					"content": "Да, я буду стараться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				},
				{
					"id": 732090419,
					"content": "Не вешай нос.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "Это действительно того стоило.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
		{
