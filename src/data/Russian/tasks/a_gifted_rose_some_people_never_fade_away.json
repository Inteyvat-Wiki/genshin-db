			"dialogs": [
				{
					"id": 732090301,
					"content": "«О, роза-роза, желанье исполни».",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "«Роза златая из камня росла и пела мне песни».",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7320904,
			"completionStepIds": [
				7320903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
