			"trigger": {
				"objectNames": [
					"Принц"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "Мяу! (Ура, поздравляю! Задание на возвышение уровня пройдено! Теперь ты Мастер!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "Принц"
				},
				{
					"id": 706680202,
					"content": "Мяу. «Теперь ты Мастер, а это значит, что техникой игры ты превосходишь многих своих соперников. Такого уровня невозможно достичь без серьёзных усилий...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "Принц"
				},
				{
					"id": 706680203,
					"content": "«Конечно, люди, которым лень приложить усилия, никогда не поймут, почему мы тратим столько времени на карточную игру. Ведь для них игра всего лишь развлечение...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "Принц"
				},
				{
					"id": 706680205,
					"content": "Мяу! (Узнав, что перед ними игрок с рангом Мастера, твои соперники отнесутся к игре куда более серьёзно.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "Принц"
				},
				{
					"id": 706680206,
					"content": "«А некоторые игроки принимают вызов на поединок только от соперника с рангом Мастера и выше... Даже в нашей таверне есть такие упрямцы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "Принц"
				},
				{
					"id": 706680207,
					"content": "#Мяу... (Что ж, {NICKNAME}...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "Принц"
				},
				{
					"id": 706680208,
					"content": "«Пусть \"Священный призыв семерых\" подарит тебе настоящую радость!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Принц"
				}
			]
		},
