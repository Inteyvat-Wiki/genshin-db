			"dialogs": [
				{
					"id": 737130101,
					"content": "Та-дам! Мы на месте! Начинаем с этой отмели - постепенно открывается красивейший вид, будто картина разворачивается прямо перед нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737130102,
					"content": "А... Это вы. И с новыми спутниками? Это же... плесенники? Я только в книгах о таких читала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 737130103,
					"content": "Как удачно, что мы встретили мелюзину!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737130104,
					"content": "Рады снова видеть тебя, Марин.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "На самом деле, мы работаем. Собираем тидалью для засолки в этом году. Многие мелюзины прибыли в деревню, чтобы помочь нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 737130107,
					"content": "Анджиани и маленькая Роксана взяли отпуск и уже вовсю трудятся, а я вот скоро отправлюсь нырять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 737130108,
					"content": "Кстати, Анджиани была права. Синие плесенники и вправду немного напоминают тидалью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 737130109,
					"content": "Не в кулинарном смысле! Просто они милые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Бам-бам-шапочка"
				},
				{
					"id": 737130111,
					"content": "Хе-хе, согласна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737130112,
					"content": "Плесенники и впрямь очень милые.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "В общем, была рада встрече. Мне пора работать, а вам желаю приятно провести время в этих краях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 737130115,
					"content": "Тогда Паймон тоже предлагает отправиться дальше! Будем фотографировать подводные красоты Фонтейна вместе с нашими плесенниками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 737130113,
					"content": "Мелюзины тоже очаровательны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Привет! А мы с тобой, кажется, не знакомы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
