				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "Мы на месте. Но, как и говорила Сангономия, не видно никого подозрительного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140202,
					"content": "#Может, они спрятались? {NICKNAME}, давай осмотримся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140203,
					"content": "Эти <color=#00E1FFFF>монументы Электро</color> какие-то странные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тэппэй",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Ух... еле справились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140502,
					"content": "Вот это увалень... Откуда здесь этот здоровый лавачурл с громовым шлемом взялся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140503,
					"content": "Паймон ничего не понимает... а от этого места ей не по себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140504,
					"content": "Ну, хорошо, что всё кончилось. Пойдём... А? Тэппэй? А ты что здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140505,
					"content": "Кхм-кхм... Вот так встреча. Так это вы исследуете эту область?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140506,
					"content": "Я только что доставил припасы на передовую и решил заодно очистить эту область от угроз. Кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140507,
					"content": "Ты сам-то в порядке? На тебе лица нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140508,
					"content": "Ничего, я в норме. Просто подхватил простуду, когда несколькими днями ранее выходил в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140509,
					"content": "По пути я услышал, что кто-то только что прибыл исследовать остров, и решил посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140510,
					"content": "Будь здесь настоящая опасность, я мог бы стать героем... Но оказалось, что это вы. Выходит, зря ходил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140511,
					"content": "Тэппэй, тебе не кажется, что это место какое-то странное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140512,
					"content": "Хм... да, что-то такое чувствуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140513,
					"content": "Наверное, Татаригами здесь более осязаем. Останки Оробаси не так уж и далеко отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140514,
					"content": "Оробаси? Кто это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140515,
					"content": "Посмотрите вон туда. Это и есть останки Оробаси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140516,
					"content": "Ого! Огроменный змеиный скелет! Какой страшный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140517,
					"content": "Оробаси вывел наших предков из Энканомии на поверхность. Так и появился остров Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140518,
					"content": "Наши предки поклонялись ему как божеству-хранителю, но во время Войны Архонтов он захватил остров Ясиори.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140519,
					"content": "Сёгун Райдэн явилась лично и убила Оробаси с помощью Мусо но хитотати. После того удара осталось ущелье, известное как Мусодзин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140520,
					"content": "Сёгун Райдэн создала ущелье Мусодзин одним ударом меча?.. Невероятно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140521,
					"content": "Да. Но Война Архонтов была жестокой, и Ясиори в той битве был полностью уничтожен. Говорят, что тогда сёгун тоже утратила нечто ценное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140522,
					"content": "После смерти Оробаси между Ватацуми и сёгунатом установилась вражда. Но сопротивление было создано не из-за веры. Мы восстали из-за Охоты на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140523,
					"content": "Когда Оробаси начал уничтожать цивилизацию, сёгун остановила его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140524,
					"content": "Но теперь, когда сёгун посягнула на наши мечты, издав указ об Охоте, кто-то должен остановить её... Кхм-кхм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140525,
					"content": "Ладно, мне пора. Только что я столкнулся с элитными самураями сёгуната, и перед следующим заданием мне не помешает передохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140526,
					"content": "Да и вы здесь не задерживайтесь. Поскорее доложите госпоже Сангономии. Оставаться подолгу рядом с Татаригами вредно для здоровья...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140527,
					"content": "Кхе-кхе... кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140528,
					"content": "Ты тоже береги себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Обо мне не переживайте. Я в отличной форме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140531,
					"content": "Тэппэй добился больших успехов, раз он смог победить самураев сёгуната. Удивительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}, вернёмся и доложим <color=#00E1FFFF>Кокоми</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140529,
					"content": "Будь осторожен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201406",
							"2"
						],
						"stepId": 201406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сангономия Кокоми"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "Кокоми, мы верну... О, и Горо здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140602,
					"content": "Что стряслось? Все такие серьёзные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140603,
					"content": "У скольких человек проявились такие симптомы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20140604,
					"content": "У меня ещё не было возможности закончить подсчёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20140605,
					"content": "Кокоми, Горо, что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}, недавно у наших солдат обнаружились симптомы ускоренного старения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20140607,
					"content": "Когда я их расспросил, то узнал, что они негласно получили у нашего спонсора секретное оружие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20140608,
					"content": "Большинство из них амбициозны и до глубины души ненавидят Охоту на Глаза. С тех пор, как солдаты получили это оружие, они втайне использовали его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20140609,
					"content": "Так вот почему нам последнее время сопутствовал успех... Но опасное секретное оружие - это не выход. Мы должны как можно скорее покончить с ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20140610,
					"content": "Горо, у тебя есть это секретное оружие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20140611,
					"content": "Почти все отказались сдать его, но я всё-таки смог добыть одно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20140612,
					"content": "Это же...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}, ты что-то знаешь об этом предмете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20140614,
					"content": "Это Глаз Порчи Фатуи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "Выходит, наш тайный благодетель - Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20140616,
					"content": "Но зачем им так поступать?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20140617,
					"content": "С этим разберёмся позже. Сейчас необходимо как можно скорее донести до войск, чтобы они прекратили пользоваться Глазами Порчи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20140618,
					"content": "Все солдаты с симптомами должны пройти лечение. Надеюсь, мы их не потеряем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140619
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20140619,
					"content": "#Постой, {NICKNAME}. О солдатах с этими симптомами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140620,
					"content": "Ведь Тэппэй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140621
					]
				},
				{
					"id": 20140621,
					"content": "Нет, вряд ли он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140622,
					"content": "К нему, скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
