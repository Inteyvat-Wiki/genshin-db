					"Тэппэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140801,
					"content": "Тэппэй!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140802,
					"content": "О, это вы. Какими судьбами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140803,
					"content": "Погодите, дайте встать сначала... Странно, силы будто покинули меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140804,
					"content": "Тэппэй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140807,
					"content": "Ах да, я не рассказал тебе подробностей. Недавно я опять совершил много подвигов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140808,
					"content": "Сражался с войском сёгуната на море, в одиночку победил самураев сёгуна, спас товарищей из засады... Раньше я не смел и мечтать о таком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140809,
					"content": "Хотелось бы быть ещё немного сильнее. Чем я сильнее, тем больше я смогу сделать для сопротивления... А где это моё секретное оружие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140810,
					"content": "Расскажи мне об этом оружии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "Когда... Незадолго до того, как тебя произвели в командиры отряда Рыба-меч II. Мне повстречались таинственные люди, которые представились нашими союзниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140813,
					"content": "Они дали мне его и сказали, что пока во мне есть воля становиться сильнее, секретное оружие будет отвечать моему зову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140814,
					"content": "Ха-ха, совсем как Глаз Бога, да? Но Глаза Бога у меня никогда не было, и я не знаю, какая между ними разница...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140815,
					"content": "Это... Глаз Порчи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "Глаз... Порчи? Звучит, как нечто плохое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140817,
					"content": "А чем он отличается от Глаза Бога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140818,
					"content": "Он выкачивает твою жизненную силу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140820,
					"content": "Вот как... Наверное, неудивительно, что использование секретного оружия неизвестного происхождения сопряжено с рисками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140821,
					"content": "Последние несколько дней я изнурён... и меня преследует дурное предчувствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140822,
					"content": "Поначалу после сражений я уставал больше обычного, но сегодня я вернулся и обнаружил, что у меня словно туман перед глазами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140823,
					"content": "Очень жаль. Я уже думал, что поравнялся с тобой... ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140824,
					"content": "Думаю, покровительство богов мне не светит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140825,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#{NICKNAME}, не {F#могла}{M#мог} бы ты кое-что для меня сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140827,
					"content": "Когда наша форма будет готова, забери мой комплект и принеси его мне... примерим её вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140828,
					"content": "Не смотри на меня так. Я отдохну немного и буду как новенький... как новенький...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140829
					],
					"speakerTitle": "Тэппэй"
				},
				{
					"id": 20140829,
					"content": "Тэппэй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140830
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140830,
					"content": "Фатуи!..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140831
					]
				},
				{
					"id": 20140831,
					"content": "#Эй, {NICKNAME}, ты куда? Эй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20140811,
					"content": "Когда ты начал использовать его?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140805,
					"content": "Скажи-ка, ты последнее время...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				}
			]
