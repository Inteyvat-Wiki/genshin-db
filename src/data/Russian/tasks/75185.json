				"points": []
			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "О, это же бравые путники из далёких земель! Уже попробовали приготовить магмовые яйца?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850702,
					"content": "Попробовали! Это блюдо прямо-таки наполняет силой!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "Точно, точно! Это мощь вулкана в каждом кусочке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850704,
					"content": "Говорят, если их есть каждый день, то станешь сильнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850705,
					"content": "#Я {F#готовила}{M#готовил} моё слишком долго. Чуть в обморок не {F#упала}{M#упал}, когда {F#попробовала}{M#попробовал}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Ха-ха-ха, незабываемый вкус, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850707,
					"content": "А вообще он не так уж плох, нужно только привыкнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850710,
					"content": "Ещё нет. Может, потом как-нибудь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "Ладно. Удачи в твоих путешествиях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рунтума"
				}
			]
		}
