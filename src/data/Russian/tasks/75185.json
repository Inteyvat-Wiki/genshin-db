				"points": []
			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "Вот это ловкость! Вы завершили испытание в считанные секунды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850402,
					"content": "Посмотрим... Чёрный цвет, насыщенный запах, пробуждающий аппетит... Скорее попробуйте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850403,
					"content": "А вот рецепт. Если однажды снова захотите попробовать магмовые яйца, вы знаете, что делать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рунтума"
				}
			]
		},
