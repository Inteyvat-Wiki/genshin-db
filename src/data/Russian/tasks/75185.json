					"Рунтума"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850201,
					"content": "Если хотите отведать наш деликатес, надо принять участие в Испытании магмового яйца: разбить геотермальное отверстие, достать оттуда магмовое яйцо и попробовать, пока оно не остыло!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рунтума"
				}
			]
		},
		{
			"id": 7518503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
