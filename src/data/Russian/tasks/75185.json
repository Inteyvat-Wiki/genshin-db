				"objectNames": [
					"Рунтума"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "Что ещё за магмовые яйца?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "Магмовые яйца... Это блюдо могли придумать только у нас, в племени, что живёт по соседству с вулканом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850303,
					"content": "Мы кладём яйцо в геотермальное отверстие, чтобы оно поджарилось на газообразном флогистоне, и спустя некоторое время достаём оттуда вкуснейшее магмовое яйцо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Рунтума"
				},
				{
					"id": 751850304,
					"content": "Но если яйцо пережарится, вкус будет... специфический.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рунтума"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
