			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзё Камадзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "#Ты... Ах, ты т{F#а}{M#от} путешественни{F#ца}{M#к} из-за границы. Чем я могу быть полезен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070302,
					"content": "О письме Хийраги Тисато...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "Это письмо... Госпожа Хийраги действительно поручила тебе доставить мне это письмо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070304,
					"content": "Этот почерк... Это действительно она... Как чудесно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070305,
					"content": "#Спасибо, что проделал{F#а} этот путь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070306,
					"content": "Что касается подорожной грамоты... Поскольку это личная просьба госпожи Хийраги, я конечно же позабочусь об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070307,
					"content": "Однако мне понадобится время на подготовку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070308,
					"content": "Давай сделаем так. Ты сможешь подождать меня возле ресторана «Киминами»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070309,
					"content": "А зачем туда идти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Ну... Я хотел попросить тебя о небольшой услуге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070311,
					"content": "Я тоже как раз собирался кое-что отправить госпоже Хийраги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070312,
					"content": "Я написал письмо и попросил госпожу Киминами приготовить для меня угощения. Я планировал отправить их вместе с письмом госпоже Хийраги в качестве подарка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070313,
					"content": "#Но если отец узнает о моих планах, он может быть недоволен... Когда ты приш{F#ла}{M#ёл}, я как раз размышлял, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070314,
					"content": "Это всего лишь подарок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Отец не хочет, чтобы я общался с госпожой Хийраги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070316,
					"content": "Я понимаю его опасения. В конце концов, я член клана Кудзё и один из исполнителей комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070317,
					"content": "Госпожа Хийраги - молодая наследница клана Хийраги комиссии Кандзё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070318,
					"content": "Если мы слишком сблизимся, то кто-то неизбежно воспользуется этим в своих целях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070319,
					"content": "И хотя это всего лишь подарок, но в глазах некоторых людей это нечто намного большее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070326,
					"content": "Хе-хе, давай больше не будем обсуждать эти пустяки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070327,
					"content": "#Путешественни{F#ца}{M#к}, подожди меня, пожалуйста, у ресторана «Киминами». Я согласую подорожную грамоту и принесу её тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070320,
					"content": "Твой отец очень строгий?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Отец... Конечно, он должен быть строгим. Я понимаю, почему он не хочет, чтобы я общался с госпожой Хийраги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070322,
					"content": "В конце концов, я член клана Кудзё и один из исполнителей комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070323,
					"content": "Госпожа Хийраги - молодая наследница клана Хийраги комиссии Кандзё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070324,
					"content": "Если мы слишком сблизимся, то кто-то неизбежно воспользуется этим в своих целях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070325
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070325,
					"content": "И хотя это всего лишь подарок, но в глазах некоторых людей это нечто намного большее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Кудзё Камадзи"
				}
			]
		},
