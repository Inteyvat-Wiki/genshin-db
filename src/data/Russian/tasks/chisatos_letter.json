					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Кудзё Камадзи"
				},
				{
					"id": 728070305,
					"content": "#Спасибо, что проделал{F#а} этот путь, путешественни{F#ца}{M#к}.",
