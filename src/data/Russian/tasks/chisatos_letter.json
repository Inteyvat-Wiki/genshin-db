			"dialogs": [
				{
					"id": 728070201,
					"content": "Ой, как же болит голова... Привет, я могу чем-то помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "Санада"
				},
				{
					"id": 728070202,
					"content": "О Камадзи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Ты говоришь о молодом господине Камадзи? Зачем он тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Санада"
				},
				{
					"id": 728070204,
					"content": "(Осматривает письмо Тисато)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Ты утверждаешь, что это письмо госпожи Хийраги Тисато? Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Санада"
				},
				{
					"id": 728070206,
					"content": "Если это письмо действительно от Хийраги Тисато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Санада"
				},
				{
					"id": 728070207,
					"content": "Я думаю... Тебе следует поговорить напрямую с господином Камадзи. В последнее время он часто гуляет возле моста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санада"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
