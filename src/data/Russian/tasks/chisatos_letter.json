			"dialogs": [
				{
					"id": 728070501,
					"content": "#Путешественни{F#ца}{M#к}, ты вернул{F#ась}{M#ся}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 728070502,
					"content": "#Полагаю, ты доставил{F#а} моё письмо Камадзи? ...Тебе удалось также получить подорожную грамоту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "Хийраги Тисато"
				},
