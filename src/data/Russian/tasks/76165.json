			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "Хм... похоже на могилу ратников. Неужели это те самые ратники, которых мы видели в ущелье?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761650102,
					"content": "Они мерцают: то вдруг появятся, то снова исчезнут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761650103,
					"content": "Хм-м, Паймон ничего не понимает. Как окажемся в Пирамиде, надо будет спросить, что это такое. Может, местные знают, что происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Патоличев"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "О, здравствуйте. Я Патоличев, интендант Светоносцев. Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650202,
					"content": "Патоличев из «Рысаков вихря»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "«Рысаки вихря»... А, это те странные тени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761650204,
					"content": "#Да, {M#господин}{F#госпожа}, когда-то я там служил. «Рысаки вихря» - давно я не слышал этого названия. И не думал, что услышу его от вас... Могу я спросить, откуда вам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650205,
					"content": "Мы были у подножия скалы Кипумаки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "Да! Разбирались с Дикой Охотой, которая там появилась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761650207,
					"content": "И видели ратников из «Рысаков вихря»... их тени остались там после битвы с Дикой Охотой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761650210,
					"content": "Поверить не могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650211,
					"content": "Почему? Паймон своими глазами всё видела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761650212,
					"content": "Ах... За эти годы многие говорили, что видели призраков моих погибших товарищей у скалы Кипумаки. Поэтому я до сих пор часто хожу туда... заодно присматриваю за их могилами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650213,
					"content": "Но я ни разу... ни разу за всё время не видел их сам. Я решил, что это всего лишь выдумки, которые люди рассказывают в надежде меня утешить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650214,
					"content": "А вы их увидели своими глазами... Но почему мне они никогда не являлись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650215,
					"content": "Возможно, время вашей встречи ещё не пришло...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "Возможно... Но теперь я знаю, что они там. И даже если это всего лишь воспоминание, всего лишь фантом - мне и этого достаточно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650219,
					"content": "#Как бы там ни было, спасибо вам, {M#господин}{F#госпожа}. Спасибо, что рассказали. Для меня это очень много значит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650220,
					"content": "Благодаря им я сейчас здесь. Но как же сильно я хочу снова встать в наш строй у подножия скалы Кипумаки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650221,
					"content": "...Однажды мы с вами обязательно встретимся снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650217,
					"content": "Возможно, они не хотели, чтобы ты вспоминал о тех мучениях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "Эх... Разве же это мучение - сражаться плечом к плечу с товарищами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Патоличев"
				},
				{
					"id": 761650208,
					"content": "Мы видели ратников «Рысаков вихря»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "Да, хотя от них остались только тени... которые продолжают сражаться с Дикой Охотой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}