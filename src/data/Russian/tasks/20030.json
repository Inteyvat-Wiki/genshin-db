			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "Добро пожаловать в <color=#00E1FFFF>Гильдию искателей приключений</color>. Мы давно присматриваемся к вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300102,
					"content": "Давно к нам присматриваетесь? Что мы такого натворили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200300103,
					"content": "О нет, я совсем не это имела в виду. Находить новых искателей приключений - это моя работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300104,
					"content": "Я вижу в тебе искателя приключений, равного по силе легендарным героям прошлого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300105,
					"content": "Ха-ха! Я тоже это заметила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200300106,
					"content": "#{NICKNAME} и Паймон путешествуют вместе. За н{F#ей}{M#им} я как за каменной стеной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200300107,
					"content": "Ха-ха! Однако для любого искателя приключений нет ничего важнее опыта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300108,
					"content": "Ведь <color=#00E1FFFF>Ранг приключений</color> можно повысить только с помощью <color=#00E1FFFF>Опыта приключений</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300109,
					"content": "А я занимаюсь инструктажем свежеиспечённых членов Гильдии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300110,
					"content": "Постой! Это значит, что мы теперь официально искатели приключений?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200300111,
					"content": "Не переживай, Гильдия не собирает никаких взносов и не накладывает никаких обязательств на своих членов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300112,
					"content": "Если вкратце, то в Гильдии нет никаких минусов, только плюсы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300113,
					"content": "Понятно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "С ростом Ранга приключений ты будешь получать награды от Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300117,
					"content": "А это подарок новым членам Гильдии. Получи и распишись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300118,
					"content": "Награда Ранга приключений",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "Плюсы! Я хочу плюсы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "Ха-ха! Хочешь побыстрее заняться делом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "Катерина"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
							"2"
						],
						"stepId": 2003003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "А вот теперь позволь мне официально поздравить тебя со вступлением в Гильдию искателей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300202,
					"content": "Вот твоя <color=#00E1FFFF>лицензия искателя приключений</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300203,
					"content": "Для этого нужна лицензия?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "Принятие нового члена в Гильдию - это важное событие. Нужно соблюсти все формальности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300207,
					"content": "В ней ты найдёшь полезную информацию о наградах и заданиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300208,
					"content": "А ещё это доказательство твоего членства в Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300209,
					"content": "Ох, чуть не забыла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300210,
					"content": "#В какой-то момент ты можешь почувствовать, что {F#застряла}{M#застрял} на определённом Ранге приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300211,
					"content": "Когда это произойдёт, тебе придётся сделать что-то выдающееся, чтобы заслужить признание Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300212,
					"content": "Выдающееся? А можно поточнее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200300213,
					"content": "Определённые задания позволят тебе повысить свой Ранг приключений. Считай это своего рода тестом на повышение квалификации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300214,
					"content": "Но сейчас тебе не о чем беспокоиться. Необходимость заработать признание Гильдии появится, когда у тебя будет достаточно опыта приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300215,
					"content": "На сегодня это всё. До скорых встреч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300216,
					"content": "К звёздам и к безднам! Вперёд, искатели приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200300205,
					"content": "Больше похоже на рекламную брошюру.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "Это и есть своего рода рекламная брошюра, но она может быть полезной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Катерина"
				}
			]
		}
	]
}