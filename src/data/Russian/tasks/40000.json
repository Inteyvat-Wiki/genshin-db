			"dialogs": [
				{
					"id": 400000201,
					"content": "Приветствую! Вы тоже хотите сыграть в «Театр Механикус»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000202,
					"content": "«Театр Механикус»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Вы ещё не слышали о «Театр Механикус»? Это настольная игра, которую я изобрела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000204,
					"content": "Видите фигурки на столе? Они все используются в игре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000205,
					"content": "Выглядит слишком сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "На самом деле играть в неё может любой. Хватит нескольких партий, чтобы разобраться во всех правилах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000207,
					"content": "Ну как, хотите попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000208,
					"content": "Сколько стоит сыграть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "Нет-нет, вы ведь на Празднике морских фонарей. Так уж получилось, что мне интересно, как «Театр Механикус» воспримут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000211,
					"content": "Поэтому я возьму с вас всего лишь один небесный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000212,
					"content": "Так что если хотите сыграть, принесите мне небесный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000213,
					"content": "Ну что, хотите попробовать? Первая игра бесплатно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жуй Цзинь"
				},
				{
					"id": 400000209,
					"content": "Думаю, очень дорого...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
