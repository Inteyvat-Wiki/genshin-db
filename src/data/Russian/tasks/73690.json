				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "Привет, я Дая из Кшахревара! Тоже хочешь поучаствовать в Празднике мудрости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900102,
					"content": "«Проектирование пути» - это развлекательная программа нашего даршана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900103,
					"content": "Ну что, хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900104,
					"content": "Насколько я помню, Кшахревар изучает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "...механизмы и архитектуру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900107,
					"content": "Кхе, что-то я ушла от темы... Ради участия в нынешнем Празднике мудрости многие студенты нашего даршана объединили усилия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900108,
					"content": "...и разработали развлекательную программу «Проектирование пути»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900109,
					"content": "Проще говоря, игроки должны построить дорогу из приготовленных нами предметов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900110,
					"content": "Это может быть подвесной мост или лестница... Главное - построить прямую дорогу до финиша, по которой могли бы пройти люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900111,
					"content": "После окончания строительства мы проведём проверку готовой дороги... так же, как проводим приёмку готового здания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900112,
					"content": "Другими словами, чтобы победить, нужно построить безопасную дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900113,
					"content": "Звучит сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Ха-ха-ха, не переживай. Тебе ведь не нужно строить настоящие здания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900116,
					"content": "Даже если ничего не получится и дорога разрушится, ничего страшного не случится. Просто построишь заново. Мы не будем ограничивать количество попыток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900117,
					"content": "Нужно построить красивую дорогу, используя своё воображение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900118,
					"content": "Хочу попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Хорошо. Тогда посмотри сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900120,
					"content": "Мне пока некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Вот оно что... Ладно. Наш киоск будет работать на протяжении всего Праздника мудрости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900122,
					"content": "Если захочешь сыграть, приходи в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дая"
				},
				{
					"id": 736900114,
					"content": "У меня нет таланта к строительству...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}