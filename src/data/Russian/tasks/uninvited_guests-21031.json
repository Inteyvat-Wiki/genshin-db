			"dialogs": [
				{
					"id": 210310401,
					"content": "Вы вернулись. С теми монстрами справиться было нелегко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310402
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310402,
					"content": "Ты уничтожил всех монстров?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "Ха-ха, да. Пришлось чуть поднапрячься. Я уже немолод.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310404,
					"content": "Полагаю, вы тоже всех своих монстров уничтожили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310405,
					"content": "О лагере монстров...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "Все они были повержены... Но в лагере никого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310407,
					"content": "Это очень странно. Неужели какой-то проходивший мимо искатель приключений победил их?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310408,
					"content": "Спасибо, что осмотрели территорию. Это вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
