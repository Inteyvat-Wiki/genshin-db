			"trigger": {
				"objectNames": [
					"Хуай Ань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Ах, я должен что-то придумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310102,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "О, это вы. Ох, даже не спрашивайте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310104,
					"content": "В последнее время дела в гостинице идут всё лучше и лучше, и к нам приезжает много гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310105,
					"content": "Некоторые стремятся к спокойному отдыху в одиночестве, а другие берут с собой семью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310106,
					"content": "Процветающий бизнес - это, конечно, хорошо, но факт остаётся фактом: окрестности кишат чудовищами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310107,
					"content": "Если какой-нибудь ребенок во время игры или пожилой человек на прогулке встретит их...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310108,
					"content": "Чтобы не допустить этого, я отгоняю монстров от гостиницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310109,
					"content": "Но я один, а их много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310110,
					"content": "Поможете мне? Я хорошо заплачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310111,
					"content": "Да, конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "Я рассчитываю на вас. Недавно я приметил несколько лагерей очень опасных монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310116,
					"content": "А ещё одна группа монстров прокралась к гостинице и расположилась прямо у неё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310117,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310118,
					"content": "Знаете, оставьте более опасных мне. Просто помогите избавиться от монстров вокруг гостиницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310119,
					"content": "Встретимся здесь, когда не останется монстров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310120,
					"content": "Эх... Эти монстры - настоящая беда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310112,
					"content": "Ты и так хорошо справляешься.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Я? Ну... Спасибо за похвалу, справляюсь кое-как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 210310114,
					"content": "И всё же не могу бороться с ними в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
