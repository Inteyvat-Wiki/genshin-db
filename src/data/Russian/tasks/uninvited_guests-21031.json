						210310302,
						210310303
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 210310302,
					"content": "Что привело тебя сюда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				},
				{
					"id": 210310304,
					"content": "Я случайно встретил этих монстров и разобрался с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310305
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 210310305,
					"content": "Тут не так уж безопасно. Так что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310306
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 210310306,
					"content": "Я буду осторожнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "Ну, мне пора. Ещё увидимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сяо"
				},
				{
					"id": 210310303,
					"content": "Этих монстров ты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				}
			]
		},
