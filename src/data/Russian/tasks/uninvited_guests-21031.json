					"nextDialogs": [
						210310203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210310203,
					"content": "Но раз уж монстры побеждены, вернёмся к Хуай Аню и расскажем ему новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
