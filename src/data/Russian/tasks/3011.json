			"trigger": {
				"objectNames": [
					"Нахида"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "Нахида, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30110402,
					"content": "Сегодня вы рано. Неужели что-то придумали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30110403,
					"content": "Можно и так сказать. Мы уверены, что время не зациклилось и что это не реальный мир... но у нас возникли новые вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30110404,
					"content": "Что будет, если мы выйдем из города?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Выйти из города... Насколько я помню, вы пару раз упоминали об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30110407,
					"content": "?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "Мы говорили об этом?! А что потом произошло? Что мы сказали, когда вернулись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30110409,
					"content": "Дайте подумать... Кажется, вы никогда не упоминали о том, чем всё закончилось. Ох, нет, вы никогда не возвращались в тот вечер, когда выходили из города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30110410,
					"content": "Но вы немало ночей провели на ногах, так что я не придала этому значения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30110411,
					"content": "Это правда, что порой за расследованием мы забывали о времени и не замечали, что уже наступил новый день. Но... никто из нас не помнит, чтобы мы выходили из города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30110412,
					"content": "Правда? Это странно. Теоретически вы должны были вспомнить всё, я пробудила все ваши воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Нахида"
				},
				{
					"id": 30110413,
					"content": "Давай завтра попробуем ещё раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "Да, что-то подозрительно. Завтра мы во всём разберёмся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30110416,
					"content": "Бип...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 30110414,
					"content": "Может быть, в этом кроется разгадка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "Мы же ещё не пробовали выйти из города, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
