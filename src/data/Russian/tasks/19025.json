			},
			"dialogs": [
				{
					"id": 190250401,
					"content": "#Как ты меня наш{F#ла}{M#ёл}?! У-у-у, этого не может быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250402
					],
					"speakerTitle": "Малышка Лэ"
				},
				{
					"id": 190250402,
					"content": "#Ты правда не подглядывал{F#а}?",
