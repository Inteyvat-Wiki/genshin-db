			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чун Юнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190250501,
					"content": "#Как же быстро ты меня наш{M#ёл}{F#ла}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250502,
					"content": "Всё-таки это твоя первая игра.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "Я посчитал, что это отличное место, чтобы спрятаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250505,
					"content": "Всю свою жизнь я выслеживаю злых духов, которые мастерски прячутся и скрывают свои следы. Дружище, у меня богатый опыт в этом деле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250506,
					"content": "Теперь посмотри на это место: угловатые поверхности, много пыли. К тому же оно укрыто от солнца. Злому духу было бы очень уютненько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250507,
					"content": "Ты применяешь навыки экзорциста в игре в прятки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "Да, вряд ли мой опыт сейчас будет сколь-нибудь полезен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250511,
					"content": "Поскольку меня нашли, признаю поражение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250512,
					"content": "Эта игра проста, но, признаться, крайне увлекательна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250513,
					"content": "Значит, сыграем как-нибудь ещё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "Идёт. Можно было бы пригласить друзей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250517,
					"content": "Что ж, идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250515,
					"content": "Хорошо, что водил не ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "Хех, точно. Я бы вас часами искал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250509,
					"content": "Но тебя здесь легко увидеть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "Хм, наверное, я так нервничал, что позабыл о главном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Чун Юнь"
				},
				{
					"id": 190250503,
					"content": "...Ты зачем спрятался здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
