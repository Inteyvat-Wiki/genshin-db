					"nextDialogs": [],
					"speakerTitle": "Малышка Лэ"
				}
			]
		},
		{
			"id": 1902505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
