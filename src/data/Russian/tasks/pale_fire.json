			"dialogs": [
				{
					"id": 733070601,
					"content": "Неужели это Соруш, её яснапати... и Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070602
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070602,
					"content": "Что значит «и Паймон»?!",
					"roleType": "TALK_ROLE_NPC",
