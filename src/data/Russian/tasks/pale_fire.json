					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"7323218",
							"3"
						],
						"stepId": 7323218,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7323218",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Зурван",
					"Соруш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733070401,
					"content": "Похоже, что пари, некогда рассеянные по всей земле, вернулись в оазис Вурукаша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070402
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070402,
					"content": "#Отличная работа. Как и следовало ожидать от яснапати, {F#которую}{M#которого} выбрала Соруш.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070403
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070403,
					"content": "Будем считать это комплиментом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070404
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733070404,
					"content": "Оазис Вурукаша выглядит куда более оживлённым, чем раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733070405,
					"content": "Как только мы заделаем эту гигантскую дыру, всё здесь сразу восстановится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733070406,
					"content": "Кстати, раз уж Паймон об этом заговорила... Если пари рождаются из воды, не следует ли вас называть «гидри» или как-то так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733070407,
					"content": "Эй, даже не пытайся дать нам какую-то глупую кличку, Белая Болталка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070408
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733070408,
					"content": "Хе-хе, это напомнило мне что-то из далёкого прошлого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070409,
						733070410
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070409,
					"content": "Про «гидри»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				},
				{
					"id": 733070411,
					"content": "Давным-давно, невзирая на все препятствия, сюда отправилось множество океанид из чужих земель.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070412
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070412,
					"content": "В те времена оазис Вурукаша отделяла пустыня. Чтобы попасть сюда, им приходилось преодолевать палящее солнце и разъярённых чудовищ. Для этих водных существ путешествие должно было быть чрезвычайно мучительным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070413
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070413,
					"content": "Казалось, они пришли за умершим божеством. Но обнаружили, что того, кого они ищут, здесь уже нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070414
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070414,
					"content": "Увидев Харвисптохм, они вскоре разошлись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070415
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070415,
					"content": "Впоследствии легенда об океанидах разошлась по миру, и многие чужеземцы шли их путём в надежде разгадать секреты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070416
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070416,
					"content": "Хоть поначалу это был лишь слух, но со временем сам маршрут стал наделяться смыслом самопожертвования в погоне за чистотой и невинностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070417
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070417,
					"content": "Оазис Вурукаша перестал быть открытым для мира, но паломничества продолжались ещё долгие годы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070418
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070418,
					"content": "Возможно, для них само путешествие было важнее, чем пункт назначения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070419
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070419,
					"content": "Можно также утверждать, что само стремление к цели приносит больше пользы, чем простое принесение себя в жертву раз и навсегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070420
					],
					"speakerTitle": "Зурван"
				},
				{
					"id": 733070420,
					"content": "Эй! Почему в конце концов всё сводится ко мне?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733070410,
					"content": "Надеюсь, история будет не слишком длинная...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				}
			]
		},
