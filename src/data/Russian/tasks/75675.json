			"dialogs": [
				{
					"id": 756750101,
					"content": "Эй! Ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 756750102,
					"content": "В голове осталась только музыка! Танцуем, танцуем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 756750103,
					"content": "Танцы, танцы, танцы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Седиль"
				},
				{
					"id": 756750104,
					"content": "Как весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Менея"
				},
				{
					"id": 756750105,
					"content": "Ра-а-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Муу"
				},
				{
					"id": 756750106,
					"content": "Я ещё и заработать успела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 756750107,
					"content": "Что? Это когда?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 756750108,
					"content": "Госпожа Нуста была очень занята, так что я решила помочь её ученикам. Мы вместе зачистили несколько нор, где гнездились монстры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 756750109,
					"content": "В Натлане сражения приносят столько же удовольствия, сколько и танцы. Мне нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 756750110,
					"content": "Простите за беспокойство, Марин. Я хотела, чтобы новички побольше тренировались, но не ожидала, что они так и не смогут самостоятельно выполнить задание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 756750111,
					"content": "Вот вернусь - задам им жару на тренировке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 756750112,
					"content": "Не стоит беспокоиться, они тоже отлично сражались. Просто в норах оказалось в семь раз больше монстров, чем мы думали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 756750113,
					"content": "Клан Цветочного Пера щедро нам заплатил. И я скопила достаточно моры, чтобы купить подарок для Эваль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 756750114,
					"content": "Но твой отпуск тоже подходит к концу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 756750115,
					"content": "Ещё несколько дней отдохну, а потом можно будет покупать билет на обратный рейс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Анджиани"
				},
				{
					"id": 756750116,
					"content": "Спешить ни к чему, ещё можно потанцевать. Малышка Роксана, Летелье, Шене и Фрежюс в последнее время наперебой берутся за задания. Не буду же я с ними соревноваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Марин"
				},
				{
					"id": 756750117,
					"content": "Тогда продолжай танцевать и веселиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Седиль"
				},
				{
					"id": 756750118,
					"content": "Устала танцевать - поешь, наелась - поспи, без забот и хлопот!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Менея"
				},
				{
					"id": 756750119,
					"content": "Ра-а-ар!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Муу"
				},
				{
					"id": 756750120,
					"content": "Мелюзины и кохолазаврики выстраиваются в ряд и вприпрыжку скачут к сцене.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "Какие милые гости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 756750122,
					"content": "Хе-хе, ты отлично проводишь время, Нуста!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756750123,
					"content": "Ты улыбаешься намного веселее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "Правда? Тогда впредь я буду постоянным гостем на всех танцевальных вечеринках!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 756750126,
					"content": "Пусть все, кто при встрече называет меня тётушкой... однажды обнаружат, что духом я моложе их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 756750127,
					"content": "Будущие танцевальные вечеринки должны быть под стать этой и проводиться как можно чаще! Хорошо бы сделать их ежемесячной традицией!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нуста"
				},
				{
					"id": 756750124,
					"content": "И как будто вся помолодела.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}